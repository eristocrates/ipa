H©Š>R§V–øpGÈáˆGpÄçÃQ—P}HÏŸ_'EùBEGIN
					-- Declare the return variable here
					DECLARE @SQL AS NVARCHAR(MAX)

					/*Main Select*/

					SET @SQL = '
								SELECT
								TRN.APKEY,
								SUM(CASE WHEN TRN.TRNTYPE IN (''FADJ'',''FCHG'',''FPAY'',''FREF'') THEN TRN.TRNAMT ELSE 0 END) UnpaidAmount,
								SUM(CASE WHEN TRN.TRNTYPE IN (''FADJ'',''FCHG'',''FPAY'',''FREF'') And FT.FEECLASS = 4 THEN TRN.TRNAMT ELSE 0 END) UnpaidAmountAtCost,
								SUM(CASE WHEN TRN.TRNTYPE IN (''FPAY'',''FREF'',''DREF'',''DRFO'',''DPAY'') THEN TRN.TRNAMT ELSE 0 END) PaidAmount,
								SUM(CASE WHEN TRN.TRNTYPE IN (''DPAY'') THEN TRN.TRNAMT ELSE 0 END) PaidAmountAtCost
								,

								SUM(CASE WHEN DueNow.APFEEKEY Is Not Null And TRN.TRNTYPE IN (''FADJ'',''FCHG'',''FPAY'',''FREF'') THEN TRN.TRNAMT ELSE 0 END) DueNowUnpaidAmount,
								SUM(CASE WHEN DueNow.APFEEKEY Is Not Null And DueNow.PAYINPORTAL = ''Y'' And TRN.TRNTYPE IN (''FADJ'',''FCHG'',''FPAY'',''FREF'') THEN TRN.TRNAMT ELSE 0 END) PortalDueNowUnpaidAmount

							FROM 
								CDR.APTRN TRN
									Left Join CDR.APPAYMENT P On P.APPAYKEY = TRN.APPAYKEY
									Left Join CDR.APPAYMENT P2 On P2.APPAYKEY = TRN.REFTRNNO
									Left Join CDR.APFEE F On F.APFEEKEY = TRN.APFEEKEY
									Left Join CDR.FEETYPEVERSION FTV On FTV.FEETYPEVERSIONKEY = F.FEETYPEVERSIONKEY
									Left Join CDR.FEETYPE FT On FT.FEETYPEKEY = FTV.FEETYPEKEY
									Left Join ('+ PORTAL.uf_GetFeesDueNow() + ') DueNow On DueNow.APFEEKEY = F.APFEEKEY
								GROUP BY TRN.APKEY 
								'
					RETURN @SQL
				ENDGH·r!Á„…w *k¦+„«èª/XÓ9Sáª‹
