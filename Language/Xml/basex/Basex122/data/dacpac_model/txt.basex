>ÁÁÁÁÁ$qÕçÕ?Ž´u_„¢£BÄ£aÀDF80¡@€„	.DˆP!âÑøpGpGpGpGpGè0W}^ýãH[÷…€A(:T¨ñh0‘`B‡%p`B(␀	\ˆ¡BÄ£ñáŽàŽàŽàŽàŽÐaHBÀdtPqÐ	¸”à¥(…Mð„„œ«>¯þq¤­ûBKL–&ˆ0aá!À…*D<ZðáŽàŽàŽàŽàŽÐa®ú¼úÇ‘¶î‹Ž",è&ˆ0aá!À…*D<ZÀr>Žxˆ ñ G€U␀¯LYÁƒ"LHXŠˆ#¯˜põzd›Çƒ"LHXŠˆ#¯˜ ÈUŠpðá7îÀPBõ…p]¯Œˆ%…p$uVäŽ0 B␀B° ñ Ÿ*H¢BEGIN
	-- Declare the return variable here
	DECLARE @WhereClause AS NVARCHAR(MAX)

	SET @WhereClause = ''

	SET @WhereClause = CASE
						WHEN @PARAMNAME = 'ADRSTNO' THEN 
							CASE
								WHEN @TABLENAME = 'AddressInfo' THEN 'AND ( AddressInfo.STNO = @ADRSTNO OR AssocAddressInfo.STNO = @ADRSTNO )'	
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND AddressInfo.STNO = @ADRSTNO'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END
						WHEN @PARAMNAME = 'ADRSTNAME' THEN 
							CASE
								WHEN @TABLENAME = 'AddressInfo' THEN 'AND ( UPPER(AddressInfo.STNAME) LIKE UPPER(@ADRSTNAME) OR UPPER(AssocAddressInfo.STNAME) LIKE UPPER(@ADRSTNAME) )'	
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND UPPER(AddressInfo.STNAME) LIKE UPPER(@ADRSTNAME)'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END
						WHEN @PARAMNAME = 'ADRSUFFIX' THEN
							CASE
								WHEN @TABLENAME = 'AddressInfo' THEN 'AND ( AddressInfo.SUFFIX LIKE @ADRSUFFIX OR AssocAddressInfo.SUFFIX LIKE @ADRSUFFIX )'
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND AddressInfo.SUFFIX LIKE @ADRSUFFIX'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END
						WHEN @PARAMNAME = 'ADRAREA' THEN
							CASE
								WHEN @TABLENAME = 'AddressInfo' THEN 'AND ( AddressInfo.AREA LIKE @ADRAREA OR AssocAddressInfo.AREA LIKE @ADRAREA )'
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND AddressInfo.AREA LIKE @ADRAREA'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END
						WHEN @PARAMNAME = 'ADRCITY' THEN 
							CASE
								WHEN @TABLENAME = 'AddressInfo' THEN 'AND ( UPPER(AddressInfo.CITY) LIKE UPPER(@ADRCITY) OR UPPER(AssocAddressInfo.CITY) LIKE UPPER(@ADRCITY) )'	
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND UPPER(AddressInfo.CITY) LIKE UPPER(@ADRCITY)'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END	
						WHEN @PARAMNAME = 'PRCLID' THEN 
							CASE
								WHEN @TABLENAME = 'ParcelInfo' THEN 'AND ( UPPER(ParcelInfo.PRCLID) LIKE UPPER(@PRCLID) OR UPPER(AssocParcelInfo.PRCLID) LIKE UPPER(@PRCLID) )'	
								WHEN @TABLENAME = 'ServiceRequest' THEN 'AND UPPER(ParcelInfo.PRCLID) LIKE UPPER(@PRCLID)'
								ELSE 'AND ''Id'' =  ''0'' ' 
							END																			 	
						ELSE ''	
						END

	RETURN @WhereClause

ENDjÀor!Á„…w *k¦+„«èª/XÓ9Sáª‹
