(:
  https://codepoints.net
:)
module namespace character = 'net.codepoints.character';
declare variable $character:newline := codepoints-to-string(10);
declare variable $character:new-line := codepoints-to-string(10);
declare variable $character:next-line := codepoints-to-string(10);
declare variable $character:line-feed := codepoints-to-string(10);
declare variable $character:line-break := codepoints-to-string(10);
declare variable $character:line-ending := codepoints-to-string(10);
declare variable $character:end-of-line := codepoints-to-string(10);











