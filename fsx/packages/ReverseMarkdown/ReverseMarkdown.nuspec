<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ReverseMarkdown</id>
    <version>6.2.1</version>
    <authors>Babu Annamalai</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/mysticmind/reversemarkdown-net</projectUrl>
    <description>ReverseMarkdown is a Html to Markdown converter library in c#</description>
    <tags>htmltomarkdown html2markdown html-to-markdown html2md htmltomd converthtml htmlconverter markdownconverter html html5 markdown md converter conversion commonmark gfm githubflavoredmarkdown multimarkdown pandoc slack telegram anglesharp aot nativeaot trimming scraping rag</tags>
    <repository type="git" url="https://github.com/mysticmind/reversemarkdown-net.git" branch="refs/heads/master" commit="fa0484a6c66a7ba1adda9ff998d64164aee56455" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="AngleSharp" version="1.5.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="AngleSharp" version="1.5.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="AngleSharp" version="1.5.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="AngleSharp" version="1.5.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>