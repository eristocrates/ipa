<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>WebFlux</id>
    <version>0.7.1</version>
    <title>WebFlux - AI-Optimized Web Content Processing SDK</title>
    <authors>iyulab</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/iyulab/WebFlux</projectUrl>
    <description>A .NET SDK for preprocessing web content for RAG (Retrieval-Augmented Generation) systems</description>
    <copyright>Copyright (c) Iyulab Corporation 2025.</copyright>
    <tags>RAG AI Web Crawling Content Processing Chunking Web Intelligence NLP Machine Learning SDK DotNet CSharp Web Scraping Text Processing Multimodal Document Processing Semantic Chunking Auto Strategy</tags>
