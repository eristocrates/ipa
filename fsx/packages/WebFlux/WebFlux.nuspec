        <dependency id="HtmlAgilityPack" version="1.12.4" exclude="Build,Analyzers" />
        <dependency id="Markdig" version="1.2.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Abstractions" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Memory" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Http" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.8" exclude="Build,Analyzers" />
        <dependency id="Polly" version="8.6.6" exclude="Build,Analyzers" />
        <dependency id="Polly.Extensions.Http" version="3.0.0" exclude="Build,Analyzers" />
        <dependency id="ReverseMarkdown" version="6.2.1" exclude="Build,Analyzers" />
        <dependency id="YamlDotNet" version="18.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
