<?xml version="1.0" encoding="utf-8"?>
<coreProperties xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.openxmlformats.org/package/2006/metadata/core-properties">
  <dc:creator>Peter Waher</dc:creator>
  <dc:description>Class library that keeps an inventory of types and interfaces available in your code. It also provides a means to access available types given an interface, and can find the best implementation to process a task or item. It can be used to implement an Inversion of Control Pattern, and helps instantiate interfaces, abstract classes and normal classes, including recursively instantiating constructor arguments. Handles singleton types.</dc:description>
  <dc:identifier>Waher.Runtime.Inventory</dc:identifier>
  <version>1.4.6</version>
  <keywords>inventory reflection runtime IoC singleton interface</keywords>
  <lastModifiedBy>NuGet.Packaging, Version=7.0.2.11305, Culture=neutral, PublicKeyToken=31bf3856ad364e35;Microsoft Windows NT 10.0.26200.0;.NET Framework 4.7.2</lastModifiedBy>
</coreProperties>