<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Meziantou.Framework.Language.Json</id>
    <version>4.0.2</version>
    <authors>meziantou</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/meziantou/Meziantou.Framework</projectUrl>
    <description>A Roslyn-style immutable JSON syntax tree: green and red nodes, trivia, diagnostics, annotations, and editing that keeps the text you did not touch.</description>
    <tags>json, syntax-tree, cst, parser, diagnostics</tags>
    <repository type="git" url="https://github.com/meziantou/Meziantou.Framework" branch="refs/heads/main" commit="72eb96ebf2ff19c43e6ea9a3bd11601cbd5eda52" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Meziantou.Framework.JsonPath" version="3.0.5" exclude="Build,Analyzers" />
        <dependency id="Meziantou.Framework.Language" version="1.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="Meziantou.Framework.JsonPath" version="3.0.5" exclude="Build,Analyzers" />
        <dependency id="Meziantou.Framework.Language" version="1.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>