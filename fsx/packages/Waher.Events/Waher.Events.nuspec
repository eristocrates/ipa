    <tags>logger logging logs events eventlogging eventlogs</tags>
    <repository type="GitHub" url="https://github.com/PeterWaher/IoTGateway" commit="6557784e8995691eb349c7d70485f8cac0420dc9" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Waher.Runtime.Collections" version="1.0.3" exclude="Build,Analyzers" />
        <dependency id="System.Net.Http" version="4.3.4" exclude="Build,Analyzers" />
        <dependency id="System.Text.RegularExpressions" version="4.3.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>