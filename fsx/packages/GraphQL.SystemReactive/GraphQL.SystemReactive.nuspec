<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>GraphQL.SystemReactive</id>
    <version>4.8.0</version>
    <authors>GraphQL.SystemReactive</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.64x64.png</icon>
    <description>GraphQL subscriptions implementation on top of System.Reactive</description>
    <tags>GraphQL json api subscriptions</tags>
    <repository type="git" url="https://github.com/graphql-dotnet/graphql-dotnet" commit="39d30c17b844a3be8e1e2e731faef6eb03505b20" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="GraphQL" version="4.8.0" exclude="Build,Analyzers" />
        <dependency id="System.Reactive.Core" version="4.4.1" exclude="Build,Analyzers" />
        <dependency id="System.Reactive.Linq" version="4.4.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>