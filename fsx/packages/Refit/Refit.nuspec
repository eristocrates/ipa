<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>Refit</id>
    <version>15.2.0</version>
    <authors>ReactiveUI and Contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/reactiveui/refit</projectUrl>
    <description>Type-safe REST API clients for .NET, generated from annotated interfaces with build-time source generation, direct request construction, System.Text.Json defaults, and support for trimming and AOT.</description>
    <releaseNotes>https://github.com/reactiveui/refit/releases</releaseNotes>
    <copyright>Copyright (c) ReactiveUI and Contributors</copyright>
    <tags>refit rest http httpclient api-client typed-client source-generator roslyn system-text-json json aot trimming</tags>
    <repository type="git" url="https://github.com/reactiveui/refit" branch="refs/heads/main" commit="96316a6b121c72e8a77abb0cb1f38c2a0839cd86" />
