<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FsExcel</id>
    <version>0.0.49</version>
    <authors>Kit Eason</authors>
    <icon>logo.png</icon>
    <description>FsExcel is a library for generating Excel spreadsheets with F#, using very simple code.</description>
    <copyright>Kit Eason</copyright>
    <repository type="git" url="https://github.com/misterspeedy/FsExcel" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="ClosedXML" version="0.101.0" exclude="Build,Analyzers" />
        <dependency id="FSharp.Core" version="6.0.7" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>