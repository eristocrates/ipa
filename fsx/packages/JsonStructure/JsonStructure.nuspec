<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>JsonStructure</id>
    <version>0.8.0</version>
    <authors>JSON Structure Authors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <description>JSON Structure SDK for .NET - Validates JSON documents against JSON Structure schemas and provides schema export functionality.</description>
    <tags>json schema validation json-structure</tags>
    <repository type="git" url="https://github.com/json-structure/sdk" commit="675642cc1c24ba85b0208134e3f3ce1c6a51c585" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="System.Text.Json" version="10.0.5" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>