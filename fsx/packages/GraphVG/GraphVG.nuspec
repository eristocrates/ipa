<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>GraphVG</id>
    <version>0.1.1</version>
    <title>GraphVG</title>
    <authors>Chris Nikkel</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/ChrisNikkel/GraphVG</projectUrl>
    <description>Generate SVG graphs and charts in F# using SharpVG</description>
    <releaseNotes>See CHANGELOG.md at https://github.com/ChrisNikkel/GraphVG/blob/main/CHANGELOG.md</releaseNotes>
    <copyright>Copyright © Chris Nikkel 2026</copyright>
    <tags>Graphics, F#, SVG, charts, graphs, data visualization</tags>
    <repository type="git" url="https://github.com/ChrisNikkel/GraphVG.git" branch="refs/heads/main" commit="8a8e869df69fe948df7420b42a8ca8e11d6080b3" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="FSharp.Core" version="9.0.303" exclude="Build,Analyzers" />
        <dependency id="MathNet.Symbolics" version="0.25.0" exclude="Build,Analyzers" />
        <dependency id="SharpVG" version="0.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>