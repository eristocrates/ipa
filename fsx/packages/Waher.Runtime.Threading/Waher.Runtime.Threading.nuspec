    <repository type="GitHub" url="https://github.com/PeterWaher/IoTGateway" commit="60cf1163d559ac0cccade7f6a9a76e76744f8d64" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Waher.Events" version="1.4.6" exclude="Build,Analyzers" />
        <dependency id="Waher.Runtime.Cache" version="2.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Net.Http" version="4.3.4" exclude="Build,Analyzers" />
        <dependency id="System.Text.RegularExpressions" version="4.3.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>