<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ModelingEvolution.FileSystem</id>
    <version>2.3.1</version>
    <title>ModelingEvolution.FileSystem</title>
    <authors>ModelingEvolution</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/modelingevolution/fs</projectUrl>
    <description>Strongly-typed file system path handling with AbsolutePath and RelativePath value types. Features intuitive path arithmetic operators (Relative + Relative, Absolute + Relative, Absolute - Absolute), cross-platform normalization, IParsable support, and JSON serialization.</description>
    <tags>filesystem path filepath absolute relative cross-platform value-type ddd</tags>
    <repository type="git" url="https://github.com/modelingevolution/fs" commit="768903428d28e04f7dced9fba76c99631ea82193" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="ModelingEvolution.JsonParsableConverter" version="1.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>