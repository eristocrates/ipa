<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>JmesPath.Net</id>
    <version>1.1.0</version>
    <authors>Jeremie Devillard,Maxime Labelle</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <projectUrl>https://github.com/jmespath-community/csharp-jmespath</projectUrl>
    <description>JmesPath.Net is a fully compliant JMESPATH parser.</description>
    <tags>jmespath json</tags>
    <repository type="git" commit="91baddb403a89d6e02c5d70d61e9376ab8618979" />
    <dependencies>
      <group targetFramework=".NETFramework4.5">
        <dependency id="JmesPath.Net.Parser" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard1.3">
        <dependency id="JmesPath.Net.Parser" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.TypeExtensions" version="4.7.0" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="JmesPath.Net.Parser" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="JmesPath.Net.Parser" version="1.1.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.5" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.5" />
    </frameworkAssemblies>
  </metadata>
</package>