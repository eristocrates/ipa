<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>SimpleCrawler.Core</id>
    <version>4.1.0</version>
    <authors>Sven-Erik Jonsson</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/svenrog/SimpleCrawler</projectUrl>
    <description>Engine-agnostic core of SimpleCrawler: parallel single-domain crawling, robots.txt/sitemap parsing, and the pluggable HTML/rendering backend abstractions.</description>
    <copyright>Copyright © Sven-Erik Jonsson</copyright>
    <tags>crawler web-crawler scraper scraping robots-txt sitemap load-testing</tags>
    <repository type="git" url="https://github.com/svenrog/SimpleCrawler" commit="8ed708cded0f28be00afe7b1837f316362303fc5" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Options" version="10.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>