<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Rdf.Vocabularies</id>
    <version>1.4.0</version>
    <authors>Tomasz Pluskiewicz T+Code</authors>
    <owners>Tomasz Pluskiewicz T+Code</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectUrl>https://github.com/wikibus/Rdf.Vocabularies</projectUrl>
    <iconUrl>http://www.w3.org/RDF/icons/rdf_w3c_icon.64</iconUrl>
    <description>Statically typed classes generated from various RDF Vocabularies or OWL Ontologies</description>
    <copyright>Copyright 2016-2019 Tomasz Pluskiewicz</copyright>
    <tags>rdf semantic web</tags>
    <dependencies>
      <group targetFramework=".NETStandard1.1">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>