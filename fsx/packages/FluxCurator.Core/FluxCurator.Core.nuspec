<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FluxCurator.Core</id>
    <version>0.8.1</version>
    <authors>Iyulab</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/iyulab/FluxCurator</projectUrl>
    <description>Core library for FluxCurator - Minimal dependencies. PII masking, content filtering, and rule-based chunking with Korean language support.</description>
    <tags>rag chunking pii masking nlp korean text-processing preprocessing</tags>
    <repository type="git" url="https://github.com/iyulab/FluxCurator" commit="eb77bd457ba6fc2a91368b8c4123065b34595d5a" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Flux.Abstractions" version="0.24.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>