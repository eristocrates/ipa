<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>ModelingEvolution.Ipv4</id>
    <version>1.1.4</version>
    <title>IPv4 Address and Network Utilities</title>
    <authors>ModelingEvolution</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/modelingevolution/ipv4</projectUrl>
    <description>A lightweight and high-performance IPv4 address library for .NET. Provides strongly-typed IPv4 addresses, network calculations, CIDR notation support, and JSON serialization. Perfect for network programming, configuration management, and Domain-Driven Design applications.</description>
    <copyright>Copyright © ModelingEvolution 2025</copyright>
    <tags>ipv4 ip address network cidr networking json parsable ddd domain-driven-design</tags>
    <repository type="git" url="https://github.com/modelingevolution/ipv4" commit="461807fc7e46b6d49771f359f611a02f121f97f5" />
    <dependencies>
      <group targetFramework="net9.0">
        <dependency id="ModelingEvolution.JsonParsableConverter" version="1.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>