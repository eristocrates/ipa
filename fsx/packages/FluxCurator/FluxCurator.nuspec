<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FluxCurator</id>
    <version>0.8.1</version>
    <authors>Iyulab</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/iyulab/FluxCurator</projectUrl>
    <description>Text preprocessing library for RAG pipelines: PII masking, content filtering, and intelligent chunking including semantic chunking with Korean language support.</description>
    <tags>rag chunking pii masking nlp korean text-processing preprocessing semantic</tags>
    <repository type="git" url="https://github.com/iyulab/FluxCurator" commit="eb77bd457ba6fc2a91368b8c4123065b34595d5a" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="FluxCurator.Core" version="0.8.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="10.0.8" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>