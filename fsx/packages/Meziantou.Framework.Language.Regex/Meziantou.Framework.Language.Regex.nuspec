<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Meziantou.Framework.Language.Regex</id>
    <version>4.0.0</version>
    <authors>meziantou</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/meziantou/Meziantou.Framework</projectUrl>
    <description>Immutable, round-trip regular-expression pattern concrete syntax tree for .NET, JavaScript, PCRE/Perl, and POSIX ERE/BRE, with diagnostics, trivia, source locations, and editing helpers.</description>
    <tags>regex, syntax-tree, cst, parser, pcre</tags>
    <repository type="git" url="https://github.com/meziantou/Meziantou.Framework" branch="refs/heads/main" commit="e0d5562559e16a4c35bb78c8a01251345e7ad03f" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Meziantou.Framework.Language" version="1.1.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net11.0">
        <dependency id="Meziantou.Framework.Language" version="1.1.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>