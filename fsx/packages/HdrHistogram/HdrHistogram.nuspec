<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>HdrHistogram</id>
    <version>2.5.0</version>
    <authors>Gil Tene, Lee Campbell</authors>
    <owners>Gil Tene, Lee Campbell</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <licenseUrl>https://raw.githubusercontent.com/HdrHistogram/HdrHistogram.NET/master/LICENSE.txt</licenseUrl>
    <projectUrl>https://github.com/HdrHistogram/HdrHistogram.NET</projectUrl>
    <iconUrl>http://hdrhistogram.github.io/HdrHistogram.NET/HdrHistogram-icon-64x64.png</iconUrl>
    <description>HdrHistogram supports low latency recording and analyzing of sampled data value counts across a configurable integer value range with configurable value precision within the range.</description>
    <releaseNotes>NetStandard release</releaseNotes>
    <copyright>Copyright 2017</copyright>
    <tags>HdrHistogram HdrHistogram.NET Histogram Instrumentation</tags>
    <repository type="git" url="https://github.com/HdrHistogram/HdrHistogram.NET" />
    <dependencies>
      <group targetFramework=".NETFramework4.5" />
      <group targetFramework=".NETStandard1.3">
        <dependency id="NETStandard.Library" version="1.6.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>