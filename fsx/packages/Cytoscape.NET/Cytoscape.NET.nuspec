<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Cytoscape.NET</id>
    <version>0.2.0</version>
    <authors>Timo Muehlhaus, Kevin Schneider, fslab contributors</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <projectUrl>https://fslab.org/Cytoscape.NET/</projectUrl>
    <description>.NET interface for Cytoscape.js written in F#</description>
    <releaseNotes>- `Cytoscape.NET.Interactive`: fix require js function name</releaseNotes>
    <tags>cytoscape graph visualisation fsharp csharp dotnet</tags>
    <repository type="git" url="https://github.com/fslaborg/Cytoscape.NET" commit="889bb3482f07547f5b8545ea432e8be796d1bc6a" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="DynamicObj" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="FSharp.Core" version="6.0.7" exclude="Build,Analyzers" />
        <dependency id="Giraffe.ViewEngine" version="1.4.0" exclude="Build,Analyzers" />
        <dependency id="Newtonsoft.Json" version="13.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>