<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Waher.Content.Html</id>
    <version>3.2.3</version>
    <authors>Peter Waher</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>Icon_64x64.png</icon>
    <projectUrl>https://github.com/PeterWaher/IoTGateway/tree/master/Content/Waher.Content.Html</projectUrl>
    <description>Provides a simple HTML document parser that can be used to extract information from web pages. Social Meta-data can be easily extracted from page. Information is taken from Open Graph meta data or Twitter Card meta data, as well as standard HTML meta data.</description>
    <copyright>Copyright © Waher Data AB 2018-2026. All rights reserved.</copyright>
    <tags>Parser HTML Open Graph OG Twitter Card MetaData Meta</tags>
    <repository type="GitHub" url="https://github.com/PeterWaher/IoTGateway" commit="e0ec7a79c3c0e4753b0bb2f07d1f55440ef53aac" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Waher.Content.Xml" version="3.1.7" exclude="Build,Analyzers" />
        <dependency id="Waher.Content" version="3.6.3" exclude="Build,Analyzers" />
        <dependency id="System.Net.Http" version="4.3.4" exclude="Build,Analyzers" />
        <dependency id="System.Text.RegularExpressions" version="4.3.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>