<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>OWLSharp.Extensions</id>
    <version>5.0.0</version>
    <title>OWLSharp.Extensions</title>
    <authors>Marco De Salvo</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <projectUrl>https://github.com/mdesalvo/OWLSharp.Extensions</projectUrl>
    <description>OWLSharp extensions for working with LinkedData ontologies and vocabularies (SKOS, GEOSPARQL, OWL-TIME)</description>
    <copyright>Marco De Salvo</copyright>
    <tags>skos geosparql owl-time ontology reasoner inference</tags>
    <repository type="git" url="https://github.com/mdesalvo/OWLSharp.Extensions.git" branch="refs/heads/master" commit="893f0a2ac91544f0a7570cbc5efe4deb7c09d2fc" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="OWLSharp" version="5.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="OWLSharp" version="5.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>