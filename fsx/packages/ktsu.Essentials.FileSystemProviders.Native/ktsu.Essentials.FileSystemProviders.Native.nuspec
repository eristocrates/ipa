    <id>ktsu.Essentials.FileSystemProviders.Native</id>
    <version>2.5.2</version>
    <title>ktsu.Essentials.FileSystemProviders.Native</title>
    <authors>ktsu.dev contributors</authors>
    <license type="file">LICENSE.md</license>
