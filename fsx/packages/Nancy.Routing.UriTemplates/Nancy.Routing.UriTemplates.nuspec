<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Nancy.Routing.UriTemplates</id>
    <version>2.0.0</version>
    <authors>Tomasz Pluskiewicz</authors>
    <owners>Tomasz Pluskiewicz</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>URI Template (RFC 6570) routing for Nancy</description>
    <copyright>2014-2019 Tomasz Pluskiewicz</copyright>
    <tags>nancy routing uri template rfc6570</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.5.2">
        <dependency id="Nancy" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="StyleCop.Analyzers" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="UriTemplate.Core" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="UriTemplateString" version="0.2.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Nancy" version="2.0.0" exclude="Build,Analyzers" />
        <dependency id="StyleCop.Analyzers" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="System.ComponentModel" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="UriTemplate.Core" version="1.0.2" exclude="Build,Analyzers" />
        <dependency id="UriTemplateString" version="0.2.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>