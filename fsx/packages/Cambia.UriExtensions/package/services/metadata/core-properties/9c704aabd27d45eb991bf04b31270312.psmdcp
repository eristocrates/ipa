<?xml version="1.0" encoding="utf-8"?><coreProperties xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.openxmlformats.org/package/2006/metadata/core-properties"><dc:creator>Steve Lautenschlager</dc:creator><dc:description>Extensions for the .NET URI class.  Get, set, drop, update URI parts, query items and path items.  Fluent interface.  No more worrying about part delimiters.</dc:description><dc:identifier>Cambia.UriExtensions</dc:identifier><version>2.1.0</version><keywords>.net uri class build change extract scheme authority user info port path query fragment http https ftp mailto file url transform fluent interface</keywords><dc:title>Cambia.UriExtensions</dc:title><lastModifiedBy>NuGet, Version=3.3.0.212, Culture=neutral, PublicKeyToken=31bf3856ad364e35;Microsoft Windows NT 6.2.9200.0;.NET Framework 4.5</lastModifiedBy></coreProperties>