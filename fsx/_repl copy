let pathDelimiters = [| '/'; '\\' |]
let lexicalDelimiters = [| '-'; '.'; '+'; '/' |]


type String with
    member this.pathTokens =
        this.Split(pathDelimiters, StringSplitOptions.TrimEntries)
        |> Array.choose (fun segment -> Option.ofNullOrWhiteSpace segment)
    member this.lexicalTokens =
        this.Split(lexicalDelimiters, StringSplitOptions.TrimEntries)
        |> Array.choose (fun segment -> Option.ofNullOrWhiteSpace segment)



