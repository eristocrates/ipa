let predicateObjectList<'Assertion when 'Assertion :> OWLAssertionAxiom> (propertyObjectList: list<OWLNamedIndividual -> 'Assertion>) (namedIndividual: OWLNamedIndividual) =
    propertyObjectList
    |> List.map (fun predicateObject -> namedIndividual |> predicateObject :> OWLAssertionAxiom)

let (||>) (namedIndividual: OWLNamedIndividual) (properties: list<OWLNamedIndividual -> 'Assertion>) =
    predicateObjectList properties namedIndividual
let predicateListObject<'Assertion when 'Assertion :> OWLAssertionAxiom>
    (properties: list<'Literal -> OWLNamedIndividual -> 'Assertion>)
    (literal: 'Literal)
    : list<OWLNamedIndividual -> 'Assertion> =
    properties |> List.map (fun property -> property literal)

