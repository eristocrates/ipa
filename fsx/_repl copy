type Nager.PublicSuffix.DomainInfo with

    member this.topLevelDomain = this.TopLevelDomainRule
    member this.secondLevelDomain = this.Domain
    member this.subdomain = Option.ofNullOrWhiteSpace this.Subdomain
    member this.dnsDomain = this.RegistrableDomain
    member this.domainName = this.FullyQualifiedDomainName
    member this.reverseDomainName =
        match this.subdomain with
        | Some subdomain -> Path.Combine(this.topLevelDomain.Name, this.secondLevelDomain, subdomain)
        | None -> Path.Combine(this.topLevelDomain.Name, this.secondLevelDomain)

    member this.ipAddresses =
        try
            Dns.GetHostAddresses this.dnsDomain
        with _ -> [||]




type LocalComputer() =
    let _publicIPAddress =
        http { GET "https://api.ipify.org" }
        |> Request.send
        |> Response.toText
        |> IPAddress.Parse
    let _localIPAddress =
        NetworkInterface.GetAllNetworkInterfaces()
        |> Seq.collect (fun networkInterface -> networkInterface.GetIPProperties().UnicastAddresses)
        |> Seq.map (fun unicastIp -> unicastIp.Address)
        |> Seq.pick (fun ipAddress ->
            if ipAddress.AddressFamily = AddressFamily.InterNetwork then
                Some ipAddress
            else
                None)
    member this.machineName = Environment.MachineName
    member this.hardDrives = DriveInfo.GetDrives()
    member this.hostName = Dns.GetHostName()
    member this.hostAddresses = Dns.GetHostAddresses this.hostName
    member this.hardDriveByLetter =
        this.hardDrives
        |> Array.map (fun hardDrive -> hardDrive.Name[0], hardDrive)
        |> Map.ofArray
    member this.networkInterfaces = NetworkInterface.GetAllNetworkInterfaces()
    member this.unicastIPAddresses =
        this.networkInterfaces
        |> Array.collect (fun networkInterface -> networkInterface.GetIPProperties().UnicastAddresses |> Seq.toArray)
    member this.localIPAddress = _localIPAddress
    member this.publicIPAddress = _publicIPAddress
