y.ResultOffset <- offset\r\n            query.MaxFeatures <- int this.LayerInfo.MaxRecordCount\r\n            let features =\r\n                this.QueryFeaturesAsync(query, Data.QueryFeatureFields.LoadAll)\r\n                |> Async.AwaitTask\r\n                |> Async.RunSynchronously\r\n                |> Seq.toArray\r\n            if features.Length = 0 then\r\n                Array.empty\r\n            else\r\n                this.FeatureQuery(offset + features.Length) |> Array.append features\r\n        |]\r\ntype Data.FeatureTable with\r\n    member this.fieldMap =\r\n        this.Fields\r\n        |> Seq.map (fun field -> field.Name, field)\r\n        |> Map.ofSeq\r\ntype FeatureAttribute =\r\n    /// \"A binary large object.\"\r\n    | BlobField of obj option\r\n    /// \"A date time value. Shapefile formats do not store the time component.\"\r\n    | DateField of DateTime option\r\n    /// \"A date only value.\"\r\n    | DateOnlyField of DateOnly option\r\n    /// \"A float value.\"\r\n    | Float32Field of single option\r\n    /// \"A double value.\"\r\n    | Float64Field of double option\r\n    /// \"A geometry value.\"\r\n    | GeometryField of Geometry.Geometry option\r\n    /// \"An esri global ID value.\"\r\n    | GlobalIDField of Guid\r\n    /// \"Globally Unique Identifier value.\"\r\n    | GuidField of Guid option\r\n    /// \"A 16-bit integer value.\"\r\n    | Int16Field of Int16 option\r\n    /// \"A 32-bit integer value.\"\r\n    | Int32Field of Int32 option\r\n    /// \"A 64-bit integer value.\"\r\n    | Int64Field of Int64 option\r\n    /// \"An object ID value.\"\r\n    | OIDField of Int64\r\n    /// \"A raster value.\"\r\n    | RasterField of Rasters.Raster option\r\n    /// \"A string value.\"\r\n    | TextField of string option\r\n    /// \"A time only value.\"\r\n    | TimeOnlyField of TimeOnly option\r\n    /// \"A timestamp with offset.\" option\r\n    | TimestampOffsetField of DateTimeOffset option\r\n    /// \"An xml value.\"\r\n    | XmlField of XElement option\r\n    | DomainField of Data.CodedValueDomain * FeatureAttribute\r\n    | UnknownField of obj option\r\ntype FeatureGeometry =\r\n    | EnvelopeGeometry of Geometry.Envelope\r\n    | MapPointGeometry of Geometry.MapPoint\r\n    | MultipartGeometry of Geometry.Multipart\r\n    | MultipointGeometry of Geometry.Multipoint\r\nlet optional<'T> (valueObject: obj) : 'T option =\r\n    valueObject\r\n    |> Option.ofObj\r\n    |> Option.map unbox<'T>\r\ntype Data.Feature with\r\n    member this.attributes =\r\n        this.Attributes\r\n        |> Seq.map (|KeyValue|)\r\n        |> Seq.map (fun (key, value) ->\r\n            let field = this.FeatureTable.fieldMap[key]\r\n            let attribute =\r\n                match Option.ofObj field.Domain, field.FieldType with\r\n    (*\r\n                | Some (:? Data.CodedValueDomain as domain), _ -> let codedValue = value\r\n                        |> Option.ofObj\r\n                        |> Option.map (fun code -> domain.CodedValues |> Seq.find (fun codedValue -> Object.Equals(codedValue.Code, code)))\r\n                    CodedValueField codedValue\r\n    *)\r\n                | None, Data.FieldType.Blob -> BlobField (Option.ofObj value)\r\n                | None, Data.FieldType.Date -> DateField (optional<DateTime> value)\r\n                | None, Data.FieldType.DateOnly -> DateOnlyField (optional<DateOnly> value)\r\n                | None, Data.FieldType.Float32 -> Float32Field (optional<single> value)\r\n                | None, Data.FieldType.Float64 -> Float64Field (optional<double> value)\r\n                | None, Data.FieldType.Geometry -> GeometryField (optional<Geometry.Geometry> value)\r\n                | None, Data.FieldType.GlobalID -> GlobalIDField (unbox<Guid> value)\r\n                | None, Data.FieldType.Guid -> GuidField (optional<Guid> value)\r\n                | None, Data.FieldType.Int16 -> Int16Field (optional<Int16> value)\r\n                | None, Data.FieldType.Int32 -> Int32Field (optional<Int32> value)\r\n                | None, Data.FieldType.Int64 -> Int64Field (optional<Int64> value)\r\n                | None, Data.FieldType.OID -> OIDField (unbox<Int64> value)\r\n                | None, Data.FieldType.Raster -> RasterField (optional<Rasters.Raster> value)\r\n                | None, Data.FieldType.Text -> TextField (optional<string> value)\r\n                | None, Data.FieldType.TimeOnly -> TimeOnlyField (optional<TimeOnly> value)\r\n                | None, Data.FieldType.TimestampOffset -> TimestampOffsetField (optional<DateTimeOffset> value)\r\n                | _, _ -> UnknownField (Option.ofObj value)\r\n            field, attribute\r\n        )\r\n        |> Seq.toArray\r\n    member this.unkownAttributes = this.attributes |> Array.filter (fun (field, attribute) -> attribute.IsUnknownField)\r\n    member this.geometry =\r\n        match this.Geometry with\r\n        | :? Geometry.Envelope as envelope -> EnvelopeGeometry envelope\r\n        | :? Geometry.MapPoint as mapPoint -> MapPointGeometry mapPoint\r\n        | :? Geometry.Multipart as multipart -> MultipartGeometry multipart\r\n        | :? Geometry.Multipoint as multipoint -> MultipointGeometry multipoint\r\ntype StormwaterFeature =\r\n    | StormwaterFeature of Data.Feature\r\n    member this.feature =\r\n        match this with\r\n        | StormwaterFeature feature -> feature\r\n    member this.attributes  = this.feature.attributes\r\n    member this.attributeMap = this.attributes |> Array.map (fun (field, attribute) -> field.Name, (field, attribute)) |> Map.ofArray\r\n    member this.geometry =\r\n        this.feature.geometry\r\ntype FeatureClass = {\r\n    table: Data.ServiceFeatureTable\r\n    features: seq<Data.Feature>\r\n}\r\nlet featureTables =\r\n    StormwaterInfrastructure.Sublayers\r\n    |> Seq.cast<Mapping.ArcGISMapImageSublayer>\r\n    |> Seq.collect (fun sublayer ->\r\n        sublayer.Sublayers\r\n        |> Seq.cast<Mapping.ArcGISMapImageSublayer>\r\n        |> Seq.insertAt 0 sublayer)\r\n    |> Seq.choose (fun sublayer -> Option.ofObj sublayer.Table)\r\n    |> Seq.toArray\r\ntype Data.Feature with\r\n    member this.OBJECTID = unbox<Int64> this.Attributes[\"OBJECTID\"]\r\n    member this.UNITID = optional<string> this.Attributes[\"UNITID\"]\r\n    member this.COMPKEY = optional<Int32> this.Attributes[\"COMPKEY\"]\r\n\r\nlet features =\r\n    featureTables\r\n    |> Array.collect (fun table -> table.FeatureQuery 0)\r\n(*\r\nfeatureTables[0].Fields\r\n|> Seq.map (fun field ->\r\n    let recordFieldType =\r\n        match field.FieldType with\r\n        | Data.FieldType.Blob -> \"obj\"\r\n        | Data.FieldType.Date -> \"DateTime\"\r\n        | Data.FieldType.DateOnly -> \"DateOnly\"\r\n        | Data.FieldType.Float32 -> \"single\"\r\n        | Data.FieldType.Float64 -> \"double\"\r\n        | Data.FieldType.Geometry -> \"Geometry.Geometry\"\r\n        | Data.FieldType.GlobalID -> \"Guid\"\r\n        | Data.FieldType.Guid -> \"Guid\"\r\n        | Data.FieldType.Int16 -> \"Int16\"\r\n        | Data.FieldType.Int32 -> \"Int32\"\r\n        | Data.FieldType.Int64 -> \"Int64\"\r\n        | Data.FieldType.OID -> \"Int64\"\r\n        | Data.FieldType.Raster -> \"Rasters.Raster\"\r\n        | Data.FieldType.Text -> \"string\"\r\n        | Data.FieldType.TimeOnly -> \"TimeOnly\"\r\n        | Data.FieldType.TimestampOffset -> \"DateTimeOffset\"\r\n        | Data.FieldType.Xml -> \"XElement\"\r\n        | _ -> \"obj\"\r\n    if field.IsNullable then\r\n        $\"{field.Name} : {recordFieldType} option\"\r\n    else\r\n        $\"{field.Name} : {recordFieldType}\"\r\n)\r\n|> String.Clipboard.clip\r\n*)\r\n\r\nmodule InforTest =\r\n    let Connect () =\r\n        let connection =\r\n            new Microsoft.Data.SqlClient.SqlConnection(\r\n                \"ApplicationIntent=ReadOnly;Server=InforTestSql;Database=test;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True\"\r\n            )\r\n        connection.Open()\r\n        connection\r\nlet assetFeatures =\r\n    select {\r\n        for asset in table<dbo.lc_stormwater_infrastructure> do\r\n            selectAll\r\n    }\r\n    |> InforTest.Connect().SelectAsync<dbo.lc_stormwater_infrastructure>\r\n    |> Async.AwaitTask\r\n    |> Async.RunSynchronously\r\n    |> Seq.toArray\r\nlet featureCompKeys =\r\n    assetFeatures\r\n    |> Array.filter (fun assetFeature -> assetFeature.COMPKEY <> 1 )\r\n    |> Array.map (fun assetFeature -> assetFeature.UNITID.TrimStart('''), assetFeature.COMPKEY)\r\n    |> Map.ofArray\r\nlet assetFeature = assetFeatures[20000]\r\nlet feature = \r\n    features\r\n    |> Array.filter (fun feature -> \r\n            match feature.UNITID with\r\n            | Some unitId -> true\r\n            | None -> false\r\n\r\n    )\r\n    |> Array.Parallel.tryFind (fun feature ->\r\n    match feature.UNITID with\r\n    | Some unitId -> assetFeature.UNITID = unitId\r\n    | None -> false\r\n    )\r\nassetFeatures\r\ntype OutFallFeature =\r\n    {\r\n    OBJECTID : Int64\r\n    FACILITYID : string option\r\n    ATTACHEDTOID : string option\r\n    UPSTREAMSTUCTUREID : string option\r\n    OUTFALLTYPE : string option\r\n    WATERBODYNAME : string option\r\n    WBID : string option\r\n    DRAINAGEBASIN : string option\r\n    NOTES : string option\r\n    STRUCTURETYPE : string option\r\n    OUTFALLID : string option\r\n    UNITID : string option\r\n    COMPKEY : Int32 option\r\n}\r\n\r\n(*\r\n    member this.X =\r\n        match this.featureGeometry with\r\n        | :? Geometry.MapPoint as mapPoint -> string mapPoint.X\r\n        | _ -> String.Empty\r\n    member this.Y =\r\n        match this.feature.Geometry with\r\n        | :? Geometry.MapPoint as mapPoint -> string mapPoint.Y\r\n        | _ -> String.Empty\r\n    member this.Z =\r\n        match this.feature.Geometry with\r\n        | :? Geometry.MapPoint as mapPoint -> string mapPoint.Z\r\n        | _ -> String.Empty\r\n\r\n    member this.AddressQualifier = defaultArg this.LOCATION String.Empty\r\n    member this.Organization = defaultArg this.MAINTBY String.Empty\r\n    member this.UnitDesc = defaultArg this.NOTES String.Empty\r\n    member this.Area = defaultArg this.OUTFALLID String.Empty\r\n    member this.Ownership = defaultArg this.OWNER String.Empty\r\n    member this.ID = defaultArg this.UNITID String.Empty\r\n    member this.ZCoordinate = defaultArg this.ZVALUE String.Empty\r\n    member this.UnitType = defaultArg this.PONDTYPE String.Empty\r\n    member this.ACCEPT_DATE =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ACCEPT_DATE\" then Some value else None)\r\n    member this.ACCURACYCODE =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ACCURACYCODE\" then Some value else None)\r\n    member this.ACREAGE =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ACREAGE\" then Some value else None)\r\n    member this.ACRES =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ACRES\" then Some value else None)\r\n    member this.ACTIVITY =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ACTIVITY\" then Some value else None)\r\n    member this.ANCILLARYROLE =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ANCILLARYROLE\" then Some value else None)\r\n    member this.ATTACHEDTOID =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ATTACHEDTOID\" then Some value else None)\r\n    member this.ATTRIBUTECOMPLETE =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"ATTRIBUTECOMPLETE\" then Some value else None)\r\n    member this.CAPACITY =\r\n        this.attributes\r\n        |> Array.tryPick (fun (key, value) -> if key = \"CAPACITY\" then Some value else None)\r\n    member this.