                                                Ast.Value("site", Ast.ConstantExpr "scheme |> www secondLevelDomain topLevelDomain")
                                            else
                                                Ast.Value("site", Ast.ConstantExpr $"site .+ \"{subdomain}\"")
                                        }
                                    | None -> ()
                                }
                            | None -> ()
                        }
                    | None -> ()
                }
            }
