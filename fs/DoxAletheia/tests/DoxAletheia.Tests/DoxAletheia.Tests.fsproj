<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="DoxAletheia.Tests.fs" />
		<None Include="paket.references" />
	</ItemGroup>

	<ItemGroup>

		<ProjectReference Include="..\..\src\DoxAletheia.Runtime\DoxAletheia.Runtime.fsproj" />

		<ProjectReference Include="..\..\src\DoxAletheia.DesignTime\DoxAletheia.DesignTime.fsproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
		</ProjectReference>

	</ItemGroup>

	<ItemGroup>
		<FscCompilerTools Include="$(MSBuildProjectDirectory)\..\..\src\DoxAletheia.DesignTime\bin\$(Configuration)\net8.0" />
	</ItemGroup>

	<Import Project="..\..\.paket\Paket.Restore.targets" />

</Project>