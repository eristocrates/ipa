source https://api.nuget.org/v3/index.json

nuget Ada.Url
nuget AW.Identifiers
nuget BrowserApi
nuget dotNetRdf
nuget Dubzer.WhatwgUrl
nuget Flurl

nuget FolkerKinzel.MimeTypes
nuget FSharp.Data
nuget FSharp.HashCollections
nuget FSharp.ViewEngine
nuget FSharpPlus
nuget IriTools
nuget LitXml
nuget Meziantou.Framework
nuget Meziantou.Framework.Uri
nuget Mime-Detective
nuget Mime-Detective.Definitions.Exhaustive
nuget Nager.PublicSuffix
nuget NLanguageTag
nuget OWLSharp
nuget OWLSharp.Extensions
nuget RDFSharp
nuget Tavis.UriTemplates
nuget VDS.Common
nuget System.Data.SqlClient
nuget TypeShape
nuget Microsoft.Extensions.Configuration = 10.0.8
nuget Microsoft.Extensions.Configuration.Abstractions = 10.0.8
nuget Fabulous.AST
nuget Fabulous.AST.Build
nuget NuGet.Protocol
nuget Newtonsoft.Json >= 13.0.0
nuget NuGet.CatalogReader
nuget ShapeSifter
nuget FSharp.Literals
nuget FSharp.SystemTextJson
nuget DynamicObj = 8.0.0
nuget DynamicObj.Immutable = 8.0.0

# These lines are used by Paket to get the latest version of the Type Provider SDK files
github fsprojects/FSharp.TypeProviders.SDK src/ProvidedTypes.fsi
github fsprojects/FSharp.TypeProviders.SDK src/ProvidedTypes.fs

group Test
    source https://api.nuget.org/v3/index.json

    nuget Microsoft.NET.Test.Sdk
    nuget NUnit
    nuget NUnit3TestAdapter version_in_path: true
