type NamedReference with
    member this.tryPrefixedName(namespaceName: NamespaceName) =
        match namespaceName.UrlPattern.Match this.identity |> Option.ofObj with
        | Some urlPatternMatch when namespaceName.localDelimiter = "#" ->
            namespaceName.prefixedName urlPatternMatch.Hash.Groups["localName"] |> Some
        | Some urlPatternMatch -> namespaceName.prefixedName urlPatternMatch.Pathname.Groups["localName"] |> Some
        | None -> None

    member this.localPart =
        match UrlPattern.Create(UrlPatternInit()).Match this.identity |> Option.ofObj with
        | Some urlPatternMatch when not (String.IsNullOrWhiteSpace urlPatternMatch.Hash.Input) ->
            urlPatternMatch.Hash.Input
        | Some urlPatternMatch -> urlPatternMatch.Pathname.Input.Split("/") |> Array.last
        | None -> "_"

