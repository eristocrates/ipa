type IGraph with
    member this.AllUriNodes =
        this.AllNodes
        |> Seq.choose (fun inode ->
            match inode with
            | :? UriNode as uriNode -> Some uriNode
            | _ -> None)

    member this.prefixedNames(namespaceName: NamespaceName) =
        this.AllUriNodes
        |> Seq.choose (fun uriNode ->

            match uriNode.tryNamedReference with
            | Some namedReference -> namedReference.tryPrefixedName namespaceName
            | None -> None)

