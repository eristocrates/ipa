    // Your own IRI/reference representation -> xsd:anyURI
    static member ofValue(value: NamedReference) =
        value.identity
        |> TypedLiteral.ofDatatype (iriref "http://www.w3.org/2001/XMLSchema#anyURI")

    // XmlQualifiedName -> xsd:QName
    static member ofValue(value: XmlQualifiedName) =
        value.ToString()
        |> TypedLiteral.ofDatatype (iriref "http://www.w3.org/2001/XMLSchema#QName")

    // Guid -> xsd:ID
    static member ofValue(value: Guid) =
        value.ToString("N")
        |> TypedLiteral.ofDatatype (iriref "http://www.w3.org/2001/XMLSchema#ID")

    static member ofAtomicValue(value: obj) =
        let lexicalForm =
            if isNull value then
                String.Empty
            else
                Convert.ToString(value, CultureInfo.InvariantCulture)

        lexicalForm
        |> TypedLiteral.ofDatatype (iriref "https://www.w3.org/2003/05/xpath-datatypes#anyAtomicType")

    static member nil =
        "true"
        |> TypedLiteral.ofDatatype (iriref "https://www.w3.org/2003/05/xpath-datatypes#nil")

