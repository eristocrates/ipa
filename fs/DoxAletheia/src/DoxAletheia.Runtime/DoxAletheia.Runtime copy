type NamespaceName with
    member this.namespaceUri = Uri this.identity
    member this.localDelimiter = this.identity.ToCharArray() |> Array.last |> string
    member this.UrlPattern = UrlPattern.Create(sprintf "%s{:localName}" this.identity)

    member this.delimiterName =
        match this.localDelimiter with
        | "/" -> "&sol;"
        | "#" -> "&num;"
        | _ -> String.Empty

    member this.reverseHostPath =
        this.namespaceUri.Host.Split('.') |> Array.rev |> String.concat "\\"

    member this.localDocumentPath =

        DriveInfo.preferredDrive.Name
        + this.namespaceUri.Scheme
        + "\\"
        + this.reverseHostPath
        + this.namespaceUri.LocalPath.Replace("/", "\\").TrimEnd('\\')
        + this.delimiterName
    member this.localTurtlePath =
        Path.Combine(this.localDocumentPath, "text", "turtle.ttl")

