    member this.toAnonymousReference =
        if not this.IsBlank then
            invalidArg (nameof this) "Resource is not blank."

        let blankNodeIri = this.URI.OriginalString

        { sinsignId =
            match Guid.TryParse this.URI.AbsolutePath with
            | true, guid -> guid
            | false, _ -> new Guid(MD5.HashData(Encoding.UTF8.GetBytes(this.URI.AbsolutePath)))

          localIdentifier = this.URI.OriginalString["bnode:".Length ..] }

type RDFLiteral with

    static member ofLiteralValue(literalValue: LiteralValue) =
        match literalValue with

        | PlainLiteral(LanguageLiteral languageString) when languageString.identity.languageTag.IsSome ->
            RDFPlainLiteral(languageString.identity.lexicalForm, languageString.identity.languageTag.Value)
            :> RDFLiteral
        | TypedLiteral typedLiteral ->
            RDFTypedLiteral(
                typedLiteral.identity.lexicalForm,
                RDFDatatypeRegister.GetDatatype typedLiteral.datatypeIri.identity
            )
            :> RDFLiteral
        | EmbeddedLiteral embeddedLiteral ->
            RDFTypedLiteral(
                embeddedLiteral.identity.lexicalForm,
                RDFDatatypeRegister.GetDatatype embeddedLiteral.datatypeIri.identity
            )
            :> RDFLiteral
        | _ -> RDFPlainLiteral(literalValue.identity.lexicalForm) :> RDFLiteral

    member this.toLiteralValue =
        match this with

        | :? RDFPlainLiteral as plainLiteral ->

            if not (plainLiteral.HasLanguage()) then
                { simpleString = plainLiteral.Value } |> SimpleLiteral |> PlainLiteral

            else
                let languageTag, baseDirection =
                    if plainLiteral.HasDirection() then

                        if plainLiteral.Language.EndsWith("--ltr", StringComparison.OrdinalIgnoreCase) then
                            plainLiteral.Language[.. plainLiteral.Language.Length - 6], Some Ltr

                        else
                            plainLiteral.Language[.. plainLiteral.Language.Length - 6], Some Rtl

                    else
                        plainLiteral.Language, None

                { lexicalForm = plainLiteral.Value
                  languageTag = LanguageTag.Parse languageTag
                  baseDirection = baseDirection }
                |> LanguageLiteral
                |> PlainLiteral

        | :? RDFTypedLiteral as typedLiteral ->

            let datatypeIri = typedLiteral.Datatype.URI.OriginalString |> IriReference |> IRIREF

            match datatypeIri.identity with

            | "http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML" ->
                { htmlString = typedLiteral.Value } |> EmbeddedHtml |> EmbeddedLiteral

            | "http://www.w3.org/1999/02/22-rdf-syntax-ns#XMLLiteral" ->
                { xmlString = typedLiteral.Value } |> EmbeddedXml |> EmbeddedLiteral

            | "http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON" ->
                { jsonString = typedLiteral.Value } |> EmbeddedJson |> EmbeddedLiteral

            | _ ->
                { lexicalForm = typedLiteral.Value
                  datatypeIri = datatypeIri }
                |> TypedLiteral

        | literal -> invalidArg (nameof this) $"Unsupported RDFLiteral type: {literal.GetType().FullName}"

type RDFTriple with

    member this.toTripleStatement =

        { curSubject =
            match this.Subject :?> RDFResource with
            | rdfResource when rdfResource.IsBlank -> AnonymousSubject rdfResource.toAnonymousReference
            | rdfResource -> NamedSubject rdfResource.NamedReference

          curPredicate = (this.Predicate :?> RDFResource).NamedReference |> NamedPredicate

          curObject =

            match this.Object with
            | :? RDFResource as rdfResource when rdfResource.IsBlank -> AnonymousObject rdfResource.toAnonymousReference
            | :? RDFResource as rdfResource -> NamedObject rdfResource.NamedReference
            | :? RDFLiteral as rdfLiteral -> rdfLiteral.toLiteralValue |> LiteralObject
            | value -> invalidArg (nameof this.Object) $"Unexpected RDFTriple object type: {value.GetType().FullName}" }

    static member ofTripleStatement(tripleStatement: TripleStatement) =

        match tripleStatement.curObject with
        | NamedObject iri ->
            new RDFTriple(
                RDFResource.ofSubjectVertex tripleStatement.curSubject,
                RDFResource.ofPredicateEdge tripleStatement.curPredicate,
                RDFResource.ofNamedReference iri
            )
        | AnonymousObject blankReference ->
            new RDFTriple(
                RDFResource.ofSubjectVertex tripleStatement.curSubject,
                RDFResource.ofPredicateEdge tripleStatement.curPredicate,
                RDFResource.ofAnonymousReference blankReference
            )
        | LiteralObject literalValue ->
            new RDFTriple(
                RDFResource.ofSubjectVertex tripleStatement.curSubject,
                RDFResource.ofPredicateEdge tripleStatement.curPredicate,
                RDFLiteral.ofLiteralValue literalValue
            )
        | TripleObject tripleTerm ->
            new RDFTriple(
                RDFResource.ofSubjectVertex tripleStatement.curSubject,
                RDFResource.ofPredicateEdge tripleStatement.curPredicate,
                (RDFTriple.ofTripleStatement tripleTerm).ReificationSubject
            )

