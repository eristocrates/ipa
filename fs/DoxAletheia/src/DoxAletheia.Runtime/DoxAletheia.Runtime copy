module ProviderRuntime =

    let namedReference (iri: string) : NamedReference = iri |> IriReference |> IRIREF

    let namedIndividual (iri: string) : OWLNamedIndividual =
        iri |> namedReference |> RDFResource.ofNamedReference |> OWLNamedIndividual

    let namedIndividualFromNamedReference (iri: NamedReference) : OWLNamedIndividual =

        iri |> RDFResource.ofNamedReference |> OWLNamedIndividual

    let objectProperty (iri: string) : OWLObjectProperty =
        iri |> namedReference |> RDFResource.ofNamedReference |> OWLObjectProperty

    let dataProperty (iri: string) : OWLDataProperty =
        iri |> namedReference |> RDFResource.ofNamedReference |> OWLDataProperty

    let annotationProperty (iri: string) : OWLAnnotationProperty =
        iri |> namedReference |> RDFResource.ofNamedReference |> OWLAnnotationProperty

    let rdfPropertyPredicate
        (iri: string)
        (objectVertex: ObjectVertex)
        (subjectVertex: SubjectVertex)
        : TripleStatement =

        { curSubject = subjectVertex

          curPredicate = iri |> namedReference |> NamedPredicate

          curObject = objectVertex }

    let owlLiteralOfLiteralValue (literalValue: LiteralValue) : OWLLiteral =

        literalValue |> RDFLiteral.ofLiteralValue |> OWLLiteral

    let rdfPropertyForNamedIndividual
        (propertyIri: string)
        (domainIndividual: OWLNamedIndividual)
        : ObjectVertex -> TripleStatement =

        let subject = domainIndividual.GetIRI().NamedReference |> NamedSubject

        fun objectVertex -> rdfPropertyPredicate propertyIri objectVertex subject

    let objectPropertyPredicate (iri: string) : OWLNamedIndividual -> OWLNamedIndividual -> OWLObjectPropertyAssertion =

        let property = objectProperty iri

        fun toIndividual -> property.Assert toIndividual

    let dataPropertyPredicate (iri: string) : OWLLiteral -> OWLNamedIndividual -> OWLDataPropertyAssertion =

        let property = dataProperty iri

        fun toLiteral -> property.Assert toLiteral

    let annotationLiteralPropertyPredicate (iri: string) : OWLLiteral -> RDFResource -> OWLAnnotationAssertion =

        let property = annotationProperty iri

        fun toAnnotationLiteral -> property.Assert toAnnotationLiteral

    let annotationResourcePropertyPredicate (iri: string) : RDFResource -> RDFResource -> OWLAnnotationAssertion =

        let property = annotationProperty iri

        fun toAnnotationResource -> property.Assert toAnnotationResource

