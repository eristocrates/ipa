    member this.tryNamedReference = this.Resource.tryNamedReference

type OntologyClass with

    member this.Classes =
        seq {
            yield this
            yield! this.SuperClasses
        }
        |> Seq.distinctBy _.Resource

    member this.propertiesForClass =
        this.Classes
        |> Seq.collect _.IsDomainOf
        |> Seq.distinctBy _.Resource
        |> Seq.choose (fun ontologyProperty ->
            ontologyProperty.tryNamedReference
            |> Option.map (fun namedReference -> namedReference, ontologyProperty))
        |> Map.ofSeq

    member this.namedInstances =
        this.Instances
        |> Seq.choose (fun ontologyResource -> ontologyResource.Resource.tryNamedReference)
        |> Seq.distinct
        |> Seq.sortBy _.identity
        |> Seq.toArray

type OntologyGraph with

    member this.classesForInstance(namedReference: NamedReference) =
        seq {
            yield! this.RdfClasses
            yield! this.OwlClasses
        }
        |> Seq.distinctBy _.Resource
        |> Seq.filter (fun ontologyClass ->
            ontologyClass.Instances
            |> Seq.exists (fun instance ->
                match instance.Resource.tryNamedReference with
                | Some instanceReference -> instanceReference = namedReference
                | None -> false))
        |> Seq.toArray

    member this.rdfProperties =
        this.RdfProperties
        |> Seq.choose (fun ontologyProperty ->
            ontologyProperty.tryNamedReference
            |> Option.map (fun namedReference -> namedReference, ontologyProperty))
        |> Map.ofSeq

    member this.owlObjectProperties =
