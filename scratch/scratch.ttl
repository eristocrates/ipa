@prefix commonplace: <https://eristocrates.dev/ontology/commonplace/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix fdcdata: <https://fdc.nal.usda.gov/fdc-datasets/> .
@prefix fx: <http://sparql.xyz/facade-x/ns/> .
@base <https://eristocrates.dev/ontology/commonplace/>.



foaf:age a owl:DatatypeProperty. 
foaf:familyName a owl:DatatypeProperty. 
foaf:firstName a owl:DatatypeProperty. 
foaf:knows a owl:ObjectProperty. 
foaf:lastName a owl:DatatypeProperty. 
foaf:nick a owl:DatatypeProperty. 
foaf:Person a owl:Class. 
foaf:surname a owl:DatatypeProperty. 
<https://eristocrates.dev/ontology/commonplace/> a owl:Ontology. 
commonplace:eristocrates a owl:NamedIndividual, foaf:Person; 
                         foaf:age "35"^^xsd:int; 
                         foaf:familyName "Collier"^^xsd:string; 
                         foaf:firstName "Brandon"^^xsd:string; 
                         foaf:knows commonplace:syrislove; 
                         foaf:lastName "Collier"^^xsd:string; 
                         foaf:nick "eristocrates"^^xsd:string; 
                         foaf:surname "Collier"^^xsd:string. 
commonplace:syrislove a owl:NamedIndividual, foaf:Person; 
                      foaf:age "33"^^xsd:int; 
                      foaf:familyName "Fisher"^^xsd:string; 
                      foaf:firstName "Tierra"^^xsd:string; 
                      foaf:knows commonplace:eristocrates; 
                      foaf:lastName "Fisher"^^xsd:string; 
                      foaf:nick "syrislove"^^xsd:string; 
                      foaf:surname "Fisher"^^xsd:string. 


@base <https://fdc.nal.usda.gov/fdc-datasets/> .
