        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DataIntersectionOf"
                 type="owl:DataIntersectionOf"></xsd:element>
    <xsd:complexType name="DataUnionOf">
        <xsd:complexContent>
            <xsd:extension base="owl:DataRange">
                <xsd:sequence>
                    <xsd:group ref="owl:DataRange"
                               minOccurs="2"
                               maxOccurs="unbounded"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DataUnionOf"
                 type="owl:DataUnionOf"></xsd:element>
    <xsd:complexType name="DataComplementOf">
        <xsd:complexContent>
            <xsd:extension base="owl:DataRange">
                <xsd:sequence>
                    <xsd:group ref="owl:DataRange"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DataComplementOf"
                 type="owl:DataComplementOf"></xsd:element>
    <xsd:complexType name="DataOneOf">
        <xsd:complexContent>
            <xsd:extension base="owl:DataRange">
                <xsd:sequence>
                    <xsd:element ref="owl:Literal"
                                 minOccurs="1"
                                 maxOccurs="unbounded"></xsd:element>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DataOneOf"
                 type="owl:DataOneOf"></xsd:element>
    <xsd:complexType name="DatatypeRestriction">
        <xsd:complexContent>
            <xsd:extension base="owl:DataRange">
                <xsd:sequence>
                    <xsd:element ref="owl:Datatype"></xsd:element>
                    <xsd:element name="FacetRestriction"
                                 type="owl:FacetRestriction"
                                 minOccurs="1"
                                 maxOccurs="unbounded"></xsd:element>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DatatypeRestriction"
                 type="owl:DatatypeRestriction"></xsd:element>
    <xsd:complexType name="FacetRestriction">
        <xsd:sequence>
            <xsd:element ref="owl:Literal"></xsd:element>
        </xsd:sequence>
        <xsd:attribute name="facet"
                       type="xsd:anyURI"
                       use="required"></xsd:attribute>
        <xsd:attributeGroup ref="xml:specialAttrs"></xsd:attributeGroup>
    </xsd:complexType>
