    <xsd:complexType name="SubClassOf">
        <xsd:complexContent>
            <xsd:extension base="owl:ClassAxiom">
                <xsd:sequence>
                    <xsd:group ref="owl:ClassExpression"></xsd:group>
                    <!-- This is the subexpression -->
                    <xsd:group ref="owl:ClassExpression"></xsd:group>
                    <!-- This is the superexpression -->
