    <!-- Key axioms -->
    <xsd:complexType name="HasKey">
        <xsd:complexContent>
            <xsd:extension base="owl:Axiom">
                <xsd:sequence>
                    <xsd:group ref="owl:ClassExpression"></xsd:group>
                    <xsd:group ref="owl:ObjectPropertyExpression"
                               minOccurs="0"
                               maxOccurs="unbounded"></xsd:group>
                    <xsd:group ref="owl:DataPropertyExpression"
                               minOccurs="0"
                               maxOccurs="unbounded"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="HasKey"
                 type="owl:HasKey"></xsd:element>
    <!-- Assertions -->
    <xsd:complexType name="Assertion"
                     abstract="true">
        <xsd:complexContent>
            <xsd:extension base="owl:Axiom"></xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="Assertion">
        <xsd:choice>
            <xsd:element ref="owl:SameIndividual"></xsd:element>
            <xsd:element ref="owl:DifferentIndividuals"></xsd:element>
            <xsd:element ref="owl:ClassAssertion"></xsd:element>
            <xsd:element ref="owl:ObjectPropertyAssertion"></xsd:element>
            <xsd:element ref="owl:NegativeObjectPropertyAssertion"></xsd:element>
            <xsd:element ref="owl:DataPropertyAssertion"></xsd:element>
            <xsd:element ref="owl:NegativeDataPropertyAssertion"></xsd:element>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="SameIndividual">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:Individual"
                               minOccurs="2"
                               maxOccurs="unbounded"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="SameIndividual"
                 type="owl:SameIndividual"></xsd:element>
    <xsd:complexType name="DifferentIndividuals">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:Individual"
                               minOccurs="2"
                               maxOccurs="unbounded"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DifferentIndividuals"
                 type="owl:DifferentIndividuals"></xsd:element>
    <xsd:complexType name="ClassAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:ClassExpression"></xsd:group>
                    <xsd:group ref="owl:Individual"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="ClassAssertion"
                 type="owl:ClassAssertion"></xsd:element>
    <xsd:complexType name="ObjectPropertyAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:ObjectPropertyExpression"></xsd:group>
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the source invididual -->
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the target individual -->
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="ObjectPropertyAssertion"
                 type="owl:ObjectPropertyAssertion"></xsd:element>
    <xsd:complexType name="NegativeObjectPropertyAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:ObjectPropertyExpression"></xsd:group>
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the source invididual -->
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the target individual -->
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="NegativeObjectPropertyAssertion"
                 type="owl:NegativeObjectPropertyAssertion"></xsd:element>
    <xsd:complexType name="DataPropertyAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:DataPropertyExpression"></xsd:group>
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the source invididual -->
                    <xsd:element ref="owl:Literal"></xsd:element>
                    <!-- This is the target individual -->
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="DataPropertyAssertion"
                 type="owl:DataPropertyAssertion"></xsd:element>
    <xsd:complexType name="NegativeDataPropertyAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:Assertion">
                <xsd:sequence>
                    <xsd:group ref="owl:DataPropertyExpression"></xsd:group>
                    <xsd:group ref="owl:Individual"></xsd:group>
                    <!-- This is the source invididual -->
                    <xsd:element ref="owl:Literal"></xsd:element>
                    <!-- This is the target individual -->
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="NegativeDataPropertyAssertion"
                 type="owl:NegativeDataPropertyAssertion"></xsd:element>
    <!-- Annotations -->
    <xsd:complexType name="IRI">
        <xsd:simpleContent>
            <xsd:extension base="xsd:anyURI">
                <xsd:attributeGroup ref="xml:specialAttrs"></xsd:attributeGroup>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>
    <xsd:element name="IRI"
                 type="owl:IRI"></xsd:element>
    <xsd:complexType name="AbbreviatedIRI">
        <xsd:simpleContent>
            <xsd:extension base="owl:abbreviatedIRI">
                <xsd:attributeGroup ref="xml:specialAttrs"></xsd:attributeGroup>
            </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>
    <xsd:element name="AbbreviatedIRI"
                 type="owl:AbbreviatedIRI"></xsd:element>
    <xsd:group name="AnnotationSubject">
        <xsd:choice>
            <xsd:element ref="owl:IRI"></xsd:element>
            <xsd:element ref="owl:AbbreviatedIRI"></xsd:element>
            <xsd:element ref="owl:AnonymousIndividual"></xsd:element>
        </xsd:choice>
    </xsd:group>
    <xsd:group name="AnnotationValue">
        <xsd:choice>
            <xsd:element ref="owl:IRI"></xsd:element>
            <xsd:element ref="owl:AbbreviatedIRI"></xsd:element>
            <xsd:element ref="owl:AnonymousIndividual"></xsd:element>
            <xsd:element ref="owl:Literal"></xsd:element>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="Annotation">
        <xsd:sequence>
            <xsd:group ref="owl:annotationAnnotations"></xsd:group>
            <xsd:element ref="owl:AnnotationProperty"></xsd:element>
            <xsd:group ref="owl:AnnotationValue"></xsd:group>
        </xsd:sequence>
        <xsd:attributeGroup ref="xml:specialAttrs"></xsd:attributeGroup>
    </xsd:complexType>
    <xsd:element name="Annotation"
                 type="owl:Annotation"></xsd:element>
    <xsd:group name="axiomAnnotations">
        <xsd:sequence>
            <xsd:element ref="owl:Annotation"
                         minOccurs="0"
                         maxOccurs="unbounded"></xsd:element>
        </xsd:sequence>
    </xsd:group>
    <xsd:group name="ontologyAnnotations">
        <xsd:sequence>
            <xsd:element ref="owl:Annotation"
                         minOccurs="0"
                         maxOccurs="unbounded"></xsd:element>
        </xsd:sequence>
    </xsd:group>
    <xsd:group name="annotationAnnotations">
        <xsd:sequence>
            <xsd:element ref="owl:Annotation"
                         minOccurs="0"
                         maxOccurs="unbounded"></xsd:element>
        </xsd:sequence>
    </xsd:group>
    <!-- Annotation axioms -->
    <xsd:complexType name="AnnotationAxiom"
                     abstract="true">
        <xsd:complexContent>
            <xsd:extension base="owl:Axiom"></xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:group name="AnnotationAxiom">
        <xsd:choice>
            <xsd:element ref="owl:AnnotationAssertion"></xsd:element>
            <xsd:element ref="owl:SubAnnotationPropertyOf"></xsd:element>
            <xsd:element ref="owl:AnnotationPropertyDomain"></xsd:element>
            <xsd:element ref="owl:AnnotationPropertyRange"></xsd:element>
        </xsd:choice>
    </xsd:group>
    <xsd:complexType name="AnnotationAssertion">
        <xsd:complexContent>
            <xsd:extension base="owl:AnnotationAxiom">
                <xsd:sequence>
                    <xsd:element ref="owl:AnnotationProperty"></xsd:element>
                    <xsd:group ref="owl:AnnotationSubject"></xsd:group>
                    <xsd:group ref="owl:AnnotationValue"></xsd:group>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="AnnotationAssertion"
                 type="owl:AnnotationAssertion"></xsd:element>
    <xsd:complexType name="SubAnnotationPropertyOf">
        <xsd:complexContent>
            <xsd:extension base="owl:AnnotationAxiom">
                <xsd:sequence>
                    <xsd:element ref="owl:AnnotationProperty"></xsd:element>
                    <!-- This is the subproperty -->
                    <xsd:element ref="owl:AnnotationProperty"></xsd:element>
                    <!-- This is the superproperty -->
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="SubAnnotationPropertyOf"
                 type="owl:SubAnnotationPropertyOf"></xsd:element>
    <xsd:complexType name="AnnotationPropertyDomain">
        <xsd:complexContent>
            <xsd:extension base="owl:AnnotationAxiom">
                <xsd:sequence>
                    <xsd:element ref="owl:AnnotationProperty"></xsd:element>
                    <xsd:element ref="owl:IRI"></xsd:element>
                    <xsd:element ref="owl:AbbreviatedIRI"></xsd:element>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="AnnotationPropertyDomain"
                 type="owl:AnnotationPropertyDomain"></xsd:element>
    <xsd:complexType name="AnnotationPropertyRange">
        <xsd:complexContent>
            <xsd:extension base="owl:AnnotationAxiom">
                <xsd:sequence>
                    <xsd:element ref="owl:AnnotationProperty"></xsd:element>
                    <xsd:element ref="owl:IRI"></xsd:element>
                    <xsd:element ref="owl:AbbreviatedIRI"></xsd:element>
                </xsd:sequence>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
    <xsd:element name="AnnotationPropertyRange"
                 type="owl:AnnotationPropertyRange"></xsd:element>
</xsd:schema>
