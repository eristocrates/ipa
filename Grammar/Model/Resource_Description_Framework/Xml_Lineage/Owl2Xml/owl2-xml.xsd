            <xsd:element ref="owl:ObjectHasSelf"></xsd:element>
            <xsd:element ref="owl:ObjectMinCardinality"></xsd:element>
            <xsd:element ref="owl:ObjectMaxCardinality"></xsd:element>
            <xsd:element ref="owl:ObjectExactCardinality"></xsd:element>
            <xsd:element ref="owl:DataSomeValuesFrom"></xsd:element>
            <xsd:element ref="owl:DataAllValuesFrom"></xsd:element>
            <xsd:element ref="owl:DataHasValue"></xsd:element>
            <xsd:element ref="owl:DataMinCardinality"></xsd:element>
            <xsd:element ref="owl:DataMaxCardinality"></xsd:element>
