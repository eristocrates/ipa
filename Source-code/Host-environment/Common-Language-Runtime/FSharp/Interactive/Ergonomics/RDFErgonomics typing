    let from_literal (literal: RDF_Literal) =
        { Term.Empty with

            kind = rdfx.RDF_Literal.representation.as_string
            lexical_form = literal.lexical_form
            representation = literal.representation.as_string
            datatype = Some(literal.datatype.representation.as_string)
            language = literal.language_tag
            region = literal.region_subtag
            direction = literal.base_direction

         }

    let from_blank_node (blank_node: Blank_Node) =
        { Term.Empty with

            kind = rdfx.Blank_Node.representation.as_string
            lexical_form = blank_node.lexical_form
            representation = blank_node.representation.as_string

         }
    // TODO continue making term constructors
    let from_variable (variable: RDF_Variable) =
        match variable with
        | RDF_Variable.DollarSign variable ->
            { Term.Empty with

                kind = rdfx.Dollar_Variable.representation.as_string
                lexical_form = variable.lexical_form
                representation = $"${variable.lexical_form}"

             }
        | RDF_Variable.QuestionMark variable ->
            { Term.Empty with

                kind = rdfx.Question_Variable.representation.as_string
                lexical_form = variable.lexical_form
                representation = $"?{variable.lexical_form}"

             }

    let from_triple (triple: RDF_Triple) =
        { Term.Empty with

            kind = rdfx.Triple.representation.as_string
            lexical_form = triple.lexical_form
            representation = triple.representation.as_string

         }

    let from_triple_term (triple_term: Triple_Term) =
        { Term.Empty with

            kind = rdfx.Triple_Term.representation.as_string
            lexical_form = triple_term.lexical_form
            representation = triple_term.representation.as_string

         }

    let from_reified_triple (reified_triple: Reified_Triple) =
        { Term.Empty with

            kind = rdfx.Reified_Triple.representation.as_string
            lexical_form = reified_triple.lexical_form
            representation = reified_triple.representation.as_string

         }

    let from_subject (subject: RDF_Subject) =
        match subject with
        | RDF_Subject.FromIRI resolved_iri -> from_resolved_iri resolved_iri
        | RDF_Subject.FromBlankNode blank_node -> from_blank_node blank_node
        | RDF_Subject.FromReifiedTriple reified_triple -> from_reified_triple reified_triple
        | RDF_Subject.FromVariable variable -> from_variable variable

    let from_predicate (predicate: RDF_Predicate) =
        match predicate with
        | RDF_Predicate.FromIRI predicate_iri -> from_resolved_iri predicate_iri

    let from_object (object: RDF_Object) =

        match object with
        | RDF_Object.FromIRI resolved_iri -> from_resolved_iri resolved_iri
        | RDF_Object.FromBlankNode blank_node -> from_blank_node blank_node
        | RDF_Object.FromLiteral literal -> from_literal literal
        | RDF_Object.FromTripleTerm triple_term -> from_triple_term triple_term
        | RDF_Object.FromReifiedTriple reified_triple -> from_reified_triple reified_triple





