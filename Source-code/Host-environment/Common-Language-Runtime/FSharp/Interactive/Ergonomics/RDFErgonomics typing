and [<RequireQualifiedAccess>] RDF_Graph =
    | Formula of RDF_Formula
    | Unnamed of Unnamed_Graph
    | Named of Named_Graph

and RDF_Dataset =
    {


      default_graph: Unnamed_Graph
      named_graphs: Named_Graph array

     }

