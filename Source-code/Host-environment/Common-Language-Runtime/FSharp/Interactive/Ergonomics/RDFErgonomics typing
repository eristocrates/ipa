and Resolved_IRI = private ResolvedIRI of RDF_String
and Relative_IRI = private RelativeIRI of RDF_String
and Skolem_IRI = private SkolemIRI of RDF_String

and RDF_String = { lexical_form: string }

and Blank_Node =
    { blank_node_identifier: RDF_String
      skolem_iri: Skolem_IRI }

and CURIE =
    { prefix: RDF_Prefix
      reference: Relative_IRI }

and RDF_Prefix = private Prefix of RDF_String

and [<MessagePackObject; RequireQualifiedAccess>] RDF_Variable =
    | QuestionMark of RDF_String
    | DollarSign of RDF_String


and RDF_Literal =
    { lexical_form: string
      datatype: Resolved_IRI
      language_tag: string option
      region_subtag: string option
      base_direction: string option }


and [<RequireQualifiedAccess>] RDF_Subject =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node
    | FromReifiedTriple of Reified_Triple
    | FromVariable of RDF_Variable

and [<RequireQualifiedAccess>] TTSubject =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node

and [<RequireQualifiedAccess>] RTSubject =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node
    | FromReifiedTriple of Reified_Triple

and [<RequireQualifiedAccess>] RDF_Predicate = FromIRI of Resolved_IRI

and [<RequireQualifiedAccess>] RDF_Object =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node
    | FromLiteral of RDF_Literal
    | FromTripleTerm of Triple_Term
    | FromReifiedTriple of Reified_Triple

and [<RequireQualifiedAccess>] TTObject =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node
    | FromLiteral of RDF_Literal
    | FromTripleTerm of Triple_Term

and [<RequireQualifiedAccess>] RTObject =
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node
    | FromLiteral of RDF_Literal
    | FromTripleTerm of Triple_Term
    | FromReifiedTriple of Reified_Triple

and RDF_Collection = Collection of RDF_Object array

and RDF_Triple =
    {



      curSubject: RDF_Subject
      curPredicate: RDF_Predicate
      curObject: RDF_Object }


and Triple_Term =

    { ttSubject: TTSubject
      predicate: RDF_Predicate
      ttObject: TTObject

     }


and Reified_Triple =
    {


      rtSubject: RTSubject
      predicate: RDF_Predicate
      rtObject: RTObject }

and RDF_Quad =
    {


      triple: RDF_Triple
      context: RDF_Context }


and [<RequireQualifiedAccess>] RDF_Context =
    | Default_Context
    | FromIRI of Resolved_IRI
    | FromBlankNode of Blank_Node

and RDF_Formula = private Formula of RDF_Triple array

and Unnamed_Graph =
    {


      base_iri: Resolved_IRI
      triples: RDF_Formula

     }

and Named_Graph =
    {


      base_iri: Resolved_IRI
      graph_name: RDF_Context
