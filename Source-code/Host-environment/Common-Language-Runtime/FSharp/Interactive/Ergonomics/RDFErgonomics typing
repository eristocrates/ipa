[<RequireQualifiedAccess>]
type Representation =
    | rdf of string
    | lpg of string
    member this.as_string =
        match this with
        | rdf rdf_representation -> rdf_representation
        | lpg lpg_representation -> lpg_representation

    static member IRIREF(lexical_form: string) = Representation.rdf $"<{lexical_form}>"











type Resolved_IRI with

    member this.as_subject = RDF_Subject.FromIRI this

    member this.as_predicate = RDF_Predicate.FromIRI this

    member this.as_object = RDF_Object.FromIRI this

    static member parsed(raw_string: string) =

        {

          lexical_form =
              parse
                  complete_parser
                  IRI.parser_combinator
                  from_input_string
                  raw_string
                  expecting
                  $"Expected {raw_string} to be a Resolved IRI"
                  return_string


        }
        |> ResolvedIRI

    static member from_trusted_string(raw_string: string) =
        { lexical_form = raw_string } |> ResolvedIRI

    member this.representation =
        let (ResolvedIRI resolved_iri) = this
        Representation.IRIREF resolved_iri.lexical_form

    member this.lexical_form =
        let (ResolvedIRI resolved_iri) = this
        resolved_iri.lexical_form

type Skolem_IRI with
    static member raw(raw_string: string) =
        { lexical_form = raw_string } |> SkolemIRI

    member this.lexical_form =
        let (SkolemIRI skolem_iri) = this
        skolem_iri.lexical_form

    member this.representation =
        let (SkolemIRI skolem_iri) = this
        Representation.IRIREF skolem_iri.lexical_form




type Relative_IRI with
    static member parsed(raw_string: string) =

        {

          lexical_form =
              parse
                  complete_parser
                  Relative.Reference.parser_combinator
                  from_input_string
                  raw_string
                  expecting
                  $"Expected {raw_string} to be a Relative IRI"
                  return_string


        }
        |> RelativeIRI

    static member raw(raw_string: string) =
        { lexical_form = raw_string } |> RelativeIRI

    static member low_lined(raw_string: string) =
        { lexical_form = raw_string.Replace(" ", "_") }
        |> RelativeIRI

    member this.representation =
        let (RelativeIRI relative_iri) = this
        Representation.IRIREF relative_iri.lexical_form

    member this.resolve(ResolvedIRI namespace_name) =
        let (RelativeIRI local_name) = this
        Resolved_IRI.from_trusted_string $"{namespace_name.lexical_form}{local_name.lexical_form}"

    member this.lexical_form =
        let (RelativeIRI relative_iri) = this
        relative_iri.lexical_form





type IRIREF with
    member this.representation =
        match this with
        | FromResolvedIRI resolved_iri -> resolved_iri.representation
        | FromRelativeIRI relative_iri -> relative_iri.representation
        | FromSkolemIRI skolem_iri -> skolem_iri.representation

    static member from_trusted_string(raw_string: string) =
        raw_string
        |> Resolved_IRI.from_trusted_string
        |> FromResolvedIRI





type RDF_Prefix with
    static member from_string(raw_string: string) = Prefix { lexical_form = raw_string }

    member this.representation =
        let (Prefix prefix) = this
        $"{prefix.lexical_form}:"

    member this.mapping =
        let (Prefix prefix) = this
        Resolved_IRI.from_trusted_string prefix_map[prefix.lexical_form]































