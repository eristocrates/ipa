      "https://developers.arcgis.com/net/api-reference/api/net/Esri.ArcGISRuntime/name": "LCPW OverlayStormwaterInfrastructure D WM",
      "https://developers.arcgis.com/net/api-reference/api/net/Esri.ArcGISRuntime/opacity": {
