    member this.file =  Path.Combine(this.directory.FullName,$"{this.module_binding}.fs") |> FileInfo
    member this.properties = 
                        Array.concat [|
                            this.type_projections 
                            this.instance_projections
                        |]
                        |> Array.collect (fun type_projection -> 
                                match type_projection.clr_type.Name with 
                                | "ArcGISMapImageLayer" -> type_projection.clr_type.infer_properties [|MapServer|]
                                | _ -> type_projection.clr_type.properties
                        )

    member this.property_namespaces = 
                        this.properties |> Array.map (fun property -> 
                            match Property_Type.from_property_info property.info with 
                            | SequentialType(sequence_type,element_type) -> element_type.Namespace
                            | _ -> property.info.PropertyType.Namespace
                        )
                        |> Array.distinct
                        |> Array.sort
    member this.emit_module = 
            Ast.Oak() {
                Ast.Namespace($"{this.namespace_binding.normalize_binding}.{this.module_binding.normalize_binding}") {
                    match this.namespace_binding with 
                    | "gov.leoncountyfl" -> ()
                    | _ -> Ast.Open ("gov.leoncountyfl.interraster")
                    for property_namespace in this.property_namespaces do
                        Ast.Open(property_namespace)
                    

                    for index = 0  to this.type_projections.Length - 1 do
                        let type_projection = this.type_projections[index]
                        let record = 
                            match type_projection.type_binding with

                            | "MapService" -> type_projection.emit_record [| MapServer.ServiceInfo |]
                            | "GroupLayer" -> MapServer.group_layer_infos_by_name this.module_binding |> type_projection.emit_record
                            | "FeatureLayer" -> MapServer.feature_layer_infos_by_name this.module_binding |> type_projection.emit_record 
