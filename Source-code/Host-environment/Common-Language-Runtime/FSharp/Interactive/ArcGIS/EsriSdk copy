            not (this.excluded_properties.Contains(property.clr_name))
        )


type Module_Projection = 
    {
        namespace_binding:string
        module_binding:string
        type_projections:Type_Projection array
        instance_projections:Type_Projection array
    }
    member this.relative_path = this.namespace_binding.Split('.') |> String.concat "\\"
