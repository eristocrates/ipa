type Field_Type =
    | OIDField of string
    | TextField of string
    | GlobalIDField of string
    | Int16Field of int16
    | Float64Field of double
    | DateField of DateTime
    | Int32Field of int
    | UnknownField of obj

    member this.boxed_value : obj =
        match this with
        | OIDField value -> box value
        | TextField value -> box value
        | GlobalIDField value -> box value
        | Int16Field value -> box value
        | Float64Field value -> box value
        | DateField value -> box value
        | Int32Field value -> box value
        | UnknownField value -> value


    member this.as_string : string =
        Convert.ToString(
            this.boxed_value,
            CultureInfo.InvariantCulture
        )

    member this.as_int16 : int16 =
        Convert.ToInt16(
            this.boxed_value,
            CultureInfo.InvariantCulture
        )

    member this.as_double : double =
        Convert.ToDouble(
            this.boxed_value,
            CultureInfo.InvariantCulture
        )

    member this.as_date_time : DateTime =
        Convert.ToDateTime(
            this.boxed_value,
            CultureInfo.InvariantCulture
        )

    member this.as_int32 : int =
        Convert.ToInt32(
            this.boxed_value,
            CultureInfo.InvariantCulture
        )

    member this.as_object : obj =
        this.boxed_value

type Attribute_Field = 
    {
        attribute:Field_Type
        field:Field
    }
type Feature with 
    member this.attribute_fields = 
        this.Attributes
        |> Seq.map (|KeyValue|)
        |> Seq.filter (fun (key,value) -> value <> null )
        |> Seq.filter (fun (key,value) -> not (String.IsNullOrWhiteSpace (string value)))
        |> Seq.map (fun (key,value) -> 
            let field = this.FeatureTable.GetField key
            let attribute = 
                    match field.FieldType.ToString() with 
                    | "OID" ->  string value |> OIDField
                    | "GlobalID" ->  string value |> GlobalIDField
                    | "Int16" ->  string value |> Int16.Parse  |> Int16Field
                    | "Float64" ->  string value |> Double.Parse  |> Float64Field
                    | "Date" ->  string value |> DateTime.Parse  |> DateField
                    | "Int32" ->  string value |> Int32.Parse  |> Int32Field
                    | "Text" ->  string value   |> TextField
                    | _ ->  UnknownField value

            {
                attribute = attribute
                field = field
            }
        )
        |> Seq.toArray
    static member Query = 
            let feature_query = QueryParameters()
            feature_query.WhereClause <- "1 = 1"
            feature_query.ReturnGeometry <- true
            feature_query

