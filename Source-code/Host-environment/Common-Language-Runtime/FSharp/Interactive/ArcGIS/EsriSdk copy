let try_get_sequence_element_type (clr_type: Type) =
    if clr_type.IsArray then
        Some(clr_type.GetElementType())

    elif clr_type.IsGenericType then
        match clr_type.GetGenericTypeDefinition() with
        | generic_type
            when generic_type = typedefof<IList<_>>
              || generic_type = typedefof<IReadOnlyList<_>>
              || generic_type = typedefof<IEnumerable<_>> ->

            Some(clr_type.GetGenericArguments()[0])

        | _ ->
            None

    else
        None


let rec emit_runtime_value
    (excluded_properties: Set<string>)
    (declared_type: Type)
    (value: obj)
    =
    match value with
    | null ->
        Ast.ConstantExpr("()")

    | :? Uri as uri ->
        Ast.NewExpr(
            Ast.LongIdent("Uri"),
            Ast.String(uri.OriginalString)
        )

    | _ ->
        match try_get_sequence_element_type declared_type with
        | Some element_type ->

            let values =
                value :?> IEnumerable

            Ast.ArrayExpr([
                for element in values do
                    emit_runtime_value
                        Set.empty
                        element_type
                        element
            ])

        | None when
            declared_type.IsPrimitive
            || declared_type.IsEnum
            || declared_type = typeof<string>
            || declared_type = typeof<decimal>
            || declared_type = typeof<DateTime>
            || declared_type = typeof<DateTimeOffset>
            || declared_type = typeof<TimeSpan>
            || declared_type = typeof<Guid> ->

            FSharp_Literal.stringifyDynamic
                declared_type
                value
            |> Ast.ConstantExpr

        | None ->

            Ast.AnonRecordExpr([
                for property in declared_type.GetProperties() do
                    if not (
                        excluded_properties.Contains property.Name
                    ) then

                        let property_value =
                            property.GetValue(value)

                        Ast.RecordFieldExpr(
                            property.Name,
                            emit_runtime_value
                                Set.empty
                                property.PropertyType
                                property_value
                        )
            ])


let try_instance_descriptor (value: 'Type) =
    if isNull (box value) then
        None
    else
        let converter =
            TypeDescriptor.GetConverter(value.GetType())

        if converter.CanConvertTo(typeof<InstanceDescriptor>) then
            match converter.ConvertTo(
                value,
                typeof<InstanceDescriptor>
            ) with
            | :? InstanceDescriptor as descriptor ->
                Some descriptor

            | _ ->
                None
        else
            None




