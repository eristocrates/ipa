                            | "FeatureField" -> MapServer.fields_by_table this.module_binding |> type_projection.emit_record 

                            | _ -> type_projection.emit_record [||]



                        if index = 0 then 
                            record
                        else 
                            record.toRecursive()


                    for type_projection in this.instance_projections do
                        match type_projection.type_binding with  
                        |  "MapService" ->
                            for emitted_instance in type_projection.emit_instances [| MapServer.ServiceInfo |] do
                                emitted_instance

                        | "GroupLayer" ->
                            let instances = MapServer.group_layer_infos_by_name this.module_binding |> type_projection.emit_instances  
                            for emitted_instance in instances do
                                emitted_instance
                        | "FeatureLayer" ->
                            let instances = MapServer.feature_layer_infos_by_name this.module_binding |> type_projection.emit_instances  
                            for emitted_instance in instances do
                                emitted_instance
                        | "FeatureTable" ->
                            let instances = MapServer.tables_by_name this.module_binding |> type_projection.emit_instances  
                            for emitted_instance in instances do
                                emitted_instance
                                
                        | "FeatureField" ->
                            let instances = MapServer.fields_by_table this.module_binding |> type_projection.emit_instances  
                            for emitted_instance in instances do
                                emitted_instance
                        | _ -> ()

                }|> _.toImplicit()
            }
            |> Gen.mkOak
            |> Gen.run


    member this.write_text() = File.WriteAllText(this.file.FullName, this.emit_module)


