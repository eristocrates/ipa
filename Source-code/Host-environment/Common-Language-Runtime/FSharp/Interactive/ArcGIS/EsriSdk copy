type String with 
    member this.snake_case = Converters.to_snake_case this
    member this.normalize_binding = Converters.ReplaceWhitespace(this,  "_").Replace("-","_")


type Property_Type =
    | NonsequentialType of Type
    | SequentialType of sequence_type:Type * element_type:Type
    static member from_property_info (property_info :PropertyInfo) = 
        match property_info.PropertyType with 
        | property_type when property_type.IsGenericType ->
                 match property_type.GetGenericTypeDefinition() with 
                 | property_generic_type when property_generic_type = typedefof<IList<_>> -> SequentialType(property_info.PropertyType, property_info.PropertyType.GetGenericArguments()[0])
                 | property_generic_type when property_generic_type = typedefof<IReadOnlyList<_>> -> SequentialType(property_info.PropertyType, property_info.PropertyType.GetGenericArguments()[0])
                 | property_generic_type -> NonsequentialType property_type
        | property_type -> NonsequentialType property_type
    member this.fsharp_name = 
        match this with 
        | NonsequentialType property_type -> FSharp_Literal.stringifyTypeDynamic property_type
        | SequentialType (sequence_type,_) -> stringifyTypeDynamic sequence_type

type Property_Info = 
    | OptionalProperty of PropertyInfo
    | MandatoryProperty of PropertyInfo
    | UninferredProperty of PropertyInfo
    member this.info = 
        match this with 
        | OptionalProperty propertyinfo -> propertyinfo
        | MandatoryProperty propertyinfo -> propertyinfo
        | UninferredProperty propertyinfo -> propertyinfo
    member this.clr_name :string = this.info.Name



        
type Type with
    member this.fsharp_name =
        FSharp_Literal.stringifyTypeDynamic this
    member this.properties = this.GetProperties() |> Array.map (fun property -> UninferredProperty property)
    member this.property_namespaces = 
                        this.properties |> Array.map (fun property -> 
                            match Property_Type.from_property_info property.info with 
                            | SequentialType(sequence_type,element_type) -> element_type.Namespace
                            | _ -> property.info.PropertyType.Namespace
                        )
                        |> Array.distinct
                        |> Array.sort
    member this.infer_properties (instances: 'Type array) = 
        if instances.Length < 1 then 
            this.properties
        else 
            this.GetProperties()
            |> Array.map (fun property -> 
                    property, instances
                    |> Array.map (fun instance ->  property.GetValue instance)
            )
            |> Array.filter (fun (property, values) -> not (Array.TrueForAll(values,   (fun value -> String.IsNullOrWhiteSpace(string value)))))
            |> Array.map(fun (property, values) -> 
                    let null_exists = values |> Array.exists (fun value -> String.IsNullOrWhiteSpace(string value))
                
                    if null_exists then 
                        OptionalProperty property
                    else 
                        MandatoryProperty property
            )



let inline emit_literal_value (value: obj)(property:Property_Info) =
    match value with
    | null -> Ast.ConstantExpr("()")
    | :? string as value -> Ast.String(value) |> Ast.ConstantExpr 
    | :? bool as value -> Ast.Bool(value) |> Ast.ConstantExpr 
    | :? decimal as value -> Ast.Decimal(value) |> Ast.ConstantExpr 
    | :? float as value when Double.IsNaN value -> Ast.ConstantExpr("Double.NaN")
    | :? float as value -> Ast.Float(value) |> Ast.ConstantExpr 
    | :? int as value -> string value |> Ast.ConstantExpr 
    | :? int64 as value -> $"{value}L" |> Ast.ConstantExpr 
    | :? Uri as value ->     Ast.NewExpr( Ast.LongIdent("Uri"), Ast.String(value.OriginalString) )
    | :? Enum as value ->
        let enum_type_name = FSharp_Literal.stringifyTypeDynamic(value.GetType())
        Ast.ConstantExpr( $"{enum_type_name}.{value}" )

    | :? MapServiceImageFormat as value -> Ast.String(value.ToString()) |> Ast.ConstantExpr


    | value ->
        failwithf
            "No emitted literal representation has been defined for \ntype_binding: %s \nproperty.clr_name: %s \nPropertyType.Name: %s" this.type_binding property.clr_name property.info.PropertyType.Name
let emit_present_value (clr_type:Type)(property:Property_Info)(instance:'Type) =

    let property_value = property.info.GetValue(instance)
    match
        clr_type.Name,
        property.clr_name,
        Property_Type.from_property_info property.info
    with


    | _, _, SequentialType _ ->

        let values =
            property_value :?> IEnumerable

        Ast.ArrayExpr([
            for value in values do
                property |> emit_literal_value value
        ])

    | _, _, NonsequentialType _ ->
        property |> emit_literal_value property_value


let inline emit_property_value (property: Property_Info) (instance: 'Type) : WidgetBuilder<SyntaxOak.Expr> =
        let clr_type = instance.GetType()
        let property_value =
            property.info.GetValue(instance)

        if property.IsOptionalProperty then

            if String.IsNullOrWhiteSpace(string property_value) then
                Ast.ConstantExpr("None")

            else
                Ast.AppExpr(
                    "Some",
                    emit_present_value clr_type property instance
                )

        else
            emit_present_value clr_type property instance
            
let inline emit_value  (type_binding:string) (slug_property_name:string) (excluded_properties: Set<string>) (instances: 'Type array) (entity:'Type) =
    let clr_type = entity.GetType()
    let properties = clr_type.infer_properties instances

    let slug_property =
        match clr_type.GetProperty( slug_property_name ) with 
        | null -> failwithf "Type %s does not contain slug property %s." clr_type.FullName slug_property_name
        | property -> property

    let slug_value = slug_property.GetValue(entity) |> string
    if String.IsNullOrWhiteSpace(slug_value) then
        failwithf "The slug property %s on %s produced no usable binding name." slug_property_name clr_type.FullName
        
    let entity_binding = 
        match type_binding,slug_value with 
        | "MapService","Layers" -> "LCPW_OverlayStormwaterInfrastructure_D_WM"
        | _,_ -> slug_value.normalize_binding
    Ast.Value(
    entity_binding,
    Ast.AnonRecordExpr([
        for (property:Property_Info) in properties do

            Ast.RecordFieldExpr(
                property.clr_name, emit_property_value property entity
            )
        match type_binding with 
        | _ -> ()

    ])
