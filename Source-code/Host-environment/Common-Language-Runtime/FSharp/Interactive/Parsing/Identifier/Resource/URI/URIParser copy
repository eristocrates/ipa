/// port          = *DIGIT
let port =
    parser_expecting
        (zero_or_more Augmented_Backus_Naur_Form.Core_Rules.DIGIT
         |>> fun charList ->
                 let stringNumeral = string_from_charList charList
                 int_from_stringNumeral stringNumeral)
        """
port          = *DIGIT
"""

/// [ ":" port ]
let colon_port =
    parser_expecting
        (opt (pchar ':' >>. port))
        """
[ ":" port ]
"""

// TODO IP-literal
