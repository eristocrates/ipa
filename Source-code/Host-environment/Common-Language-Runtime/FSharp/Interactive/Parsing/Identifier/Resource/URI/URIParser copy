                      ]
         )
         |>> fun hier_partOption -> defaultArg hier_partOption path_empty)
        """
hier-part     = "//" authority path-abempty
             / path-absolute
             / path-rootless
             / path-empty
"""

/// absolute-URI  = scheme ":" hier-part [ "?" query ]
