  let many1Chars2
      (p1: Parser<int, int, 'State, 'Input>)
      (p: Parser<int, int, 'State, 'Input>)
      (reader: Reader<int, 'State, 'Input>)
      =
      match p1 reader with
      | Ok cp ->
          let sb = StringBuilder()
          append_code_point sb cp

          let mutable keepGoing = true

          while keepGoing do
              let pos = reader.Position

              match p reader with
              | Ok cp ->
                  if pos = reader.Position then
                      raise (InfiniteLoopException pos)

                  append_code_point sb cp

              | Error _ ->
                  reader.Position <- pos
                  keepGoing <- false

          preturn (sb.ToString()) reader

      | Error err ->
          Error err

  let manyCharsTill
      (p: Parser<int, int, 'State, 'Input>)
      (pEnd: Parser<'End, int, 'State, 'Input>)
      (reader: Reader<int, 'State, 'Input>)
      =
      let sb = StringBuilder()
      let mutable endResult = ValueNone
      let mutable error = ValueNone

      while endResult.IsNone && error.IsNone do
          match pEnd reader with
          | Ok x ->
              endResult <- ValueSome x

          | Error _ ->
              let pos = reader.Position

              match p reader with
              | Ok cp ->
                  if pos = reader.Position then
                      raise (InfiniteLoopException pos)

                  append_code_point sb cp

              | Error err ->
                  error <- ValueSome err

      match error, endResult with
      | ValueSome err, _ ->
          Error err

      | _, ValueSome x ->
          preturn (sb.ToString(), x) reader

      | _ ->
          fail EndOfInput reader

  // SIMD-adjacent variant: preserve the scalar array instead of rebuilding text.
  let manyCodePoints
      (p: Parser<int, int, 'State, 'Input>)
      (reader: Reader<int, 'State, 'Input>)
      =
      let start = reader.Position

      match p reader with
      | Ok cp ->
          let xs = ResizeArray<int>()
          xs.Add cp

          let mutable keepGoing = true

          while keepGoing do
              let pos = reader.Position

              match p reader with
              | Ok cp ->
                  if pos = reader.Position then
                      raise (InfiniteLoopException pos)

                  xs.Add cp

              | Error _ ->
                  reader.Position <- pos
                  keepGoing <- false

          preturn (xs.ToArray()) reader

      | Error _ ->
          reader.Position <- start
          preturn Array.empty<int> reader

  // -----------------------------------------------------------------------------
  // Whitespace and newline
  // -----------------------------------------------------------------------------

  let spaces
      (reader: Reader<int, 'State, 'Input>)
      =
      let mutable keepGoing = true

      while keepGoing do
          match reader.Peek() with
          | ValueSome cp when isSpaceCodePoint cp ->
              reader.Skip()

          | _ ->
              keepGoing <- false

      preturn () reader

  let spaces1
      (reader: Reader<int, 'State, 'Input>)
      =
      match reader.Peek() with
      | ValueSome cp when isSpaceCodePoint cp ->
          reader.Skip()

          let mutable keepGoing = true

          while keepGoing do
              match reader.Peek() with
              | ValueSome cp when isSpaceCodePoint cp ->
                  reader.Skip()

              | _ ->
                  keepGoing <- false

          preturn () reader

      | ValueSome _ ->
          fail ErrorPayload.spaces1 reader

      | ValueNone ->
          fail EndOfInput reader

  let newlineReturn
      (result: 'Parsed)
      (reader: Reader<int, 'State, 'Input>)
      =
      let span = reader.PeekN 2

      if span.IsEmpty then
          fail EndOfInput reader
      else
          match span[0] with
          | cp when cp = int '\n' ->
              reader.Skip()
              preturn result reader

          | cp when cp = int '\r' ->
              if span.Length = 2 && span[1] = int '\n' then
                  reader.SkipN 2
              else
                  reader.Skip()

              preturn result reader

          | _ ->
              fail ErrorPayload.expectedNewline reader

  let newline reader =
      newlineReturn (int '\n') reader

  let skipNewline reader =
      newlineReturn () reader

  // -----------------------------------------------------------------------------
  // Integer parsers over ASCII numeric syntax
  // -----------------------------------------------------------------------------

  let private digitValue cp =
      if cp >= int '0' && cp <= int '9' then
          cp - int '0'
      elif cp >= int 'a' && cp <= int 'f' then
          cp - int 'a' + 10
      elif cp >= int 'A' && cp <= int 'F' then
          cp - int 'A' + 10
      else
          -1

  let private parseIntegerCore
      (allowSign: bool)
      (reader: Reader<int, 'State, 'Input>)
      =
      let mutable sign = BigInteger.One

      if allowSign then
          match reader.Peek() with
          | ValueSome cp when cp = int '-' ->
              reader.Skip()
              sign <- -BigInteger.One

          | ValueSome cp when cp = int '+' ->
              reader.Skip()

          | _ ->
              ()

      if reader.AtEnd then
          fail EndOfInput reader
      else
          let mutable radix = 10
          let prefix = reader.PeekN 2

          if prefix.Length = 2 && prefix[0] = int '0' then
              match prefix[1] with
              | cp when cp = int 'x' || cp = int 'X' ->
                  radix <- 16
                  reader.SkipN 2

              | cp when cp = int 'o' || cp = int 'O' ->
                  radix <- 8
                  reader.SkipN 2

              | cp when cp = int 'b' || cp = int 'B' ->
                  radix <- 2
                  reader.SkipN 2

              | _ ->
                  ()

          let digitStart = reader.Position
          let mutable value = BigInteger.Zero
          let mutable keepGoing = true

          while keepGoing do
              match reader.Peek() with
              | ValueSome cp ->
                  let d = digitValue cp

                  if d >= 0 && d < radix then
                      value <- value * bigint radix + bigint d
                      reader.Skip()
                  else
                      keepGoing <- false

              | ValueNone ->
                  keepGoing <- false

          if reader.Position = digitStart then
              fail ErrorPayload.intInvalid reader
          else
              preturn (sign * value) reader

  let private pintBounded
      (minValue: BigInteger)
      (maxValue: BigInteger)
      (convert: BigInteger -> 'T)
      (reader: Reader<int, 'State, 'Input>)
      =
      match parseIntegerCore true reader with
      | Ok value when value >= minValue && value <= maxValue ->
          preturn (convert value) reader

      | Ok _ ->
          fail ErrorPayload.intOutOfRange reader

      | Error err ->
          Error err

  let private puintBounded
      (maxValue: BigInteger)
      (convert: BigInteger -> 'T)
      (reader: Reader<int, 'State, 'Input>)
      =
      match parseIntegerCore false reader with
      | Ok value when value >= BigInteger.Zero && value <= maxValue ->
          preturn (convert value) reader

      | Ok _ ->
          fail ErrorPayload.intOutOfRange reader

      | Error err ->
          Error err

  let pbigint reader =
      parseIntegerCore true reader

  let pint64 reader =
      pintBounded (bigint Int64.MinValue) (bigint Int64.MaxValue) int64 reader

  let pint32 reader =
      pintBounded (bigint Int32.MinValue) (bigint Int32.MaxValue) int reader

  let pint16 reader =
      pintBounded (bigint Int16.MinValue) (bigint Int16.MaxValue) int16 reader

  let pint8 reader =
      pintBounded (bigint SByte.MinValue) (bigint SByte.MaxValue) int8 reader

  let puint64 reader =
      puintBounded (bigint UInt64.MaxValue) uint64 reader

  let puint32 reader =
      puintBounded (bigint UInt32.MaxValue) uint32 reader

  let puint16 reader =
      puintBounded (bigint UInt16.MaxValue) uint16 reader

  let puint8 reader =
      puintBounded (bigint Byte.MaxValue) uint8 reader

  // -----------------------------------------------------------------------------
  // Float parser
  // -----------------------------------------------------------------------------
  // This covers decimal floats and IEEE spellings: NaN, Inf, Infinity, with signs.
  // It intentionally does not implement XParsec's hexadecimal float syntax yet.
  // If exact parity with CharParsers.pfloat is required, port that routine directly.

  let private appendAscii (sb: StringBuilder) cp =
      sb.Append(char cp) |> ignore

  let private readDigitsInto (sb: StringBuilder) (reader: Reader<int, 'State, 'Input>) =
      let start = reader.Position
      let mutable keepGoing = true

      while keepGoing do
          match reader.Peek() with
          | ValueSome cp when isDigit cp ->
              appendAscii sb cp
              reader.Skip()

          | _ ->
              keepGoing <- false

      reader.Position <> start

  let pfloat
      (reader: Reader<int, 'State, 'Input>)
      =
      let special =
          [ "infinity", Double.PositiveInfinity
            "+infinity", Double.PositiveInfinity
            "-infinity", Double.NegativeInfinity
            "inf", Double.PositiveInfinity
            "+inf", Double.PositiveInfinity
            "-inf", Double.NegativeInfinity
            "nan", Double.NaN
            "+nan", Double.NaN
            "-nan", Double.NaN ]

      match anyStringCIReturn special reader with
      | Ok value ->
          preturn value reader

      | Error _ ->
          let sb = StringBuilder()

          match reader.Peek() with
          | ValueSome cp when cp = int '+' || cp = int '-' ->
              appendAscii sb cp
              reader.Skip()

          | _ ->
              ()

          let hasIntegralDigits = readDigitsInto sb reader

          if not hasIntegralDigits then
              fail ErrorPayload.floatInvalid reader
          else
              match reader.Peek() with
              | ValueSome cp when cp = int '.' ->
                  appendAscii sb cp
                  reader.Skip()
                  readDigitsInto sb reader |> ignore

              | _ ->
                  ()

              match reader.Peek() with
              | ValueSome cp when cp = int 'e' || cp = int 'E' ->
                  appendAscii sb cp
                  reader.Skip()

                  match reader.Peek() with
                  | ValueSome cp when cp = int '+' || cp = int '-' ->
                      appendAscii sb cp
                      reader.Skip()

                  | _ ->
                      ()

                  let hasExponentDigits = readDigitsInto sb reader

                  if not hasExponentDigits then
                      fail ErrorPayload.floatInvalid reader
                  else
                      match Double.TryParse(sb.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture) with
                      | true, value -> preturn value reader
                      | false, _ -> fail ErrorPayload.floatInvalid reader

              | _ ->
                  match Double.TryParse(sb.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture) with
                  | true, value -> preturn value reader
                  | false, _ -> fail ErrorPayload.floatInvalid reader
