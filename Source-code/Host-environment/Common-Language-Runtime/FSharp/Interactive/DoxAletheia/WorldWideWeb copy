let optionalLabel (label: string option) (affix: Affix) =
    if label.IsSome then
        match affix with
        | Affix.prefix delimiter -> $"{delimiter}{label}"
        | Affix.postfix delimiter -> $"{label}{delimiter}"
    else
        String.Empty



let (|Subdomain_from_uri|_|) (uri: Uri) =
    match uri.Scheme with
    | "http"
    | "https" ->
        match uri.HostNameType with
        | UriHostNameType.Dns when uri.Authority.Count(period) = 2 -> firstSubstringBeforeDelimiter "." uri.Host

        | _ -> None
    | _ -> None

let (|Second_level_domain_from_uri|_|) (uri: Uri) =
    match uri.Scheme with
    | "http"
    | "https" ->
        match uri.HostNameType with
        | UriHostNameType.Dns when uri.Authority.Count(period) = 1 -> firstSubstringBeforeDelimiter "." uri.Host
        | UriHostNameType.Dns when uri.Authority.Count(period) = 2 -> substringFromCircumfix "." uri.Host "."
        | _ -> None
    | _ -> None



type TopLevelDomain =
    {

      label: string

     }

and SecondLevelDomain =
    {

      label: string
      topLevelDomain: TopLevelDomain

     }

and Subdomain =
    {

      label: string
      topLevelDomain: TopLevelDomain
      secondLevelDomain: SecondLevelDomain

     }
    static member postfix = Affix.postfix "."
    member this.asUrlComponent = "${this.label}."

type Host =
    {

      topLevelDomain: string
      secondLevelDomain: string
      subdomain: string option

     }
    static member inhabitant(uri: Uri) =
        let topLevelDomain =
            let reverseHost = reverseString uri.Host

            let reverseTopLevelDomainLabel =
                (firstSubstringBeforeDelimiter "." reverseHost)
                    .Value

            reverseString reverseTopLevelDomainLabel


        let secondLevelDomain =
            match uri with
            | Second_level_domain_from_uri secondLevelDomainLabel -> secondLevelDomainLabel

        let subdomain =
            match uri with
            | Subdomain_from_uri subdomainLabel -> Some(subdomainLabel)
            | _ -> None

        {

          topLevelDomain = topLevelDomain
          secondLevelDomain = secondLevelDomain
          subdomain = subdomain

        }

    member this.urlSubdomain = optionalLabel this.subdomain (Affix.postfix ".")

    member this.urlHost =
        $"{this.urlSubdomain}{this.secondLevelDomain}.{this.topLevelDomain}"


