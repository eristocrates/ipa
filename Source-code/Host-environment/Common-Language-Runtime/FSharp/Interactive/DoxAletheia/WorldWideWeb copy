type Iri =
    {

      scheme: string
      host: string
      port: int option
      pathSegments: string array
      leaf: string
      leafSegments: string array
      query: string option
      fragment: string option

     }

    static member inhabitant(uri: Uri) =

        let host = uri.Host


        let port =
            if uri.Port = -1 then
                None
            else
                Some(uri.Port)

        let segmentsFromUri = pathSegments uri.Segments
        let leaf = segmentsFromUri |> Array.last
        let leafSegments = leaf.Split(".")

        {

          scheme = uri.Scheme
          host = host
          port = port
          pathSegments = segmentsFromUri
          leaf = leaf
          leafSegments = leafSegments
          query = nonEmptyString uri.Query
          fragment = nonEmptyString uri.Fragment


        }

    static member inhabitant(urlString: string) =
        let uri = new Uri(urlString)
        Iri.inhabitant uri


    member this.urlPort =
        let portString = this.port |> Option.map string
        optionalLabel portString (Affix.prefix ":")


    member this.urlFragment = optionalLabel this.fragment (Affix.prefix "#")

    member this.urlQuery = optionalLabel this.query (Affix.prefix "#")

    member this.urlPath =
        if this.pathSegments.Length > 0 then
            this.pathSegments |> String.concat "/"
        else
            String.Empty


    member this.urlAuthority = $"{this.host}{this.urlPort}"

    member this.asUrlString =
        $"{this.scheme}://{this.urlAuthority}{this.urlPath}{this.urlFragment}"
