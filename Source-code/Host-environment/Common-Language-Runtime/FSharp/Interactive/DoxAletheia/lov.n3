        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://w3id.org/people/mpoveda/> ;
                  <dcterms:date>     "2015-07-02"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "http://rdfs.org/ns/void# does not seem to be working"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2013-06-03"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "It is important to understand the relationship beween VoID and DCAT: In short, VoID is for data in RDF format, while DCAT is neutral with regards to format. (See the introduction section of DCAT vocabulary: http://www.w3.org/TR/vocab-dcat/)"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2017-04-06"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "No changes."
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2014-06-04"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Annual review OK"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2015-05-04"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "VoID is specified by a W3C Interest Group Note at http://www.w3.org/TR/void/, which is stable, including the namespace http://rdfs.org/ns/void#. This namespace used to redirect to http://vocab.deri.ie/void, which is declaring itself as the vocabulary URI in the RDF file. Unfortunately both URI and namespace are offline at the moment, future of vocab.deri.ie being unknown."
                ] ;
