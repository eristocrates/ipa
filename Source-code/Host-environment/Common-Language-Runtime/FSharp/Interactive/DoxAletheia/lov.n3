rdf:    a              <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/contributor>
                <http://richard.cyganiak.de/foaf.rdf#cygri> , <http://about.me/david_wood> ;
        <http://purl.org/dc/terms/creator>
                <http://www.markus-lanthaler.com/> ;
        <http://purl.org/dc/terms/description>
                "This is the RDF Schema for the RDF vocabulary terms in the RDF Namespace, defined in RDF 1.1 Concepts."@en ;
        <http://purl.org/dc/terms/issued>
                "1999-02-22"^^xsd:date ;
        <http://purl.org/dc/terms/modified>
                "2019-12-16"^^xsd:date ;
        <http://purl.org/dc/terms/publisher>
                <http://www.w3.org/data#W3C> ;
        <http://purl.org/dc/terms/title>
                "The RDF Concepts Vocabulary"@en ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2015-07-11"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Annual review OK."
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2021-03-07"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "New additions to RDF in 2019 ( rdf:JSON, rdf:direction) without proper metadata (https://w3c.github.io/rdf-star/Minutes/2021-03-05.html#t04). That's not what we can call best practice publishing from W3C vocabulary. Who is to blame? :)"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2017-03-09"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Annual review OK."
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2014-06-13"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "The vocabulary of vocabularies is itself linked to others that build on it : it relies on RDFS as well as OWL and Dublin Core for metadata in the latest version. The namespace is keeping track of the first release 1999-02-22. If a vocabulary in LOV pretends it was issued before this date, it's certainly a bug."
                ] ;
