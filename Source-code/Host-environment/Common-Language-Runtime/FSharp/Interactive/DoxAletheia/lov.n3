                  <dcterms:creator>  <https://es.linkedin.com/in/albafernandezizquierdo> ;
                  <dcterms:date>     "2019-05-29"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "first introduced in LOV. There is no publisher"
                ] ;
