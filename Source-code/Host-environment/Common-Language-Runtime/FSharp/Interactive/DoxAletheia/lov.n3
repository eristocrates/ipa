<http://ontology.eil.utoronto.ca/GCI/Foundation/GCI-Foundation.owl>
        a       <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/creator>
                <http://eil.utoronto.ca/profiles/foxpro.html> ;
        <http://purl.org/dc/terms/description>
                "Global City Indicator Foundation Ontology developed by the Information Engineering Group, Mechanical & Industrial Engineering, University of Toronto. Contains the foundation ontologies required to represent ISO 37120 city indicators, including Placenames, Time, Measurement, Provenance, Statistics, Validity and Trust. See: Fox, M.S., (2013), \"A Foundation Ontology for Global City Indicators\", Global City Institute Working Paper, Vol. 1, No.4, pp. 1-45. Global Cities Institute, University of Toronto. Updated 24 June 2014: http://www.eil. Based on the Global City Indicators Facility, University of Toronto: http://www.cityindicators.org/Deliverables/Core%20and%20Supporting%20Indicators%20Table%20SEPTEMBER%202011.pdf.\n\nContact: Mark S. Fox, msf@eil.utoronto.ca"@en ;
        <http://purl.org/dc/terms/issued>
                "2015-04-14"^^xsd:date ;
        <http://purl.org/dc/terms/modified>
                "2015-04-15"^^xsd:date ;
        <http://purl.org/dc/terms/title>
                "Global City Indicator Foundation Ontology"@en ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2015-04-15"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "An ontology with application in the domain of Smart cities to capture global indicators. Few metadata are expected in the vocabulary to improve its discovery and maintenance, as well as the submission of external ontologies reused by the current version of the vocabulary."
                ] ;
        <http://purl.org/vocab/vann/preferredNamespacePrefix>
                "gci" ;
        <http://purl.org/vocab/vann/preferredNamespaceUri>
