                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2013-06-25"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "A small generic vocabulary for description of scientific research concepts, such as hypotheses, methods, results and publications. Most of those concepts seem already described in other vocabularies, and maybe too generic for efficient direct use. Could be extended and specialized for specific domains."
