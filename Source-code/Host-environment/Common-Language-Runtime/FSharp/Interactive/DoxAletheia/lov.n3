<http://vocab.deri.ie/void>
        a              <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/creator>
                <http://data.semanticweb.org/person/jun-zhao> , <https://plus.google.com/102497386507936526460> , <http://data.semanticweb.org/person/keith-alexander> , <http://richard.cyganiak.de/foaf.rdf#cygri> ;
        <http://purl.org/dc/terms/description>
                "The Vocabulary of Interlinked Datasets (VoID) is an RDF Schema vocabulary for expressing metadata about RDF datasets."@en ;
        <http://purl.org/dc/terms/issued>
                "2010-01-26"^^xsd:date ;
        <http://purl.org/dc/terms/modified>
