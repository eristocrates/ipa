                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2015-03-10"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "A very generic vocabulary intended to be extendable to any kind of units and measures. Includes expression of relationships and conversions between different units."
                ] ;
