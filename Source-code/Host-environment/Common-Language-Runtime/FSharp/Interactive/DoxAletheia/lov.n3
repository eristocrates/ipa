<http://purl.org/reco#>
        a       <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/description>
                "The RECO ontology defines the vocabulary for representing preferences-as-constraints and preferences-as-ratings as RDF graphs. This lightweight vocabulary provides domain-independent means to describe user profiles in a coherent and context-aware way. RECO has been designed as an extension of both Friend-Of-A-Friend (FOAF) and Who Am I! (WAI) ontologies."@en ;
        <http://purl.org/dc/terms/issued>
                "2011-08-01"^^xsd:date ;
        <http://purl.org/dc/terms/language>
                <http://id.loc.gov/vocabulary/iso639-2/eng> ;
        <http://purl.org/dc/terms/modified>
                "2011-08-01"^^xsd:date ;
        <http://purl.org/dc/terms/title>
                "RECommendations Ontology"@en ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2015-04-03"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "This vocabulary is a good starting point for modeling user profiles. However, it needs better metadata to be fully LOV compliant."
                ] ;
