<http://purl.org/iot/ontology/fiesta-iot>
        a                 <http://purl.org/vocommons/voaf#Vocabulary> ;
        rdfs:isDefinedBy  <http://ontology.fiesta-iot.eu/ontologyDocs/fiesta-iot.owl> ;
        <http://purl.org/dc/terms/contributor>
                <https://garvitabajaj.wordpress.com/> ;
        <http://purl.org/dc/terms/creator>
                <http://personal.ee.surrey.ac.uk/Personal/T.Elsaleh/> , <https://mimove.inria.fr/members/rachit-agarwal/> , <https://www.researchgate.net/profile/Luis_Sanchez19> , <https://plus.google.com/107915931756113239056> , <https://www.researchgate.net/profile/Jorge_Lanza> , <https://www.researchgate.net/profile/David_Gomez_Fernandez> ;
        <http://purl.org/dc/terms/description>
                "The  FIESTA-IoT ontology takes inspiration from the well-known Noy et al. methodology  for reusing and interconnecting existing ontologies. To build the ontology, we leverage a number of core concepts from various mainstream ontologies and taxonomies, such as Semantic Sensor Network (SSN), M3-lite (a lite version of M3 ontology), WGS84, IoT-lite, Time, and DUL ontology."@en ;
        <http://purl.org/dc/terms/issued>
                "2016-04-28"^^xsd:date ;
        <http://purl.org/dc/terms/language>
                <http://id.loc.gov/vocabulary/iso639-2/eng> ;
        <http://purl.org/dc/terms/modified>
                "2017-02-09"^^xsd:date ;
        <http://purl.org/dc/terms/title>
                "FIESTA-IoT Ontology"@en ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2017-04-04"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "The FIESTA-IoT Ontology  is framed within the EU H2020 FIESTA-IoT project, that aims to seamlessly support the federation of testbeds through the usage of semantic-based technologies. I hope they will have a smart documentation to help user understanding the concepts. The ontolgy is using an ontology which is not currently online. See: http://www.onem2m.org/ontology/Base_Ontology/base_ontology#. Statatics are not showing up in the interface, we should try to fix the issue."
                ] ;
        <http://purl.org/vocab/vann/preferredNamespacePrefix>
                "fiesta-iot" ;
        <http://purl.org/vocab/vann/preferredNamespaceUri>
                "http://purl.org/iot/ontology/fiesta-iot#" ;
        <http://purl.org/vocommons/voaf#occurrencesInDatasets>
                "0"^^xsd:int ;
