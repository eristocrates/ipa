<http://resource.geosciml.org/ontology/timescale/gts>
        a       <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/contributor>
                <http://www.azgs.az.gov/profile_richard.shtml> ;
