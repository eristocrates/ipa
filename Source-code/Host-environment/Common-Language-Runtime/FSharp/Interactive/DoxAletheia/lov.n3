                  <dcterms:date>     "2020-07-24"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Vocabulary added into LOV. The authors have a shape description of the ontology at https://github.com/dcodings/DINGO/blob/master/DINGO.shex"
                ] ;
