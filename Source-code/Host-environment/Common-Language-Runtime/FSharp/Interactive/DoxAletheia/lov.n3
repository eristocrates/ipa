                  <http://purl.org/stuff/rev#text>
                          "Record updated with new version. See also https://plus.google.com/u/0/115593825497938381443/posts/azcdojYpmmS"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2014-08-31"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "A very rich vocabulary leveraging core LOV components such as SKOS, Dublin Core, BIBO, FOAF, and iso-thes, the OWL expression of ISO 25964. It is used by Getty publication of its great thesauri resources AAT and TGN, and more in the pipe. Great job."
                ] ;
