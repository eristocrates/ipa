<http://www.agls.gov.au/agls/terms>
        a              <http://purl.org/vocommons/voaf#Vocabulary> ;
        <http://purl.org/dc/terms/creator>
                <http://www.naa.gov.au/> ;
        <http://purl.org/dc/terms/description>
                "The AGLS Metadata Terms Namespace provides URIs for the AGLS Metadata Terms Vocabulary in the context of AGLS Metadata Standard, a set of metadata properties and associated usage guidelines to improve the visibility, manageability and interoperability of online information and services. Vocabulary terms are declared using RDF Schema language to support RDF applications. It will be updated according to AGLS Working Group decisions."@en ;
        <http://purl.org/dc/terms/issued>
                "2002-04-17"^^xsd:date ;
        <http://purl.org/dc/terms/language>
                <http://id.loc.gov/vocabulary/iso639-2/eng> ;
        <http://purl.org/dc/terms/modified>
                "2010-06-29"^^xsd:date ;
        <http://purl.org/dc/terms/publisher>
                <http://www.naa.gov.au/> ;
        <http://purl.org/dc/terms/title>
                "AGLS Metadata Terms"@en ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2017-01-02"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Annual review - no change"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2023-06-30"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "The vocabulary URI is 404. We'll contact the editors and maintainers. A fallback access to the RDF file is available at https://agls.gov.au/schemas/rdfs/2010/06/30/aglsterms.rdf. I've added a new homepage"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2013-06-02"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "This vocabulary seems to wrongly assign the class \"SubjectSchema\" to Dublin Core namespace.(e.g dcterms:SubjectSchema). See http://bit.ly/13gsJBP."
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <https://orcid.org/0000-0003-1562-6922> ;
                  <dcterms:date>     "2023-06-30"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "[Official] The National Archives of Australia will be decommissioning the AGLS Metadata Standard website at the end of 2023. More information can be found at https://www.naa.gov.au/information-management/standards/agls-metadata-standard. An archived copy of the AGLS website will continue to be available via The National Library of Australia’s Trove facility: https://webarchive.nla.gov.au/awa/20230304113201/https://agls.gov.au/"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2015-06-02"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Annual review - no change"
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2014-06-03"^^xsd:date ;
