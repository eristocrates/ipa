                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2015-04-17"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Added creators and publishers. This vocabulary is maintained on Google Code, which is closing soon. Editors contacted to know where it will be moved to."
                ] ;
