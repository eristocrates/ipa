                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://google.com/+PierreYvesVandenbussche> ;
                  <dcterms:date>     "2019-04-30"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "This vocabulary provides metadata for scholarly document representation, with istex categorisation along with some extracted entities (geography, organization, places, etc.)"
                ] ;
