                  <http://purl.org/stuff/rev#text>
                          "This vocabulary relies on a few other, very specific OBO vocabularies, which have not been included in LOV."
                ] ;
        <http://purl.org/stuff/rev#hasReview>
                [ a                  <http://purl.org/stuff/rev#Review> ;
                  <dcterms:creator>  <http://data.semanticweb.org/person/bernard-vatant> ;
                  <dcterms:date>     "2013-05-19"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "Classes and properties are not declared under the declared xmlns http://www.w3.org/2001/sw/hcls/ns/transmed/tmo#, but directly under http://www.w3.org/2001/sw/hcls/ns/transmed/. The later is therefore taken here as the \"actual\" vocabulary namespace and URI. Both URI are de-referencable to the same RDF file anyway."
                ] ;
