                  <dcterms:date>     "2013-08-23"^^xsd:date ;
                  <http://purl.org/stuff/rev#text>
                          "RADion could be useful for describing assets in repositories, quite similar to the ADMS vocabulary. It handles versioning by using xhv:next and xhv:prev properties (xhv:http://www.w3.org/1999/xhtml/vocab#)"
                ] ;
