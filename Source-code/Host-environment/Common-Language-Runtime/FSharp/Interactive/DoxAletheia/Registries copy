File.WriteAllText(Path.Combine(__SOURCE_DIRECTORY__, $"{prefixLabel}NestedTypeArrays.fsx"), NestedTypeArraysText)
                """
                    .TrimStart()
                    .TrimEnd()

            File.WriteAllText(TypeProviderFilePath, TypeProviderText)















vocabularyIriStrings
|> Array.Parallel.iter (fun vocabularyIriString ->

    let label_from_prefixcc =
        prefixcc.json.JsonValue.Properties()
        |> Array.Parallel.tryPick (fun (jsonKey, jsonValue) ->

            if (jsonValue.AsString() = vocabularyIriString) then
                Some(jsonKey)
            else
                None)

    match label_from_prefixcc with
    | _ when label_from_prefixcc.IsNone ->
        let label_from_lov =
            lov.vocabulary.json
            |> Array.Parallel.tryPick (fun vocabulary ->

                if vocabulary.Nsp = vocabularyIriString then
                    Some(vocabulary.Prefix)
                else
                    None

            )


        match label_from_lov with
        | _ when label_from_lov.IsNone -> iriStringsWithoutPrefix.Add vocabularyIriString
        | _ -> codegenTypeProviders label_from_lov.Value vocabularyIriString
    | _ -> codegenTypeProviders label_from_prefixcc.Value vocabularyIriString

)

