let codegen = 
    Oak() {
        AnonymousModule() {

            for nestedType in typeof<Generative>.GetNestedTypes () do 
                Value($"{nestedType.Name}Array", $"Generative.{nestedType.Name}.Get graph |> Seq.toArray")

        }

    }
    |> Gen.mkOak
    |> Gen.run


    
