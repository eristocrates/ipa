let iriStringsWithoutPrefix = ResizeArray<string>()
let vocabularyFilePaths = ResizeArray<string>()

type UnknownContentTypeRecord =
    { namespaceUriString: string
      contentType: string }

let uriStringWithNoSuccessCode = ResizeArray<string>()
let uriStringWithNoContentTypes = ResizeArray<string>()
let uriStringWithUnknownContentTypes = ResizeArray<UnknownContentTypeRecord>()







let codegenTypeProviders (prefixLabel: string) (vocabularyIriString: string) =

    let uriDereferenceResponse =
        http {

            GET vocabularyIriString

        }
        |> Request.send
        |> Response.asOriginalHttpResponseMessage

    if not uriDereferenceResponse.IsSuccessStatusCode then
        uriStringWithNoSuccessCode.Add vocabularyIriString
    else
        let contentType =
            uriDereferenceResponse.Content.Headers
            |> Seq.pick (fun header ->

                if header.Key = "Content-Type" then
                    Some(header.Value |> Seq.item 0)
                else
                    uriStringWithNoContentTypes.Add vocabularyIriString
                    None

            )
        // TODO figure out overwrite logic by directory and/or format
        let directoryPath =
            Path.Combine(VocabularyDirectory, (iriToRelativePath vocabularyIriString))


        if Directory.Exists directoryPath then
            let ttlPaths =
                Directory.GetFiles(VocabularyDirectory, "*.ttl")
                |> Array.toSeq

            vocabularyFilePaths.AddRange ttlPaths

        else
            let fileName =
                match contentType with
                | _ when contentType.Contains("turtle") -> $"{prefixLabel}.ttl"
                | _ ->
                    uriStringWithUnknownContentTypes.Add
                        { namespaceUriString = vocabularyIriString
                          contentType = contentType }

                    $"{prefixLabel}.download"

            let vocabularyText =
                uriDereferenceResponse.Content.ReadAsStringAsync()
                |> Async.AwaitTask
                |> Async.RunSynchronously

            let vocabularyFilePath = Ensure.path (Path.Combine(directoryPath, fileName))


            vocabularyFilePaths.Add vocabularyFilePath

            File.WriteAllText(vocabularyFilePath, vocabularyText)


            let TypeProviderFilePath = Path.Combine(directoryPath, $"{prefixLabel}{TypeProviderLiteral}.fsx")

            
            let NestedTypeArraysMetaText = 
                Scriban
                    .Template
                    .Parse(File.ReadAllText(NestedTypeArraysMetaTemplateFilePath))
                    .Render(
                        {| 

                                    type_provider_file_path =  TypeProviderFilePath
                                    type_provider_module = $"{Capitalize prefixLabel}{TypeProviderLiteral}"

                                |}
            
                        )
            let TypeProviderText =
                $$"""
