@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix wty: <https://ns.verisav.fr/wty#>.

wty: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/>;
     <http://purl.org/dc/terms/created> "2025-12-16"^^xsd:date;
     <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Kévin Boutillier" ; 
                                         rdfs:seeAlso <https://orcid.org/0009-0001-0356-4421> ; 
                                         rdfs:seeAlso <https://www.verisav.fr/en/founders/kevin-boutillier> ; 
                                         rdfs:seeAlso <https://www.linkedin.com/in/kévinboutillier> ; 
                                         a <http://xmlns.com/foaf/0.1/Person>];
     <http://purl.org/dc/terms/description> "Vocabulaire pour garanties et contrats lisibles par machine, permettant l'automatisation complète des décisions de paiement et évaluation de couverture dans le service après-vente."@fr,
                                            "Vocabulary for machine-readable warranties and contracts, enabling complete automation of payment decisions and coverage assessment in after-sales service."@en;
     <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
     <http://purl.org/dc/terms/modified> "2025-12-28"^^xsd:date;
     <http://purl.org/dc/terms/publisher> <https://www.verisav.fr/>;
     <http://purl.org/dc/terms/rights> "Copyright © 2025 Verisav SAS. Tous droits réservés."@fr,
                                       "Copyright © 2025 Verisav SAS. All rights reserved."@en;
     <http://purl.org/dc/terms/title> "Verisav Warranty & Contracts Vocabulary"@en;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "wty";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ns.verisav.fr/wty#";
     a <http://purl.org/vocommons/voaf#Vocabulary>,
       <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "Version 1.0.0 (2025-12-28): Initial release. Vocabulary for machine-readable warranties and contracts with payment rules, coverage definitions, exclusions, and automated claim assessment."@en,
                  "Version 1.0.0 (2025-12-28): Version initiale. Vocabulaire pour garanties et contrats lisibles par machine avec règles de paiement, définitions de couverture, exclusions et évaluation automatisée des réclamations."@fr;
     rdfs:label "Verisav Warranty & Contracts Vocabulary"@en,
                "Vocabulaire Garanties et Contrats Verisav"@fr;
     <http://www.w3.org/2002/07/owl#imports> <https://schema.org/>,
                                             <https://ns.verisav.fr/rma#>,
                                             <https://ns.verisav.fr/dpp#>;
     <http://www.w3.org/2002/07/owl#versionInfo> "1.0.0";
     <http://www.w3.org/ns/dcat#distribution> [<http://www.w3.org/ns/dcat#accessURL> <https://www.verisav.fr/api/graphql> ; 
                                               <http://purl.org/dc/terms/title> "Verisav Vocabularies GraphQL API"@en ; 
                                               <http://purl.org/dc/terms/format> "application/graphql" ; 
                                               <http://purl.org/dc/terms/description> "GraphQL API for querying all Verisav vocabularies (DPP, RMA, WTY)"@en ; 
                                               a <http://www.w3.org/ns/dcat#Distribution>],
                                              [<http://www.w3.org/ns/dcat#downloadURL> <https://ns.verisav.fr/wty/wty.jsonld> ; 
                                               <http://purl.org/dc/terms/format> "application/ld+json" ; 
                                               a <http://www.w3.org/ns/dcat#Distribution>],
                                              [<http://www.w3.org/ns/dcat#downloadURL> <https://ns.verisav.fr/wty/wty.ttl> ; 
                                               <http://purl.org/dc/terms/format> "text/turtle" ; 
                                               a <http://www.w3.org/ns/dcat#Distribution>],
                                              [<http://www.w3.org/ns/dcat#accessURL> <https://www.verisav.fr/api/wty/wty.jsonld> ; 
                                               <http://purl.org/dc/terms/title> "WTY Vocabulary (JSON-LD via API)"@en ; 
                                               <http://purl.org/dc/terms/format> "application/ld+json" ; 
                                               a <http://www.w3.org/ns/dcat#Distribution>];
     <https://schema.org/potentialAction> [<https://schema.org/target> <https://www.verisav.fr/api/v1/vocabulary/wty/search?q=%7Bquery%7D> ; 
                                           <https://schema.org/query-input> "required name=query" ; 
                                           a <https://schema.org/SearchAction>].
wty:ClaimAssessment a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Automated assessment of a claim against warranty or contract, determining coverage and payment responsibility."@en;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "Claim Assessment"@en,
                               "Évaluation de Réclamation"@fr;
                    rdfs:subClassOf <https://schema.org/Thing>;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Condition a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A condition that must be met for warranty or contract to apply (normal use, proper installation, documentation, etc.)."@en;
              rdfs:isDefinedBy wty:;
              rdfs:label "Condition"@en,
                         "Condition"@fr;
              rdfs:subClassOf <https://schema.org/Thing>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Contract a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A contract (maintenance, extension, insurance) that defines terms and coverage for after-sales service."@en;
             rdfs:isDefinedBy wty:;
             rdfs:label "Contract"@en,
                        "Contrat"@fr;
             rdfs:subClassOf <https://schema.org/Contract>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Coverage a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Defines what is covered by a warranty or contract (components, defect types, repair types, periods)."@en;
             rdfs:isDefinedBy wty:;
             rdfs:label "Coverage"@en,
                        "Couverture"@fr;
             rdfs:subClassOf <https://schema.org/Thing>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Exclusion a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Defines what is NOT covered by a warranty or contract (excluded defect types, causes, components)."@en;
              rdfs:isDefinedBy wty:;
              rdfs:label "Exclusion"@en,
                         "Exclusion"@fr;
              rdfs:subClassOf <https://schema.org/Thing>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Invoice a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An invoice generated automatically based on warranty/contract payment rules and claim assessment."@en;
            rdfs:isDefinedBy wty:;
            rdfs:label "Invoice"@en,
                       "Facture"@fr;
            rdfs:subClassOf <https://schema.org/Invoice>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Limit a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Defines limits (financial, temporal, quantity) for warranty or contract coverage."@en;
          rdfs:isDefinedBy wty:;
          rdfs:label "Limit"@en,
                     "Limite"@fr;
          rdfs:subClassOf <https://schema.org/Thing>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:PaymentRule a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Defines who pays for what (diagnostic, repair, parts, travel) and payment splits between parties."@en;
                rdfs:isDefinedBy wty:;
                rdfs:label "Payment Rule"@en,
                           "Règle de Paiement"@fr;
                rdfs:subClassOf <https://schema.org/Thing>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:Warranty a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An extended warranty that defines coverage, exclusions, payment rules, and conditions in a machine-readable format for automation."@en;
             rdfs:isDefinedBy wty:;
             rdfs:label "Warranty"@en,
                        "Garantie"@fr;
             rdfs:subClassOf <https://ns.verisav.fr/dpp#Warranty>,
                             <https://schema.org/WarrantyScope>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:appliedCoverage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Links a claim assessment to the coverage that applies."@en;
                    rdfs:domain wty:ClaimAssessment;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "applied coverage"@en,
                               "couverture appliquée"@fr;
                    rdfs:range wty:Coverage;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:appliedExclusions a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links a claim assessment to exclusions that apply."@en;
                      rdfs:domain wty:ClaimAssessment;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "applied exclusions"@en,
                                 "exclusions appliquées"@fr;
                      rdfs:range wty:Exclusion;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:assessesClaim a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Links a claim assessment to the ticket or claim being assessed."@en;
                  rdfs:domain wty:ClaimAssessment;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "assesses claim"@en,
                             "évalue la réclamation"@fr;
                  rdfs:range <https://ns.verisav.fr/rma#Ticket>,
                             <https://ns.verisav.fr/dpp#WarrantyClaim>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:assessmentDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Date when the assessment was performed."@en;
                   rdfs:domain wty:ClaimAssessment;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "assessment date"@en,
                              "date d'évaluation"@fr;
                   rdfs:range xsd:dateTime;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:assessmentReason a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Reason for the assessment result (explanation of why covered or not)."@en;
                     rdfs:domain wty:ClaimAssessment;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "assessment reason"@en,
                                "raison d'évaluation"@fr;
                     rdfs:range xsd:string;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:assessmentResult a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Result of the assessment (covered, not_covered, partially_covered, pending_verification)."@en;
                     rdfs:domain wty:ClaimAssessment;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "assessment result"@en,
                                "résultat d'évaluation"@fr;
                     rdfs:range xsd:string;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:autoRenewal a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Whether the contract auto-renews."@en;
                rdfs:domain wty:Contract;
                rdfs:isDefinedBy wty:;
                rdfs:label "auto renewal"@en,
                           "renouvellement automatique"@fr;
                rdfs:range xsd:boolean;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:checksCoverage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Links a claim assessment to the coverage being checked."@en;
                   rdfs:domain wty:ClaimAssessment;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "checks coverage"@en,
                              "vérifie la couverture"@fr;
                   rdfs:range wty:Coverage;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:checksExclusions a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links a claim assessment to exclusions being checked."@en;
                     rdfs:domain wty:ClaimAssessment;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "checks exclusions"@en,
                                "vérifie les exclusions"@fr;
                     rdfs:range wty:Exclusion;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:conditionDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Description of the condition that must be met."@en;
                         rdfs:domain wty:Condition;
                         rdfs:isDefinedBy wty:;
                         rdfs:label "condition description"@en,
                                    "description de condition"@fr;
                         rdfs:range xsd:string;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:conditionType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Type of condition (normal_use, proper_installation, documentation, proof_of_purchase, etc.)."@en;
                  rdfs:domain wty:Condition;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "condition type"@en,
                             "type de condition"@fr;
                  rdfs:range xsd:string;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:contractEndDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "End date of the contract."@en;
                    rdfs:domain wty:Contract;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "contract end date"@en,
                               "date de fin de contrat"@fr;
                    rdfs:range xsd:date;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:contractNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Unique identifier for the contract."@en;
                   rdfs:domain wty:Contract;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "contract number"@en,
                              "numéro de contrat"@fr;
                   rdfs:range xsd:string;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:contractStartDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Start date of the contract."@en;
                      rdfs:domain wty:Contract;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "contract start date"@en,
                                 "date de début de contrat"@fr;
                      rdfs:range xsd:date;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:contractStatus a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Status of the contract (active, expired, suspended, cancelled, renewed)."@en;
                   rdfs:domain wty:Contract;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "contract status"@en,
                              "statut du contrat"@fr;
                   rdfs:range xsd:string;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:contractType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Type of contract (maintenance, extension, insurance, service_agreement)."@en;
                 rdfs:domain wty:Contract;
                 rdfs:isDefinedBy wty:;
                 rdfs:label "contract type"@en,
                            "type de contrat"@fr;
                 rdfs:range xsd:string;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coverageEndDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "End date of coverage period."@en;
                    rdfs:domain wty:Coverage;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "coverage end date"@en,
                               "date de fin de couverture"@fr;
                    rdfs:range xsd:date;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coveragePeriod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The period during which coverage applies (e.g., '24_months', 'lifetime')."@en;
                   rdfs:domain wty:Coverage;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "coverage period"@en,
                              "période de couverture"@fr;
                   rdfs:range xsd:string;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coverageStartDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Start date of coverage period."@en;
                      rdfs:domain wty:Coverage;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "coverage start date"@en,
                                 "date de début de couverture"@fr;
                      rdfs:range xsd:date;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coveredAmount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Amount covered by warranty/contract for this claim."@en;
                  rdfs:domain wty:ClaimAssessment;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "covered amount"@en,
                             "montant couvert"@fr;
                  rdfs:range xsd:decimal;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coveredCurrency a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Currency code for the covered amount (ISO 4217)."@en;
                    rdfs:domain wty:ClaimAssessment;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "covered currency"@en,
                               "devise couverte"@fr;
                    rdfs:range xsd:string;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coversComponent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Links coverage to specific product components that are covered."@en;
                    rdfs:domain wty:Coverage;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "covers component"@en,
                               "couvre le composant"@fr;
                    rdfs:range <https://schema.org/Product>,
                               <https://ns.verisav.fr/dpp#ProductPassport>;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coversDefectType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links coverage to types of defects that are covered."@en;
                     rdfs:domain wty:Coverage;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "covers defect type"@en,
                                "couvre le type de défaut"@fr;
                     rdfs:range <https://schema.org/Thing>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:coversRepairType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links coverage to types of repairs that are covered."@en;
                     rdfs:domain wty:Coverage;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "covers repair type"@en,
                                "couvre le type de réparation"@fr;
                     rdfs:range <https://ns.verisav.fr/dpp#Intervention>,
                                <https://schema.org/Service>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:customerResponsibility a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Amount the customer is responsible for."@en;
                           rdfs:domain wty:ClaimAssessment;
                           rdfs:isDefinedBy wty:;
                           rdfs:label "customer responsibility"@en,
                                      "responsabilité client"@fr;
                           rdfs:range xsd:decimal;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:definesConditions a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links a warranty or contract to its conditions."@en;
                      rdfs:domain wty:Warranty,
                                  wty:Contract;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "defines conditions"@en,
                                 "définit les conditions"@fr;
                      rdfs:range wty:Condition;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:definesCoverage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Links a warranty or contract to its coverage definition."@en;
                    rdfs:domain wty:Warranty,
                                wty:Contract;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "defines coverage"@en,
                               "définit la couverture"@fr;
                    rdfs:range wty:Coverage;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:definesExclusions a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links a warranty or contract to its exclusion definitions."@en;
                      rdfs:domain wty:Warranty,
                                  wty:Contract;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "defines exclusions"@en,
                                 "définit les exclusions"@fr;
                      rdfs:range wty:Exclusion;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:definesLimits a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Links a warranty or contract to its limits."@en;
                  rdfs:domain wty:Warranty,
                              wty:Contract;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "defines limits"@en,
                             "définit les limites"@fr;
                  rdfs:range wty:Limit;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:definesPaymentRule a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Links a warranty or contract to its payment rule."@en;
                       rdfs:domain wty:Warranty,
                                   wty:Contract;
                       rdfs:isDefinedBy wty:;
                       rdfs:label "defines payment rule"@en,
                                  "définit la règle de paiement"@fr;
                       rdfs:range wty:PaymentRule;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:determinesPayment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links a claim assessment to the payment rule used to determine payment responsibility."@en;
                      rdfs:domain wty:ClaimAssessment;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "determines payment"@en,
                                 "détermine le paiement"@fr;
                      rdfs:range wty:PaymentRule;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:excludedCause a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Links exclusion to causes that are excluded (normal wear, damage, misuse, etc.)."@en;
                  rdfs:domain wty:Exclusion;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "excluded cause"@en,
                             "cause exclue"@fr;
                  rdfs:range <https://schema.org/Thing>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:excludedComponent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links exclusion to specific components that are excluded."@en;
                      rdfs:domain wty:Exclusion;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "excluded component"@en,
                                 "composant exclu"@fr;
                      rdfs:range <https://schema.org/Product>;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:excludedDefectType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Links exclusion to types of defects that are excluded."@en;
                       rdfs:domain wty:Exclusion;
                       rdfs:isDefinedBy wty:;
                       rdfs:label "excluded defect type"@en,
                                  "type de défaut exclu"@fr;
                       rdfs:range <https://schema.org/Thing>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:firstParty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The party (organization or person) that pays first or primarily."@en;
               rdfs:domain wty:PaymentRule;
               rdfs:isDefinedBy wty:;
               rdfs:label "first party"@en,
                          "première partie"@fr;
               rdfs:range <https://schema.org/Organization>,
                          <https://schema.org/Person>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:generatesInvoice a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links a claim assessment to the invoice generated."@en;
                     rdfs:domain wty:ClaimAssessment;
                     rdfs:isDefinedBy wty:;
                     rdfs:label "generates invoice"@en,
                                "génère la facture"@fr;
                     rdfs:range wty:Invoice;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:hasPaymentLimit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Whether the payment rule has a limit."@en;
                    rdfs:domain wty:PaymentRule;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "has payment limit"@en,
                               "a une limite de paiement"@fr;
                    rdfs:range xsd:boolean;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoiceAmount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Total amount of the invoice."@en;
                  rdfs:domain wty:Invoice;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "invoice amount"@en,
                             "montant de facture"@fr;
                  rdfs:range xsd:decimal;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoiceCurrency a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Currency code for the invoice amount (ISO 4217)."@en;
                    rdfs:domain wty:Invoice;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "invoice currency"@en,
                               "devise de facture"@fr;
                    rdfs:range xsd:string;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoiceDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Date when the invoice was generated."@en;
                rdfs:domain wty:Invoice;
                rdfs:isDefinedBy wty:;
                rdfs:label "invoice date"@en,
                           "date de facture"@fr;
                rdfs:range xsd:dateTime;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoiceNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Unique identifier for the invoice."@en;
                  rdfs:domain wty:Invoice;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "invoice number"@en,
                             "numéro de facture"@fr;
                  rdfs:range xsd:string;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoiceStatus a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Status of the invoice (draft, sent, paid, overdue, cancelled)."@en;
                  rdfs:domain wty:Invoice;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "invoice status"@en,
                             "statut de facture"@fr;
                  rdfs:range xsd:string;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:invoices a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Links an invoice to the intervention, repair, or service being invoiced."@en;
             rdfs:domain wty:Invoice;
             rdfs:isDefinedBy wty:;
             rdfs:label "facture"@fr,
                        "invoices"@en;
             rdfs:range <https://ns.verisav.fr/dpp#WorkOrder>,
                        <https://ns.verisav.fr/rma#Resolution>,
                        <https://ns.verisav.fr/dpp#Intervention>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:limitAmount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Maximum amount for the limit."@en;
                rdfs:domain wty:Limit;
                rdfs:isDefinedBy wty:;
                rdfs:label "limit amount"@en,
                           "montant limite"@fr;
                rdfs:range xsd:decimal;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:limitCurrency a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Currency code for the limit amount (ISO 4217)."@en;
                  rdfs:domain wty:Limit;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "limit currency"@en,
                             "devise limite"@fr;
                  rdfs:range xsd:string;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:limitPeriod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Period over which the limit applies (per_month, per_year, total, etc.)."@en;
                rdfs:domain wty:Limit;
                rdfs:isDefinedBy wty:;
                rdfs:label "limit period"@en,
                           "période limite"@fr;
                rdfs:range xsd:string;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:limitQuantity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Maximum quantity (for number-based limits like interventions)."@en;
                  rdfs:domain wty:Limit;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "limit quantity"@en,
                             "quantité limite"@fr;
                  rdfs:range xsd:integer;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:limitType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Type of limit (amount, number_of_interventions, per_incident, total, etc.)."@en;
              rdfs:domain wty:Limit;
              rdfs:isDefinedBy wty:;
              rdfs:label "limit type"@en,
                         "type de limite"@fr;
              rdfs:range xsd:string;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:payer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "The party responsible for paying the invoice."@en;
          rdfs:domain wty:Invoice;
          rdfs:isDefinedBy wty:;
          rdfs:label "payer"@en,
                     "payeur"@fr;
          rdfs:range <https://schema.org/Organization>,
                     <https://schema.org/Person>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:paymentDecision a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Links a claim assessment to the payment rule that determines who pays."@en;
                    rdfs:domain wty:ClaimAssessment;
                    rdfs:isDefinedBy wty:;
                    rdfs:label "payment decision"@en,
                               "décision de paiement"@fr;
                    rdfs:range wty:PaymentRule;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:paymentPercentage a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Percentage of cost paid by the first party (0-100)."@en;
                      rdfs:domain wty:PaymentRule;
                      rdfs:isDefinedBy wty:;
                      rdfs:label "payment percentage"@en,
                                 "pourcentage de paiement"@fr;
                      rdfs:range xsd:decimal;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:paymentSplit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "JSON string describing payment split between multiple parties."@en,
                              "JSON string describing how payment is split between parties (if multiple payers)."@en;
                 rdfs:domain wty:Invoice,
                             wty:PaymentRule;
                 rdfs:isDefinedBy wty:;
                 rdfs:label "payment split"@en,
                            "répartition du paiement"@fr;
                 rdfs:range xsd:string;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:paysFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Links a payment rule to what it pays for (diagnostic, repair, parts, travel, etc.)."@en;
            rdfs:domain wty:PaymentRule;
            rdfs:isDefinedBy wty:;
            rdfs:label "pays for"@en,
                       "paie pour"@fr;
            rdfs:range <https://ns.verisav.fr/dpp#Intervention>,
                       <https://ns.verisav.fr/dpp#Diagnostic>,
                       <https://schema.org/Service>,
                       <https://ns.verisav.fr/dpp#ReplacementPart>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:requiresDocumentation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Whether documentation is required (proof of purchase, installation certificate, etc.)."@en;
                          rdfs:domain wty:Condition;
                          rdfs:isDefinedBy wty:;
                          rdfs:label "requires documentation"@en,
                                     "nécessite une documentation"@fr;
                          rdfs:range xsd:boolean;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:requiresProof a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Whether proof is required (photos, diagnostic report, etc.)."@en;
                  rdfs:domain wty:Condition;
                  rdfs:isDefinedBy wty:;
                  rdfs:label "requires proof"@en,
                             "nécessite une preuve"@fr;
                  rdfs:range xsd:boolean;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:triggersAssessment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Links a ticket or claim to a claim assessment."@en;
                       rdfs:domain <https://ns.verisav.fr/rma#Ticket>,
                                   <https://ns.verisav.fr/dpp#WarrantyClaim>;
                       rdfs:isDefinedBy wty:;
                       rdfs:label "triggers assessment"@en,
                                  "déclenche l'évaluation"@fr;
                       rdfs:range wty:ClaimAssessment;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
wty:validityPeriod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Period during which the condition is valid (e.g., 'warranty_period', 'lifetime')."@en;
                   rdfs:domain wty:Condition;
                   rdfs:isDefinedBy wty:;
                   rdfs:label "validity period"@en,
                              "période de validité"@fr;
                   rdfs:range xsd:string;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
