                          rdfs:range modsci:ModernScience.
modsci:usesMethodsFrom a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain modsci:ModernScience;
                       rdfs:range modsci:ModernScience.
modsci:usesTechniquesFrom a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                            <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain modsci:ModernScience;
                          rdfs:range modsci:ModernScience.
modsci:x a <http://www.w3.org/2003/11/swrl#Variable>.
modsci:y a <http://www.w3.org/2003/11/swrl#Variable>.
modsci:z a <http://www.w3.org/2003/11/swrl#Variable>.
