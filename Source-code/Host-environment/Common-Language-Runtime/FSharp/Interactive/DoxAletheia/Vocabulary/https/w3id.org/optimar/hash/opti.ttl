@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix opti: <https://w3id.org/optimar#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

nsprov:generated rdfs:comment "Relaciona un evento con los datos generados por el mismo."@es,
                              "Relates an event to the generated data by the same."@en;
                 rdfs:domain opti:Event;
                 rdfs:label "Genera"@es,
                            "Generates"@en;
                 rdfs:range opti:Data.
w3id:optimar dc11:creator "Alejandro Flores (USAL), Alberto Montero (USAL), Oihana Garcia (Tekniker) and Cristina Aceta (Tekniker)";
             dc11:date "2025-10-06"^^xsd:date;
             dc11:description "This ontology describes the components, failures, sensors, and events related to offshore wind platforms."@en,
                              "Esta ontología describe los componentes, fallos, sensores y eventos relacionados con las plataformas eólicas offshore."@es;
             dc11:language "en";
             dc11:name "OPTiMAR Offshore Wind Ontology"@en,
                       "Ontología Offshore OPTiMAR"@es;
             dc11:title "Offshore Wind Power Platform Ontology for OPTiMAR"@en,
                        "Ontología de Plataforma Eólica Offshore para OPTiMAR"@es;
             dcterms:abstract "Ontologia que modela los elementos estructurales, sensores, eventos y fallos de plataformas eólicas offshore, incluyendo datos de medición y actores involucrados."@es,
                              "Ontology modeling structural elements, sensors, events, and failures in offshore wind platforms, including measurement data and involved actors."@en;
             dcterms:bibliographicCitation "Flores, A., Montero, A., Garcia, O., & Aceta, C. (2025). Ontología de Plataforma Eólica Offshore para OPTiMAR. DOI: 10.1234/abcd"@es,
                                           "Flores, A., Montero, A., Garcia, O., & Aceta, C. (2025). Offshore Wind Power Platform Ontology for OPTiMAR. DOI: 10.1234/abcd"@en;
             dcterms:created "2025-09-30"^^xsd:date;
             dcterms:issued "2025-09-30"^^xsd:date;
             dcterms:license <https://opensource.org/licenses/MIT>;
             dcterms:modified "2025-10-06"^^xsd:date;
             dcterms:publisher "University of Salamanca, Technology and Research Centre - Tekniker"@en,
                               "Universidad de Salamanca, Centro Tecnológico y de Investigación - Tekniker"@es;
             dcterms:rights "Este trabajo se distribuye bajo la licencia MIT. Se permite copiar, modificar y distribuir bajo los términos de dicha licencia."@es,
                            "This work is distributed under the MIT License. It may be copied, modified, and distributed under the terms of this license."@en;
             dcterms:status "estable"@es,
                            "stable"@en;
             vann:preferredNamespacePrefix "ex";
             vann:preferredNamespaceUri opti:;
             a owl:Ontology;
             owl:backwardCompatibleWith <https://w3id.org/optimar/0.2>;
             owl:versionIRI <https://w3id.org/optimar/1.0>;
             owl:versionInfo "Versión 1.0 de la ontología"@es,
                             "Version 1.0 of the Ontology"@en;
             foaf:homepage w3id:optimar.
opti:Actor a owl:Class;
           rdfs:comment "Un actor que interactúa o gestiona la plataforma eólica."@es,
                        "An actor that interacts or manages the offshore wind power platform."@en;
           rdfs:label "Actor"@es,
                      "Actor"@en.
opti:AnalyticalRole a owl:Class;
                    rdfs:comment "Rol orientado al analisis de datos y generación de información útil para la toma de decisiones."@es,
                                 "Role focused on data analysis and generation of useful information for decision-making."@en;
                    rdfs:label "Rol analítico"@es,
                               "Analytical Role"@en;
                    rdfs:subClassOf opti:Role.
opti:Anemometer a owl:Class;
                rdfs:comment "Sensor que mide la velocidad y dirección del viento en el parque eólico."@es,
                             "Sensor that measures wind speed and direction in the wind farm."@en;
                rdfs:label "Anemómetro"@es,
                           "Anemometer"@en;
                rdfs:subClassOf opti:Sensor.
opti:Base a owl:Class;
          rdfs:comment "La base que soporta la plataforma flotante."@es,
                       "The base that supports the floating platform."@en;
          rdfs:label "Base (subestructura flotante)"@es,
                     "Base (floating substructure)"@en;
          rdfs:subClassOf opti:StructuralComponent.
opti:Blade a owl:Class;
           rdfs:comment "Las palas de la turbina que capturan la energía eólica."@es,
                        "The blades of the turbine that capture the wind energy."@en;
           rdfs:label "Pala"@es,
                      "Blade"@en;
           rdfs:subClassOf opti:TurbineComponent.
opti:CloudAdministrator a owl:Class;
                        rdfs:comment "Responsable de la administración y seguridad de los servicios en la nube que procesan los datos de la plataforma."@es,
                                     "Responsible for managing and securing cloud services that process data from the platform."@en;
                        rdfs:label "Administrador de nube"@es,
                                   "Cloud Administrator"@en;
                        rdfs:subClassOf opti:Actor.
opti:Component a owl:Class;
               rdfs:comment "Un componente de una plataforma eólica offshore, como las palas, torres, sistema de pitch, etc."@es,
                            "An component of an offshore wind power platform, such as blades, towers, pitch system, etc."@en;
               rdfs:label "Componente"@es,
                          "Component"@en.
opti:ComponentBreakage a owl:Class;
                       rdfs:comment "Fallo originado por la fractura o rotura de un componente de la plataforma eólica."@es,
                                    "Failure caused by the fracture or breakage of an offshore wind turbine component."@en;
                       rdfs:label "Rotura de componente"@es,
                                  "Component Breakage"@en;
                       rdfs:subClassOf opti:Failure.
opti:Corrosion a owl:DatatypeProperty;
               rdfs:comment "Índice general de corrosión detectada en un componente."@es,
                            "General corrosion index detected in a component."@en;
               rdfs:domain opti:CorrosionEvent;
               rdfs:label "Corrosión"@es,
                          "Corrosion"@en;
               rdfs:range xsd:decimal.
opti:CorrosionCamera a owl:Class;
                     rdfs:comment "Cámara utilizada para detectar y monitorear corrosión en la estructura de la plataforma."@es,
                                  "Camera used to detect and monitor corrosion in the platform structure."@en;
                     rdfs:label "Cámara corrosión"@es,
                                "Corrosion Camera"@en;
                     rdfs:subClassOf opti:Sensor;
                     owl:disjointWith opti:StructuralCamera,
                                      opti:Anemometer,
                                      opti:DynamicMonitor.
opti:CorrosionEvent a owl:Class;
                    rdfs:comment "Degradación de la estructura metálica de la plataforma por efectos de corrosión."@es,
                                 "Degradation of the platform's metallic structure due to corrosion effects."@en;
                    rdfs:label "Evento de Corrosión"@es,
                               "Corrosion Event"@en;
                    rdfs:subClassOf opti:FailureEvent;
                    owl:disjointWith opti:MaterialFatigue,
                                     opti:Misalignment.
opti:Data a owl:Class;
          rdfs:comment "Una clase general para representar los datos de medición recolectados por sensores u otros sistemas."@es,
                       "A class for representing the measurement data collected by sensors or other systems."@en;
          rdfs:label "Dato"@es,
                     "Data"@en.
opti:DataAnalyst a owl:Class;
                 rdfs:comment "Especialista que analiza los datos recolectados para detectar patrones, fallos y oportunidades de optimización."@es,
                              "Specialist who analyzes collected data to detect patterns, failures, and optimization opportunities."@en;
                 rdfs:label "Analista de datos"@es,
                            "Data Analyst"@en;
                 rdfs:subClassOf opti:Actor.
opti:Deformation a owl:DatatypeProperty;
                 rdfs:comment "Grado de deformación registrado en el componente."@es,
                              "Degree of deformation recorded in the component."@en;
                 rdfs:domain opti:Data;
                 rdfs:label "Deformación"@es,
                            "Deformation"@en;
                 rdfs:range xsd:decimal.
opti:DynamicMonitor a owl:Class;
                    rdfs:comment "Dispositivo que mide parámetros dinámicos de la plataforma como vibraciones y movimientos."@es,
                                 "Device that measures dynamic parameters of the platform, such as vibrations and movements."@en;
                    rdfs:label "Monitor dinámico"@es,
                               "Dynamic Monitor"@en;
                    rdfs:subClassOf opti:Sensor.
opti:EnvironmentalCondition a owl:Class;
                            rdfs:comment "Las condiciones ambientales que afectan a la plataforma eólica, como la velocidad del viento, la temperatura, etc."@es,
                                         "The environmental conditions that affect the offshore wind power platform, such as wind speed, temperature, etc."@en;
                            rdfs:label "Condición ambiental"@es,
                                       "Environmental Condition"@en.
opti:Event a owl:Class;
           rdfs:comment "Un evento que ocurre en la plataforma eólica, como la detección de un fallo."@es,
                        "An event that occurs in the offshore wind power platform, such as a failure detection."@en;
           rdfs:label "Evento"@es,
                      "Event"@en.
opti:Failure a owl:Class;
             rdfs:comment "Una clase que representa fallos identificados en la plataforma eólica."@es,
                          "A class that represents identified failures in the wind platform."@en;
             rdfs:label "Fallo"@es,
                        "Failure"@en.
opti:FailureEvent a owl:Class;
                  rdfs:comment "Evento que representa un fallo detectado en el sistema, debe estar causado por al menos un fallo. "@es,
                               "Event that represents a detected failure in the system, must be caused by at least one failure."@en;
                  rdfs:label "Evento de fallo"@es,
                             "Failure Event"@en;
                  rdfs:subClassOf [owl:someValuesFrom opti:Failure ; 
                                   owl:onProperty opti:causedBy ; 
                                   a owl:Restriction],
                                  opti:Event.
opti:FloatingPlatform a owl:Class;
                      rdfs:comment "Una plataforma flotante que sirve de base para la turbina eólica."@es,
                                   "A floating platform that serves as a base for the wind turbine."@en;
                      rdfs:label "Plataforma flotante"@es,
                                 "Floating Platform"@en;
                      rdfs:subClassOf opti:Component.
opti:FloatingSubstructure a owl:Class;
                          rdfs:comment "La subestructura flotante que permite que la plataforma sea estable en el mar."@es,
                                       "The floating substructure that allows the platform to be stable at sea."@en;
                          rdfs:label "Subestructura flotante"@es,
                                     "Floating Substructure"@en;
                          rdfs:subClassOf opti:StructuralComponent.
opti:GaugeSystem a owl:Class;
                 rdfs:comment "Sistema de galgas extensiométricas utilizado para medir tensiones y deformaciones en la estructura."@es,
                              "Strain gauge system used to measure stresses and deformations in the structure."@en;
                 rdfs:label "Sistema de galgas"@es,
                            "Gauge System"@en;
                 rdfs:subClassOf opti:Sensor.
opti:Hub a owl:Class;
         rdfs:comment "La parte central de la turbina donde se conectan las palas."@es,
                      "The central part of the turbine where the blades are connected."@en;
         rdfs:label "Hub"@es,
                    "Hub"@en;
         rdfs:subClassOf opti:TurbineComponent.
opti:ISUMSystem a owl:Class;
                rdfs:comment "Sistema especializado para la monitorización integrada de la plataforma offshore."@es,
                             "Specialized system for integrated monitoring of the offshore platform."@en;
                rdfs:label "Sistema ISUM"@es,
                           "ISUM System"@en;
                rdfs:subClassOf opti:Sensor.
opti:Image a owl:Class;
           rdfs:comment "Una clase que representa una imagen que soporta la medición."@es,
                        "A class that represents an image that supports the measurement."@en;
           rdfs:label "Imagen"@es,
                      "Image"@en;
           rdfs:subClassOf opti:Data.
opti:Location a owl:Class;
              rdfs:comment "La ubicación geográfica de la plataforma eólica."@es,
                           "The geographic location of the wind platform."@en;
              rdfs:label "Ubicación"@es,
                         "Location"@en.
opti:Maintenance a owl:Class;
                 rdfs:comment "Una clase que representa el mantenimiento de la plataforma eólica."@es,
                              "A class that represents the maintenance of the wind platform."@en;
                 rdfs:label "Mantenimiento"@es,
                            "Maintenance"@en;
                 opti:performedBy opti:MaintenanceOperator.
opti:MaintenanceOperator a owl:Class;
                         rdfs:comment "Persona encargada de realizar el mantenimiento preventivo y correctivo en la plataforma."@es,
                                      "Person responsible for carrying out preventive and corrective maintenance on the platform."@en;
                         rdfs:label "Operador de mantenimiento"@es,
                                    "Maintenance Operator"@en;
                         rdfs:subClassOf opti:Actor.
opti:ManagementRole a owl:Class;
                    rdfs:comment "Rol encargado de la coordinación, planificación y gestión de recursos en la plataforma eólica."@es,
                                 "Role responsible for coordination, planning, and resource management in the wind platform."@en;
                    rdfs:label "Rol de gestión"@es,
                               "Management Role"@en;
                    rdfs:subClassOf opti:Role.
opti:MaterialFatigue a owl:Class;
                     rdfs:comment "Fallo en el material estructural causado por ciclos repetidos de carga."@es,
                                  "Structural material failure caused by repeated load cycles."@en;
                     rdfs:label "Fatiga del material"@es,
                                "Material Fatigue"@en;
                     rdfs:subClassOf opti:Failure;
                     owl:disjointWith opti:CorrosionEvent,
                                      opti:Misalignment.
opti:Measurement a owl:Class;
                 rdfs:comment "Representa una medición tomada por un sensor."@es,
                              "Represents a measurement taken by a sensor."@en;
                 rdfs:label "Medición"@es,
                            "Measurement"@en;
                 rdfs:subClassOf opti:Data.
opti:Misalignment a owl:Class;
                  rdfs:comment "Fallo causado por el desajuste o falta de alineación entre los componentes de la plataforma."@es,
                               "Failure caused by misalignment or lack of proper adjustment between platform components."@en;
                  rdfs:label "Desalineación"@es,
                             "Misalignment"@en;
                  rdfs:subClassOf opti:Failure;
                  owl:disjointWith opti:CorrosionEvent,
                                   opti:MaterialFatigue.
opti:MonitoringTask a owl:Class;
                    rdfs:comment "Una tarea destinada a supervisar el estado de la plataforma mediante sensores y sistemas de monitorización."@es,
                                 "A task aimed at supervising the condition of the platform through sensors and monitoring systems."@en;
                    rdfs:label "Tarea de monitoreo"@es,
                               "Monitoring Task"@en;
                    rdfs:subClassOf opti:Task.
opti:MooringSystem a owl:Class;
                   rdfs:comment "El sistema de amarre que mantiene la plataforma flotante en su ubicación."@es,
                                "The mooring system that keeps the floating platform in place."@en;
                   rdfs:label "Sistema de amarre"@es,
                              "Mooring System"@en;
                   rdfs:subClassOf opti:StructuralComponent.
opti:Nacelle a owl:Class;
             rdfs:comment "El compartimento de la turbina que aloja el generador y otros componentes mecánicos."@es,
                          "The turbine component that houses the generator and other mechanical components."@en;
             rdfs:label "Nacelle"@es,
                        "Nacelle"@en;
             rdfs:subClassOf opti:TurbineComponent.
opti:Observation a owl:Class;
                 rdfs:comment "El resultado de registrar un fenómeno o condición, normalmente a través de un sensor o sistema de monitorización."@es,
                              "The result of recording a phenomenon or condition, usually through a sensor or monitoring system."@en;
                 rdfs:label "Observación"@es,
                            "Observation"@en;
                 rdfs:subClassOf <https://www.w3.org/ns/sosa/Observation>;
                 opti:madeBySensor <https://www.w3.org/ns/sosa/Sensor>.
opti:ParkOwner a owl:Class;
               rdfs:comment "Entidad o persona propietaria del parque eólico offshore y responsable de su operación general."@es,
                            "Entity or individual owning the offshore wind farm and responsible for its overall operation."@en;
               rdfs:label "Propietario de parque"@es,
                          "Park Owner"@en;
               rdfs:subClassOf opti:Actor.
opti:PitchSystem a owl:Class;
                 rdfs:comment "El sistema que ajusta el ángulo de las palas de la turbina."@es,
                              "The system that adjusts the angle of the blades of the turbine."@en;
                 rdfs:label "Sistema de pitch"@es,
                            "Pitch System"@en;
                 rdfs:subClassOf opti:Component.
opti:PlatformActuator a owl:Class;
                      rdfs:comment "Encargado de realizar ajustes sobre la plataforma, como ajustes mecánicos o hidráulicos."@es,
                                   "Responsible for making adjustments on the platform, such as mechanical or hydraulic adjustments."@en;
                      rdfs:label "Actuador de plataforma"@es,
                                 "Platform Actuator"@en;
                      rdfs:subClassOf opti:Actor.
opti:Role a owl:Class;
          rdfs:comment "Los roles de los actores que gestionan, operan o mantienen la plataforma eólica."@es,
                       "The roles of the actors that manage, operate or maintain the offshore wind power platform."@en;
          rdfs:label "Rol"@es,
                     "Role"@en.
opti:Sensor a owl:Class;
            rdfs:comment "Un dispositivo que mide o monitorea parámetros de la plataforma eólica, como viento, corrosión, vibraciones, etc."@es,
                         "A device that measures or monitors parameters of the wind platform, such as wind, corrosion, vibrations, etc."@en;
            rdfs:label "Sensor"@es,
                       "Sensor"@en;
            rdfs:subClassOf <https://www.w3.org/ns/sosa/Sensor>.
opti:StressData a owl:Class;
                rdfs:comment "Datos de tensión medidos por un sensor."@es,
                             "Stress data measured by a sensor."@en;
                rdfs:label "Datos de tensión"@es,
                           "Stress Data"@en;
                rdfs:subClassOf opti:Measurement.
opti:StructuralCamera a owl:Class;
                      rdfs:comment "Cámara dedicada a la inspección visual del estado estructural de la plataforma."@es,
                                   "Camera dedicated to visual inspection of the structural condition of the platform."@en;
                      rdfs:label "Cámara estructural"@es,
                                 "Structural Camera"@en;
                      rdfs:subClassOf opti:Sensor;
                      owl:disjointWith opti:CorrosionCamera,
                                       opti:Anemometer,
                                       opti:DynamicMonitor.
opti:StructuralComponent a owl:Class;
                         rdfs:comment "Los componentes estructurales que componen la infraestructura básica de la plataforma eólica."@es,
                                      "The structural components that make up the basic infrastructure of the wind platform."@en;
                         rdfs:label "Componentes estructurales"@es,
                                    "Structural Components"@en;
                         owl:equivalentClass [owl:unionOf (opti:Base
                                                           opti:MooringSystem
                                                           opti:FloatingSubstructure) ; 
                                              a owl:Class].
opti:StructuralInstability a owl:Class;
                           rdfs:comment "Fallo que compromete la estabilidad estructural de la plataforma flotante."@es,
                                        "Failure that compromises the structural stability of the floating platform."@en;
                           rdfs:label "Inestabilidad estructural"@es,
                                      "Structural Instability"@en;
                           rdfs:subClassOf opti:Failure.
opti:Task a owl:Class;
          rdfs:comment "Una tarea general relacionada con la operación, supervisión o mantenimiento de la plataforma eólica."@es,
                       "A general task related to the operation, monitoring, or maintenance of the wind platform."@en;
          rdfs:label "Tarea"@es,
                     "Task"@en.
opti:TechnicalRole a owl:Class;
                   rdfs:comment "Rol asociado a actividades técnicas como operación, reparación y supervisión de sistemas."@es,
                                "Role associated with technical activities such as operation, repair, and system supervision."@en;
                   rdfs:label "Rol técnico"@es,
                              "Technical Role"@en;
                   rdfs:subClassOf opti:Role.
opti:Tower a owl:Class;
           rdfs:comment "La estructura que sostiene la turbina eólica."@es,
                        "The structure that supports the wind turbine."@en;
           rdfs:label "Torre"@es,
                      "Tower"@en;
           rdfs:subClassOf opti:TurbineComponent.
opti:Turbine a owl:Class;
             rdfs:comment "Una turbina de viento que forma parte de la plataforma eólica."@es,
                          "A wind turbine that is part of the wind platform."@en;
             rdfs:label "Turbina"@es,
                        "Turbine"@en;
             rdfs:subClassOf opti:Component.
opti:TurbineComponent a owl:Class;
                      rdfs:comment "Los componentes de la turbina eólica que generan energía a partir del viento."@es,
                                   "The turbine components that generate energy from the wind."@en;
                      rdfs:label "Componentes de turbina"@es,
                                 "Turbine Components"@en;
                      owl:equivalentClass [owl:unionOf (opti:Hub
                                                        opti:Nacelle
                                                        opti:Blade
                                                        opti:Tower) ; 
                                           a owl:Class].
opti:VibrationData a owl:Class;
                   rdfs:comment "Datos de vibracion medidos por un sensor."@es,
                                "Vibration data measured by a sensor."@en;
                   rdfs:label "Datos de vibración"@es,
                              "Vibration Data"@en;
                   rdfs:subClassOf opti:Measurement.
opti:WindPowerPlatform a owl:Class;
                       rdfs:comment "Una plataforma eólica offshore que genera energía electrica a partir del viento."@es,
                                    "An offshore wind power platform that generates electricity from wind."@en;
                       rdfs:label "Plataforma eólica offshore"@es,
                                  "Offshore Wind Power Platform"@en.
opti:adjusts a owl:ObjectProperty;
             rdfs:comment "Indica que un actor realiza ajustes sobre un componente o sistema de pitch."@es,
                          "Indicas that an actor makes adjustments on a component or pitch system."@en;
             rdfs:domain opti:Actor;
             rdfs:label "Ajusta"@es,
                        "Adjusts"@en;
             rdfs:range [owl:unionOf (opti:Component
                                      opti:PitchSystem)].
opti:analyzes a owl:ObjectProperty;
              rdfs:comment "Relaciona a un actor con los datos o fallos que estudia o interpreta."@es,
                           "Relates an actor to the data or failures that it studies or interprets."@en;
              rdfs:domain opti:Actor;
              rdfs:label "Analiza"@es,
                         "Analyzes"@en;
              rdfs:range [owl:unionOf (opti:Data
                                       opti:Failure)].
opti:causedBy a owl:ObjectProperty;
              rdfs:comment "Relaciona un evento con el fallo que lo provocó."@es,
                           "Relates an event with the failure that caused it."@en;
              rdfs:domain opti:Event;
              rdfs:label "Causado por"@es,
                         "Caused by"@en;
              rdfs:range opti:Failure.
opti:connectedTo a owl:ObjectProperty;
                 rdfs:comment "Indica que un componente está conectado a otro."@es,
                              "Indicates that a component is connected to another."@en;
                 rdfs:domain opti:Component;
                 rdfs:label "Conectado a"@es,
                            "Connected to"@en;
                 rdfs:range opti:Component.
opti:darkCorrosion a owl:DatatypeProperty;
                   rdfs:comment "Nivel de corrosión oscura detectada en la superficie del material."@es,
                                "Level of dark corrosion detected on the mmaterial surface."@en;
                   rdfs:domain opti:CorrosionEvent;
                   rdfs:label "Corrosión oscura"@es,
                              "Dark corrosion"@en;
                   rdfs:range xsd:decimal;
                   rdfs:subPropertyOf opti:Corrosion.
opti:dateTime a owl:DatatypeProperty;
              rdfs:comment "Marca temporal asociada a la medición."@es,
                           "Associated temporal mark to the measurement."@en;
              rdfs:domain opti:Measurement;
              rdfs:label "Fecha y hora"@es,
                         "Date and time"@en;
              rdfs:range xsd:dateTime.
opti:detectedBy a owl:ObjectProperty;
                rdfs:comment "Relaciona un evento con el sensor que lo detectó."@es,
                             "Relates an event to the sensor that detected it."@en;
                rdfs:domain opti:Event;
                rdfs:label "Detectado por"@es,
                           "Detected by"@en;
                rdfs:range opti:Sensor.
opti:detectsCorrosion a owl:ObjectProperty;
                      rdfs:comment "Relaciona un sensor con la medición de corrosión detectada."@es,
                                   "Relates a sensor with the detected corrosion measurement."@en;
                      rdfs:domain opti:Sensor;
                      rdfs:label "Detecta corrosión"@es,
                                 "Detects corrosion"@en;
                      rdfs:range opti:Corrosion.
opti:diameter a owl:ObjectProperty;
              rdfs:comment "Diámetro del componente medido en unidades QUDT."@es,
                           "Diameter of the component measured in QUDT units."@en;
              rdfs:domain opti:Component;
              rdfs:label "Diámetro"@es,
                         "Diameter"@en;
              rdfs:range qudt:QuantityValue.
opti:displacement a owl:DatatypeProperty;
                  rdfs:comment "Desplazamiento o cambio de posición registrado en el componente."@es,
                               "Displacement or position change recorded in the component."@en;
                  rdfs:domain opti:Data;
                  rdfs:label "Desplazamiento"@es,
                             "Displacement"@en;
                  rdfs:range xsd:decimal.
opti:externalShape a owl:DatatypeProperty;
                   rdfs:comment "Describe la forma externa o geometría del componente."@es,
                                "Describe the external shape or geometric of the component."@en;
                   rdfs:domain opti:Component;
                   rdfs:label "Forma externa"@es,
                              "External shape"@en;
                   rdfs:range xsd:string.
opti:failureObservation a owl:ObjectProperty;
                        rdfs:comment "Relación entre un evento de fallo y la observación realizada por un sensor."@es,
                                     "Relationship between a failure event and the observation made by a sensor."@en;
                        rdfs:domain opti:FailureEvent;
                        rdfs:label "Observación de fallo"@es,
                                   "Failure observation"@en;
                        rdfs:range opti:Observation.
opti:hasCapacity a owl:DatatypeProperty;
                 rdfs:comment "Capacidad nominal de generación de la turbina."@es,
                              "Rated generation capacity of the turbine."@en;
                 rdfs:domain opti:Turbine;
                 rdfs:label "Capacidad"@es,
                            "Capacity"@en;
                 rdfs:range xsd:string.
opti:hasFailureCause a owl:ObjectProperty;
                     rdfs:comment "Indica que un fallo tiene su origen en una condición ambiental específica."@es,
                                  "Indicates that a failure is caused by a specific environmental condition."@en;
                     rdfs:domain opti:Failure;
                     rdfs:label "Causa de fallo"@es,
                                "Failure cause"@en;
                     rdfs:range opti:EnvironmentalCondition.
opti:hasRole a owl:ObjectProperty;
             rdfs:comment "Indica el rol que desempeña un actor dentro del sistema."@es,
                          "Indicas the role that an actor performs within the system."@en;
             rdfs:domain opti:Actor;
             rdfs:label "Tiene rol"@es,
                        "Has role"@en;
             rdfs:range opti:Role.
opti:height a owl:ObjectProperty;
            rdfs:comment "Altura del componente expresada como un valor con unidad QUDT."@es,
                         "Height of the component expressed as a QUDT quantity value."@en;
            rdfs:domain opti:Component;
            rdfs:label "Altura"@es,
                       "Height"@en;
            rdfs:range qudt:QuantityValue.
opti:houses a owl:ObjectProperty;
            rdfs:comment "Indica que un componente contiene o aloja fisicamente a otro en su estructura."@es,
                         "Indicates that a component contains or houses physically another in its structure."@en;
            rdfs:domain opti:Component;
            rdfs:label "Aloja"@es,
                       "Houses"@en;
            rdfs:range opti:Component.
opti:imageURL a owl:DatatypeProperty;
              rdfs:comment "Dirección de acceso a la imagen generada o almacenada."@es,
                           "Access URL of the generated or stored image."@en;
              rdfs:domain opti:Image;
              rdfs:label "URL de la imagen"@es,
                         "Image URL"@en;
              rdfs:range xsd:string.
opti:isSupportedBy a owl:ObjectProperty;
                   rdfs:comment "Indica que un componente depende estructural o funcionalmente de otro para su soporte."@es,
                                "Indicates that a component is structurally or functionally supported by another."@en;
                   rdfs:domain opti:Component;
                   rdfs:label "Es soportado por"@es,
                              "Is supported by"@en;
                   rdfs:range opti:Component.
opti:length a owl:ObjectProperty;
            rdfs:comment "Longitud de un componente, expresada como un valor con unidad QUDT"@es,
                         "Length of a component, expressed as a QUDT quantity value"@en;
            rdfs:domain opti:Component;
            rdfs:label "Longitud"@es,
                       "Length"@en;
            rdfs:range qudt:QuantityValue.
opti:lightCorrosion a owl:DatatypeProperty;
                    rdfs:comment "Nivel de corrosión clara detectada en la superficie del material."@es,
                                 "Level of light corrosion detected on the material surface."@en;
                    rdfs:domain opti:CorrosionEvent;
                    rdfs:label "Corrosión clara"@es,
                               "Light corrosion"@en;
                    rdfs:range xsd:decimal;
                    rdfs:subPropertyOf opti:Corrosion.
opti:locatedIn a owl:ObjectProperty;
               rdfs:comment "Indica el lugar en el que se encuentra la plataforma eólica."@es,
                            "Indicates the location where the wind power platform is located."@en;
               rdfs:domain opti:WindPowerPlatform;
               rdfs:label "Ubicado en"@es,
                          "Located in"@en;
               rdfs:range opti:Location.
opti:madeBySensor a owl:ObjectProperty;
                  rdfs:comment "Relaciona una observación con el sensor que la realizó."@es,
                               "Relates an observation to the sensor that made it."@en;
                  rdfs:domain <https://www.w3.org/ns/sosa/Observation>;
                  rdfs:label "Realizada por sensor"@es,
                             "Made by sensor"@en;
                  rdfs:range <https://www.w3.org/ns/sosa/Sensor>.
opti:manages a owl:ObjectProperty;
             rdfs:comment "Infica que un actor se encarga de la gestión de una plataforma eólica o su sistema de anclaje."@es,
                          "Indicates that an actor is responsible for managing a wind power platform or its mooring system."@en;
             rdfs:domain opti:Actor;
             rdfs:label "Administra"@es,
                        "Manages"@en;
             rdfs:range [owl:unionOf (opti:WindPowerPlatform
                                      opti:MooringSystem)].
opti:mass a owl:ObjectProperty;
          rdfs:comment "Masa del componente expresada expresada como un valor con unidad QUDT"@es,
                       "Mass of the component expressed as a QUDT quantity value"@en;
          rdfs:domain opti:Component;
          rdfs:label "Masa"@es,
                     "Mass"@en;
          rdfs:range qudt:QuantityValue.
opti:material a owl:DatatypeProperty;
              rdfs:comment "Material de fabricación del componente (ej. acero, compuesto, fibra de vidrio, etc.)."@es,
                           "Material of manufacturing of the component (e.g. steel, composite, fiberglass, etc.)."@en;
              rdfs:domain opti:Component;
              rdfs:label "Material"@es,
                         "Material"@en;
              rdfs:range xsd:string.
opti:materialFatigue a owl:DatatypeProperty;
                     rdfs:comment "Grado de fatiga acumulada en el material."@es,
                                  "Accumulated material fatigue degree."@en;
                     rdfs:domain opti:Data;
                     rdfs:label "Fatiga material"@es,
                                "Material fatigue"@en;
                     rdfs:range xsd:decimal.
opti:materialWear a owl:DatatypeProperty;
                  rdfs:comment "Grado de desgaste de un material en un componente."@es,
                               "Degree of material wear in a component."@en;
                  rdfs:domain opti:Data;
                  rdfs:label "Desgaste material"@es,
                             "Material wear"@en;
                  rdfs:range xsd:decimal.
opti:measuresStress a owl:ObjectProperty;
                    rdfs:comment "Indica que un sensor mide la tensión ejercida sobre un componente."@es,
                                 "Indicates that a sensor measures the stress exerted on a component."@en;
                    rdfs:domain opti:Sensor;
                    rdfs:label "Mide tensión"@es,
                               "Measures stress"@en;
                    rdfs:range opti:StressData.
opti:measuresVibration a owl:ObjectProperty;
                       rdfs:comment "Indica que un sensor obtiene datos de vibración de un componente."@es,
                                    "Indicates that a sensor collects vibration data from a component."@en;
                       rdfs:domain opti:Sensor;
                       rdfs:label "Mide vibración"@es,
                                  "Measures vibration"@en;
                       rdfs:range opti:VibrationData.
opti:measuresWind a owl:ObjectProperty;
                  rdfs:comment "Relaciona un sensor con la medición de velocidad o dirección del viento."@es,
                               "Relates a sensor with the measurement of wind speed or direction."@en;
                  rdfs:domain opti:Sensor;
                  rdfs:label "Mide viento"@es,
                             "Measures wind"@en;
                  rdfs:range opti:EnvironmentalCondition.
opti:misalignment a owl:DatatypeProperty;
                  rdfs:comment "Medida de la falta de alineación detectada en un componente."@es,
                               "Measure of the misalignment detected in a component."@en;
                  rdfs:domain opti:Data;
                  rdfs:label "Desalineación"@es,
                             "Misalignment"@en;
                  rdfs:range xsd:decimal.
opti:monitors a owl:ObjectProperty;
              rdfs:comment "Relaciona a un actor con los componentes o sensores que supervisa."@es,
                           "Relates an actor to the components or sensors they monitor."@en;
              rdfs:domain opti:Actor;
              rdfs:label "Monitorea"@es,
                         "Monitors"@en;
              rdfs:range [owl:unionOf (opti:Component
                                       opti:Sensor)].
opti:monitorsDeformation a owl:ObjectProperty;
                         rdfs:comment "Relaciona un sensor con la deformación estructural que mide o supervisa."@es,
                                      "Relates a sensor to the structural deformation it measures or monitors."@en;
                         rdfs:domain opti:Sensor;
                         rdfs:label "Monitorea deformación"@es,
                                    "Monitors deformation"@en;
                         rdfs:range opti:Deformation.
opti:operationalStatus a owl:DatatypeProperty;
                       rdfs:comment "Estado de funcionamiento actual de la turbina (ej. operativa, parada, en mantenimiento, etc.)."@es,
                                    "Current operational status of the turbine (e.g. operative, stopped, under maintenance, etc.)."@en;
                       rdfs:domain opti:Turbine;
                       rdfs:label "Estado operativo"@es,
                                  "Operational status"@en;
                       rdfs:range xsd:string.
opti:performedMaintenance a owl:ObjectProperty;
                          rdfs:comment "Relaciona un actor con el mantenimiento que realiza."@es,
                                       "Relates an actor with the maintenance that it performs."@en;
                          rdfs:domain opti:Actor;
                          rdfs:label "Realiza mantenimiento"@es,
                                     "Performs maintenance"@en;
                          rdfs:range opti:Maintenance.
opti:performsTask a owl:ObjectProperty;
                  rdfs:comment "Relaciona un actor con una tarea que ejecuta como parte de su rol."@es,
                               "Relates an actor with a task that it performs as part of its role."@en;
                  rdfs:domain opti:Actor;
                  rdfs:label "Realiza tarea"@es,
                             "Performs task"@en;
                  rdfs:range opti:Task.
opti:pressure a owl:DatatypeProperty;
              rdfs:comment "Presión ejercida sobre un componente."@es,
                           "Pressure exerted on a component."@en;
              rdfs:domain opti:Data;
              rdfs:label "Presión"@es,
                         "Pressure"@en;
              rdfs:range xsd:decimal.
opti:relatedToComponent a owl:ObjectProperty;
                        rdfs:comment "Relaciona un evento con el componente de la plataforma que se ve afectado."@es,
                                     "Relates an event to the platform component that is affected."@en;
                        rdfs:domain opti:Event;
                        rdfs:label "Relacionado con componente"@es,
                                   "Related to component"@en;
                        rdfs:range opti:Component.
opti:rotationSpeed a owl:ObjectProperty;
                   rdfs:comment "Velocidad angular de un componente expresada como un valor con unidad QUDT."@es,
                                "Angular speed of a component expressed as a QUDT quantity value."@en;
                   rdfs:domain opti:Component;
                   rdfs:label "Velocidad de rotación"@es,
                              "Rotation speed"@en;
                   rdfs:range qudt:QuantityValue.
opti:stress a owl:DatatypeProperty;
            rdfs:comment "Nivel de tensión registrado en un componente."@es,
                         "Stress level recorded in a component."@en;
            rdfs:domain opti:Data;
            rdfs:label "Tensión"@es,
                       "Stress"@en;
            rdfs:range xsd:decimal.
opti:supports a owl:ObjectProperty;
              rdfs:comment "Indica que un componente proporciona soporte estructural o funcional a otro."@es,
                           "Indicates that a component provides structural or functional support to another."@en;
              rdfs:domain opti:Component;
              rdfs:label "Soporta a"@es,
                         "Supports"@en;
              rdfs:range opti:Component;
              owl:inverseOf opti:isSupportedBy.
opti:temperature a owl:ObjectProperty;
                 rdfs:comment "Temperatura registrada expresada como un valor con unidad QUDT."@es,
                              "Temperature recorded expressed as a QUDT quantity value."@en;
                 rdfs:domain opti:Data;
                 rdfs:label "Temperatura"@es,
                            "Temperature"@en;
                 rdfs:range qudt:QuantityValue.
opti:thickness a owl:ObjectProperty;
               rdfs:comment "Espesor de la sección o pared de un componente medido en unidades QUDT."@es,
                            "Thickness of the section or wall of a component measured in QUDT units."@en;
               rdfs:domain opti:Component;
               rdfs:label "Espesor"@es,
                          "Thickness"@en;
               rdfs:range qudt:QuantityValue.
opti:transmitsMovementTo a owl:ObjectProperty;
                         rdfs:comment "Indica que un componente transmite movimiento mecánico a otro."@es,
                                      "Indicates that a component transmits mechanical movement to another."@en;
                         rdfs:domain opti:Component;
                         rdfs:label "Transmite movimiento a"@es,
                                    "Transmits movement to"@en;
                         rdfs:range opti:Component.
opti:unit a owl:DatatypeProperty;
          rdfs:comment "Unidad de medida del valor registrado (ej. m/s, rpm, °C, etc.)."@es,
                       "Measurement unit of the recorded value (e.g. m/s, rpm, °C, etc.)."@en;
          rdfs:domain opti:Measurement;
          rdfs:label "Unidad"@es,
                     "Unit"@en;
          rdfs:range xsd:string.
opti:value a owl:DatatypeProperty;
           rdfs:comment "Valor numérico de la medición tomada por un sensor."@es,
                        "Numeric value of the measurement taken by a sensor."@en;
           rdfs:domain opti:Measurement;
           rdfs:label "Valor"@es,
                      "Value"@en;
           rdfs:range xsd:decimal.
opti:vibrations a owl:DatatypeProperty;
                rdfs:comment "Nivel de vibraciones registradas en un componente o sistema."@es,
                             "Level of vibrations recorded in a component or system."@en;
                rdfs:domain opti:Data;
                rdfs:label "Vibraciones"@es,
                           "Vibrations"@en;
                rdfs:range xsd:decimal.
opti:width a owl:ObjectProperty;
           rdfs:comment "Anchura del componente expresada como un valor con unidad QUDT."@es,
                        "Width of the component expressed as a QUDT quantity value."@en;
           rdfs:domain opti:Component;
           rdfs:label "Anchura"@es,
                      "Width"@en;
           rdfs:range qudt:QuantityValue.
opti:windDirection a owl:ObjectProperty;
                   rdfs:comment "Dirección desde la que sopla el viento expresada en valores con unidad QUDT."@es,
                                "Direction from which the wind blows expressed as a QUDT quantity value."@en;
                   rdfs:domain opti:EnvironmentalCondition;
                   rdfs:label "Dirección del viento"@es,
                              "Wind direction"@en;
                   rdfs:range qudt:QuantityValue.
opti:windSpeed a owl:ObjectProperty;
               rdfs:comment "Velocidad del viento expresada como valor QUDT."@es,
                            "Wind speed expressed as a QUDT quantity value."@en;
               rdfs:domain opti:EnvironmentalCondition;
               rdfs:label "Velocidad del viento"@es,
                          "Wind speed"@en;
               rdfs:range qudt:QuantityValue.
