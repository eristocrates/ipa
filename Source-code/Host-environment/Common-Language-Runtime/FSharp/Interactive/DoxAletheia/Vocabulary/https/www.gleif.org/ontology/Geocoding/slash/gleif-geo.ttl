@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gleif-geo: <https://www.gleif.org/ontology/Geocoding/>.

_:Bc6b906e7294c741fc1bc8b6b3eeb8442 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#members> (gleif-geo:MatchTypePointAddress
                                                                             gleif-geo:MatchTypeInterpolated).
gleif-geo: <http://purl.org/dc/terms/abstract> "Ontology defining concepts for Geocoding of addresses. It is based on the geocoding  used in the Global Legal Entity Identifier Foundation (GLEIF) Golden Copy Data, but is more broadly applicable.";
           <http://purl.org/dc/terms/contributor> <https://www.linkedin.com/in/peterivett/>,
                                                  <http://www.workingontologist.com/>,
                                                  <http://purl.org/bryon>;
           <http://purl.org/dc/terms/creator> <https://www.gleif.org/ontology/Base/GLEIF>;
           <http://purl.org/dc/terms/issued> "2019-02-01T00:00:00+00:00"^^xsd:dateTime;
           <http://purl.org/dc/terms/license> "https://www.gleif.org/en/meta/lei-data-terms-of-use/"^^xsd:anyURI;
           <http://purl.org/dc/terms/rights> "Copyright (c) 2019 Global Legal Entity Identifier Foundation (GLEIF)";
           <http://purl.org/dc/terms/rightsHolder> <https://www.gleif.org/ontology/Base/GLEIF>;
           <http://purl.org/dc/terms/source> "https://developer.here.com/documentation/geocoder/topics/reading-geocoding-response.html"^^xsd:anyURI,
                                             "https://www.gleif.org/en/lei-data/gleif-golden-copy"^^xsd:anyURI;
           <http://purl.org/dc/terms/title> "Global Legal Entity Identifier Foundation Geocoding Ontology"@en;
           <http://purl.org/vocab/vann/preferredNamespacePrefix> "gleif-geo";
           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://www.gleif.org/ontology/Geocoding/";
           a <http://www.w3.org/2002/07/owl#Ontology>,
             <http://purl.org/vocommons/voaf#Vocabulary>;
           rdfs:label "GLEIF Geocoding Ontology";
           <http://www.w3.org/2002/07/owl#imports> <https://www.gleif.org/ontology/Base/>,
                                                   <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/>;
           <http://www.w3.org/2002/07/owl#versionIRI> <https://www.gleif.org/ontology/Geocoding-v1.0/Geocoding/>.
gleif-geo:BoundingBox a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy gleif-geo:;
                      rdfs:label "bounding box";
                      rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
                                      [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:topLeft ; 
                                       <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2003/01/geo/wgs84_pos#Point> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:bottomRight ; 
                                       <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2003/01/geo/wgs84_pos#Point> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2004/02/skos/core#definition> "A geographic rectangular area bounded by its top left and bottom right points.".
gleif-geo:GeocodedAddress a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:isDefinedBy gleif-geo:;
                          rdfs:label "geocoded address"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1" ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasCountry> ; 
                                           <http://www.w3.org/2002/07/owl#onClass> <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/Country> ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasAddressNumber> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1" ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:relevance ; 
                                           <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1" ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:hasBoundingBox ; 
                                           <http://www.w3.org/2002/07/owl#onClass> gleif-geo:BoundingBox ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:hasStreet ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:hasDistrict ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1" ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:matchDate ; 
                                           <http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          <https://www.gleif.org/ontology/Base/PhysicalAddress>,
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:formattedAddressText ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1" ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> gleif-geo:matchType ; 
                                           <http://www.w3.org/2002/07/owl#onClass> gleif-geo:MatchType ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:locationId ; 
                                           <http://www.w3.org/2002/07/owl#cardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:hasRegionText ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:originalAddress ; 
                                           <http://www.w3.org/2002/07/owl#onClass> <https://www.gleif.org/ontology/Base/PhysicalAddress> ; 
                                           <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> gleif-geo:originalAddressText ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "0" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasCity> ; 
                                           <http://www.w3.org/2002/07/owl#cardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasPostalCode> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>];
                          <http://www.w3.org/2004/02/skos/core#definition> "A geocoded address, derived from a physical address, with latitude and longitude information.".
gleif-geo:MatchType a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy gleif-geo:;
                    rdfs:label "match type";
                    <http://www.w3.org/2002/07/owl#oneOf> (gleif-geo:MatchTypePointAddress
                                                           gleif-geo:MatchTypeInterpolated);
                    <http://www.w3.org/2004/02/skos/core#definition> "Quality of the location match, either pointAddress or interpolated.".
gleif-geo:MatchTypeInterpolated a gleif-geo:MatchType;
                                rdfs:isDefinedBy gleif-geo:;
                                rdfs:label "match type interpolated";
                                <http://www.w3.org/2004/02/skos/core#definition> "The location was interpolated from known locations of adjacent addresses.";
                                <https://www.gleif.org/ontology/Base/hasTag> "interpolated".
gleif-geo:MatchTypePointAddress a gleif-geo:MatchType;
                                rdfs:isDefinedBy gleif-geo:;
                                rdfs:label "match type point address";
                                <http://www.w3.org/2004/02/skos/core#definition> "The location matches the specific address.";
                                <https://www.gleif.org/ontology/Base/hasTag> "pointAddress".
gleif-geo:bottomRight a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain gleif-geo:BoundingBox;
                      rdfs:isDefinedBy gleif-geo:;
                      rdfs:label "bottom right";
                      rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
                      <http://www.w3.org/2004/02/skos/core#definition> "The bottom right point of a bounding box.".
gleif-geo:formattedAddressText a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:domain gleif-geo:GeocodedAddress;
                               rdfs:isDefinedBy gleif-geo:;
                               rdfs:label "formatted address text";
                               <http://www.w3.org/2004/02/skos/core#definition> "An aggregated textual representation of the the fields produced by the geocoding as a comma-separated list of fields.".
gleif-geo:hasBoundingBox a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain gleif-geo:GeocodedAddress;
                         rdfs:isDefinedBy gleif-geo:;
                         rdfs:label "has bounding box";
                         rdfs:range gleif-geo:BoundingBox;
                         <http://www.w3.org/2004/02/skos/core#definition> "The geographic area represented by the address.".
gleif-geo:hasDistrict a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain gleif-geo:GeocodedAddress;
                      rdfs:isDefinedBy gleif-geo:;
                      rdfs:label "has district";
                      <http://www.w3.org/2004/02/skos/core#definition> "A textual representation of the district.".
gleif-geo:hasGeocodedAddress a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:isDefinedBy gleif-geo:;
                             rdfs:label "has geocoded address";
                             rdfs:range gleif-geo:GeocodedAddress;
                             rdfs:subPropertyOf <https://www.gleif.org/ontology/Base/hasAddress>;
                             <http://www.w3.org/2004/02/skos/core#definition> "A geocoded address for the legal entity.".
gleif-geo:hasRegionText a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain gleif-geo:GeocodedAddress;
                        rdfs:isDefinedBy gleif-geo:;
                        rdfs:label "has region text";
                        <http://www.w3.org/2004/02/skos/core#altLabel> "has state text";
                        <http://www.w3.org/2004/02/skos/core#definition> "A textual representation of the state or region.";
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "has region text".
gleif-geo:hasStreet a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain gleif-geo:GeocodedAddress;
                    rdfs:isDefinedBy gleif-geo:;
                    rdfs:label "has street";
                    <http://www.w3.org/2004/02/skos/core#definition> "The name of a street, as opposed to a house within it.".
gleif-geo:locationId a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain gleif-geo:GeocodedAddress;
                     rdfs:isDefinedBy gleif-geo:;
                     rdfs:label "location ID";
                     rdfs:subPropertyOf <https://www.gleif.org/ontology/Base/hasTag>;
                     <http://www.w3.org/2004/02/skos/core#definition> "A unique identifier representing a hash of the location.".
gleif-geo:matchDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain gleif-geo:GeocodedAddress;
                    rdfs:isDefinedBy gleif-geo:;
                    rdfs:label "has end"@en;
                    rdfs:range xsd:dateTime;
                    <http://www.w3.org/2004/02/skos/core#definition> "The date of the geocoding from the original address.".
gleif-geo:matchLevel a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                     rdfs:domain gleif-geo:GeocodedAddress;
                     rdfs:isDefinedBy gleif-geo:;
                     rdfs:label "match level";
                     rdfs:range <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     <http://www.w3.org/2004/02/skos/core#definition> "The most detailed address field that the geocoding was able to provide.".
gleif-geo:matchType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain gleif-geo:GeocodedAddress;
                    rdfs:isDefinedBy gleif-geo:;
                    rdfs:label "match type";
                    rdfs:range gleif-geo:MatchType;
                    <http://www.w3.org/2004/02/skos/core#definition> "Quality of the location match, either pointAddress or interpolated.".
gleif-geo:originalAddress a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain gleif-geo:GeocodedAddress;
                          rdfs:isDefinedBy gleif-geo:;
                          rdfs:label "original address";
                          rdfs:range <https://www.gleif.org/ontology/Base/PhysicalAddress>;
                          <http://www.w3.org/2004/02/skos/core#definition> "The original address(es) from which the geocoding was derived.".
gleif-geo:originalAddressText a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain gleif-geo:GeocodedAddress;
                              rdfs:isDefinedBy gleif-geo:;
                              rdfs:label "original address text";
                              <http://www.w3.org/2004/02/skos/core#definition> "An aggregated textual representation of the original address(es) from which the geocoding was derived, as a comma-separated list of fields with null where the field did not have a value.".
gleif-geo:relevance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain gleif-geo:GeocodedAddress;
                    rdfs:isDefinedBy gleif-geo:;
                    rdfs:label "bottom right";
                    rdfs:range xsd:decimal;
                    <http://www.w3.org/2004/02/skos/core#definition> "A value from 0 to 1 representing the percentage of the input that matched the returned address. 1 means that all input tokens were matched.".
gleif-geo:topLeft a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain gleif-geo:BoundingBox;
                  rdfs:isDefinedBy gleif-geo:;
                  rdfs:label "top left";
                  rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
                  <http://www.w3.org/2004/02/skos/core#definition> "The top left point of a bounding box.".
