@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix mdo-calc: <https://w3id.org/mdo/calculation/>.
@prefix core: <https://w3id.org/mdo/core/>.
@prefix mdo: <https://w3id.org/mdo/full/>.
@prefix mdoprov: <https://w3id.org/mdo/provenance/>.
@prefix mdo-struc: <https://w3id.org/mdo/structure/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
mdo: dcterms:contributor "Patrick Lambrix",
                         "Rickard Armiento";
     dcterms:created "2019-11-07";
     dcterms:creator "Huanyu Li";
     dcterms:license "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE";
     dcterms:title "Materials Design Ontology - Full"@en;
     vann:preferredNamespacePrefix "mdo";
     vann:preferredNamespaceUri "https://w3id.org/mdo/full/1.0/";
     a owl:Ontology;
     rdfs:comment "This is the Materials Design Ontology."@en;
     rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology";
     owl:imports <https://w3id.org/mdo/structure/1.0/>,
                 <https://w3id.org/mdo/provenance/1.0/>,
                 <https://w3id.org/mdo/core/1.0/>,
                 <https://w3id.org/mdo/calculation/1.0/>;
     owl:versionIRI <https://w3id.org/mdo/full/1.0/>;
     owl:versionInfo "1.0".
