@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ecc: <https://ns.eccenca.com/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix eccpubsub: <https://vocab.eccenca.com/pubsub/>.

<http://creativecommons.org/licenses/by/3.0/> rdfs:label "Creative Commons Attribution 3.0 Unported".
ccrel:license a owl:AnnotationProperty;
              rdfs:isDefinedBy <http://creativecommons.org/ns>.
dcterms:created a owl:AnnotationProperty;
                rdfs:isDefinedBy dcterms:.
dcterms:creator a owl:AnnotationProperty;
                rdfs:isDefinedBy dcterms:.
dcterms:identifier a owl:AnnotationProperty;
                   rdfs:isDefinedBy dcterms:.
dcterms:issued a owl:AnnotationProperty;
               rdfs:isDefinedBy dcterms:.
dcterms:modified a owl:AnnotationProperty;
                 rdfs:isDefinedBy dcterms:.
dcterms:publisher a owl:AnnotationProperty;
                  rdfs:isDefinedBy dcterms:.
dcterms:rights a owl:AnnotationProperty;
               rdfs:isDefinedBy dcterms:.
vann:preferredNamespacePrefix a owl:AnnotationProperty;
                              rdfs:isDefinedBy vann:.
vann:preferredNamespaceUri a owl:AnnotationProperty;
                           rdfs:isDefinedBy vann:.
<http://sebastian.tramp.name/> a foaf:Person,
                                 dcterms:Agent;
                               foaf:name "Sebastian Tramp".
ecc:eccenca-GmbH a dcterms:Agent,
                   foaf:Organization;
                 foaf:name "eccenca GmbH".
ecc:mfrommhold a dcterms:Agent,
                 foaf:Person;
               foaf:name "Marvin Frommhold".
<https://superfeedr-misc.s3.amazonaws.com/pubsubhubbub-core-0.4.html> a doap:Specification;
                                                                      rdfs:label "PubSubHubbub Core 0.4 -- Working Draft".
eccpubsub: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
           dcterms:creator ecc:mfrommhold,
                           <http://sebastian.tramp.name/>;
           dcterms:issued "2016-07-12"^^xsd:date;
           dcterms:modified "2016-07-12"^^xsd:date;
           dcterms:publisher ecc:eccenca-GmbH;
           dcterms:rights "Copyright © 2016 eccenca GmbH";
           vann:preferredNamespacePrefix "eccpubsub";
           vann:preferredNamespaceUri "https://vocab.eccenca.com/pubsub/";
           void:vocabulary foaf:,
                           dcterms:,
                           vann:,
                           status:;
           doap:bug-database <https://github.com/eccenca/eccpubsub-vocab/issues>;
           doap:download-page <https://github.com/eccenca/eccpubsub-vocab/releases>;
           doap:homepage <https://github.com/eccenca/eccpubsub-vocab>;
           doap:implements <https://superfeedr-misc.s3.amazonaws.com/pubsubhubbub-core-0.4.html>;
           doap:repository <https://github.com/eccenca/eccpubsub-vocab.git>;
           a owl:Ontology,
             voaf:Vocabulary;
           rdfs:comment "The eccenca Publish-Subscribe Vocabulary defines concepts and relations to create statements about publishers, subscribers and their subscriptions in a Publish-Subscribe environment based on the PubSubHubbub Core 0.4 specification."@en;
           rdfs:isDefinedBy eccpubsub:;
           rdfs:label "eccpubsub: eccenca Publish-Subscribe Vocabulary"@en;
           owl:versionInfo "1.0.0".
eccpubsub:CallbackEndpoint dcterms:issued "2016-07-12"^^xsd:date;
                           dcterms:modified "2016-07-12"^^xsd:date;
                           a owl:Class;
                           rdfs:comment "An HTTP endpoint acting as callback of a subscriber."@en;
                           rdfs:isDefinedBy eccpubsub:;
                           rdfs:label "callback endpoint"@en;
                           rdfs:subClassOf eccpubsub:Endpoint;
                           status:term_status "testing"@en.
eccpubsub:Endpoint dcterms:issued "2016-07-12"^^xsd:date;
                   dcterms:modified "2016-07-12"^^xsd:date;
                   a owl:Class;
                   rdfs:comment "A PubSubHubbub HTTP endpoint. Individuals of this class MUST be referenced by their URL."@en;
                   rdfs:isDefinedBy eccpubsub:;
                   rdfs:label "endpoint"@en;
                   status:term_status "testing"@en.
eccpubsub:HubEndpoint dcterms:issued "2016-07-12"^^xsd:date;
                      dcterms:modified "2016-07-12"^^xsd:date;
                      a owl:Class;
                      rdfs:comment "An HTTP endpoint acting as hub."@en;
                      rdfs:isDefinedBy eccpubsub:;
                      rdfs:label "hub endpoint"@en;
                      rdfs:subClassOf eccpubsub:Endpoint;
                      status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_ACTIVE dcterms:issued "2016-07-12"^^xsd:date;
                              dcterms:modified "2016-07-12"^^xsd:date;
                              a eccpubsub:SubscriptionState;
                              rdfs:comment "Indicates that a subscription is valided and verified."@en;
                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "active"@en;
                              status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_CANCELED dcterms:issued "2016-07-12"^^xsd:date;
                                dcterms:modified "2016-07-12"^^xsd:date;
                                a eccpubsub:SubscriptionState;
                                rdfs:comment "Indicates that a susbcription was canceled by the subscriber."@en;
                                rdfs:isDefinedBy eccpubsub:;
                                rdfs:label "canceled"@en;
                                status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_DENIED dcterms:issued "2016-07-12"^^xsd:date;
                              dcterms:modified "2016-07-12"^^xsd:date;
                              a eccpubsub:SubscriptionState;
                              rdfs:comment "Indicates that a subscription was denied by a publisher."@en;
                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "denied"@en;
                              status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_CANCELED dcterms:issued "2016-07-12"^^xsd:date;
                                        dcterms:modified "2016-07-12"^^xsd:date;
                                        a eccpubsub:SubscriptionRequestState;
                                        rdfs:comment "Indicates that a subscription cancellation request was successfully sent to the hub but is not yet verified."@en;
                                        rdfs:isDefinedBy eccpubsub:;
                                        rdfs:label "request canceled"@en;
                                        status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_DELETED dcterms:issued "2016-07-12"^^xsd:date;
                                       dcterms:modified "2016-07-12"^^xsd:date;
                                       a eccpubsub:SubscriptionRequestState;
                                       rdfs:comment "Indicates that a subscription cancellation request was successfully verified."@en;
                                       rdfs:isDefinedBy eccpubsub:;
                                       rdfs:label "request deleted"@en;
                                       status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_DENIED dcterms:issued "2016-07-12"^^xsd:date;
                                      dcterms:modified "2016-07-12"^^xsd:date;
                                      a eccpubsub:SubscriptionRequestState;
                                      rdfs:comment "Indicates that a subscription request was denied."@en;
                                      rdfs:isDefinedBy eccpubsub:;
                                      rdfs:label "request denied"@en;
                                      status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_PENDING dcterms:issued "2016-07-12"^^xsd:date;
                                       dcterms:modified "2016-07-12"^^xsd:date;
                                       a eccpubsub:SubscriptionRequestState;
                                       rdfs:comment "Indicates that a subscription request was successfully sent to the hub but is not yet verified."@en;
                                       rdfs:isDefinedBy eccpubsub:;
                                       rdfs:label "request pending"@en;
                                       status:term_status "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_VERIFIED dcterms:issued "2016-07-12"^^xsd:date;
                                        dcterms:modified "2016-07-12"^^xsd:date;
                                        a eccpubsub:SubscriptionRequestState;
                                        rdfs:comment "Indicates that a subscription request was successfully validated and verified."@en;
                                        rdfs:isDefinedBy eccpubsub:;
                                        rdfs:label "request verified"@en;
                                        status:term_status "testing"@en.
eccpubsub:Subscription dcterms:issued "2016-07-12"^^xsd:date;
                       dcterms:modified "2016-07-12"^^xsd:date;
                       a owl:Class;
                       rdfs:comment "A unique relation to a topic by a subscriber that indicates it should receive updates for that topic."@en;
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "subscription"@en;
                       rdfs:subClassOf [owl:onProperty eccpubsub:state ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty dcterms:modified ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty eccpubsub:secret ; 
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty eccpubsub:deniedReason ; 
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty dcterms:created ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty eccpubsub:callback ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty eccpubsub:topic ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction];
                       status:term_status "testing"@en.
eccpubsub:SubscriptionRequest dcterms:issued "2016-07-12"^^xsd:date;
                              dcterms:modified "2016-07-12"^^xsd:date;
                              a owl:Class;
                              rdfs:comment "A request to a hub by a subscriber indicating interest to updates of a topic."@en;
                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "subscription request"@en;
                              rdfs:subClassOf [owl:onProperty dcterms:created ; 
                                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              [owl:onProperty eccpubsub:requestState ; 
                                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              [owl:onProperty eccpubsub:deniedReason ; 
                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              [owl:onProperty dcterms:modified ; 
                                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              [owl:onProperty eccpubsub:topic ; 
                                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction],
                                              [owl:onProperty eccpubsub:hub ; 
                                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               a owl:Restriction];
                              status:term_status "testing"@en.
eccpubsub:SubscriptionRequestState dcterms:issued "2016-07-12"^^xsd:date;
                                   dcterms:modified "2016-07-12"^^xsd:date;
                                   a owl:Class;
                                   rdfs:comment "A state of a subscription request."@en;
                                   rdfs:isDefinedBy eccpubsub:;
                                   rdfs:label "subscription request state"@en;
                                   owl:equivalentClass [owl:oneOf (eccpubsub:SUBSCRIPTION_REQUEST_PENDING
                                                                   eccpubsub:SUBSCRIPTION_REQUEST_VERIFIED
                                                                   eccpubsub:SUBSCRIPTION_REQUEST_DENIED
                                                                   eccpubsub:SUBSCRIPTION_REQUEST_CANCELED
                                                                   eccpubsub:SUBSCRIPTION_REQUEST_DELETED) ; 
                                                        a owl:Class];
                                   status:term_status "testing"@en.
eccpubsub:SubscriptionState dcterms:issued "2016-07-12"^^xsd:date;
                            dcterms:modified "2016-07-12"^^xsd:date;
                            a owl:Class;
                            rdfs:comment "A state of a subscription."@en;
                            rdfs:isDefinedBy eccpubsub:;
                            rdfs:label "subscription state"@en;
                            owl:equivalentClass [owl:oneOf (eccpubsub:SUBSCRIPTION_ACTIVE
                                                            eccpubsub:SUBSCRIPTION_CANCELED
                                                            eccpubsub:SUBSCRIPTION_DENIED) ; 
                                                 a owl:Class];
                            status:term_status "testing"@en.
eccpubsub:callback dcterms:issued "2016-07-12"^^xsd:date;
                   dcterms:modified "2016-07-12"^^xsd:date;
                   a owl:ObjectProperty;
                   rdfs:comment "The URL at which a subscriber wishes to receive notifications."@en;
                   rdfs:domain eccpubsub:Subscription;
                   rdfs:isDefinedBy eccpubsub:;
                   rdfs:label "has callback URL"@en;
                   rdfs:range eccpubsub:CallbackEndpoint;
                   status:term_status "testing"@en.
eccpubsub:deniedReason dcterms:issued "2016-07-12"^^xsd:date;
                       dcterms:modified "2016-07-12"^^xsd:date;
                       a owl:DatatypeProperty;
                       rdfs:comment "The reason for which the subscription (request) has been denied."@en;
                       rdfs:domain [owl:unionOf (eccpubsub:Subscription
                                                 eccpubsub:SubscriptionRequest) ; 
                                    a owl:Class];
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "has reason for denial"@en;
                       rdfs:range xsd:string;
                       status:term_status "testing"@en.
eccpubsub:hub dcterms:issued "2016-07-12"^^xsd:date;
              dcterms:modified "2016-07-12"^^xsd:date;
              a owl:ObjectProperty;
              rdfs:comment "The URL of the hub to which the request is addressed."@en;
              rdfs:domain eccpubsub:SubscriptionRequest;
              rdfs:isDefinedBy eccpubsub:;
              rdfs:label "has hub URL"@en;
              rdfs:range eccpubsub:HubEndpoint;
              status:term_status "testing"@en.
eccpubsub:requestState dcterms:issued "2016-07-12"^^xsd:date;
                       dcterms:modified "2016-07-12"^^xsd:date;
                       a owl:ObjectProperty;
                       rdfs:comment "The state of a subscription request."@en;
                       rdfs:domain eccpubsub:SubscriptionRequest;
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "has subscription request state"@en;
                       rdfs:range eccpubsub:SubscriptionRequestState;
                       status:term_status "testing"@en.
eccpubsub:secret dcterms:issued "2016-07-12"^^xsd:date;
                 dcterms:modified "2016-07-12"^^xsd:date;
                 a owl:DatatypeProperty;
                 rdfs:comment "A secret string that will be used to compute an HMAC digest for authorized content distribution. If not supplied, the HMAC digest will not be present for content distribution requests."@en;
                 rdfs:domain eccpubsub:Subscription;
                 rdfs:isDefinedBy eccpubsub:;
                 rdfs:label "has secret"@en;
                 rdfs:range xsd:string;
                 status:term_status "testing"@en.
eccpubsub:state dcterms:issued "2016-07-12"^^xsd:date;
                dcterms:modified "2016-07-12"^^xsd:date;
                a owl:ObjectProperty;
                rdfs:comment "The state of a subscription."@en;
                rdfs:domain eccpubsub:Subscription;
                rdfs:isDefinedBy eccpubsub:;
                rdfs:label "has subscription state"@en;
                rdfs:range eccpubsub:SubscriptionState;
                status:term_status "testing"@en.
eccpubsub:topic dcterms:issued "2016-07-12"^^xsd:date;
                dcterms:modified "2016-07-12"^^xsd:date;
                a owl:ObjectProperty;
                rdfs:comment "The resource URI for which updates should be published."@en;
                rdfs:domain [owl:unionOf (eccpubsub:Subscription
                                          eccpubsub:SubscriptionRequest) ; 
                             a owl:Class];
                rdfs:isDefinedBy eccpubsub:;
                rdfs:label "has topic URI"@en;
                rdfs:range owl:Thing;
                status:term_status "testing"@en.
