                                dcterms:created "2023-05-30";
                                dcterms:creator "Patricia Casla (Tekniker)"@en;
                                dcterms:description "The goal of this module is to represent the common classes, and object and data properties included in two or more modules of the TribOnt ontology. "@en;
                                dcterms:issued "2023-05-30";
                                dcterms:publisher "Tekniker";
                                dcterms:title "Core module";
                                vann:preferredNamespacePrefix "core";
                                vann:preferredNamespaceUri "https://w3id.org/tribont/core";
                                a owl:Ontology;
                                owl:imports w3id:isCharacterisedBy;
                                owl:versionInfo 1.0.
tribont-core:%C3%85 a tribont-core:DistanceUnit,
                      owl:NamedIndividual;
                    rdfs:isDefinedBy "https://w3id.org/tribont/core";
                    rdfs:label "Å";
                    status:term_status "Testing".
tribont-core:ASTMD5706 a owl:NamedIndividual;
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "ASTMD5706";
                       status:term_status "Testing".
tribont-core:ASTMD5707 a owl:NamedIndividual;
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "ASTMD5707";
                       status:term_status "Testing".
tribont-core:ASTMD6425 a owl:NamedIndividual;
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "ASTMD6425";
                       status:term_status "Testing".
tribont-core:ASTMD7421 a owl:NamedIndividual;
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "ASTMD7421";
                       status:term_status "Testing".
tribont-core:Acceleration a owl:Class;
                          rdfs:comment "Increase in speed or rate.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/core";
                          rdfs:label "Acceleration";
                          rdfs:subClassOf [owl:onClass tribont-core:AccelerationUnit ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty icb:hasUnit ; 
                                           a owl:Restriction],
                                          [owl:allValuesFrom tribont-core:AccelerationUnit ; 
                                           owl:onProperty icb:hasUnit ; 
                                           a owl:Restriction],
                                          tribont-core:MovementProperty;
                          status:term_status "Testing".
tribont-core:AccelerationUnit a owl:Class;
                              rdfs:comment "Measurement unit for derivative of velocity with respect to time.";
                              rdfs:isDefinedBy "https://w3id.org/tribont/core";
                              rdfs:label "AccelerationUnit";
                              rdfs:subClassOf icb:Unit;
                              status:term_status "Testing".
tribont-core:AcidNumberAN a owl:Class;
                          rdfs:comment "Acid number of something.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/core";
                          rdfs:label "AcidNumberAN";
                          rdfs:subClassOf tribont-core:LiquidPhysicalProperty;
                          status:term_status "Testing".
tribont-core:AirReleaseTimeLAV a owl:Class;
                               rdfs:comment "Air release time for something.";
                               rdfs:isDefinedBy "https://w3id.org/tribont/core";
                               rdfs:label "AirReleaseTimeLAV";
                               rdfs:subClassOf [owl:onClass tribont-core:TimeUnit ; 
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onProperty icb:hasUnit ; 
                                                a owl:Restriction],
                                               [owl:allValuesFrom tribont-core:TimeUnit ; 
                                                owl:onProperty icb:hasUnit ; 
                                                a owl:Restriction],
                                               tribont-core:LiquidPhysicalProperty;
                               status:term_status "Testing".
tribont-core:AlkalineAdditivesConsumption a owl:Class;
                                          rdfs:comment "Consumption of alkaline additives by something.";
                                          rdfs:isDefinedBy "https://w3id.org/tribont/core";
                                          rdfs:label "AlkalineAdditivesConsumption";
                                          rdfs:subClassOf [owl:onClass tribont-core:CapacityUnit ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty icb:hasUnit ; 
                                                           a owl:Restriction],
                                                          [owl:allValuesFrom tribont-core:CapacityUnit ; 
                                                           owl:onProperty icb:hasUnit ; 
                                                           a owl:Restriction],
                                                          tribont-core:LiquidPhysicalProperty;
                                          status:term_status "Testing".
tribont-core:AngleUnit a owl:Class;
                       rdfs:comment "Measurement unit for angle.";
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "AngleUnit";
                       rdfs:subClassOf icb:Unit;
                       status:term_status "Testing".
tribont-core:AngularPosition a owl:Class;
                             rdfs:comment "Angular position of something.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/core";
                             rdfs:label "AngularPosition";
                             rdfs:subClassOf tribont-core:MovementProperty;
                             status:term_status "Testing".
tribont-core:AxialLoad a owl:Class;
                       rdfs:comment "Axial load applied to something.";
                       rdfs:isDefinedBy "https://w3id.org/tribont/core";
                       rdfs:label "AxialLoad";
                       rdfs:subClassOf [owl:onClass tribont-core:ForceUnit ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty icb:hasUnit ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom tribont-core:ForceUnit ; 
                                        owl:onProperty icb:hasUnit ; 
                                        a owl:Restriction],
                                       tribont-core:LoadProperty;
                       status:term_status "Testing".
tribont-core:BTUhr.ft.degreeF a tribont-core:ThermalConductivityUnit,
                                owl:NamedIndividual;
                              rdfs:isDefinedBy "https://w3id.org/tribont/core";
                              rdfs:label "BTU/hr.ft.°F";
                              status:term_status "Testing".
tribont-core:BTUin2 a tribont-core:TensionUnit,
                      owl:NamedIndividual;
                    rdfs:isDefinedBy "https://w3id.org/tribont/core";
                    rdfs:label "BTU/in2";
                    status:term_status "Testing".
tribont-core:BTUlb.degreeF a tribont-core:HeatCapacityUnit,
                             owl:NamedIndividual;
                           rdfs:isDefinedBy "https://w3id.org/tribont/core";
                           rdfs:label "BTU/lb.°F";
                           status:term_status "Testing".
tribont-core:Ba a tribont-core:MechanicalUnit,
                  owl:NamedIndividual;
                rdfs:isDefinedBy "https://w3id.org/tribont/core";
                rdfs:label "Ba";
                status:term_status "Testing".
tribont-core:Body a owl:Class;
                  rdfs:comment "A body can be considered as an aggregate of particles to which it is possible to apply a force";
                  rdfs:isDefinedBy "https://w3id.org/tribont/core";
                  rdfs:label "Body";
                  rdfs:subClassOf [owl:onClass tribont-core:Shape ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty icb:isCharacterisedBy ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom [owl:unionOf (tribont-core:GeometricDimension
                                                                   tribont-core:Shape
                                                                   tribont-core:Volume
                                                                   tribont-core:Weight) ; 
                                                      a owl:Class] ; 
                                   owl:onProperty icb:isCharacterisedBy ; 
                                   a owl:Restriction],
                                  [owl:onClass tribont-core:Volume ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty icb:isCharacterisedBy ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom tribont-core:GeometricDimension ; 
                                   owl:onProperty icb:isCharacterisedBy ; 
                                   a owl:Restriction],
                                  icb:SubjectOfInterest,
                                  [owl:onClass tribont-core:Weight ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty icb:isCharacterisedBy ; 
                                   a owl:Restriction];
                  status:term_status "Testing".
tribont-core:BodyProperty a owl:Class;
                          rdfs:comment "Qualifiable or quantifiable attribute, or characteristic of a body.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/core";
                          rdfs:label "BodyProperty";
                          rdfs:subClassOf tribont-core:TechnicalProperty;
                          status:term_status "Testing".
tribont-core:COFMean a owl:Class;
                     rdfs:comment "Mean value of the coefficient of friction.";
                     rdfs:label "COFMean";
                     rdfs:subClassOf tribont-core:FrictionProperty;
                     status:term_status "https://w3id.org/tribont/core",
                                        "Testing".
tribont-core:CapacityUnit a owl:Class;
                          rdfs:comment "Measurement unit for capacity.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/core";
                          rdfs:label "CapacityUnit";
                          rdfs:subClassOf icb:Unit;
                          status:term_status "Testing".
tribont-core:ChamberTemperature a owl:Class;
                                rdfs:comment "Temperature of the chamber where the sample is tested.";
                                rdfs:isDefinedBy "https://w3id.org/tribont/core";
                                rdfs:label "ChamberTemperature";
                                rdfs:subClassOf tribont-core:Temperature;
                                owl:disjointWith tribont-core:SampleTemperature;
                                status:term_status "Testing".
tribont-core:CloudPoint a owl:Class;
                        rdfs:comment "Cloud point.";
                        rdfs:label "CloudPoint";
                        rdfs:subClassOf tribont-core:LiquidThermalProperty;
                        status:term_status "https://w3id.org/tribont/core".
tribont-core:ColdFilterPluggingPoint a owl:Class;
                                     rdfs:comment "Cold filter plugging point.";
                                     rdfs:label "ColdFilterPluggingPoint";
                                     rdfs:subClassOf tribont-core:LiquidThermalProperty;
                                     status:term_status "https://w3id.org/tribont/core".
tribont-core:ColourIndex a owl:Class;
                         rdfs:comment "Colour index  of something.";
                         rdfs:isDefinedBy "https://w3id.org/tribont/core";
                         rdfs:label "ColourIndex";
                         rdfs:subClassOf tribont-core:LiquidPhysicalProperty;
                         status:term_status "Testing".
tribont-core:Company a owl:Class;
                     rdfs:comment "A company.";
                     rdfs:isDefinedBy "https://w3id.org/tribont/core";
                     rdfs:label "Company";
                     rdfs:subClassOf [owl:allValuesFrom xsd:string ; 
                                      owl:onProperty tribont-core:shortName ; 
                                      a owl:Restriction],
                                     [owl:allValuesFrom xsd:string ; 
                                      owl:onProperty tribont-core:name ; 
                                      a owl:Restriction],
                                     [owl:allValuesFrom xsd:string ; 
                                      owl:onProperty dcterms:identifier ; 
                                      a owl:Restriction];
