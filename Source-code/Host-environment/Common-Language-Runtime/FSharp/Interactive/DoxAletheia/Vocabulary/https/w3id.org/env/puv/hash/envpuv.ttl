envpuv:PhysicalEntitySubGroup <http://purl.org/dc/terms/description> "Controlled vocabulary defining the terms that may be used to qualify a generic physical entity (part of the what theme) in the BODC parameter semantic model";
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "Physical entity sub-group (S19)";
                              rdfs:seeAlso <http://vocab.nerc.ac.uk/collection/S19/>;
                              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>,
