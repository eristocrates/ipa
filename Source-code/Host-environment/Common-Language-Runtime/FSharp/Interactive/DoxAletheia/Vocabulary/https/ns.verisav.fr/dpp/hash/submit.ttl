@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix submit: <https://ns.verisav.fr/dpp#>.

submit: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/>;
        <http://purl.org/dc/terms/created> "2025-12-16"^^xsd:date;
        <http://purl.org/dc/terms/creator> [rdfs:seeAlso <https://www.linkedin.com/in/kévinboutillier> ; 
                                            rdfs:seeAlso <https://www.verisav.fr/en/founders/kevin-boutillier> ; 
                                            rdfs:seeAlso <https://orcid.org/0009-0001-0356-4421> ; 
                                            <http://xmlns.com/foaf/0.1/name> "Kévin Boutillier" ; 
                                            a <http://xmlns.com/foaf/0.1/Person>];
        <http://purl.org/dc/terms/description> "Vocabulaire pour les Passeports Produit Numérique (DPP) gérant le cycle de vie des produits, garanties, réparations et conformité avec les réglementations européennes (ESPR EU 2024/1781). Aligné avec les standards GS1 Digital Link, UNTP (United Nations Transparency Protocol) pour la durabilité et la traçabilité, et EU Business Wallet (EBW) pour les credentials vérifiables et l'identité d'entreprise. Inclut GTIN, GLN, granularité (modèle/lot/série), support des identifiants composés, provenance des matériaux, émissions, circularité, déclarations de conformité, W3C Verifiable Credentials (VCDM 2.0), et support EUID (European Unique Identifier)."@fr,
                                               "Vocabulary for Digital Product Passports (DPP) managing product lifecycle, warranties, repairs, and compliance with EU regulations (ESPR EU 2024/1781). Aligned with GS1 Digital Link standards, UNTP (United Nations Transparency Protocol) for sustainability and traceability, and EU Business Wallet (EBW) for verifiable credentials and enterprise identity. Includes GTIN, GLN, granularity (model/batch/serial), compound identifier support, material provenance, emissions, circularity, conformity claims, W3C Verifiable Credentials (VCDM 2.0), and EUID (European Unique Identifier) support."@en;
        <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
        <http://purl.org/dc/terms/modified> "2026-01-23"^^xsd:date;
        <http://purl.org/dc/terms/publisher> <https://www.verisav.fr/>;
        <http://purl.org/dc/terms/rights> "Copyright © 2025 Verisav SAS. All rights reserved."@en,
                                          "Copyright © 2025 Verisav SAS. Tous droits réservés."@fr;
        <http://purl.org/dc/terms/title> "Verisav DPP Vocabulary"@en;
        <http://purl.org/vocab/vann/preferredNamespacePrefix> "dpp";
        <http://purl.org/vocab/vann/preferredNamespaceUri> "https://ns.verisav.fr/dpp#";
        a <http://www.w3.org/2002/07/owl#Ontology>,
          <http://purl.org/vocommons/voaf#Vocabulary>;
        rdfs:comment "This vocabulary is aligned with UNTP DPP specification for sustainability and traceability, EU Business Wallet (EBW) for verifiable credentials and enterprise identity, while maintaining a specific focus on after-sales service (SAV)."@en,
                     "Version 1.2.0 (2026-01-23): Ajout support EU Business Wallet (EBW) - VerifiableProductPassport, VerifiableCredential, support EUID pour EconomicOperator, SecureDataShare. Version 1.1.0 (2025-01-XX): Ajout alignement UNTP - Provenance Matériaux, Classification Produit, Performance Émissions, Performance Circularité, Déclarations Conformité, Événements Traçabilité. Version initiale (1.0.0) avec alignement GS1 Digital Link et support ESPR (EU 2024/1781). Propriétés ajoutées : gs1DigitalLink, hasGln, hasGtin, granularityLevel, batchLotNumber, versionNumber. Classes ajoutées : EconomicOperator, Facility, CompoundIdentifier."@fr,
                     "Ce vocabulaire est aligné avec la spécification UNTP DPP pour la durabilité et la traçabilité, EU Business Wallet (EBW) pour les credentials vérifiables et l'identité d'entreprise, tout en conservant un focus spécifique sur le service après-vente (SAV)."@fr,
                     "Version 1.2.0 (2026-01-23): Added EU Business Wallet (EBW) support - VerifiableProductPassport, VerifiableCredential, EUID support for EconomicOperator, SecureDataShare. Version 1.1.0 (2025-01-XX): Added UNTP alignment - Material Provenance, Product Classification, Emissions Performance, Circularity Performance, Conformity Claims, Traceability Events. Initial release (1.0.0) with GS1 Digital Link alignment and ESPR (EU 2024/1781) support. Added properties: gs1DigitalLink, hasGln, hasGtin, granularityLevel, batchLotNumber, versionNumber. Added classes: EconomicOperator, Facility, CompoundIdentifier."@en,
                     """Ce vocabulaire est accessible via l'API GraphQL à https://www.verisav.fr/api/graphql. Utilisez la requête 'vocabulary(id: \"dpp\")' pour accéder aux données du vocabulaire DPP."""@fr,
                     """This vocabulary is accessible via GraphQL API at https://www.verisav.fr/api/graphql. Use the 'vocabulary(id: \"dpp\")' query to access DPP vocabulary data."""@en;
        rdfs:label "Vocabulaire Passeport Produit Numérique Verisav"@fr,
                   "Verisav Digital Product Passport Vocabulary"@en;
        rdfs:seeAlso <https://www.w3.org/TR/vc-data-model-2.0/>,
                     <https://www.gs1.org/standards/id-keys>,
                     <https://untp.unece.org/docs/specification/DigitalProductPassport/>,
                     <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>,
                     <https://www.gs1.org/standards/Digital-Link/>;
        <http://www.w3.org/2002/07/owl#imports> <https://schema.org/>;
        <http://www.w3.org/2002/07/owl#versionInfo> "1.2.0";
        <http://www.w3.org/ns/dcat#accessURL> <https://www.verisav.fr/api/graphql>;
        <http://www.w3.org/ns/dcat#distribution> [<http://purl.org/dc/terms/description> "API GraphQL pour interroger tous les vocabulaires Verisav (DPP, RMA, WTY). Supporte l'introspection, les labels multilingues et l'accès en temps réel aux vocabulaires."@fr ; 
                                                  <http://purl.org/dc/terms/description> "GraphQL API for querying all Verisav vocabularies (DPP, RMA, WTY). Supports introspection, multilingual labels, and real-time vocabulary access."@en ; 
                                                  <http://purl.org/dc/terms/title> "API GraphQL Vocabulaires Verisav"@fr ; 
                                                  <http://purl.org/dc/terms/title> "Verisav Vocabularies GraphQL API"@en ; 
                                                  <http://www.w3.org/ns/dcat#endpointURL> <https://www.verisav.fr/api/graphql> ; 
                                                  <http://www.w3.org/ns/dcat#accessURL> <https://www.verisav.fr/api/graphql> ; 
                                                  <http://purl.org/dc/terms/format> "application/graphql" ; 
                                                  a <http://www.w3.org/ns/dcat#Distribution>],
                                                 [<http://purl.org/dc/terms/title> "DPP Vocabulary (JSON-LD via API)"@en ; 
                                                  <http://www.w3.org/ns/dcat#accessURL> <https://www.verisav.fr/api/dpp/dpp.jsonld> ; 
                                                  <http://purl.org/dc/terms/format> "application/ld+json" ; 
                                                  a <http://www.w3.org/ns/dcat#Distribution>],
                                                 [<http://www.w3.org/ns/dcat#downloadURL> <https://ns.verisav.fr/dpp/dpp.xml> ; 
                                                  <http://purl.org/dc/terms/format> "application/rdf+xml" ; 
                                                  a <http://www.w3.org/ns/dcat#Distribution>],
                                                 [<http://www.w3.org/ns/dcat#downloadURL> <https://ns.verisav.fr/dpp/dpp.ttl> ; 
                                                  <http://purl.org/dc/terms/format> "text/turtle" ; 
                                                  a <http://www.w3.org/ns/dcat#Distribution>],
                                                 [<http://www.w3.org/ns/dcat#downloadURL> <https://ns.verisav.fr/dpp/dpp.jsonld> ; 
                                                  <http://purl.org/dc/terms/format> "application/ld+json" ; 
                                                  a <http://www.w3.org/ns/dcat#Distribution>];
        <http://www.w3.org/ns/dcat#endpointURL> <https://www.verisav.fr/api/graphql>;
        <https://schema.org/potentialAction> [<https://schema.org/query-input> "required name=query" ; 
                                              <https://schema.org/target> <https://www.verisav.fr/api/v1/vocabulary/dpp/search?q=%7Bquery%7D> ; 
                                              a <https://schema.org/SearchAction>].
submit:CircularityPerformance a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Tableau de bord de la circularité du produit. Aligné avec UNTP DPP."@fr,
                                           "Product circularity scorecard. Aligned with UNTP DPP."@en;
                              rdfs:isDefinedBy submit:;
                              rdfs:label "Circularity Performance"@en,
                                         "Performance Circularité"@fr;
                              rdfs:seeAlso <https://www.ellenmacarthurfoundation.org/resources/apply/material-circularity-indicator>,
                                           <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                              rdfs:subClassOf <https://schema.org/Thing>;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:CompoundIdentifier a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Un identifiant complexe combinant un GTIN avec un variant, lot ou numéro de série (produits sur mesure)."@fr,
                                       "A complex identifier combining a GTIN with a variant, batch, or serial number (Made-to-Order products)."@en;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "Identifiant Composé"@fr,
                                     "Compound Identifier"@en;
                          rdfs:subClassOf <https://schema.org/PropertyValue>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:ConformityClaim a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Déclaration de conformité à un standard ou réglementation. Aligné avec UNTP DPP."@fr,
                                    "Claim of conformity to a standard or regulation. Aligned with UNTP DPP."@en;
                       rdfs:isDefinedBy submit:;
                       rdfs:label "Déclaration de Conformité"@fr,
                                  "Conformity Claim"@en;
                       rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                       rdfs:subClassOf <https://schema.org/Claim>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Consumer a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Un consommateur qui possède ou utilise un produit."@fr,
                             "A consumer who owns or uses a product."@en;
                rdfs:label "Consommateur"@fr,
                           "Consumer"@en;
                rdfs:subClassOf <https://schema.org/Person>.
submit:Criterion a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Critère ou règle dans un standard ou réglementation contre lequel une déclaration est évaluée."@fr,
                              "A criterion or rule within a standard or regulation against which a claim is evaluated."@en;
                 rdfs:isDefinedBy submit:;
                 rdfs:label "Critère"@fr,
                            "Criterion"@en;
                 rdfs:subClassOf <https://schema.org/Thing>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Diagnostic a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Une évaluation de diagnostic effectuée sur un produit pour identifier les problèmes."@fr,
                               "A diagnostic assessment performed on a product to identify issues."@en;
                  rdfs:label "Diagnostic"@fr,
                             "Diagnostic"@en;
                  rdfs:subClassOf <https://schema.org/Thing>.
submit:Document a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Un document associé à un produit (manuels, factures, certificats, etc.)."@fr,
                             "A document associated with a product (manuals, invoices, certificates, etc.)."@en;
                rdfs:label "Document"@fr,
                           "Document"@en;
                rdfs:subClassOf <https://schema.org/DigitalDocument>.
submit:EconomicOperator a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Un opérateur économique dans la chaîne de valeur (fabricant, importateur, distributeur, revendeur, réparateur) selon la réglementation européenne ESPR. Peut être authentifié via EU Business Wallet (EBW) avec EUID (European Unique Identifier)."@fr,
                                     "An economic operator in the value chain (manufacturer, importer, distributor, dealer, repairer) as per EU ESPR regulation. Can be authenticated via EU Business Wallet (EBW) with EUID (European Unique Identifier)."@en;
                        rdfs:isDefinedBy submit:;
                        rdfs:label "Opérateur Économique"@fr,
                                   "Economic Operator"@en;
                        rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                        rdfs:subClassOf <https://schema.org/Organization>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:EmissionsPerformance a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Tableau de bord des émissions de gaz à effet de serre du produit. Aligné avec UNTP DPP."@fr,
                                         "Greenhouse gas emissions scorecard for a product. Aligned with UNTP DPP."@en;
                            rdfs:isDefinedBy submit:;
                            rdfs:label "Performance Émissions"@fr,
                                       "Emissions Performance"@en;
                            rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                            rdfs:subClassOf <https://schema.org/QuantitativeValue>;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Facility a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Un lieu ou bâtiment impliqué dans la chaîne de valeur d'un produit (usine de fabrication, entrepôt, etc.) selon la réglementation européenne ESPR. Aligné avec UNTP DPP-04."@fr,
                             "A location or building involved in the value chain of a product (manufacturing facility, warehouse, etc.) as per EU ESPR regulation. Aligned with UNTP DPP-04."@en;
                rdfs:isDefinedBy submit:;
                rdfs:label "Installation"@fr,
                           "Facility"@en;
                rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                rdfs:subClassOf <https://schema.org/Place>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Intervention a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Une intervention technique sur un produit (diagnostic, réparation, maintenance, remplacement, retour fabricant)."@fr,
                                 "A technical intervention on a product (diagnostic, repair, maintenance, replacement, return to manufacturer)."@en;
                    rdfs:label "Intervention"@fr,
                               "Intervention"@en;
                    rdfs:subClassOf submit:RepairEvent.
submit:Manufacturer a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Le fabricant d'un produit."@fr,
                                 "The manufacturer of a product."@en;
                    rdfs:label "Fabricant"@fr,
                               "Manufacturer"@en;
                    rdfs:subClassOf <https://schema.org/Organization>.
submit:MaterialProvenance a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Information sur la provenance d'un matériau : nom, fraction massique, pays d'origine. Aligné avec UNTP DPP-03."@fr,
                                       "Information about material provenance: name, mass fraction, origin country. Aligned with UNTP DPP-03."@en;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "Provenance des Matériaux"@fr,
                                     "Material Provenance"@en;
                          rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                          rdfs:subClassOf <https://schema.org/Thing>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Metric a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Métrique définissant les valeurs mesurées réelles, incluant optionnellement la précision."@fr,
                           "A metric defining actual measured values, optionally including accuracy."@en;
              rdfs:isDefinedBy submit:;
              rdfs:label "Métrique"@fr,
                         "Metric"@en;
              rdfs:subClassOf <https://schema.org/QuantitativeValue>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:ProductClassification a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Classification d'un produit selon un schéma standardisé (UN-CPC, GS1, NACE, etc.). Aligné avec UNTP DPP-02."@fr,
                                          "Product classification according to a standardized scheme (UN-CPC, GS1, NACE, etc.). Aligned with UNTP DPP-02."@en;
                             rdfs:isDefinedBy submit:;
                             rdfs:label "Classification Produit"@fr,
                                        "Product Classification"@en;
                             rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                             rdfs:subClassOf <https://schema.org/Thing>;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:ProductLifecycleStage a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Une étape dans le cycle de vie du produit (fabrication, achat, usage, fin de vie, recyclage)."@fr,
                                          "A stage in the product lifecycle (manufacturing, purchase, usage, end of life, recycling)."@en;
                             rdfs:label "Étape du Cycle de Vie du Produit"@fr,
                                        "Product Lifecycle Stage"@en;
                             rdfs:subClassOf <https://schema.org/Enumeration>.
submit:ProductPassport a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Un Passeport Produit Numérique qui suit un produit tout au long de son cycle de vie."@fr,
                                    "A Digital Product Passport that tracks a product throughout its entire lifecycle."@en;
                       rdfs:label "Passeport Produit"@fr,
                                  "Product Passport"@en;
                       rdfs:subClassOf <https://schema.org/Product>.
submit:ProductStatus a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Le statut actuel d'un produit (sous garantie, hors garantie, en panne, réparé, etc.)."@fr,
                                  "The current status of a product (under warranty, out of warranty, broken, repaired, etc.)."@en;
                     rdfs:label "Statut Produit"@fr,
                                "Product Status"@en;
                     rdfs:subClassOf <https://schema.org/Enumeration>.
submit:RecyclingInstructions a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Instructions pour recycler ou éliminer un produit en fin de vie."@fr,
                                          "Instructions for recycling or disposing of a product at end of life."@en;
                             rdfs:label "Consignes de Recyclage"@fr,
                                        "Recycling Instructions"@en;
                             rdfs:subClassOf <https://schema.org/CreativeWork>.
submit:Regulation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Réglementation de référence pour une déclaration de conformité."@fr,
                               "Reference regulation for a conformity claim."@en;
                  rdfs:isDefinedBy submit:;
                  rdfs:label "Réglementation"@fr,
                             "Regulation"@en;
                  rdfs:subClassOf <https://schema.org/Thing>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:RepairEvent a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Une intervention de réparation ou maintenance spécifique effectuée sur un produit."@fr,
                                "A specific repair or maintenance intervention performed on a product."@en;
                   rdfs:label "Événement de Réparation"@fr,
                              "Repair Event"@en;
                   rdfs:subClassOf <https://schema.org/Service>.
submit:Repairer a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Une personne ou organisation qui répare des produits."@fr,
                             "A person or organization that repairs products."@en;
                rdfs:label "Réparateur"@fr,
                           "Repairer"@en;
                rdfs:subClassOf <https://schema.org/Organization>,
                                <https://schema.org/Person>.
submit:ReplacementPart a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Une pièce utilisée pour remplacer un composant dans un produit lors d'une réparation ou maintenance."@fr,
                                    "A part used to replace a component in a product during repair or maintenance."@en;
                       rdfs:label "Pièce de Rechange"@fr,
                                  "Replacement Part"@en;
                       rdfs:subClassOf <https://schema.org/Product>.
submit:Retailer a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Un distributeur qui vend des produits."@fr,
                             "A retailer or distributor who sells products."@en;
                rdfs:label "Distributeur"@fr,
                           "Retailer"@en;
                rdfs:subClassOf <https://schema.org/Organization>.
submit:SecureDataShare a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Un partage sécurisé de données DPP entre opérateurs économiques via EU Business Wallet (EBW). Inclut la vérification d'intégrité cryptographique et l'horodatage."@fr,
                                    "A secure sharing of DPP data between economic operators via EU Business Wallet (EBW). Includes cryptographic integrity verification and timestamping."@en;
                       rdfs:isDefinedBy submit:;
                       rdfs:label "Partage de Données Sécurisé"@fr,
                                  "Secure Data Share"@en;
                       rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                       rdfs:subClassOf <https://schema.org/Action>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:SecureLink a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Lien sécurisé avec digest de hash et méthode de cryptage pour vérification."@fr,
                               "A secure link with hash digest and encryption method for verification."@en;
                  rdfs:isDefinedBy submit:;
                  rdfs:label "Lien Sécurisé"@fr,
                             "Secure Link"@en;
                  rdfs:subClassOf <https://schema.org/URL>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:ServiceRequest a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Une demande de service après-vente (SAV) pour un produit."@fr,
                                   "A request for after-sales service (SAV) for a product."@en;
                      rdfs:label "Demande de Service"@fr,
                                 "Service Request"@en;
                      rdfs:subClassOf <https://schema.org/Service>.
submit:Standard a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Standard, norme ou schéma de référence pour une déclaration de conformité."@fr,
                             "Standard, norm, or reference scheme for a conformity claim."@en;
                rdfs:isDefinedBy submit:;
                rdfs:label "Standard"@fr,
                           "Standard"@en;
                rdfs:subClassOf <https://schema.org/Thing>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:TraceabilityEvent a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Événement de traçabilité basé sur ISO/IEC 19987 (EPCIS) ou standards similaires. Aligné avec UNTP DPP-06."@fr,
                                      "Traceability event based on ISO/IEC 19987 (EPCIS) or similar standards. Aligned with UNTP DPP-06."@en;
                         rdfs:isDefinedBy submit:;
                         rdfs:label "Traceability Event"@en,
                                    "Événement de Traçabilité"@fr;
                         rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>,
                                      <https://www.iso.org/standard/71507.html>;
                         rdfs:subClassOf <https://schema.org/Event>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:TraceabilityPerformance a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Information de traçabilité pour un processus spécifique de la chaîne de valeur. Aligné avec UNTP DPP."@fr,
                                            "Traceability information for a specific value chain process. Aligned with UNTP DPP."@en;
                               rdfs:isDefinedBy submit:;
                               rdfs:label "Performance Traçabilité"@fr,
                                          "Traceability Performance"@en;
                               rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                               rdfs:subClassOf <https://schema.org/Thing>;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:VerifiableCredential a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Un W3C Verifiable Credential (VCDM 2.0) qui peut être utilisé pour vérifier des déclarations sur un passeport produit ou un opérateur économique. Stocké et géré via EU Business Wallet (EBW)."@fr,
                                         "A W3C Verifiable Credential (VCDM 2.0) that can be used to verify claims about a product passport or economic operator. Stored and managed via EU Business Wallet (EBW)."@en;
                            rdfs:isDefinedBy submit:;
                            rdfs:label "Credential Vérifiable"@fr,
                                       "Verifiable Credential"@en;
                            rdfs:seeAlso <https://www.w3.org/TR/vc-data-model-2.0/>,
                                         <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                            rdfs:subClassOf <https://schema.org/Thing>;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:VerifiableProductPassport a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A Digital Product Passport issued as a W3C Verifiable Credential (VCDM 2.0) via EU Business Wallet (EBW). Provides cryptographic proof of authenticity and integrity."@en,
                                              "Un Passeport Produit Numérique émis comme W3C Verifiable Credential (VCDM 2.0) via EU Business Wallet (EBW). Fournit une preuve cryptographique d'authenticité et d'intégrité."@fr;
                                 rdfs:isDefinedBy submit:;
                                 rdfs:label "Verifiable Product Passport"@en,
                                            "Passeport Produit Vérifiable"@fr;
                                 rdfs:seeAlso <https://www.w3.org/TR/vc-data-model-2.0/>,
                                              <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                                 rdfs:subClassOf submit:ProductPassport;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:Warranty a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Une garantie couvrant un produit, qui peut être de différents types (constructeur, distributeur, extension, maintenance)."@fr,
                             "A warranty covering a product, which can be of different types (manufacturer, retailer, extension, maintenance)."@en;
                rdfs:label "Garantie"@fr,
                           "Warranty"@en;
                rdfs:subClassOf <https://schema.org/WarrantyScope>.
submit:WarrantyClaim a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Une réclamation effectuée sous garantie."@fr,
                                  "A claim made under a warranty."@en;
                     rdfs:label "Réclamation de Garantie"@fr,
                                "Warranty Claim"@en;
                     rdfs:subClassOf <https://schema.org/Claim>.
submit:WorkOrder a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Un ordre de travail à effectuer sur un produit (réparation, maintenance, etc.)."@fr,
                              "An order for work to be performed on a product (repair, maintenance, etc.)."@en;
                 rdfs:label "Ordre de Travail"@fr,
                            "Work Order"@en;
                 rdfs:subClassOf <https://schema.org/Service>.
submit:accuracy a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Précision ou incertitude de la valeur de la métrique (optionnel)."@fr,
                             "Accuracy or uncertainty of the metric value (optional)."@en;
                rdfs:domain submit:Metric;
                rdfs:isDefinedBy submit:;
                rdfs:label "précision"@fr,
                           "accuracy"@en;
                rdfs:range xsd:decimal;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:assessmentCriteria a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Critères dans le standard ou réglementation contre lesquels la déclaration est évaluée."@fr,
                                       "Criteria within the standard or regulation against which the claim is evaluated."@en;
                          rdfs:domain submit:ConformityClaim;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "critères d'évaluation"@fr,
                                     "assessment criteria"@en;
                          rdfs:range submit:Criterion;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:assessmentDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Date à laquelle la déclaration a été évaluée."@fr,
                                   "Date when the claim was assessed."@en;
                      rdfs:domain submit:ConformityClaim;
                      rdfs:isDefinedBy submit:;
                      rdfs:label "date d'évaluation"@fr,
                                 "assessment date"@en;
                      rdfs:range xsd:date;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:batchLotNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The batch or lot number (GS1 AI 10) for production batches. Used with GTIN for batch-level granularity."@en,
                                   "Le numéro de lot ou batch (GS1 AI 10) pour les lots de production. Utilisé avec GTIN pour la granularité au niveau lot."@fr;
                      rdfs:domain submit:CompoundIdentifier,
                                  submit:ProductPassport;
                      rdfs:isDefinedBy submit:;
                      rdfs:label "Batch/Lot Number"@en,
                                 "Numéro de Lot"@fr;
                      rdfs:range xsd:string;
                      rdfs:seeAlso <https://www.gs1.org/standards/barcodes/application-identifiers/10>;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:belongsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Propriété inverse : lie un WorkOrder ou Intervention à son ProductPassport."@fr,
                              "Inverse property: links a WorkOrder or Intervention to its ProductPassport."@en;
                 rdfs:domain submit:Intervention,
                             submit:WorkOrder;
                 rdfs:label "appartient à"@fr,
                            "belongs to"@en;
                 rdfs:range submit:ProductPassport;
                 <http://www.w3.org/2002/07/owl#inverseOf> submit:hasIntervention,
                                                           submit:hasWorkOrder.
submit:carbonFootprint a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Empreinte carbone du produit en kg CO2eq par unité déclarée."@fr,
                                    "Carbon footprint of the product in kg CO2eq per declared unit."@en;
                       rdfs:domain submit:EmissionsPerformance;
                       rdfs:isDefinedBy submit:;
                       rdfs:label "empreinte carbone"@fr,
                                  "carbon footprint"@en;
                       rdfs:range xsd:decimal;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:claimDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Une description de la demande de service ou réclamation."@fr,
                                     "A description of the service request or claim."@en;
                        rdfs:domain submit:ServiceRequest;
                        rdfs:label "description de la réclamation"@fr,
                                   "claim description"@en;
                        rdfs:range xsd:string.
submit:claimPriority a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "La priorité de la demande de service (normal, haute, urgente)."@fr,
                                  "The priority of the service request (normal, high, urgent)."@en;
                     rdfs:domain submit:ServiceRequest;
                     rdfs:label "priorité de la réclamation"@fr,
                                "claim priority"@en;
                     rdfs:range xsd:string.
submit:claimStatus a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Le statut d'une demande de service (soumise, en cours, approuvée, résolue)."@fr,
                                "The status of a service request (soumise, en_cours, approuvee, resolue)."@en;
                   rdfs:domain submit:ServiceRequest;
                   rdfs:label "statut de la réclamation"@fr,
                              "claim status"@en;
                   rdfs:range xsd:string.
submit:classificationCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Code de classification selon le schéma spécifié."@fr,
                                       "Classification code according to the specified scheme."@en;
                          rdfs:domain submit:ProductClassification;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "code de classification"@fr,
                                     "classification code"@en;
                          rdfs:range xsd:string;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:classificationScheme a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "URI ou identifiant du schéma de classification (ex: 'UN-CPC', 'GS1', 'NACE')."@fr,
                                         "URI or identifier of the classification scheme (e.g., 'UN-CPC', 'GS1', 'NACE')."@en;
                            rdfs:domain submit:ProductClassification;
                            rdfs:isDefinedBy submit:;
                            rdfs:label "schéma de classification"@fr,
                                       "classification scheme"@en;
                            rdfs:range xsd:string;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:conformance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Indique si le produit est conforme aux critères spécifiés (true/false)."@fr,
                                "Indicates whether the product meets the specified criteria (true/false)."@en;
                   rdfs:domain submit:ConformityClaim;
                   rdfs:isDefinedBy submit:;
                   rdfs:label "conformité"@fr,
                              "conformance"@en;
                   rdfs:range xsd:boolean;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:conformityEvidence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Lien vers attestation de deuxième ou troisième partie, comme un Digital Conformity Credential UNTP, PDF, ou autre format de preuve."@fr,
                                       "Link to second or third party attestation, such as a UNTP Digital Conformity Credential, PDF, or other evidence format."@en;
                          rdfs:domain submit:ConformityClaim;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "preuve de conformité"@fr,
                                     "conformity evidence"@en;
                          rdfs:range submit:Document,
                                     submit:SecureLink;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:conformityTopic a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Catégorie thématique de la déclaration (ex: 'environment.emissions', 'social.working_conditions')."@fr,
                                    "Topic category of the claim (e.g., 'environment.emissions', 'social.working_conditions')."@en;
                       rdfs:domain submit:ConformityClaim;
                       rdfs:isDefinedBy submit:;
                       rdfs:label "thème de conformité"@fr,
                                  "conformity topic"@en;
                       rdfs:range xsd:string;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:credentialIssuer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "L'autorité ou Opérateur Économique qui a émis un VerifiableCredential via EU Business Wallet (EBW)."@fr,
                                     "The authority or EconomicOperator that issued a VerifiableCredential via EU Business Wallet (EBW)."@en;
                        rdfs:domain submit:ConformityClaim,
                                    submit:VerifiableCredential;
                        rdfs:isDefinedBy submit:;
                        rdfs:label "émetteur de credential"@fr,
                                   "credential issuer"@en;
                        rdfs:range submit:EconomicOperator;
                        rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:criterionId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Identifiant unique du critère (typiquement une URI)."@fr,
                                "Unique identifier for the criterion (typically a URI)."@en;
                   rdfs:domain submit:Criterion;
                   rdfs:isDefinedBy submit:;
                   rdfs:label "ID critère"@fr,
                              "criterion ID"@en;
                   rdfs:range xsd:anyURI;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:criterionName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Nom du critère."@fr,
                                  "Name of the criterion."@en;
                     rdfs:domain submit:Criterion;
                     rdfs:isDefinedBy submit:;
                     rdfs:label "nom du critère"@fr,
                                "criterion name"@en;
                     rdfs:range xsd:string;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:dataIntegrityHash a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Digest de hash cryptographique garantissant l'intégrité des données DPP partagées via EU Business Wallet (EBW). Utilisé dans SecureDataShare pour la détection de falsification."@fr,
                                      "Cryptographic hash digest ensuring the integrity of shared DPP data via EU Business Wallet (EBW). Used in SecureDataShare for tamper detection."@en;
                         rdfs:domain submit:SecureDataShare;
                         rdfs:isDefinedBy submit:;
                         rdfs:label "hash d'intégrité des données"@fr,
                                    "data integrity hash"@en;
                         rdfs:range xsd:string;
                         rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:declaredUnit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Unité de mesure pour l'empreinte carbone (ex: 'KGM' pour kg, 'C62' pour unité)."@fr,
                                 "Unit of measure for carbon footprint (e.g., 'KGM' for kg, 'C62' for unit)."@en;
                    rdfs:domain submit:EmissionsPerformance;
                    rdfs:isDefinedBy submit:;
                    rdfs:label "unité déclarée"@fr,
                               "declared unit"@en;
                    rdfs:range xsd:string;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:declaredValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Valeurs mesurées réelles, incluant optionnellement la précision."@fr,
                                  "Actual measured values, optionally including accuracy."@en;
                     rdfs:domain submit:ConformityClaim;
                     rdfs:isDefinedBy submit:;
                     rdfs:label "valeur déclarée"@fr,
                                "declared value"@en;
                     rdfs:range submit:Metric;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:diagnosticDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Une description du processus de diagnostic et des résultats."@fr,
                                          "A description of the diagnostic process and findings."@en;
                             rdfs:domain submit:Diagnostic;
                             rdfs:label "description du diagnostic"@fr,
                                        "diagnostic description"@en;
                             rdfs:range xsd:string.
submit:diagnosticResult a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Le résultat ou conclusion du diagnostic."@fr,
                                     "The result or conclusion of the diagnostic."@en;
                        rdfs:domain submit:Diagnostic;
                        rdfs:label "résultat du diagnostic"@fr,
                                   "diagnostic result"@en;
                        rdfs:range xsd:string.
submit:encryptionMethod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Méthode de cryptage si applicable (ex: 'AES', 'none')."@fr,
                                     "Encryption method if applicable (e.g., 'AES', 'none')."@en;
                        rdfs:domain submit:SecureLink;
                        rdfs:isDefinedBy submit:;
                        rdfs:label "méthode de cryptage"@fr,
                                   "encryption method"@en;
                        rdfs:range xsd:string;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:euid a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "L'Identifiant Unique Européen (EUID) pour une entité légale, émis via EU Business Wallet (EBW). Fournit une identité numérique unifiée dans les 27 États membres de l'UE."@fr,
                         "The European Unique Identifier (EUID) for a legal entity, issued via EU Business Wallet (EBW). Provides a unified digital identity across all 27 EU member states."@en;
            rdfs:domain submit:EconomicOperator;
            rdfs:isDefinedBy submit:;
            rdfs:label "Identifiant Unique Européen (EUID)"@fr,
                       "European Unique Identifier (EUID)"@en;
            rdfs:range xsd:string;
            rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/business-wallets>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:follows a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Lie une Intervention à une Intervention précédente (crée une chaîne d'interventions)."@fr,
                            "Links an Intervention to a previous Intervention (creates a chain of interventions)."@en;
               rdfs:domain submit:Intervention;
               rdfs:label "suit"@fr,
                          "follows"@en;
               rdfs:range submit:Intervention.
submit:granularityLevel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Le niveau de granularité d'identification : 'model' (GTIN seul), 'batch' (GTIN + numéro de lot), ou 'serial' (GTIN + numéro de série). Déterminé par les actes délégués UE par catégorie de produit."@fr,
                                     "The level of identification granularity: 'model' (GTIN only), 'batch' (GTIN + batch/lot number), or 'serial' (GTIN + serial number). Determined by EU delegated acts per product category."@en;
                        rdfs:domain submit:ProductPassport;
                        rdfs:isDefinedBy submit:;
                        rdfs:label "Niveau de Granularité"@fr,
                                   "Granularity Level"@en;
                        rdfs:range xsd:string;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:gs1DigitalLink a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The standard GS1 Digital Link URI for the product, resolving to the DPP. Uses uncompressed GS1 Digital Link URI syntax per GS1 standards."@en,
                                   "L'URI standard GS1 Digital Link pour le produit, résolvant vers le DPP. Utilise la syntaxe GS1 Digital Link URI non compressée selon les standards GS1."@fr;
                      rdfs:domain submit:ProductPassport;
                      rdfs:isDefinedBy submit:;
                      rdfs:label "GS1 Digital Link URI"@en,
                                 "URI GS1 Digital Link"@fr;
                      rdfs:range xsd:anyURI;
                      rdfs:seeAlso <https://www.gs1.org/standards/Digital-Link/>;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:hasCircularityScorecard a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Links a ProductPassport to its circularity scorecard. Aligned with UNTP DPP."@en,
                                            "Lie un ProductPassport à son tableau de bord de circularité. Aligné avec UNTP DPP."@fr;
                               rdfs:domain submit:ProductPassport;
                               rdfs:isDefinedBy submit:;
                               rdfs:label "has circularity scorecard"@en,
                                          "a pour tableau de bord circularité"@fr;
                               rdfs:range submit:CircularityPerformance;
                               rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:hasCompoundIdentifier a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Lie un ProductPassport à un Identifiant Composé (GTIN + variant/lot/série)."@fr,
                                          "Links a ProductPassport to a CompoundIdentifier (GTIN + variant/batch/serial)."@en;
                             rdfs:domain submit:ProductPassport;
                             rdfs:label "a pour identifiant composé"@fr,
                                        "has compound identifier"@en;
                             rdfs:range submit:CompoundIdentifier.
submit:hasConformityClaim a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Lie un ProductPassport à une déclaration de conformité. Aligné avec UNTP DPP."@fr,
                                       "Links a ProductPassport to a conformity claim. Aligned with UNTP DPP."@en;
                          rdfs:domain submit:ProductPassport;
                          rdfs:isDefinedBy submit:;
                          rdfs:label "has conformity claim"@en,
                                     "a pour déclaration de conformité"@fr;
                          rdfs:range submit:ConformityClaim;
                          rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:hasConstituentProduct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Link to a DPP of a constituent product in the value chain. Enables multi-level traceability."@en,
                                          "Lien vers un DPP de produit constituant dans la chaîne de valeur. Permet la traçabilité multi-niveau."@fr;
                             rdfs:domain submit:ProductPassport;
                             rdfs:isDefinedBy submit:;
                             rdfs:label "a pour produit constituant"@fr,
                                        "has constituent product"@en;
                             rdfs:range submit:ProductPassport;
                             rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:hasConsumer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Lie un ProductPassport à son Consommateur."@fr,
                                "Links a ProductPassport to its Consumer."@en;
                   rdfs:domain submit:ProductPassport;
                   rdfs:label "a pour consommateur"@fr,
                              "has consumer"@en;
                   rdfs:range submit:Consumer.
submit:hasCurrentStatus a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Lie un ProductPassport à son ProductStatus actuel."@fr,
                                     "Links a ProductPassport to its current ProductStatus."@en;
                        rdfs:domain submit:ProductPassport;
                        rdfs:label "a pour statut actuel"@fr,
                                   "has current status"@en;
                        rdfs:range submit:ProductStatus.
submit:hasDiagnostic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Lie une Intervention à un Diagnostic."@fr,
                                  "Links an Intervention to a Diagnostic."@en;
                     rdfs:domain submit:Intervention;
                     rdfs:label "a pour diagnostic"@fr,
                                "has diagnostic"@en;
                     rdfs:range submit:Diagnostic.
submit:hasDocument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Lie un ProductPassport à un Document."@fr,
                                "Links a ProductPassport to a Document."@en;
                   rdfs:domain submit:ProductPassport;
                   rdfs:label "a pour document"@fr,
                              "has document"@en;
                   rdfs:range submit:Document.
submit:hasEconomicOperator a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Lie un ProductPassport à son Opérateur Économique (fabricant, importateur, distributeur, etc.)."@fr,
                                        "Links a ProductPassport to its EconomicOperator (manufacturer, importer, distributor, etc.)."@en;
                           rdfs:domain submit:ProductPassport;
                           rdfs:label "a pour opérateur économique"@fr,
                                      "has economic operator"@en;
                           rdfs:range submit:EconomicOperator.
submit:hasEmissionsScorecard a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Links a ProductPassport to its emissions scorecard. Aligned with UNTP DPP."@en,
                                          "Lie un ProductPassport à son tableau de bord d'émissions. Aligné avec UNTP DPP."@fr;
                             rdfs:domain submit:ProductPassport;
                             rdfs:isDefinedBy submit:;
                             rdfs:label "a pour tableau de bord émissions"@fr,
                                        "has emissions scorecard"@en;
                             rdfs:range submit:EmissionsPerformance;
                             rdfs:seeAlso <https://untp.unece.org/docs/specification/DigitalProductPassport/>;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
submit:hasFacility a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Lie un ProductPassport à l'Installation où il a été produit."@fr,
                                "Links a ProductPassport to the Facility where it was produced."@en;
                   rdfs:domain submit:ProductPassport;
                   rdfs:label "a pour installation"@fr,
                              "has facility"@en;
                   rdfs:range submit:Facility.
submit:hasGln a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Le Code Lieu International GS1 identifiant l'organisation ou l'installation. Utilisé pour les opérateurs économiques et installations selon la réglementation européenne ESPR."@fr,
                           "The GS1 Global Location Number identifying the organization or facility. Used for economic operators and facilities per EU ESPR regulation."@en;
              rdfs:domain submit:Facility,
                          <https://schema.org/Organization>,
                          submit:EconomicOperator,
                          <https://schema.org/Place>;
