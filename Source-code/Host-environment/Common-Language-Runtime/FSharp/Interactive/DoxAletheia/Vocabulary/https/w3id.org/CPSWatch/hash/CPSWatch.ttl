@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix qudt: <http://qudt.org/schema/qudt/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos08: <http://www.w3.org/2008/05/skos#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix sosa: <http://www.w3.org/ns/sosa/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix CPSWatch: <https://w3id.org/CPSWatch#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix schemas: <https://schema.org/>.

dc11:description a owl:AnnotationProperty.
dc11:publisher a owl:ObjectProperty;
               rdfs:comment "An entity responsible for making the resource available."@en;
               rdfs:isDefinedBy dc11:;
               rdfs:label "publisher"@en.
dc11:title a owl:AnnotationProperty.
dcterms:abstract a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:publisher a owl:AnnotationProperty.
bibo:status a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
qudt:Unit a owl:Class;
          rdfs:comment "A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). Any measurement of the length can be expressed as a number multiplied by the unit meter. More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  \\\\\\\\(Q = nU\\\\\\\\). ";
          rdfs:label "Unit".
owl:cardinality a owl:AnnotationProperty.
skos08:prefLabel a owl:AnnotationProperty;
                 rdfs:subPropertyOf rdfs:label.
org:memberOf a owl:AnnotationProperty.
sosa:ObservableProperty a owl:Class.
sosa:hasSimpleResult a owl:DatatypeProperty;
                     rdfs:comment "The value of the observations of a CPSWatch#ContinuousMonitoringSensor or CPSWatch#EventMonitoringSensor monitoring sensor are made in.";
                     rdfs:domain CPSWatch:NumericObservation;
                     rdfs:label "hasSimpleResult";
                     owl:cardinality "1"^^xsd:nonNegativeInteger.
sosa:madeBySensor a owl:ObjectProperty;
                  rdfs:comment "Connection between a CPSWatch#Observation and a CPSWatch#MonitoringSensor. "@en;
                  rdfs:domain CPSWatch:Observation;
                  rdfs:label "madeBySensor"@en;
                  rdfs:range CPSWatch:MonitoringSensor.
sosa:observes a owl:ObjectProperty;
              rdfs:comment "Connection between a CPSWatch#MonitoringSensor and a sosa#ObservableProperty. "@en;
              rdfs:domain CPSWatch:MonitoringSensor;
              rdfs:label "observes"@en;
              rdfs:range sosa:ObservableProperty.
sosa:resultTime a owl:DatatypeProperty;
                rdfs:comment "The dateTime of the observations of a CPSWatch#ContinuousMonitoringSensor or CPSWatch#EventMonitoringSensor monitoring sensor.";
                rdfs:domain CPSWatch:Observation;
                rdfs:label "resultTime";
                owl:cardinality "1"^^xsd:nonNegativeInteger.
foaf:Organization a owl:Class.
foaf:homepage a owl:AnnotationProperty.
foaf:name a owl:AnnotationProperty.
<https://orcid.org/0009-0003-2548-8225> org:memberOf <https://www.hsu-hh.de/#this>;
                                        foaf:name "Björn Ludwig"@en.
schemas:image a owl:AnnotationProperty.
schemas:includedInDataCatalog a owl:AnnotationProperty.
schemas:logo a owl:AnnotationProperty.
w3id:CPSWatch dc11:description "This ontology defines a vocabulary for describing cyber physical systems for monitoring purpose. It contains two main concepts: CPSWatch#MonitoredSystem that is a top level description of a System that is modeled and CPSWatch#MonitoringSensor that is a top level description of a sensor used to monitor the CPSWatch#MonitoredSystem. "@en;
              dc11:title "The Cyber Physical System Watch Ontology"@en;
              dcterms:abstract "Manufacturers and users want to monitore their cyber physical systems. In the Industry 4.0 this is done by observing data from sensors. The problem arises when looking at a system of systems, e.g. a production plant or a whole powertrain of a vessel. Multiple systems describe their data in multiple ways and create the problem of analysing these data together in one system. To tackle this problem and to make transferability of algorithms (ML methods) between different monitoring systems possible, the CPSWatch Ontology is defined to create a top level description of a CPS system. "@en;
              dcterms:created "December 7th, 2023"@en;
              dcterms:creator <https://orcid.org/0009-0003-2548-8225>;
              dcterms:issued "December 7th, 2023"@en;
              dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
              dcterms:modified "December 7th, 2023"@en;
              dcterms:publisher "CPSWatch on Github"@en;
              bibo:status "CPSWatch (stable)"@en;
              vann:preferredNamespacePrefix "CPSWatch"@en;
              vann:preferredNamespaceUri "https://w3id.org/CPSWatch/1.0.1";
              a owl:Ontology;
              rdfs:comment "1.0.1 release of the CPSWatch Ontology"@en;
              owl:versionIRI <https://w3id.org/CPSWatch/1.0.1>;
              owl:versionInfo "1.0.1"@en;
              schemas:image <https://github.com/B-Ludwig/CPSWatch/blob/aa184a2003274995672a6dd3ca445b12a5286f52/assets/Logo.png>;
              schemas:logo <https://github.com/B-Ludwig/CPSWatch/blob/aa184a2003274995672a6dd3ca445b12a5286f52/assets/Logo.png>.
CPSWatch:Closed a owl:NamedIndividual,
                  CPSWatch:Status.
CPSWatch:ContinuousMonitoringSensor a owl:Class;
                                    rdfs:comment "A CPSWatch#ContinuousMonitoringSensor is a sensor that writes data with a fixed sample rate.";
                                    rdfs:label "ContinuousMonitoringSensor";
                                    rdfs:subClassOf [owl:onProperty CPSWatch:hasSampleRate ; 
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction],
                                                    CPSWatch:NumericMonitoringSensor.
CPSWatch:Critical a owl:NamedIndividual,
                    CPSWatch:Status.
CPSWatch:Error a owl:NamedIndividual,
                 CPSWatch:Status.
CPSWatch:EventMonitoringSensor a owl:Class;
                               rdfs:comment "A CPSWatch#EventMonitoringSensor is a sensor that writes data if a threshold is surpassed.";
                               rdfs:label "EventMonitoringSensor";
                               rdfs:subClassOf [owl:onProperty CPSWatch:hasDeviationThreshold ; 
                                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                a owl:Restriction],
                                               CPSWatch:NumericMonitoringSensor.
CPSWatch:MonitoredSystem a owl:Class;
                         rdfs:comment "A CPSWatch#MonitoredSystem is a system that is monitored by CPSWatch#MonitoringSensor.";
                         rdfs:label "MonitoredSystem";
                         rdfs:subClassOf [owl:onProperty CPSWatch:hasSystemID ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction].
CPSWatch:MonitoringSensor a owl:Class;
                          rdfs:comment "A CPSWatch#MonitoringSensor is a sensor used to monitor a CPSWatch#MonitoredSystem. It can be of type CPSWatch#ContinuousMonitoringSensor, CPSWatch#EventMonitoringSensor, CPSWatch#StatusMonitoringSensor.";
                          rdfs:label "MonitoringSensor";
                          rdfs:subClassOf [owl:onProperty CPSWatch:hasSensorID ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction].
CPSWatch:NumericMonitoringSensor a owl:Class;
                                 rdfs:comment "A CPSWatch#NumericMonitoringSensor is a sensor that writes numreric data.";
                                 rdfs:label "NumericMonitoringSensor";
                                 rdfs:subClassOf CPSWatch:MonitoringSensor.
CPSWatch:NumericObservation a owl:Class;
                            rdfs:comment "A CPSWatch#NumericObservation is an observation made by an CPSWatch#NumericMonitoringSensor.";
                            rdfs:label "NumericObservation ";
                            rdfs:subClassOf [owl:onProperty sosa:hasSimpleResult ; 
                                             owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             a owl:Restriction],
                                            CPSWatch:Observation.
CPSWatch:Observation a owl:Class;
                     rdfs:comment "A CPSWatch#Observation is the parent class of CPSWatch#NumericObservation and CPSWatch#StatusObservation that describe the observation made by a CPSWatch#ContinuousMonitoringSensor, CPSWatch#EventMonitoringSensor, or CPSWatch#StatusMonitoringSensor.";
                     rdfs:label "Observation";
                     rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty sosa:madeBySensor ; 
                                      owl:onClass CPSWatch:MonitoringSensor ; 
                                      a owl:Restriction],
                                     [owl:onProperty sosa:resultTime ; 
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                      a owl:Restriction].
CPSWatch:Off a owl:NamedIndividual,
               CPSWatch:Status.
CPSWatch:Ok a owl:NamedIndividual,
              CPSWatch:Status.
CPSWatch:On a owl:NamedIndividual,
              CPSWatch:Status.
CPSWatch:Open a owl:NamedIndividual,
                CPSWatch:Status.
CPSWatch:ShuttingDown a owl:NamedIndividual,
                        CPSWatch:Status.
CPSWatch:Starting a owl:NamedIndividual,
                    CPSWatch:Status.
CPSWatch:Status a owl:Class;
                rdfs:comment "The status values a CPSWatch#StatusMonitoringSensor can return.";
                rdfs:label "Status".
CPSWatch:StatusMonitoringSensor a owl:Class;
                                rdfs:comment "A CPSWatch#StatusMonitoringSensor is a sensor that can write specific states.";
                                rdfs:label "StatusMonitoringSensor";
                                rdfs:subClassOf CPSWatch:MonitoringSensor.
CPSWatch:StatusObservation a owl:Class;
                           rdfs:comment "A CPSWatch#StatusObservation is an observation made by an CPSWatch#StatusMonitoringSensor monitoring sensor.";
                           rdfs:label "StatusObservation ";
                           rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty CPSWatch:hasStatus ; 
                                            owl:onClass CPSWatch:Status ; 
                                            a owl:Restriction],
                                           CPSWatch:Observation.
CPSWatch:hasDeviationThreshold a owl:DatatypeProperty;
                               rdfs:comment "Deviation threshold of a CPSWatch:EventMonitoringSensor that needs to be exceeded to save the current value.";
                               rdfs:domain CPSWatch:EventMonitoringSensor;
                               rdfs:label "hasDeviationThreshold";
                               rdfs:range xsd:float;
                               owl:cardinality "1"^^xsd:nonNegativeInteger.
CPSWatch:hasInfluence a owl:ObjectProperty;
                      rdfs:comment "Connection between two CPSWatch:MonitoringSensor to state that the observations of these sensors are connected."@en;
                      rdfs:domain CPSWatch:MonitoringSensor;
                      rdfs:label "hasInfluence"@en;
                      rdfs:range CPSWatch:MonitoringSensor.
CPSWatch:hasMonitoringSensor a owl:ObjectProperty;
                             rdfs:comment "Connection from a CPSWatch:MonitoredSystem to a CPSWatch#MonitoringSensor"@en;
                             rdfs:domain CPSWatch:MonitoredSystem;
                             rdfs:label "hasMonitoringSensor"@en;
                             rdfs:range CPSWatch:MonitoringSensor.
CPSWatch:hasNegativeCorrelation a owl:ObjectProperty;
                                rdfs:comment "Connection between two CPSWatch:MonitoringSensor to state that the observations of these sensors are with a negative correlation."@en;
                                rdfs:domain CPSWatch:MonitoringSensor;
                                rdfs:label "hasNegativeCorrelation"@en;
                                rdfs:range CPSWatch:MonitoringSensor;
                                rdfs:subPropertyOf CPSWatch:hasInfluence.
CPSWatch:hasPositiveCorrelation a owl:ObjectProperty;
                                rdfs:comment "Connection between two CPSWatch:MonitoringSensor to state that the observations of these sensors are with a positive correlation."@en;
                                rdfs:domain CPSWatch:MonitoringSensor;
                                rdfs:label "hasPositiveCorrelation"@en;
                                rdfs:range CPSWatch:MonitoringSensor;
                                rdfs:subPropertyOf CPSWatch:hasInfluence.
CPSWatch:hasSampleRate a owl:DatatypeProperty;
                       rdfs:comment "Update rate in seconds (s) that the data is stored.";
                       rdfs:domain CPSWatch:ContinuousMonitoringSensor;
                       rdfs:label "hasSampleRate";
                       rdfs:range xsd:float;
                       owl:cardinality "1"^^xsd:nonNegativeInteger.
CPSWatch:hasSensorID a owl:DatatypeProperty;
                     rdfs:comment "The unique ID of a CPSWatch#MonitoringSensor."@en;
                     rdfs:domain CPSWatch:MonitoringSensor;
                     rdfs:label "hasID"@en;
                     rdfs:range xsd:unsignedInt.
CPSWatch:hasStates a owl:ObjectProperty;
                   rdfs:comment "The possible states that a CPSWatch#StatusMonitoringSensor can have.";
                   rdfs:domain CPSWatch:StatusMonitoringSensor;
                   rdfs:label "hasStates";
                   rdfs:range CPSWatch:Status.
CPSWatch:hasStatus a owl:ObjectProperty;
                   rdfs:comment "The Status of the observations of a CPSWatch#StatusMonitoringSensor.";
                   rdfs:domain CPSWatch:StatusObservation;
                   rdfs:label "hasStatus";
                   rdfs:range CPSWatch:Status;
                   owl:cardinality "1"^^xsd:nonNegativeInteger.
CPSWatch:hasSubSystem a owl:ObjectProperty;
                      rdfs:comment "Connection between two CPSWatch:MonitoredSystem to state that a CPSWatch:MonitoredSystem has a sub system."@en;
                      rdfs:domain CPSWatch:MonitoredSystem;
                      rdfs:label "hasSubSystem"@en;
                      rdfs:range CPSWatch:MonitoredSystem.
CPSWatch:hasSystemConnection a owl:ObjectProperty;
                             rdfs:comment "Connection between two CPSWatch:MonitoredSystem to state that system B is dependent on system A, e.g. CPSWatch:MonitoredSystem A hasSystemConnection CPSWatch:MonitoredSystem B."@en;
                             rdfs:domain CPSWatch:MonitoredSystem;
                             rdfs:label "hasSystemConnection"@en;
                             rdfs:range CPSWatch:MonitoredSystem;
                             rdfs:subPropertyOf CPSWatch:hasSystemConnection.
CPSWatch:hasSystemID a owl:DatatypeProperty;
                     rdfs:comment "The unique ID of a CPSWatch#MonitoredSystem."@en;
                     rdfs:domain CPSWatch:MonitoredSystem;
                     rdfs:label "hasID"@en;
                     rdfs:range xsd:unsignedInt.
CPSWatch:hasUnit a owl:ObjectProperty;
                 rdfs:comment "The unit the observations of a CPSWatch#ContinuousMonitoringSensor or CPSWatch#EventMonitoringSensor monitoring sensor are made in.";
                 rdfs:domain CPSWatch:NumericMonitoringSensor;
                 rdfs:label "hasUnit";
                 rdfs:range qudt:Unit;
                 owl:cardinality "1"^^xsd:nonNegativeInteger.
<https://www.hsu-hh.de/#this> a owl:NamedIndividual,
                                foaf:Organization;
                              foaf:homepage "https://www.hsu-hh.de/en/";
                              foaf:name "Helmut Schmidt University".
