                 rdfs:isDefinedBy "https://w3id.org/tribont";
                 rdfs:label "performs";
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:tests a <http://www.w3.org/2002/07/owl#ObjectProperty>;
