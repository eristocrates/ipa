tribont:executes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relationship between an equipment and the activity it carries out.";
                 rdfs:isDefinedBy "https://w3id.org/tribont";
                 rdfs:label "executes";
                 <http://www.w3.org/2002/07/owl#inverseOf> tribont:isExecutedBy;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:hasAfterEndDependency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Relation between an activity and the one preceeding it.";
                              rdfs:isDefinedBy "https://w3id.org/tribont";
                              rdfs:label "hasAfterEndDependency";
                              rdfs:subPropertyOf tribont:hasDependency;
                              <http://www.w3.org/2002/07/owl#equivalentProperty> tribont:isNext;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:hasDependency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Identifies the dependency between two activities.";
                      rdfs:isDefinedBy "https://w3id.org/tribont";
                      rdfs:label "hasDependency";
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:hasNofollowDependency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Indicates that an activity has not a following dependency.";
                              rdfs:isDefinedBy "https://w3id.org/tribont";
                              rdfs:label "hasNofollowDependency";
                              rdfs:subPropertyOf tribont:hasDependency;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:isExecutedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relationship between an activity and the equipment that executes it.";
                     rdfs:isDefinedBy "https://w3id.org/tribont";
                     rdfs:label "isExecutedBy";
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:isNext a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relationship between an activity and the one preceding it.";
               rdfs:isDefinedBy "https://w3id.org/tribont";
               rdfs:label "isNext";
               <http://www.w3.org/2002/07/owl#inverseOf> tribont:isPrevious;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:isPerformedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relationship between an activity and the person who performs it.";
                      rdfs:isDefinedBy "https://w3id.org/tribont";
                      rdfs:label "isPerformedBy";
                      <http://www.w3.org/2002/07/owl#inverseOf> tribont:performs;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:isPrevious a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relationship between an activity and the one following it.";
                   rdfs:isDefinedBy "https://w3id.org/tribont";
                   rdfs:label "isPrevious";
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:isTestedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relationship between a sample body or sample system and the testing activity testing it.";
                   rdfs:isDefinedBy "https://w3id.org/tribont";
                   rdfs:label "isTestedBy";
                   <http://www.w3.org/2002/07/owl#inverseOf> tribont:tests;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont:performs a <http://www.w3.org/2002/07/owl#ObjectProperty>;
