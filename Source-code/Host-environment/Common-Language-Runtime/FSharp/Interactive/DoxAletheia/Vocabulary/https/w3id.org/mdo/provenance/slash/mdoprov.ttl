@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix mdoprov: <https://w3id.org/mdo/provenance/>.

<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
xsd:date a rdfs:Datatype,
           <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/prov#Agent> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#SoftwareAgent> a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                           <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> mdoprov:SoftwareName ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          <http://www.w3.org/ns/prov#Agent>.
<http://www.w3.org/ns/prov#wasAssociatedWith> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/ns/prov#wasAttributedTo> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/mdo/core/Calculation> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/ns/prov#SoftwareAgent> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAssociatedWith> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>].
<https://w3id.org/mdo/core/Property> rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> mdoprov:ReferenceAgent ; 
                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAttributedTo> ; 
                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                      [<http://www.w3.org/2002/07/owl#onClass> mdoprov:ReferenceAgent ; 
                                                                                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAttributedTo> ; 
                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                      a <http://www.w3.org/2002/07/owl#Class>].
<https://w3id.org/mdo/core/Structure> rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> mdoprov:ReferenceAgent ; 
                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAttributedTo> ; 
                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                       [<http://www.w3.org/2002/07/owl#onClass> mdoprov:ReferenceAgent ; 
                                                                                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAttributedTo> ; 
                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                       a <http://www.w3.org/2002/07/owl#Class>].
mdoprov: <http://purl.org/dc/terms/contributor> "Patrick Lambrix",
                                                "Rickard Armiento";
         <http://purl.org/dc/terms/created> "2020-04-02";
         <http://purl.org/dc/terms/creator> "Huanyu Li";
         <http://purl.org/dc/terms/license> "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE";
         <http://purl.org/dc/terms/title> "Materials Design Ontology - Provenance Module"@en;
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "provenance";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/mdo/provenance/1.0/";
         a <http://www.w3.org/2002/07/owl#Ontology>;
         rdfs:comment "This is the provenance module of Materials Design Ontology."@en;
         rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology";
         <http://www.w3.org/2002/07/owl#imports> <https://w3id.org/mdo/core/1.0/>;
         <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/mdo/provenance/1.0/>;
         <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mdoprov:AuthorName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "AuthorName represents that a reference agent has the author's name in a string."@en;
                   rdfs:domain mdoprov:ReferenceAgent;
                   rdfs:label "author name"@en;
                   rdfs:range xsd:string.
mdoprov:DOI a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "DOI represents that a reference agent has the DOI in a string."@en;
            rdfs:domain mdoprov:ReferenceAgent;
            rdfs:label "DOI"@en;
            rdfs:range xsd:string.
mdoprov:DatabaseName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "DatabaseName represents that a reference agent has the database's name in a string."@en;
                     rdfs:domain mdoprov:ReferenceAgent;
                     rdfs:label "database name"@en;
                     rdfs:range xsd:string.
mdoprov:PublicationDateTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "PublicationDateTime represents that a reference agent has the date time in a dateTime."@en;
                            rdfs:domain mdoprov:ReferenceAgent;
                            rdfs:label "publication dateTime"@en;
                            rdfs:range xsd:dateTime.
mdoprov:PublicationTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "PublicationTitle represents that a reference agent has the publication's title in a string."@en;
                         rdfs:domain mdoprov:ReferenceAgent;
                         rdfs:label "publication title"@en;
                         rdfs:range xsd:string.
mdoprov:ReferenceAgent a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A reference agent is the representation of the reference that the structure or property refer to."@en;
                       rdfs:label "Reference Agent"@en;
                       rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>.
mdoprov:SoftwareName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "SoftwareName represents that a software agent has the name in a string."@en;
                     rdfs:domain <http://www.w3.org/ns/prov#SoftwareAgent>;
                     rdfs:label "software name"@en;
                     rdfs:range xsd:string.
mdoprov:URL a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "URL represents that a reference agent has the URL in a string."@en;
            rdfs:domain mdoprov:ReferenceAgent;
            rdfs:label "URL"@en;
            rdfs:range xsd:string.
