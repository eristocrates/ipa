@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix core: <https://w3id.org/mdo/core/>.
@prefix mdoprov: <https://w3id.org/mdo/provenance/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
xsd:date a rdfs:Datatype,
           owl:AnnotationProperty.
nsprov:Agent a owl:Class.
nsprov:SoftwareAgent a owl:Class;
                     rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty mdoprov:SoftwareName ; 
                                      a owl:Restriction],
                                     nsprov:Agent.
nsprov:wasAssociatedWith a owl:ObjectProperty.
nsprov:wasAttributedTo a owl:ObjectProperty.
core:Calculation a owl:Class;
                 rdfs:subClassOf [owl:someValuesFrom nsprov:SoftwareAgent ; 
                                  owl:onProperty nsprov:wasAssociatedWith ; 
                                  a owl:Restriction].
core:Property rdfs:subClassOf [owl:intersectionOf ([owl:allValuesFrom mdoprov:ReferenceAgent ; 
                                                   owl:onProperty nsprov:wasAttributedTo ; 
                                                   a owl:Restriction]
                                                   [owl:onClass mdoprov:ReferenceAgent ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty nsprov:wasAttributedTo ; 
                                                   a owl:Restriction]) ; 
                               a owl:Class].
core:Structure rdfs:subClassOf [owl:intersectionOf ([owl:allValuesFrom mdoprov:ReferenceAgent ; 
                                                    owl:onProperty nsprov:wasAttributedTo ; 
                                                    a owl:Restriction]
                                                    [owl:onClass mdoprov:ReferenceAgent ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty nsprov:wasAttributedTo ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class].
mdoprov: dcterms:contributor "Patrick Lambrix",
                             "Rickard Armiento";
         dcterms:created "2020-04-02";
         dcterms:creator "Huanyu Li";
         dcterms:license "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE";
         dcterms:title "Materials Design Ontology - Provenance Module"@en;
         vann:preferredNamespacePrefix "provenance";
         vann:preferredNamespaceUri "https://w3id.org/mdo/provenance/1.0/";
         a owl:Ontology;
         rdfs:comment "This is the provenance module of Materials Design Ontology."@en;
         rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology";
         owl:imports <https://w3id.org/mdo/core/1.0/>;
         owl:versionIRI <https://w3id.org/mdo/provenance/1.0/>;
         owl:versionInfo "1.0".
mdoprov:AuthorName a owl:DatatypeProperty;
                   rdfs:comment "AuthorName represents that a reference agent has the author's name in a string."@en;
                   rdfs:domain mdoprov:ReferenceAgent;
                   rdfs:label "author name"@en;
                   rdfs:range xsd:string.
mdoprov:DOI a owl:DatatypeProperty;
            rdfs:comment "DOI represents that a reference agent has the DOI in a string."@en;
            rdfs:domain mdoprov:ReferenceAgent;
            rdfs:label "DOI"@en;
            rdfs:range xsd:string.
mdoprov:DatabaseName a owl:DatatypeProperty;
                     rdfs:comment "DatabaseName represents that a reference agent has the database's name in a string."@en;
                     rdfs:domain mdoprov:ReferenceAgent;
                     rdfs:label "database name"@en;
                     rdfs:range xsd:string.
mdoprov:PublicationDateTime a owl:DatatypeProperty;
                            rdfs:comment "PublicationDateTime represents that a reference agent has the date time in a dateTime."@en;
                            rdfs:domain mdoprov:ReferenceAgent;
                            rdfs:label "publication dateTime"@en;
                            rdfs:range xsd:dateTime.
mdoprov:PublicationTitle a owl:DatatypeProperty;
                         rdfs:comment "PublicationTitle represents that a reference agent has the publication's title in a string."@en;
                         rdfs:domain mdoprov:ReferenceAgent;
                         rdfs:label "publication title"@en;
                         rdfs:range xsd:string.
mdoprov:ReferenceAgent a owl:Class;
                       rdfs:comment "A reference agent is the representation of the reference that the structure or property refer to."@en;
                       rdfs:label "Reference Agent"@en;
                       rdfs:subClassOf nsprov:Agent.
mdoprov:SoftwareName a owl:DatatypeProperty;
                     rdfs:comment "SoftwareName represents that a software agent has the name in a string."@en;
                     rdfs:domain nsprov:SoftwareAgent;
                     rdfs:label "software name"@en;
                     rdfs:range xsd:string.
mdoprov:URL a owl:DatatypeProperty;
            rdfs:comment "URL represents that a reference agent has the URL in a string."@en;
            rdfs:domain mdoprov:ReferenceAgent;
            rdfs:label "URL"@en;
            rdfs:range xsd:string.
