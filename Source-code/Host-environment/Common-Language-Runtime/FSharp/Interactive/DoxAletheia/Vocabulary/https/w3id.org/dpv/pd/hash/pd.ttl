                                       skos:prefLabel "Age Exact"@en;
                                       dpv:isSubTypeOf <https://w3id.org/dpv/dpv-pd#AgeRange>.
<https://w3id.org/dpv/dpv-pd#AgeRange> dcterms:created "2022-04-20"^^xsd:date;
