mdo-struc:AngleTriple a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A angle triple is a vector of three angles which represent the angles among three bases in a cell."@en;
                      rdfs:label "Angle Triple"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Angle_gamma ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Angle_beta ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Angle_alpha ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
mdo-struc:Angle_alpha a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Angle_alpha represents that an angle triple has the alpha angle's value in a double."@en;
                      rdfs:domain mdo-struc:AngleTriple;
                      rdfs:label "Angle_alpha"@en;
                      rdfs:range xsd:double.
mdo-struc:Angle_beta a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Angle_beta represents that an angle triple has the beta angle's value in a double."@en;
                     rdfs:domain mdo-struc:AngleTriple;
                     rdfs:label "Angle_beta"@en;
                     rdfs:range xsd:double.
mdo-struc:Angle_gamma a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Angle_gamma represents that an angle triple has the gamma angle's value in a double."@en;
                      rdfs:domain mdo-struc:AngleTriple;
                      rdfs:label "Angle_gamma"@en;
                      rdfs:range xsd:double.
mdo-struc:AnonymousFormula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "AnonymousFormula represents that a composition has the anonymous formula in a string."@en;
                           rdfs:domain mdo-struc:Composition;
                           rdfs:label "anonymous formula"@en;
                           rdfs:range xsd:string.
mdo-struc:AxisVectors a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An axis-vectors is the three vectors which represent the bases of cell."@en;
                      rdfs:label "Axis Vectors"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#onClass> mdo-struc:CoordinateVector ; 
                                                                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:has_a_axisVector ; 
                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                       [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:CoordinateVector ; 
                                                                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:has_b_axisVector ; 
                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                       [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:CoordinateVector ; 
                                                                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                       <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:has_c_axisVector ; 
                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:Basis a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A basis defines a spatial unit used to express fractional coordinates."@en;
                rdfs:label "Basis"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#onClass> mdo-struc:AngleTriple ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasAngleVector ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                          [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:LengthTriple ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasLengthVector ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                          a <http://www.w3.org/2002/07/owl#Class>]
                                                                          [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:AxisVectors ; 
                                                                          <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasAxisVectors ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:Composition a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A composition is used to represent what chemical elements composing a structure and the ratio of the chemical elements."@en;
                      rdfs:label "Composition"@en.
mdo-struc:CoordinateVector a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A coordinate vector is the coordinates of a point in space."@en;
                           rdfs:label "Coordinate Vector"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Z_axisCoordinate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Y_axisCoordinate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:X_axisCoordinate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>].
mdo-struc:DescriptiveFormula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "DescriptiveFormula represents that a composition has the descriptive formula in a string."@en;
                             rdfs:domain mdo-struc:Composition;
                             rdfs:label "descriptive formula"@en;
                             rdfs:range xsd:string.
mdo-struc:ElementRatio a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "ElementRatio represents that a species has the ratio in a double."@en;
                       rdfs:domain mdo-struc:Species;
                       rdfs:label "element ratio"@en;
                       rdfs:range xsd:double.
mdo-struc:HillFormula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "HillFormula represents that a composition has the hill formula in a string."@en;
                      rdfs:domain mdo-struc:Composition;
                      rdfs:label "hill formula"@en;
                      rdfs:range xsd:string.
mdo-struc:Lattice a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A lattice defines a peroidic arrangement of one or more atoms."@en;
                  rdfs:label "Lattice"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#onClass> mdo-struc:AngleTriple ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasAngleVector ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                            [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:LengthTriple ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasLengthVector ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>]
                                                                            [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:AxisVectors ; 
                                                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                            <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasAxisVectors ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:LatticeType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "LatticeType represents that a lattice has the type in a string."@en;
                      rdfs:domain mdo-struc:Lattice;
                      rdfs:label "lattice type"@en;
                      rdfs:range xsd:string.
mdo-struc:LatticeVolume a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "LatticeVolume represents that a lattice has the volume in a double."@en;
                        rdfs:domain mdo-struc:Lattice;
                        rdfs:label "lattice volume"@en;
                        rdfs:range xsd:double.
mdo-struc:LengthTriple a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A length triple defines the three parameters (a, b, c) that represent the lengths in three axes respectively."@en;
                       rdfs:label "Length Triple"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                        <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Length_c ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                        <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Length_b ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onDataRange> xsd:double ; 
                                        <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:Length_a ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>].
mdo-struc:Length_a a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Length_a represents that a length triple has the 'a' value in a double."@en;
                   rdfs:domain mdo-struc:LengthTriple;
                   rdfs:label "Length_a"@en;
                   rdfs:range xsd:double.
mdo-struc:Length_b a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Length_b represents that a length triple has the 'b' value in a double."@en;
                   rdfs:domain mdo-struc:LengthTriple;
                   rdfs:label "Length_b"@en;
                   rdfs:range xsd:double.
mdo-struc:Length_c a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Length_c represents that a length triple has the 'c' value in a double."@en;
                   rdfs:domain mdo-struc:LengthTriple;
                   rdfs:label "Length_c"@en;
                   rdfs:range xsd:double.
mdo-struc:Occupancy a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An occupancy ties a specific species to a site."@en;
                    rdfs:label "Occupancy"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> mdo-struc:Species ; 
                                                                                     <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasSpecies ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#allValuesFrom> mdo-struc:Species ; 
                                                                                     <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasSpecies ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>],
                                    [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> mdo-struc:Site ; 
                                                                                     <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasSite ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#allValuesFrom> mdo-struc:Site ; 
                                                                                     <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasSite ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:PointGroup a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A group of linear mappings of vector space, which is corresonpond to the group of motions in point space determining the symmetry of the macroscopic crystal, is called the point group of the crystal, furthermore of the crystal structure, and is also called the point group of its space group."@en;
                     rdfs:label "Point Group"@en;
                     rdfs:seeAlso "International Tables for Crystallography, Volume A, Fourth, revised edition, Section 8.1.5."@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:PointGroupHMName ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>].
mdo-struc:PointGroupHMName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "PointGroupHMName represents that a point group has the Hermann-Mauguin in a string."@en;
                           rdfs:domain mdo-struc:PointGroup;
                           rdfs:label "point group Hermann-Mauguin name"@en;
                           rdfs:range xsd:string.
mdo-struc:ReducedFormula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "ReducedFormula represents that a composition has the reduced formula in a string."@en;
                         rdfs:domain mdo-struc:Composition;
                         rdfs:label "reduced formula"@en;
                         rdfs:range xsd:string.
mdo-struc:Site a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A site is a point in a lattice."@en;
               rdfs:label "Site"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> mdo-struc:CoordinateVector ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasFractionalCoordinates ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:CoordinateVector ; 
                                                                                <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasFractionalCoordinates ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>],
                               [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> mdo-struc:CoordinateVector ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasCartesianCoordinates ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#onClass> mdo-struc:CoordinateVector ; 
                                                                                <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasCartesianCoordinates ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:SpaceGroup a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A space group is the symmetry group of a three-dimensional crystal pattern is called its space group."@en;
                     rdfs:label "Space Group"@en;
                     rdfs:seeAlso "International Tables for Crystallography, Volume !, Fourth, revised edition, Section 8.1.5."@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:SpaceGroupSymbol ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onDataRange> xsd:integer ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:SpaceGroupID ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> mdo-struc:PointGroup ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasPointGroup ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> mdo-struc:PointGroup ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasPointGroup ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>].
mdo-struc:SpaceGroupID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "SpaceGroupID represents that a space group has the unique ID in an integer."@en;
                       rdfs:domain mdo-struc:SpaceGroup;
                       rdfs:label "space group ID"@en;
                       rdfs:range xsd:integer.
mdo-struc:SpaceGroupSymbol a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "SpaceGroupSymbol represents that a space group has the symbol in a string."@en;
                           rdfs:domain mdo-struc:SpaceGroup;
                           rdfs:label "space group symbol"@en;
                           rdfs:range xsd:string.
mdo-struc:Species a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A species is the combination of atoms on each site."@en;
                  rdfs:label "Species"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> <http://purl.obolibrary.org/obo/CHEBI_33250> ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> mdo-struc:hasElement ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>].
mdo-struc:X_axisCoordinate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "X_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in X axis."@en;
                           rdfs:domain mdo-struc:CoordinateVector;
                           rdfs:label "X_axis coordinate"@en;
                           rdfs:range xsd:double.
mdo-struc:Y_axisCoordinate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Y_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in Y axis."@en;
                           rdfs:domain mdo-struc:CoordinateVector;
                           rdfs:label "Y_axis coordinate"@en;
                           rdfs:range xsd:double.
mdo-struc:Z_axisCoordinate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Z_axisCoordinate represents that a coordinate vector has the value of a coordinate in a double in Z axis."@en;
                           rdfs:domain mdo-struc:CoordinateVector;
                           rdfs:label "Z_axis coordinate"@en;
                           rdfs:range xsd:double.
mdo-struc:hasAngleVector a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "hasAngleVector represents the relationship between a basis or a lattice and an angle triple it has."@en;
                         rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (mdo-struc:Basis
                                                                               mdo-struc:Lattice) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                         rdfs:label "has angle vector"@en;
                         rdfs:range mdo-struc:AngleTriple.
mdo-struc:hasAxisVectors a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "hasAxisVectors represents the relationship between a basis or a lattice and a axis-vectors it has."@en;
                         rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (mdo-struc:Basis
                                                                               mdo-struc:Lattice) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                         rdfs:label "has axis vectors"@en;
                         rdfs:range mdo-struc:AxisVectors.
mdo-struc:hasBasis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "hasBasis represents the relationship between a structure and the bases it has."@en;
                   rdfs:domain <https://w3id.org/mdo/core/Structure>;
                   rdfs:label "has basis"@en;
                   rdfs:range mdo-struc:Basis.
mdo-struc:hasCartesianCoordinates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "hasCartesianCoordinates represents the relationship between a site and coordinates in cartesian format it has."@en;
                                  rdfs:domain mdo-struc:Site;
                                  rdfs:label "has cartesian coordinates"@en;
                                  rdfs:range mdo-struc:CoordinateVector.
mdo-struc:hasComposition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "hasComposition represents the relationship between a structure and a a composition it has."@en;
                         rdfs:domain <https://w3id.org/mdo/core/Structure>;
                         rdfs:label "has composition"@en;
                         rdfs:range mdo-struc:Composition.
mdo-struc:hasElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "hasElement represents the relationship between a species and atoms it has."@en;
                     rdfs:domain mdo-struc:Species;
                     rdfs:label "has element"@en;
                     rdfs:range <http://purl.obolibrary.org/obo/CHEBI_33250>.
mdo-struc:hasFractionalCoordinates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "hasFractionalCoordinates represents the relationship between a site and coordinates in fractional format it has."@en;
                                   rdfs:domain mdo-struc:Site;
                                   rdfs:label "has fractional coordinates"@en;
                                   rdfs:range mdo-struc:CoordinateVector.
mdo-struc:hasLattice a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "hasLattice represents the relationship between a structure and lattices in it has."@en;
                     rdfs:domain <https://w3id.org/mdo/core/Structure>;
                     rdfs:label "has lattice"@en;
                     rdfs:range mdo-struc:Lattice.
mdo-struc:hasLengthVector a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "hasLengthVector represents the relationship between a basis or a lattice and a length triple it has."@en;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (mdo-struc:Basis
                                                                                mdo-struc:Lattice) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:label "has length vector"@en;
                          rdfs:range mdo-struc:LengthTriple.
mdo-struc:hasOccupancy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "hasOccupancy represents the relationship between a structure and occupancies it has."@en;
                       rdfs:domain <https://w3id.org/mdo/core/Structure>;
                       rdfs:label "has occupancy"@en;
                       rdfs:range mdo-struc:Occupancy.
mdo-struc:hasPointGroup a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "hasPointGroup represents the relationship between a space group and point groups it corresponds to."@en;
                        rdfs:domain mdo-struc:SpaceGroup;
                        rdfs:label "has point group"@en;
                        rdfs:range mdo-struc:PointGroup.
mdo-struc:hasSite a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "hasSite represents the relationship between an occupancy and sites it ties."@en;
                  rdfs:domain mdo-struc:Occupancy;
                  rdfs:label "has site"@en;
                  rdfs:range mdo-struc:Site.
mdo-struc:hasSpaceGroup a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "hasSpaceGroup represents the relationship between a structure and a space group it corresponds to."@en;
                        rdfs:domain <https://w3id.org/mdo/core/Structure>;
                        rdfs:label "has space group"@en;
                        rdfs:range mdo-struc:SpaceGroup.
mdo-struc:hasSpecies a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "hasSpecies represents the relationship between an occupancy and species it ties."@en;
                     rdfs:domain mdo-struc:Occupancy;
                     rdfs:label "has species"@en;
                     rdfs:range mdo-struc:Species.
mdo-struc:has_a_axisVector a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "has_a_axisVector represents the relationship between an axis-vectors and a coordinate vector to define the coordiantes of the translation vector (a)."@en;
                           rdfs:domain mdo-struc:AxisVectors;
