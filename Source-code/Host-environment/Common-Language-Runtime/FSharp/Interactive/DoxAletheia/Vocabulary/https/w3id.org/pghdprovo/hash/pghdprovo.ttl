@prefix saref: <https://saref.etsi.org/core/>.
@prefix s4wear: <https://saref.etsi.org/saref4wear/>.
@prefix w3id: <https://w3id.org/>.
@prefix modp: <https://w3id.org/mod#>.
@prefix pghdprovo: <https://w3id.org/pghdprovo#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix vcard2006: <http://www.w3.org/2006/vcard/ns#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

_:B6c49835e7c2a36ad3a0c946e637d5d46 a owl:AllDisjointClasses;
                                    owl:members (saref:Device
                                                 pghdprovo:Application
                                                 pghdprovo:ContextualInfo
                                                 pghdprovo:PGHD).
_:B962990c636149aae48d3124b0e745c4a a owl:AllDisjointClasses;
                                    owl:members (pghdprovo:Patient
                                                 pghdprovo:PatientRelative
                                                 pghdprovo:Practitioner).
_:Bb41bc280bae10bcc62363eeeede8e07c a owl:Axiom;
                                    rdfs:comment "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence.";
                                    owl:annotatedProperty rdfs:subPropertyOf;
                                    owl:annotatedSource nsprov:wasDerivedFrom;
                                    owl:annotatedTarget nsprov:wasInfluencedBy.
_:Bbf0b686d84a799f887eb51de8966c54f a owl:AllDisjointClasses;
                                    owl:members (nsprov:Organization
                                                 nsprov:Person
                                                 nsprov:SoftwareAgent).
_:Bc0faba6edf785bf16273da1ee8085783 a owl:Axiom;
                                    rdfs:comment "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.";
                                    owl:annotatedProperty rdfs:subPropertyOf;
                                    owl:annotatedSource nsprov:wasAttributedTo;
                                    owl:annotatedTarget nsprov:wasInfluencedBy;
                                    nsprov:definition "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. ".
_:Bc9a0d58f6c4f53a7558d9d3c20e0f56f a owl:AllDisjointClasses;
                                    owl:members (pghdprovo:Programme
                                                 pghdprovo:Protocol
                                                 pghdprovo:Rating
                                                 pghdprovo:State).
dc11:identifier a owl:DatatypeProperty;
                rdfs:comment "Recommended practice is to identify the resource by means of a string conforming to an identification system.";
                rdfs:domain owl:Thing;
                rdfs:label "Identifier";
                rdfs:range rdfs:Literal;
                nsprov:definition "An unambiguous reference to the resource within a given context.".
dcterms:bibliographicCitation a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:publisher a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
bibo:status a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
xsd:date a rdfs:Datatype.
owl:versionInfo a owl:AnnotationProperty.
status:term_status a owl:AnnotationProperty.
vcard2006:hasAddress a owl:DatatypeProperty;
                     rdfs:comment "To specify the components of the delivery address for the vCard object."@en;
                     rdfs:domain owl:Thing;
                     rdfs:label "has address"@en;
                     rdfs:range rdfs:Literal;
                     rdfs:subPropertyOf owl:topDataProperty.
vcard2006:hasEmail a owl:DatatypeProperty;
                   rdfs:comment "To specify the electronic mail address for communication with the object";
                   rdfs:domain owl:Thing;
                   rdfs:label "has email";
                   rdfs:range rdfs:Literal.
vcard2006:hasRole a owl:DatatypeProperty;
                  rdfs:comment "To specify the function or part played in a particular situation by an individual."@en;
                  rdfs:domain owl:Thing;
                  rdfs:label "has role"@en;
                  rdfs:range rdfs:Literal.
vcard2006:hasTelephone a owl:DatatypeProperty;
                       rdfs:comment "To specify the telephone number for telephony communication with the object."@en;
                       rdfs:domain owl:Thing;
                       rdfs:label "has telephone"@en;
                       rdfs:range rdfs:Literal;
                       rdfs:subPropertyOf owl:topDataProperty.
nsprov:Activity a owl:Class;
                rdfs:comment "An action or process that occurs over a period of time and acts upon entities."@en;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                rdfs:label "Activity";
                owl:disjointWith nsprov:Entity;
                nsprov:category "starting-point";
                nsprov:component "entities-activities";
                nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                nsprov:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities.";
                nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity"^^xsd:anyURI;
                nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity"^^xsd:anyURI.
nsprov:Agent a owl:Class;
             rdfs:comment "Something that bears responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."@en;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "Agent";
             nsprov:category "starting-point";
             nsprov:component "agents-responsibility";
             nsprov:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en;
             nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
             nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI.
nsprov:Entity a owl:Class;
              rdfs:comment "A physical, digital, conceptual, or other kind of thing with some fixed aspects."@en;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "Entity";
              nsprov:category "starting-point";
              nsprov:component "entities-activities";
              nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
              nsprov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en;
              nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI;
              nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI.
nsprov:Organization a owl:Class;
                    rdfs:comment "A social or legal entity such as a company, institution, or association."@en;
                    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                    rdfs:label "Organization";
                    rdfs:subClassOf nsprov:Agent;
                    nsprov:category "expanded";
                    nsprov:component "agents-responsibility";
                    nsprov:definition "An organization is a social or legal institution such as a company, society, etc.";
                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
                    nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI.
nsprov:Person a owl:Class;
              rdfs:comment "Person agents are people."@en;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "Person";
              rdfs:subClassOf [owl:onProperty foaf:givenName ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty foaf:gender ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              nsprov:Agent,
                              [owl:onProperty foaf:birthday ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction];
              nsprov:category "expanded";
              nsprov:component "agents-responsibility";
              nsprov:definition "Person agents are people."@en;
              nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
              nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI.
nsprov:SoftwareAgent a owl:Class;
                     rdfs:comment "A running software system acting as an agent in provenance descriptions."@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "SoftwareAgent";
                     rdfs:subClassOf nsprov:Agent;
                     nsprov:category "expanded";
                     nsprov:component "agents-responsibility";
                     nsprov:definition "A software agent is running software."@en;
                     nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
                     nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI.
nsprov:actedOnBehalfOf a owl:ObjectProperty;
                       rdfs:comment "An object property to express the accountability of an agent towards another agent. The subordinate agent acted on behalf of the responsible agent in an actual activity. "@en;
                       rdfs:domain nsprov:Agent;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "actedOnBehalfOf";
                       rdfs:range nsprov:Agent;
                       rdfs:subPropertyOf nsprov:wasInfluencedBy;
                       owl:inverseOf pghdprovo:hadDelegate;
                       nsprov:category "starting-point";
                       nsprov:component "agents-responsibility";
                       nsprov:inverse "hadDelegate";
                       nsprov:qualifiedForm nsprov:qualifiedDelegation,
                                            nsprov:Delegation.
nsprov:category a owl:AnnotationProperty.
nsprov:component a owl:AnnotationProperty.
nsprov:constraints a owl:AnnotationProperty.
nsprov:definition a owl:AnnotationProperty.
nsprov:dm a owl:AnnotationProperty.
nsprov:editorialNote a owl:AnnotationProperty.
nsprov:endedAtTime a owl:DatatypeProperty;
                   rdfs:comment """The number of calories burned associated with the
activity.""",
                                "The time at which an activity ended. See also prov:startedAtTime."@en;
                   rdfs:domain nsprov:Activity;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "endedAtTime";
                   rdfs:range xsd:dateTime;
                   nsprov:category "starting-point";
                   nsprov:component "entities-activities";
                   nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en;
                   nsprov:qualifiedForm nsprov:End,
                                        nsprov:atTime.
nsprov:generated a owl:ObjectProperty;
                 rdfs:comment "Relates an activity to an entity that it generated."@en;
                 rdfs:domain owl:Thing;
                 rdfs:label "generated";
                 rdfs:range owl:Thing.
nsprov:generatedAtTime a owl:DatatypeProperty;
                       rdfs:comment "The time at which an entity was completely created and is available for use."@en;
                       rdfs:domain nsprov:Entity;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "generatedAtTime";
                       rdfs:range xsd:dateTime;
                       nsprov:category "expanded";
                       nsprov:component "entities-activities";
                       nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en;
                       nsprov:qualifiedForm nsprov:atTime,
                                            nsprov:Generation.
nsprov:inverse a owl:AnnotationProperty.
nsprov:n a owl:AnnotationProperty.
nsprov:qualifiedForm a owl:AnnotationProperty.
nsprov:startedAtTime a owl:DatatypeProperty;
                     rdfs:comment "The time at which an activity started. See also prov:endedAtTime."@en;
                     rdfs:domain nsprov:Activity;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "startedAtTime";
                     rdfs:range xsd:dateTime;
                     nsprov:category "starting-point";
                     nsprov:component "entities-activities";
                     nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en;
                     nsprov:qualifiedForm nsprov:Start,
                                          nsprov:atTime.
nsprov:used a owl:ObjectProperty;
            rdfs:comment "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en;
            rdfs:domain nsprov:Activity;
            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
            rdfs:label "used";
            rdfs:range nsprov:Entity;
            rdfs:subPropertyOf nsprov:wasInfluencedBy;
            nsprov:category "starting-point";
            nsprov:component "entities-activities";
            nsprov:inverse "wasUsedBy";
            nsprov:qualifiedForm nsprov:Usage,
                                 nsprov:qualifiedUsage.
nsprov:wasAssociatedWith a owl:ObjectProperty;
                         rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en;
                         rdfs:domain nsprov:Activity;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                         rdfs:label "wasAssociatedWith";
                         rdfs:range nsprov:Agent;
                         rdfs:subPropertyOf nsprov:wasInfluencedBy;
                         owl:inverseOf pghdprovo:associatedWith;
                         nsprov:category "starting-point";
                         nsprov:component "agents-responsibility";
                         nsprov:inverse "wasAssociateFor";
                         nsprov:qualifiedForm nsprov:Association,
                                              nsprov:qualifiedAssociation.
nsprov:wasAttributedTo a owl:ObjectProperty;
                       rdfs:comment "Attribution is the ascribing of an entity to an agent."@en;
                       rdfs:domain nsprov:Entity;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "wasAttributedTo";
                       rdfs:range nsprov:Agent;
                       rdfs:subPropertyOf nsprov:wasInfluencedBy;
                       owl:inverseOf pghdprovo:contributed;
                       nsprov:category "starting-point";
                       nsprov:component "agents-responsibility";
                       nsprov:definition "Attribution is the ascribing of an entity to an agent."@en;
                       nsprov:inverse "contributed";
                       nsprov:qualifiedForm nsprov:Attribution,
                                            nsprov:qualifiedAttribution.
nsprov:wasDerivedFrom a owl:ObjectProperty;
                      rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en;
                      rdfs:domain nsprov:Entity;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                      rdfs:label "wasDerivedFrom";
                      rdfs:range nsprov:Entity;
                      rdfs:subPropertyOf nsprov:wasInfluencedBy;
                      owl:inverseOf pghdprovo:isSourceOf;
                      nsprov:category "starting-point";
                      nsprov:component "derivations";
                      nsprov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en;
                      nsprov:inverse "hadDerivation";
                      nsprov:qualifiedForm nsprov:Derivation,
                                           nsprov:qualifiedDerivation.
nsprov:wasGeneratedBy a owl:ObjectProperty;
                      rdfs:comment "Indicates that an entity was generated by an activity."@en;
                      rdfs:domain nsprov:Entity;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                      rdfs:label "wasGeneratedBy";
                      rdfs:range nsprov:Activity;
                      rdfs:subPropertyOf nsprov:wasInfluencedBy;
                      nsprov:category "starting-point";
                      nsprov:component "entities-activities";
                      nsprov:inverse "generated";
                      nsprov:qualifiedForm nsprov:Generation,
                                           nsprov:qualifiedGeneration.
nsprov:wasInfluencedBy a owl:ObjectProperty;
                       rdfs:comment "Indicates that one entity, activity, or agent was influenced by another."@en;
                       rdfs:domain owl:Thing;
                       rdfs:label "was influenced by";
                       rdfs:range owl:Thing.
foaf:age a owl:DatatypeProperty;
         rdfs:comment "A person's age, usually expressed in years, represented as an integer."@en;
         rdfs:domain nsprov:Person;
         rdfs:label "age";
         rdfs:range rdfs:Literal.
foaf:birthday a owl:DatatypeProperty,
                owl:FunctionalProperty;
              rdfs:comment "The birthday of this Agent, represented in mm-dd string form, eg. '12-31'.";
              rdfs:domain nsprov:Person;
              rdfs:isDefinedBy foaf:;
              rdfs:label "birthday";
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf foaf:age;
              status:term_status "unstable".
foaf:gender a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:comment "The gender of this Agent (typically but not necessarily 'male' or 'female').";
            rdfs:domain nsprov:Person;
            rdfs:isDefinedBy foaf:;
            rdfs:label "gender";
            rdfs:range rdfs:Literal;
            status:term_status "testing".
foaf:givenName a owl:DatatypeProperty;
               rdfs:comment "The given name of some person.";
               rdfs:domain nsprov:Person;
               rdfs:isDefinedBy foaf:;
               rdfs:label "Given name";
               rdfs:range rdfs:Literal;
               status:term_status "testing".
foaf:name a owl:DatatypeProperty;
          rdfs:comment "A name for some thing.";
          rdfs:domain owl:Thing;
          rdfs:label "name";
          rdfs:range rdfs:Literal.
saref:Device a owl:Class;
             rdfs:comment "A tangible object designed to accomplish a particular task. In order to accomplish this task, the device performs one or more functions. For example, a washing machine is designed to wash (task) and to accomplish this task it performs a start and stop function."@en;
             rdfs:isDefinedBy saref:;
             rdfs:label "Device"@en;
             rdfs:subClassOf nsprov:Entity.
s4wear:User a owl:Class;
            rdfs:comment "A user is an entity using a wearable."@en;
            rdfs:label "User"@en;
            rdfs:subClassOf nsprov:Person;
            owl:equivalentClass pghdprovo:Patient.
s4wear:Wearable a owl:Class;
                rdfs:comment "A wearable device is a device that is intended to be located near, on or in an organism."@en;
                rdfs:label "Wearable device"@en;
                rdfs:subClassOf saref:Device.
modp:createdWith a owl:AnnotationProperty.
w3id:pghdprovo dcterms:bibliographicCitation "Kawu, A.A., O’Sullivan, D. and Hederman, L., 2025, June. PGHDProvO: Provenance Based Ontology for Sharing Patient Generated Health Data (PGHD) with an Electronic Health Record (EHR). In International Conference on Artificial Intelligence in Medicine (pp. 197-201). Cham: Springer Nature Switzerland.";
               dcterms:contributor "Lucy Hederman, Trinity College Dublin",
                                   "Dympna OSullivan, Technological University Dublin";
               dcterms:created "2021-05-24"^^xsd:date;
               dcterms:creator "Abdullahi Abubakar Kawu";
               dcterms:description "Patient Generated Health Data (PGHD) refer to health data collected by patient or their relatives. This ontology seeks to capture information about the data, the provenance and data quality associated with PGHD shared with an EHR."@en;
               dcterms:issued "2024-05-24"^^xsd:date;
               dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
               dcterms:modified "2025-11-24"^^xsd:date;
               dcterms:publisher "Technological University Dublin";
               dcterms:title "PGHDPROVO";
               bibo:status "http://purl.org/ontology/bibo/status/published";
               vann:preferredNamespacePrefix "pghdprovo";
               vann:preferredNamespaceUri "https://w3id.org/pghdprovo#";
               a owl:Ontology;
               rdfs:label "Patient Generated Health Data Provenance Ontology"@en;
               owl:priorVersion <https://w3id.org/pghdprovo/1.0>;
               owl:versionIRI <https://w3id.org/pghdprovo/1.0>;
               owl:versionInfo "1.0";
               modp:createdWith <https://chowlk.linkeddata.es/>.
pghdprovo:Application a owl:Class;
                      rdfs:comment "A software application is a software that can be directly executed by some processing unit.";
                      rdfs:label "Application";
                      rdfs:subClassOf [owl:someValuesFrom nsprov:Person ; 
                                       owl:onProperty nsprov:wasAttributedTo ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom xsd:string ; 
                                       owl:onProperty pghdprovo:appName ; 
                                       a owl:Restriction],
                                      nsprov:Entity.
pghdprovo:BPMonitor a owl:NamedIndividual,
                      saref:Device;
                    pghdprovo:deviceModel "";
                    pghdprovo:deviceName "".
pghdprovo:BloodPressure1 dc11:identifier "";
                         a owl:NamedIndividual,
                           pghdprovo:PGHD;
                         nsprov:wasAttributedTo pghdprovo:Patient1;
                         nsprov:wasDerivedFrom pghdprovo:BPMonitor;
                         foaf:name ""^^rdfs:Literal;
                         pghdprovo:dataSource ""^^rdfs:Literal;
                         pghdprovo:hasContextualInfo pghdprovo:Programme1,
                                                     pghdprovo:Rating1,
                                                     pghdprovo:State1,
                                                     pghdprovo:Protocol1;
                         pghdprovo:unit ""^^rdfs:Literal;
                         pghdprovo:value ""^^rdfs:Literal;
                         pghdprovo:wasCollectedBy pghdprovo:Patient1.
pghdprovo:Carer a owl:Class;
                rdfs:comment "A Person who helps a patient to collect or transmit data.";
                rdfs:label "Carer";
                rdfs:subClassOf nsprov:Person.
pghdprovo:Consent a owl:Class;
                  rdfs:comment "A record of consent for Patient Generated Health Data.";
                  rdfs:label "Consent";
                  rdfs:subClassOf nsprov:Entity.
pghdprovo:ContextualDataInfo1 a owl:NamedIndividual,
                                pghdprovo:ContextualInfo;
                              pghdprovo:locationOfPatient "".
pghdprovo:ContextualInfo a owl:Class;
                         rdfs:comment "Contextual Information provides to extra details that help explain the measurement, like the environment, device settings, or the activity the person was doing when the data was taken.";
                         rdfs:label "contextual information";
                         rdfs:subClassOf nsprov:Entity.
pghdprovo:Organisation1 a owl:NamedIndividual,
                          nsprov:Organization;
                        pghdprovo:orgAddress "";
                        pghdprovo:orgEmail "";
                        pghdprovo:orgId "";
                        pghdprovo:orgName "".
pghdprovo:PGHD a owl:Class;
               rdfs:comment "Patient Generated Health Data (PGHD) a term referring to data that patients (or their caregivers) collect from home or any location outside the clinical environment.";
               rdfs:label "PGHD";
               rdfs:subClassOf [owl:someValuesFrom pghdprovo:ContextualInfo ; 
                                owl:onProperty pghdprovo:hasContextualInfo ; 
                                a owl:Restriction],
                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty pghdprovo:dataSource ; 
                                owl:onDataRange xsd:string ; 
                                a owl:Restriction],
                               [owl:onProperty nsprov:wasAttributedTo ; 
                                owl:allValuesFrom pghdprovo:Patient ; 
                                a owl:Restriction],
                               [owl:someValuesFrom s4wear:Wearable ; 
                                owl:onProperty nsprov:wasDerivedFrom ; 
                                a owl:Restriction],
                               nsprov:Entity,
                               [owl:someValuesFrom nsprov:Person ; 
                                owl:onProperty pghdprovo:wasCollectedBy ; 
                                a owl:Restriction],
                               [owl:onProperty nsprov:wasGeneratedBy ; 
                                owl:allValuesFrom pghdprovo:PGHDRequest ; 
                                a owl:Restriction].
pghdprovo:PGHDRequest a owl:Class;
                      rdfs:comment "A request made by a practitioner to obtain patient health data generated by wearable device or software application.";
                      rdfs:label "PGHD Request";
                      rdfs:subClassOf [owl:someValuesFrom pghdprovo:Application ; 
                                       owl:onProperty nsprov:used ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom pghdprovo:Practitioner ; 
                                       owl:onProperty pghdprovo:PGHDRequestedBy ; 
                                       a owl:Restriction],
                                      [owl:onProperty nsprov:wasAssociatedWith ; 
                                       owl:allValuesFrom pghdprovo:Patient ; 
                                       a owl:Restriction],
                                      [owl:onProperty pghdprovo:wasAuthorizedBy ; 
                                       owl:allValuesFrom pghdprovo:Patient ; 
                                       a owl:Restriction],
                                      [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty pghdprovo:requestId ; 
                                       owl:onDataRange xsd:integer ; 
                                       a owl:Restriction],
                                      nsprov:Activity.
pghdprovo:PGHDRequest1 a owl:NamedIndividual,
                         pghdprovo:PGHDRequest;
                       nsprov:endedAtTime "1000-10-10T00:00:00"^^xsd:dateTime;
                       nsprov:startedAtTime "1000-10-10T00:00:00"^^xsd:dateTime;
                       nsprov:used pghdprovo:application1;
                       pghdprovo:PGHDRequestedBy pghdprovo:Practitioner1;
                       pghdprovo:description "";
                       pghdprovo:requestId "";
                       pghdprovo:wasAuthorizedBy pghdprovo:Patient1.
pghdprovo:PGHDRequestedBy a owl:ObjectProperty;
                          rdfs:comment "A object property that declares the prov:agent responsible for the initializing a request for acquiring of patient Health data.";
                          rdfs:domain pghdprovo:PGHDRequest;
                          rdfs:label "PGHD requested by";
                          rdfs:range pghdprovo:Practitioner;
                          owl:inverseOf pghdprovo:requested.
pghdprovo:Patient a owl:Class;
                  rdfs:comment "A person who receives medical attention, care, or treatment, or who is registered with medical professional or institution with the purpose to receive medical care when necessary.";
                  rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C16960";
                  rdfs:label "Patient";
                  rdfs:subClassOf nsprov:Person.
pghdprovo:Patient1 a owl:NamedIndividual,
                     pghdprovo:Patient;
                   foaf:name "";
                   pghdprovo:address "";
                   pghdprovo:id "";
                   pghdprovo:phoneNumber "".
pghdprovo:PatientRelative a owl:Class;
                          rdfs:comment "A Patient relative or friend who helps to collect or transmit data.";
                          rdfs:label "Patient Relative";
                          rdfs:subClassOf [owl:someValuesFrom pghdprovo:Patient ; 
                                           owl:onProperty nsprov:actedOnBehalfOf ; 
                                           a owl:Restriction],
                                          [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty pghdprovo:relationship ; 
                                           owl:onDataRange xsd:string ; 
                                           a owl:Restriction],
                                          pghdprovo:Carer.
pghdprovo:PatientRelative1 a owl:NamedIndividual,
                             pghdprovo:PatientRelative;
                           nsprov:actedOnBehalfOf pghdprovo:Patient1;
                           foaf:name "";
                           pghdprovo:address "";
                           pghdprovo:id "";
                           pghdprovo:phoneNumber "";
                           pghdprovo:relationship "".
pghdprovo:Practitioner a owl:Class;
                       rdfs:comment """A person professionally engaged medical practice who is appointed to a post or duties.
[Definition Source: NCI]""";
                       rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C51846";
                       rdfs:label "Practitioner";
                       rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty pghdprovo:role ; 
                                        owl:onDataRange xsd:string ; 
                                        a owl:Restriction],
                                       nsprov:Person.
pghdprovo:Practitioner1 a owl:NamedIndividual,
                          pghdprovo:Practitioner;
                        foaf:name "";
                        pghdprovo:address "";
                        pghdprovo:id "";
                        pghdprovo:isAStaffOf pghdprovo:Organisation1;
                        pghdprovo:phoneNumber "";
                        pghdprovo:role "".
pghdprovo:Programme a owl:Class;
                    rdfs:comment "Refers to a health plan or program the person is following, helping to understand the data in relation to their health goals.";
                    rdfs:label "programme";
                    rdfs:subClassOf pghdprovo:ContextualInfo.
pghdprovo:Programme1 a owl:NamedIndividual,
                       pghdprovo:Programme;
                     pghdprovo:programmeName "".
pghdprovo:Protocol a owl:Class;
                   rdfs:comment "Describes the steps or rules followed when collecting the data, such as instructions for using a device or following a specific health procedure.";
                   rdfs:label "protocol";
                   rdfs:subClassOf pghdprovo:ContextualInfo.
pghdprovo:Protocol1 a owl:NamedIndividual,
                      pghdprovo:Protocol;
                    pghdprovo:bodySite "".
pghdprovo:Rating a owl:Class;
                 rdfs:comment "Includes scores or opinions about the measurement, like how good the data is or a personal rating of a health condition.";
                 rdfs:label "rating";
                 rdfs:subClassOf pghdprovo:ContextualInfo.
pghdprovo:Rating1 a owl:NamedIndividual,
                    pghdprovo:Rating;
                  pghdprovo:ratingOrgName "";
                  pghdprovo:ratingScore "".
pghdprovo:State a owl:Class;
                rdfs:comment "Informaion about the person's condition when the data was recorded, such as whether they were resting, active, sleeping, or exercising.";
                rdfs:label "state";
                rdfs:subClassOf pghdprovo:ContextualInfo.
pghdprovo:State1 a owl:NamedIndividual,
                   pghdprovo:State;
                 pghdprovo:exerciseState "";
                 pghdprovo:posture "".
pghdprovo:State2 a owl:NamedIndividual,
                   pghdprovo:State;
                 pghdprovo:posture "".
pghdprovo:address a owl:DatatypeProperty;
                  rdfs:comment "A standardized representation of the location of a person, business, building, or organization.";
                  rdfs:domain nsprov:Person;
                  rdfs:isDefinedBy "http://purl.obolibrary.org/obo/NCIT_C25407";
                  rdfs:label "address";
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf vcard2006:hasAddress.
pghdprovo:appName a owl:DatatypeProperty;
                  rdfs:comment "The name of the software application utilised by a patient and practitioner.";
                  rdfs:domain pghdprovo:Application;
                  rdfs:label "app name";
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf foaf:name.
pghdprovo:application1 a owl:NamedIndividual,
                         pghdprovo:Application;
                       nsprov:wasAttributedTo pghdprovo:Practitioner1;
                       pghdprovo:appName "".
pghdprovo:associatedWith a owl:ObjectProperty;
                         rdfs:comment "Defines association between an agent and an activity. Inverse of prov:wasAssociatedWith."@en;
                         rdfs:domain nsprov:Agent;
                         rdfs:label "associated with"@en;
                         rdfs:range nsprov:Activity.
pghdprovo:authorized a owl:ObjectProperty;
                     rdfs:comment "Indicates that an agent authorized an activity. Inverse of pghdprovo:wasAuthorizedBy."@en;
                     rdfs:domain pghdprovo:Patient;
                     rdfs:label "authorized"@en;
                     rdfs:range pghdprovo:PGHDRequest;
                     owl:inverseOf pghdprovo:wasAuthorizedBy.
pghdprovo:bodySite a owl:DatatypeProperty;
                   rdfs:comment "The part of the body where data is collected or which a device was placed to collect health data.";
                   rdfs:domain pghdprovo:Protocol;
                   rdfs:label "Body Site";
                   rdfs:range rdfs:Literal.
pghdprovo:calibrationStatus a owl:DatatypeProperty;
                            rdfs:comment "Specifies the calibration state of the device that produced the patient-generated health data. Preferred value includes calibrated, not-calibrated, calibration-due, unknown, and self-check-performed.";
                            rdfs:domain pghdprovo:Protocol;
                            rdfs:label "calibration status";
                            rdfs:range rdfs:Literal.
pghdprovo:code a owl:DatatypeProperty;
               rdfs:comment "A code associated with the resource.";
               rdfs:domain pghdprovo:PGHD;
               rdfs:label "code";
               rdfs:range rdfs:Literal.
pghdprovo:collected a owl:ObjectProperty;
                    rdfs:comment "Indicates that an agent collected data from an entity. Inverse of pghdprovo:wasCollectedBy."@en;
                    rdfs:domain nsprov:Person;
                    rdfs:label "collected"@en;
                    rdfs:range pghdprovo:PGHD;
                    owl:inverseOf pghdprovo:wasCollectedBy.
pghdprovo:consentDate a owl:DatatypeProperty;
                      rdfs:comment "The date and time the consent was issued.";
                      rdfs:domain pghdprovo:Consent;
                      rdfs:label "Consent Date";
                      rdfs:range xsd:dateTime.
pghdprovo:consentOrganisation a owl:ObjectProperty;
                              rdfs:comment "The organization managing or enforcing this consent.";
                              rdfs:domain pghdprovo:Consent;
                              rdfs:label "Consent Organization";
                              rdfs:range nsprov:Organization.
pghdprovo:consentPatient a owl:ObjectProperty;
                         rdfs:comment "The patient to whom this consent applies.";
                         rdfs:domain pghdprovo:Consent;
                         rdfs:label "Consent Patient";
                         rdfs:range pghdprovo:Patient.
pghdprovo:consentPolicy a owl:DatatypeProperty;
                        rdfs:comment "The URI for the specific organizational or jurisdictional policy referenced.";
                        rdfs:domain pghdprovo:Consent;
                        rdfs:label "Consent Policy URI";
                        rdfs:range rdfs:Literal.
pghdprovo:consentProvisionData a owl:ObjectProperty;
                               rdfs:comment "The specific observations (data) covered by this consent rule.";
                               rdfs:domain pghdprovo:Consent;
                               rdfs:label "Consent Provision Data";
                               rdfs:range pghdprovo:PGHD.
pghdprovo:consentRegulatory a owl:DatatypeProperty;
                            rdfs:comment "The URI for the computable regulation or policy rule.";
                            rdfs:domain pghdprovo:Consent;
                            rdfs:label "Consent Regulatory Rule URI";
                            rdfs:range rdfs:Literal.
pghdprovo:consentServiceProvider a owl:ObjectProperty;
                                 rdfs:comment "The practitioner or provider associated with the consent agreement.";
                                 rdfs:domain pghdprovo:Consent;
                                 rdfs:label "Consent Service Provider";
                                 rdfs:range pghdprovo:Practitioner.
pghdprovo:consentSourceReference a owl:DatatypeProperty;
                                 rdfs:comment "A string reference (URL, ID, or description) pointing to the original source of the consent.";
                                 rdfs:domain pghdprovo:Consent;
                                 rdfs:label "Consent Source Reference";
                                 rdfs:range rdfs:Literal.
pghdprovo:contributed a owl:ObjectProperty;
                      rdfs:comment "Indicates that an agent contributed to an entity. Inverse of prov:wasAttributedTo."@en;
                      rdfs:domain nsprov:Agent;
                      rdfs:label "contributed"@en;
                      rdfs:range nsprov:Entity.
pghdprovo:dataCoveredByConsent a owl:ObjectProperty;
                               rdfs:comment "Indicates consents that cover this specific PGHD data.";
                               rdfs:domain pghdprovo:PGHD;
                               rdfs:label "Data Covered By Consent";
                               rdfs:range pghdprovo:Consent;
                               owl:inverseOf pghdprovo:consentProvisionData.
pghdprovo:dataName a owl:DatatypeProperty;
                   rdfs:comment "The 'dataName' property indicates the type of measurement or observation being recorded, such as heart rate, blood pressure, step count, or sleep duration.";
                   rdfs:domain pghdprovo:PGHD;
                   rdfs:label "data name";
                   rdfs:range rdfs:Literal;
                   rdfs:subPropertyOf foaf:name.
pghdprovo:dataSource a owl:DatatypeProperty;
                     rdfs:comment "An entity that produce a digital data.";
                     rdfs:domain pghdprovo:PGHD;
                     rdfs:label "data source";
                     rdfs:range rdfs:Literal.
pghdprovo:dateCollected a owl:DatatypeProperty;
                        rdfs:comment "The 'dateCollected' property records the date and time when the measurement or observation was taken.";
                        rdfs:domain pghdprovo:PGHD;
                        rdfs:label "date collected";
                        rdfs:range rdfs:Literal.
pghdprovo:description a owl:DatatypeProperty;
                      rdfs:comment "Provide more information about an activity.";
                      rdfs:domain pghdprovo:PGHDRequest;
                      rdfs:label "description";
                      rdfs:range rdfs:Literal.
pghdprovo:deviceModel a owl:DatatypeProperty;
                      rdfs:comment "A unique number or name given by a device manufacturer to devices that corresponds to a certain characteristics.";
                      rdfs:domain saref:Device;
                      rdfs:label "device model";
                      rdfs:range rdfs:Literal.
pghdprovo:deviceName a owl:DatatypeProperty;
                     rdfs:comment "A name for a device.";
                     rdfs:domain saref:Device;
                     rdfs:label "device name";
                     rdfs:range rdfs:Literal;
                     rdfs:subPropertyOf foaf:name.
pghdprovo:exerciseState a owl:DatatypeProperty;
                        rdfs:comment "exercise state.";
                        rdfs:domain pghdprovo:State;
                        rdfs:label "exercise state";
                        rdfs:range rdfs:Literal.
pghdprovo:hadDelegate a owl:ObjectProperty;
                      rdfs:comment "Indicates that an agent had another agent act on their behalf. Inverse of prov:actedOnBehalfOf."@en;
                      rdfs:domain nsprov:Agent;
                      rdfs:label "had delegate"@en;
                      rdfs:range nsprov:Agent.
pghdprovo:hasContextualInfo a owl:ObjectProperty;
                            rdfs:comment "Has some contextual information associated to the PGHD";
                            rdfs:domain pghdprovo:PGHD;
                            rdfs:label "Contain Contextual Info";
                            rdfs:range pghdprovo:ContextualInfo;
                            owl:inverseOf pghdprovo:isContextualInfoOf.
pghdprovo:hasStaff a owl:ObjectProperty;
                   rdfs:comment "Indicates that an organization has a staff member. Inverse of pghdprovo:isAStaffOf."@en;
                   rdfs:domain nsprov:Organization;
                   rdfs:label "has staff"@en;
                   rdfs:range pghdprovo:Practitioner;
                   owl:inverseOf pghdprovo:isAStaffOf.
pghdprovo:id a owl:DatatypeProperty;
             rdfs:comment "Identifier";
             rdfs:domain nsprov:Person;
             rdfs:label "id";
             rdfs:range rdfs:Literal;
             rdfs:subPropertyOf dc11:identifier.
pghdprovo:isAStaffOf a owl:ObjectProperty;
                     rdfs:comment "Shows the institution a person works.";
                     rdfs:domain pghdprovo:Practitioner;
                     rdfs:label "is a staff of";
                     rdfs:range nsprov:Organization.
pghdprovo:isContextualInfoOf a owl:ObjectProperty;
                             rdfs:comment "Relates contextual information back to the entity it describes. Inverse of pghdprovo:hasContextualInfo."@en;
                             rdfs:domain pghdprovo:ContextualInfo;
                             rdfs:label "is contextual info of"@en;
                             rdfs:range pghdprovo:PGHD.
pghdprovo:isSourceOf a owl:ObjectProperty;
                     rdfs:comment "Indicates that an entity served as the source for a derived entity. Inverse of prov:wasDerivedFrom."@en;
                     rdfs:domain nsprov:Entity;
                     rdfs:label "is source of"@en;
                     rdfs:range nsprov:Entity.
pghdprovo:locationOfPatient a owl:DatatypeProperty;
                            rdfs:comment "Location of a patient during data collection.";
                            rdfs:domain pghdprovo:ContextualInfo;
                            rdfs:label "location of patient";
                            rdfs:range rdfs:Literal.
pghdprovo:orgAddress a owl:DatatypeProperty;
                     rdfs:comment "Location of organisation.";
                     rdfs:domain nsprov:Organization;
                     rdfs:label "organization address";
                     rdfs:range rdfs:Literal;
                     rdfs:subPropertyOf vcard2006:hasAddress.
pghdprovo:orgEmail a owl:DatatypeProperty;
                   rdfs:comment "Organization email address.";
                   rdfs:domain nsprov:Organization;
                   rdfs:label "organization email";
                   rdfs:range rdfs:Literal;
                   rdfs:subPropertyOf vcard2006:hasEmail.
pghdprovo:orgId a owl:DatatypeProperty;
                rdfs:comment "An identifier for an organization.";
                rdfs:domain nsprov:Organization;
                rdfs:label "organization id";
                rdfs:range rdfs:Literal;
                rdfs:subPropertyOf dc11:identifier.
pghdprovo:orgName a owl:DatatypeProperty;
                  rdfs:comment "The name of the organization where a practitioner belongs.";
                  rdfs:domain nsprov:Organization;
                  rdfs:label "organization name";
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf foaf:name.
pghdprovo:organisationConsented a owl:ObjectProperty;
                                rdfs:comment "Indicates consents managed or enforced by the organization.";
                                rdfs:domain nsprov:Organization;
                                rdfs:label "Organisation Consented";
                                rdfs:range pghdprovo:Consent;
                                owl:inverseOf pghdprovo:consentOrganisation.
pghdprovo:patientConsented a owl:ObjectProperty;
                           rdfs:comment "Indicates consents associated with this patient.";
                           rdfs:domain pghdprovo:Patient;
                           rdfs:label "Patient Consented";
                           rdfs:range pghdprovo:Consent;
                           owl:inverseOf pghdprovo:consentPatient.
pghdprovo:phoneNumber a owl:DatatypeProperty;
                      rdfs:comment "Phone contact number.";
                      rdfs:domain nsprov:Person;
                      rdfs:label "phone number";
                      rdfs:range rdfs:Literal;
                      rdfs:subPropertyOf vcard2006:hasTelephone.
pghdprovo:posture a owl:DatatypeProperty;
                  rdfs:comment "The body position of the patient during data collection.";
                  rdfs:domain pghdprovo:State;
                  rdfs:label "posture";
                  rdfs:range rdfs:Literal.
pghdprovo:programmeName a owl:DatatypeProperty;
                        rdfs:comment "The treatment programme associated with the PGHD request.";
                        rdfs:domain pghdprovo:Programme;
                        rdfs:label "programme name";
                        rdfs:range rdfs:Literal.
pghdprovo:ratingOrgName a owl:DatatypeProperty;
                        rdfs:comment "Denotes the name of the organization that conducted the rating.";
                        rdfs:domain pghdprovo:Rating;
                        rdfs:label "rating organization name";
                        rdfs:range rdfs:Literal;
                        rdfs:subPropertyOf owl:topDataProperty.
pghdprovo:ratingScore a owl:DatatypeProperty;
                      rdfs:comment "The efficiency rating of an equipement or device by recognized body.";
                      rdfs:domain pghdprovo:Rating;
                      rdfs:label "rating score";
                      rdfs:range rdfs:Literal.
pghdprovo:relationship a owl:DatatypeProperty;
                       rdfs:comment "shows the relationship of a caregiver, friend, or relative to a patient.";
                       rdfs:domain pghdprovo:PatientRelative;
                       rdfs:label "relationship";
                       rdfs:range rdfs:Literal.
pghdprovo:requestId a owl:DatatypeProperty;
                    rdfs:comment "Log id for an activity.";
                    rdfs:domain pghdprovo:PGHDRequest;
                    rdfs:label "activity id";
                    rdfs:range rdfs:Literal;
                    rdfs:subPropertyOf dc11:identifier.
pghdprovo:requested a owl:ObjectProperty;
                    rdfs:comment "Indicates that an agent made a request for PGHD. Inverse of pghdprovo:PGHDRequestedBy."@en;
                    rdfs:domain pghdprovo:Practitioner;
                    rdfs:label "requested"@en;
                    rdfs:range pghdprovo:PGHDRequest.
pghdprovo:role a owl:DatatypeProperty;
               rdfs:comment "position or function within an organization";
               rdfs:domain pghdprovo:Practitioner;
               rdfs:label "role";
               rdfs:range rdfs:Literal;
               rdfs:subPropertyOf vcard2006:hasRole.
pghdprovo:serviceProviderConsented a owl:ObjectProperty;
                                   rdfs:comment "Indicates consents associated with this practitioner or provider.";
                                   rdfs:domain pghdprovo:Practitioner;
                                   rdfs:label "Service Provider Consented";
                                   rdfs:range pghdprovo:Consent;
                                   owl:inverseOf pghdprovo:consentServiceProvider.
pghdprovo:unit a owl:DatatypeProperty;
               rdfs:comment "The 'unit' property specifies the metric or unit of measurement associated with the observed value.";
               rdfs:domain pghdprovo:PGHD;
               rdfs:label "unit";
               rdfs:range rdfs:Literal.
pghdprovo:value a owl:DatatypeProperty;
                rdfs:comment "The 'value' property represents the quantity measured or observed, typically recorded by a health or activity monitoring device.";
                rdfs:domain pghdprovo:PGHD;
                rdfs:label "value";
                rdfs:range rdfs:Literal.
pghdprovo:wasAuthorizedBy a owl:ObjectProperty;
                          rdfs:comment "A person who grant access to data requested.";
                          rdfs:domain pghdprovo:PGHDRequest;
                          rdfs:label "was authorized by";
                          rdfs:range pghdprovo:Patient.
pghdprovo:wasCollectedBy a owl:ObjectProperty;
                         rdfs:comment "Ascribing a person engaged in the retrieval of health data. This could be the patient themself, a caregiver, a relative, or a friend.";
                         rdfs:domain pghdprovo:PGHD;
                         rdfs:label "was collected by";
                         rdfs:range nsprov:Person.
