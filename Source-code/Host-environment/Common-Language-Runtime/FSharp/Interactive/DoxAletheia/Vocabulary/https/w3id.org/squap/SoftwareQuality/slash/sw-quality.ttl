<https://w3id.org/squap/SoftwareQualityCharacteristic> a owl:Class;
                                                       rdfs:comment "The concept of the sotftware quality characteristic";
                                                       rdfs:label "Software quality characteristic";
                                                       rdfs:subClassOf <https://w3id.org/squap/Concept>;
                                                       owl:equivalentClass [owl:unionOf (<https://w3id.org/squap/ArchitecturalAlignment>
                                                                                         <https://w3id.org/squap/ProcessMaturity>
                                                                                         <https://w3id.org/squap/SoftwareQuality>) ; 
                                                                            a owl:Class].
<https://w3id.org/squap/SoftwareQualityFactor> a owl:Class;
                                               rdfs:label "Software quality factor";
                                               rdfs:subClassOf [owl:someValuesFrom <https://w3id.org/squap/SoftwareQualityCharacteristic> ; 
                                                                owl:onProperty <https://w3id.org/squap/usesQualityCharacteristic> ; 
                                                                a owl:Restriction],
                                                               [owl:onProperty <https://w3id.org/squap/usesQualityCharacteristic> ; 
                                                                owl:allValuesFrom <https://w3id.org/squap/SoftwareQualityCharacteristic> ; 
                                                                a owl:Restriction],
                                                               <https://w3id.org/squap/Description>.
<https://w3id.org/squap/SoftwareQualityResult> a owl:Class;
                                               rdfs:label "Software quality result";
                                               rdfs:subClassOf <https://w3id.org/squap/MeasurementResult>.
<https://w3id.org/squap/Value> a owl:Class;
                               rdfs:label "Value";
                               rdfs:subClassOf [owl:onProperty <https://w3id.org/squap/value> ; 
                                                owl:cardinality "1" ; 
                                                a owl:Restriction],
                                               <https://w3id.org/squap/Region>.
<https://w3id.org/squap/affectsMeasurementOf> a owl:ObjectProperty;
                                              rdfs:domain <https://w3id.org/squap/MeasurementResult>;
                                              rdfs:label "affects measurement of";
