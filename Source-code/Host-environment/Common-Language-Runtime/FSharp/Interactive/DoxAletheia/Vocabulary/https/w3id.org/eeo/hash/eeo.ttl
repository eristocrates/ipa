@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://purl.obolibrary.org/obo/BFO_0000017> rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/EvaluationSpace> ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/projectsOn> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>].
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/version> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label rdfs:comment "A minimal interpretation of a stimulus.".
<https://w3id.org/eeo> <http://purl.org/dc/elements/1.1/creator> "Maximilian Zocholl"^^rdfs:Literal,
                                                                 "Anne-Laure Jousselme"^^rdfs:Literal;
                       <http://purl.org/dc/elements/1.1/date> "2020-09-21"^^rdfs:Literal;
                       <http://purl.org/dc/elements/1.1/description> "An ontology to describe experiments, evaluations and their relation.";
                       <http://purl.org/dc/elements/1.1/issued> "2020-09-21T11:35:00"^^xsd:dateTime;
                       <http://purl.org/dc/elements/1.1/license> <https://creativecommons.org/licenses/by/4.0/>;
                       <http://purl.org/dc/elements/1.1/title> "Experimental Evaluation Ontology";
                       a <http://www.w3.org/2002/07/owl#Ontology>;
                       <http://www.w3.org/2002/07/owl#imports> <http://purl.obolibrary.org/obo/bfo.owl>;
                       <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/eeo/0.1.0>;
                       <http://www.w3.org/2002/07/owl#versionInfo> "0.1.0".
<https://w3id.org/eeo/0.1.0/ComputationalProperty> a <http://www.w3.org/2002/07/owl#Class>;
                                                   rdfs:comment "A property that is assignable to the computational unit on which the experimental run is performed. The computational properties are potentially impacting on the ExperimentalResult and the EvaluationResult.";
                                                   rdfs:label "ComputationalProperty"@en;
                                                   rdfs:subClassOf <https://w3id.org/eeo/0.1.0/Predicate>.
<https://w3id.org/eeo/0.1.0/Data> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A minimal interpretation of a stimulus.";
                                  rdfs:label "Data"@en;
                                  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020>.
<https://w3id.org/eeo/0.1.0/Effect> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "A set of properties that result from an ExperimentalRun. Synonyms: Response variable, observational unit.";
                                    rdfs:label "Effect"@en;
                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019>.
<https://w3id.org/eeo/0.1.0/Evaluand> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "An Entity that is the subject of an Evaluation. Synonym: Evaluand, EvaluationUnit.";
                                      rdfs:label "Evaluand"@en;
                                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Phenomenon> ; 
                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/hasPart> ; 
                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                       [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Predicate> ; 
                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/hasPart> ; 
                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                       [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Evaluation> ; 
                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isPartOf> ; 
                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                       a <http://www.w3.org/2002/07/owl#Class>],
                                                      <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/Evaluation> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "The Process of assigning a quantity or quality value to a property of one or more Evaluands by means of an EvaluationMethod. Each Evaluation has an EvaluationContext, an EvaluationResult and may consist of one or more Evaluations. Polysemy sibling with the result of an Evaluation.";
                                        rdfs:label "Evaluation"@en;
                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/EvaluationValueScale> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/applies> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Evaluand> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/hasPart> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/EvaluationSystem> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isExecutionOf> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/EvaluationContext> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isRunningIn> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        <http://purl.obolibrary.org/obo/BFO_0000015>.
<https://w3id.org/eeo/0.1.0/EvaluationContext> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "A spatiotemporal region that includes a description of all Entities that impact on the Evaluation without being part of the Evaluation.";
                                               rdfs:label "EvaluationContext"@en;
                                               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000011>.
<https://w3id.org/eeo/0.1.0/EvaluationMethod> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "A Method aiming at the quantification of a Quality of an Evaluand making use of one or more EvaluationCriteria and EvaluationValueScales.";
                                              rdfs:label "EvaluationMethod"@en;
                                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Evaluation> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isAppliedBy> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Evaluand> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isAppliedTo> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              <http://purl.obolibrary.org/obo/BFO_0000017>.
<https://w3id.org/eeo/0.1.0/EvaluationResult> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "An Output of an Evaluation. A Quantity that is assigned to the Evaluand referring to an EvaluationCriterion and an EvaluationValueScale.";
                                              rdfs:label "EvaluationResult"@en;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000019>.
<https://w3id.org/eeo/0.1.0/EvaluationSpace> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "The cartesian product of the sets of the EvaluationCriteria realised by their respective EvaluationMetrics.";
                                             rdfs:label "EvaluationSpace"@en;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006>.
<https://w3id.org/eeo/0.1.0/EvaluationSystem> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "An Implementation that performs an Evaluation."@en;
                                              rdfs:label "EvaluationSystem"@en;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000030>.
<https://w3id.org/eeo/0.1.0/EvaluationValueScale> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:comment "A set of quality or quantity values of a quality or quantity that describes the relation between two or more values according to the properties of the set, e.g. set for distinguishing values, ordered set for ranking values, a metric that applies to all members of the set, etc.";
                                                  rdfs:label "EvaluationValueScale"@en;
                                                  rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000026>.
<https://w3id.org/eeo/0.1.0/Experiment> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A Process that includes two or more ExperimentalRuns between which the Input to an ExperimentalUnit is varied according to an ExperimentalPlan in a controlled way and the Effects are observed.";
                                        rdfs:label "Experiment"@en;
                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/ExperimentalSpace> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/hasPart> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/ExperimentalPlan> ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isSpecifiedBy> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                         <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isSpecifiedBy> ; 
                                                         <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/eeo/0.1.0/ExperimentalUnit> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        <http://purl.obolibrary.org/obo/BFO_0000015>.
<https://w3id.org/eeo/0.1.0/ExperimentalPlan> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "A randomly ordered set of two or more Treatments.";
                                              rdfs:label "ExperimentalPlan"@en;
                                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isSpecifiedBy> ; 
                                                               <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/eeo/0.1.0/ExperimentalRun> ; 
                                                               <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              <http://purl.obolibrary.org/obo/BFO_0000006>.
<https://w3id.org/eeo/0.1.0/ExperimentalRun> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "A Process in which the ExperimentalUnit transforms an Input into an ExperimentalResult.";
                                             rdfs:label "ExperimentalRun"@en;
                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/ExperimentalRunContext> ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isRunningIn> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Effect> ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> <https://w3id.org/eeo/0.1.0/isOutputOf>] ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isExecutionOf> ; 
                                                              <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/eeo/0.1.0/Implementation> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isSpecifiedBy> ; 
                                                              <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/eeo/0.1.0/Treatment> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             <http://purl.obolibrary.org/obo/BFO_0000015>.
<https://w3id.org/eeo/0.1.0/ExperimentalRunContext> a <http://www.w3.org/2002/07/owl#Class>;
                                                    rdfs:comment "A spatiotemporal region that is composed of ParameterSetting and ComputationalProperties.";
                                                    rdfs:label "ExperimentalRunContext"@en;
                                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000011>.
<https://w3id.org/eeo/0.1.0/ExperimentalSpace> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "The cartesian product of the sets of the FactorLevels of each Factor.";
                                               rdfs:label "ExperimentalSpace"@en;
                                               rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000006>.
<https://w3id.org/eeo/0.1.0/ExperimentalUnit> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "An Entity that has a function which transforms a Treatment into an ExperimentalResult during the ExperimentalRun and whose properties remain unchanged over the period of the experiment.",
                                                           "Corresponds to Phenomenon in VIM";
                                              rdfs:label "ExperimentalUnit"@en;
                                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Experiment> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isExperimentalUnitOf> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Task> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/pursues> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              <http://purl.obolibrary.org/obo/BFO_0000004>.
<https://w3id.org/eeo/0.1.0/Factor> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "An Entity that is an Input of the ExperimentalUnit within an Experiment.";
                                    rdfs:label "Factor"@en;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/hasFactorLevel> ; 
                                                     <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/eeo/0.1.0/FactorLevel> ; 
                                                     <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    <http://purl.obolibrary.org/obo/BFO_0000023>.
<https://w3id.org/eeo/0.1.0/FactorLevel> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "A value that is or may be assigned to a factor.";
                                         rdfs:label "FactorLevel"@en;
                                         rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023>.
<https://w3id.org/eeo/0.1.0/Hypothesis> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A model of the Evaluand to be accepted or rejected.";
                                        rdfs:label "Hypothesis"@en;
                                        rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023>.
<https://w3id.org/eeo/0.1.0/Implementation> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment "An entity that interprets a Specification and may create a process when being execute. An Implementation may be an ExperimentalUnit.";
                                            rdfs:label "Implementation"@en;
                                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/eeo/0.1.0/Specification> ; 
                                                             <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/eeo/0.1.0/isImplementing> ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                                            <http://purl.obolibrary.org/obo/BFO_0000004>.
<https://w3id.org/eeo/0.1.0/IntervalInterpretedValue> a <http://www.w3.org/2002/07/owl#Class>;
                                                      rdfs:comment "A Value interpreted according to multiple ordered categories that are subject to a distance measure.";
                                                      rdfs:label "IntervalInterpretedValue"@en;
                                                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.obolibrary.org/obo/BFO_0000019>
                                                                                                                <http://purl.obolibrary.org/obo/BFO_0000144>) ; 
                                                                       a <http://www.w3.org/2002/07/owl#Class>],
                                                                      <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/Measurement> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "A Process of assigning one or more quantity values to a measurand.";
                                         rdfs:label "Measurement"@en;
                                         rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015>.
<https://w3id.org/eeo/0.1.0/Method> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "A description of a Process to acquire Data, Information or Knowledge.";
                                    rdfs:label "Method"@en;
                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017>.
<https://w3id.org/eeo/0.1.0/Model> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "An incomplete and simplified representation of an entity.";
                                   rdfs:label "Model"@en;
                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020>.
<https://w3id.org/eeo/0.1.0/NominalInterpretedValue> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "A Value interpreted according to multiple categories.";
                                                     rdfs:label "NominalInterpretedValue"@en;
                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.obolibrary.org/obo/BFO_0000019>
                                                                                                               <http://purl.obolibrary.org/obo/BFO_0000144>) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>],
                                                                     <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/OrdinalInterpretedValue> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "A Value interpreted according to multiple ordered categories.";
                                                     rdfs:label "OrdinalInterpretedValue"@en;
                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.obolibrary.org/obo/BFO_0000019>
                                                                                                               <http://purl.obolibrary.org/obo/BFO_0000144>) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>],
                                                                     <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/ParameterSetting> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "A set of parameter values that are not changed during an Experiment.";
                                              rdfs:label "ParameterSetting"@en;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000023>.
<https://w3id.org/eeo/0.1.0/Phenomenon> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/eeo/0.1.0/Evaluand>
                                                                                                  <https://w3id.org/eeo/0.1.0/EvaluationResult>
                                                                                                  [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.obolibrary.org/obo/BFO_0000002>
                                                                                                                                           <http://purl.obolibrary.org/obo/BFO_0000003>) ; 
                                                                                                  a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                                         a <http://www.w3.org/2002/07/owl#Class>],
                                                        <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/Predicate> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A quality that allows to distinguish or match two or more Entities or Processes.";
                                       rdfs:label "Predicate"@en;
                                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.obolibrary.org/obo/BFO_0000019>
                                                                                                 <http://purl.obolibrary.org/obo/BFO_0000144>) ; 
                                                        a <http://www.w3.org/2002/07/owl#Class>],
                                                       <http://purl.obolibrary.org/obo/BFO_0000001>.
<https://w3id.org/eeo/0.1.0/QualityValue> a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment "A value of a property of an entity.";
                                          rdfs:label "QualityValue"@en;
                                          rdfs:subClassOf <https://w3id.org/eeo/0.1.0/Value>.
<https://w3id.org/eeo/0.1.0/Quantity> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "A property of an entity to which a value can be assigned that has a meaningful quantitative interpretation.";
                                      rdfs:label "Quantity"@en;
                                      rdfs:subClassOf <https://w3id.org/eeo/0.1.0/Predicate>.
<https://w3id.org/eeo/0.1.0/QuantityValue> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A numerical value of a property of an entity that has a magnitude.";
                                           rdfs:label "QuantityValue"@en;
                                           rdfs:subClassOf <https://w3id.org/eeo/0.1.0/Value>.
