                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasAttributeName> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                rdfs:comment "The object property relates the attribute name with the facet attribute according to IDS definition"@en;
                                                rdfs:domain <https://w3id.org/loin/v2/ids#Attribute>;
                                                rdfs:label "has attribute name"@en;
                                                rdfs:range <https://w3id.org/loin/v2/ids#AttributeName>;
                                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasEntityName> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "The object property relates the entity name with the facet entity according to IDS definition"@en;
                                             rdfs:domain <https://w3id.org/loin/v2/ids#Entity>;
                                             rdfs:label "has entity name"@en;
                                             rdfs:range <https://w3id.org/loin/v2/ids#EntityName>;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasIFCDataType> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:comment "The object property relates the IFC data type with the facet property according to IDS definition"@en;
                                              rdfs:domain <https://w3id.org/loin/v2/ids#Property>;
                                              rdfs:label "has IFC data type"@en;
                                              rdfs:range <https://w3id.org/loin/v2/ids#IFCDataType>;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasPredefinedType> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:comment "The object property relates a predefined type with the facet entity according to IDS definition"@en;
                                                 rdfs:domain <https://w3id.org/loin/v2/ids#Entity>;
                                                 rdfs:label "has predefined type"@en;
                                                 rdfs:range <https://w3id.org/loin/v2/ids#PredefinedType>;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasPropertyName> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:comment "The object property relates a property name type with the facet property according to IDS definition"@en;
                                               rdfs:domain <https://w3id.org/loin/v2/ids#Property>;
                                               rdfs:label "has property name"@en;
                                               rdfs:range <https://w3id.org/loin/v2/ids#PropertyName>;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasRequirement> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:comment "The object property relates the requirements with the IDS data definition"@en;
                                              rdfs:domain <https://w3id.org/loin/v2/ids#DataDefinition>;
                                              rdfs:label "has requirement"@en;
                                              rdfs:range <https://w3id.org/loin/v2/ids#FacetDefinition>;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasRestrictionType> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                  rdfs:comment "relates the restriction type with the facet parameter in IDS data definition"@en;
                                                  rdfs:domain <https://w3id.org/loin/v2/ids#FacetParameter>;
                                                  rdfs:label "has restriction type"@en;
                                                  rdfs:range <https://w3id.org/loin/v2/ids#RestrictionType>;
                                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#hasValue> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment "relates the value with a facet in IDS data definition"@en;
                                        rdfs:domain <https://w3id.org/loin/v2/ids#Attribute>,
                                                    <https://w3id.org/loin/v2/ids#Material>,
                                                    <https://w3id.org/loin/v2/ids#Property>;
                                        rdfs:label "has value";
                                        rdfs:range <https://w3id.org/loin/v2/ids#Value>;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<https://w3id.org/loin/v2/ids#restrictionFormulation> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                      rdfs:comment "Restriction formulation is for formulating facet parameter value, that is used by IDS definition."@en;
                                                      rdfs:domain <https://w3id.org/loin/v2/ids#FacetParameter>;
                                                      rdfs:label "Constraint text formulated for facet parameters"@en;
                                                      rdfs:range xsd:string;
                                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
