                                                                       rdfs:label "millimetre"@en.
<http://www.ontology-of-units-of-measure.org/resource/om-2/millivolt> a <https://saref.etsi.org/core/UnitOfMeasure>,
                                                                        <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                                                      rdfs:label "millivolt"@en.
<http://www.opengis.net/ont/geosparql#Feature> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "This class represents the top-level feature type. This class is equivalent to GFI_Feature defined in ISO 19156:2011, and it is superclass of all feature types."@en;
                                               rdfs:isDefinedBy <http://www.opengis.net/ont/gml>,
                                                                <http://www.opengis.net/ont/geosparql>;
                                               rdfs:label "Feature"@en;
                                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.opengis.net/ont/geosparql#Geometry> ; 
                                                                <http://www.w3.org/2002/07/owl#onProperty> <http://www.opengis.net/ont/geosparql#hasGeometry> ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                                               <http://www.opengis.net/ont/geosparql#SpatialObject>;
                                               <http://www.w3.org/2002/07/owl#disjointWith> <http://www.opengis.net/ont/geosparql#Geometry>.
<http://www.opengis.net/ont/geosparql#Geometry> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "The class represents the top-level geometry type. This class is equivalent to the UML class GM_Object defined in ISO 19107, and it is superclass of all geometry types."@en;
                                                rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>;
                                                rdfs:label "Geometry"@en;
                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject>.
<http://www.opengis.net/ont/geosparql#SpatialObject> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "The class spatial-object represents everything that can have a spatial representation. It is superclass of feature and geometry."@en;
                                                     rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql>;
                                                     rdfs:label "SpatialObject"@en;
                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2003/01/geo/wgs84_pos#Point> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2003/01/geo/wgs84_pos#location> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                     [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.opengis.net/ont/geosparql#SpatialObject> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.opengis.net/ont/geosparql#sfWithin> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                     [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.opengis.net/ont/geosparql#SpatialObject> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.opengis.net/ont/geosparql#sfContains> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                     [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.opengis.net/ont/geosparql#Geometry> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.opengis.net/ont/geosparql#hasGeometry> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
<http://www.opengis.net/ont/geosparql#hasGeometry> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:comment "A spatial representation for a given feature."@en;
                                                   rdfs:domain <http://www.opengis.net/ont/geosparql#Feature>;
                                                   rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#>;
                                                   rdfs:label "has geometry"@en;
                                                   rdfs:range <http://www.opengis.net/ont/geosparql#Geometry>.
<http://www.opengis.net/ont/geosparql#sfContains> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                  rdfs:comment "Exists if the subject SpatialObject spatially contains the object SpatialObject. DE-9IM: T*****FF*"@en;
                                                  rdfs:domain <http://www.opengis.net/ont/geosparql#SpatialObject>;
                                                  rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0>,
                                                                   <http://www.opengis.net/ont/geosparql>;
                                                  rdfs:label "contains"@en;
                                                  rdfs:range <http://www.opengis.net/ont/geosparql#SpatialObject>.
<http://www.opengis.net/ont/geosparql#sfWithin> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                rdfs:comment "Exists if the subject SpatialObject is spatially within the object SpatialObject. DE-9IM: T*F**F***"@en;
                                                rdfs:domain <http://www.opengis.net/ont/geosparql#SpatialObject>;
                                                rdfs:isDefinedBy <http://www.opengis.net/spec/geosparql/1.0>,
                                                                 <http://www.opengis.net/ont/geosparql>;
                                                rdfs:label "within"@en;
                                                rdfs:range <http://www.opengis.net/ont/geosparql#SpatialObject>.
xsd:date a rdfs:Datatype.
xsd:duration a rdfs:Datatype.
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "A point, typically described using a coordinate system relative to Earth, such as WGS84."@en,
                                                             """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  """;
                                                rdfs:isDefinedBy <http://www.w3.org/2003/01/geo/wgs84_pos#>;
                                                rdfs:label "Point"@en;
                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Geometry>.
<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                              rdfs:comment "The WGS84 altitude of a SpatialThing (decimal meters above the local reference ellipsoid)."@en;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                                              rdfs:label "altitude"@en.
<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                              rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)."@en;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                                              rdfs:label "latitude"@en.
<http://www.w3.org/2003/01/geo/wgs84_pos#location> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:comment """The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .
 """@en;
                                                   rdfs:label "location"@en;
                                                   rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/based_near>.
<http://www.w3.org/2003/01/geo/wgs84_pos#long> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)."@en;
                                               rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                                               rdfs:label "longitude"@en.
<http://www.w3.org/2004/02/skos/core#definition> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2004/02/skos/core#prefLabel> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2006/time#Instant> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "A temporal entity with zero extent or duration"@en;
                                      rdfs:isDefinedBy <http://www.w3.org/2006/time#>;
                                      rdfs:label "Instant"@en;
                                      rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity>.
<http://www.w3.org/2006/time#Interval> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A temporal entity with an extent or duration"@en;
                                       rdfs:isDefinedBy <http://www.w3.org/2006/time#>;
                                       rdfs:label "Time interval"@en;
                                       rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity>.
<http://www.w3.org/2006/time#TemporalEntity> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "A temporal interval or instant."@en;
                                             rdfs:isDefinedBy <http://www.w3.org/2006/time#>;
                                             rdfs:label "Temporal entity"@en.
<http://www.w3.org/ns/prov#hadPrimarySource> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/sosa/Platform> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms (definition taken from http://www.w3.org/ns/sosa/Platform)"@en;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                     rdfs:label "Platform"@en.
<http://www.w3.org/ns/sosa/hosts> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Relation between a platform and the systems it hosts."@en;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                  rdfs:label "host"@en;
                                  <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/sosa/isHostedBy>.
<http://www.w3.org/ns/sosa/isHostedBy> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "Relation between a system and its hosting platform."@en;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                       rdfs:label "is hosted by"@en.
<http://www.w3.org/ns/ssn/Deployment> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                      rdfs:label "Deployment"@en.
<http://www.w3.org/ns/ssn/System> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other Systems. (Definition taken from http://www.w3.org/ns/ssn/System)"@en;
                                  rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                  rdfs:label "System"@en.
<http://www.w3.org/ns/ssn/deployedOnPlatform> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:comment "Relation between a deployment and the platform(s) involved in the deployment."@en;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                              rdfs:label "deployed on platform"@en;
                                              <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/ssn/inDeployment>.
<http://www.w3.org/ns/ssn/deployedSystem> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "Relation between a deployment and the system deployed."@en;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                          rdfs:label "deployed system"@en;
                                          <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/ssn/hasDeployment>.
<http://www.w3.org/ns/ssn/hasDeployment> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                         rdfs:label "has deployment"@en.
<http://www.w3.org/ns/ssn/hasSubSystem> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                        rdfs:label "has subsystem"@en.
<http://www.w3.org/ns/ssn/inDeployment> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment "Relation between a platform and the deployment(s) that takes place in the platform."@en;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/ssn/>;
                                        rdfs:label "in deployment"@en.
<http://xmlns.com/foaf/0.1/Agent> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:label "Agent"@en;
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://xmlns.com/foaf/0.1/Agent> ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/member> ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>].
<http://xmlns.com/foaf/0.1/Person> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:label "Person"@en;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>.
<http://xmlns.com/foaf/0.1/based_near> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://xmlns.com/foaf/0.1/member> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:label "member"@en.
<https://saref.etsi.org/core/Actuator> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "Actuator"@en;
                                       rdfs:subClassOf <https://saref.etsi.org/core/Device>.
<https://saref.etsi.org/core/Command> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "A directive that a device must support to perform a certain function. A command may act upon a state, but does not necessarily act upon a state. For example, the ON command acts upon the ON/OFF state, but the GET command does not act upon any state, it simply gives a directive to retrieve a certain value. We propose here a list of commands that are relevant for the purpose of SAREF, but this list can be extended."@en;
                                      rdfs:label "Command"@en;
                                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasDescription> ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      [<http://www.w3.org/2002/07/owl#onClass> <https://saref.etsi.org/core/Function> ; 
                                                       <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isCommandOf> ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/State> ; 
                                                       <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/actsUpon> ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>].
<https://saref.etsi.org/core/Device> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                     rdfs:label "Device"@en;
                                     rdfs:subClassOf <http://www.w3.org/ns/ssn/System>.
<https://saref.etsi.org/core/FeatureOfInterest> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment <https://saref.etsi.org/core/>;
                                                rdfs:label "Feature of interest"@en;
                                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Measurement> ; 
                                                                 <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasMeasurement> ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Property> ; 
                                                                 <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasProperty> ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>].
<https://saref.etsi.org/core/Function> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "The functionality necessary to accomplish the task for which a Device is designed. A device can be designed to perform more than one function. Functions can be structured in categories (subclasses) that reflect different points of view, for example, considering the specific application area for which a function can be used (e.g., light, temperature, motion, heat, power, etc.), or the capability that a function can support (e.g., receive, reply, notify, etc.), and so forth. "@en;
                                       rdfs:label "Function"@en;
                                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> <https://saref.etsi.org/core/Command> ; 
                                                        <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasCommand> ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>].
<https://saref.etsi.org/core/Humidity> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a humidity unit"@en;
                                       rdfs:label "Humidity"@en,
                                                  "Humidiy"@en;
                                       rdfs:subClassOf <https://saref.etsi.org/core/Property>.
<https://saref.etsi.org/core/Measurement> a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment "Represents the measured value made over a property. It is also linked to the unit of measure in which the value is expressed and the timestamp of the measurement."@en;
                                          rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                          rdfs:label "Measurement"@en;
                                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> <https://saref.etsi.org/core/Property> ; 
                                                           <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/relatesToProperty> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:dateTime ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasTimestamp> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/UnitOfMeasure> ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isMeasuredIn> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/FeatureOfInterest> ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isMeasurementOf> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#onClass> <https://saref.etsi.org/core/UnitOfMeasure> ; 
                                                           <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isMeasuredIn> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasValue> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#onDataRange> xsd:float ; 
                                                           <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/hasValue> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Property> ; 
                                                           <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/relatesToProperty> ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>];
                                          <http://www.w3.org/2002/07/owl#disjointWith> <https://saref.etsi.org/core/UnitOfMeasure>,
                                                                                       <https://saref.etsi.org/core/Property>.
<https://saref.etsi.org/core/Property> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "Anything that can be sensed, measured or controlled in households, common public buildings or offices. We propose here a list of properties that are relevant for the purpose of SAREF, but this list can be extended."@en,
                                                    "An aspect of an entity that can be observable by a sensor."@en;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "Property"@en;
                                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Device> ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isMeasuredByDevice> ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Measurement> ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/relatesToMeasurement> ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/Device> ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isControlledByDevice> ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://saref.etsi.org/core/FeatureOfInterest> ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isPropertyOf> ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>];
                                       <http://www.w3.org/2002/07/owl#disjointWith> <https://saref.etsi.org/core/UnitOfMeasure>.
<https://saref.etsi.org/core/Sensor> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                     rdfs:label "Sensor"@en;
                                     rdfs:subClassOf <https://saref.etsi.org/core/Device>.
<https://saref.etsi.org/core/State> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "The state in which a device can be found, e.g, ON/OFF/STANDBY, or ONLINE/OFFLINE. We propose here a list of states that are relevant for the purpose of SAREF, but this list can be extended."@en;
                                    rdfs:label "State"@en.
<https://saref.etsi.org/core/Task> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The goal for which a device is designed (from a user perspective). For example, a washing machine is designed for the task of washing. We propose here a list of tasks that are relevant for the purpose of SAREF, but this list can be extended."@en;
                                   rdfs:label "Task"@en;
                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> <https://saref.etsi.org/core/Device> ; 
                                                    <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    <http://www.w3.org/2002/07/owl#onProperty> <https://saref.etsi.org/core/isAccomplishedBy> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>].
<https://saref.etsi.org/core/Temperature> a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment "A saref:Property related to some measurements that are characterized by a certain value that is measured in a temperature unit (degree_Celsius, degree_Fahrenheit, or degree_kelvin)"@en;
                                          rdfs:label "Temperature"@en;
                                          rdfs:subClassOf <https://saref.etsi.org/core/Property>.
<https://saref.etsi.org/core/Time> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A saref:Property that allows to specify the time concept in terms of instants or intervals according to the imported W3C Time ontology."@en;
                                   rdfs:label "Time"@en;
                                   rdfs:subClassOf <https://saref.etsi.org/core/Property>.
<https://saref.etsi.org/core/UnitOfMeasure> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment """The unit of measure is a standard for measurement of a quantity, such as a Property. For example,  Power is a property and Watt is a unit of power that represents a definite predetermined power: when we say 10 Watt, we actually mean 10 times the definite predetermined power called \"watt\". Our definition is based on the definition of unit of measure in the Ontology of units of Measure (OM). We propose here a list of some units of measure that are relevant for the purpose of SAREF, but this list can be extended, also using some other ontologies rather than the Ontology of units of Measure (OM)."""@en,
                                                         """The unit of measure is a standard for measurement of a quantity, such as a Property. For example,  Power is a property and Watt is a unit of power that represents a definite predetermined power: when we say 10 Watt, we actually mean 10 times the definite predetermined power called \"watt\". Our definition is based on the definition of unit of measure in the Ontology of units of Measure (OM). We propose here a list of some units of measure that are relevant for the purpose of the Smart Appliances ontology, but this list can be extended."""@en;
                                            rdfs:isDefinedBy <https://saref.etsi.org/core/>,
                                                             <http://www.wurvoc.org/vocabularies/om-1.6/Unit_of_measure>;
                                            rdfs:label "Unit of measure"@en.
<https://saref.etsi.org/core/accomplishes> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:comment "A relationship between a certain entity (e.g., a device) and the task it accomplishes"@en;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                           rdfs:label "accomplishes"@en;
                                           <http://www.w3.org/2002/07/owl#inverseOf> <https://saref.etsi.org/core/isAccomplishedBy>.
<https://saref.etsi.org/core/actsUpon> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "A relationship between a command and a state"@en;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "acts upon"@en.
<https://saref.etsi.org/core/controlsProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                               rdfs:label "controls property"@en.
<https://saref.etsi.org/core/hasCommand> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:comment "A relationship between an entity (such as a function) and a command"@en;
                                         rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                         rdfs:label "has command"@en;
                                         <http://www.w3.org/2002/07/owl#inverseOf> <https://saref.etsi.org/core/isCommandOf>.
<https://saref.etsi.org/core/hasDescription> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                             rdfs:comment "A relationship providing a description of an entity (e.g., device)"@en;
                                             rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                             rdfs:label "has description"@en;
                                             rdfs:range xsd:string.
<https://saref.etsi.org/core/hasFunction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "A relationship identifying the type of function of a device"@en;
                                          rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                          rdfs:label "has function"@en.
<https://saref.etsi.org/core/hasManufacturer> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                              rdfs:comment "A relationship identifying the manufacturer of an entity (e.g., device)"@en;
                                              rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                              rdfs:label "has manufacturer"@en;
                                              rdfs:range xsd:string.
<https://saref.etsi.org/core/hasMeasurement> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "Relation betwwen a feature of interest and the measurments that are about it."@en;
                                             rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                             rdfs:label "is feature of interest of"@en.
<https://saref.etsi.org/core/hasModel> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:comment "A relationship identifying the model of an entity (e.g., device)"@en;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "has model"@en;
                                       rdfs:range xsd:string.
<https://saref.etsi.org/core/hasProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "Relation between a feature of interest and its properties."@en;
                                          rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                          rdfs:label "has property"@en;
                                          <http://www.w3.org/2002/07/owl#inverseOf> <https://saref.etsi.org/core/isPropertyOf>.
<https://saref.etsi.org/core/hasState> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "has state"@en.
<https://saref.etsi.org/core/hasTimestamp> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                           rdfs:label "has timestamp"@en.
<https://saref.etsi.org/core/hasValue> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                       rdfs:label "has value"@en.
<https://saref.etsi.org/core/isAccomplishedBy> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:comment "A relationship indentifying the task accomplished by a certain entity (e.g., a device)"@en;
                                               rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                               rdfs:label "is accomplished by"@en.
<https://saref.etsi.org/core/isCommandOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "A relationship between a command and a function."@en;
                                          rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                          rdfs:label "is command of"@en.
<https://saref.etsi.org/core/isControlledByDevice> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                                   rdfs:label "is controlled by device"@en.
<https://saref.etsi.org/core/isMeasuredByDevice> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                                 rdfs:label "is measured by device"@en.
<https://saref.etsi.org/core/isMeasuredIn> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                           rdfs:label "is measured in"@en.
<https://saref.etsi.org/core/isMeasurementOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:comment "Relation between a measurement and the feature of interest being measured."@en;
                                              rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                              rdfs:label "has feature of interest"@en;
                                              <http://www.w3.org/2002/07/owl#inverseOf> <https://saref.etsi.org/core/hasMeasurement>.
<https://saref.etsi.org/core/isPropertyOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:comment "Relation between a property and a feature of interest in which such property appears."@en;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                           rdfs:label "is property of"@en.
<https://saref.etsi.org/core/makesMeasurement> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                               rdfs:label "makes measurement"@en;
                                               <http://www.w3.org/2002/07/owl#inverseOf> <https://saref.etsi.org/core/measurementMadeBy>.
<https://saref.etsi.org/core/measurementMadeBy> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                rdfs:comment "Relation between a measurement and the device that made it."@en;
                                                rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                                rdfs:label "measurement made by"@en.
<https://saref.etsi.org/core/measuresProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                               rdfs:label "measures property"@en.
<https://saref.etsi.org/core/relatesToMeasurement> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                                   rdfs:label "relates to measurement"@en.
<https://saref.etsi.org/core/relatesToProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                rdfs:isDefinedBy <https://saref.etsi.org/core/>;
                                                rdfs:label "relates to property"@en.
s4agri: <http://purl.org/dc/terms/contributor> <https://www.researchgate.net/profile/Jack_Verhoosel>;
        <http://purl.org/dc/terms/created> "2019-04-15"^^xsd:date;
        <http://purl.org/dc/terms/creator> <https://www.linkedin.com/in/mderoode>,
                                           <http://w3id.org/people/mpoveda>,
                                           <http://www.garcia-castro.com/foaf.rdf#me>,
                                           <https://www.linkedin.com/in/lauradaniele>;
        <http://purl.org/dc/terms/description> "This ontology extends the SAREF ontology for the Agricultural domain. This work has been developed in the context of the STF 534 (https://portal.etsi.org/STF/STFs/STFHomePages/STF534.aspx), which was established with the goal to create three SAREF extensions, one of them for the Agricultural domain."@en,
                                               "SAREF4AGRI is an extension of SAREF for the agriculture and food domain. SAREF4AGRI is specified and published by ETSI in the TS 103 410-6 associated to this ontology file. The list of use cases, standards and requirements that guided the creation of SAREF4AGRI are described in the associated ETSI TR 103 511."@en;
        <http://purl.org/dc/terms/issued> "2019-04-30"^^xsd:date;
        <http://purl.org/dc/terms/license> <https://forge.etsi.org/etsi-software-license>;
        <http://purl.org/dc/terms/modified> "2020-06-05"^^xsd:date;
        <http://purl.org/dc/terms/publisher> <https://www.etsi.org/>;
        <http://purl.org/dc/terms/source> <https://saref.etsi.org/sources/saref4agri/>;
        <http://purl.org/dc/terms/title> "SAREF4AGRI: an extension of SAREF for the agriculture and food domain"@en;
        <http://purl.org/vocab/vann/preferredNamespacePrefix> "s4agri";
        <http://purl.org/vocab/vann/preferredNamespaceUri> "https://saref.etsi.org/saref4agri/";
        a <http://www.w3.org/2002/07/owl#Ontology>;
        rdfs:seeAlso <https://www.etsi.org/deliver/etsi_ts/103400_103499/10341006/01.01.02_60/ts_10341006v010102p.pdf>;
        <http://www.w3.org/2002/07/owl#versionIRI> <https://saref.etsi.org/saref4agri/v1.1.2/>;
        <http://www.w3.org/2002/07/owl#versionInfo> "v1.1.2".
s4agri:AirTemperature a <https://saref.etsi.org/core/Temperature>,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>;
                      rdfs:comment "The degree or intensity of heat present in the air."@en;
                      rdfs:label "Air temperature"@en.
s4agri:AmbientHumidity a <https://saref.etsi.org/core/Humidity>,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>;
                       rdfs:comment "The amount of water vapour in the air."@en;
                       rdfs:label "Ambient humidity"@en.
s4agri:Animal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An individual and identifiable living organism that feeds on organic matter, typically having specialized sense organs and nervous system and able to respond rapidly to stimuli."@en;
              rdfs:label "Animal"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.obolibrary.org/obo/TAXRANK_0000000> ; 
                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.obolibrary.org/obo/TAXRANK_1000000> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                               <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasBirthDate ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                               <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <https://saref.etsi.org/core/FeatureOfInterest>,
                              [<http://www.w3.org/2002/07/owl#onClass> s4agri:ID ; 
                               <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasID ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                               <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasDeathDate ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:AnimalGroup ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:isMemberOf ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.opengis.net/ont/geosparql#Feature> ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:isLocatedIn ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>].
s4agri:AnimalGroup a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A collection of one or multiple animals."@en;
                   rdfs:label "Animal Group"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.opengis.net/ont/geosparql#Feature> ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> s4agri:isLocatedIn ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Animal ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasMember ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <https://saref.etsi.org/core/FeatureOfInterest>.
s4agri:Building a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space)."@en;
                rdfs:label "Building"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:BuildingSpace ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> s4agri:contains ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                <http://www.opengis.net/ont/geosparql#Feature>.
s4agri:BuildingSpace a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An entity used to define the physical spaces of the building. A building space contains devices or building objects."@en;
                     rdfs:label "Building space"@en;
                     rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>.
s4agri:Crop a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A collection of cultivated plants that is grown on a large scale commercially, especially a cereal, fruit, or vegetable."@en;
            rdfs:label "Crop"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:dateTime ; 
                             <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasPlantDate ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:dateTime ; 
                             <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasHarvestDate ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.obolibrary.org/obo/TAXRANK_0000000> ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://purl.obolibrary.org/obo/TAXRANK_1000000> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <https://saref.etsi.org/core/FeatureOfInterest>.
s4agri:Deployment a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The scenario, including temporal and spatial information, in which the systems and devices are installed."@en,
                               "Deployment"@en;
                  rdfs:label "Deployment"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.opengis.net/ont/geosparql#SpatialObject> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> s4agri:isDeployedAtSpace ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/2006/time#TemporalEntity> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasDeploymentPeriod ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/ns/ssn/System> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/ssn/deployedSystem> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/ns/sosa/Platform> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/ssn/deployedOnPlatform> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://www.w3.org/ns/ssn/Deployment>.
s4agri:EatingActivitySensor a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Eating activity sensor"@en;
                            rdfs:label "Eating activity sensor"@en;
                            rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:Farm a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A plot of land used for the scope of farming which can contain buildings and parcels."@en;
            rdfs:label "Farm"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Parcel ; 
                             <http://www.w3.org/2002/07/owl#onProperty> s4agri:contains ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Building ; 
                             <http://www.w3.org/2002/07/owl#onProperty> s4agri:contains ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <http://www.opengis.net/ont/geosparql#Feature>.
s4agri:FarmHolding a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A class to decsribe a saref4agri farm holding as subcass of an org:Organization"@en;
                   rdfs:label "Farm holding"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Farm ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> s4agri:managesFarm ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <https://schema.org/Organization>.
s4agri:Farmer a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A class to decsribe a saref4agri farmer as subcass of a foaf:Person"@en;
              rdfs:label "Farmer"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Farm ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:managesFarm ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://xmlns.com/foaf/0.1/Person>.
s4agri:ID a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "ID"@en;
          rdfs:label "ID"@en.
s4agri:Intake a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The amount of food or other substance taken into the body of an animal or into the soil."@en;
              rdfs:label "Intake"@en.
s4agri:IrrigationWater a <https://saref.etsi.org/core/Property>,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>;
                       rdfs:comment "The amount of water falling in the soil by irrigation methods."@en;
                       rdfs:label "Irrigation water"@en.
s4agri:MilkingSensor a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Milking sensor"@en;
                     rdfs:label "Milking sensor"@en;
                     rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:MovementActivitySensor a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Movement activity sensor"@en;
                              rdfs:label "Movement activity sensor"@en;
                              rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:Parcel a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An area of land, which might be used for grazing animals or planting crops. The parcel is defined as an undividable logical area of land which contains homogeneous items."@en;
              rdfs:label "Parcel"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                               <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:hasName ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> s4agri:Crop ; 
                               <http://www.w3.org/2002/07/owl#onProperty> s4agri:contains ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://www.opengis.net/ont/geosparql#Feature>.
s4agri:PlantGrowthStage a <https://saref.etsi.org/core/Property>,
                          <http://www.w3.org/2002/07/owl#NamedIndividual>;
                        rdfs:comment "The level or stage of growth of the plant."@en;
                        rdfs:label "Plant growth stage"@en.
s4agri:Platform a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Platform"@en;
                rdfs:label "Platform"@en;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/Platform>.
s4agri:Pluviometer a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A sensor that measures the rain fall."@en;
                   rdfs:label "Pluviometer"@en;
                   rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:Precipitation a <https://saref.etsi.org/core/Property>,
                       <http://www.w3.org/2002/07/owl#NamedIndividual>;
                     rdfs:comment "The amount of water falling in the soil by natural process (e.g. rain)."@en;
                     rdfs:label "Precipitation"@en.
s4agri:Soil a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Upper layer of the earth in which plants grow."@en;
            rdfs:label "Soil"@en;
            rdfs:subClassOf <https://saref.etsi.org/core/FeatureOfInterest>.
s4agri:SoilMoisture a <https://saref.etsi.org/core/Property>,
                      <http://www.w3.org/2002/07/owl#NamedIndividual>;
                    rdfs:comment "The amount of water or humidity contained in the soil."@en;
                    rdfs:label "Soil moisture"@en.
s4agri:SoilTemperature a <https://saref.etsi.org/core/Temperature>,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>;
                       rdfs:comment "The degree or intensity of heat present in the soil."@en;
                       rdfs:label "Soil temperature"@en.
s4agri:SoilTensiometer a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A sensor that measures the soil moisture."@en;
                       rdfs:label "Soil tensiometer"@en;
                       rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:Thermometer a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Thermometer"@en;
                   rdfs:label "Thermometer"@en;
                   rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:WateringGun a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An actuator to irrigate an space."@en;
                   rdfs:label "Watering gun"@en;
                   rdfs:subClassOf <https://saref.etsi.org/core/Actuator>.
s4agri:WateringSystem a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Watering system"@en;
                      rdfs:label "Watering system"@en;
                      rdfs:subClassOf <http://www.w3.org/ns/ssn/System>.
s4agri:WateringValve a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Watering valve"@en;
                     rdfs:label "Watering valve"@en;
                     rdfs:subClassOf <https://saref.etsi.org/core/Actuator>.
s4agri:WeatherStation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A sensor o system that measure weather conditions."@en;
                      rdfs:label "Weather station"@en;
                      rdfs:subClassOf <https://saref.etsi.org/core/Sensor>,
                                      <http://www.w3.org/ns/ssn/System>.
s4agri:WeightSensor a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Weight sensor"@en;
                    rdfs:label "Weight sensor"@en;
                    rdfs:subClassOf <https://saref.etsi.org/core/Sensor>.
s4agri:Yield a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The produced amount of food for animals or of agricultural products."@en;
             rdfs:label "Yield"@en.
s4agri:contains a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "contains"@en;
                rdfs:label "contains"@en;
                rdfs:subPropertyOf <http://www.opengis.net/ont/geosparql#sfContains>;
                <http://www.w3.org/2002/07/owl#inverseOf> s4agri:isContainedIn.
s4agri:generates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A relation to represent the yield generated by a Crop."@en;
                 rdfs:label "generates"@en;
                 rdfs:subPropertyOf <https://saref.etsi.org/core/hasProperty>.
s4agri:hasBirthDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "A relation to express the birth date of an animal."@en;
                    rdfs:label "has birth date"@en;
                    rdfs:range xsd:dateTime.
s4agri:hasDeathDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "A relation to express the death date of an animal."@en;
                    rdfs:label "has death date"@en;
                    rdfs:range xsd:dateTime.
s4agri:hasDeploymentPeriod a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "has deployment period"@en,
                                        "Relation to indicate the temporal duration or period of a deployment."@en;
                           rdfs:label "has deployment period"@en.
s4agri:hasHarvestDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "A relation to express the day the crop is harvested."@en;
                      rdfs:label "has harvest date"@en;
                      rdfs:range xsd:dateTime;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
s4agri:hasID a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A relation to express the unique identifier of an animal."@en;
             rdfs:label "has id"@en;
             rdfs:range s4agri:ID;
             rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
s4agri:hasMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A relation to represent  the members of an AnimalGroup."@en;
                 rdfs:label "has member"@en;
                 <http://www.w3.org/2002/07/owl#inverseOf> s4agri:isMemberOf.
s4agri:hasName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "A relation to express the name of an entity (e.g.,animal)."@en;
               rdfs:label "has name"@en;
               rdfs:range xsd:string.
s4agri:hasPlantDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "A relation to express the day the crop is planted."@en;
                    rdfs:label "has plant date"@en;
                    rdfs:range xsd:dateTime;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
s4agri:hasReceived a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "has received"@en;
                   rdfs:label "has received"@en;
                   <http://www.w3.org/2002/07/owl#inverseOf> s4agri:receives.
s4agri:isContainedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "is contained in"@en;
                     rdfs:label "is contained in"@en.
s4agri:isDeployedAtSpace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "is deployed at space"@en,
                                      "Relation to indicate the geographical componet of a deployment."@en;
                         rdfs:label "is deployed at space"@en.
s4agri:isLocatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A relation to express the physical location of a saref4agri entity (e.g., an animal)"@en;
                   rdfs:label "is located in"@en;
                   <http://www.w3.org/2002/07/owl#inverseOf> s4agri:isLocationOf.
s4agri:isLocationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "is location of"@en;
                    rdfs:label "is location of"@en.
s4agri:isMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "A relation to express that an animal can be part of groups."@en;
                  rdfs:label "is member of"@en.
s4agri:managesFarm a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "manages farm"@en;
                   rdfs:label "manages farm"@en.
s4agri:receives a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A relation to represent the intake/consumption of certain substances in a Crop."@en;
                rdfs:label "receives"@en;
                rdfs:subPropertyOf <https://saref.etsi.org/core/hasMeasurement>.
<https://schema.org/Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:label "Organization"@en;
                                  rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>.
