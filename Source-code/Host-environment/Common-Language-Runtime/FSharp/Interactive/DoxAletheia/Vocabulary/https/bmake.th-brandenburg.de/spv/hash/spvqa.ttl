                              rdfs:isDefinedBy <https://schema.org/>;
                              rdfs:label "Language"@en;
                              rdfs:subClassOf <https://schema.org/Intangible>.
<https://schema.org/Organization> a <http://www.w3.org/2002/07/owl#Class>;
