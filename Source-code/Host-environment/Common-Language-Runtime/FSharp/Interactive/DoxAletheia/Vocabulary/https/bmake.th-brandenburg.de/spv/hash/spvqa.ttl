                              rdfs:isDefinedBy <https://schema.org/>;
                              rdfs:label "Item List"@en;
                              rdfs:subClassOf <https://schema.org/Intangible>.
<https://schema.org/Language> a <http://www.w3.org/2002/07/owl#Class>;
