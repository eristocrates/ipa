<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/source> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> <http://purl.org/dc/elements/1.1/description> "Class has target title."@en;
                                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "Class has target title."@en;
                                 rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                 rdfs:label "title"@en;
                                 rdfs:range xsd:string.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:label "comment".
xsd:date a rdfs:Datatype.
<http://www.w3.org/2002/07/owl#backwardCompatibleWith> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/dcat#Resource> <http://purl.org/dc/elements/1.1/description> "Resource of data from DCAT ontology"@en;
                                     a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "Resource of data from DCAT ontology"@en;
                                     rdfs:label "Resource"@en;
                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:DigitalEntity ; 
                                                      <http://www.w3.org/2002/07/owl#onProperty> dtw:isDataOf ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/ns/dcat#Resource> ; 
                                                      <http://www.w3.org/2002/07/owl#onProperty> dtw:resourceAggregatedFrom ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/ns/dcat#Resource> ; 
                                                      <http://www.w3.org/2002/07/owl#onProperty> dtw:resourceAggregates ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     dtw:DigitalEntityDimension.
dtw: <http://purl.org/dc/elements/1.1/contributor> "Socorro Bernardos";
     <http://purl.org/dc/elements/1.1/creator> "Salvador González Gerpe";
     <http://purl.org/dc/elements/1.1/description> "Digital Twin ontology used to define Digital Twins and Semantic Digital Twins and aggregations by dimensions using Web of Things."@en;
     <http://purl.org/dc/elements/1.1/identifier> <https://doi.org/10.5281/zenodo.15263156>;
     <http://purl.org/dc/elements/1.1/title> "WoTDT: The WoT Digital Twin Ontology."@en;
     <http://purl.org/dc/terms/bibliographicCitation> "González-Gerpe, S., Poveda-Villalón, M., & García-Castro, R. (2024). DTAG: A Methodology for Aggregating Digital Twins Using the WoTDT Ontology. APPLIED SCIENCES-BASEL, 14(13).";
     <http://purl.org/dc/terms/created> "2024-04-01"^^xsd:date;
     <http://purl.org/dc/terms/issued> "2024-04-01"^^xsd:date;
     <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
     <http://purl.org/dc/terms/modified> "2025-06-15"^^xsd:date;
     <http://purl.org/dc/terms/publisher> "W3ID";
     <http://purl.org/dc/terms/source> <https://oeg-upm.github.io/WoT-DT-ontology-v2/OnToology/ontology.ttl/documentation/ontology.ttl>;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "dtw";
     <http://purl.org/vocab/vann/preferredNamespaceUri> dtw:;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#backwardCompatibleWith> dtw:;
     <http://www.w3.org/2002/07/owl#priorVersion> "0.4.0";
     <http://www.w3.org/2002/07/owl#versionIRI> dtw:0.5.0;
     <http://www.w3.org/2002/07/owl#versionInfo> "0.5.0";
     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en;
     <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/>.
dtw:BehavioralModel a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Describes the behaviors and response mechanisms of the entity (e.g. state transition, performance and disturbances)"@en;
                    rdfs:label "Behavioral Model"@en;
                    rdfs:subClassOf dtw:Model.
dtw:Connection a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Existing connection between different dtw:ConnectionPoint."@en;
               rdfs:label "Connection"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:InternalConnectionPoint ; 
                                <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConsumer ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               dtw:DigitalTwinDimension,
                               [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasConsumer ; 
                                <http://www.w3.org/2002/07/owl#onClass> dtw:ConnectionPoint ; 
                                <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> dtw:hasProvider ; 
                                <http://www.w3.org/2002/07/owl#onClass> dtw:ConnectionPoint ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ExternalConnectionPoint ; 
                                <http://www.w3.org/2002/07/owl#onProperty> dtw:hasProvider ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:InternalConnectionPoint ; 
                                <http://www.w3.org/2002/07/owl#onProperty> dtw:hasProvider ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ExternalConnectionPoint ; 
                                <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConsumer ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
dtw:ConnectionPoint a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Connection point of the connection."@en;
                    rdfs:label "Connection Point"@en.
dtw:DataServiceConnection a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Connection between dcat:Resource and td:InteractionAffordance."@en;
                          rdfs:label "Data Service Connection"@en;
                          rdfs:subClassOf dtw:Connection.
dtw:DigitalEntity a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This dimension of the digital twin consists of various data models that represents all the information allocated in the digital twin."@en;
                  rdfs:label "Digital Entity"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> dtw:containsInteractionAffordance ; 
                                   <http://www.w3.org/2002/07/owl#onClass> <https://www.w3.org/2019/wot/td#InteractionAffordance> ; 
                                   <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:RulesModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:SemanticModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:PhysicalModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasData ; 
                                   <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/dcat#Resource> ; 
                                   <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  dtw:DigitalTwinDimension,
                                  [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   <http://www.w3.org/2002/07/owl#onClass> dtw:Model ; 
                                   <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:OntologyModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:GeometricModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:BehavioralModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:MappingModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ShapesModel ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> dtw:hasModel ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>].
dtw:DigitalEntityDimension <http://purl.org/dc/elements/1.1/description> "Digital Entity Dimension class to add resource, model and interaction affordances clases"@en;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Digital Entity Dimension class to add resource, model and interaction affordances clases"@en;
                           rdfs:label "Digital Entity Dimension"@en.
dtw:DigitalTwin a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A realistic representation of all product life cycle components using physical, virtual and interaction data."@en;
                rdfs:label "Digital Twin"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> dtw:hasPhysicalEntity ; 
                                 <http://www.w3.org/2002/07/owl#onClass> dtw:PhysicalEntity ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ModelServiceConnection ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConnection ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasDigitalEntity ; 
                                 <http://www.w3.org/2002/07/owl#onClass> dtw:DigitalEntity ; 
                                 <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                <https://www.w3.org/2019/wot/td#Thing>,
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ModelDataConnection ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConnection ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:DataServiceConnection ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConnection ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:ModelModelConnection ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> dtw:hasConnection ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasConnection ; 
                                 <http://www.w3.org/2002/07/owl#onClass> dtw:Connection ; 
                                 <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
dtw:DigitalTwinAggregate a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Describes the aggregation of all the DTIs. Unlike the DTI, the DTA may not be an independent data structure. It may be a computing construct that has access to all DTIs and queries them either ad-hoc or proactively."@en;
                         rdfs:label "Digital Twin Aggregate"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:DigitalTwinAggregate ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> dtw:aggregateDTwA ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:DigitalTwinInstance ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> dtw:aggregateDTwI ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         dtw:DigitalTwin.
dtw:DigitalTwinDimension a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Dimensions of which the digital twin is composed."@en;
                         rdfs:label "Digital Twin Dimension"@en.
dtw:DigitalTwinInstance a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Describes a specific corresponding physical product that an individual Digital Twin remains linked to throughout the life of that physical product."@en;
                        rdfs:label "Digital Twin Instance"@en;
                        rdfs:subClassOf dtw:DigitalTwin.
dtw:ExternalConnectionPoint a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Connection point of the connection that is external to the DTw."@en;
                            rdfs:label "External Connection Point"@en;
                            rdfs:subClassOf dtw:ConnectionPoint.
dtw:Format a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Extension format in which the model or data is available."@en;
           rdfs:label "Format"@en.
dtw:GeometricModel a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Describes all the geometric parameters of the physical entity (e.g. shapes, sizes and assembly relations)."@en;
                   rdfs:label "Geometric Model"@en;
                   rdfs:subClassOf dtw:Model.
dtw:InternalConnectionPoint a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Connection point of the connection that is internal to the DTw."@en;
                            rdfs:label "Internal Connection Point"@en;
                            rdfs:subClassOf dtw:ConnectionPoint.
dtw:MappingModel a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Model that allows the alignment of data with the objective of obtaining harmonised data from non-harmonised data."@en;
                 rdfs:label "Mapping Model"@en;
                 rdfs:subClassOf dtw:SemanticModel.
dtw:Model a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Representation or conceptualization of the data registered in the Virtual Entity dimension."@en;
          rdfs:label "Model"@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:DigitalEntity ; 
                           <http://www.w3.org/2002/07/owl#onProperty> dtw:isModelOf ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:Model ; 
                           <http://www.w3.org/2002/07/owl#onProperty> dtw:modelAggregatedFrom ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#someValuesFrom> dtw:Model ; 
                           <http://www.w3.org/2002/07/owl#onProperty> dtw:modelAggregates ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> dtw:hasFormat ; 
                           <http://www.w3.org/2002/07/owl#onClass> dtw:Format ; 
                           <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          dtw:DigitalEntityDimension.
dtw:ModelDataConnection a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Connection between dtw:Model and dcat:Resource."@en;
                        rdfs:label "Model Data Connection"@en;
                        rdfs:subClassOf dtw:Connection.
dtw:ModelModelConnection <http://purl.org/dc/elements/1.1/description> "Model to model connection."@en;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Model to model connection."@en;
                         rdfs:label "Model Model Connection"@en;
                         rdfs:subClassOf dtw:Connection.
dtw:ModelServiceConnection a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Connection between dtw:Model and td:InteractionAffordance."@en;
                           rdfs:label "Model Service Connection"@en;
                           rdfs:subClassOf dtw:Connection.
dtw:OntologyModel a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Model that contains the conceptualization of the information of the digital twin. This conceptualization activity refers to the organization and structuration of the information (data, knowledge, etc.), obtained during the acquisition process, into meaningful models at the knowledge level and according to the ontology requirements specification document."@en;
                  rdfs:label "Ontology Model"@en;
                  rdfs:subClassOf dtw:SemanticModel.
dtw:PhysicalEntity a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This dimension of the digital twin consists of various subsystems, objects and sensory devices. These subsystems can include dynamic systems, control systems, maintenance systems, etc., and can be combined for a specific task. Also, non physical entities can be represented."@en;
                   rdfs:label "Physical Entity"@en;
                   rdfs:subClassOf dtw:DigitalTwinDimension.
dtw:PhysicalModel a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Responsible for providing all the physical properties (e.g. speed and force) based on dt:GeometricModel"@en;
                  rdfs:label "Physical Model"@en;
                  rdfs:subClassOf dtw:Model.
dtw:RulesModel a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A set of rules extracted from the historical data obtained from the physical model, whose function is to provide the virtual entity with a judgment for decision making, optimization, evaluation, prediction and maintenance."@en;
               rdfs:label "Rules Model"@en;
               rdfs:subClassOf dtw:Model.
dtw:SemanticModel <http://purl.org/dc/elements/1.1/description> "Model representing semantic web rules or conceptualizations."@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Model representing semantic web rules or conceptualizations."@en;
                  rdfs:label "Semantic Model"@en;
                  rdfs:subClassOf dtw:Model.
dtw:ShapesModel a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Model that contains the data validation rules allowing the data to be validated."@en;
                rdfs:label "Shapes Model"@en;
                rdfs:subClassOf dtw:SemanticModel.
dtw:aggregateDTwA a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Property that describes de action of aggregation between two different entities or dtw:DigitalTwinAggregate."@en;
                  rdfs:domain dtw:DigitalTwinAggregate;
                  rdfs:label "aggregate DTwA"@en;
                  rdfs:range dtw:DigitalTwinAggregate;
                  <http://www.w3.org/2002/07/owl#inverseOf> dtw:aggregatedDTwAFrom.
dtw:aggregateDTwI a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Property that describes de action of aggregation between two different entities or dtw:DigitalTwinInstance."@en;
                  rdfs:domain dtw:DigitalTwinAggregate;
                  rdfs:label "aggregate DTwI"@en;
                  rdfs:range dtw:DigitalTwinInstance;
                  <http://www.w3.org/2002/07/owl#inverseOf> dtw:aggregatedDTwIFrom.
dtw:aggregatedDTwAFrom <http://purl.org/dc/elements/1.1/description> "DTwA aggregated from a specific DTwA"@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "DTwA aggregated from a specific DTwA"@en;
                       rdfs:domain dtw:DigitalTwinAggregate;
                       rdfs:label "aggregated DTwA from"@en;
                       rdfs:range dtw:DigitalTwinAggregate.
dtw:aggregatedDTwIFrom <http://purl.org/dc/elements/1.1/description> "DTwI aggregated from a specific DTwA"@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "DTwI aggregated from a specific DTwA"@en;
                       rdfs:domain dtw:DigitalTwinInstance;
