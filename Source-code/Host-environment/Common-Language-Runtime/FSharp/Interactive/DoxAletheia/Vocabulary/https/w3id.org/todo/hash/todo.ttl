@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix todo: <https://w3id.org/todo#>.
@prefix tddial: <https://w3id.org/todo/tododial#>.
@prefix tddom: <https://w3id.org/todo/tododom#>.
@prefix tddt: <https://w3id.org/todo/tododt#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

w3id:todo ccrel:license "http://purl.org/NET/rdflicense/cc-by4.0";
          dcterms:contributor "Izaskun Fernández (Tekniker) <mailto:izaskun.fernandez@tekniker.es>";
          dcterms:created "2020-04-21T00:00:00";
          dcterms:creator "Cristina Aceta (Tekniker) <mailto:cristina.aceta@tekniker.es>";
          dcterms:description "With the aim of enhancing natural communication between workers in industrial environments and the systems to be used by them, TODO (Task-Oriented Dialogue management Ontology) has been developed to be the core of task-oriented dialogue systems. TODO is a core ontology that provides task-oriented dialogue systems with the necessary means to be capable of naturally interacting with workers (both at understanding and at ommunication levels) and that can be easily adapted to different industrial scenarios, reducing adaptation time and costs. Moreover, it allows to store and reproduce the dialogue process to be able to learn from new interactions.";
          dcterms:issued "";
          dcterms:modified "2021-09-23T10:00:00";
          dcterms:title "TODO: Task-Oriented Dialogue management Ontology";
          vann:preferredNamespacePrefix "todo";
          vann:preferredNamespaceUri "https://w3id.org/todo";
          a owl:Ontology;
          owl:imports <https://w3id.org/todo/tododom>,
                      <https://w3id.org/todo/tododial>;
          owl:versionInfo 2.1.
todo:hasActionTrace a owl:ObjectProperty,
                      owl:FunctionalProperty;
                    rdfs:comment "Establishes the relationship between an Action and its Trace";
                    rdfs:isDefinedBy "https://w3id.org/todo#";
                    rdfs:label "hasActionTrace";
                    owl:inverseOf todo:isActionTraceOf;
                    status:term_status "stable".
todo:hasObtained a owl:ObjectProperty,
                   owl:InverseFunctionalProperty;
                 rdfs:comment "Establishes a relation between a SecondaryDialogue and the information (ActionTrace/ArgumentTrace/WorldElementTrace) that has been obtained thanks to it.";
                 rdfs:isDefinedBy "https://w3id.org/todo#";
                 rdfs:label "hasObtained";
                 owl:inverseOf todo:obtainedThrough;
                 status:term_status "stable".
todo:isActionTraceOf a owl:ObjectProperty,
                       owl:InverseFunctionalProperty;
                     rdfs:comment "Establishes the relationship between an ActionTrace and the Action it refers to.";
                     rdfs:isDefinedBy "https://w3id.org/todo/todo";
                     rdfs:label "isActionTraceOf";
                     status:term_status "stable".
todo:obtainedThrough a owl:ObjectProperty,
                       owl:FunctionalProperty;
                     rdfs:comment "Establishes a relation between a Trace (ActionTrace/ArgumentTrace/WorldElementTrace) and the SecondaryDialogue performed to obtain said Trace.";
                     rdfs:isDefinedBy "https://w3id.org/todo#";
                     rdfs:label "obtainedThrough";
                     status:term_status "stable".
tddial:UserRequestTrace a owl:Class;
                        rdfs:subClassOf [owl:someValuesFrom tddom:ActionTrace ; 
                                         owl:onProperty todo:hasActionTrace ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom tddom:KeyElementTrace ; 
                                         owl:onProperty tddom:hasKeyElement ; 
                                         a owl:Restriction].
tddom:ActionTrace a owl:Class;
                  rdfs:subClassOf [owl:someValuesFrom tddt:SecondaryDialogueTrace ; 
                                   owl:onProperty todo:obtainedThrough ; 
                                   a owl:Restriction].
tddom:ArgumentTrace rdfs:subClassOf [owl:someValuesFrom tddt:SecondaryDialogueTrace ; 
                                     owl:onProperty todo:obtainedThrough ; 
                                     a owl:Restriction].
tddom:WorldElementTrace rdfs:subClassOf [owl:someValuesFrom tddt:SecondaryDialogueTrace ; 
                                         owl:onProperty todo:obtainedThrough ; 
                                         a owl:Restriction].
tddt:SecondaryDialogueTrace rdfs:subClassOf [owl:someValuesFrom tddom:ActionTrace ; 
                                             owl:onProperty todo:hasObtained ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom tddom:ArgumentTrace ; 
                                             owl:onProperty todo:hasObtained ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom tddom:WorldElementTrace ; 
                                             owl:onProperty todo:hasObtained ; 
                                             a owl:Restriction].
