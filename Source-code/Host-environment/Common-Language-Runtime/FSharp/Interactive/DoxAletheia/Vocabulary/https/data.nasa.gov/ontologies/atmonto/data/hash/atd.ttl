@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix arg: <http://spinrdf.org/arg#>.
@prefix sp: <http://spinrdf.org/sp#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix atm: <https://data.nasa.gov/ontologies/atmonto/ATM#>.
@prefix nas: <https://data.nasa.gov/ontologies/atmonto/NAS#>.
@prefix atd: <https://data.nasa.gov/ontologies/atmonto/data#>.
@prefix atts: <https://data.nasa.gov/ontologies/atmonto/general#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

arg:class a rdf:Property;
          rdfs:subPropertyOf sp:arg.
arg:property a rdf:Property;
             rdfs:subPropertyOf sp:arg.
atm:AircraftFlowCapacity rdfs:subClassOf atd:IntervalData.
nas:Airport rdfs:subClassOf atd:METARreportingStation.
nas:RunwayVisibleRangeMeasurement rdfs:subClassOf atd:IntervalData.
nas:StandAloneWeatherStation rdfs:subClassOf atd:METARreportingStation.
<https://data.nasa.gov/ontologies/atmonto/data> a owl:Ontology;
                                                owl:imports <https://data.nasa.gov/ontologies/atmonto/ATM>;
                                                owl:versionInfo "Created with TopBraid Composer".
atd:ASPMmeteorologicalCondition a owl:Class;
                                rdfs:comment "Meteorological conditions reported as part of the ASPM hourly airport data. Includes sky, wind, visibility and weather components.";
                                rdfs:label "ASPM meteorological condition";
                                rdfs:subClassOf atd:MeteorologicalCondition.
atd:AirportData a owl:Class;
                rdfs:comment "Represents a collection of airport data for a given time period, as reported by the FAA's ASPM system.";
                rdfs:label "Airport Data";
                rdfs:subClassOf [owl:onProperty atd:aspmFlightRules ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty atd:aspmFlightRules ; 
                                 owl:allValuesFrom [owl:oneOf ("I"
                                                               "V") ; 
                                                    a rdfs:Datatype] ; 
                                 a owl:Restriction],
                                atd:IntervalData.
atd:CloudLayer a owl:Class;
               rdfs:comment "Represents a cloud layer, providing its bottom and top altitude, its cloud type, and its degree of coverage.";
               rdfs:label "Cloud layer";
               rdfs:subClassOf [owl:onProperty atd:cloudType ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty atd:cloudCover ; 
                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty atd:cloudType ; 
                                owl:allValuesFrom [owl:oneOf ("towering cumulus"
                                                              "cumulonimbus"
                                                              "altocumulus castellanus") ; 
                                                   a rdfs:Datatype] ; 
                                a owl:Restriction],
                               [owl:onProperty atd:cloudCover ; 
                                owl:allValuesFrom [owl:oneOf ("clear"
                                                              "few clouds"
                                                              "scattered clouds"
                                                              "broken clouds"
                                                              "overcast"
                                                              "vertical visibility layer") ; 
                                                   a rdfs:Datatype] ; 
                                a owl:Restriction],
                               atts:SequencedItem.
atd:CloudLayerProfile a owl:Class;
                      rdfs:comment "A sequence of cloud layers, ordered from the ground upward. Represents cloud conditions.";
                      rdfs:label "Cloud layer profile";
                      rdfs:subClassOf [owl:onProperty atts:hasSequencedItem ; 
                                       owl:allValuesFrom atd:CloudLayer ; 
                                       a owl:Restriction],
                                      [owl:onProperty atts:hasLastItem ; 
                                       owl:allValuesFrom atd:CloudLayer ; 
                                       a owl:Restriction],
                                      [owl:onProperty atts:hasFirstItem ; 
                                       owl:allValuesFrom atd:CloudLayer ; 
                                       a owl:Restriction],
                                      atts:Sequence.
atd:FixCapacity a owl:Class;
                rdfs:comment "A subclass of interval-based data representing the maximum controllable number of aircraft flowing through a fix per some interval of time, given weather and other air traffic control constraints.";
                rdfs:label "Fix capacity";
                rdfs:subClassOf [owl:onProperty atm:flowMeasurementRegion ; 
                                 owl:allValuesFrom atm:NavigationFix ; 
                                 a owl:Restriction],
                                atm:AircraftCapacity.
atd:FixFlow a owl:Class;
            rdfs:comment "A subclass of interval-based data representing the number of aircraft flowing through a fix per some interval of time.";
            rdfs:domain atd:FixFlow;
            rdfs:label "Fix flow";
            rdfs:subClassOf [owl:onProperty atm:flowMeasurementRegion ; 
                             owl:allValuesFrom atm:NavigationFix ; 
                             a owl:Restriction],
                            atm:AircraftFlow.
atd:IntervalData a owl:Class;
                 rdfs:comment "State data that has a temporal lifetime: a start and end time.";
                 rdfs:label "Interval data".
atd:METARreport a owl:Class;
                rdfs:comment "Meteorological conditions provided in a periodic METAR report. Includes sky, wind, visibility and weather components.";
                rdfs:label "METAR Report";
                rdfs:subClassOf [owl:onProperty atd:metarReportType ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty atd:metarReportModifier ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty atd:metarReportType ; 
                                 owl:allValuesFrom [owl:oneOf ("METAR"
                                                               "SPECI") ; 
                                                    a rdfs:Datatype] ; 
                                 a owl:Restriction],
                                [owl:onProperty atd:metarReportModifier ; 
                                 owl:allValuesFrom [owl:oneOf ("AUTO"
                                                               "COR") ; 
                                                    a rdfs:Datatype] ; 
                                 a owl:Restriction],
                                atd:MeteorologicalCondition.
atd:METARreportingStation a owl:Class;
                          rdfs:comment "A weather reporting station that provides sensor data for a METAR report. Many airports are also METAR reporting stations.";
                          rdfs:label "METARreporting station";
                          rdfs:subClassOf owl:Thing.
atd:MetCondition a owl:Class;
                 rdfs:comment "A superclass over the various types of meteorological conditions.";
                 rdfs:label "Meteorological condition".
atd:MeteorologicalCondition a owl:Class;
                            rdfs:comment "A representation of the meteorological status for the specified time period, including sky, wind, visibility, and weather subcomponents.";
                            rdfs:label "Meteorological condition";
                            rdfs:subClassOf [owl:onProperty atd:meteorologicalConditionStatus ; 
                                             owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             a owl:Restriction],
                                            [owl:onProperty atd:meteorologicalConditionStatus ; 
                                             owl:allValuesFrom [owl:oneOf ("observed"
                                                                           "forecast") ; 
                                                                a rdfs:Datatype] ; 
                                             a owl:Restriction],
                                            atd:IntervalData.
atd:RunwayReport rdfs:comment "A report on runway conditions during a specified interval of time, focusing on runway status (open vs. closed) and surface friction during winter precipitation.".
atd:RunwayStatusData a owl:Class;
                     rdfs:comment "This class describes a temporally-dependent set of data about the operating status of a physical runway.";
                     rdfs:label "Runway status data";
                     rdfs:subClassOf [owl:onProperty atd:runwayStatus ; 
                                      owl:allValuesFrom [owl:oneOf ("open"
                                                                    "closed") ; 
                                                         a rdfs:Datatype] ; 
                                      a owl:Restriction],
                                     atd:IntervalData.
atd:SectorCapacity a owl:Class;
                   rdfs:comment "A subclass of interval-based data representing the maximum number of controllable aircraft flowing through a sector during some interval of time.";
                   rdfs:label "Sector capacity";
                   rdfs:subClassOf [owl:onProperty atm:flowMeasurementRegion ; 
                                    owl:allValuesFrom nas:Sector ; 
                                    a owl:Restriction],
                                   atm:AircraftCapacity.
atd:SectorFlow a owl:Class;
               rdfs:comment "A subclass of interval-based data representing the number of aircraft flowing through a sector during some interval of time.";
               rdfs:label "Sector flow";
               rdfs:subClassOf [owl:onProperty atm:flowMeasurementRegion ; 
                                owl:allValuesFrom nas:Sector ; 
                                a owl:Restriction],
                               atm:AircraftFlow.
atd:SkyCondition a owl:Class;
                 rdfs:comment "The current or forecast sky conditions, including the ceiling and information on the cloud layers present.";
                 rdfs:label "Sky condition";
                 rdfs:subClassOf atd:MetCondition.
atd:SurfaceWindCondition a owl:Class;
                         rdfs:comment "The current or forecast surface wind conditions.";
                         rdfs:label "Surface wind condition";
                         rdfs:subClassOf [owl:onProperty atd:surfaceWindDirectionStatus ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty atd:surfaceWindDirectionStatus ; 
                                          owl:allValuesFrom [owl:oneOf ("fixed"
                                                                        "varyingWithinRange"
                                                                        "variable") ; 
                                                             a rdfs:Datatype] ; 
                                          a owl:Restriction],
                                         atd:MetCondition.
atd:TAFmeteorologicalCondition a owl:Class;
                               rdfs:comment "Meteorological conditions reported as part of a TAF forecast. Includes sky, wind, visibility and weather components for current and future time periods.";
                               rdfs:label "TAF meteorological condition";
                               rdfs:subClassOf [owl:onProperty atd:rapidityOfWeatherChange ; 
                                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                a owl:Restriction],
                                               [owl:onProperty atd:rapidityOfWeatherChange ; 
                                                owl:allValuesFrom [owl:oneOf ("rapid"
                                                                              "gradual"
                                                                              "transient") ; 
                                                                   a rdfs:Datatype] ; 
                                                a owl:Restriction],
                                               atts:SequencedItem,
                                               atd:MeteorologicalCondition.
atd:TAFreport a owl:Class;
              rdfs:comment "Meteorological conditions provided in a periodic TAF forecast. Includes sky, wind, visibility and weather components.";
              rdfs:label "TAF report";
              rdfs:subClassOf [owl:onProperty atd:tafReportType ; 
                               owl:allValuesFrom [owl:oneOf ("routine"
                                                             "amended"
                                                             "corrected"
                                                             "delayed") ; 
                                                  a rdfs:Datatype] ; 
                               a owl:Restriction],
                              [owl:onProperty atts:hasSequencedItem ; 
                               owl:allValuesFrom atd:TAFmeteorologicalCondition ; 
                               a owl:Restriction],
                              [owl:onProperty atts:hasLastItem ; 
                               owl:allValuesFrom atd:TAFmeteorologicalCondition ; 
                               a owl:Restriction],
                              [owl:onProperty atts:hasFirstItem ; 
                               owl:allValuesFrom atd:TAFmeteorologicalCondition ; 
                               a owl:Restriction],
                              atts:Sequence,
                              atd:IntervalData.
atd:VisibilityCondition a owl:Class;
                        rdfs:comment "The current or forecast surface visibility conditions at a given airport or other reporting station.";
                        rdfs:label "Visibility condition";
                        rdfs:subClassOf atd:MetCondition.
atd:WITIproperty a owl:Class;
                 rdfs:comment "A class of different properties relating to WITI (Weather-Impacted Traffic Index)";
                 rdfs:label "WITIproperty";
                 rdfs:subClassOf owl:DatatypeProperty.
atd:WeatherCondition a owl:Class;
                     rdfs:comment "The current or forecast weather conditions at a given airport or other reporting station.";
                     rdfs:label "Weather condition";
                     rdfs:subClassOf [owl:onProperty atd:weatherQualifier ; 
                                      owl:allValuesFrom [owl:oneOf ("shallow"
                                                                    "partial"
                                                                    "patchy"
                                                                    "low drifting"
                                                                    "blowing"
                                                                    "shower"
                                                                    "thunderstorm"
                                                                    "freezing") ; 
                                                         a rdfs:Datatype] ; 
                                      a owl:Restriction],
                                     [owl:onProperty atd:weatherPhenomenon ; 
                                      owl:allValuesFrom [owl:oneOf ("drizzle"
                                                                    "rain"
                                                                    "snow"
                                                                    "snow grains"
                                                                    "ice crystals"
                                                                    "ice pellets"
                                                                    "hail"
                                                                    "small hail and/or snow pellets"
                                                                    "unknown precipitation"
                                                                    "mist"
                                                                    "fog"
                                                                    "smoke"
                                                                    "volcanic ash"
                                                                    "widespread dust"
                                                                    "sand"
                                                                    "haze"
                                                                    "spray"
                                                                    "well-developed dust/sand whirls"
                                                                    "squalls"
                                                                    "funnel cloud"
                                                                    "tornado/waterspout"
                                                                    "sandstorm"
                                                                    "duststorm") ; 
                                                         a rdfs:Datatype] ; 
                                      a owl:Restriction],
                                     [owl:onProperty atd:weatherIntensity ; 
                                      owl:maxCardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty atd:weatherProximity ; 
                                      owl:allValuesFrom [owl:oneOf ("immediate proximity"
                                                                    "in vicinity") ; 
                                                         a rdfs:Datatype] ; 
                                      a owl:Restriction],
                                     [owl:onProperty atd:weatherIntensity ; 
                                      owl:allValuesFrom [owl:oneOf ("light"
                                                                    "moderate"
                                                                    "heavy") ; 
                                                         a rdfs:Datatype] ; 
                                      a owl:Restriction],
                                     atd:MetCondition,
                                     [owl:onProperty atd:weatherProximity ; 
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                      a owl:Restriction].
atd:airportArrivalRate a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "The arrival rate per hour set by the airport during the specified interval. This is the total number of aircraft that can arrive on all runways combined during an hour.";
                       rdfs:domain atd:AirportData;
                       rdfs:label "airport arrival rate";
                       rdfs:range xsd:integer.
atd:airportDepartureRate a owl:FunctionalProperty,
                           owl:DatatypeProperty;
                         rdfs:comment "The departure rate per hour set by the airport during the specified interval. This is the total number of aircraft that can depart from all runways combined during an hour.";
                         rdfs:domain atd:AirportData;
                         rdfs:label "airport departure rate";
                         rdfs:range xsd:integer.
atd:arrivalDemand a owl:FunctionalProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "The number of aircraft intending to arrive at an airport during the specified time period.";
                  rdfs:domain atd:AirportData;
                  rdfs:label "arrival demand";
                  rdfs:range xsd:integer.
atd:aspmFlightRules a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "Indicates what flight rule conditions the airport is operating under during the specified time period (I-instrument, V-Visual).";
                    rdfs:domain atd:AirportData;
                    rdfs:label "ASPM Flight Rules";
                    rdfs:range xsd:string.
atd:associatedMETARreportingStation a owl:ObjectProperty;
                                    rdfs:comment "Links a METAR report to the reporting station where the data were collected.";
                                    rdfs:domain atd:METARreport;
                                    rdfs:label "METAR reporting station";
                                    rdfs:range atd:METARreportingStation;
                                    owl:inverseOf atd:hasMETARreport.
atd:baseAltitude a owl:DatatypeProperty;
                 rdfs:comment "For a given homogeonous cloud layer, this is the lowest altitude.";
                 rdfs:domain atd:CloudLayer;
                 rdfs:label "base altitude";
                 rdfs:range xsd:integer.
atd:ceiling a owl:DatatypeProperty;
            rdfs:comment "The vertical visibility (in feet) measured from the ground to the lowest cloud layer reported as broken or overcast.";
            rdfs:domain atd:SkyCondition;
            rdfs:label "ceiling";
            rdfs:range xsd:integer.
atd:cloudCover a owl:DatatypeProperty;
               rdfs:comment "For a given homogenous cloud layer, the type of cloud cover present: clear, few clouds, scattered clouds, broken clouds, overcast, vertical visibility layer.";
               rdfs:domain atd:CloudLayer;
               rdfs:label "cloud cover";
               rdfs:range xsd:string.
atd:cloudType a owl:DatatypeProperty;
              rdfs:comment "For a given homogeneous cloud layer, the type of cloud present: towering cumulus, cumulonimbus, altocumulus castellanus.";
              rdfs:domain atd:CloudLayer;
              rdfs:label "cloud type";
              rdfs:range xsd:string.
atd:dataIntervalEndDay a owl:ObjectProperty;
                       rdfs:comment "Links temporally-dependent data to the ending day of its period of validity.";
                       rdfs:domain atd:IntervalData;
                       rdfs:label "data interval end day";
                       rdfs:range nas:NASday.
atd:dataIntervalEndTime a owl:DatatypeProperty;
                        rdfs:comment "For temporally-dependent data, the ending time of the data's period of validity.";
                        rdfs:domain atd:IntervalData;
                        rdfs:label "data interval end time";
                        rdfs:range xsd:dateTime.
atd:dataIntervalStartDay a owl:ObjectProperty;
                         rdfs:comment "Links temporally-dependent data to the starting day of its period of validity.";
                         rdfs:domain atd:IntervalData;
                         rdfs:label "data interval start day";
                         rdfs:range nas:NASday.
atd:dataIntervalStartTime a owl:DatatypeProperty;
                          rdfs:comment "For temporally-dependent data, the starting time of the data's period of validity.";
                          rdfs:domain atd:IntervalData;
                          rdfs:label "data interval start time";
                          rdfs:range xsd:dateTime.
atd:departureDemand a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "The number of aircraft intending to depart during the specified time period.";
                    rdfs:domain atd:AirportData;
                    rdfs:label "departure demand";
                    rdfs:range xsd:integer.
atd:dewpoint a owl:DatatypeProperty;
             rdfs:comment "The dewpoint recorded as part of a meteorological condition report.";
             rdfs:domain atd:MeteorologicalCondition;
             rdfs:label "dewpoint";
             rdfs:range xsd:float.
atd:edctArrivalHold a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "EDCT (Estimated Departure Clearance Time) hold minutes at other airports arriving this airport.";
                    rdfs:domain atd:AirportData;
                    rdfs:label "EDCT arrival hold";
                    rdfs:range xsd:float.
atd:edctDepartureHold a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "EDCT (Estimated Departure Clearance Time) hold minutes at other airports departing this airport.";
                      rdfs:domain atd:AirportData;
                      rdfs:label "EDCT departure hold";
                      rdfs:range xsd:float.
atd:etmsArrivals a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment "Count of arrivals at airport based on ETMS (Enhanced Traffic Management System) data.";
                 rdfs:domain atd:AirportData;
                 rdfs:label "etms arrivals";
                 rdfs:range xsd:integer.
atd:etmsDepartures a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "Count of departures at airport based on ETMS (Enhanced Traffic Management System) data.";
                   rdfs:domain atd:AirportData;
                   rdfs:label "etms arrivals";
                   rdfs:range xsd:integer.
atd:forecastIssueTime a owl:DatatypeProperty;
                      rdfs:comment "The time that the TAF (Terminal Area Forecast) report was issued.";
                      rdfs:domain atd:TAFreport;
                      rdfs:label "forecast issue time";
                      rdfs:range xsd:dateTime.
atd:forecastingAirport a owl:ObjectProperty;
                       rdfs:comment "Links to the airport for which the TAF (Terminal Area Forecast) report was compiled.";
                       rdfs:domain atd:TAFreport;
                       rdfs:label "forecasting airport";
                       rdfs:range nas:Airport;
                       owl:inverseOf atd:hasTAFreport.
atd:hasASPMmetCondition a owl:ObjectProperty;
                        rdfs:comment "Links meteorological information to the collection of temporally-dependent data associated with an airport.";
                        rdfs:domain atd:AirportData;
                        rdfs:label "has ASPMmet condition";
                        rdfs:range atd:ASPMmeteorologicalCondition.
atd:hasAirportData a owl:ObjectProperty;
                   rdfs:comment "Links an airport to a collection of temporally-dependent data pertinent to the airport conditions, including a variety of data collected in the ASPM system.";
                   rdfs:domain nas:Airport;
                   rdfs:label "has airport data";
                   rdfs:range atd:AirportData.
atd:hasCloudLayerProfile a owl:ObjectProperty;
                         rdfs:comment "Links a sky condition to a representation of the cloud layers present.";
                         rdfs:domain atd:SkyCondition;
                         rdfs:label "has cloud layer profile";
                         rdfs:range atd:CloudLayerProfile.
atd:hasMETARreport a owl:ObjectProperty;
                   rdfs:comment "Associates a METAR reporting station with METAR weather reports generated for that station.";
                   rdfs:domain atd:METARreportingStation;
                   rdfs:label "has METARreport";
                   rdfs:range atd:METARreport;
                   owl:inverseOf atd:associatedMETARreportingStation.
atd:hasSkyCondition a owl:ObjectProperty;
                    rdfs:comment "Associates a meteorological condition with the details of the sky and cloud conditions at the reporting location..";
                    rdfs:domain atd:MeteorologicalCondition;
                    rdfs:label "has sky condition";
                    rdfs:range atd:SkyCondition.
atd:hasSurfaceWindCondition a owl:ObjectProperty;
                            rdfs:comment "Associates a meteorological condition with the details of the surface wind conditions at the reporting location..";
                            rdfs:domain atd:MeteorologicalCondition;
                            rdfs:label "has surface wind condition";
                            rdfs:range atd:SurfaceWindCondition.
atd:hasTAFreport a owl:ObjectProperty;
                 rdfs:comment "Associates an airport with TAF weather reports generated for that airport.";
                 rdfs:domain nas:Airport;
                 rdfs:label "has TAFreport";
                 rdfs:range atd:TAFreport;
                 owl:inverseOf atd:forecastingAirport.
atd:hasVisibilityCondition a owl:ObjectProperty;
                           rdfs:comment "Associates a meteorological condition with the details of the surface visibility conditions at the reporting location..";
                           rdfs:domain atd:MeteorologicalCondition;
                           rdfs:label "has visibility condition";
                           rdfs:range atd:VisibilityCondition.
atd:hasWeatherCondition a owl:ObjectProperty;
                        rdfs:comment "Associates a meteorological condition with the details of the weather conditions at the reporting location.";
                        rdfs:domain atd:MeteorologicalCondition;
                        rdfs:label "has weather condition";
                        rdfs:range atd:WeatherCondition.
atd:highWindWITIdaily a owl:FunctionalProperty,
                        atd:WITIproperty;
                      rdfs:comment "The high wind weather impacted traffic index (WITI) computed for the airport during the specified timeframe (daily). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the winds at the airport are above a set threshold, then the high wind WITI is set to the number of scheduled arrivals for that timeframe.";
                      rdfs:domain atd:AirportData;
                      rdfs:label "high wind WITI daily";
                      rdfs:range xsd:float.
atd:highWindWITIhourly a owl:FunctionalProperty,
                         atd:WITIproperty;
                       rdfs:comment "The high wind weather impacted traffic index (WITI) computed for the airport during the specified timeframe (hourly). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the winds at the airport are above a set threshold, then the high wind WITI is set to the number of scheduled arrivals for that timeframe.";
                       rdfs:domain atd:AirportData;
                       rdfs:label "high wind WITI hourly";
                       rdfs:range xsd:float.
atd:hourlyPrecipitation a owl:DatatypeProperty;
                        rdfs:comment "Recorded hourly precipitation rate at the measurement station in inches.";
                        rdfs:domain atd:WeatherCondition;
                        rdfs:label "hourly precipitation";
                        rdfs:range xsd:float.
atd:limitedVisibilityDistance a owl:DatatypeProperty;
                              rdfs:comment "The visibility distance (in miles) at the reporting station. Only applicable if data:unlimitedVisibility is False.";
                              rdfs:domain atd:VisibilityCondition;
                              rdfs:label "limited visibility distance";
                              rdfs:range xsd:float;
                              rdfs:seeAlso atd:unlimitedVisibility.
atd:lowCeilingWITIdaily a owl:FunctionalProperty,
                          atd:WITIproperty;
                        rdfs:comment "The low ceiling weather impacted traffic index (WITI) computed for the airport during the specified timeframe (daily). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the ceiling at the airport is below a set threshold, then the low ceiling WITI is set to the number of scheduled arrivals for that timeframe.";
                        rdfs:domain atd:AirportData;
                        rdfs:label "low ceiling WITI daily";
                        rdfs:range xsd:float.
atd:lowCeilingWITIhourly a owl:FunctionalProperty,
                           atd:WITIproperty;
                         rdfs:comment "The low ceiling weather impacted traffic index (WITI) computed for the airport during the specified timeframe (hourly). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the ceiling at the airport is below a set threshold, then the low ceiling WITI is set to the number of scheduled arrivals for that timeframe.";
                         rdfs:domain atd:AirportData;
                         rdfs:label "low ceiling WITI hourly";
                         rdfs:range xsd:float.
atd:lowVisibilityWITIdaily a owl:FunctionalProperty,
                             atd:WITIproperty;
                           rdfs:comment "The low visibility weather impacted traffic index (WITI) computed for the airport during the specified timeframe (daily). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the visibility at the airport is below a set threshold, then the low visibility WITI is set to the number of scheduled arrivals for that timeframe.";
                           rdfs:domain atd:AirportData;
                           rdfs:label "low visibility WITI daily";
                           rdfs:range xsd:float.
atd:lowVisibilityWITIhourly a owl:FunctionalProperty,
                              atd:WITIproperty;
                            rdfs:comment "The low visibility weather impacted traffic index (WITI) computed for the airport during the specified timeframe (hourly). WITI is an estimate of the number of flights potentially impacted due to inclement weather based on the scheduled traffic demand for a defined geographic region of the air traffic system (in this case, an airport). If the visibility at the airport is below a set threshold, then the low visibility WITI is set to the number of scheduled arrivals for that timeframe.";
                            rdfs:domain atd:AirportData;
                            rdfs:label "low visibility WITI hourly";
                            rdfs:range xsd:float.
atd:metConditionProbability a owl:DatatypeProperty;
                            rdfs:comment "For a forecast meteorological condition, the percent probability associated with the forecast occurrence.";
                            rdfs:domain atd:MeteorologicalCondition;
                            rdfs:label "met condition probability";
                            rdfs:range xsd:float.
atd:metarReportModifier a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "Automation status information pertaining to a METAR report: AUTO indicates a fully automated report with no human intervention; COR indicates a corrected observation; no modifier indicates either human observer/reporter or automated report with human oversight.";
                        rdfs:domain atd:METARreport;
                        rdfs:label "metar report modifier";
                        rdfs:range xsd:string.
atd:metarReportString a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "Entire text of METAR report.";
                      rdfs:domain atd:METARreport;
                      rdfs:label "METAR report string";
                      rdfs:range xsd:string.
atd:metarReportType a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "METAR report type indicator specifies whether this report is a regularly scheduled hourly report (METAR) or a special unscheduled report (SPECI). SPECIs are issued more frequently than hourly when adverse weather conditions prevail.";
                    rdfs:domain atd:METARreport;
                    rdfs:label "metar report type";
                    rdfs:range xsd:string.
atd:metarStationHasPrecipitationSensor a owl:DatatypeProperty;
                                       rdfs:comment "A boolean value indicating whether the reporting METAR station has a precipitation sensor.";
                                       rdfs:domain atd:METARreport;
                                       rdfs:label "metar station has precipitation sensor";
                                       rdfs:range xsd:boolean.
atd:meteorologicalConditionStatus a owl:DatatypeProperty;
                                  rdfs:comment "An indicator of whether the meteorological condition is based on actual observations (observed) or on future projections (forecast).";
                                  rdfs:domain atd:MeteorologicalCondition;
                                  rdfs:label "meteorological condition status";
                                  rdfs:range xsd:string.
atd:oagArrivalDelay a owl:FunctionalProperty,
                      owl:DatatypeProperty;
                    rdfs:comment "Minutes of OAG (Official Airline Guide) based arrival delay in excess of 15 minutes.";
                    rdfs:domain atd:AirportData;
                    rdfs:label "OAG arrival delay";
                    rdfs:range xsd:integer.
atd:oagGateDepartureDelay a owl:FunctionalProperty,
                            owl:DatatypeProperty;
                          rdfs:comment "Minutes of OAG (Official Airline Guide) based gate departure delay in excess of 15 minutes.";
                          rdfs:domain atd:AirportData;
                          rdfs:label "OAG gate departure delay";
                          rdfs:range xsd:integer.
atd:rapidityOfWeatherChange a owl:DatatypeProperty;
                            rdfs:comment """Indicates how fast change is expected from the prior state to the forecast meteorological conditions: \"rapid\" , \"gradual\" , \"transient\".""";
                            rdfs:domain atd:TAFmeteorologicalCondition;
                            rdfs:label "rapidity of weather change";
                            rdfs:range xsd:string.
atd:runwayReportedOn a owl:ObjectProperty;
                     rdfs:comment "Associates a runway status report with the physical runway being measured.";
                     rdfs:domain atd:RunwayStatusData;
                     rdfs:label "runway reported on";
                     rdfs:range nas:PhysicalRunway.
atd:runwayStatus a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment "An indicator of whether the runway is open or closed during the specified period.";
                 rdfs:domain atd:RunwayStatusData;
                 rdfs:label "runway status";
                 rdfs:range xsd:string.
atd:runwaySurfaceFriction a owl:FunctionalProperty,
                            owl:DatatypeProperty;
                          rdfs:comment "The surface friction (mu) value of the runway for the specified period. Runway surface friction is directly relevant to the braking action which will be available to an aircraft decelerating after touch down, or after a decision to reject a take off.";
                          rdfs:domain atd:RunwayStatusData;
                          rdfs:label "runway surface friction (mu)";
                          rdfs:range xsd:float.
atd:runwayVisibleRange a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:comment "Links a visibility condition to a runway visible range measurement class instance.";
                       rdfs:domain atd:VisibilityCondition;
                       rdfs:label "runway visible range";
                       rdfs:range nas:RunwayVisibleRangeMeasurement.
atd:scheduledArrivals a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "Count of scheduled arrivals. (Most probably from OAG (Official Airline Guide))";
                      rdfs:domain atd:AirportData;
                      rdfs:label "scheduled arrivals";
                      rdfs:range xsd:integer.
atd:scheduledDepartures a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "Count of scheduled departures. (Most probably from OAG (Official Airline Guide))";
                        rdfs:domain atd:AirportData;
                        rdfs:label "scheduled departures";
                        rdfs:range xsd:integer.
atd:seaLevelPressure a owl:DatatypeProperty;
                     rdfs:comment "Sea level pressure measured under the associated meteorological conditions.";
                     rdfs:domain atd:MeteorologicalCondition;
                     rdfs:label "sea level pressure";
                     rdfs:range xsd:float.
atd:surfaceGustSpeed a owl:DatatypeProperty;
                     rdfs:comment "Surface gust speed measured under the associated surface wind conditions.";
                     rdfs:domain atd:SurfaceWindCondition;
                     rdfs:label "surface gust speed";
                     rdfs:range xsd:float.
atd:surfaceTemperature a owl:DatatypeProperty;
                       rdfs:comment "Surface temperature measured under the associated meteorological conditions.";
                       rdfs:domain atd:MeteorologicalCondition;
                       rdfs:label "surface temperature";
                       rdfs:range xsd:float.
atd:surfaceWindDirectionStatus a owl:DatatypeProperty;
                               rdfs:comment "Information about the direction of the wind, either fixed, varyingWithinRange, or variable.";
                               rdfs:domain atd:SurfaceWindCondition;
                               rdfs:label "surface wind direction status";
                               rdfs:range xsd:string.
atd:surfaceWindSpeed a owl:DatatypeProperty;
                     rdfs:comment "The speed in knots of the surface wind.";
                     rdfs:domain atd:SurfaceWindCondition;
                     rdfs:label "surface wind speed";
                     rdfs:range xsd:float.
atd:tafReportString a owl:DatatypeProperty;
                    rdfs:comment "The full text of the entire TAF report.";
                    rdfs:domain atd:TAFreport;
                    rdfs:label "taf report string";
                    rdfs:range xsd:string.
atd:tafReportType a owl:DatatypeProperty;
                  rdfs:comment "Type of Terminal Area Forecast (TAF) report: a routine report (TAF), an amended report (AMD), a corrected report (COR), or a delayed report (RTD). An amended TAF is issued when the current TAF no longer adequately describes the ongoing weather or the forecaster feels the TAF is not representative of the current or expected weather.";
                  rdfs:domain atd:TAFreport;
                  rdfs:label "taf report type";
                  rdfs:range xsd:string.
atd:topAltitude a owl:DatatypeProperty;
                rdfs:comment "The top altitude of a homogenous cloud layer.";
                rdfs:domain atd:CloudLayer;
                rdfs:label "top altitude";
                rdfs:range xsd:integer.
atd:totalAirborneDelay a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "Total airborne flight delay in minutes for this airport during the specified period.";
                       rdfs:domain atd:AirportData;
                       rdfs:label "total airborne delay";
                       rdfs:range xsd:float.
atd:unlimitedVisibility a owl:DatatypeProperty;
                        rdfs:comment "A binary property indicating whether the visibility conditions are unlimited.";
                        rdfs:domain atd:VisibilityCondition;
                        rdfs:label "unlimited visibility";
                        rdfs:range xsd:boolean.
atd:weatherIntensity a owl:DatatypeProperty;
                     rdfs:comment "An indicator of the intensity of the weather: light, moderate, heavy.";
                     rdfs:domain atd:WeatherCondition;
                     rdfs:label "weather intensity";
                     rdfs:range xsd:string.
atd:weatherPhenomenon a owl:DatatypeProperty;
                      rdfs:comment "Describes the type of weather phenomena experienced during the specified period: drizzle, rain, snow, snow grains, ice crystals, ice pellets, hail, small hail and/or snow pellets, unknown precipitation, mist, fog, smoke, volcanic ash, widespread dust, sand, haze, spray, well-developed dust/sand whirls, squalls, funnel cloud, tornado/waterspout, sandstorm, duststorm";
                      rdfs:domain atd:WeatherCondition;
                      rdfs:label "weather phenomenon";
                      rdfs:range xsd:string.
atd:weatherProximity a owl:DatatypeProperty;
                     rdfs:comment "Describes the location of the weather phenomena in relation to the reporting station: immediate proximity or in vicinity.";
                     rdfs:domain atd:WeatherCondition;
                     rdfs:label "weather proximity";
                     rdfs:range xsd:string.
atd:weatherQualifier a owl:DatatypeProperty;
                     rdfs:comment "An additional qualifier describing the reported weather phenomenon: shallow, partial, patchy, low drifting, blowing, shower, thunderstorm, freezing.";
                     rdfs:domain atd:WeatherCondition;
                     rdfs:label "weather qualifier";
                     rdfs:range xsd:string.
atd:windDirectionFixed a owl:DatatypeProperty;
                       rdfs:comment "Steady wind direction (in degrees), when winds are fixed and not variable.";
                       rdfs:domain atd:SurfaceWindCondition;
                       rdfs:label "fixed wind direction";
                       rdfs:range xsd:float.
atd:windDirectionLower a owl:DatatypeProperty;
                       rdfs:comment "Lower bound (in degrees) of two bounding values describing a variable wind direction.";
                       rdfs:domain atd:SurfaceWindCondition;
                       rdfs:label "lower wind direction";
                       rdfs:range xsd:float.
atd:windDirectionUpper a owl:DatatypeProperty;
                       rdfs:comment "Upper bound (in degrees) of two bounding values describing a variable wind direction.";
                       rdfs:domain atd:SurfaceWindCondition;
                       rdfs:label "lower wind direction";
                       rdfs:range xsd:float.
atd:windShearHeight a owl:DatatypeProperty;
                    rdfs:comment "The height in hundreds of feet above ground level associated with a wind shear phenomenon.";
                    rdfs:domain atd:SurfaceWindCondition;
                    rdfs:label "wind shear height";
                    rdfs:range xsd:float.
