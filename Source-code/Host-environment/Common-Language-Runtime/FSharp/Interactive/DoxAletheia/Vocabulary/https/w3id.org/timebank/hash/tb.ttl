<https://w3id.org/timebank> <http://purl.org/dc/elements/1.1/title> "Timebank Ontology";
                            <http://purl.org/dc/terms/created> "2020-04-01";
                            <http://purl.org/dc/terms/creator> "Xueer Li",
                                                               "Subhayan Roy",
                                                               "Tobias Grubenmann",
                                                               "Ankit Tibrewal";
                            <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
                            <http://purl.org/dc/terms/rights> "Copyright © 2020 The University of Hong Kong";
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "tb";
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/timebank";
                            a <http://www.w3.org/2002/07/owl#Ontology>;
                            rdfs:comment "An ontology to describe poeple and requests for timebanks. This includes the poeple's skills, limitations, and environment.";
                            <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/2006/time#>,
                                                                    <http://www.w3.org/2004/02/skos/core#>,
                                                                    <http://xmlns.com/foaf/0.1/>;
                            <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/timebank/0.2>;
                            <http://www.w3.org/2002/07/owl#versionInfo> 0.2;
                            <https://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/>.
tb:Accessibility a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Describes any revelant information regarding the accessibility of a location of a request.";
                 rdfs:isDefinedBy <https://w3id.org/timebank>;
                 rdfs:label "Accessibility";
                 rdfs:subClassOf tb:Environment;
                 <http://www.w3.org/2002/07/owl#disjointWith> tb:Supplies;
                 <http://www.w3.org/2004/02/skos/core#broaderTransitive> tb:Environment;
                 <http://www.w3.org/2004/02/skos/core#exactMatch> <http://dbpedia.org/resource/Accessibility>.
tb:AccessibleByPublicTransport a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The location is accessible by public transport.";
                               rdfs:isDefinedBy <https://w3id.org/timebank>;
                               rdfs:label "Accessible by Public Transport";
                               rdfs:subClassOf tb:Accessibility;
                               <http://www.w3.org/2004/02/skos/core#broaderTransitive> tb:Accessibility;
                               <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://dbpedia.org/resource/Public_transport>.
tb:AddressPart a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An address part indicates part of an address like region, city, etc. If two places share the same address part, they also share the same environmental factors.";
               rdfs:isDefinedBy <https://w3id.org/timebank>;
               rdfs:label "Address Part";
               <http://www.w3.org/2002/07/owl#disjointWith> tb:Level,
                                                            tb:Request,
                                                            tb:Limitation,
                                                            tb:Environment,
                                                            tb:Status,
                                                            tb:Skill.
tb:Advice a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Skills to provide particular services which requires some sort of education or training.";
          rdfs:isDefinedBy <https://w3id.org/timebank>;
          rdfs:label "Advice";
          rdfs:subClassOf tb:Skill;
          <http://www.w3.org/2004/02/skos/core#broaderTransitive> tb:Skill;
          <http://www.w3.org/2004/02/skos/core#closeMatch> <http://dbpedia.org/resource/Category:Consulting>.
tb:Allergy a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A collection of allergies, which is caused by hypersensitivity of the immune system.";
           rdfs:isDefinedBy <https://w3id.org/timebank>;
           rdfs:label "Allergy";
           rdfs:subClassOf tb:Limitation;
           <http://www.w3.org/2004/02/skos/core#broaderTransitive> tb:Limitation;
           <http://www.w3.org/2004/02/skos/core#exactMatch> <http://dbpedia.org/resource/Allergy>;
