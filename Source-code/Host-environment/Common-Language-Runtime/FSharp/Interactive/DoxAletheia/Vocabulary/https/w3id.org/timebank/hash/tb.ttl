w3id:timebank dc11:title "Timebank Ontology";
              dcterms:created "2020-04-01";
              dcterms:creator "Xueer Li",
                              "Subhayan Roy",
                              "Tobias Grubenmann",
                              "Ankit Tibrewal";
              dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
              dcterms:rights "Copyright © 2020 The University of Hong Kong";
              vann:preferredNamespacePrefix "tb";
              vann:preferredNamespaceUri "https://w3id.org/timebank";
              a owl:Ontology;
              rdfs:comment "An ontology to describe poeple and requests for timebanks. This includes the poeple's skills, limitations, and environment.";
              owl:imports time:,
                          skos:,
                          foaf:;
              owl:versionIRI <https://w3id.org/timebank/0.2>;
              owl:versionInfo 0.2;
              <https://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/>.
tb:Accessibility a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "Describes any revelant information regarding the accessibility of a location of a request.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Accessibility";
                 rdfs:subClassOf tb:Environment;
                 owl:disjointWith tb:Supplies;
                 skos:broaderTransitive tb:Environment;
                 skos:exactMatch resource:Accessibility.
tb:AccessibleByPublicTransport a owl:NamedIndividual,
                                 owl:Class;
                               rdfs:comment "The location is accessible by public transport.";
                               rdfs:isDefinedBy w3id:timebank;
                               rdfs:label "Accessible by Public Transport";
                               rdfs:subClassOf tb:Accessibility;
                               skos:broaderTransitive tb:Accessibility;
                               skos:relatedMatch resource:Public_transport.
tb:AddressPart a owl:Class;
               rdfs:comment "An address part indicates part of an address like region, city, etc. If two places share the same address part, they also share the same environmental factors.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Address Part";
               owl:disjointWith tb:Level,
                                tb:Request,
                                tb:Limitation,
                                tb:Environment,
                                tb:Status,
                                tb:Skill.
tb:Advice a owl:NamedIndividual,
            owl:Class;
          rdfs:comment "Skills to provide particular services which requires some sort of education or training.";
          rdfs:isDefinedBy w3id:timebank;
          rdfs:label "Advice";
          rdfs:subClassOf tb:Skill;
          skos:broaderTransitive tb:Skill;
          skos:closeMatch resource:Category:Consulting.
tb:Allergy a owl:NamedIndividual,
             owl:Class;
           rdfs:comment "A collection of allergies, which is caused by hypersensitivity of the immune system.";
           rdfs:isDefinedBy w3id:timebank;
           rdfs:label "Allergy";
           rdfs:subClassOf tb:Limitation;
           skos:broaderTransitive tb:Limitation;
           skos:exactMatch resource:Allergy;
           skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/T78.4>.
tb:Assembling a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "The skill to assemble items like furniture and other things.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Assembling";
              rdfs:subClassOf tb:Crafting;
              skos:broaderTransitive tb:Crafting.
tb:AutomobileRepair a owl:NamedIndividual,
                      owl:Class;
                    rdfs:comment "The skill to repair automobiles.";
                    rdfs:isDefinedBy w3id:timebank;
                    rdfs:label "Automobile Repair";
                    rdfs:subClassOf tb:Repair;
                    skos:broaderTransitive tb:Repair;
                    skos:relatedMatch resource:Auto_mechanic.
tb:Baking a owl:NamedIndividual,
            owl:Class;
          rdfs:comment "The skill to assist with baking.";
          rdfs:isDefinedBy w3id:timebank;
          rdfs:label "Baking";
          rdfs:subClassOf tb:FoodService;
          skos:broaderTransitive tb:FoodService;
          skos:exactMatch resource:Baking.
tb:Carpeting a owl:NamedIndividual,
               owl:Class;
             rdfs:comment "The skill to do carpenting.";
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "Carpenting";
             rdfs:subClassOf tb:WoodCrafting;
             owl:disjointWith tb:WoodCarving;
             skos:broaderTransitive tb:WoodCrafting;
             skos:exactMatch resource::Carpentry.
tb:Catering a owl:NamedIndividual,
              owl:Class;
            rdfs:comment "The skill to assist with catering requirements.";
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "Catering";
            rdfs:subClassOf tb:FoodService;
            skos:broaderTransitive tb:FoodService;
            skos:exactMatch resource:Catering.
tb:Cats a owl:NamedIndividual,
          owl:Class;
        rdfs:comment "Indicates that cats might be present.";
        rdfs:isDefinedBy w3id:timebank;
        rdfs:label "Cats";
        rdfs:subClassOf tb:Pets;
        skos:broaderTransitive tb:Pets;
        skos:exactMatch resource:Cat.
tb:ChildCare a owl:NamedIndividual,
               owl:Class;
             rdfs:comment "The skill to provide care for children.";
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "Child Care";
             rdfs:subClassOf tb:PeopleCare;
             skos:broaderTransitive tb:PeopleCare;
             skos:exactMatch resource:Child_care.
tb:Cleaning a owl:NamedIndividual,
              owl:Class;
            rdfs:comment "The skill to assist with general cleaning tasks.";
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "Cleaning";
            rdfs:subClassOf tb:Maintenance;
            skos:broaderTransitive tb:Maintenance;
            skos:exactMatch resource:Category:Cleaning.
tb:ClimbingStairsDifficulty a owl:NamedIndividual,
                              owl:Class;
                            rdfs:comment "The person has difficulty in climbing up stairs.";
                            rdfs:isDefinedBy w3id:timebank;
                            rdfs:label "Difficulty in Climbing Stairs";
                            rdfs:subClassOf tb:MobilityProblem;
                            skos:broaderTransitive tb:MobilityProblem;
                            skos:relatedMatch <http://who.int/icf#d450-d469>,
                                              sct:129016000.
tb:ClothesWashing a owl:NamedIndividual,
                    owl:Class;
                  rdfs:comment "The skill to assist with washing clothes.";
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "Clothes Washing";
                  rdfs:subClassOf tb:Cleaning;
                  owl:disjointWith tb:Mopping;
                  skos:broaderTransitive tb:Cleaning;
                  skos:closeMatch resource:Washing.
tb:CognitiveImpairment a owl:NamedIndividual,
                         owl:Class;
                       rdfs:comment "A person with cognitive impairment can't think and remember things clearly.";
                       rdfs:isDefinedBy w3id:timebank;
                       rdfs:label "Cognitive Impairment";
                       rdfs:subClassOf tb:MentalDisorder;
                       skos:broaderTransitive tb:MentalDisorder;
                       skos:exactMatch resource:Cognitive_deficit;
                       skos:relatedMatch <http://who.int/icf#b164>,
                                         <http://purl.bioontology.org/ontology/ICD10/F06.7>,
                                         sct:110352000.
tb:CommonDisease a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "A collection of diseases that are common, especially for elderly people";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Common Disease";
                 rdfs:subClassOf tb:Limitation;
                 skos:broaderTransitive tb:Limitation.
tb:ComputerProcessing a owl:NamedIndividual,
                        owl:Class;
                      rdfs:comment "The skill to assist with processing data computers.";
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "Computer Processing";
                      rdfs:subClassOf tb:OfficeWork;
                      skos:broaderTransitive tb:OfficeWork;
                      skos:exactMatch resource:Computer_skills.
tb:ComputerRepair a owl:NamedIndividual,
                    owl:Class;
                  rdfs:comment "The skill to fix problems with computers.";
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "Computer Repair";
                  rdfs:subClassOf tb:Repair;
                  skos:broaderTransitive tb:Repair;
                  skos:relatedMatch resource:Computer_repair_technician.
tb:Cooking a owl:NamedIndividual,
             owl:Class;
           rdfs:comment "The skill to assist with cooking in general.";
           rdfs:isDefinedBy w3id:timebank;
           rdfs:label "Cooking";
           rdfs:subClassOf tb:FoodService;
           skos:broaderTransitive tb:FoodService;
           skos:exactMatch resource:Cooking.
tb:Counseling a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "The skill to advice people on psychological matters.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Counseling";
              rdfs:subClassOf tb:Advice;
              skos:broaderTransitive tb:Advice;
              skos:exactMatch resource:Category:Counseling.
tb:Crafting a owl:NamedIndividual,
              owl:Class;
            rdfs:comment "Crafting skills.";
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "Crafting";
            rdfs:subClassOf tb:Skill;
            skos:broaderTransitive tb:Skill;
            skos:closeMatch resource:Craft.
tb:CraftingClothes a owl:NamedIndividual,
                     owl:Class;
                   rdfs:comment "The ability to craft any kind of clothes.";
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "Crafting Clothes";
                   rdfs:subClassOf tb:Crafting;
                   skos:broaderTransitive tb:Crafting.
tb:DancingCompanion a owl:NamedIndividual,
                      owl:Class;
                    rdfs:comment "The ability to act as a dancing companion.";
                    rdfs:isDefinedBy w3id:timebank;
                    rdfs:label "Dancing Companion";
                    rdfs:subClassOf tb:Recreation;
                    skos:broaderTransitive tb:Recreation;
                    skos:relatedMatch resource:Dance.
tb:Depression a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "A person with depression has a depressed mood over a long period and may even have thoughts of suicide.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Depression";
              rdfs:subClassOf tb:MentalDisorder;
              skos:broaderTransitive tb:MentalDisorder;
              skos:closeMatch <http://purl.bioontology.org/ontology/ICD10/F32>;
              skos:exactMatch <http://dbpedia.org/resource/Depression_(mood)>;
              skos:narrowMatch sct:154966009,
                               sct:154965008,
                               sct:154967000.
tb:Diabetes a owl:Class,
              owl:NamedIndividual;
            rdfs:comment "A disorder characterized by high blood sugar levels during a long period.";
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "Diabetes Mellitus";
            rdfs:subClassOf tb:CommonDisease;
            skos:broaderTransitive tb:CommonDisease;
            skos:exactMatch <http://purl.bioontology.org/ontology/ICD10/E10-E14.9>,
                            sct:191044006,
                            resource:Diabetes_mellitus.
tb:Dishwashing a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "The skill to assist with washing dishes.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Dishwashing";
               rdfs:subClassOf tb:FoodService;
               skos:broaderTransitive tb:FoodService;
               skos:exactMatch resource:Dishwashing.
tb:Dogs a owl:NamedIndividual,
          owl:Class;
        rdfs:comment "Indicates that dogs might be present.";
        rdfs:isDefinedBy w3id:timebank;
        rdfs:label "Dogs";
        rdfs:subClassOf tb:Pets;
        skos:broaderTransitive tb:Dogs;
        skos:exactMatch resource:Dog.
tb:DressingAssistance a owl:NamedIndividual,
                        owl:Class;
                      rdfs:comment "The skill to assist someone with dressing.";
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "Dressing Assistance";
                      rdfs:subClassOf tb:PersonalService;
                      skos:broaderTransitive tb:PersonalService.
tb:DressingProblem a owl:NamedIndividual,
                     owl:Class;
                   rdfs:comment "The person has difficulties dressing himself.";
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "Dressing Problem";
                   rdfs:subClassOf tb:MobilityProblem;
                   skos:broaderTransitive tb:MobilityProblem;
                   skos:relatedMatch <http://who.int/icf#d5400>,
                                     sct:129039006.
tb:DrivingCars a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "Experience in driving cars.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Driving Cars";
               rdfs:subClassOf tb:DrivingLightVehicles;
               owl:disjointWith tb:DrivingVans;
               skos:broaderTransitive tb:DrivingLightVehicles;
               skos:relatedMatch resource:Automobile.
tb:DrivingHeavyVehicles a owl:NamedIndividual,
                          owl:Class;
                        rdfs:comment "Experience in driving heavy vehicles.";
                        rdfs:isDefinedBy w3id:timebank;
                        rdfs:label "Driving Heavy Vehicles";
                        rdfs:subClassOf tb:Transportation;
                        owl:disjointWith tb:DrivingLightVehicles;
                        skos:broaderTransitive tb:Transportation.
tb:DrivingLightVehicles a owl:NamedIndividual,
                          owl:Class;
                        rdfs:comment "Experience in driving light vehicles.";
                        rdfs:isDefinedBy w3id:timebank;
                        rdfs:label "Driving Light Vehicles";
                        rdfs:subClassOf tb:Transportation;
                        skos:broaderTransitive tb:Transportation.
tb:DrivingTractors a owl:NamedIndividual,
                     owl:Class;
                   rdfs:comment "Experience in driving tractors.";
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "Driving Tractors";
                   rdfs:subClassOf tb:DrivingHeavyVehicles;
                   skos:broaderTransitive tb:DrivingHeavyVehicles;
                   skos:relatedMatch resource:Tractor.
tb:DrivingTrucks a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "Experience in driving with trucks.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Driving Trucks";
                 rdfs:subClassOf tb:DrivingHeavyVehicles;
                 skos:broaderTransitive tb:DrivingHeavyVehicles;
                 skos:relatedMatch resource:Truck.
tb:DrivingVans a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "Experience in driving vans.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Driving Vans";
               rdfs:subClassOf tb:DrivingLightVehicles;
               skos:broaderTransitive tb:DrivingLightVehicles;
               skos:relatedMatch resource:Automobile.
tb:DrivingWithTrailers a owl:NamedIndividual,
                         owl:Class;
                       rdfs:comment "Experience in driving with trailers.";
                       rdfs:isDefinedBy w3id:timebank;
                       rdfs:label "Driving with Trailers";
                       rdfs:subClassOf tb:DrivingHeavyVehicles;
                       skos:broaderTransitive tb:DrivingHeavyVehicles;
                       skos:relatedMatch <http://dbpedia.org/resource/Trailer_(vehicle)>.
tb:DrugAllergy a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "An allergy to drugs.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Drug Allergy";
               rdfs:subClassOf tb:Allergy;
               skos:broaderTransitive tb:Allergy;
               skos:exactMatch sct:93431001,
                               resource:Drug_allergy;
               skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/Z88>.
tb:EggAllergy a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "Allergy to eggs.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Egg Allergy";
              rdfs:subClassOf tb:FoodAllergy;
              skos:broaderTransitive tb:FoodAllergy;
              skos:exactMatch resource:Egg_allergy,
                              sct:157802003;
              skos:relatedMatch sct:138050005.
tb:ElderlyCare a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "The skill to provide care and support for the elderly.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Care for Elderly";
               rdfs:subClassOf tb:PeopleCare;
               skos:broaderTransitive tb:PeopleCare;
               skos:exactMatch resource:Elderly_care.
tb:Electricity a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "Electric outlet available.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Electricity";
               rdfs:subClassOf tb:Supplies;
               skos:broaderTransitive tb:Supplies;
               skos:relatedMatch resource:Electricity.
tb:ElectronicRepair a owl:NamedIndividual,
                      owl:Class;
                    rdfs:comment "The skill to repair electronic devices.";
                    rdfs:isDefinedBy w3id:timebank;
                    rdfs:label "Electronic Repair";
                    rdfs:subClassOf tb:Repair;
                    skos:broaderTransitive tb:Repair.
tb:Environment a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "The environment describes relevant environmental factors of a request.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Environment";
               owl:disjointWith tb:Request,
                                tb:Limitation,
                                tb:Status,
                                tb:Skill,
                                tb:User,
                                tb:Level.
tb:EnvironmentalAllergy a owl:NamedIndividual,
                          owl:Class;
                        rdfs:comment "An allergy to something in the environment such as dust mites, pollen, pet hair and cigarette smoke.";
                        rdfs:isDefinedBy w3id:timebank;
                        rdfs:label "Environmental Allergy";
                        rdfs:subClassOf tb:Allergy;
                        skos:broaderTransitive tb:Allergy;
                        skos:exactMatch sct:426232007.
tb:EventPlanning a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "The skill to assist in planning and hosting events.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Event Planning";
                 rdfs:subClassOf tb:Recreation;
                 skos:broaderTransitive tb:Recreation;
                 skos:closeMatch resource:Event_planning.
tb:FearOfAnimals a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "Fear of animals. This can include dogs, cats, snakes, insects, etc.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Fear of Animals";
                 rdfs:subClassOf tb:SpecificPhobia;
                 skos:broaderTransitive tb:SpecificPhobia;
                 skos:exactMatch sct:54307006,
                                 resource:Zoophobia.
tb:FearOfCats a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "Fear of cats.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Fear of Cats";
              rdfs:subClassOf tb:FearOfAnimals;
              owl:disjointWith tb:FearOfDogs;
              skos:broaderTransitive tb:FearOfAnimals;
              skos:exactMatch resource:Ailurophobia.
tb:FearOfDark a owl:NamedIndividual,
                owl:Class;
              rdfs:comment "Fear of dark places.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Fear of Dark";
              rdfs:subClassOf tb:SpecificPhobia;
