          rdfs:comment "The status of a request.";
          rdfs:isDefinedBy w3id:timebank;
          rdfs:label "Status";
          owl:disjointWith tb:User.
tb:StatusAssigned a tb:Status,
                    owl:NamedIndividual;
                  rdfs:comment "Indicates that a request is assigned to a helper but not yet completed.";
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "Status: Assigned".
tb:StatusCancelled a tb:Status,
                     owl:NamedIndividual;
                   rdfs:comment "Indicates that a request is cancelled and no helper is needed anymore.";
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "Status: Cancelled".
tb:StatusClosed a tb:Status,
                  owl:NamedIndividual;
                rdfs:comment "Indicates that a request is closed and that no helper is needed anymore.";
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "Status: Closed".
tb:StatusOpen a tb:Status,
                owl:NamedIndividual;
              rdfs:comment "Indicates that a request is open and no helper is assigned to it.";
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "Status: Open".
tb:StrokeHistory a owl:Class,
                   owl:NamedIndividual;
                 rdfs:comment "It indicates a person once had a storke. A stroke happens when blood flow to the brain is blocked and oxygen for the brain cells is insufficient, which could leads to cell death.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "History of Strokes";
                 rdfs:subClassOf tb:CommonDisease;
                 skos:broaderTransitive tb:CommonDisease;
                 skos:exactMatch sct:138787005;
                 skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/I60-I69.9>,
                                   resource:Stroke.
tb:Supplies a owl:NamedIndividual,
              owl:Class;
            rdfs:comment "Availability of specific supplies to complete a task.";
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "Supplies";
            rdfs:subClassOf tb:Environment;
            skos:broaderTransitive tb:Environment.
tb:Tailoring a owl:NamedIndividual,
               owl:Class;
             rdfs:comment "Specialized in providing tailoring services.";
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "Tailoring";
             rdfs:subClassOf tb:CraftingClothes;
             skos:broaderTransitive tb:CraftingClothes;
             skos:relatedMatch resource:Tailor.
tb:ToiletUsingProblem a owl:NamedIndividual,
                        owl:Class;
                      rdfs:comment "The person has difficulties using toilet.";
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "Toilet Using Problem";
                      rdfs:subClassOf tb:MobilityProblem;
                      skos:broaderTransitive tb:MobilityProblem;
                      skos:relatedMatch <http://who.int/icf#d530>,
                                        sct:129045003.
tb:Tools a owl:NamedIndividual,
           owl:Class;
         rdfs:comment "Tools can be provided.";
         rdfs:isDefinedBy w3id:timebank;
         rdfs:label "Tools";
         rdfs:subClassOf tb:Supplies;
         skos:broaderTransitive tb:Supplies;
         skos:relatedMatch resource:Tool.
tb:Transportation a owl:NamedIndividual,
                    owl:Class;
                  rdfs:comment "The skill to provide services related to transportation.";
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "TransportationServices";
                  rdfs:subClassOf tb:Skill;
                  skos:broaderTransitive tb:Skill;
                  skos:relatedMatch resource:Transport.
tb:TransportationAvailable a owl:NamedIndividual,
                             owl:Class;
                           rdfs:comment "Transportation necessary to complete the task can be provided.";
                           rdfs:isDefinedBy w3id:timebank;
                           rdfs:label "Transportation Available";
                           rdfs:subClassOf tb:Accessibility;
                           skos:broaderTransitive tb:Accessibility;
                           skos:relatedMatch resource:Transport.
tb:TravelCompanion a owl:NamedIndividual,
                     owl:Class;
                   rdfs:comment "The ability to act as a travel companion.";
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "Travel Companion";
                   rdfs:subClassOf tb:Recreation;
                   skos:broaderTransitive tb:Recreation;
                   skos:relatedMatch resource:Travel.
tb:UnevenTerrain a owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment "The person needs equipment (e.g. shoes) suitable for uneven terrain.";
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "Uneven Terrain";
                 rdfs:subClassOf tb:Accessibility;
                 skos:broaderTransitive tb:Accessibility.
tb:User a owl:Class;
        rdfs:comment "A user of the Timebank.";
        rdfs:isDefinedBy w3id:timebank;
        rdfs:label "User";
        rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         owl:onProperty tb:hasTimeBalance ; 
                         a owl:Restriction],
                        foaf:Person.
tb:WalkingProblem a owl:NamedIndividual,
                    owl:Class;
                  rdfs:comment "The person has difficulties walking.";
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "Walking Problem";
                  rdfs:subClassOf tb:MobilityProblem;
                  skos:broaderTransitive tb:MobilityProblem;
                  skos:exactMatch sct:156615004;
                  skos:relatedMatch <http://purl.bioontology.org/ontology/ICD10/R26.2>,
                                    <http://who.int/icf#d450-d469>.
tb:Water a owl:NamedIndividual,
           owl:Class;
         rdfs:comment "Water outlet is available.";
         rdfs:isDefinedBy w3id:timebank;
         rdfs:label "Water";
         rdfs:subClassOf tb:Supplies;
         skos:broaderTransitive tb:Supplies;
         skos:exactMatch resource:Water_supply.
tb:WeatherConstraint a owl:NamedIndividual,
                       owl:Class;
                     rdfs:comment "The place is difficult to access during bad weather (e.g. snow).";
                     rdfs:isDefinedBy w3id:timebank;
                     rdfs:label "Weather Constraint";
                     rdfs:subClassOf tb:Accessibility;
                     skos:broaderTransitive tb:Accessibility;
                     skos:relatedMatch resource:Meteorology.
tb:WoodCarving a owl:NamedIndividual,
                 owl:Class;
               rdfs:comment "The skill to Carve items out of wood.";
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "Wood Carving";
               rdfs:subClassOf tb:WoodCrafting;
               skos:broaderTransitive tb:WoodCrafting;
               skos:exactMatch resource:Category:Woodcarving.
tb:WoodCrafting a owl:NamedIndividual,
                  owl:Class;
                rdfs:comment "Crafting skill with wood as base material.";
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "Wood Crafting";
                rdfs:subClassOf tb:Crafting;
                skos:broaderTransitive tb:Crafting;
                skos:exactMatch resource:Woodworking.
tb:Writing a owl:NamedIndividual,
             owl:Class;
           rdfs:comment "The skill to assist with written work, like writing or reading a letter.";
           rdfs:isDefinedBy w3id:timebank;
           rdfs:label "Writing";
           rdfs:subClassOf tb:OfficeWork;
           skos:broaderTransitive tb:OfficeWork;
           skos:exactMatch resource:Category:Writing.
tb:accepts a owl:ObjectProperty;
           rdfs:comment "Indicates that a user who is willing to help accepted the request.";
           rdfs:domain tb:User;
           rdfs:isDefinedBy w3id:timebank;
           rdfs:label "accepts";
           rdfs:range tb:Request;
           owl:inverseOf tb:isAcceptedBy.
tb:endsRepeatingOn a owl:ObjectProperty;
                   rdfs:comment "Indicates that a time-interval is repeating until this time and date.";
                   rdfs:domain time:ProperInterval;
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "ends repeating on";
                   rdfs:range time:Instant;
                   owl:inverseOf tb:isRepeatingEndpointOf.
tb:excludesUserByLimitation a owl:ObjectProperty;
                            rdfs:comment "This property is used to describe that a request exludes helpers having a certain limitation.";
                            rdfs:domain tb:Request;
                            rdfs:isDefinedBy w3id:timebank;
                            rdfs:label "excludes user by limitation";
                            rdfs:range tb:Limitation;
                            owl:inverseOf tb:excludesUserFrom.
tb:excludesUserFrom a owl:ObjectProperty;
                    rdfs:comment "This property is used to describe that a certain limitation excludes certain helpers from the request.";
                    rdfs:domain tb:Limitation;
                    rdfs:isDefinedBy w3id:timebank;
                    rdfs:label "excludes user from";
                    rdfs:range tb:Request.
tb:hasAccreditedDuration a owl:ObjectProperty;
                         rdfs:comment "The accredited duration of the request. This is the amount of time which will be transferred from the originator the the assigned helper of the request. Do not use this property to indicate the estimated duration of the task. Use hasExpectedDuration instead.";
                         rdfs:domain tb:Request;
                         rdfs:isDefinedBy w3id:timebank;
                         rdfs:label "has accredited duration";
                         rdfs:range time:DurationDescription;
                         owl:inverseOf tb:isAccreditedTo.
tb:hasAddressPart a owl:ObjectProperty;
                  rdfs:comment "An address part that describes the location of a specific request.";
                  rdfs:domain tb:Request;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "has address part";
                  rdfs:range tb:AddressPart;
                  owl:inverseOf tb:isAdressPartOf;
                  owl:propertyChainAxiom ().
tb:hasEnvironment a owl:ObjectProperty;
                  rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor.";
                  rdfs:domain tb:AddressPart;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "has environment";
                  rdfs:range tb:Environment;
                  owl:inverseOf tb:isEnvironmentOf.
tb:hasExpectedDuration a owl:ObjectProperty;
                       rdfs:comment "The expected duration indicates the duraction of the request estimated by the originator of the request. Do not use this property to assert the actual time credits associated to this request. Use hasAccreditedDuration instead.";
                       rdfs:domain tb:Request;
                       rdfs:isDefinedBy w3id:timebank;
                       rdfs:label "has expected duration";
                       rdfs:range time:DurationDescription;
                       owl:inverseOf tb:isExpectedDurationOf.
tb:hasLimitation a owl:ObjectProperty;
                 rdfs:comment "Indicates that a Timebank user suffers from a certain limitation.";
                 rdfs:domain tb:User;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "has limitation";
                 rdfs:range tb:Limitation;
                 owl:inverseOf tb:isLimitationOf.
tb:hasNotEnvironment a owl:ObjectProperty;
                     rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor.";
                     rdfs:domain tb:AddressPart;
                     rdfs:isDefinedBy w3id:timebank;
                     rdfs:label "has not environment";
                     rdfs:range tb:Environment;
                     owl:inverseOf tb:isNotEnvironmentOf.
tb:hasOriginator a owl:ObjectProperty;
                 rdfs:comment "Indicates that the request has the specific originator.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "has originator";
                 rdfs:range tb:User;
                 owl:inverseOf tb:isOriginatorOf.
tb:hasSeverity a owl:ObjectProperty;
               rdfs:comment "Indicates the severity of a limitation.";
               rdfs:domain tb:Limitation;
               rdfs:isDefinedBy w3id:timebank;
               rdfs:label "has severity";
               rdfs:range tb:Level;
               owl:inverseOf tb:isSeverityOf.
tb:hasSkill a owl:ObjectProperty;
            rdfs:comment "Describes the Skill of a certain Timebank user.";
            rdfs:domain tb:User;
            rdfs:isDefinedBy w3id:timebank;
            rdfs:label "has skill";
            rdfs:range tb:Skill;
            owl:inverseOf tb:isSkillOf.
tb:hasSkillLevel a owl:ObjectProperty;
                 rdfs:comment "Describes the proficiency level of a skill.";
                 rdfs:domain tb:Skill;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "has skill level";
                 rdfs:range tb:Level;
                 owl:inverseOf tb:isSkillLevelOf.
tb:hasStatus a owl:ObjectProperty;
             rdfs:comment "Every request can have at most one status assigned to it.";
             rdfs:domain tb:Request;
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "has status";
             rdfs:range tb:Status;
             owl:inverseOf tb:isStatusOf.
tb:hasSubPart a owl:TransitiveProperty,
                owl:ObjectProperty;
              rdfs:comment "Indicates that the address part is a sub-part of another. A sub-part defines a place more precisely. A sub-part is always in the context of its super-part. For example, a streetnumber is a sub- part of the street.",
                           w3id:timebank;
              rdfs:domain tb:AddressPart;
              rdfs:label "has sub-part";
              rdfs:range tb:AddressPart;
              owl:inverseOf tb:isSubPartOf.
tb:hasTimeBalance a owl:ObjectProperty;
                  rdfs:comment "Indicates the current time-balance of a Timebank user.";
                  rdfs:domain tb:User;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "has time-balance";
                  rdfs:range time:DurationDescription;
                  owl:inverseOf tb:isTimeBalanceOf.
tb:hasTimeWindow a owl:ObjectProperty;
                 rdfs:comment "Indicates the time window in which the request can/should be completed.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "has time window";
                 rdfs:range time:ProperInterval;
                 owl:inverseOf tb:isTimeWindowOf.
tb:isAcceptanceDateOf a owl:ObjectProperty;
                      rdfs:comment "Indicates the time and date when the Timebank request was accepted by the assigned helper.";
                      rdfs:domain time:Instant;
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "is acceptance date of";
                      rdfs:range tb:Request;
                      owl:inverseOf tb:isAcceptedOn.
tb:isAcceptedBy a owl:ObjectProperty;
                rdfs:comment "Indicates that a request is accepted by a user who is willing to help completing the request.";
                rdfs:domain tb:Request;
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "is accepted by";
                rdfs:range tb:User.
tb:isAcceptedOn a owl:ObjectProperty;
                rdfs:comment "Indicates the time and date when the Timebank request was accepted by the assigned helper.";
                rdfs:domain tb:Request;
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "is accepted on";
                rdfs:range time:Instant.
tb:isAccreditedTo a owl:ObjectProperty;
                  rdfs:comment "The accredited duration of the request. This is the amount of time which will be transferred from the originator the the assigned helper of the request. Do not use this property to indicate the estimated duration of the task. Use hasExpectedDuration instead.";
                  rdfs:domain time:DurationDescription;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is accredited to";
                  rdfs:range tb:Request.
tb:isAdressPartOf a owl:ObjectProperty;
                  rdfs:comment "An address part that describes the location of a specific request.";
                  rdfs:domain tb:AddressPart;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is adress part of";
                  rdfs:range tb:Request.
tb:isAvailabilityOf a owl:ObjectProperty;
                    rdfs:comment "Indicates the availability of a Timebank user to act as a helper for a Timebank request.";
                    rdfs:domain time:ProperInterval;
                    rdfs:isDefinedBy w3id:timebank;
                    rdfs:label "is availability of";
                    rdfs:range tb:User;
                    owl:inverseOf tb:isAvailableOn.
tb:isAvailableOn a owl:ObjectProperty;
                 rdfs:comment "Indicates the availability of a Timebank user to act as a helper for a Timebank request.";
                 rdfs:domain tb:User;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "is available on";
                 rdfs:range time:ProperInterval.
tb:isCancellationDateOf a owl:ObjectProperty;
                        rdfs:comment "Indicates the time and date when the Timebank request was cancelled.";
                        rdfs:domain time:Instant;
                        rdfs:isDefinedBy w3id:timebank;
                        rdfs:label "is cancellation date of";
                        rdfs:range tb:Request;
                        owl:inverseOf tb:isCancelledOn.
tb:isCancelledOn a owl:ObjectProperty;
                 rdfs:comment "Indicates the time and date when the Timebank request was cancelled.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "is cancelled on";
                 rdfs:range time:Instant.
tb:isCompletedOn a owl:ObjectProperty;
                 rdfs:comment "Indicates the time and date of the completion of a Timebank request.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "is completed on";
                 rdfs:range time:Instant;
                 owl:inverseOf tb:isCompletionDateOf.
tb:isCompletionDateOf a owl:ObjectProperty;
                      rdfs:comment "Indicates the time and date of the completion of a Timebank request.";
                      rdfs:domain time:Instant;
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "is completion date of";
                      rdfs:range tb:Request.
tb:isEnvironmentOf a owl:ObjectProperty;
                   rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor.";
                   rdfs:domain tb:Environment;
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "is environment of";
                   rdfs:range tb:AddressPart.
tb:isExpectedDurationOf a owl:ObjectProperty;
                        rdfs:comment "The expected duration indicates the duraction of the request estimated by the originator of the request. Do not use this property to assert the actual time credits associated to this request. Use hasAccreditedDuration instead.";
                        rdfs:domain time:DurationDescription;
                        rdfs:isDefinedBy w3id:timebank;
                        rdfs:label "is expected duration of";
                        rdfs:range tb:Request.
tb:isLimitationOf a owl:ObjectProperty;
                  rdfs:comment "Indicates that a certain limitation applies to the Timebank user.";
                  rdfs:domain tb:Limitation;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is limitation of";
                  rdfs:range tb:User.
tb:isNotEnvironmentOf a owl:ObjectProperty;
                      rdfs:comment "Indicates that a certain Location Specifier has a specific environmental factor.";
                      rdfs:domain tb:Environment;
                      rdfs:isDefinedBy w3id:timebank;
                      rdfs:label "is not environment of";
                      rdfs:range tb:AddressPart.
tb:isOriginatorOf a owl:ObjectProperty;
                  rdfs:comment "Indicates that the user is the originator of the request.";
                  rdfs:domain tb:User;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is originator of";
                  rdfs:range tb:Request.
tb:isPublicationDateOf a owl:ObjectProperty;
                       rdfs:comment "Indicates the time and date of the publication of a Timebank request.";
                       rdfs:domain time:Instant;
                       rdfs:isDefinedBy w3id:timebank;
                       rdfs:label "is publication date of";
                       rdfs:range tb:Request;
                       owl:inverseOf tb:isPublishedOn.
tb:isPublishedOn a owl:ObjectProperty;
                 rdfs:comment "Indicates the time and date of the publication of a Timebank request.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "is published on";
                 rdfs:range time:Instant.
tb:isRepeatingEndpointOf a owl:ObjectProperty;
                         rdfs:comment "Indicates that a specific time and date marks the end of a repetition of a time-interval.";
                         rdfs:domain time:Instant;
                         rdfs:isDefinedBy w3id:timebank;
                         rdfs:label "is repeating endpoint of";
                         rdfs:range time:ProperInterval.
tb:isRepetitionDayOf a owl:ObjectProperty;
                     rdfs:comment "Indicates that a time interval repeats on the specified weekdays.";
                     rdfs:domain time:DayOfWeek;
                     rdfs:isDefinedBy w3id:timebank;
                     rdfs:label "is repetition date of";
                     rdfs:range time:ProperInterval;
                     owl:inverseOf tb:repeatsOn.
tb:isRequiredBy a owl:ObjectProperty;
                rdfs:comment "The skill associated with a Timebank request.";
                rdfs:domain tb:Skill;
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "is required by";
                rdfs:range tb:Request;
                owl:inverseOf tb:requiresSkill.
tb:isSeverityOf a owl:ObjectProperty;
                rdfs:comment "Indicates the severity of a limitation.";
                rdfs:domain tb:Level;
                rdfs:isDefinedBy w3id:timebank;
                rdfs:label "is severity of";
                rdfs:range tb:Limitation.
tb:isSkillLevelOf a owl:ObjectProperty;
                  rdfs:comment "Describes the proficiency level of a skill.";
                  rdfs:domain tb:Level;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is skill level of";
                  rdfs:range tb:Skill.
tb:isSkillOf a owl:ObjectProperty;
             rdfs:comment "Describes the Skill of a certain Timebank user.";
             rdfs:domain tb:Skill;
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "is skill of";
             rdfs:range tb:User.
tb:isStatusOf a owl:ObjectProperty;
              rdfs:comment "Every request can have at most one status assigned to it.";
              rdfs:domain tb:Status;
              rdfs:isDefinedBy w3id:timebank;
              rdfs:label "is status of";
              rdfs:range tb:Request.
tb:isSubPartOf a owl:TransitiveProperty,
                 owl:ObjectProperty;
               rdfs:comment "Indicates that the address part is a sub-part of another. A sub-part defines a place more precisely. A sub-part is always in the context of its super-part. For example, a streetnumber is a sub- part of the street.",
                            w3id:timebank;
               rdfs:domain tb:AddressPart;
               rdfs:label "is sub-part of";
               rdfs:range tb:AddressPart.
tb:isTimeBalanceOf a owl:ObjectProperty;
                   rdfs:comment "Indicates the current time-balance of a Timebank user.";
                   rdfs:domain time:DurationDescription;
                   rdfs:isDefinedBy w3id:timebank;
                   rdfs:label "is time-balance of";
                   rdfs:range tb:User.
tb:isTimeWindowOf a owl:ObjectProperty;
                  rdfs:comment "Indicates the time window in which the request can/should be completed.";
                  rdfs:domain time:ProperInterval;
                  rdfs:isDefinedBy w3id:timebank;
                  rdfs:label "is time window of";
                  rdfs:range tb:Request.
tb:rating a owl:DatatypeProperty;
          rdfs:comment "The rating given by the originator of a request to the assigned helper for completing the specific request.";
          rdfs:domain tb:Request;
          rdfs:isDefinedBy w3id:timebank;
          rdfs:label "rating";
          rdfs:range xsd:decimal.
tb:repeatsOn a owl:ObjectProperty;
             rdfs:comment "Indicates that a time interval repeats on the specified weekdays.";
             rdfs:domain time:ProperInterval;
             rdfs:isDefinedBy w3id:timebank;
             rdfs:label "repeats on";
             rdfs:range time:DayOfWeek.
tb:requiresSkill a owl:ObjectProperty;
                 rdfs:comment "The skill associated with a Timebank request.";
                 rdfs:domain tb:Request;
                 rdfs:isDefinedBy w3id:timebank;
                 rdfs:label "requires skill";
                 rdfs:range tb:Skill.
