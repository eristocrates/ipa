                                    schemas:url <https://id.inrupt.com/inrupt>.
authn_provider: dcterms:contributor [schemas:url <https://id.inrupt.com/inruptpat> ; 
                                     schemas:name "Pat McBennet" ; 
                                     schemas:affiliation _:B210e9674a4c141f1f94409df8023a6fd ; 
                                     a schemas:Person],
                                    [schemas:url <https://id.inrupt.com/davidbowen> ; 
