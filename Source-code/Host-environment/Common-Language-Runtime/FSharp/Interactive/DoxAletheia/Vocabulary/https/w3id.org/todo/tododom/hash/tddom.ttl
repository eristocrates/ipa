<http://www.daml.org/services/owl-s/1.2/Grounding.owl#WsdlAtomicProcessGrounding> a owl:Class;
                                                                                  rdfs:subClassOf [owl:onDataRange xsd:anyURI ; 
                                                                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
