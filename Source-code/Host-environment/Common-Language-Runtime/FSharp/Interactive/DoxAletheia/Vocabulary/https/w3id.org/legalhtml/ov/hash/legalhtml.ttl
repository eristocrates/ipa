@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix legalhtml: <https://w3id.org/legalhtml/ov#>.

<https://w3id.org/legalhtml/ov> <http://purl.org/dc/terms/creator> <https://art.uniroma2.it/stellato>,
                                                                   <https://art.uniroma2.it/fiorelli>;
                                <http://purl.org/dc/terms/description> "An ontology for metadata about legal texts represented using the LegalHTML format"@en;
                                <http://purl.org/dc/terms/issued> "2022-12-18"^^xsd:date;
                                <http://purl.org/dc/terms/license> <http://joinup.ec.europa.eu/software/page/eupl>;
                                <http://purl.org/dc/terms/title> "LegalHTML Ontology"@en;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "lh";
                                <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/legalhtml/ov#";
                                a <http://www.w3.org/2002/07/owl#Ontology>;
                                <http://www.w3.org/2002/07/owl#imports> <http://purl.org/dc/terms/>,
                                                                        <http://data.europa.eu/eli/ontology#>;
                                <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/legalhtml/ov-1.0.0-rc.1>;
                                <http://www.w3.org/2002/07/owl#versionInfo> "1.0.0-rc.1".
legalhtml:Change a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "change"@en;
                 rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                 <http://www.w3.org/2004/02/skos/core#definition> "A modification affecting a legal resource"@en.
legalhtml:ChangeSet a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "change set"@en;
                    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                    <http://www.w3.org/2004/02/skos/core#definition> "A collection of related modifications to a legal resource (e.g. originating from the same amendment)"@en.
legalhtml:ConsolidatedResource a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:label "consolidated resource"@en;
                               rdfs:subClassOf <http://data.europa.eu/eli/ontology#LegalResource>;
                               <http://www.w3.org/2004/02/skos/core#definition> "A consolidated legal resource accounting for subsequent amendments"@en.
legalhtml:EfficacyChange a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "efficacy change"@en;
                         rdfs:subClassOf legalhtml:Change;
                         <http://www.w3.org/2004/02/skos/core#definition> "A modification in the efficacy of a legal resource"@en.
legalhtml:EndOfEfficacy a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "end of efficacy"@en;
                        rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:EndOfEnactment a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "end of enactment"@en;
                         rdfs:subClassOf legalhtml:ForceChange.
legalhtml:EntryIntoEfficacy a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "entry into efficacy"@en;
                            rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:EntryIntoForce a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "entry into force"@en;
                         rdfs:subClassOf legalhtml:ForceChange.
legalhtml:Extraefficacy a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "extraefficacy"@en;
                        rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:ForceChange a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "force change"@en;
                      rdfs:subClassOf legalhtml:Change;
                      <http://www.w3.org/2004/02/skos/core#definition> "A modification in the force of a legal resource"@en.
legalhtml:Inapplication a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "inapplication"@en;
                        rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:Insertion a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "insertion"@en;
                    rdfs:subClassOf legalhtml:TextualChange;
                    <http://www.w3.org/2004/02/skos/core#definition> "An insertion of text into a legal resource"@en.
legalhtml:Legislature a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "legislature"@en;
                      rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                      <http://www.w3.org/2004/02/skos/core#definition> "An assembly that is empowered to legislate for a political entity such as a country or city"@en.
legalhtml:PostponementOfEfficacy a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:label "postponement of efficacy"@en;
                                 rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:PostponementOfEntryIntoForce a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "postponement of entry into force"@en;
                                       rdfs:subClassOf legalhtml:ForceChange.
legalhtml:ProcedureStage a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "procedure stage"@en;
                         rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                         <http://www.w3.org/2004/02/skos/core#definition> "A stage of a procedure"@en.
legalhtml:ProrogationOfEfficacy a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:label "prorogation of efficacy"@en;
                                rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:ProrogationOfForce a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "prorogation of force"@en;
                             rdfs:subClassOf legalhtml:ForceChange.
legalhtml:ReEnactment a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "re-enactment"@en;
                      rdfs:subClassOf legalhtml:ForceChange.
legalhtml:Repeal a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "repeal"@en;
                 rdfs:subClassOf legalhtml:TextualChange;
                 <http://www.w3.org/2004/02/skos/core#definition> "A deletion of text from a legal resource"@en.
legalhtml:Retroactivity a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "retroactivity"@en;
                        rdfs:subClassOf legalhtml:EfficacyChange.
legalhtml:Role a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "role"@en;
               rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
               <http://www.w3.org/2004/02/skos/core#definition> "A role within an organization"@en.
legalhtml:Signature a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "signature"@en;
                    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                    <http://www.w3.org/2004/02/skos/core#definition> "A signature on a legal resource made by someone in some organization with certain role"@en.
legalhtml:Status a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "status"@en;
                 rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                 <http://www.w3.org/2004/02/skos/core#definition> "A status of a file, document, etc.".
legalhtml:Substitution a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "substitution"@en;
                       rdfs:subClassOf legalhtml:TextualChange;
                       <http://www.w3.org/2004/02/skos/core#definition> "A substitution of text inside a legal resource"@en.
legalhtml:TextualChange a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "textual change"@en;
                        rdfs:subClassOf legalhtml:Change;
                        <http://www.w3.org/2004/02/skos/core#definition> "A textual modificaiton to a legal resource"@en.
legalhtml:Unconstitutionality a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "uncostitutionality"@en;
                              rdfs:subClassOf legalhtml:ForceChange.
legalhtml:actingEntity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                       rdfs:label "acting entity"@en;
                       rdfs:range <http://data.europa.eu/eli/ontology#Agent>;
                       <http://www.w3.org/2004/02/skos/core#definition> "Each of the acting entities of a legal resource"@en.
legalhtml:addendum a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain legalhtml:Insertion;
                   rdfs:label "addendum"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> "Technical reference to the inserted text"@en.
legalhtml:addressee a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                    rdfs:label "addressee"@en;
                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                    <http://www.w3.org/2004/02/skos/core#definition> "A person or entity to which a legal resource is addressed"@en.
legalhtml:amendedText a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain legalhtml:TextualChange;
                      rdfs:label "amended text"@en;
                      rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>;
                      <http://www.w3.org/2004/02/skos/core#definition> "Reference to the part of the act that is being modified"@en.
legalhtml:amendingText a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain legalhtml:TextualChange;
                       rdfs:label "amending text"@en;
                       rdfs:range <http://data.europa.eu/eli/ontology#LegalResourceSubdivision>;
                       <http://www.w3.org/2004/02/skos/core#definition> "Reference to the part of the amending act that specifies the modification being done"@en.
legalhtml:applicability a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                        rdfs:label "applicability"@en;
                        rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                        <http://www.w3.org/2004/02/skos/core#definition> "Reference to an entity directly bound by the application of a legal resource"@en.
legalhtml:change a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain legalhtml:ChangeSet;
                 rdfs:label "change"@en;
                 rdfs:range legalhtml:Change;
                 <http://www.w3.org/2004/02/skos/core#definition> "Reference to a change in a change set"@en.
legalhtml:changeSet a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain legalhtml:ConsolidatedResource;
                    rdfs:label "change set"@en;
                    rdfs:range legalhtml:ChangeSet;
                    <http://www.w3.org/2004/02/skos/core#definition> "Reference to a change set being consolidated by a consolidated resource"@en.
legalhtml:changingAct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain legalhtml:ChangeSet;
                      rdfs:label "changing act"@en;
                      rdfs:range <http://data.europa.eu/eli/ontology#LegalResource>;
                      <http://www.w3.org/2004/02/skos/core#definition> "the act making the modification"@en.
legalhtml:deletion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain legalhtml:Repeal;
                   rdfs:label "deletion"@en;
                   <http://www.w3.org/2004/02/skos/core#definition> "Technical reference to the deleted text"@en.
legalhtml:entryIntoForce a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain legalhtml:ChangeSet;
                         rdfs:label "entry into force"@en;
                         rdfs:range xsd:date;
                         <http://www.w3.org/2004/02/skos/core#definition> "The date of first entry into force"@en.
legalhtml:forceChange a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:label "force change"@en;
                      rdfs:range legalhtml:ForceChange;
                      rdfs:subPropertyOf legalhtml:change;
                      <http://www.w3.org/2004/02/skos/core#definition> "Reference to a force change"@en.
legalhtml:issuer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                 rdfs:label "issuer"@en;
                 rdfs:range <http://data.europa.eu/eli/ontology#Agent>;
                 <http://www.w3.org/2004/02/skos/core#definition> "An entity responsible for originating a legal resource"@en.
legalhtml:legislature a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                      rdfs:label "legislature"@en;
                      rdfs:range legalhtml:Legislature;
                      <http://www.w3.org/2004/02/skos/core#definition> "Reference to the legislature responsible for originating a legal resource"@en.
legalhtml:originalLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                           rdfs:label "original language"@en;
                           rdfs:range <http://purl.org/dc/terms/LinguisticSystem>;
                           <http://www.w3.org/2004/02/skos/core#definition> "The language in which a legal resource has been originally drafted"@en.
legalhtml:procedureID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                      rdfs:label "procedure identifier"@en;
                      rdfs:range rdfs:Literal;
                      <http://www.w3.org/2004/02/skos/core#definition> "Unique reference for a procedure"@en.
legalhtml:procedureStage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                         rdfs:label "procedure stage"@en;
                         rdfs:range legalhtml:ProcedureStage;
                         <http://www.w3.org/2004/02/skos/core#definition> "Reference to the stage of a procedure"@en.
legalhtml:proposingEntity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                          rdfs:label "proposing entity"@en;
                          rdfs:range <http://data.europa.eu/eli/ontology#Agent>;
                          <http://www.w3.org/2004/02/skos/core#definition> "An entity responsible for the proposal"@en.
legalhtml:published a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain legalhtml:ChangeSet;
                    rdfs:label "published"@en;
                    rdfs:range xsd:date;
                    <http://www.w3.org/2004/02/skos/core#definition> "The date of publication"@en.
legalhtml:reference a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                    rdfs:label "reference"@en;
                    rdfs:range rdfs:Literal;
                    <http://www.w3.org/2004/02/skos/core#definition> "An identifier assigned to a legal resource by an entity"@en.
legalhtml:relevance a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                    rdfs:label "relevance"@en;
                    rdfs:range <http://data.europa.eu/eli/ontology#Agent>;
                    <http://www.w3.org/2004/02/skos/core#definition> "An entity governed by legal acts relevant for a legal resource"@en.
legalhtml:replacedContent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain legalhtml:Substitution;
                          rdfs:label "replaced content"@en;
                          <http://www.w3.org/2004/02/skos/core#definition> "Technical reference to the replaced text"@en.
legalhtml:replacement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain legalhtml:Substitution;
                      rdfs:label "replacement"@en;
                      <http://www.w3.org/2004/02/skos/core#definition> "Technical reference to the replacement text"@en.
legalhtml:signatory a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain legalhtml:Signature;
                    rdfs:label "signatory"@en;
                    rdfs:range <http://data.europa.eu/eli/ontology#Person>;
                    <http://www.w3.org/2004/02/skos/core#definition> "The person who affixed the signature"@en.
legalhtml:signatoryOrganization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:domain legalhtml:Signature;
                                rdfs:label "signatory organization"@en;
                                rdfs:range <http://data.europa.eu/eli/ontology#Organization>;
                                <http://www.w3.org/2004/02/skos/core#definition> "The organization on behalf of which the signatory affixed a signature on a legal resource"@en.
legalhtml:signatoryRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain legalhtml:Signature;
                        rdfs:label "signatory role"@en;
                        rdfs:range legalhtml:Role;
                        <http://www.w3.org/2004/02/skos/core#definition> "The role played within an organization by someones who affixed a signature on a legal resource on behalf of it"@en.
legalhtml:signature a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                    rdfs:label "signature"@en;
                    rdfs:range legalhtml:Signature;
                    <http://www.w3.org/2004/02/skos/core#definition> "Reference to a signature on a legal resource"@en.
legalhtml:signatureDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                        rdfs:label "signature date"@en;
                        rdfs:range <http://purl.org/dc/terms/date>;
                        <http://www.w3.org/2004/02/skos/core#definition> "The signature date of a legal resource"@en.
legalhtml:signaturePlace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                         rdfs:label "signature place"@en;
                         rdfs:range <http://purl.org/dc/terms/Location>;
                         <http://www.w3.org/2004/02/skos/core#definition> "The signature place of a legal resource"@en.
legalhtml:startOfApplicability a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:domain legalhtml:ChangeSet;
                               rdfs:label "start of applicability"@en;
                               rdfs:range xsd:date;
                               <http://www.w3.org/2004/02/skos/core#definition> "The date of first applicability"@en.
legalhtml:status a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain <http://data.europa.eu/eli/ontology#LegalResource>;
                 rdfs:label "status"@en;
                 rdfs:range legalhtml:Status;
                 <http://www.w3.org/2004/02/skos/core#definition> "The status of a language resource"@en.
legalhtml:textualChange a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:label "textual change"@en;
                        rdfs:range legalhtml:TextualChange;
                        rdfs:subPropertyOf legalhtml:change;
                        <http://www.w3.org/2004/02/skos/core#definition> "Reference to a textual change"@en.
