       <http://purl.org/dc/terms/lastModified> "2019-04-10"@en;
       <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
       <http://purl.org/dc/terms/title> "SEO, The Scientific Events Ontology."@en;
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "seo";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/seo/"^^<http://purl.org/dc/terms/URI>;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "Scientific Events Ontology"@en;
       rdfs:seeAlso "See also documentation at http://kddste.sda.tech/SEOontology/Documentation/SEO.html"@en;
       <http://www.w3.org/2002/07/owl#imports> <http://xmlns.com/foaf/0.1/>,
                                               <http://dbpedia.org/ontology/>,
                                               <https://w3id.org/scholarlydata/ontology/conference-ontology.owl>;
       <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
<https://w3id.org/seo#/> a <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:ArtificialIntelligence a w3seo:ResearchField,
                               <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:Author a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The one who write the article."@en;
             rdfs:label "Author"@en;
             rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:AuthorRegistration a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "At least one of the authors must register at the full rate in order for the paper to be published in the Proceedings."@en;
                         rdfs:label "Author registration"@en.
w3seo:Award a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A price for the highest quality research."@en;
            rdfs:label "Award"@en.
w3seo:BestApplicationsPaperAward a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "This award for the best application paper presented. "@en;
                                 rdfs:label "Best applications paper award"@en;
                                 rdfs:subClassOf w3seo:BestPaperAward.
w3seo:BestPaperAward a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This award recognizes the best paper presented."@en;
                     rdfs:label "Best paper award"@en;
                     rdfs:subClassOf w3seo:Award.
w3seo:BestPosterAward a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This award highlight good quality posters presented."@en;
                      rdfs:label "Best poster award"@en;
                      rdfs:subClassOf w3seo:Award.
w3seo:BestStudentPaperAward a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "This award recognizes the best paper authored primarily by a student and presented by the student."@en;
                            rdfs:label "Best student paper award"@en;
                            rdfs:subClassOf w3seo:BestPaperAward.
w3seo:BronzeSponsorship a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A Sponsorship Package."@en;
                        rdfs:label "Bronze sponsorship"@en;
                        rdfs:subClassOf w3seo:Sponsorship.
w3seo:Chair a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The Chair person must ensure that the Management Committee functions properly, that there is full participation during meetings, that all relevant matters are discussed and that effective decisions are made and carried out."@en;
            rdfs:label "Chair"@en;
            rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:ChallengeTrack a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The idea of the challenge track is to provide participants with a set of case studies and challenge the state of the art."@en;
                     rdfs:label "Challenge track"@en;
                     rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:ComputerSystemsOrganization a w3seo:ResearchField,
                                    <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:DemoChair a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A person responsible for assembling the system demonstration papers to be presented in the main conference program. "@en;
                rdfs:label "Demo chair"@en;
                rdfs:subClassOf w3seo:Chair.
w3seo:DemosTrack a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Offer an opportunity for presenting late-breaking research results, on-going research projects, and speculative or innovative work in progress."@en;
                 rdfs:label "Demos track"@en;
                 rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:DoctoralConsortium a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Provide PhD students an opportunity to share and develop their research ideas in a critical but supportive environment."@en;
                         rdfs:label "Doctoral consortium"@en;
                         rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>.
w3seo:DoctoralConsortiumChair a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "The event member who leads the doctoral consortium."@en;
                              rdfs:label "Doctoral consortium chair"@en;
                              rdfs:subClassOf w3seo:Chair.
w3seo:EarlyBirdRegistration a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Registration before a specific date."@en;
                            rdfs:label "Early bird registration"@en;
                            rdfs:subClassOf w3seo:Registration;
                            <http://www.w3.org/2002/07/owl#disjointWith> w3seo:LateRegistration.
w3seo:EventReception a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The reception event within a scientific event ."@en;
                     rdfs:label "Event reception"@en;
                     rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent>.
w3seo:Flyer a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An announcement or advertisement that is printed on a sheet of paper and given to people."@en;
            rdfs:label "Flyer"@en.
w3seo:GeneralChair a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A person responsible for overseeing and coordinating the whole conference. ."@en;
                   rdfs:label "General chair"@en;
                   rdfs:subClassOf w3seo:Chair.
w3seo:GetTogetherEvent a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Socially gather two or more people in one event ."@en;
                       rdfs:label "Get together event"@en;
                       rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent>.
w3seo:GoldSponsorship a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Sponsorship Package."@en;
                      rdfs:label "Gold sponsorship"@en;
                      rdfs:subClassOf w3seo:Sponsorship.
w3seo:HonorChair a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Chair of the conference ."@en;
                 rdfs:label "Honor chair"@en;
                 rdfs:subClassOf w3seo:Chair.
w3seo:HumanCenteredComputing a w3seo:ResearchField,
                               <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:ImportantDates a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Important dates to be noticed such as, abstract deadline, submission deadline, ...etc ."@en;
                     rdfs:label "Important dates"@en.
w3seo:In-useTrack a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "In-Use track provides researchers to discuss novel research taken to the market."@en;
                  rdfs:label "In-use track"@en;
                  rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:IndustrialConference a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A business conference is held for people working in the same company or industry."@en;
                           rdfs:label "Industrial conference"@en;
                           rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#NonAcademicEvent>.
w3seo:IndustryTrack a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The industry track seeks to present research contributions in industrial settings."@en;
                    rdfs:label "Industry track"@en;
                    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:InformationSystems a w3seo:ResearchField,
                           <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:InvitedSpeakers a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Invited person to give a speech in an event."@en;
                      rdfs:label "Invited speakers"@en;
                      rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:Keynote a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A talk that establishes a main underlying the theme of the event.";
              rdfs:label "Keynote speech".
w3seo:KeynoteSpeaker a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Someone who gives the main address at a formal gathering such as a conference ."@en;
                     rdfs:label "Keynote speaker"@en;
                     rdfs:subClassOf w3seo:InvitedSpeakers.
w3seo:LateRegistration a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Registration after a specific deadline ."@en;
                       rdfs:label "Late registration"@en;
                       rdfs:subClassOf w3seo:Registration.
w3seo:LocalOrganisationChair a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The chair of the local organizers of the event. "@en;
                             rdfs:label "Local organisation chair"@en;
                             rdfs:subClassOf w3seo:Chair.
w3seo:OnSiteRegistration a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Process of signing up for an event on the day of, or at the site of, the event."@en;
                         rdfs:label "On site registration"@en;
                         rdfs:subClassOf w3seo:Registration.
w3seo:Organizer a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A person who arranges an event or activity. ."@en;
                rdfs:label "Organizer"@en;
                rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:PHDSymposium a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Event for PHD student to present and receive feedback on their ongoing work."@en;
                   rdfs:label "PHD symposium"@en;
                   rdfs:subClassOf w3seo:Symposium.
w3seo:PastEvents a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Events happened or existed before the present time. "@en;
                 rdfs:label "Past events"@en.
w3seo:PlatinumSponsorship a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Sponsorship Package."@en;
                          rdfs:label "Platinum sponsorship"@en;
                          rdfs:subClassOf w3seo:Sponsorship.
w3seo:PosterChair a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The poster chair is responsible for recruiting and selecting poster fair organizers for the fairs that fall under the shared interest category."@en;
                  rdfs:label "Poster chair"@en;
                  rdfs:subClassOf w3seo:Chair.
w3seo:PostersTrack a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Present research contributions as posters."@en;
                   rdfs:label "Posters track"@en;
                   rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:ProgramChair a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The Program Chair is responsible for working to develop the annual program budget, manage chapter-programming delivery, monitor program quality, manage member satisfaction with programs, and manage all speaker communications. "@en;
                   rdfs:label "Program chair"@en;
                   rdfs:subClassOf w3seo:Chair.
w3seo:ProgramCommitteeMember a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The program committee is responsible for objectively and thoroughly reviewing all submissions, for submitting timely, informative reviews that provide authors with feedback about their submissions, and for attending the program committee meetings."@en;
                             rdfs:label "Program committee member"@en;
                             rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:ProgramSchedule a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A plan for carrying out a process or procedure, giving lists of intended events and times."@en;
                      rdfs:label "Program schedule"@en.
w3seo:Publisher a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The publisher of the event proceedings."@en;
                rdfs:label "Publisher"@en;
                rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>.
w3seo:Registration a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The action or process of registering or of being registered."@en;
                   rdfs:label "Registration"@en.
w3seo:RegularRegistration a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Normal registration"@en;
                          rdfs:label "Regular registration"@en;
                          rdfs:subClassOf w3seo:AuthorRegistration;
                          <http://www.w3.org/2002/07/owl#disjointWith> w3seo:StudentRegistration.
w3seo:ResearchField a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Area of interest."@en;
                    rdfs:label "Research field"@en.
w3seo:ResearchTrack a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The track for fundamental research, innovative technology, and applications concerning the research topic of the event."@en;
                    rdfs:label "Research track"@en;
                    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:ResourceTrack a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The Resources Track aims to promote the sharing of resources including: datasets, ontologies, vocabularies, ... etc"@en;
                    rdfs:label "Resource track"@en;
                    rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>.
w3seo:Reviewer a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A person who reviews the submissions and give feedback about the submitted articles."@en;
               rdfs:label "Reviewer"@en;
               rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:SecurityAndPrivacy a w3seo:ResearchField,
                           <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:SilverSponsorship a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Sponsorship Package."@en;
                        rdfs:label "Silver sponsorship"@en;
                        rdfs:subClassOf w3seo:Sponsorship.
w3seo:SoftwareEngineering a w3seo:ResearchField,
                            <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:Sponsor a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The Sponsor of the event (i.e. company, university ... etc.)."@en;
              rdfs:label "Sponsor"@en;
              rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>.
w3seo:Sponsorship a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Refer to a person or organization with some sort of responsibility for another person or organisation."@en;
                  rdfs:label "Sponsorship"@en.
w3seo:SponsorshipChair a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A person responsible for collecting funding from two kinds of sources: granting institutions and corporations. "@en;
                       rdfs:label "Sponsorship chair"@en;
                       rdfs:subClassOf w3seo:Chair.
w3seo:Student a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A person enrolled in a school or other educational institution."@en;
              rdfs:label "Student"@en;
              rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
w3seo:StudentRegistration a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Students full-time enrolled in a college or university can register as a student for the reduced early career rate."@en;
                          rdfs:label "Student registration"@en;
                          rdfs:subClassOf w3seo:AuthorRegistration.
w3seo:SubmissionGuidelines a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Instructions for the submission process ."@en;
                           rdfs:label "Submission guidelines"@en.
w3seo:Symposium a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A conference or meeting to discuss a particular subject."@en;
                rdfs:label "Symposium"@en;
                rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>.
w3seo:SymposiumSeries a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A series of symposiums."@en;
                      rdfs:label "Symposiums series"@en;
                      rdfs:subClassOf <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries>.
w3seo:TheoryOfComputations a w3seo:ResearchField,
                             <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:TravelInformation a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The information about the travel: date, place, ...etc ."@en;
                        rdfs:label "Travel information"@en.
w3seo:TutorialChair a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A person responsible for requesting tutorial proposals and making final selections."@en;
                    rdfs:label "Tutorial chair"@en;
                    rdfs:subClassOf w3seo:Chair.
w3seo:WorkshopChair a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The one responsible for collaborating with the workshop chairs for other ACL-affiliated conferences in the given year, in preparing and circulating the Call for Proposals, and in reviewing submissions."@en;
                    rdfs:label "Workshop chair"@en;
                    rdfs:subClassOf w3seo:Chair.
w3seo:WorldWideWeb a w3seo:ResearchField,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>.
w3seo:abstractDeadline a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "The deadline of abstract submission.";
                       rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                       rdfs:range xsd:date.
w3seo:acceptanceRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The acceptance rate of the event in a particular year."@en;
                     rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                     rdfs:range xsd:decimal.
w3seo:acceptedPapers a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The number of accepted papers in the event."@en;
                     rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                     rdfs:range xsd:unsignedInt.
w3seo:belongsToSeries a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property shows the series which an event belongs to."@en;
                      rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
                      rdfs:label "belongsToSeries"@en;
                      rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries>;
                      <http://www.w3.org/2002/07/owl#inverseOf> w3seo:hasEvent.
w3seo:colocatedWith a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property links an event to another one which is co-located with.";
                    rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
                    rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>.
w3seo:eventWebsite a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The webpage of the event."@en;
                   rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                   rdfs:range xsd:anyURI.
w3seo:hasAffiliation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                     rdfs:range <http://xmlns.com/foaf/0.1/Organization>.
w3seo:hasChair a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Track>;
               rdfs:range w3seo:Chair.
w3seo:hasEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "an event series has an event edition";
               rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#EventSeries>;
               rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>.
w3seo:hasFlyer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
               rdfs:range w3seo:Flyer.
w3seo:hasImportantDates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                        rdfs:range w3seo:ImportantDates.
w3seo:hasKeynote a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
                 rdfs:range w3seo:Keynote;
                 <http://www.w3.org/2002/07/owl#inverseOf> w3seo:keynoteIn.
w3seo:hasProgramCommitteeMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                                rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Person>.
w3seo:hasProgramSchedual a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>.
w3seo:hasPublisher a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "This propoerty shows the publisher of a proceedings.";
                   rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>
                                                                         <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Proceedings>) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:range w3seo:Publisher;
                   <http://www.w3.org/2002/07/owl#inverseOf> w3seo:isPublisherOf.
w3seo:hasRegistration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
                      rdfs:range w3seo:Registration.
w3seo:hasRegistrationType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain w3seo:Author;
                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (w3seo:EarlyBirdRegistration
                                                                               w3seo:LateRegistration) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>].
w3seo:hasSocialEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#AcademicEvent>;
                     rdfs:range <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#SocialEvent>.
w3seo:hasSponsor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This propoerty shows the sponsor of an event.";
                 rdfs:domain <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#OrganisedEvent>;
                 rdfs:range w3seo:Sponsor;
                 <http://www.w3.org/2002/07/owl#inverseOf> w3seo:isSponsorOf.
