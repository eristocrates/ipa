citedcat:isVariantFormOf a rdf:Property,
                           owl:ObjectProperty;
                         rdfs:comment "Indicates A is a variant or different form of B [DataCite]."@en;
                         rdfs:isDefinedBy <https://schema.datacite.org/>,
