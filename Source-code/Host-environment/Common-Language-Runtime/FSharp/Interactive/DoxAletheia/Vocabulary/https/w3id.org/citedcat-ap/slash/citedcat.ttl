                                adms:representationTechnique <http://purl.org/adms/representationtechnique/OWL> ; 
                                adms:representationTechnique <http://purl.org/adms/representationtechnique/RDFSchema> ; 
                                dcterms:title "JSON-LD"@en ; 
                                dcterms:format <http://publications.europa.eu/resource/authority/file-type/JSON_LD> ; 
                                dcterms:format <http://www.w3.org/ns/formats/data/JSON-LD> ; 
                                a adms:AssetDistribution],
                               [aerdcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; 
                                aerdcat:downloadURL <https://ec-jrc.github.io/datacite-to-dcat-ap/citedcat-ap.rdf> ; 
                                adms:representationTechnique <http://purl.org/adms/representationtechnique/OWL> ; 
                                adms:representationTechnique <http://purl.org/adms/representationtechnique/RDFSchema> ; 
                                dcterms:title "RDF/XML"@en ; 
