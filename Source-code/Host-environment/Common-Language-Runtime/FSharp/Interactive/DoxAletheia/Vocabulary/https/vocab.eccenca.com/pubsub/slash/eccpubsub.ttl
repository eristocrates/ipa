                      rdfs:comment "An HTTP endpoint acting as hub."@en;
                      rdfs:isDefinedBy eccpubsub:;
                      rdfs:label "hub endpoint"@en;
                      rdfs:subClassOf eccpubsub:Endpoint;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_ACTIVE <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                              a eccpubsub:SubscriptionState;
