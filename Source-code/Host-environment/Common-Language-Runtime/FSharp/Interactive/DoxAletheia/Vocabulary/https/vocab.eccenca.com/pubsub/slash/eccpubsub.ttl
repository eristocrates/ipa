                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "active"@en;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_CANCELED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                a eccpubsub:SubscriptionState;
                                rdfs:comment "Indicates that a susbcription was canceled by the subscriber."@en;
                                rdfs:isDefinedBy eccpubsub:;
                                rdfs:label "canceled"@en;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_DENIED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                              a eccpubsub:SubscriptionState;
                              rdfs:comment "Indicates that a subscription was denied by a publisher."@en;
                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "denied"@en;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_CANCELED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                        <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                        a eccpubsub:SubscriptionRequestState;
                                        rdfs:comment "Indicates that a subscription cancellation request was successfully sent to the hub but is not yet verified."@en;
                                        rdfs:isDefinedBy eccpubsub:;
                                        rdfs:label "request canceled"@en;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_DELETED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                       a eccpubsub:SubscriptionRequestState;
                                       rdfs:comment "Indicates that a subscription cancellation request was successfully verified."@en;
                                       rdfs:isDefinedBy eccpubsub:;
                                       rdfs:label "request deleted"@en;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_DENIED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                      a eccpubsub:SubscriptionRequestState;
                                      rdfs:comment "Indicates that a subscription request was denied."@en;
                                      rdfs:isDefinedBy eccpubsub:;
                                      rdfs:label "request denied"@en;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_PENDING <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                       a eccpubsub:SubscriptionRequestState;
                                       rdfs:comment "Indicates that a subscription request was successfully sent to the hub but is not yet verified."@en;
                                       rdfs:isDefinedBy eccpubsub:;
                                       rdfs:label "request pending"@en;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SUBSCRIPTION_REQUEST_VERIFIED <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                        <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                        a eccpubsub:SubscriptionRequestState;
                                        rdfs:comment "Indicates that a subscription request was successfully validated and verified."@en;
                                        rdfs:isDefinedBy eccpubsub:;
                                        rdfs:label "request verified"@en;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:Subscription <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A unique relation to a topic by a subscriber that indicates it should receive updates for that topic."@en;
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "subscription"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:state ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/modified> ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:secret ; 
                                        <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:deniedReason ; 
                                        <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/created> ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:callback ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:topic ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>];
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SubscriptionRequest <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A request to a hub by a subscriber indicating interest to updates of a topic."@en;
                              rdfs:isDefinedBy eccpubsub:;
                              rdfs:label "subscription request"@en;
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/created> ; 
                                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:requestState ; 
                                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:deniedReason ; 
                                               <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/modified> ; 
                                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:topic ; 
                                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> eccpubsub:hub ; 
                                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>];
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SubscriptionRequestState <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A state of a subscription request."@en;
                                   rdfs:isDefinedBy eccpubsub:;
                                   rdfs:label "subscription request state"@en;
                                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (eccpubsub:SUBSCRIPTION_REQUEST_PENDING
                                                                                                                           eccpubsub:SUBSCRIPTION_REQUEST_VERIFIED
                                                                                                                           eccpubsub:SUBSCRIPTION_REQUEST_DENIED
                                                                                                                           eccpubsub:SUBSCRIPTION_REQUEST_CANCELED
                                                                                                                           eccpubsub:SUBSCRIPTION_REQUEST_DELETED) ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Class>];
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:SubscriptionState <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                            <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A state of a subscription."@en;
                            rdfs:isDefinedBy eccpubsub:;
                            rdfs:label "subscription state"@en;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (eccpubsub:SUBSCRIPTION_ACTIVE
                                                                                                                    eccpubsub:SUBSCRIPTION_CANCELED
                                                                                                                    eccpubsub:SUBSCRIPTION_DENIED) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>];
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:callback <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The URL at which a subscriber wishes to receive notifications."@en;
                   rdfs:domain eccpubsub:Subscription;
                   rdfs:isDefinedBy eccpubsub:;
                   rdfs:label "has callback URL"@en;
                   rdfs:range eccpubsub:CallbackEndpoint;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:deniedReason <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "The reason for which the subscription (request) has been denied."@en;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (eccpubsub:Subscription
                                                                             eccpubsub:SubscriptionRequest) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "has reason for denial"@en;
                       rdfs:range xsd:string;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:hub <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The URL of the hub to which the request is addressed."@en;
              rdfs:domain eccpubsub:SubscriptionRequest;
              rdfs:isDefinedBy eccpubsub:;
              rdfs:label "has hub URL"@en;
              rdfs:range eccpubsub:HubEndpoint;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:requestState <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "The state of a subscription request."@en;
                       rdfs:domain eccpubsub:SubscriptionRequest;
                       rdfs:isDefinedBy eccpubsub:;
                       rdfs:label "has subscription request state"@en;
                       rdfs:range eccpubsub:SubscriptionRequestState;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:secret <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "A secret string that will be used to compute an HMAC digest for authorized content distribution. If not supplied, the HMAC digest will not be present for content distribution requests."@en;
                 rdfs:domain eccpubsub:Subscription;
                 rdfs:isDefinedBy eccpubsub:;
                 rdfs:label "has secret"@en;
                 rdfs:range xsd:string;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:state <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The state of a subscription."@en;
                rdfs:domain eccpubsub:Subscription;
                rdfs:isDefinedBy eccpubsub:;
                rdfs:label "has subscription state"@en;
                rdfs:range eccpubsub:SubscriptionState;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:topic <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The resource URI for which updates should be published."@en;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (eccpubsub:Subscription
                                                                      eccpubsub:SubscriptionRequest) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy eccpubsub:;
                rdfs:label "has topic URI"@en;
                rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
