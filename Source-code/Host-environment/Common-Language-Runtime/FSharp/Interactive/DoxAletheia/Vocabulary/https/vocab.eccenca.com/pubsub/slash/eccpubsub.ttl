                           rdfs:label "callback endpoint"@en;
                           rdfs:subClassOf eccpubsub:Endpoint;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
eccpubsub:Endpoint <http://purl.org/dc/terms/issued> "2016-07-12"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2016-07-12"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A PubSubHubbub HTTP endpoint. Individuals of this class MUST be referenced by their URL."@en;
                   rdfs:isDefinedBy eccpubsub:;
                   rdfs:label "endpoint"@en;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
