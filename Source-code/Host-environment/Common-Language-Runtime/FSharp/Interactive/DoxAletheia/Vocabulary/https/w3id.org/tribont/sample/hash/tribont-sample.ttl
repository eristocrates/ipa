tribont-material:FluidLubricant a owl:Class.
tribont-material:Material a owl:Class.
tribont-material:SolidLubricant a owl:Class.
<https://w3id.org/tribont/sample> ccrel:license <https://creativecommons.org/licenses/by-nc/4.0/>;
                                  <http://gbol.life/ontology/bibo#status> "published";
                                  dcterms:bibliographicCitation "Work in progress";
                                  dcterms:contributor """Izaskun Fernandez (Tekniker) 
Domain expert:Iban Quintana (Tekniker) 
Domain expert:Xana Fernandez (Tekniker)"""@en;
                                  dcterms:created "2023-05-30";
                                  dcterms:creator "Patricia Casla (Tekniker)"@en;
                                  dcterms:description "The goal of this module is to represent the sample systems , and the undelaying samples, involved in the tribological experiments."@en;
                                  dcterms:issued "2023-05-30";
                                  dcterms:publisher "Tekniker";
                                  dcterms:title "Sample module";
                                  vann:preferredNamespacePrefix "sample";
                                  vann:preferredNamespaceUri "https://w3id.org/tribont/sample";
                                  a owl:Ontology;
                                  owl:imports <https://w3id.org/tribont/material>;
                                  owl:versionInfo 1.0.
tribont-sample:CoatedSample a owl:Class;
                            rdfs:comment "Sample body which has a coating moterial.";
                            rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                            rdfs:label "CoatedSample";
                            rdfs:subClassOf tribont-sample:Sample;
                            owl:equivalentClass [a owl:Class ; 
                                                 owl:intersectionOf (tribont-sample:Sample
                                                                     [owl:someValuesFrom tribont-sample:Coating ; 
                                                                     owl:onProperty tribont-sample:hasCoating ; 
                                                                     a owl:Restriction])];
                            status:term_status "Testing".
tribont-sample:Coating a owl:Class;
                       rdfs:comment "A thin layer covering of something.";
                       rdfs:isDefinedBy "https://w3id.org/tribont/material";
                       rdfs:label "Coating";
                       rdfs:subClassOf [owl:onClass tribont-material:Material ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty tribont-sample:hasCoreMaterial ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom tribont-material:Material ; 
                                        owl:onProperty tribont-sample:hasCoreMaterial ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom tribont-sample:CoatingProperty ; 
                                        owl:onProperty icb:isCharacterisedBy ; 
                                        a owl:Restriction],
                                       icb:SubjectOfInterest;
                       status:term_status "Testing".
tribont-sample:CoatingProperty a owl:Class;
                               rdfs:comment "Qualifiable or quantifiable attribute, or characteristic of a coating.";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "CoatingProperty";
                               rdfs:subClassOf icb:Property;
                               status:term_status "Testing".
tribont-sample:CoatingThickness a owl:Class;
                                rdfs:comment "Thickness of a coating.";
                                rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                rdfs:label "CoatingThickness";
                                rdfs:subClassOf tribont-sample:CoatingProperty;
                                status:term_status "Testing".
tribont-sample:CoatingType a owl:Class;
                           rdfs:comment "Type of coating.";
                           rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                           rdfs:label "CoatingType";
                           rdfs:subClassOf tribont-sample:CoatingProperty;
                           status:term_status "Testing".
tribont-sample:LubricatedSampleSystem a owl:Class;
                                      rdfs:comment "Sample system that includes a lubricant as part of it.";
                                      rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                      rdfs:label "LubricatedSampleSystem";
                                      rdfs:subClassOf tribont-sample:SampleSystem;
                                      owl:equivalentClass [a owl:Class ; 
                                                           owl:intersectionOf (tribont-sample:SampleSystem
                                                                               [owl:someValuesFrom tribont-sample:LubricationSample ; 
                                                                               owl:onProperty tribont-sample:hasLubricationSample ; 
                                                                               a owl:Restriction])];
                                      status:term_status "Testing".
tribont-sample:LubricationSample a owl:Class;
                                 rdfs:comment "Portion of lubricant material selected from a larger quantity of lubricant material for Testing purposes. Lubricant material can be fluid or solid lubricants ";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                 rdfs:label "LubricationSample";
                                 rdfs:subClassOf tribont-sample:Sample;
                                 owl:equivalentClass [a owl:Class ; 
                                                      owl:intersectionOf (tribont-sample:Sample
                                                                          [owl:unionOf ([owl:someValuesFrom tribont-material:FluidLubricant ; 
                                                                                       owl:onProperty tribont-sample:hasCoreMaterial ; 
                                                                                       a owl:Restriction]
                                                                                       [owl:someValuesFrom tribont-material:SolidLubricant ; 
                                                                                       owl:onProperty tribont-sample:hasCoreMaterial ; 
                                                                                       a owl:Restriction]) ; 
                                                                          a owl:Class])];
                                 status:term_status "Testing".
tribont-sample:Sample a owl:Class;
                      rdfs:comment "Portion of material which can be transformed or not for Testing purposes. For example the moving and static samples in a tribological tests are transformed following a specific manufacturing process to achieve the required body characteristics, while lubricants acting as lubrication body are not transformed.";
                      rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                      rdfs:label "Sample";
                      rdfs:subClassOf [owl:allValuesFrom tribont-material:Material ; 
                                       owl:onProperty tribont-sample:hasCoreMaterial ; 
                                       a owl:Restriction],
                                      [owl:onClass tribont-core:Body ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty tribont-sample:hasBody ; 
                                       a owl:Restriction],
                                      icb:SubjectOfInterest,
                                      [owl:onClass tribont-sample:Coating ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty tribont-sample:hasCoating ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom tribont-core:Body ; 
                                       owl:onProperty tribont-sample:hasBody ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom tribont-sample:Coating ; 
                                       owl:onProperty tribont-sample:hasCoating ; 
                                       a owl:Restriction],
                                      [owl:onClass tribont-sample:SampleRole ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty tribont-sample:hasSampleRole ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom xsd:dateTime ; 
                                       owl:onProperty tribont-sample:preparationDate ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom tribont-sample:SampleRole ; 
                                       owl:onProperty tribont-sample:hasSampleRole ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom tribont-core:TechnicalProperty ; 
                                       owl:onProperty icb:isCharacterisedBy ; 
                                       a owl:Restriction];
                      status:term_status "Testing".
tribont-sample:SampleBatch a owl:Class;
                           rdfs:comment "An aggrupation of samples which have been transformed at the same time using a same material and share a set of common atributes of characteristics.";
                           rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                           rdfs:label "SampleBatch";
                           rdfs:subClassOf icb:SubjectOfInterest,
                                           [owl:onClass tribont-sample:Coating ; 
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty tribont-sample:hasCoating ; 
                                            a owl:Restriction],
                                           [owl:onDataRange xsd:dateTime ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty tribont-sample:preparationDate ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom tribont-material:Material ; 
                                            owl:onProperty tribont-sample:hasCoreMaterial ; 
                                            a owl:Restriction],
                                           [owl:onClass tribont-core:Body ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty tribont-sample:hasBody ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom tribont-sample:Coating ; 
                                            owl:onProperty tribont-sample:hasCoating ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom tribont-core:Body ; 
                                            owl:onProperty tribont-sample:hasBody ; 
                                            a owl:Restriction];
                           status:term_status "Testing".
tribont-sample:SampleRole a owl:Class;
                          rdfs:comment "The position or purpose that a sample has in a situation.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                          rdfs:label "SampleRole";
                          rdfs:subClassOf tribont-core:Role;
                          status:term_status "Testing".
tribont-sample:SampleSystem a owl:Class;
                            rdfs:comment "Object aggregate that has two or more elements that interact with each other, and it is used for Testing purposes. For example, a tribological sample system aggregates at least a static and a moving sample body and can include or not a lubrication sample body.";
                            rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                            rdfs:label "SampleSystem";
                            rdfs:subClassOf [owl:allValuesFrom tribont-sample:LubricationSample ; 
                                             owl:onProperty tribont-sample:hasLubricationSample ; 
                                             a owl:Restriction],
                                            icb:SubjectOfInterest,
                                            [owl:allValuesFrom tribont-core:SystemProperty ; 
                                             owl:onProperty icb:isCharacterisedBy ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-sample:Sample ; 
                                             owl:onProperty tribont-sample:hasMovingSample ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-sample:Sample ; 
                                             owl:onProperty tribont-sample:hasStaticSample ; 
                                             a owl:Restriction];
                            status:term_status "Testing".
tribont-sample:executionDate a owl:DatatypeProperty;
                             rdfs:comment "Data when something has been executed.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                             rdfs:label "executionDate";
                             status:term_status "Testing".
tribont-sample:hasBody a owl:ObjectProperty;
                       rdfs:comment "Relationship between something  and its body configuration..";
                       rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                       rdfs:label "hasBody";
                       status:term_status "Testing".
tribont-sample:hasCoating a owl:ObjectProperty;
                          rdfs:comment "Relationship between a sample  and its coating.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                          rdfs:label "hasCoating";
                          owl:inverseOf tribont-sample:isCoatingFor;
                          status:term_status "Testing".
tribont-sample:hasCoreMaterial a owl:ObjectProperty;
                               rdfs:comment "Relationship between something and the material of which it is made";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "hasCoreMaterial";
                               owl:inverseOf tribont-sample:isCoreMaterialFor;
                               status:term_status "Testing".
tribont-sample:hasLubricationSample a owl:ObjectProperty;
                                    rdfs:comment "Relationship between a sample system and a lubricant material that is part of it.";
                                    rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                    rdfs:label "hasLubricationSample";
                                    owl:inverseOf tribont-sample:isLubricationSampleFor;
                                    status:term_status "Testing".
tribont-sample:hasMovingSample a owl:ObjectProperty;
                               rdfs:comment "Relationship between a sample system and a moving sample body that is part of it.";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "hasMovingSample";
                               owl:inverseOf tribont-sample:isMovingSampleFor;
                               status:term_status "Testing".
tribont-sample:hasSampleRole a owl:ObjectProperty;
                             rdfs:comment "Relationship between a sample and its role.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                             rdfs:label "hasSampleRole";
                             owl:inverseOf tribont-sample:isSampleRoleFor;
                             status:term_status "Testing".
tribont-sample:hasStaticSample a owl:ObjectProperty;
                               rdfs:comment "Relationship between a sample system and a static sample body that is part of it.";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "hasStaticSample";
                               owl:inverseOf tribont-sample:isStaticSampleFor;
                               status:term_status "Testing".
tribont-sample:interactsWith a owl:ObjectProperty;
                             rdfs:comment "Releation between sveral samples interacting one with each other.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                             rdfs:label "interactsWith";
                             status:term_status "Testing".
tribont-sample:isCoatingFor a owl:ObjectProperty;
                            rdfs:comment "Relationship between a coating  and the sample  of which it is a part.";
                            rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                            rdfs:label "isCoatingFor";
                            status:term_status "Testing".
tribont-sample:isCoreMaterialFor a owl:ObjectProperty;
                                 rdfs:comment "Relationship between  the material it is made of and something";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                 rdfs:label "isCoreMaterialFor";
                                 status:term_status "Testing".
tribont-sample:isLubricationSampleFor a owl:ObjectProperty;
                                      rdfs:comment "Relationship between a lubrication sample  and the sample system of which it is a part.";
                                      rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                      rdfs:label "isLubricationSampleFor";
                                      status:term_status "Testing".
tribont-sample:isMovingSampleFor a owl:ObjectProperty;
                                 rdfs:comment "Relationship between a moving sample  and the sample system of which it is a part.";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                 rdfs:label "isMovingSampleFor";
                                 status:term_status "Testing".
tribont-sample:isSampleRoleFor a owl:ObjectProperty;
                               rdfs:comment "Relationship between a role and the sample to which it applies,";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "isSampleRoleFor";
                               status:term_status "Testing".
tribont-sample:isStaticSampleFor a owl:ObjectProperty;
                                 rdfs:comment "Relationship between a static sample  and the sample system of which it is a part.";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                                 rdfs:label "isStaticSampleFor";
                                 status:term_status "Testing".
tribont-sample:preparationDate a owl:DatatypeProperty;
                               rdfs:comment "Data when something has been prepared.";
                               rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                               rdfs:label "preparationDate";
                               status:term_status "Testing".
tribont-sample:reference a tribont-sample:SampleRole,
                           owl:NamedIndividual;
                         rdfs:comment "A reference against which the sample is tested.";
                         rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                         rdfs:label "reference";
                         status:term_status "Testing".
tribont-sample:target a tribont-sample:SampleRole,
                        owl:NamedIndividual;
                      rdfs:comment "Target sample for the  testing  activity.";
                      rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                      rdfs:label "target";
