                                                                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoreMaterial ; 
                                                                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/tribont/material#SolidLubricant> ; 
                                                                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoreMaterial ; 
                                                                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>])];
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:Sample a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Portion of material which can be transformed or not for Testing purposes. For example the moving and static samples in a tribological tests are transformed following a specific manufacturing process to achieve the required body characteristics, while lubricants acting as lubrication body are not transformed.";
                      rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                      rdfs:label "Sample";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/material#Material> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoreMaterial ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/tribont/core#Body> ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasBody ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      <https://w3id.org/isCharacterisedBy#SubjectOfInterest>,
                                      [<http://www.w3.org/2002/07/owl#onClass> tribont-sample:Coating ; 
                                       <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoating ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/core#Body> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasBody ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:Coating ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoating ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onClass> tribont-sample:SampleRole ; 
                                       <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasSampleRole ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:dateTime ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:preparationDate ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:SampleRole ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasSampleRole ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/core#TechnicalProperty> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:SampleBatch a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "An aggrupation of samples which have been transformed at the same time using a same material and share a set of common atributes of characteristics.";
                           rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                           rdfs:label "SampleBatch";
                           rdfs:subClassOf <https://w3id.org/isCharacterisedBy#SubjectOfInterest>,
                                           [<http://www.w3.org/2002/07/owl#onClass> tribont-sample:Coating ; 
                                            <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoating ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:preparationDate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/material#Material> ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoreMaterial ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/tribont/core#Body> ; 
                                            <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasBody ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:Coating ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasCoating ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/core#Body> ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasBody ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:SampleRole a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The position or purpose that a sample has in a situation.";
                          rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                          rdfs:label "SampleRole";
                          rdfs:subClassOf <https://w3id.org/tribont/core#Role>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:SampleSystem a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Object aggregate that has two or more elements that interact with each other, and it is used for Testing purposes. For example, a tribological sample system aggregates at least a static and a moving sample body and can include or not a lubrication sample body.";
                            rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                            rdfs:label "SampleSystem";
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:LubricationSample ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasLubricationSample ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            <https://w3id.org/isCharacterisedBy#SubjectOfInterest>,
                                            [<http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/tribont/core#SystemProperty> ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/isCharacterisedBy#isCharacterisedBy> ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:Sample ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasMovingSample ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#allValuesFrom> tribont-sample:Sample ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> tribont-sample:hasStaticSample ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>];
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:executionDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Data when something has been executed.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                             rdfs:label "executionDate";
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:hasBody a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relationship between something  and its body configuration..";
                       rdfs:isDefinedBy "https://w3id.org/tribont/sample";
                       rdfs:label "hasBody";
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Testing".
tribont-sample:hasCoating a <http://www.w3.org/2002/07/owl#ObjectProperty>;
