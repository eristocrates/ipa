                        seas-stats:FlexibilityOntology-1.0,
                        seas-stats:ComplexOntology-1.0,
                        seas-stats:ElectricVehicleOntology-1.0;
            owl:priorVersion seas-stats:seas-0.9;
            owl:versionIRI seas-stats:seas-1.0;
            owl:versionInfo "v1.0".
