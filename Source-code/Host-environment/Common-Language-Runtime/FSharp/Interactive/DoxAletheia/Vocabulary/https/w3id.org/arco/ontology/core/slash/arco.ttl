@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cis: <http://dati.beniculturali.it/cis/>.
@prefix dcatapit: <http://dati.gov.it/onto/dcatapit#>.
@prefix odp: <http://ontologydesignpatterns.org/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix arco: <https://w3id.org/arco/ontology/core/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix vcard2006: <http://www.w3.org/2006/vcard/ns#>.

cis:CulturalEntity a owl:Class;
                   rdfs:subClassOf owl:Thing.
cis:CulturalEvent a owl:Class;
                  rdfs:subClassOf <https://w3id.org/italia/onto/l0/EventOrSituation>;
                  owl:disjointWith cis:NameInTime.
cis:CulturalInstituteOrSite a owl:Class;
                            rdfs:subClassOf <https://w3id.org/italia/onto/l0/Agent>.
cis:NameInTime a owl:Class;
               rdfs:subClassOf <https://w3id.org/italia/onto/l0/EventOrSituation>,
                               arco:Situation.
cis:Site a owl:Class;
         rdfs:subClassOf <https://w3id.org/italia/onto/l0/Location>.
dcatapit:Agent a owl:Class;
               owl:equivalentClass <https://w3id.org/italia/onto/l0/Agent>.
dcatapit:Organization a owl:Class;
                      rdfs:subClassOf <https://w3id.org/italia/onto/l0/Agent>;
                      owl:equivalentClass vcard2006:Organization.
<http://ontologydesignpatterns.org/opla/isNativeTo> a owl:AnnotationProperty.
<http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate> a owl:AnnotationProperty.
dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:language a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
vcard2006:Organization a owl:Class;
                       rdfs:subClassOf <https://w3id.org/italia/onto/l0/Agent>.
foaf:Agent a owl:Class;
           owl:equivalentClass <https://w3id.org/italia/onto/l0/Agent>.
<https://w3id.org/arco/ontology/core> <http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate> <http://www.ontologydesignpatterns.org/cp/owl/partof.owl>,
                                                                                                       <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#>,
                                                                                                       <http://www.ontologydesignpatterns.org/cp/owl/place.owl#>,
                                                                                                       <http://www.ontologydesignpatterns.org/cp/owl/componency.owl>,
                                                                                                       <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl>,
                                                                                                       <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>,
                                                                                                       <http://ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                                      dc11:creator "Aldo Gangemi (ISTC-CNR, STLab)",
                                                   "Marialetizia Mancinelli (MiBAC, ICCD)",
                                                   "Valentina Presutti (ISTC-CNR, STLab)",
                                                   "Chiara Veninata (MiBAC, ICCD)",
                                                   "Andrea Nuzzolese (ISTC-CNR, STLab)",
                                                   "Valentina Carriero (ISTC-CNR, STLab)",
                                                   "Ludovica Marinucci (ISTC-CNR, STLab)";
                                      dc11:description "The Core module represents general-purpose concepts orthogonal to the whole network, which are imported by all other ontology modules (e.g. part-whole relation, classification)."@en,
                                                       "Questo modulo rappresenta concetti trasversali a tutta la network, che sono quindi importati da tutti gli altri moduli ontologici (es.: relazione parte-tutto, classificazione)."@it;
                                      dc11:language <http://publications.europa.eu/resource/authority/language/ENG>,
                                                    <http://publications.europa.eu/resource/authority/language/ITA>;
                                      dc11:title "Ontologia Core (ArCo network)"@it,
                                                 "Core Ontology (ArCo network)"@en;
                                      dcterms:issued "2018-03-07";
                                      dcterms:license <https://creativecommons.org/licenses/by-sa/4.0/>,
                                                      <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40>;
                                      dcterms:modified "2019-06-01";
                                      a owl:Ontology;
                                      rdfs:comment "Questo modulo rappresenta concetti trasversali a tutta la network, che sono quindi importati da tutti gli altri moduli ontologici (es.: relazione parte-tutto, classificazione)."@it,
                                                   "The Core module represents general-purpose concepts orthogonal to the whole network, which are imported by all other ontology modules (e.g. part-whole relation, classification)."@en;
                                      rdfs:label "Core Ontology (ArCo network)"@en,
                                                 "Ontologia Core (ArCo network)"@it;
                                      owl:versionInfo "Version 1.0"@en,
                                                      "Versione 1.0"@it.
arco:AgentRole a owl:Class;
               rdfs:comment "Questa classe rappresenta una situazione relativa a un agente che ricopre un ruolo, senza la specificazione della dimensione tempo."@it,
                            "This class represents a situation in which an agent holds a role, regardless of the timing."@en;
               rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
               rdfs:label "Agent Role"@en,
                          "Ruolo ricoperto da agente"@it;
               rdfs:subClassOf [owl:someValuesFrom <https://w3id.org/italia/onto/RO/Role> ; 
                                owl:onProperty arco:hasRole ; 
                                a owl:Restriction],
                               arco:Situation,
                               [owl:someValuesFrom <https://w3id.org/italia/onto/l0/Agent> ; 
                                owl:onProperty arco:hasAgent ; 
                                a owl:Restriction];
               owl:disjointWith arco:Classification;
               owl:versionInfo "stable"@en,
                               "stabile"@it.
arco:Category a owl:Class;
              rdfs:comment "The class representing a category."@en,
                           "La classe che rappresenta una categoria."@it;
              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
              rdfs:label "Category"@en,
                         "Categoria"@it;
              rdfs:subClassOf arco:Concept;
              owl:versionInfo "stable"@en,
                              "stabile"@it.
arco:Classification <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl>;
                    a owl:Class;
                    rdfs:comment "La classe che rappresenta il concetto di classificazione."@it,
                                 "The class that models the concept of classification."@en;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                    rdfs:label "Classification"@en,
                               "Classificazione"@it;
                    rdfs:subClassOf arco:Situation;
                    owl:versionInfo "stable"@en,
                                    "stabile"@it.
arco:Concept <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#>;
             a owl:Class;
             rdfs:comment "The class representing a concept."@en,
                          "La classe che rappresenta un concetto."@it;
             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
             rdfs:label "Concetto"@it,
                        "Concept"@en;
             rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object>;
             owl:equivalentClass <https://w3id.org/italia/onto/l0/Concept>;
             owl:versionInfo "stable"@en,
                             "stabile"@it.
arco:CulturalEntityCharacteristic a owl:Class;
                                  rdfs:comment "The class representing the characteristic of a cultural entity (e.g. a cultural property)."@en,
                                               "La classe che rappresenta una caratteristica di un'entità di carattere culturale come ad esempio un bene culturale."@it;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                                  rdfs:label "Cultural Entity Characteristic"@en,
                                             "Caratteristica di Entità Culturale"@it;
                                  rdfs:subClassOf <https://w3id.org/italia/onto/l0/Characteristic>;
                                  owl:versionInfo "stable"@en,
                                                  "stabile"@it.
arco:CulturalEntityClassification a owl:Class;
                                  rdfs:comment "The class that models the concept of cultural entity classification."@en,
                                               "La classe che rappresenta il concetto di classificazione di un'entità culturale."@it;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                                  rdfs:label "Cultural entity classification"@en,
                                             "Classificazione relativa a bene culturale"@it;
                                  rdfs:subClassOf arco:Classification.
arco:Method a owl:Class;
            rdfs:comment "The class representing the concept of method."@en,
                         "Classe che rappresenta il concetto di metodo."@it;
            rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
            rdfs:label "Metodo"@it,
                       "Method"@en;
            rdfs:subClassOf <https://w3id.org/italia/onto/l0/Description>;
            owl:versionInfo "stable"@en,
                            "stabile"@it.
arco:Situation <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
               a owl:Class;
               rdfs:comment "La classe che rappresenta il generico concetto di situazione."@it,
                            "The class representing the generic concept of situation."@en;
               rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
               rdfs:label "Situazione"@it,
                          "Situation"@en;
               rdfs:subClassOf <https://w3id.org/italia/onto/l0/EventOrSituation>;
               owl:versionInfo "stable"@en,
                               "stabile"@it.
arco:TimeIndexedSituation <http://ontologydesignpatterns.org/opla/isNativeTo> <http://ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                          a owl:Class;
                          rdfs:comment "The class representing the generic concept of time indexed situation."@en,
                                       "La classe che rappresenta il generico concetto di situazione indicizzata nel tempo."@it;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                          rdfs:label "Situazione nel tempo"@it,
                                     "Time indexed situation"@en;
                          rdfs:subClassOf arco:Situation;
                          owl:versionInfo "stabile"@it,
                                          "stable"@en.
arco:Type a owl:Class;
          rdfs:comment "The class representing the concept of type."@en,
                       "Classe che rappresenta il concetto di tipo."@it;
          rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
          rdfs:label "Type"@en,
                     "Tipo"@it;
          rdfs:subClassOf arco:Concept;
          owl:versionInfo "stable"@en,
                          "stabile"@it.
arco:description a owl:DatatypeProperty;
                 rdfs:comment "This property relates a description associated to an entity, in order to add details and some more information."@en,
                              "Questa proprietà rappresenta una descrizione associata a una certa entità, che viene arricchita con ulteriori dettagli che la descrivono."@it;
                 rdfs:domain owl:Thing;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                 rdfs:label "description"@en,
                            "descrizione"@it;
                 rdfs:range rdfs:Literal;
                 owl:versionInfo "stable"@en,
                                 "stabile"@it.
arco:hasAgent a owl:ObjectProperty;
              rdfs:comment "This property relates a situation in which an agent holds a role to that agent."@en,
                           "Questa proprietà collega una situazione in cui un ruolo viene ricoperto da un agente all'agente che lo ricopre."@it;
              rdfs:domain arco:AgentRole;
              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
              rdfs:label "has agent"@en,
                         "ha agente"@it;
              rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
              owl:inverseOf arco:isAgentOf;
              owl:versionInfo "stabile"@it,
                              "stable"@en.
arco:hasAgentRole a owl:ObjectProperty;
                  rdfs:comment "Questa proprietà collega un'entità a una situazione in cui un agente ricopre un ruolo."@it,
                               "This property relates an entity to a situation in which an agent holds a role connected to that entity."@en;
                  rdfs:domain owl:Thing;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                  rdfs:label "ha ruolo ricoperto da agente"@it,
                             "has agent role"@en;
                  rdfs:range arco:AgentRole;
                  rdfs:subPropertyOf arco:hasSituation;
                  owl:inverseOf arco:isAgentRoleOf;
                  owl:versionInfo "stable"@en,
                                  "stabile"@it.
arco:hasCategory a owl:ObjectProperty;
                 rdfs:comment "The object property that associates any object with a category."@en,
                              "La object property che associa un qualunque oggetto a una categoria."@it;
                 rdfs:domain owl:Thing;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                 rdfs:label "ha categoria"@it,
                            "has category"@en;
                 rdfs:range arco:Category;
                 rdfs:subPropertyOf arco:hasConcept;
                 owl:inverseOf arco:isCategoryOf;
                 owl:versionInfo "stabile"@it,
                                 "stable"@en.
arco:hasCharacteristic a owl:ObjectProperty;
                       rdfs:comment "The object property that links an entity to one of its characteristics."@en,
                                    "La object property che collega un'entità a una sua caratteristica."@it;
                       rdfs:domain owl:Thing;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                       rdfs:label "ha caratteristica"@it,
                                  "has characteristic"@en;
                       rdfs:range <https://w3id.org/italia/onto/l0/Characteristic>;
                       owl:inverseOf arco:isCharacteristicOf;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en.
arco:hasClassification <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl>;
                       a owl:ObjectProperty;
                       rdfs:comment "The object property that allows to add a classification to any object."@en,
                                    "La object property che permette di aggiungere una classificazione a un qualsiasi oggetto."@it;
                       rdfs:domain owl:Thing;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                       rdfs:label "ha classificazione"@it,
                                  "has classification"@en;
                       rdfs:range arco:Classification;
                       rdfs:subPropertyOf arco:hasSituation;
                       owl:inverseOf arco:isClassificationOf.
arco:hasComponent <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/componency.owl>;
                  a owl:ObjectProperty;
                  rdfs:comment "This property relates, non-transitively, an entity to a component."@en,
                               "Questa proprietà collega, in maniera non-transitiva, un'entità a un suo componente."@it;
                  rdfs:domain owl:Thing;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                  rdfs:label "ha componente"@it,
                             "has component"@en;
                  rdfs:range owl:Thing;
                  rdfs:subPropertyOf arco:hasPart;
                  owl:inverseOf arco:isComponentOf;
                  owl:versionInfo "stabile"@it,
                                  "stable"@en.
arco:hasConcept <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#>;
                a owl:ObjectProperty;
                rdfs:comment "The object property that associates any object with a concept, classifying it."@en,
                             "La object property che associa un qualunque oggetto a un concetto, che lo classifica."@it;
                rdfs:domain owl:Thing;
                rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                rdfs:label "has concept"@en,
                           "ha concetto"@it;
                rdfs:range arco:Concept;
                owl:inverseOf arco:isConceptOf;
                owl:versionInfo "stable"@en,
                                "stabile"@it.
arco:hasCulturalEntityCharacteristic a owl:ObjectProperty;
                                     rdfs:comment "La object property che collega una cultural entity a una sua caratteristica."@it,
                                                  "The object property that links a cultural entity to one of its characteristics."@en;
                                     rdfs:domain cis:CulturalEntity;
                                     rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                                     rdfs:label "ha caratteristica di entità culturale"@it,
                                                "has cultural entity characteristic"@en;
                                     rdfs:range arco:CulturalEntityCharacteristic;
                                     rdfs:subPropertyOf arco:hasCharacteristic;
                                     owl:inverseOf arco:isCulturalEntityCharacteristicOf;
                                     owl:versionInfo "stabile"@it,
                                                     "stable"@en.
arco:hasLocation <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/place.owl#>;
                 a owl:ObjectProperty;
                 rdfs:comment "La object property che collega un'entità a un luogo in cui si trova."@it,
                              "The object property that associates an entity to a location."@en;
                 rdfs:domain owl:Thing;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                 rdfs:label "ha luogo"@it,
                            "has location"@en;
                 rdfs:range <https://w3id.org/italia/onto/l0/Location>;
                 owl:inverseOf arco:isLocationOf;
                 owl:versionInfo "stabile"@it,
                                 "stable"@en.
arco:hasMethod a owl:ObjectProperty;
               rdfs:comment "L'object property che collega un'entità a un metodo."@it,
                            "The object property that links an entity to a method."@en;
               rdfs:domain owl:Thing;
               rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
               rdfs:label "ha metodo"@it,
                          "has method"@en;
               rdfs:range arco:Method;
               rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription>;
               owl:inverseOf arco:isMethodOf;
               owl:versionInfo "stable"@en,
                               "stabile"@it.
arco:hasPart <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/partof.owl>;
             a owl:ObjectProperty,
               owl:TransitiveProperty;
             rdfs:comment "This property relates an entity to its part."@en,
                          "Questa proprietà collega un'entità a una sua parte."@it;
             rdfs:domain owl:Thing;
             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
             rdfs:label "has part"@en,
                        "ha parte"@it;
             rdfs:range owl:Thing;
             owl:inverseOf arco:isPartOf;
             owl:versionInfo "stabile"@it,
                             "stable"@en;
             arco:iccdNormTag """\"Riferimento alla parte\", presente in molti campi strutturati delle normative ICCD"""@it.
arco:hasRole a owl:ObjectProperty;
             rdfs:comment "This property relates a situation in which an agent holds a role to that role."@en,
                          "Questa proprietà collega una situazione in cui un ruolo viene ricoperto da un agente al ruolo stesso."@it;
             rdfs:domain arco:AgentRole;
             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
             rdfs:label "has role"@en,
                        "ha ruolo"@it;
             rdfs:range <https://w3id.org/italia/onto/RO/Role>;
             owl:inverseOf arco:isRoleOf;
             owl:versionInfo "stable"@en,
                             "stabile"@it.
arco:hasSituation <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
                  a owl:ObjectProperty;
                  rdfs:comment "La proprietà che collega un qualsiasi oggetto a una situazione."@it,
                               "The property that links any object to a situation."@en;
                  rdfs:domain owl:Thing;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                  rdfs:label "ha situazione"@it,
                             "has situation"@en;
                  rdfs:range arco:Situation;
                  owl:inverseOf arco:isSituationOf.
arco:hasTimeIndexedSituation <http://ontologydesignpatterns.org/opla/isNativeTo> <http://ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                             a owl:ObjectProperty;
                             rdfs:comment "La proprietà che collega un qualsiasi oggetto a una situazione indicizzata nel tempo."@it,
                                          "The property that links any object to a time indexed situation."@en;
                             rdfs:domain owl:Thing;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                             rdfs:label "has time indexed situation"@en,
                                        "ha situazione nel tempo"@it;
                             rdfs:range arco:TimeIndexedSituation;
                             rdfs:subPropertyOf arco:hasSituation;
                             owl:inverseOf arco:isTimeIndexedSituationOf;
                             owl:versionInfo "stable"@en,
                                             "stabile"@it.
arco:hasType a owl:ObjectProperty;
             rdfs:comment "The object property that associates any object with a type."@en,
                          "La object property che associa un qualunque oggetto a un tipo."@it;
             rdfs:domain owl:Thing;
             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
             rdfs:label "ha tipo"@it,
                        "has type"@en;
             rdfs:range arco:Type;
             rdfs:subPropertyOf arco:hasConcept;
             owl:inverseOf arco:isTypeOf;
             owl:versionInfo "stabile"@it,
                             "stable"@en.
arco:iccdNormTag a owl:AnnotationProperty.
arco:isAgentOf a owl:ObjectProperty;
               rdfs:comment """Questa proprietà, inversa a \"ha agente\", collega un agente alla situazione in cui l'agente ha ricoperto un ruolo."""@it,
                            "This property relates an agent to a situation in which that agent holds a role."@en;
               rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
               rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
               rdfs:label "is agent of"@en,
                          "è agente in"@it;
               rdfs:range arco:AgentRole;
               owl:versionInfo "stable"@en,
                               "stabile"@it.
arco:isAgentRoleOf a owl:ObjectProperty;
                   rdfs:comment "Questa proprietà collega una situazione in cui un agente ricopre un ruolo relativo a un'entità all'entità."@it,
                                "This property relates a situation in which an agent holds a role connected to an entity to that entity."@en;
                   rdfs:domain arco:AgentRole;
                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                   rdfs:label "is agent role of"@en,
                              "è ruolo ricoperto da agente di"@it;
                   rdfs:range owl:Thing;
                   rdfs:subPropertyOf arco:isSituationOf;
                   owl:versionInfo "stable"@en,
                                   "stabile"@it.
arco:isCategoryOf a owl:ObjectProperty;
                  rdfs:comment "La object property che associa una categoria a un qualunque oggetto."@it,
                               "The object property that associates a category to any object."@en;
                  rdfs:domain owl:Thing;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                  rdfs:label "è categoria di"@it,
                             "is category of"@en;
                  rdfs:range arco:Category;
                  rdfs:subPropertyOf arco:isConceptOf;
                  owl:versionInfo "stable"@en,
                                  "stabile"@it.
arco:isCharacteristicOf a owl:ObjectProperty;
                        rdfs:comment "The object property that links an entity characteristic to the entity."@en,
                                     "La object property che collega una caratteristica di un'entità all'entità stessa."@it;
                        rdfs:domain <https://w3id.org/italia/onto/l0/Characteristic>;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                        rdfs:label "is characteristic of"@en,
                                   "è caratteristica di"@it;
                        rdfs:range owl:Thing;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
arco:isClassificationOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/countingas.owl>;
                        a owl:ObjectProperty;
                        rdfs:comment "The inverse object property of hasClassification, that links an object to a classification."@en,
                                     "La proprietà inversa di hasClassification, che collega un oggetto a una sua classificazione."@it;
                        rdfs:domain arco:Classification;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                        rdfs:label "is classification of"@en,
                                   "è classificazione di"@it;
                        rdfs:range owl:Thing;
                        rdfs:subPropertyOf arco:isSituationOf;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
arco:isComponentOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/componency.owl>;
                   a owl:ObjectProperty;
                   rdfs:comment "Questa proprietà collega, in maniera non-transitiva, un componente a un'entità di cui è componente."@it,
                                "This property relates, non-transitively, a component to an entity of which it is component."@en;
                   rdfs:domain owl:Thing;
                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                   rdfs:label "è componente di"@it,
                              "is component of"@en;
                   rdfs:range owl:Thing;
                   rdfs:subPropertyOf arco:isPartOf;
                   owl:versionInfo "stabile"@it,
                                   "stable"@en.
arco:isConceptOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#>;
                 a owl:ObjectProperty;
                 rdfs:comment "La proprietà inversa di hasConcept, che collega un concetto a un qualunque oggetto."@it,
                              "The inverse property of hasConcept, that relates a concept to any object."@en;
                 rdfs:domain arco:Concept;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                 rdfs:label "is concept of"@en,
                            "è concetto di"@it;
                 rdfs:range owl:Thing;
                 owl:versionInfo "stable"@en,
                                 "stabile"@it.
arco:isCulturalEntityCharacteristicOf a owl:ObjectProperty;
                                      rdfs:comment "The object property that links a cultural entity characteristic to the cultural entity."@it,
                                                   "La object property che collega una caratteristica di una cultural entity alla cultural entity."@it;
                                      rdfs:domain arco:CulturalEntityCharacteristic;
                                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                                      rdfs:label "è caratteristica di entità culturale di"@it,
                                                 "is cultural entity characteristic of"@en;
                                      rdfs:range cis:CulturalEntity;
                                      rdfs:subPropertyOf arco:isCharacteristicOf;
                                      owl:versionInfo "stabile"@it,
                                                      "stable"@en.
arco:isLocationOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/place.owl#>;
                  a owl:ObjectProperty;
                  rdfs:comment "The object property that associates a location to an entity located there."@en,
                               "La object property che collega un luogo a un'entità che si trova in quel luogo."@it;
                  rdfs:domain <https://w3id.org/italia/onto/l0/Location>;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                  rdfs:label "è luogo di"@it,
                             "is location of"@en;
                  rdfs:range owl:Thing;
                  owl:versionInfo "stable"@en,
                                  "stabile"@it.
arco:isMethodOf a owl:ObjectProperty;
                rdfs:comment "The object property that links a method to an entity."@en,
                             "L'object property che collega un metodo a un'entità."@it;
                rdfs:domain arco:Method;
                rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                rdfs:label "è metodo di"@it,
                           "is method of"@en;
                rdfs:range owl:Thing;
                rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/isDescriptionOf>;
                owl:versionInfo "stable"@en,
                                "stabile"@it.
arco:isPartOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/partof.owl>;
              a owl:TransitiveProperty,
                owl:ObjectProperty;
              rdfs:comment "This property relates the part of an entity to that entity."@en,
                           "Questa proprietà collega una parte di un'entità all'entità."@it;
              rdfs:domain owl:Thing;
              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
              rdfs:label "is part of"@en,
                         "è parte di"@it;
              rdfs:range owl:Thing;
              owl:versionInfo "stable"@en,
                              "stabile"@it;
              arco:iccdNormTag """\"Riferimento alla parte\", presente in molti campi strutturati delle normative ICCD"""@it.
arco:isRoleOf a owl:ObjectProperty;
              rdfs:comment "Questa proprietà collega un ruolo a una situazione in cui il ruolo viene ricoperto da un agente."@it,
                           "This property relates a role to a situation in which an agent holds that role."@en;
              rdfs:domain <https://w3id.org/italia/onto/RO/Role>;
              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
              rdfs:label "is role of"@en,
                         "è ruolo in"@it;
              rdfs:range arco:AgentRole;
              owl:versionInfo "stabile"@it,
                              "stable"@en.
arco:isSituationOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
                   a owl:ObjectProperty;
                   rdfs:comment "La proprietà che collega una situazione ad un qualsiasi oggetto. La proprietà è modellata come proprietà inversa di hasSituation."@it,
                                "The property that links a situation to any object. The property is modelled as inverse object property of hasSituation."@en;
                   rdfs:domain arco:Situation;
                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                   rdfs:label "is situation of"@en,
                              "è situazione di"@it;
                   rdfs:range owl:Thing;
                   owl:versionInfo "stable"@en,
                                   "stabile"@it.
arco:isTimeIndexedSituationOf <http://ontologydesignpatterns.org/opla/isNativeTo> <http://ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                              a owl:ObjectProperty;
                              rdfs:comment "La proprietà che collega una situazione indicizzata nel tempo ad un qualsiasi oggetto. La proprietà è modellata come proprietà inversa di hasTimeIndexedSituation."@it,
                                           "The property that links a time indexed situation to any object. The property is modelled as inverse object property of hasTimeIndexedSituation."@en;
                              rdfs:domain arco:TimeIndexedSituation;
                              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                              rdfs:label "è situazione nel tempo di"@it,
                                         "is time indexed situation of"@en;
                              rdfs:range owl:Thing;
                              rdfs:subPropertyOf arco:isSituationOf;
                              owl:versionInfo "stable"@en,
                                              "stabile"@it.
arco:isTypeOf a owl:ObjectProperty;
              rdfs:comment "The object property that associates a type to any object."@en,
                           "La object property che associa un tipo a un qualunque oggetto."@it;
              rdfs:domain arco:Type;
              rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
              rdfs:label "is type of"@en,
                         "è tipo di"@it;
              rdfs:range owl:Thing;
              rdfs:subPropertyOf arco:isConceptOf;
              owl:versionInfo "stable"@en,
                              "stabile"@it.
arco:keyword a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:comment "Questa proprietà rappresenta una parola chiave relativa a un'entità, che può essere utilizzata per la ricerca dell'entità."@it,
                          "This property represents a keyword related to an entity, used to search for that entity."@en;
             rdfs:domain owl:Thing;
             rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
             rdfs:label "keyword"@en,
                        "parola chiave"@it;
             rdfs:range rdfs:Literal;
             owl:versionInfo "stabile"@it,
                             "stable"@en;
             arco:iccdNormTag "ICCD Normativa PST: CT/CTC".
arco:note a owl:DatatypeProperty;
          rdfs:comment "Questa proprietà rappresenta eventuali note, relative a una certa informazione."@it,
                       "This property represents notes associated to a piece of information."@en;
          rdfs:domain owl:Thing;
          rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
          rdfs:label "note"@it,
                     "note"@en;
          rdfs:range rdfs:Literal;
          owl:versionInfo "stable"@en,
                          "stabile"@it.
arco:specifications a owl:DatatypeProperty;
                    rdfs:comment "This property represents specifications associated to a piece of information."@en,
                                 "Questa proprietà rappresenta eventuali specifiche, relative a una certa informazione."@it;
                    rdfs:domain owl:Thing;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/core>;
                    rdfs:label "specifications"@en,
                               "specifiche"@it;
                    rdfs:range rdfs:Literal;
                    owl:versionInfo "stabile"@it,
                                    "stable"@en.
<https://w3id.org/italia/onto/RO/Role> a owl:Class;
                                       rdfs:subClassOf arco:Concept.
<https://w3id.org/italia/onto/l0/Agent> a owl:Class.
<https://w3id.org/italia/onto/l0/Characteristic> a owl:Class.
<https://w3id.org/italia/onto/l0/Concept> a owl:Class;
                                          rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object>.
<https://w3id.org/italia/onto/l0/Description> a owl:Class.
<https://w3id.org/italia/onto/l0/EventOrSituation> a owl:Class.
<https://w3id.org/italia/onto/l0/Location> a owl:Class.
<https://w3id.org/italia/onto/l0/Object> a owl:Class.
<https://w3id.org/italia/onto/l0/hasDescription> a owl:ObjectProperty.
<https://w3id.org/italia/onto/l0/hasTopic> a owl:ObjectProperty.
<https://w3id.org/italia/onto/l0/isDescriptionOf> a owl:ObjectProperty.
<https://w3id.org/italia/onto/l0/isTopicOf> a owl:ObjectProperty.
