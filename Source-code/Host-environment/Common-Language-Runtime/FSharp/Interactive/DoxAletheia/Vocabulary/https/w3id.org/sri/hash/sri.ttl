@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix sdmxm: <http://purl.org/linked-data/sdmx/2009/measure#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix w3id: <https://w3id.org/>.
@prefix sri: <https://w3id.org/sri#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix schemas: <https://schema.org/>.

dcterms:bibliographicCitation a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:publisher a owl:AnnotationProperty.
dcterms:source a owl:AnnotationProperty.
qb: a owl:Class.
sdmxm:obsValue a owl:DatatypeProperty.
bibo:doi a owl:AnnotationProperty.
bibo:status a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
skos:broader a owl:ObjectProperty.
<https://orcid.org/0000-0001-9521-8907> rdfs:label "Stefan Bischof";
                                        schemas:affiliation <https://www.siemens.at/>.
<https://orcid.org/0000-0002-3050-159X> rdfs:label "Josiane Xavier Parreira";
                                        schemas:affiliation <https://www.siemens.at/>.
<https://orcid.org/0000-0003-3445-0504> rdfs:label "Erwin Filtz";
                                        schemas:affiliation <https://www.siemens.at/>.
schemas:affiliation a owl:AnnotationProperty.
schemas:funding a owl:AnnotationProperty.
schemas:image a owl:AnnotationProperty.
schemas:logo a owl:AnnotationProperty.
w3id:sri dcterms:bibliographicCitation "Stefan Bischof, Erwin Filtz, Josiane Xavier Parreira. Smart Readiness Indicator Vocabulary. Revision: 1.0.0. Retrieved from: https://w3id.org/sri/1.0"@en;
         dcterms:contributor <https://orcid.org/0000-0003-3445-0504>,
                             <https://orcid.org/0000-0002-3050-159X>;
         dcterms:created "2022-02-02"^^xsd:date;
         dcterms:creator <https://orcid.org/0000-0001-9521-8907>;
         dcterms:description "A vocabulary specifying concepts and structures needed to represent different data cubes needed for the Smart Readiness Indicator.";
         dcterms:issued "2023-11-30"^^xsd:date;
         dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
         dcterms:modified "2023-11-30"^^xsd:date;
         dcterms:publisher <https://www.siemens.at/>;
         dcterms:source <https://data.europa.eu/doi/10.2833/41100>;
         dcterms:title "Smart Readiness Indicator Vocabulary"@en;
         bibo:doi "10.5281/zenodo.10047286";
         bibo:status <http://purl.org/ontology/bibo/status/published>;
         vann:preferredNamespacePrefix "sri";
         vann:preferredNamespaceUri "https://w3id.org/sri#";
         a owl:Ontology;
         rdfs:label "Smart Readiness Indicator Vocabulary"@en;
         rdfs:seeAlso <https://energy.ec.europa.eu/topics/energy-efficiency/energy-efficient-buildings/smart-readiness-indicator_en>;
         owl:imports <http://purl.org/linked-data/cube>;
         owl:versionIRI <https://w3id.org/sri/1.0>;
         owl:versionInfo "1.0.0";
         schemas:funding <https://cordis.europa.eu/project/id/893079>;
         schemas:image <https://raw.githubusercontent.com/stefanbischof/sri/main/sridiagram.svg>;
         schemas:logo <https://raw.githubusercontent.com/stefanbischof/sri/main/srilogo.svg>.
sri:Building a owl:Class;
             rdfs:comment "This represents a building which is assessed."@en;
             rdfs:label "Building"@en.
sri:Domain a owl:Class;
           rdfs:comment "Class of technical domains."@en;
           rdfs:label "Domain"@en;
           rdfs:subClassOf [owl:onProperty skos:narrower ; 
                            owl:allValuesFrom sri:Service ; 
                            a owl:Restriction],
                           sri:FunctionalThing;
           owl:disjointWith sri:Service.
sri:FunctionalThing a owl:Class;
                    rdfs:comment "Class of instances in the functional hierarchy, this includes Domains and Services."@en;
                    rdfs:label "FunctionalThing"@en.
sri:Impact a owl:Class;
           rdfs:comment "Class of Impacts."@en;
           rdfs:label "Impact"@en;
           rdfs:subClassOf [owl:onProperty skos:broader ; 
                            owl:allValuesFrom sri:KeyCapability ; 
                            a owl:Restriction],
                           sri:ImpactThing;
           owl:disjointWith sri:KeyCapability.
sri:ImpactThing a owl:Class;
                rdfs:comment "Class of all instances in the impact hierarchy, this includes Impacts and Key Capabilities."@en;
                rdfs:label "ImpactThing"@en.
sri:KeyCapability a owl:Class;
                  rdfs:comment "Class of all Key Capabilities, aggregation of Impacts."@en;
                  rdfs:label "KeyCapability"@en;
                  rdfs:subClassOf [owl:onProperty skos:narrower ; 
                                   owl:allValuesFrom sri:Impact ; 
                                   a owl:Restriction],
                                  sri:ImpactThing.
sri:Level a owl:Class;
          rdfs:comment "Class of service levels."@en;
          rdfs:label "Level"@en.
sri:Service a owl:Class;
            rdfs:comment "Class for Services."@en;
            rdfs:label "Service"@en;
            rdfs:subClassOf [owl:onProperty skos:broader ; 
                             owl:allValuesFrom sri:Domain ; 
                             a owl:Restriction],
                            sri:FunctionalThing.
sri:ServiceCatalogue a owl:Class;
                     rdfs:comment "A Service Catalogue is a collection of services used in an assessment."@en;
                     rdfs:label "Service catalogue"@en.
sri:ServiceLevel a owl:Class;
                 rdfs:comment "Class for all ServiceLevel instances, which are all allowed/defined combinations of Services and Levels."@en;
                 rdfs:label "Service level"@en;
                 rdfs:subClassOf [owl:someValuesFrom sri:Service ; 
                                  owl:onProperty sri:function ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom sri:Level ; 
                                  owl:onProperty sri:level ; 
                                  a owl:Restriction].
sri:adaptTheirOperationToTheNeedsOfTheOccupant a owl:NamedIndividual,
                                                 sri:KeyCapability;
                                               rdfs:label "Adapt their operation to the needs of the occupant"@en;
                                               skos:narrower sri:comfort,
                                                             sri:convenience,
                                                             sri:health_well_being_and_accessibility,
                                                             sri:information_to_occupants.
sri:adaptToSignalsFromTheGrid a owl:NamedIndividual,
                                sri:KeyCapability;
                              rdfs:label "Adapt to signals from the grid"@en;
                              skos:narrower sri:energy_flexibility_and_storage.
sri:additionalLevel a owl:ObjectProperty;
                    rdfs:comment "Additional Level if share is < 100%."@en;
                    rdfs:label "additional level"@en;
                    rdfs:range sri:Level.
sri:assessment a owl:ObjectProperty;
               rdfs:comment "Relates something to an assessment dataset."@en;
               rdfs:label "assessment"@en;
               rdfs:range [owl:onProperty qb:structure ; 
                           owl:hasValue sri:dsd-assessment ; 
                           a owl:Restriction],
                          qb:DataSet.
sri:building a owl:ObjectProperty;
             rdfs:comment "Relates something to a Building."@en;
             rdfs:label "building"@en;
             rdfs:range sri:Building.
sri:comfort a owl:NamedIndividual,
              sri:Impact;
            rdfs:label "Comfort"@en.
sri:convenience a owl:NamedIndividual,
                  sri:Impact;
                rdfs:label "Convenience"@en.
sri:cooling a owl:NamedIndividual,
              sri:Domain;
            rdfs:label "Cooling"@en.
sri:dE a owl:NamedIndividual,
         sri:Domain;
       rdfs:label "Dynamic building envelope"@en.
sri:dHW a owl:NamedIndividual,
          sri:Domain;
        rdfs:label "Domestic hot water"@en.
sri:dsd-assessment qb:component [qb:dimension sri:function],
                                [qb:measure sri:level];
                   a owl:NamedIndividual,
                     qb:DataStructureDefinition.
sri:dsd-scores qb:component [qb:dimension sri:impact],
                            [qb:dimension sri:function],
                            [qb:measure sri:score];
               a owl:NamedIndividual,
                 qb:DataStructureDefinition.
sri:dsd-sriscores qb:component [qb:dimension sri:function],
                               [qb:dimension sri:level],
                               [qb:measure sri:icscore];
                  a owl:NamedIndividual,
                    qb:DataStructureDefinition;
                  rdfs:label "SRI scores DSD"@en.
sri:dsd-weights qb:component [qb:measure sri:weight],
                             [qb:dimension sri:impact],
                             [qb:dimension sri:function];
                a owl:NamedIndividual,
                  qb:DataStructureDefinition.
sri:eV a owl:NamedIndividual,
         sri:Domain;
       rdfs:label "Electric vehicle charging"@en.
sri:electricity a owl:NamedIndividual,
                  sri:Domain;
                rdfs:label "Electricity"@en.
sri:energy_efficiency a owl:NamedIndividual,
                        sri:Impact;
                      rdfs:label "Energy efficiency"@en.
sri:energy_flexibility_and_storage a owl:NamedIndividual,
                                     sri:Impact;
                                   rdfs:label "Energy flexibility and storage"@en.
sri:function a owl:ObjectProperty,
               owl:FunctionalProperty,
               owl:NamedIndividual;
             rdfs:comment "Relates something to a FunctionalThing."@en;
             rdfs:label "function"@en;
             rdfs:range sri:FunctionalThing.
sri:health_well_being_and_accessibility a owl:NamedIndividual,
                                          sri:Impact;
                                        rdfs:label "Health well being and accessibility"@en.
sri:heating a owl:NamedIndividual,
              sri:Domain;
            rdfs:label "Heating"@en.
sri:icscore a owl:DatatypeProperty,
              owl:NamedIndividual,
              qb:MeasureProperty;
            rdfs:comment "The impact criterion score is defined for Services and calculated for Domains in Step 3."@en;
            rdfs:label "impact criterion score"@en;
            rdfs:range xsd:integer;
            rdfs:subPropertyOf sdmxm:obsValue.
sri:impact a owl:ObjectProperty,
             owl:FunctionalProperty,
             owl:NamedIndividual;
           rdfs:comment "Relates something to an ImpactThing."@en;
           rdfs:label "impact"@en;
           rdfs:range sri:ImpactThing.
sri:information_to_occupants a owl:NamedIndividual,
                               sri:Impact;
                             rdfs:label "Information to occupants"@en.
sri:level a owl:ObjectProperty,
            owl:FunctionalProperty,
            owl:NamedIndividual;
          rdfs:comment "Relates something to a Level."@en;
          rdfs:label "level"@en;
          rdfs:range sri:Level.
sri:level0 a owl:NamedIndividual,
             sri:Level;
           rdfs:label "Level 0"@en.
sri:level1 a owl:NamedIndividual,
             sri:Level;
           rdfs:label "Level 1"@en.
sri:level2 a owl:NamedIndividual,
             sri:Level;
           rdfs:label "Level 2"@en.
sri:level3 a owl:NamedIndividual,
             sri:Level;
           rdfs:label "Level 3"@en.
sri:level4 a owl:NamedIndividual,
             sri:Level;
           rdfs:label "Level 4"@en.
sri:lighting a owl:NamedIndividual,
               sri:Domain;
             rdfs:label "Lighting"@en.
sri:mC a owl:NamedIndividual,
         sri:Domain;
       rdfs:label "Monitoring and control"@en.
sri:maintenance_and_fault_prediction a owl:NamedIndividual,
                                       sri:Impact;
                                     rdfs:label "Maintenance and fault prediction"@en.
sri:max a owl:DatatypeProperty,
          owl:NamedIndividual,
          qb:;
        rdfs:comment "Maximum impact criterion score. This is defined for Domains and calculated in Step 4."@en;
        rdfs:label "maximum impact criterion score"@en;
        rdfs:range xsd:integer.
sri:optimiseEnergyEfficiencyAndOverallIn-UsePerformance a owl:NamedIndividual,
                                                          sri:KeyCapability;
                                                        rdfs:label "Optimise energy efficiency and overall in-use performance"@en;
                                                        skos:narrower sri:energy_efficiency,
                                                                      sri:maintenance_and_fault_prediction.
sri:score a owl:DatatypeProperty,
            owl:FunctionalProperty,
            owl:NamedIndividual,
            qb:MeasureProperty;
          rdfs:comment "The smart-readiness score is defined for ImpactThings on all levels from Impacts to the complete Building (Steps 5, 6, and 7) and optionally for Domains (Step 8)"@en;
          rdfs:label "smart-readiness score"@en;
          rdfs:range [owl:unionOf (xsd:decimal
                                   xsd:double
                                   xsd:float) ; 
                      a rdfs:Datatype];
          rdfs:subPropertyOf sdmxm:obsValue.
sri:serviceCatalogue a owl:ObjectProperty;
                     rdfs:comment "Relates something to a ServiceCatalogue."@en;
                     rdfs:label "service catalogue"@en;
                     rdfs:range sri:ServiceCatalogue.
sri:share a owl:DatatypeProperty,
            owl:FunctionalProperty;
          rdfs:comment "A percentage (value between 0.0 and 1.0) which expresses that parts of a building are assessed with different levels wrt. a Service. If share is < 100% then additionalLevel has to be defined."@en;
          rdfs:label "share"@en;
          rdfs:range [owl:unionOf (xsd:decimal
                                   xsd:double
                                   xsd:float) ; 
                      a rdfs:Datatype].
sri:topDomain a owl:NamedIndividual,
                sri:FunctionalThing;
              rdfs:label "All domains"@en;
              skos:narrower sri:lighting,
                            sri:cooling,
                            sri:dE,
                            sri:mC,
                            sri:heating,
                            sri:electricity,
                            sri:ventilation,
                            sri:eV,
                            sri:dHW.
sri:topImpact a owl:NamedIndividual,
                sri:ImpactThing;
              rdfs:label "All impacts"@en;
              skos:narrower sri:adaptTheirOperationToTheNeedsOfTheOccupant,
                            sri:adaptToSignalsFromTheGrid,
                            sri:optimiseEnergyEfficiencyAndOverallIn-UsePerformance.
sri:ventilation a owl:NamedIndividual,
                  sri:Domain;
                rdfs:label "Ventilation"@en.
sri:weight a owl:DatatypeProperty,
             owl:FunctionalProperty,
             owl:NamedIndividual,
             qb:MeasureProperty;
           rdfs:comment "A weight of the weight matrix used for weighing the smart-readiness scores before aggregation."@en;
           rdfs:label "weight"@en;
           rdfs:range [owl:unionOf (xsd:decimal
                                    xsd:double
                                    xsd:float) ; 
                       a rdfs:Datatype];
           rdfs:subPropertyOf sdmxm:obsValue.
<https://www.siemens.at/> rdfs:label "Siemens AG Österreich".
