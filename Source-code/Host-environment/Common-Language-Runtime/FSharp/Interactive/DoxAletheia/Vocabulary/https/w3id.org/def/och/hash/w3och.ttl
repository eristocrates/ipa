@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3och: <https://w3id.org/def/och#>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/bibliographicCitation> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdf:Property a <http://www.w3.org/2002/07/owl#Class>.
rdfs:Datatype a <http://www.w3.org/2002/07/owl#Class>.
rdfs:Resource a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#Class> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#DatatypeProperty> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#ObjectProperty> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#Ontology> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#priorVersion> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#versionIRI> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/dcat#Dataset> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/Agent> a <http://www.w3.org/2002/07/owl#Class>.
w3och: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/legalcode>;
       <http://purl.org/dc/terms/abstract> "As any other engineering product, ontologies evolve during their lifecycle due to several reasons such as accommodating new requirements or fixing issues. To keep track of these changes, several tools have defined ad-hoc formalisms to define and manage them. However, some of them are not based on standard interoperable languages such as RDF, and the RDF-based ones cover a limited set of changes. In this paper, we present the OWL Change Ontology (OCH), an ontology to capture changes in ontologies. Developed following the LOT methodology, OCH provides a declarative framework for documenting ontology changelogs. With this approach, ontologies gain a valuable resource to improve their lifecycle management, while associated semantic products such as declarative mappings (e.g., RML) and validation shapes (e.g., SHACL) can take advantage of standardized and machine-readable changelogs to streamline their schema evolution.";
       <http://purl.org/dc/terms/bibliographicCitation> "Conde-Herreros, D. Pernisch, R., Poveda-Villalón, M., Corcho, O., & Chaves-Fraga, D. (2024). OCH: The OWL Change Ontology";
       <http://purl.org/dc/terms/contributor> "Diego Conde Herreros";
       <http://purl.org/dc/terms/created> "2024-04-17"^^xsd:date;
       <http://purl.org/dc/terms/creator> "Diego Conde-Herreros",
                                          "María Poveda-Villalón",
                                          "David Chaves-Fraga",
                                          "Romana Pernisch",
                                          "Oscar Corcho";
       <http://purl.org/dc/terms/description> "An ontology for describing changes between OWL ontology versions";
       <http://purl.org/dc/terms/modified> "2024-12-19"^^xsd:date;
       <http://purl.org/dc/terms/title> "OWL Change Ontology";
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "och";
       <http://purl.org/vocab/vann/preferredNamespaceUri> w3och:;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       <http://www.w3.org/2002/07/owl#versionInfo> "2.0.0"@en;
       <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/>.
w3och:AddCharacteristic a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The change operation corresponding to addition of a characteristic to a property";
                        rdfs:label "Add Characteristic";
                        rdfs:subClassOf w3och:PropertyCharacteristicChange.
w3och:AddClass a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The change operation corresponding to the addition of a class";
               rdfs:label "Add Class";
               rdfs:subClassOf w3och:ClassChange.
w3och:AddDataProperty a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The change operation corresponding to the addition of a data property";
                      rdfs:label "Add Data Property";
                      rdfs:subClassOf w3och:AddProperty,
                                      w3och:DataPropertyChange;
                      <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddDataProperty>.
w3och:AddDisjointProperty a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The change operation corresponding to the addition of a Disjoint Property relation between two properties";
                          rdfs:label "Add Disjoint Property";
                          rdfs:subClassOf w3och:DisjointPropertyChange.
w3och:AddDomain a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The change operation corresponding to the addition of the domain to a given property";
                rdfs:label "Add Domain";
                rdfs:subClassOf w3och:DomainChange;
                <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddDomain>.
w3och:AddEquivalentClass a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The change operation corresponding to the addition of an equivalent class relation between two classes";
                         rdfs:label "Add Equivalent Class";
                         rdfs:subClassOf w3och:EquivalentClassChange;
                         <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddEquivalentClass>.
w3och:AddEquivalentProperty a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The change operation corresponding to the addition of an equivalent property relation between two properties";
                            rdfs:label "Add Equivalent Property";
                            rdfs:subClassOf w3och:EquivalentPropertyChange.
w3och:AddIndividual a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The change operation corresponding to the addition of an individual to the ontology";
                    rdfs:label "Add Individual";
                    rdfs:subClassOf w3och:IndividualChange.
w3och:AddInverseProperty a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The change operation corresponding to the addition of an inverse property relation between two properties";
                         rdfs:label "Add Inverse Property";
                         rdfs:subClassOf w3och:InversePropertyChange.
w3och:AddObjectProperty a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The change operation corresponding to the addition of an object property";
                        rdfs:label "Add Object Property";
                        rdfs:subClassOf w3och:AddProperty,
                                        w3och:ObjectPropertyChange;
                        <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddObjectProperty>.
w3och:AddProperty a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The class that represents the addition of a property to an ontology";
                  rdfs:label "Add Property";
                  rdfs:subClassOf w3och:PropertyChange;
                  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddProperty>.
w3och:AddRange a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The change operation corresponding to the addition of the range to a given property";
               rdfs:label "Add Range";
               rdfs:subClassOf w3och:RangeChange;
               <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddRange>.
w3och:AddRangeDataProperty a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The change operation corresponding to the addition of the range of a given data property";
                           rdfs:label "Add Range Data Property";
                           rdfs:subClassOf w3och:AddRange.
w3och:AddRangeObjectProperty a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The change operation corresponding to the addition of the range of a given object property";
                             rdfs:label "Add Range Object Property";
                             rdfs:subClassOf w3och:AddRange.
w3och:AddRelationToIndividual a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "The change operation corresponding to the addition of a relation between two individuals";
                              rdfs:label "Add Relation to Individual";
                              rdfs:subClassOf w3och:IndividualRelationChange.
w3och:AddSubClass a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The change operation corresponding to the addition of a subClass relation between two classes";
                  rdfs:label "Add Sub Class";
                  rdfs:subClassOf w3och:SubClassChange.
w3och:AddSubPropertyOf a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "The change operation corresponding to the addition of a subProperty relation between two properties";
                       rdfs:label "Add Sub Property Of";
                       rdfs:subClassOf w3och:SubPropertyChange;
                       <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesAddSubPropertyOf>.
w3och:AsymmetricProperty a w3och:ObjectPropertyCharacteristic;
                         rdfs:comment "The term that describes asymmetric properties."@en;
                         rdfs:label "Asymmetric Property"@en.
w3och:ChangeSet a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The class for representing sets of changes, it can be used for representing complex changes made out of atomic changes.";
                rdfs:label "Change Set";
                rdfs:subClassOf w3och:Changelog.
w3och:Changelog a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The set of change operations between ontology versions";
                rdfs:label "Changelog";
                rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset>.
w3och:ClassChange a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The change operation corresponding to the change of a given class within the ontology";
                  rdfs:label "Class Change";
                  rdfs:subClassOf w3och:EntityChange;
                  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesClassChange>.
w3och:ClassRelationChange a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The change operation corresponding to the change of the relationship between two classes";
                          rdfs:label "Class Relation Change";
                          rdfs:subClassOf w3och:ClassChange.
w3och:DataPropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The change operation corresponding to the change of a data property";
                         rdfs:label "Data Property Change";
                         rdfs:subClassOf w3och:PropertyChange;
                         <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesDataPropertyChange>.
w3och:DeprecateEntity a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The change operation corresponding to the deprecation of an OWL Entity";
                      rdfs:label "Deprecate Entity";
                      rdfs:subClassOf w3och:EntityChange.
w3och:DisjointPropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The change operation corresponding to the change of a Disjoint Property";
                             rdfs:label "Disjoint Property Change";
                             rdfs:subClassOf w3och:PropertyRelationChange.
w3och:DomainChange a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The change operation corresponding to the change of the domain of a given property";
                   rdfs:label "Domain Change";
                   rdfs:subClassOf w3och:PropertyChange.
w3och:EntityChange a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The class that represents all changes to OWL Entities: classes, properties, and individuals";
                   rdfs:label "Entity Change";
                   rdfs:subClassOf w3och:OntologicalChange.
w3och:EquivalentClassChange a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The change operation corresponding to the change of an equivalent class relation between two classes";
                            rdfs:label "Equivalent Class Change";
                            rdfs:subClassOf w3och:ClassRelationChange;
                            <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesEquivalentClassChange>.
w3och:EquivalentPropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The change operation corresponding to the change of an equivalent property relation between two properties";
                               rdfs:label "Equivalent Property Change";
                               rdfs:subClassOf w3och:PropertyRelationChange.
w3och:FunctionalProperty a w3och:PropertyCharacteristic;
                         rdfs:comment "The term that describes Functional Properties."@en;
                         rdfs:label "Functional Property"@en.
w3och:IndividualChange a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "The change operation corresponding to the change of a given individual within the ontology";
                       rdfs:label "Individual Change";
                       rdfs:subClassOf w3och:EntityChange.
w3och:IndividualRelationChange a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The change operation corresponding to the change of a relationship between two individuals within the ontology";
                               rdfs:label "Individual Relation Change";
                               rdfs:subClassOf w3och:IndividualChange.
w3och:InverseFunctionalProperty a w3och:ObjectPropertyCharacteristic;
                                rdfs:comment "The term that describes the inverse functional properties."@en;
                                rdfs:label "Inverse Functional Property"@en.
w3och:InversePropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The change operation corresponding to the change of an inverse prop7 relation between two properties";
                            rdfs:label "Inverse Property Change";
                            rdfs:subClassOf w3och:PropertyRelationChange.
w3och:IrreflexiveProperty a w3och:ObjectPropertyCharacteristic;
                          rdfs:comment "The term that describes irreflexive properties."@en;
                          rdfs:label "Irreflexive Property"@en.
w3och:ObjectPropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The change operation corresponding to the change of an object property";
                           rdfs:label "Object Property Change";
                           rdfs:subClassOf w3och:PropertyChange;
                           <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesObjectPropertyChange>.
w3och:ObjectPropertyCharacteristic a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The term that describes those property characteristics that are exclusive to object properties"@en;
                                   rdfs:label "Object Property Characteristic"@en;
                                   rdfs:subClassOf w3och:PropertyCharacteristic.
w3och:OntologicalChange a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The class that represents all changes within an ontology being term-level, structural level, or higher level";
                        rdfs:label "Ontological Change";
                        <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesOntologyChange>.
w3och:PropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The class that represents changes to properties";
                     rdfs:label "Property Change";
                     rdfs:subClassOf w3och:EntityChange.
w3och:PropertyCharacteristic a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The top term that encompases all characteristics"@en;
                             rdfs:label "Property Characteristic"@en.
w3och:PropertyCharacteristicChange a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The change operation corresponding to the change of a property characteristic.";
                                   rdfs:label "Property Characteristic Change";
                                   rdfs:subClassOf w3och:PropertyChange.
w3och:PropertyRelationChange a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The class that represents changes to property relations";
                             rdfs:label "Property Relation Change";
                             rdfs:subClassOf w3och:PropertyChange.
w3och:RangeChange a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The change operation corresponding to the change of the range of a given property";
                  rdfs:label "Range Change";
                  rdfs:subClassOf w3och:PropertyChange.
w3och:ReflexiveProperty a w3och:ObjectPropertyCharacteristic;
                        rdfs:comment "The term that describes reflexive properties."@en;
                        rdfs:label "Reflexive Property"@en.
w3och:RemoveCharacteristic a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The change operation corresponding to the removal of a property characteristic";
                           rdfs:label "Remove Characteristic";
                           rdfs:subClassOf w3och:PropertyCharacteristicChange.
w3och:RemoveClass a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The change operation corresponding to the removal of a class";
                  rdfs:label "Remove Class";
                  rdfs:subClassOf w3och:ClassChange.
w3och:RemoveDataProperty a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The change operation corresponding to the removal of a data property";
                         rdfs:label "Remove Data Property";
                         rdfs:subClassOf w3och:DataPropertyChange,
                                         w3och:RemoveProperty;
                         <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveDataProperty>.
w3och:RemoveDisjointProperty a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The change operation corresponding to the removal of a Disjoint Property relation between two properties";
                             rdfs:label "Remove Disjoint Property";
                             rdfs:subClassOf w3och:DisjointPropertyChange.
w3och:RemoveDomain a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The change operation corresponding to the removal of the domain of a given property";
                   rdfs:label "Remove Domain";
                   rdfs:subClassOf w3och:DomainChange;
                   <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveDomain>.
w3och:RemoveEquivalentClass a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The change operation corresponding to the removal of the equivalent class relation between two classes";
                            rdfs:label "Remove Equivalent Class";
                            rdfs:subClassOf w3och:EquivalentClassChange;
                            <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveEquivalentClass>.
w3och:RemoveEquivalentProperty a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The change operation corresponding to the removal of the equivalent property relation between two properties";
                               rdfs:label "Remove Equivalent Property";
                               rdfs:subClassOf w3och:EquivalentPropertyChange.
w3och:RemoveIndividual a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "The change operation corresponding to the removal of an individual to the ontology";
                       rdfs:label "Remove Individual";
                       rdfs:subClassOf w3och:IndividualChange.
w3och:RemoveInverseProperty a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The change operation corresponding to the removal of the inverse property relation between two properties";
                            rdfs:label "Remove Inverse Property";
                            rdfs:subClassOf w3och:InversePropertyChange.
w3och:RemoveObjectProperty a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The change operation corresponding to the removal of an object property";
                           rdfs:label "Remove Object Property";
                           rdfs:subClassOf w3och:ObjectPropertyChange,
                                           w3och:RemoveProperty;
                           <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveObjectProperty>.
w3och:RemoveProperty a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The class that represents the removal of a property to an ontology";
                     rdfs:label "Remove Property";
                     rdfs:subClassOf w3och:PropertyChange;
                     <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveProperty>.
w3och:RemoveRange a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The change operation corresponding to the removal of the range of a given property";
                  rdfs:label "Remove Range";
                  rdfs:subClassOf w3och:RangeChange;
                  <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveRange>.
w3och:RemoveRangeDataProperty a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "The change operation corresponding to the removal of the range of a data property";
                              rdfs:label "Remove Range Data Property";
                              rdfs:subClassOf w3och:RemoveRange.
w3och:RemoveRangeObjectProperty a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "The change operation corresponding to the removal of the range off an object property";
                                rdfs:label "Remove Range Object Property";
                                rdfs:subClassOf w3och:RemoveRange.
w3och:RemoveRelationFromIndividual a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The change operation corresponding to the removal of a relation between two individuals";
                                   rdfs:label "Remove Relation from Individuals";
                                   rdfs:subClassOf w3och:IndividualRelationChange.
w3och:RemoveSubClass a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The change operation corresponding to the removal of the subClass relation between two classes";
                     rdfs:label "Remove Sub Class";
                     rdfs:subClassOf w3och:SubClassChange.
w3och:RemoveSubPropertyOf a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The change operation corresponding to the removal of the subProperty relation between two properties";
                          rdfs:label "Remove Sub Property Of";
                          rdfs:subClassOf w3och:SubPropertyChange;
                          <http://www.w3.org/ns/prov#wasDerivedFrom> <http://omv.ontoware.org/2007/07/OWLChangesRemoveSubPropertyOf>.
w3och:RenameEntity a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The change operation corresponding to the renaming of an OWL Entity within an ontology, this is whenever the semantics do not change and only the URI is modified";
                   rdfs:label "Rename Entity";
                   rdfs:subClassOf w3och:EntityChange.
w3och:RevokeDeprecate a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The change operation corresponding to the revokal of an ontological term";
                      rdfs:label "Revoke Deprecate";
                      rdfs:subClassOf w3och:EntityChange.
w3och:SubClassChange a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The class that represents changes to a subclass relationship between two classes.";
                     rdfs:label "Sub Class Change";
                     rdfs:subClassOf w3och:ClassRelationChange.
w3och:SubPropertyChange a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The change operation corresponding to the change of the subProperty relation between to properties";
                        rdfs:label "Sub Property Change";
                        rdfs:subClassOf w3och:PropertyRelationChange.
w3och:SymmetricProperty a w3och:ObjectPropertyCharacteristic;
                        rdfs:comment "The term that describes symmetric properties."@en;
                        rdfs:label "Symmetric Property"@en.
w3och:TransitiveProperty a w3och:ObjectPropertyCharacteristic;
                         rdfs:comment "The term that describes transitive properties."@en;
                         rdfs:label "Transitive Property"@en.
w3och:addedCharacteristic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "The characteristic being added to a given property";
                          rdfs:domain w3och:AddCharacteristic;
                          rdfs:label "added characteristic";
                          rdfs:range w3och:PropertyCharacteristic.
w3och:addedCharacteristicToProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "The property a characteristic is added to";
                                    rdfs:domain w3och:AddCharacteristic;
                                    rdfs:label "add Characteristic to property";
                                    rdfs:range rdf:Property.
w3och:addedClass a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The class being added in an AddClass operation";
                 rdfs:domain w3och:AddClass;
                 rdfs:label "added class";
                 rdfs:range <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:subPropertyOf w3och:addedEntity.
w3och:addedDataProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "The data property that is being added to the ontology";
                        rdfs:domain w3och:AddDataProperty;
                        rdfs:label "added data property";
                        rdfs:range <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:subPropertyOf w3och:addedEntity.
w3och:addedDataRange a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The range being added to a data property";
                     rdfs:domain w3och:AddRangeDataProperty;
                     rdfs:label "added data range";
                     rdfs:range rdfs:Datatype.
