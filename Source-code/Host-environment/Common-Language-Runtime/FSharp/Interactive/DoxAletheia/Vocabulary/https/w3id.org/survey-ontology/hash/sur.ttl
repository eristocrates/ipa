@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sur: <https://w3id.org/survey-ontology#>.

<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/subject> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/rv-ontology#Model> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:subClassOf <http://purl.org/wf4ever/ro#Resource>.
<http://w3id.org/rv-ontology#Variable> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/homepage> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<https://w3id.org/survey-ontology> a <http://www.w3.org/2002/07/owl#NamedIndividual>.
sur: <http://purl.org/dc/elements/1.1/contributor> "Work on the Survey Ontology and Coney (https://survey.actionproject.eu/coney/) was partially supported by the ACTION project (grant agreement number 824603), co-funded by the European Commission under the Horizon 2020 Framework Programme."@en;
     <http://purl.org/dc/elements/1.1/creator> "Irene Celino"@en,
                                               "Mario Scrocca"@en,
                                               "Damiano Scandolari"@en,
                                               "Gloria Re Calegari"@en;
     <http://purl.org/dc/elements/1.1/rights> """The Survey Ontology is available under the Creative Commons Attribution 3.0 Unported license; see http://creativecommons.org/licenses/by/3.0/. In a nutshell, you are free to copy, distribute and transmit the work; to remix/adapt the work (e.g. to import the ontology and create specializations of its elements), as long as you attribute the work in the manner specified by the author or licensor (but not in any way that suggests that they endorse you or your use of the work). Proper Attribution: Simply include the statement \"This work is based on the Survey Ontology, developed by the Knowledge Technologies group at Cefriel, Milan\" and link back to https://w3id.org/survey-ontology"""@en;
     <http://purl.org/dc/elements/1.1/subject> "Survey, Question, Answer, Variable"@en;
     <http://purl.org/dc/elements/1.1/title> "The Survey Ontology"@en;
     <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "sur";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/survey-ontology#";
     a <http://www.w3.org/2002/07/owl#NamedIndividual>,
       <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "Ontology for surveys based on the Coney data model."@en;
     rdfs:label "Survey Ontology"@en;
     <http://www.w3.org/2002/07/owl#imports> <http://purl.org/wf4ever/ro#>,
                                             <http://purl.org/wf4ever/wfdesc#>,
                                             <http://w3id.org/rv-ontology#>,
                                             <http://www.w3.org/ns/prov#>,
                                             <http://purl.org/linked-data/cube#>,
                                             <http://purl.org/wf4ever/wfprov#>;
     <http://www.w3.org/2002/07/owl#versionInfo> "V 1.0, Release 2020"@en;
     <http://xmlns.com/foaf/0.1/homepage> <https://w3id.org/survey-ontology>.
sur:Answer a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Answer";
           rdfs:subClassOf sur:SurveyElement;
           <http://www.w3.org/2002/07/owl#disjointWith> sur:Question,
                                                        sur:Talk.
sur:CheckboxQuestion a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Checkbox Question";
                     rdfs:subClassOf sur:ClosedQuestion.
sur:ClosedAnswer a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Closed Answer";
                 rdfs:subClassOf sur:Answer.
sur:ClosedQuestion a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Closed Question";
                   rdfs:subClassOf sur:Question.
sur:CompletedQuestion a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "Completed Question";
                      rdfs:subClassOf <http://purl.org/linked-data/cube#Observation>,
                                      <http://purl.org/wf4ever/wfdesc#Output>,
                                      <http://www.w3.org/ns/prov#Entity>.
sur:CompletedSurvey a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "Completed Survey";
                    rdfs:subClassOf <http://purl.org/linked-data/cube#Slice>,
                                    <http://purl.org/wf4ever/wfprov#Artifact>.
sur:Dropdown a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               sur:QuestionVisualization;
             rdfs:label "Dropdown".
sur:Emoji a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            sur:QuestionVisualization;
          rdfs:label "Emoji".
sur:LatentVariable a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Latent Variable";
                   rdfs:subClassOf <http://w3id.org/rv-ontology#Variable>.
sur:MultipleChoiceQuestion a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "Multiple Choice Question";
                           rdfs:subClassOf sur:ClosedQuestion.
sur:MutipleInputQuestion a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Multiple Input Question";
                         rdfs:subClassOf sur:OpenQuestion.
sur:ObservableVariable a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Observable Variable";
                       rdfs:subClassOf <http://w3id.org/rv-ontology#Variable>.
sur:OpenAnswer a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Open Answer";
               rdfs:subClassOf sur:Answer.
sur:OpenQuestion a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Open Question";
                 rdfs:subClassOf sur:Question.
sur:Option a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             sur:QuestionVisualization;
           rdfs:label "Option".
sur:Participant a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Participant";
                rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>.
sur:Question a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Question";
             rdfs:subClassOf sur:SurveyElement;
             <http://www.w3.org/2002/07/owl#disjointWith> sur:Talk.
sur:QuestionVisualization a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "Question Visualization";
                          rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
sur:Scale a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            sur:QuestionVisualization;
          rdfs:label "Scale".
sur:SingleInputQuestion a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "Single Input Question";
                        rdfs:subClassOf sur:OpenQuestion.
sur:Slider a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             sur:QuestionVisualization;
           rdfs:label "Slider".
sur:Survey a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Survey";
           rdfs:subClassOf <http://purl.org/wf4ever/ro#ResearchObject>.
sur:SurveyCompletionTask a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Survey Completion Task";
                         rdfs:subClassOf <http://purl.org/wf4ever/wfprov#ProcessRun>.
sur:SurveyDataSet a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Survey Dataset";
                  rdfs:subClassOf <http://purl.org/linked-data/cube#DataSet>,
                                  <http://purl.org/wf4ever/ro#Resource>.
sur:SurveyElement a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Survey Element";
                  rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
sur:SurveyProcedure a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "Survey Procedure";
                    rdfs:subClassOf <http://purl.org/wf4ever/ro#Resource>,
                                    <http://purl.org/wf4ever/wfdesc#Process>.
sur:SurveyTarget a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Survey Target";
                 rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
sur:Talk a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "Talk";
         rdfs:subClassOf sur:SurveyElement.
sur:answeredIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain sur:CompletedQuestion;
               rdfs:label "answered in";
               rdfs:range sur:SurveyCompletionTask.
sur:completedFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain sur:SurveyCompletionTask;
                 rdfs:label "completed for";
                 rdfs:range sur:SurveyTarget.
sur:completesQuestion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain sur:CompletedQuestion;
                      rdfs:label "completes question";
                      rdfs:range sur:Question.
sur:hasAnswer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain sur:CompletedQuestion;
              rdfs:label "has answer";
              rdfs:range sur:Answer.
sur:hasAnswerText a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain sur:CompletedQuestion;
                  rdfs:label "has answer text";
                  rdfs:range xsd:string.
sur:hasCompletionTimestamp a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain sur:CompletedQuestion;
                           rdfs:label "has completion timestamp";
                           rdfs:range xsd:dateTime.
sur:hasLatentVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain sur:Question;
                      rdfs:label "has latent variable";
                      rdfs:range sur:LatentVariable.
sur:hasLink a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain sur:Talk;
            rdfs:label "has link";
            rdfs:range xsd:anyURI.
sur:hasObservableVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain sur:Question;
                          rdfs:label "has observable variable";
                          rdfs:range sur:ObservableVariable.
sur:hasOrderNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain sur:ClosedAnswer;
                   rdfs:label "has order number";
                   rdfs:range xsd:integer.
sur:hasPoints a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain sur:ClosedAnswer;
              rdfs:label "has points";
              rdfs:range xsd:float.
sur:hasStatus a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain sur:SurveyProcedure;
              rdfs:label "has status";
              rdfs:range xsd:string.
sur:hasText a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain sur:SurveyElement;
            rdfs:label "has text";
            rdfs:range xsd:string.
sur:hasTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain sur:SurveyProcedure;
             rdfs:label "has title";
             rdfs:range xsd:string.
sur:hasValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain sur:ClosedAnswer;
             rdfs:label "has value";
             rdfs:range xsd:float.
sur:hasVisualization a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain sur:MultipleChoiceQuestion;
                     rdfs:label "has visualization";
                     rdfs:range sur:QuestionVisualization.
sur:inSurveyProcedure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain sur:SurveyElement;
                      rdfs:label "in survey procedure";
                      rdfs:range sur:SurveyProcedure.
sur:leadsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain sur:SurveyElement;
            rdfs:label "leads to";
            rdfs:range sur:SurveyElement.
sur:participantId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain sur:Participant;
                  rdfs:label "participant id";
                  rdfs:range xsd:string.
sur:sessionId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain sur:SurveyCompletionTask;
              rdfs:label "session id";
              rdfs:range xsd:string.
sur:startsWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain sur:SurveyProcedure;
               rdfs:label "starts with";
               rdfs:range sur:SurveyElement.
