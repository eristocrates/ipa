ontouml:AggregationKind a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "This class is an enumeration of its individuals, which are: ontouml:composite, ontouml:none, and ontouml:shared."@en,
                                     "Groups all possible aggregation kinds to which an ontouml:Property can be related."@en;
                        rdfs:isDefinedBy <https://w3id.org/ontouml>;
                        rdfs:label "AggregationKind"@en;
                        <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (ontouml:composite
                                                                                                                ontouml:none
                                                                                                                ontouml:shared) ; 
                                                                         a <http://www.w3.org/2002/07/owl#Class>].
ontouml:Cardinality a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Represents the cardinality of an ontouml:Property through its data property ontouml:cardinalityValue."@en;
                    rdfs:isDefinedBy <https://w3id.org/ontouml>;
                    rdfs:label "Cardinality"@en.
ontouml:Class a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An ontouml:Class have exactly one ontouml:Stereotype (i.e., it is a mandatory property) of specific type ontouml:ClassStereotype. This information is formalized by the ontouml:stereotype property."@en,
                           "Represents a type defined in the ontology."@en;
              rdfs:isDefinedBy <https://w3id.org/ontouml>;
              rdfs:label "Class"@en;
              rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Class> ; 
                               <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#allValuesFrom> ontouml:ClassStereotype ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> ontouml:stereotype ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                               [<http://www.w3.org/2002/07/owl#onClass> ontouml:ClassStereotype ; 
                                                                               <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> ontouml:stereotype ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>])],
                              ontouml:Classifier.
ontouml:ClassStereotype a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "This class is an enumeration of its individuals, which are: ontouml:abstract, ontouml:category, ontouml:collective, ontouml:datatype, ontouml:enumeration, ontouml:event, ontouml:historicalRole, ontouml:historicalRoleMixin, ontouml:kind, ontouml:mixin, ontouml:mode, ontouml:phase, ontouml:phaseMixin, ontouml:quality, ontouml:quantity, ontouml:relator, ontouml:role, ontouml:roleMixin, ontouml:situation, ontouml:subkind, and ontouml:type."@en,
                                     "Aggregates all possible instances that can be assigned via an ontouml:stereotype property to an ontouml:Class."@en;
                        rdfs:isDefinedBy <https://w3id.org/ontouml>;
                        rdfs:label "ClassStereotype"@en;
                        rdfs:subClassOf ontouml:Stereotype;
                        <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (ontouml:abstract
                                                                                                                ontouml:category
                                                                                                                ontouml:collective
                                                                                                                ontouml:datatype
