@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdom: <https://w3id.org/okn/o/sdm#>.

<http://purl.org/dc/elements/1.1/abstract> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://qudt.org/schema/qudt/Unit> a <http://www.w3.org/2002/07/owl#Class>.
<http://schema.org/GeoCoordinates> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:isDefinedBy <http://schema.org/>.
<http://schema.org/GeoShape> a <http://www.w3.org/2002/07/owl#Class>.
<http://schema.org/Place> a <http://www.w3.org/2002/07/owl#Class>.
<http://schema.org/box> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:isDefinedBy <http://schema.org/>.
<http://schema.org/contentLocation> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://schema.org/elevation> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:isDefinedBy <http://schema.org/>.
<http://schema.org/geo> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://schema.org/latitude> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:isDefinedBy <http://schema.org/>.
<http://schema.org/longitude> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:isDefinedBy <http://schema.org/>.
<https://w3id.org/okn/o/sd#ConfigurationSetup> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#DatasetSpecification> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#Image> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#Parameter> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#Software> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#SoftwareConfiguration> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#VariablePresentation> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/okn/o/sd#usesUnit> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/okn/o/sd#value> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<https://w3id.org/okn/o/sdm> <http://purl.org/dc/elements/1.1/abstract> "The Software Description Ontology for Models (SDM) expands the software description ontology (SD) to add information about scientific software models. Examples of scientific software models are hydrology models, agriculture models or economy models."@en;
                             <http://purl.org/dc/elements/1.1/contributor> "Scott Peckham"@en,
                                                                           "Hernán Vargas"@en,
                                                                           "Kelly Cobourn"@en,
                                                                           "Armen Kemanian"@en,
                                                                           "Christopher Duffy"@en;
                             <http://purl.org/dc/elements/1.1/creator> "Yolanda Gil"@en,
                                                                       "Daniel Garijo"@en,
                                                                       "Deborah Khider"@en;
                             <http://purl.org/dc/elements/1.1/license> "<http://creativecommons.org/licenses/by/2.0/>"@en;
                             <http://purl.org/dc/elements/1.1/title> "The Software Description Ontology for Models"@en;
                             <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/2.0/>;
                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "sdm";
                             <http://purl.org/vocab/vann/preferredNamespaceUri> sdom:;
                             a <http://www.w3.org/2002/07/owl#Ontology>;
                             <http://www.w3.org/2002/07/owl#imports> <https://w3id.org/okn/o/sd/1.8.0>;
                             <http://www.w3.org/2002/07/owl#priorVersion> <https://w3id.org/okn/o/sdm/1.7.0>;
                             <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/okn/o/sdm/1.7.0>;
                             <http://www.w3.org/2002/07/owl#versionInfo> "1.7.0"@en.
sdom:Category a <http://www.w3.org/2002/07/owl#Class>.
sdom:CausalDiagram a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Diagram information with the processes and variables associated with a model configuration"@en;
                   rdfs:label "Causal Diagram"@en.
sdom:Constraint a <http://www.w3.org/2002/07/owl#Class>.
sdom:CoupledModel a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Model that incorporates the coupling of two or more existing models"@en;
                  rdfs:label "Coupled model"@en;
                  rdfs:subClassOf sdom:Model.
sdom:EmpiricalModel a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Model based on observations."@en;
                    rdfs:label "Empirical model"@en;
                    rdfs:subClassOf sdom:Model.
sdom:Emulator a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Type of models that emulates the behavior of another model. For example, an emulator can be a machine learning model trained on the output runs of a hydrology model"@en;
              rdfs:label "Emulator"@en;
              rdfs:subClassOf sdom:Model.
sdom:Equation a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Information about the mathematical representation used in a model or model configuration"@en;
              rdfs:label "Equation"@en.
sdom:GeoCoordinates a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Coordinate metadata of a region"@en;
                    rdfs:label "GeoCoordinates"@en;
                    rdfs:subClassOf <http://schema.org/GeoCoordinates>.
sdom:GeoShape a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Shape or polygon of a region in a map"@en;
              rdfs:label "GeoShape"@en;
              rdfs:subClassOf <http://schema.org/GeoShape>.
sdom:Grid a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Class that represents the geospatial information associated with a model";
          rdfs:label "Grid"@en;
          rdfs:subClassOf <https://w3id.org/okn/o/sd#DatasetSpecification>.
sdom:HybridModel a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A model based on empirical observations and theory."@en;
                 rdfs:label "Hybrid model"@en;
                 rdfs:subClassOf sdom:Model.
sdom:Intervention a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Interference by a policy maker or modeler by modifying a variable or parameter of a model"@en;
                  rdfs:label "Intervention"@en.
sdom:Model a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A mathematical description of a process (e.g., hydrological, agricultural, social, etc.)"@en;
           rdfs:label "Model"@en;
           rdfs:subClassOf <https://w3id.org/okn/o/sd#Software>.
sdom:ModelCategory a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Class used to represent a category of a model (e.g., Hydrology, Agriculture, etc.)"@en;
                   rdfs:label "Model category"@en.
sdom:ModelConfiguration a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A model configuration is a way of exposing a particular functionality of a model."@en;
                        rdfs:label "Model configuration"@en;
                        rdfs:subClassOf <https://w3id.org/okn/o/sd#SoftwareConfiguration>,
                                        sdom:Model.
sdom:ModelConfigurationSetup a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Setup of a particular model, that may represent a calibration or a configuration with a set of values for a specific region."@en;
                             rdfs:label "Model configuration setup"@en;
                             rdfs:subClassOf <https://w3id.org/okn/o/sd#ConfigurationSetup>,
                                             sdom:ModelConfiguration.
sdom:PointBasedGrid a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A grid that is based on a series if points (or a single point). Typically associated with point-based models"@en;
                    rdfs:label "Point Based Grid"@en;
                    rdfs:subClassOf sdom:Grid.
sdom:Process a <http://www.w3.org/2002/07/owl#Class>.
sdom:Region a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An area or division with some characteristics but not always fixed boundaries"@en;
            rdfs:label "Region"@en;
            rdfs:subClassOf <http://schema.org/Place>.
sdom:SpatialResolution a <http://www.w3.org/2002/07/owl#Class>.
sdom:SpatiallyDistributedGrid a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Grid that represents a 2D or 3D space"@en;
                              rdfs:label "Spatially Distributed Grid"@en;
                              rdfs:subClassOf sdom:Grid.
sdom:Theory-GuidedModel a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A model guided by mathematical equations that attempt to represent one or more natural processes."@en;
                        rdfs:label "Theory guided model"@en;
                        rdfs:subClassOf sdom:Model.
sdom:TimeInterval a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Time interval at which a model produces output. For example, a model may produce outputs for every simulated day, hour, etc."@en;
                  rdfs:label "Time Interval"@en.
sdom:box a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain sdom:GeoShape;
         rdfs:range xsd:string;
         rdfs:subPropertyOf <http://schema.org/box>.
sdom:calibratedVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Variable that was calibrated in this particular model configuration calibration"@en;
                        rdfs:domain sdom:ModelConfigurationSetup;
                        rdfs:label "calibrated variable"@en;
                        rdfs:range <https://w3id.org/okn/o/sd#VariablePresentation>.
sdom:calibrationInterval a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Property that represents the temporal interval used to calibrate a model"@en;
                         rdfs:domain sdom:ModelConfigurationSetup;
                         rdfs:label "calibration interval"@en;
                         rdfs:range xsd:string.
sdom:calibrationMethod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Calibration method used for a particular model configuration or setup"@en;
                       rdfs:domain sdom:ModelConfigurationSetup;
                       rdfs:label "calibration method"@en;
                       rdfs:range xsd:string.
sdom:calibrationTargetVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Variable for which the model was calibrated for. For example, in a hydrology model one calibrate the predicted river width by varying hydrologic conductivity"@en;
                               rdfs:domain sdom:ModelConfigurationSetup;
                               rdfs:label "calibration target variable"@en;
                               rdfs:range <https://w3id.org/okn/o/sd#VariablePresentation>.
sdom:elevation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Elevation of a location (WGS84)"@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (sdom:GeoCoordinates
                                                                     sdom:GeoShape) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "elevation"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf <http://schema.org/elevation>.
sdom:geo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:comment "Specific coordinates or shape associated with a region"@en;
         rdfs:domain sdom:Region;
         rdfs:label "geo"@en;
         rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (sdom:GeoCoordinates
                                                              sdom:GeoShape) ; 
                     a <http://www.w3.org/2002/07/owl#Class>];
         rdfs:subPropertyOf <http://schema.org/geo>.
sdom:hasCausalDiagram a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Diagram associated to a model configuration"@en;
                      rdfs:domain sdom:ModelConfiguration;
                      rdfs:label "has causal diagram"@en;
                      rdfs:range sdom:CausalDiagram.
sdom:hasConstraint a <http://www.w3.org/2002/07/owl#ObjectProperty>.
sdom:hasCoordinateSystem a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                           <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                         rdfs:comment "Coordinate system used in a grid"@en;
                         rdfs:domain sdom:Grid;
                         rdfs:label "has coordinate system"@en;
                         rdfs:range xsd:string.
sdom:hasDiagramPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Property that links a causal diagram with its constituent nodes";
                    rdfs:domain sdom:CausalDiagram;
                    rdfs:label "has diagram part"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/okn/o/sd#VariablePresentation>
                                                                         sdom:Process) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
sdom:hasDimension a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "Dimension of the grid (2D, 3D)"@en;
                  rdfs:domain sdom:Grid;
                  rdfs:label "has dimension"@en;
                  rdfs:range xsd:string.
sdom:hasEquation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Equations used in the model"@en;
                 rdfs:domain sdom:Model;
                 rdfs:label "has equation"@en;
                 rdfs:range sdom:Equation.
sdom:hasExplanationDiagram a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Diagram used to explain the behavior of the model"@en;
                           rdfs:domain sdom:Model;
                           rdfs:label "has explanation diagram"@en;
                           rdfs:range <https://w3id.org/okn/o/sd#Image>.
sdom:hasGrid a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Grid information about the model"@en;
             rdfs:domain sdom:Model;
             rdfs:label "has grid"@en;
             rdfs:range sdom:Grid.
sdom:hasInputVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Variable that is used as input for this model"@en;
                      rdfs:domain sdom:Model;
                      rdfs:label "has input variable"@en;
                      rdfs:range <https://w3id.org/okn/o/sd#VariablePresentation>.
sdom:hasMaximumValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
sdom:hasMinimumValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
sdom:hasModelCategory a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Category associated with a model (e.g., Hydrology, etc.)"@en;
                      rdfs:domain sdom:Model;
                      rdfs:label "has model category"@en;
                      rdfs:range sdom:ModelCategory.
sdom:hasModelResultTable a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Sample result table associated with a model configuration"@en;
                         rdfs:domain sdom:ModelConfiguration;
                         rdfs:label "has model result table"@en;
                         rdfs:range xsd:string.
sdom:hasOutputTimeInterval a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Time interval used in the model configuration"@en;
                           rdfs:domain sdom:ModelConfiguration;
                           rdfs:label "has output time interval"@en;
                           rdfs:range sdom:TimeInterval.
sdom:hasOutputVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Variable that is used as output for this model"@en;
                       rdfs:domain sdom:Model;
                       rdfs:label "has output variable"@en;
                       rdfs:range <https://w3id.org/okn/o/sd#VariablePresentation>.
sdom:hasProcess a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Property that indicates which physical processes (if any) are associated with a model"@en;
                rdfs:domain sdom:Model;
                rdfs:label "has process"@en;
                rdfs:range sdom:Process.
sdom:hasRegion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Property linking a region to a model configuration/calibration. This property implies that the described model configuration is prepared to execute in that target region"@en;
               rdfs:domain sdom:ModelConfiguration;
               rdfs:range sdom:Region;
               rdfs:subPropertyOf <http://schema.org/contentLocation>.
sdom:hasShape a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Grids may be: rectangular, triangular, hexagonal, hybrid, unstructured, block structure, etc."@en;
              rdfs:domain sdom:Grid;
              rdfs:label "has shape"@en;
              rdfs:range xsd:string.
sdom:hasSpatialResolution a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Spatial resolution of a grid (e.g., 50m)"@en;
                          rdfs:domain sdom:Grid;
                          rdfs:label "has spatial resolution"@en;
                          rdfs:range xsd:string.
sdom:hasVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>.
sdom:influences a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Property that captures if a physical process influences another process"@en;
                rdfs:domain sdom:Process;
                rdfs:label "influences"@en;
                rdfs:range sdom:Process.
sdom:intervalUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Unit used in an interval (e.g., month)"@en;
                  rdfs:domain sdom:TimeInterval;
                  rdfs:label "interval unit"@en;
                  rdfs:range <http://qudt.org/schema/qudt/Unit>;
                  rdfs:subPropertyOf <https://w3id.org/okn/o/sd#usesUnit>.
sdom:intervalValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Value used in the time interval of a model (e.g., 1 month, 5 days, 'harvest cycle')"@en;
                   rdfs:domain sdom:TimeInterval;
                   rdfs:label "interval value"@en;
                   rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (xsd:integer
                                                                        xsd:string) ; 
                               a rdfs:Datatype];
                   rdfs:subPropertyOf <https://w3id.org/okn/o/sd#value>.
sdom:latitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Latitude (coordinates) of a location (WGS84)"@en;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (sdom:GeoCoordinates
                                                                    sdom:GeoShape) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "latitude"@en;
              rdfs:range xsd:string;
              rdfs:subPropertyOf <http://schema.org/latitude>.
sdom:limitations a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Known restrictions (i.e. cases where the model is known not to be reliable or shouldn't be used)"@en;
                 rdfs:domain sdom:Model;
                 rdfs:label "limitations"@en;
                 rdfs:range xsd:string.
sdom:longitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Longitude (coordinates) of a location (WGS84)"@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (sdom:GeoCoordinates
                                                                     sdom:GeoShape) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "longitude"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf <http://schema.org/longitude>.
sdom:parameterAssignmentMethod a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:comment "Property that indicates how have the parameters assigned in a model configuration (e.g., using an expert guess, by using calibration, etc.)"@en;
                               rdfs:domain sdom:ModelConfigurationSetup;
                               rdfs:label "parameter assignment method"@en;
                               rdfs:range xsd:string.
sdom:parameterization a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Were there any simplifications made to processes to make the model more efficient"@en;
                      rdfs:domain sdom:Model;
                      rdfs:label "parameterization"@en;
                      rdfs:range xsd:string.
sdom:parentCategory a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Indicates the parent category of a given category"@en;
                    rdfs:domain sdom:ModelCategory;
                    rdfs:label "parent category"@en;
                    rdfs:range sdom:ModelCategory.
sdom:partOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Indicates whether a region is part of another region"@en;
            rdfs:domain sdom:Region;
            rdfs:label "part of"@en;
            rdfs:range sdom:Region.
sdom:relevantForIntervention a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Property that links a parameter to the intervention it is relevant for."@en;
                             rdfs:domain <https://w3id.org/okn/o/sd#Parameter>;
                             rdfs:label "relevant for intervention"@en;
                             rdfs:range sdom:Intervention.
sdom:runtimeEstimation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "An estimate of the time required to run example codes or other known configurations"@en;
                       rdfs:domain sdom:Model;
                       rdfs:label "runtime estimation"@en;
                       rdfs:range xsd:string.
sdom:theoreticalBasis a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "What is the theory behind the processes described in the model"@en;
                      rdfs:domain sdom:Model;
                      rdfs:label "theoretical basis"@en;
                      rdfs:range xsd:string.
sdom:usesModel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Property that describes which models are used by a coupled model"@en;
               rdfs:domain sdom:Model;
               rdfs:label "uses model"@en;
               rdfs:range sdom:Model.
sdom:validUntil a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Date until which the calibration of a model is valid. For example, a trained model with data from 2005-2010 may only be valid for predictions until 2015."@en;
                rdfs:domain sdom:ModelConfigurationSetup;
                rdfs:label "valid until"@en;
                rdfs:range xsd:dateTime.
