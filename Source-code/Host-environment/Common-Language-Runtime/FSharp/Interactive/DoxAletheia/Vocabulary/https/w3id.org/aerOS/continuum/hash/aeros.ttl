aeros:operatingSystem a owl:ObjectProperty;
                      rdfs:domain aeros:InfrastructureElement;
                      rdfs:label "operating system";
                      rdfs:range aeros:OperatingSystem.
aeros:orchestrationType a owl:ObjectProperty;
                        rdfs:domain aeros:LowLevelOrchestrator;
                        rdfs:label "orchestration type";
                        rdfs:range aeros:OrchestrationType.
aeros:owner a owl:ObjectProperty;
            rdfs:domain aeros:Domain;
            rdfs:label "owner";
            rdfs:range org:Organization.
aeros:portNumber a owl:DatatypeProperty;
                 rdfs:domain aeros:NetworkPort;
                 rdfs:label "port number";
