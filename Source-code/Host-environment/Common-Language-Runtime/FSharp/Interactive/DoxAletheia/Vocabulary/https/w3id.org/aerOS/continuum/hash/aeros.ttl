           rdfs:range xsd:anyURI.
xsd:Area a owl:Class.
xsd:Location a owl:Class.
xsd:date a rdfs:Datatype.
owl:versionInfo a owl:AnnotationProperty.
org:Membership a owl:Class;
               rdfs:isDefinedBy org:;
               rdfs:label "Membership".
org:Organization a owl:Class;
                 rdfs:comment "Group of people that work together towards a business goal. In the scope of aerOS, an organization is accountable for the management of an aerOS domain as part of a continuum.";
                 rdfs:isDefinedBy org:;
                 rdfs:label "Organization".
org:Role a owl:Class;
         rdfs:comment "Function or set of functions that a person can perform within an organization. In the scope of aerOS, the functions will be mapped to the capabilities exposed by the aerOS continuum.";
         rdfs:isDefinedBy org:;
         rdfs:label "Role".
org:member a owl:ObjectProperty;
           rdfs:domain org:Membership;
           rdfs:isDefinedBy org:;
           rdfs:label "member";
           rdfs:range foaf:Person.
org:organization a owl:ObjectProperty;
                 rdfs:domain org:Membership;
                 rdfs:isDefinedBy org:;
                 rdfs:label "organization";
                 rdfs:range org:Organization.
org:role a owl:ObjectProperty;
         rdfs:domain org:Membership;
         rdfs:isDefinedBy org:;
         rdfs:label "role";
         rdfs:range org:Role.
foaf:Person a owl:Class;
            rdfs:isDefinedBy foaf:;
            rdfs:label "Person".
foaf:firstName a owl:DatatypeProperty;
               rdfs:domain foaf:Person;
               rdfs:isDefinedBy foaf:;
               rdfs:label "first name";
               rdfs:range xsd:string.
foaf:lastName a owl:DatatypeProperty;
              rdfs:domain foaf:Person;
              rdfs:isDefinedBy foaf:;
              rdfs:label "last name";
              rdfs:range xsd:string.
aeros: dcterms:contributor "Andreu Belsa Pellicer",
                           "Rafael Vaño Garcia";
       dcterms:created "2024-02-14"^^xsd:date;
       dcterms:creator "Ignacio Dominguez Martinez-Casanueva";
       dcterms:description """
                                    Ontology for the orchestration of the aerOS continuum.
                                    """;
       dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0>;
       dcterms:modified "2024-08-23"^^xsd:date;
       dcterms:source <https://gitlab.aeros-project.eu/wp4/t4.1/aeros-continuum>;
       dcterms:title "aerOS Continuum Ontology";
       vann:preferredNamespacePrefix "aeros";
       vann:preferredNamespaceUri aeros:;
       a owl:Ontology,
         owl:NamedIndividual;
       rdfs:label "aerOS Continuum Ontology"@en;
       owl:versionIRI <https://w3id.org/aerOS/continuum>;
       owl:versionInfo "1.1.0";
       modp:createdWith <https://chowlk.linkeddata.es/>.
aeros:CloudTier a owl:NamedIndividual,
                  aeros:InfrastructureElementTier.
aeros:ContainerdOrchestration a owl:NamedIndividual,
                                aeros:OrchestrationType.
aeros:CpuArchitecture a owl:Class;
                      rdfs:label "Cpu Architecture".
aeros:DockerOrchestration a owl:NamedIndividual,
                            aeros:OrchestrationType.
aeros:Domain a owl:Class;
             rdfs:comment "A set of one or more IEs, functionally connected and sharing a common instance of aerOS basic services among them, constituting an administrative domain able to be managed and orchestrated by aerOS Meta-OS and thus be part of the IoT-Edge-Cloud continuum.";
             rdfs:label "Domain".
aeros:DomainStatus a owl:Class;
                   rdfs:comment "Represents the status of a domain. Possible types are Preliminar, Functional, Removed.Represents the status of a domain. Possible types are Preliminar, Functional, Removed.";
                   rdfs:label "Domain Status".
aeros:EdgeTier a owl:NamedIndividual,
                 aeros:InfrastructureElementTier.
aeros:FailedServiceComponent a owl:NamedIndividual,
                               aeros:ServiceComponentStatus.
aeros:FarEdgeTier a owl:NamedIndividual,
                    aeros:InfrastructureElementTier.
aeros:FinishedServiceComponent a owl:NamedIndividual,
                                 aeros:ServiceComponentStatus.
aeros:FunctionalDomain a owl:NamedIndividual,
                         aeros:DomainStatus.
aeros:InfrastructureElement a owl:Class;
                            rdfs:comment """\"The fundamental building block within aerOS Meta-OS. A physical or virtual computing resource providing the necessary processing power, storage capacity, and network connectivity to support containerised workloads and services.

Exposes aerOS runtime on top of provided capabilities being thus the minimum execution unit within the IoT-Edge-Cloud continuum.\"""";
                            rdfs:label "Infrastructure Element".
aeros:InfrastructureElementRequirements a owl:Class;
                                        rdfs:comment "Represents the IE requirements for running a service component.";
                                        rdfs:label "Infrastructure Element Requirements".
aeros:InfrastructureElementStatus a owl:Class;
                                  rdfs:comment "Represents the status of an IE. Possible types are READY, OVERLOAD, UNSECURE, UNTRUSTED.";
                                  rdfs:label "Infrastructure Element Status".
aeros:InfrastructureElementTier a owl:Class;
                                rdfs:comment "Represents the computing continuum tier (cloud, edge, ...) of an IE.";
                                rdfs:label "Infrastructure Element Tier".
aeros:IotTier a owl:NamedIndividual,
                aeros:InfrastructureElementTier.
aeros:KubernetesOrchestration a owl:NamedIndividual,
                                aeros:OrchestrationType.
aeros:Linux a owl:NamedIndividual,
              aeros:OperatingSystem.
aeros:LocatingServiceComponent a owl:NamedIndividual,
                                 aeros:ServiceComponentStatus.
aeros:LowLevelOrchestrator a owl:Class;
                           rdfs:comment "This element interprets the Decision Blueprint coming from the HLO and oversees the actual deployment of workloads in the selected IE(s). Being aware of the underlying container management frameworks, is able to convert the allocation order into proper deployment. Several LLOs may live in the same domain.";
                           rdfs:label "Low Level Orchestrator".
aeros:MigratingServiceComponent a owl:NamedIndividual,
                                  aeros:ServiceComponentStatus.
aeros:NetworkPort a owl:Class;
                  rdfs:label "Network Port".
aeros:OpenstackOrchestration a owl:NamedIndividual,
                               aeros:OrchestrationType.
aeros:OperatingSystem a owl:Class;
                      rdfs:label "Operating System".
aeros:OrchestrationType a owl:Class;
                        rdfs:comment "Container orchestration technology.";
                        rdfs:label "Orchestration Type".
aeros:OverloadInfrastructureElement a owl:NamedIndividual,
                                      aeros:InfrastructureElementStatus.
aeros:OverloadServiceComponent a owl:NamedIndividual,
                                 aeros:ServiceComponentStatus.
aeros:PreliminarDomain a owl:NamedIndividual,
                         aeros:DomainStatus.
aeros:ReadyInfrastructureElement a owl:NamedIndividual,
                                   aeros:InfrastructureElementStatus.
aeros:RemovedDomain a owl:NamedIndividual,
                      aeros:DomainStatus.
aeros:RemovingServiceComponent a owl:NamedIndividual,
                                 aeros:ServiceComponentStatus.
aeros:RunningServiceComponent a owl:NamedIndividual,
                                aeros:ServiceComponentStatus.
aeros:Service a owl:Class;
              rdfs:comment "Represents a single instance of an IoT service with a unique identifier. A service is composed by one or some ServiceComponents.";
              rdfs:label "Service".
aeros:ServiceComponent a owl:Class;
                       rdfs:comment "Individual, deployable units that together constitute a Service in the aerOS ecosystem, each with a specific role or function.";
                       rdfs:label "Service Component".
aeros:ServiceComponentStatus a owl:Class;
                             rdfs:label "Service Component Status".
aeros:ServiceType a owl:Class;
                  rdfs:comment """Identifies the services such as a \"catalogue\".""";
                  rdfs:label "Service Type".
aeros:StartingServiceComponent a owl:NamedIndividual,
                                 aeros:ServiceComponentStatus.
aeros:UnsecureInfrastructureElement a owl:NamedIndividual,
                                      aeros:InfrastructureElementStatus.
aeros:UntrustedInfrastructureElement a owl:NamedIndividual,
                                       aeros:InfrastructureElementStatus.
aeros:User a owl:Class;
           rdfs:comment "Person with access to the capabilities of the continuum.";
           rdfs:label "User";
           rdfs:subClassOf foaf:Person.
aeros:Windows a owl:NamedIndividual,
                aeros:OperatingSystem.
aeros:arm32Architecture a owl:NamedIndividual,
                          aeros:CpuArchitecture.
aeros:arm64Architecture a owl:NamedIndividual,
                          aeros:CpuArchitecture.
