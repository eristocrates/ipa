                                        rdfs:domain aeros:ServiceComponent;
                                        rdfs:label "infrastructure element requirements";
                                        rdfs:range aeros:InfrastructureElementRequirements.
aeros:infrastructureElementStatus a owl:ObjectProperty;
                                  rdfs:domain aeros:InfrastructureElement;
                                  rdfs:label "infrastructure element status";
                                  rdfs:range aeros:InfrastructureElementStatus.
aeros:infrastructureElementTier a owl:ObjectProperty;
                                rdfs:domain aeros:InfrastructureElement;
                                rdfs:label "infrastructure element tier";
                                rdfs:range aeros:InfrastructureElementTier.
aeros:internalIpAddress a owl:DatatypeProperty;
                        rdfs:domain aeros:InfrastructureElement;
                        rdfs:label "internal ip address";
                        rdfs:range xsd:string.
aeros:isEntrypoint a owl:DatatypeProperty;
                   rdfs:domain aeros:Domain;
                   rdfs:label "is entrypoint";
                   rdfs:range xsd:boolean.
aeros:isPartOfService a owl:ObjectProperty;
                      rdfs:domain aeros:ServiceComponent;
                      rdfs:label "is part of service";
                      rdfs:range aeros:Service.
aeros:location a owl:ObjectProperty,
                 owl:DatatypeProperty;
               rdfs:domain aeros:InfrastructureElement;
               rdfs:label "location";
