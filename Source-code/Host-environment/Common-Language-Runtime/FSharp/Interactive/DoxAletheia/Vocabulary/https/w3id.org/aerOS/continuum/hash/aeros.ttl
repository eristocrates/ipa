aeros:requiredCpuUsage a owl:DatatypeProperty;
                       rdfs:domain aeros:InfrastructureElementRequirements;
                       rdfs:label "required cpu usage";
                       rdfs:range xsd:float.
aeros:requiredRam a owl:DatatypeProperty;
                  rdfs:domain aeros:InfrastructureElementRequirements;
                  rdfs:label "required ram";
