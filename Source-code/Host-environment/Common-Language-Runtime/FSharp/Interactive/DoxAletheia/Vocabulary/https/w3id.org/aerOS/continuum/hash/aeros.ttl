aeros:currentRamUsage a owl:DatatypeProperty;
                      rdfs:domain aeros:InfrastructureElement;
                      rdfs:label "current ram usage";
                      rdfs:range xsd:integer.
aeros:deployedOnServiceComponent a owl:ObjectProperty;
                                 rdfs:domain aeros:InfrastructureElement;
                                 rdfs:label "deployed on service component";
                                 rdfs:range aeros:ServiceComponent.
aeros:domain a owl:ObjectProperty;
             rdfs:domain aeros:InfrastructureElement;
             rdfs:label "domain";
             rdfs:range aeros:Domain.
aeros:domainStatus a owl:ObjectProperty;
                   rdfs:domain aeros:Domain;
                   rdfs:label "domain status";
                   rdfs:range aeros:DomainStatus.
aeros:envVars a owl:DatatypeProperty;
              rdfs:domain aeros:ServiceComponent;
              rdfs:label "env vars";
              rdfs:range xsd:string.
aeros:exposesNetworkPort a owl:ObjectProperty;
                         rdfs:domain aeros:ServiceComponent;
                         rdfs:label "exposes network port";
