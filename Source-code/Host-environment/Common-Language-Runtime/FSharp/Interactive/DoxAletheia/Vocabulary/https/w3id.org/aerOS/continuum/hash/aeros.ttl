                              rdfs:label "average power consumption";
                              rdfs:range xsd:float.
aeros:belongsTo a owl:ObjectProperty;
                rdfs:domain aeros:LowLevelOrchestrator;
                rdfs:label "belongs to";
                rdfs:range aeros:Domain.
aeros:cliArgs a owl:DatatypeProperty;
              rdfs:domain aeros:ServiceComponent;
              rdfs:label "cli args";
              rdfs:range xsd:string.
aeros:containerImage a owl:DatatypeProperty;
