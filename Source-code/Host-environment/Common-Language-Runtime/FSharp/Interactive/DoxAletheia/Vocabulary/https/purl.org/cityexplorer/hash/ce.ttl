ce:Andalusian a owl:NamedIndividual.
ce:AndalusianRestaurant a owl:Class;
                        rdfs:comment "Refers to restaurants serving food from Andalusia"@en;
                        rdfs:label "AndalusianRestaurant"@en;
                        rdfs:subClassOf ce:RestaurantCategory;
                        owl:equivalentClass [owl:intersectionOf (ce:Restaurant
                                                                 [owl:onProperty ce:hasCategory ; 
                                                                 owl:hasValue ce:Andalusian ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class];
                        status:term_status "testing"@en.
ce:Attraction a owl:Class;
              rdfs:comment "Refers to an attraction type, which can be cultural, park, etc."@en;
              rdfs:label "Attraction"@en;
              rdfs:sameAs "https://schema.org/Attraction"@en;
              rdfs:subClassOf [owl:someValuesFrom xsd:string ; 
                               owl:onProperty ce:identifier ; 
                               a owl:Restriction],
                              [owl:someValuesFrom xsd:decimal ; 
                               owl:onProperty ce:aggregateRating ; 
                               a owl:Restriction],
                              [owl:onProperty ce:hasCategory ; 
                               owl:onClass ce:AttractionTypes ; 
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:someValuesFrom ce:City ; 
                               owl:onProperty ce:locatedInCity ; 
                               a owl:Restriction],
                              [owl:someValuesFrom xsd:string ; 
                               owl:onProperty ce:name ; 
                               a owl:Restriction];
              status:term_status "testing"@en.
ce:AttractionCategory a owl:Class;
                      rdfs:comment "Includes different attraction categories"@en;
                      rdfs:label "AttractionCategory"@en;
                      rdfs:subClassOf ce:Category;
                      status:term_status "testing"@en.
ce:AttractionTypes a owl:Class;
                   rdfs:comment "Refers to the category of attractions"@en;
                   rdfs:label "AttractionType"@en;
                   rdfs:subClassOf ce:CategoryTypes;
                   owl:equivalentClass [owl:oneOf (ce:Beach
                                                   ce:Cultural
                                                   ce:Monument
                                                   ce:Museum
                                                   ce:Park) ; 
                                        a owl:Class];
                   status:term_status "testing"@en.
