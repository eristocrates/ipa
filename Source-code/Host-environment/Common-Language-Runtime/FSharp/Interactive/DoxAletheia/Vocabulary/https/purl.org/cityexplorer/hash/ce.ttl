_:B4b06d4a346ca6bc04cdfae31cf7e9842 a swrl:Imp;
                                    rdfs:comment "Rule for recommended restaurants aggregate rating greater than 4.0 and price range less or equal than 20."@en;
                                    rdfs:label "RecommendedRestaurants"@en;
                                    swrl:body ([swrl:classPredicate ce:Restaurant ; 
                                               swrl:argument1 <urn:swrl:var#r> ; 
                                               a swrl:ClassAtom]
                                               [swrl:propertyPredicate ce:aggregateRating ; 
                                               swrl:argument2 <urn:swrl:var#ar> ; 
                                               swrl:argument1 <urn:swrl:var#r> ; 
                                               a swrl:DatavaluedPropertyAtom]
                                               [swrl:propertyPredicate ce:priceRange ; 
                                               swrl:argument2 <urn:swrl:var#pr> ; 
                                               swrl:argument1 <urn:swrl:var#r> ; 
                                               a swrl:DatavaluedPropertyAtom]
                                               [swrl:builtin swrlb:greaterThan ; 
                                               swrl:arguments (<urn:swrl:var#ar>
                                                               4.0) ; 
                                               a swrl:BuiltinAtom]
                                               [swrl:builtin swrlb:lessThanOrEqual ; 
                                               swrl:arguments (<urn:swrl:var#pr>
                                                               20 ) ; 
                                               a swrl:BuiltinAtom]);
                                    swrl:head ([swrl:classPredicate ce:RecommendedRestaurants ; 
                                               swrl:argument1 <urn:swrl:var#r> ; 
                                               a swrl:ClassAtom]).
