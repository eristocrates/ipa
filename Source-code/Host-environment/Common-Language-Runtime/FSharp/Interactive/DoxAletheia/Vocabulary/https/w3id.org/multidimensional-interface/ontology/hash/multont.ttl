@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix multont: <https://w3id.org/multidimensional-interface/ontology#>.

<https://w3id.org/multidimensional-interface/ontology> <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Ruben Taelman" ; 
                                                                                           <http://xmlns.com/foaf/0.1/mbox> "Ruben.Taelman@UGent.be"];
                                                       <http://purl.org/dc/terms/issued> "2016-06-28"^^xsd:date;
                                                       <http://purl.org/dc/terms/modified> "2016-06-28"^^xsd:date;
                                                       <http://purl.org/dc/terms/title> "The vocabulary for describing Multidimensional Interfaces"@en;
                                                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "mid";
                                                       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/multidimensional-interface/ontology#";
                                                       a <http://www.w3.org/2002/07/owl#Ontology>;
                                                       rdfs:comment "An RDF vocabulary to describe and facilitate the usage of a Multidimensional Interface."@en;
                                                       rdfs:label "RDF vocabulary to describe a Multidimensional Interface."@en.
multont:RangeFragment a rdfs:Class;
                      rdfs:comment "A Linked Data Fragment that has an interval as selector, which apply to dimensional resources at one of its n dimensions."@en;
                      rdfs:isDefinedBy multont:;
                      rdfs:label "RangeFragment"@en;
                      rdfs:subClassOf <https://www.w3.org/ns/hydra/core#PagedCollection>.
multont:RangeGate a rdfs:Class;
                  rdfs:comment "A Linked Data interface through which Range Fragments can be selected by interval. This interface selects all Range Fragments whose interval overlap with the Range Gate’s interval."@en;
                  rdfs:isDefinedBy multont:;
                  rdfs:label "RangeGate"@en;
                  rdfs:subClassOf <https://www.w3.org/ns/hydra/core#PagedCollection>.
multont:final a rdf:Property;
              rdfs:comment "The upper bound of an interval, excluding this value."@en;
              rdfs:isDefinedBy multont:;
              rdfs:label "interval final"@en;
              rdfs:range xsd:numeric.
multont:hasRangeGate a rdf:Property;
                     rdfs:comment "A link to the Range Gate of a Multidimensional Index of a datasource."@en;
                     rdfs:domain <http://rdfs.org/ns/void#Dataset>;
                     rdfs:isDefinedBy multont:;
                     rdfs:label "has range gate"@en;
                     rdfs:range multont:RangeGate.
multont:initial a rdf:Property;
                rdfs:comment "The lower bound of an interval, including this value."@en;
                rdfs:isDefinedBy multont:;
                rdfs:label "interval initial"@en;
                rdfs:range xsd:numeric.
