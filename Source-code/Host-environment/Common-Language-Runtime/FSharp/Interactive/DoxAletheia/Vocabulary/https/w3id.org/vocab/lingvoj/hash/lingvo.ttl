lingvo:historicalLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "A language spoken in the past in this place, but not used anymore"@en,
                                       "Een taal die vroeger in dit gebied gesproken werd, maar wordt nu niet meer gebruikt"@nl,
                                       "Um idioma falado no passado num determinado lugar, não sendo já utilizado no presente"@pt,
                                       "Une langue parlée dans le passé dans ce lieu, mais plus utilisée aujourd'hui"@fr,
                                       "この場所で過去に話されていたが、もはや用いられていない言語"@ja,
                                       "Una lengua hablada en el pasado en este lugar, pero ya no se utiliza"@es;
                          rdfs:label "lengua histórica"@es,
                                     "historische taal"@nl,
                                     "langue historique"@fr,
                                     "historical language"@en,
                                     "歴史的言語"@ja,
                                     "idioma histórico"@pt;
                          rdfs:range lingvo:Lingvo;
                          <https://w3id.org/vocab/olca#domainIncludes> <http://schema.org/Place>.
lingvo:intermediateReading <http://purl.org/dc/terms/replaces> lingvo:hasAbility2;
