lingvo:livingLanguage a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "La langue possède des locuteurs à la date indiquée"@fr,
                                   "The language has speakers at the given date"@en,
                                   "ある時点でその言語を話す人がいる"@ja,
                                   "La lengua tiene hablantes en la fecha dada"@es,
                                   "De taal wordt door mensen gesproken op het aangegeven moment"@nl,
                                   "O idioma possui pessoas que o falam na data indicada"@pt;
                      rdfs:domain lingvo:Lingvo;
                      rdfs:label "langue vivante"@fr,
