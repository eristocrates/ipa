                    rdfs:range lingvo:Lingvo;
                    <https://w3id.org/vocab/olca#domainIncludes> lingvo:LanguageResource,
                                                                 <http://schema.org/Place>.
lingvo:minorityLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Une langue parlée par une minorité dans un pays, mais pas nécessairement dans une région spécifique"@fr,
                                     "O idioma falado por uma minoria num país, mas não necessariamente numa região específica"@pt,
                                     "Een taal die door een minderheid van de bevolking van een land gesproken wordt, maar niet noodzakelijkerwijs in een specifieke regio"@nl,
                                     "ある国の少数の人々（必ずしも特定地域ではない）が話す言語"@ja,
                                     "Un lengua hablada por una minoría en algún país, pero no necesariamente en una región específica"@es,
                                     "A language spoken by a minority in some country, but not necessarily in a specific region"@en;
                        rdfs:label "minderheidstaal"@nl,
                                   "lengua minoritaria"@es,
                                   "少数言語"@ja,
                                   "idioma minoritário"@pt,
                                   "langue minoritaire"@fr,
                                   "minority language"@en;
                        rdfs:range lingvo:Lingvo;
                        <https://w3id.org/vocab/olca#domainIncludes> <http://schema.org/Country>.
lingvo:nativeLanguage <http://purl.org/dc/terms/replaces> lingvo:hasNativeLanguage;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Esta propiedad es independiente de el nivel de fluidez o de las habilidades de lectura o escritura"@es,
                                   "このプロパティーは、流暢さ、読解力、記述能力のレベルに依存しない"@ja,
                                   "This property is independent of the level of fluency, reading or writing ability"@en,
                                   "Esta propriedade é independente do nível de fluência, de leitura ou de escrita"@pt,
                                   "Cette propriété est indépendante du niveau de langue parlée, lue ou écrite"@fr,
                                   "Deze eigenschap is onafhankelijk van het niveau van spreken, lezen of schrijven"@nl;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                      rdfs:label "langue maternelle"@fr,
