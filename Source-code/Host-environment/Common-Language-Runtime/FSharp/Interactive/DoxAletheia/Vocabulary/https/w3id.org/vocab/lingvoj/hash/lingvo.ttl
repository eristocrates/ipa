                                      "gemiddeld leesniveau"@nl,
                                      "lecture moyenne"@fr,
                                      "intermediate reading"@en;
                           rdfs:range lingvo:Lingvo.
lingvo:intermediateSpeaking <http://purl.org/dc/terms/replaces> lingvo:hasAbility2;
