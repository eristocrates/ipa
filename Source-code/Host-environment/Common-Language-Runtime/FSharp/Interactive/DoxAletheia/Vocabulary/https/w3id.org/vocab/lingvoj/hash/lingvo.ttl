                                       "La lengua está en vías de extinción en la fecha dada"@es,
                                       "The language is endangered at the given date"@en,
                                       "O idioma está em vias de extinção na data indicada"@pt;
                          rdfs:domain lingvo:Lingvo;
                          rdfs:label "langue menacée"@fr,
