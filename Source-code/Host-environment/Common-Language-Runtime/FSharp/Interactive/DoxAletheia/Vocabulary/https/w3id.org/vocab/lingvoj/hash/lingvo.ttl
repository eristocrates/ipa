                         rdfs:isDefinedBy <https://w3id.org/vocab/lingvoj_v1.3.rdf>;
                         <http://www.w3.org/2002/07/owl#deprecated> true.
lingvo:regionalLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Une langue parlée dans une région d'un pays"@fr,
                                     "Una lengua hablada en una región o un país"@es,
                                     "Een taal gesproken in bepaalde streek van een land"@nl,
                                     "Um idioma falado num região de um país"@pt,
                                     "A language spoken in a region of a country"@en,
                                     "ある国のある地域で話される言語"@ja;
                        rdfs:label "lengua regional"@es,
                                   "regional language"@en,
                                   "地方言語"@ja,
                                   "idioma regional"@pt,
                                   "streektaal"@nl,
                                   "langue régionale"@fr;
                        rdfs:range lingvo:Lingvo;
                        <https://w3id.org/vocab/olca#domainIncludes> <http://schema.org/Country>.
lingvo:resourceType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Um conceito que define o tipo de recuso linguístico"@pt,
                                 "Un concept définissant le type de la ressource linguistique"@fr,
                                 "A concept defining the type of the language resource"@en,
                                 "Een concept van het definiëren van de aard van de taal bron"@nl,
                                 "言語資源の種類を定義する概念"@ja,
                                 "Un concepto que define el tipo de recurso lingüístico"@es;
                    rdfs:domain lingvo:LanguageResource;
                    rdfs:label "bron type"@nl,
                               "type de ressource"@fr,
                               "tipo de recurso"@pt,
                               "tipo de recurso"@es,
                               "資源の種類"@ja,
                               "resource type"@en;
                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
lingvo:spokenLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Een taal gesproken op een bepaalde plek of tijdens een evenement"@nl,
                                   "A language which is spoken in some place or event"@en,
                                   "Una lengua que se habla en algún lugar o evento"@es,
                                   "Une langue parlée dans un lieu ou lors d'un événement"@fr,
                                   "O idioma que é falado num determinado lugar ou evento"@pt,
                                   "ある場所やイベントで話される言語"@ja;
                      rdfs:label "langue parlée"@fr,
                                 "gesproken taal"@nl,
                                 "spoken language"@en,
                                 "idioma falado"@pt,
                                 "話し言葉"@ja,
                                 "lengua hablada"@es;
                      rdfs:range lingvo:Lingvo;
                      <https://w3id.org/vocab/olca#domainIncludes> <http://linkedevents.org/ontology/Event>,
                                                                   <http://xmlns.com/foaf/0.1/Project>,
                                                                   <http://schema.org/Place>,
                                                                   <http://xmlns.com/foaf/0.1/Organization>.
lingvo:supportedLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Um idioma suportado pelo recurso linguístico"@pt,
                                      "Une langue supportée par la ressource linguistique"@fr,
                                      "言語資源でサポートされている言語"@ja,
                                      "Un idioma soportado por el recurso lingüístico"@es,
                                      "A language supported by the language resource"@en,
                                      "Een taal die wordt ondersteund door de taal bron"@nl;
                         rdfs:domain lingvo:LanguageResource;
                         rdfs:label "サポートされている言語 "@ja,
                                    "langue supportée"@fr,
                                    "ondersteunde taal"@nl,
                                    "idioma soportado"@es,
                                    "supported language"@en,
                                    "idioma suportado"@pt;
                         rdfs:range lingvo:Lingvo.
lingvo:supportingResource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Un recurso lingüístico para este idioma"@es,
                                       "Um recurso linguístico para este idioma"@pt,
                                       "A language resource for this language"@en,
                                       "Een taal bron voor deze taal"@nl,
                                       "この言語の言語資源"@ja,
                                       "Une ressource linguistique pour cette langue"@fr;
                          rdfs:domain lingvo:Lingvo;
                          rdfs:label "recurso suportado"@pt,
                                     "ressource support"@fr,
                                     "サポート資源"@ja,
                                     "support resource"@en,
                                     "recurso soportado"@es,
                                     "ondersteunende bron"@nl;
                          rdfs:range lingvo:LanguageResource;
                          <http://www.w3.org/2002/07/owl#inverseOf> lingvo:supportedLanguage.
lingvo:tag a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "A tag para ser usada, por exemplo como valor de xml:lang. Ver https://tools.ietf.org/html/bcp47"@pt,
                        "Le tag à utiliser pour la langue, par exemple comme valeur de xml:lang. Voir https://tools.ietf.org/html/bcp47"@fr,
                        "The tag to use for the language, for example as value of xml:lang. See https://tools.ietf.org/html/bcp47"@en,
                        "例えばxml:langの値として、言語に用いるタグ。https://tools.ietf.org/html/bcp47を参照"@ja,
                        "La etiqueta a utilizar para el lenguaje, por ejemplo como valor de xml:lang. Ver https://tools.ietf.org/html/bcp47"@es;
           rdfs:domain lingvo:Lingvo;
           rdfs:label "tag de idioma"@pt,
                      "etiqueta"@es,
                      "言語タグ"@ja,
                      "taal tag"@nl,
                      "tag de langue"@fr,
                      "language tag"@en;
           rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
lingvo:targetLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "La lengua de la fuente traducida"@es,
                                   "De taal waarin de bron vertaald is"@nl,
                                   "翻訳後の資源の言語"@ja,
                                   "The language of the translated ressource"@en,
                                   "La langue de la ressource traduite"@fr,
                                   "O idioma do recurso traduzido"@pt;
                      rdfs:domain lingvo:Translation;
                      rdfs:label "doeltaal"@nl,
                                 "langue cible"@fr,
                                 "target language"@en,
                                 "翻訳先の言語"@ja,
                                 "lengua destino"@es,
                                 "idioma destino"@pt;
                      rdfs:range lingvo:Lingvo.
lingvo:translatedResource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "La fuente que resulta de la traducción"@es,
                                       "La ressource qui est le résultat de la traduction"@fr,
                                       "O recurso que é o resultado da tradução"@pt,
                                       "翻訳の結果である資源"@ja,
                                       "Het resultaat van de vertaling"@nl,
                                       "The resource which is the result of the translation"@en;
                          rdfs:domain lingvo:Translation;
                          rdfs:label "recurso traduzido"@pt,
                                     "recurso traducido"@es,
                                     "vertaalde bron"@nl,
                                     "翻訳後の資源"@ja,
                                     "translated resource"@en,
                                     "ressource traduite"@fr.
lingvo:translatedTitle rdfs:comment "翻訳タイトルは、Translation（翻訳）自体のプロパティーではなく、翻訳された資源のプロパティー（dcterms:titleを使用）"@ja,
                                    "Le titre traduit est une propriété de la ressource traduite (utiliser dcterms:title) et non une propriété de la Traduction elle-même"@fr,
                                    "The translated title is a property of the translated resource (use dcterms:title) and not a property of the Translation itself"@en;
                       rdfs:isDefinedBy <https://w3id.org/vocab/lingvoj_v1.3.rdf>;
                       <http://www.w3.org/2002/07/owl#deprecated> true.
lingvo:translator a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "De agent (persoon, organisatie of applicatie) verantwoordelijk voor de vertaling"@nl,
                               "An agent (person, organization or sofware) responsible of the translation"@en,
                               "翻訳に責任を持つエージェント（人、組織またはソフトウェア）"@ja,
                               "Un agent (personne, organisation ou logiciel) responsable de la traduction"@fr,
                               "Un agente (persona, organización o software) responsable de la traducción"@es,
                               "um agente (pessoa, organização ou programa) responsável pela tradução"@pt;
                  rdfs:domain lingvo:Translation;
                  rdfs:label "translator"@en,
                             "翻訳者"@ja,
                             "traducteur"@fr,
                             "vertaler"@nl,
                             "tradutor"@pt,
                             "traductor"@es;
                  rdfs:range <http://xmlns.com/foaf/0.1/Agent>.
lingvo:workingLanguage <http://purl.org/dc/terms/replaces> lingvo:hasWorkingLanguage;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Una lengua que el proyecto o la organización utiliza para comunicación interna"@es,
                                    "A language the project or organization uses for internal communication"@en,
                                    "Une langue utilisée par l'organisation ou le projet pour sa communication interne"@fr,
                                    "O idioma que o projecto ou organização usa para a comunicação interna"@pt,
                                    "De taal gebruikt voor interne communicatie door een organisatie of binnen een project"@nl,
                                    "プロジェクトや組織が内部コミュニケーションに用いる言語"@ja;
                       rdfs:label "werktaal"@nl,
                                  "langue de travail"@fr,
                                  "実用言語"@ja,
                                  "idioma de trabalho"@pt,
                                  "working language"@en,
                                  "lenguaje de trabajo"@es;
                       rdfs:range lingvo:Lingvo;
                       <https://w3id.org/vocab/olca#domainIncludes> <http://xmlns.com/foaf/0.1/Organization>,
                                                                    <http://xmlns.com/foaf/0.1/Project>.
