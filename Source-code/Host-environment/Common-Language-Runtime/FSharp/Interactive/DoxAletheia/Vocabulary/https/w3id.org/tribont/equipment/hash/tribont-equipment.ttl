Domain expert:Xana Fernandez (Tekniker)"""@en;
                                     dcterms:created "2023-06-02";
                                     dcterms:creator "Patricia Casla (Tekniker)"@en;
                                     dcterms:description "The goal of this module is to represent the equipment hierarchy model involved in the tribological experiments."@en;
                                     dcterms:issued "2023-06-02";
                                     dcterms:publisher "Tekniker";
                                     dcterms:title "Equipment module";
                                     vann:preferredNamespacePrefix "equipment";
                                     vann:preferredNamespaceUri "https://w3id.org/tribont/equipment";
                                     a owl:Ontology;
                                     owl:imports <https://w3id.org/tribont/core>;
                                     owl:versionInfo 1.0.
tribont-equipment:AbrasionTester a owl:Class;
                                 rdfs:comment " An equipment that measures the abrasion resistance of something.";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                 rdfs:label "AbrasionTester";
                                 rdfs:subClassOf tribont-equipment:MeasuringEquipment;
                                 status:term_status "Testing".
tribont-equipment:Calibration a owl:Class;
                              rdfs:comment "The action or process of calibrating something to maintain accuracy, and repeatability in measurements, assuring reliable results.";
                              rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                              rdfs:label "Calibration";
                              rdfs:subClassOf [owl:onDataRange xsd:dateTime ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty tribont-equipment:validityDate ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:dateTime ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty tribont-equipment:executionDate ; 
                                               a owl:Restriction],
                                              [owl:allValuesFrom tribont-equipment:CalibrationDocument ; 
                                               owl:onProperty tribont-core:hasDocument ; 
                                               a owl:Restriction];
                              status:term_status "Testing".
tribont-equipment:CalibrationDocument a owl:Class;
                                      rdfs:comment "A document that contains all the relevant information related to a specific calibration.";
                                      rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                      rdfs:label "CalibrationDocument";
                                      rdfs:subClassOf tribont-core:Document;
                                      owl:disjointWith tribont-equipment:TechnicalDocument;
                                      status:term_status "Testing".
tribont-equipment:Equipment a owl:Class;
                            rdfs:comment "An object which is instrumental for reaching a particular purpose through its characteristic functioning process.";
                            rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                            rdfs:label "Equipment";
                            rdfs:subClassOf [owl:onClass tribont-core:Company ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty tribont-core:hasLocation ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-core:OperationProperty ; 
                                             owl:onProperty tribont-core:isCharacterisedByOperationCondition ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom tribont-equipment:TechnicalDocument ; 
                                             owl:onProperty tribont-core:hasDocument ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom xsd:string ; 
                                             owl:onProperty tribont-equipment:purpose ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom xsd:string ; 
                                             owl:onProperty tribont-core:shortNam ; 
                                             a owl:Restriction],
                                            [owl:onClass tribont-equipment:Calibration ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty tribont-equipment:hasCalibration ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom xsd:string ; 
                                             owl:onProperty tribont-core:longName ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom xsd:string ; 
                                             owl:onProperty tribont-equipment:measuringPrinciple ; 
                                             a owl:Restriction],
                                            icb:SubjectOfInterest,
                                            [owl:allValuesFrom tribont-core:Company ; 
                                             owl:onProperty tribont-core:hasLocation ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-equipment:Calibration ; 
                                             owl:onProperty tribont-equipment:hasCalibration ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-core:Body ; 
                                             owl:onProperty tribont-equipment:holdsSampleBody ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom tribont-core:TechnicalProperty ; 
                                             owl:onProperty tribont-core:isCharacterisedByOutputMeasure ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom [owl:unionOf (tribont-equipment:CalibrationDocument
                                                                             tribont-equipment:TechnicalDocument) ; 
                                                                a owl:Class] ; 
                                             owl:onProperty tribont-core:hasDocument ; 
                                             a owl:Restriction];
                            status:term_status "Testing".
tribont-equipment:EquipmentClass a owl:Class;
                                 rdfs:comment "An aggrupation of equipments with a set of common atributes of characteristics.";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                 rdfs:label "EquipmentClass";
                                 rdfs:subClassOf icb:SubjectOfInterest,
                                                 [owl:allValuesFrom tribont-core:Body ; 
                                                  owl:onProperty tribont-equipment:holdsSampleBody ; 
                                                  a owl:Restriction],
                                                 [owl:someValuesFrom tribont-equipment:TechnicalDocument ; 
                                                  owl:onProperty tribont-core:hasDocument ; 
                                                  a owl:Restriction],
                                                 [owl:someValuesFrom xsd:string ; 
                                                  owl:onProperty tribont-equipment:measuringPrinciple ; 
                                                  a owl:Restriction],
                                                 [owl:allValuesFrom tribont-equipment:TechnicalDocument ; 
                                                  owl:onProperty tribont-core:hasDocument ; 
                                                  a owl:Restriction],
                                                 [owl:someValuesFrom xsd:string ; 
                                                  owl:onProperty tribont-equipment:purpose ; 
                                                  a owl:Restriction];
                                 status:term_status "Testing".
tribont-equipment:EquipmentStandard a owl:Class;
                                    rdfs:comment "A document approved by a recognized body that provides common to by fullfiled by an equipment.";
                                    rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                    rdfs:label "EquipmentStandard";
                                    rdfs:subClassOf tribont-core:Standard;
                                    status:term_status "Testing".
tribont-equipment:ExperimentalEquipment a owl:Class;
                                        rdfs:comment "An equipment that reproduces certain operation conditions for experimentation purposes.";
                                        rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                        rdfs:label "ExperimentalEquipment";
                                        rdfs:subClassOf tribont-equipment:Equipment;
                                        status:term_status "Testing".
tribont-equipment:ExperimentalEquipmentClass a owl:Class;
                                             rdfs:comment "An aggrupation of experimental equipments with a set of common atributes of characteristics.";
                                             rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                             rdfs:label "ExperimentalEquipmentClass";
                                             rdfs:subClassOf tribont-equipment:EquipmentClass;
                                             status:term_status "Testing".
tribont-equipment:HardnessTester a owl:Class;
                                 rdfs:comment "An equipment that measures the hardness of a material, ";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                 rdfs:label "HardnessTester";
                                 rdfs:subClassOf [owl:allValuesFrom tribont-core:HardnessProperty ; 
                                                  owl:onProperty tribont-core:isCharacterisedByOutputMeasure ; 
                                                  a owl:Restriction],
                                                 tribont-equipment:MeasuringEquipment;
                                 status:term_status "Testing".
tribont-equipment:HardnessTesterClass a owl:Class;
                                      rdfs:comment "An aggrupation of hardness testers with a set of common atributes of characteristics.";
                                      rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                      rdfs:label "HardnessTesterClass";
                                      rdfs:subClassOf tribont-equipment:MeasuringEquipmentClass;
                                      status:term_status "Testing".
tribont-equipment:MachineryBook a owl:Class;
                                rdfs:comment "A document providing all the relevant information of the technical characteristics of an equipment, and describes how and when to use and mantain it. ";
                                rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                rdfs:label "MachineryBook";
                                rdfs:subClassOf tribont-equipment:TechnicalDocument;
                                owl:disjointWith tribont-equipment:ManufacturerDataSheet;
                                status:term_status "Testing".
tribont-equipment:ManufacturerDataSheet a owl:Class;
                                        rdfs:comment "A document provided by the manufacturer that includes a summary of technical characteristics, and describes how and when to use something.";
                                        rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                        rdfs:label "ManufacturerDataSheet";
                                        rdfs:subClassOf tribont-equipment:TechnicalDocument;
                                        status:term_status "Testing".
tribont-equipment:MeasuringEquipment a owl:Class;
                                     rdfs:comment "An equipment used to measure technical attributes or characteristics of something.";
                                     rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                     rdfs:label "MeasuringEquipment";
                                     rdfs:subClassOf tribont-equipment:Equipment;
                                     status:term_status "Testing".
tribont-equipment:MeasuringEquipmentClass a owl:Class;
                                          rdfs:comment "An aggrupation of measuring equipment with a set of common atributes of characteristics.";
                                          rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                          rdfs:label "MeasuringEquipmentClass";
                                          rdfs:subClassOf tribont-equipment:EquipmentClass;
                                          status:term_status "Testing".
tribont-equipment:OpticalMicroscope a owl:Class;
                                    rdfs:comment "An equipment used to assess surfaces by magnifying images with visible light.";
                                    rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                    rdfs:label "OpticalMicroscope";
                                    rdfs:subClassOf [owl:allValuesFrom tribont-equipment:OpticalMicroscope ; 
                                                     owl:onProperty tribont-core:isCharacterisedByOperationCondition ; 
                                                     a owl:Restriction],
                                                    tribont-equipment:MeasuringEquipment;
                                    status:term_status "Testing".
tribont-equipment:OpticalProfilometer a owl:Class;
                                      rdfs:comment "An equipment used to measure precisely surface profiles.";
                                      rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                      rdfs:label "OpticalProfilometer";
                                      rdfs:subClassOf tribont-equipment:MeasuringEquipment;
                                      status:term_status "Testing".
tribont-equipment:Scale a owl:Class;
                        rdfs:comment "An equipment used to measure the weigth of somebody or something.";
                        rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                        rdfs:label "Scale";
                        rdfs:subClassOf [owl:allValuesFrom tribont-core:Weight ; 
                                         owl:onProperty tribont-core:isCharacterisedByOutputMeasure ; 
                                         a owl:Restriction],
                                        tribont-equipment:MeasuringEquipment;
                        status:term_status "Testing".
tribont-equipment:ScanningElectronMicroscope a owl:Class;
                                             rdfs:comment "An equipment used to assess the materials surfaces by producing images of a sample.";
                                             rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                             rdfs:label "ScanningElectronMicroscope";
                                             rdfs:subClassOf tribont-equipment:MeasuringEquipment;
                                             status:term_status "Testing".
tribont-equipment:ScratchTester a owl:Class;
                                rdfs:comment "An equipment used to assess the coating adhesion.";
                                rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                rdfs:label "ScratchTester";
                                rdfs:subClassOf tribont-equipment:MeasuringEquipment;
                                status:term_status "Testing".
tribont-equipment:TechnicalDocument a owl:Class;
                                    rdfs:comment "Information on how to to use and maintain something as for e.g. drawings, manuals, technical reports, etc.";
                                    rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                    rdfs:label "TechnicalDocument";
                                    rdfs:subClassOf tribont-core:Document;
                                    status:term_status "Testing".
tribont-equipment:Tribometer a owl:Class;
                             rdfs:comment "An equipment used to measure tribological properties (e.g. friction coefficients, wear, etc.) by simulating the interaction of between two surfaces in contact under specific operation conditions.";
                             rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                             rdfs:label "Tribometer";
                             rdfs:subClassOf [owl:allValuesFrom tribont-core:Body ; 
                                              owl:onProperty tribont-equipment:holdsMovingSampleBody ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom tribont-core:Body ; 
                                              owl:onProperty tribont-equipment:holdsMovingSampleBody ; 
                                              a owl:Restriction],
                                             tribont-equipment:ExperimentalEquipment,
                                             [owl:allValuesFrom tribont-core:Body ; 
                                              owl:onProperty tribont-equipment:holdsStaticSampleBody ; 
                                              a owl:Restriction],
                                             [owl:allValuesFrom tribont-core:TribologicalProperty ; 
                                              owl:onProperty tribont-core:isCharacterisedByOutputMeasure ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom tribont-core:Body ; 
                                              owl:onProperty tribont-equipment:holdsStaticSampleBody ; 
                                              a owl:Restriction];
                             status:term_status "Testing".
tribont-equipment:TribometerClass a owl:Class;
                                  rdfs:comment "An aggrupation of tribometers with a set of common atributes of characteristics.";
                                  rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                  rdfs:label "TribometerClass";
                                  rdfs:subClassOf [owl:allValuesFrom tribont-core:Body ; 
                                                   owl:onProperty tribont-equipment:holdsStaticSampleBody ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom tribont-core:Body ; 
                                                   owl:onProperty tribont-equipment:holdsMovingSampleBody ; 
                                                   a owl:Restriction],
                                                  tribont-equipment:ExperimentalEquipmentClass;
                                  status:term_status "Testing".
tribont-equipment:executionDate a owl:DatatypeProperty;
                                rdfs:comment "The date when a specific action has been performed.";
                                rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                rdfs:label "executionDate";
                                status:term_status "Testing".
tribont-equipment:hasCalibration a owl:ObjectProperty;
                                 rdfs:comment "The relation between a specific equipment and the calibrations performed on it.";
                                 rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                 rdfs:label "hasCalibration";
                                 status:term_status "Testing".
tribont-equipment:holdsMovingSampleBody a owl:ObjectProperty;
                                        rdfs:comment "Relationship between an equipment and the moving sample  body it can hold";
                                        rdfs:isDefinedBy "https://w3id.org/tribont/equipment";
                                        rdfs:label "holdsMovingSampleBody";
