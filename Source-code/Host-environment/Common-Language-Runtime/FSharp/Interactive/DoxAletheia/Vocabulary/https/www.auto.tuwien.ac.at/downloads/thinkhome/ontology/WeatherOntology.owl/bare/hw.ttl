wgspos:Point a owl:Class;
             rdfs:comment "A point, typically described using a coordinate system relative to Earth, such as WGS84."@en,
                          """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2)."""@en;
             rdfs:label "point";
             rdfs:subClassOf wgspos:SpatialThing.
wgspos:SpatialThing a owl:Class;
                    rdfs:comment """Anything with spatial extent, i.e. size, shape, or position.
 e.g. people, places, bowling balls, as well as abstract areas like cubes."""@en;
                    rdfs:label "SpatialThing".
wgspos:alt a owl:DatatypeProperty;
           rdfs:comment "altitude"@en,
                        """The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid)."""@en;
           rdfs:domain wgspos:SpatialThing.
wgspos:lat a owl:DatatypeProperty;
           rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees)."@en;
           rdfs:domain wgspos:SpatialThing;
           rdfs:label "latitude".
wgspos:location a owl:ObjectProperty;
                rdfs:comment """The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping ."""@en;
                rdfs:label "location";
                rdfs:range wgspos:SpatialThing.
wgspos:long a owl:DatatypeProperty;
            rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees)"@en;
            rdfs:domain wgspos:SpatialThing;
            rdfs:label "longitude".
hw: a owl:Ontology;
    rdfs:comment "smart home ontology for weather phenomena and exterior conditions"@en;
    owl:imports <http://www.w3.org/2006/time>;
    owl:versionIRI <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/weather/WeatherOntology_1.03.owl>;
    owl:versionInfo "1.03".
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AboveRoomTemperature> a owl:Class;
                                                                                                      owl:equivalentClass [owl:intersectionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Temperature>
                                                                                                                                               [owl:allValuesFrom [owl:withRestrictions ([xsd:minExclusive "25.0"^^xsd:float]) ; 
                                                                                                                                                                  owl:onDatatype xsd:float ; 
                                                                                                                                                                  a rdfs:Datatype] ; 
                                                                                                                                               owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasValue> ; 
                                                                                                                                               a owl:Restriction]) ; 
                                                                                                                           a owl:Class].
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AboveZeroTemperature> a owl:Class;
                                                                                                      owl:equivalentClass [owl:intersectionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Temperature>
                                                                                                                                               [owl:allValuesFrom [owl:withRestrictions ([xsd:minExclusive "0.0"^^xsd:float]) ; 
                                                                                                                                                                  owl:onDatatype xsd:float ; 
                                                                                                                                                                  a rdfs:Datatype] ; 
                                                                                                                                               owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasValue> ; 
                                                                                                                                               a owl:Restriction]) ; 
                                                                                                                           a owl:Class].
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AirPollution> a owl:Class;
                                                                                              rdfs:comment "the current air pollution represented as European Air Quality Index value. The index value is based on 3 pollutants of major concern in Europe: PM10, NO2, O3 and will be able to take into account to 3 additional pollutants (CO, PM2.5 and SO2) where data are also available."@en;
                                                                                              rdfs:subClassOf [owl:someValuesFrom xsd:nonNegativeInteger ; 
                                                                                                               owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasValue> ; 
                                                                                                               a owl:Restriction],
                                                                                                              <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon>;
                                                                                              owl:equivalentClass [owl:unionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#HighAirPollution>
                                                                                                                                <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#LowAirPollution>
                                                                                                                                <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#MediumAirPollution>
                                                                                                                                <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#VeryHighAirPollution>
                                                                                                                                <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#VeryLowAirPollution>) ; 
                                                                                                                   a owl:Class].
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AiringWeatherState> a owl:Class;
                                                                                                    rdfs:comment ""@en;
                                                                                                    owl:equivalentClass [owl:intersectionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherState>
                                                                                                                                             [owl:complementOf [owl:someValuesFrom <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AboveRoomTemperature> ; 
                                                                                                                                                               owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasWeatherPhenomenon> ; 
                                                                                                                                                               a owl:Restriction] ; 
                                                                                                                                             a owl:Class]
                                                                                                                                             [owl:someValuesFrom <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#NoPrecipitation> ; 
                                                                                                                                             owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasWeatherPhenomenon> ; 
                                                                                                                                             a owl:Restriction]
                                                                                                                                             [owl:someValuesFrom [owl:unionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#LightWind>
                                                                                                                                                                              <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#StrongWind>) ; 
                                                                                                                                                                 a owl:Class] ; 
                                                                                                                                             owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasWeatherPhenomenon> ; 
                                                                                                                                             a owl:Restriction]) ; 
                                                                                                                         a owl:Class].
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#AtmosphericPressure> a owl:Class;
                                                                                                     rdfs:comment "atmospheric pressure in hectopascal (hPa)"@en;
                                                                                                     rdfs:subClassOf [owl:onDataRange [owl:withRestrictions ([xsd:minExclusive "0.0"^^xsd:float]) ; 
                                                                                                                                       owl:onDatatype xsd:float ; 
                                                                                                                                       a rdfs:Datatype] ; 
                                                                                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                                                      owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasValue> ; 
                                                                                                                      a owl:Restriction],
                                                                                                                     <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon>.
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#BelowOrZeroTemperature> a owl:Class;
                                                                                                        owl:equivalentClass [owl:intersectionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Temperature>
                                                                                                                                                 [owl:allValuesFrom [owl:withRestrictions ([xsd:maxInclusive "0.0"^^xsd:float]) ; 
                                                                                                                                                                    owl:onDatatype xsd:float ; 
                                                                                                                                                                    a rdfs:Datatype] ; 
