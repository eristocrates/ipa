                                                                                                                                              a owl:Restriction]) ; 
                                                                                                                          a owl:Class].
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#CurrentWeatherReport> a owl:Class;
                                                                                                      owl:disjointWith <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#ForecastWeatherReport>;
                                                                                                      owl:equivalentClass [owl:intersectionOf (<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherReport>
                                                                                                                                               [owl:someValuesFrom [owl:someValuesFrom [owl:someValuesFrom [owl:hasValue 0  ; 
                                                                                                                                                                                                           owl:onProperty time:hour ; 
                                                                                                                                                                                                           a owl:Restriction] ; 
