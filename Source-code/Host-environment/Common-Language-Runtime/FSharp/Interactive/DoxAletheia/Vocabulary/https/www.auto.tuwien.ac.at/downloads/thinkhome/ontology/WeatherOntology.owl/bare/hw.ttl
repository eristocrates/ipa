                                                                                                                                                          a owl:Restriction]
                                                                                                                                                          [owl:someValuesFrom [owl:someValuesFrom [owl:someValuesFrom [owl:hasValue 0  ; 
                                                                                                                                                                                                                      owl:onProperty time:hour ; 
                                                                                                                                                                                                                      a owl:Restriction] ; 
