<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#Cloud> a <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherCondition>,
                                                                                         owl:NamedIndividual.
<https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#CloudCover> a owl:Class;
                                                                                            rdfs:comment """clound cover in the unit \"Okta\""""@en;
                                                                                            rdfs:subClassOf [owl:intersectionOf ([owl:onDataRange [owl:withRestrictions ([xsd:maxExclusive 10 ]) ; 
                                                                                                                                                  owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                                                  a rdfs:Datatype] ; 
                                                                                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                                                                 owl:onProperty <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasCloudCoverValue> ; 
                                                                                                                                 a owl:Restriction]
                                                                                                                                 [owl:onDataRange xsd:nonNegativeInteger ; 
