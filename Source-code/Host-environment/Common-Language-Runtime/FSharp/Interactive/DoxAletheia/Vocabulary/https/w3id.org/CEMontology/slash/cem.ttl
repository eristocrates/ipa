                                          rdfs:subClassOf <http://crimeanalytics.it/cem/CrimeAgainstPublicOrder>.
<http://crimeanalytics.it/cem/Theft> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "Theft"@en;
