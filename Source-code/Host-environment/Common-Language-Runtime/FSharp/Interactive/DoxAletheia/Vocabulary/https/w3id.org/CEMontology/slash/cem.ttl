<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocommons/voaf#Vocabulary> a <http://www.w3.org/2002/07/owl#Class>.
<http://schema.org/Article> a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "An article, such as a news article or piece of investigative report. Newspapers and magazines have articles of many different types and this is intended to cover them all."@en;
                            rdfs:label "Article"@en;
                            rdfs:subClassOf <http://schema.org/CreativeWork>.
<http://schema.org/CreativeWork> a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "The most generic kind of creative work, including books, movies, photographs, software programs, etc."@en;
                                 rdfs:label "CreativeWork"@en;
                                 rdfs:subClassOf <http://schema.org/Thing>.
<http://schema.org/DataType> a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The basic data types such as Integers, Strings, etc."@en;
                             rdfs:label "DataType"@en;
                             <http://www.w3.org/2002/07/owl#disjointWith> <http://semanticweb.cs.vu.nl/2009/11/sem/Core>.
<http://schema.org/Date> a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """A date value in <a href=\"http://en.wikipedia.org/wiki/ISO_8601\">ISO 8601 date format</a>."""@en;
                         rdfs:isDefinedBy <https://schema.org/Date>;
                         rdfs:label "Date"@en;
                         rdfs:subClassOf <http://schema.org/DataType>.
<http://schema.org/DateTime> a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A combination of date and time of day in the form [-]CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] (see Chapter 5.4 of ISO 8601)."@en;
                             rdfs:isDefinedBy <https://schema.org/DateTime>;
                             rdfs:label "DateTime"@en;
                             rdfs:subClassOf <http://schema.org/DataType>.
<http://schema.org/Language> a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Natural languages such as Spanish, Tamil, Hindi, English, etc. Formal language code tags expressed in BCP 47 can be used via the alternateName property. The Language type previously also covered programming languages such as Scheme and Lisp, which are now best represented using ComputerLanguage."@en;
                             rdfs:label "Language"@en;
                             rdfs:subClassOf <http://schema.org/Thing>.
<http://schema.org/NewsArticle> a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment """A NewsArticle is an article whose content reports news, or provides background context and supporting materials for understanding the news.<br/><br/>

A more detailed overview of <a href=\"/docs/news.html\">schema.org News markup</a> is also available."""@en;
                                rdfs:isDefinedBy <https://schema.org/NewsArticle>;
                                rdfs:label "NewsArticle"@en;
                                rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://schema.org/mentions> ; 
                                                 <http://www.w3.org/2002/07/owl#someValuesFrom> <http://crimeanalytics.it/cem/CrimeEvent>],
                                                <http://schema.org/Article>.
<http://schema.org/Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "An organization such as a school, NGO, corporation, club, etc."@en;
                                 rdfs:label "Organization"@en;
                                 rdfs:subClassOf <http://schema.org/Thing>.
<http://schema.org/Person> a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A person (alive, dead, undead, or fictional)."@en;
                           rdfs:label "Person"@en;
                           rdfs:subClassOf <http://schema.org/Thing>.
<http://schema.org/Place> a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Entities that have a somewhat fixed, physical extension."@en;
                          rdfs:label "Place"@en;
                          rdfs:subClassOf <http://schema.org/Thing>;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://semanticweb.cs.vu.nl/2009/11/sem/Place>.
<http://schema.org/Text> a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Data type: Text."@en;
                         rdfs:isDefinedBy <https://schema.org/Text>;
                         rdfs:label "Text"@en;
                         rdfs:subClassOf <http://schema.org/DataType>.
<http://schema.org/Thing> a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The most generic type of item."@en;
                          rdfs:label "Thing"@en;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.w3.org/2002/07/owl#Thing>.
<http://schema.org/URL> a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Data type: URL."@en;
                        rdfs:label "URL"@en;
                        rdfs:subClassOf <http://schema.org/Text>.
<http://schema.org/articleBody> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "The actual body of the article."@en;
                                rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                             <http://www.w3.org/2002/07/owl#unionOf> ()];
                                rdfs:isDefinedBy <https://schema.org/articleBody>;
                                rdfs:label "articleBody"@en;
                                rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                            <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/containedInPlace> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "The basic containment relation between a place and one that contains it."@en;
                                     rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                  <http://www.w3.org/2002/07/owl#unionOf> ()];
                                     rdfs:isDefinedBy <https://schema.org/containedInPlace>;
                                     rdfs:label "containedInPlace"@en;
                                     rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                 <http://www.w3.org/2002/07/owl#unionOf> ()];
                                     <http://www.w3.org/2002/07/owl#inverseOf> <http://schema.org/containsPlace>.
<http://schema.org/containsPlace> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Inverse property of containedInPlace."@en;
                                  rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                               <http://www.w3.org/2002/07/owl#unionOf> ()];
                                  rdfs:label "containsPlace"@en;
                                  rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                              <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/datePublished> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Date of first broadcast/publication."@en;
                                  rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                               <http://www.w3.org/2002/07/owl#unionOf> ()];
                                  rdfs:isDefinedBy <https://schema.org/datePublished>;
                                  rdfs:label "datePublished"@en;
                                  rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                              <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/hasurl> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "URL of the item."@en;
                           rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                        <http://www.w3.org/2002/07/owl#unionOf> ()];
                           rdfs:isDefinedBy <https://schema.org/url>;
                           rdfs:label "url"@en;
                           rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                       <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/headline> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Headline of the article."@en;
                             rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                          <http://www.w3.org/2002/07/owl#unionOf> ()];
                             rdfs:isDefinedBy <https://schema.org/headline>;
                             rdfs:label "headline"@en;
                             rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                         <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/inLanguage> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment """The language of the content or performance or used in an action. Please use one of the language codes from the <a href=\"http://tools.ietf.org/html/bcp47\">IETF BCP 47 standard</a>. See also <a class=\"localLink\" href=\"http://schema.org/availableLanguage\">availableLanguage</a>."""@en;
                               rdfs:domain <http://schema.org/CreativeWork>;
                               rdfs:isDefinedBy <https://schema.org/inLanguage>;
                               rdfs:label "inLanguage"@en;
                               rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                           <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/mentions> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a concept."@en;
                             rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                          <http://www.w3.org/2002/07/owl#unionOf> ()];
                             rdfs:isDefinedBy <https://schema.org/mentions>;
                             rdfs:label "mentions"@en;
                             rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                         <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://schema.org/publisher> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "The publisher of the creative work."@en;
                              rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                                           <http://www.w3.org/2002/07/owl#unionOf> ()];
                              rdfs:isDefinedBy <https://schema.org/publisher>;
                              rdfs:label "publisher"@en;
                              rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                                          <http://www.w3.org/2002/07/owl#unionOf> ()].
<http://semanticweb.cs.vu.nl/2009/11/sem/Actor> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "Actors are entities that take part in an Event, either actively or passively. Actors do not necessarily have to be sentient. They can also be objects. Actors are a thing, animate or inanimate, physical or non-physical.";
                                                rdfs:label "Actor";
                                                rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core>;
                                                <http://www.w3.org/2004/02/skos/core#broadMatch> <http://sw.opencyc.org/2009/04/07/concept/en/SomethingExisting>,
                                                                                                 <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#endurant>;
                                                <http://www.w3.org/2004/02/skos/core#closeMatch> <http://xmlns.com/foaf/0.1/Agent>,
                                                                                                 <http://purl.org/dc/terms/AgentClass>,
                                                                                                 <http://sw.opencyc.org/2009/04/07/concept/en/Agent-Generic>,
                                                                                                 <http://purl.org/dc/terms/Agent>,
                                                                                                 <http://www.ontologyportal.org/translations/SUMO.owl.txt#Agent>,
                                                                                                 <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E39.Actor>.
<http://semanticweb.cs.vu.nl/2009/11/sem/Core> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "The SEM Core class contains all entities that make up the context of an event: Events, Actors, Places, Times. This class is meant to be extended for each application domain.";
                                               rdfs:label "Core".
<http://semanticweb.cs.vu.nl/2009/11/sem/Event> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "Events are things that happen. This comprises everything from historical events to web site sessions and mythical journeys. Event is the central class of SEM.";
                                                rdfs:label "Event";
                                                rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core>;
                                                <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/NET/c4dm/event.owl#Event>,
                                                                                                 <http://linkedevents.org/ontology/Event>;
                                                <http://www.w3.org/2004/02/skos/core#closeMatch> <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E5.Event>,
                                                                                                 <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#perdurant>,
                                                                                                 <http://sw.opencyc.org/2009/04/07/concept/en/Situation>,
                                                                                                 <http://purl.org/dc/dcmitype/Event>,
                                                                                                 <http://www.ontologyportal.org/translations/SUMO.owl.txt#Process>.
<http://semanticweb.cs.vu.nl/2009/11/sem/Place> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "Places are locations where an Event happens. They do not need to be physical places and hence do not necessarily need coordinates. Neither do they need to have any significance apart from them being the location of an Event.";
                                                rdfs:label "Place";
                                                rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core>;
                                                <http://www.w3.org/2004/02/skos/core#closeMatch> <http://purl.org/dc/terms/Location>,
                                                                                                 <http://www.ontologyportal.org/translations/SUMO.owl.txt#GeographicArea>,
                                                                                                 <http://www8.informatik.uni-erlangen.de/IMMD8/Services/cidoc-crm/erlangen-crm_090330_5_0_1.owl#E53.Place>,
                                                                                                 <http://sw.opencyc.org/2009/04/07/concept/en/EnduringThing-Localized>;
                                                <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://www.loa-cnr.it/ontologies/DOLCE-Lite.owl#PhysicalRegion>,
                                                                                                  <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
<http://semanticweb.cs.vu.nl/2009/11/sem/Time> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:comment "Time contains symbolic representations of when an Event took place. Time instances do not necessarily need to have a timestamp associated with them. The Time class exists to represent semantics of time, e.g. that one thing happens before another, even though the exact timestamps are unknown.";
                                               rdfs:label "Time";
                                               rdfs:subClassOf <http://semanticweb.cs.vu.nl/2009/11/sem/Core>;
                                               <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/2006/timeTemporalEntity>.
<http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                        rdfs:comment "Event properties connect Events to other SEM Core entities."@en;
                                                        rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                        rdfs:label "eventProperty";
                                                        rdfs:range rdfs:Class.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasActor> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:comment "Has actor is used to state which Actors or Objects participate in an Event."@en;
                                                   rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                   rdfs:label "hasActor";
                                                   rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Actor>;
                                                   rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty>;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://linkedevents.org/ontology/involved>;
                                                   <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://www.kulttuurisampo.fi/ebkr/agent>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasBeginTimeStamp> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                            rdfs:comment "Has begin timestamp is used to indicate the beginning of a time interval. Omitting the hasBeginTimeStamp while stating a hasEndTimeStamp is interpreted as an open ended interval."@en;
                                                            rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                            rdfs:label "hasBeginTimestamp";
                                                            rdfs:range xsd:dateTimeStamp;
                                                            rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasEndTimeStamp> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                          rdfs:comment "Has end timestamp is used to indicate the end of a time interval. Omitting the hasEndTimeStamp while stating a hasBeginTimeStamp is interpreted as an open ended interval."@en;
                                                          rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                          rdfs:label "hasEndTimestamp";
                                                          rdfs:range xsd:dateTimeStamp;
                                                          rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasPlace> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:comment "Has place is used to state in which Place(s) an Event happened. Coordinates can be attached to the Place with the W3C Geospatial Vocabulary (http://www.w3.org/2005/Incubator/geo/XGR-geo-20071023/).";
                                                   rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                   rdfs:label "hasPlace";
                                                   rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Place>;
                                                   rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty>;
                                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <http://www.kulttuurisampo.fi/ebkr/place>;
                                                   <http://www.w3.org/2004/02/skos/core#narrowMatch> <http://linkedevents.org/ontology/inSpace>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasSubEvent> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                      rdfs:comment "Has subevent connects an Event to other Events that belong to it. This is a very generic property that does not mean the subevents fully define the superconcept or that there is any causal relationship.";
                                                      rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                      rdfs:label "has subevent";
                                                      rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                      rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty>;
                                                      <http://www.w3.org/2002/07/owl#inverseOf> <http://semanticweb.cs.vu.nl/2009/11/sem/subEventOf>;
                                                      <http://www.w3.org/2004/02/skos/core#exactMatch> <http://purl.org/NET/c4dm/event.owl#sub_event>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasTime> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                  rdfs:comment "Has time is used to indicate at which time an Event took place or when a property under the Temporary Constraint is valid. Has time points to a symbolic representation of time, which allows semantic relations between time resources. (see http://www.w3.org/TR/owl-time/)";
                                                  rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                  rdfs:label "has Time";
                                                  rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Time>;
                                                  rdfs:subPropertyOf <http://semanticweb.cs.vu.nl/2009/11/sem/eventProperty>;
                                                  <http://www.w3.org/2004/02/skos/core#broadMatch> <http://linkedevents.org/ontology/atTime>.
<http://semanticweb.cs.vu.nl/2009/11/sem/hasTimeStamp> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                       rdfs:comment "Has timestamp is used to put time indicators on any individual. It is the most common way to state when an Event took place. There are subproperties of hasTimeStamp to represent time intervals and uncertain time intervals. If the exact moment is not known, but it is necessary to specify a certain time, use hasTime instead. All of these properties are also used to indicate the time at which a property under the Temporary Constraint is valid."@en;
                                                       rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                       rdfs:label "hasTimestamp";
                                                       rdfs:range xsd:dateTimeStamp;
                                                       <http://www.w3.org/2004/02/skos/core#closeMatch> <http://www.kulttuurisampo.fi/ebkr/time>.
<http://semanticweb.cs.vu.nl/2009/11/sem/subEventOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                     rdfs:comment "Inverse property of hasSubEvent";
                                                     rdfs:domain <http://semanticweb.cs.vu.nl/2009/11/sem/Event>;
                                                     rdfs:label "subevent of";
                                                     rdfs:range <http://semanticweb.cs.vu.nl/2009/11/sem/Event>.
<http://semanticweb.cs.vu.nl/2009/11/sem/subTypeOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                    rdfs:comment "The inverse property of hasSubType."@en;
                                                    rdfs:domain rdfs:Class;
                                                    rdfs:label "subtype of";
                                                    rdfs:range rdfs:Class;
                                                    rdfs:subPropertyOf rdfs:subClassOf.
rdfs:Class a <http://www.w3.org/2002/07/owl#Class>.
rdfs:subClassOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The subject is a subclass of a class."@en;
                rdfs:domain rdfs:Class;
                rdfs:isDefinedBy <http://www.w3.org/2000/01/rdf-schema>;
                rdfs:label "subClassOf";
                rdfs:range rdfs:Class.
xsd:date a rdfs:Datatype.
<http://www.w3.org/2004/02/skos/core#broadMatch> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2004/02/skos/core#closeMatch> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2004/02/skos/core#exactMatch> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2004/02/skos/core#narrowMatch> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://xmlns.com/foaf/0.1/Organization> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/Person> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<https://w3id.org/BLIND> a <http://xmlns.com/foaf/0.1/Organization>,
                           <http://www.w3.org/2002/07/owl#NamedIndividual>.
<https://w3id.org/CEMontology> <http://purl.org/dc/terms/bibliographicCitation> "BLIND";
                               <http://purl.org/dc/terms/contributor> [a <http://xmlns.com/foaf/0.1/Person> ; 
                                                                       <http://xmlns.com/foaf/0.1/name> "BLIND"],
                                                                      [a <http://xmlns.com/foaf/0.1/Person> ; 
                                                                       <http://xmlns.com/foaf/0.1/name> "BLIND"];
                               <http://purl.org/dc/terms/created> "2022-06-14"^^xsd:date;
                               <http://purl.org/dc/terms/creator> "BLIND";
                               <http://purl.org/dc/terms/description> "A lightweight ontology to describe crime events"@en;
                               <http://purl.org/dc/terms/identifier> cem:,
                                                                     "info:doi:10.13140/RG.2.2.18252.90243";
                               <http://purl.org/dc/terms/issued> "2022-06-14"^^xsd:date;
                               <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
                               <http://purl.org/dc/terms/modified> "2022-10-26"^^xsd:date;
                               <http://purl.org/dc/terms/provenance> <https://w3id.org/CEMontology>;
                               <http://purl.org/dc/terms/publisher> <https://w3id.org/BLIND>;
                               <http://purl.org/dc/terms/title> "Crime Event Model (CEM)"@en;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "cem";
                               <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/CEMontology/";
                               a <http://purl.org/vocommons/voaf#Vocabulary>,
                                 <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 <http://www.w3.org/2002/07/owl#Ontology>;
                               rdfs:comment "The Crime Event Model is an ontology for the representation of crime events extracted from local newspapers. It could be employed for Crime Analysis purposes: extracting crime information from newspapers and enriching them with proper machine-readable semantics is a critical task to help law enforcement agencies at preventing crime, supporting criminal investigations and evaluating the action of law enforcement agencies themselves. The model is based on the fundamental 5W1H journalistic questions, that are Who?, What?, When?, Where?, Why? and How?. Another important requirement was the attempt to exploit existing knowledge graphs and ontologies such as the Simple Event Model (SEM) Ontology and the Schema.org data model for interoperability and interconnection."@en,
                                            "-Version 1.1: Insertion of ontology descriptors to be inserted in Linked Open Vocabulary-Version 1: creation"@en;
                               rdfs:label "Crime Event Model (CEM)"@en;
                               <http://www.w3.org/2002/07/owl#versionIRI> <http://crimeanalytics.it/cem-reference/cem.owl>;
                               <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
