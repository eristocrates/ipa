@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sto: <https://w3id.org/i40/sto#>.

sto: <http://purl.org/dc/elements/1.1/description> "A vocabulary to describe the relation between standards in use on the Industry 4.0, and related concepts";
     <http://purl.org/dc/elements/1.1/title> "i40 Standards Lanscape Vocabulary"@en;
     <http://purl.org/dc/terms/created> "2017-01-25"^^xsd:date;
     <http://purl.org/dc/terms/creator> "Steffen Lohmann",
                                        "Paul Baptista",
                                        "Irlan Grangel";
     <http://purl.org/dc/terms/publisher> <http://de.dbpedia.org/resource/Fraunhofer-Gesellschaft>;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "sto";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/i40/sto#";
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#versionInfo> "0.2".
sto:IndustryDomain <http://purl.org/dc/terms/description> "Represents the possible industry domains"@en;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Industry Domain".
sto:SDO <http://purl.org/dc/terms/description> "Define the standards organizations that develop and publish specific standards related to the industry 4.0"@en;
        a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "Standard Developing Organization";
        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>;
        <http://www.w3.org/2002/07/owl#disjointWith> sto:Standard.
sto:Standard <http://purl.org/dc/terms/description> "Defines the standards in use on the Industry 4.0"@en;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Standard";
             rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
sto:abbreviation <http://purl.org/dc/terms/description> "Abbreviated  name of the organization"@en;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain sto:SDO;
                 rdfs:label "Abbreviated name".
sto:formationDate <http://purl.org/dc/terms/description> "Abbreviated  name of the organization"@en;
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain sto:SDO;
                  rdfs:label "Formation Date"@en;
                  rdfs:range xsd:date.
sto:hasDBpediaResource <http://purl.org/dc/terms/description> "Instance's DBpedia Resource"@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:label "Has DBpedia resource".
sto:hasOfficialWebsite <http://purl.org/dc/terms/description> "Instance's Official Website"@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:label "Has Official website".
sto:hasTag <http://purl.org/dc/terms/description> "Tag commonly used to refer to the standard "@en;
           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:domain sto:Standard;
           rdfs:label "Has Tag";
           rdfs:range <http://purl.org/muto/core#Tag>.
sto:hasWikidataEntity <http://purl.org/dc/terms/description> "Instance's Wikidata Entry"@en;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:label "Has Wikidata entity".
sto:hasWikipediaArticle <http://purl.org/dc/terms/description> "Instance's Wikipedia article"@en;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:label "Has Wikipedia article".
sto:license <http://purl.org/dc/terms/description> "License under which a standard is published"@en;
            a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain sto:Standard;
            rdfs:label "License";
            rdfs:subPropertyOf <http://purl.org/dc/terms/license>.
sto:motivation <http://purl.org/dc/terms/description> "A motivation for the creation of the standard"@en;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain sto:Standard;
               rdfs:label "motivation";
               rdfs:range <http://purl.org/spar/deo/Motivation>.
sto:name <http://purl.org/dc/terms/description> "Name of the Organization"@en;
         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain sto:SDO;
         rdfs:label "Name".
sto:norm <http://purl.org/dc/terms/description> "Norm under which the standard is published"@en;
         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain sto:Standard;
         rdfs:label "Norm".
sto:published <http://purl.org/dc/terms/description> "A standard published by this organization"@en;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain sto:SDO;
              rdfs:label "Published";
              rdfs:range sto:Standard;
              rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/made>;
              <http://www.w3.org/2002/07/owl#inverseOf> sto:publisher.
sto:publisher <http://purl.org/dc/terms/description> "The organization that published this Standard"@en;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain sto:Standard;
              rdfs:label "Publisher";
              rdfs:range sto:SDO;
              rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/maker>.
sto:ramiHierarchyLevel <http://purl.org/dc/terms/description> "Property through to associate the standards with the RAMI level in which they are applicable"@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain sto:Standard;
                       rdfs:label "RAMI Hierarchy Level"@en;
                       rdfs:range <https://w3id.org/i40/rami/RAMIHierarchyLevel>.
sto:relatedTo <http://purl.org/dc/terms/description> "Both Standards are related"@en;
              a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain sto:Standard;
              rdfs:label "Related to";
              rdfs:range sto:Standard.
sto:scope <http://purl.org/dc/terms/description> "Property through which relate the standards with industry domains"@en;
          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:domain sto:Standard;
          rdfs:label "Scope"@en;
          rdfs:range sto:IndustryDomain.
