@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ctrl: <https://w3id.org/ibp/CTRLont#>.

<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/identifier> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocommons/voaf#Vocabulary> a <http://www.w3.org/2002/07/owl#Class>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:seeAlso a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ibp/CTRLont> <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-2033-859X>,
                                                                  "Georg Ferdinand Schneider",
                                                                  <https://www.researchgate.net/profile/Georg_Schneider3>;
                               <http://purl.org/dc/terms/description> """The ontology and its use are described in [1]. The ontology is implemented using the free protege tool (protege.stanford.edu) [2].

[1] Schneider, G.F., Pauwels, P. and Steiger, S. (2017): \"Ontology-based Modelling of Control Logic in Building Automation Systems\" in IEEE Transactions on Industrial Informatics, vol. 13, no. 6, pp. 3350-3360, DOI: 10.1109/TII.2017.2743221.

[2] M. A. Musen (2015): The protege project: a look back and a look forward. AI matters, 1(4):4-12, doi: 10.1145/2757001.2757003."""@en;
                               <http://purl.org/dc/terms/identifier> "https://w3id.org/ibp/CTRLont#";
                               <http://purl.org/dc/terms/issued> "2016-11-01"^^xsd:date;
                               <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-sa/4.0>;
                               <http://purl.org/dc/terms/modified> "2018-03-12"^^xsd:date;
                               <http://purl.org/dc/terms/publisher> <https://www.ibp.fraunhofer.de/>;
                               <http://purl.org/dc/terms/rights> "Copyright (c) 2019 Georg Ferdinand Schneider/ Fraunhofer Institute for Building Physics IBP",
                                                                 """Copyright (c) 2017/ 2018, Fraunhofer Institute for Building Physics,
Nuremberg, Germany. This ontology is distributed under a Creative Commons Attribution 
Share Alike License (CC BY-SA 4.0) http://creativecommons.org/licenses/by-sa/4.0"""@en;
                               <http://purl.org/dc/terms/title> "CTRLont - An ontology to formally specify the control domain."@en;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "ctrl";
                               <http://purl.org/vocab/vann/preferredNamespaceUri> ctrl:;
                               a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 <http://purl.org/vocommons/voaf#Vocabulary>,
                                 <http://www.w3.org/2002/07/owl#Ontology>;
                               rdfs:comment "CTRLont specifies concepts and relationships of control actors on a high level."@en;
                               rdfs:label "CTRLont"@en;
                               <http://www.w3.org/2002/07/owl#priorVersion> <https://w3id.org/ibp/CTRLont-0.0.1>;
                               <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/ibp/CTRLont-0.2.0>;
                               <http://www.w3.org/2002/07/owl#versionInfo> "v0.2.0".
ctrl:AnnotatedElement a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An annotated element is a generic superclass for ctrl:Input, ctrl:Output and ctrl:Parameter"@en;
                      rdfs:label "Annotated Element"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasDataType ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:DataType ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasMedium ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Medium ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasQuantity ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Quantity ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasSemanticType ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:SemanticType ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasUnit ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Unit ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
ctrl:ApplicationLogic a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Concept to specify the application logic of a control actor. Seperate ontologies may be used to further specify this concept."@en;
                      rdfs:label "Application Logic"@en.
ctrl:ControlActor a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """Concept to describe the in general accepted Sense-Process-Actuate
pattern in automation systems, e.g. function blocks from IEC 61499."""@en;
                  rdfs:label "Control Actor"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> ctrl:ApplicationLogic ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> ctrl:hasApplicationLogic ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> ctrl:Output ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> ctrl:hasOutput ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasApplicationLogic ; 
                                   <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:ApplicationLogic ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasInput ; 
                                   <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Input ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasOutput ; 
                                   <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Output ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onProperty> ctrl:hasParameter ; 
                                   <http://www.w3.org/2002/07/owl#allValuesFrom> ctrl:Parameter ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>].
ctrl:DataType a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Placeholder class for the specification of basic data types such as, e.g. integer, boolean or double."@en;
              rdfs:label "Data type"@en;
              rdfs:seeAlso "https://www.w3.org/TR/xmlschema-2/#built-in-datatypes"^^xsd:anyURI.
ctrl:Input a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An input allow flows of information to enter a control actor. Inputs are processed by the respective application logic of the control actor to compute the outputs."@en;
           rdfs:label "Input"@en;
           rdfs:subClassOf ctrl:AnnotatedElement;
           <http://www.w3.org/2002/07/owl#disjointWith> ctrl:Parameter.
ctrl:Medium a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """Placeholder concept to stipulate reuse of existing ontologies such as dbpedia or  	http://www.productontology.org/id/"""@en;
            rdfs:label "Medium"@en;
            rdfs:seeAlso <http://wiki.dbpedia.org/>,
                         <http://www.productontology.org/id/>.
ctrl:Output a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An output allows compute results by the application logic of an control actor to be fowarded to outside entities such as actuators or other control actors."@en;
            rdfs:label "Output"@en;
            rdfs:subClassOf ctrl:AnnotatedElement;
            <http://www.w3.org/2002/07/owl#disjointWith> ctrl:Parameter.
ctrl:Parameter a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Parameter describe time-invariant values and settings of the respective control actor. Thus thay can be added dependent on the respective application logic."@en;
               rdfs:label "Parameter"@en;
               rdfs:subClassOf ctrl:AnnotatedElement.
ctrl:Quantity a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Placeholder concept to stipulate reuse of existing ontologies such as Ontology for Units and Measures (OM) or QUDT."@en;
              rdfs:label "Quantity"@en;
              rdfs:seeAlso <http://qudt.org/schema/qudt>,
                           <http://www.ontology-of-units-of-measure.org/resource/om-2/>.
ctrl:SemanticType a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "It may be required to further annotate an Input, Output or Parameter with a specific Semantic Type. For example in building automation to differ between room air temperature or outdoor air temperature."@en;
                  rdfs:label "Semantic Type"@en.
ctrl:Unit a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Placeholder concept to stipulate reuse of existing ontologies such as Ontology for Units and Measures (OM) or QUDT."@en;
          rdfs:label "Unit"@en.
ctrl:hasApplicationLogic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Object property to relate a control actor to its specific application logic"@en;
                         rdfs:label "hasApplicationLogic"@en;
                         rdfs:range ctrl:ApplicationLogic.
ctrl:hasDataType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Object property to annotate a input, output or parameter with its data type."@en;
                 rdfs:domain ctrl:AnnotatedElement;
                 rdfs:label "hasDataType"@en;
                 rdfs:range ctrl:DataType.
ctrl:hasInput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Object property to relate a control actor to its inputs."@en;
              rdfs:domain ctrl:ControlActor;
              rdfs:label "hasInput"@en;
              rdfs:range ctrl:Input.
ctrl:hasMedium a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Object property to annotate an input, output or parameter with its medium."@en;
               rdfs:domain ctrl:AnnotatedElement;
               rdfs:label "hasMedium"@en;
               rdfs:range ctrl:Medium.
ctrl:hasOutput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Object property to relate a control actor to its outputs."@en;
               rdfs:domain ctrl:ControlActor;
               rdfs:label "hasOutput"@en;
               rdfs:range ctrl:Output.
ctrl:hasParameter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Object property to relate a control actor to its parameter."@en;
                  rdfs:domain ctrl:ControlActor;
                  rdfs:label "hasParameter"@en;
                  rdfs:range ctrl:Parameter.
ctrl:hasQuantity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Object property to annotate an input, output or parameter with its quantity."@en;
                 rdfs:domain ctrl:AnnotatedElement;
                 rdfs:label "hasQuantity"@en;
                 rdfs:range ctrl:Quantity.
ctrl:hasSemanticType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Object property to relate an input, output or parameter with its semantic type."@en;
                     rdfs:domain ctrl:AnnotatedElement;
                     rdfs:label "hasSemanticType"@en;
                     rdfs:range ctrl:SemanticType.
ctrl:hasUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Object property to relate an input, output or parameter with its unit."@en;
             rdfs:domain ctrl:AnnotatedElement;
             rdfs:label "hasUnit"@en;
             rdfs:range ctrl:Unit.
ctrl:isConnectedTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Object property to describe the topological relationship between an input of one control actor and the output of another."@en;
                   rdfs:domain ctrl:Output;
                   rdfs:label "isConnectedTo"@en;
                   rdfs:range ctrl:Input.
ctrl:isSupervisedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Object property to describe hierarchical composition of control actors."@en;
                    rdfs:domain ctrl:ControlActor;
                    rdfs:label "isSupervisedBy"@en;
                    rdfs:range ctrl:ControlActor;
                    <http://www.w3.org/2002/07/owl#inverseOf> ctrl:supervises.
ctrl:logicInput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Object property to express the relationship of some application logic concept to an input."@en;
                rdfs:label "logicInput"@en;
                rdfs:range ctrl:Input.
ctrl:logicOutput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Object property to express the relationship of some application logic concept to an output."@en;
                 rdfs:label "logicOutput"@en;
                 rdfs:range ctrl:Output.
ctrl:logicParameter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Object property to express the relationship of some application logic concept to an parameter."@en;
                    rdfs:label "logicParameter"@en;
                    rdfs:range ctrl:Parameter.
ctrl:supervises a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Object property to describe if one control actor supervises another."@en;
                rdfs:domain ctrl:ControlActor;
                rdfs:label "supervises"@en;
                rdfs:range ctrl:ControlActor.
