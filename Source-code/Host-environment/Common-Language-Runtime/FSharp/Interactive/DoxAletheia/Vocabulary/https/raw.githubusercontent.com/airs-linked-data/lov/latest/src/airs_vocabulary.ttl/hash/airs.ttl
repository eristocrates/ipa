                              [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://semweb.mmlab.be/ns/oh#OpeningHours> ; 
                               <http://www.w3.org/2002/07/owl#onProperty> airs:hasSeasonalSchedule ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://www.w3.org/2002/07/owl#Thing>.
airs:Service a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """Akin to a \"Program\", as in for example \"a homeless outreach program\".  Can be delivered at many \"airs:Site[s]\", and the nexus of the two is an airs:SiteService"""@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:Agency ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:hasAgency ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:status ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             <http://www.w3.org/2002/07/owl#Thing>,
                             [<http://www.w3.org/2002/07/owl#someValuesFrom> airs:ServiceGroup ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:hasServiceGroup ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ResourceInfo ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:hasResourceInfo ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:SiteService ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:hasSiteService ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                              <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                              <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>].
airs:ServiceArea a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This is the geographic area served by the SiteService. This can be anything from a single neighborhood to an entire country. Types can also be mixed; perhaps one city and 6 nearby ZIP codes. In this case the required element would be City and there would be additional ZIP codes. A national 1-800 hotline would have one Country element."@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> airs:censusTract ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://purl.org/dc/terms/Location> ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> airs:servesGeographicArea ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 <http://www.w3.org/2002/07/owl#Thing>.
airs:ServiceGroup a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Groups together multiple Services that are related somehow."@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:Service ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> airs:offersService ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ResourceInfo ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> airs:hasResourceInfo ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://www.w3.org/2002/07/owl#Thing>.
airs:Site a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Sites are physical locations or none physical locations (a website or hotline). Site is used for two purposes. First, it is used by Agency to provide the location of the agency in Agency.AgencyLocation (note this type of Site would never have any SiteService children). Second, sites are also the location where services are provided. This would be the Agency.Site element (note this type of Site would have SiteService children)."@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                                                        a rdfs:Datatype] ; 
                           <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:status ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:Address ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasAddress ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:InternetResource ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasInternetResource ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:disabilitiesAccess ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:transportationServicesAccess ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2006/vcard/ns#Individual> ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#hasRelated> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:directions ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:openHoursDescription ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          <http://www.w3.org/ns/org#Site>,
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2003/01/geo/wgs84_pos#Point> ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasSpatialLocation ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:locatedAtCrossStreet ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:excludedFromWebsite ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:AlternateName ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasAlternateName ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2006/vcard/ns#Voice> ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#hasTelephone> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://semweb.mmlab.be/ns/oh#OpeningHours> ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:opensAtTimes ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:SiteService ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasSiteService ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:Agency ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasAgency ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ResourceInfo ; 
                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasResourceInfo ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#url> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>].
airs:SiteService a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """SiteService is the smallest unit describing a \"service\" that is offered at a Site. It can be thought of as the intersection of a Site and a Taxonomy code (or related Taxonomy codes) and meta data about what is offered. A \"Service\" however is not represented as its own element because the \"Service\" cannot exist without a location (the site)."""@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://semweb.mmlab.be/ns/oh#OpeningHours> ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> airs:opensAtTimes ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                                                               a rdfs:Datatype] ; 
                                  <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> airs:status ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
