                                          <http://www.w3.org/2002/07/owl#Thing>.
airs:LicenseAccreditation a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "If applicable, information about the license type (dct:title)/accreditation held by the agency and the body that licensed/accredited it."@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> airs:licensedBy ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          <http://www.w3.org/2002/07/owl#Thing>.
airs:ResourceInfo a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "For property <http://www.w3.org/2006/vcard/ns:hasRelated>, it indicates the person within each agency who has overall responsibility for updating the information about the agency, its sites and its services, etc."@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> airs:lastActionType ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> airs:availableForReferral ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:dateTime ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> airs:dateOfLastAction ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://www.w3.org/2002/07/owl#Thing>,
