                               a <http://www.w3.org/2002/07/owl#Restriction>].
airs:GenderRequirement <http://purl.org/dc/terms/description> "Any gender requirements for participation.  Further restrictions upon age for a given gender are also available.";
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/gender> ; 
