                                       <http://www.w3.org/2002/07/owl#Thing>.
airs:InternetResource a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A web location that has more information related to the SiteService, Agency, etc..  For example a facebook page for the Agency, that is supplementary to the Agency's main website."@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#url> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      <http://www.w3.org/2002/07/owl#Thing>.
airs:LanguageAvailability a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Languages offered, and available times, at the SiteService"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://semweb.mmlab.be/ns/oh#OpeningHours> ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> airs:hasLanguageTimeOpen ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
