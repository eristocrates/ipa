airs:Seasonal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Activities that are only offered a certain time of year, such as seasonal tax preparation, summer camps and holiday meals."@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                               <http://www.w3.org/2002/07/owl#onProperty> airs:seasonal ; 
