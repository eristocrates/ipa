airs: <http://purl.org/dc/elements/1.1/title> "The Alliance of Information and Referral Services (AIRS) Linked Open Vocabulary";
      <http://purl.org/dc/terms/date> "2015-02-15";
      <http://purl.org/dc/terms/description> "The AIRS Linked Open Vocabulary is a way to describe human services information and referral (I&R) concepts.  AIRS is the Alliance of Information and Referral Services (airs.org), which possesses over 1,000 member agencies primarily in the United States and Canada.  The AIRS LOV is based on the AIRS XML Schema, available at: https://airs-xml.googlecode.com/hg/tags/3.1/airs.xsd"@en;
      <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/>;
      a <http://www.w3.org/2002/07/owl#Ontology>;
      <http://www.w3.org/2002/07/owl#backwardCompatibleWith> "";
      <http://www.w3.org/2002/07/owl#priorVersion> <https://raw.githubusercontent.com/airs-linked-data/lov/v0.0.10/src/airs_vocabulary.ttl#>,
                                                   "";
      <http://www.w3.org/2002/07/owl#versionIRI> <https://raw.githubusercontent.com/airs-linked-data/lov/v0.0.11/src/airs_vocabulary.ttl#>.
airs:Address a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This represents a referenceable street location of an item, using an addressing system other than geospatial terms, often with postal system terms.  airs:hasDescription is a description of the physical location or other information pertinent to this address, and hasExplanationForNoPhysicalAddress clarifies why the address doesn't have a physical presence."@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:explanationForNoPhysicalAddess ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:physicalAddress ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ResourceInfo ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:hasResourceInfo ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                              <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                              <http://www.w3.org/2002/07/owl#onProperty> airs:mailingAddress ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             <http://www.w3.org/2006/vcard/ns#Address>.
airs:AgeRequirement <http://purl.org/dc/terms/description> "Age requirements for participation, independent of gender.";
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> airs:maximumAge ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> airs:minimumAge ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>].
airs:Agency a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """Agencies are organizations that offer services at locations. Agencies provide services directly or they may have \"child\" agencies that offer these services. Services are offered at sites that belong to an agency. Services are represented by the combination of taxonomy codes offered at a location; this idea is called a SiteService. To recap: Agencies don't provide services directly, they provide them through sites. For property <http://www.w3.org/2006/vcard/ns:hasRelated> This represents the agency contact.  1) Contact is the person at an Agency, or Site who will interface with the public or who has responsibility for the entity, like a site manager or director."""@en;
            rdfs:label "Agencia"@es,
                       "Agency"@en,
                       "Agence"@fr;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:gYear ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:yearIncorporated ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:recordOwner ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:AlternateName ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:hasAlternateName ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:InternetResource ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:hasInternetResource ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <http://www.w3.org/ns/org#FormalOrganization>,
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ServiceGroup ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:hasServiceGroup ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:boolean ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:excludedFromWebsite ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:legalStatus ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:ResourceInfo ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:hasResourceInfo ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:fein ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:LicenseAccreditation ; 
                             <http://www.w3.org/2002/07/owl#onProperty> airs:hasLicenseAccreditation ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2006/vcard/ns#Email> ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#hasEmail> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2006/vcard/ns#Voice> ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#hasTelephone> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#organization-name> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#url> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> airs:Site ; 
