@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xbrll: <https://w3id.org/vocab/xbrll#>.

<http://aims.fao.org/aos/geopolitical.owl#nameCurrencyEN> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                          rdfs:label "name currency EN"@en;
                                                          rdfs:range xsd:string.
<http://schema.org/Report> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/vocab/xbrll> <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Maria Moreno" ; 
                                                                   <http://schema.org/affiliation> [<http://xmlns.com/foaf/0.1/name> "CDP" ; 
                                                                                                    <http://xmlns.com/foaf/0.1/homepage> <http://www.cdp.net/>]],
                                                                  [<http://xmlns.com/foaf/0.1/name> "Ghislain Atemezing" ; 
                                                                   <http://schema.org/affiliation> [<http://xmlns.com/foaf/0.1/name> "Mondeca" ; 
                                                                                                    <http://xmlns.com/foaf/0.1/homepage> <http://www.mondeca.com/>]];
                               <http://purl.org/dc/terms/issued> "2016-05-18"^^xsd:date;
                               <http://purl.org/dc/terms/modified> "2016-06-01"^^xsd:date,
                                                                   "2016-06-29"^^xsd:date,
                                                                   "2016-05-20"^^xsd:date;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "xbrll";
                               a <http://www.w3.org/2002/07/owl#Ontology>,
                                 <http://purl.org/vocommons/voaf#Vocabulary>;
                               rdfs:label "El vocabulario para informe financiero"@es,
                                          "A leightweight XBRL vocabulary"@en;
                               <http://www.w3.org/2002/07/owl#versionInfo> "0.1".
xbrll:Context a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "the context of a fact in a financial report"@en;
              rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
              rdfs:label "Context"@en.
xbrll:DataPoint a rdfs:Class,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "this define a fact in the report. A data point should have at least one context"@en;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "data point"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> xbrll:context ; 
                                 <http://www.w3.org/2002/07/owl#onClass> xbrll:Context ; 
                                 <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> xbrll:Dimension ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> xbrll:hasDimension ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
xbrll:Dimension a rdfs:Class,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The dimension defining whether the dimensions in the axis are explicit member or implicit ones"@en;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "Dimension"@en.
xbrll:FinancialEntity a rdfs:Class,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                      rdfs:label "Financial entity"@en;
                      rdfs:subClassOf <http://www.w3.org/ns/regorg#RegisteredOrganization>.
xbrll:FinancialReport a rdfs:Class,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A financial report may content many data points that are facts"@en;
                      rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                      rdfs:label "Financial report"@en,
                                 "informe financiero"@es;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xbrll:DataPoint ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> xbrll:dataPoint ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      <http://schema.org/Report>.
xbrll:Period a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
             rdfs:label "Period"@en.
xbrll:contactPerson a rdf:Property,
                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "The person of contact in the metadata info of a company"@en;
                    rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                    rdfs:label "Contact person"@en;
                    rdfs:range <http://xmlns.com/foaf/0.1/Agent>.
xbrll:context a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                rdf:Property;
              rdfs:comment "Context property from a data point"@en;
              rdfs:domain xbrll:DataPoint;
              rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
              rdfs:label "Context property"@en;
              rdfs:range xbrll:Context.
xbrll:dataPoint a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "Data point property from a financial report"@en;
                rdfs:domain xbrll:FinancialReport;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "Data point property"@en;
                rdfs:range xbrll:DataPoint.
xbrll:decimals a rdf:Property,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Number of decimals used for a currency"@en;
               rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
               rdfs:label "Decimals"@en;
               rdfs:range xsd:integer.
xbrll:endDate a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "End date of a period"@en;
              rdfs:domain xbrll:Period;
              rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
              rdfs:label "End date"@en;
              rdfs:range xsd:date.
xbrll:fiscalYear a rdf:Property,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "End of fiscal year"@en;
                 rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                 rdfs:label "Fiscal year"@en;
                 rdfs:range xsd:date.
xbrll:hasDimension a rdf:Property,
                     <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain xbrll:Dimension;
                   rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                   rdfs:label "Has dimension"@en;
                   rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("Explicit Member"
                                                                      "Typed Member") ; 
                               a <http://www.w3.org/2002/07/owl#DataRange>].
xbrll:isForever a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Boolean telling the period is forever or not"@en;
                rdfs:domain xbrll:Period;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "Is forever"@en;
                rdfs:range xsd:boolean.
xbrll:isInstant a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "boolean for the instant moment"@en;
                rdfs:domain xbrll:Period;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "Is instant"@en;
                rdfs:range xsd:boolean.
xbrll:period a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
             rdfs:label "Period"@en;
             rdfs:range xbrll:Period.
xbrll:reportYear a rdf:Property,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "year of the report"@en;
                 rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                 rdfs:label "Report year"@en;
                 rdfs:range xsd:string.
xbrll:startDate a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Starting date of a period"@en;
                rdfs:domain xbrll:Period;
                rdfs:isDefinedBy <https://w3id.org/vocab/xbrll>;
                rdfs:label "Start date"@en;
                rdfs:range xsd:date.
