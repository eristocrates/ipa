@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix tax: <https://w3id.org/EUTaxO#>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://rs.tdwg.org/dwc/terms/acceptedNameUsage> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/genus> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/namePublishedInYear> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/scientificName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/scientificNameAuthorship> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/specificEpithet> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://rs.tdwg.org/dwc/terms/taxonRank> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<https://w3id.org/EUTaxO> <http://creativecommons.org/ns#license> "https://opensource.org/licenses/MIT";
                          <http://purl.org/dc/terms/contributor> "Carlos Alberto Martínez Muñoz";
                          <http://purl.org/dc/terms/created> "2022-09-29T23:59:59"^^xsd:dateTime;
                          <http://purl.org/dc/terms/creator> "José F. Aldana-Martín";
                          <http://purl.org/dc/terms/description> "EUdaphobase Taxonomy Ontology for the European Soil-Biology Data Warehouse for Soil Protection";
                          <http://purl.org/dc/terms/title> "EUTaxO - EUdaphobase Taxonomy Ontology";
                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "tax";
                          <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/EUTaxO#"^^xsd:anyURI;
                          a <http://www.w3.org/2002/07/owl#Ontology>;
                          rdfs:label "EUTaxO - EUdaphobase Taxonomy Ontology";
                          <http://www.w3.org/2002/07/owl#priorVersion> "https://www.eudaphobase.eu/ontologies/taxonomy/1.3.0"^^xsd:anyURI;
                          <http://www.w3.org/2002/07/owl#versionIRI> tax:2.0.0;
                          <http://www.w3.org/2002/07/owl#versionInfo> """v2.0.0 - Changes:
This major version adapts the ontology to better comply with the FAIR principles.
- Changed URI from \"https://www.eudaphobase.eu/ontologies/taxonomy\" to \"https://w3id.org/EUTaxO\"
- Complete ontology metadata
- Complete labels and comments for all terms
- Remove support to parse output excel file
- Remove all spaces from URIs""".
tax:Animalia a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Animalia kingdom";
             rdfs:label "Animalia";
             rdfs:subClassOf tax:Taxon.
tax:Taxon a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Base taxon class";
          rdfs:label "Taxon";
          rdfs:seeAlso "http://purl.org/biodiversity/taxon/Taxon"^^xsd:anyURI.
tax:belongsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#TransitiveProperty>;
              rdfs:comment "Defines a hierarchy from more generic taxa, to more specific ones";
              rdfs:domain tax:Taxon;
              rdfs:label "belongs to";
              rdfs:range tax:Taxon.
tax:brackets a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Whether to use brackets for the correct nomenclature of a taxon";
             rdfs:domain tax:Taxon;
             rdfs:label "brackets";
             rdfs:range xsd:boolean.
tax:id a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
       rdfs:comment "id from the EUdaphobase database";
       rdfs:domain tax:Taxon;
       rdfs:label "id";
       rdfs:range xsd:string.
tax:kingdom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "The kingdom of a specific taxon";
            rdfs:domain tax:Taxon;
            rdfs:label "kingdom";
            rdfs:range tax:Taxon.
tax:phylum a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "The phylum of a specific taxon";
           rdfs:domain tax:Taxon;
           rdfs:label "phylum";
           rdfs:range tax:Taxon.
tax:synonym a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              <http://www.w3.org/2002/07/owl#SymmetricProperty>,
              <http://www.w3.org/2002/07/owl#TransitiveProperty>;
            rdfs:comment "Relates if two taxon are synonyms";
            rdfs:domain tax:Taxon;
            rdfs:label "synonym";
            rdfs:range tax:Taxon.
tax:synonyms_exist a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Whether or not synonyms exists for a given taxon";
                   rdfs:domain tax:Taxon;
                   rdfs:label "synonyms exist";
                   rdfs:range xsd:boolean.
