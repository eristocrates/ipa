@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix dwc: <http://rs.tdwg.org/dwc/terms/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix tax: <https://w3id.org/EUTaxO#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

ccrel:license a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
dwc:acceptedNameUsage a owl:DatatypeProperty.
dwc:genus a owl:DatatypeProperty.
dwc:namePublishedInYear a owl:DatatypeProperty.
dwc:scientificName a owl:DatatypeProperty.
dwc:scientificNameAuthorship a owl:DatatypeProperty.
dwc:specificEpithet a owl:DatatypeProperty.
dwc:taxonRank a owl:DatatypeProperty.
w3id:EUTaxO ccrel:license "https://opensource.org/licenses/MIT";
            dcterms:contributor "Carlos Alberto Martínez Muñoz";
            dcterms:created "2022-09-29T23:59:59"^^xsd:dateTime;
            dcterms:creator "José F. Aldana-Martín";
            dcterms:description "EUdaphobase Taxonomy Ontology for the European Soil-Biology Data Warehouse for Soil Protection";
            dcterms:title "EUTaxO - EUdaphobase Taxonomy Ontology";
            vann:preferredNamespacePrefix "tax";
            vann:preferredNamespaceUri "https://w3id.org/EUTaxO#"^^xsd:anyURI;
            a owl:Ontology;
            rdfs:label "EUTaxO - EUdaphobase Taxonomy Ontology";
            owl:priorVersion "https://www.eudaphobase.eu/ontologies/taxonomy/1.3.0"^^xsd:anyURI;
            owl:versionIRI tax:2.0.0;
            owl:versionInfo """v2.0.0 - Changes:
This major version adapts the ontology to better comply with the FAIR principles.
- Changed URI from \"https://www.eudaphobase.eu/ontologies/taxonomy\" to \"https://w3id.org/EUTaxO\"
- Complete ontology metadata
- Complete labels and comments for all terms
- Remove support to parse output excel file
- Remove all spaces from URIs""".
tax:Animalia a owl:Class;
             rdfs:comment "Animalia kingdom";
             rdfs:label "Animalia";
             rdfs:subClassOf tax:Taxon.
tax:Taxon a owl:Class;
          rdfs:comment "Base taxon class";
          rdfs:label "Taxon";
          rdfs:seeAlso "http://purl.org/biodiversity/taxon/Taxon"^^xsd:anyURI.
tax:belongsTo a owl:ObjectProperty,
                owl:TransitiveProperty;
              rdfs:comment "Defines a hierarchy from more generic taxa, to more specific ones";
              rdfs:domain tax:Taxon;
              rdfs:label "belongs to";
              rdfs:range tax:Taxon.
tax:brackets a owl:DatatypeProperty;
             rdfs:comment "Whether to use brackets for the correct nomenclature of a taxon";
             rdfs:domain tax:Taxon;
             rdfs:label "brackets";
             rdfs:range xsd:boolean.
tax:id a owl:DatatypeProperty;
       rdfs:comment "id from the EUdaphobase database";
       rdfs:domain tax:Taxon;
       rdfs:label "id";
       rdfs:range xsd:string.
tax:kingdom a owl:ObjectProperty;
            rdfs:comment "The kingdom of a specific taxon";
            rdfs:domain tax:Taxon;
            rdfs:label "kingdom";
            rdfs:range tax:Taxon.
tax:phylum a owl:ObjectProperty;
           rdfs:comment "The phylum of a specific taxon";
           rdfs:domain tax:Taxon;
           rdfs:label "phylum";
           rdfs:range tax:Taxon.
tax:synonym a owl:ObjectProperty,
              owl:SymmetricProperty,
              owl:TransitiveProperty;
            rdfs:comment "Relates if two taxon are synonyms";
            rdfs:domain tax:Taxon;
            rdfs:label "synonym";
            rdfs:range tax:Taxon.
tax:synonyms_exist a owl:DatatypeProperty;
                   rdfs:comment "Whether or not synonyms exists for a given taxon";
                   rdfs:domain tax:Taxon;
                   rdfs:label "synonyms exist";
                   rdfs:range xsd:boolean.
