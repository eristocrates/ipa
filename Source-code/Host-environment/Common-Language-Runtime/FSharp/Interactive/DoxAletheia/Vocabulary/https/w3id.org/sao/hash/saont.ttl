@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix saont: <https://w3id.org/sao#>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/prov#hadMember> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/ep-plan#Agent> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#Entity> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#EntityCollection> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#MultiStep> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#MultiVariable> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#Plan> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan#correspondsToVariable> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/ep-plan#hasCorrespondingEntity> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/sao> <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by-nc-sa/4.0/>;
                       <http://purl.org/dc/terms/creator> <https://www.abdn.ac.uk/ncs/profiles/iman.naja>,
                                                          <https://www.abdn.ac.uk/ncs/profiles/milan.markovic/>,
                                                          <https://www.abdn.ac.uk/ncs/profiles/p.edwards>;
                       <http://purl.org/dc/terms/description> "An ontology to model accountability of generic systems."@en;
                       <http://purl.org/dc/terms/issued> "2020-12-18"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2021-12-30"^^xsd:date;
                       <http://purl.org/dc/terms/rights> "Copyright 2020 University of Aberdeen";
                       <http://purl.org/dc/terms/title> "The System Accountability Ontology"@en;
                       <http://purl.org/vocab/vann/preferredNamespacePrefix> "sao";
                       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/sao#";
                       a <http://www.w3.org/2002/07/owl#Ontology>;
                       rdfs:comment """-Version 1.0.1: minor edits and additions to the ontology metadata to reflect LOV requirements 
									-Version 1: creation"""@en,
                                    "To contact the RAInS team, please send an email to therainsproject [at] gmail [dot] com"@en;
                       rdfs:label "The System Accountability Ontology";
                       <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
saont:AccountabilityPlan a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A plan which describes a specification of the information that should be collected, so as to support accountability of systems.";
                         rdfs:label "Accountability Plan";
                         rdfs:subClassOf <https://w3id.org/ep-plan#Plan>.
saont:AccountableAction a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A planned step which is deemed to be important for accountability purposes and produces AccountableResult.";
                        rdfs:label "Accountable Action";
                        rdfs:subClassOf <https://w3id.org/ep-plan#MultiStep>.
saont:AccountableAgent a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An agent (typically a human)  that can be held accountable for his/her actions.";
                       rdfs:label "Accountable Agent";
                       rdfs:subClassOf <https://w3id.org/ep-plan#Agent>,
                                       saont:InformationElement.
saont:AccountableObject a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An accountable object models an abstract representation of a thing that should be documented for accountability. This may reference the whole system, its logical part, or associated process.  For example, a larger system may be described as a group of sub-systems or a single system may be broken down into a number of layers/components (e.g., a decision logic layer).";
                        rdfs:label "Accountable Object".
saont:AccountableResult a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An output variable which is produced by an Accountable Action, for example,  a decision made by a human or a specification produced by a team. The variable is part of the accountability plan and has a corresponding InformationRealization collection in the execution trace.";
                        rdfs:label "Accountable Result";
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/ep-plan#hasCorrespondingEntity> ; 
                                         <http://www.w3.org/2002/07/owl#allValuesFrom> saont:InformationRealization ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        <https://w3id.org/ep-plan#MultiVariable>.
saont:InformationElement a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A member of the collection of type Information Realization. Information Realizations may have multiple Information Elements.  Information Element describes in more detail a specific type of information contained by the Information Realization collection.";
                         rdfs:label "Information Element";
                         rdfs:subClassOf <https://w3id.org/ep-plan#Entity>.
saont:InformationRealization a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A collection of pieces of information (InformationElements) which corresponds to a variable of type  AccountableResult. The collection represents the actual piece of provenance information documenting a specific AccountableResult during a single plan execution.";
                             rdfs:label "Information Realization";
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#hadMember> ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> saont:InformationElement ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/ep-plan#correspondsToVariable> ; 
                                              <http://www.w3.org/2002/07/owl#allValuesFrom> saont:AccountableResult ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             <https://w3id.org/ep-plan#EntityCollection>.
saont:System a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A system that the collected accountability information is about.";
             rdfs:label "System";
             rdfs:subClassOf saont:AccountableObject.
saont:hasAccountableAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Inverse of is accountable for";
                          rdfs:domain <https://w3id.org/ep-plan#Entity>;
                          rdfs:label "has accountable agent";
                          rdfs:range saont:AccountableAgent;
                          <http://www.w3.org/2002/07/owl#inverseOf> saont:isAccountableFor.
saont:hasRelatedAccountableResult a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:domain saont:AccountableObject;
                                  rdfs:label "has related accountable result";
                                  rdfs:range saont:AccountableResult;
                                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                                  <http://www.w3.org/2002/07/owl#inverseOf> saont:relatesToAccountableObject.
saont:hasSpecifiedAccountabiltyPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "Inverse of specified for system.";
                                    rdfs:domain saont:System;
                                    rdfs:label "has specified accountability plan";
                                    rdfs:range saont:AccountabilityPlan;
                                    <http://www.w3.org/2002/07/owl#inverseOf> saont:specifiedForSystem.
saont:impacts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "A relation which describes that an accountable object have some effect on the system's accountability.";
              rdfs:domain saont:AccountableObject;
              rdfs:label "impacts";
              rdfs:range saont:System;
              <http://www.w3.org/2002/07/owl#inverseOf> saont:isImpactedBy.
saont:isAccountableFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "A relation that links accountable agents to entities they are accountable for.";
                       rdfs:domain saont:AccountableAgent;
                       rdfs:label "is accountable for";
                       rdfs:range <https://w3id.org/ep-plan#Entity>.
saont:isImpactedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Inverse of impacts.";
                   rdfs:domain saont:System;
                   rdfs:label "is impacted by";
                   rdfs:range saont:AccountableObject.
saont:relatesToAccountableObject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "A relation which describes the information described by an accountable result relates to an accountable object.";
                                 rdfs:domain saont:AccountableResult;
                                 rdfs:label "relates to accountable object";
                                 rdfs:range saont:AccountableObject.
saont:specifiedForSystem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "A relation that links the accountability plan to the system it was specified for.";
                         rdfs:domain saont:AccountabilityPlan;
                         rdfs:label "specified for system";
                         rdfs:range saont:System.
