<https://w3id.org/def/NyOn#j> a <http://www.w3.org/2003/11/swrl#Variable>.
<https://w3id.org/def/NyOn#m> a <http://www.w3.org/2003/11/swrl#Variable>.
<https://w3id.org/def/NyOn#p> a <http://www.w3.org/2003/11/swrl#Variable>.
<https://w3id.org/def/NyOn#r> a <http://www.w3.org/2003/11/swrl#Variable>.
<https://w3id.org/def/NyOn#x> a <http://www.w3.org/2003/11/swrl#Variable>.
<https://w3id.org/def/NyOn#y> a <http://www.w3.org/2003/11/swrl#Variable>.
nyon: <http://purl.org/dc/elements/1.1/publisher> <https://www.semintelligence.org/projects>;
      <http://purl.org/dc/terms/created> "2020-04-04";
      <http://purl.org/dc/terms/creator> "Harde, Pooja",
                                         "Mihindukulasooriya, Nandana",
                                         "Jain, Sarika";
      <http://purl.org/dc/terms/description> "An ontology that represents concepts in the legal domain."@en;
      <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/cc-by4.0>;
      <http://purl.org/dc/terms/modified> "2020-07-16";
      <http://purl.org/dc/terms/title> "NyOn: A Multilingual Legal Ontology for Globalized Judicial System"@en;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "nyon";
      <http://purl.org/vocab/vann/preferredNamespaceUri> nyon:;
      a <http://www.w3.org/2002/07/owl#Ontology>;
      <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
nyon:Accussed a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "person against whom an allegation has been made that he has committed an offence, or who is charge with an offence"@en;
              rdfs:label "Accused"@en;
              rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Class> ; 
                               <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:Respondent ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> nyon:hasParty ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                               [<http://www.w3.org/2002/07/owl#allValuesFrom> nyon:Criminal ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> nyon:OfDomian ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>])],
                              [a <http://www.w3.org/2002/07/owl#Class> ; 
                               <http://www.w3.org/2002/07/owl#intersectionOf> (nyon:Respondent
                                                                               [<http://www.w3.org/2002/07/owl#allValuesFrom> nyon:Criminal ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> nyon:OfDomian ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>])],
                              nyon:Party.
nyon:Advisory_Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "jurisdiction type is a advisory jurisdiction"@en;
                           rdfs:label "Advisory Jurisdiction"@en;
                           rdfs:subClassOf nyon:Jurisdiction.
nyon:Appellant a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "party who makes an appeal"@en;
               rdfs:label "Appellant"@en;
               rdfs:subClassOf nyon:Party;
               <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R7uigsz85fFCSPszS6B93dN"@en.
nyon:Appellant_Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "jurisdiction type is a appellant jurisdiction"@en;
                            rdfs:label "Appellant Jurisdiction"@en;
                            rdfs:subClassOf nyon:Jurisdiction.
nyon:Argument a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Argument made by any of the party"@en;
              rdfs:label "Argument"@en.
nyon:Author a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Author (Judge) who is responsible for a creation of case document"@en;
            rdfs:label "Author"@en;
            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onClass> nyon:Judge ; 
                                                             <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                             <http://www.w3.org/2002/07/owl#onProperty> nyon:hasAuthor ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/Ra6EHlbqrpUT9rxM2PtwIP"@en.
nyon:Bench a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Defines the bench of the case."@en;
           rdfs:label "Bench"@en;
           <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R8w3kl1tpEaQ2woPVs9N8Kf"@en.
nyon:COFirstName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain nyon:Court_Official;
                 rdfs:label "COFirstName"@en;
                 rdfs:range xsd:string;
                 rdfs:subPropertyOf nyon:courtOffName.
nyon:COLastName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain nyon:Court_Official;
                rdfs:label "COLastName"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf nyon:courtOffName.
nyon:CaseDomain a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "case belongs to specific proceeding like civil or criminal"@en;
                rdfs:label "CaseDomain"@en.
nyon:CaseType a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "classification of types of cases"@en;
              rdfs:label "CaseType"@en.
nyon:CatchWord a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Descriptive words or phrases used to categorise the subject matter of a case along with some keywords representing the issues in the case"@en;
               rdfs:label "Catchword"@en;
               rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Class> ; 
                                <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:CaseDomain ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> nyon:hasWords ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:Issue ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> nyon:hasWords ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>])],
                               [a <http://www.w3.org/2002/07/owl#Class> ; 
                                <http://www.w3.org/2002/07/owl#intersectionOf> (<http://www.w3.org/2002/07/owl#Thing>
                                                                                nyon:CaseDomain)].
nyon:Chief_Meterpolitan_Court a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "lower court at metropolitan level after Sessions Court for criminal cases"@en;
                              rdfs:label "Chief Meterpolitan Court"@en;
                              rdfs:subClassOf nyon:Courts_for_Criminal.
nyon:City_Civil_Courts a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "lower court at metropolitan level after High Courts for civil cases"@en;
                       rdfs:label "City Civil Court"@en;
                       rdfs:subClassOf nyon:Courts_for_Civil.
nyon:Civil a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "case is a civil case"@en;
           rdfs:label "Civil"@en;
           rdfs:subClassOf nyon:CaseDomain;
           <http://www.w3.org/2002/07/owl#disjointWith> nyon:Criminal.
nyon:Concurrence a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "decisions result when a judge agrees with the ultimate conclusion made by the majority of the court but disagrees on how they reached that decision";
                 rdfs:label "Concurrence"@en;
                 rdfs:subClassOf nyon:Opinion.
nyon:Country a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A country";
             rdfs:label "Country"@en;
             rdfs:subClassOf nyon:Location;
             <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RNrcOpWxQNlCpzR0FTsHNG"@en.
nyon:Court a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "courts in the judicial system"@en;
           rdfs:label "Court"@en;
           <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/Rafw4pSzJ3S3d8sq6quprG"@en.
nyon:CourtCase a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "represents the court judgment given by a court of law"@en;
               rdfs:label "CourtCase"@en.
nyon:CourtDecision a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "CourtDecision"@en.
nyon:Court_Official a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "legal system related people involved in a case"@en;
                    rdfs:label "CourtOfficial"@en.
nyon:Courts_for_Civil a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "court for civil cases"@en;
                      rdfs:label "Civil Court"@en;
                      rdfs:subClassOf nyon:CaseDomain;
                      <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9uoItz60Ut8I4l3jEH3mSF"@en.
nyon:Courts_for_Criminal a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "courts for crimnial cases"@en;
                         rdfs:label "Criminal Court"@en;
                         rdfs:subClassOf nyon:CaseDomain;
                         <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RihNVfYYtmWzQWciwxquKe"@en.
nyon:Courts_of_Smaller_Causes a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "lowest court after City Civil Courts at metropolitan level for civil cases"@en;
                              rdfs:label "Court of Smaller Cause"@en;
                              rdfs:subClassOf nyon:Courts_for_Civil;
                              <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9Mmy6MnWY16eR6dlLOKnGO"@en.
nyon:Criminal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "case is a criminal case"@en;
              rdfs:label "Criminal"@en;
              rdfs:subClassOf nyon:CaseDomain.
nyon:DateOfJudgment a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "signifies the final date on which the judgment is given by the court of law"@en;
                    rdfs:label "DateofJudgment"@en.
nyon:Decree a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "formal order issued by the judges";
            rdfs:label "Decree"@en;
            rdfs:subClassOf nyon:CourtDecision;
            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#allValuesFrom> nyon:Civil ; 
                                                             <http://www.w3.org/2002/07/owl#onProperty> nyon:OfDomian ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>].
nyon:Defendant a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "a person sued in the court of law"@en;
               rdfs:label "Defendant"@en;
               rdfs:subClassOf nyon:Party;
               <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RijIqw1HEfQF4ctjWUlgnq"@en.
nyon:Dissent a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "judges who do not agree with the majority of the Court";
             rdfs:label "Dissent"@en;
             rdfs:subClassOf nyon:Opinion.
nyon:District a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "represents district name/location"@en;
              rdfs:label "District"@en;
              rdfs:subClassOf nyon:Location.
nyon:District_Court a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "a term in judicial system in India in which a case is heard and judged by at least 2 judges"@en;
                    rdfs:label "District Court"@en;
                    rdfs:subClassOf nyon:Courts_for_Civil,
                                    nyon:Court.
nyon:Division_Bench a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "a term in judicial system in India in which a case is heard and judged by at least 2 judges"@en;
                    rdfs:label "Division Bench"@en;
                    rdfs:subClassOf nyon:Bench.
nyon:Evidence a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "evidences presented in front of the court in the case"@en;
              rdfs:label "Evidence"@en;
              <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R7c1yU31BO5LWM06a7c0Pfd"@en.
nyon:Fact a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "represents factual statements in the case law"@en;
          rdfs:label "Fact"@en;
          <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RnKWv1E6U2Ssc5SRsG14NO"@en.
nyon:Group a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "party of the case are the group of people on one side against another group of people or individual or state"@en;
           rdfs:label "Group"@en;
           rdfs:subClassOf nyon:Party_Type.
nyon:High_Court a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "court at the state level"@en;
                rdfs:label "High Court"@en;
                rdfs:subClassOf nyon:Court.
nyon:Individual a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "participants of the case are the individual persons"@en;
                rdfs:label "Individual"@en;
                rdfs:subClassOf nyon:Party_Type;
                <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RDCkFrEclhipkoHPgckuFY6"@en.
nyon:Investigator a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A police officer is a warranted law employee of a police force";
                  rdfs:label "PolicePersonnel"@en;
                  <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RDVQLifN70TJSPCRJJLBgPY"@en.
nyon:Issue a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "issues in the case arised by the party"@en;
           rdfs:label "Issue"@en.
nyon:Judge a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "represents the judge of the case"@en;
           rdfs:label "Judge"@en;
           rdfs:subClassOf nyon:Court_Official;
           <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RDnLOdTNWmEc4EhZ0SZXDm7"@en.
nyon:Judgement a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Judgement given by the judge "@en;
               rdfs:label "Judgement"@en;
               rdfs:subClassOf nyon:CourtDecision;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#complementOf> nyon:Opinion ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>];
               <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9jpIjzc10qdgl78jXOZtfm"@en.
<https://w3id.org/def/nyon#Judicial_Magistrate_Court(First_Class)> a <http://www.w3.org/2002/07/owl#Class>;
                                                                   rdfs:comment "second lower court at distrcit level after districit level Session Court for criminal cases"@en;
                                                                   rdfs:label "Judicial Magistrate Court (First Class)"@en;
                                                                   rdfs:subClassOf nyon:Courts_for_Criminal.
<https://w3id.org/def/nyon#Judicial_Magistrate_Court(Second_Class)> a <http://www.w3.org/2002/07/owl#Class>;
                                                                    rdfs:comment "lowest court after Judicial Magistrate Court (First Class) at distrcit level for criminal cases"@en;
                                                                    rdfs:label "Judicial Magistrate Court (Second Class)"@en;
                                                                    rdfs:subClassOf nyon:Courts_for_Criminal.
nyon:Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "the extent to which a court of law can exercise its authority over any cases filed across a region"@en;
                  rdfs:label "Jurisdiction"@en.
nyon:Larger_Bench a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "a term in judicial system in India in which a case is heard and judged by three or five judges"@en;
                  rdfs:label "Larger Bench"@en;
                  rdfs:subClassOf nyon:Bench.
nyon:Lawyer a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Lawyer is a term of reference to the attroneys and advocates collectively in litigation"@en;
            rdfs:label "Lawyer"@en;
            rdfs:subClassOf nyon:Court_Official;
            <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RcTA2iQmrtqOnX3WrjJIp8"@en.
nyon:LearnedCounsel a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Learned counsel is a term of reference to the lawyers and advocates collectively in litigation"@en;
                    rdfs:label "LearnedCounsel"@en;
                    rdfs:subClassOf nyon:Court_Official.
nyon:Location a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "represents the location of the courts, etc and also used for evidence locations"@en;
              rdfs:label "Location"@en;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#complementOf> <https://schema.org/Place> ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>];
              <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9aSzp9cEiBCzObnP92jYFX"@en.
nyon:Majority a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Majority decisions are the ones where a majority of the judges agree";
              rdfs:label "Majority"@en;
              rdfs:subClassOf nyon:Opinion.
nyon:Metropolitan_Magistrate_Courts a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "lowest court after Chief Metropolitan Court at metropolitan level for criminal cases"@en;
                                    rdfs:label "Metropolitan Magistrate Court"@en;
                                    rdfs:subClassOf nyon:Courts_for_Criminal.
nyon:Metropolitian_Courts a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "court for population more than 10 lakh city "@en;
                          rdfs:label "Metropolitan Court"@en;
                          rdfs:subClassOf nyon:Court.
nyon:Munsif_Court a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "lowest court in heirarchy for civil ases at district level after Principal Junior Civil Court"@en;
                  rdfs:label "Munsif Court"@en;
                  rdfs:subClassOf nyon:Courts_for_Civil.
nyon:ObiterDictum a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "additional obersvations, remarks, and opinions made by the judge that are not the part of the reason for the decision"@en;
                  rdfs:label "Obiter Dictum"@en.
nyon:OfDomian a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "specifies the law domain (nyon:CaseDomain) the court case (nyon:CourtCase) belongs to";
              rdfs:domain nyon:CaseType;
              rdfs:label "OfDomain"@en;
              rdfs:range nyon:CaseDomain;
              rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:Opinion a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "judge opinion with respect to case or judgment"@en;
             rdfs:label "Opinion"@en;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#complementOf> nyon:Judgement ; 
                                                              a <http://www.w3.org/2002/07/owl#Class>];
             <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RDNaE3PFsXDfIudTq7w3ace"@en.
nyon:Order a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "order given by the court"@en;
           rdfs:label "Order"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:CaseDomain ; 
                            <http://www.w3.org/2002/07/owl#onProperty> nyon:OfDomian ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           nyon:CourtDecision;
           <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R7ibFsNNncTIYF5AjKUDg7b"@en.
nyon:Original_Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "jurisdiction type is a original jurisdiction"@en;
                           rdfs:label "Original Jurisdiction"@en;
                           rdfs:subClassOf nyon:Jurisdiction.
nyon:Party a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "party or people involved in the case"@en;
           rdfs:label "Party"@en.
nyon:Party_Type a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "represents the types of party involved in the case viz. individual, organization, govt. etc."@en;
                rdfs:label "Party Type"@en.
nyon:Petitioner a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "one who makes the petition"@en;
                rdfs:label "Petitioner"@en;
                rdfs:subClassOf nyon:Party.
nyon:Plaintiff a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "party who brings the suit in the court of law"@en;
               rdfs:label "Plaintiff"@en;
               rdfs:subClassOf nyon:Party;
               <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9tyJmIM3Lx7OItGji5zPXN"@en.
nyon:Precedent a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "all the past cases referred in the current judgment b ythe judge"@en;
               rdfs:label "Precedent"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (nyon:District_Court
                                                                         [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                                         <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:CourtCase ; 
                                                                                                                         <http://www.w3.org/2002/07/owl#onProperty> nyon:hasPrecedent ; 
                                                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:High_Court ; 
                                                                                                                         <http://www.w3.org/2002/07/owl#onProperty> nyon:hasRulingOf ; 
                                                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>])]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
nyon:Principal_Junior_Civil_Court a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "third lower court in hierarchy at district level for civil cases"@en;
                                  rdfs:label "Principal Junior Civil Court"@en;
                                  rdfs:subClassOf nyon:Courts_for_Civil.
nyon:Provision a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "clause or section number or article number applied/used in the case law"@en;
               rdfs:label "Provision"@en.
nyon:RatioDecidendi a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "the rationale for the decision"@en;
                    rdfs:label "RatioDecidendi"@en.
nyon:Respondent a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "party called upon to respond or answer a petition, a cliam or a appeal"@en;
                rdfs:label "Respondent"@en;
                rdfs:subClassOf nyon:Party;
                <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/RDsxHT4FlaoALPmeZmTt8td"@en.
nyon:Review_Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "jurisdiction type is a review jurisdiction"@en;
                         rdfs:label "Review Jurisdiction"@en;
                         rdfs:subClassOf nyon:Jurisdiction.
nyon:Session_Court a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "lower court at both distrcit and metropolitan level after High Courts specific for criminal cases"@en;
                   rdfs:label "Sessions Court"@en;
                   rdfs:subClassOf nyon:Courts_for_Criminal.
nyon:Single_Judge a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "a case heard and judged by a single judge"@en;
                  rdfs:label "Single Judge"@en;
                  rdfs:subClassOf nyon:Bench;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#complementOf> [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                                                                                 <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:Judge ; 
                                                                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> nyon:hasCourtOfficial ; 
                                                                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:Judge ; 
                                                                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> nyon:hasJudge ; 
                                                                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>])] ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>],
                                                                  [<http://www.w3.org/2002/07/owl#complementOf> nyon:Judge ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>],
                                                                  [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                                   <http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> nyon:Judge ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> nyon:hasBench ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                   [<http://www.w3.org/2002/07/owl#onClass> nyon:Judge ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> nyon:hasJudge ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>])].
nyon:Solicitor a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "represents solicitor, learned counsel or laywer of the case"@en;
               rdfs:label "Solicitor"@en;
               rdfs:subClassOf nyon:Court_Official.
nyon:Special_Bench a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "means the Bench constituted by or under the orders of the Chief Justice to hear a case or particular class of cases"@en;
                   rdfs:label "Special Bench"@en;
                   rdfs:subClassOf nyon:Bench.
nyon:State a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "represents state name/location"@en;
           rdfs:label "State"@en;
           rdfs:subClassOf nyon:Party_Type,
                           nyon:Location.
nyon:Statue a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "includes the acts and norms of the law"@en;
            rdfs:label "Statue"@en.
nyon:Sub_Court a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "second lower court in hierarchy at District level for civil cases"@en;
               rdfs:label "Sub Court"@en;
               rdfs:subClassOf nyon:Courts_for_Civil;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#complementOf> nyon:Tribunal ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
nyon:SupremeCourt a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "highest court in the judicial system"@en;
                  rdfs:label "Supreme Court of India"@en;
                  rdfs:subClassOf nyon:Court.
nyon:Taluka a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "represents taluka name/location"@en;
            rdfs:label "Taluka"@en;
            rdfs:subClassOf nyon:Location.
nyon:Tribunal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "institutions established for discharging judicial or quasi-judicial duties under the Government of India"@en;
              rdfs:label "Tribunal"@en;
              rdfs:subClassOf nyon:Court.
nyon:Tribunal_Bench a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Bench deals with tribunals cases"@en;
                    rdfs:label "Tribunal Bench"@en;
                    rdfs:subClassOf nyon:Bench.
nyon:Witness a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "witness involved/presented in the case"@en;
             rdfs:label "Witness"@en;
             <http://www.w3.org/2002/07/owl#sameAs> "http://lmss.sali.org/R9tZFXPrXQJWHbqSgtCQxJF"@en.
nyon:WordAndPhrase a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "words or phrases exctracted from the case to make the search better for the cases or find relevent cases or judgment"@en;
                   rdfs:label "WordsAndPhrases"@en.
nyon:Writ_Jurisdiction a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "jurisdiction type is a writ jurisdiction"@en;
                       rdfs:label "Writ Jurisdiction"@en;
                       rdfs:subClassOf nyon:Jurisdiction.
nyon:appellantArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "specifies the argument made by the appellant (nyon:Appellant) of nyon:CourtCase";
                       rdfs:domain nyon:Argument;
                       rdfs:label "appellantArgument";
                       rdfs:range nyon:Appellant;
                       rdfs:subPropertyOf nyon:makeArgument.
nyon:argumentSequenceNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain nyon:Argument;
                         rdfs:label "argumentSequenceNum"@en;
                         rdfs:range xsd:int;
                         rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:argumentValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain nyon:Argument;
                   rdfs:label "argumentValue"@en;
                   rdfs:range xsd:string;
                   rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:catchwordValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain nyon:CatchWord;
                    rdfs:label "catchwordValue"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:citedBy a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
               <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "specifies the nyon:CourtCase being cited by nyon:CourtCase";
             rdfs:domain nyon:CourtCase;
             rdfs:label "citedBy"@en;
             rdfs:range nyon:CourtCase;
             <http://www.w3.org/2002/07/owl#inverseOf> nyon:cites.
nyon:cites a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
             <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "specifies the nyon:CourtCase is citing another nyon:CourtCase";
           rdfs:domain nyon:CourtCase;
           rdfs:label "cites"@en;
           rdfs:range nyon:CourtCase.
nyon:courtName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain nyon:Court;
               rdfs:label "courtName"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:courtOffName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:label "courtOffName"@en;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:dateOfJudgment a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (nyon:Argument
                                                                          nyon:DateOfJudgment) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:label "dateOfJudgment"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:defendentArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "specifies the argument made by the defendant (nyon:Defendant) of nyon:CourtCase";
                       rdfs:domain nyon:Argument;
                       rdfs:label "defendantArgument";
                       rdfs:range nyon:Defendant;
                       rdfs:subPropertyOf nyon:makeArgument.
nyon:equivalentCitation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "equivalent citations provided by the various law reporters."@en;
                        rdfs:domain nyon:CourtCase;
                        rdfs:range xsd:string;
                        rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>;
                        <http://www.w3.org/2002/07/owl#propertyDisjointWith> nyon:neutralCitations.
nyon:evidenceLocation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain nyon:Evidence;
                      rdfs:label "evidenceLocation"@en;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:factSequenceNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain nyon:Fact;
                     rdfs:label "factSequenceNum"@en;
                     rdfs:range xsd:int;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:factValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain nyon:Fact;
               rdfs:label "factValue"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:finalDecisionValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain nyon:CourtDecision;
                        rdfs:label "finalDecisionValue"@en;
                        rdfs:range xsd:string;
                        rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:firstName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain nyon:Party;
               rdfs:label "firstName"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf nyon:partyName;
               <http://www.w3.org/2002/07/owl#propertyDisjointWith> nyon:lastName.
nyon:hasAuthor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "specifies an author (nyon:Author) (any judge (nyon:Judge) from the bench) of the nyon:CourtCase";
               rdfs:domain nyon:CourtCase;
               rdfs:label "hasAuthor"@en;
               rdfs:range nyon:Author.
nyon:hasBench a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "specifies the bench associated with nyon:Bench of the nyon:CourtCase";
              rdfs:domain nyon:CourtCase;
              rdfs:label "hasBench"@en;
              rdfs:range nyon:Bench;
              rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasCaseID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Case has a unique ID"@en;
               rdfs:domain nyon:CourtCase;
               rdfs:label "caseID";
               rdfs:range xsd:string.
nyon:hasCaseName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "represents the name of a case usually contains the name of both the parties"@en;
                 rdfs:domain nyon:CourtCase;
                 rdfs:label "caseName";
                 rdfs:range xsd:string.
nyon:hasCourtLoc a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "specifies the location of the nyon:Court";
                 rdfs:domain nyon:Court;
                 rdfs:label "hasCourtLoc"@en;
                 rdfs:range nyon:Location;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasCourtOfficial a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "specifies the court official represented with nyon:CourtOfficial connected to the nyon:CourtCase";
                      rdfs:domain nyon:CourtCase;
                      rdfs:label "hasCourtOfficial"@en;
                      rdfs:range nyon:Court_Official;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain nyon:DateOfJudgment;
             rdfs:label "hasDate"@en;
             rdfs:range xsd:int;
             rdfs:subPropertyOf nyon:dateOfJudgment.
nyon:hasDateOfJudgment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "specifies the date of the judgment of the nyon:CourtCase";
                       rdfs:domain nyon:Court;
                       rdfs:label "hasDateOfJudgment"@en;
                       rdfs:range nyon:DateOfJudgment;
                       rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasDesignation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain nyon:Investigator;
                    rdfs:label "hasDesignation"@en;
                    rdfs:range xsd:string.
nyon:hasEvidence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "specifies the evidence associated with the nyon:Evidence instance for the nyon:CourtCase";
                 rdfs:domain nyon:CourtCase;
                 rdfs:label "hasEvidence"@en;
                 rdfs:range nyon:Evidence;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasEvidenceLoc a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "specifies the evidence location associated with the nyon:Evidence instance for the nyon:CourtCase";
                    rdfs:domain nyon:Evidence;
                    rdfs:label "hasEvidenceLoc"@en;
                    rdfs:range nyon:Location;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasFact a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "specifies the fact associated with nyon:Fact belonging to a specific nyon:CourtCase";
             rdfs:domain nyon:CourtCase;
             rdfs:label "hasFact"@en;
             rdfs:range nyon:Fact;
             rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasFinalDecision a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "specifies the final verdict associated with the nyon:CourtCase";
                      rdfs:domain nyon:CourtCase;
                      rdfs:label "hasFinalDecision"@en;
                      rdfs:range nyon:CourtDecision;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasIssue a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "specifies the issue associated with the nyon:Issue instance mentioned in the nyon:CourtCase";
              rdfs:domain nyon:CourtCase;
              rdfs:label "hasIssue"@en;
              rdfs:range nyon:Issue.
nyon:hasJudge a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "specifies the judicial body (nyon:Judge) of nyon:CourtCase"@en;
              rdfs:domain nyon:CourtCase;
              rdfs:label "hasJudge"@en;
              rdfs:range nyon:Judge.
nyon:hasJudgmentType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "specifies the type of judgment (nyon:CaseType) for nyon:CourtCase";
                     rdfs:domain nyon:CourtCase;
                     rdfs:label "hasJudgmentType"@en;
                     rdfs:range nyon:CaseType;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasJurisdiction a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "specifies the jurisdiction (nyon:Jurisdiction) for nyon:Court";
                     rdfs:domain nyon:Court;
                     rdfs:label "hasJurisdiction"@en;
                     rdfs:range nyon:Jurisdiction;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasMonth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain nyon:DateOfJudgment;
              rdfs:label "hasMonth"@en;
              rdfs:range xsd:string;
              rdfs:subPropertyOf nyon:dateOfJudgment.
nyon:hasObiterDictum a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "specifies the obiter dicta associated with nyon:ObiterDictum mentioned in nyon:CourtCase";
                     rdfs:domain nyon:CourtCase;
                     rdfs:label "hasObiterDictum"@en;
                     rdfs:range nyon:ObiterDictum;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasParty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "specifies the party (nyon:Party) associated with nyon:CourtCase";
              rdfs:domain nyon:CourtCase;
              rdfs:label "hasParty"@en;
              rdfs:range nyon:Party;
              rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasPartyType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "specifies the type of party (nyon:PartyType) involved in nyon:CourtCase";
                  rdfs:domain nyon:Party;
                  rdfs:label "hasPartyType"@en;
                  rdfs:range nyon:Party_Type;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasPolicePersonnel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "specifies the police officer (nyon:PolicePersonnel) doing mentioned in nyon:CourtCase";
                        rdfs:domain nyon:CourtCase;
                        rdfs:label "hasPolicePersonnel"@en;
                        rdfs:range nyon:Investigator.
nyon:hasPolicePersonnelName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "represents the name of the police personnel involved in the case"@en;
                            rdfs:domain nyon:Investigator;
                            rdfs:label "hasPolicePersonnelName"@en;
                            rdfs:range xsd:string.
nyon:hasPrecedent a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "specifies the previous cases of type nyon:CourtCase",
                               "represents past cases referred by the judge in the judgment"@en;
                  rdfs:domain nyon:CourtCase;
                  rdfs:range nyon:CourtCase;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasProvision a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "specifies a clause or norm (nyon:Provision) in a legal instrument or a law";
                  rdfs:domain nyon:CourtCase;
                  rdfs:label "hasProvision"@en;
                  rdfs:range nyon:Provision.
nyon:hasRatioDecidendi a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "specifies the judges ratio of decision (nyon:RatioDecidendi) for nyon:CourtCase";
                       rdfs:domain nyon:CourtCase;
                       rdfs:label "hasRatioDecidendi"@en;
                       rdfs:range nyon:RatioDecidendi;
                       rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasRulingOf a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "specifies the ruling (previous judgments nyon:CourtCase) of the lower court (nyon:Court)";
                 rdfs:domain nyon:CourtCase;
                 rdfs:label "hasRulingOf"@en;
                 rdfs:range nyon:Court;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasStatue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "specifies the statute (nyon:Statute) mentioned in nyon:CourtCase";
               rdfs:domain nyon:CourtCase;
               rdfs:label "hasStatue"@en;
               rdfs:range nyon:Statue;
               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasWitness a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "specifies the witness (nyon:Witness) mentioned in nyon:CourtCase";
                rdfs:domain nyon:CourtCase;
                rdfs:label "hasWitness"@en;
                rdfs:range nyon:Witness;
                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasWordPhrase a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "specifies the phrases and words (specially nyon:Issue) mentioned in nyon:CourtCase";
                   rdfs:domain nyon:CourtCase;
                   rdfs:label "hasWordPhrase"@en;
                   rdfs:range nyon:WordAndPhrase;
                   rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:hasWords a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "signifies the domain words, facts and issue related words in the case";
              rdfs:domain nyon:CourtCase;
              rdfs:label "hasWords"@en;
              rdfs:range nyon:CatchWord.
nyon:hasYear a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain nyon:DateOfJudgment;
             rdfs:label "hasYear"@en;
             rdfs:range xsd:int;
             rdfs:subPropertyOf nyon:dateOfJudgment.
nyon:issueSequenceNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain nyon:Issue;
                      rdfs:label "issueSequenceNum"@en;
                      rdfs:range xsd:int;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:issueValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain nyon:Issue;
                rdfs:label "issueValue"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:lastName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain nyon:Party;
              rdfs:label "lastName"@en;
              rdfs:range xsd:string;
              rdfs:subPropertyOf nyon:partyName.
nyon:locationName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain nyon:Location;
                  rdfs:label "locationName"@en;
                  rdfs:range xsd:string;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:makeArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "specifies the arguments done in nyon:CourtCase by some party (nyon:Party)";
                  rdfs:domain nyon:Party;
                  rdfs:label "makeArgument"@en;
                  rdfs:range nyon:Argument;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
nyon:neutralCitations a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "represents neutral citations given by the court itself"@en;
                      rdfs:domain nyon:CourtCase;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:obiterDictumSequenceNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain nyon:ObiterDictum;
                             rdfs:label "obiterDictumSequenceNum"@en;
                             rdfs:range xsd:int;
                             rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:obiterDictumValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain nyon:ObiterDictum;
                       rdfs:label "obiterDictumValue"@en;
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:partyName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:label "partyName"@en;
               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:petitionerArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "specifies the argument made by the Petitioner (nyon:Petitioner) of nyon:CourtCase";
                        rdfs:domain nyon:Argument;
                        rdfs:label "petitionerArgument";
                        rdfs:range nyon:Petitioner;
                        rdfs:subPropertyOf nyon:makeArgument.
nyon:plaintiffArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "specifies the argument made by the plaintiff (nyon:Plaintiff) of nyon:CourtCase";
                       rdfs:domain nyon:Argument;
                       rdfs:label "plaintiffArgument";
                       rdfs:range nyon:Plaintiff;
                       rdfs:subPropertyOf nyon:makeArgument.
nyon:precedentOverruled a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "specifies the past cases (nyon:CourtCase) overruled by the judge in the current case";
                        rdfs:domain nyon:CourtCase;
                        rdfs:label "precedentOverruled"@en;
                        rdfs:range nyon:CourtCase;
                        rdfs:subPropertyOf nyon:hasPrecedent.
nyon:precedentReliedUpon a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "specifies the past cases (nyon:CourtCase) referred by the judge on which the current judgment relies on";
                         rdfs:domain nyon:CourtCase;
                         rdfs:label "precedentReliedUpon"@en;
                         rdfs:range nyon:CourtCase;
                         rdfs:subPropertyOf nyon:hasPrecedent.
nyon:precendentNotReliedUpon a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "specifies the previous cases (nyon:CourtCase) referred by the judge on which the case decision does not rely on";
                             rdfs:domain nyon:CourtCase;
                             rdfs:label "precedentNotReliedUpon"@en;
                             rdfs:range nyon:CourtCase;
                             rdfs:subPropertyOf nyon:hasPrecedent.
nyon:ratioDecidendiSequenceNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:domain nyon:RatioDecidendi;
                               rdfs:label "ratioDecidendiSequenceNum"@en;
                               rdfs:range xsd:int;
                               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:ratioDecidendiValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain nyon:RatioDecidendi;
                         rdfs:label "ratioDecidendiValue"@en;
                         rdfs:range xsd:string;
                         rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:respondentArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "specifies the argument made by the respondent (nyon:Respondent) of nyon:CourtCase";
                        rdfs:domain nyon:Argument;
                        rdfs:label "respondentArgument";
                        rdfs:range nyon:Respondent;
                        rdfs:subPropertyOf nyon:makeArgument.
nyon:value a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain nyon:Opinion;
           rdfs:range xsd:string.
nyon:wFirstName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain nyon:Witness;
                rdfs:label "wFirstName"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf nyon:witnessName;
                <http://www.w3.org/2002/07/owl#propertyDisjointWith> nyon:wLastName.
nyon:wLastName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain nyon:Witness;
               rdfs:label "wLastName"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf nyon:witnessName.
nyon:withConcurrence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "specifies the judge (nyon:Judge) gives the opinion in concurrence (nyon:Concurrence) of the court";
                     rdfs:domain nyon:Judge;
                     rdfs:label "withConcurrence"@en;
                     rdfs:range nyon:Concurrence;
                     rdfs:subPropertyOf nyon:withOpinion.
nyon:withDissent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "specifies the judge (nyon:Judge) gives the opinion in dissent (nyon:Dissent) of the court";
                 rdfs:domain nyon:Judge;
                 rdfs:label "withDissent"@en;
                 rdfs:range nyon:Dissent;
                 rdfs:subPropertyOf nyon:withOpinion.
nyon:withMajority a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "specifies the judge (nyon:Judge) gives the opinion in majority (nyon:Majority) of the court";
                  rdfs:domain nyon:Judge;
                  rdfs:label "withMajority"@en;
                  rdfs:range nyon:Majority;
                  rdfs:subPropertyOf nyon:withOpinion.
nyon:withOpinion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "represnts the judge opinion on the case either with majority, dissent or concurrence"@en;
                 rdfs:domain nyon:Judge;
                 rdfs:label "withOpinion"@en;
                 rdfs:range nyon:Opinion.
nyon:witnessName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:label "witnessName"@en;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:witnessStatement a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain nyon:Witness;
                      rdfs:label "witnessStatement"@en;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:wordPhraseValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain nyon:WordAndPhrase;
                     rdfs:label "wordPhraseValue"@en;
                     rdfs:range xsd:string;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
nyon:worksIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "specifies the judge (nyon:Judge) working in court (nyon:Court)";
             rdfs:domain nyon:Court_Official;
             rdfs:label "worksIn"@en;
             rdfs:range nyon:Court;
             rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
