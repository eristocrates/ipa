ids:authUsername a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Username / ID used for authentication."@en;
                 rdfs:domain ids:UserAuthentication;
                 rdfs:label "auth username"@en;
