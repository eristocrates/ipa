                                                                     rdfs:label "Entry Level Self-Assessment Certification of Participants"@en.
<https://w3id.org/idsa/code/PARTICIPANT_MEMBER_LEVEL_CONTROL_FRAMEWORK> a ids:ParticipantCertificationLevel,
