             rdfs:label "authInfo"@en;
             rdfs:range ids:AuthInfo.
ids:authPassword a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Username / ID used for authentication.";
                 rdfs:domain ids:BasicAuthentication;
                 rdfs:label "auth password";
                 rdfs:range xsd:string.
ids:authService a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain ids:AuthInfo;
                rdfs:range xsd:anyURI.
ids:authStandard a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The standard used by the authentication service that is provided by the Connector."@en;
                 rdfs:domain ids:AuthInfo;
                 rdfs:label "authStandard"@en;
