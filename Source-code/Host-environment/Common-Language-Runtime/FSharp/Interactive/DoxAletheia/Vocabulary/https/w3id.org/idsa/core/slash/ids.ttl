                                                                  <http://purl.org/dc/terms/>,
                                                                  <http://xmlns.com/foaf/0.1/>;
                             a <http://www.w3.org/2002/07/owl#Ontology>;
                             rdfs:comment "This ontology defines classes and properties for describing participants, infrastructure, data and services of the International Data Spaces (formerly known as Industrial Data Space).";
                             rdfs:isDefinedBy ids:;
                             rdfs:label "IDS Information Model"@en;
                             rdfs:seeAlso <https://industrialdataspace.github.io/InformationModel/>;
                             <http://www.w3.org/2002/07/owl#versionInfo> "4.0.0".
ids: <http://purl.org/dc/terms/created> "2017-09-26"^^xsd:date;
     <http://purl.org/dc/terms/modified> "2020-08-10"^^xsd:date;
     <http://purl.org/dc/terms/publisher> ids:IDSA;
     <http://purl.org/dc/terms/title> "The International Data Spaces Information Model"@en;
     a <http://purl.org/vocommons/voaf#Vocabulary>,
       <http://www.w3.org/2002/07/owl#NamedIndividual>.
ids:AbstractConstraint a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf <http://www.w3.org/ns/odrl/2/Constraint>;
                       <https://w3id.org/idsa/metamodel/abstract> true.
ids:AccessTokenRequestMessage a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Message requesting an access token. This is intended for point-to-point communication with, e.g., Brokers."@en;
                              rdfs:label "AccessToken Request Message"@en;
                              rdfs:subClassOf ids:RequestMessage.
ids:AccessTokenResponseMessage a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Response to an access token request, intended for point-to-point communication."@en;
                               rdfs:label "Access Token Response"@en;
                               rdfs:subClassOf ids:ResponseMessage.
ids:Action a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf <http://www.w3.org/ns/odrl/2/Action>;
           <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:actionRefinement ; 
                                                         <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:Agent a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Internal or external Agent interacting with the Industrial Data Space, not necessarily an IDS Participant."@en;
          rdfs:label "Agent"@en;
          rdfs:subClassOf ids:Described,
                          <http://xmlns.com/foaf/0.1/Agent>,
                          <http://www.w3.org/ns/odrl/2/Party>.
ids:AppAvailableMessage a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Message indicating that a specific App should be available (again) in the AppStore."@en;
                        rdfs:label "App Available Message"@en;
                        rdfs:subClassOf ids:AppNotificationMessage.
ids:AppDeleteMessage a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Message indicating that an App should be deleted from the AppStore."@en;
                     rdfs:label "App Delete Message"@en;
                     rdfs:subClassOf ids:AppNotificationMessage.
ids:AppEndpoint a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf ids:Endpoint;
                <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:appEndpointType ; 
                                                              <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:AppEndpointType a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Class of endpoint types a data app offers."@en;
                    rdfs:label "App endpoint type"@en.
ids:AppExecutionResources a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Resource control for deployed services."@en;
                          rdfs:label "App execution resources"@en;
                          rdfs:subClassOf ids:SecurityGuarantee;
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (<https://w3id.org/idsa/code/APP_RESOURCES_LOCAL_ENFORCEMENT>
                                                                                                                  <https://w3id.org/idsa/code/APP_RESOURCES_NONE>
                                                                                                                  <https://w3id.org/idsa/code/APP_RESOURCES_REMOTE_VERIFICATION>) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>].
ids:AppNotificationMessage a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                             <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf ids:ResourceNotificationMessage;
                           <https://w3id.org/idsa/metamodel/abstract> true;
                           <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:affectedDataAppResource ; 
                                                                         <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:AppRegistrationRequestMessage a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Message that asks for registration or update of a data app to the App Store. Payload contains app-related metadata (instance of class ids:AppResource). Message header may contain an app identifier parameter of a prior registered data app. If the app identifier is supplied, the message should be interpreted as a registration for an app update. Otherwise this message is used to register a new app. "@en;
                                  rdfs:label "App Registration Request Message"@en;
                                  rdfs:subClassOf ids:RequestMessage.
ids:AppRegistrationResponseMessage a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Message that follows up an AppRegistrationRequestMessage and contains the app registration confimation."@en;
                                   rdfs:label "App Registration Response Message"@en;
                                   rdfs:subClassOf ids:ResponseMessage.
ids:AppRepresentation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "App representation"@en;
                      rdfs:label "App Representation"@en;
                      rdfs:subClassOf ids:SoftwareRepresentation.
ids:AppResource a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Resource comprising IDS data apps."@en;
                rdfs:label "App Resource"@en;
                rdfs:subClassOf ids:Resource.
ids:AppRoute a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               <http://www.w3.org/2002/07/owl#Class>;
             <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:routeDeployMethod ; 
                                                           <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                          [<https://w3id.org/idsa/metamodel/forProperty> ids:subRoute ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                          [<https://w3id.org/idsa/metamodel/forProperty> ids:appRouteStart ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                          [<https://w3id.org/idsa/metamodel/forProperty> ids:appRouteEnd ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:AppStore a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Secure platform for distributing Data Apps."@en;
             rdfs:label "App Store"@en;
             rdfs:subClassOf ids:Connector.
ids:AppUnavailableMessage a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Message indicating that a specific App should be unavailable in the AppStore."@en;
                          rdfs:label "App Unavailable Message"@en;
                          rdfs:subClassOf ids:AppNotificationMessage.
ids:AppUploadMessage a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:subClassOf ids:UploadMessage;
                     <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:appArtifactReference ; 
                                                                   <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:AppUploadResponseMessage a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Message that follows up an AppUploadMessage and contains the app upload confimation."@en;
                             rdfs:label "App Upload Response Message"@en;
                             rdfs:subClassOf ids:UploadResponseMessage.
ids:Artifact a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Instance of a Representation materialized at a partiuclar version and point in time. Possesses characteristics like file name, size, creation date etc."@en;
             rdfs:label "Artifact"@en;
             rdfs:subClassOf ids:RepresentationInstance;
             <http://www.w3.org/2002/07/owl#disjointWith> ids:Value.
ids:ArtifactRequestMessage a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                             <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf ids:RequestMessage;
                           <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:requestedArtifact ; 
                                                                         <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ArtifactResponseMessage a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Message that follows up a RetrieveArtifact Message and contains the Artifact's data in the payload section."@en;
                            rdfs:label "Artifact Response Message"@en;
                            rdfs:subClassOf ids:ResponseMessage.
ids:ArtifactState a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The state which an ids:Artifact may have or not."@en;
                  rdfs:label "Artifact State"@en.
ids:Asset a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf <http://www.w3.org/ns/odrl/2/Asset>;
          <https://w3id.org/idsa/metamodel/abstract> true.
ids:AssetCollection a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An AssetCollection is a bracket object combining several ids:Assets."@en;
                    rdfs:label "Asset Collection"@en;
                    rdfs:subClassOf ids:Asset,
                                    <http://www.w3.org/ns/odrl/2/AssetCollection>.
ids:Audience a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The class of audiences (recipients) used in the JWT. "@en;
             rdfs:label "Audience"@en;
             rdfs:seeAlso <https://tools.ietf.org/html/rfc7519>.
ids:AudioRepresentation a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Audio representation"@en;
                        rdfs:label "Audio Representation"@en;
                        rdfs:subClassOf ids:Representation.
ids:AudioResource a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Resource (at least partially) comprising audio content."@en;
                  rdfs:label "Audio Resource"@en;
                  rdfs:subClassOf ids:Resource.
ids:AuditGuarantee a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Local audit logging (including integrity protection) is the baseline for auditing and clearing. Remote audit log tracing provides means to do external audit verification."@en;
                   rdfs:label "Audit guarantee"@en;
                   rdfs:subClassOf ids:SecurityGuarantee;
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (<https://w3id.org/idsa/code/AUDIT_LOCAL_LOGGING>
                                                                                                           <https://w3id.org/idsa/code/AUDIT_NONE>
                                                                                                           <https://w3id.org/idsa/code/AUDIT_REMOTE_TRACING>) ; 
                                                                    a <http://www.w3.org/2002/07/owl#Class>].
ids:AuthInfo a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               <http://www.w3.org/2002/07/owl#Class>;
             <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:authService ; 
                                                           <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:AuthStandard a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The class of authentication standards that may be supported by Connectors."@en;
                 rdfs:label "AuthStandard"@en.
ids:AuthenticationGuarantee a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Authentication mechanism applied prior to opening a connection. Examples are the verification server's identity or doing mutual authentication."@en;
                            rdfs:label "Authentication"@en;
                            rdfs:subClassOf ids:SecurityGuarantee;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (<https://w3id.org/idsa/code/AUTHENTICATION_MUTUAL>
                                                                                                                    <https://w3id.org/idsa/code/AUTHENTICATION_NONE>
                                                                                                                    <https://w3id.org/idsa/code/AUTHENTICATION_SERVER_SIDE>) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
ids:BaseConnector a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Implementation of the Connector specification providing only restricted security capabilities."@en;
                  rdfs:label "Base Connector"@en;
                  rdfs:subClassOf ids:Connector.
ids:BasicAuthentication a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Basic authentication using username / password "@en;
                        rdfs:label "User Authentication"@en;
                        rdfs:seeAlso <https://tools.ietf.org/html/rfc7617>;
                        rdfs:subClassOf ids:UserAuthentication.
ids:BinaryOperator a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The class of binary operators."@en;
                   rdfs:label "BinaryOperator"@en;
                   rdfs:subClassOf <http://www.w3.org/ns/odrl/2/Operator>.
ids:BoundingPolygon a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:subClassOf ids:Geometry;
                    <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:geoPoint ; 
                                                                  <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany> ; 
                                                                  <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotEmpty>].
ids:Broker a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf ids:Connector;
           <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:connectorCatalog ; 
                                                         <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:Catalog a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf <http://www.w3.org/ns/dcat#Catalog>;
            <https://w3id.org/idsa/metamodel/abstract> true.
ids:Certification a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                    <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf ids:ManagedEntity;
                  <https://w3id.org/idsa/metamodel/abstract> true.
ids:CertificationLevel a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         <http://www.w3.org/2002/07/owl#Class>;
                       <https://w3id.org/idsa/metamodel/abstract> true.
ids:ClearingHouse a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The Clearing House provides clearing and settlement services B2B interactions within the International Data Spaces."@en;
                  rdfs:label "Clearing House"@en;
                  rdfs:subClassOf ids:InfrastructureComponent.
ids:CommandMessage a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:subClassOf ids:RequestMessage;
                   <https://w3id.org/idsa/metamodel/abstract> true.
ids:ComponentCertification a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Process and result of certifying a software component/servivce in order to become a certified part of the International Data Space infrastructure."@en;
                           rdfs:label "Component Certification"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> ids:ComponentCertificationLevel ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> ids:certificationLevel ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           ids:Certification;
                           <http://www.w3.org/2002/07/owl#disjointWith> ids:ParticipantCertification.
ids:ComponentCertificationLevel a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Level of a Component Certification"@en;
                                rdfs:label "Component Certification Level"@en;
                                rdfs:subClassOf ids:CertificationLevel;
                                <http://www.w3.org/2002/07/owl#disjointWith> ids:ParticipantCertificationLevel.
ids:Concept a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
            <https://w3id.org/idsa/metamodel/abstract> true.
ids:ConfigurationModel a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         <http://www.w3.org/2002/07/owl#Class>;
                       <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:appRoute ; 
                                                                     <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                                    [<https://w3id.org/idsa/metamodel/forProperty> ids:connectorDeployMode ; 
                                                                     <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                                    [<https://w3id.org/idsa/metamodel/forProperty> ids:connectorStatus ; 
                                                                     <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                                    [<https://w3id.org/idsa/metamodel/forProperty> ids:configurationModelLogLevel ; 
                                                                     <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                                    [<https://w3id.org/idsa/metamodel/forProperty> ids:userAuthentication ; 
                                                                     <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                                    [<https://w3id.org/idsa/metamodel/forProperty> ids:connectorProxy ; 
                                                                     <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:Connector a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf ids:InfrastructureComponent;
              <https://w3id.org/idsa/metamodel/abstract> true;
              <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:hasAgent ; 
                                                            <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                           [<https://w3id.org/idsa/metamodel/forProperty> ids:securityProfile ; 
                                                            <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                           [<https://w3id.org/idsa/metamodel/forProperty> ids:resourceCatalog ; 
                                                            <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                           [<https://w3id.org/idsa/metamodel/forProperty> ids:hasEndpoint ; 
                                                            <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                           [<https://w3id.org/idsa/metamodel/forProperty> ids:extendedGuarantee ; 
                                                            <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                           [<https://w3id.org/idsa/metamodel/forProperty> ids:hasDefaultEndpoint ; 
                                                            <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ConnectorCatalog a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:subClassOf ids:Catalog;
                     <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:listedConnector ; 
                                                                   <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:ConnectorCertificateGrantedMessage a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "Whenever a Connector has been successfully certified by the Certification Body, the Identity Provider can use this message to notify Infrastructure Components."@en;
                                       rdfs:label "Connector Certificate Granted Message"@en;
                                       rdfs:subClassOf ids:ConnectorNotificationMessage.
ids:ConnectorCertificateRevokedMessage a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "Indicates that a (previously certified) Connector is no more certified. This could happen, for instance, if the Certification Body revokes a granted certificate or if the certificate just expires."@en;
                                       rdfs:label "Connector Certificate Revoked Message"@en;
                                       rdfs:subClassOf ids:ConnectorNotificationMessage.
ids:ConnectorDeployMode a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Deploy mode of a Connector. Used mainly to capture a Connectors deployment type in the Configuration Model."@en;
                        rdfs:label "Connector Deploy Mode"@en.
ids:ConnectorEndpoint a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf ids:Endpoint;
                      <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:accessUrl ; 
                                                                    <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ConnectorNotificationMessage a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                   <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:subClassOf ids:NotificationMessage;
                                 <https://w3id.org/idsa/metamodel/abstract> true;
                                 <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:affectedConnector ; 
                                                                               <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ConnectorStatus a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Connector Status is used to represent a Connectors current state inside the Configuration Model."@en;
                    rdfs:label "Connector Status"@en.
ids:ConnectorUnavailableMessage a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Event notifying the recipient(s) that a connector will be unavailable. The same connector may be available again in the future."@en;
                                rdfs:label "Connector Unavailable Message"@en;
                                rdfs:subClassOf ids:ConnectorNotificationMessage.
ids:ConnectorUpdateMessage a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Event notifying the recipient(s) about the availability and current configuration of a connector. The payload of the message must contain the updated connector's self-description."@en;
                           rdfs:label "Connector Update Message"@en;
                           rdfs:subClassOf ids:ConnectorNotificationMessage.
ids:ConnectorbasedAgreement a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The ContractAgreement class representing the 'Connector-restricted Data Usage' policy class."@en;
                            rdfs:label "Connector-restricted Data Usage Agreement"@en;
                            rdfs:subClassOf ids:ContractAgreement.
ids:ConnectorbasedOffer a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The ContractOffer class representing the 'Connector-restricted Data Usage' policy class."@en;
                        rdfs:label "Connector-restricted Data Usage Offer"@en;
                        rdfs:subClassOf ids:ContractOffer.
ids:ConnectorbasedRequest a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The ContractRequest class representing the 'Connector-restricted Data Usage' policy class."@en;
                          rdfs:label "Connector-restricted Data Usage Request"@en;
                          rdfs:subClassOf ids:ContractRequest.
ids:Constraint a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf ids:AbstractConstraint;
               <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:leftOperand ; 
                                                             <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                            [<https://w3id.org/idsa/metamodel/forProperty> ids:operator ; 
                                                             <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ContentType a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf <http://purl.org/dc/terms/DCMIType>;
                <https://w3id.org/idsa/metamodel/usage> "Instances of Content Type are used to more precisely specify the type, genre or interpretation of a Digital Content."@en.
ids:Contract a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf <http://www.w3.org/ns/odrl/2/Policy>;
             <https://w3id.org/idsa/metamodel/abstract> true;
             <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:permission ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                          [<https://w3id.org/idsa/metamodel/forProperty> ids:prohibition ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                          [<https://w3id.org/idsa/metamodel/forProperty> ids:obligation ; 
                                                           <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>].
ids:ContractAgreement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf ids:Contract,
                                      <http://www.w3.org/ns/odrl/2/Agreement>;
                      <http://www.w3.org/2002/07/owl#disjointWith> ids:ContractRequest,
                                                                   ids:ContractOffer;
                      <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:contractStart ; 
                                                                    <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:ContractAgreementMessage a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Message containing a contract, as an instance of ids:ContractAgreement, with resource access modalities on which two parties have agreed in the payload."@en;
                             rdfs:label "Contract Agreement Message"@en;
                             rdfs:subClassOf ids:ResponseMessage.
ids:ContractOffer a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Contract issued by the Data Provider offering the usage of a Resource at particular conditions."@en;
                  rdfs:label "Contract offer"@en;
                  rdfs:subClassOf ids:Contract,
                                  <http://www.w3.org/ns/odrl/2/Offer>;
                  <http://www.w3.org/2002/07/owl#disjointWith> ids:ContractRequest.
ids:ContractOfferMessage a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Message containing a offered content contract (as offered by a data provider to the data consumer) in the associated payload (which is an instance of ContractOffer). In contrast to the ids:ContractResponseMessage, the ids:ContractOfferMessage is not related to a previous contract "@en;
                         rdfs:label "Contract Offer Message"@en;
                         rdfs:subClassOf ids:NotificationMessage.
ids:ContractRejectionMessage a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Message indicating rejection of a contract."@en;
                             rdfs:label "Contract Rejection Message"@en;
                             rdfs:subClassOf ids:RejectionMessage.
ids:ContractRequest a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Contract issued by the Data Consumer requesting the usage of a Resource at particular conditions."@en;
                    rdfs:label "Contract request"@en;
                    rdfs:subClassOf ids:Contract,
                                    <http://www.w3.org/ns/odrl/2/Request>.
ids:ContractRequestMessage a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Message containing a suggested content contract (as offered by the data consumer to the data provider) in the associated payload (which is an instance of ContractRequest)."@en;
                           rdfs:label "Contract Request Message"@en;
                           rdfs:subClassOf ids:RequestMessage.
ids:ContractResponseMessage a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Message containing a response to a contract request (of a data consumer) in form of a counter-proposal of a contract in the associated payload (which is an instance of ContractOffcer). "@en;
                            rdfs:label "Contract Response Message"@en;
                            rdfs:subClassOf ids:ResponseMessage.
ids:ContractSupplementMessage a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Message containing supplemental information to access resources of a contract (e.g. resource access tokens)."@en;
                              rdfs:label "Contract Supplement Message"@en;
                              rdfs:subClassOf ids:NotificationMessage.
ids:CustomMediaType a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A selection of custom media types to be used for data published on the IDS when no IANA type is available."@en;
                    rdfs:label "Custom Media Type"@en;
                    rdfs:subClassOf ids:MediaType.
ids:DAPS a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "The Dynamic Attribute Provisioning Service (DAPS) is a component of the Identity Provider and manages and issues the Dynamic Attribute Tokens (DAT), acting as digtial proofs for dynamic attributes of both connectors and participants."@en;
         rdfs:label "Dynamic Attribute Provisioning Service"@en;
         rdfs:subClassOf ids:InfrastructureComponent.
ids:DatPayload a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf ids:JwtPayload;
               <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:extendedGuarantee ; 
                                                             <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany>],
                                                            [<https://w3id.org/idsa/metamodel/forProperty> ids:referringConnector ; 
                                                             <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>],
                                                            [<https://w3id.org/idsa/metamodel/forProperty> ids:iss ; 
                                                             <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotNull>].
ids:DatRequestPayload a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment """The Dynamic Attribute Token (DAT) *Request* Payload is the JSON Element of any DAT containing the claims of the token bearer. This payload itself is a JSON-LD encoded RDF class with a defined set of attributes. These attributes are either defined by RFC 7519 or by the IDS Information Model. As a direct consequence of regarding the DAT Payload as JSON-LD, *all* DAT Payloads must have exactly one \"@context\" attribute with the IDS context URI as its value and a \"@type\" with ids:DatPayload as its value. Note that, different to the DatPayload, the DatRequestPayload contains the *self-claims* of a connector and is not yet signed by any DAPS. Consequently, no other connector must accept a DatRequest object as a DAT. A DatRequest and its contained DatRequestPayload is *only* intended for interactions with a DAPS and *nothing else*!"""@en;
                      rdfs:label "DAT Request Payload"@en;
                      rdfs:seeAlso <https://tools.ietf.org/html/rfc7519>;
                      rdfs:subClassOf ids:JwtPayload.
ids:DataApp a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              <http://www.w3.org/2002/07/owl#Class>;
            <https://w3id.org/idsa/metamodel/abstract> true;
            <https://w3id.org/idsa/metamodel/validation> [<https://w3id.org/idsa/metamodel/forProperty> ids:appEndpoint ; 
                                                          <https://w3id.org/idsa/metamodel/relationType> <https://w3id.org/idsa/metamodel/OneToMany> ; 
                                                          <https://w3id.org/idsa/metamodel/constraint> <https://w3id.org/idsa/metamodel/NotEmpty>].
ids:DataRepresentation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Physical representation of (structured) data."@en;
                       rdfs:label "Data representation"@en;
                       rdfs:subClassOf ids:Representation.
ids:DataResource a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Resource (at least partially) comprising data content."@en;
                 rdfs:label "Data Resource"@en;
