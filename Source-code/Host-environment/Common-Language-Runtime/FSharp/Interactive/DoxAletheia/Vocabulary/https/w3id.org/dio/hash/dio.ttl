@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix dio: <https://w3id.org/dio#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:language a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:description a owl:DatatypeProperty.
rdf:PlainLiteral a rdfs:Datatype.
xsd:dateTime a rdfs:Datatype.
xsd:string a rdfs:Datatype.
owl:topObjectProperty a owl:ObjectProperty.
owl:versionInfo a owl:AnnotationProperty.
nsprov:generatedAtTime a owl:DatatypeProperty.
nsprov:wasAttributedTo a owl:ObjectProperty.
dio: dc11:creator "Monika Solanki (monika.solanki@cs.ox.ac.uk)"@en;
     dc11:date "04-01-2016";
     dc11:description <http://aligned.cs.ox.ac.uk/images/dio.jpg>,
                      """The scope of the DIO ODP is the domain of design intent or design rationale that needs to be documented while undertaking the design of any artifact.

To capture provenance, DIO exploits PROV-O. However DIO uses a modualrised version of PROV-O, based on Syntactic locality.""";
     dc11:title "The Design Intent Ontology - A content ontology design pattern";
     a owl:Ontology;
     owl:imports <http://protege.stanford.edu/plugins/owl/dc/protege-dc.owl>,
                 <http://aligned.cs.ox.ac.uk/ontologies/prov_dio.owl>;
     owl:versionInfo 1.1.
dio:Active a dio:Status,
             owl:NamedIndividual.
dio:AlternativeSolution dc11:description "An entity representing the proposed solution.";
                        a owl:Class;
                        rdfs:label "Alternative Solution";
                        rdfs:subClassOf dio:Solution.
dio:Argument dc11:description "A reason presented against a proposed solution.";
             a owl:Class;
             rdfs:label "Argument";
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Assumption dc11:description "The assumption on which a proposed solution is based.";
               a owl:Class;
               rdfs:label "Assumption";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Comment dc11:description "A comment made by an agent in response to an argument, a justification or another comment";
            a owl:Class;
            rdfs:label "Comment";
            rdfs:subClassOf dio:DesignIntentArtifact.
dio:Constraint dc11:description "A constraint that underlies the proposed solution.";
               a owl:Class;
               rdfs:label "Constraint";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Design dc11:description "A design is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of  components, satisfying a set of requirements, subject to constraints.";
           a owl:Class;
           rdfs:label "Design".
dio:DesignDecision dc11:description "The final design decision made based on the various alternative solutions proposed. A design decision is driven by a mandated solution.";
                   a owl:Class;
                   rdfs:label "Design Decision".
dio:DesignGoal dc11:description "An entity representing the problem, goal, question or issue the design intent aims to address.";
               a owl:Class;
               rdfs:label "Design Goal";
               rdfs:subClassOf [owl:intersectionOf (dio:DesignIntentArtifact
                                                    [owl:allValuesFrom dio:AlternativeSolution ; 
                                                    owl:onProperty dio:hasAlternativeSolution ; 
                                                    a owl:Restriction]
                                                    [owl:allValuesFrom dio:MandatedSolution ; 
                                                    owl:onProperty dio:hasMandatedSolution ; 
                                                    a owl:Restriction]
                                                    [owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onClass dio:MandatedSolution ; 
                                                    owl:onProperty dio:hasMandatedSolution ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class];
               owl:equivalentClass dio:DesignIssue.
dio:DesignIntent dc11:description "A entity defining the notion of a design intent, i.e., the rationale underpinning the choices that are made from the alternatives available during various phases of the overall design lifecycle.";
                 a owl:Class;
                 rdfs:label "Design Intent";
                 rdfs:subClassOf dio:DesignIntentArtifact.
dio:DesignIntentArtifact dc11:description "An entity representing any artifact that plays a part in capturing the design intent. The minimum ontological commitment required for this entity is a brief description of the artifact, the version info and the date.";
                         a owl:Class;
                         rdfs:label "Design Intent Artifact";
                         rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onClass nsprov:Agent ; 
                                                              owl:onProperty nsprov:wasAttributedTo ; 
                                                              a owl:Restriction]
                                                              [owl:onDataRange xsd:string ; 
                                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty dcterms:description ; 
                                                              a owl:Restriction]
                                                              [owl:onDataRange xsd:dateTime ; 
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty nsprov:generatedAtTime ; 
                                                              a owl:Restriction]
                                                              [owl:onDataRange xsd:string ; 
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty dio:version ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
dio:DesignIssue dc11:description "An entity representing the problem, goal, question or issue the design intent aims to address.";
                a owl:Class;
                rdfs:label "Design Issue";
                rdfs:subClassOf dio:DesignIntentArtifact.
dio:DesignRequirement dc11:description "An entity capturing the requirements that result in the design intent";
                      a owl:Class;
                      rdfs:label "Design Requirements";
                      rdfs:subClassOf dio:DesignIntentArtifact.
dio:Evaluation dc11:description "An entity representing the evaluation that supports the solution.";
               a owl:Class;
               rdfs:label "Evaluation";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Evidence dc11:description "An entity representing an evidence that supports a proposed solution.",
                              "Evidence";
             a owl:Class;
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Heuristic dc11:description "An entity representing the requirements to be fulfilled for realising the solution";
              a owl:Class;
              rdfs:label "Heuristic";
              rdfs:subClassOf dio:DesignIntentArtifact.
dio:Justification a owl:Class;
                  rdfs:label "A reason supporting the proposed solution.",
                             "Justification";
                  rdfs:subClassOf dio:DesignIntentArtifact.
dio:MandatedSolution dc11:description "An entity representing the solution accepted as a result of the design deliberation process.";
                     a owl:Class;
                     rdfs:label "Mandated Solution";
                     rdfs:subClassOf dio:Solution.
dio:OnHold a dio:Status,
             owl:NamedIndividual.
dio:RationaleCaptureMethod dc11:description "An entity representing the methodology used to capture the design intent artifact";
                           a owl:Class;
                           rdfs:label "Rationale Capture Methodology".
dio:Resolved a dio:Status,
               owl:NamedIndividual.
dio:Solution a owl:Class;
             rdfs:label "Solution";
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Status dc11:description "An entity representing the status of a design issue.";
           a owl:Class;
           rdfs:label "Status".
dio:Terminated a dio:Status,
                 owl:NamedIndividual.
dio:addressedBy a owl:ObjectProperty;
                rdfs:label "addressedBy".
dio:captureMethodology a owl:ObjectProperty;
                       rdfs:label "captureMethodology".
dio:contradicts a owl:ObjectProperty;
                rdfs:domain dio:Solution;
                rdfs:label "contradicts";
                rdfs:range dio:Solution.
dio:fulfillsRequirement a owl:ObjectProperty;
                        rdfs:domain dio:DesignIntentArtifact,
                                    dio:Design;
                        rdfs:label "fullfillsRequirements";
                        rdfs:range dio:DesignRequirement;
                        owl:inverseOf dio:requirementFulfilledBy.
dio:governsDesign a owl:ObjectProperty;
                  rdfs:domain dio:DesignDecision;
                  rdfs:label "governsDesign";
                  rdfs:range dio:Design.
dio:hasAlternativeSolution a owl:ObjectProperty;
                           rdfs:label "hasAlternativeSolution";
                           rdfs:range dio:AlternativeSolution;
                           rdfs:subPropertyOf owl:topObjectProperty.
dio:hasArgument a owl:ObjectProperty;
                rdfs:label "hasArgument";
                rdfs:range dio:Argument.
dio:hasComment a owl:ObjectProperty;
               rdfs:label "hasComment".
dio:hasConstraint a owl:ObjectProperty;
                  rdfs:domain dio:Solution;
                  rdfs:label "hasConstraint";
                  rdfs:range dio:Constraint.
dio:hasEvidence a owl:ObjectProperty;
                rdfs:domain dio:Justification,
                            dio:Argument;
                rdfs:label "hasEvidence";
                rdfs:range dio:Evidence.
dio:hasJustification a owl:ObjectProperty;
                     rdfs:label "hasJustification";
                     rdfs:range dio:Justification.
dio:hasMandatedSolution a owl:ObjectProperty;
                        rdfs:label "hasMandatedSolution";
                        rdfs:range dio:MandatedSolution;
                        rdfs:subPropertyOf owl:topObjectProperty.
dio:hasStatus a owl:ObjectProperty;
              rdfs:domain dio:DesignIssue;
              rdfs:label "hasStatus";
              rdfs:range dio:Status.
dio:intentAddresses a owl:ObjectProperty;
                    rdfs:domain dio:DesignIntent;
                    rdfs:label "intentAddresses";
                    rdfs:range dio:DesignGoal.
dio:leadsTo a owl:ObjectProperty;
            rdfs:domain dio:MandatedSolution;
            rdfs:label "leadsTo";
            rdfs:range dio:DesignDecision;
            rdfs:subPropertyOf owl:topObjectProperty.
dio:providesAlternativeSolution a owl:ObjectProperty;
                                rdfs:label "providesAlternativeSolution";
                                owl:inverseOf dio:hasAlternativeSolution.
dio:providesMandatedSolution a owl:ObjectProperty;
                             rdfs:label "providesMandatedSolution";
                             owl:inverseOf dio:hasMandatedSolution.
dio:rationaleCapturedUsing a owl:ObjectProperty;
                           rdfs:label "rationaleCapturedUsing".
dio:refines a owl:ObjectProperty;
            rdfs:domain dio:Solution;
            rdfs:label "refines";
            rdfs:range dio:Solution.
dio:requirementFulfilledBy a owl:ObjectProperty;
                           rdfs:label "requirementFulfilledBy".
dio:supports a owl:ObjectProperty;
             rdfs:label "supports";
             rdfs:range dio:Justification.
dio:usesAssumption a owl:ObjectProperty;
                   rdfs:domain dio:Solution;
                   rdfs:label "usesAssumption";
                   rdfs:range dio:Assumption.
dio:usesHeuristic a owl:ObjectProperty;
                  rdfs:domain dio:Solution;
                  rdfs:label "usesHeuristic";
                  rdfs:range dio:Heuristic.
dio:version a owl:FunctionalProperty,
              owl:DatatypeProperty.
