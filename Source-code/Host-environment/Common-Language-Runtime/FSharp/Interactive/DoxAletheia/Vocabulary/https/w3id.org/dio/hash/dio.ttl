@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dio: <https://w3id.org/dio#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/language> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
rdf:PlainLiteral a rdfs:Datatype.
xsd:dateTime a rdfs:Datatype.
xsd:string a rdfs:Datatype.
<http://www.w3.org/2002/07/owl#topObjectProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/prov#generatedAtTime> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://www.w3.org/ns/prov#wasAttributedTo> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
dio: <http://purl.org/dc/elements/1.1/creator> "Monika Solanki (monika.solanki@cs.ox.ac.uk)"@en;
     <http://purl.org/dc/elements/1.1/date> "04-01-2016";
     <http://purl.org/dc/elements/1.1/description> <http://aligned.cs.ox.ac.uk/images/dio.jpg>,
                                                   """The scope of the DIO ODP is the domain of design intent or design rationale that needs to be documented while undertaking the design of any artifact.

To capture provenance, DIO exploits PROV-O. However DIO uses a modualrised version of PROV-O, based on Syntactic locality.""";
     <http://purl.org/dc/elements/1.1/title> "The Design Intent Ontology - A content ontology design pattern";
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#imports> <http://protege.stanford.edu/plugins/owl/dc/protege-dc.owl>,
                                             <http://aligned.cs.ox.ac.uk/ontologies/prov_dio.owl>;
     <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
dio:Active a dio:Status,
             <http://www.w3.org/2002/07/owl#NamedIndividual>.
dio:AlternativeSolution <http://purl.org/dc/elements/1.1/description> "An entity representing the proposed solution.";
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "Alternative Solution";
                        rdfs:subClassOf dio:Solution.
dio:Argument <http://purl.org/dc/elements/1.1/description> "A reason presented against a proposed solution.";
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Argument";
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Assumption <http://purl.org/dc/elements/1.1/description> "The assumption on which a proposed solution is based.";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Assumption";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Comment <http://purl.org/dc/elements/1.1/description> "A comment made by an agent in response to an argument, a justification or another comment";
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Comment";
            rdfs:subClassOf dio:DesignIntentArtifact.
dio:Constraint <http://purl.org/dc/elements/1.1/description> "A constraint that underlies the proposed solution.";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Constraint";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Design <http://purl.org/dc/elements/1.1/description> "A design is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of  components, satisfying a set of requirements, subject to constraints.";
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Design".
dio:DesignDecision <http://purl.org/dc/elements/1.1/description> "The final design decision made based on the various alternative solutions proposed. A design decision is driven by a mandated solution.";
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Design Decision".
dio:DesignGoal <http://purl.org/dc/elements/1.1/description> "An entity representing the problem, goal, question or issue the design intent aims to address.";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Design Goal";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (dio:DesignIntentArtifact
                                                                                [<http://www.w3.org/2002/07/owl#allValuesFrom> dio:AlternativeSolution ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> dio:hasAlternativeSolution ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#allValuesFrom> dio:MandatedSolution ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> dio:hasMandatedSolution ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                <http://www.w3.org/2002/07/owl#onClass> dio:MandatedSolution ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> dio:hasMandatedSolution ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
               <http://www.w3.org/2002/07/owl#equivalentClass> dio:DesignIssue.
dio:DesignIntent <http://purl.org/dc/elements/1.1/description> "A entity defining the notion of a design intent, i.e., the rationale underpinning the choices that are made from the alternatives available during various phases of the overall design lifecycle.";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Design Intent";
                 rdfs:subClassOf dio:DesignIntentArtifact.
dio:DesignIntentArtifact <http://purl.org/dc/elements/1.1/description> "An entity representing any artifact that plays a part in capturing the design intent. The minimum ontological commitment required for this entity is a brief description of the artifact, the version info and the date.";
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Design Intent Artifact";
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                          <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/prov#Agent> ; 
                                                                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAttributedTo> ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                          [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                                                          <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                          <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                          [<http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                                                                          <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#generatedAtTime> ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                          [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                                                          <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                          <http://www.w3.org/2002/07/owl#onProperty> dio:version ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>].
dio:DesignIssue <http://purl.org/dc/elements/1.1/description> "An entity representing the problem, goal, question or issue the design intent aims to address.";
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Design Issue";
                rdfs:subClassOf dio:DesignIntentArtifact.
dio:DesignRequirement <http://purl.org/dc/elements/1.1/description> "An entity capturing the requirements that result in the design intent";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "Design Requirements";
                      rdfs:subClassOf dio:DesignIntentArtifact.
dio:Evaluation <http://purl.org/dc/elements/1.1/description> "An entity representing the evaluation that supports the solution.";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Evaluation";
               rdfs:subClassOf dio:DesignIntentArtifact.
dio:Evidence <http://purl.org/dc/elements/1.1/description> "An entity representing an evidence that supports a proposed solution.",
                                                           "Evidence";
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Heuristic <http://purl.org/dc/elements/1.1/description> "An entity representing the requirements to be fulfilled for realising the solution";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Heuristic";
              rdfs:subClassOf dio:DesignIntentArtifact.
dio:Justification a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "A reason supporting the proposed solution.",
                             "Justification";
                  rdfs:subClassOf dio:DesignIntentArtifact.
dio:MandatedSolution <http://purl.org/dc/elements/1.1/description> "An entity representing the solution accepted as a result of the design deliberation process.";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Mandated Solution";
                     rdfs:subClassOf dio:Solution.
dio:OnHold a dio:Status,
             <http://www.w3.org/2002/07/owl#NamedIndividual>.
dio:RationaleCaptureMethod <http://purl.org/dc/elements/1.1/description> "An entity representing the methodology used to capture the design intent artifact";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "Rationale Capture Methodology".
dio:Resolved a dio:Status,
               <http://www.w3.org/2002/07/owl#NamedIndividual>.
dio:Solution a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Solution";
             rdfs:subClassOf dio:DesignIntentArtifact.
dio:Status <http://purl.org/dc/elements/1.1/description> "An entity representing the status of a design issue.";
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Status".
dio:Terminated a dio:Status,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>.
dio:addressedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "addressedBy".
dio:captureMethodology a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:label "captureMethodology".
dio:contradicts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain dio:Solution;
                rdfs:label "contradicts";
                rdfs:range dio:Solution.
dio:fulfillsRequirement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain dio:DesignIntentArtifact,
                                    dio:Design;
                        rdfs:label "fullfillsRequirements";
                        rdfs:range dio:DesignRequirement;
                        <http://www.w3.org/2002/07/owl#inverseOf> dio:requirementFulfilledBy.
dio:governsDesign a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain dio:DesignDecision;
                  rdfs:label "governsDesign";
                  rdfs:range dio:Design.
dio:hasAlternativeSolution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "hasAlternativeSolution";
                           rdfs:range dio:AlternativeSolution;
                           rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
dio:hasArgument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:label "hasArgument";
                rdfs:range dio:Argument.
dio:hasComment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "hasComment".
dio:hasConstraint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain dio:Solution;
                  rdfs:label "hasConstraint";
                  rdfs:range dio:Constraint.
dio:hasEvidence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain dio:Justification,
                            dio:Argument;
                rdfs:label "hasEvidence";
                rdfs:range dio:Evidence.
dio:hasJustification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:label "hasJustification";
                     rdfs:range dio:Justification.
dio:hasMandatedSolution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:label "hasMandatedSolution";
                        rdfs:range dio:MandatedSolution;
                        rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
dio:hasStatus a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain dio:DesignIssue;
              rdfs:label "hasStatus";
              rdfs:range dio:Status.
dio:intentAddresses a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain dio:DesignIntent;
                    rdfs:label "intentAddresses";
                    rdfs:range dio:DesignGoal.
dio:leadsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain dio:MandatedSolution;
            rdfs:label "leadsTo";
            rdfs:range dio:DesignDecision;
            rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
dio:providesAlternativeSolution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:label "providesAlternativeSolution";
                                <http://www.w3.org/2002/07/owl#inverseOf> dio:hasAlternativeSolution.
dio:providesMandatedSolution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:label "providesMandatedSolution";
                             <http://www.w3.org/2002/07/owl#inverseOf> dio:hasMandatedSolution.
dio:rationaleCapturedUsing a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "rationaleCapturedUsing".
dio:refines a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain dio:Solution;
            rdfs:label "refines";
            rdfs:range dio:Solution.
dio:requirementFulfilledBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "requirementFulfilledBy".
dio:supports a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:label "supports";
             rdfs:range dio:Justification.
dio:usesAssumption a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain dio:Solution;
                   rdfs:label "usesAssumption";
                   rdfs:range dio:Assumption.
dio:usesHeuristic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain dio:Solution;
                  rdfs:label "usesHeuristic";
                  rdfs:range dio:Heuristic.
dio:version a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>.
