@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix amv: <https://w3id.org/amv#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/LicenseDocument> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A legal document giving official permission to do something with a Resource."@en;
                                           rdfs:label "LicenseDocument";
                                           rdfs:subClassOf <http://purl.org/dc/terms/RightsStatement>.
<http://purl.org/dc/terms/RightsStatement> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A statement about the intellectual property rights (IPR) held in or over a Resource, a legal document giving official permission to do something with a resource, or a statement about access rights."@en;
                                           rdfs:label "Rights Statement".
<http://purl.org/dc/terms/accessRights> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment """Information about who access the resource or an indication of its security status. 
Access Rights may include information regarding access or restrictions based on privacy, security, or other policies. 

Examples of access rights are: Public, Internal, Department (source: https://www.dublincore.org/groups/government/accessRights/)"""@en;
                                        rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                        rdfs:label "access rights"@en;
                                        rdfs:range <http://purl.org/dc/terms/RightsStatement>;
                                        rdfs:subPropertyOf <http://purl.org/dc/terms/rights>;
                                        <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_accessRightsOf.
<http://purl.org/dc/terms/available> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                     rdfs:comment "Date (often a range) that the resource became or will become available."@en;
                                     rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                     rdfs:label "available"@en;
                                     rdfs:range rdfs:Literal;
                                     rdfs:subPropertyOf <http://purl.org/dc/terms/date>.
<http://purl.org/dc/terms/bibliographicCitation> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                 rdfs:comment "A bibliographic reference for the resource."@en;
                                                 rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                                 rdfs:label "bibliographic citation"@en;
                                                 rdfs:range rdfs:Literal.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "An agent who contributes towards the algorithm."@en;
                                       rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                       rdfs:label "contributor";
                                       rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
                                       <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_contributorOf.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:comment "The date of creation of the algorithm."@en;
                                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:label "created";
                                   rdfs:range rdfs:Literal;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/date>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "The person who created the algorithm."@en;
                                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:label "creator";
                                   rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
                                   <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_creatorOf;
                                   <http://www.w3.org/2004/02/skos/core#AltLabel> "author"@en.
<http://purl.org/dc/terms/date> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en;
                                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                rdfs:label "date";
                                rdfs:range rdfs:Literal;
                                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
<http://purl.org/dc/terms/dateSubmitted> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                         rdfs:comment "Date of submission of the resource."@en;
                                         rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                         rdfs:label "dateSubmitted";
                                         rdfs:range rdfs:Literal;
                                         rdfs:subPropertyOf <http://purl.org/dc/terms/date>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:comment "An account of the resource."@en,
                                                    "A statement that represents something in words. It is the act of describing something. The description can include, for instance, the purpose of a thing, the scope, the area of applications of a thing, the history, etc."@en;
                                       rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                       rdfs:label "description";
                                       rdfs:range xsd:string.
<http://purl.org/dc/terms/hasPart> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                     <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "A related resource that is included either physically or logically in the described resource.(https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/isPartOf)";
                                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:label "has Part";
                                   rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/relation>;
                                   <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/dc/terms/isPartOf>.
<http://purl.org/dc/terms/hasVersion> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                        <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "A related resource (e.g., algorithm, program) that is a version, edition, or adaptation of the described resource."@en;
                                      rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                      rdfs:label "has Version";
                                      rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                      rdfs:subPropertyOf <http://purl.org/dc/terms/relation>;
                                      <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/dc/terms/isVersionOf>.
<http://purl.org/dc/terms/identifier> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:comment "An unambiguous reference to the resource within a given context."@en;
                                      rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                      rdfs:label "identifier";
                                      rdfs:range rdfs:Literal.
<http://purl.org/dc/terms/isPartOf> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "A related resource in which the described resource is physically or logically included.(https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#http://purl.org/dc/terms/isPartOf)";
                                    rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                    rdfs:label "is Part Of";
                                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                    rdfs:subPropertyOf <http://purl.org/dc/terms/relation>.
<http://purl.org/dc/terms/isVersionOf> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "A related resource (e.g., algorithm, program) of which the described resource is a version, edition, or adaptation."@en;
                                       rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                       rdfs:label "is Version Of";
                                       rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                       rdfs:subPropertyOf <http://purl.org/dc/terms/relation>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "The licence under which the algorithm is published."@en;
                                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:label "license";
                                   rdfs:range <http://purl.org/dc/terms/LicenseDocument>;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/rights>;
                                   <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_licenseOf.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                    rdfs:comment "Date on which the resource was changed."@en;
                                    rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                    rdfs:label "modified";
                                    rdfs:range rdfs:Literal;
                                    rdfs:subPropertyOf <http://purl.org/dc/terms/date>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "An entity responsible for making the resource available."@en;
                                     rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.wikidata.org/entity/Q8366>
                                                                                           amv:Implementation
                                                                                           amv:pub_InformationResource) ; 
                                                  a <http://www.w3.org/2002/07/owl#Class>];
                                     rdfs:label "publisher"@en;
                                     rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
                                     <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_publisherOf.
<http://purl.org/dc/terms/relation> a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment """A related resource. 
For example, a Sorting problem is related to a problem Convex Hull."""@en;
                                    rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                    rdfs:label "relation"@en;
                                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>.
<http://purl.org/dc/terms/rights> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Information about rights held in and over the resource."@en;
                                  rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                  rdfs:label "rights"@en;
                                  rdfs:range <http://purl.org/dc/terms/RightsStatement>;
                                  <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_rightsOf.
<http://purl.org/dc/terms/subject> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "A topic of the resource."@en;
                                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                   rdfs:label "subject";
                                   rdfs:range amv:pub_Discipline;
                                   rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                                   <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_subjectOf.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "A name given to the resource (e.g., book, algorithm, research software)."@en;
                                 rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                 rdfs:label "title";
                                 rdfs:range xsd:string.
<http://purl.org/ontology/bibo/AcademicArticle> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "A scholarly academic article, typically published in a journal."@en;
                                                rdfs:label "Academic article"@en;
                                                rdfs:subClassOf <http://purl.org/ontology/bibo/Article>.
<http://purl.org/ontology/bibo/Article> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A written composition in prose, usually nonfiction, on a specific topic, forming an independent part of a book or other publication, as a newspaper or magazine."@en;
                                        rdfs:label "Article"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Book> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "A written or printed work of fiction or nonfiction, usually on sheets of paper fastened or bound together within covers."@en;
                                     rdfs:label "Book"@en;
                                     rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/BookSection> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment "A section of a book."@en;
                                            rdfs:label "Book Section"@en;
                                            rdfs:subClassOf <http://purl.org/ontology/bibo/DocumentPart>.
<http://purl.org/ontology/bibo/Chapter> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A chapter of a book."@en;
                                        rdfs:label "Chapter"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/BookSection>;
                                        <http://www.w3.org/2004/02/skos/core#AltLabel> "Book chapter"@en.
<http://purl.org/ontology/bibo/CollectedDocument> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:comment "A document that simultaneously contains other documents."@en;
                                                  rdfs:label "Collected Document"@en;
                                                  rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Collection> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A collection of Documents or Collections."@en;
                                           rdfs:label "Collection"@en;
                                           rdfs:subClassOf amv:pub_InformationResource.
<http://purl.org/ontology/bibo/Document> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "The algorithm was published in what kind of literature.",
                                                      "A document (noun) is a bounded physical representation of body of information designed with the capacity (and usually intent) to communicate. A document may manifest symbolic, diagrammatic or sensory-representational information."@en;
                                         rdfs:label "Document"@en;
                                         rdfs:subClassOf amv:pub_InformationResource;
                                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/Document>.
<http://purl.org/ontology/bibo/DocumentPart> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "a distinct part of a larger document or collected document."@en;
                                             rdfs:label "Document Part"@en;
                                             rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/EditedBook> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "An edited book."@en;
                                           rdfs:label "Edited Book"@en;
                                           rdfs:subClassOf <http://purl.org/ontology/bibo/CollectedDocument>.
<http://purl.org/ontology/bibo/Excerpt> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A passage selected from a larger work."@en;
                                        rdfs:label "Excerpt"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/DocumentPart>.
<http://purl.org/ontology/bibo/Issue> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "something that is printed or published and distributed, esp. a given number of a periodical."@en;
                                      rdfs:label "Issue"@en;
                                      rdfs:subClassOf <http://purl.org/ontology/bibo/CollectedDocument>.
<http://purl.org/ontology/bibo/Journal> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment """a periodical dedicated to a particular subject; \"he reads the medical journals.\""""@en,
                                                     "A periodical of scholarly journal Articles."@en;
                                        rdfs:label "Journal"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical>;
                                        <http://www.w3.org/2002/07/owl#disjointWith> <http://purl.org/ontology/bibo/Magazine>.
<http://purl.org/ontology/bibo/Magazine> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "A periodical publication containing articles and illustrations, often on a particular subject or aimed at a particular readership."@en,
                                                      "A periodical of magazine Articles. A magazine is a publication that is issued periodically, usually bound in a paper cover, and typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports."@en;
                                         rdfs:label "Magazine"@en;
                                         rdfs:subClassOf <http://purl.org/ontology/bibo/Periodical>.
<http://purl.org/ontology/bibo/Manuscript> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "An unpublished Document, which may also be submitted to a publisher for publication."@en;
                                           rdfs:label "Manuscript"@en;
                                           rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Patent> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years."@en;
                                       rdfs:label "Patent"@en;
                                       rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Periodical> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A group of related documents issued at regular intervals."@en;
                                           rdfs:label "Periodical"@en;
                                           rdfs:subClassOf <http://purl.org/ontology/bibo/Collection>;
                                           <http://www.w3.org/2002/07/owl#disjointWith> <http://purl.org/ontology/bibo/Website>,
                                                                                        <http://purl.org/ontology/bibo/Series>.
<http://purl.org/ontology/bibo/Proceedings> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment "A compilation of documents published from an event, such as a conference."@en;
                                            rdfs:label "Proceedings"@en;
                                            rdfs:subClassOf <http://purl.org/ontology/bibo/Book>.
<http://purl.org/ontology/bibo/ReferenceSource> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "A document that presents authoritative reference information, such as a dictionary or encylopedia."@en;
                                                rdfs:label "Reference Source"@en;
                                                rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Report> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A document describing an account or statement describing in detail an event, situation, or the like, usually as the result of observation, inquiry, etc.."@en;
                                       rdfs:label "Report"@en;
                                       rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Series> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A loose, thematic, collection of Documents, often Books."@en;
                                       rdfs:label "Series"@en;
                                       rdfs:subClassOf <http://purl.org/ontology/bibo/Collection>.
<http://purl.org/ontology/bibo/Slide> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "A slide in a slideshow."@en;
                                      rdfs:label "Slide"@en;
                                      rdfs:subClassOf <http://purl.org/ontology/bibo/DocumentPart>.
<http://purl.org/ontology/bibo/Thesis> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A document created to summarize research findings associated with the completion of an academic degree."@en;
                                       rdfs:label "Thesis"@en;
                                       rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Webpage> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A web page is an online document available (at least initially) on the world wide web. A web page is written first and foremost to appear on the web, as distinct from other online resources such as books, manuscripts or audio documents which use the web primarily as a distribution mechanism alongside other more traditional methods such as print."@en;
                                        rdfs:label "Webpage"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
<http://purl.org/ontology/bibo/Website> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "A group of Webpages accessible on the Web."@en;
                                        rdfs:label "Website"@en;
                                        rdfs:subClassOf <http://purl.org/ontology/bibo/Collection>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://schema.org/Comment> a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A comment on an item - for example, a comment on a blog post. The comment's content is expressed via the text property, and its topic via about, properties shared with all CreativeWorks."@en;
                            rdfs:label "Comment"@en.
<http://schema.org/comment> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Comments, typically from users."@en;
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.wikidata.org/entity/Q8366>
                                                                                  amv:Implementation
                                                                                  amv:pub_InformationResource) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:label "comment"@en;
                            rdfs:range <http://schema.org/Comment>;
                            <http://www.w3.org/2002/07/owl#inverseOf> amv:commentOf.
<http://www.w3.org/2004/02/skos/core#AltLabel> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/dcat#byteSize> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                     rdfs:comment "The size of a distribution in bytes."@en;
                                     rdfs:domain amv:Implementation;
                                     rdfs:label "byte size"@en;
                                     rdfs:range xsd:decimal.
<http://www.w3.org/ns/dcat#landingPage> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                        rdfs:comment "A Web page that can be navigated to in a Web browser to gain access to the catalog, a dataset, its distributions and/or additional information."@en;
                                        rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                        rdfs:label "landingPage";
                                        rdfs:range xsd:string;
                                        rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/page>.
<http://www.w3.org/ns/dcat#version> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                    rdfs:comment "The version number of a resource."@en;
                                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.wikidata.org/entity/Q8366>
                                                                                          amv:Implementation) ; 
                                                 a <http://www.w3.org/2002/07/owl#Class>];
                                    rdfs:label "version"@en;
                                    rdfs:range rdfs:Literal.
<http://www.w3.org/ns/prov#generalizationOf> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "An entity that is a generalization of another. E.g., Distribution sort algorithm is a generalization of Bucket sort."@en;
                                             rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:label "generalization of"@en;
                                             rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:subPropertyOf <http://purl.org/dc/terms/relation>;
                                             <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/prov#specializationOf>.
<http://www.w3.org/ns/prov#hadDerivation> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                            <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                          rdfs:label "had derivation"@en;
                                          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                          <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/prov#wasDerivedFrom>.
<http://www.w3.org/ns/prov#hadPrimarySource> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight. Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated. A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain."@en;
                                             rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:label "had primary source"@en;
                                             rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasDerivedFrom>;
                                             <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/prov#wasPrimarySourceOf>.
<http://www.w3.org/ns/prov#hadRevision> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                        rdfs:label "had revision"@en;
                                        rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                        rdfs:subPropertyOf <http://www.w3.org/ns/prov#hadDerivation>;
                                        <http://www.w3.org/2002/07/owl#inverseOf> <http://www.w3.org/ns/prov#wasRevisionOf>.
<http://www.w3.org/ns/prov#specializationOf> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:comment "An entity that is specialization of (... is a kind of) another entity and shares all aspects of the later including its own specific aspects. E.g., Bucket sort algorithm is a specialization of (a kind of) Distribution sort."@en;
                                             rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:label "specialization of"@en;
                                             rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                             rdfs:subPropertyOf <http://purl.org/dc/terms/relation>.
<http://www.w3.org/ns/prov#wasDerivedFrom> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                                             <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:comment "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en;
                                           rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                           rdfs:label "was Derived From";
                                           rdfs:range <http://www.w3.org/2002/07/owl#Thing>.
<http://www.w3.org/ns/prov#wasPrimarySourceOf> a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
