                     rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                     rdfs:label "alternative title"@en;
                     rdfs:range xsd:string.
amv:analysisFunctionType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "The various function types for analysis of algorithms like logarithmic functions, exponential functions etc."@en;
                         rdfs:domain amv:Algorithm;
                         rdfs:label "analysis function type"@en;
                         rdfs:range amv:AlgorithmAnalysisFunction;
                         rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                         <http://www.w3.org/2002/07/owl#inverseOf> amv:analysisFunctionTypeOf.
amv:analysisFunctionTypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain amv:AlgorithmAnalysisFunction;
                           rdfs:label "analysis function type of"@en;
                           rdfs:range amv:Algorithm.
amv:availableAlgorithm a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "An algorithm for a given problem."@en;
                       rdfs:domain amv:Problem;
                       rdfs:label "available algorithm"@en;
                       rdfs:range amv:Algorithm;
                       <http://www.w3.org/2002/07/owl#inverseOf> amv:computesSolutionTo.
amv:averageMessageComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain amv:MessageComplexity;
                             rdfs:label "average message complexity"@en;
                             rdfs:range xsd:string.
amv:averageSpaceComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Space complexity of an algorithm on average.(https://www.wikidata.org/wiki/Property:P3757)";
                           rdfs:domain amv:SpaceComplexity;
                           rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P3757"@en;
                           rdfs:label "average space complexity"@en;
                           rdfs:range xsd:string.
amv:averageTimeComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Time complexity of an algorithm on average. (https://www.wikidata.org/wiki/Property:P3754)"@en;
                          rdfs:domain amv:TimeComplexity;
                          rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P3754"@en;
                          rdfs:label "average time complexity"@en;
                          rdfs:range xsd:string.
amv:bestCaseMessageComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain amv:MessageComplexity;
                              rdfs:label "best case message complexity"@en;
                              rdfs:range xsd:string.
amv:bestCaseSpaceComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "Space complexity of an algorithm at least.(https://www.wikidata.org/wiki/Property:P3756)";
                            rdfs:domain amv:SpaceComplexity;
                            rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P3756"@en;
                            rdfs:label "best case space complexity"@en;
                            rdfs:range xsd:string.
amv:bestCaseTimeComplexity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Time complexity of an algorithm at least. (https://www.wikidata.org/wiki/Property:P3753)"@en;
                           rdfs:domain amv:TimeComplexity;
                           rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P3753"@en;
                           rdfs:label "best case time complexity"@en;
                           rdfs:range xsd:string.
amv:commentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain <http://schema.org/Comment>;
              rdfs:label "comment of"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.wikidata.org/entity/Q8366>
                                                                   amv:Implementation
                                                                   amv:pub_InformationResource) ; 
                          a <http://www.w3.org/2002/07/owl#Class>].
amv:computesSolutionTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "The type of problem the algorithm solves."@en,
                                    "Problem that this algorithm or method solves.(https://www.wikidata.org/wiki/Property:P2159)";
                       rdfs:domain amv:Algorithm;
                       rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P2159"@en;
                       rdfs:label "computes solution to"@en;
                       rdfs:range amv:Problem.
amv:constraint a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Limitations that an algorithm posses."@en;
               rdfs:domain amv:Algorithm;
               rdfs:label "constraint"@en;
               rdfs:range xsd:string.
amv:cpuTimeLimit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Time taken by CPU while executing the program.(In seconds)"@en;
                 rdfs:domain amv:Implementation;
                 rdfs:label "cpu time limit"@en;
                 rdfs:range xsd:integer.
amv:dataStructureUsed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "The data structure used in an algorithm."@en;
                      rdfs:domain amv:Algorithm;
                      rdfs:label "data Structure Used";
                      rdfs:range amv:DataStructure;
                      <http://www.w3.org/2002/07/owl#inverseOf> amv:dataStructureUsedIn.
amv:dataStructureUsedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain amv:DataStructure;
                        rdfs:label "data Structure Used In";
                        rdfs:range amv:Algorithm.
amv:definingFormula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment """The mathematical formula used for solving the problem.	
Mathematical formula representing a theorem or law."""@en;
                    rdfs:domain amv:MathematicalProperties;
                    rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/p2534"@en;
                    rdfs:label "defining formula"@en;
                    rdfs:range xsd:string.
amv:definition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:label "definiton"@en;
               rdfs:range xsd:string.
amv:edgeCase a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Input values that require special handling in an algorithm. When using the algorithm at an extreme(maximum or minimum) operating parameters."@en;
             rdfs:domain amv:Algorithm;
             rdfs:label "edge Case"@en;
             rdfs:range xsd:string.
amv:excerpt a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "An excerpt is a contiguous or discontiguous portion, or a passage selected from a larger work or document."@en;
            rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
            rdfs:label "excerpt"@en;
            rdfs:range xsd:string.
amv:firstWrittenRecord a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "First time a subject was mentioned in writing.(https://www.wikidata.org/wiki/Property:P1249)";
                       rdfs:domain amv:Algorithm;
                       rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/P1249"@en;
                       rdfs:label "time of earliest written record"@en;
                       rdfs:range xsd:dateTime.
amv:flexible a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "The algorithm written in such a way that it allows to add new features without changing the existing module."@en;
             rdfs:domain amv:Algorithm;
             rdfs:label "flexible";
             rdfs:range xsd:boolean.
amv:formOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The form of expression of an Algorithm.";
                     rdfs:domain amv:Algorithm;
                     rdfs:label "form of expression"@en;
                     rdfs:range amv:FormOfExpression;
                     <http://www.w3.org/2002/07/owl#inverseOf> amv:formOfExpressionOf.
amv:formOfExpressionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "The form of expression of an Algorithm.";
                       rdfs:domain amv:FormOfExpression;
                       rdfs:label "form Of expression of"@en;
                       rdfs:range amv:Algorithm.
amv:formalDefinition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                     rdfs:label "formal definition"@en;
                     rdfs:range xsd:string.
amv:hasImplementation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "The various applications of the algorithm."@en;
                      rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                      rdfs:label "has implementation"@en;
                      rdfs:range amv:Implementation;
                      <http://www.w3.org/2002/07/owl#inverseOf> amv:implementationOf.
amv:hasMessageComplexity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain amv:Algorithm;
                         rdfs:label "has message complexity"@en;
                         rdfs:range amv:MessageComplexity;
                         rdfs:subPropertyOf amv:hasMetric;
                         <http://www.w3.org/2002/07/owl#inverseOf> amv:messageComplexityOf.
amv:hasMetric a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain amv:Algorithm;
              rdfs:label "has metric"@en;
              rdfs:range amv:Metric;
              <http://www.w3.org/2002/07/owl#inverseOf> amv:metricOf.
amv:hasPerformanceMetric a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain amv:Algorithm;
                         rdfs:label "has performance metric"@en;
                         rdfs:range amv:PerformanceMetric;
                         rdfs:subPropertyOf amv:hasMetric;
                         <http://www.w3.org/2002/07/owl#inverseOf> amv:performanceMetricOf.
amv:hasSpaceComplexity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain amv:Algorithm;
                       rdfs:label "has space complexity"@en;
                       rdfs:range amv:SpaceComplexity;
                       rdfs:subPropertyOf amv:hasMetric;
                       <http://www.w3.org/2002/07/owl#inverseOf> amv:spaceComplexityOf.
amv:hasSubalgorithm a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain amv:Algorithm;
                    rdfs:label "has subalgorithm"@en;
                    rdfs:range amv:Algorithm;
                    rdfs:subPropertyOf <http://purl.org/dc/terms/hasPart>;
                    <http://www.w3.org/2002/07/owl#inverseOf> amv:subalgorithmOf.
amv:hasSubproblem a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "a problem that is contingent on or forms a part of another more inclusive problem."@en;
                  rdfs:domain amv:Problem;
                  rdfs:label "has subproblem"@en;
                  rdfs:range amv:Problem;
                  rdfs:subPropertyOf <http://purl.org/dc/terms/hasPart>;
                  <http://www.w3.org/2002/07/owl#inverseOf> amv:subproblemOf.
amv:hasTimeComplexity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain amv:Algorithm;
                      rdfs:label "has time complexity"@en;
                      rdfs:range amv:TimeComplexity;
                      rdfs:subPropertyOf amv:hasMetric;
                      <http://www.w3.org/2002/07/owl#inverseOf> amv:timeComplexityOf.
amv:implementationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The various applications of the algorithm.";
                     rdfs:domain amv:Implementation;
                     rdfs:label "implementation of"@en;
                     rdfs:range <http://www.w3.org/2002/07/owl#Thing>.
amv:input a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Something that is operated on by any process or system. An algorithm can have zero or more inputs."@en;
          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (amv:Algorithm
                                                                amv:Implementation) ; 
                       a <http://www.w3.org/2002/07/owl#Class>];
          rdfs:label "input"@en;
          rdfs:range xsd:string.
amv:inputDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Input description of an algorithm."@en;
                     rdfs:domain amv:Algorithm;
                     rdfs:label "input description"@en;
                     rdfs:range xsd:string;
                     rdfs:subPropertyOf <http://purl.org/dc/terms/description>.
amv:inputImage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:label "output image"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Image>;
               rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/depiction>;
               <http://www.w3.org/2002/07/owl#inverseOf> amv:isOutputImageOf.
amv:isATypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The nature or genre of an algorithm."@en,
                           "The different type of algorithmic techniques that are used to solve the various existing problems in the most optimized manner.This classification is neither exhaustive nor disjoint but highlights the various ways in which a problem can be addressed."@en;
              rdfs:domain amv:Algorithm;
              rdfs:label "is a type of"@en;
              rdfs:range amv:AlgorithmicType.
amv:isInputImageOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://xmlns.com/foaf/0.1/Image>;
                   rdfs:label "is input image of"@en;
                   rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                   rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                   <http://www.w3.org/2002/07/owl#inverseOf> amv:outputImage.
amv:isOutputImageOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://xmlns.com/foaf/0.1/Image>;
                    rdfs:label "is output image of"@en;
                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
amv:isSimilarTo a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A pointer to another, functionally similar thing (or multiple things), for example, an algorithm is similar to another algorithm or algorithms, a problem is similar to another problem or problems, etc."@en;
                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:label "is similar to"@en;
                rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:subPropertyOf <http://purl.org/dc/terms/relation>.
amv:libraryURI a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Unique identifier of the central place where the algorithm is stored."@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (amv:Algorithm
                                                                     amv:Implementation) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "library URI";
               rdfs:range xsd:anyURI.
amv:loopConstruct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The loop best suited for the algorithm."@en;
                  rdfs:domain amv:Algorithm;
                  rdfs:label "loop construct"@en;
                  rdfs:range amv:LoopConstruct;
                  <http://www.w3.org/2002/07/owl#inverseOf> amv:loopConstructOf.
amv:loopConstructOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain amv:LoopConstruct;
                    rdfs:label "loop construct of"@en;
                    rdfs:range amv:Algorithm.
amv:mathematicalProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "The mathematical concept used to solve the problem."@en;
                         rdfs:domain amv:Algorithm;
                         rdfs:label "mathematical property"@en;
                         rdfs:range amv:MathematicalProperties;
                         <http://www.w3.org/2002/07/owl#inverseOf> amv:mathematicalPropertyUsed.
amv:mathematicalPropertyUsed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:domain amv:MathematicalProperties;
                             rdfs:label "mathematicalPropertyUsed";
                             rdfs:range amv:Algorithm.
amv:messageComplexityOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain amv:MessageComplexity;
                        rdfs:label "message complexity of"@en;
                        rdfs:range amv:Algorithm;
                        rdfs:subPropertyOf amv:metricOf.
amv:metricOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain amv:Metric;
             rdfs:label "metric of"@en;
             rdfs:range amv:Algorithm.
amv:n-bodyProblem a amv:Problem,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>;
                  rdfs:comment "The n-body problem is the problem of predicting the individual motions of a group of celestial objects interacting with each other gravitationally."@en;
                  rdfs:label "n-body problem"@en.
amv:numberOfNestedLoops a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "The number of nested loops in an algorithm."@en;
                        rdfs:domain amv:Algorithm;
                        rdfs:label "number Of Nested Loops";
                        rdfs:range xsd:nonNegativeInteger.
amv:numberOfSteps a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Total number of steps that the algorithm takes to solve a certain problem."@en;
                  rdfs:domain amv:Algorithm;
                  rdfs:label "number Of Steps";
                  rdfs:range xsd:nonNegativeInteger.
amv:offlineAlgorithm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The complete dataset is required to start processing."@en;
                     rdfs:domain amv:Algorithm;
                     rdfs:label "offline algorithm"@en;
                     rdfs:range xsd:boolean.
amv:onlineAlgorithm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The data can be feed while processing."@en;
                    rdfs:domain amv:Algorithm;
                    rdfs:label "online algorithm"@en;
                    rdfs:range xsd:boolean.
amv:operatingSystemFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain <https://schema.org/OperatingSystem>;
                       rdfs:label "operatingSystemFor";
                       rdfs:range amv:Implementation;
                       <http://www.w3.org/2002/07/owl#inverseOf> amv:runsOnOperatingSystem.
amv:optimal a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "An algorithm is optimal means the time complexity in the worst case is a lower bound of the function that describes the time complexity in the worst case of a problem that the algorithm in question solves."@en;
            rdfs:domain amv:Algorithm;
            rdfs:label "optimal"@en;
            rdfs:range xsd:boolean.
amv:output a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Output after processing the input.";
           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (amv:Algorithm
                                                                 amv:Implementation) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:label "output"@en;
           rdfs:range xsd:string.
amv:outputImage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:label "input image"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Image>;
                rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/depiction>.
amv:performanceMetricOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain amv:PerformanceMetric;
                        rdfs:label "performance metric of"@en;
                        rdfs:range amv:Algorithm;
                        rdfs:subPropertyOf amv:metricOf.
amv:precision a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "It is a measure of quality, higher precision means algorithm returns more relevant results than irrelevant ones."@en;
              rdfs:domain amv:PerformanceMetric;
              rdfs:label "precision"@en;
              rdfs:range xsd:float.
amv:problemDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "A description providing the problem statement."@en;
                       rdfs:domain amv:Problem;
                       rdfs:label "problem description"@en;
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf <http://purl.org/dc/terms/description>.
amv:programmingLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "In which all language the implementation of the algorithm/ problem is available."@en;
                        rdfs:domain amv:Implementation;
                        rdfs:label "programming language"@en;
                        rdfs:range amv:ProgrammingLanguage;
                        <http://www.w3.org/2002/07/owl#inverseOf> amv:usedInIm.
amv:pub_Discipline a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Academic field of study or profession."@en,
                                "A branch of knowledge."@en;
                   rdfs:label "Academic discipline"@en;
                   <http://www.w3.org/2004/02/skos/core#AltLabel> "Subject area"@en,
                                                                  "Academic field"@en.
amv:pub_InformationResource a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "An information resource."@en;
                            rdfs:label "Information Resource"@en.
amv:pub_Manual a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A small reference book, especially one giving instructions."@en;
               rdfs:label "Manual"@en;
               rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
amv:pub_accessRightsOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain <http://purl.org/dc/terms/RightsStatement>;
                       rdfs:label "access rights of"@en;
                       rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                       rdfs:subPropertyOf amv:pub_rightsOf.
amv:pub_appearedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "An algorithm appeared in a publication."@en;
                   rdfs:domain amv:Algorithm;
                   rdfs:label "appeared In";
                   rdfs:range amv:pub_InformationResource;
                   <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_contains.
amv:pub_branchOf a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain amv:pub_Discipline;
                 rdfs:label "branch Of"@en;
                 rdfs:range amv:pub_Discipline;
                 <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_hasBranch.
amv:pub_contains a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain amv:pub_InformationResource;
                 rdfs:label "contains";
                 rdfs:range amv:Algorithm.
amv:pub_contributorOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                      rdfs:label "contributor of"@en;
                      rdfs:range <http://www.w3.org/2002/07/owl#Thing>.
amv:pub_creatorOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                  rdfs:label "creator of"@en;
                  rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                  <http://www.w3.org/2004/02/skos/core#AltLabel> "author of"@en.
amv:pub_downloadLink a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "URL which can be used to download a work."@en;
                     rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.wikidata.org/entity/Q8366>
                                                                           amv:Implementation) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                     rdfs:isDefinedBy "http://www.wikidata.org/prop/direct/p4945"@en;
                     rdfs:label "download link"@en;
                     rdfs:range xsd:anyURI.
amv:pub_hasArticle a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://purl.org/ontology/bibo/Periodical>;
                   rdfs:label "hasArticle";
                   rdfs:range <http://purl.org/ontology/bibo/Article>;
                   <http://www.w3.org/2002/07/owl#inverseOf> amv:pub_publishedIn.
amv:pub_hasBranch a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Branch of the academic discipline.";
                  rdfs:domain amv:pub_Discipline;
