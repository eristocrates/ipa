@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix core: <https://w3id.org/mdo/core/>.

<http://emmo.info/domains/emmo-material.owl#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                       rdfs:label "Material".
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://qudt.org/schema/qudt/Quantity> a <http://www.w3.org/2002/07/owl#Class>.
<http://qudt.org/schema/qudt/QuantityKind> a <http://www.w3.org/2002/07/owl#Class>.
<http://qudt.org/schema/qudt/QuantityValue> a <http://www.w3.org/2002/07/owl#Class>.
<http://qudt.org/schema/qudt/hasQuantityKind> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:range <http://qudt.org/schema/qudt/QuantityKind>.
<http://qudt.org/schema/qudt/numericalValue> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                             rdfs:range xsd:double.
<http://qudt.org/schema/qudt/quantityValue> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                            rdfs:range <http://qudt.org/schema/qudt/QuantityValue>.
<http://qudt.org/schema/qudt/unit> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:range <http://qudt.org/vocab/unit/Unit>.
<http://qudt.org/vocab/unit/EV> a <http://qudt.org/vocab/unit/Unit>,
                                  <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://qudt.org/vocab/unit/GM-PER-CentiM3> a <http://qudt.org/vocab/unit/Unit>,
                                              <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://qudt.org/vocab/unit/Unit> a <http://www.w3.org/2002/07/owl#Class>.
xsd:date a rdfs:Datatype.
core: <http://purl.org/dc/terms/contributor> "Rickard Armiento",
                                             "Patrick Lambrix";
      <http://purl.org/dc/terms/created> "2019-11-07";
      <http://purl.org/dc/terms/creator> "Huanyu Li";
      <http://purl.org/dc/terms/license> "https://github.com/huanyu-li/Materials-Design-Ontology/blob/master/LICENSE";
      <http://purl.org/dc/terms/title> "Materials Design Ontology - Core Module"@en;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "core";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/mdo/core/1.0/";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "This is the core module in Materials Design Ontology."@en;
      rdfs:seeAlso "https://github.com/huanyu-li/Materials-Design-Ontology";
      <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/mdo/core/1.0/>;
      <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
core:CalculatedProperty a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A calculated property is a proprty that is a result from a calculation."@en;
                        rdfs:label "Calculated Property"@en;
                        rdfs:subClassOf core:Property;
                        <http://www.w3.org/2002/07/owl#disjointWith> core:PhysicalProperty.
core:Calculation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A calculation is the use of a specific computational method to process structures and/or properties into output structures and/or calculated properties."@en;
                 rdfs:label "Calculation"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> core:Structure ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasInputStructure ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> core:Structure ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasInputStructure ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> core:Structure ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasOutputStructure ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> core:Property ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasInputProperty ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> core:Property ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasInputProperty ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#allValuesFrom> core:CalculatedProperty ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> core:hasOutputCalculatedProperty ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
core:ID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:comment "ID represents that a calculation has the unique ID in a string."@en;
        rdfs:domain core:Calculation;
        rdfs:label "ID"@en;
        rdfs:range xsd:string.
core:PhysicalProperty a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A physical property is an objective property over a physical system. (ie, a property pertains to the physical reality)"@en;
                      rdfs:label "Physical Property"@en;
                      rdfs:subClassOf core:Property.
core:Property a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A property in materials design is data pertaining to at least one material or materials system."@en;
              rdfs:label "Property"@en;
              rdfs:subClassOf <http://qudt.org/schema/qudt/Quantity>.
core:PropertyName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "PropertyName represents that a property has the name in a string."@en;
                  rdfs:domain core:Property;
                  rdfs:label "property name"@en;
                  rdfs:range xsd:string.
core:Structure a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A structure is the information of the sites and their occupancies in a material or materials system."@en;
               rdfs:label "Structure"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <http://emmo.info/domains/emmo-material.owl#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> core:relatesToMaterial ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://emmo.info/domains/emmo-material.owl#EMMO_4207e895_8b83_4318_996a_72cfb32acd94> ; 
                                                                                <http://www.w3.org/2002/07/owl#onProperty> core:relatesToMaterial ; 
                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
core:hasInputProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "hasInputProperty represents the relationship between a calculation and the properties it takes as input."@en;
                      rdfs:domain core:Calculation;
                      rdfs:label "has input property"@en;
                      rdfs:range core:Property.
core:hasInputStructure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "hasInputStructure represents the relationship between a calculation and the structures it takes as input."@en;
                       rdfs:domain core:Calculation;
                       rdfs:label "has input structure"@en;
                       rdfs:range core:Structure.
core:hasOutputCalculatedProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "hasOutputCalculatedProperty represents the relationship between a calculation and the calculated properties it outputs."@en;
                                 rdfs:domain core:Calculation;
                                 rdfs:label "has output calculated property"@en;
                                 rdfs:range core:CalculatedProperty.
core:hasOutputStructure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "hasOutputStructure represents the relationship between a calculation and the structures it outputs."@en;
                        rdfs:domain core:Calculation;
                        rdfs:label "has output structure"@en;
                        rdfs:range core:Structure.
core:hasQuantityValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "hasQuantityValue represents the relationship between a property and quantity value it takes."@en;
                      rdfs:label "has quantity value"@en.
core:relatesToMaterial a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "relatesToMaterial represents the relationship between a structure and the materials it comes from."@en;
                       rdfs:domain core:Structure;
                       rdfs:label "relates to material"@en;
                       rdfs:range <http://emmo.info/domains/emmo-material.owl#EMMO_4207e895_8b83_4318_996a_72cfb32acd94>.
core:relatesToStructure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "relatesToStructure represents the relationship between a property and the structures it comes from."@en;
                        rdfs:domain core:Property;
                        rdfs:label "relates to structure"@en;
                        rdfs:range core:Structure.
