cis:CulturalEntity a owl:Class.
<http://ontologydesignpatterns.org/opla/isNativeTo> a owl:AnnotationProperty.
<http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate> a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:language a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
<https://w3id.org/arco/ontology/catalogue> <http://ontologydesignpatterns.org/opla/reusesPatternAsTemplate> <http://ontologydesignpatterns.org/cp/owl/sequence.owl>,
                                                                                                            <http://ontologydesignpatterns.org/cp/owl/classification.owl>;
                                           dc11:creator "Andrea Nuzzolese (ISTC-CNR, STLab)",
                                                        "Valentina Carriero (ISTC-CNR, STLab)",
                                                        "Maria Letizia Mancinelli (MiBACT, ICCD)",
                                                        "Chiara Veninata (MiBACT, ICCD)",
                                                        "Aldo Gangemi (ISTC-CNR, STLab)",
                                                        "Ludovica Marinucci (ISTC-CNR, STLab)",
                                                        "Valentina Presutti (ISTC-CNR, STLab)";
                                           dc11:description "The Catalogue module allows the description of concepts related to the Italian General Catalogue of Cultural Heritage (ICCD-MiBAC), and in particular catalogue records, that is XML files recording all data gathered by a cataloguer on a particular cultural property."@en,
                                                            "Questo modulo modella le informazioni relative al Catalogo Generale dei Beni Culturali (ICCD-MiBAC) e alle schede di catalogo che descrivono un bene culturale."@it;
                                           dc11:language <http://publications.europa.eu/resource/authority/language/ITA>,
                                                         <http://publications.europa.eu/resource/authority/language/ENG>;
                                           dc11:title "Catalogue Ontology (ArCo network)"@en,
                                                      "Ontologia del Catalogo (ArCo network)"@it;
                                           dcterms:issued "2018-03-07";
                                           dcterms:license <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40>,
                                                           <https://creativecommons.org/licenses/by-sa/4.0/>;
                                           dcterms:modified "2019-06-01";
                                           a owl:Ontology;
                                           rdfs:comment """The Catalogue module allows the description of concepts related to the Italian General Catalogue of Cultural Heritage (ICCD-MiBAC), and in particular catalogue records, that is XML files recording all data gathered by a cataloguer on a particular cultural property.
In this module are used as template the following Ontology Design Patterns:
- http://www.ontologydesignpatterns.org/cp/owl/classification.owl
- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"""@en,
                                                        """Questo modulo modella le informazioni relative al Catalogo Generale dei Beni Culturali (ICCD-MiBAC) e alle schede di catalogo che descrivono un bene culturale.
In questo modulo sono riusati come template i seguenti Ontology Design Patterns:
- http://www.ontologydesignpatterns.org/cp/owl/classification.owl
- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"""@it;
                                           rdfs:label "Catalogue Ontology (ArCo network)"@en,
                                                      "Ontologia del Catalogo (ArCo network)"@it;
                                           owl:imports <https://w3id.org/arco/ontology/core>;
                                           owl:versionInfo "Version 1.0"@en,
                                                           "Versione 1.0"@it.
ctlog:AccessProfile a owl:Class;
                    rdfs:comment "Questa classe rappresenta il profilo di accesso ai dati contenuti in una scheda catalografica, con cui si forniscono indicazioni circa la diffusione pubblica dei dati catalografici sul web."@it,
                                 "This class represents the access profile to the data recorded in a catalogue record, giving instructions for public dissemination of data on the web."@en;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                    rdfs:label "Profilo di accesso"@it,
                               "Access profile"@en;
                    rdfs:subClassOf [owl:someValuesFrom ctlog:CatalogueRecord ; 
                                     owl:onProperty ctlog:isAccessProfileOf ; 
                                     a owl:Restriction],
                                    [owl:onProperty cdesc:expiryDate ; 
                                     owl:allValuesFrom rdfs:Literal ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ctlog:PrivacyLevel ; 
                                     owl:onProperty ctlog:hasPrivacyLevel ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ctlog:PrivacyReason ; 
                                     owl:onProperty ctlog:hasPrivacyReason ; 
                                     a owl:Restriction],
                                    <https://w3id.org/italia/onto/l0/Characteristic>;
                    owl:versionInfo "stabile"@it,
                                    "stable"@en;
                    ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS".
ctlog:AdditionalForm a owl:Class;
                     rdfs:comment "This class represents an additional form, that describes specific information about a cultural property (epigraphic documents, stratigraphy, unit, wall typology)"@en,
                                  "Questa classe rappresenta un modulo di approfondimento, utile a trattare secondo un approccio specialistico specifici aspetti del bene in esame (Documenti Epigrafici; Tipi Murari, Unità Stratigrafiche)"@it;
                     rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                     rdfs:label "Additional form"@en,
                                "Modulo di approfondimento"@it;
                     rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                      owl:onProperty ctlog:additionalFormIdentifier ; 
                                      a owl:Restriction],
                                     <https://w3id.org/italia/onto/l0/Object>,
                                     [owl:someValuesFrom cis:CulturalEntity ; 
                                      owl:onProperty ctlog:describes ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom ctlog:AdditionalFormType ; 
                                      owl:onProperty ctlog:hasAdditionalFormType ; 
                                      a owl:Restriction];
                     owl:disjointWith ctlog:InformationForm;
                     owl:versionInfo "stable"@en,
                                     "stabile"@it;
                     ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP".
ctlog:AdditionalFormType a owl:Class;
                         rdfs:comment "Questa classe rappresenta il tipo di modulo di approfondimento (Unità Stratigrafica, Tipo Murario, Epigrafia)"@it,
                                      "This class represents the additional form type (Stratigraphic Unit, Wall Typology, Epigraphy)"@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Additional form type"@en,
                                    "Tipo di modulo di approfondimento"@it;
                         rdfs:subClassOf [owl:someValuesFrom ctlog:AdditionalForm ; 
                                          owl:onProperty ctlog:isAdditionalFormTypeOf ; 
                                          a owl:Restriction],
                                         arco:Type;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en;
                         ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPT".
ctlog:AlternativeIdentifier a owl:Class;
                            rdfs:comment "Questa classe rappresenta un codice che identifica la scheda di catalogo nell'ambito di altri sistemi informativi, assegnato da enti diversi da ICCD."@it,
                                         "This class represents an identifier of a catalogue record in information systems other than ICCD."@en;
                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                            rdfs:label "Codice alternativo"@it,
                                       "Alternative Identifier"@en;
                            rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object>,
                                            [owl:someValuesFrom ctlog:CatalogueRecord ; 
                                             owl:onProperty ctlog:isAlternativeIdentifierOf ; 
                                             a owl:Restriction],
                                            [owl:onProperty ctlog:referenceProject ; 
                                             owl:allValuesFrom rdfs:Literal ; 
                                             a owl:Restriction];
                            owl:versionInfo "stabile"@it,
                                            "stable"@en;
                            ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACC".
ctlog:C a owl:NamedIndividual,
          ctlog:CataloguingLevel;
        rdfs:label "Detailed Level"@en,
                   "Livello di Catalogo"@it;
        owl:versionInfo "stabile"@it,
                        "stable"@en.
ctlog:CatalogueRecord dc11:description """An example of usage of the class 'Catalogue Record' is the following:
resource:CatalogueRecordS/0500212038
        a           cat:CatalogueRecordS ;
        rdfs:label  \"Catalogue record n: 0500212038\"@en ;
        cat:catalogueRecordIdentifier \"0500212038\" ;
        cat:describesCulturalProperty resource:HistoricOrArtisticProperty/0500212038 ;
        cat:hasAccessProfile resource:AccessProfile/0500212038-1 ;
        cat:hasCatalogueRecordVersion resource:CatalogueRecordVersion/0500212038-rvm , resource:CatalogueRecordVersion/0500212038-agg-1 , resource:CatalogueRecordVersion/0500212038-compilation ;
        cat:hasCataloguingLevel
                cat:C ;
        cat:systemRecordCode \"ICCD8403091\" ;
        core:note>  \"Number of negative by \"Museco Civico\": MCBas G/ DLXXXIX/ 3775\" ."""@en,
                                       """Un esempio di utilizzo della classe \"Scheda di Catalogo\" è il seguente:
resource:CatalogueRecordS/0500212038
        a           cat:CatalogueRecordS ;
        rdfs:label  \"Scheda catalografica n: 0500212038\"@it ;
        cat:catalogueRecordIdentifier \"0500212038\" ;
        cat:describesCulturalProperty resource:HistoricOrArtisticProperty/0500212038 ;
        cat:hasAccessProfile resource:AccessProfile/0500212038-1 ;
        cat:hasCatalogueRecordVersion resource:CatalogueRecordVersion/0500212038-rvm , resource:CatalogueRecordVersion/0500212038-agg-1 , resource:CatalogueRecordVersion/0500212038-compilation ;
        cat:hasCataloguingLevel
                cat:C ;
        cat:systemRecordCode \"ICCD8403091\" ;
        core:note  \"Numero di negativo del Museo Civico: MCBas G/ DLXXXIX/ 3775\" ."""@it;
                      a owl:Class;
                      rdfs:comment "Rappresenta una scheda di catalogo, cioè un modello descrittivo che raccoglie in modo organizzato le informazioni sui beni, e che può avere più versioni (in seguito ad aggiornamenti e revisioni)."@it,
                                   "This class represents a catalogue record, that is a descriptive model collecting and organising information on a cultural property, and which can have more than one version (after editing and updating)."@en;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                      rdfs:label "Scheda di catalogo"@it,
                                 "Catalogue record"@en;
                      rdfs:subClassOf [owl:someValuesFrom ctlog:AccessProfile ; 
                                       owl:onProperty ctlog:hasAccessProfile ; 
                                       a owl:Restriction],
                                      [owl:onProperty ctlog:hasCatalogueRecordVersion ; 
                                       owl:allValuesFrom ctlog:CatalogueRecordVersion ; 
                                       a owl:Restriction],
                                      [owl:onProperty ctlog:describesCulturalProperty ; 
                                       owl:allValuesFrom cis:CulturalEntity ; 
                                       a owl:Restriction],
                                      <https://w3id.org/italia/onto/l0/Object>,
                                      [owl:onProperty ctlog:catalogueRecordIdentifier ; 
                                       owl:allValuesFrom rdfs:Literal ; 
                                       a owl:Restriction],
                                      [owl:onProperty ctlog:systemRecordCode ; 
                                       owl:allValuesFrom rdfs:Literal ; 
                                       a owl:Restriction];
                      owl:versionInfo "stable"@en,
                                      "stabile"@it.
ctlog:CatalogueRecordA a owl:Class;
                       rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive architettura."@it,
                                    "This class represents the catalogue record describing Architecture."@en;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "Architecture catalogue record"@en,
                                  "Scheda Architettura"@it;
                       rdfs:subClassOf ctlog:CatalogueRecord;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en.
