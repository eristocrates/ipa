                                      "This class represents the catalogue record describing Contemporary artworks."@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Contemporary artworks catalogue record"@en,
                                    "Scheda opere/oggetti d'arte contemporanea"@it;
                         rdfs:subClassOf ctlog:CatalogueRecord;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:CatalogueRecordPG a owl:Class;
                        rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive parchi/giardini."@it,
                                     "This class represents the catalogue record describing Parks / Gardens."@en;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "Parks/Gardens catalogue record"@en,
                                   "Scheda Parchi/giardini"@it;
                        rdfs:subClassOf ctlog:CatalogueRecord;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
ctlog:CatalogueRecordPST a owl:Class;
                         rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive il patrimonio scientifico e tecnologico."@it,
                                      "This class represents the catalogue record describing Scientific and technological heritage."@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Scheda Patrimonio scientifico e tecnologico"@it,
                                    "Scientific and technological heritage catalogue record"@en;
                         rdfs:subClassOf ctlog:CatalogueRecord;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:CatalogueRecordRA a owl:Class;
                        rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive reperti archeologici."@it,
                                     "This class represents the catalogue record describing Archaeological objects."@en;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "Archaeological objects catalogue record"@en,
                                   "Scheda Reperti archeologici"@it;
                        rdfs:subClassOf ctlog:CatalogueRecord;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
ctlog:CatalogueRecordS a owl:Class;
                       rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive stampe."@it,
                                    "This class represents the catalogue record describing Prints."@en;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "Prints catalogue record"@en,
                                  "Scheda Stampe"@it;
                       rdfs:subClassOf ctlog:CatalogueRecord;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en.
ctlog:CatalogueRecordSAS a owl:Class;
                         rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive saggi stratigrafici."@it,
                                      "This class represents the catalogue record describing Stratigraphic records."@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Scheda Saggi stratigrafici"@it,
                                    "Stratigraphic records catalogue record"@en;
                         rdfs:subClassOf ctlog:CatalogueRecord;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:CatalogueRecordSI a owl:Class;
                        rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive siti archeologici."@it,
                                     "This class represents the catalogue record describing Archaeological sites."@en;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "Archaeological sites catalogue record"@en,
                                   "Scheda Siti archeologici"@it;
                        rdfs:subClassOf ctlog:CatalogueRecord;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
ctlog:CatalogueRecordSM a owl:Class;
                        rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive strumenti musicali."@it,
                                     "This class represents the catalogue record describing Musical instruments."@en;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "Musical instruments catalogue record"@en,
                                   "Scheda Strumenti musicali"@it;
                        rdfs:subClassOf ctlog:CatalogueRecord;
                        owl:versionInfo "stabile"@it,
                                        "stable"@en.
ctlog:CatalogueRecordSMO a owl:Class;
                         rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive strumenti musicali-organo."@it,
                                      "This class represents the catalogue record describing Organs."@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Musical instruments - Organs catalogue record"@en,
                                    "Scheda Strumenti musicali-Organo"@it;
                         rdfs:subClassOf ctlog:CatalogueRecord;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:CatalogueRecordTMA a owl:Class;
                         rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive tabella materiali archeologici."@it,
                                      "This class represents the catalogue record describing Archaeological materials tables."@en;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "Archaeological materials tables catalogue record"@en,
                                    "Scheda Tabella materiali archeologici"@it;
                         rdfs:subClassOf ctlog:CatalogueRecord;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:CatalogueRecordVeAC a owl:Class;
                          rdfs:comment "Questa classe rappresenta la scheda catalografica che descrive vestimenti antichi/contemporanei."@it,
                                       "This class represents the catalogue record describing Historic and contemporary garments."@en;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                          rdfs:label "Historic and contemporary garments catalogue record"@en,
                                     "Scheda Vestimenti antichi/contemporanei"@it;
                          rdfs:subClassOf ctlog:CatalogueRecord;
                          owl:versionInfo "stabile"@it,
                                          "stable"@en.
ctlog:CatalogueRecordVersion a owl:Class;
                             rdfs:comment "This class represents a version (after creation, editing, updating) of a catalogue record on a cultural property."@en,
                                          "Rappresenta una versione (relativa a operazioni di redazione, aggiornamento, revisione) di una scheda di catalogo, cioè un modello descrittivo che raccoglie in modo organizzato le informazioni sui beni."@it;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                             rdfs:label "Versione della scheda"@it,
                                        "Catalogue record version"@en;
                             rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object>,
                                             [owl:onProperty ctlog:editedAtTime ; 
                                              owl:allValuesFrom <https://w3id.org/italia/onto/TI/TimeInterval> ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:isPreviousVersionOf ; 
                                              owl:allValuesFrom ctlog:CatalogueRecordVersion ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:hasCatalogueRecordVersionRiT ; 
                                              owl:allValuesFrom <https://w3id.org/italia/onto/RO/TimeIndexedRole> ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:isImmediatePreviousVersionOf ; 
                                              owl:allValuesFrom ctlog:CatalogueRecordVersion ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:hasImmediatePreviousVersion ; 
                                              owl:allValuesFrom ctlog:CatalogueRecordVersion ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:hasPreviousVersion ; 
                                              owl:allValuesFrom ctlog:CatalogueRecordVersion ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:isCatalogueRecordVersionOf ; 
                                              owl:allValuesFrom ctlog:CatalogueRecord ; 
                                              a owl:Restriction],
                                             [owl:onProperty ctlog:hasCataloguingAgent ; 
                                              owl:allValuesFrom <https://w3id.org/italia/onto/l0/Agent> ; 
                                              a owl:Restriction];
                             owl:versionInfo "stabile"@it,
                                             "stable"@en;
                             ctlog:iccdNormTag "CM/CMP; CM/RVM; CM/AGG".
ctlog:CataloguingLevel a owl:Class;
                       rdfs:comment "Questa classe rappresenta il livello catalogazione, cioè la sigla che individua il grado di approfondimento dell'indagine condotta sul bene in esame (I corrisponde al livello di inventario, P al livello di precatalogo, C al livello di catalogo)"@it,
                                    "This class represents the cataloguing level, defining the level of detail of the survey carried out on the cultural property (Minimum, Medium, Detailed)"@en;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "Livello catalogazione"@it,
                                  "Cataloguing level"@en;
                       rdfs:subClassOf [owl:someValuesFrom ctlog:CatalogueRecord ; 
                                        owl:onProperty ctlog:isCataloguingLevelOf ; 
                                        a owl:Restriction],
                                       <https://w3id.org/italia/onto/l0/Characteristic>;
                       owl:equivalentClass [owl:oneOf (ctlog:C
                                                       ctlog:I
                                                       ctlog:P) ; 
                                            a owl:Class];
                       owl:versionInfo "stable"@en,
                                       "stabile"@it;
                       ctlog:iccdNormTag "CD/LIR".
ctlog:ComplexCPCatalogueRecord a owl:Class;
                               rdfs:comment "Questa classe rappresenta una scheda catalografica che descrive un bene culturale complesso, a prescindere dal trattamento catalografico applicato (scheda unica/scheda d'insieme)."@it,
                                            "This class represents a catalogue record describing a complex cultural property."@en;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                               rdfs:label "Complex cultural property catalogue record"@en,
                                          "Scheda catalografica su bene culturale complesso"@it;
                               rdfs:subClassOf ctlog:CatalogueRecord;
                               owl:versionInfo "stabile"@it,
                                               "stable"@en.
ctlog:CulturalPropertyRecord a owl:Class;
                             rdfs:comment "This class represents a record describing a cultural property for purposes other than cataloguing cultural heritage."@en,
                                          "Questa classe rappresenta una scheda che analizza il bene in esame per finalità diverse da quella specifica della catalogazione del patrimonio culturale."@it;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                             rdfs:label "Scheda su bene culturale"@it,
                                        "Catalogue property record"@en;
                             rdfs:subClassOf [owl:onProperty ctlog:referenceProject ; 
                                              owl:allValuesFrom rdfs:Literal ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom cis:CulturalEntity ; 
                                              owl:onProperty ctlog:describes ; 
                                              a owl:Restriction],
                                             <https://w3id.org/italia/onto/l0/Object>,
                                             [owl:someValuesFrom rdfs:Literal ; 
                                              owl:onProperty ctlog:culturalPropertyRecordIdentifier ; 
                                              a owl:Restriction];
                             owl:versionInfo "stabile"@it,
                                             "stable"@en;
                             ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS".
ctlog:EpigraphyForm a owl:NamedIndividual,
                      ctlog:AdditionalFormType;
                    rdfs:label "Epigraphy form"@en,
                               "Modulo sull'epigrafia"@it.
ctlog:I a owl:NamedIndividual,
          ctlog:CataloguingLevel;
        rdfs:label "Livello di Inventario"@it,
                   "Minimum Level"@en;
        owl:versionInfo "stabile"@it,
                        "stable"@en.
ctlog:ICCDIdentifier a owl:FunctionalProperty,
                       owl:DatatypeProperty;
                     rdfs:comment "Questa proprietà rappresenta un codice assegnato a un'entità dall'ICCD. Si specializza in sottoproprietà (es.: codice univoco ICCD dell'autore, codice univoco ICCD del riferimento bibliografico, etc.)"@it,
                                  "This property represents the identifier assigned to a cultural property by ICCD."@en;
                     rdfs:domain owl:Thing;
                     rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                     rdfs:label "ICCD identifier"@en,
                                "codice univoco ICCD"@it;
                     rdfs:range rdfs:Literal;
                     rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                     owl:versionInfo "stabile"@it,
                                     "stable"@en.
ctlog:InformationForm a owl:Class;
                      rdfs:comment "Questa classe rappresenta un modulo informativo, uno standard ICCD per attività di censimento e segnalazione di beni culturali, utilizzato per acquisire informazioni per qualsiasi tipo di entità, con un set minimo di dati standardizzati obbligatori."@it,
                                   "This class represents an information form, an ICCD standard for cultural heritage census and reporting activities, used to acquire information for any type of entity, with a minimum set of mandatory standardized data."@en;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                      rdfs:label "Modulo informativo"@it,
                                 "Information form"@en;
                      rdfs:subClassOf <https://w3id.org/italia/onto/l0/Object>,
                                      [owl:onProperty ctlog:informationFormIdentifier ; 
                                       owl:allValuesFrom rdfs:Literal ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom cis:CulturalEntity ; 
                                       owl:onProperty ctlog:describes ; 
                                       a owl:Restriction];
                      owl:versionInfo "stable"@en,
                                      "stabile"@it;
                      ctlog:iccdNormTag "ICCD Normativa Trasvesale 4.00: AC/MOD".
ctlog:MaximumPrivacy a owl:NamedIndividual,
                       ctlog:PrivacyLevel;
                     rdfs:label "Livello alto di riservatezza"@it,
                                "Maximum privacy"@en.
ctlog:MediumPrivacy a owl:NamedIndividual,
                      ctlog:PrivacyLevel;
                    rdfs:label "Livello medio di riservatezza"@it,
                               "Medium privacy"@en.
ctlog:MinimumPrivacy a owl:NamedIndividual,
                       ctlog:PrivacyLevel;
                     rdfs:label "Livello basso di riservatezza"@it,
                                "Minimum privacy"@en.
ctlog:P a owl:NamedIndividual,
          ctlog:CataloguingLevel;
        rdfs:label "Livello di Precatalogo"@it,
                   "Medium Level"@en;
        owl:versionInfo "stabile"@it,
                        "stable"@en.
ctlog:PrivacyLevel a owl:Class;
                   rdfs:comment "Questa classe rappresenta il livello di riservatezza dei dati contenuti in una scheda catalografica (1 livello basso di riservatezza, 2 livello medio di riservatezza, 3 livello alto di riservatezza)"@it,
                                "This class represents the privacy level of the data recorded in a catalogue record (Minimum, Medium, Maximum)."@en;
                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                   rdfs:label "Livello di riservatezza"@it,
                              "Privacy level"@en;
                   rdfs:subClassOf <https://w3id.org/italia/onto/l0/Characteristic>,
                                   [owl:someValuesFrom ctlog:AccessProfile ; 
                                    owl:onProperty ctlog:isPrivacyLevelOf ; 
                                    a owl:Restriction];
                   owl:versionInfo "stabile"@it,
                                   "stable"@en;
                   ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS/ADSP".
ctlog:PrivacyReason a owl:Class;
                    rdfs:comment "Questa classe rappresenta la motivazione che ha determinato l'adozione di un profilo di accesso relativamente ai dati contenuti in una scheda catalografica."@it,
                                 "This class represents the reason for the adoption of a specific access profile for a catalogue record."@en;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                    rdfs:label "Motivo di riservatezza"@it,
                               "Privacy reason"@en;
                    rdfs:subClassOf [owl:someValuesFrom ctlog:AccessProfile ; 
                                     owl:onProperty ctlog:isPrivacyReasonOf ; 
                                     a owl:Restriction],
                                    <https://w3id.org/italia/onto/l0/Description>;
                    owl:versionInfo "stable"@en,
                                    "stabile"@it;
                    ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS/ADSM".
ctlog:StratigraphicUnitForm a owl:NamedIndividual,
                              ctlog:AdditionalFormType;
                            rdfs:label "Modulo sull'Unità Stratigrafica"@it,
                                       "Stratigraphic Unit form"@en.
ctlog:WallTypologyForm a owl:NamedIndividual,
                         ctlog:AdditionalFormType;
                       rdfs:label "Modulo sul Tipo Murario"@it,
                                  "Wall Typology form"@en.
ctlog:additionalFormIdentifier a owl:DatatypeProperty,
                                 owl:FunctionalProperty;
                               rdfs:comment "This property represents the additional form identifier."@en,
                                            "Questa proprietà permette di associare un identificativo a un modulo di approfondimento."@it;
                               rdfs:domain ctlog:AdditionalForm;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                               rdfs:label "identificativo del modulo di approfondimento"@it,
                                          "additional form identifier"@en;
                               rdfs:range rdfs:Literal;
                               rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                               owl:versionInfo "stabile"@it,
                                               "stable"@en;
                               ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPC".
ctlog:catalogueRecordIdentifier a owl:FunctionalProperty,
                                  owl:DatatypeProperty;
                                rdfs:comment "Questa proprietà permette di associare l'identificativo a una scheda catalografica che descrive un bene culturale."@it,
                                             "This property represents the identifier of a catalogue record describing a cultural property."@en;
                                rdfs:domain ctlog:CatalogueRecord;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "catalogue record identifier"@en,
                                           "identificativo della scheda di catalogo"@it;
                                rdfs:range rdfs:Literal;
                                rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                                owl:versionInfo "stable"@en,
                                                "stabile"@it;
                                ctlog:iccdNormTag "Concatenazione dei sottocampi di CD/NCT (NCTR, NCTN, NCTS) e RV/RVE/RVEL"@it.
ctlog:culturalPropertyRecordIdentifier a owl:DatatypeProperty;
                                       rdfs:comment "Questa proprietà permette di associare l'identificativo a una scheda in cui si analizza un bene culturale per finalità diverse da quella specificazione della catalogazione del patrimonio culturale."@it,
                                                    "This property is used to associate the identifier to a catalogue record that analyze the cultural property for reasons other than cataloguing the cultural heritage."@en;
                                       rdfs:domain ctlog:CulturalPropertyRecord;
                                       rdfs:label "identificativo di scheda su bene culturale"@it,
                                                  "cultural property record identifier"@en;
                                       rdfs:range rdfs:Literal;
                                       rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                                       owl:versionInfo "stabile"@it,
                                                       "stable"@en;
                                       ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS/ACSC".
ctlog:deletedICCDIdentifier a owl:DatatypeProperty;
                            rdfs:comment "This property represents the ICCD's identifier deleted for many reasons, used to search for obsolete catalogue records."@en,
                                         "Questa proprietà rappresenta un codice ICCD eventualmente soppresso per motivi di diversa natura, utile per poter ricercare e consultare le schede pregresse nell'Archivio storico gestito dall'Istituto o da altri Enti."@it;
                            rdfs:domain ctlog:CatalogueRecord;
                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                            rdfs:label "codice ICCD soppresso"@it,
                                       "deleted ICCD identifier"@en;
                            rdfs:range rdfs:Literal;
                            rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                            owl:versionInfo "stabile"@it,
                                            "stable"@en;
                            ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: RV/RSP; versioni precedenti: RV/RVE/RVES"@it.
ctlog:describes a owl:ObjectProperty;
                rdfs:comment "This property was created as a generic property for specific subproperties, and represents the relationship between an entity that describes another entity."@en,
                             "Questa proprietà è stata creata come proprietà generica di sottoproprietà specifiche, e rappresenta la relazione tra un'entità che descrive un'altra entità."@it;
                rdfs:domain owl:Thing;
                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                rdfs:label "describes"@en,
                           "descrive"@it;
                rdfs:range owl:Thing;
                owl:inverseOf ctlog:isDescribedBy;
                owl:versionInfo "stable"@en,
                                "stabile"@it.
ctlog:describesCulturalProperty a owl:ObjectProperty;
                                rdfs:comment "Proprietà che consente di associare la scheda di catalogo al bene culturale che essa descrive."@it,
                                             "Property used to associate the catalogue record with the cultural property that the catalogue record describes."@en;
                                rdfs:domain ctlog:CatalogueRecord;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "describes"@en,
                                           "descrive"@it;
                                rdfs:range cis:CulturalEntity;
                                rdfs:subPropertyOf ctlog:describes;
                                owl:inverseOf ctlog:isDescribedByCatalogueRecord;
                                owl:versionInfo "stabile"@it,
                                                "stable"@en.
ctlog:editedAtTime a owl:ObjectProperty;
                   rdfs:comment "Property used to associate a catalogue record version with the time interval in which it was edited."@en,
                                "Proprietà che associa una versione di una scheda di catalogo all'intervallo temporale in cui è stata compilata."@it;
                   rdfs:domain ctlog:CatalogueRecordVersion;
                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                   rdfs:label "compilato al tempo"@it,
                              "edited at time"@en;
                   rdfs:range <https://w3id.org/italia/onto/TI/TimeInterval>;
                   owl:inverseOf ctlog:editingTimeOf;
                   owl:versionInfo "stable"@en,
                                   "stabile"@it;
                   ctlog:iccdNormTag "CM/CMP/CMPD; CM/RVM/RVMD; CM/AGG/AGGD".
ctlog:editingTimeOf a owl:ObjectProperty;
                    rdfs:comment """Questa è la proprietà inversa di \"compilato al tempo\"."""@it,
                                 """This is the inverse property of \"edited at time\"."""@en;
                    rdfs:domain <https://w3id.org/italia/onto/TI/TimeInterval>;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                    rdfs:label "editing time of"@en,
                               "tempo di compilazione di"@it;
                    rdfs:range ctlog:CatalogueRecordVersion;
                    owl:versionInfo "stabile"@it,
                                    "stable"@en.
ctlog:hasAccessProfile a owl:ObjectProperty;
                       rdfs:comment "Questa proprietà collega una scheda di catalogo al profilo di accesso ai dati (basso, medio, alto)."@it;
                       rdfs:domain ctlog:CatalogueRecord;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "has access profile"@en,
                                  "ha profilo di accesso"@it;
                       rdfs:range ctlog:AccessProfile;
                       rdfs:subPropertyOf arco:hasCharacteristic;
                       owl:inverseOf ctlog:isAccessProfileOf;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en;
                       ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS".
ctlog:hasAdditionalFormResponsibleAgent a owl:ObjectProperty;
                                        rdfs:comment "Questa proprietà collega un modulo di approfondimento all'ente/il soggetto responsabile nel SIGECweb della redazione del modulo."@it,
                                                     "This property relates an additional form to the responsible agent of that form in the SIGECweb."@en;
                                        rdfs:domain ctlog:AdditionalForm;
                                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                        rdfs:label "ha responsabile di modulo di approfondimento"@it,
                                                   "has additional form responsible agent"@en;
                                        rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                        rdfs:subPropertyOf cdesc:hasRelatedAgent;
                                        owl:inverseOf ctlog:isAdditionalFormResponsibleAgentOf;
                                        owl:versionInfo "stabile"@it,
                                                        "stable"@en;
                                        ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPE".
ctlog:hasAdditionalFormType a owl:ObjectProperty;
                            rdfs:comment "This property relates an additional form to its type (Stratigraphic Unit, Epigraphy, Wall Typology)."@en,
                                         "Questa proprietà collega un modulo di approfondimento al tipo di modulo (Unità Stratigrafica, Tipo Murario, Epigrafia)."@it;
                            rdfs:domain ctlog:AdditionalForm;
                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                            rdfs:label "has additional form type"@en,
                                       "ha tipo di modulo di approfondimento"@it;
                            rdfs:range ctlog:AdditionalFormType;
                            rdfs:subPropertyOf arco:hasType;
                            owl:inverseOf ctlog:isAdditionalFormTypeOf;
                            owl:versionInfo "stable"@en,
                                            "stabile"@it;
                            ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP/APPT".
ctlog:hasAlternativeIdentifier a owl:ObjectProperty;
                               rdfs:comment "Property used to associate a catalogue record with an identifier created in the context of information systems other than ICCD's SIGECweb."@en,
                                            "Questa proprietà collega una scheda di catalogo a un codice che identifica la scheda di catalogo nell'ambito di altri sistemi informativi, assegnato da enti diversi da ICCD."@it;
                               rdfs:domain ctlog:CatalogueRecord;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                               rdfs:label "ha altro codice identificativo"@it,
                                          "has alternative identifier"@en;
                               rdfs:range ctlog:AlternativeIdentifier;
                               owl:inverseOf ctlog:isAlternativeIdentifierOf;
                               owl:versionInfo "stabile"@it,
                                               "stable"@en;
                               ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACC"@it.
ctlog:hasCatalogueRecordVersion a owl:ObjectProperty;
                                rdfs:comment "Proprietà che permette di collegare una scheda di catalogo, intesa come oggetto informativo che descrive un bene culturale, a una sua versione (corrispondente a un particolare stato dovuto a operazioni di redazione, aggiornamento, revisione)."@it,
                                             "Property used to associate a catalogue record to one of its versions (e.g. after update)"@en;
                                rdfs:domain ctlog:CatalogueRecord;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "ha versione"@it,
                                           "has version"@en;
                                rdfs:range ctlog:CatalogueRecordVersion;
                                owl:inverseOf ctlog:isCatalogueRecordVersionOf;
                                owl:versionInfo "stable"@en,
                                                "stabile"@it.
ctlog:hasCatalogueRecordVersionRiT a owl:ObjectProperty;
                                   rdfs:comment "Questa proprietà permette di associare una particolare versione di una scheda al ruolo nel tempo che un agente esercita nell'ambito della redazione, dell'aggiornamento o revisione della scheda."@it,
                                                "This property is used to associate a particular version of a catalogue record to the role in time of an agent that plays a role in updating the catalogue record."@en;
                                   rdfs:domain ctlog:CatalogueRecordVersion;
                                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                   rdfs:label "has role in time"@en,
                                              "ha ruolo nel tempo"@it;
                                   rdfs:range <https://w3id.org/italia/onto/RO/TimeIndexedRole>;
                                   rdfs:subPropertyOf <https://w3id.org/italia/onto/RO/hasRiT>;
                                   owl:inverseOf ctlog:isCatalogueRecordVersionRiTOf;
                                   owl:versionInfo "stable"@en,
                                                   "stabile"@it.
ctlog:hasCataloguingAgent a owl:ObjectProperty;
                          rdfs:comment "This property is used to associate a catalogue record to an agent playing a role in cataloguing activities."@en,
                                       "Questa proprietà rappresenta la relazione che collega una versione di una scheda di catalogo a un agente che riveste un ruolo nelle attività di catalogazione di quella scheda. La relazione tra il ruolo e l'agente che lo riveste è espressa, in maniera generica, nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Questa relazione è poi specializzata da sottoproprietà. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l’ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                          rdfs:domain ctlog:CatalogueRecordVersion;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                          rdfs:label "has cataloguing agent"@en,
                                     "ha agente coinvolto nella catalogazione"@it;
                          rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                          rdfs:subPropertyOf cdesc:hasRelatedAgent;
                          owl:inverseOf ctlog:isCataloguingAgentOf;
                          owl:propertyChainAxiom (<https://w3id.org/italia/onto/RO/hasRiT>
                                                  <https://w3id.org/italia/onto/RO/isRoleInTimeOf>);
                          owl:versionInfo "stable"@en,
                                          "stabile"@it.
ctlog:hasCataloguingLevel a owl:ObjectProperty;
                          rdfs:comment "Questa proprietà permette di associare una scheda di catalogo al suo livello di catalogazione."@it;
                          rdfs:domain ctlog:CatalogueRecord;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                          rdfs:label "has cataloguing level"@en,
                                     "ha livello di catalogazione"@it;
                          rdfs:range ctlog:CataloguingLevel;
                          rdfs:subPropertyOf arco:hasCharacteristic;
                          owl:inverseOf ctlog:isCataloguingLevelOf;
                          owl:versionInfo "stabile"@it,
                                          "stable"@en;
                          ctlog:iccdNormTag "CD/LIR".
ctlog:hasCulturalPropertyRecordResponsibleAgent a owl:ObjectProperty;
                                                rdfs:comment "Questa proprietà collega una scheda in cui si analizza un bene culturale per finalità diverse da quella della catalogazione del patrimonio all'Ente o al soggetto che ha prodotto la scheda o che gestisce la banca dati di cui la scheda fa parte."@it,
                                                             "This property relates a cultural property record to the agency or the person that created that record or manages the database where the record is."@en;
                                                rdfs:domain ctlog:CulturalPropertyRecord;
                                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                                rdfs:label "ha agente responsabile della scheda su bene culturale"@it,
                                                           "has cultural property record responsible agent"@en;
                                                rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                                rdfs:subPropertyOf cdesc:hasRelatedAgent;
                                                owl:inverseOf ctlog:isResponsibleAgentOfCulturalPropertyRecord;
                                                owl:versionInfo "stable"@en,
                                                                "stabile"@it;
                                                ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS/ACSE".
ctlog:hasDigitalTranscriptionOperator a owl:ObjectProperty;
                                      rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione, relativa a trascrizione per informatizzazione, di una scheda di catalogo al relativo operatore. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                      rdfs:domain ctlog:CatalogueRecordVersion;
                                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                      rdfs:label "has digital transcription operator"@en,
                                                 "ha operatore di trascrizione per informatizzazione"@it;
                                      rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                      rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                      owl:inverseOf ctlog:isDigitalTranscriptionOperatorOf;
                                      owl:versionInfo "stabile"@it,
                                                      "stable"@en;
                                      ctlog:iccdNormTag "CM/RVM/RVMN".
ctlog:hasDigitalTranscriptionResponsibleAgent a owl:ObjectProperty;
                                              rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione, relativa a trascrizione per informatizzazione, di una scheda di catalogo al relativo ente/soggetto responsabile. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                              rdfs:domain ctlog:CatalogueRecordVersion;
                                              rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                              rdfs:label "has digital transcription responsible agent"@en,
                                                         "ha ente o soggetto responsabile di trascrizione per informatizzazione"@it;
                                              rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                              rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                              owl:inverseOf ctlog:isDigitalTranscriptionResponsibleAgentOf;
                                              owl:versionInfo "stable"@en,
                                                              "stabile"@it;
                                              ctlog:iccdNormTag "CM/RVM/RVME".
ctlog:hasImmediatePreviousVersion <http://ontologydesignpatterns.org/opla/isNativeTo> <https://w3id.org/arco/pattern/catalogue-record-sequence/>;
                                  a owl:FunctionalProperty,
                                    owl:ObjectProperty;
                                  rdfs:comment "Property used to associate a catalogue record version to its immediate previous version."@en,
                                               "Questa proprietà associa una versione di una scheda alla sua versione immediatamente precedente."@it;
                                  rdfs:domain ctlog:CatalogueRecordVersion;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                  rdfs:label "ha la versione precedente"@it,
                                             "has immediate previous version"@en;
                                  rdfs:range ctlog:CatalogueRecordVersion;
                                  rdfs:subPropertyOf ctlog:hasPreviousVersion;
                                  owl:inverseOf ctlog:isImmediatePreviousVersionOf;
                                  owl:versionInfo "stabile"@it,
                                                  "stable"@en.
ctlog:hasOfficialInCharge a owl:ObjectProperty;
                          rdfs:comment "Questa proprietà rappresenta la relazione che collega la prima versione di una scheda di catalogo al relativo funzionario responsabile. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                          rdfs:domain ctlog:CatalogueRecordVersion;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                          rdfs:label "has official in charge"@en,
                                     "ha funzionario responsabile"@it;
                          rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                          rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                          owl:inverseOf ctlog:isOfficialInChargeOf;
                          owl:versionInfo "stable"@en,
                                          "stabile"@it;
                          ctlog:iccdNormTag "CM/FUR".
ctlog:hasPreviousVersion <http://ontologydesignpatterns.org/opla/isNativeTo> <https://w3id.org/arco/pattern/catalogue-record-sequence/>;
                         a owl:TransitiveProperty,
                           owl:ObjectProperty;
                         rdfs:comment "Questa proprietà associa una versione di una scheda a una sua versione precedente."@it,
                                      "Property used to associate a catalogue record version to its previous version."@en;
                         rdfs:domain ctlog:CatalogueRecordVersion;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                         rdfs:label "has previous version"@en,
                                    "ha versione precedente"@it;
                         rdfs:range ctlog:CatalogueRecordVersion;
                         rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/follows>;
                         owl:inverseOf ctlog:isPreviousVersionOf;
                         owl:versionInfo "stabile"@it,
                                         "stable"@en.
ctlog:hasPrivacyLevel a owl:ObjectProperty;
                      rdfs:comment "Questa proprietà collega il profilo di accesso di una scheda catalografica al livello di riservatezza dei dati contenutevi (basso livello di riservatezza, alto livello di riservatezza, medio livello di riservatezza)."@it;
                      rdfs:domain ctlog:AccessProfile;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                      rdfs:label "ha livello di riservatezza"@it,
                                 "has privacy level"@en;
                      rdfs:range ctlog:PrivacyLevel;
                      rdfs:subPropertyOf arco:hasCharacteristic;
                      owl:inverseOf ctlog:isPrivacyLevelOf;
                      owl:versionInfo "stabile"@it,
                                      "stable"@en;
                      ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS".
ctlog:hasPrivacyReason a owl:ObjectProperty;
                       rdfs:comment "Questa proprietà collega uno specifico profilo d'accesso ai dati di una scheda catalografica alla motivazione che ha determinato l'adozione di quel profilo d'accesso (es.: scheda contenente dati liberamente accessibili, scheda contenente dati personali, scheda di bene di proprietà privata, scheda di bene a rischio, scheda di bene non adeguatamente sorvegliabile)"@it;
                       rdfs:domain ctlog:AccessProfile;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "has privacy reason"@en,
                                  "ha motivazione di riservatezza"@it;
                       rdfs:range ctlog:PrivacyReason;
                       rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasDescription>;
                       owl:inverseOf ctlog:isPrivacyReasonOf;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en;
                       ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AD/ADS/ADSM".
ctlog:hasResponsibleResearchAndCompilation a owl:ObjectProperty;
                                           rdfs:comment "Questa proprietà rappresenta la relazione che collega la prima versione di una scheda di catalogo al relativo responsabile ricerca e redazione. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                           rdfs:domain ctlog:CatalogueRecordVersion;
                                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                           rdfs:label "ha responsabile ricerca e redazione"@it,
                                                      "has responsible research and compilation"@en;
                                           rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                           rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                           owl:inverseOf ctlog:isResponsibleResearchAndCompilationOf;
                                           owl:versionInfo "stable"@en,
                                                           "stabile"@it;
                                           ctlog:iccdNormTag "CM/CMP/CMPN".
ctlog:hasScientificDirector a owl:ObjectProperty;
                            rdfs:comment "Questa proprietà rappresenta la relazione che collega la prima versione di una scheda di catalogo al relativo referente verifica scientifica. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                            rdfs:domain ctlog:CatalogueRecordVersion;
                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                            rdfs:label "has scientific director"@en,
                                       "ha referente verifica scientifica"@it;
                            rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                            rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                            owl:inverseOf ctlog:isScientificDirectorOf;
                            owl:versionInfo "stable"@en,
                                            "stabile"@it;
                            ctlog:iccdNormTag "CM/RSR".
ctlog:hasUpdateOfficialInCharge a owl:ObjectProperty;
                                rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione aggiornata di una scheda di catalogo al relativo funzionario responsabile. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                rdfs:domain ctlog:CatalogueRecordVersion;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "has update official in charge"@en,
                                           "ha funzionario responsabile di aggiornamento"@it;
                                rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                owl:inverseOf ctlog:isUpdateOfficialInChargeOf;
                                owl:versionInfo "stable"@en,
                                                "stabile"@it;
                                ctlog:iccdNormTag "CM/AGG/AGGF".
ctlog:hasUpdateResponsibleAgent a owl:ObjectProperty;
                                rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione aggiornata di una scheda di catalogo al relativo ente/soggetto responsabile. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                rdfs:domain ctlog:CatalogueRecordVersion;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "has update responsible agency or person"@en,
                                           "ha ente o soggetto responsabile di aggiornamento"@it;
                                rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                owl:inverseOf ctlog:isUpdateResponsibleAgentOf;
                                owl:versionInfo "stabile"@it,
                                                "stable"@en;
                                ctlog:iccdNormTag "CM/AGG/AGGE".
ctlog:hasUpdateResponsibleResearchAndCompilation a owl:ObjectProperty;
                                                 rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione aggiornata di una scheda di catalogo al relativo responsabile ricerca e redazione. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                                 rdfs:domain ctlog:CatalogueRecordVersion;
                                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                                 rdfs:label "ha responsabile di ricerca e redazione di aggiornamento"@it,
                                                            "has update responsible research and compilation"@en;
                                                 rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                                 rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                                 owl:inverseOf ctlog:isUpdateResponsibleResearchAndCompilationOf;
                                                 owl:versionInfo "stabile"@it,
                                                                 "stable"@en;
                                                 ctlog:iccdNormTag "CM/AGG/AGGN".
ctlog:hasUpdateScientificRevisor a owl:ObjectProperty;
                                 rdfs:comment "Questa proprietà rappresenta la relazione che collega una versione aggiornata di una scheda di catalogo al relativo referente verifica scientifica. La relazione tra il ruolo e l'ente che lo riveste è espressa nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. Nell'ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l'ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                 rdfs:domain ctlog:CatalogueRecordVersion;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                 rdfs:label "ha referente verifica scientifica di aggiornamento"@it,
                                            "has update scientific revisor"@en;
                                 rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                 rdfs:subPropertyOf ctlog:hasCataloguingAgent;
                                 owl:inverseOf ctlog:isUpdateScientificRevisorOf;
                                 owl:versionInfo "stabile"@it,
                                                 "stable"@en;
                                 ctlog:iccdNormTag "CM/AGG/AGGR".
ctlog:iccdNormTag a owl:AnnotationProperty;
                  rdfs:comment "Questa proprietà permette di annotare il campo o i campi della normativa ICCD corrispondenti a una determinata classe o proprietà dell'ontologia."@it,
                               "This property annotates the field or the fields of the ICCD regulation to which a specific class or property refers."@en;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                  rdfs:label "ICCD norm tag"@en,
                             "acronimo normativa ICCD"@it;
                  owl:versionInfo "stabile"@it,
                                  "stable"@en.
ctlog:informationFormIdentifier a owl:DatatypeProperty,
                                  owl:FunctionalProperty;
                                rdfs:comment "Questa proprietà permette di associare l'identificativo a un modulo informativo che è collegato a un bene culturale."@it,
                                             "This property links an identifier to an information form related to a cultural property."@en;
                                rdfs:domain ctlog:InformationForm;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "information form identifier"@en,
                                           "identificativo del modulo informativo"@it;
                                rdfs:range rdfs:Literal;
                                rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                                owl:versionInfo "stabile"@it,
                                                "stable"@en;
                                ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/MOD/MODI".
ctlog:isAccessProfileOf a owl:ObjectProperty;
                        rdfs:comment """Questa è la proprietà inversa di \"ha profilo di accesso\"."""@it,
                                     """This is the inverse property of \"has access profile\"."""@en;
                        rdfs:domain ctlog:AccessProfile;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "è profilo di accesso di"@it,
                                   "is access profile of"@en;
                        rdfs:range ctlog:CatalogueRecord;
                        rdfs:subPropertyOf arco:isCharacteristicOf;
                        owl:versionInfo "stable"@en,
                                        "stabile"@it.
ctlog:isAdditionalFormResponsibleAgentOf a owl:ObjectProperty;
                                         rdfs:comment """Questa è la proprietà inversa di \"ha responsabile di modulo di approfondimento\"."""@it,
                                                      """This is the inverse property of \"has additional form responsible agent\""""@en;
                                         rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                         rdfs:label "è responsabile di modulo di approfondimento"@it,
                                                    "is additional form responsible agent of"@en;
                                         rdfs:range ctlog:AdditionalForm;
                                         rdfs:subPropertyOf cdesc:isAgentRelatedTo;
                                         owl:versionInfo "stabile"@it,
                                                         "stable"@en.
ctlog:isAdditionalFormTypeOf a owl:ObjectProperty;
                             rdfs:comment """Questa è la proprietà inversa di \"ha tipo di modulo di approfondimento\"."""@it,
                                          """This is the inverse property of \"has additional form type\"."""@en;
                             rdfs:domain ctlog:AdditionalFormType;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                             rdfs:label "is additional form type of"@en,
                                        "è tipo di modulo di approfondimento di"@it;
                             rdfs:range ctlog:AdditionalForm;
                             rdfs:subPropertyOf arco:isTypeOf;
                             owl:versionInfo "stable"@en,
                                             "stabile"@it.
ctlog:isAlternativeIdentifierOf a owl:ObjectProperty;
                                rdfs:comment """This is the inverse property of \"has alternative identifier\"."""@en,
                                             """Questa è la proprietà inversa di \"ha altro codice identificativo\"."""@it;
                                rdfs:domain ctlog:AlternativeIdentifier;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "is alternative identifier of"@en,
                                           "è altro codice identificativo di"@it;
                                rdfs:range ctlog:CatalogueRecord;
                                owl:versionInfo "stabile"@it,
                                                "stable"@en.
ctlog:isCatalogueRecordVersionOf a owl:ObjectProperty;
                                 rdfs:comment """Property, inverse of \"has catalogue record version\", used to associate a catalogue record version (e.g. after update) to the catalogue record."""@en,
                                              """Proprietà, inversa di \"ha versione\", che permette di collegare una versione  (corrispondente a un particolare stato dovuto a operazioni di redazione, aggiornamento, revisione) di una scheda di catalogo alla scheda di catalogo intesa come oggetto informativo che descrive un bene culturale."""@it;
                                 rdfs:domain ctlog:CatalogueRecordVersion;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                 rdfs:label "è versione di"@it,
                                            "is catalogue record version of"@en;
                                 rdfs:range ctlog:CatalogueRecord;
                                 owl:versionInfo "stable"@en,
                                                 "stabile"@it.
ctlog:isCatalogueRecordVersionRiTOf a owl:ObjectProperty;
                                    rdfs:comment """Property, inverse of \"has catalogue record version role in time\", used to associate a role in time to the agent playing that role, in the updating of a particular version of a catalogue record."""@en,
                                                 """Questa proprietà, inversa a \"ha ruolo nel tempo\", permette di associare il ruolo nel tempo che un agente esercita nell'ambito della redazione, dell'aggiornamento o revisione della scheda a una particolare versione di una scheda."""@it;
                                    rdfs:domain <https://w3id.org/italia/onto/RO/TimeIndexedRole>;
                                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                    rdfs:label "è ruolo nel tempo di"@it,
                                               "is role in time of"@en;
                                    rdfs:range ctlog:CatalogueRecordVersion;
                                    owl:versionInfo "stable"@en,
                                                    "stabile"@it.
ctlog:isCataloguingAgentOf a owl:ObjectProperty;
                           rdfs:comment """This property, inverse of \"has cataloguin agent\", is used to associate an agent playing a role in cataloguing activities to the catalogue record."""@en,
                                        """Questa proprietà, inversa a \"ha agente coinvolto nella catalogazione\", rappresenta la relazione che collega un agente che riveste un ruolo nelle attività di catalogazione di una scheda di catalogo alla scheda stessa."""@it;
                           rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                           rdfs:label "è agente coinvolto nella catalogazione di"@it,
                                      "is cataloguing agent of"@en;
                           rdfs:range ctlog:CatalogueRecordVersion;
                           rdfs:subPropertyOf cdesc:isAgentRelatedTo;
                           owl:versionInfo "stable"@en,
                                           "stabile"@it.
ctlog:isCataloguingLevelOf a owl:ObjectProperty;
                           rdfs:comment """Questa è la proprietà inversa di \"ha livello di catalogazione\"."""@it,
                                        """This is the inverse property of \"has cataloguing level\"."""@en;
                           rdfs:domain ctlog:CataloguingLevel;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                           rdfs:label "è livello di catalogazione di"@it,
                                      "is cataloguing level of"@en;
                           rdfs:range ctlog:CatalogueRecord;
                           rdfs:subPropertyOf arco:isCharacteristicOf;
                           owl:versionInfo "stabile"@it,
                                           "stable"@en.
ctlog:isDescribedBy a owl:ObjectProperty;
                    rdfs:comment """This property, inverse property of \"describes\", was created as a generic property for specific subproperties, and represents the relationship between an entity described by another entity."""@en,
                                 """Questa proprietà, inversa della proprietà \"descrive\", è stata creata come proprietà generica di sottoproprietà specifiche, e rappresenta la relazione tra un'entità descritta da un'altra entità."""@it;
                    rdfs:domain owl:Thing;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                    rdfs:label "is described by"@en,
                               "è descritto da"@it;
                    rdfs:range owl:Thing;
                    owl:versionInfo "stable"@en,
                                    "stabile"@it.
ctlog:isDescribedByCatalogueRecord a owl:ObjectProperty;
                                   rdfs:comment """Questa proprietà, inversa di \"descrive\", permette di associare un bene culturale alla scheda di catalogo che lo descrive."""@it,
                                                """This property, inverse of \"describes\", is used to associate a cultural property with the catalogue record that describes it."""@en;
                                   rdfs:domain cis:CulturalEntity;
                                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                   rdfs:label "è descritto da"@it,
                                              "is described by"@en;
                                   rdfs:range ctlog:CatalogueRecord;
                                   rdfs:subPropertyOf ctlog:isDescribedBy;
                                   owl:versionInfo "stable"@en,
                                                   "stabile"@it.
ctlog:isDigitalTranscriptionOperatorOf a owl:ObjectProperty;
                                       rdfs:comment """Questa è la proprietà inversa a \"ha operatore di trascrizione per informatizzazione\"."""@it,
                                                    """This is the inverse property of \"has digital transcription operator\"."""@en;
                                       rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                       rdfs:label "is digital transcription operator of"@en,
                                                  "è operatore di trascrizione per informatizzazione di"@it;
                                       rdfs:range ctlog:CatalogueRecordVersion;
                                       rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                       owl:versionInfo "stable"@en,
                                                       "stabile"@it.
ctlog:isDigitalTranscriptionResponsibleAgentOf a owl:ObjectProperty;
                                               rdfs:comment """This is the inverse property of \"has digital transcription responsible agent\"."""@en,
                                                            """Questa è la proprietà inversa a \"ha ente o soggetto responsabile di trascrizione per informatizzazione\"."""@it;
                                               rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                               rdfs:label "è ente o soggetto responsabile di trascrizione per informatizzazione di"@it,
                                                          "is digital transcription responsible agent of"@en;
                                               rdfs:range ctlog:CatalogueRecordVersion;
                                               rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                               owl:versionInfo "stable"@en,
                                                               "stabile"@it.
ctlog:isImmediatePreviousVersionOf <http://ontologydesignpatterns.org/opla/isNativeTo> <https://w3id.org/arco/pattern/catalogue-record-sequence/>;
                                   a owl:ObjectProperty,
                                     owl:FunctionalProperty;
                                   rdfs:comment "Property used to associate a catalogue record version to its immediate next version."@en,
                                                "Questa proprietà associa una versione di una scheda alla sua versione immediatamente successiva."@it;
                                   rdfs:domain ctlog:CatalogueRecordVersion;
                                   rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                   rdfs:label "è la versione precedente di"@it,
                                              "is immediate previous version of"@en;
                                   rdfs:range ctlog:CatalogueRecordVersion;
                                   rdfs:subPropertyOf ctlog:isPreviousVersionOf;
                                   owl:versionInfo "stabile"@it,
                                                   "stable"@en.
ctlog:isOfficialInChargeOf a owl:ObjectProperty;
                           rdfs:comment """This is the inverse property of \"has official in charge\"."""@en,
                                        """Questa è la proprietà inversa a \"ha funzionario responsabile\"."""@it;
                           rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                           rdfs:label "è funzionario responsabile di"@it,
                                      "is official in charge of"@en;
                           rdfs:range ctlog:CatalogueRecordVersion;
                           rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                           owl:versionInfo "stable"@en,
                                           "stabile"@it.
ctlog:isPreviousVersionOf <http://ontologydesignpatterns.org/opla/isNativeTo> <https://w3id.org/arco/pattern/catalogue-record-sequence/>;
                          a owl:ObjectProperty,
                            owl:TransitiveProperty;
                          rdfs:comment "Questa proprietà associa una versione di una scheda a una sua versione successiva."@it,
                                       "Property used to associate a catalogue record version one of its next version."@en;
                          rdfs:domain ctlog:CatalogueRecordVersion;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                          rdfs:label "è versione precedente di"@it,
                                     "is previous version of"@en;
                          rdfs:range ctlog:CatalogueRecordVersion;
                          rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/precedes>;
                          owl:versionInfo "stabile"@it,
                                          "stable"@en.
ctlog:isPrivacyLevelOf a owl:ObjectProperty;
                       rdfs:comment """This is the inverse property of \"has privacy level\"."""@en,
                                    """Questa è la proprietà inversa di \"ha livello di riservatezza\"."""@it;
                       rdfs:domain ctlog:PrivacyLevel;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "è livello di riservatezza di"@it,
                                  "is privacy level of"@en;
                       rdfs:range ctlog:AccessProfile;
                       rdfs:subPropertyOf arco:isCharacteristicOf;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en.
ctlog:isPrivacyReasonOf a owl:ObjectProperty;
                        rdfs:comment """This is the inverse property of \"has privacy reason\"."""@en,
                                     """Questa è la proprietà inversa di \"ha motivazione di riservatezza\"."""@it;
                        rdfs:domain ctlog:PrivacyReason;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                        rdfs:label "è motivazione di riservatezza di"@it,
                                   "is privacy reason of"@en;
                        rdfs:range ctlog:AccessProfile;
                        rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/isDescriptionOf>;
                        owl:versionInfo "stable"@en,
                                        "stabile"@it.
ctlog:isRelatedToAdditionalForm a owl:ObjectProperty;
                                rdfs:comment "Questa proprietà collega un bene culturale a un modulo di approfondimento in relazione con il bene in esame."@it,
                                             "This property relates a cultural property to an additional form."@en;
                                rdfs:domain cis:CulturalEntity;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                rdfs:label "è collegato a modulo di approfondimento"@it,
                                           "is related to additional form"@en;
                                rdfs:range ctlog:AdditionalForm;
                                owl:versionInfo "stable"@en,
                                                "stabile"@it;
                                ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: DA/APP".
ctlog:isRelatedToInformationForm a owl:ObjectProperty;
                                 rdfs:comment "Questa proprietà collega un bene culturale a un modulo informativo in relazione con il bene in esame."@it,
                                              "This property relates a cultural property to an information form."@en;
                                 rdfs:domain cis:CulturalEntity;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                 rdfs:label "is related to information form"@en,
                                            "è collegato a modulo informativo"@it;
                                 rdfs:range ctlog:InformationForm;
                                 owl:versionInfo "stable"@en,
                                                 "stabile"@it;
                                 ctlog:iccdNormTag "ICCD Normativa Trasvesale 4.00: AC/MOD".
ctlog:isResponsibleAgentOfCulturalPropertyRecord a owl:ObjectProperty;
                                                 rdfs:comment """Questa proprietà, inversa a \"ha agente responsabile di scheda su bene culturale\", collega l'Ente o il soggetto che ha prodotto la scheda o che gestisce la banca dati di cui la scheda fa parte alla scheda stessa."""@it,
                                                              """This property, inverse of \"has cultural property record responsible agent\", relates the agency or the person that created the record or manages the database where the record is to the record itself."""@en;
                                                 rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                                 rdfs:label "is responsible agent of cultural property record"@en,
                                                            "è ente responsabile della scheda su bene culturale"@it;
                                                 rdfs:range ctlog:CulturalPropertyRecord;
                                                 owl:versionInfo "stabile"@it,
                                                                 "stable"@en;
                                                 ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACS/ACSE".
ctlog:isResponsibleResearchAndCompilationOf a owl:ObjectProperty;
                                            rdfs:comment """Questa è la proprietà inversa a \"ha responsabile ricerca e redazione\"."""@it,
                                                         """This is the inverse property of \"has responsible research and compilation\"."""@en;
                                            rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                            rdfs:label "è responsabile ricerca e redazione di"@it,
                                                       "is responsible research and compilation of"@en;
                                            rdfs:range ctlog:CatalogueRecordVersion;
                                            rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                            owl:versionInfo "stable"@en,
                                                            "stabile"@it.
ctlog:isScientificDirectorOf a owl:ObjectProperty;
                             rdfs:comment """This is the inverse property of \"has scientific director\"."""@en,
                                          """Questa è la proprietà inversa a \"ha referente verifica scientifica\"."""@it;
                             rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                             rdfs:label "è referente verifica scientifica di"@it,
                                        "is scientific director of"@en;
                             rdfs:range ctlog:CatalogueRecordVersion;
                             rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                             owl:versionInfo "stable"@en,
                                             "stabile"@it.
ctlog:isUpdateOfficialInChargeOf a owl:ObjectProperty;
                                 rdfs:comment """This is the inverse property of \"has update official in charge\"."""@en,
                                              """Questa è la proprietà inversa a \"ha funzionario responsabile di aggiornamento\"."""@it;
                                 rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                 rdfs:label "is update official in charge of"@en,
                                            "è funzionario responsabile di aggiornamento di"@it;
                                 rdfs:range ctlog:CatalogueRecordVersion;
                                 rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                 owl:versionInfo "stable"@en,
                                                 "stabile"@it.
ctlog:isUpdateResponsibleAgentOf a owl:ObjectProperty;
                                 rdfs:comment """Questa è la proprietà inversa a \"ha ente o soggetto responsabile di aggiornamento\"."""@it,
                                              """This is the inverse property of \"has update responsible agent\","""@en;
                                 rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                 rdfs:label "is update responsible agent of"@en,
                                            "è ente o soggetto responsabile di aggiornamento di"@it;
                                 rdfs:range ctlog:CatalogueRecordVersion;
                                 rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                 owl:versionInfo "stabile"@it,
                                                 "stable"@en.
ctlog:isUpdateResponsibleResearchAndCompilationOf a owl:ObjectProperty;
                                                  rdfs:comment """This is the inverse property of \"has update responsible research and compilation\"."""@en,
                                                               """Questa è la proprietà inversa a \"ha responsabile di ricerca e redazione di aggiornamento\"."""@it;
                                                  rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                                  rdfs:label "è responsabile di ricerca e redazione di aggiornamento di"@it,
                                                             "is update responsible research and compilation of"@en;
                                                  rdfs:range ctlog:CatalogueRecordVersion;
                                                  rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                                  owl:versionInfo "stabile"@it,
                                                                  "stable"@en.
ctlog:isUpdateScientificRevisorOf a owl:ObjectProperty;
                                  rdfs:comment """Questa è la proprietà inversa a \"ha referente verifica scientifica di aggiornamento\"."""@it,
                                               """This is the inverse property of \"has update scientific revisor\"."""@en;
                                  rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                                  rdfs:label "is update scientific revisor of"@en,
                                             "è referente verifica scientifica di aggiornamento di"@it;
                                  rdfs:range ctlog:CatalogueRecordVersion;
                                  rdfs:subPropertyOf ctlog:isCataloguingAgentOf;
                                  owl:versionInfo "stabile"@it,
                                                  "stable"@en.
ctlog:localIdentifier a owl:DatatypeProperty,
                        owl:FunctionalProperty;
                      rdfs:comment "This property represents a unique identifier of an entity, within a local inventory."@en,
                                   "Questa proprietà rappresenta un identificativo che individua un'entità in modo univoco nell'ambito di un repertorio locale. Si specializza in sottoproprietà (es.: identificativo dell'autore nell'ambito di un repertorio locale, identificativo dell'indagine archeologica nell'ambito di un repertorio locale, etc.)"@it;
                      rdfs:domain owl:Thing;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                      rdfs:label "local identifier"@it,
                                 "identificativo di repertorio locale"@it;
                      rdfs:range rdfs:Literal;
                      rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                      owl:versionInfo "stabile"@it,
                                      "stable"@en.
ctlog:recoveredData a owl:DatatypeProperty;
                    rdfs:comment "Questa proprietà rappresenta eventuali informazioni provenienti da schede pregresse redatte sulla base di standard obsoleti, per le quali non è stato possibile effettuare il trasferimento nel tracciato della scheda aggiornato, secondo la sintassi: “acronimocampo: valore; acronimocampo: valore”"@it,
                                 "This property represents information extracted from versions of a catalogue record using obsolete standards."@en;
                    rdfs:domain ctlog:CatalogueRecord;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                    rdfs:label "dati pregressi recuperati"@it,
                               "recovered data"@en;
                    rdfs:range rdfs:Literal;
                    owl:versionInfo "stabile"@it,
                                    "stable"@en;
                    ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AN/RDP".
ctlog:referenceProject a owl:DatatypeProperty;
                       rdfs:comment "Questa proprietà rappresenta il progetto nell'ambito del quale è stata prodotta una scheda, quella a cui si associa un codice alternativo, assegnato da enti diversi da ICCD, o quella che analizza un bene culturale per finalità diverse da quella specifica della catalogazione del patrimonio culturale."@it,
                                    "This property represents the reference project of a record about a cultural property."@en;
                       rdfs:domain [owl:unionOf (ctlog:AlternativeIdentifier
                                                 ctlog:CulturalPropertyRecord) ; 
                                    a owl:Class];
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "reference project"@en,
                                  "progetto di riferimento"@it;
                       rdfs:range rdfs:Literal;
                       owl:versionInfo "stabile"@it,
                                       "stable"@en;
                       ctlog:iccdNormTag "ICCD Normativa Trasversale 4.00: AC/ACC/ACCP; AC/ACS/ACSP".
ctlog:systemRecordCode a owl:DatatypeProperty,
                         owl:FunctionalProperty;
                       rdfs:comment "This property represents the identifier associated in the context of the SIGECweb to the xml file containing a catalogue record."@en,
                                    "Questa proprietà rappresenta l'identificativo di sistema che viene associato all'interno del sistema Sigec al file xml contenente una scheda di catalogo."@it;
                       rdfs:domain ctlog:CatalogueRecord;
                       rdfs:isDefinedBy <https://w3id.org/arco/ontology/catalogue>;
                       rdfs:label "identificativo di sistema"@it,
                                  "system record code"@en;
                       rdfs:range rdfs:Literal;
                       rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                       owl:versionInfo "stable"@en,
                                       "stabile"@it.
