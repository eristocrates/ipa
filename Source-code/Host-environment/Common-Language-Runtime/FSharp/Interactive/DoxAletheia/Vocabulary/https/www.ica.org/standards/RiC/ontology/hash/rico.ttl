                   skos:changeNote [dc11:date "2021-01-22" ; 
                                    rdf:value "changed the superproperty IRI."@en];
                   rico:RiCCMCorrespondingComponent """RiC-R009i ('follows in time'
            relation)"""@en.
rico:followsOrFollowed a owl:ObjectProperty;
                       rdfs:comment "Inverse of 'precedesOrPreceded' object property."@en;
                       rdfs:domain rico:Thing;
                       rdfs:isDefinedBy <https://www.ica.org/standards/RiC/ontology>;
