rico:followsInTime a owl:ObjectProperty;
                   rdfs:comment "Inverse of 'precedes in time' object property."@en;
                   rdfs:domain rico:Thing;
                   rdfs:isDefinedBy <https://www.ica.org/standards/RiC/ontology>;
