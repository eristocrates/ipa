                  rdfs:label "has or had part"@en;
                  rdfs:range rico:Thing;
                  rdfs:subPropertyOf rico:isRelatedTo;
                  owl:inverseOf rico:isOrWasPartOf;
                  owl:propertyChainAxiom (rico:thingIsSourceOfWholePartRelation
                                          rico:wholePartRelationHasTarget);
                  skos:changeNote [dc11:date "2021-01-22" ; 
                                   rdf:value """changed the IRI, label, inverse property IRI, textual
                    definition (changed made in order to make RiC-O compliant with RiC-CM 0.2; the
                    name of this property in RiC-O 0.1 was \"hasPart\")."""@en];
                  skos:scopeNote """The end of existence of a whole/part relation may affect the
            integrity or nature of the domain entity"""@en;
                  rico:RiCCMCorrespondingComponent """RiC-R002 (has or had part
            relation)"""@en.
rico:hasOrHadParticipant a owl:ObjectProperty;
                         rdfs:comment """Connects an Event to a Thing that is or was actively or
            passively involved in it."""@en;
                         rdfs:domain rico:Event;
                         rdfs:isDefinedBy <https://www.ica.org/standards/RiC/ontology>;
                         rdfs:label "has or had participant"@en;
                         rdfs:range rico:Thing;
                         rdfs:subPropertyOf rico:isEventAssociatedWith;
                         owl:inverseOf rico:isOrWasParticipantIn;
