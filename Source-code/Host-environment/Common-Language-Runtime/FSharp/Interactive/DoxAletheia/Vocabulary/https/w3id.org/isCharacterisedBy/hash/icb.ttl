@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix swrl: <http://www.w3.org/2003/11/swrl#>.
@prefix w3id: <https://w3id.org/>.
@prefix icb: <https://w3id.org/isCharacterisedBy#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

_:B0ca4782d610bd4c76684358561887f75 a swrl:Imp;
                                    swrl:body ([swrl:argument1 <urn:swrl:var#p> ; 
                                               swrl:classPredicate icb:Property ; 
                                               a swrl:ClassAtom]
                                               [swrl:argument1 <urn:swrl:var#soi> ; 
                                               swrl:classPredicate icb:SubjectOfInterest ; 
                                               a swrl:ClassAtom]
                                               [swrl:argument2 <urn:swrl:var#p> ; 
                                               swrl:argument1 <urn:swrl:var#soc> ; 
                                               swrl:propertyPredicate icb:isCharacterisedBy ; 
                                               a swrl:IndividualPropertyAtom]
                                               [swrl:argument1 <urn:swrl:var#soc> ; 
                                               swrl:classPredicate icb:SubjectOfInterest ; 
                                               a swrl:ClassAtom]
                                               [swrl:argument2 <urn:swrl:var#soc> ; 
                                               swrl:argument1 <urn:swrl:var#soi> ; 
                                               swrl:propertyPredicate icb:belongsTo ; 
                                               a swrl:IndividualPropertyAtom]);
                                    swrl:head ([swrl:argument2 <urn:swrl:var#p> ; 
                                               swrl:argument1 <urn:swrl:var#soi> ; 
                                               swrl:propertyPredicate icb:isCharacterisedBy ; 
                                               a swrl:IndividualPropertyAtom]).
_:B1377fe2954f247cb1b593ddc27a46f49 a swrl:AtomList.
() a swrl:AtomList.
() a swrl:AtomList.
_:B671913febc1a5e524f1dcf54dc33a80c a swrl:AtomList.
_:B6980941f01b56effcef1efbd74364195 a owl:AllDisjointClasses;
                                    owl:members (icb:Property
                                                 icb:SubjectOfInterest
                                                 icb:Unit).
_:B748383fc1eaee9c470e9b5a908718c3a a swrl:AtomList.
_:Bc56d413e16eaad4194286445276039c8 a swrl:AtomList.
ccrel:license a owl:AnnotationProperty.
<http://gbol.life/ontology/bibo#status> a owl:AnnotationProperty.
dcterms:bibliographicCitation a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:identifier a owl:DatatypeProperty;
                   rdfs:comment "An unambiguous reference to the resource within a given context.";
                   rdfs:isDefinedBy "http://purl.org/dc/terms";
                   rdfs:label "identifier".
dcterms:issued a owl:AnnotationProperty.
dcterms:publisher a owl:AnnotationProperty.
dcterms:title a owl:DatatypeProperty,
                owl:AnnotationProperty;
              rdfs:comment "A name given to the resource.";
              rdfs:isDefinedBy "http://purl.org/dc/terms";
              rdfs:label "title";
              status:term_status "".
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
owl:qualifiedCardinality a owl:AnnotationProperty.
status:term_status a owl:AnnotationProperty.
w3id:isCharacterisedBy ccrel:license <https://creativecommons.org/licenses/by-nc/4.0/>;
                       <http://gbol.life/ontology/bibo#status> "published";
                       dcterms:bibliographicCitation "Work in progress";
                       dcterms:contributor """Izaskun Fernandez (Tekniker) 
Iban Quintana (Tekniker) 
Xana Fernandez (Tekniker)"""@en;
                       dcterms:created "2023-05-30";
                       dcterms:creator "Patricia Casla (Tekniker)"@en;
                       dcterms:description "The goal of this ontology design pattern is to characterise a subject or group of subjects of interest by assigning qualifiable or quantifiable attributes or characteristics."@en;
                       dcterms:issued "2023-05-30";
                       dcterms:publisher "Tekniker";
                       dcterms:title "isCharacterisedBy ontology design pattern ";
                       vann:preferredNamespacePrefix "icb";
                       vann:preferredNamespaceUri "https://w3id.org/isCharacterisedBy";
                       a owl:Ontology;
                       owl:versionInfo 1.0.
icb:Property a owl:Class;
             rdfs:comment "Property is a qualifiable or quantifiable attribute, or characteristic of something. or somebody";
             rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
             rdfs:label "Property";
             rdfs:subClassOf [owl:onClass icb:SubjectOfInterest ; 
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                              owl:onProperty icb:characterises ; 
                              a owl:Restriction],
                             [owl:allValuesFrom xsd:double ; 
                              owl:onProperty icb:minValue ; 
                              a owl:Restriction],
                             [owl:allValuesFrom icb:Unit ; 
                              owl:onProperty icb:hasUnit ; 
                              a owl:Restriction],
                             [owl:onClass icb:Unit ; 
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                              owl:onProperty icb:hasUnit ; 
                              a owl:Restriction],
                             [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                              owl:onProperty dcterms:identifier ; 
                              a owl:Restriction],
                             [owl:allValuesFrom xsd:double ; 
                              owl:onProperty icb:value ; 
                              a owl:Restriction],
                             [owl:allValuesFrom xsd:double ; 
                              owl:onProperty icb:maxValue ; 
                              a owl:Restriction],
                             [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                              owl:onProperty dcterms:title ; 
                              a owl:Restriction];
             status:term_status "Testing".
icb:SubjectOfInterest a owl:Class;
                      rdfs:comment "A subject of interest is an abstraction of a real world phenomena (thing, person, event, etc).";
                      rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
                      rdfs:label "SubjectOfInterest";
                      rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dcterms:title ; 
                                       a owl:Restriction],
                                      [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dcterms:identifier ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom icb:SubjectOfInterest ; 
                                       owl:onProperty icb:isGroupingOf ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom icb:Property ; 
                                       owl:onProperty icb:isCharacterisedBy ; 
                                       a owl:Restriction];
                      status:term_status "Testing".
icb:Unit a owl:Class;
         rdfs:comment "A reference to the unit of measure of a quantifiable aspect (attribute or characteristic).";
         rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
         rdfs:label "Unit";
         status:term_status "Testing".
icb:belongsTo a owl:ObjectProperty;
              rdfs:comment "Relationship between a member and the group it belongs to.";
              rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
              rdfs:label "belongsTo";
              owl:inverseOf icb:isGroupingOf;
              status:term_status "Testing".
icb:characterises a owl:ObjectProperty;
                  rdfs:comment "Relationship between a Property and the SubjectOfInterest it characterises.";
                  rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
                  rdfs:label "characterises";
                  rdfs:range icb:SubjectOfInterest;
                  owl:inverseOf icb:isCharacterisedBy;
                  status:term_status "Testing".
icb:hasUnit a owl:ObjectProperty;
            rdfs:comment "Relationship between a quantifiable property and a unit of measurement";
            rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
            rdfs:label "hasUnit";
            rdfs:range icb:Unit;
            owl:inverseOf icb:isUnitFor;
            status:term_status "Testing".
icb:isCharacterisedBy a owl:ObjectProperty;
                      rdfs:comment "Relationship between a SubjectOfInterest and the Property that characterises it.";
                      rdfs:domain icb:SubjectOfInterest;
                      rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
                      rdfs:label "isCharacterisedBy";
                      status:term_status "Testing".
icb:isGroupingOf a owl:ObjectProperty;
                 rdfs:comment "Relationship between a group and the members of such group. All the members of a group have the same charabterists or attributes.";
                 rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
                 rdfs:label "isGroupingOf";
                 status:term_status "Testing".
icb:isUnitFor a owl:ObjectProperty;
              rdfs:comment "Relationship between an unit and the property of which it is a unit of measurement.";
              rdfs:domain icb:Unit;
              rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
              rdfs:label "isUnitFor";
              status:term_status "Testing".
icb:maxValue a owl:DatatypeProperty;
             rdfs:comment "Maximum permissible value.";
             rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
             rdfs:label "maxValue";
             status:term_status "Testing".
icb:minValue a owl:DatatypeProperty;
             rdfs:comment "Minimun permissible value.";
             rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
             rdfs:label "minValue";
             status:term_status "Testing".
icb:value a owl:DatatypeProperty;
          rdfs:comment "Specific value.";
          rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
          rdfs:label "value";
          status:term_status "Testing".
<urn:swrl:var#p> a swrl:Variable.
<urn:swrl:var#soc> a swrl:Variable.
<urn:swrl:var#soi> a swrl:Variable.
