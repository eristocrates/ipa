icb:SubjectOfInterest a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A subject of interest is an abstraction of a real world phenomena (thing, person, event, etc).";
                      rdfs:isDefinedBy "https://w3id.org/isCharacterisedBy";
                      rdfs:label "SubjectOfInterest";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/identifier> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> icb:SubjectOfInterest ; 
