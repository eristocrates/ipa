                         rdfs:range cevent:UnifyingFactor;
                         rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept>;
                         <http://www.w3.org/2002/07/owl#inverseOf> cevent:isUnifyingFactorOf;
                         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                     "stable"@en.
cevent:isAgentRelatedToCulturalEventOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment """Questa è la proprietà inversa a \"ha agente collegato a evento culturale\"."""@it,
