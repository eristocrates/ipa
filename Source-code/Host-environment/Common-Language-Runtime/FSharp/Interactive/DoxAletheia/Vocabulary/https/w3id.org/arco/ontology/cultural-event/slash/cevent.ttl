@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cevent: <https://w3id.org/arco/ontology/cultural-event/>.

<http://dati.beniculturali.it/cis/CulturalEvent> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/dc/elements/1.1/language> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/opla/reusesPatternAsTemplate> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<https://w3id.org/arco/ontology/catalogue/iccdNormTag> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<https://w3id.org/arco/ontology/context-description/hasRelatedAgent> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/context-description/isAgentRelatedTo> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/core/Concept> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/arco/ontology/core/Situation> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/arco/ontology/core/hasCharacteristic> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/core/hasConcept> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/core/isCharacteristicOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/core/isConceptOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<https://w3id.org/arco/ontology/cultural-event> <http://purl.org/dc/elements/1.1/creator> "Andrea Nuzzolese (ISTC-CNR, STLab)",
                                                                                          "Ludovica Marinucci (ISTC-CNR, STLab)",
                                                                                          "Marialetizia Mancinelli (MiBACT, ICCD)",
                                                                                          "Aldo Gangemi (ISTC-CNR, STLab)",
                                                                                          "Valentina Presutti (ISTC-CNR, STLab)",
                                                                                          "Valentina Carriero (ISTC-CNR, STLab)",
                                                                                          "Chiara Veninata (MiBACT, ICCD)";
                                                <http://purl.org/dc/elements/1.1/description> "The Cultural Event module models cultural events, i.e. events involving cultural properties."@en,
                                                                                              "Questo modulo modella gli eventi culturali, cioè eventi che coinvolgono un bene culturale."@it;
                                                <http://purl.org/dc/elements/1.1/language> <http://publications.europa.eu/resource/authority/language/ITA>,
                                                                                           <http://publications.europa.eu/resource/authority/language/ENG>;
                                                <http://purl.org/dc/elements/1.1/title> "Ontologia degli Eventi Culturali (ArCo network)"@it,
                                                                                        "Cultural Event Ontology (ArCo network)"@en;
                                                <http://purl.org/dc/terms/issued> "2018-03-07";
                                                <http://purl.org/dc/terms/license> <https://w3id.org/italia/controlled-vocabulary/licences/A31_CCBYSA40>,
                                                                                   <https://creativecommons.org/licenses/by-sa/4.0/>;
                                                <http://purl.org/dc/terms/modified> "2019-06-01";
                                                <http://www.ontologydesignpatterns.org/opla/reusesPatternAsTemplate> <http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl>,
                                                                                                                     <http://ontologydesignpatterns.org/cp/owl/sequence.owl>;
                                                a <http://www.w3.org/2002/07/owl#Ontology>;
                                                rdfs:comment """The Cultural Event module models cultural events, i.e. events involving cultural properties.
In this module are used as template the following Ontology Design Patterns:
- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl
- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"""@en,
                                                             """Questo modulo modella gli eventi culturali, cioè eventi che coinvolgono un bene culturale.
In questo modulo sono riusati come template i seguenti Ontology Design Patterns:
- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl
- http://www.ontologydesignpatterns.org/cp/owl/sequence.owl"""@it;
                                                rdfs:label "Ontologia degli Eventi Culturali (ArCo network)"@it,
                                                           "Cultural Event Ontology (ArCo network)"@en;
                                                <http://www.w3.org/2002/07/owl#imports> <https://w3id.org/arco/ontology/catalogue>,
                                                                                        <https://w3id.org/arco/ontology/core>;
                                                <http://www.w3.org/2002/07/owl#versionInfo> "Version 1.0"@en,
                                                                                            "Versione 1.0"@it.
cevent:Exhibition a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents an exhibition, as a particular type of cultural event."@en,
                               "Questa classe rappresenta una mostra, come sottocategoria di un generico evento culturale."@it;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                  rdfs:label "Mostra"@it,
                             "Exhibition"@en;
                  rdfs:subClassOf <http://dati.beniculturali.it/cis/CulturalEvent>;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                              "stable"@en;
                  <https://w3id.org/arco/ontology/catalogue/iccdNormTag> """ICCD Normativa Trasversale e altre normative di versione 4.00: se MS/MST/MSTI= \"mostra\""""@it.
cevent:Hour a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              cevent:TimePeriodMeasurementUnit;
            rdfs:label "Hour"@en,
                       "Ora"@it.
cevent:Minute a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                cevent:TimePeriodMeasurementUnit;
              rdfs:label "Minute"@en,
                         "Minuto"@it.
cevent:Month a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               cevent:TimePeriodMeasurementUnit;
             rdfs:label "Mese"@it,
                        "Month"@en.
cevent:RecurrentEvent a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This class represents a recurrent event, that is an event as a collection of sequential events and identified by at least one unifying factor (e.g.: topic, place)."@en,
                                   "Questa classe rappresenta un evento ricorrente, ovvero un evento inteso come collezione di eventi, posti in una sequenza temporale, e caratterizzato da almeno un fattore unificante (es.: il topic, il luogo)."@it;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                      rdfs:label "Evento ricorrente"@it,
                                 "Recurrent event"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:RecurrentTimePeriod ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cevent:hasRecurrentTimePeriod ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/italia/onto/l0/EventOrSituation> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cevent:hasMemberEvent ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:UnifyingFactor ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cevent:hasUnifyingFactor ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#intersectionOf> (<https://w3id.org/arco/ontology/core/Situation>
                                                                                       <https://w3id.org/italia/onto/l0/Collection>) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/italia/onto/l0/EventOrSituation> ; 
                                                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> cevent:hasNextEvent ; 
                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/italia/onto/l0/EventOrSituation> ; 
                                                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> cevent:hasPreviousEvent ; 
                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                       <http://www.w3.org/2002/07/owl#onProperty> cevent:hasMemberEvent ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                  "stabile"@it;
                      <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa BDI 4.00: RC".
cevent:RecurrentTimePeriod a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "This class represents the time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one."@en,
                                        "Questa classe rappresenta il periodo di tempo che intercorre tra un evento membro di un evento ricorrente, inteso come collezione di eventi, e un evento membro successivo."@it;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                           rdfs:label "Recurrent time period"@en,
                                      "Periodo di tempo ricorrente"@it;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:integer ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> cevent:timePeriodValue ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:TimePeriodMeasurementUnit ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> cevent:hasTimePeriodMeasurementUnit ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:RecurrentEvent ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> cevent:isRecurrentTimePeriodOf ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                       "stabile"@it.
cevent:Second a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                cevent:TimePeriodMeasurementUnit;
              rdfs:label "Second"@en,
                         "Secondo"@it.
cevent:TimePeriod a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "La classe che rappresenta un periodo di tempo."@it,
                               "The class that represents a time period."@en;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                  rdfs:label "Periodo di tempo"@it,
                             "Time period"@en;
                  rdfs:subClassOf <https://w3id.org/italia/onto/TI/TimeInterval>;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                              "stable"@en.
cevent:TimePeriodMeasurementUnit a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Questa classe rappresenta l'unità di misura associata al periodo di tempo massimo che intercorre tra un evento membro di un evento ricorrente, inteso come collezione di eventi, e un evento membro successivo."@it,
                                              "This class represents the unit of measurement associated to the maximum time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one."@en;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                                 rdfs:label "Unità di misura del periodo di tempo"@it,
                                            "Time period measurement unit"@en;
                                 rdfs:subClassOf <https://w3id.org/italia/onto/MU/MeasurementUnit>,
                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:RecurrentTimePeriod ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> cevent:isTimePeriodMeasurementUnitOf ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                             "stable"@en.
cevent:UnifyingFactor a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Questa classe rappresenta un fattore unificante, ovvero un fattore che rappresenta un invariante comune a tutti gli eventi che sono membri dell'evento ricorrente."@it,
                                   "This class represents a unifying factor, that is a factor that represents an invariant common to all the events that are members of the recurrent event."@en;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                      rdfs:label "Unifying factor"@en,
                                 "Fattore unificante"@it;
                      rdfs:subClassOf <https://w3id.org/arco/ontology/core/Concept>,
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> cevent:RecurrentEvent ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cevent:isUnifyingFactorOf ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                  "stabile"@it.
cevent:Week a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              cevent:TimePeriodMeasurementUnit;
            rdfs:label "Settimana"@it,
                       "Week"@en.
cevent:Year a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              cevent:TimePeriodMeasurementUnit;
            rdfs:label "Anno"@it,
                       "Year"@en.
cevent:eventTimeLocation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "This property represents the time and location of a cultural event, when they are recorded together."@en,
                                      "Questa proprietà rappresenta il luogo e il tempo di un evento culturale, quando espressi unitamente."@it;
                         rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent>;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                         rdfs:label "tempo e luogo dell'evento"@it,
                                    "event time and location"@en;
                         rdfs:range rdfs:Literal;
                         <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                     "stabile"@it;
                         <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale e normative di versione 4.00: MS/MST/MSTL"@it.
cevent:hasAgentRelatedToCulturalEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "This class relates a cultural event to an agent playing a role related to that cultural event."@en,
                                                   "Questa proprietà rappresenta la relazione che collega un evento culturale a un agente che riveste un ruolo relativo all'evento. La relazione tra il ruolo e l’agente che lo riveste è espressa, in maniera generica, nel nome della proprietà, che quindi ne fornisce una rappresentazione semplificata, con ridotta espressività. La relazione è poi specializzata da sottoproprietà. Nell’ontologia questa relazione è modellata anche, in maniera più espressiva, dalla classe TimeIndexedRole, che permette di collegare l’ente, il suo ruolo e la sua corrispondente estensione temporale."@it;
                                      rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent>;
                                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                                      rdfs:label "ha agente collegato a evento culturale"@it,
                                                 "has agent related to cultural event"@en;
                                      rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                                      rdfs:subPropertyOf <https://w3id.org/arco/ontology/context-description/hasRelatedAgent>;
                                      <http://www.w3.org/2002/07/owl#inverseOf> cevent:isAgentRelatedToCulturalEventOf;
                                      <http://www.w3.org/2002/07/owl#propertyChainAxiom> (<https://w3id.org/italia/onto/RO/hasRiT>
                                                                                          <https://w3id.org/italia/onto/RO/isRoleInTimeOf>);
                                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                                  "stabile"@it.
cevent:hasEventOrganiser a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Questa proprietà collega un evento culturale all'ente o soggetto che ha organizzato quell'evento."@it,
                                      "This property relates a cultural evento to the agency or person that is the organiser of that event."@en;
                         rdfs:domain <http://dati.beniculturali.it/cis/CulturalEvent>;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                         rdfs:label "has event organiser"@en,
                                    "ha ente o soggetto organizzatore"@it;
                         rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                         rdfs:subPropertyOf cevent:hasAgentRelatedToCulturalEvent;
                         <http://www.w3.org/2002/07/owl#inverseOf> cevent:isEventOrganiserOf;
                         <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                     "stabile"@it;
                         <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "Versioni 4.00 e ICCD Normativa Trasversale: MS/MST/MSTE - Versioni precedenti a 4.00: DO/MST/MSTO"@it.
cevent:hasImmediateNextEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                             rdfs:comment "Questa proprietà collega un evento che è membro di un evento ricorrente, inteso come collezione, all'evento immediatamente successivo."@it,
                                          "This property relates an event that is member of a recurrent event, as a collection, to the immediate next event."@en;
                             rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation>;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                             rdfs:label "ha evento immediatamente successivo"@it,
                                        "has immediate next event"@en;
                             rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation>;
                             rdfs:subPropertyOf cevent:hasNextEvent;
                             <http://www.w3.org/2002/07/owl#inverseOf> cevent:hasImmediatePreviousEvent;
                             <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                         "stable"@en.
cevent:hasImmediatePreviousEvent a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Questa proprietà collega un evento che è membro di un evento ricorrente, inteso come collezione, all'evento immediatamente precedente."@it,
                                              "This property relates an event that is member of a recurrent event, as a collection, to the immediate previous event."@en;
                                 rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation>;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                                 rdfs:label "ha evento immediatamente precedente"@it,
                                            "has immediate previous event"@en;
                                 rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation>;
                                 rdfs:subPropertyOf cevent:hasPreviousEvent;
                                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                             "stable"@en.
cevent:hasMemberEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Questa proprietà collega un evento ricorrente, inteso come collezione di eventi, a uno degli eventi membri della collezione."@it,
                                   "This property relates a recurrent event, as a collection of events, to one of its member events."@en;
                      rdfs:domain cevent:RecurrentEvent;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                      rdfs:label "has member event"@en,
                                 "ha evento membro"@it;
                      rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation>;
                      rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/hasMember>;
                      <http://www.w3.org/2002/07/owl#inverseOf> cevent:isEventMemberOf;
                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                  "stabile"@it.
cevent:hasNextEvent a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property relates an event that is member of a recurrent event, as a collection, to one of the next events."@en,
                                 "Questa proprietà collega un evento che è membro di un evento ricorrente, inteso come collezione, a uno degli eventi successivi."@it;
                    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation>;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                    rdfs:label "has next event"@en,
                               "ha evento successivo"@it;
                    rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation>;
                    rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/precedes>;
                    <http://www.w3.org/2002/07/owl#inverseOf> cevent:hasPreviousEvent;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                "stable"@en.
cevent:hasPreviousEvent a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Questa proprietà collega un evento che è membro di un evento ricorrente, inteso come collezione, a uno degli eventi precedenti."@it,
                                     "This property relates an event that is member of a recurrent event, as a collection, to one of the previous events."@en;
                        rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation>;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                        rdfs:label "ha evento precedente"@it,
                                   "has previous event"@en;
                        rdfs:range <https://w3id.org/italia/onto/l0/EventOrSituation>;
                        rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/follows>;
                        <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                    "stable"@en.
cevent:hasRecurrentTimePeriod a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "This property relates a recurrent event to the time period that elapses between one of its member events and the next one."@en,
                                           "Questa proprietà collega un evento ricorrente al periodo di tempo che intercorre tra uno dei suoi eventi membri e quello successivo."@it;
                              rdfs:domain cevent:RecurrentEvent;
                              rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                              rdfs:label "ha periodo ricorrente di tempo"@it,
                                         "has recurrent time period"@en;
                              rdfs:range cevent:RecurrentTimePeriod;
                              <http://www.w3.org/2002/07/owl#inverseOf> cevent:isRecurrentTimePeriodOf;
                              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (cevent:hasMemberEvent
                                                                                  cevent:hasTimePeriodBeforeNextEvent);
                              <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                          "stabile"@it.
cevent:hasTimePeriodBeforeNextEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "This property relates an event, member of a recurrent event as a collection of events, to the time period that is between that event and the next one."@en,
                                                 "Questa proprietà collega un evento, membro di un evento ricorrente inteso come collezione di eventi, al periodo di tempo che intercorre tra l'evento stesso e l'evento successivo."@it;
                                    rdfs:domain <https://w3id.org/italia/onto/l0/EventOrSituation>;
                                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                                    rdfs:label "has time period before next event"@en,
                                               "ha periodo di tempo prima di evento successivo"@it;
                                    rdfs:range cevent:RecurrentTimePeriod;
                                    <http://www.w3.org/2002/07/owl#inverseOf> cevent:isTimePeriodBeforeNextEventOf;
                                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                                "stable"@en.
cevent:hasTimePeriodMeasurementUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "This property relates the maximum time period that elapses between one of the member events of a recurrent event, as a collection of events, and the next one, to the unit of measurement associated to it."@en,
                                                 "Questa proprietà collega il periodo di tempo massimo che intercorre tra un evento membro di un evento ricorrente, inteso come collezione di eventi, e un evento membro successivo alla sua unità di misura."@it;
                                    rdfs:domain cevent:RecurrentTimePeriod;
                                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/cultural-event>;
                                    rdfs:label "has time period measurement unit"@en,
                                               "ha unità di misura di periodo di tempo"@it;
                                    rdfs:range cevent:TimePeriodMeasurementUnit;
                                    rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasCharacteristic>;
                                    <http://www.w3.org/2002/07/owl#inverseOf> cevent:isTimePeriodMeasurementUnitOf;
                                    <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                                "stabile"@it.
cevent:hasUnifyingFactor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property relates a recurrent event to a unifying factor."@en,
