aeros: <http://purl.org/dc/terms/creator> "Ignacio Dominguez Martinez-Casanueva";
       <http://purl.org/dc/terms/description> """
                                        Ontology that defines concepts for representing the aerOS Data Catalog
                                        """;
       <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/APACHE2.0>;
       <http://purl.org/dc/terms/modified> "2024-08-23"^^xsd:date;
       <http://purl.org/dc/terms/source> <https://gitlab.aeros-project.eu/wp4/t4.1/data-catalog-ontology>;
       <http://purl.org/dc/terms/title> "aerOS Data Catalog Ontology";
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "aerdcat";
       <http://purl.org/vocab/vann/preferredNamespaceUri> aeros:;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "aerOS Data Catalog Ontology"@en;
       <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/aerOS/data-catalog>;
       <http://www.w3.org/2002/07/owl#versionInfo> "1.0.0";
       <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/>.
aeros:ContextBroker a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Represents an NGSI-LD Context Broker.";
                    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                    rdfs:label "Context Broker";
                    rdfs:subClassOf <http://www.w3.org/ns/dcat#DataService>.
aeros:DataProduct a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Representation of a data product as wrapper of a dataset.";
                  rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                  rdfs:label "Data Product";
                  rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset>.
aeros:DataProductOwner a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         <http://www.w3.org/ns/org#Role>;
                       rdfs:comment "Person responsible for the creation and publication of a data product.";
                       rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                       rdfs:label "Data Product Owner".
aeros:contextBroker a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relation with a context broker.";
                    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                    rdfs:label "context broker";
                    rdfs:range aeros:ContextBroker;
                    rdfs:subPropertyOf <http://www.w3.org/ns/dcat#service>.
aeros:dataProduct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relation with a data product.";
                  rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                  rdfs:label "data product";
                  rdfs:range aeros:DataProduct;
                  rdfs:subPropertyOf <http://www.w3.org/ns/dcat#dataset>.
aeros:servesDataProduct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Denotes a data product exposed by a data service.";
                        rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                        rdfs:label "serves data product";
                        rdfs:range aeros:DataProduct;
                        rdfs:subPropertyOf <http://www.w3.org/ns/dcat#servesDataset>.
<https://w3id.org/mod#createdWith> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
