aoscon: <http://purl.org/dc/terms/contributor> "Andreu Belsa Pellicer",
                                               "Rafael Vaño Garcia";
        <http://purl.org/dc/terms/created> "2024-02-14"^^xsd:date;
        <http://purl.org/dc/terms/creator> "Ignacio Dominguez Martinez-Casanueva";
        <http://purl.org/dc/terms/description> """
                                    Ontology for the orchestration of the aerOS continuum.
                                    """;
        <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/APACHE2.0>;
        <http://purl.org/dc/terms/modified> "2024-08-23"^^xsd:date;
        <http://purl.org/dc/terms/source> <https://gitlab.aeros-project.eu/wp4/t4.1/aeros-continuum>;
        <http://purl.org/dc/terms/title> "aerOS Continuum Ontology";
        <http://purl.org/vocab/vann/preferredNamespacePrefix> "aeros";
        <http://purl.org/vocab/vann/preferredNamespaceUri> aoscon:;
        a <http://www.w3.org/2002/07/owl#Ontology>,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:label "aerOS Continuum Ontology"@en;
        <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/aerOS/continuum>;
        <http://www.w3.org/2002/07/owl#versionInfo> "1.1.0";
        <https://w3id.org/mod#createdWith> <https://chowlk.linkeddata.es/>.
aoscon:CloudTier a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   aoscon:InfrastructureElementTier.
aoscon:ContainerdOrchestration a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 aoscon:OrchestrationType.
aoscon:CpuArchitecture a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Cpu Architecture".
aoscon:DockerOrchestration a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                             aoscon:OrchestrationType.
aoscon:Domain a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A set of one or more IEs, functionally connected and sharing a common instance of aerOS basic services among them, constituting an administrative domain able to be managed and orchestrated by aerOS Meta-OS and thus be part of the IoT-Edge-Cloud continuum.";
              rdfs:label "Domain".
aoscon:DomainStatus a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Represents the status of a domain. Possible types are Preliminar, Functional, Removed.Represents the status of a domain. Possible types are Preliminar, Functional, Removed.";
                    rdfs:label "Domain Status".
aoscon:EdgeTier a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  aoscon:InfrastructureElementTier.
aoscon:FailedServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                aoscon:ServiceComponentStatus.
aoscon:FarEdgeTier a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     aoscon:InfrastructureElementTier.
aoscon:FinishedServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  aoscon:ServiceComponentStatus.
aoscon:FunctionalDomain a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                          aoscon:DomainStatus.
aoscon:InfrastructureElement a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment """\"The fundamental building block within aerOS Meta-OS. A physical or virtual computing resource providing the necessary processing power, storage capacity, and network connectivity to support containerised workloads and services.

Exposes aerOS runtime on top of provided capabilities being thus the minimum execution unit within the IoT-Edge-Cloud continuum.\"""";
                             rdfs:label "Infrastructure Element".
aoscon:InfrastructureElementRequirements a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "Represents the IE requirements for running a service component.";
                                         rdfs:label "Infrastructure Element Requirements".
aoscon:InfrastructureElementStatus a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Represents the status of an IE. Possible types are READY, OVERLOAD, UNSECURE, UNTRUSTED.";
                                   rdfs:label "Infrastructure Element Status".
aoscon:InfrastructureElementTier a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Represents the computing continuum tier (cloud, edge, ...) of an IE.";
                                 rdfs:label "Infrastructure Element Tier".
aoscon:IotTier a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 aoscon:InfrastructureElementTier.
aoscon:KubernetesOrchestration a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 aoscon:OrchestrationType.
aoscon:Linux a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               aoscon:OperatingSystem.
aoscon:LocatingServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  aoscon:ServiceComponentStatus.
aoscon:LowLevelOrchestrator a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "This element interprets the Decision Blueprint coming from the HLO and oversees the actual deployment of workloads in the selected IE(s). Being aware of the underlying container management frameworks, is able to convert the allocation order into proper deployment. Several LLOs may live in the same domain.";
                            rdfs:label "Low Level Orchestrator".
aoscon:MigratingServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                   aoscon:ServiceComponentStatus.
aoscon:NetworkPort a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Network Port".
aoscon:OpenstackOrchestration a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                aoscon:OrchestrationType.
aoscon:OperatingSystem a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Operating System".
aoscon:OrchestrationType a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Container orchestration technology.";
                         rdfs:label "Orchestration Type".
aoscon:OverloadInfrastructureElement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                       aoscon:InfrastructureElementStatus.
aoscon:OverloadServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  aoscon:ServiceComponentStatus.
aoscon:PreliminarDomain a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                          aoscon:DomainStatus.
aoscon:ReadyInfrastructureElement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                    aoscon:InfrastructureElementStatus.
aoscon:RemovedDomain a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                       aoscon:DomainStatus.
aoscon:RemovingServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  aoscon:ServiceComponentStatus.
aoscon:RunningServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                 aoscon:ServiceComponentStatus.
aoscon:Service a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Represents a single instance of an IoT service with a unique identifier. A service is composed by one or some ServiceComponents.";
               rdfs:label "Service".
aoscon:ServiceComponent a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Individual, deployable units that together constitute a Service in the aerOS ecosystem, each with a specific role or function.";
                        rdfs:label "Service Component".
aoscon:ServiceComponentStatus a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "Service Component Status".
aoscon:ServiceType a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """Identifies the services such as a \"catalogue\".""";
                   rdfs:label "Service Type".
aoscon:StartingServiceComponent a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  aoscon:ServiceComponentStatus.
aoscon:UnsecureInfrastructureElement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                       aoscon:InfrastructureElementStatus.
aoscon:UntrustedInfrastructureElement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                        aoscon:InfrastructureElementStatus.
aoscon:User a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Person with access to the capabilities of the continuum.";
            rdfs:label "User";
            rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
aoscon:Windows a <http://www.w3.org/2002/07/owl#NamedIndividual>,
