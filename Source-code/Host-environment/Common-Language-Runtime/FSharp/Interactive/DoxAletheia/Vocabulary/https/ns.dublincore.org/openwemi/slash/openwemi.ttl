@base <https://dcmi.github.io/openwemi/ns/openWEMI.ttl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix openwemi: <https://ns.dublincore.org/openwemi/>.

openwemi: dct:creator "Dublin Core Metadata Initiative, OpenWEMI Working Group";
          dct:date "2024/01/19";
          dct:description "OpenWEMI is a minimally constrained vocabulary for describing created resources using the concepts of Work, Expression, Manifestation, Item.";
          dct:title "OpenWEMI vocabulary";
          a owl:Ontology.
openwemi:Endeavor a rdfs:Class,
                    owl:Class;
                  rdfs:comment "A creation."@en;
                  rdfs:isDefinedBy openwemi:;
                  rdfs:label "Endeavor"@en.
openwemi:Expression dct:description "Endeavors are made tangible through some kind of expression, such as text, sound, or a visual form. There may be more than one expression of a work of the same type or of different types."@en;
                    a rdfs:Class,
                      owl:Class;
                    rdfs:comment "A perceivable form of the creation."@en;
                    rdfs:isDefinedBy openwemi:;
                    rdfs:label "Expression"@en;
                    rdfs:subClassOf openwemi:Endeavor.
openwemi:Item dct:description "An Item is a single instance of an Endeavor, something that can have a place on a shelf or a location online."@en;
              a rdfs:Class,
                owl:Class;
              rdfs:comment "An exemplar of a creation."@en;
              rdfs:isDefinedBy openwemi:;
              rdfs:label "Item"@en;
              rdfs:subClassOf openwemi:Endeavor.
openwemi:Manifestation dct:description "A manifestation is an Endeavor that has been realized in some physical or digital form. A manifestation may be a single realization or a realization that is produced in multiple copies such as the publication of a music compact disk or the manufacture of a shirt."@en;
                       a rdfs:Class,
                         owl:Class;
                       rdfs:comment "The physical embodiment of a creation."@en;
                       rdfs:isDefinedBy openwemi:;
                       rdfs:label "Manifestation"@en;
                       rdfs:subClassOf openwemi:Endeavor.
openwemi:Work dct:description "A work is an abstraction that represents the concepts behind an Endeavor. Each metadata community will have a different definition of Work, but it should be the broadest definition of the Endeavors being described."@en;
              a rdfs:Class,
                owl:Class;
              rdfs:comment "An abstract notion of an artistic or intellectual creation."@en;
              rdfs:isDefinedBy openwemi:;
              rdfs:label "Work"@en;
              rdfs:subClassOf openwemi:Endeavor.
openwemi:commonEndeavor dct:description "commonEndeavour is intended to define a relationship between two resources that may or may not be modeled as OpenWEMI. This makes it possible to assert that a resource modeled using a vocabulary that does not use the  entity model explicitly is describing the same Work, Expression, Manifestation, and/or Item as another resource."@en;
                        a rdf:Property;
                        rdfs:comment "Relates any two resources that are or contain the same endeavor.";
                        rdfs:isDefinedBy openwemi:;
                        rdfs:label "common Endeavor"@en;
                        owl:equivalentProperty <http://open.vocab.org/terms/commonEndeavour>.
openwemi:commonExpression dct:description "commonExpression is intended to define a relationship between two resources that may or may not be modeled as OpenWEMI. This makes it possible to assert that a resource modeled using a vocabulary that does not use the OpenWEMI entity model explicitly is describing the Expression as another resource."@en;
                          a rdf:Property;
                          rdfs:comment "Relates any two resources that are or contain the same Expression.";
                          rdfs:isDefinedBy openwemi:;
                          rdfs:label "common Expression"@en;
                          owl:equivalentProperty <http://open.vocab.org/terms/commonExpression>.
openwemi:commonItem dct:description "commonItem is intended to define a relationship between two resources that may or may not be modeled as OpenWEMI. This makes it possible to assert that a resource modeled using a vocabulary that does not use the OpenWEMI entity model explicitly is describing the same Item as another resource."@en;
                    a rdf:Property;
                    rdfs:comment "Relates any two resources that are or contain the same Item.";
                    rdfs:isDefinedBy openwemi:;
                    rdfs:label "common Item"@en;
                    owl:equivalentProperty <http://open.vocab.org/terms/commonItem>.
openwemi:commonManifestation dct:description "commonManifestation is intended to define a relationship between two resources that may or may not be modeled as OpenWEMI. This makes it possible to assert that a resource modeled using a vocabulary that does not use the OpenWEMI entity model explicitly is describing the same Manifestation as another resource."@en;
                             a rdf:Property;
                             rdfs:comment "Relates any two resources that are or contain the same Manifestation.";
                             rdfs:isDefinedBy openwemi:;
                             rdfs:label "common Manifestation"@en;
                             owl:equivalentProperty <http://open.vocab.org/terms/commonManifestation>.
openwemi:commonWork dct:description "commonWork is intended to define a relationship between two resources that may or may not be modeled as OpenWEMI. This makes it possible to assert that a resource modeled using a vocabulary that does not use the OpenWEMI entity model explicitly is describing the same Work as another resource."@en;
                    a rdf:Property;
                    rdfs:comment "Relates any two resources that are or contain the same Work.";
                    rdfs:isDefinedBy openwemi:;
                    rdfs:label "common Work"@en;
                    owl:equivalentProperty <http://open.vocab.org/terms/commonWork>.
openwemi:expressedBy dct:description "A relationship asserted from a Work to an Expression that expresses the Work."@en;
                     a rdf:Property;
                     rdfs:comment "An Expression of a Work."@en;
                     rdfs:domain openwemi:Work;
                     rdfs:isDefinedBy openwemi:;
                     rdfs:label "expressed by"@en;
                     rdfs:range openwemi:Expression;
                     rdfs:subPropertyOf dct:relation;
                     owl:inverseOf openwemi:expresses.
openwemi:expresses dct:description "A relationship asserted from an Expression to a Work that it expresses."@en;
                   a rdf:Property;
                   rdfs:comment "An Endeavor that expresses a Work."@en;
                   rdfs:domain openwemi:Expression;
                   rdfs:isDefinedBy openwemi:;
                   rdfs:label "expresses"@en;
                   rdfs:range openwemi:Work;
                   rdfs:subPropertyOf dct:relation.
openwemi:instantiatedBy dct:description "A relationship asserted from a Work, an Expression, or a Manifestation to an Item."@en;
                        a rdf:Property;
                        rdfs:comment "An instantiation of a Manifestation, an Expression or a Work."@en;
                        rdfs:domain [a owl:Class ; 
                                     owl:unionOf (openwemi:Work
                                                  openwemi:Expression
                                                  openwemi:Manifestation)];
                        rdfs:isDefinedBy openwemi:;
                        rdfs:label "instantiated by"@en;
                        rdfs:range openwemi:Item;
                        rdfs:subPropertyOf dct:relation;
                        owl:inverseOf openwemi:instantiates.
openwemi:instantiates dct:description "A relationship asserted from an Item to a Manifestation, an Expression, or a Work."@en;
                      a rdf:Property;
                      rdfs:comment "An Endeavor that instantiates a Manifestation, an Expression or a Work."@en;
                      rdfs:domain openwemi:Item;
                      rdfs:isDefinedBy openwemi:;
                      rdfs:label "instantiates"@en;
                      rdfs:range [a owl:Class ; 
                                  owl:unionOf (openwemi:Work
                                               openwemi:Expression
                                               openwemi:Manifestation)];
                      rdfs:subPropertyOf dct:relation.
openwemi:manifestedBy dct:description "A relationship asserted from a Work or an Expression to a Manifestation."@en;
                      a rdf:Property;
                      rdfs:comment "A Manifestation of a Work or an Expression."@en;
                      rdfs:domain [a owl:Class ; 
                                   owl:unionOf (openwemi:Work
                                                openwemi:Expression)];
                      rdfs:isDefinedBy openwemi:;
                      rdfs:label "manifested by"@en;
                      rdfs:range openwemi:Manifestation;
                      rdfs:subPropertyOf dct:relation;
                      owl:inverseOf openwemi:manifests.
openwemi:manifests dct:description "A relationship asserted from a Manifestation to an Expression or a Work."@en;
                   a rdf:Property;
                   rdfs:comment "An Endeavor that manifests an Expression or a Work."@en;
                   rdfs:domain openwemi:Manifestation;
                   rdfs:isDefinedBy openwemi:;
                   rdfs:label "manifests"@en;
                   rdfs:range [a owl:Class ; 
                               owl:unionOf (openwemi:Work
                                            openwemi:Expression)];
                   rdfs:subPropertyOf dct:relation.
openwemi:relatedExpression dct:description "This provides a non-specific relationship between two Expressions. The specific relationship type can be defined as a sub-property of relatedExpression."@en;
                           a rdf:Property;
                           rdfs:comment "An Expression that is related in some way to another Expression."@en;
                           rdfs:domain openwemi:Expression;
                           rdfs:isDefinedBy openwemi:;
                           rdfs:label "related Expression"@en;
                           rdfs:range openwemi:Expression;
                           rdfs:subPropertyOf dct:relation.
openwemi:relatedItem dct:description "This provides a non-specific relationship between two Items. The specific relationship type can be defined as a sub-property of relatedItem."@en;
                     a rdf:Property;
                     rdfs:comment "An Item that is related in some way to another Item."@en;
                     rdfs:domain openwemi:Item;
                     rdfs:isDefinedBy openwemi:;
                     rdfs:label "related Item"@en;
                     rdfs:range openwemi:Item;
                     rdfs:subPropertyOf dct:relation.
openwemi:relatedManifestation dct:description "This provides a non-specific relationship between two Manifestations. The specific relationship type can be defined as a sub-property of relatedManifestation."@en;
                              a rdf:Property;
                              rdfs:comment "A Manifestation that is related in some way to another Manifestation."@en;
                              rdfs:domain openwemi:Manifestation;
                              rdfs:isDefinedBy openwemi:;
                              rdfs:label "related Manifestation"@en;
                              rdfs:range openwemi:Manifestation;
                              rdfs:subPropertyOf dct:relation.
openwemi:relatedWork dct:description "This provides a non-specific relationship between two Works. The specific relationship type can be defined as a sub-property of relatedWork."@en;
                     a rdf:Property;
                     rdfs:comment "A Work that is related in some way to another Work."@en;
                     rdfs:domain openwemi:Work;
                     rdfs:isDefinedBy openwemi:;
                     rdfs:label "related Work"@en;
                     rdfs:range openwemi:Work;
                     rdfs:subPropertyOf dct:relation.
