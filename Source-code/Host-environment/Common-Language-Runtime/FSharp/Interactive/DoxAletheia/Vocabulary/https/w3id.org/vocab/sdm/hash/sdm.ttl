@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdm: <https://w3id.org/vocab/sdm#>.

<https://w3id.org/vocab/sdm> <http://purl.org/dc/terms/contributor> [<http://xmlns.com/foaf/0.1/name> "Kingsley Idehen" ; 
                                                                     <http://schema.org/affiliation> [<http://xmlns.com/foaf/0.1/name> "OpenLink Software" ; 
                                                                                                      <http://xmlns.com/foaf/0.1/homepage> <http://www.openlinksw.com/>]];
                             <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Ghislain Auguste Atemezing" ; 
                                                                 <http://xmlns.com/foaf/0.1/homepage> <http://www.atemezing.org/> ; 
                                                                 rdfs:seeAlso <http://www.eurecom.fr/~atemezin/gatemezing-foaf.rdf>];
                             <http://purl.org/dc/terms/description> "A small vocabulary for representing SPARQL endpoint metadata on the web"@en;
                             <http://purl.org/dc/terms/issued> "2013-10-14"^^xsd:date;
                             <http://purl.org/dc/terms/license> <http://www.opendatacommons.org/licenses/pddl/1.0/>;
                             <http://purl.org/dc/terms/modified> "2013-10-15"^^xsd:date,
                                                                 "2016-03-16"^^xsd:date;
                             <http://purl.org/dc/terms/title> "SPARQL endpoint metadata"@en;
                             a <http://www.w3.org/2002/07/owl#Ontology>,
                               <http://purl.org/vocommons/voaf#vocabulary>;
                             rdfs:comment "A vocabulary to represent SPARQL endpoint metadata."@en;
                             <http://www.w3.org/2002/07/owl#versionInfo> "v0.1".
sdm:EndPointFeatureExtension a <http://www.w3.org/2002/07/owl#Class>,
                               rdfs:Class;
                             rdfs:comment "Principal class extending the sd:Feature for providing more metadata on an endpoint service. "@en;
                             rdfs:label "EndPoint feature extension"@fr;
                             rdfs:subClassOf <http://www.w3.org/ns/sparql-service-description#Feature>.
sdm:SPARQLRequest a <http://www.w3.org/2002/07/owl#Class>,
                    rdfs:Class;
                  rdfs:label "SPARQL request"@en;
                  rdfs:subClassOf <http://www.w3.org/2011/http#Request>.
sdm:TripleStore a <http://www.w3.org/2002/07/owl#Class>,
                  rdfs:Class;
                rdfs:label "Triple store"@en;
                rdfs:subClassOf <http://purl.org/dc/dcmitype/Software>.
sdm:developer a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                rdf:Property;
              rdfs:comment "Developer of the triple store"@en;
              rdfs:domain sdm:TripleStore;
              rdfs:label "developer"@en;
              rdfs:range <http://www.w3.org/ns/org#Organization>.
sdm:httpMessage a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "Links to the message of an http connection, and helps to connect with http:httpVersion which is a rdfs:Literal"@en;
                rdfs:domain sdm:EndPointFeatureExtension;
                rdfs:label "http message"@en;
                rdfs:range <http://www.w3.org/2011/http#Message>.
sdm:maxResultPerRequest a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                          rdf:Property;
                        rdfs:comment "The limit of the maximum results for the endpoint service"@en;
                        rdfs:domain sdm:EndPointFeatureExtension;
                        rdfs:label "Max results per request"@en;
                        rdfs:range xsd:integer.
sdm:mirror a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
             rdf:Property;
           rdfs:comment "URI of a mirror of the endpoint service"@en;
           rdfs:domain sdm:EndPointFeatureExtension;
           rdfs:label "mirror"@en;
           rdfs:range xsd:anyURI.
sdm:queryTimeOut a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "The timeout of a query in milliseconds"@en;
                 rdfs:domain sdm:EndPointFeatureExtension;
                 rdfs:label "query time out"@en;
                 rdfs:range xsd:integer.
sdm:remainingPerRequest a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                          rdf:Property;
                        rdfs:comment "The remaining results for a given request"@en;
                        rdfs:domain sdm:EndPointFeatureExtension;
                        rdfs:label "Remaining per request"@en;
                        rdfs:range xsd:integer.
sdm:request a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              rdf:Property;
            rdfs:comment "Links to a SPARQL request"@en;
            rdfs:domain sdm:EndPointFeatureExtension;
            rdfs:label "requests"@en;
            rdfs:range sdm:SPARQLRequest.
sdm:scheduledDowntime a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        rdf:Property;
                      rdfs:comment "Links to an interval period time"@en;
                      rdfs:domain sdm:EndPointFeatureExtension;
                      rdfs:label "scheduled downtime"@en;
                      rdfs:range <http://reference.data.gov.uk/def/intervals/CalendarInterval>.
sdm:tripleStore a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "Links to a given software acting as a triple store"@en;
                rdfs:domain sdm:EndPointFeatureExtension;
                rdfs:label "tripleStore"@en;
                rdfs:range sdm:TripleStore.
