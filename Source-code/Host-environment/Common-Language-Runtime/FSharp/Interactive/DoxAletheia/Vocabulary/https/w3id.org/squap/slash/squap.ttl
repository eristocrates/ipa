<https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic> a <http://www.w3.org/2002/07/owl#Class>,
                                                                          <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                          squap:ArchitecturalAlignment;
                                                                        rdfs:label "Objective characteristic";
                                                                        rdfs:subClassOf squap:ArchitecturalAlignment.
<https://w3id.org/squap/ArchitecturalAlignment/Stakeholder> a <http://www.w3.org/2002/07/owl#Class>,
                                                              <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                              squap:ArchitecturalAlignment;
                                                            rdfs:label "Stakeholder";
