                                                                       squap:ArchitecturalAlignment;
                                                                     rdfs:label "Architecture rational";
                                                                     rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>;
                                                                     squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/ArchitectureView> a <http://www.w3.org/2002/07/owl#Class>,
                                                                   <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                   squap:ArchitecturalAlignment;
                                                                 rdfs:label "Architecture view";
                                                                 rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>;
                                                                 squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/ArchitectureViewpoint> a <http://www.w3.org/2002/07/owl#Class>,
                                                                        <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                        squap:ArchitecturalAlignment;
                                                                      rdfs:label "Architecture viewpoint";
                                                                      rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>;
                                                                      squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/Concern> a <http://www.w3.org/2002/07/owl#Class>,
