                                                          squap:ArchitecturalAlignment;
                                                        rdfs:label "Concern";
                                                        rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>;
                                                        squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/Correspondence> a <http://www.w3.org/2002/07/owl#Class>,
                                                                 <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                 squap:ArchitecturalAlignment;
                                                               rdfs:label "Correspondence";
                                                               rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>;
                                                               squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/CorrespondenceRules> a <http://www.w3.org/2002/07/owl#Class>,
                                                                      <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                      squap:ArchitecturalAlignment;
                                                                    rdfs:label "Correspondence rules";
                                                                    rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>;
                                                                    squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/ObjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/Environment> a <http://www.w3.org/2002/07/owl#Class>,
                                                              <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                              squap:ArchitecturalAlignment;
                                                            rdfs:label "Environment";
                                                            rdfs:subClassOf <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>;
                                                            squap:specializes <https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic>.
<https://w3id.org/squap/ArchitecturalAlignment/ModelKind> a <http://www.w3.org/2002/07/owl#Class>,
                                                            <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                            squap:ArchitecturalAlignment;
                                                          rdfs:label "Model kind";
