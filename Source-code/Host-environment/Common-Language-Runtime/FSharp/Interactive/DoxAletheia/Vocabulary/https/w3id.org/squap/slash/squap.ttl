<https://w3id.org/squap/ArchitecturalAlignment/SubjectiveCharacteristic> a <http://www.w3.org/2002/07/owl#Class>,
                                                                           <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                           squap:ArchitecturalAlignment;
                                                                         rdfs:label "Subjective characteristic";
                                                                         rdfs:subClassOf squap:ArchitecturalAlignment.
<https://w3id.org/squap/ArchitecturalAlignment/System-of-Interest> a <http://www.w3.org/2002/07/owl#Class>,
                                                                     <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                                                     squap:ArchitecturalAlignment;
                                                                   rdfs:label "System-of-Interest";
