@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gleif-elf: <https://www.gleif.org/ontology/EntityLegalForm/>.

gleif-elf: <http://purl.org/dc/terms/abstract> "Ontology defining concepts for Entity Legal Forms and their abbreviations by jurisdiction, based on ISO 20275. Though used by Global Legal Entity Identifier Foundation (GLEIF)  for Legal Entity Identifier registration, it is more broadly applicable."@en;
           <http://purl.org/dc/terms/contributor> <https://www.linkedin.com/in/peterivett/>,
                                                  <http://purl.org/bryon>,
                                                  <http://www.workingontologist.com/>;
           <http://purl.org/dc/terms/creator> <https://www.gleif.org/ontology/Base/GLEIF>;
           <http://purl.org/dc/terms/issued> "2019-02-01T00:00:00+00:00"^^xsd:dateTime;
           <http://purl.org/dc/terms/license> "https://www.gleif.org/en/meta/lei-data-terms-of-use/"^^xsd:anyURI;
           <http://purl.org/dc/terms/rights> "Copyright (c) 2019 Global Legal Entity Identifier Foundation (GLEIF)";
           <http://purl.org/dc/terms/rightsHolder> <https://www.gleif.org/ontology/Base/GLEIF>;
           <http://purl.org/dc/terms/source> "https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI;
           <http://purl.org/dc/terms/title> "Entity Legal Form Ontology"@en;
           <http://purl.org/vocab/vann/preferredNamespacePrefix> "gleif-elf";
           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://www.gleif.org/ontology/EntityLegalForm/";
           a <http://purl.org/vocommons/voaf#Vocabulary>,
             <http://www.w3.org/2002/07/owl#Ontology>;
           rdfs:label "Entity Legal Form Ontology";
           <http://www.w3.org/2002/07/owl#imports> <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/>,
                                                   <https://www.gleif.org/ontology/Base/>;
           <http://www.w3.org/2002/07/owl#versionIRI> <https://www.gleif.org/ontology/EntityLegalForm-v1.0/EntityLegalForm/>.
gleif-elf:ELFregistry a <https://www.gleif.org/ontology/Base/Registry>;
                      rdfs:isDefinedBy gleif-elf:;
                      rdfs:label "ELF registry";
                      <http://www.w3.org/2004/02/skos/core#altLabel> "Entity Legal Form list",
                                                                     "ELF list";
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "ELF registry";
                      <https://www.gleif.org/ontology/Base/hasWebsite> "https://www.gleif.org/en/about-lei/code-lists/iso-20275-entity-legal-forms-code-list"^^xsd:anyURI;
                      <https://www.gleif.org/ontology/Base/isManagedBy> <https://www.gleif.org/ontology/Base/GLEIF>.
gleif-elf:EntityLegalForm a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:isDefinedBy gleif-elf:;
                          rdfs:label "entity legal form";
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://www.omg.org/spec/LCC/Countries/CountryRepresentation/GeographicRegion> ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasCoverageArea> ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasNameTransliterated> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasNameLegalLocal> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasAbbreviationTransliterated> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/hasAbbreviationLocal> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>];
                          <http://www.w3.org/2004/02/skos/core#definition> "The legal form of the entity, taken from the ISO Entity Legal Form (ELF) code list maintained by GLEIF. ".
gleif-elf:EntityLegalFormIdentifier a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:isDefinedBy gleif-elf:;
                                    rdfs:label "entity legal form identifier";
                                    rdfs:subClassOf <https://www.gleif.org/ontology/Base/Identifier>,
                                                    [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> <https://www.gleif.org/ontology/Base/identifies> ; 
                                                     <http://www.w3.org/2002/07/owl#onClass> gleif-elf:EntityLegalForm ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                                    <http://www.w3.org/2004/02/skos/core#definition> "A current code from the GLEIF-maintained list MUST be used. Values of the LegalFormEnum code list are maintained by GLEIF on behalf of ISO through the Entity Legal Form (ELF) as defined in ISO 20275.".
