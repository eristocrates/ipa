                             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                         "stabile"@it.
ddesc:isAgeRangeInvolvedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment """This is the inverse property of \"involves age range\"."""@en,
                                        """Questa è la proprietà inversa di \"coinvolge fascia d'età\"."""@it;
                           rdfs:domain ddesc:AgeRange;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
