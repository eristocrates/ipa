ddesc:isDesignationInTimeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment """Questa è la proprietà inversa di \"ha designazione nel tempo\"."""@it,
                                         """This is the inverse property of \"has designation in time\"."""@en;
                            rdfs:domain ddesc:DesignationInTime;
                            rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
