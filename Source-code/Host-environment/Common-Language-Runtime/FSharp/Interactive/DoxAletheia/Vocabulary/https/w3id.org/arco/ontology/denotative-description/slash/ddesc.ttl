                                                "è metodo di memorizzazione e profondità del colore di"@it;
                                     rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                     rdfs:subPropertyOf ddesc:isTechnicalCharacteristicOf;
                                     <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                                 "stabile"@it.
ddesc:isSupportOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """This property connects a support (e.g. \"paper label\") to an element (stamp, embelem, inscription, mark) which has been represented on it. It is the inverse property of hasSupport."""@en,
                               """Questa proprietà, inversa di \"ha supporto\", collega un supporto (es.: \"etichetta di carta\") all'elemento (timbro, emblema, iscrizione, marchio) che vi viene rappresentato."""@it;
                  rdfs:domain ddesc:Support;
                  rdfs:isDefinedBy <https://w3id.org/arco/denotative-description>;
                  rdfs:label "is support of"@en,
                             "è supporto di"@it;
                  rdfs:range ddesc:AffixedElement;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                              "stabile"@it;
                  <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISES".
ddesc:isTechnicalCharacteristicOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "This property relates a technical characteristic to an entity."@en,
                                               "Questa proprietà collega una caratteristica tecnica all'entità che ha quella caratteristica."@it;
                                  rdfs:domain ddesc:TechnicalCharacteristic;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                  rdfs:label "è caratteristica tecnica di"@it,
                                             "is technical characteristic of"@en;
                                  rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                              "stable"@en.
ddesc:isTechnicalConceptUsedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "This property relates a technical concept (e.g. material) used in the technical description of a cultural property."@en,
                                            "Questa proprietà collega un concetto tecnico (es.: materia) usato nella descrizione tecnica di un bene culturale."@it;
                               rdfs:domain ddesc:TechnicalConcept;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                               rdfs:label "is technical concept used in"@en,
                                          "è concetto tecnico usato in"@it;
                               rdfs:range ddesc:CulturalEntityTechnicalDescription;
                               <http://www.w3.org/2002/07/owl#inverseOf> ddesc:usesTechnicalConcept;
                               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                           "stable"@en.
ddesc:isTechnicalDescriptionSatisfiedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment "This property relates a technical description of a cultural entity to a situation that satisfies that description."@en;
                                        rdfs:domain ddesc:CulturalEntityTechnicalDescription;
                                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                        rdfs:label "è descrizione di entità culturale soddisfatta da"@it,
                                                   "is cultural entity description satisfied by"@en;
                                        rdfs:range ddesc:CulturalEntityTechnicalStatus;
                                        <http://www.w3.org/2002/07/owl#inverseOf> ddesc:satisfiesTechnicalDescription;
                                        <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                                    "stabile"@it.
ddesc:isTechnicalStatusOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Questa proprietà collega uno stato tecnico di un'entità culturale a un'entità culturale. Lo stato è valido fino a determinato momento ed è rappresentato dalle caratteristiche tecniche che il bene culturale ha in quel momento."@it,
                                       "This property connects a technical status to a cultural entity. This status is valid until a specific moment and is represented by the technical characteristics that a cultural entity has in that moment."@en;
                          rdfs:domain ddesc:CulturalEntityTechnicalStatus;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                          rdfs:label "is technical status of"@en,
                                     "è stato tecnico di"@it;
                          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                          rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/isSituationOf>;
                          <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                      "stable"@en.
ddesc:isTechnicalStatusValidAt a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Questa proprietà collega uno stato tecnico di un'entità culturale all'intervallo temporale entro il quale è valido, relativamente al momento in cui quelle caratteristiche sono state rilevate."@it,
                                            "This property relates a cultural entity technical status to the time interval until which that status is valid, with regard to the moment in which the characteristics are observed."@en;
                               rdfs:domain ddesc:CulturalEntityTechnicalStatus;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                               rdfs:label "è stato tecnico di entità culturale valido fino a"@it,
                                          "is cultural entity technical status valid at"@en;
                               rdfs:range <https://w3id.org/italia/onto/TI/TimeInterval>;
                               <http://www.w3.org/2002/07/owl#inverseOf> ddesc:isTimeIntervalValidFor;
                               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                           "stable"@en.
ddesc:isTechniqueOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment """This is the inverse property of \"has technique\""""@en,
                                 """Questa è la proprietà inversa di \"ha materia e tecnica\""""@it;
                    rdfs:domain ddesc:TechnicalCharacteristic;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                    rdfs:label "è tecnica di"@it,
                               "is technique of"@en;
                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                    rdfs:subPropertyOf ddesc:isMaterialOrTechniqueOf;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                "stable"@en.
ddesc:isTemperamentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment """This is the inverse property of \"has temperament\"."""@en,
                                   """Questa è la proprietà inversa di \"ha temperamento\"."""@it;
                      rdfs:domain ddesc:TechnicalCharacteristic;
                      rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                      rdfs:label "is temperament of"@en,
                                 "è temperamento di"@it;
                      rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                      rdfs:subPropertyOf ddesc:isTechnicalCharacteristicOf;
                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                  "stabile"@it.
ddesc:isTimeIntervalValidFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Questa proprietà collega un intervallo temporale entro il quale è valido uno stato tecnico di un'entità culturale allo stato tecnico stesso, relativamente al momento in cui quelle caratteristiche sono state rilevate."@it,
                                          "This property relates the time interval, at which a cultural entity technical status is valid, to that technical status, with regard to the moment in which the characteristics are observed."@en;
                             rdfs:domain <https://w3id.org/italia/onto/TI/TimeInterval>;
                             rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                             rdfs:label "is time interval valid for"@en,
                                        "è intervallo di tempo valido per"@it;
                             rdfs:range ddesc:CulturalEntityTechnicalStatus;
                             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                         "stabile"@it.
ddesc:isTuningOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment """This is the inverse property of \"has tuning\"."""@en,
                              """Questa è la proprietà inversa di \"ha accordatura\"."""@it;
                 rdfs:domain ddesc:TechnicalCharacteristic;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                 rdfs:label "is tuning of"@en,
                            "è accordatura di"@it;
                 rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                 rdfs:subPropertyOf ddesc:isTechnicalCharacteristicOf;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it.
ddesc:isValueOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment """Questa è la proprietà inversa di \"ha valore\"."""@it,
                             """This is the inverse property of \"has value\"."""@en;
                rdfs:domain <https://w3id.org/italia/onto/MU/Value>;
                rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                rdfs:label "è valore di"@it,
                           "is value of"@en;
                rdfs:range ddesc:Measurement;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                            "stabile"@it.
ddesc:isVibratingLenghtOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment """Questa è la proprietà inversa di \"ha lunghezza vibrante\"."""@it,
                                       """This is the inverse property of \"has vibrating lenght\"."""@en;
                          rdfs:domain ddesc:TechnicalCharacteristic;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                          rdfs:label "è lunghezza vibrante di"@it,
                                     "is vibrating lenght of"@en;
                          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                          rdfs:subPropertyOf ddesc:isTechnicalCharacteristicOf;
                          <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                      "stabile"@it.
ddesc:isVolumetricDimensionsMeasurementIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment """This is the inverse property of \"has volumetric dimensions measurement\"."""@en,
                                                       """Questa è la proprietà inversa di \"ha misura di ingombro\"."""@it;
                                          rdfs:domain ddesc:Measurement;
                                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                          rdfs:label "è misura di ingombro di"@it,
                                                     "is volumetric dimensions measurement in"@en;
                                          rdfs:range ddesc:MeasurementCollection;
                                          rdfs:subPropertyOf ddesc:isMeasurementIn;
                                          <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                                      "stable"@en.
ddesc:isWritingSystemOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment """Questa è la proprietà inversa di \"ha sistema di scrittura\"."""@it,
                                     """This is the inverse property of \"has writing system\"."""@en;
                        rdfs:domain ddesc:WritingSystem;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                        rdfs:label "is writing system of"@en,
                                   "è sistema di scrittura di"@it;
                        rdfs:range ddesc:AffixedElement;
                        <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                    "stabile"@it.
ddesc:italianTranslation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Questa proprietà rappresenta la traduzione italiana della trascrizione di un testo contenuto in un'iscrizione, un'emblema, etc."@it,
                                      "This property represents the italian translation of a text transcription contained in an inscription, emblem etc."@en;
                         rdfs:domain ddesc:AffixedElement;
                         rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                         rdfs:label "italian translation"@en,
                                    "traduzione italiana"@it;
                         rdfs:range rdfs:Literal;
                         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                     "stable"@en;
                         <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISEB".
ddesc:numberOfChildParticipants a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "Questa proprietà rappresenta il numero dei bambini che attuano una comunicazione (verbale, musicale vocale)."@it,
                                             "This property represents the number of the child participants to a communication (verbal, singing, kinesic)."@en;
                                rdfs:domain ddesc:CommunicationMedium;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                rdfs:label "numero di partecipanti infantili"@it,
                                           "number of child participants"@en;
                                rdfs:range xsd:integer;
                                <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                            "stabile"@it;
                                <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa BDI: CU/CUV/CUVI; CU/CUM/CUMI".
ddesc:numberOfFemaleParticipants a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "Questa proprietà rappresenta il numero delle persone di sesso femminile che attuano una comunicazione (verbale, musicale vocale, cinesica)."@it,
                                              "This property represents the number of the male participants to a communication (verbal, singing, kinesic)."@en;
                                 rdfs:domain ddesc:CommunicationMedium;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                 rdfs:label "numero di partecipanti femminili"@it,
                                            "number of female participants"@en;
                                 rdfs:range xsd:integer;
                                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                             "stable"@en;
                                 <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa BDI: CU/CUV/CUVF; CU/CUM/CUMF; CU/CUC/CUCF".
ddesc:numberOfMaleParticipants a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                               rdfs:comment "Questa proprietà rappresenta il numero delle persone di sesso maschile che attuano una comunicazione (verbale, musicale vocale, cinesica)"@it,
                                            "This property represents the number of the male participants to a communication (verbal, singing, kinesic)."@en;
                               rdfs:domain ddesc:CommunicationMedium;
                               rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                               rdfs:label "numero di partecipanti maschili"@it,
                                          "number of male participants"@en;
                               rdfs:range xsd:integer;
                               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                           "stable"@en;
                               <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa BDI: CU/CUV/CUVM; CU/CUM/CUMM; CU/CUC/CUCM".
ddesc:occurrences a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                    <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Questa proprietà rappresenta le occorrenze di un emblema, marchio, iscrizione, etc., su uno stesso bene culturale, cioè quante volte l'elemento descritto compare sul bene."@it,
                               "This property represents the occurrences of an affixed element on a cultular entity, that is how many times the outlined element appears on the cultual entity."@en;
                  rdfs:domain ddesc:AffixedElement;
                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                  rdfs:label "occurrences"@en,
                             "occorrenze"@it;
                  rdfs:range rdfs:Literal;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                              "stable"@en;
                  <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISEQ - Normative di versioni precedenti: DA/STM/STMU"@it.
ddesc:positionInComplexCulturalProperty a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                        rdfs:comment "Questa proprietà rappresenta la posizione di un bene rispetto al bene complesso di cui è parte componente."@it,
                                                     "This property represents a cultural entity's position with respect to a complex entity to which it belongs."@en;
                                        rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity>;
                                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                        rdfs:label "posizione rispetto al bene culturale complesso"@it,
                                                   "position in complex cultural property"@en;
                                        rdfs:range rdfs:Literal;
                                        <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                                    "stabile"@it;
                                        <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normative OA e RA: OG/OGT/OGTP"@it.
ddesc:positionOnCulturalProperty a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "Questa proprietà rappresenta la posizione di un oggetto (es.: elementi come stemmi, emblemi, timbri, etc., oppure i soggetti rappresentati) rispetto all'intero bene o a una sua specifica parte."@it,
                                              "This property represents a cultural entity's postion (e.g. elements like crests, emblems, stamps or the depicted subjects), with respect to the whole entity or to its specific part."@en;
                                 rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                 rdfs:label "position on cultural property"@en,
                                            "posizione su bene culturale"@it;
                                 rdfs:range rdfs:Literal;
                                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                             "stable"@en;
                                 <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISEP - Normative di versioni precedenti: DA/STM/STMP; DA/ISR/ISRP - Normativa A: LI/LSI/LSIU - Normativa PST: OG/SGT/SGTP - ICCD Normative MA, CA, SI, SAS: MC/CMN/CMNP"@it.
ddesc:proposedIntervention a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "Questa proprietà rappresenta eventuali proposte per interventi conservativi, dopo aver valutato le condizioni del bene al momento della sua catalogazione."@it,
                                        "This property represents potential proposals for conservative interventions after evaluating the cultual entity's conditions at time of its cataloguing."@en;
                           rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity>;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                           rdfs:label "proposte di interventi"@it,
                                      "proposed intervention"@en;
                           rdfs:range rdfs:Literal;
                           <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                       "stabile"@it;
                           <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "CO/STP".
ddesc:refersToAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property connects a crest, emblem, postmark etc., located on a cultural entity to the agent (e.g. family, factory, cave, silversmith) to which it refers."@en,
                                 "Questa proprietà collega un uno stemma, un emblema, un timbro, etc., presente su un bene culturale, all'agente (la famiglia, la fabbrica, la cava, l'argentiere, etc.) a cui si riferisce l'elemento."@it;
                    rdfs:domain ddesc:AffixedElement;
                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                    rdfs:label "refers to agent"@en,
                               "si riferisce ad agente"@it;
                    rdfs:range <https://w3id.org/italia/onto/l0/Agent>;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                "stable"@en;
                    <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISES - Normative di versioni precedenti: DA/STM/STMI"@it.
ddesc:sampleCollectedIdentifier a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "Questa proprietà rappresenta il numero che identifica il campione."@it,
                                             "This property represents the seample collected identifier."@en;
                                rdfs:domain ddesc:SampleCollected;
                                rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                rdfs:label "identificativo del campione prelevato"@it,
                                           "sample collected identifier"@en;
                                rdfs:range rdfs:Literal;
                                rdfs:subPropertyOf <https://w3id.org/italia/onto/l0/identifier>;
                                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                            "stable"@en;
                                <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa MA, CA, SI, SAS: MC/CMN".
ddesc:satisfiesTechnicalDescription a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "This property relates a technical status (intended as a situaiton) of a cultural entity to the technical description satisfied by that situation."@en;
                                    rdfs:domain ddesc:CulturalEntityTechnicalStatus;
                                    rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                    rdfs:label "satisfies technical description"@en,
                                               "soddisfa descrizione tecnica"@it;
                                    rdfs:range ddesc:CulturalEntityTechnicalDescription;
                                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                                "stable"@en.
ddesc:storageConditions a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Questa proprietà rappresenta informazioni sulle condizioni ambientali e microclimatiche in cui si trova il bene al momento della catalogazione ed eventuali indicazioni per una sua corretta conservazione."@it,
                                     "This property represents informations about the storage conditions of a cultural property."@en;
                        rdfs:domain <http://dati.beniculturali.it/cis/CulturalEntity>;
                        rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                        rdfs:label "storage conditions"@en,
                                   "modalità di conservazione"@it;
                        rdfs:range rdfs:Literal;
                        <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                    "stable"@en;
                        <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "CO/STD".
ddesc:transcript a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "This property connects an inscription, emblem etc., to the text's transcription, using scientifically accepted integrations."@en,
                              "Questa proprietà collega un'iscrizione, un emblema, etc., alla trascrizione del testo, utilizzando scioglimenti e integrazioni scientificamente accettati."@it;
                 rdfs:domain ddesc:AffixedElement;
                 rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                 rdfs:label "trascrizione"@it,
                            "transcript"@en;
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it;
                 <https://w3id.org/arco/ontology/catalogue/iccdNormTag> "ICCD Normativa Trasversale 4.00: DA/ISE/ISEI - Normative di versioni precedenti: DA/ISR/ISRI"@it.
ddesc:usesTechnicalConcept a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Questa proprietà collega una descrizione tecnica di un bene culturale a uno dei concetti usati in quella descrizione."@it,
                                        "This property relates a technical description of a cultural property to one of the concepts used in that description."@en;
                           rdfs:domain ddesc:CulturalEntityTechnicalDescription;
                           rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                           rdfs:label "usa concetto tecnico"@it,
