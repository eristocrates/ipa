                                     <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                                 "stable"@en.
ddesc:isCulturalPropertySpecificationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment """This is the inverse property of \"has cultural property specification\"."""@en,
                                                     """Questa è la proprietà inversa di \"ha specifiche del bene culturale\"."""@it;
                                        rdfs:domain ddesc:CulturalPropertySpecification;
