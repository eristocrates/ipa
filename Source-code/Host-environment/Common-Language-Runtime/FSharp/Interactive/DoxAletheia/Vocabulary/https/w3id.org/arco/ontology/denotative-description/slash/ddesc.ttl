ddesc:isDesignationTypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment """Questa è la proprietà inversa di \"ha tipo di denominazione\"."""@it,
                                       """This is the inverse property of \"has designation type\"."""@en;
                          rdfs:domain ddesc:DesignationType;
