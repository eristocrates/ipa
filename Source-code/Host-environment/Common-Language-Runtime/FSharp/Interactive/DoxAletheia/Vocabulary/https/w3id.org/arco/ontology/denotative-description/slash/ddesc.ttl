                              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                          "stable"@en.
ddesc:isCommunicationMediumTypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment """Questa è la proprietà inversa di \"ha tipo di modalità comunicativa\"."""@it,
                                               """This is the inverse property of \"has communication medium type\"."""@en;
                                  rdfs:domain ddesc:CommunicationMediumType;
                                  rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                                  rdfs:label "is communication medium type of"@en,
