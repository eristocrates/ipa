                                   rdfs:subPropertyOf <https://w3id.org/arco/ontology/core/hasConcept>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                               "stable"@en.
ddesc:isCommunicationMediumOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment """This is the inverse property of \"has communication medium\"."""@en,
                                           """Questa è la proprietà inversa di \"ha modalità comunicativa\"."""@it;
                              rdfs:domain ddesc:CommunicationMedium;
