ddesc:isAffixedElementTypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment """Questa è la proprietà inversa di \"ha tipo di elemento apposto\"."""@it,
                                          """This is the inverse property of \"has affixed element type\"."""@en;
