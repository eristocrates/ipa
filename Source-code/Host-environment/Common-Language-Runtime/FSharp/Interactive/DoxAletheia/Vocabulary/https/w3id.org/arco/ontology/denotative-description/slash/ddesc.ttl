                           rdfs:range ddesc:CommunicationMedium;
                           <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                       "stable"@en.
ddesc:isAgentReferredToBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment """This is the inverse property of \"refers to agent\"."""@en,
                                       """Questa è la proprietà inversa a \"si riferisce ad agente\"."""@it;
                          rdfs:domain <https://w3id.org/italia/onto/l0/Agent>;
                          rdfs:isDefinedBy <https://w3id.org/arco/ontology/denotative-description>;
                          rdfs:label "is agent referred to by"@en,
                                     "è agente cui si riferisce"@it;
                          rdfs:range ddesc:AffixedElement;
                          <http://www.w3.org/2002/07/owl#inverseOf> ddesc:refersToAgent;
                          <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                      "stabile"@it.
ddesc:isCharacteristicClassifiedBy <http://ontologydesignpatterns.org/opla/isNativeTo> <https://w3id.org/arco/pattern/technical-characteristic/>;
                                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "Questa proprietà collega una caratteristica tecnica di un'entità - come un bene culturale - a un concetto tecnico, che la classifica."@it,
                                                "This property connects an entity's techincal characteristic to a technical concept, which classifies that characteristic."@en;
