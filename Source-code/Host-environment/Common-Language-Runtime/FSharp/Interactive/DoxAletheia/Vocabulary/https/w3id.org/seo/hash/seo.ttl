                               a owl:Restriction],
                              [owl:unionOf (doco:Chapter
                                            doco:Section) ; 
                               a owl:Class],
                              [owl:unionOf (pattern:Block
                                            pattern:Container) ; 
                               a owl:Class],
                              [owl:allValuesFrom pattern:Block ; 
                               owl:onProperty pattern:containsAsHeader ; 
                               a owl:Restriction],
                              [owl:allValuesFrom [a owl:Class ; 
                                                  owl:intersectionOf (pattern:Bucket
                                                                      [owl:allValuesFrom [owl:unionOf (pattern:Container
                                                                                                      pattern:Popup) ; 
                                                                                         a owl:Class] ; 
                                                                      owl:onProperty pattern:isContainedBy ; 
                                                                      a owl:Restriction])] ; 
                               owl:onProperty pattern:isContainedBy ; 
                               a owl:Restriction],
                              [owl:someValuesFrom [owl:unionOf (doco:Paragraph
                                                                doco:Section) ; 
                                                   a owl:Class] ; 
                               owl:onProperty pattern:contains ; 
                               a owl:Restriction],
                              [owl:someValuesFrom [owl:complementOf doco:Chapter ; 
                                                   a owl:Class] ; 
                               owl:onProperty pattern:contains ; 
                               a owl:Restriction],
                              [a owl:Class ; 
                               owl:intersectionOf (pattern:Bucket
                                                   [owl:allValuesFrom [owl:unionOf (pattern:Container
                                                                                   pattern:Popup) ; 
                                                                      a owl:Class] ; 
                                                   owl:onProperty pattern:isContainedBy ; 
                                                   a owl:Restriction])],
                              pattern:HeadedContainer,
                              [a owl:Class ; 
                               owl:intersectionOf (doco:Section
                                                   pattern:HeadedContainer)],
                              [owl:allValuesFrom [owl:unionOf (pattern:Block
                                                               pattern:Container
                                                               pattern:Field
                                                               pattern:Meta) ; 
                                                  a owl:Class] ; 
                               owl:onProperty pattern:contains ; 
                               a owl:Restriction],
                              [owl:unionOf (doco:Paragraph
                                            doco:Section) ; 
                               a owl:Class],
                              [owl:unionOf (pattern:Block
                                            pattern:Container
                                            pattern:Field
                                            pattern:Meta) ; 
                               a owl:Class],
                              [owl:complementOf pattern:Textual ; 
                               a owl:Class],
                              [owl:someValuesFrom doco:BackMatter ; 
                               owl:onProperty dcterms:isPartOf ; 
                               a owl:Restriction],
                              [owl:someValuesFrom [owl:unionOf (doco:BackMatter
                                                                doco:FrontMatter) ; 
                                                   a owl:Class] ; 
                               owl:onProperty dcterms:isPartOf ; 
                               a owl:Restriction],
                              [a owl:Class ; 
                               owl:intersectionOf (deo:DiscourseElement
                                                   pattern:HeadedContainer)].
doco:BackMatter a owl:Class.
doco:BodyMatter a owl:Class.
doco:Chapter a owl:Class.
doco:FrontMatter a owl:Class.
doco:Paragraph a owl:Class.
doco:Section a owl:Class.
fabio:ConferencePaper a owl:Class;
                      rdfs:subClassOf [owl:allValuesFrom fabio:Work ; 
                                       owl:onProperty frbrcore:realizationOf ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom fabio:Manifestation ; 
                                       owl:onProperty frbrcore:embodiment ; 
                                       a owl:Restriction],
                                      [a owl:Class ; 
                                       owl:intersectionOf ([owl:allValuesFrom frbrcore:Expression ; 
                                                           owl:onProperty frbrcore:part ; 
                                                           a owl:Restriction]
                                                           [owl:allValuesFrom frbrcore:Expression ; 
                                                           owl:onProperty frbrcore:partOf ; 
                                                           a owl:Restriction])],
                                      fabio:Expression.
fabio:ConferencePoster a owl:Class;
                       rdfs:subClassOf [owl:allValuesFrom fabio:Work ; 
                                        owl:onProperty frbrcore:realizationOf ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom fabio:Manifestation ; 
                                        owl:onProperty frbrcore:embodiment ; 
                                        a owl:Restriction],
                                       [a owl:Class ; 
                                        owl:intersectionOf ([owl:allValuesFrom frbrcore:Expression ; 
                                                            owl:onProperty frbrcore:part ; 
                                                            a owl:Restriction]
                                                            [owl:allValuesFrom frbrcore:Expression ; 
                                                            owl:onProperty frbrcore:partOf ; 
                                                            a owl:Restriction])].
fabio:ConferenceProceedings a owl:Class;
                            rdfs:subClassOf [owl:allValuesFrom fabio:Work ; 
                                             owl:onProperty frbrcore:realizationOf ; 
                                             a owl:Restriction],
                                            [owl:allValuesFrom fabio:Manifestation ; 
                                             owl:onProperty frbrcore:embodiment ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom fabio:ProceedingsPaper ; 
                                             owl:onProperty frbrcore:part ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom fabio:Expression ; 
                                             owl:onProperty frbrcore:part ; 
                                             a owl:Restriction],
                                            [a owl:Class ; 
                                             owl:intersectionOf ([owl:allValuesFrom frbrcore:Expression ; 
                                                                 owl:onProperty frbrcore:part ; 
                                                                 a owl:Restriction]
                                                                 [owl:allValuesFrom frbrcore:Expression ; 
                                                                 owl:onProperty frbrcore:partOf ; 
                                                                 a owl:Restriction])],
                                            fabio:ExpressionCollection,
                                            fabio:Expression.
fabio:Expression a owl:Class.
fabio:ExpressionCollection a owl:Class.
fabio:Manifestation a owl:Class.
fabio:ProceedingsPaper a owl:Class.
fabio:Work a owl:Class.
fabio:WorkingPaper a owl:Class;
                   rdfs:subClassOf [owl:allValuesFrom fabio:Expression ; 
                                    owl:onProperty frbrcore:realization ; 
                                    a owl:Restriction],
                                   [a owl:Class ; 
                                    owl:intersectionOf ([owl:allValuesFrom frbrcore:Work ; 
                                                        owl:onProperty frbrcore:part ; 
                                                        a owl:Restriction]
                                                        [owl:allValuesFrom frbrcore:Work ; 
                                                        owl:onProperty frbrcore:partOf ; 
                                                        a owl:Restriction])].
frbrcore:Expression a owl:Class.
frbrcore:Work a owl:Class.
frbrcore:embodiment a owl:ObjectProperty.
frbrcore:part a owl:ObjectProperty.
frbrcore:partOf a owl:ObjectProperty.
frbrcore:realization a owl:ObjectProperty.
frbrcore:realizationOf a owl:ObjectProperty.
sioc:e1 a swrl:Variable.
sioc:e2 a swrl:Variable.
sioc:ed1 a swrl:Variable.
sioc:ed2 a swrl:Variable.
sioc:l a swrl:Variable.
sioc:l1 a swrl:Variable.
sioc:l2 a swrl:Variable.
sioc:sd1 a swrl:Variable.
sioc:sd2 a swrl:Variable.
sro:Abstract a owl:Class.
swrc:Proceedings a owl:Class;
                 rdfs:subClassOf [owl:allValuesFrom swrc:Publication ; 
                                  owl:onProperty swrc:cite ; 
                                  a owl:Restriction].
swrc:Publication dc11:description "an article issued for public sale";
                 a owl:Class.
swrc:cite a owl:ObjectProperty.
swrc:keywords a owl:DatatypeProperty;
              rdfs:domain [owl:allValuesFrom swrc:Publication ; 
                           owl:onProperty swrc:cite ; 
                           a owl:Restriction],
                          swrc:Publication;
              rdfs:range xsd:string.
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> a owl:AnnotationProperty.
pattern:Block a owl:Class.
pattern:Bucket a owl:Class.
pattern:Container a owl:Class.
pattern:Field a owl:Class.
pattern:HeadedContainer a owl:Class.
pattern:Meta a owl:Class.
pattern:NonTextual a owl:Class.
pattern:Pattern a owl:Class.
pattern:Popup a owl:Class.
pattern:Structured a owl:Class.
pattern:Table a owl:Class.
pattern:Textual a owl:Class.
pattern:contains a owl:ObjectProperty.
pattern:containsAsHeader a owl:ObjectProperty.
pattern:isContainedBy a owl:ObjectProperty.
rdfs:Class a owl:Class.
xsd:date a rdfs:Datatype.
skos:note a owl:AnnotationProperty.
time:hasDuration a owl:AnnotationProperty;
                 rdfs:domain conference:OrganisedEvent.
time:hasTemporalDuration a owl:AnnotationProperty.
foaf:Agent a owl:Class.
conference:AcademicEvent a owl:Class.
conference:EventSeries a owl:Class.
conference:Proceedings a owl:Class.
conference:hasAddress rdfs:range conference:Agent.
conference:hasProceedings a owl:AnnotationProperty.
conference:holdsRoleIn rdfs:domain foaf:Person.
seo: dc11:creator "Said Fathalla",
                  "Christoph Lange";
     dcterms:created "2018-02-01"@en;
     dcterms:creator "Soeren Auer",
                     "Sahar Vahdati";
     dcterms:description "SEO is a reference ontology for modelling data about scientific events such as conferences, symposioums and workshops."@en;
     dcterms:lastModified "2019-04-10"@en;
     dcterms:license <http://creativecommons.org/licenses/by/3.0/>;
     dcterms:title "SEO, The Scientific Events Ontology."@en;
     vann:preferredNamespacePrefix "seo";
     vann:preferredNamespaceUri "http://purl.org/seo/"^^dcterms:URI;
     a owl:Ontology;
     rdfs:label "Scientific Events Ontology"@en;
     rdfs:seeAlso "See also documentation at http://kddste.sda.tech/SEOontology/Documentation/SEO.html"@en;
     owl:imports foaf:,
                 dbpedia-owl:,
                 <https://w3id.org/scholarlydata/ontology/conference-ontology.owl>;
     owl:versionInfo 1.1.
<https://w3id.org/seo#/> a owl:NamedIndividual.
seo:ArtificialIntelligence a seo:ResearchField,
                             owl:NamedIndividual.
seo:Author a owl:Class;
           rdfs:comment "The one who write the article."@en;
           rdfs:label "Author"@en;
           rdfs:subClassOf foaf:Person.
seo:AuthorRegistration a owl:Class;
                       rdfs:comment "At least one of the authors must register at the full rate in order for the paper to be published in the Proceedings."@en;
                       rdfs:label "Author registration"@en.
seo:Award a owl:Class;
          rdfs:comment "A price for the highest quality research."@en;
          rdfs:label "Award"@en.
seo:BestApplicationsPaperAward a owl:Class;
                               rdfs:comment "This award for the best application paper presented. "@en;
                               rdfs:label "Best applications paper award"@en;
                               rdfs:subClassOf seo:BestPaperAward.
seo:BestPaperAward a owl:Class;
                   rdfs:comment "This award recognizes the best paper presented."@en;
                   rdfs:label "Best paper award"@en;
                   rdfs:subClassOf seo:Award.
seo:BestPosterAward a owl:Class;
                    rdfs:comment "This award highlight good quality posters presented."@en;
                    rdfs:label "Best poster award"@en;
                    rdfs:subClassOf seo:Award.
seo:BestStudentPaperAward a owl:Class;
                          rdfs:comment "This award recognizes the best paper authored primarily by a student and presented by the student."@en;
                          rdfs:label "Best student paper award"@en;
                          rdfs:subClassOf seo:BestPaperAward.
seo:BronzeSponsorship a owl:Class;
                      rdfs:comment "A Sponsorship Package."@en;
                      rdfs:label "Bronze sponsorship"@en;
                      rdfs:subClassOf seo:Sponsorship.
seo:Chair a owl:Class;
          rdfs:comment "The Chair person must ensure that the Management Committee functions properly, that there is full participation during meetings, that all relevant matters are discussed and that effective decisions are made and carried out."@en;
          rdfs:label "Chair"@en;
          rdfs:subClassOf foaf:Person.
seo:ChallengeTrack a owl:Class;
                   rdfs:comment "The idea of the challenge track is to provide participants with a set of case studies and challenge the state of the art."@en;
                   rdfs:label "Challenge track"@en;
                   rdfs:subClassOf conference:Track.
seo:ComputerSystemsOrganization a seo:ResearchField,
                                  owl:NamedIndividual.
seo:DemoChair a owl:Class;
              rdfs:comment "A person responsible for assembling the system demonstration papers to be presented in the main conference program. "@en;
              rdfs:label "Demo chair"@en;
              rdfs:subClassOf seo:Chair.
seo:DemosTrack a owl:Class;
               rdfs:comment "Offer an opportunity for presenting late-breaking research results, on-going research projects, and speculative or innovative work in progress."@en;
               rdfs:label "Demos track"@en;
               rdfs:subClassOf conference:Track.
seo:DoctoralConsortium a owl:Class;
                       rdfs:comment "Provide PhD students an opportunity to share and develop their research ideas in a critical but supportive environment."@en;
                       rdfs:label "Doctoral consortium"@en;
                       rdfs:subClassOf conference:AcademicEvent.
seo:DoctoralConsortiumChair a owl:Class;
                            rdfs:comment "The event member who leads the doctoral consortium."@en;
                            rdfs:label "Doctoral consortium chair"@en;
                            rdfs:subClassOf seo:Chair.
seo:EarlyBirdRegistration a owl:Class;
                          rdfs:comment "Registration before a specific date."@en;
                          rdfs:label "Early bird registration"@en;
                          rdfs:subClassOf seo:Registration;
                          owl:disjointWith seo:LateRegistration.
seo:EventReception a owl:Class;
                   rdfs:comment "The reception event within a scientific event ."@en;
                   rdfs:label "Event reception"@en;
                   rdfs:subClassOf conference:SocialEvent.
seo:Flyer a owl:Class;
          rdfs:comment "An announcement or advertisement that is printed on a sheet of paper and given to people."@en;
          rdfs:label "Flyer"@en.
seo:GeneralChair a owl:Class;
                 rdfs:comment "A person responsible for overseeing and coordinating the whole conference. ."@en;
                 rdfs:label "General chair"@en;
                 rdfs:subClassOf seo:Chair.
seo:GetTogetherEvent a owl:Class;
                     rdfs:comment "Socially gather two or more people in one event ."@en;
                     rdfs:label "Get together event"@en;
                     rdfs:subClassOf conference:SocialEvent.
seo:GoldSponsorship a owl:Class;
                    rdfs:comment "Sponsorship Package."@en;
                    rdfs:label "Gold sponsorship"@en;
                    rdfs:subClassOf seo:Sponsorship.
seo:HonorChair a owl:Class;
               rdfs:comment "Chair of the conference ."@en;
               rdfs:label "Honor chair"@en;
               rdfs:subClassOf seo:Chair.
seo:HumanCenteredComputing a seo:ResearchField,
                             owl:NamedIndividual.
seo:ImportantDates a owl:Class;
                   rdfs:comment "Important dates to be noticed such as, abstract deadline, submission deadline, ...etc ."@en;
                   rdfs:label "Important dates"@en.
seo:In-useTrack a owl:Class;
                rdfs:comment "In-Use track provides researchers to discuss novel research taken to the market."@en;
                rdfs:label "In-use track"@en;
                rdfs:subClassOf conference:Track.
seo:IndustrialConference a owl:Class;
                         rdfs:comment "A business conference is held for people working in the same company or industry."@en;
                         rdfs:label "Industrial conference"@en;
                         rdfs:subClassOf conference:NonAcademicEvent.
seo:IndustryTrack a owl:Class;
                  rdfs:comment "The industry track seeks to present research contributions in industrial settings."@en;
                  rdfs:label "Industry track"@en;
                  rdfs:subClassOf conference:Track.
seo:InformationSystems a seo:ResearchField,
                         owl:NamedIndividual.
seo:InvitedSpeakers a owl:Class;
                    rdfs:comment "Invited person to give a speech in an event."@en;
                    rdfs:label "Invited speakers"@en;
                    rdfs:subClassOf foaf:Person.
seo:Keynote a owl:Class;
            rdfs:comment "A talk that establishes a main underlying the theme of the event.";
            rdfs:label "Keynote speech".
seo:KeynoteSpeaker a owl:Class;
                   rdfs:comment "Someone who gives the main address at a formal gathering such as a conference ."@en;
                   rdfs:label "Keynote speaker"@en;
                   rdfs:subClassOf seo:InvitedSpeakers.
seo:LateRegistration a owl:Class;
                     rdfs:comment "Registration after a specific deadline ."@en;
                     rdfs:label "Late registration"@en;
                     rdfs:subClassOf seo:Registration.
seo:LocalOrganisationChair a owl:Class;
                           rdfs:comment "The chair of the local organizers of the event. "@en;
                           rdfs:label "Local organisation chair"@en;
                           rdfs:subClassOf seo:Chair.
seo:OnSiteRegistration a owl:Class;
                       rdfs:comment "Process of signing up for an event on the day of, or at the site of, the event."@en;
                       rdfs:label "On site registration"@en;
                       rdfs:subClassOf seo:Registration.
seo:Organizer a owl:Class;
              rdfs:comment "A person who arranges an event or activity. ."@en;
              rdfs:label "Organizer"@en;
              rdfs:subClassOf foaf:Person.
seo:PHDSymposium a owl:Class;
                 rdfs:comment "Event for PHD student to present and receive feedback on their ongoing work."@en;
                 rdfs:label "PHD symposium"@en;
                 rdfs:subClassOf seo:Symposium.
seo:PastEvents a owl:Class;
               rdfs:comment "Events happened or existed before the present time. "@en;
               rdfs:label "Past events"@en.
seo:PlatinumSponsorship a owl:Class;
                        rdfs:comment "Sponsorship Package."@en;
                        rdfs:label "Platinum sponsorship"@en;
                        rdfs:subClassOf seo:Sponsorship.
seo:PosterChair a owl:Class;
                rdfs:comment "The poster chair is responsible for recruiting and selecting poster fair organizers for the fairs that fall under the shared interest category."@en;
                rdfs:label "Poster chair"@en;
                rdfs:subClassOf seo:Chair.
seo:PostersTrack a owl:Class;
                 rdfs:comment "Present research contributions as posters."@en;
                 rdfs:label "Posters track"@en;
                 rdfs:subClassOf conference:Track.
seo:ProgramChair a owl:Class;
                 rdfs:comment "The Program Chair is responsible for working to develop the annual program budget, manage chapter-programming delivery, monitor program quality, manage member satisfaction with programs, and manage all speaker communications. "@en;
                 rdfs:label "Program chair"@en;
                 rdfs:subClassOf seo:Chair.
seo:ProgramCommitteeMember a owl:Class;
                           rdfs:comment "The program committee is responsible for objectively and thoroughly reviewing all submissions, for submitting timely, informative reviews that provide authors with feedback about their submissions, and for attending the program committee meetings."@en;
                           rdfs:label "Program committee member"@en;
                           rdfs:subClassOf foaf:Person.
seo:ProgramSchedule a owl:Class;
                    rdfs:comment "A plan for carrying out a process or procedure, giving lists of intended events and times."@en;
                    rdfs:label "Program schedule"@en.
seo:Publisher a owl:Class;
              rdfs:comment "The publisher of the event proceedings."@en;
              rdfs:label "Publisher"@en;
              rdfs:subClassOf foaf:Organization.
seo:Registration a owl:Class;
                 rdfs:comment "The action or process of registering or of being registered."@en;
                 rdfs:label "Registration"@en.
seo:RegularRegistration a owl:Class;
                        rdfs:comment "Normal registration"@en;
                        rdfs:label "Regular registration"@en;
                        rdfs:subClassOf seo:AuthorRegistration;
                        owl:disjointWith seo:StudentRegistration.
seo:ResearchField a owl:Class;
                  rdfs:comment "Area of interest."@en;
                  rdfs:label "Research field"@en.
seo:ResearchTrack a owl:Class;
                  rdfs:comment "The track for fundamental research, innovative technology, and applications concerning the research topic of the event."@en;
                  rdfs:label "Research track"@en;
                  rdfs:subClassOf conference:Track.
seo:ResourceTrack a owl:Class;
                  rdfs:comment "The Resources Track aims to promote the sharing of resources including: datasets, ontologies, vocabularies, ... etc"@en;
                  rdfs:label "Resource track"@en;
                  rdfs:subClassOf conference:Track.
seo:Reviewer a owl:Class;
             rdfs:comment "A person who reviews the submissions and give feedback about the submitted articles."@en;
             rdfs:label "Reviewer"@en;
             rdfs:subClassOf foaf:Person.
seo:SecurityAndPrivacy a seo:ResearchField,
                         owl:NamedIndividual.
seo:SilverSponsorship a owl:Class;
                      rdfs:comment "Sponsorship Package."@en;
                      rdfs:label "Silver sponsorship"@en;
                      rdfs:subClassOf seo:Sponsorship.
seo:SoftwareEngineering a seo:ResearchField,
                          owl:NamedIndividual.
seo:Sponsor a owl:Class;
            rdfs:comment "The Sponsor of the event (i.e. company, university ... etc.)."@en;
            rdfs:label "Sponsor"@en;
            rdfs:subClassOf foaf:Organization.
seo:Sponsorship a owl:Class;
                rdfs:comment "Refer to a person or organization with some sort of responsibility for another person or organisation."@en;
                rdfs:label "Sponsorship"@en.
seo:SponsorshipChair a owl:Class;
                     rdfs:comment "A person responsible for collecting funding from two kinds of sources: granting institutions and corporations. "@en;
                     rdfs:label "Sponsorship chair"@en;
                     rdfs:subClassOf seo:Chair.
seo:Student a owl:Class;
            rdfs:comment "A person enrolled in a school or other educational institution."@en;
            rdfs:label "Student"@en;
            rdfs:subClassOf foaf:Person.
seo:StudentRegistration a owl:Class;
                        rdfs:comment "Students full-time enrolled in a college or university can register as a student for the reduced early career rate."@en;
                        rdfs:label "Student registration"@en;
                        rdfs:subClassOf seo:AuthorRegistration.
seo:SubmissionGuidelines a owl:Class;
                         rdfs:comment "Instructions for the submission process ."@en;
                         rdfs:label "Submission guidelines"@en.
seo:Symposium a owl:Class;
              rdfs:comment "A conference or meeting to discuss a particular subject."@en;
              rdfs:label "Symposium"@en;
              rdfs:subClassOf conference:AcademicEvent.
seo:SymposiumSeries a owl:Class;
                    rdfs:comment "A series of symposiums."@en;
                    rdfs:label "Symposiums series"@en;
                    rdfs:subClassOf conference:EventSeries.
seo:TheoryOfComputations a seo:ResearchField,
                           owl:NamedIndividual.
seo:TravelInformation a owl:Class;
                      rdfs:comment "The information about the travel: date, place, ...etc ."@en;
                      rdfs:label "Travel information"@en.
seo:TutorialChair a owl:Class;
                  rdfs:comment "A person responsible for requesting tutorial proposals and making final selections."@en;
                  rdfs:label "Tutorial chair"@en;
                  rdfs:subClassOf seo:Chair.
seo:WorkshopChair a owl:Class;
                  rdfs:comment "The one responsible for collaborating with the workshop chairs for other ACL-affiliated conferences in the given year, in preparing and circulating the Call for Proposals, and in reviewing submissions."@en;
                  rdfs:label "Workshop chair"@en;
                  rdfs:subClassOf seo:Chair.
seo:WorldWideWeb a seo:ResearchField,
                   owl:NamedIndividual.
seo:abstractDeadline a owl:DatatypeProperty;
                     rdfs:comment "The deadline of abstract submission.";
                     rdfs:domain conference:AcademicEvent;
                     rdfs:range xsd:date.
seo:acceptanceRate a owl:DatatypeProperty;
                   rdfs:comment "The acceptance rate of the event in a particular year."@en;
                   rdfs:domain conference:AcademicEvent;
                   rdfs:range xsd:decimal.
seo:acceptedPapers a owl:DatatypeProperty;
                   rdfs:comment "The number of accepted papers in the event."@en;
                   rdfs:domain conference:AcademicEvent;
                   rdfs:range xsd:unsignedInt.
seo:belongsToSeries a owl:ObjectProperty;
                    rdfs:comment "This property shows the series which an event belongs to."@en;
                    rdfs:domain conference:OrganisedEvent;
                    rdfs:label "belongsToSeries"@en;
                    rdfs:range conference:EventSeries;
                    owl:inverseOf seo:hasEvent.
seo:colocatedWith a owl:SymmetricProperty,
                    owl:ObjectProperty;
                  rdfs:comment "This property links an event to another one which is co-located with.";
                  rdfs:domain conference:OrganisedEvent;
                  rdfs:range conference:OrganisedEvent.
seo:eventWebsite a owl:DatatypeProperty;
                 rdfs:comment "The webpage of the event."@en;
                 rdfs:domain conference:AcademicEvent;
                 rdfs:range xsd:anyURI.
seo:hasAffiliation a owl:ObjectProperty;
                   rdfs:domain foaf:Person;
                   rdfs:range foaf:Organization.
seo:hasChair a owl:ObjectProperty;
             rdfs:domain conference:Track;
             rdfs:range seo:Chair.
seo:hasEvent a owl:ObjectProperty;
             rdfs:comment "an event series has an event edition";
             rdfs:domain conference:EventSeries;
             rdfs:range conference:OrganisedEvent.
seo:hasFlyer a owl:ObjectProperty;
             rdfs:domain conference:OrganisedEvent;
             rdfs:range seo:Flyer.
seo:hasImportantDates a owl:ObjectProperty;
                      rdfs:domain conference:AcademicEvent;
                      rdfs:range seo:ImportantDates.
seo:hasKeynote a owl:ObjectProperty;
               rdfs:domain conference:OrganisedEvent;
               rdfs:range seo:Keynote;
               owl:inverseOf seo:keynoteIn.
seo:hasProgramCommitteeMember a owl:ObjectProperty;
                              rdfs:domain conference:AcademicEvent;
                              rdfs:range conference:Person.
seo:hasProgramSchedual a owl:ObjectProperty;
                       rdfs:domain conference:OrganisedEvent.
seo:hasPublisher a owl:ObjectProperty;
                 rdfs:comment "This propoerty shows the publisher of a proceedings.";
                 rdfs:domain [owl:unionOf (conference:AcademicEvent
                                           conference:Proceedings) ; 
                              a owl:Class];
                 rdfs:range seo:Publisher;
                 owl:inverseOf seo:isPublisherOf.
seo:hasRegistration a owl:ObjectProperty;
                    rdfs:domain conference:OrganisedEvent;
                    rdfs:range seo:Registration.
seo:hasRegistrationType a owl:ObjectProperty;
                        rdfs:domain seo:Author;
                        rdfs:range [owl:unionOf (seo:EarlyBirdRegistration
                                                 seo:LateRegistration) ; 
                                    a owl:Class].
seo:hasSocialEvent a owl:ObjectProperty;
                   rdfs:domain conference:AcademicEvent;
                   rdfs:range conference:SocialEvent.
seo:hasSponsor a owl:ObjectProperty;
               rdfs:comment "This propoerty shows the sponsor of an event.";
               rdfs:domain conference:OrganisedEvent;
               rdfs:range seo:Sponsor;
               owl:inverseOf seo:isSponsorOf.
seo:hasSubmissionGuidelines a owl:ObjectProperty;
                            rdfs:domain conference:AcademicEvent;
                            rdfs:range seo:SubmissionGuidelines.
seo:hasTrack a owl:ObjectProperty;
             rdfs:comment "This propoerty shows the available tracks of an event.";
             rdfs:domain conference:AcademicEvent;
             rdfs:range conference:Track;
             owl:inverseOf seo:isTrackOf.
seo:hasTwitter a owl:DatatypeProperty;
               rdfs:comment "The twitter account of the event.";
               rdfs:domain conference:EventSeries;
               rdfs:range xsd:anyURI.
seo:heldInCity a owl:ObjectProperty;
               rdfs:domain conference:OrganisedEvent;
               rdfs:range dbpedia-owl:City;
               rdfs:subPropertyOf conference:hasLocation.
seo:heldInCountry a owl:ObjectProperty;
                  rdfs:domain conference:OrganisedEvent;
                  rdfs:range dbpedia-owl:Country;
                  rdfs:subPropertyOf conference:hasLocation.
seo:isPublisherOf a owl:ObjectProperty;
                  rdfs:domain seo:Publisher;
                  rdfs:range [owl:unionOf (conference:AcademicEvent
                                           conference:Proceedings) ; 
                              a owl:Class].
seo:isSponsorOf a owl:ObjectProperty;
                rdfs:domain seo:Sponsor;
                rdfs:range conference:OrganisedEvent.
seo:isTrackOf a owl:ObjectProperty;
              rdfs:domain conference:Track;
              rdfs:range conference:AcademicEvent.
seo:keynoteIn a owl:ObjectProperty;
              rdfs:domain seo:Keynote;
              rdfs:range conference:OrganisedEvent.
seo:notificationDate a owl:DatatypeProperty;
                     rdfs:comment "The date of the paper acceptance notification.";
                     rdfs:domain conference:AcademicEvent;
                     rdfs:label "Paper Acceptance Notification";
                     rdfs:range xsd:date.
seo:offersAward a owl:ObjectProperty;
                rdfs:domain conference:OrganisedEvent;
                rdfs:range seo:Award.
seo:offersBestPaperAward a owl:ObjectProperty;
                         rdfs:domain conference:AcademicEvent;
                         rdfs:range seo:BestPaperAward;
                         rdfs:subPropertyOf seo:offersAward.
seo:participatesAs a owl:ObjectProperty;
                   rdfs:domain foaf:Person;
                   rdfs:range [owl:unionOf (seo:Author
                                            seo:Chair
                                            seo:Organizer) ; 
                               a owl:Class].
seo:participatesIn a owl:ObjectProperty;
                   rdfs:domain foaf:Agent;
                   rdfs:range conference:OrganisedEvent.
seo:providesTravelInformation a owl:ObjectProperty;
                              rdfs:domain conference:OrganisedEvent;
                              rdfs:range seo:TravelInformation.
seo:registeredAs a owl:ObjectProperty;
                 rdfs:domain seo:Author;
                 rdfs:range seo:AuthorRegistration.
seo:sponsorshipType a owl:ObjectProperty;
                    rdfs:domain seo:Sponsor;
                    rdfs:range seo:Sponsorship.
seo:submissionDeadline a owl:DatatypeProperty;
                       rdfs:comment "The deadline of paper submission.";
                       rdfs:domain conference:AcademicEvent;
                       rdfs:range xsd:date.
seo:submissionWebPage a owl:DatatypeProperty;
                      rdfs:comment "The webpage of the submission to event.";
                      rdfs:domain conference:OrganisedEvent;
                      rdfs:range xsd:anyURI.
seo:submittedPapers a owl:DatatypeProperty;
                    rdfs:comment "The number of submitted papers to the event."@en;
                    rdfs:domain conference:AcademicEvent;
                    rdfs:range xsd:unsignedInt.
seo:takesAward a owl:ObjectProperty;
               rdfs:domain seo:Author;
               rdfs:range seo:Award.
<urn:swrl#a> a swrl:Variable.
<urn:swrl#e> a swrl:Variable.
