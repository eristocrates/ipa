isoprops:hasGroupOfProperties a owl:ObjectProperty;
                              rdfs:comment "List of globally unique identifiers of groups of properties (attribute GA001) to which the property is attached",
                                           "Liste von global eindeutigen Bezeichnern von Merkmalsgruppen (Attribut GA001), denen das Merkmal angehoert"@de-de;
