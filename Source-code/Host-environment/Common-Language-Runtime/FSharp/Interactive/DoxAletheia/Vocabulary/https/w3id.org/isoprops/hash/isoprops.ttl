                                  rdfs:label "Global eindeutiger Bezeichner (GUID)"@de-de,
                                             "Globally Unique Identifier (GUID)";
                                  rdfs:range xsd:string;
                                  rdfs:subPropertyOf owl:topDataProperty;
                                  skos:scopeNote "PA001/GA001";
                                  isoprops:code "PA001/GA001",
                                                "PA001/GA001"@de-de.
