isoprops:hasTextFormat a owl:ObjectProperty;
                       rdfs:comment """Paar fuer den Texttyp (Verschluesselung, Anzahl der Zeichen)
die Verschluesselung wird nach Name der Codierungsnorm von IANA, RFC 2978 festgelegt"""@de-de,
                                    """Pair for text type (encoding, number of characters)
The encoding is set according to Name of encoding standard of IANA, RFC 2978""";
