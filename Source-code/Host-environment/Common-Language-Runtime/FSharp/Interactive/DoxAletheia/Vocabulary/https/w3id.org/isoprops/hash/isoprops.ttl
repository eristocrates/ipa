isoprops:NumberOfCharacters a owl:DatatypeProperty;
                            rdfs:comment "The encoding is set according to Name of encoding standard of IANA, RFC 2978",
                                         "Die Verschluesselung wird nach Name der Codierungsnorm von IANA, RFC 2978 festgelegt"@de-de;
                            rdfs:domain isoprops:TextFormatItem;
                            rdfs:label "Number of Characters",
                                       "Anzahl der Zeichen"@de-de;
                            rdfs:range xsd:integer;
