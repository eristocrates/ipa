                                                      owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                      a owl:Restriction],
                                                     owl:Thing;
                                     owl:equivalentClass dt:ExternalDictionaryReference.
isoprops:GloballyUniqueIdentifier a owl:DatatypeProperty;
                                  rdfs:comment "Unique identifier generated using the algorithm denoted in RFC 4122",
                                               "Eindeutiger Bezeichner, der mit dem in RFC 4122 beschriebenen Algorithmus erzeugt wird"@de-de;
