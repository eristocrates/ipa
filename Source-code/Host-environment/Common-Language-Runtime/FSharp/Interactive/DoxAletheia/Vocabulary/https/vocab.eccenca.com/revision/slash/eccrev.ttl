@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix aksw: <http://aksw.org/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ecc: <https://ns.eccenca.com/>.
@prefix eccrev: <https://vocab.eccenca.com/revision/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

aksw:MarvinFrommhold a foaf:Person,
                       dcterms:Agent;
                     foaf:name "Marvin Frommhold".
<http://creativecommons.org/licenses/by/3.0/> rdfs:label "Creative Commons Attribution 3.0 Unported".
ccrel:license a owl:AnnotationProperty;
              rdfs:isDefinedBy <http://creativecommons.org/ns>.
dcterms:creator a owl:AnnotationProperty;
                rdfs:isDefinedBy dcterms:.
dcterms:description a owl:AnnotationProperty;
                    rdfs:isDefinedBy dcterms:.
dcterms:issued a owl:AnnotationProperty;
               rdfs:isDefinedBy dcterms:.
dcterms:modified a owl:AnnotationProperty;
                 rdfs:isDefinedBy dcterms:.
dcterms:publisher a owl:AnnotationProperty;
                  rdfs:isDefinedBy dcterms:.
dcterms:rights a owl:AnnotationProperty;
               rdfs:isDefinedBy dcterms:.
dcterms:title a owl:AnnotationProperty;
              rdfs:isDefinedBy dcterms:.
vann:preferredNamespacePrefix a owl:AnnotationProperty;
                              rdfs:isDefinedBy vann:.
vann:preferredNamespaceUri a owl:AnnotationProperty;
                           rdfs:isDefinedBy vann:.
<http://sebastian.tramp.name/> a foaf:Person,
                                 dcterms:Agent;
                               foaf:name "Sebastian Tramp".
nsprov:Activity a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:Entity a owl:Class;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:InstantaneousEvent a owl:Class;
                          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:atTime a owl:DatatypeProperty;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:range xsd:date.
nsprov:generated a owl:ObjectProperty;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:wasAssociatedWith a owl:ObjectProperty;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:wasDerivedFrom a owl:ObjectProperty;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:wasRevisionOf a owl:ObjectProperty;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
ecc:eccenca-GmbH a dcterms:Agent,
                   foaf:Organization;
                 foaf:name "eccenca GmbH".
ecc:rnavarropiris a foaf:Person,
                    dcterms:Agent;
                  foaf:name "Rubén Navarro Piris".
eccrev: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
        dcterms:contributor aksw:MarvinFrommhold;
        dcterms:creator <http://sebastian.tramp.name/>,
                        ecc:rnavarropiris;
        dcterms:issued "2014-12-15"^^xsd:date;
        dcterms:modified "2016-03-11"^^xsd:date;
        dcterms:publisher ecc:eccenca-GmbH;
        dcterms:rights "Copyright © 2014 - 2016 eccenca GmbH";
        vann:preferredNamespacePrefix "eccrev";
        vann:preferredNamespaceUri "https://vocab.eccenca.com/revision/";
        vann:usageNote "The expressiveness of the vocabulary is compliant with the OWL 2 DL profile, but in order to achieve this, used ontologies (dct, prov, vann) are not directly imported (since that leads to non-conformance with the OWL 2 DL profile). Instead, their classes and properties are declared (with the corresponding necessary OWL property type) with a reference to the original ontology that defined them."@en;
        void:vocabulary dcterms:,
                        vann:,
                        foaf:,
                        nsprov:;
        doap:bug-database <https://github.com/eccenca/eccrev-vocab/issues>;
        doap:download-page <https://github.com/eccenca/eccrev-vocab/releases>;
        doap:homepage <https://github.com/eccenca/eccrev-vocab>;
        doap:repository <https://github.com/eccenca/eccrev-vocab.git>;
        doap:wiki <https://github.com/eccenca/eccrev-vocab/wiki>;
        a owl:Ontology,
          voaf:Vocabulary;
        rdfs:comment "A vocabulary & data model for describing RDF changes and revisions. It defines the Commit & Revision classes together with their expected properties."@en;
        rdfs:isDefinedBy eccrev:;
        rdfs:label "eccrev: RDF changes and revisions vocabulary"@en;
        owl:versionInfo "v1.0.2".
eccrev:Branch dcterms:issued "2014-12-22"^^xsd:date;
              dcterms:modified "2014-12-30"^^xsd:date;
              a owl:Class;
              rdfs:comment "Represents a branch"@en;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "Branch"@en;
              rdfs:subClassOf [owl:onProperty eccrev:referencesCommit ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction];
              owl:disjointWith eccrev:Revision,
                               eccrev:Tag,
                               eccrev:Commit.
eccrev:Commit dcterms:issued "2014-12-15"^^xsd:date;
              dcterms:modified "2014-12-30"^^xsd:date;
              a owl:Class;
              rdfs:comment "Represents a modification of the datastore. A commit consists typically on a collection of :Revision (connected with a :hasRevision relationship"@en;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "Commit"@en;
              rdfs:subClassOf nsprov:Activity,
                              nsprov:InstantaneousEvent,
                              [owl:onProperty eccrev:commitAuthor ; 
                               owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty eccrev:commitMessage ; 
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty eccrev:previousCommit ; 
                               owl:maxCardinality "2"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              [owl:onProperty eccrev:hasRevision ; 
                               owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction];
              owl:disjointWith eccrev:Revision,
                               eccrev:Tag,
                               eccrev:Branch.
eccrev:Revision dcterms:issued "2014-12-15"^^xsd:date;
                dcterms:modified "2014-12-30"^^xsd:date;
                a owl:Class;
                rdfs:comment "Represents a modification on a specific named graph"@en;
                rdfs:isDefinedBy eccrev:;
                rdfs:label "Revision"@en;
                rdfs:subClassOf nsprov:Entity,
                                [owl:onProperty eccrev:deltaDelete ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty eccrev:hasRevisionGraph ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty nsprov:atTime ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                [owl:onProperty eccrev:deltaInsert ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction];
                owl:disjointWith eccrev:Branch,
                                 eccrev:Tag,
                                 eccrev:Commit.
eccrev:Tag dcterms:issued "2014-12-22"^^xsd:date;
           dcterms:modified "2014-12-30"^^xsd:date;
           a owl:Class;
           rdfs:comment "Represents a tag"@en;
           rdfs:isDefinedBy eccrev:;
           rdfs:label "Tag"@en;
           rdfs:subClassOf [owl:onProperty eccrev:referencesCommit ; 
                            owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction];
           owl:disjointWith eccrev:Revision,
                            eccrev:Branch,
                            eccrev:Commit.
eccrev:commitAuthor dcterms:issued "2014-12-29"^^xsd:date;
                    dcterms:modified "2014-12-30"^^xsd:date;
                    a owl:ObjectProperty;
                    rdfs:comment "The author of the commit"@en;
                    rdfs:domain eccrev:Commit;
                    rdfs:isDefinedBy eccrev:;
                    rdfs:label "commit author"@en;
                    rdfs:subPropertyOf nsprov:wasAssociatedWith.
eccrev:commitMessage dcterms:issued "2014-12-15"^^xsd:date;
                     dcterms:modified "2014-12-30"^^xsd:date;
                     a owl:DatatypeProperty;
                     rdfs:comment "A message describing the commit"@en;
                     rdfs:domain eccrev:Commit;
                     rdfs:isDefinedBy eccrev:;
                     rdfs:label "commit message"@en;
                     rdfs:range xsd:string.
eccrev:deltaDelete dcterms:issued "2014-12-15"^^xsd:date;
                   dcterms:modified "2014-12-16"^^xsd:date;
                   a owl:ObjectProperty;
                   rdfs:comment "The IRI of the named graph containing the deleted triples of a revision (compared to its previous revision)"@en;
                   rdfs:domain eccrev:Revision;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "delete delta"@en.
eccrev:deltaInsert dcterms:issued "2014-12-15"^^xsd:date;
                   dcterms:modified "2014-12-16"^^xsd:date;
                   a owl:ObjectProperty;
                   rdfs:comment "The IRI of the named graph containing the inserted triples of a revision (compared to its previous revision)"@en;
                   rdfs:domain eccrev:Revision;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "insert delta"@en.
eccrev:hasRevision dcterms:issued "2014-12-16"^^xsd:date;
                   dcterms:modified "2014-12-16"^^xsd:date;
                   a owl:ObjectProperty,
                     owl:InverseFunctionalProperty;
                   rdfs:comment "A named graph revision belonging to the commit"@en;
                   rdfs:domain eccrev:Commit;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "has revision"@en;
                   rdfs:range eccrev:Revision;
                   rdfs:subPropertyOf nsprov:generated.
eccrev:hasRevisionGraph dcterms:issued "2014-12-29"^^xsd:date;
                        dcterms:modified "2014-12-29"^^xsd:date;
                        a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:comment "The named graph the revision refers to"@en;
                        rdfs:domain eccrev:Revision;
                        rdfs:isDefinedBy eccrev:;
                        rdfs:label "has revision graph"@en;
                        rdfs:subPropertyOf nsprov:wasRevisionOf.
eccrev:previousCommit dcterms:issued "2014-12-15"^^xsd:date;
                      dcterms:modified "2014-12-16"^^xsd:date;
                      a owl:ObjectProperty;
                      rdfs:comment "Connects to the previous commit (or pair of commits in the case of a merge commit)"@en;
                      rdfs:domain eccrev:Commit;
                      rdfs:isDefinedBy eccrev:;
                      rdfs:label "previous commit"@en;
                      rdfs:range eccrev:Commit;
                      rdfs:subPropertyOf nsprov:wasDerivedFrom.
eccrev:referencesCommit dcterms:issued "2014-12-22"^^xsd:date;
                        dcterms:modified "2014-12-22"^^xsd:date;
                        a owl:ObjectProperty;
                        rdfs:comment "The commit to which this branch or tag references"@en;
                        rdfs:domain [owl:unionOf (eccrev:Branch
                                                  eccrev:Tag)];
                        rdfs:isDefinedBy eccrev:;
                        rdfs:label "references commit"@en;
                        rdfs:range eccrev:Commit.
eccrev:sha256 dcterms:issued "2014-12-19"^^xsd:date;
              dcterms:modified "2014-12-19"^^xsd:date;
              a owl:DatatypeProperty;
              rdfs:comment """A sha256 digest of a commit based on the RDF NC14 algorithm described in \"Signing RDF Graphs\" by Jeremy J. Carroll (DOI: 10.1007/F978-3-540-39718-2_24)."""@en;
              rdfs:domain eccrev:Commit;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "sha256 digest"@en;
              rdfs:range xsd:base64Binary;
              rdfs:seeAlso <http://link.springer.com/chapter/10.1007%2F978-3-540-39718-2_24>.
