eccrev: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
        <http://purl.org/dc/terms/contributor> <http://aksw.org/MarvinFrommhold>;
        <http://purl.org/dc/terms/creator> <http://sebastian.tramp.name/>,
                                           <https://ns.eccenca.com/rnavarropiris>;
        <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
        <http://purl.org/dc/terms/modified> "2016-03-11"^^xsd:date;
        <http://purl.org/dc/terms/publisher> <https://ns.eccenca.com/eccenca-GmbH>;
        <http://purl.org/dc/terms/rights> "Copyright © 2014 - 2016 eccenca GmbH";
        <http://purl.org/vocab/vann/preferredNamespacePrefix> "eccrev";
        <http://purl.org/vocab/vann/preferredNamespaceUri> "https://vocab.eccenca.com/revision/";
        <http://purl.org/vocab/vann/usageNote> "The expressiveness of the vocabulary is compliant with the OWL 2 DL profile, but in order to achieve this, used ontologies (dct, prov, vann) are not directly imported (since that leads to non-conformance with the OWL 2 DL profile). Instead, their classes and properties are declared (with the corresponding necessary OWL property type) with a reference to the original ontology that defined them."@en;
        <http://rdfs.org/ns/void#vocabulary> <http://purl.org/dc/terms/>,
                                             <http://purl.org/vocab/vann/>,
                                             <http://xmlns.com/foaf/0.1/>,
                                             <http://www.w3.org/ns/prov#>;
        <http://usefulinc.com/ns/doap#bug-database> <https://github.com/eccenca/eccrev-vocab/issues>;
        <http://usefulinc.com/ns/doap#download-page> <https://github.com/eccenca/eccrev-vocab/releases>;
        <http://usefulinc.com/ns/doap#homepage> <https://github.com/eccenca/eccrev-vocab>;
        <http://usefulinc.com/ns/doap#repository> <https://github.com/eccenca/eccrev-vocab.git>;
        <http://usefulinc.com/ns/doap#wiki> <https://github.com/eccenca/eccrev-vocab/wiki>;
        a <http://www.w3.org/2002/07/owl#Ontology>,
          <http://purl.org/vocommons/voaf#Vocabulary>;
        rdfs:comment "A vocabulary & data model for describing RDF changes and revisions. It defines the Commit & Revision classes together with their expected properties."@en;
        rdfs:isDefinedBy eccrev:;
        rdfs:label "eccrev: RDF changes and revisions vocabulary"@en;
        <http://www.w3.org/2002/07/owl#versionInfo> "v1.0.2".
eccrev:Branch <http://purl.org/dc/terms/issued> "2014-12-22"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Represents a branch"@en;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "Branch"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> eccrev:referencesCommit ; 
                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#disjointWith> eccrev:Revision,
                                                           eccrev:Tag,
                                                           eccrev:Commit.
eccrev:Commit <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Represents a modification of the datastore. A commit consists typically on a collection of :Revision (connected with a :hasRevision relationship"@en;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "Commit"@en;
              rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>,
                              <http://www.w3.org/ns/prov#InstantaneousEvent>,
                              [<http://www.w3.org/2002/07/owl#onProperty> eccrev:commitAuthor ; 
                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> eccrev:commitMessage ; 
                               <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> eccrev:previousCommit ; 
                               <http://www.w3.org/2002/07/owl#maxCardinality> "2"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> eccrev:hasRevision ; 
                               <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#disjointWith> eccrev:Revision,
                                                           eccrev:Tag,
                                                           eccrev:Branch.
eccrev:Revision <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Represents a modification on a specific named graph"@en;
                rdfs:isDefinedBy eccrev:;
                rdfs:label "Revision"@en;
                rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>,
                                [<http://www.w3.org/2002/07/owl#onProperty> eccrev:deltaDelete ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> eccrev:hasRevisionGraph ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#atTime> ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> eccrev:deltaInsert ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2002/07/owl#disjointWith> eccrev:Branch,
                                                             eccrev:Tag,
                                                             eccrev:Commit.
eccrev:Tag <http://purl.org/dc/terms/issued> "2014-12-22"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Represents a tag"@en;
           rdfs:isDefinedBy eccrev:;
           rdfs:label "Tag"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> eccrev:referencesCommit ; 
                            <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2002/07/owl#disjointWith> eccrev:Revision,
                                                        eccrev:Branch,
                                                        eccrev:Commit.
eccrev:commitAuthor <http://purl.org/dc/terms/issued> "2014-12-29"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "The author of the commit"@en;
                    rdfs:domain eccrev:Commit;
                    rdfs:isDefinedBy eccrev:;
                    rdfs:label "commit author"@en;
                    rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasAssociatedWith>.
eccrev:commitMessage <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-12-30"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "A message describing the commit"@en;
                     rdfs:domain eccrev:Commit;
                     rdfs:isDefinedBy eccrev:;
                     rdfs:label "commit message"@en;
                     rdfs:range xsd:string.
eccrev:deltaDelete <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-12-16"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The IRI of the named graph containing the deleted triples of a revision (compared to its previous revision)"@en;
                   rdfs:domain eccrev:Revision;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "delete delta"@en.
eccrev:deltaInsert <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-12-16"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The IRI of the named graph containing the inserted triples of a revision (compared to its previous revision)"@en;
                   rdfs:domain eccrev:Revision;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "insert delta"@en.
eccrev:hasRevision <http://purl.org/dc/terms/issued> "2014-12-16"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2014-12-16"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                   rdfs:comment "A named graph revision belonging to the commit"@en;
                   rdfs:domain eccrev:Commit;
                   rdfs:isDefinedBy eccrev:;
                   rdfs:label "has revision"@en;
                   rdfs:range eccrev:Revision;
                   rdfs:subPropertyOf <http://www.w3.org/ns/prov#generated>.
eccrev:hasRevisionGraph <http://purl.org/dc/terms/issued> "2014-12-29"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2014-12-29"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:comment "The named graph the revision refers to"@en;
                        rdfs:domain eccrev:Revision;
                        rdfs:isDefinedBy eccrev:;
                        rdfs:label "has revision graph"@en;
                        rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasRevisionOf>.
eccrev:previousCommit <http://purl.org/dc/terms/issued> "2014-12-15"^^xsd:date;
                      <http://purl.org/dc/terms/modified> "2014-12-16"^^xsd:date;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Connects to the previous commit (or pair of commits in the case of a merge commit)"@en;
                      rdfs:domain eccrev:Commit;
                      rdfs:isDefinedBy eccrev:;
                      rdfs:label "previous commit"@en;
                      rdfs:range eccrev:Commit;
                      rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasDerivedFrom>.
eccrev:referencesCommit <http://purl.org/dc/terms/issued> "2014-12-22"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2014-12-22"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "The commit to which this branch or tag references"@en;
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (eccrev:Branch
                                                                              eccrev:Tag)];
                        rdfs:isDefinedBy eccrev:;
                        rdfs:label "references commit"@en;
                        rdfs:range eccrev:Commit.
eccrev:sha256 <http://purl.org/dc/terms/issued> "2014-12-19"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2014-12-19"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment """A sha256 digest of a commit based on the RDF NC14 algorithm described in \"Signing RDF Graphs\" by Jeremy J. Carroll (DOI: 10.1007/F978-3-540-39718-2_24)."""@en;
              rdfs:domain eccrev:Commit;
              rdfs:isDefinedBy eccrev:;
              rdfs:label "sha256 digest"@en;
              rdfs:range xsd:base64Binary;
              rdfs:seeAlso <http://link.springer.com/chapter/10.1007%2F978-3-540-39718-2_24>.
