                                            rdfs:seeAlso <https://w3id.org/nen2660/term#transferType>;
                                            <http://www.w3.org/2004/02/skos/core#definition> "The possession of a transfer type by an interaction"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "transfer type"@en.
<https://w3id.org/nen2660/def#transforms> a rdf:Property,
                                            <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:domain <https://w3id.org/nen2660/def#Activity>;
                                          rdfs:range <https://w3id.org/nen2660/def#Object>;
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#transforms>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The object transformed by an activity"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "transforms"@en.
<https://w3id.org/nen2660/def#triggers> a rdf:Property,
                                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:domain <https://w3id.org/nen2660/def#Entity>;
                                        rdfs:range <https://w3id.org/nen2660/def#Event>;
                                        rdfs:seeAlso <https://w3id.org/nen2660/term#triggers>;
                                        <http://www.w3.org/2004/02/skos/core#definition> "The event triggert by an entity"@en;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "triggers"@en.
<https://w3id.org/nen2660/owl/def> a <http://www.w3.org/2002/07/owl#Ontology>;
                                   <http://www.w3.org/2002/07/owl#imports> <http://qudt.org/2.1/schema/qudt>,
                                                                           <http://qudt.org/2.1/vocab/quantitykind>,
