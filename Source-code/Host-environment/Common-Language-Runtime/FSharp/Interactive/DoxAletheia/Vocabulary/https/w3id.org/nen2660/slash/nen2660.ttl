@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix nen2660: <https://w3id.org/nen2660/>.

<http://qudt.org/schema/qudt/QuantityKind> a <https://w3id.org/nen2660/def#EnumerationType>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#QuantityKind>;
                                           <http://www.w3.org/2004/02/skos/core#definition> "Any observable property that can be measured and quantified numerically"@en;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Quantity kind"@en.
<http://qudt.org/schema/qudt/Unit> a <https://w3id.org/nen2660/def#EnumerationType>;
                                   rdfs:seeAlso <https://w3id.org/nen2660/term#Unit>;
                                   <http://www.w3.org/2004/02/skos/core#definition> "A particular quantity value that has been chosen as a scale for measuring other quantities the same kind"@en;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Unit"@en.
<http://www.w3.org/2006/time#TemporalEntity> rdfs:seeAlso <https://w3id.org/nen2660/term#TemporalEntity>;
                                             rdfs:subClassOf <https://w3id.org/nen2660/def#Representation>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "A temporal interval or instant"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Temporal entity"@en.
<https://w3id.org/nen2660/def#AbstractConcept> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#AbstractConcept>;
                                               rdfs:subClassOf <https://w3id.org/nen2660/def#TopConcept>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Concept that forms a manifestation and demarcation in an abstract space. An abstract concept has no life cycle"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Abstract concept"@en.
<https://w3id.org/nen2660/def#Activity> a rdfs:Class,
                                          <http://www.w3.org/2002/07/owl#Class>,
                                          <http://www.w3.org/ns/shacl#NodeShape>;
                                        rdfs:seeAlso <https://w3id.org/nen2660/term#Activity>;
                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                         <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#Activity> ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                                        <https://w3id.org/nen2660/def#Entity>;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Entity that takes place or can take place in a concrete space-time. An activity transforms objects, and is executed by an object"@en;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Activity"@en;
                                        <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasBoundary> ; 
                                                                               <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>],
                                                                              [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasInterior> ; 
                                                                               <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>],
                                                                              [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#transforms> ; 
                                                                               <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Object>],
                                                                              [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPeriod> ; 
                                                                               <http://www.w3.org/ns/shacl#class> <http://www.w3.org/2006/time#TemporalEntity>],
                                                                              [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                               <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Activity>].
<https://w3id.org/nen2660/def#AggregationStateType> a rdfs:Class,
                                                      <http://www.w3.org/2002/07/owl#Class>,
                                                      <http://www.w3.org/ns/shacl#NodeShape>,
                                                      <https://w3id.org/nen2660/def#EnumerationType>;
                                                    rdfs:seeAlso <https://w3id.org/nen2660/term#AggregationStateType>;
                                                    <http://www.w3.org/2002/07/owl#oneOf> (<https://w3id.org/nen2660/def#Solid>
                                                                                           <https://w3id.org/nen2660/def#Liquid>
                                                                                           <https://w3id.org/nen2660/def#Gas>
                                                                                           <https://w3id.org/nen2660/def#Plasma>);
                                                    <http://www.w3.org/2004/02/skos/core#definition> "One of the four fundamental states of matter being a solid, liquid, gas or plasma"@en;
                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Aggregation state type"@en;
                                                    <http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#Solid>
                                                                                     <https://w3id.org/nen2660/def#Liquid>
                                                                                     <https://w3id.org/nen2660/def#Gas>
                                                                                     <https://w3id.org/nen2660/def#Plasma>).
<https://w3id.org/nen2660/def#AllDisjointClassesShape> a <http://www.w3.org/ns/shacl#NodeShape>;
                                                       <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#qualifiedValueShape> [<http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#RealObject>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#SpatialRegion>)] ; 
                                                                                              <http://www.w3.org/ns/shacl#qualifiedMaxCount> 1  ; 
                                                                                              <http://www.w3.org/ns/shacl#path> (rdf:type
                                                                                                                                 [<http://www.w3.org/ns/shacl#zeroOrMorePath> rdfs:subClassOf])],
                                                                                             [<http://www.w3.org/ns/shacl#qualifiedValueShape> [<http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#FunctionalEntity>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#TechnicalEntity>)] ; 
                                                                                              <http://www.w3.org/ns/shacl#qualifiedMaxCount> 1  ; 
                                                                                              <http://www.w3.org/ns/shacl#path> (rdf:type
                                                                                                                                 [<http://www.w3.org/ns/shacl#zeroOrMorePath> rdfs:subClassOf])],
                                                                                             [<http://www.w3.org/ns/shacl#qualifiedValueShape> [<http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#PlannedEntity>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#RealizedEntity>)] ; 
                                                                                              <http://www.w3.org/ns/shacl#qualifiedMaxCount> 1  ; 
                                                                                              <http://www.w3.org/ns/shacl#path> (rdf:type
                                                                                                                                 [<http://www.w3.org/ns/shacl#zeroOrMorePath> rdfs:subClassOf])],
                                                                                             [<http://www.w3.org/ns/shacl#qualifiedValueShape> [<http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#PhysicalObject>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#InformationObject>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#State>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#Event>
                                                                                                                                                                                 <https://w3id.org/nen2660/def#Activity>)] ; 
                                                                                              <http://www.w3.org/ns/shacl#qualifiedMaxCount> 1  ; 
                                                                                              <http://www.w3.org/ns/shacl#path> (rdf:type
                                                                                                                                 [<http://www.w3.org/ns/shacl#zeroOrMorePath> rdfs:subClassOf])];
                                                       <http://www.w3.org/ns/shacl#targetSubjectsOf> rdf:type.
<https://w3id.org/nen2660/def#AllDisjointClasses_1> a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                                    <http://www.w3.org/2002/07/owl#members> (<https://w3id.org/nen2660/def#PhysicalObject>
                                                                                             <https://w3id.org/nen2660/def#InformationObject>
                                                                                             <https://w3id.org/nen2660/def#Activity>
                                                                                             <https://w3id.org/nen2660/def#Event>
                                                                                             <https://w3id.org/nen2660/def#State>).
<https://w3id.org/nen2660/def#AllDisjointClasses_2> a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                                    <http://www.w3.org/2002/07/owl#members> (<https://w3id.org/nen2660/def#RealObject>
                                                                                             <https://w3id.org/nen2660/def#SpatialRegion>).
<https://w3id.org/nen2660/def#AllDisjointClasses_3> a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                                    <http://www.w3.org/2002/07/owl#members> (<https://w3id.org/nen2660/def#FunctionalEntity>
                                                                                             <https://w3id.org/nen2660/def#TechnicalEntity>).
<https://w3id.org/nen2660/def#AllDisjointClasses_4> a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                                    <http://www.w3.org/2002/07/owl#members> (<https://w3id.org/nen2660/def#PlannedEntity>
                                                                                             <https://w3id.org/nen2660/def#RealizedEntity>).
<https://w3id.org/nen2660/def#AmountOfBulkMatter> a rdfs:Class,
                                                    <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:seeAlso <https://w3id.org/nen2660/term#AmountOfBulkMatter>;
                                                  rdfs:subClassOf <https://w3id.org/nen2660/def#RealObject>;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A real object that consists of a continuous amount of non-rigid matter, held together primarily by external forces (gravity or confinement)"@en;
                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Amount of bulk matter"@en.
<https://w3id.org/nen2660/def#ChemicalCompound> a rdfs:Class,
                                                  <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:seeAlso <https://w3id.org/nen2660/term#ChemicalBonding>;
                                                rdfs:subClassOf <https://w3id.org/nen2660/def#PureSubstance>;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Pure substance consisting of two or more chemical elements that have a chemical bond with each other. In a chemical compound, the elements occur in a fixed ratio. A compound can be broken down into simpler substances by means of chemical reactions"@en;
                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Chemical compound"@en.
<https://w3id.org/nen2660/def#ChemicalElement> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#ChemicalElement>;
                                               rdfs:subClassOf <https://w3id.org/nen2660/def#PureSubstance>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Pure substance that is made up of atoms with the same atomic number. A chemical element cannot be decomposed through chemical reactions"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Chemical element"@en.
<https://w3id.org/nen2660/def#ConceptType> a rdfs:Class,
                                             <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#ConceptType>;
                                           rdfs:subClassOf <https://w3id.org/nen2660/def#Type>;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A meta-concept having concepts as instances that can have attributes or relations"@en;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Concept type"@en.
<https://w3id.org/nen2660/def#ConcreteConcept> a rdfs:Class,
                                                 <http://www.w3.org/ns/shacl#NodeShape>,
                                                 <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#ConcreteConcept>;
                                               rdfs:subClassOf <https://w3id.org/nen2660/def#TopConcept>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Concept that forms a manifestation and a demarcation in a concrete space-time. A concrete concept has a life cycle"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Concrete concept"@en;
                                               <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasBoundary> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>],
                                                                                     [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#ConcreteConcept>],
                                                                                     [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasTemporalEntity> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <http://www.w3.org/2006/time#TemporalEntity>],
                                                                                     [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPartsGroup> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> rdfs:Container],
                                                                                     [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasInterior> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>].
<https://w3id.org/nen2660/def#Connection> a rdfs:Class,
                                            <http://www.w3.org/2002/07/owl#Class>,
                                            <http://www.w3.org/ns/shacl#NodeShape>;
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#Connection>;
                                          rdfs:subClassOf <https://w3id.org/nen2660/def#PhysicalObject>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "A physical object (real object or spatial area) that connects two other physical objects and over which interaction takes place, namely the transfer of matter, energy, information or forces"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Connection"@en;
                                          <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#connectsObject> ; 
                                                                                 <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#PhysicalObject>],
                                                                                [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#connectsPort> ; 
                                                                                 <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Port>].
<https://w3id.org/nen2660/def#DiscreteObject> a rdfs:Class,
                                                <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:seeAlso <https://w3id.org/nen2660/term#DiscreteObject>;
                                              rdfs:subClassOf <https://w3id.org/nen2660/def#RealObject>;
                                              <http://www.w3.org/2004/02/skos/core#definition> "A real object consisting of a contiguous amount of form-retaining matter, held together primarily by internal forces (gravity or electromagnetic force)"@en;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Discrete object"@en.
<https://w3id.org/nen2660/def#EnergyFlow> a <https://w3id.org/nen2660/def#TransferType>;
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#EnergyFlow>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The movement of an amount of energy (as capacity to do work)"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Energy flow"@en.
<https://w3id.org/nen2660/def#Entity> a rdfs:Class,
                                        <http://www.w3.org/2002/07/owl#Class>,
                                        <http://www.w3.org/ns/shacl#NodeShape>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#Entity>;
                                      rdfs:subClassOf <https://w3id.org/nen2660/def#ConcreteConcept>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Concept that forms a manifestation and a demarcation in a concrete space-time, and which has a certain state at any moment in time. An entity has a unique identity that remains constant throughout its life cycle. The life cycle of an entity is made up of the sequence of states of that entity, which follow each other in time. An entity is an object or an activity. An object exists, an activity takes place"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Entity"@en;
                                      <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasState> ; 
                                                                             <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#State>],
                                                                            [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#triggers> ; 
                                                                             <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Event>].
<https://w3id.org/nen2660/def#EnumerationType> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#EnumerationType>;
                                               rdfs:subClassOf rdfs:Container,
                                                               <https://w3id.org/nen2660/def#Type>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A meta-concept having concepts as instances having no further attributes or relations (annotations only)"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Enumeration type"@en.
<https://w3id.org/nen2660/def#Event> a rdfs:Class,
                                       <http://www.w3.org/2002/07/owl#Class>,
                                       <http://www.w3.org/ns/shacl#NodeShape>;
                                     rdfs:seeAlso <https://w3id.org/nen2660/term#Event>;
                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#Event> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     <https://w3id.org/nen2660/def#ConcreteConcept>;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Transition between two successive states of an entity (object or activity). An event is triggered in a state"@en;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Event"@en;
                                     <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#ends> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#State>],
                                                                           [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Event>],
                                                                           [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#begins> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#State>].
<https://w3id.org/nen2660/def#Force> a <https://w3id.org/nen2660/def#TransferType>;
                                     rdfs:seeAlso <https://w3id.org/nen2660/term#Force>;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Physical quantity which, when exerted on a body, causes tension or pressure to arise therein, or which causes the body to change motion, accelerate"@en;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Force"@en.
<https://w3id.org/nen2660/def#FunctionalEntity> a rdfs:Class,
                                                  <http://www.w3.org/2002/07/owl#Class>,
                                                  <http://www.w3.org/ns/shacl#NodeShape>;
                                                rdfs:seeAlso <https://w3id.org/nen2660/term#FunctionalEntity>;
                                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#Entity> ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                <https://w3id.org/nen2660/def#Entity>;
                                                <http://www.w3.org/2004/02/skos/core#definition> "An entity involving the external behavior where the output contributes to stakeholder objectives implemented/played by one or more technical entities"@en;
                                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Functional entity"@en;
                                                <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasSolution> ; 
                                                                                       <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#TechnicalEntity>],
                                                                                      [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasFunctionalPart> ; 
                                                                                       <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#FunctionalEntity>],
                                                                                      [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                       <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Entity>].
<https://w3id.org/nen2660/def#Gas> a <https://w3id.org/nen2660/def#AggregationStateType>;
                                   rdfs:seeAlso <https://w3id.org/nen2660/term#Gas>;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Matter in an intermediate state between liquid and plasma that can be contained only if it is fully surrounded by a solid (or in a bubble of liquid) (or held together by gravitational pull); it can condense into a liquid, or can (rarely) become a solid directly by deposition"@en;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Gas"@en.
<https://w3id.org/nen2660/def#GeometricEntity> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#GeometricEntity>;
                                               rdfs:subClassOf <https://w3id.org/nen2660/def#Representation>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Named concept, which forms an actual or virtual demarcation in a concrete (physical, three-dimensional) space, which we experience in reality"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Geometric entity"@en.
<https://w3id.org/nen2660/def#HeterogeneousMixture> a rdfs:Class,
                                                      <http://www.w3.org/2002/07/owl#Class>;
                                                    rdfs:seeAlso <https://w3id.org/nen2660/term#HeterogeneousMixture>;
                                                    rdfs:subClassOf <https://w3id.org/nen2660/def#Mixture>;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "A mixture that is separated into different regions or phases that have different compositions or properties"@en;
                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Heterogeneous mixture"@en.
<https://w3id.org/nen2660/def#HomogeneousMixture> a rdfs:Class,
                                                    <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:seeAlso <https://w3id.org/nen2660/term#HomogeneousMixture>;
                                                  rdfs:subClassOf <https://w3id.org/nen2660/def#Mixture>;
                                                  <http://www.w3.org/2004/02/skos/core#definition> "A mixture that is uniform throughout, and has only one phase"@en;
                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Homogeneous mixture"@en.
<https://w3id.org/nen2660/def#InformationFlow> a <https://w3id.org/nen2660/def#TransferType>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#InformationFlow>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "The movement of information represented in some medium"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Information flow"@en.
<https://w3id.org/nen2660/def#InformationObject> a rdfs:Class,
                                                   <http://www.w3.org/2002/07/owl#Class>;
                                                 rdfs:seeAlso <https://w3id.org/nen2660/term#InformationObject>;
                                                 rdfs:subClassOf <https://w3id.org/nen2660/def#Object>;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Object which describes a thing in reality"@en;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Information object"@en.
<https://w3id.org/nen2660/def#Interaction> a rdfs:Class,
                                             <http://www.w3.org/2002/07/owl#Class>,
                                             <http://www.w3.org/ns/shacl#NodeShape>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#Interaction>;
                                           rdfs:subClassOf <https://w3id.org/nen2660/def#Activity>;
                                           <http://www.w3.org/2004/02/skos/core#definition> "The activity being a combination of sub-activities performed by physical objects between which a transfer of matter, information, energy or force takes place, typically over a connection or interface (directly or through ports)"@en;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Interaction"@en;
                                           <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#overConnection> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Connection>],
                                                                                 [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#transferType> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#TransferType>],
                                                                                 [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#overInterface> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Interface>].
<https://w3id.org/nen2660/def#Interface> a rdfs:Class,
                                           <http://www.w3.org/2002/07/owl#Class>,
                                           <http://www.w3.org/ns/shacl#NodeShape>;
                                         rdfs:seeAlso <https://w3id.org/nen2660/term#Interface>;
                                         rdfs:subClassOf <https://w3id.org/nen2660/def#SpatialRegion>;
                                         <http://www.w3.org/2004/02/skos/core#definition> "A spatial object, typically a thin 2D physical space (but also 0D or 1D) that connects two physical objects or ports of physical objects through which a static or dynamic interaction or interaction between those elements can take place"@en;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Interface"@en;
                                         <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#connectsObject> ; 
                                                                                <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#PhysicalObject>],
                                                                               [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#connectsPort> ; 
                                                                                <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Port>].
<https://w3id.org/nen2660/def#Liquid> a <https://w3id.org/nen2660/def#AggregationStateType>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#Liquid>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Liquid"@en.
<https://w3id.org/nen2660/def#MaterialFlow> a <https://w3id.org/nen2660/def#TransferType>;
                                            rdfs:seeAlso <https://w3id.org/nen2660/term#MaterialFlow>;
                                            <http://www.w3.org/2004/02/skos/core#definition> "The movement of an amount of material"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Material flow"@en.
<https://w3id.org/nen2660/def#Matter> a rdfs:Class,
                                        <http://www.w3.org/2002/07/owl#Class>,
                                        <http://www.w3.org/ns/shacl#NodeShape>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#Matter>;
                                      rdfs:subClassOf <https://w3id.org/nen2660/def#PhysicalObject>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A pure chemical substance, chemical compound or mixture from which real objects are made"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Matter"@en;
                                      <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#aggregationStateType> ; 
                                                                             <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#AggregationStateType>],
                                                                            [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#chemicalFormula> ; 
                                                                             <http://www.w3.org/ns/shacl#datatype> xsd:string].
<https://w3id.org/nen2660/def#MatterPortion> a <http://www.w3.org/2002/07/owl#Class>,
                                               <http://www.w3.org/ns/shacl#NodeShape>,
                                               rdfs:Class;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#MatterPortion>;
                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#portion> ; 
                                                              <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             <https://w3id.org/nen2660/def#RelationReference>,
                                                             [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                              <http://www.w3.org/2002/07/owl#onClass> <https://w3id.org/nen2660/def#Matter> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>];
                                             <http://www.w3.org/2004/02/skos/core#definition> "An objectified relation reference for the consists of relation"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Matter portion"@en;
                                             <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#portion> ; 
                                                                                    <http://www.w3.org/ns/shacl#minCount> 1  ; 
                                                                                    <http://www.w3.org/ns/shacl#maxCount> 1  ; 
                                                                                    <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#QuantityValue>].
<https://w3id.org/nen2660/def#Mixture> a rdfs:Class,
                                         <http://www.w3.org/2002/07/owl#Class>,
                                         <http://www.w3.org/ns/shacl#NodeShape>;
                                       rdfs:seeAlso <https://w3id.org/nen2660/term#Mixture>;
                                       rdfs:subClassOf <https://w3id.org/nen2660/def#Matter>;
                                       <http://www.w3.org/2004/02/skos/core#definition> "The combination of two or more different pure substances without the molecules losing their identity"@en;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Mixture"@en;
                                       <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#consistsOf> ; 
                                                                              <http://www.w3.org/ns/shacl#or> ([<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Matter>]
                                                                                                               [<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#MatterPortion>])].
<https://w3id.org/nen2660/def#Object> a rdfs:Class,
                                        <http://www.w3.org/2002/07/owl#Class>,
                                        <http://www.w3.org/ns/shacl#NodeShape>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#Object>;
                                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#Object> ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      <https://w3id.org/nen2660/def#Entity>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Entity that exists or can exist within a concrete space-time. An object executes an activity, and is transformed by an activity"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Object"@en;
                                      <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                             <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Object>].
<https://w3id.org/nen2660/def#Objectification> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>,
                                                 <http://www.w3.org/ns/shacl#NodeShape>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#Objectification>;
                                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                                <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                                               <https://w3id.org/nen2660/def#AbstractConcept>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "An attribute (quality or quantity) or relation represented as an individual defined by a concept"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Objectification"@en;
                                               <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> rdf:value ; 
                                                                                      <http://www.w3.org/ns/shacl#maxCount> 1 ].
<https://w3id.org/nen2660/def#PhysicalObject> a rdfs:Class,
                                                <http://www.w3.org/2002/07/owl#Class>,
                                                <http://www.w3.org/ns/shacl#NodeShape>;
                                              rdfs:seeAlso <https://w3id.org/nen2660/term#PhysicalObject>;
                                              rdfs:subClassOf <https://w3id.org/nen2660/def#Object>;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Object that exists or may exist within physical 4D space-time. A physical object forms a manifestation and a demarcation of matter and/or energy, and is (in)directly perceptible by the senses"@en;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Physical object"@en;
                                              <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#isDescribedBy> ; 
                                                                                     <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#InformationObject>],
                                                                                    [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#isConnectedTo> ; 
                                                                                     <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#PhysicalObject>],
                                                                                    [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#executes> ; 
                                                                                     <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Activity>],
                                                                                    [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#participatesIn> ; 
                                                                                     <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Interaction>].
<https://w3id.org/nen2660/def#PlannedEntity> a rdfs:Class,
                                               <http://www.w3.org/2002/07/owl#Class>,
                                               <http://www.w3.org/ns/shacl#NodeShape>;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#PlannedEntity>;
                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                              <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#PlannedEntity> ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             <https://w3id.org/nen2660/def#Entity>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "An entity that does not yet exist in physical reality, but which exists in mental or conceptual reality"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Planned entity"@en;
                                             <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#isPlanFor> ; 
                                                                                    <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RealizedEntity>],
                                                                                   [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                    <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#PlannedEntity>].
<https://w3id.org/nen2660/def#Plasma> a <https://w3id.org/nen2660/def#AggregationStateType>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#Plasma>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "A phase in which the particles of a gaseous substance are ionised"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Plasma"@en.
<https://w3id.org/nen2660/def#Port> a rdfs:Class,
                                      <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:seeAlso <https://w3id.org/nen2660/term#Port>;
                                    rdfs:subClassOf <https://w3id.org/nen2660/def#PhysicalObject>;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A physical or logical point of interaction as part of a physical object where, through a connection or interface, an interaction can take place"@en;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Port"@en.
<https://w3id.org/nen2660/def#PureSubstance> a rdfs:Class,
                                               <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#PureSubstance>;
                                             rdfs:subClassOf <https://w3id.org/nen2660/def#Matter>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Chemical matter that has an equal chemical composition and recognizable uniform and isotropic properties"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Pure substance"@en.
<https://w3id.org/nen2660/def#QualityValue> a rdfs:Class,
                                              <http://www.w3.org/2002/07/owl#Class>,
                                              <http://www.w3.org/ns/shacl#NodeShape>;
                                            rdfs:seeAlso <https://w3id.org/nen2660/term#QualityValue>;
                                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                             <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (xsd:string
                                                                                                                                                     xsd:boolean
                                                                                                                                                     xsd:anyURI) ; 
                                                                                                            a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                                            <https://w3id.org/nen2660/def#Objectification>;
                                            <http://www.w3.org/2004/02/skos/core#definition> "The objectification of a value of a quality having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Quality value"@en;
                                            <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> rdf:value ; 
                                                                                   <http://www.w3.org/ns/shacl#datatype> xsd:string].
<https://w3id.org/nen2660/def#QuantityValue> a rdfs:Class,
                                               <http://www.w3.org/2002/07/owl#Class>,
                                               <http://www.w3.org/ns/shacl#NodeShape>;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#QuantityValue>;
                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                              <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (xsd:decimal
                                                                                                                                                      xsd:float
                                                                                                                                                      xsd:double
                                                                                                                                                      xsd:integer) ; 
                                                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                             <https://w3id.org/nen2660/def#Objectification>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "The objectification of a value of a quantity (typically involving a quantity kind and a unit) having a complex value like a simple value sec combined with other metadata or just a combination of simple values"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Quantity value"@en;
                                             <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> rdf:value ; 
                                                                                    <http://www.w3.org/ns/shacl#or> ([<http://www.w3.org/ns/shacl#datatype> xsd:decimal]
                                                                                                                     [<http://www.w3.org/ns/shacl#datatype> xsd:float]
                                                                                                                     [<http://www.w3.org/ns/shacl#datatype> xsd:double])].
<https://w3id.org/nen2660/def#RealObject> a rdfs:Class,
                                            <http://www.w3.org/ns/shacl#NodeShape>,
                                            <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#RealObject>;
                                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                           <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#RealObject>
                                                                                                                                                   <https://w3id.org/nen2660/def#Port>) ; 
                                                                                                          a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                                          <https://w3id.org/nen2660/def#PhysicalObject>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "physical object (rigid or non-rigid) that is (or can be) tangible and visible in reality, man-made or naturally occurring"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Real object"@en;
                                          <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                 <http://www.w3.org/ns/shacl#or> ([<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RealObject>]
                                                                                                                  [<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Port>])],
                                                                                [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#consistsOf> ; 
                                                                                 <http://www.w3.org/ns/shacl#or> ([<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Matter>]
                                                                                                                  [<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#MatterPortion>])].
<https://w3id.org/nen2660/def#RealizedEntity> a rdfs:Class,
                                                <http://www.w3.org/2002/07/owl#Class>,
                                                <http://www.w3.org/ns/shacl#NodeShape>;
                                              rdfs:seeAlso <https://w3id.org/nen2660/term#RealizedEntity>;
                                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                               <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#RealizedEntity> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              <https://w3id.org/nen2660/def#Entity>;
                                              <http://www.w3.org/2004/02/skos/core#definition> "An entity that exists or has existed in the physical reality"@en;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Realized entity"@en;
                                              <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                     <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RealizedEntity>].
<https://w3id.org/nen2660/def#RelationReference> a rdfs:Class,
                                                   <http://www.w3.org/2002/07/owl#Class>,
                                                   <http://www.w3.org/ns/shacl#NodeShape>;
                                                 rdfs:seeAlso <https://w3id.org/nen2660/term#RelationReference>;
                                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                 <https://w3id.org/nen2660/def#Objectification>;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "The objectification of a reference for a relation having a complex value like a simple reference sec combined with other metadata or just a combination of simple references (n-ary relation)"@en;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Relation reference"@en;
                                                 <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> rdf:value ; 
                                                                                        <http://www.w3.org/ns/shacl#datatype> xsd:anyURI].
<https://w3id.org/nen2660/def#Representation> a rdfs:Class,
                                                <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:seeAlso <https://w3id.org/nen2660/term#Representation>;
                                              rdfs:subClassOf <https://w3id.org/nen2660/def#InformationObject>;
                                              <http://www.w3.org/2004/02/skos/core#definition> "That which represents something else"@en;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Representation"@en.
<https://w3id.org/nen2660/def#Requirement> a rdfs:Class,
                                             <http://www.w3.org/ns/shacl#NodeShape>,
                                             <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#Requirement>;
                                           rdfs:subClassOf <https://w3id.org/nen2660/def#InformationObject>,
                                                           [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                            <http://www.w3.org/2002/07/owl#onProperty> rdf:value ; 
                                                            <http://www.w3.org/2002/07/owl#onClass> xsd:string ; 
                                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                                           <http://www.w3.org/2004/02/skos/core#definition> "A rule that should hold for something, defined via its attributes or relations";
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Requirement"@en;
                                           <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#requirementSeverityType> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RequirementSeverityType>],
                                                                                 [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#requirementTopicType> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RequirementTopicType>],
                                                                                 [<http://www.w3.org/ns/shacl#path> rdf:value ; 
                                                                                  <http://www.w3.org/ns/shacl#minCount> 1  ; 
                                                                                  <http://www.w3.org/ns/shacl#maxCount> 1  ; 
                                                                                  <http://www.w3.org/ns/shacl#datatype> xsd:string],
                                                                                 [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#requirementSourceType> ; 
                                                                                  <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RequirementSourceType>].
<https://w3id.org/nen2660/def#RequirementSeverityType> a rdfs:Class,
                                                         <http://www.w3.org/2002/07/owl#Class>,
                                                         <https://w3id.org/nen2660/def#EnumerationType>;
                                                       rdfs:seeAlso <https://w3id.org/nen2660/term#RequirementSeverityType>;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "The seriousness of a requirement like demanded or wished"@en;
                                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Requirement severity type"@en.
<https://w3id.org/nen2660/def#RequirementSourceType> a rdfs:Class,
                                                       <http://www.w3.org/2002/07/owl#Class>,
                                                       <https://w3id.org/nen2660/def#EnumerationType>;
                                                     rdfs:seeAlso <https://w3id.org/nen2660/term#RequirementSourceType>;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "The type of source from which a requirement comes like a client, by definition, recommended by the sector or demanded by law/regulation"@en;
                                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Requirement source type"@en.
<https://w3id.org/nen2660/def#RequirementTopicType> a rdfs:Class,
                                                      <http://www.w3.org/2002/07/owl#Class>,
                                                      <https://w3id.org/nen2660/def#EnumerationType>;
                                                    rdfs:seeAlso <https://w3id.org/nen2660/term#RequirementTopicType>;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "The entity aspect a requirement applies to"@en;
                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Requirement topic type"@en.
<https://w3id.org/nen2660/def#Solid> a <https://w3id.org/nen2660/def#AggregationStateType>;
                                     rdfs:seeAlso <https://w3id.org/nen2660/term#Solid>;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Matter that can be picked up or held, having a texture, and usually firm. Unlike a liquid, gas or plasma"@en;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Solid"@en.
<https://w3id.org/nen2660/def#SpatialRegion> a <http://www.w3.org/ns/shacl#NodeShape>,
                                               <http://www.w3.org/2002/07/owl#Class>,
                                               rdfs:Class;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#SpatialRegion>;
                                             rdfs:subClassOf <https://w3id.org/nen2660/def#PhysicalObject>,
                                                             [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                              <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#SpatialRegion>
                                                                                                                                                      <https://w3id.org/nen2660/def#Port>) ; 
                                                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>];
                                             <http://www.w3.org/2004/02/skos/core#definition> "A physical object that encloses a particular area such as a room, roadway and river, that is bounded by real objects or other spatial areas (e.g., by usage or convention) and that contains primarily liquid or gaseous amount of matter"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Spatial region"@en;
                                             <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                    <http://www.w3.org/ns/shacl#or> ([<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#SpatialRegion>]
                                                                                                                     [<http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Port>])],
                                                                                   [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#isBoundBy> ; 
                                                                                    <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#PhysicalObject>],
                                                                                   [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#contains> ; 
                                                                                    <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#RealObject>].
<https://w3id.org/nen2660/def#State> a rdfs:Class,
                                       <http://www.w3.org/2002/07/owl#Class>,
                                       <http://www.w3.org/ns/shacl#NodeShape>;
                                     rdfs:seeAlso <https://w3id.org/nen2660/term#State>;
                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#State> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     <https://w3id.org/nen2660/def#ConcreteConcept>;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Temporal part of an entity during a period between two events. A state is characterized by the properties and relations of the entity"@en;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "State"@en;
                                     <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPeriod> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <http://www.w3.org/2006/time#TemporalEntity>],
                                                                           [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#State>],
                                                                           [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasBoundary> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>],
                                                                           [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasInterior> ; 
                                                                            <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#GeometricEntity>].
<https://w3id.org/nen2660/def#TechnicalEntity> a rdfs:Class,
                                                 <http://www.w3.org/2002/07/owl#Class>,
                                                 <http://www.w3.org/ns/shacl#NodeShape>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#TechnicalEntity>;
                                               rdfs:subClassOf <https://w3id.org/nen2660/def#Entity>,
                                                               [<http://www.w3.org/2002/07/owl#onProperty> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                <http://www.w3.org/2002/07/owl#allValuesFrom> <https://w3id.org/nen2660/def#Entity> ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>];
                                               <http://www.w3.org/2004/02/skos/core#definition> "An entity concerned with technical properties and relations that implements or plays functional entities"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Technical entity"@en;
                                               <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasTechnicalPart> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#TechnicalEntity>],
                                                                                     [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasPart> ; 
                                                                                      <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Entity>].
<https://w3id.org/nen2660/def#TopConcept> a rdfs:Class,
                                            <http://www.w3.org/2002/07/owl#Class>,
                                            <http://www.w3.org/ns/shacl#NodeShape>;
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#TopConcept>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The most generic concept"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Top concept"@en;
                                          <http://www.w3.org/ns/shacl#property> [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#abbreviation> ; 
                                                                                 <http://www.w3.org/ns/shacl#datatype> xsd:string],
                                                                                [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#hasRequirement> ; 
                                                                                 <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#Requirement>],
                                                                                [<http://www.w3.org/ns/shacl#path> <https://w3id.org/nen2660/def#isDescribedBy> ; 
                                                                                 <http://www.w3.org/ns/shacl#class> <https://w3id.org/nen2660/def#InformationObject>].
<https://w3id.org/nen2660/def#TransferType> a rdfs:Class,
                                              <http://www.w3.org/2002/07/owl#Class>,
                                              <http://www.w3.org/ns/shacl#NodeShape>,
                                              <https://w3id.org/nen2660/def#EnumerationType>;
                                            rdfs:seeAlso <https://w3id.org/nen2660/term#TransferType>;
                                            <http://www.w3.org/2002/07/owl#oneOf> (<https://w3id.org/nen2660/def#MaterialFlow>
                                                                                   <https://w3id.org/nen2660/def#EnergyFlow>
                                                                                   <https://w3id.org/nen2660/def#InformationFlow>
                                                                                   <https://w3id.org/nen2660/def#Force>);
                                            <http://www.w3.org/2004/02/skos/core#definition> "The type of thing being transferred, here: material, information, energy or force"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Transfer type"@en;
                                            <http://www.w3.org/ns/shacl#in> (<https://w3id.org/nen2660/def#MaterialFlow>
                                                                             <https://w3id.org/nen2660/def#EnergyFlow>
                                                                             <https://w3id.org/nen2660/def#InformationFlow>
                                                                             <https://w3id.org/nen2660/def#Force>).
<https://w3id.org/nen2660/def#Type> a rdfs:Class,
                                      <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:seeAlso <https://w3id.org/nen2660/term#Type>;
                                    rdfs:subClassOf <https://w3id.org/nen2660/def#AbstractConcept>;
                                    <http://www.w3.org/2004/02/skos/core#definition> "A meta-concept which instances are concepts (not individuals)"@en;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Type"@en.
<https://w3id.org/nen2660/def#abbreviation> a rdf:Property,
                                              <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                            rdfs:domain <https://w3id.org/nen2660/def#TopConcept>;
                                            rdfs:range xsd:string;
                                            rdfs:seeAlso <https://w3id.org/nen2660/term#abbreviation>;
                                            rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#altLabel>;
                                            <http://www.w3.org/2004/02/skos/core#definition> "Acronym or initial word as special case of an external name"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "abbreviation"@en.
<https://w3id.org/nen2660/def#aggregationStateType> a rdf:Property,
                                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                    rdfs:domain <https://w3id.org/nen2660/def#Matter>;
                                                    rdfs:range <https://w3id.org/nen2660/def#AggregationStateType>;
                                                    rdfs:seeAlso <https://w3id.org/nen2660/term#aggregationStateType>;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "The possession of an aggregation state type"@en;
                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "aggregation state type"@en.
<https://w3id.org/nen2660/def#begins> a rdf:Property,
                                        <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:domain <https://w3id.org/nen2660/def#Event>;
                                      rdfs:range <https://w3id.org/nen2660/def#State>;
                                      rdfs:seeAlso <https://w3id.org/nen2660/term#begins>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "The state that is started by an event"@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "begins"@en.
<https://w3id.org/nen2660/def#chemicalFormula> a rdf:Property,
                                                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                               rdfs:domain <https://w3id.org/nen2660/def#Matter>;
                                               rdfs:range xsd:string;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#chemicalFormula>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "The possession of information about the chemical proportions of atoms that constitute a particular chemical compound"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "chemical formula"@en.
<https://w3id.org/nen2660/def#connectsObject> a rdf:Property,
                                                <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#Connection>
                                                                                                    <https://w3id.org/nen2660/def#Interface>) ; 
                                                           a <http://www.w3.org/2002/07/owl#Class>];
                                              rdfs:range <https://w3id.org/nen2660/def#PhysicalObject>;
                                              rdfs:seeAlso <https://w3id.org/nen2660/term#connectsObject>;
                                              <http://www.w3.org/2004/02/skos/core#definition> "The physical objects connected by a connection or interface"@en;
                                              <http://www.w3.org/2004/02/skos/core#prefLabel> "connects object"@en.
<https://w3id.org/nen2660/def#connectsPort> a rdf:Property,
                                              <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#Connection>
                                                                                                  <https://w3id.org/nen2660/def#Interface>) ; 
                                                         a <http://www.w3.org/2002/07/owl#Class>];
                                            rdfs:range <https://w3id.org/nen2660/def#Port>;
                                            rdfs:seeAlso <https://w3id.org/nen2660/term#connectsPort>;
                                            <http://www.w3.org/2004/02/skos/core#definition> "The ports (as part of physical objects) connected by a connection or interface"@en;
                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "connects port"@en.
<https://w3id.org/nen2660/def#consistsOf> a rdf:Property,
                                            <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#RealObject>
                                                                                                <https://w3id.org/nen2660/def#Mixture>) ; 
                                                       a <http://www.w3.org/2002/07/owl#Class>];
                                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<https://w3id.org/nen2660/def#Matter>
                                                                                               <https://w3id.org/nen2660/def#MatterPortion>) ; 
                                                      a <http://www.w3.org/2002/07/owl#Class>];
                                          rdfs:seeAlso <https://w3id.org/nen2660/term#consistsOf>;
                                          <http://www.w3.org/2004/02/skos/core#definition> "The matter a real object or mixture is made of"@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "consists of"@en.
<https://w3id.org/nen2660/def#contains> a rdf:Property,
                                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:domain <https://w3id.org/nen2660/def#SpatialRegion>;
                                        rdfs:range <https://w3id.org/nen2660/def#RealObject>;
                                        rdfs:seeAlso <https://w3id.org/nen2660/term#contains>;
                                        <http://www.w3.org/2004/02/skos/core#definition> "The real objects located in a spatial region, typically the gaseous amount of bulk matter present in that region"@en;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "contains"@en.
<https://w3id.org/nen2660/def#ends> a rdf:Property,
                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:domain <https://w3id.org/nen2660/def#Event>;
                                    rdfs:range <https://w3id.org/nen2660/def#State>;
                                    rdfs:seeAlso <https://w3id.org/nen2660/term#ends>;
                                    <http://www.w3.org/2004/02/skos/core#definition> "The state that is ended by an event"@en;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "ends"@en.
<https://w3id.org/nen2660/def#executes> a rdf:Property,
                                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:domain <https://w3id.org/nen2660/def#PhysicalObject>;
                                        rdfs:range <https://w3id.org/nen2660/def#Activity>;
                                        rdfs:seeAlso <https://w3id.org/nen2660/term#executes>;
                                        <http://www.w3.org/2004/02/skos/core#definition> "The activity executed by a physical object"@en;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "executes"@en.
<https://w3id.org/nen2660/def#hasBoundary> a rdf:Property,
                                             <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:domain <https://w3id.org/nen2660/def#ConcreteConcept>;
                                           rdfs:range <https://w3id.org/nen2660/def#GeometricEntity>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#hasBoundary>;
                                           <http://www.w3.org/2004/02/skos/core#definition> "The geometric entity representing the boundary of a concrete concept"@en;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "has boundary"@en.
<https://w3id.org/nen2660/def#hasFunctionalPart> a rdf:Property,
                                                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:domain <https://w3id.org/nen2660/def#FunctionalEntity>;
                                                 rdfs:range <https://w3id.org/nen2660/def#FunctionalEntity>;
                                                 rdfs:seeAlso <https://w3id.org/nen2660/term#hasFunctionalPart>;
                                                 rdfs:subPropertyOf <https://w3id.org/nen2660/def#hasPart>;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "The hasPart relation of a functional nature"@en;
                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "has functional part"@en.
<https://w3id.org/nen2660/def#hasInterior> a rdf:Property,
                                             <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           rdfs:domain <https://w3id.org/nen2660/def#ConcreteConcept>;
                                           rdfs:range <https://w3id.org/nen2660/def#GeometricEntity>;
                                           rdfs:seeAlso <https://w3id.org/nen2660/term#hasInterior>;
                                           <http://www.w3.org/2004/02/skos/core#definition> "The geometric entity representing the interior of a concrete concept"@en;
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "has interior"@en.
<https://w3id.org/nen2660/def#hasPart> a rdf:Property,
                                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:domain <https://w3id.org/nen2660/def#ConcreteConcept>;
                                       rdfs:range <https://w3id.org/nen2660/def#ConcreteConcept>;
                                       rdfs:seeAlso <https://w3id.org/nen2660/term#hasPart>;
                                       <http://www.w3.org/2004/02/skos/core#definition> "A decomposition (hasPart) relation between concrete concepts"@en;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "has part"@en.
<https://w3id.org/nen2660/def#hasPartsGroup> a rdf:Property,
                                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:domain <https://w3id.org/nen2660/def#ConcreteConcept>;
                                             rdfs:range rdfs:Container;
                                             rdfs:seeAlso <https://w3id.org/nen2660/term#hasPart>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "The possession of an group of, potentially implicit, parts"@en;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "has parts group"@en.
<https://w3id.org/nen2660/def#hasQuantityKind> a rdf:Property,
                                                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:range <http://qudt.org/schema/qudt/QuantityKind>;
                                               rdfs:seeAlso <https://w3id.org/nen2660/term#hasQuantityKind>;
                                               <http://www.w3.org/2004/02/skos/core#definition> "The possession of a quantity kind"@en;
                                               <http://www.w3.org/2004/02/skos/core#prefLabel> "has quantity kind"@en.
<https://w3id.org/nen2660/def#hasQuantityKindShape> a <http://www.w3.org/ns/shacl#NodeShape>;
                                                    <http://www.w3.org/ns/shacl#class> <http://qudt.org/schema/qudt/QuantityKind>;
                                                    <http://www.w3.org/ns/shacl#targetObjectsOf> <https://w3id.org/nen2660/def#hasQuantityKind>.
