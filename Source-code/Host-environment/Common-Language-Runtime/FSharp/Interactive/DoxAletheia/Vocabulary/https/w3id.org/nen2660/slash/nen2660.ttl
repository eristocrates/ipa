                                                    rdfs:domain <https://w3id.org/nen2660/def#Requirement>;
                                                    rdfs:range <https://w3id.org/nen2660/def#RequirementTopicType>;
                                                    rdfs:seeAlso <https://w3id.org/nen2660/term#requirementTopicType>;
                                                    <http://www.w3.org/2004/02/skos/core#definition> "The possession of a topic type by a requirement"@en;
                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "requirement topic type"@en.
<https://w3id.org/nen2660/def#transferType> a rdf:Property,
