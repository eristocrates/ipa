comcore:ont00001734 a owl:NamedIndividual,
                      comcore:ont00000518;
                    rdfs:label "Australian Dollar"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00001735 a owl:AnnotationProperty;
                    rdfs:label "query text"@en;
                    skos:definition "The text of a query that is associated with a class"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001737 a owl:AnnotationProperty;
                    rdfs:label "doctrinal definition"@en;
                    rdfs:subPropertyOf skos:definition;
                    skos:definition "A Definition that is taken directly from a Doctrinal Source."@en;
                    skos:scopeNote "There is only one definition for any given term in an ontology; however, a Doctrinal Definition may be provided in addition to the asserted Definition if the preservation of this information is important. When both a Definition and a Doctrinal Definition are provided for a term, the Definition takes precedence."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001738 a owl:AnnotationProperty;
                    rdfs:label "SI unit label"@en;
                    rdfs:subPropertyOf skos:altLabel;
                    skos:definition "An Alternative Label that is officially accepted for use in the International System of Units (SI) as denoting a Measurement Unit."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001739 a owl:AnnotationProperty;
                    rdfs:label "ordinal measurement annotation"@en;
                    rdfs:subPropertyOf comcore:ont00001746;
                    skos:definition "An ordinal measurement value of an instance of a quality, realizable or process profile"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001740 a owl:AnnotationProperty;
                    rdfs:label "SI unit symbol"@en;
                    rdfs:subPropertyOf comcore:ont00001753;
                    skos:definition "An Acronym that is officially accepted for use in the International System of Units (SI) as denoting a Measurement Unit."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001741 a owl:AnnotationProperty;
                    rdfs:label "nominal measurement annotation"@en;
                    rdfs:subPropertyOf comcore:ont00001746;
                    skos:definition "A nominal measurement value of an instance of a quality, realizable or process profile"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001742 a owl:AnnotationProperty;
                    rdfs:label "term creator"@en;
                    rdfs:subPropertyOf comcore:ont00001762;
                    skos:definition "The name of the Term Editor who added the term to the ontology."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001743 a owl:AnnotationProperty;
                    rdfs:label "content license"@en;
                    skos:definition "The name and description of the license under which the ideas, concepts and other informational content expressed in the .owl file are released."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001744 a owl:AnnotationProperty;
                    rdfs:label "copyright"@en;
                    skos:definition "An assertion of copyright"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001745 a owl:AnnotationProperty;
                    rdfs:label "doctrinal source"@en;
                    rdfs:subPropertyOf comcore:ont00001754;
                    skos:definition "A Definition Source that consists of a formalized doctrine in which the term is authoritatively defined."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001746 a owl:AnnotationProperty;
                    rdfs:label "measurement annotation"@en;
                    skos:definition "A measurement value of an instance of a quality, realizable or process profile"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001747 a owl:AnnotationProperty;
                    rdfs:label "ratio measurement annotation"@en;
                    rdfs:subPropertyOf comcore:ont00001746;
                    skos:definition "A ratio measurement value of an instance of a quality, realizable or process profile"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001748 a owl:AnnotationProperty;
                    rdfs:label "doctrinal label"@en;
                    rdfs:subPropertyOf skos:altLabel;
                    skos:definition "An Alternative Label that consists of the preferred term or phrase used by a Doctrinal Source to denote the entity."@en;
                    skos:scopeNote "When the cco:doctrinal_label is identical to the rdfs:label, the cco:doctrinal_label annotation is superfluous. As a subclass of 'alternative label', 'doctrinal label' is intended to be used to provide additional information about the entity when its preferred doctrinal designator is ambiguous or otherwise inappropriate for use as the rdfs:label."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001749 a owl:AnnotationProperty;
                    rdfs:label "doctrinal acronym"@en;
                    rdfs:subPropertyOf comcore:ont00001753;
                    skos:definition "An Acronym that is used by a Doctrinal Source to denote the entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001752 a owl:AnnotationProperty;
                    rdfs:label "has token unit"@en;
                    skos:definition "A relation between an information content entity and a widely used measurement unit of the token used to express it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001753 a owl:AnnotationProperty;
                    rdfs:label "acronym"@en;
                    rdfs:subPropertyOf skos:altLabel;
                    skos:definition "An Alternative Label that consists of a shortened or abbreviated form of the rdfs:label and is used to denote the entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001754 a owl:AnnotationProperty;
                    rdfs:label "definition source"@en;
                    skos:definition "A citation of where all or some of the information used to create the term's Definition was acquired from."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001756 a owl:AnnotationProperty;
                    rdfs:label "interval measurement annotation"@en;
                    rdfs:subPropertyOf comcore:ont00001746;
                    skos:definition "A interval measurement value of an instance of a quality, realizable or process profile "@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001757 a owl:AnnotationProperty;
                    rdfs:label "designator annotation"@en;
                    skos:definition "A name or other identifier that is used to designate an individual."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001758 a owl:AnnotationProperty;
                    rdfs:label "http query string"@en;
                    skos:definition "The text of an HTTP request that can be sent to a SPARQL Protocol service."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001759 a owl:AnnotationProperty;
                    rdfs:label "code license"@en;
                    skos:definition "The name and description of the license under which the .owl file is released."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001760 a owl:AnnotationProperty;
                    rdfs:label "is curated in ontology"@en;
                    skos:definition "An annotation property that links a class, property, or named individual to the URI of the ontology where it is located."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001761 a owl:AnnotationProperty;
                    rdfs:label "is tokenized by"@en;
                    skos:definition "A relation between an information content entity and a widely used token used to express it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001762 a owl:AnnotationProperty;
                    rdfs:label "term editor"@en;
                    skos:definition "The name of a person who contributed to the development or enhancement of the term."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001763 a owl:DatatypeProperty;
                    rdfs:label "has altitude value"@en;
                    skos:scopeNote "Altitude values typically use kilometers as the Unit of Measurement."@en,
                                   "This data property can be used along with has_latitude_value and has_longitude_value to connect three-dimensional spatial data to a single Information Bearing Entity to specify the location of an entity in a Geospatial Region."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001764 a owl:DatatypeProperty;
                    rdfs:label "has longitude value"@en;
                    rdfs:range xsd:decimal;
                    skos:definition "A Data Property that has as its range the longitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001765 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has text value"@en;
                    skos:definition "A data property that has as its range a string value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001766 a owl:DatatypeProperty;
                    rdfs:label "has latitude value"@en;
                    rdfs:range xsd:decimal;
                    skos:definition "A Data Property that has as its range the latitude value from some Geospatial Location coordinates set expressed in decimal degrees."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001767 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has datetime value"@en;
                    rdfs:range xsd:dateTime;
                    skos:definition "A data property that has as its value a datetime value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001768 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has URI value"@en;
                    rdfs:range xsd:anyURI;
                    skos:definition "A data property that has as its range a URI value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001769 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has decimal value"@en;
                    rdfs:range xsd:decimal;
                    skos:definition "A data property that has as its range a decimal value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001770 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has double value"@en;
                    rdfs:range xsd:double;
                    skos:definition "A data property that has as its range a double value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001771 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has date value"@en;
                    skos:definition "A data property that has as its range a date value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001772 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has boolean value"@en;
                    rdfs:range xsd:boolean;
                    skos:definition "A data property that has as its range a boolean value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001773 a owl:DatatypeProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "has integer value"@en;
                    rdfs:range xsd:integer;
                    skos:definition "A data property that has as its range an integer value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001775 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000004;
                    rdfs:label "is successor of"@en;
                    rdfs:range pobo:BFO_0000004;
                    owl:inverseOf comcore:ont00001928;
                    skos:definition "x is successor of y =Def y is predecessor of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001777 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has process part"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000117;
                    owl:inverseOf comcore:ont00001857;
                    skos:definition "x has process part y =Def y is part of process x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001778 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has object"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000020
                                             pobo:BFO_0000031
                                             [owl:intersectionOf (pobo:BFO_0000004
                                                                 [a owl:Class ; 
                                                                 owl:complementOf pobo:BFO_0000006]) ; 
                                             a owl:Class])];
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    owl:inverseOf comcore:ont00001936;
                    skos:definition "x has object y =Def y is object of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001779 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000038;
                    rdfs:label "has inside instant"@en;
                    rdfs:range pobo:BFO_0000203;
                    owl:inverseOf comcore:ont00001848;
                    skos:definition "x has_inside_instant y iff x is an instance of One Dimensional Temporal Region and y is an instance of Temporal Instant and y is_inside_instant_of x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001782 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "has all members located in"@en;
                    rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                    [a owl:Class ; 
                                                    owl:complementOf pobo:BFO_0000006]) ; 
                                a owl:Class];
                    rdfs:subPropertyOf comcore:ont00001832;
                    skos:definition "x has all members located in y iff x is an instance of Object Aggregate and y is an instance of independent continuant but not a spatial region, and every member of x is located in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001787 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "agent in"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    owl:inverseOf comcore:ont00001833;
                    skos:definition "x agent_in y iff y is an instance of Process and x is an instance of Agent, such that x is causally active in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001791 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "coincides with"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001810;
                    skos:definition "x coincides_with y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and y is a spatial part of x."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive and symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001794 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001180;
                    rdfs:label "has subsidiary"@en;
                    rdfs:range comcore:ont00001180;
                    rdfs:subPropertyOf comcore:ont00001977;
                    owl:inverseOf comcore:ont00001815;
                    skos:definition "x has subsidiary y =Def y is subsidiary of x"@en;
                    comcore:ont00001754 "http://www.austlii.edu.au/legis/cth/consol_act/ca2001172/s50aa.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001795 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "has inside interval"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001924;
                    owl:inverseOf comcore:ont00001869;
                    skos:definition "x has inside interval y =Def y interval during x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001796 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "tangential part of"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001944;
                    owl:inverseOf comcore:ont00001909;
                    skos:definition "x tangential_part_of y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and there exists an instance of Immaterial Entity z such that z externally connects with x and z externally connects with y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001797 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "partially overlaps with"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001810;
                    skos:definition "x partially overlaps with y iff x and y are both instances of Immaterial Entity and x overlaps with y and x is not a spatial part of y and y is not a spatial part of x."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001798 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001262;
                    rdfs:label "is supervised by"@en;
                    rdfs:range comcore:ont00001262;
                    rdfs:subPropertyOf comcore:ont00001939;
                    owl:inverseOf comcore:ont00001943;
                    skos:definition "x is_supervised_by y iff x and y are both instances of Person and y supervises x."@en;
                    comcore:ont00001754 "http://en.wiktionary.org/wiki/supervise)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001799 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000023;
                    rdfs:label "role of aggregate"@en;
                    rdfs:range pobo:BFO_0000027;
                    rdfs:subPropertyOf comcore:ont00001809;
                    skos:definition "x role_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Role, and x inheres_in_aggregate y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001800 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001324;
                    rdfs:label "prohibits"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf comcore:ont00001942;
                    owl:inverseOf comcore:ont00001817;
                    skos:definition "x prohibits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must not occur."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001801 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is subject of"@en;
                    rdfs:range comcore:ont00000958;
                    owl:inverseOf comcore:ont00001808;
                    skos:definition "x is subject of y =Def y is about x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001803 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is cause of"@en;
                    rdfs:range pobo:BFO_0000015;
                    owl:inverseOf comcore:ont00001819;
                    skos:definition "x is_cause_of y iff x and y are instances of Process, and y is a consequence of x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001805 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is disrupted by"@en;
                    rdfs:range pobo:BFO_0000015;
                    owl:inverseOf comcore:ont00001888;
                    skos:definition "x is disrupted by y =Def y disrupts x";
                    skos:prefLabel "is disrupted by"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001807 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is required by"@en;
                    rdfs:range comcore:ont00001324;
                    rdfs:subPropertyOf comcore:ont00001920;
                    owl:inverseOf comcore:ont00001974;
                    skos:definition "x is required by y =Def y requires x"@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001808 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000958;
                    rdfs:label "is about"@en;
                    rdfs:range pobo:BFO_0000001;
                    skos:definition "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000136";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001809 a owl:ObjectProperty;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf (pobo:BFO_0000020
                                              pobo:BFO_0000031)];
                    rdfs:label "inheres in aggregate"@en;
                    rdfs:range pobo:BFO_0000027;
                    owl:inverseOf comcore:ont00001836;
                    skos:definition "x inheres_in_aggregate y iff x is an instance of Specifically Dependent Continuant or Generically Dependent Continuant and y is an instance of Object Aggregate and y aggregate_bearer_of x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001810 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "connected with"@en;
                    rdfs:range pobo:BFO_0000141;
                    skos:definition "x is_connected_with y iff x and y are both instances of Immaterial Entity and there exists an instance of Immaterial Entity z that is part of both x and y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001811 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001010;
                    rdfs:label "is an ordinal measurement of"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001966;
                    owl:inverseOf comcore:ont00001963;
                    skos:definition "x is_an_ordinal_measurement_of y iff x is an instance of Ordinal Measurement Information Content Entity and y is an instance of Entity and y is_measured_by_ordinal x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001813 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "uses"@en;
                    rdfs:range pobo:BFO_0000040;
                    owl:inverseOf comcore:ont00001925;
                    skos:definition "x uses y iff x is an instance of an Agent and y is an instance of a Material Entity, such that both x and y participate in some instance of a Process wherein x attempts to accomplish a goal by manipulating, deploying, or leveraging some attribute of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001814 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval finishes"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001971;
                    owl:inverseOf comcore:ont00001821;
                    skos:definition "x interval_finishes y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant v, w, and z such that v is the starting instant of x, w is the ending instant of both x and y, z is the starting instant of y, and z is before v."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001815 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001180;
                    rdfs:label "is subsidiary of"@en;
                    rdfs:range comcore:ont00001180;
                    rdfs:subPropertyOf comcore:ont00001939;
                    skos:definition "x is_subsidiary_of y iff x and y are both instances of Organization and y controls x by having the capacity to determine the outcome of decisions about the financial and operating policies of x. "@en;
                    comcore:ont00001754 "http://www.austlii.edu.au/legis/cth/consol_act/ca2001172/s50aa.html)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001816 a owl:ObjectProperty;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf (pobo:BFO_0000020
                                              pobo:BFO_0000031
                                              [owl:intersectionOf (pobo:BFO_0000004
                                                                  [a owl:Class ; 
                                                                  owl:complementOf pobo:BFO_0000006]) ; 
                                              a owl:Class])];
                    rdfs:label "is output of"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    owl:inverseOf comcore:ont00001986;
                    skos:definition "x is output of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the end of y is a necessary condition for the completion of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001817 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is prohibited by"@en;
                    rdfs:range comcore:ont00001324;
                    rdfs:subPropertyOf comcore:ont00001920;
                    skos:definition "x is prohibited by y =Def y prohibits x"@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001819 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000003;
                    rdfs:label "caused by"@en;
                    rdfs:range pobo:BFO_0000003;
                    skos:definition "x caused by y =Def y is cause of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001821 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval finished by"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001924;
                    skos:definition "x interval finished by y =Def y interval finishes x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001822 a owl:ObjectProperty,
                      owl:SymmetricProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval equals"@en;
                    rdfs:range pobo:BFO_0000202;
                    owl:propertyDisjointWith comcore:ont00001862;
                    skos:definition "x interval_equals y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w and z such that w is the starting instant of both x and y and z is the ending instant of both x and y."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001824 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "is excerpted from"@en;
                    rdfs:range comcore:ont00000253;
                    skos:definition "An Information Bearing Entity b1 is excerpted from another Information Bearing Entity B2 iff b1 is part of some Information Bearing Entity B1 that is carrier of some Information Content Entity C1, B2 is carrier of some Information Content Entity C2, C1 is not identical with C2, b1 is carrier of some Information Content Entity c1, b2 is an Information Bearing Entity that is part of B2 and b2 is carrier of c1 (i.e. the same Information Content Entity as borne by b1)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001825 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval overlaps"@en;
                    rdfs:range pobo:BFO_0000202;
                    owl:inverseOf comcore:ont00001870;
                    owl:propertyDisjointWith comcore:ont00001862;
                    skos:definition "x interval overlaps y =Def y interval overlapped by x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001827 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "nontangential part of"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001944;
                    owl:inverseOf comcore:ont00001989;
                    skos:definition "x nontangential_part_of y iff x and y are both instances of Immaterial Entity and x is a spatial part of y and there does not exist an instance of Immaterial Entity z such that z externally connects with x and z externally connects with y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001829 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000016;
                    rdfs:label "disposition of aggregate"@en;
                    rdfs:range pobo:BFO_0000027;
                    rdfs:subPropertyOf comcore:ont00001809;
                    owl:inverseOf comcore:ont00001956;
                    skos:definition "x disposition_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Disposition, and x inheres_in_aggregate y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001830 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has accomplice"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    owl:inverseOf comcore:ont00001895;
                    skos:definition "x has accomplice y =Def y accomplice in x"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Accomplice&oldid=1002047204"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001831 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000023;
                    rdfs:label "is subordinate role to"@en;
                    rdfs:range pobo:BFO_0000023;
                    owl:inverseOf comcore:ont00001951;
                    skos:definition "For all x,y,t: y is subordinate role to x at t iff: x is an instance of Role at time t, and y is an instance of Role at time t, and there is some z such that x is realized by z and z is an instance of Process which creates, modifies, transfers, or eliminates some u such that u is a Process Regulation at time t, and u is addressed to the bearer of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001832 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "has some member located in"@en;
                    rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                    [a owl:Class ; 
                                                    owl:complementOf pobo:BFO_0000006]) ; 
                                a owl:Class];
                    skos:definition "x has some member located in y iff x is an instance of Object Aggregate and y is an instance of independent continuant but not a spatial region, and at least one member of x is located in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001833 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has agent"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    skos:definition "x has agent y =Def y agent in x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001834 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "affects"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000020
                                             pobo:BFO_0000031
                                             [owl:intersectionOf (pobo:BFO_0000004
                                                                 [a owl:Class ; 
                                                                 owl:complementOf pobo:BFO_0000006]) ; 
                                             a owl:Class])];
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    owl:inverseOf comcore:ont00001886;
                    skos:definition "x affects y =Def y is affected by x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001836 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "aggregate bearer of"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000020
                                             pobo:BFO_0000031)];
                    skos:definition "x aggregate bearer of y =Def y inheres in aggregate x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001837 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000829;
                    rdfs:label "time zone identifier used by"@en;
                    rdfs:range comcore:ont00000253;
                    rdfs:subPropertyOf pobo:BFO_0000084;
                    owl:inverseOf comcore:ont00001908;
                    skos:definition "x time_zone_identifier_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Time Zone Identifier, such that x designates the spatial region associated with the time zone mentioned in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001838 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "disconnected with"@en;
                    rdfs:range pobo:BFO_0000141;
                    skos:definition "x disconnected_with y iff x and y are both instances of Immaterial Entity and there does not exist some immaterial entity z that is part of both x and y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001841 a owl:ObjectProperty;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf (pobo:BFO_0000020
                                              pobo:BFO_0000031
                                              [owl:intersectionOf (pobo:BFO_0000004
                                                                  [a owl:Class ; 
                                                                  owl:complementOf pobo:BFO_0000006]) ; 
                                              a owl:Class])];
                    rdfs:label "is input of"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    owl:inverseOf comcore:ont00001921;
                    skos:definition "x is input of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the beginning of y is a necessary condition for the start of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001844 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000402;
                    rdfs:label "has sender"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    owl:inverseOf comcore:ont00001993;
                    skos:definition "x has sender y =Def y sends x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001845 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000029;
                    rdfs:label "is site of"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000183;
                    owl:inverseOf comcore:ont00001918;
                    skos:definition "x is site of y =Def y occurs at x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001846 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001180;
                    rdfs:label "is organizational context of"@en;
                    rdfs:range pobo:BFO_0000023;
                    owl:inverseOf comcore:ont00001992;
                    skos:definition "x is_organizational_context_of y iff x is an instance of an Organization and y is an instance of a Role and z is an instance of a Person, such that z's affiliation with x is a prerequisite for z bearing y, or x ascribes y to the bearer of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001847 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval is after"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001862;
                    owl:inverseOf comcore:ont00001940;
                    skos:definition "x interval is after y =Def y interval is before x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001848 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000203;
                    rdfs:label "is inside instant of"@en;
                    rdfs:range pobo:BFO_0000038;
                    skos:definition "x is_inside_instant of y iff x is an instance of Temporal Instant and y is an instance of One-Dimensional Temporal Region and there are instances of Temporal Instant w and z that are part of y and non-identical to x such that w precedes x and z is preceded by x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001852 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "accessory in"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    owl:inverseOf comcore:ont00001949;
                    skos:definition "x is_accessory_in y iff x is an instance of Agent and y is an instance of Process such that x assists another instance of Agent z in the commission of y, and x was not located at the location of y when y occurred, and x is not an agent_in y."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Accessory_(legal_term)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001855 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "has spatial part"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf pobo:BFO_0000178,
                                       comcore:ont00001810;
                    owl:inverseOf comcore:ont00001944;
                    skos:definition "x has spatial part y =Def y spatial part of x"@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001857 a owl:ObjectProperty;
                    rdfs:domain [owl:intersectionOf (pobo:BFO_0000015
                                                     [a owl:Restriction ; 
                                                     owl:onProperty pobo:BFO_0000199 ; 
                                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000008
                                                                                             [a owl:Restriction ; 
                                                                                             owl:onProperty pobo:BFO_0000132 ; 
                                                                                             owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000202
                                                                                                                                     [a owl:Restriction ; 
                                                                                                                                     owl:onProperty comcore:ont00001874 ; 
                                                                                                                                     owl:someValuesFrom pobo:BFO_0000015]) ; 
                                                                                                                 a owl:Class]]) ; 
                                                                         a owl:Class]]) ; 
                                 a owl:Class];
                    rdfs:label "is part of process"@en;
                    rdfs:range [owl:intersectionOf (pobo:BFO_0000015
                                                    [a owl:Restriction ; 
                                                    owl:onProperty pobo:BFO_0000199 ; 
                                                    owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000202
                                                                                            [a owl:Restriction ; 
                                                                                            owl:onProperty pobo:BFO_0000117 ; 
                                                                                            owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000008
                                                                                                                                    [a owl:Restriction ; 
                                                                                                                                    owl:onProperty [owl:inverseOf pobo:BFO_0000199] ; 
                                                                                                                                    owl:someValuesFrom pobo:BFO_0000015]) ; 
                                                                                                                a owl:Class]]) ; 
                                                                        a owl:Class]]) ; 
                                a owl:Class];
                    rdfs:subPropertyOf pobo:BFO_0000132;
                    skos:definition "x is part of process y iff x is occurrent part of y, x and y are Processes, and x occupies a temporal region that is a proper occurrent part of the temporal interval of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001859 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001180;
                    rdfs:label "is delimited by"@en;
                    rdfs:range comcore:ont00001203;
                    owl:inverseOf comcore:ont00001864;
                    skos:definition "x is_delimited_by y iff x is an instance of Organization and y is an instance of Delimiting Domain and y delimits x."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Boundary_delimitation&oldid=1039137603"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001862 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval disjoint"@en;
                    rdfs:range pobo:BFO_0000202;
                    owl:propertyDisjointWith comcore:ont00001870,
                                             comcore:ont00001924,
                                             comcore:ont00001971;
                    skos:definition "x interval_disjoint y iff x and y are both instances of Temporal Interval and have no parts in common."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001863 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "uses measurement unit"@en;
                    rdfs:range comcore:ont00000120;
                    rdfs:subPropertyOf pobo:BFO_0000101;
                    owl:inverseOf comcore:ont00001961;
                    skos:definition "x uses measurement unit y =Def y is measurement unit of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001864 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001203;
                    rdfs:label "delimits"@en;
                    rdfs:range comcore:ont00001180;
                    skos:definition "x delimits y =Def y is delimited by x"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Boundary_delimitation&oldid=1039137603"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001866 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is interest of"@en;
                    rdfs:range comcore:ont00001017;
                    owl:inverseOf comcore:ont00001984;
                    skos:definition "x is interest of y =Def y has interest in x";
                    skos:prefLabel "is interest of"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001868 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000293;
                    rdfs:label "is a nominal measurement of"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001966;
                    owl:inverseOf comcore:ont00001914;
                    skos:definition "x is_a_nominal_measurement_of y iff x is an instance of Nominal Measurement Information Content Entity and y is an instance of Entity, such that x classifies y relative to some set of shared, possibly arbitrary, characteristics."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001869 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval during"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001971;
                    skos:definition "x interval_during y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant u, v, w, and z such that u is the starting instant of x, v is the ending instant of x, w is the starting instant of y, z is the ending instant of y, w is before u, and v is before z."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001870 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval overlapped by"@en;
                    rdfs:range pobo:BFO_0000202;
                    skos:definition "x is_overlapped_by y iff x and y are both instances of Temporal Interval and y interval_overlaps x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001873 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "represented by"@en;
                    rdfs:range comcore:ont00001069;
                    rdfs:subPropertyOf comcore:ont00001801;
                    owl:inverseOf comcore:ont00001938;
                    skos:definition "x represented by y =Def y represents x"@en;
                    skos:scopeNote "See notes for inverse property.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001874 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000008;
                    rdfs:label "is temporal region of"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000015
                                             pobo:BFO_0000035)];
                    skos:definition "x is temporal region of y =Def y occupies temporal region x"@en;
                    skos:editorialNote "Leaving this is in ERO for now since BFO2020 has no inverse of occupies-temporal-region yet."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001875 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval started by"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001924;
                    owl:inverseOf comcore:ont00001923;
                    skos:definition "x interval started by y =Def y interval starts x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001877 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001364;
                    rdfs:label "is an interval measurement of"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001966;
                    owl:inverseOf comcore:ont00001964;
                    skos:definition "x is_an_interval_measurement_of y iff x is an instance of Interval Measurement Information Content Entity and y is an instance of Entity and y is_measured_by_interval x."@en;
                    skos:example "a measurement of air temperature on the Celsius scale.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001878 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "is mention of"@en;
                    rdfs:range pobo:BFO_0000001;
                    owl:inverseOf comcore:ont00001919;
                    skos:definition "x is mention of y =Def y is mentioned by x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001879 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "designated by"@en;
                    rdfs:range comcore:ont00000686;
                    rdfs:subPropertyOf comcore:ont00001801;
                    owl:inverseOf comcore:ont00001916;
                    skos:definition "x designated by y =Def y designates x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001880 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001379;
                    rdfs:label "capability of aggregate"@en;
                    rdfs:range pobo:BFO_0000027;
                    rdfs:subPropertyOf comcore:ont00001809;
                    owl:inverseOf comcore:ont00001898;
                    skos:definition "x capability_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Agent Capability, such that x inheres in aggregate y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001884 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "condition described by"@en;
                    rdfs:range comcore:ont00000127;
                    rdfs:subPropertyOf comcore:ont00001801;
                    owl:inverseOf comcore:ont00001980;
                    owl:propertyChainAxiom (comcore:ont00001917
                                            pobo:BFO_0000176);
                    skos:definition "x condition described by y =Def y describes condition x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001886 a owl:ObjectProperty;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf (pobo:BFO_0000020
                                              pobo:BFO_0000031
                                              [owl:intersectionOf (pobo:BFO_0000004
                                                                  [a owl:Class ; 
                                                                  owl:complementOf pobo:BFO_0000006]) ; 
                                              a owl:Class])];
                    rdfs:label "is affected by"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    skos:definition "x is affected by y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y influences x in some manner, most often by producing a change in x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001888 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "disrupts"@en;
                    rdfs:range pobo:BFO_0000015;
                    skos:definition "A relation where one process disrupts another process from occurring as it would have."@en;
                    skos:editorialNote "To lower the grade of a process is to lower the quality of a process according to some standard, for example when realizing a capability or a function."@en;
                    skos:prefLabel "disrupts"@en;
                    skos:scopeNote "A process can disrupt another process from occurring as it would have by 1) preventing a disposition or role from being realized by that process, 2) lowering the grade of the process, or 3) stopping the process from continuing to occur."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001889 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001379;
                    rdfs:label "capability of"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000197;
                    owl:inverseOf comcore:ont00001954;
                    skos:definition "x capability_of y iff y is an instance of Agent and x is an instance of Agent Capability, such that x inheres in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001893 a owl:ObjectProperty,
                      owl:TransitiveProperty;
                    rdfs:domain pobo:BFO_0000203;
                    rdfs:label "instant is after"@en;
                    rdfs:range pobo:BFO_0000203;
                    owl:inverseOf comcore:ont00001990;
                    skos:definition "x instant_is_after y iff x and y are both instances of Temporal Instant and there exists some instance of Temporal Interval z such that y is the starting instant of z and x is the ending instant of z."@en;
                    skos:scopeNote "'instant is after' is a primitive relationship. Informally, a temporal instant x is after some temporal instant y iff y precedes x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001895 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "accomplice in"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    skos:definition "Agent x is accomplice_in Process y iff x assists in the commission of y, is located at the location of y, but is not agent_in y."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Accomplice&oldid=1002047204"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001896 a owl:ObjectProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval meets"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001862;
                    skos:definition "x interval meets y =Def y interval met by x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001898 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "aggregate has capability"@en;
                    rdfs:range comcore:ont00001379;
                    rdfs:subPropertyOf comcore:ont00001836;
                    skos:definition "x aggregate has capability y =Def y capability of aggregate x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001899 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001175;
                    rdfs:label "language used in"@en;
                    rdfs:range comcore:ont00000253;
                    rdfs:subPropertyOf comcore:ont00001942;
                    owl:inverseOf comcore:ont00001976;
                    skos:definition "x language_used_by y iff y is an instance of Information Bearing Entity and x is an instance of Language, such that the literal value of y is a string that is encoded according to the syntax of x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001900 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000469;
                    rdfs:label "is geospatial coordinate reference system of"@en;
                    rdfs:range comcore:ont00000253;
                    rdfs:subPropertyOf comcore:ont00001997;
                    owl:inverseOf comcore:ont00001913;
                    skos:definition "x is_geospatial_coordinate_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Geospatial Coordinate Reference System, such that x describes the set of standards mentioned in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001901 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "aggregate has role"@en;
                    rdfs:range pobo:BFO_0000023;
                    rdfs:subPropertyOf comcore:ont00001836;
                    skos:definition "x aggregate_has_role y iff x is an instance of Object Aggregate and y is an instance of Role, such that x aggregate_bearer_of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001904 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is measured by"@en;
                    rdfs:range comcore:ont00001163;
                    rdfs:subPropertyOf comcore:ont00001917;
                    owl:inverseOf comcore:ont00001966;
                    skos:definition "x is measured by y =Def y is a measurement of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001907 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "aggregate has quality"@en;
                    rdfs:range pobo:BFO_0000019;
                    rdfs:subPropertyOf comcore:ont00001836;
                    skos:definition "x aggregate_has_quality y iff x is an instance of Object Aggregate and y is an instance of Quality, such that x aggregate_bearer_of y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001908 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "uses time zone identifier"@en;
                    rdfs:range comcore:ont00000829;
                    rdfs:subPropertyOf pobo:BFO_0000101;
                    skos:definition "x uses time zone identifier y =Def y time zone identifier used by x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001909 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "has tangential part"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001855;
                    skos:definition "x has tangential part y =Def y tangential part of x"@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001910 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001324;
                    rdfs:label "permits"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf comcore:ont00001942;
                    owl:inverseOf comcore:ont00001998;
                    skos:definition "x permits y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that y may occur."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001912 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "uses reference system"@en;
                    rdfs:range comcore:ont00000398;
                    rdfs:subPropertyOf pobo:BFO_0000101;
                    owl:inverseOf comcore:ont00001997;
                    skos:definition "x uses reference system y =Def y is reference system of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001913 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "uses geospatial coordinate reference system"@en;
                    rdfs:range comcore:ont00000469;
                    rdfs:subPropertyOf comcore:ont00001912;
                    skos:definition "x uses geospatial coordinate reference system y =Def y is geospatial coordinate reference system of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001914 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is measured by nominal"@en;
                    rdfs:range comcore:ont00000293;
                    rdfs:subPropertyOf comcore:ont00001904;
                    skos:definition "x is measured by nominal y =Def y is a nominal measurement of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001915 a owl:ObjectProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval met by"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001862;
                    skos:definition "x interval_met_by y iff x and y are both instances of Temporal Interval and y interval_meets x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001916 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000686;
                    rdfs:label "designates"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001808;
                    skos:definition "x designates y iff x is an instance of a Designative Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities."@en;
                    skos:example "a URL designates the location of a Web Page on the internet",
                                 "a person's name designates that person",
                                 "a vehicle identification number designates some vehicle";
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001917 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "described by"@en;
                    rdfs:range comcore:ont00000853;
                    rdfs:subPropertyOf comcore:ont00001801;
                    owl:inverseOf comcore:ont00001982;
                    skos:definition "x described by y =Def y describes x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001918 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "occurs at"@en;
                    rdfs:range pobo:BFO_0000029;
                    rdfs:subPropertyOf pobo:BFO_0000066;
                    skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001919 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is mentioned by"@en;
                    rdfs:range comcore:ont00000253;
                    skos:definition "x is_mentioned_by y iff y is an instance of Information Bearing Entity and x is an instance of Entity, such that y is used as a reference to x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001920 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "prescribed by"@en;
                    rdfs:range comcore:ont00000965;
                    rdfs:subPropertyOf comcore:ont00001801;
                    owl:inverseOf comcore:ont00001942;
                    skos:definition "x prescribed by y =Def y prescribes x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001921 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has input"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000020
                                             pobo:BFO_0000031
                                             [owl:intersectionOf (pobo:BFO_0000004
                                                                 [a owl:Class ; 
                                                                 owl:complementOf pobo:BFO_0000006]) ; 
                                             a owl:Class])];
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    skos:definition "x has input y =Def y is input of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001922 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000402;
                    rdfs:label "has recipient"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    owl:inverseOf comcore:ont00001978;
                    skos:definition "x has recipient y =Def y receives x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001923 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval starts"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001971;
                    skos:definition "x interval_starts y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant v, w, and z such that v is the starting instant of both x and y, w is the ending instant of x, z is the ending instant of y and w is before z."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001924 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval contains"@en;
                    rdfs:range pobo:BFO_0000202;
                    owl:inverseOf comcore:ont00001971;
                    skos:definition "x interval contains y =Def y interval contained by x"@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001925 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000040;
                    rdfs:label "is used by"@en;
                    rdfs:range comcore:ont00001017;
                    skos:definition "x is used by y =Def y uses x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001928 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000004;
                    rdfs:label "is predecessor of"@en;
                    rdfs:range pobo:BFO_0000004;
                    skos:definition "x is_predecessor_of y iff x and y are both instances of Independent Continuant and there is some process p and x is an input to p and y is an output of p."@en;
                    skos:scopeNote "More informally, x is_predecessor_of y iff y follows or replaces x."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001931 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "externally connects with"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001810;
                    skos:definition "x externally_connects_with y iff x and y are both instances of Immaterial Entity and x connects with y and x does not overlap y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be symmetric. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001933 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "process starts"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf comcore:ont00001803;
                    owl:inverseOf comcore:ont00001962;
                    skos:definition "x process_starts y iff x and y are instances of processes, and x is_cause_of y, and i is an instance of a temporal instant, and r is an instance of a temporal interval, and y has starting instance i, and x occupies temporal region r, and r has inside instant i."@en;
                    skos:scopeNote "A process x starts another process y when x causes y while x is still occurring."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001936 a owl:ObjectProperty;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf (pobo:BFO_0000020
                                              pobo:BFO_0000031
                                              [owl:intersectionOf (pobo:BFO_0000004
                                                                  [a owl:Class ; 
                                                                  owl:complementOf pobo:BFO_0000006]) ; 
                                              a owl:Class])];
                    rdfs:label "is object of"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    skos:definition "x is object of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and y is performed by Agent z and x is part of the projected state that z intends to achieve by performing y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001938 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001069;
                    rdfs:label "represents"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001808;
                    skos:definition "x represents y iff x is an instance of Representational Information Content Entity, y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en,
                                   "Isomorphism between the carrier of x and the represented entity can be via a direct similarity relation, e.g., grooves in a vinyl record corresponding to sound waves, or linguistic convention, e.g., a court stenographer's transcription of spoken words, as well as others, such as encoding processes for images."@en,
                                   "The relationship that is being defined here is that between the content of a photographic image and its object, between the content of a video and its objects and events, between the content of an audio recording and the sounds or events generating those sounds, or between the content of a written transcript and the verbal event that it transcribes."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001939 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "is affiliated with"@en;
                    rdfs:range comcore:ont00001017;
                    owl:inverseOf comcore:ont00001977;
                    skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001940 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval is before"@en;
                    rdfs:range pobo:BFO_0000202;
                    rdfs:subPropertyOf comcore:ont00001862;
                    skos:definition "x interval_is_before y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w, z such that w is the ending instant of x and z is the starting instant of y and w is before z."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001942 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000965;
                    rdfs:label "prescribes"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001808;
                    skos:definition "x prescribes y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x serves as a rule or guide for y if y an Occurrent, or x serves as a model for y if y is a Continuant."@en;
                    skos:example "A blueprint prescribes some artifact or facility by being a model for it.",
                                 "A professional code of conduct prescribes some realizations of a profession (role) by giving rules for how the bearer should act in those realizations.",
                                 "An operations plan prescribes an operation by enumerating the tasks that need to be performed in order to achieve the objectives of the operation.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001943 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001262;
                    rdfs:label "supervises"@en;
                    rdfs:range comcore:ont00001262;
                    rdfs:subPropertyOf comcore:ont00001977;
                    skos:definition "x supervises y =Def y is supervised by x"@en;
                    comcore:ont00001754 "http://en.wiktionary.org/wiki/supervise";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001944 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "spatial part of"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf pobo:BFO_0000176,
                                       comcore:ont00001810;
                    skos:definition "x spatial_part_of y iff x, y, z, and q are instances of Immaterial Entity, such that for any z connected with x, z is also connected with y, and q is connected with y but not connected with x."@en;
                    skos:scopeNote "in the sense used here, spatial part of is elsewhere referred to as proper spatial part of"@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001947 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000019;
                    rdfs:label "quality of aggregate"@en;
                    rdfs:range pobo:BFO_0000027;
                    rdfs:subPropertyOf comcore:ont00001809;
                    skos:definition "x quality_of_aggregate y iff y is an instance of Object Aggregate and x is an instance of Quality, and x inheres_in_aggregate y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001949 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has accessory"@en;
                    rdfs:range comcore:ont00001017;
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    skos:definition "x has accessory y =Def y accessory in x"@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Accessory_(legal_term)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001951 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000023;
                    rdfs:label "has subordinate role"@en;
                    rdfs:range pobo:BFO_0000023;
                    skos:definition "x has subordinate role y =Def y is subordinate role to x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001954 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "has capability"@en;
                    rdfs:range comcore:ont00001379;
                    rdfs:subPropertyOf pobo:BFO_0000196;
                    skos:definition "x has capability y =Def y capability of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001956 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000027;
                    rdfs:label "aggregate has disposition"@en;
                    rdfs:range pobo:BFO_0000016;
                    rdfs:subPropertyOf comcore:ont00001836;
                    skos:definition "x aggregate has disposition y =Def y disposition of aggregate x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001959 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "inhibits"@en;
                    rdfs:range pobo:BFO_0000015;
                    owl:inverseOf comcore:ont00001970;
                    skos:definition "x inhibits y =Def y is inhibited by x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001961 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000120;
                    rdfs:label "is measurement unit of"@en;
                    rdfs:range comcore:ont00000253;
                    rdfs:subPropertyOf pobo:BFO_0000084;
                    skos:definition "x is_measurement_unit_of y iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001962 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "process started by"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf comcore:ont00001819;
                    skos:definition "x process started by y =Def y process starts x"@en;
                    skos:scopeNote "A process x is started by another process y when y causes x while y is still occurring."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001963 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is measured by ordinal"@en;
                    rdfs:range comcore:ont00001010;
                    rdfs:subPropertyOf comcore:ont00001904;
                    skos:definition "x is measured by ordinal y =Def y is a ordinal measurement of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001964 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is measured by interval"@en;
                    rdfs:range comcore:ont00001364;
                    rdfs:subPropertyOf comcore:ont00001904;
                    skos:definition "x is measured by interval y =Def y is a interval measurement of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001965 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000001;
                    rdfs:label "is measured by ratio"@en;
                    rdfs:range comcore:ont00001022;
                    rdfs:subPropertyOf comcore:ont00001904;
                    owl:inverseOf comcore:ont00001983;
                    skos:definition "x is measured by ratio y =Def y is a ratio measurement of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001966 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001163;
                    rdfs:label "is a measurement of"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001982;
                    skos:definition "x is_a_measurement_of y iff x is an instance of Measurement Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en,
                                   "This object property, as well as all of its children are typified as functional properties. This means that for instances x, y, and z if x is a measurement of y and x is a measurement of z, then y = z."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001970 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "inhibited by"@en;
                    rdfs:range pobo:BFO_0000015;
                    skos:definition "y inhibited_by x iff x and y are non-identical Processes, d is a Decrease of Realizable Entity, and x is_cause_of d, and r is a Realizable Entity, and d has_participant r, and r realized_in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001971 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000202;
                    rdfs:label "interval contained by"@en;
                    rdfs:range pobo:BFO_0000202;
                    skos:definition "x interval_contained_by y iff x and y are both instances of Temporal Interval and y interval_contains x."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001974 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001324;
                    rdfs:label "requires"@en;
                    rdfs:range pobo:BFO_0000015;
                    rdfs:subPropertyOf comcore:ont00001942;
                    skos:definition "x requires y at t iff: x is an instance of Process Regulation at time t, and y is an instance of Process at time t, and x prescribes that some y must occur."@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001976 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000253;
                    rdfs:label "uses language"@en;
                    rdfs:range comcore:ont00001175;
                    rdfs:subPropertyOf comcore:ont00001920;
                    skos:definition "x uses language y =Def y language used in x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001977 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "has affiliate"@en;
                    rdfs:range comcore:ont00001017;
                    skos:definition "x has affiliate y =Def y is affiliated with x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001978 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "receives"@en;
                    rdfs:range comcore:ont00000402;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    skos:definition "x receives y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the recipient and decoder of the InformationContentEntity intended for communication in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001980 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000127;
                    rdfs:label "describes condition"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001808;
                    owl:propertyChainAxiom (pobo:BFO_0000178
                                            comcore:ont00001982);
                    skos:definition "p describes_condition c iff p is an instance of a Performance Specification and c is an instance of Entity and p has part d, and d is an instance of a Descriptive Information Content Entity, and p prescribes an entity s, and d describes c, and c is an entity that is causally relevant to s existing as prescribed by p."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001982 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000853;
                    rdfs:label "describes"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001808;
                    skos:definition "x describes y iff x is an instance of Descriptive Information Content Entity, and y is an instance of Entity, such that x is_about the characteristics that identify y."@en;
                    skos:example "the content of a newspaper article describes some current event",
                                 "the content of a visitor's log describes some facility visit",
                                 "the content of an accident report describes some accident";
                    skos:scopeNote "It is possible that this relation should be a functional property, that is for all x, y, z if x describes y and x describes z then y = z. For example, if a financial report x describes the quarterly results of a company y and that same financial report describes the quarterly results of a company z, then it should be inferred that companies y and z are the same. We refrained from classifying the relation as a functional property on the concern that descriptions are multifaceted and so consequently it may be that the same report would contain descriptions of multiple entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001983 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001022;
                    rdfs:label "is a ratio measurement of"@en;
                    rdfs:range pobo:BFO_0000001;
                    rdfs:subPropertyOf comcore:ont00001966;
                    skos:definition "x is_a_ratio_measurement_of y iff x is an instance of Ratio Measurement Information Content Entity and y is an instance of Entity and x describes some attribute of y relative to a scale having equal unit values and a zero value that corresponds to the absence of the attribute being measured."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001984 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "has interest in"@en;
                    rdfs:range pobo:BFO_0000015;
                    skos:definition "A relation between an Agent and some Process where the Agent has an interest in that Process."@en;
                    skos:editorialNote "This term is meant to be weakly normative. The only sense in which the process is of positive normative value is that it's prescribed by the Agent, or historically of evolutionary benefit to the Agent's ancestors, or facilitates a process the Agent has an interest in for the prior two reasons. The process an Agent has an interest could in many or all ways be harmful to the Agent."@en;
                    skos:prefLabel "has interest in"@en;
                    skos:scopeNote "There are four conditions in which an agent has an interest in some process. 1) Biological Condition: If a part (including improper part) of an organism has a function, then that organism has an interest in the realization of that function. 2) Artifactual Condition: If a part (including improper part) of an artifact has a function, then some agent or group of agents, at some time, has an interest in the realization of that function. 3) Prescription Condition: If an agent or group of agents has a plan, then it has an interest in the realization of all the processes and process-combinations prescribed by that plan. 4) Facilitation Condition: If (a) agent x has an interest in the realization of a disposition y, and (b) the realization of a disposition z facilitates the realization of disposition y, then (c) x has an interest in the realization of disposition z, and by 'facilitates' we mean that the occurrence of a process w, which realizes realization of z is either (1) required for y, to realize or (2) would contribute positively to the grade of, y's realization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001986 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "has output"@en;
                    rdfs:range [a owl:Class ; 
                                owl:unionOf (pobo:BFO_0000020
                                             pobo:BFO_0000031
                                             [owl:intersectionOf (pobo:BFO_0000004
                                                                 [a owl:Class ; 
                                                                 owl:complementOf pobo:BFO_0000006]) ; 
                                             a owl:Class])];
                    rdfs:subPropertyOf pobo:BFO_0000057;
                    skos:definition "x has output y =Def y is output of x"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=IPO_model&oldid=1024398398"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI.
comcore:ont00001989 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000141;
                    rdfs:label "has nontangential part"@en;
                    rdfs:range pobo:BFO_0000141;
                    rdfs:subPropertyOf comcore:ont00001855;
                    skos:definition "x has nontangential part y =Def y nontangential part of x"@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be transitive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001754 """Randell, D. A., Cui, Z. and Cohn, A. G.: 1992, \"A spatial logic based on regions and connection,\" Proc. 3rd Int. Conf. on Knowledge Representation and Reasoning, Morgan Kaufmann, San Mateo, pp. 165-176. Available at: https://www.dpi.inpe.br/gilberto/references/cohn_rcc.pdf"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001990 a owl:ObjectProperty,
                      owl:TransitiveProperty;
                    rdfs:domain pobo:BFO_0000203;
                    rdfs:label "instant is before"@en;
                    rdfs:range pobo:BFO_0000203;
                    skos:definition "x instant_is_before y iff x and y are both instances of Zero Dimensional Temporal Region and there exists some instance of Temporal Interval z such that x is the starting instant of z and y is the ending instant of z."@en;
                    skos:scopeNote "'instant is before' is a primitive relationship. Informally, a temporal instant x is before some temporal instant y iff x precedes y."@en;
                    comcore:ont00001754 "J. F. Allen and J. A. G. M. Koomen. Planning using a temporal world model. In Proceedings of the 8th International Joint Conference on Artificial Intelligence (IJCAI-1983)  pages 741–747. Available at: https://www.ijcai.org/Proceedings/83-2/Papers/036.pdf"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001992 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000023;
                    rdfs:label "has organizational context"@en;
                    rdfs:range comcore:ont00001180;
                    skos:definition "x has organizational context y =Def y is organizational context of x"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001993 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00001017;
                    rdfs:label "sends"@en;
                    rdfs:range comcore:ont00000402;
                    rdfs:subPropertyOf pobo:BFO_0000056;
                    skos:definition "x sends y iff x is an instance of Agent and y is an instance of Act Of Communication, such that x is the initiator and encoder of the InformationContentEntity intended for communication in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001997 a owl:ObjectProperty;
                    rdfs:domain comcore:ont00000398;
                    rdfs:label "is reference system of"@en;
                    rdfs:range comcore:ont00000253;
                    rdfs:subPropertyOf pobo:BFO_0000084;
                    skos:definition "x is_reference_system_of y iff y is an instance of Information Bearing Entity and x is an instance of Reference System, such that x describes the set of standards mentioned in y."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001998 a owl:ObjectProperty;
                    rdfs:domain pobo:BFO_0000015;
                    rdfs:label "is permitted by"@en;
                    rdfs:range comcore:ont00001324;
                    rdfs:subPropertyOf comcore:ont00001920;
                    skos:definition "x is permitted by y =Def y permits x"@en;
                    skos:scopeNote "Given a stronger temporal interpretation, this property may be asymmetric and irreflexive. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001999 a owl:Class;
                    rdfs:label "Filter Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process where entities of a specific type or which have specified properties enter it or pass through it."@en;
                    skos:scopeNote """Although its basic function remains the same, a Filter can be used in 2 different ways:
(1) to allow only the desired entities to pass through (e.g. removing dirt from engine oil); or
(2) to allow everything except the desired entities to pass through (e.g. panning for gold)."""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002000 a owl:Class;
                    rdfs:label "Center of Mass"@en;
                    rdfs:subClassOf pobo:BFO_0000147;
                    skos:definition "A Fiat Point that is where the weighted position vectors of the distributed Mass of a Material Entity relative to this point sum to zero."@en;
                    comcore:ont00001754 "Asimov, Isaac. Understanding Physics. New York: Barnes and Noble, 1993. 76-79. Available at: https://archive.org/details/understandingphy00isaa/page/n91/mode/2up"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00002001 a owl:Class;
                    rdfs:label "Media Content Entity";
                    rdfs:subClassOf comcore:ont00000958;
                    skos:definition "An information content entity presented in a canonical media format."@en;
                    skos:scopeNote "By 'canonical', it is intended that the media format is of a commonly recognized format, such as mass media formats such as books, magazines, and journals, as well as digital media forms (e.g. ebooks), to include, too, file types, such as those recognized by the Internet Assigned Numbers Authority (IANA)'s Media Types standard [RFC2046].";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002002 a owl:Class;
                    rdfs:label "Certificate"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity that attests to certain demonstrated characteristics of an Object, Person, or Organization."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/degree";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002003 a owl:Class;
                    rdfs:label "Academic Degree"@en;
                    rdfs:subClassOf comcore:ont00002002;
                    skos:definition "A Certificate issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/degree";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002004 a owl:Class;
                    rdfs:label "Image"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Image&oldid=1062709732"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002005 a owl:Class;
                    rdfs:label "Chart"@en;
                    rdfs:subClassOf comcore:ont00002004;
                    skos:definition "An Image that is prescribed by some canonical visual format."@en;
                    comcore:ont00001754 "Adapted from “Chart.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/chart. Accessed 4 Aug. 2024.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002006 a owl:Class;
                    rdfs:label "Database"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity that is designed to be rapidly searchable and retrievable."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Database&oldid=1057024641"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002007 a owl:Class;
                    rdfs:label "List"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity whose parts are the subject of some Sequence Position Ordinality."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=List_(abstract_data_type)&oldid=1041588680"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002008 a owl:Class;
                    rdfs:label "Code List"@en;
                    rdfs:subClassOf comcore:ont00002007;
                    skos:definition "A List whose parts are Code Identifiers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002009 a owl:Class;
                    rdfs:label "Video"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity that contains a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Video&oldid=1049376249"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002010 a owl:Class;
                    rdfs:label "Message"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity that is relatively brief and designed to be transmitted from a sender to a recipient."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Message&oldid=1060098631"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002011 a owl:Class;
                    rdfs:label "Warning Message"@en;
                    rdfs:subClassOf comcore:ont00002010;
                    skos:definition "A Message that describes a possible or impending threat."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002012 a owl:Class;
                    rdfs:label "Email Message"@en;
                    rdfs:subClassOf comcore:ont00002010;
                    skos:definition "A Message that is transmitted to the recipient's Email Box."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002013 a owl:Class;
                    rdfs:label "Notification Message"@en;
                    rdfs:subClassOf comcore:ont00002010;
                    skos:definition "A Message that describes a scenario that has been determined to merit attention by the recipient."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002014 a owl:Class;
                    rdfs:label "Barcode"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content Entity that represents one or more geometric shapes that have, as part, some Prescriptive Information Content Entity."@en;
                    skos:scopeNote "For information on types of barcodes, see: https://www.scandit.com/types-barcodes-choosing-right-barcode/"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Barcode&oldid=1059844765"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002037 a owl:Class;
                    rdfs:label "Information Line"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:definition "A Media Content entity consisting of a single line or row in some Document Content entity of which it is a part."@en;
                    skos:example "a line in a computer file that bears a portion of code for some computer program",
                                 "a line of data in a database",
                                 "a line of text in a book";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002038 a owl:Class;
                    rdfs:label "Document Field Content"@en;
                    rdfs:subClassOf comcore:ont00002001,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00002039];
                    skos:altLabel "Document Field"@en;
                    skos:definition "A Media Content Entity that is a part of some document content entity, and which  prescribes the eliciation of information to be written or selected within the document content entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002039 a owl:Class;
                    rdfs:label "Document Content Entity"@en;
                    rdfs:subClassOf comcore:ont00002001;
                    skos:altLabel "Document"@en;
                    skos:definition "A Media Content Entity that consists of a series of paragraphs of text or diagrams that are intended to be carried by physical pieces of paper or an electronic word processor file."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Document&oldid=1057829688"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002040 a owl:Class;
                    rdfs:label "Book"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content Entity that canonically appears as ink on paper or parchment, or other materials fastened together to hinge at one side."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Book&oldid=1063132471"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002041 a owl:Class;
                    rdfs:label "Transcript"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content Entity that was originally recorded in a different medium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transcript&oldid=1038510063"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002042 a owl:Class;
                    rdfs:label "Spreadsheet"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content Entity that canonically appears as a interactive, tabular form."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spreadsheet&oldid=1064060503"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002043 a owl:Class;
                    rdfs:label "Report"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Report&oldid=1063765657"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002044 a owl:Class;
                    rdfs:label "Form Document"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content Entity that has Document Field Contents as parts."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Form_(document)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002045 a owl:Class;
                    rdfs:label "Journal Article"@en;
                    rdfs:subClassOf comcore:ont00002039;
                    skos:definition "A Document Content Entity that is part of a Journal Issue."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Academic_journal&oldid=1059723283"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002066 a owl:Class;
                    rdfs:label "Explosive Mine"@en;
                    rdfs:subClassOf comcore:ont00000552;
                    skos:altLabel "Mine"@en,
                                  "Mine Weapon"@en;
                    skos:definition "An Explosive Weapon that is designed to be concealed and to detonate as its target passes near it."@en;
                    skos:scopeNote "Being (relatively) stationary is a common but not necessary feature of explosive mines."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Explosive_mine&oldid=1116284461"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002067 a owl:Class;
                    rdfs:label "Explosive Naval Mine"@en;
                    rdfs:subClassOf comcore:ont00002066;
                    skos:altLabel "Naval Mine"@en,
                                  "Sea Mine"@en;
                    skos:definition "An Explosive Mine that is designed to be concealed on or under water."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Naval_mine&oldid=1299942380"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002068 a owl:Class;
                    rdfs:label "Display Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000995
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00002069]) ; 
                                         a owl:Class];
                    skos:definition "A Material Artifact that is designed to bear an Image Display Artifact Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002069 a owl:Class;
                    rdfs:label "Image Display Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to display an Image."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002070 a owl:Class;
                    rdfs:altLabel "Email Box Identifier"@en;
                    rdfs:label "Email Address"@en;
                    rdfs:subClassOf comcore:ont00000003;
                    skos:definition "A Designative Name created in order to identify some Email Box as the destination of an email message for the purpose of Email Messaging."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00002071 a owl:Class;
                    rdfs:label "Act of Employment"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association wherein an Agent assigns a set of activities to some Person to be performed in exchange for financial compensation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00002073 a owl:Class;
                    rdfs:label "Sensor Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an entity in virtue of it being used in a process wherein an attribute of its bearer acts as a proxy for some aspect of its sensing environment."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002074 a owl:Class;
                    rdfs:label "Sensor Platform Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an entity in virtue of it being used to support or convey a Sensor during its deployment and functioning."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00002075 a owl:Class;
                    rdfs:label "Sensing Process"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000015
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000055 ; 
                                                             owl:someValuesFrom [a owl:Class ; 
                                                                                 owl:unionOf (comcore:ont00001241
                                                                                              comcore:ont00002073)]]) ; 
                                         a owl:Class];
                    skos:definition "A Process that realizes a Sensor Function or Sensor Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
