@base <https://www.commoncoreontologies.org/CommonCoreOntologiesMerged>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <https://www.commoncoreontologies.org/CommonCoreOntologiesMerged#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix pobo: <http://purl.obolibrary.org/obo/>.
@prefix w3: <http://www.w3.org/>.
@prefix geosparql: <http://www.opengis.net/ont/geosparql#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix comcore: <https://www.commoncoreontologies.org/>.
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_>.

_:autos21603 a owl:AllDisjointClasses;
             owl:members (pobo:BFO_0000004
                          pobo:BFO_0000020
                          pobo:BFO_0000031).
_:autos21607 a owl:AllDisjointClasses;
             owl:members (pobo:BFO_0000006
                          pobo:BFO_0000029
                          pobo:BFO_0000140).
_:autos21611 a owl:AllDisjointClasses;
             owl:members (pobo:BFO_0000008
                          pobo:BFO_0000011
                          pobo:BFO_0000015
                          pobo:BFO_0000035).
_:autos21616 a owl:AllDisjointClasses;
             owl:members (pobo:BFO_0000009
                          pobo:BFO_0000018
                          pobo:BFO_0000026
                          pobo:BFO_0000028).
_:autos21621 a owl:AllDisjointClasses;
             owl:members (pobo:BFO_0000142
                          pobo:BFO_0000146
                          pobo:BFO_0000147).
pobo:BFO_0000001 dc11:identifier "001-BFO";
                 a owl:Class;
                 rdfs:label "entity"@en;
                 skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en;
                 skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en.
pobo:BFO_0000002 dc11:identifier "008-BFO";
                 a owl:Class;
                 rdfs:label "continuant"@en;
                 rdfs:subClassOf pobo:BFO_0000001,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000176 ; 
                                  owl:allValuesFrom pobo:BFO_0000002];
                 owl:disjointWith pobo:BFO_0000003;
                 skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en;
                 skos:example "A human being; a tennis ball; a cave; a region of space; someone's temperature"@en.
pobo:BFO_0000003 dc11:identifier "077-BFO";
                 a owl:Class;
                 rdfs:label "occurrent"@en;
                 rdfs:subClassOf pobo:BFO_0000001;
                 skos:definition "(Elucidation) An occurrent is an entity that unfolds itself in time or it is the start or end of such an entity or it is a temporal or spatiotemporal region"@en;
                 skos:example "As for process, history, process boundary, spatiotemporal region, zero-dimensional temporal region, one-dimensional temporal region, temporal interval, temporal instant."@en.
pobo:BFO_0000004 dc11:identifier "017-BFO";
                 a owl:Class;
                 rdfs:label "independent continuant"@en;
                 rdfs:subClassOf pobo:BFO_0000002,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000176 ; 
                                  owl:allValuesFrom pobo:BFO_0000004];
                 skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en;
                 skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en.
pobo:BFO_0000006 dc11:identifier "035-BFO";
                 a owl:Class;
                 rdfs:label "spatial region"@en;
                 rdfs:subClassOf pobo:BFO_0000141,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000176 ; 
                                  owl:allValuesFrom pobo:BFO_0000006];
                 skos:definition "(Elucidation) A spatial region is a continuant entity that is a continuant part of the spatial projection of a portion of spacetime at a given time"@en;
                 skos:example "As for zero-dimensional spatial region, one-dimensional spatial region, two-dimensional spatial region, three-dimensional spatial region"@en.
pobo:BFO_0000008 dc11:identifier "100-BFO";
                 a owl:Class;
                 rdfs:label "temporal region"@en;
                 rdfs:subClassOf pobo:BFO_0000003,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000132 ; 
                                  owl:allValuesFrom pobo:BFO_0000008],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000139 ; 
                                  owl:allValuesFrom pobo:BFO_0000008];
                 skos:definition "(Elucidation) A temporal region is an occurrent over which processes can unfold"@en;
                 skos:example "As for zero-dimensional temporal region and one-dimensional temporal region"@en.
pobo:BFO_0000009 dc11:identifier "039-BFO";
                 a owl:Class;
                 rdfs:label "two-dimensional spatial region"@en;
                 rdfs:subClassOf pobo:BFO_0000006,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000009
                                                                  pobo:BFO_0000018
                                                                  pobo:BFO_0000026)]];
                 skos:definition "(Elucidation) A two-dimensional spatial region is a spatial region that is a whole consisting of a surface together with zero or more surfaces which may have spatial regions of lower dimension as parts"@en;
                 skos:example "The surface of a sphere-shaped part of space; an infinitely thin plane in space"@en.
pobo:BFO_0000011 dc11:identifier "095-BFO";
                 a owl:Class;
                 rdfs:label "spatiotemporal region"@en;
                 rdfs:subClassOf pobo:BFO_0000003,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000132 ; 
                                  owl:allValuesFrom pobo:BFO_0000011],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000139 ; 
                                  owl:allValuesFrom pobo:BFO_0000011];
                 skos:definition "(Elucidation) A spatiotemporal region is an occurrent that is an occurrent part of spacetime"@en;
                 skos:example "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en;
                 skos:scopeNote "'Spacetime' here refers to the maximal instance of the universal spatiotemporal region."@en.
pobo:BFO_0000015 dc11:identifier "083-BFO";
                 a owl:Class;
                 rdfs:label "process"@en;
                 rdfs:subClassOf pobo:BFO_0000003,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000117 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000015
                                                                  pobo:BFO_0000035)]],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000132 ; 
                                  owl:allValuesFrom pobo:BFO_0000015],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000139 ; 
                                  owl:allValuesFrom pobo:BFO_0000015];
                 skos:altLabel "event"@en;
                 skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en;
                 skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en.
pobo:BFO_0000016 dc11:identifier "062-BFO";
                 a owl:Class;
                 rdfs:label "disposition"@en;
                 rdfs:subClassOf pobo:BFO_0000017;
                 owl:disjointWith pobo:BFO_0000023;
                 skos:altLabel "internally-grounded realizable entity"@en;
                 skos:definition "(Elucidation) A disposition b is a realizable entity such that if b ceases to exist then its bearer is physically changed & b's realization occurs when and because this bearer is in some special physical circumstances & this realization occurs in virtue of the bearer's physical make-up"@en;
                 skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en.
pobo:BFO_0000017 dc11:identifier "058-BFO";
                 a owl:Class;
                 rdfs:label "realizable entity"@en;
                 rdfs:subClassOf pobo:BFO_0000020;
                 owl:disjointWith pobo:BFO_0000019;
                 skos:definition "(Elucidation) A realizable entity is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region & which is of a type some instances of which are realized in processes of a correlated type"@en;
                 skos:example "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en.
pobo:BFO_0000018 dc11:identifier "037-BFO";
                 a owl:Class;
                 rdfs:label "zero-dimensional spatial region"@en;
                 rdfs:subClassOf pobo:BFO_0000006,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom pobo:BFO_0000018];
                 skos:definition "(Elucidation) A zero-dimensional spatial region is one or a collection of more than one spatially disjoint points in space"@en;
                 skos:example "The spatial region occupied at some time instant by the North Pole"@en.
pobo:BFO_0000019 dc11:identifier "055-BFO";
                 a owl:Class;
                 rdfs:label "quality"@en;
                 rdfs:subClassOf pobo:BFO_0000020;
                 skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en;
                 skos:example "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en.
pobo:BFO_0000020 dc11:identifier "050-BFO";
                 a owl:Class;
                 rdfs:label "specifically dependent continuant"@en;
                 rdfs:subClassOf pobo:BFO_0000002;
                 skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en;
                 skos:example "(with multiple bearers) John's love for Mary; the ownership relation between John and this statue; the relation of authority between John and his subordinates"@en,
                              "(with one bearer) The mass of this tomato; the pink colour of a medium rare piece of grilled filet mignon at its centre; the smell of this portion of mozzarella; the disposition of this fish to decay; the role of being a doctor; the function of this heart to pump blood; the shape of this hole"@en.
pobo:BFO_0000023 dc11:identifier "061-BFO";
                 a owl:Class;
                 rdfs:label "role"@en;
                 rdfs:subClassOf pobo:BFO_0000017;
                 skos:altLabel "externally-grounded realizable entity"@en;
                 skos:definition "(Elucidation) A role b is a realizable entity such that b exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be & b is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed"@en;
                 skos:example "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a boundary to demarcate two neighbouring administrative territories; the role of a building in serving as a military target"@en.
pobo:BFO_0000024 dc11:identifier "027-BFO";
                 a owl:Class;
                 rdfs:label "fiat object part"@en;
                 rdfs:subClassOf pobo:BFO_0000040;
                 skos:definition "(Elucidation) A fiat object part b is a material entity & such that if b exists then it is continuant part of some object c & demarcated from the remainder of c by one or more fiat surfaces"@en;
                 skos:example "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA:regional parts of an intact human body"@en.
pobo:BFO_0000026 dc11:identifier "038-BFO";
                 a owl:Class;
                 rdfs:label "one-dimensional spatial region"@en;
                 rdfs:subClassOf pobo:BFO_0000006,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000018
                                                                  pobo:BFO_0000026)]];
                 skos:definition "(Elucidation) A one-dimensional spatial region is a whole consisting of a line together with zero or more lines which may have points as parts"@en;
                 skos:example "An edge of a cube-shaped portion of space; a line connecting two points; two parallel lines extended in space"@en.
pobo:BFO_0000027 dc11:identifier "025-BFO";
                 a owl:Class;
                 rdfs:label "object aggregate"@en;
                 rdfs:subClassOf pobo:BFO_0000040;
                 skos:definition "(Elucidation) An object aggregate is a material entity consisting exactly of a plurality (≥1) of objects as member parts which together form a unit"@en;
                 skos:example "The aggregate of the musicians in a symphony orchestra and their instruments; the aggregate of bearings in a constant velocity axle joint; the nitrogen atoms in the atmosphere; a collection of cells in a blood biobank"@en;
                 skos:scopeNote "'Exactly' means that there are no parts of the object aggregate other than its member parts.",
                                "The unit can, at certain times, consist of exactly one object, for example, when a wolf litter loses all but one of its pups, but it must at some time have a plurality of member parts.".
pobo:BFO_0000028 dc11:identifier "040-BFO";
                 a owl:Class;
                 rdfs:label "three-dimensional spatial region"@en;
                 rdfs:subClassOf pobo:BFO_0000006,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom pobo:BFO_0000006];
                 skos:definition "(Elucidation) A three-dimensional spatial region is a whole consisting of a spatial volume together with zero or more spatial volumes which may have spatial regions of lower dimension as parts"@en;
                 skos:example "A cube-shaped region of space; a sphere-shaped region of space; the region of space occupied by all and only the planets in the solar system at some point in time"@en.
pobo:BFO_0000029 dc11:identifier "034-BFO";
                 a owl:Class;
                 rdfs:label "site"@en;
                 rdfs:subClassOf pobo:BFO_0000141,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000176 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000029
                                                                  pobo:BFO_0000040)]],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000029
                                                                  pobo:BFO_0000140)]],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000210 ; 
                                  owl:allValuesFrom pobo:BFO_0000028];
                 skos:definition "(Elucidation) A site is a three-dimensional immaterial entity whose boundaries either (partially or wholly) coincide with the boundaries of one or more material entities or have locations determined in relation to some material entity"@en;
                 skos:example "A hole in a portion of cheese; a rabbit hole; the Grand Canyon; the Piazza San Marco; the kangaroo-joey-containing hole of a kangaroo pouch; your left nostril (a fiat part - the opening - of your left nasal cavity); the lumen of your gut; the hold of a ship; the interior of the trunk of your car; hole in an engineered floor joist"@en.
pobo:BFO_0000030 dc11:identifier "024-BFO";
                 a owl:Class;
                 rdfs:label "object"@en;
                 rdfs:subClassOf pobo:BFO_0000040;
                 skos:definition "(Elucidation) An object is a material entity which manifests causal unity & is of a type instances of which are maximal relative to the sort of causal unity manifested"@en;
                 skos:example "An organism; a fish tank; a planet; a laptop; a valve; a block of marble; an ice cube"@en;
                 skos:scopeNote "A description of three primary sorts of causal unity is provided in Basic Formal Ontology 2.0. Specification and User Guide"@en.
pobo:BFO_0000031 dc11:identifier "074-BFO";
                 a owl:Class;
                 rdfs:label "generically dependent continuant"@en;
                 rdfs:subClassOf pobo:BFO_0000002;
                 skos:altLabel "g-dependent continuant"@en;
                 skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en;
                 skos:example "The pdf file on your laptop; the pdf file that is a copy thereof on my laptop; the sequence of this protein molecule; the sequence that is a copy thereof in that protein molecule; the content that is shared by a string of dots and dashes written on a page and the transmitted Morse code signal; the content of a sentence; an engineering blueprint"@en.
pobo:BFO_0000034 dc11:identifier "064-BFO";
                 a owl:Class;
                 rdfs:label "function"@en;
                 rdfs:subClassOf pobo:BFO_0000016;
                 skos:definition "(Elucidation) A function is a disposition that exists in virtue of its bearer's physical make-up & this physical make-up is something the bearer possesses because it came into being either through evolution (in the case of natural biological entities) or through intentional design (in the case of artefacts) in order to realize processes of a certain sort"@en;
                 skos:example "The function of a hammer to drive in nails; the function of a heart pacemaker to regulate the beating of a heart through electricity"@en.
pobo:BFO_0000035 dc11:identifier "084-BFO";
                 a owl:Class;
                 rdfs:label "process boundary"@en;
                 rdfs:subClassOf pobo:BFO_0000003,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000117 ; 
                                  owl:allValuesFrom pobo:BFO_0000035],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000121 ; 
                                  owl:allValuesFrom pobo:BFO_0000035],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000132 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000015
                                                                  pobo:BFO_0000035)]],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000139 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000015
                                                                  pobo:BFO_0000035)]];
                 skos:definition "p is a process boundary =Def p is a temporal part of a process & p has no proper temporal parts"@en;
                 skos:example "The boundary between the 2nd and 3rd year of your life"@en.
pobo:BFO_0000038 dc11:identifier "103-BFO";
                 a owl:Class;
                 rdfs:label "one-dimensional temporal region"@en;
                 rdfs:subClassOf pobo:BFO_0000008,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000121 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000038
                                                                  pobo:BFO_0000148)]],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000139 ; 
                                  owl:allValuesFrom pobo:BFO_0000038];
                 owl:disjointWith pobo:BFO_0000148;
                 skos:definition "(Elucidation) A one-dimensional temporal region is a temporal region that is a whole that has a temporal interval and zero or more temporal intervals and temporal instants as parts"@en;
                 skos:example "The temporal region during which a process occurs"@en.
pobo:BFO_0000040 dc11:identifier "019-BFO";
                 a owl:Class;
                 rdfs:label "material entity"@en;
                 rdfs:subClassOf pobo:BFO_0000004,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000176 ; 
                                  owl:allValuesFrom pobo:BFO_0000040],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000029
                                                                  pobo:BFO_0000040
                                                                  pobo:BFO_0000140)]];
                 owl:disjointWith pobo:BFO_0000141;
                 skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en;
                 skos:example "A human being; the undetached arm of a human being; an aggregate of human beings"@en.
pobo:BFO_0000054 dc11:identifier "206-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000017;
                 rdfs:label "has realization"@en;
                 rdfs:range pobo:BFO_0000015;
                 owl:inverseOf pobo:BFO_0000055;
                 skos:altLabel "realized in"@en;
                 skos:definition "b has realization c =Def c realizes b"@en;
                 skos:example "As for realizes"@en.
pobo:BFO_0000055 dc11:identifier "059-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000015;
                 rdfs:label "realizes"@en;
                 rdfs:range pobo:BFO_0000017;
                 skos:definition "(Elucidation) realizes is a relation between a process b and realizable entity c such that c inheres in some d & for all t, if b has participant d then c exists & the type instantiated by b is correlated with the type instantiated by c"@en;
                 skos:example "A balding process realizes a disposition to go bald; a studying process realizes a student role; a process of pumping blood realizes the pumping function of a heart"@en.
pobo:BFO_0000056 dc11:identifier "250-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000020
                                           pobo:BFO_0000031
                                           [owl:intersectionOf (pobo:BFO_0000004
                                                               [a owl:Class ; 
                                                               owl:complementOf pobo:BFO_0000006]) ; 
                                           a owl:Class])];
                 rdfs:label "participates in"@en;
                 rdfs:range pobo:BFO_0000015;
                 owl:inverseOf pobo:BFO_0000057;
                 skos:definition "(Elucidation) participates in holds between some b that is either a specifically dependent continuant or generically dependent continuant or independent continuant that is not a spatial region & some process p such that b participates in p some way"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000057 dc11:identifier "248-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000015;
                 rdfs:label "has participant"@en;
                 rdfs:range [a owl:Class ; 
                             owl:unionOf (pobo:BFO_0000020
                                          pobo:BFO_0000031
                                          [owl:intersectionOf (pobo:BFO_0000004
                                                              [a owl:Class ; 
                                                              owl:complementOf pobo:BFO_0000006]) ; 
                                          a owl:Class])];
                 skos:definition "p has participant c =Def c participates in p"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000058 dc11:identifier "258-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000031;
                 rdfs:label "is concretized by"@en;
                 rdfs:range [a owl:Class ; 
                             owl:unionOf (pobo:BFO_0000015
                                          pobo:BFO_0000020)];
                 owl:inverseOf pobo:BFO_0000059;
                 skos:definition "c is concretized by b =Def b concretizes c"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000059 dc11:identifier "256-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000015
                                           pobo:BFO_0000020)];
                 rdfs:label "concretizes"@en;
                 rdfs:range pobo:BFO_0000031;
                 skos:definition "b concretizes c =Def b is a process or a specifically dependent continuant & c is a generically dependent continuant & there is some time t such that c is the pattern or content which b shares at t with actual or potential copies"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000062 dc11:identifier "213-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "preceded by"@en;
                 rdfs:range pobo:BFO_0000003;
                 owl:inverseOf pobo:BFO_0000063;
                 skos:definition "b preceded by c =Def b precedes c"@en;
                 skos:example "The temporal region occupied by the second half of the match is preceded by the temporal region occupied by the first half of the match"@en.
pobo:BFO_0000063 dc11:identifier "270-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "precedes"@en;
                 rdfs:range pobo:BFO_0000003;
                 skos:definition "(Elucidation) precedes is a relation between occurrents o, o' such that if t is the temporal extent of o & t' is the temporal extent of o' then either the last instant of o is before the first instant of o' or the last instant of o is the first instant of o' & neither o nor o' are temporal instants"@en;
                 skos:example "The temporal region occupied by Mary's birth precedes the temporal region occupied by Mary's death."@en;
                 skos:scopeNote "Each temporal region is its own temporal extent. The temporal extent of a spatiotemporal region is the temporal region it temporally projects onto. The temporal extent of a process or process boundary that occupies temporal region t is t.",
                                "Precedes defines a strict partial order on occurrents.".
pobo:BFO_0000066 dc11:identifier "143-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000015
                                           pobo:BFO_0000035)];
                 rdfs:label "occurs in"@en;
                 rdfs:range [a owl:Class ; 
                             owl:unionOf (pobo:BFO_0000029
                                          pobo:BFO_0000040)];
                 owl:inverseOf pobo:BFO_0000183;
                 skos:definition "b occurs in c =Def b is a process or a process boundary & c is a material entity or site & there exists a spatiotemporal region r & b occupies spatiotemporal region r & for all time t, if b exists at t then c exists at t & there exist spatial regions s and s' where b spatially projects onto s at t & c occupies spatial region s' at t & s is a continuant part of s' at t"@en;
                 skos:example "A process of digestion occurs in the interior of an organism; a process of loading artillery rounds into a tank cannon occurs in the interior of the tank"@en.
pobo:BFO_0000084 dc11:identifier "252-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000031;
                 rdfs:label "generically depends on"@en;
                 rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                 [a owl:Class ; 
                                                 owl:complementOf pobo:BFO_0000006]) ; 
                             a owl:Class];
                 owl:inverseOf pobo:BFO_0000101;
                 skos:altLabel "g-depends on"@en;
                 skos:definition "b generically depends on c =Def b is a generically dependent continuant & c is an independent continuant that is not a spatial region & at some time t there inheres in c a specifically dependent continuant which concretizes b at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000101 dc11:identifier "254-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:intersectionOf (pobo:BFO_0000004
                                                  [a owl:Class ; 
                                                  owl:complementOf pobo:BFO_0000006]) ; 
                              a owl:Class];
                 rdfs:label "is carrier of"@en;
                 rdfs:range pobo:BFO_0000031;
                 skos:definition "b is carrier of c =Def there is some time t such that c generically depends on b at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000108 dc11:identifier "118-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000001;
                 rdfs:label "exists at"@en;
                 rdfs:range pobo:BFO_0000008;
                 skos:definition "(Elucidation) exists at is a relation between a particular and some temporal region at which the particular exists"@en;
                 skos:example "First World War exists at 1914-1916; Mexico exists at January 1, 2000"@en.
pobo:BFO_0000115 dc11:identifier "230-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000040;
                 rdfs:label "has member part"@en;
                 rdfs:range pobo:BFO_0000040;
                 rdfs:subPropertyOf pobo:BFO_0000178;
                 owl:inverseOf pobo:BFO_0000129;
                 skos:definition "b has member part c =Def c member part of b"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000117 dc11:identifier "202-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "has occurrent part"@en;
                 rdfs:range pobo:BFO_0000003;
                 owl:inverseOf pobo:BFO_0000132;
                 skos:definition "b has occurrent part c =Def c occurrent part of b"@en;
                 skos:example "Mary's life has occurrent part Mary's 5th birthday"@en.
pobo:BFO_0000121 dc11:identifier "211-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "has temporal part"@en;
                 rdfs:range pobo:BFO_0000003;
                 rdfs:subPropertyOf pobo:BFO_0000117;
                 owl:inverseOf pobo:BFO_0000139;
                 skos:definition "b has temporal part c =Def c temporal part of b"@en;
                 skos:example "Your life has temporal part the first year of your life"@en.
pobo:BFO_0000124 dc11:identifier "236-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:intersectionOf (pobo:BFO_0000004
                                                  [a owl:Class ; 
                                                  owl:complementOf pobo:BFO_0000006]) ; 
                              a owl:Class];
                 rdfs:label "location of"@en;
                 rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                 [a owl:Class ; 
                                                 owl:complementOf pobo:BFO_0000006]) ; 
                             a owl:Class];
                 owl:inverseOf pobo:BFO_0000171;
                 skos:definition "b location of c =Def c located in b"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000127 dc11:identifier "244-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000040;
                 rdfs:label "material basis of"@en;
                 rdfs:range pobo:BFO_0000016;
                 owl:inverseOf pobo:BFO_0000218;
                 skos:definition "b material basis of c =Def c has material basis b"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000129 dc11:identifier "228-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000040;
                 rdfs:label "member part of"@en;
                 rdfs:range pobo:BFO_0000040;
                 rdfs:subPropertyOf pobo:BFO_0000176;
                 skos:definition "b member part of c =Def b is an object & c is a material entity & there is some time t such that b continuant part of c at t & there is a mutually exhaustive and pairwise disjoint partition of c into objects x1, ..., xn (for some n ≠ 1) with b = xi (for some 1 <= i <= n)"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000132 dc11:identifier "003-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "occurrent part of"@en;
                 rdfs:range pobo:BFO_0000003;
                 skos:definition "(Elucidation) occurrent part of is a relation between occurrents b and c when b is part of c"@en;
                 skos:example "Mary's 5th birthday is an occurrent part of Mary's life; the first set of the tennis match is an occurrent part of the tennis match"@en.
pobo:BFO_0000139 dc11:identifier "078-BFO";
                 a owl:ObjectProperty,
                   owl:TransitiveProperty;
                 rdfs:domain pobo:BFO_0000003;
                 rdfs:label "temporal part of"@en;
                 rdfs:range pobo:BFO_0000003;
                 rdfs:subPropertyOf pobo:BFO_0000132;
                 skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en;
                 skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en.
pobo:BFO_0000140 dc11:identifier "029-BFO";
                 a owl:Class;
                 rdfs:label "continuant fiat boundary"@en;
                 rdfs:subClassOf pobo:BFO_0000141,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000124 ; 
                                  owl:allValuesFrom pobo:BFO_0000140],
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom pobo:BFO_0000140];
                 skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en;
                 skos:example "As for fiat point, fiat line, fiat surface"@en.
pobo:BFO_0000141 dc11:identifier "028-BFO";
                 a owl:Class;
                 rdfs:label "immaterial entity"@en;
                 rdfs:subClassOf pobo:BFO_0000004;
                 skos:definition "b is an immaterial entity =Def b is an independent continuant which is such that there is no time t when it has a material entity as continuant part"@en;
                 skos:example "As for fiat point, fiat line, fiat surface, site"@en.
pobo:BFO_0000142 dc11:identifier "032-BFO";
                 a owl:Class;
                 rdfs:label "fiat line"@en;
                 rdfs:subClassOf pobo:BFO_0000140,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom [a owl:Class ; 
                                                     owl:unionOf (pobo:BFO_0000142
                                                                  pobo:BFO_0000147)]];
                 skos:definition "(Elucidation) A fiat line is a one-dimensional continuant fiat boundary that is continuous"@en;
                 skos:example "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of your tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin"@en.
pobo:BFO_0000144 a owl:Class;
                 rdfs:label "Process Profile"@en;
                 rdfs:subClassOf pobo:BFO_0000003;
                 skos:definition "An occurrent that is an occurrent part of some process by virtue of the rate, or pattern, or amplitude of change in an attribute of one or more participants of said process."@en;
                 skos:example "On a somewhat higher level of complexity are what we shall call rate process profiles, which are the targets of selective abstraction focused not on determinate quality magnitudes plotted over time, but rather on certain ratios between these magnitudes and elapsed times. A speed process profile, for example, is represented by a graph plotting against time the ratio of distance covered per unit of time. Since rates may change, and since such changes, too, may have rates of change, we have to deal here with a hierarchy of process profile universals at successive levels; One important sub-family of rate process profiles is illustrated by the beat or frequency profiles of cyclical processes, illustrated by the 60 beats per minute beating process of John’s heart, or the 120 beats per minute drumming process involved in one of John’s performances in a rock band, and so on. Each such process includes what we shall call a beat process profile instance as part, a subtype of rate process profile in which the salient ratio is not distance covered but rather number of beat cycles per unit of time. Each beat process profile instance instantiates the determinable universal beat process profile. But it also instantiates multiple more specialized universals at lower levels of generality, selected from rate process profilebeat process profileregular beat process profile3 bpm beat process profile4 bpm beat process profileirregular beat process profileincreasing beat process profileand so on.In the case of a regular beat process profile, a rate can be assigned in the simplest possible fashion by dividing the number of cycles by the length of the temporal region occupied by the beating process profile as a whole. Irregular process profiles of this sort, for example as identified in the clinic, or in the readings on an aircraft instrument panel, are often of diagnostic significance.; The simplest type of process profiles are what we shall call ‘quality process profiles’, which are the process profiles which serve as the foci of the sort of selective abstraction that is involved when measurements are made of changes in single qualities, as illustrated, for example, by process profiles of mass, temperature, aortic pressure, and so on."@en;
                 skos:scopeNote "b process_profile_of c holds when b proper_occurrent_part_of c& there is some proper_occurrent_part d of c which has no parts in common with b & is mutually dependent on b& is such that b, c and d occupy the same temporal region (axiom label in BFO2 Reference: [094-005])"@en;
                 comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
pobo:BFO_0000145 dc11:identifier "057-BFO";
                 a owl:Class;
                 rdfs:label "relational quality"@en;
                 rdfs:subClassOf pobo:BFO_0000019;
                 skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en;
                 skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en.
pobo:BFO_0000146 dc11:identifier "033-BFO";
                 a owl:Class;
                 rdfs:label "fiat surface"@en;
                 rdfs:subClassOf pobo:BFO_0000140,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom pobo:BFO_0000140];
                 skos:definition "(Elucidation) A fiat surface is a two-dimensional continuant fiat boundary that is self-connected"@en;
                 skos:example "The surface of the Earth; the plane separating the smoking from the non-smoking zone in a restaurant"@en.
pobo:BFO_0000147 dc11:identifier "031-BFO";
                 a owl:Class;
                 rdfs:label "fiat point"@en;
                 rdfs:subClassOf pobo:BFO_0000140,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000178 ; 
                                  owl:allValuesFrom pobo:BFO_0000147];
                 skos:definition "(Elucidation) A fiat point is a zero-dimensional continuant fiat boundary that consists of a single point"@en;
                 skos:example "The geographic North Pole; the quadripoint where the boundaries of Colorado, Utah, New Mexico and Arizona meet; the point of origin of some spatial coordinate system"@en.
pobo:BFO_0000148 dc11:identifier "102-BFO";
                 a owl:Class;
                 rdfs:label "zero-dimensional temporal region"@en;
                 rdfs:subClassOf pobo:BFO_0000008,
                                 [a owl:Restriction ; 
                                  owl:onProperty pobo:BFO_0000121 ; 
                                  owl:allValuesFrom pobo:BFO_0000148];
                 skos:definition "(Elucidation) A zero-dimensional temporal region is a temporal region that is a whole consisting of one or more separated temporal instants as parts"@en;
                 skos:example "A temporal region that is occupied by a process boundary; the moment at which a finger is detached in an industrial accident"@en.
pobo:BFO_0000153 dc11:identifier "080-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:domain pobo:BFO_0000011;
                 rdfs:label "temporally projects onto"@en;
                 rdfs:range pobo:BFO_0000008;
                 skos:definition "(Elucidation) temporally projects onto is a relation between a spatiotemporal region s and some temporal region which is the temporal extent of s"@en;
                 skos:example "The world line of a particle temporally projects onto the temporal region extending from the beginning to the end of the existence of the particle"@en.
pobo:BFO_0000171 dc11:identifier "234-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:intersectionOf (pobo:BFO_0000004
                                                  [a owl:Class ; 
                                                  owl:complementOf pobo:BFO_0000006]) ; 
                              a owl:Class];
                 rdfs:label "located in"@en;
                 rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                 [a owl:Class ; 
                                                 owl:complementOf pobo:BFO_0000006]) ; 
                             a owl:Class];
                 skos:definition "b located in c =Def b is an independent continuant & c is an independent & neither is a spatial region & there is some time t such that the spatial region which b occupies at t is continuant part of the spatial region which c occupies at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000176 dc11:identifier "221-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000002;
                 rdfs:label "continuant part of"@en;
                 rdfs:range pobo:BFO_0000002;
                 owl:inverseOf pobo:BFO_0000178;
                 skos:definition "b continuant part of c =Def b and c are continuants & there is some time t such that b and c exist at t & b continuant part of c at t"@en;
                 skos:example "Milk teeth continuant part of human; surgically removed tumour continuant part of organism"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000178 dc11:identifier "271-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000002;
                 rdfs:label "has continuant part"@en;
                 rdfs:range pobo:BFO_0000002;
                 skos:definition "b has continuant part c =Def c continuant part of b"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000182 dc11:identifier "138-BFO";
                 a owl:Class;
                 rdfs:label "history"@en;
                 rdfs:subClassOf pobo:BFO_0000015;
                 skos:definition "(Elucidation) A history is a process that is the sum of the totality of processes taking place in the spatiotemporal region occupied by the material part of a material entity"@en;
                 skos:example "The life of an organism from the beginning to the end of its existence"@en.
pobo:BFO_0000183 dc11:identifier "267-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000029
                                           pobo:BFO_0000040)];
                 rdfs:label "environs"@en;
                 rdfs:range [a owl:Class ; 
                             owl:unionOf (pobo:BFO_0000015
                                          pobo:BFO_0000035)];
                 skos:altLabel "contains process"@en;
                 skos:definition "b environs c =Def c occurs in b"@en;
                 skos:example "Mouth environs process of mastication; city environs traffic"@en.
pobo:BFO_0000184 dc11:identifier "144-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty,
                   owl:InverseFunctionalProperty;
                 rdfs:domain pobo:BFO_0000182;
                 rdfs:label "history of"@en;
                 rdfs:range pobo:BFO_0000040;
                 owl:inverseOf pobo:BFO_0000185;
                 skos:definition "(Elucidation) history of is a relation between history b and material entity c such that b is the unique history of c"@en;
                 skos:example "This life is the history of this organism"@en.
pobo:BFO_0000185 dc11:identifier "145-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000040;
                 rdfs:label "has history"@en;
                 rdfs:range pobo:BFO_0000182;
                 skos:definition "b has history c =Def c history of b"@en;
                 skos:example "This organism has history this life"@en.
pobo:BFO_0000194 dc11:identifier "260-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000020
                                           [owl:intersectionOf (pobo:BFO_0000004
                                                               [a owl:Class ; 
                                                               owl:complementOf pobo:BFO_0000006]) ; 
                                           a owl:Class])];
                 rdfs:label "specifically depended on by"@en;
                 rdfs:range pobo:BFO_0000020;
                 owl:inverseOf pobo:BFO_0000195;
                 skos:altLabel "s-depended on by"@en;
                 skos:definition "b specifically depended on by c =Def c specifically depends on b"@en;
                 skos:example "Coloured object specifically depended on by colour"@en.
pobo:BFO_0000195 dc11:identifier "012-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000020;
                 rdfs:label "specifically depends on"@en;
                 rdfs:range [a owl:Class ; 
                             owl:unionOf (pobo:BFO_0000020
                                          [owl:intersectionOf (pobo:BFO_0000004
                                                              [a owl:Class ; 
                                                              owl:complementOf pobo:BFO_0000006]) ; 
                                          a owl:Class])];
                 skos:altLabel "s-depends on"@en;
                 skos:definition "(Elucidation) specifically depends on is a relation between a specifically dependent continuant b and specifically dependent continuant or independent continuant that is not a spatial region c such that b and c share no parts in common & b is of a nature such that at all times t it cannot exist unless c exists & b is not a boundary of c"@en;
                 skos:example "A shape specifically depends on the shaped object; hue, saturation and brightness of a colour sample specifically depends on each other"@en;
                 skos:scopeNote "The analogue of specifically depends on for occurrents is has participant."@en.
pobo:BFO_0000196 dc11:identifier "053-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:intersectionOf (pobo:BFO_0000004
                                                  [a owl:Class ; 
                                                  owl:complementOf pobo:BFO_0000006]) ; 
                              a owl:Class];
                 rdfs:label "bearer of"@en;
                 rdfs:range pobo:BFO_0000020;
                 rdfs:subPropertyOf pobo:BFO_0000194;
                 owl:inverseOf pobo:BFO_0000197;
                 skos:definition "b bearer of c =Def c inheres in b"@en;
                 skos:example "A patch of ink is the bearer of a colour quality; an organism is the bearer of a temperature quality"@en.
pobo:BFO_0000197 dc11:identifier "051-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000020;
                 rdfs:label "inheres in"@en;
                 rdfs:range [owl:intersectionOf (pobo:BFO_0000004
                                                 [a owl:Class ; 
                                                 owl:complementOf pobo:BFO_0000006]) ; 
                             a owl:Class];
                 rdfs:subPropertyOf pobo:BFO_0000195;
                 skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en;
                 skos:example "A shape inheres in a shaped object; a mass inheres in a material entity"@en.
pobo:BFO_0000199 dc11:identifier "132-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000015
                                           pobo:BFO_0000035)];
                 rdfs:label "occupies temporal region"@en;
                 rdfs:range pobo:BFO_0000008;
                 owl:inverseOf comcore:ont00001874;
                 skos:definition "p occupies temporal region t =Def p is a process or process boundary & the spatiotemporal region occupied by p temporally projects onto t"@en;
                 skos:example "The Second World War occupies the temporal region September 1, 1939 - September 2, 1945"@en.
pobo:BFO_0000200 dc11:identifier "082-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf (pobo:BFO_0000015
                                           pobo:BFO_0000035)];
                 rdfs:label "occupies spatiotemporal region"@en;
                 rdfs:range pobo:BFO_0000011;
                 skos:definition "(Elucidation) occupies spatiotemporal region is a relation between a process or process boundary p and the spatiotemporal region s which is its spatiotemporal extent"@en;
                 skos:example "A particle emitted by a nuclear reactor occupies the spatiotemporal region which is its trajectory"@en.
pobo:BFO_0000202 dc11:identifier "155-BFO";
                 a owl:Class;
                 rdfs:label "temporal interval"@en;
                 rdfs:subClassOf pobo:BFO_0000038;
                 skos:definition "(Elucidation) A temporal interval is a one-dimensional temporal region that is continuous, thus without gaps or breaks"@en;
                 skos:example "The year 2018."@en;
                 skos:scopeNote "A one-dimensional temporal region can include as parts not only temporal intervals but also temporal instants separated from other parts by gaps."@en.
pobo:BFO_0000203 dc11:identifier "209-BFO";
                 a owl:Class;
                 rdfs:label "temporal instant"@en;
                 rdfs:subClassOf pobo:BFO_0000148;
                 skos:definition "(Elucidation) A temporal instant is a zero-dimensional temporal region that has no proper temporal part"@en;
                 skos:example "The millennium"@en.
pobo:BFO_0000210 dc11:identifier "232-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:intersectionOf (pobo:BFO_0000004
                                                  [a owl:Class ; 
                                                  owl:complementOf pobo:BFO_0000006]) ; 
                              a owl:Class];
                 rdfs:label "occupies spatial region"@en;
                 rdfs:range pobo:BFO_0000006;
                 skos:definition "b occupies spatial region r =Def b is an independent continuant that is not a spatial region & r is a spatial region & there is some time t such that every continuant part of b occupies some continuant part of r at t and no continuant part of b occupies any spatial region that is not a continuant part of r at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000216 dc11:identifier "246-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000011;
                 rdfs:label "spatially projects onto"@en;
                 rdfs:range pobo:BFO_0000006;
                 skos:definition "(Elucidation) spatially projects onto is a relation between some spatiotemporal region b and spatial region c such that at some time t, c is the spatial extent of b at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000218 dc11:identifier "242-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000016;
                 rdfs:label "has material basis"@en;
                 rdfs:range pobo:BFO_0000040;
                 skos:definition "b has material basis c =Def b is a disposition & c is a material entity & there is some d bearer of b & there is some time t such that c is a continuant part of d at t & d has disposition b because c is a continuant part of d at t"@en;
                 skos:scopeNote "Users that require more sophisticated representations of time are encouraged to import a temporal extension of BFO-Core provided by the BFO development team. See documentation for guidance: <https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/profiles/temporal%20extensions>"@en.
pobo:BFO_0000221 dc11:identifier "268-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000203;
                 rdfs:label "first instant of"@en;
                 rdfs:range pobo:BFO_0000008;
                 owl:inverseOf pobo:BFO_0000222;
                 skos:definition "t first instant of t' =Def t is a temporal instant & t' is a temporal region t' & t precedes all temporal parts of t' other than t"@en;
                 skos:example "An hour starting at midnight yesterday has first instant midnight yesterday"@en.
pobo:BFO_0000222 dc11:identifier "261-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:domain pobo:BFO_0000008;
                 rdfs:label "has first instant"@en;
                 rdfs:range pobo:BFO_0000203;
                 skos:definition "t has first instant t' =Def t' first instant of t"@en;
                 skos:example "The first hour of a year has first instant midnight on December 31"@en.
pobo:BFO_0000223 dc11:identifier "269-BFO";
                 a owl:ObjectProperty;
                 rdfs:domain pobo:BFO_0000203;
                 rdfs:label "last instant of"@en;
                 rdfs:range pobo:BFO_0000008;
                 owl:inverseOf pobo:BFO_0000224;
                 skos:definition "t last instant of t' =Def t is a temporal instant & t' is a temporal region & all temporal parts of t' other than t precede t"@en;
                 skos:example "Last midnight is the last instant of yesterday"@en.
pobo:BFO_0000224 dc11:identifier "215-BFO";
                 a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:domain pobo:BFO_0000008;
                 rdfs:label "has last instant"@en;
                 rdfs:range pobo:BFO_0000203;
                 skos:definition "t has last instant t' =Def t' last instant of t"@en;
                 skos:example "The last hour of a year has last instant midnight December 31"@en.
dc11:contributor a owl:AnnotationProperty.
dc11:identifier a owl:AnnotationProperty.
dc11:license a owl:AnnotationProperty.
dcterms:bibliographicCitation a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:rights a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
geosparql:asWKT a owl:DatatypeProperty;
                rdfs:label "as WKT"@en;
                skos:definition "A Data Property that has as its range a string formated according to the Well-known text standardization for geometric objects."@en;
                skos:example "Polygon ((10 10, 10 20, 20 20, 20 15, 10 10))";
                skos:scopeNote "ISO 19162:2015"@en;
                comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
rdfs:altLabel a owl:AnnotationProperty.
skos:altLabel a owl:AnnotationProperty.
skos:definition a owl:AnnotationProperty.
skos:editorialNote a owl:AnnotationProperty.
skos:example a owl:AnnotationProperty.
skos:prefLabel a owl:AnnotationProperty.
skos:scopeNote a owl:AnnotationProperty.
comcore:CommonCoreOntologiesMerged dcterms:license "BSD 3-Clause: https://github.com/CommonCoreOntology/CommonCoreOntologies/blob/master/LICENSE"@en;
                                   dcterms:rights "CUBRC Inc., see full license."@en;
                                   a owl:Ontology;
                                   rdfs:comment "A stand-alone file containing the eleven mid-level Common Core Ontologies plus BFO. Provided for use-cases where one file representing a specific release of CCO and its imports is desirable."@en;
                                   rdfs:label "Common Core Ontologies Merged"@en;
                                   owl:versionIRI <https://www.commoncoreontologies.org/2026-04-04/CommonCoreOntologiesMerged>;
                                   owl:versionInfo "Depends on http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl, obtained 2026-04-04."@en,
                                                   "Version 2.1"@en.
comcore:ont00000001 a owl:Class;
                    rdfs:label "Deflecting Prism"@en;
                    rdfs:subClassOf comcore:ont00000804;
                    skos:definition "A Prism designed to deflect a beam of light entering the Prism by a fixed angle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000002 a owl:Class;
                    rdfs:label "Cooling Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system decreases."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000003 a owl:Class;
                    rdfs:label "Designative Name"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    owl:disjointWith comcore:ont00000649;
                    skos:altLabel "Name"@en;
                    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified cultural or social namespace and which is typically a word or phrase in a natural language that has an accepted cultural or social significance."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000004 a owl:Class;
                    rdfs:label "Change"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000005 a owl:Class;
                    rdfs:label "Act"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    skos:definition "A Process in which at least one Agent plays a causative role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000006 a owl:Class;
                    rdfs:label "Upper Midrange Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 2 and 4 kHz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000007 a owl:Class;
                    rdfs:label "Natural Process"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    skos:definition "A Process existing in or produced by nature; rather than by the intent of human beings."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/natural+process";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000008 a owl:Class;
                    rdfs:label "Sound Frequency"@en;
                    rdfs:subClassOf comcore:ont00001047,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000675];
                    skos:definition "A Frequency that is the rate of Oscillations per second of a Sound Wave."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000009 a owl:Class;
                    rdfs:label "Mass Density"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:altLabel "Density"@en;
                    skos:definition "A Quality that inheres in a bearer in virtue of that bearer's mass per unit volume."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000010 a owl:Class;
                    rdfs:label "Incorporated Organization"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    skos:altLabel "Corporation"@en;
                    skos:definition "An Organization formed by an Act of Incorporation that consists of an association of individuals, created by law or under authority of law, having a continuous existence independent of the existences of its members and owners, and having powers and liabilities distinct from those of its members and owners."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/corporation";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000011 a owl:Class;
                    rdfs:label "Nominal Stasis"@en;
                    rdfs:subClassOf comcore:ont00000135;
                    skos:altLabel "Nominal"@en;
                    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en;
                    comcore:ont00001754 "https://en.oxforddictionaries.com/definition/nominal (Definition 6)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000012 a owl:Class;
                    rdfs:label "Propulsion Control System"@en;
                    rdfs:subClassOf comcore:ont00000781;
                    skos:definition "A Control System that consists of control devices, displays, indicators, or modules designed to control a Propulsion System."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000013 a owl:Class;
                    rdfs:label "Gain of Generically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000554,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000101 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000031]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Dependent Continuant wherein some Independent Continuant becomes the carrier of some Generically Dependent Continuant."@en;
                    skos:example "A Person forms a Plan, A Person is initiated into a Religion, A photgraphic image is produced.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000015 a owl:Class;
                    rdfs:label "Shotgun"@en;
                    rdfs:subClassOf comcore:ont00001104;
                    skos:definition "A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shotgun&oldid=1062571691"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000016 a owl:Class;
                    rdfs:label "Triangular Waveform"@en;
                    rdfs:subClassOf comcore:ont00001286;
                    skos:definition "A Waveform that is characterized by a triangular shape due to the continuous linear zig-zag transitions between minimum and maximum Amplitudes of the Wave Cycle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000017 a owl:Class;
                    rdfs:label "Minor Axis"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that is the longest line segment perpendicular to the Major Axis that connects two points on the edge of an Ellipse."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-major_and_semi-minor_axes&oldid=1047911304"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000018 a owl:Class;
                    rdfs:label "Title Document"@en;
                    rdfs:subClassOf comcore:ont00001346;
                    skos:definition "A Legal Instrument that is designed as evidence of ownership."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Title_(property)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000019 a owl:Class;
                    rdfs:label "Power Inverting Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000961;
                    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Material Artifact is used to convert direct current (DC) to alternating current (AC)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000020 a owl:Class;
                    rdfs:label "Container"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to contain (wholly or partially) some material entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000021 a owl:Class;
                    rdfs:label "Sensor Platform"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom [a owl:Class ; 
                                                                                 owl:unionOf (comcore:ont00000023
                                                                                              comcore:ont00002074)]]) ; 
                                         a owl:Class];
                    skos:definition "A Material Entity that bears a Sensor Platform Artifact Function or Sensor Platform Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000022 a owl:Class;
                    rdfs:label "Radio Communication Reception Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000422;
                    skos:definition "A Communication Reception Artifact Function that is realized during events in which a Material Artifact receives information transmitted from another Material Artifact, where the transmission of information occurs using radio waves."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000023 a owl:Class;
                    rdfs:label "Sensor Deployment Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to support or convey one or more Sensors while the Sensors are realizing their own Artifact Functions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000024 a owl:Class;
                    rdfs:label "Act of Advising"@en;
                    rdfs:subClassOf comcore:ont00000133;
                    skos:definition "An Act of Directive Communication performed by providing advice or counsel to another agent."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/advising";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000025 a owl:Class;
                    rdfs:label "Electronic Stock"@en;
                    rdfs:subClassOf comcore:ont00001278;
                    skos:definition "Stock that consists of Bytes."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000026 a owl:Class;
                    rdfs:label "Hair Color"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality inhering in a portion of Hair by virtue of its color."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000027 a owl:Class;
                    rdfs:label "Mailing"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Mailing"@en;
                    skos:definition "An Act of Communication by Media in which information and tangible objects, usually written documents, are delivered to destinations around the world."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000028 a owl:Class;
                    rdfs:label "Dispersive Prism"@en;
                    rdfs:subClassOf comcore:ont00000804;
                    skos:definition "A Prism designed to break up a beam of light entering the Prism into its constituent spectral colors by leveraging the refractive index of light based on its Frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000029 a owl:Class;
                    rdfs:label "Median Point Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000745;
                    skos:altLabel "Median"@en;
                    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to either the middle value or the average of the two values which separate the set into two equally populated upper and lower sets."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000030 a owl:Class;
                    rdfs:label "Nuclear Reactor"@en;
                    rdfs:subClassOf comcore:ont00000288;
                    skos:definition "A Power Source that is designed to initiate and control a self-sustained nuclear chain reaction to produce power in the form of heat, which can be transferred to a working fluid for further conversion to mechanical or electrical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_reactor&oldid=1063370273"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000031 a owl:Class;
                    rdfs:label "Atmospheric Feature"@en;
                    rdfs:subClassOf comcore:ont00001081;
                    skos:definition "A Geographic Feature that is part of the atmosphere (including the atmosphere itself as a non-proper part) having a relatively stable lifecycle and which has a location that can be distinguished from the surrounding portion of the atmosphere."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000032 a owl:Class;
                    rdfs:label "Church"@en;
                    rdfs:subClassOf comcore:ont00000052;
                    skos:definition "A Religious Facility that is designed for Christian worship and prayer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Church_(building)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000033 a owl:Class;
                    rdfs:label "Decrease of Role"@en;
                    rdfs:subClassOf comcore:ont00000854;
                    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Role that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000034 a owl:Class;
                    rdfs:label "Conveyance Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000448;
                    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function conveys entities from one location to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000035 a owl:Class;
                    rdfs:label "Soft X-ray Frequency"@en;
                    rdfs:subClassOf comcore:ont00000490;
                    skos:definition "An X-Ray Frequency that is between 30 petahertz and 3 exahertz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000036 a owl:Class;
                    rdfs:label "Waste Management Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of collecting, transporting, processing, recycling, monitoring, or disposing of waste materials."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000037 a owl:Class;
                    rdfs:label "Act of Observation"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of acquiring information from a source via the use of one or more senses."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Observation&oldid=1062502087"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000038 a owl:Class;
                    rdfs:label "System Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an entity in virtue of its parts or elements being arranged in such a way that they together exhibit behavior or meaning that they do not exhibit individually."@en;
                    comcore:ont00001754 "https://www.incose.org/about-systems-engineering/system-and-se-definition/general-system-definition"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000039 a owl:Class;
                    rdfs:label "Portion of Solid Fuel"@en;
                    rdfs:subClassOf comcore:ont00000838;
                    skos:definition "A Portion of Fuel that is stored in a solid state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000040 a owl:Class;
                    rdfs:label "Grocery Store"@en;
                    rdfs:subClassOf comcore:ont00001102;
                    skos:definition "A Commercial Facility that is designed to sell food."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grocery_store&oldid=1060022873"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000041 a owl:Class;
                    rdfs:label "Hostel"@en;
                    rdfs:subClassOf comcore:ont00000410;
                    skos:definition "A Residential Facility that is designed to temporarily lodge guests in a sociable environment for relatively low costs."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hostel&oldid=1057812930"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000042 a owl:Class;
                    rdfs:label "Semicircular"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape quality inhering in a bearer in virtue of the bearer having the shape of half a circle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000043 a owl:Class;
                    rdfs:label "Portion of Solid Propellant"@en;
                    rdfs:subClassOf comcore:ont00000593;
                    skos:definition "A Portion of Propellant that is stored in a solid state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000044 a owl:Class;
                    rdfs:label "Eye Color"@en;
                    rdfs:subClassOf pobo:BFO_0000019,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000197 ; 
                                     owl:someValuesFrom comcore:ont00000404];
                    skos:definition "A Quality inhering in an Eye by virtue of the color of the Eye's Iris."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000045 a owl:Class;
                    rdfs:label "Petroleum Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store petroleum, oil, or lubricants."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000046 a owl:Class;
                    rdfs:label "Province"@en;
                    rdfs:subClassOf comcore:ont00000126;
                    skos:definition "A First-Order Administrative Region that is part of a Country and delimits the authority of a magistrate who holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the Province."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Province&oldid=1062496131"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000047 a owl:Class;
                    rdfs:label "Flow Control Valve"@en;
                    rdfs:subClassOf comcore:ont00000598;
                    skos:definition "A Valve that is designed to regulate the flow or Pressure of a fluid."@en;
                    skos:scopeNote "Flow Control Valves are often more complex than a simple Valve and typically include an Actuator that is capable of automatically adjusting the state of the valve in response to signals from a connected Sensor or Controller."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flow_control_valve&oldid=1013438085"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000048 a owl:Class;
                    rdfs:label "Random Wire Antenna"@en;
                    rdfs:subClassOf comcore:ont00000499;
                    skos:definition "A Wire Antenna that consists of a long wire suspended above the ground with a length that does not bear a relation to the wavelength of the radio waves used and which is typically used as a receiving antenna on the long, medium, and short wave bands."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Random_wire_antenna&oldid=1058546356"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000049 a owl:Class;
                    rdfs:label "Banknote"@en;
                    rdfs:subClassOf comcore:ont00000475;
                    skos:definition "A Portion of Cash that consists of a portable slips of paper or fabric designed to bear some specified Financial Value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000050 a owl:Class;
                    rdfs:label "Very High Frequency Communication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Very High Frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000051 a owl:Class;
                    rdfs:label "Act of Construction"@en;
                    rdfs:subClassOf comcore:ont00000908;
                    skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are built on site as prescribed by some contract."@en;
                    skos:scopeNote "An Act of Construction typically involves the production of only one or a limited number of goods, such as in the construction of an airport or a community of condominiums."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000052 a owl:Class;
                    rdfs:label "Religious Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for worship and prayer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Religion&oldid=1063431202"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000053 a owl:Class;
                    rdfs:label "Ground Motor Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000618;
                    skos:definition "A Ground Vehicle that is designed to receive its motive power from an Engine and is not designed to travel on rails."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motor_vehicle&oldid=1063627395"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000054 a owl:Class;
                    rdfs:label "Stirling Engine"@en;
                    rdfs:subClassOf comcore:ont00000431;
                    skos:definition "An External Combusion Engine that is designed to compress and expand some working fluid at different temperatures, such that there is a net conversion of heat energy to mechanical work."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stirling_engine&oldid=1061164490"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000055 a owl:Class;
                    rdfs:label "Healthcare Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for the diagnosis, treatment, and prevention of disease."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Medicine&oldid=1062226814"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000056 a owl:Class;
                    rdfs:label "Reaction Engine"@en;
                    rdfs:subClassOf comcore:ont00000210;
                    skos:altLabel "Reaction Motor"@en;
                    skos:definition "An Engine that provides propulsion by expelling Reaction Mass."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reaction_engine&oldid=1046981784"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000057 a owl:Class;
                    rdfs:label "Mobile Telephone"@en;
                    rdfs:subClassOf comcore:ont00000907;
                    skos:definition "A Telephone that is connected to a Telephone Network by radio waves."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mobile_phone&oldid=1061800841"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000058 a owl:Class;
                    rdfs:label "Scalp Hair"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of a portion of hair that grows on the scalp of a human or other animal."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000059 a owl:Class;
                    rdfs:label "Telephone Line"@en;
                    rdfs:subClassOf comcore:ont00000825;
                    skos:altLabel "Telephone Circuit"@en;
                    skos:definition "A Telecommunication Network Line that consists of a physical wire or other signaling medium that is designed to be part of a Telephone Network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000060 a owl:Class;
                    rdfs:label "Open Pit Mine"@en;
                    rdfs:subClassOf comcore:ont00000639;
                    skos:definition "A Mine that is designed to support the extraction of materials from the ground directly without using tunnels."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Open-pit_mining&oldid=1059271938"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000061 a owl:Class;
                    rdfs:label "Measurement Unit of Flow"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which portions of a substance pass per unit of time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000062 a owl:Class;
                    rdfs:label "Frequency Measurement Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001100;
                    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Frequency of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000063 a owl:Class;
                    rdfs:label "Multi-Hour Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00001058];
                    skos:definition "A one-dimensional temporal region that is measured in Hours and spans at least one Hour."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000064 a owl:Class;
                    rdfs:label "Material Copy of a Book"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002040];
                    skos:altLabel "Book"@en;
                    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity by means of ink, paper, parchment, or other materials fastened together to hinge at one side."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Book&oldid=1063132471"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000065 a owl:Class;
                    rdfs:label "Act of Location Change"@en;
                    rdfs:subClassOf comcore:ont00000357;
                    skos:definition "An Act of Motion in which the location of some Object is changed by some Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000066 a owl:Class;
                    rdfs:label "Military Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes related to the armed services."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000067 a owl:Class;
                    rdfs:label "Civil Time Reference System"@en;
                    rdfs:subClassOf comcore:ont00001328;
                    skos:definition "A Temporal Reference System that is a statutory time scale as designated by civilian authorities to determine local time(s)."@en;
                    skos:scopeNote "In traditional astronomical usage, civil time is mean solar time as calculated from midnight as the beginning of the Civil Day."@en,
                                   "Note that Civil Time Reference System is more accurately represented as a Temporal Reference System that participates in an act of usage that is sanctioned by an appropriate civil authority. As such, it should be represented as a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000068 a owl:Class;
                    rdfs:label "Three-Dimensional Path"@en;
                    rdfs:subClassOf pobo:BFO_0000028,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001855 ; 
                                     owl:someValuesFrom comcore:ont00001348];
                    skos:definition "A Three-Dimensional Spatial Region that encompasses the spatial region through which some Object travels."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000069 a owl:Class;
                    rdfs:label "Material Copy of a Transcript"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002041];
                    skos:altLabel "Transcript"@en;
                    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity that was originally recorded in a different medium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transcript&oldid=1038510063"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000070 a owl:Class;
                    rdfs:label "Ground Track Point"@en;
                    rdfs:subClassOf pobo:BFO_0000018;
                    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point located on the surface of an Astronomical Body directly below an Object Track Point."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000071 a owl:Class;
                    rdfs:label "Town"@en;
                    rdfs:subClassOf comcore:ont00000460;
                    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a Village but smaller than that of a City; is designated as a town based on a particular administrative, legal, or historical status; and which delimits a local Government that typically exercises less power than that of a City Government."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/town";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000072 a owl:Class;
                    rdfs:label "Low Density Residential Area"@en;
                    rdfs:subClassOf comcore:ont00000224;
                    skos:definition "A Populated Place where houses are on lots of more than one acre."@en;
                    comcore:ont00001754 "Anderson et. al. A Land Use and Land Cover Classification System for use with Remote Sensor Data, Geological Survey Professional Paper 964";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000073 a owl:Class;
                    rdfs:label "Temporal Interval Identifier"@en;
                    rdfs:subClassOf comcore:ont00000399;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000399
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom pobo:BFO_0000038]) ; 
                                         a owl:Class];
                    skos:altLabel "One-Dimensional Temporal Region Identifier"@en;
                    skos:definition "A Temporal Region Identifier that designates some Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000074 a owl:Class;
                    rdfs:label "Measurement Unit of Acceleration"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate at which objects change their velocities per unit of time."@en;
                    skos:example "feet per second per second, kilometers per second per second";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000075 a owl:Class;
                    rdfs:label "Optical Microscope"@en;
                    rdfs:subClassOf comcore:ont00000304;
                    skos:altLabel "Light Microscope"@en;
                    skos:definition "A Microscope that is designed to use visible light and a system of Optical Lenses to produce a significantly enlarged image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_microscope&oldid=1063131242"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000076 a owl:Class;
                    rdfs:label "Wired Communication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000727;
                    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of a (usually cylindrical) flexible strand or rod of metal."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000077 a owl:Class;
                    rdfs:label "Code Identifier"@en;
                    rdfs:subClassOf comcore:ont00000649;
                    owl:disjointWith comcore:ont00000923;
                    skos:altLabel "Code ID"@en,
                                  "ID Code"@en,
                                  "Identifier Code"@en;
                    skos:definition "A Non-Name Identifier that consists of a string of characters that was created and assigned according to an encoding system such that metadata can be derived from the identifier."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000078 a owl:Class;
                    rdfs:label "Act of Estimation"@en;
                    rdfs:subClassOf comcore:ont00000345;
                    skos:altLabel "Act of Approximation"@en;
                    skos:definition "An Act of Measuring that involves the comparison of a measurement of a similar Entity or of a portion of the Entity being estimated to produce an approximated measurement of the target Entity."@en;
                    skos:example "measuring how much time a train will add to your commute by measuring how long it takes for 10 train cars to pass a given point and then combining this information with an estimate of how many train cars are in a typical train based on your past experience",
                                 "measuring the amount of time required to do a task based on how long it took to do a similar task in the past",
                                 "measuring the height of a building by counting the number of floors and multiplying it by the height of an average floor in an average building",
                                 "measuring the property value of a house based on its square footage and the average cost per square foot of other houses in the area";
                    skos:scopeNote "Although the boundary between Act of Estimation and guessing is vague, estimation can be partially distinguished from guessing in that every Act of Estimation has as input some relevant information; whereas an act of guessing can occur sans information (or at least sans pertinent information). For example, if Mr. Green were asked how many blades of grass are in his lawn, he could simply choose a number (i.e. he could guess) or he could estimate the number by counting how many baldes of grass are in 1 square foot of his lawn, measuring the square footage of his lawn, and then multiplying these values to arrive at a number. Hence, many estimates may be loosely considered to be educated guesses."@en,
                                   "In all cases, the Agent in an Act of Estimation either lacks complete information, lacks access to the relevant information, or chooses not to use the complete information (perhaps to save money or time) about the thing being estimated; instead, the Agent uses some or all of the relevant information that the Agent does have as a basis for arriving at the estimate."@en,
                                   "Note that, while every Act of Measuring arguably involves some degree of estimation (for example, a measuring instrument rounding to the nearest ten-thousandth or an Agent reading an analog display), it would be a mistake to classify all Acts of Measuring as Acts of Estimation. This holds even for cases (e.g. census taking) in which sofisticated estimations are often more accurate than other means of measuring (e.g. enumeration)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000079 a owl:Class;
                    rdfs:label "Act of Social Movement"@en;
                    rdfs:subClassOf comcore:ont00001327;
                    skos:definition "A Social Act composed of a series of performances, displays and campaigns directed at implementing, resisting or undoing a change in society."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Social_movement&oldid=1062720561"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000080 a owl:Class;
                    rdfs:label "Standard Time of Day Identifier"@en;
                    rdfs:subClassOf comcore:ont00000827;
                    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using the Hours, Minutes, and Seconds of the Day that preceded the Temporal Instant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000081 a owl:Class;
                    rdfs:label "Cutting Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of separating some portion of its target into two or more portions through the application of acutely directed force."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cutting&oldid=1058846915"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000082 a owl:Class;
                    rdfs:label "Green"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is between Yellow and Cyan with a wavelength in the visible spectrum, typically between 520 to 560 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000083 a owl:Class;
                    rdfs:label "Process Ending"@en;
                    rdfs:subClassOf pobo:BFO_0000035;
                    skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the ending instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000084 a owl:Class;
                    rdfs:label "Bodily Component"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A Fiat Object Part located within or on the surface of an Agent."@en;
                    skos:example "Bodily Components include anatomical structures, body flora, pathogens, toxins, and their combinations.";
                    comcore:ont00001754 "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3017014/";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000085 a owl:Class;
                    rdfs:label "Minute"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00001058];
                    skos:definition "A Temporal Interval that is equal to sixty consecutive Seconds."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=minute";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000086 a owl:Class;
                    rdfs:label "Autopilot System"@en;
                    rdfs:subClassOf comcore:ont00000723;
                    skos:altLabel "Autopilot"@en;
                    skos:definition "A Vehicle Control System that is designed to enable some Agent to control the trajectory of a Vehicle without constant 'hands-on' control."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Autopilot&oldid=1063382206"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000087 a owl:Class;
                    rdfs:label "Ordinal Date Identifier"@en;
                    rdfs:subClassOf comcore:ont00000894;
                    skos:altLabel "Ordinal Date"@en;
                    skos:definition "A Decimal Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since the beginning of the Year."@en;
                    skos:scopeNote "An Ordinal Date Identifier may or may not also contain a number indicating a specific Year. If both numbers are included, the ISO 8601 ordinal date format stipulates that the two numbers be formatted as YYYY-DDD or YYYYDDD where [YYYY] indicates a year and [DDD] is the day of that year, from 001 through 365 (or 366 in leap years)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ordinal_date&oldid=1061989434"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000088 a owl:Class;
                    rdfs:label "Firearm"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to launch Bullets or Cartridges."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Firearm&oldid=1061216363"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000089 a owl:Class;
                    rdfs:label "Skill"@en;
                    rdfs:subClassOf comcore:ont00001379;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001379
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001889 ; 
                                                             owl:someValuesFrom comcore:ont00001262]) ; 
                                         a owl:Class];
                    skos:definition "An Agent Capability that inheres in a Person to the extent of that Person's capacity to realize it in Intentional Acts of a certain type."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000090 a owl:Class;
                    rdfs:label "Infrared Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing infrared light to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared_telescope&oldid=1062918090"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000091 a owl:Class;
                    rdfs:label "Portion of Coolant"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:definition "A Portion of Material that is designed to be used in a thermal control system to reduce or maintain the temperature of an object to or at a specified level."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000092 a owl:Class;
                    rdfs:label "Bidirectional Transducer"@en;
                    rdfs:subClassOf comcore:ont00000736;
                    skos:definition "A Transducer that is designed to receive a signal in the form of physical phenomena and convert it into an electrical signal, and vice versa."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transducer&oldid=1053290948"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000093 a owl:Class;
                    rdfs:label "Preferred Stock"@en;
                    rdfs:subClassOf comcore:ont00001278;
                    skos:definition "Stock that entitles its holder to receive a certain level of dividend payments before any dividends can be issued to other holders."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000094 a owl:Class;
                    rdfs:label "Seat of National Government"@en;
                    rdfs:subClassOf comcore:ont00000946;
                    skos:definition "A Government Building that is designed for the administration of a sovereign nation."@en;
                    skos:example "Parliament of Canada",
                                 "United States Capitol";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Seat_of_government&oldid=1063047501"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000095 a owl:Class;
                    rdfs:label "Control Surface"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to deflect air, water, or another medium around its surface in order to change the Attitude of a Vehicle by rotating the Vehicle on one or more of its Axes of Rotation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flight_control_surfaces&oldid=1019271264"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000096 a owl:Class;
                    rdfs:label "Propulsion System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another and which consists of a source of mechanical power and a means of converting this power into propulsive force to generate the movement."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propulsion&oldid=1022034059"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000097 a owl:Class;
                    rdfs:label "Complex Optical Lens"@en;
                    rdfs:subClassOf comcore:ont00001207;
                    skos:altLabel "Lens System"@en;
                    skos:definition "An Optical Lens consisting of more than one Simple Optical Lenses."@en;
                    comcore:ont00001754 "Hecht, Eugene (1987). Optics (2nd ed.). Addison Wesley. ISBN 978-0-201-11609-0. Chapters 5 & 6."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000098 a owl:Class;
                    rdfs:label "Electrical Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform a process involving electrical power."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000099 a owl:Class;
                    rdfs:label "Wave Process"@en;
                    rdfs:subClassOf comcore:ont00000007,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000062 ; 
                                     owl:someValuesFrom comcore:ont00000765],
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000752];
                    skos:definition "A Natural Process that involves Oscillation accompanied by a transfer of energy that travels through a portion of matter or spatial region."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wave&oldid=1062648180"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000100 a owl:Class;
                    rdfs:label "Stasis of Partially Mission Capable"@en;
                    rdfs:subClassOf comcore:ont00001132;
                    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000101 a owl:Class;
                    rdfs:label "Portion of Liquid Oxygen"@en;
                    rdfs:subClassOf comcore:ont00000255;
                    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid oxygen."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000102 a owl:Class;
                    rdfs:label "Skin Type"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality inhering in a portion of skin by virtue of its color and natural tendency to respond to ultraviolet light."@en;
                    skos:scopeNote "Skin Type is classified according to a reference system such as the Fitzpatrick scale: https://en.wikipedia.org/wiki/Fitzpatrick_scale"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000103 a owl:Class;
                    rdfs:label "Vehicle Compartment"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:altLabel "Compartment"@en;
                    skos:definition "A Material Artifact that is designed to partition a Vehicle into subdivisions for various purposes."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000104 a owl:Class;
                    rdfs:label "Underwater Mine"@en;
                    rdfs:subClassOf comcore:ont00000639;
                    skos:definition "A Mine that is designed to support the extraction of materials from the ocean floor."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Naval_mine&oldid=1062538523"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000105 a owl:Class;
                    rdfs:label "Square"@en;
                    rdfs:subClassOf comcore:ont00001369;
                    skos:definition "A Rectangular shape which has four equal length sides and four 90 degree angles."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000106 a owl:Class;
                    rdfs:label "End of Life Stasis"@en;
                    rdfs:subClassOf comcore:ont00001213;
                    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when the participating Material Artifact is no longer capable of realizing all of its designed primary Artifact Functions."@en;
                    skos:scopeNote "An End of Life Stasis (EoL) is distinguished from a Stasis of Partially Mission Capable or Stasis of Non-Mission Capable in that EoL is more inclusive such that the participating Material Artifact may be either Partially or Non-Mission Capable. Additionally, EoL applies only to Artifacts and is typically determined in relation to its original mission and designed primary functions. In contrast, an Artifact's level of Mission Capability depends on the requirements of the mission under consideration such that a given Artifact may simultaneously be Fully Mission Capable for mission1, Partially Mission Capable for mission2, and Non-Mission Capable for mission3."@en;
                    comcore:ont00001753 "EOL",
                                        "EoL";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000107 a owl:Class;
                    rdfs:label "Increase of Generically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00001048;
                    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Generically Dependent Continuant that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000108 a owl:Class;
                    rdfs:label "Rail Facility"@en;
                    rdfs:subClassOf comcore:ont00000226;
                    skos:definition "A Transportation Facility that is designed for transferring people or cargo to and from Trains."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Train_station&oldid=1063922802"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000109 a owl:Class;
                    rdfs:label "Act of Military Force"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of employing a Military Force to achieve some desired result."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000110 a owl:Class;
                    rdfs:label "Mechanical Process"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    skos:definition "A Process that is the realization of some Disposition of a Material Artifact"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000111 a owl:Class;
                    rdfs:label "Air Inlet"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:altLabel "Air Intake"@en;
                    skos:definition "A Fluid Control Artifact that consists of an opening that is designed to capture and direct the flow of air into the system it is part of."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000112 a owl:Class;
                    rdfs:label "Translucent"@en;
                    rdfs:subClassOf comcore:ont00001384;
                    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit some but not all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs some but not all electromagnetic radiation of that frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000113 a owl:Class;
                    rdfs:label "Ventilation Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the quality of air in some space."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000114 a owl:Class;
                    rdfs:label "Unix Temporal Instant"@en;
                    rdfs:subClassOf pobo:BFO_0000203;
                    skos:definition "A Temporal Instant as specified by the number of Seconds that have elapsed since the specified Epoch Time as described by an implementation of Unix Time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000115 a owl:Class;
                    rdfs:label "Stasis of Disposition"@en;
                    rdfs:subClassOf comcore:ont00000246;
                    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Disposition that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000116 a owl:Class;
                    rdfs:label "Pump"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that is designed to impart motion to a portion of fluid to transport it within a system through the use of mechanical action."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000117 a owl:Class;
                    rdfs:label "Information Processing Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to use algorithms to transform some Information Content Entity into another Information Content Entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000118 a owl:Class;
                    rdfs:label "Artifact Function Specification"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000965
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000176 ; 
                                                             owl:someValuesFrom comcore:ont00001045]
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001942 ; 
                                                             owl:someValuesFrom comcore:ont00000323]) ; 
                                         a owl:Class];
                    skos:definition "A Prescriptive Information Content Entity that prescribes some Material Artifact Function and which is part of some Material Artifact Model."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000119 a owl:Class;
                    rdfs:label "Spatial Orientation"@en;
                    rdfs:subClassOf pobo:BFO_0000145;
                    skos:altLabel "Attitude"@en;
                    skos:definition "A Relational Quality that is the angle of Rotation of an Object relative to one or more Plane of Reference or Axis of Rotation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Orientation_(geometry)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000120 a owl:Class;
                    rdfs:label "Measurement Unit"@en;
                    rdfs:subClassOf comcore:ont00000853;
                    skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Unit_of_measurement&oldid=1061038125"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000121 a owl:Class;
                    rdfs:label "Act of Conducting Mass Media Interview"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving a conversation between a reporter and a person of public interest, used as a basis of a broadcast or publication."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000122 a owl:Class;
                    rdfs:label "Vehicle Track Point"@en;
                    rdfs:subClassOf comcore:ont00000170,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001944 ; 
                                     owl:someValuesFrom comcore:ont00000904];
                    skos:definition "An Object Track Point that is where a Vehicle is or was located during some motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000123 a owl:Class;
                    rdfs:label "Act of Expressive Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication in which an Agent expresses their attitudes or emotions towards some entity."@en;
                    skos:scopeNote "Examples: apologizing, condoling, congratulating, greeting, thanking, accepting (acknowledging an acknowledgment)"@en;
                    comcore:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000124 a owl:Class;
                    rdfs:label "Solar Time Reference System"@en;
                    rdfs:subClassOf comcore:ont00001328;
                    skos:definition "A Temporal Reference System that is based on the position of the Sun in the sky."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000125 a owl:Class;
                    rdfs:label "Bounding Box Point"@en;
                    rdfs:subClassOf comcore:ont00000373;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000373
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000176 ; 
                                                             owl:someValuesFrom comcore:ont00000358]) ; 
                                         a owl:Class];
                    skos:definition "A Geospatial Position that is a proper part of some Geospatial Region Bounding Box."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000126 a owl:Class;
                    rdfs:label "First-Order Administrative Region"@en;
                    rdfs:subClassOf comcore:ont00001152,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000139];
                    skos:definition "A Government Domain that is a primary administrative division of a Country."@en;
                    skos:example "a state in the United States";
                    comcore:ont00001754 "http://www.geonames.org/export/codes.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000127 a owl:Class;
                    rdfs:label "Performance Specification"@en;
                    rdfs:subClassOf comcore:ont00000965,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001980 ; 
                                     owl:someValuesFrom pobo:BFO_0000001];
                    skos:definition "A Prescriptive Information Content Entity that prescribes some aspect of the behavior of a participant in a Process given one or more operating conditions."@en;
                    skos:example "Maximum Speed at high altitude; Rate of Ascent at 10 degrees celsius with nominal payload.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000128 a owl:Class;
                    rdfs:label "Portion of Liquid Hydrogen"@en;
                    rdfs:subClassOf comcore:ont00000255;
                    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid hydrogen."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000129 a owl:Class;
                    rdfs:label "Tattoo"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of a typically permanent mark or design on a portion of skin that is created by a process of pricking and ingraining an indelible pigment or by raising scars."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/tattoo";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000130 a owl:Class;
                    rdfs:label "Power Transformer"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to transfer electrical energy between two or more circuits through electromagnetic induction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transformer&oldid=1062163369"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000131 a owl:Class;
                    rdfs:label "Increase of Quality"@en;
                    rdfs:subClassOf comcore:ont00001214;
                    skos:definition "An Increase of Specifically Dependent Continuant in which some Indpendent Continuant has an increase of some Quality that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000132 a owl:Class;
                    rdfs:label "Recording Device"@en;
                    rdfs:subClassOf comcore:ont00000117;
                    skos:definition "An Information Processing Artifact that is designed to capture some information and store it in some recording format on some storage medium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Record&oldid=1062776450"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000133 a owl:Class;
                    rdfs:label "Act of Directive Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication that is intended to cause the hearer to take a particular action."@en;
                    skos:scopeNote "Examples: advising, admonishing, asking, begging, dismissing, excusing, forbidding, instructing, ordering, permitting, requesting, requiring, suggesting, urging, warning"@en;
                    comcore:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000134 a owl:Class;
                    rdfs:label "Third-Order Administrative Region"@en;
                    rdfs:subClassOf comcore:ont00001152,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000405];
                    skos:definition "A Government Domain that is a subdivision of a Second-Order Administrative Region."@en;
                    comcore:ont00001754 "http://www.geonames.org/export/codes.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000135 a owl:Class;
                    rdfs:label "Stasis of Specifically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000819;
                    skos:definition "A Stasis in which some Independent Continuant bears some Specifically Dependent Continuant that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000136 a owl:Class;
                    rdfs:label "Optical Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to process light waves."@en;
                    skos:scopeNote "Light waves can be processed in a variety of ways including via reflection, refraction, diffraction, deflection, focusing, collimation, dispersion, and interference."@en,
                                   "Optical Instruments are typically constructed for the purpose of being used to aid in vision or the analysis of light."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_instrument&oldid=1061981216"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000137 a owl:Class;
                    rdfs:label "Act of Financial Deposit"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Depositor) to another Agent to create a liability to be repaid to the Depositor through an Act of Financial Withdrawal."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000138 a owl:Class;
                    rdfs:label "Maximum Power"@en;
                    rdfs:subClassOf comcore:ont00000503;
                    skos:definition "A Power that is characterized by the maximum rate of Work, or Energy consumed, done in a given time period."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000139 dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023.";
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Domain of a Country"@en;
                    rdfs:subClassOf comcore:ont00001152;
                    skos:definition "A Government Domain that is associated with certain distinct political, ethnic, or cultural characteristics, and which delimits a Government that has legitimate authority over a Populace."@en;
                    skos:editorialNote "'Country' is an unclear term. Does it refer to the people, the government, the site, or the material in the site? Furthermore, what is properly referred to as a 'Country' is highly dependent on the classification practices of the international community. For example: The United Kingdom is a sovereign country that has Wales, a non-sovereign Country, as a member. Vatican City is a sovereign country that is landlocked by a city: Rome, Italy. Puerto Rico is not a country (it's a territory) but has a government, a distinct culture, and so on. Thus, here we do not define 'Country' but instead define 'Domain of a Country'."@en;
                    skos:prefLabel "Domain of a Country"@en;
                    comcore:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000140 a owl:Class;
                    rdfs:label "Measurement Unit of Amount of Substance"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:altLabel "Measurement Unit of Chemical Amount"@en,
                                  "Measurement Unit of Enplethy"@en;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of a specified type of particle in a portion of matter."@en;
                    skos:example "mole, pound-mole";
                    skos:scopeNote "The type of particle quantified is typically either atoms or molecules, but may also be protons, neutrons, electrons, quarks, or other particles. The type of particle being measured should always be specified along with the measurement and its unit."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology".
comcore:ont00000141 a owl:Class;
                    rdfs:label "Populace"@en;
                    rdfs:subClassOf comcore:ont00000914;
                    skos:definition "A Group of Persons forming the total population of some Government Domain."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Population&oldid=1059148871"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000142 a owl:Class;
                    rdfs:label "Act of Government"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act that is initiated or supported by some Geopolitical Entity and enforced by some Government Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000143 a owl:Class;
                    rdfs:label "Cargo Cabin"@en;
                    rdfs:subClassOf comcore:ont00000103;
                    skos:definition "A Vehicle Compartment that is used to store goods or materials during transportation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000144 a owl:Class;
                    rdfs:label "Act of Meeting"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association wherein two or more Persons assemble for some common purpose."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=meet (Sense Key: meet%2:41:00, get together%2:41:00)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000145 a owl:Class;
                    rdfs:label "Incendiary Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of starting a fire."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Incendiary_device&oldid=1055642422"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000146 a owl:Class;
                    rdfs:label "Artificial Language"@en;
                    rdfs:subClassOf comcore:ont00001175;
                    owl:disjointWith comcore:ont00000496;
                    skos:definition "A Language that is developed through conscious planning and premeditation, rather than one that was developed through use and repetition."@en;
                    skos:example "Esperanto",
                                 "Python Programming Language";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Constructed_language&oldid=1062733589"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000147 a owl:Class;
                    rdfs:label "Flight Transponder"@en;
                    rdfs:subClassOf comcore:ont00000325;
                    skos:definition "A Radio Transponder that is designed to produce a specified response (typically for identification, location, or status update purposes) when it receives a radio-frequency interrogation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transponder_(aeronautics)&oldid=1052688836"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000148 a owl:Class;
                    rdfs:label "Clockwise Rotational Motion"@en;
                    rdfs:subClassOf comcore:ont00000368;
                    skos:altLabel "CW Rotational Motion"@en,
                                  "Clockwise Rotation"@en;
                    skos:definition "A Rotational Motion in which the direction of rotation is toward the right as seen relative to the designated side of the plane of rotation."@en;
                    skos:example "the axial rotation of the Earth as seen from above the South Pole";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000149 a owl:Class;
                    rdfs:label "Instant Messaging"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of IMing"@en,
                                  "Act of Instant Messaging"@en;
                    skos:definition "An Act of Communication by Media in which real-time direct text-based communication occurs between two or more people using personal computers or other devices, along with shared Instant Messaging Client Software conveyed over a network, such as the Internet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Instant_messaging&oldid=1062873579"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000150 a owl:Class;
                    rdfs:label "Radio Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 3 kHz and 300 GHz."@en;
                    comcore:ont00001753 "RF";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_wave&oldid=1062110903"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000151 a owl:Class;
                    rdfs:label "Act of Reporting"@en;
                    rdfs:subClassOf comcore:ont00000379;
                    skos:definition "An Act of Representative Communication performed by giving a detailed account or statement."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/report";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000152 a owl:Class;
                    rdfs:label "Telephone Network"@en;
                    rdfs:subClassOf comcore:ont00000998;
                    skos:definition "A Telecommunication Network that is designed to allow telephone calls to be made between two or more parties connected to the network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000153 a owl:Class;
                    rdfs:label "Generator Control Unit"@en;
                    rdfs:subClassOf comcore:ont00000781;
                    skos:definition "A Control System that is designed to regulate the voltage of some Electrical Power Source."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000154 a owl:Class;
                    rdfs:label "Mode Point Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000745;
                    skos:altLabel "Mode"@en,
                                  "Statistical Mode"@en;
                    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the value or values that occur most often in the set."@en;
                    skos:scopeNote "While there is always at least one Mode for every set of data, it is possible for any given set of data to have multiple Modes. The Mode is typically most useful when the members of the set are all Nominal Measurement Information Content Entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000155 a owl:Class;
                    rdfs:label "Near Infrared Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00001337;
                    skos:definition "An Infrared Light Frequency that is between 214 and 400 terahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000156 a owl:Class;
                    rdfs:label "Hand Gun"@en;
                    rdfs:subClassOf comcore:ont00000088;
                    skos:definition "A Firearm that is designed to have a relatively short barrel and to be held in one or two hands and to be fired without being braced against the shoulder."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Handgun&oldid=1060570395"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000157 a owl:Class;
                    rdfs:label "Facial Hair"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of a portion of hair that grows on the face of a human (typically male) or other animal."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000158 a owl:Class;
                    rdfs:label "Lithium-ion Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001105;
                    skos:definition "A Secondary Cell Electric Battery that produces electricity when lithium ions move from anode to cathode."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lithium-ion_battery&oldid=1064099588"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000159 a owl:Class;
                    rdfs:label "Material Copy of a Timekeeping Instrument"@en;
                    rdfs:subClassOf comcore:ont00000798;
                    skos:altLabel "Timekeeping Instrument"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity that is about some temporal region."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Timekeeper&oldid=1061681902"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000160 a owl:Class;
                    rdfs:label "Manual Tool"@en;
                    rdfs:subClassOf comcore:ont00000581;
                    skos:altLabel "Hand Tool"@en;
                    skos:definition "A Tool that is designed to be powered by manual labor rather than by an engine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hand_tool&oldid=1060741381"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000161 a owl:Class;
                    rdfs:label "Coordinate System Axis"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region defined by a Coordinate System for the purpose of identifying the position of entities along one dimension of the Coordinate System's spatial framework."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000162 a owl:Class;
                    rdfs:label "Electrical Connector Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000795;
                    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used to join electrical terminations to create an electrical circuit."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000163 a owl:Class;
                    rdfs:label "z-Axis"@en;
                    rdfs:subClassOf comcore:ont00000161;
                    skos:definition "A Coordinate System Axis designated by the variable 'z'."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000164 a owl:Class;
                    rdfs:label "Minimum Ordinal Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001010;
                    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the smallest or having the least amount relative to a nominally described set of like entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000165 a owl:Class;
                    rdfs:label "Criminal Act"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act committed in violation of rules or laws for which some governing authority (via mechanisms such as legal systems) can prescribe a conviction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Crime&oldid=1062237249"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000166 a owl:Class;
                    rdfs:label "Wave Cycle"@en;
                    rdfs:subClassOf comcore:ont00000099;
                    skos:definition "A Wave Process that consists of a portion of a Wave Process that begins at an arbitrary point of the Wave Process and ends at the next point when the pattern of the Wave Process begins to repeat."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000167 a owl:Class;
                    rdfs:label "Large-Scale Rocket Launcher"@en;
                    rdfs:subClassOf comcore:ont00001173;
                    skos:definition "A Rocket Launcher that is designed to contain multiple Rocket Launchers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000168 a owl:Class;
                    rdfs:label "Act of Interpersonal Relationship"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association between two or more Persons that may range from fleeting to enduring."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Interpersonal_relationship&oldid=1060991304"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000169 a owl:Class;
                    rdfs:label "Very High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 8"@en;
                    skos:definition "A Radio Frequency that is between 30 and 300 MHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 10–1 m"@en;
                    comcore:ont00001753 "VHF";
                    comcore:ont00001754 "International Telecommunication Union (ITU) and IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000170 a owl:Class;
                    rdfs:label "Object Track Point"@en;
                    rdfs:subClassOf pobo:BFO_0000018,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001944 ; 
                                     owl:someValuesFrom comcore:ont00000205];
                    skos:definition "A Zero-Dimensional Spatial Region that is an idealized point where an Object is or was located during some motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000171 a owl:Class;
                    rdfs:label "Detergent Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000344;
                    skos:definition "A Surfactant Artifact Function that is realized in a process that cleans substances in dilute solutions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detergent&oldid=1064079329"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000172 a owl:Class;
                    rdfs:label "Base of Operations"@en;
                    rdfs:subClassOf comcore:ont00000483;
                    skos:altLabel "Main Operating Base"@en;
                    skos:definition "A Military Base with permanently stationed operating forces, robust Infrastructure, and strengthened force protection measures such that it is designed to launch and support large-scale operations, support smaller or less-permanent bases, and organize supply facilities."@en;
                    comcore:ont00001753 "MOB";
                    comcore:ont00001754 "http://www.jcs.mil/Portals/36/Documents/Doctrine/pubs/dictionary.pdf?ver=2018-08-27-122235-653";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000173 a owl:Class;
                    rdfs:label "Civilian Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents not being part of either an Armed Force or police force."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000174 a owl:Class;
                    rdfs:label "Ultraviolet Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:altLabel "UV Telescope"@en;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing ultraviolet light to form an enhanced image of the Object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000175 a owl:Class;
                    rdfs:label "Organization Member Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill as a member of some Organization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000176 dcterms:bibliographicCitation "Lee, David S., and Brad Glosserman. “How Companies Can Navigate Today’s Geopolitical Risks.” Harvard Business Review, 28 Nov. 2022. hbr.org, https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks.",
                                                  "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023.";
                    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Geopolitical Organization"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001180
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000898]) ; 
                                         a owl:Class];
                    skos:definition "An Organization that bears a Geopolitical Power Role."@en;
                    skos:prefLabel "Geopolitical Organization"@en;
                    comcore:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power",
                                        "https://hbr.org/2022/11/how-companies-can-navigate-todays-geopolitical-risks";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000177 a owl:Class;
                    rdfs:label "Affordance"@en;
                    rdfs:subClassOf pobo:BFO_0000017;
                    skos:definition "A Realizable Entity of an Independent Continuant that creates an opportunity for an Agent to realize some Agent Capability or Disposition in some Act."@en;
                    comcore:ont00001754 """J. J. Gibson, \"The Theory of Affordances,\" in The Ecological Approach to Visual Perception (NY: Taylor & Francis Group, 1986): 127-143. Available at: https://archive.org/details/pdfy-u5hmFOvOM2Civ4Gz/page/n70/mode/1up."""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000178 a owl:Class;
                    rdfs:label "Arrow"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to be fired from a Bow and consists of a long straight stiff shaft with stabilizers (fletchings) and a slot (the nock) on one end and a weighted tip (the arrowhead) on the other end."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arrow&oldid=1058445874"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000179 a owl:Class;
                    rdfs:label "Thrust"@en;
                    rdfs:subClassOf comcore:ont00000570;
                    skos:definition "A Force that is equal in magnitude to but in the opposite direction of an exerted Force and which is used to describe the forward Force of a Jet or Rocket Engine in reaction to the Acceleration of its Reaction Mass in the opposite direction."@en;
                    skos:scopeNote "More generally, Thrust is the propulsive Force of a Rocket."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000180 a owl:Class;
                    rdfs:label "Hotel"@en;
                    rdfs:subClassOf comcore:ont00000410;
                    skos:definition "A Residential Facility that is designed to provide lodging that is paid for on a short-term basis."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hotel&oldid=1063583593"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000181 a owl:Class;
                    rdfs:label "Language Skill"@en;
                    rdfs:subClassOf comcore:ont00000089;
                    skos:definition "A Skill that is realized by an Act which is prescribed by a Language."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000182 a owl:Class;
                    rdfs:label "Act of Thanking"@en;
                    rdfs:subClassOf comcore:ont00000123;
                    skos:definition "An Act of Expressive Communication performed by expressing gratitude."@en;
                    comcore:ont00001754 " http://www.merriam-webster.com/dictionary/thanks";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000183 a owl:Class;
                    rdfs:label "Fragrance Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes of emitting a pleasant or sweet odor."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Perfume&oldid=1062785740"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000184 a owl:Class;
                    rdfs:label "Axial Rotation Period"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that is equal to the length of time required for a spinning Object to complete one rotation around its Axis of Rotation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000185 a owl:Class;
                    rdfs:label "Blunt"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having a sharp edge or point."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000186 a owl:Class;
                    rdfs:label "Artifact Version Ordinality"@en;
                    rdfs:subClassOf comcore:ont00001010;
                    skos:definition "An Ordinal Measurement Information Content Entity that is about the form of a Material Artifact which differs in some respects from previous or future forms of that Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000187 a owl:Class;
                    rdfs:label "Authority Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that is realized by Processes which create, modify, transfer, or eliminate Process Regulations or other Authority Roles, and inheres in an Agent in virtue of collective acceptance of that Agent's ability to issue binding directives."@en;
                    skos:scopeNote "Authority Roles are externally grounded in a social group's collective acceptance of the binding force of the agent's directives. This acceptance can be direct or indirect (e.g., by accepting a procedure for deputizing authority). Such collective acceptance need not be explicit or cognized; rather, collective acceptance can be expressed in the dispositions and attitudes of people toward that agent's directives. In many cases, the directives issued by Authority Roles are backed by threats of punishment or sanction for failure to comply, but the issuing of a directive plus a threat is not sufficient for authority. Rather, an agent's authority must be accepted either directly or indirectly through the acceptance of a procedure for bestowing authority (e.g., elections)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000188 a owl:Class;
                    rdfs:label "Ground Track"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:altLabel "Ground Trace"@en;
                    skos:definition "A One-Dimensional Spatial Region defined by the line formed on the surface of an Astronomical Body by projecting an imaginary line from the center of the tracked Object to the center of the Astronomical Body as the Object travels above the surface."@en;
                    skos:scopeNote "The Ground Track is the line on the surface of the Earth or other Astronomical Body that is located directly below the Object Track."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ground_track&oldid=1058025510"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000189 a owl:Class;
                    rdfs:label "Material Copy of a Certificate"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002002];
                    skos:altLabel "Certificate"@en;
                    skos:definition "An Information Bearing Artifact that bears an Information Content Entity which attests to certain demonstrated characteristics of an Object, Person, or Organization."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/degree";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000190 a owl:Class;
                    rdfs:label "Minimum Speed Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001353;
                    skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the lowest speed at which that Material Artifact is designed to operate."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000191 a owl:Class;
                    rdfs:label "Act of Homicide"@en;
                    rdfs:subClassOf comcore:ont00001147,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001803 ; 
                                     owl:someValuesFrom comcore:ont00000920];
                    skos:definition "An Act of Violence which causes the unlawful killing of another person."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000192 a owl:Class;
                    rdfs:label "Facility"@en;
                    rdfs:subClassOf comcore:ont00000995,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000171 ; 
                                     owl:someValuesFrom comcore:ont00001341];
                    skos:definition "A Material Artifact that is designed as a building or campus dedicated to some specific purpose."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000193 a owl:Class;
                    rdfs:label "Telephone Subscriber Line"@en;
                    rdfs:subClassOf comcore:ont00000059;
                    skos:definition "A Telephone Line that connects a Communication Endpoint to another node in a Telecommunication Network to enable service to a user's Telephone."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_line&oldid=1063429738"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000194 a owl:Class;
                    rdfs:label "Electrical Contact Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000795;
                    skos:definition "An Electrical Conduction Artifact Function that is realized by processes in which some Material Artifact is used as an endpoint of an electrical circuit from which an electrical current is passed via physical contact with the endpoint."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000195 a owl:Class;
                    rdfs:label "Heliport"@en;
                    rdfs:subClassOf comcore:ont00001078;
                    skos:definition "An Airport that is designed for launching, receiving, and housing Rotorcraft."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heliport&oldid=1049937701"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000196 a owl:Class;
                    rdfs:label "Purple"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is aproximately midway between Red and Blue."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000197 a owl:Class;
                    rdfs:label "Process Beginning"@en;
                    rdfs:subClassOf pobo:BFO_0000035;
                    skos:definition "A Process Boundary that occupies a Zero-Dimensional Temporal Region that is the starting instant of the One-Dimensional Temporal Region that the Process, of which the Process Boundary is a part, occupies."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000198 a owl:Class;
                    rdfs:label "Measurement Unit of Sound Level"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the level (the loudness) of sounds."@en;
                    skos:example "decibels, sones";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000199 a owl:Class;
                    rdfs:label "Camera"@en;
                    rdfs:subClassOf comcore:ont00000771;
                    skos:definition "An Imaging Instrument that is designed to form and digitally or physically record an image of an entity."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/camera";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000200 a owl:Class;
                    rdfs:label "Act of Pilgrimage"@en;
                    rdfs:subClassOf comcore:ont00000890;
                    skos:definition "An Act of Travel to a location of importance to a person's beliefs and faith."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pilgrimage&oldid=1056524204"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000201 a owl:Class;
                    rdfs:label "Act of Change of Residence"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change involving one or more Persons moving from one place of residence to another."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000202 a owl:Class;
                    rdfs:label "Act of Terrorist Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00001075;
                    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Terrorist Organization by imparting knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature to an Agent either directly or indirectly through some communication medium."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000203 a owl:Class;
                    rdfs:label "Event Status Nominal Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000293;
                    skos:definition "A Nominal Measurement Information Content Entity that is a measurement of the current state of a process."@en;
                    skos:example "proposed, approved, planned, in progress, completed, failed, or successful";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000204 a owl:Class;
                    rdfs:label "Rifle"@en;
                    rdfs:subClassOf comcore:ont00001104;
                    skos:definition "A Long Gun that is designed to have a rifled barrel and to fire single Bullets over long ranges with high accuracy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rifle&oldid=1056172452"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000205 a owl:Class;
                    rdfs:label "Object Track"@en;
                    rdfs:subClassOf pobo:BFO_0000026,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001855 ; 
                                     owl:someValuesFrom comcore:ont00000170];
                    skos:definition "A One-Dimensional Spatial Region that consists of the idealized line along which an Object has traversed during some motion."@en;
                    skos:scopeNote "The exact line of the Object Track may be drawn based on the Center of Mass of the Object or another reference point, such as the location of a transponder beacon or the center of a radar cross-section, depending on the Object being tracked."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000206 a owl:Class;
                    rdfs:label "Friction Reduction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes of reducing the force resisting the relative motion of surfaces in contact."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Friction&oldid=1061569068"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000207 a owl:Class;
                    rdfs:label "One-Dimensional Geospatial Boundary"@en;
                    rdfs:subClassOf pobo:BFO_0000142;
                    skos:definition "A Fiat Line that is a boundary of some Geospatial Region."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000208 a owl:Class;
                    rdfs:label "Act of Congratulating"@en;
                    rdfs:subClassOf comcore:ont00000123;
                    skos:definition "An Act of Expressive Communication performed by expressing vicarious pleasure to a person on the occasion of their success or good fortune."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/congratulate";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000209 a owl:Class;
                    rdfs:label "Sound Wavelength"@en;
                    rdfs:subClassOf comcore:ont00000313;
                    skos:definition "A Wavelength that is the distance a Sound Wave traverses during one Wave Cycle."@en;
                    comcore:ont00001754 "http://www.physicsclassroom.com/Class/waves/u10l2b.cfm";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000210 a owl:Class;
                    rdfs:label "Engine"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:altLabel "Motor"@en;
                    skos:definition "A Material Artifact that is designed to convert one form of energy into mechanical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Engine&oldid=1063879193"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000211 a owl:Class;
                    rdfs:label "Multi-Day Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000800];
                    skos:definition "A one-dimensional temporal region that is measured in Days and spans at least one Day."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000212 a owl:Class;
                    rdfs:label "Chemical Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing toxic chemicals."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_weapon&oldid=1054342645"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000213 a owl:Class;
                    rdfs:label "Subcontinent"@en;
                    rdfs:subClassOf comcore:ont00000472;
                    skos:definition "A Geospatial Region that is bounded by a large, relatively self-contained landmass forming a subdivision of a Continent."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Continent&oldid=1064057312"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000214 a owl:Class;
                    rdfs:label "Moving Target Indication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000289;
                    skos:definition "A Radar Imaging Artifact Function that inheres in Material Artifacts that are designed to identify and produce visual representations of moving entities by using a radar to emit successive phase coherent pulses, which are sampled and added to the subsequent pulse to cancel out signals from non-moving entities such that only signals from moving entities remain and are displayed."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000215 a owl:Class;
                    rdfs:label "Radio Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves to form an enhanced image of the Object."@en;
                    skos:scopeNote "A Radio Telescope consists of a specialized Antenna and a Radio Receiver and is typically used to receive radio waves from sources in outer space."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_telescope&oldid=1052819190"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000216 a owl:Class;
                    rdfs:label "Shell"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to be a non-self-propelled projectile and to carry a payload (explosive or other) over a relatively short distance."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Shell_(projectile)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000217 a owl:Class;
                    rdfs:label "Measurement Unit of Area"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of two-dimensional regions or Geospatial Regions."@en;
                    skos:example "square feet, square meters, acre, hectare";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000218 a owl:Class;
                    rdfs:label "Major Axis"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that is the longest line segment that connects two points on the edge of an Ellipse."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000219 a owl:Class;
                    rdfs:label "Reflecting Optical Telescope"@en;
                    rdfs:subClassOf comcore:ont00001009;
                    skos:altLabel "Reflecting Telescope"@en,
                                  "Reflector"@en;
                    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via reflection through the use of one or more curved Mirrors to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reflecting_telescope&oldid=1062982683"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000220 a owl:Class;
                    rdfs:label "Ammunition Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store Portions of Ammunition."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ammunition_dump&oldid=1044466765"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000221 a owl:Class;
                    rdfs:label "Semi-Minor Axis"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Minor Axis of an Ellipse."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000222 a owl:Class;
                    rdfs:label "Presence Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 4 and 6 kHz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000223 a owl:Class;
                    rdfs:label "Time of Day"@en;
                    rdfs:subClassOf pobo:BFO_0000203,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000800];
                    skos:definition "A Temporal Instant that is part of a Day."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000224 a owl:Class;
                    rdfs:label "Populated place"@en;
                    rdfs:subClassOf comcore:ont00001197;
                    skos:definition "An Anthropogenic Feature at which people live or have lived."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human_settlement&oldid=1060418164"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000225 a owl:Class;
                    rdfs:label "Month"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00000832];
                    skos:definition "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."@en;
                    skos:scopeNote "Unless otherwise specified, it is assumed that a Month is specified relative to the Rotational Motion of the Moon around the Earth. Earth Months are approximately equal to four consecutive Weeks or 30 consecutive Days."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=month";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000226 a owl:Class;
                    rdfs:label "Transportation Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for commencing or concluding the transportation of transportation artifacts, or for housing transportation artifacts."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transport&oldid=1063526665"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000227 a owl:Class;
                    rdfs:label "Julian Year"@en;
                    rdfs:subClassOf comcore:ont00000674;
                    skos:definition "A Calendar Year in the Julian Calendar."@en;
                    skos:scopeNote "A Julian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.25 Julian Days. Julian Years are typically indicated by prefixing a capital 'J' in front of the Year number, e.g. J2000.0 or J2018."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000228 a owl:Class;
                    rdfs:label "Planned Act"@en;
                    rdfs:subClassOf comcore:ont00000005;
                    skos:altLabel "Intentional Act"@en;
                    skos:definition "An Act in which at least one Agent plays a causative role and which is prescribed by some Prescriptive Information Content Entity held by at least one of the Agents."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000229 a owl:Class;
                    rdfs:label "Measurement Unit of Power"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of rates of work."@en;
                    skos:example "watt, horsepower";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000230 a owl:Class;
                    rdfs:label "Diffraction Grating"@en;
                    rdfs:subClassOf comcore:ont00000136;
                    skos:definition "An Optical Instrument with a periodic structure that is designed to split and defract a beam of light into several beams travelling in different directions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Diffraction_grating&oldid=1060463366"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000231 a owl:Class;
                    rdfs:label "Torpedo Tube"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to launch Torpedoes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo_tube&oldid=1063672665"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000232 a owl:Class;
                    rdfs:label "Pumping Station"@en;
                    rdfs:subClassOf comcore:ont00000677;
                    skos:definition "A Product Transport Facility that is designed to pump fluids from one place to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pumping_station&oldid=1045678418"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000233 a owl:Class;
                    rdfs:label "Stock Certificate"@en;
                    rdfs:subClassOf comcore:ont00001278;
                    skos:definition "Stock that consists of a Certificate."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000234 a owl:Class;
                    rdfs:label "Act of Training"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which knowledge, skills or values are imparted from one or more Agents to at least one other Agent."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000235 a owl:Class;
                    rdfs:label "Act of Vocational Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000687;
                    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring skills required for a specific occupation in industry, agriculture or trade from an Agent or communication medium that realizes a capacity derived from its affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000236 a owl:Class;
                    rdfs:label "Lighting System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to emit light within some area."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000237 a owl:Class;
                    rdfs:label "Act of Terrorist Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000687;
                    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature from an Agent or communication medium that realizes a capacity derived from its affiliation with a Terrorist Organization."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=terrorism";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000238 a owl:Class;
                    rdfs:label "Propeller"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:altLabel "Propelling Screw"@en;
                    skos:definition "A Material Artifact that is designed to convert rotary motion from an Engine or other mechanical Power Source into propulsive Force."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Propeller_(aeronautics)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000239 a owl:Class;
                    rdfs:label "Measurement Unit of Mass"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of an object's resistance to Acceleration when a Force is applied to the object."@en;
                    skos:example "ounce, gram, pound";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000240 a owl:Class;
                    rdfs:label "Act of Oath Taking"@en;
                    rdfs:subClassOf comcore:ont00001162;
                    skos:definition "An Act of Commissive Communication performed by stating or promising, usually calling upon something or someone that the oath maker considers sacred."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oath&oldid=1052326917"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000243 a owl:Class;
                    rdfs:label "Heat Sink"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to regulate the temperature of a computer by the passive transfer of heat away from other components in the computer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heat_sink&oldid=1062822080"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000244 a owl:Class;
                    rdfs:label "Fragmentation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001153;
                    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of a detonation which causes fragmentation."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/fragmentation";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000245 a owl:Class;
                    rdfs:label "Petroleum Manufacturing Facility"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed to manufacture petroleum-based products."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Petroleum&oldid=1062956217"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000246 a owl:Class;
                    rdfs:label "Stasis of Realizable Entity"@en;
                    rdfs:subClassOf comcore:ont00000135;
                    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Realizable Entity that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000247 a owl:Class;
                    rdfs:label "Road"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to travel from one location to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Road&oldid=1063402841";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000248 a owl:Class;
                    rdfs:label "Chemical Manufacturing Facility"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed to manufacture or process chemicals."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_industry&oldid=1061177027"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000249 a owl:Class;
                    rdfs:label "Shaft"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to rotate and transmit Torque, Power, or Rotational Motion from one machine element to another."@en;
                    skos:scopeNote "A Shaft is usually used to connect other components of a drive train that cannot be connected directly either because of the distance between them or the need to allow for relative movement between those components."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Shaft&oldid=1023963656"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000250 a owl:Class;
                    rdfs:label "Loss of Realizable Entity"@en;
                    rdfs:subClassOf comcore:ont00000865;
                    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Realizable Entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000251 a owl:Class;
                    rdfs:label "Continent"@en;
                    rdfs:subClassOf comcore:ont00000472;
                    skos:definition "A Geospatial Region that is bounded by any of the Earth's main continuous expanses of land."@en;
                    comcore:ont00001754 "JC3IEDM version 3.0.2";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000252 a owl:Class;
                    rdfs:label "Nozzle"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that is designed to control the speed, direction, rate, shape, or pressure of the flow of fluid exiting it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000253 a owl:Class;
                    rdfs:label "Information Bearing Entity"@en;
                    rdfs:subClassOf pobo:BFO_0000030;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000030
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000101 ; 
                                                             owl:someValuesFrom comcore:ont00000958]) ; 
                                         a owl:Class];
                    skos:altLabel "IBE"@en,
                                  "Information Carrying Entity"@en;
                    skos:definition "An Object upon which an Information Content Entity generically depends."@en;
                    skos:scopeNote "This class continues to use the word ‘bearing’ in its rdfslabel because of potential confusion with the acronym ‘ICE’, which is widely used for information content entity."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000178"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000254 a owl:Class;
                    rdfs:label "Transportation Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is fixed in place and designed to enable the movement of Vehicles and Agents from one location to another."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000255 a owl:Class;
                    rdfs:label "Portion of Cryogenic Material"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:definition "A Portion of Material that has been reduced to a very low temperature (below -180 degrees Celcius)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000256 a owl:Class;
                    rdfs:label "Fluid Control Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to manipulate the flow of a fluid (i.e. a liquid or a gas)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000257 a owl:Class;
                    rdfs:label "Radiopaque"@en;
                    rdfs:subClassOf comcore:ont00000620;
                    skos:altLabel "Radiodense"@en;
                    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to prevent most X-rays from passing through it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000259 a owl:Class;
                    rdfs:label "Calendar Month"@en;
                    rdfs:subClassOf comcore:ont00000225;
                    skos:definition "A Month that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Month."@en;
                    skos:example "January; February; March; April; May; June; July; August; September; October; November; December";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000260 a owl:Class;
                    rdfs:label "Muzzle Blast"@en;
                    rdfs:subClassOf comcore:ont00000675;
                    skos:definition "A Sound Wave Process that is caused by a projectile being pushed from the barrel of a firearm by an explosive charge."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000261 a owl:Class;
                    rdfs:label "Gamma Ray Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is above 30 exahertz."@en;
                    skos:scopeNote """Currently gamma radiation is distinguished from x-rays by their source--either inside or outside of the nucleus--rather than by frequency, energy, and wavelength.
https://en.wikipedia.org/wiki/Gamma_ray#Naming_conventions_and_overlap_in_terminology"""@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gamma_ray&oldid=1062115897"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000262 a owl:Class;
                    rdfs:label "Shop"@en;
                    rdfs:subClassOf comcore:ont00001102;
                    skos:definition "A Commercial Facility designed to sell small lots of goods to consumers."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Retail&oldid=1061431295"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000263 a owl:Class;
                    rdfs:label "Clock Time System"@en;
                    rdfs:subClassOf comcore:ont00001328;
                    skos:definition "A Temporal Reference System that is a convention for keeping and displaying the Time of Day."@en;
                    skos:scopeNote "A single Clock Time System does not provide a complete means for identifying or measuring times. Depending on the particular Clock Time System, it may be compatible for use with one or more other Temporal Reference Systems."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000264 a owl:Class;
                    rdfs:label "Hydraulic Fluid Reservoir"@en;
                    rdfs:subClassOf comcore:ont00000020;
                    skos:definition "A Container that is designed to store some hydraulic fluid for use in some Hyrdraulic Power Source."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000265 a owl:Class;
                    rdfs:label "Election"@en;
                    rdfs:subClassOf comcore:ont00001327;
                    skos:altLabel "Act of Political Election"@en;
                    skos:definition "A Social Act by which a population chooses an individual to hold public office."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Election&oldid=1063238552"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000266 a owl:Class;
                    rdfs:label "Hearing Aid"@en;
                    rdfs:subClassOf comcore:ont00001381;
                    skos:definition "A Medical Artifact that is designed to improve hearing for its user."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hearing_aid&oldid=1062688647"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000267 a owl:Class;
                    rdfs:label "Catalyst Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which the rate of a chemical reaction is increased due to the participation of an additional substance, without that substance being consumed in the reaction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Catalysis&oldid=1063864001"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000268 a owl:Class;
                    rdfs:label "Cannon"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to use a controlled explosion to launch a relatively large Portion of Ammunition, such as a Round Shot or a Shell, at a significant Velocity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cannon&oldid=1063792906"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000269 a owl:Class;
                    rdfs:label "Radio Transmitter"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to generate a radio frequency alternating current, which can be applied to a Radio Antenna to be transmitted as radio waves."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transmitter&oldid=1061735586"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000270 a owl:Class;
                    rdfs:label "Educational Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for facilitating learning, or the acquisition of knowledge, skills, values, beliefs, and habits."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000271 a owl:Class;
                    rdfs:label "Underground Mine"@en;
                    rdfs:subClassOf comcore:ont00000639;
                    skos:definition "A Mine that is designed to support the extraction of materials from the ground using underground tunnels and shafts."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Underground_mining_(hard_rock)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000272 a owl:Class;
                    rdfs:label "Combustion"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:altLabel "Burning Process"@en,
                                  "Combustion Process"@en;
                    skos:definition "A Natural Process in which a Portion of Fuel or other Material Entity is burned."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000273 a owl:Class;
                    rdfs:label "Communication Interference Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to interfere with the transmission of information for the purpose of preventing communication."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000274 a owl:Class;
                    rdfs:label "Armed Force"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    skos:definition "An Organization having the Objective to further the foreign and domestic policies of a Government and to defend that body and the nation it represents from external and internal aggressors."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000275 a owl:Class;
                    rdfs:label "Spatial Reference System"@en;
                    rdfs:subClassOf comcore:ont00000398;
                    skos:altLabel "Coordinate System"@en,
                                  "Spatial Coordinate System"@en,
                                  "Spatial Reference Frame"@en;
                    skos:definition "A Reference System that describes a set of standards for uniquely identifying the position of an entity or the direction of a vector within a defined spatial region by means of measurements along one or more Coordinate System Axes."@en;
                    skos:scopeNote "Note that, while reference systems and reference frames are treated as synonyms here, some people treat them as related but separate entities. See: http://www.ggos-portal.org/lang_en/GGOS-Portal/EN/Topics/GeodeticApplications/GeodeticReferenceSystemsAndFrames/GeodeticReferenceSystemsAndFrames.html"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coordinate_system&oldid=1060461397"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000276 a owl:Class;
                    rdfs:label "Solar Calendar System"@en;
                    rdfs:subClassOf comcore:ont00000891;
                    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of an Astronomical Body's Orbit around the Sun."@en;
                    skos:scopeNote "Unless otherwise specified, a Solar Calendar System is assumed to be relative to the Orbit of the Earth around the Sun."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_calendar&oldid=1058016588"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000277 a owl:Class;
                    rdfs:label "Nuclear Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a destructive nuclear reaction, either through fission or through a combination of fission and fusion."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_weapon&oldid=1060854171"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000278 a owl:Class;
                    rdfs:label "Momentum"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00001133];
                    skos:definition "A Process Profile of an object in Motion that is the product of its Mass and Velocity with respect to a frame of reference."@en;
                    skos:scopeNote "The SI unit of measure for Momentum is Newton seconds (N s)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000279 a owl:Class;
                    rdfs:label "Enemy Role"@en;
                    rdfs:subClassOf comcore:ont00000392;
                    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000280 a owl:Class;
                    rdfs:label "Torpedo"@en;
                    rdfs:subClassOf comcore:ont00001124;
                    skos:definition "A Precision-Guided Missile that is designed to be fired into a body of water, be self-propelled through the water, and carry an explosive payload."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torpedo&oldid=1062609830"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000281 a owl:Class;
                    rdfs:label "Albedo"@en;
                    rdfs:subClassOf comcore:ont00001137;
                    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of its surface to reflect incident electromagnetic radiation of a particular wavelength."@en;
                    skos:scopeNote "Albedo is a reflection coefficient and is measured as the ratio of radiation reflected from the surface to the incident radiation. Albedo is dimensionless, can be expressed as a percentage, and is measured on a scale from 0 for no reflection to 1 for perfect reflection of a surface. Albedo depends on the wavelength of the radiation; when no wavelength is specified, it typically refers to some appropriate average across the spectrum of visible light."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Albedo&oldid=1063352646"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000282 a owl:Class;
                    rdfs:label "Counterfeit Financial Instrument"@en;
                    rdfs:subClassOf comcore:ont00000719;
                    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some legally sanctioned Financial Instrument."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit_money&oldid=1064052318"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000283 a owl:Class;
                    rdfs:label "Cylindrical"@en;
                    rdfs:subClassOf comcore:ont00001360;
                    skos:altLabel "Columnar"@en;
                    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of the bearer having an elongated shape with round bases."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000284 a owl:Class;
                    rdfs:label "Strength"@en;
                    rdfs:subClassOf pobo:BFO_0000017;
                    skos:definition "A Realizable Entity that is realized when its bearer exerts or resists some power, influence, or force."@en;
                    skos:scopeNote "Strength is intended to be understood broadly here. Physical strength is only one type of Strength. Other subtypes of Strength may include military strength, psychological strength, emotional strength, political strength, technological strength, and so on."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000285 a owl:Class;
                    rdfs:label "Emergency Locator Transmitter"@en;
                    rdfs:subClassOf comcore:ont00000269;
                    skos:definition "A Radio Transmitter that is designed to signal distress and provide positional data for the entity it is located on."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emergency_position-indicating_radiobeacon&oldid=1063407242"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000286 a owl:Class;
                    rdfs:label "Stasis of Partially Mission Capable Maintenance"@en;
                    rdfs:subClassOf comcore:ont00000100;
                    skos:definition "A Stasis of Partially Mission Capable during which the participating Continuant is not capable of performing some of its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000287 a owl:Class;
                    rdfs:label "Inertial Navigation System"@en;
                    rdfs:subClassOf comcore:ont00001187;
                    skos:altLabel "INS"@en;
                    skos:definition "A Navigation System that is designed to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Inertial_navigation_system&oldid=1063682725"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000288 a owl:Class;
                    rdfs:label "Power Source"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to supply power to some other Material Artifact."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_source&oldid=1032888635"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000289 a owl:Class;
                    rdfs:label "Radar Imaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000601;
                    skos:definition "An Imaging Artifact Function that inheres in Material Artifacts that are designed to produce visual representations of entities using radio waves."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000290 a owl:Class;
                    rdfs:label "Decrease of Specifically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000726;
                    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in some Specifically Dependent Continuant that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000291 a owl:Class;
                    rdfs:label "Act of Decoy Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Decoy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000292 a owl:Class;
                    rdfs:label "Artifact Identifier"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000686
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom comcore:ont00000995]) ; 
                                         a owl:Class];
                    skos:definition "A Designative Information Content Entity which designates some Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000293 a owl:Class;
                    rdfs:label "Nominal Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    owl:disjointWith comcore:ont00001010,
                                     comcore:ont00001022,
                                     comcore:ont00001364;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001163
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001868 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:definition "A Measurement Information Content Entity that consists of a symbol that classifies Entities according to some shared, possibly arbitrary, characteristic."@en;
                    skos:example """The sentence \"January 20, 1985 was a cold day in Chicago, IL\" is the carrier of a nominal measurement."""@en,
                                 "a measurement that classifies automobiles as sedans, coupes, hatchbacks, or convertibles",
                                 "a measurement that classifies military intelligence as strategic, operational, or tactical",
                                 "a measurement that classifies rocks as igneous, sedimentary, or metamorphic";
                    skos:scopeNote """Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000294 a owl:Class;
                    rdfs:label "Air-Breathing Jet Engine"@en;
                    rdfs:subClassOf comcore:ont00000533;
                    skos:altLabel "Ducted Jet Engine"@en;
                    skos:definition "A Jet Engine that is propelled by a jet of hot exhaust gases formed from air that is drawn into the Engine via an Air Inlet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Airbreathing_jet_engine&oldid=1062364308"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000295 a owl:Class;
                    rdfs:label "Wetness"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which the bearer is covered by a liquid, typically on a continuum of dry to wet."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000296 a owl:Class;
                    rdfs:label "Angular Velocity"@en;
                    rdfs:subClassOf comcore:ont00000763;
                    skos:altLabel "Rotational Velocity"@en;
                    skos:definition "A Velocity that is characterized by both the angular Speed of an object and the Axis about which the object is Rotating."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Angular_velocity&oldid=1060081663"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000297 a owl:Class;
                    rdfs:label "Portion of Hydrosphere"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A fiat object part of the combined mass of water found on, under, and above the surface of a natural satellite"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydrosphere&oldid=1128848972"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000298 a owl:Class;
                    rdfs:label "Shoulder-Fired Rocket Launcher"@en;
                    rdfs:subClassOf comcore:ont00001173;
                    skos:definition "A Rocket Launcher that is designed to be small enough to be carried by a single person and fired while supported on the person's shoulder."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000299 a owl:Class;
                    rdfs:label "Prosthetic Leg"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace a missing leg."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000300 a owl:Class;
                    rdfs:label "Group of Agents"@en;
                    rdfs:subClassOf pobo:BFO_0000027,
                                    [owl:intersectionOf ([a owl:Restriction ; 
                                                         owl:onProperty pobo:BFO_0000115 ; 
                                                         owl:someValuesFrom comcore:ont00001017]
                                                         [a owl:Restriction ; 
                                                         owl:onProperty pobo:BFO_0000115 ; 
                                                         owl:allValuesFrom comcore:ont00001017]) ; 
                                     a owl:Class];
                    skos:definition "An Object Aggregate that has only Agents as member parts."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000301 a owl:Class;
                    rdfs:label "Vehicle Transmission"@en;
                    rdfs:subClassOf comcore:ont00000663;
                    skos:altLabel "Gearbox"@en,
                                  "Transmission"@en;
                    skos:definition "A Power Transmission Artifact that is designed to vary the output speed and torque in a rotating power transfer system."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Transmission_(mechanics)"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000302 a owl:Class;
                    rdfs:label "Alternating Current Power Source"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of alternating current."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000303 a owl:Class;
                    rdfs:label "Intercommunication System"@en;
                    rdfs:subClassOf comcore:ont00001036;
                    skos:definition "A Communication System that is designed to enable some Act of Communication between end points within a building, small collection of buildings, or within a small area of service."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Intercom&oldid=1055934442"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000304 a owl:Class;
                    rdfs:label "Microscope"@en;
                    rdfs:subClassOf comcore:ont00000771;
                    skos:definition "An Imaging Instrument that is designed to enable users to see Objects that are otherwise too small to be seen by the naked eye by producing a significantly enlarged image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microscope&oldid=1059024357"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000305 a owl:Class;
                    rdfs:label "Sound Pressure"@en;
                    rdfs:subClassOf comcore:ont00000380;
                    skos:altLabel "Acoustic Pressure"@en;
                    skos:definition "A Pressure that is caused by a Sound Wave and is a local deviation from the ambient Pressure."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000306 a owl:Class;
                    rdfs:label "Hinge"@en;
                    rdfs:subClassOf comcore:ont00001370;
                    skos:definition "A Machine Bearing that is designed to limit the angle of Rotation between two solid objects."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hinge&oldid=1059935559"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000307 a owl:Class;
                    rdfs:label "Portion of Food"@en;
                    rdfs:subClassOf comcore:ont00001084;
                    skos:definition "A Portion of Processed Material that is designed to be consumed and ingested for nutrition or taste."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Food&oldid=1062824590"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000308 a owl:Class;
                    rdfs:label "Act of Military Service"@en;
                    rdfs:subClassOf comcore:ont00001226;
                    skos:definition "An Act of Employment by an Organization wherein a Person serves as a member of a Military Force, whether voluntarily or by conscription."@en;
                    comcore:ont00001754 "http://www.collinsdictionary.com/dictionary/english/military-service";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000309 a owl:Class;
                    rdfs:label "Healthcare Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of treating and preventing illness."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Health_care&oldid=1064015344"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000310 a owl:Class;
                    rdfs:label "Grenade"@en;
                    rdfs:subClassOf comcore:ont00000552;
                    skos:altLabel "Hand Grenade"@en;
                    skos:definition "An Explosive Weapon that is designed to be relatively small and to be thrown by hand."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Grenade&oldid=1060366148"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000311 a owl:Class;
                    rdfs:label "Filtration Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001999;
                    skos:definition "A Filter Function that is realized in a process in which some solid entity is prevented from moving along with some quantity of liquid."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Filtration&oldid=1061655528"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000312 a owl:Class;
                    rdfs:label "Propulsion Process"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:definition "A Natural Process in which one or more Forces are generated and applied to a participating Object such that the Object is set in Motion or has the direction or magnitude of its Motion altered."@en;
                    skos:example "a twin-engine turboprop plane rotating both of its propellers against a portion of atmosphere to propel the plane forward",
                                 "an apple falling to the ground under the power of Earth's gravitational force",
                                 "burning a portion of fuel to produce exhaust that is ejected through a jet nozzle to propel a rocket and its payload",
                                 "heat from a fire causing ashes to rise into the sky",
                                 "launching a water balloon using a sling shot",
                                 "the wind blowing leaves across a lawn",
                                 "turning a paddle wheel against a portion of water to propel the paddle boat forward";
                    skos:scopeNote "In each case, a Propulsion Process minimally involves the Object being propelled, a Reaction Mass (e.g. a portion of water, atmosphere, exhaust, etc.), and the Force(s) acting between these two entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000313 a owl:Class;
                    rdfs:label "Wavelength"@en;
                    rdfs:subClassOf comcore:ont00000752;
                    skos:definition "A Wave Process Profile that is the distance the Wave Process traverses during one Wave Cycle."@en;
                    skos:scopeNote "Assuming a non-dispersive media, the Wavelength will be the inverse of the Frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000314 a owl:Class;
                    rdfs:label "Information Quality Entity"@en;
                    rdfs:subClassOf pobo:BFO_0000019,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000197 ; 
                                     owl:someValuesFrom comcore:ont00000253];
                    skos:altLabel "IQE"@en;
                    skos:definition "A Quality that concretizes some Information Content Entity."@en;
                    skos:scopeNote "Typically, an IQE will be a complex pattern made up of multiple qualities joined together spatially."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000315 a owl:Class;
                    rdfs:label "Telecommunication Switching Node"@en;
                    rdfs:subClassOf comcore:ont00000918;
                    skos:definition "A Telecommunication Network Node that is capable of redirecting a communication transmission to another Telecommunication Network Node."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_network&oldid=1063347482"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000316 a owl:Class;
                    rdfs:label "Portion of Liquid Helium"@en;
                    rdfs:subClassOf comcore:ont00000255;
                    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid helium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000317 a owl:Class;
                    rdfs:label "Electronic Signal Processing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001218;
                    skos:definition "A Signal Processing Artifact Function that inheres in Material Artifacts that are designed to process or transfer information contained in electronic signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000318 a owl:Class;
                    rdfs:label "Disease"@en;
                    rdfs:subClassOf pobo:BFO_0000016;
                    skos:definition "A Disposition to undergo pathological processes that exists in an organism because of one or more disorders in that organism."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/OGMS_0000031";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000319 a owl:Class;
                    rdfs:label "Artifact Design"@en;
                    rdfs:subClassOf comcore:ont00000965,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001942 ; 
                                     owl:someValuesFrom comcore:ont00000995];
                    skos:definition "A Prescriptive Information Content Entity that is a specification of an object, manifested by an agent, intended to accomplish goals, in a particular environment, using a set of primitive components, satisfying a set of requirements, subject to constraints."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Design&oldid=1063941625"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000320 a owl:Class;
                    rdfs:label "Act of Reconnaissance"@en;
                    rdfs:subClassOf comcore:ont00001251;
                    skos:definition "An Act of Intelligence Gathering used to determine an Agent's disposition and intention; the composition and capabilities of Equipment and Facilities, and the surrounding landforms and weather conditions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reconnaissance&oldid=1038843823"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000321 a owl:Class;
                    rdfs:label "Residential Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of residing in a dwelling or home."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000322 a owl:Class;
                    rdfs:label "Act of Funding"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use in which an Agent (the Funder) provides some Financial Instrument to another Agent (the recipient of the funds) as a resource pool that is earmarked by the Funder for a future transaction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000323 a owl:Class;
                    rdfs:label "Artifact Function"@en;
                    rdfs:subClassOf pobo:BFO_0000034,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000197 ; 
                                     owl:someValuesFrom comcore:ont00000995];
                    skos:definition "A Function that inheres in some Material Artifact in virtue of that Material Artifact being designed to be used in processes that require that Function to be realized."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000324 a owl:Class;
                    rdfs:label "Width"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a horizontal direction."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000325 a owl:Class;
                    rdfs:label "Radio Transponder"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:altLabel "Transmitter-Responder"@en;
                    skos:definition "A Radio Communication Instrument that is an electronic device that acts as both a Radio Transmitter and responder and is used to wirelessly receive and transmit electrical signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000327 a owl:Class;
                    rdfs:label "Texture"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the size, shape, and distribution of features on its surface, typically on a continuum from smooth to rough."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000328 a owl:Class;
                    rdfs:label "Transportation Infrastructure"@en;
                    rdfs:subClassOf comcore:ont00000870;
                    skos:definition "An Infrastructure System that has continuant part one or more Transportation Artifacts and bears a function that, if realized, is realized in Acts of Cargo Transportation"@en;
                    comcore:ont00001754 "http://www.cfr.org/infrastructure/transportation-infrastructure-moving-america/p18611";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000329 a owl:Class;
                    rdfs:label "Multi-Month Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000225];
                    skos:definition "A one-dimensional temporal region that is measured in Months and spans at least one Month."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000330 a owl:Class;
                    rdfs:label "Thermal Power Plant"@en;
                    rdfs:subClassOf comcore:ont00001076;
                    skos:definition "An Electric Power Station that is designed to convert heat energy into electrical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_power_station&oldid=1062208548"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000331 a owl:Class;
                    rdfs:label "House"@en;
                    rdfs:subClassOf comcore:ont00000410;
                    skos:definition "A Residential Facility that is designed to provide a self-standing, permanent residence for an individual, family, household, multiple families, or similar-sized group."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=House&oldid=1062818553"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000332 a owl:Class;
                    rdfs:label "Training Camp"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for rigorous and focused training in order to learn or improve skills, usually involving physical actions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Training_camp&oldid=1059977631"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000333 a owl:Class;
                    rdfs:label "Gas Turbine"@en;
                    rdfs:subClassOf comcore:ont00000394;
                    skos:altLabel "Combustion Turbine"@en;
                    skos:definition "An Internal Combustion Engine that has a rotating compressor and a turbine and is designed to operate utilizing continous Combustion to produce Thrust, either directly via exhaust or indirectly via a prop."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gas_turbine&oldid=1062398125"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000334 a owl:Class;
                    rdfs:label "Interphone"@en;
                    rdfs:subClassOf comcore:ont00000303;
                    skos:definition "An Intercommunication System that that is designed to facilitate some Act of Communication between agents by means of audio messages."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000335 a owl:Class;
                    rdfs:label "Stasis of Generically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000819;
                    skos:definition "A Stasis in which some Independent Continuant bears some Generically Dependent Continuant that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000336 a owl:Class;
                    rdfs:label "Apartment Building"@en;
                    rdfs:subClassOf comcore:ont00000410;
                    skos:definition "A Residential Facility that is designed to contain multiple permanent residences comprised of a suite of rooms."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Apartment&oldid=1064019048"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000337 a owl:Class;
                    rdfs:label "Rocket-Propelled Grenade"@en;
                    rdfs:subClassOf comcore:ont00001029;
                    skos:definition "An Unguided Rocket that is designed to contain an explosive warhead, be fired from a Shoulder-Fired Rocket Launcher, and be used against Tanks."@en;
                    comcore:ont00001753 "RPG";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket-propelled_grenade&oldid=1063641548"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000338 a owl:Class;
                    rdfs:label "Fan"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that consists of a rotating arrangement of vanes or blades that are designed to act on a portion of fluid to create flow within it."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Fan_(machine)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000339 a owl:Class;
                    rdfs:label "Agricultural Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed as a building or campus for agricultural processes with the aim of cultivating animals, plants, or fungi for food, fiber, biofuel, medicinal plants, or other products to sustain and enhance human life."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Agriculture&oldid=1063222666"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000340 a owl:Class;
                    rdfs:label "Mortar"@en;
                    rdfs:subClassOf comcore:ont00000268;
                    skos:definition "A Cannon that is designed to fire projectiles at relatively low velocities over relatively short ranges."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Mortar_(weapon)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000341 a owl:Class;
                    rdfs:label "Prosthetic Arm"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace a missing arm."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000342 a owl:Class;
                    rdfs:label "Brake"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to inhibit the Vehicle's Motion by absorbing energy from a moving system."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Brake&oldid=1047693009"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000343 a owl:Class;
                    rdfs:label "Reciprocating Steam Engine"@en;
                    rdfs:subClassOf comcore:ont00000634;
                    skos:definition "A Steam Engine that is designed to use one or more reciprocating pistons to convert pressure into a rotating motion."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reciprocating_engine&oldid=1057783145"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000344 a owl:Class;
                    rdfs:label "Surfactant Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001281;
                    skos:definition "An Emulsifier Artifact Function that is realized in a process that lowers the surface tension between two liquids or between a liquid and a solid."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Surfactant&oldid=1063693411"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000345 a owl:Class;
                    rdfs:label "Act of Measuring"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act that involves determining the extent, dimensions, quanity, or quality of an Entity relative to some standard."@en;
                    skos:example "putting an object on a scale to measure its weight in kilograms",
                                 "rating Hollywood movies on a 1 to 5 star scale",
                                 "using a tape measure to determine the height and width of a doorway in inches";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000346 a owl:Class;
                    rdfs:label "Communication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to facilitate communication between at least two entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000347 a owl:Class;
                    rdfs:label "Electronic Bond"@en;
                    rdfs:subClassOf comcore:ont00001159;
                    skos:definition "A Bond that consists of Bytes."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000348 a owl:Class;
                    rdfs:label "Filter"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000995
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00001999]) ; 
                                         a owl:Class];
                    skos:definition "A Material Artifact that bears a Filter Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000349 a owl:Class;
                    rdfs:label "Police Station"@en;
                    rdfs:subClassOf comcore:ont00000479;
                    skos:definition "A Public Safety Facility that is designed for the professional and clerical processes of a local police force."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Police_station&oldid=1056208781"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000350 a owl:Class;
                    rdfs:label "Cooling System"@en;
                    rdfs:subClassOf comcore:ont00000453;
                    skos:definition "An Environment Control System that is designed to cool the air or objects in a Site."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000351 a owl:Class;
                    rdfs:label "Act of Commanding"@en;
                    rdfs:subClassOf comcore:ont00000133;
                    skos:definition "An Act of Directive Communication through which an Agent exercises authoritative control or power over another Agent's actions."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=commanding (Edited 08-22-2016)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000352 a owl:Class;
                    rdfs:label "Satellite Artifact"@en;
                    rdfs:subClassOf comcore:ont00001139;
                    skos:definition "A Spacecraft that is designed to Orbit a Space Object (typically Earth)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000353 a owl:Class;
                    rdfs:label "Research Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to perform research on a specified entity or class of entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000354 a owl:Class;
                    rdfs:label "Act of Testifying"@en;
                    rdfs:subClassOf comcore:ont00000379;
                    skos:definition "An Act of Representative Communication performed by stating one's personal knowledge or belief."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/testify";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000355 a owl:Class;
                    rdfs:label "Refracting Optical Telescope"@en;
                    rdfs:subClassOf comcore:ont00001009;
                    skos:altLabel "Refracting Telescope"@en,
                                  "Refractor"@en;
                    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light via refraction through the use of one or more Lenses to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refracting_telescope&oldid=1059975066"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000356 a owl:Class;
                    rdfs:label "Act of Publishing Mass Media Article"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of a non-fictional essay, especially one included with others in a newspaper, magazine, journal, etc."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000357 a owl:Class;
                    rdfs:label "Act of Motion"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act by which an Agent causes the position or location of some Object to change."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/motion";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000358 a owl:Class;
                    rdfs:label "Geospatial Region Bounding Box"@en;
                    rdfs:subClassOf comcore:ont00001130;
                    skos:definition "A Geospatial Polygon that has some Geospatial Region as a non-tangential proper part."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000359 a owl:Class;
                    rdfs:label "Julian Date"@en;
                    rdfs:subClassOf comcore:ont00000223,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000498];
                    skos:definition "A Time of Day as specified according to the Julian Calendar using the Julian Date epoch."@en;
                    comcore:ont00001753 "JD";
                    comcore:ont00001754 "https://www.defit.org/julian-date/";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000360 a owl:Class;
                    rdfs:label "Wounded Stasis"@en;
                    rdfs:subClassOf comcore:ont00001289;
                    skos:altLabel "Wounded"@en;
                    skos:definition "A Damaged Stasis in which a Person or other organism is the bearer of a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to an injuring event."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000361 a owl:Class;
                    rdfs:label "Increase of Function"@en;
                    rdfs:subClassOf comcore:ont00001356;
                    skos:definition "An Increase of Disposition in which some Independent Continuant has an increase of some Function that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000362 a owl:Class;
                    rdfs:label "Rocket Engine"@en;
                    rdfs:subClassOf comcore:ont00000533;
                    skos:altLabel "Thruster"@en;
                    skos:definition "A Jet Engine that is designed to use only stored Rocket Propellant to form a high speed propulsive jet in order to generate Thrust."@en;
                    skos:scopeNote "Most rocket engines are also Internal Combustion Engines, however non-combusting forms also exist. For example, an untied balloon full of air that is released and allowed to zoom around the room may be both a Rocket Engine and a Physically Powered Engine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket_engine&oldid=1063879464"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000363 a owl:Class;
                    rdfs:label "Wireless Telecommunication Network"@en;
                    rdfs:subClassOf comcore:ont00000998;
                    skos:altLabel "Wireless Network"@en;
                    skos:definition "A Telecommunication Network that uses wireless connections to connect Telecommunication Network Nodes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wireless_network&oldid=1060257041"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000364 a owl:Class;
                    rdfs:label "Pneumatic Motor"@en;
                    rdfs:subClassOf comcore:ont00001221;
                    skos:altLabel "Air Motor"@en,
                                  "Compressed Air Engine"@en;
                    skos:definition "A Physically Powered Engine that converts potential energy stored in a portion of compressed air into mechanical energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000365 a owl:Class;
                    rdfs:label "x-Axis"@en;
                    rdfs:subClassOf comcore:ont00000161;
                    skos:definition "A Coordinate System Axis designated by the variable 'x'."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000366 a owl:Class;
                    rdfs:label "Act of Information Processing"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which one or more input Information Content Entities are received, manipulated, transferred, or stored by an Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000367 a owl:Class;
                    rdfs:label "Act of Military Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00001075;
                    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Military Organization by imparting knowledge of the tactics, techniques, and/or strategies of Military Operations to an Agent either directly or indirectly through some communication medium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000368 a owl:Class;
                    rdfs:label "Rotational Motion"@en;
                    rdfs:subClassOf comcore:ont00001133,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000296];
                    skos:altLabel "Rotation"@en;
                    skos:definition "A Motion Process in which an Object moves in a Circular or Elliptical Path around an Axis of Rotation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rotation&oldid=1055998344"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000369 a owl:Class;
                    rdfs:label "Priority Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001010;
                    skos:altLabel "Criticality Measurement"@en,
                                  "Importance Measurement"@en,
                                  "Priority Measurement"@en;
                    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of the relative importance of an entity."@en;
                    skos:example "low, normal, high, urgent, or immediate priority";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000370 a owl:Class;
                    rdfs:label "Act of Condoling"@en;
                    rdfs:subClassOf comcore:ont00000123;
                    skos:definition "An Act of Expressive Communication performed by expressing sympathy or sorrow."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/condoling";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000371 a owl:Class;
                    rdfs:label "Act of Prediction"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act that involves the generation of a Predictive Information Content entity that is intended to describe an uncertain possible future event, value, entity, or attribute of an entity."@en;
                    skos:example "a chess master predicting the next 8 moves his opponent will make",
                                 "predicting that a particular stock will double in value over the next fiscal quarter",
                                 "using sample exit polls data to predict the winners of an election";
                    skos:scopeNote "An Act of Prediction may involve the use of some or no relevant information. An Act of Prediction that utilizes relevant information may also be (or at least involve) an Act of Estimation. Hence, these two classes are not disjoint. Furthermore, neither class subsumes the other since estimates can be made about existing entities and not all predictions produce measurements (e.g. predicting that it will rain tomorrow)."@en,
                                   "Predictions can only be made about things that are not yet the case (i.e. future things) and are further restricted to being about things that do not have a probability of either 1 (necessary) or 0 (impossible). For example, assuming that no organism is immortal, one cannot predict of a given organism that it will eventually die; however, one may predict uncertain things about the organism's eventual death, such as its precise cause or time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000372 a owl:Class;
                    rdfs:label "Power Transformer Rectifier Unit"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:altLabel "TRU"@en;
                    skos:definition "A Material Artifact that is designed to perform the functions of both a Rectifier and a Transformer."@en;
                    comcore:ont00001754 "http://www.skybrary.aero/index.php/Transformer_Rectifier_Unit_(TRU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000373 a owl:Class;
                    rdfs:label "Geospatial Position"@en;
                    rdfs:subClassOf pobo:BFO_0000147;
                    skos:definition "A Fiat Point that is at or near the surface of the Earth and fixed according to some Geospatial Coordinate Reference System."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000374 a owl:Class;
                    rdfs:label "Measurement Unit of Volumetric Flow Rate"@en;
                    rdfs:subClassOf comcore:ont00000061;
                    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which volumes of fluid pass per unit time."@en;
                    skos:example "cubic metres per second, standard cubic centimeters per minute, cubic feet per second, gallons per minute";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000375 a owl:Class;
                    rdfs:label "Warehouse"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store commercial goods."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Warehouse&oldid=1063721454"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000376 a owl:Class;
                    rdfs:label "Portion of Gallium Arsenide"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:altLabel "Portion of GaAs"@en;
                    skos:definition "A Portion of Material that is composed of a compound of the elements gallium and arsenic."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000377 a owl:Class;
                    rdfs:label "Disability"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality inhering in an Agent by virtue a physical or mental condition that limits the Agent's movements, senses, or activities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000378 a owl:Class;
                    rdfs:label "Color"@en;
                    rdfs:subClassOf comcore:ont00000784;
                    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's Color Hue, Color Saturation and Color Brightness."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000379 a owl:Class;
                    rdfs:label "Act of Representative Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication that commits a speaker to the truth of the expressed proposition."@en;
                    skos:scopeNote "Examples: affirming, alleging, announcing, answering, attributing, claiming, classifying, concurring, confirming, conjecturing, denying, disagreeing, disclosing, disputing, identifying, informing, insisting, predicting, ranking, reporting, stating, stipulating"@en;
                    comcore:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000380 a owl:Class;
                    rdfs:label "Pressure"@en;
                    rdfs:subClassOf comcore:ont00000570;
                    skos:definition "A Force that is applied perpendicular to the surface of an Object per unit area over which that Force is distributed."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000381 a owl:Class;
                    rdfs:label "Weapon Manufacturing Facility"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed to produce or assemble weapons."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Arms_industry&oldid=1063811497"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000382 a owl:Class;
                    rdfs:label "Material Copy of a Spreadsheet"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002042];
                    skos:altLabel "Spreadsheet"@en;
                    skos:definition "A Material Copy of a Document that is designed to carry some Information Content Entity in an interactive, tabular form."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spreadsheet&oldid=1064060503"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000383 a owl:Class;
                    rdfs:label "Nuclear Family"@en;
                    rdfs:subClassOf comcore:ont00000837;
                    skos:definition "A Family composed of parents and their children."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000384 a owl:Class;
                    rdfs:label "Rectilinear Motion"@en;
                    rdfs:subClassOf comcore:ont00000789;
                    skos:altLabel "Linear Motion"@en;
                    skos:definition "A Translational Motion process in which an Object moves along a straight path."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000385 a owl:Class;
                    rdfs:label "Wide"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Broad"@en,
                                  "Fat"@en;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly larger in proportion to its length or height."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000386 a owl:Class;
                    rdfs:label "Webcast"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Webcasting"@en;
                    skos:definition "An Act of Communciation by Media transmitted to an audience over the Internet using streaming media technology to distribute a single content source that may be distributed live or on demand."@en;
                    skos:scopeNote "Essentially, webcasting is “broadcasting” over the Internet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Webcast&oldid=1062685084"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000387 a owl:Class;
                    rdfs:label "Axis of Rotation"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:altLabel "Rotational Axis"@en;
                    skos:definition "A One-Dimensional Spatial Region defined by the line around which a spinning body rotates."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000388 a owl:Class;
                    rdfs:label "Citizen"@en;
                    rdfs:subClassOf comcore:ont00001262;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000987]) ; 
                                         a owl:Class];
                    skos:definition "A Person who is the bearer of some Citizen Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000389 a owl:Class;
                    rdfs:label "Act of Buying"@en;
                    rdfs:subClassOf comcore:ont00001334;
                    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Buyer) to acquire ownership of a good from another Agent (the Seller)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000390 a owl:Class;
                    rdfs:label "Spatial Region Identifier"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000686
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom pobo:BFO_0000006]) ; 
                                         a owl:Class];
                    skos:definition "A Designative Information Content Entity that designates some Spatial Region."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000391 a owl:Class;
                    rdfs:label "Tremendously High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:altLabel "ITU Band Number 12"@en,
                                  "Submillimeter Band Frequency"@en,
                                  "Terahertz Radiation Frequency"@en;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 GHz and 3 THz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 1–0.1 mm"@en;
                    comcore:ont00001753 "THF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000392 a owl:Class;
                    rdfs:label "Allegiance Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent by virtue of the support it has committed to provide to another Agent when that Agent is involved in a conflict."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000393 a owl:Class;
                    rdfs:label "Yaw Axis"@en;
                    rdfs:subClassOf comcore:ont00000387;
                    skos:altLabel "Vertical Axis"@en;
                    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the top to the bottom and is perpendicular to the direction of the object's motion. For objects in Orbit, the Yaw Axis passes through the Barycenter of its Orbit."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000394 a owl:Class;
                    rdfs:label "Internal Combustion Engine"@en;
                    rdfs:subClassOf comcore:ont00000746;
                    skos:definition "A Combustion Engine that is designed to have an internal Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy that is then converted into mechanical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Internal_combustion_engine&oldid=1063281505"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000395 a owl:Class;
                    rdfs:label "Gain of Specifically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000554,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000020]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Dependent Continuant in which some Independent Continuant becomes the bearer of some Specifically Dependent Continuant."@en;
                    skos:example "A Person becomes pregnant (gain of quality), A person becomes forgetful (gain of disposition), A vehicle becomes amphibious (gain of function), A Person becomes a Database Administrator (gain of role).";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000396 a owl:Class;
                    rdfs:label "Extremely Low Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 1"@en;
                    skos:definition "A Radio Frequency that is between 3 and 30 Hz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 100,000–10,000 km"@en;
                    comcore:ont00001753 "ELF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000397 a owl:Class;
                    rdfs:label "Combustion Chamber"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:altLabel "Burner"@en,
                                  "Combustor"@en,
                                  "Flame Holder"@en;
                    skos:definition "A Material Artifact that is designed to wholly or partially bound an internal Site where a Combustion process is intended to occur."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000398 a owl:Class;
                    rdfs:label "Reference System"@en;
                    rdfs:subClassOf comcore:ont00000853;
                    skos:definition "A Descriptive Information Content Entity that describes a set of standards for organizing and understanding data of the specified type or domain."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000399 a owl:Class;
                    rdfs:label "Temporal Region Identifier"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000686
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom pobo:BFO_0000008]) ; 
                                         a owl:Class];
                    skos:definition "A Designative Information Content Entity that designates some Temporal Region."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000400 a owl:Class;
                    rdfs:label "Park"@en;
                    rdfs:subClassOf comcore:ont00001197;
                    skos:definition "An Anthropogenic Feature that is a bounded area of land, or water, usually in its natural or semi-natural (landscaped) state and set aside for some purpose, usually to do with recreation or conservation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Park&oldid=1061073992"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000401 a owl:Class;
                    rdfs:label "Fundamental Frequency"@en;
                    rdfs:subClassOf comcore:ont00000008;
                    skos:definition "A Sound Frequency that is the lowest Frequency of a Sound Wave."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000402 a owl:Class;
                    rdfs:label "Act of Communication"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which some Information Content Entity is transferred from some Agent to Another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication&oldid=1063752020"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000403 a owl:Class;
                    rdfs:label "Diffraction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a diffraction event in which the Material Artifact forces a wave to bend around the corners of an obstacle or aperture into the region of geometrical shadow of the obstacle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000404 a owl:Class;
                    rdfs:label "Iris"@en;
                    rdfs:subClassOf comcore:ont00000084,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000500];
                    skos:definition "A Bodily Component that consists of the part of an Eye that is a pigmented, round, contractile membrane, suspended between the cornea and lens and perforated by the pupil, and which canonically regulates the amount of light entering the Eye."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/iris";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000405 a owl:Class;
                    rdfs:label "Second-Order Administrative Region"@en;
                    rdfs:subClassOf comcore:ont00001152,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000126];
                    skos:definition "A Government Domain that is a subdivision of a First-Order Administrative Region."@en;
                    comcore:ont00001754 "http://www.geonames.org/export/codes.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000406 a owl:Class;
                    rdfs:label "Measurement Unit of Geocoordinate"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit specifying the geospatial coordinates of a location."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000407 a owl:Class;
                    rdfs:label "Electrical Resistance Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:definition "An Electrical Artifact Function that is realized in processes in which a Material Artifact opposes the flow of an electric current."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electrical_resistivity_and_conductivity&oldid=1063749049"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000408 a owl:Class;
                    rdfs:label "Government Organization"@en;
                    rdfs:subClassOf comcore:ont00001180,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00001335];
                    skos:definition "An Organization that is part of a Government and is responsible for the oversight or administration of specific governmental functions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000409 a owl:Class;
                    rdfs:label "Spark Ignition System"@en;
                    rdfs:subClassOf comcore:ont00000742;
                    skos:definition "An Ignition System that is designed to produce a spark in order to initiate an Ignition process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000410 a owl:Class;
                    rdfs:label "Residential Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to house one or more Persons."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Residence&oldid=1019728937"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000411 a owl:Class;
                    rdfs:label "Speed Measurement Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001100;
                    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Speed of a specified object's or class of objects' Motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000412 a owl:Class;
                    rdfs:label "Oxidizer Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which electrons are removed from a reactant in a redox reaction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Redox&oldid=1063866348"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000413 a owl:Class;
                    rdfs:label "Electron Microscope"@en;
                    rdfs:subClassOf comcore:ont00000304;
                    skos:definition "A Microscope that is designed to use a beam of accelerated electrons to illuminate the target and produce a significantly enlarged image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electron_microscope&oldid=1060512240"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000414 a owl:Class;
                    rdfs:label "Square Waveform"@en;
                    rdfs:subClassOf comcore:ont00001286;
                    skos:definition "A Waveform that is characterized by a square shape due to the near-instantaneous transitions between minimum and maximum Amplitudes of the Wave Cycle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000415 a owl:Class;
                    rdfs:label "Anti-Microbial Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000828;
                    skos:definition "A Pesticide Artifact Function that is realized in a process which causes illness in, or the death of, a microorganism."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antimicrobial&oldid=1064100151"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000416 a owl:Class;
                    rdfs:label "Act of Publishing Mass Media Press Release"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000417 a owl:Class;
                    rdfs:label "Prosthetic Hand"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace a missing hand."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000418 a owl:Class;
                    rdfs:label "Biographical Life"@en;
                    rdfs:subClassOf comcore:ont00000005;
                    skos:definition "An Act composed of the Life Events that occur during the course of existence of an Agent (i.e. Person or Organization)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000419 a owl:Class;
                    rdfs:label "Part Number"@en;
                    rdfs:subClassOf comcore:ont00000077;
                    skos:definition "A Code Identifier that designates a type of part whose instances are designed to be part of some Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000420 a owl:Class;
                    rdfs:label "Computer"@en;
                    rdfs:subClassOf comcore:ont00000117;
                    skos:definition "An Information Processing Artifact that is designed to execute an arbitrary set of arithmetic or logical operations automatically."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Computer&oldid=1061553332"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000421 a owl:Class;
                    rdfs:label "Nuclear Power Plant"@en;
                    rdfs:subClassOf comcore:ont00000330;
                    skos:definition "A Thermal Power Plant that is designed to produce heat by means of a nuclear reactor, which is then converted to electrical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nuclear_power_plant&oldid=1062752651"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000422 a owl:Class;
                    rdfs:label "Communication Reception Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to receive information that has been transmitted for the purpose of communiction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000423 a owl:Class;
                    rdfs:label "Motor Vehicle Manufacturing Facility"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed to manufacture automobiles."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Automotive_industry&oldid=1061661751"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000424 a owl:Class;
                    rdfs:label "Sharp"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a fine point or thin edge."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000425 a owl:Class;
                    rdfs:label "Gregorian Year"@en;
                    rdfs:subClassOf comcore:ont00000674;
                    skos:definition "A Calendar Year in the Gregorian Calendar."@en;
                    skos:scopeNote "A Gregorian Year begins concurrently with January 1, ends concurrently with December 31, and has an average duration of exactly 365.2425 Gregorian Days. The Gregorian Year is based upon the vernal equinox year. Unless otherwise stated, instances of Calendar Year are assumed to be instances of Gregorian Year since the Gregorian Calendar is the most widely used civil Calendar System."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000426 a owl:Class;
                    rdfs:label "Military Personnel Force"@en;
                    rdfs:subClassOf comcore:ont00000274;
                    skos:definition "An Armed Force authorized to use deadly force, and weapons, to support the interests of the Government and some or all of its Citizens."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000427 a owl:Class;
                    rdfs:label "Armored Fighting Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000053;
                    skos:definition "A Ground Motor Vehicle that is designed to be armored and used to transport and support military personal in combat missions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Armoured_fighting_vehicle&oldid=1063212018"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000428 a owl:Class;
                    rdfs:label "Railway Junction"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to enable a Train to switch between the tracks of two routes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Junction_(rail)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000430 a owl:Class;
                    rdfs:label "Stable Orientation"@en;
                    rdfs:subClassOf comcore:ont00000850;
                    skos:definition "A Stasis of Quality that holds during a Temporal Interval when an object maintains the same Spatial Orientation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000431 a owl:Class;
                    rdfs:label "External Combustion Engine"@en;
                    rdfs:subClassOf comcore:ont00000746;
                    skos:definition "A Combustion Engine that is designed to have an external Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy to heat the working fluid, which transfers energy to the Engine where it is converted into mechanical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=External_combustion_engine&oldid=1063941809"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000432 a owl:Class;
                    rdfs:label "Missile Launch Site"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed for storing and launching missiles."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Missile_launch_facility&oldid=1062709375"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000433 a owl:Class;
                    rdfs:label "Act of Association"@en;
                    rdfs:subClassOf comcore:ont00001327;
                    skos:definition "A Social Act wherein an Agent unites with some other Agent in a Planned Act, enterprise or business."@en;
                    comcore:ont00001754 "http://en.wiktionary.org/wiki/associate";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000434 a owl:Class;
                    rdfs:label "Simple Optical Lens"@en;
                    rdfs:subClassOf comcore:ont00001207;
                    skos:definition "An Optical Lens consisting of a single piece of transparent material."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000435 a owl:Class;
                    rdfs:label "Gregorian Day"@en;
                    rdfs:subClassOf comcore:ont00000921;
                    skos:definition "A Calendar Day in the Gregorian Calendar."@en;
                    skos:scopeNote "A Gregorian Day is twenty-four Hours in duration."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000436 a owl:Class;
                    rdfs:label "X-ray Microscope"@en;
                    rdfs:subClassOf comcore:ont00000304;
                    skos:definition "A Microscope that is designed to use Electromagnetic Radiation in the soft X-ray band to produce a significantly enlarged image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_microscope&oldid=1046169107"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000437 a owl:Class;
                    rdfs:label "Enhancing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes of intensifying, increainsg, or further improving the quality, value, or extent of some entity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Enhancement&oldid=1003326590"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000438 a owl:Class;
                    rdfs:label "Act of Official Documentation"@en;
                    rdfs:subClassOf comcore:ont00001374;
                    skos:definition "An Act of Declarative Communication in which an Agent records some information for official use by another Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000439 a owl:Class;
                    rdfs:label "Black"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that lacks any hues as parts."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000440 a owl:Class;
                    rdfs:label "Watercraft"@en;
                    rdfs:subClassOf comcore:ont00000713;
                    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by water travel."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Watercraft&oldid=1054071067"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000441 a owl:Class;
                    rdfs:label "Temperature"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000442 a owl:Class;
                    rdfs:label "Radioactive"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of that bearer exhibiting or being caused by radioactivity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000443 a owl:Class;
                    rdfs:label "Commercial Organization"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001180
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000485]) ; 
                                         a owl:Class];
                    skos:definition "An Organization that is the bearer of a Commercial Role and whose primary objective is to make a profit from the provision of goods or services."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000444 a owl:Class;
                    rdfs:label "Measurement Unit of Energy"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the Amount of work that is available in an object."@en;
                    skos:example "ft-lbs, calorie, horsepower, kilowatt";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000445 a owl:Class;
                    rdfs:label "Weapon"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to destroy or inflict damage to structures or systems, or to kill or wound living things by creating specific lethal or nonlethal effects."@en;
                    skos:scopeNote "Nonlethal effects include all outcomes short of death or destruction. This is captured by the fact that Damaged Stasis and Wounded Stasis are defined in terms of impairment of the Independent Continuant that participates in them."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Weapon&oldid=1143263715"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000446 a owl:Class;
                    rdfs:label "Circumference"@en;
                    rdfs:subClassOf comcore:ont00001293;
                    skos:definition "A Perimeter that inheres in a circle or ellipse."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000447 a owl:Class;
                    rdfs:label "Triangular"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of it having exactly three angles and exactly three sides."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000448 a owl:Class;
                    rdfs:label "Motion Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which an entity changes its position with respect to time."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Motion_(physics)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000449 a owl:Class;
                    rdfs:label "Act of Remuneration"@en;
                    rdfs:subClassOf comcore:ont00001334;
                    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Employer) to compensate another Agent (the Employee) for the services they perform for the Employer."@en;
                    skos:scopeNote "Comment: Remuneration normally consists of salary or hourly wages, but also applies to commission, stock options, fringe benefits, etc."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Remuneration&oldid=1033306001"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000450 a owl:Class;
                    rdfs:label "Silver Color"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that resembles Grey with the added feature of having a metallic shine."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000451 a owl:Class;
                    rdfs:label "Collimation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a collimation event in which the Material Artifact narrows a beam of particles or waves by either causing the spatial cross-section of the beam to become smaller or by causing the directions of motion of the beam's constituents to be aligned in a specifc direction of Motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000452 a owl:Class;
                    rdfs:label "Timekeeping Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to keep track of and report the current time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000453 a owl:Class;
                    rdfs:label "Environment Control System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to control the temperature, air quality, or other feature of a Site that is relevant to the comfort or operation of entities located within that Site."@en;
                    skos:scopeNote "Controlling air quality typically involves temperature control, oxygen replenishment, and removal of moisture, odor, smoke, heat, dust, airborne bacteria, carbon dioxide, and other undesired gases or particulates."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000454 a owl:Class;
                    rdfs:label "Compression Ignition System"@en;
                    rdfs:subClassOf comcore:ont00000742;
                    skos:definition "An Ignition System that is designed to generate heat by compressing a portion of fuel and oxidizer mixture in order to initiate an Ignition process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000455 a owl:Class;
                    rdfs:label "Act of Ceremony"@en;
                    rdfs:subClassOf comcore:ont00001327;
                    skos:definition "A Social Act of ritual significance, performed on a special occasion."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ceremony&oldid=1064081855"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000456 a owl:Class;
                    rdfs:label "Railway"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to enable Trains to transport passengers and goods."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rail_transport&oldid=1063793805";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000457 a owl:Class;
                    rdfs:label "Portion of Material"@en;
                    rdfs:subClassOf comcore:ont00001084;
                    skos:definition "A Portion of Processed Material that was produced to be used as the input for another Act of Material Artifact Processing."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000458 a owl:Class;
                    rdfs:label "Coupling"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to connect two Shafts together at their ends for the purpose of transmitting power."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Coupling&oldid=1055718683"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000459 a owl:Class;
                    rdfs:label "Fluorescence"@en;
                    rdfs:subClassOf comcore:ont00001126;
                    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light while absorbing shorter wavelength radiation, but not after."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fluorescence&oldid=1061358510"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000460 a owl:Class;
                    rdfs:label "Local Administrative Region"@en;
                    rdfs:subClassOf comcore:ont00001152;
                    skos:altLabel "Locality"@en;
                    skos:definition "A Government Domain that delimits a local Government."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000462 a owl:Class;
                    rdfs:label "Gain of Function"@en;
                    rdfs:subClassOf comcore:ont00000609,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000034]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Disposition in which some Independent Continuant becomes the bearer of some Function."@en;
                    skos:scopeNote "This class should be used to demarcate the start of the temporal interval (through the BFO 'occupies temporal region' property) that the Entity bears the Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000463 a owl:Class;
                    rdfs:label "Act of Educational Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00001075;
                    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Educational Organization by imparting knowledge of a curriculum to an Agent either directly or indirectly through some communication medium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000464 a owl:Class;
                    rdfs:label "Oblong"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having an long thin shape with approximately parallel sides."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000465 a owl:Class;
                    rdfs:label "Modified Julian Date"@en;
                    rdfs:subClassOf comcore:ont00000223;
                    skos:definition "A Time of Day as specified according to the Julian Calendar using the Modified Julian Date epoch."@en;
                    skos:scopeNote """A Day begins at midnight GMT within the Modified Julian Date reference system. The Modified Julian Date (MJD) is related to the Julian Date (JD) by the formula:
MJD = JD - 2400000.5"""@en;
                    comcore:ont00001753 "MJD";
                    comcore:ont00001754 "http://aa.usno.navy.mil/data/docs/JulianDate.php";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000466 a owl:Class;
                    rdfs:label "Orientation Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to control the Orientation of some object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000467 a owl:Class;
                    rdfs:label "Armored Personnel Carrier"@en;
                    rdfs:subClassOf comcore:ont00000427;
                    skos:definition "An Armored Fighting Vehicle that is designed to transport infantry to the battlefield but which are not usually designed to take part in a direct-fire battle."@en;
                    comcore:ont00001753 "APC";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Armoured_personnel_carrier&oldid=1061608326"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000468 a owl:Class;
                    rdfs:label "Office Building"@en;
                    rdfs:subClassOf comcore:ont00001102;
                    skos:definition "A Commercial Facility that is designed as an environment for conducting commercial, professional, or bureaucratic work."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Office&oldid=1063508719"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000469 a owl:Class;
                    rdfs:label "Geospatial Coordinate Reference System"@en;
                    rdfs:subClassOf comcore:ont00000275;
                    skos:altLabel "Geographic Coordinate System"@en;
                    skos:definition "A Spatial Reference System that is used to determine and identify the location of a point or object at or near the surface of the Earth."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000470 a owl:Class;
                    rdfs:label "Material Copy of a Academic Degree"@en;
                    rdfs:subClassOf comcore:ont00000189,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002003];
                    skos:altLabel "Academic Degree"@en;
                    skos:definition "A Material Copy of a Certificate that is issued by an Educational Organization to a Person to indicate that the Person has satisfactorily completed a course of study, or as an honorary recognition of the Person's achievement."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/degree";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000471 a owl:Class;
                    rdfs:label "Material Copy of a Warning Message"@en;
                    rdfs:subClassOf comcore:ont00001046,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002011];
                    skos:altLabel "Warning Message"@en;
                    skos:definition "A Material Copy of a Notification Message that is designed to carry an Information Content Entity that describes a possible or impending threat."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000472 a owl:Class;
                    rdfs:label "Geospatial Region"@en;
                    rdfs:subClassOf pobo:BFO_0000029;
                    skos:definition "A Site that is at or near the surface of the Earth."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000473 a owl:Class;
                    rdfs:label "Fourth-Order Administrative Region"@en;
                    rdfs:subClassOf comcore:ont00001152,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000134];
                    skos:definition "A Government Domain that is a subdivision of a Third-Order Administrative Region."@en;
                    comcore:ont00001754 "http://www.geonames.org/export/codes.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000474 a owl:Class;
                    rdfs:label "Curved"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having borders which are smoothly rounded."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000475 a owl:Class;
                    rdfs:label "Portion of Cash"@en;
                    rdfs:subClassOf comcore:ont00000537;
                    skos:definition "A Financial Instrument that is designed to be a ready medium of exchange."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000476 a owl:Class;
                    rdfs:label "Objective"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    skos:definition "A Prescriptive Information Content Entity that prescribes some projected state that some Agent intends to achieve."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Objective_(goal)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000477 a owl:Class;
                    rdfs:label "Fuel Cell"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that consists in part of an anode, a cathode, and an electrolyte; converts chemical energy from a fuel into electricity through a chemical reaction of positively charged hydrogen ions with an oxidizing agent (typically oxygen); and, if given a continuous source of fuel and oxidizing agent, can continuously produce electricity."@en;
                    skos:scopeNote "A Fuel Cell differs from a Battery in that it requires a continuous source of fuel and oxygen to sustain the chemical reaction, whereas a Battery only uses chemicals already stored inside it."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fuel_cell&oldid=1063586731"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000478 a owl:Class;
                    rdfs:label "Cuboidal"@en;
                    rdfs:subClassOf comcore:ont00001360;
                    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having six Rectangular faces."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000479 a owl:Class;
                    rdfs:label "Public Safety Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for the prevention of and protection from events that could endanger, injure, or damage the general public."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_security&oldid=1058257389"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000480 a owl:Class;
                    rdfs:label "Life Support Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact materially affects an organism, where this causes that organism to continue living in a situation where death would otherwise occur."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000481 a owl:Class;
                    rdfs:label "Research and Development Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of producing new knowledge or of devising new applications of existing knowledge."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Research_and_development&oldid=1062181110"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000482 a owl:Class;
                    rdfs:label "Synthetic Aperture Radar Imaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000289;
                    skos:definition "A Radar Imaging Artifact Function that inheres in Material Artifacts that are designed to produce visual representations of entities using the motion of a radar antenna over a targeted region to create a synthetic aperture."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000483 a owl:Class;
                    rdfs:label "Military Base"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed to shelter military equipment and personnel and to facilitate training and operations."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military_base&oldid=1047077734"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000484 a owl:Class;
                    rdfs:label "Concave Shape"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer having one or more cavities, such that at least one line connecting a pair of points on the surface of the bearer will lie outside."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000485 a owl:Class;
                    rdfs:label "Commercial Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Organization by virtue of its establishment as a for-profit business."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000486 a owl:Class;
                    rdfs:label "Neutral Role"@en;
                    rdfs:subClassOf comcore:ont00000392;
                    skos:definition "An Allegiance Role that inheres in an Agent by virtue of that Agent not performing or being committed to performing Acts that have as their Objective to either support or undermine the Objectives of an Agent or Group of Agents involved in some conflict."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000487 a owl:Class;
                    rdfs:label "Geospatial Location"@en;
                    rdfs:subClassOf comcore:ont00000472;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000472
                                                             [a owl:Class ; 
                                                             owl:unionOf ([a owl:Restriction ; 
                                                                          owl:onProperty pobo:BFO_0000124 ; 
                                                                          owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                                                                  [a owl:Class ; 
                                                                                                                  owl:complementOf pobo:BFO_0000006]) ; 
                                                                                              a owl:Class]]
                                                                          [a owl:Restriction ; 
                                                                          owl:onProperty pobo:BFO_0000183 ; 
                                                                          owl:someValuesFrom pobo:BFO_0000015])]) ; 
                                         a owl:Class];
                    skos:definition "A Geospatial Region that is the location of an Independent Continuant (that is not a Spatial Region) or that environs some Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000488 a owl:Class;
                    rdfs:label "Tripod"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that consists of three legs and a platform that joins them and which is designed to support the weight and maintain the stability of objects that are attached to or rested on the platform."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tripod&oldid=1063988190"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000489 a owl:Class;
                    rdfs:label "High Density Residential Area"@en;
                    rdfs:subClassOf comcore:ont00000224;
                    skos:definition "A Populated Place which is characterized by densely contained multiple-unit living structures."@en;
                    comcore:ont00001754 "Anderson et. al. A Land Use and Land Cover Classification System for use with Remote Sensor Data, Geological Survey Professional Paper 964";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000490 a owl:Class;
                    rdfs:label "X-ray Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 30 petahertz and 30 exahertz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000491 a owl:Class;
                    rdfs:label "Detonating Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes of combustion involving a supersonic exothermic front accelerating through a medium that eventually drives a shock front propagating directly in front of it."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detonation&oldid=1061553336"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000492 a owl:Class;
                    rdfs:label "Email Messaging"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Emailing"@en;
                    skos:definition "An Act of Communication by Media in which text-based communication occurs between two or more people using personal computers or other devices using some Email Client Software conveyed over the Internet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000493 a owl:Class;
                    rdfs:label "Material Copy of a Code List"@en;
                    rdfs:subClassOf comcore:ont00000799,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002008];
                    skos:altLabel "Code List"@en;
                    skos:definition "A Material Copy of a List that contains an ordered sequence of Information Bearing Entities that carry Code Identifiers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000494 a owl:Class;
                    rdfs:label "Serrated"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having multiple sharp points along a edge."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000495 a owl:Class;
                    rdfs:label "Radio Communication Interference Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000273;
                    skos:definition "A Communication Interference Artifact Function that is realized during events in which a Material Artifact is used to interfere with the transmission of information via radio waves."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000496 a owl:Class;
                    rdfs:label "Natural Language"@en;
                    rdfs:subClassOf comcore:ont00001175;
                    skos:definition "A Language that is developed and evolves through use and repetition, rather than through conscious planning or premeditation."@en;
                    skos:example "English",
                                 "Mandarin (Chinese)",
                                 "Spanish";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Natural_language&oldid=1060890461"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000497 a owl:Class;
                    rdfs:label "Measurement Unit of Force"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of interactions in which the Motion or Velocity of an object is changed, unless the interaction is opposed."@en;
                    skos:example "newton, dyne, pound force ";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000498 a owl:Class;
                    rdfs:label "Julian Day"@en;
                    rdfs:subClassOf comcore:ont00000921;
                    skos:definition "A Calendar Day in the Julian Calendar."@en;
                    skos:scopeNote "A Julian Day begins at noon Universal Time and is twenty-four Hours in duration."@en;
                    comcore:ont00001754 "https://www.defit.org/julian-date/";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000499 a owl:Class;
                    rdfs:label "Wire Antenna"@en;
                    rdfs:subClassOf comcore:ont00001192;
                    skos:definition "A Radio Antenna that consists primarily of a length of wire."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000500 a owl:Class;
                    rdfs:label "Eye"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of an organ that canonically affords the Agent it is part of with the ability to receive visual stimuli necessary for sight."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000501 a owl:Class;
                    rdfs:label "Act of Financial Withdrawal"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent to another Agent (the Depositor) from an account created by an earlier Act of Financial Deposit performed by the Depositor."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Deposit_(bank)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000502 a owl:Class;
                    rdfs:label "Measurement Unit of Area Moment of Inertia"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:altLabel "Measurement Unit of Second Area Moment"@en;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to an axis."@en;
                    skos:scopeNote "A measure of an object’s resistance to bending or deflection."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000503 a owl:Class;
                    rdfs:label "Power"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    skos:definition "A Process Profile that is characterized by the rate of Work, or Energy consumed, done in a given time period."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000504 a owl:Class;
                    rdfs:label "Optical Processing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a visible light processing event."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000506 a owl:Class;
                    rdfs:label "Contractor Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent or Group of Agents by virtue of that Agent or Group of Agents entering into a Contract to provide materials or labor to perform a service or complete a task."@en;
                    skos:scopeNote "A Contractor Role differs from an Occupation Role in at least two ways. First, the Contract that binds the two parties together is not one of employment. Second, a Contractor Role is occupationally neutral in that an Agent can be contracted to perform any number of Occupational Roles."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000507 a owl:Class;
                    rdfs:label "Ethnic Group"@en;
                    rdfs:subClassOf comcore:ont00000914,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001907 ; 
                                     owl:someValuesFrom comcore:ont00000780];
                    skos:definition "A Group of Persons who identify with one another based on one or more shared inherited characteristics such as language, ancestry, nationality, culture, customs, religion, or social experiences."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ethnic_group&oldid=1063804490"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000508 a owl:Class;
                    rdfs:label "Near Ultraviolet Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00000610;
                    skos:definition "An Ultraviolet Light Frequency that is between 750 terahertz and 3 petahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000509 a owl:Class;
                    rdfs:label "Service Provider"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    skos:definition "An Organization whose purpose is to provide a service to other Agents."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Service_provider&oldid=1059415018"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000510 a owl:Class;
                    rdfs:label "Mosque"@en;
                    rdfs:subClassOf comcore:ont00000052;
                    skos:definition "A Religious Facility that is designed for Islamic worship and prayer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mosque&oldid=1062609892"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000511 a owl:Class;
                    rdfs:label "Act of Planning"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act that involves making a Plan to achieve some specified Objective."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000512 a owl:Class;
                    rdfs:label "Radiation Emissivity"@en;
                    rdfs:subClassOf comcore:ont00000628;
                    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to emit electromagnetic radiation of a given frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000513 a owl:Class;
                    rdfs:label "Act of Tool Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Tool."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000514 a owl:Class;
                    rdfs:label "Transverse Wave Profile"@en;
                    rdfs:subClassOf comcore:ont00000752;
                    skos:altLabel "Transverse Wave"@en;
                    skos:definition "A Wave Process Profile in which the displacement of participating particles is perpendicular to the direction of the Wave Process' propogation."@en;
                    comcore:ont00001754 "http://www.acs.psu.edu/drussell/Demos/waves/wavemotion.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000515 a owl:Class;
                    rdfs:label "Act of Vehicle Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Vehicle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000516 a owl:Class;
                    rdfs:label "Pneumatic Power Source"@en;
                    rdfs:subClassOf comcore:ont00000288;
                    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of compressed air or compressed inert gases."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000517 a owl:Class;
                    rdfs:label "Act of Communication by Media"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication in which some Material Artifact is used to transfer an Information Bearing Entity from sender(s) to receiver(s)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000518 a owl:Class;
                    rdfs:label "Measurement Unit of Currency"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit used in measurements of financial values."@en;
                    skos:example "U.S. Dollar, Euro, Yuan, South African Rand";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00000519 a owl:Class;
                    rdfs:label "Extremely High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000732;
                    skos:altLabel "ITU Band Number 11"@en,
                                  "Millimeter Band Frequency"@en;
                    skos:definition "A Microwave Frequency that is between 30 and 300 GHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 10–1 mm"@en;
                    comcore:ont00001753 "EHF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000520 a owl:Class;
                    rdfs:label "Act of Departure"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change that consists of the participating entity leaving its starting location such that the larger Act of Location Change is initiated."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000521 a owl:Class;
                    rdfs:label "Act of Assassination"@en;
                    rdfs:subClassOf comcore:ont00001272;
                    skos:definition "An Act of Murder of a prominent person."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000522 a owl:Class;
                    rdfs:label "Pulsejet Engine"@en;
                    rdfs:subClassOf comcore:ont00000294;
                    skos:altLabel "Pulse Jet"@en,
                                  "Pulsejet"@en;
                    skos:definition "An Air-Breathing Jet Engine that is capable of operating statically and uses intermittent (pulsing) Combustion of the fuel-oxidizer mixture before expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pulsejet&oldid=1050473545"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000523 a owl:Class;
                    rdfs:label "Loudness"@en;
                    rdfs:subClassOf comcore:ont00000862;
                    skos:definition "A Sound Process Profile that is characterized by the amplitude and total energy of translated sound waves, typically on a continuum from soft to loud."@en;
                    comcore:ont00001754 "https://byjus.com/physics/loudness-of-sound/"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000524 a owl:Class;
                    rdfs:label "Air Conditioning Unit"@en;
                    rdfs:subClassOf comcore:ont00000350;
                    skos:altLabel "AC Unit"@en;
                    skos:definition "A Cooling System that is designed to remove excess heat and humidity from the air in an enclosed space."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Air_conditioning&oldid=1063494896"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000525 a owl:Class;
                    rdfs:label "Transparent"@en;
                    rdfs:subClassOf comcore:ont00001384;
                    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's capacity to transmit all or nearly all electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs little or no electromagnetic radiation of that frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000526 a owl:Class;
                    rdfs:label "Gamma-ray Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Gamma-rays to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telescope&oldid=1057722342"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000527 a owl:Class;
                    rdfs:label "Measurement Unit of Rotational Inertia"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:altLabel "Measurement Unit of Moment of Inertia"@en,
                                  "Measurement Unit of Rotational Mass"@en;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the distribution of Mass of an object with respect to its axis of rotation."@en;
                    skos:scopeNote "A measure of an object’s resistance to change in its state of rotation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000528 a owl:Class;
                    rdfs:label "White"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color of maximum brightness, the color of objects that reflect nearly all wavelengths of the visible light spectrum, thus considered achromatic."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000529 a owl:Class;
                    rdfs:label "Date Identifier"@en;
                    rdfs:subClassOf comcore:ont00000073;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000073
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom comcore:ont00000800]) ; 
                                         a owl:Class];
                    skos:altLabel "Day Identifier"@en;
                    skos:definition "A Temporal Interval Identifier that designates some Day."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000530 a owl:Class;
                    rdfs:label "Sonic Frequency"@en;
                    rdfs:subClassOf comcore:ont00000008;
                    skos:altLabel "Audible Frequency"@en;
                    skos:definition "A Sound Frequency that is between 20 Hz and 20 kHz."@en;
                    skos:scopeNote "Sound waves with frequencies in this range are typically audible to humans."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000531 a owl:Class;
                    rdfs:label "Communications Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to support processes of receiving or transmitting information."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000532 dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023.";
                    dcterms:created "2023-02-08T19:54:46-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Government of a Country"@en;
                    rdfs:subClassOf comcore:ont00001335;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001335
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001859 ; 
                                                             owl:someValuesFrom comcore:ont00000139]) ; 
                                         a owl:Class];
                    skos:definition "A Government that has legitimate authority within and is delimited by a Domain of a Country."@en;
                    skos:prefLabel "Government of a Country"@en;
                    comcore:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000533 a owl:Class;
                    rdfs:label "Jet Engine"@en;
                    rdfs:subClassOf comcore:ont00000056;
                    skos:definition "A Reaction Engine that discharges a fast moving jet that generates Thrust by jet propulsion."@en;
                    skos:scopeNote "Some (most) jet engines utilize turbines, but some do not. Most rocket engines do not utilize turbines, but some do."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Jet_engine&oldid=1060157063"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000534 a owl:Class;
                    rdfs:label "Cutting Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001153;
                    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired by being opened or divided."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/cutting";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000535 a owl:Class;
                    rdfs:label "Decrease of Quality"@en;
                    rdfs:subClassOf comcore:ont00000290;
                    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Quality that it bears."@en;
                    skos:example "Weight Loss, Decreasing Temperature, decreasing color intensity, loss of structural integrity";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000536 a owl:Class;
                    rdfs:label "Bond Certificate"@en;
                    rdfs:subClassOf comcore:ont00001159;
                    skos:definition "A Bond that consists of a Certificate."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000537 a owl:Class;
                    rdfs:label "Financial Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to be a tradeable asset and that is legally sanctioned."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000538 a owl:Class;
                    rdfs:label "Defoliant Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000831;
                    skos:definition "An Herbicide Artifact Function that is realized in a process that causes a plant to lose its leaves."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Defoliant&oldid=1059494225"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000539 a owl:Class;
                    rdfs:label "Count Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001022;
                    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of the number of members of some aggregate."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000540 a owl:Class;
                    rdfs:label "Temporal Instant Identifier"@en;
                    rdfs:subClassOf comcore:ont00000399;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000399
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom pobo:BFO_0000203]) ; 
                                         a owl:Class];
                    skos:altLabel "Zero-Dimensional Temporal Region Identifier"@en;
                    skos:definition "A Temporal Region Identifier that designates some Temporal Instant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000541 a owl:Class;
                    rdfs:label "Diameter"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a circle in virtue of the extent of a straight line that passes through the center of the circle and starts and ends on the circle's boundary."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000542 a owl:Class;
                    rdfs:label "Loss of Generically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000876;
                    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the carrier of some Generically Dependent Continuant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000543 a owl:Class;
                    rdfs:label "Decrease of Disposition"@en;
                    rdfs:subClassOf comcore:ont00000854;
                    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Disposition it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000544 a owl:Class;
                    rdfs:label "Target"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001936 ; 
                                                             owl:someValuesFrom comcore:ont00000741]) ; 
                                         a owl:Class];
                    skos:definition "A Material Entity that is the object of an Act of Targeting."@en;
                    skos:scopeNote "Although people speak of targeting a process, say, a parade, what in fact are being targeted are the material participants of that process. The disruption or ceasing of the process is the objective of some plan, but not technically a target. Only material things can be targeted for action. Even if some dependent entity is described as being the target, the material thing for which that dependent entity depends is the object of a targeting process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000545 a owl:Class;
                    rdfs:label "Seat of Local Government"@en;
                    rdfs:subClassOf comcore:ont00000946;
                    skos:altLabel "City Hall"@en,
                                  "Town Hall"@en;
                    skos:definition "A Government Building that is designed for the administration of a local community."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Seat_of_government&oldid=1063047501"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000546 a owl:Class;
                    rdfs:label "Unplanned Act"@en;
                    rdfs:subClassOf comcore:ont00000005;
                    skos:altLabel "Unintentional Act"@en;
                    skos:definition "An Act in which at least one Agent plays a causative role and which is not prescribed by some Objective held by any of the Agents."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000547 a owl:Class;
                    rdfs:label "Telescope"@en;
                    rdfs:subClassOf comcore:ont00000771;
                    skos:definition "An Imaging Instrument that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing Electromagnetic Radiation to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telescope&oldid=1057722342"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000548 dcterms:bibliographicCitation "Vulnerability | Definition of Vulnerability by Oxford Dictionary on Lexico.Com Also Meaning of Vulnerability. https://web.archive.org/web/20210118111731/https://www.lexico.com/en/definition/vulnerability. Accessed 19 Dec. 2022. ";
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Vulnerability"@en;
                    rdfs:subClassOf comcore:ont00000997;
                    skos:definition "A Disrupting Disposition the realization of which would disrupt a process that the bearer of the Disrupting Disposition has an interest in."@en;
                    skos:editorialNote "This is defined class. A Vulnerability is indexed by the interest_in object property. A disposition can be a Vulnerability according to one index and not a Vulnerability according to another index.";
                    skos:prefLabel "Vulnerability"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000549 a owl:Class;
                    rdfs:label "Water Transportation Artifact"@en;
                    rdfs:subClassOf comcore:ont00000254;
                    skos:definition "A Transportation Artifact that facilitates the movement of Agents and Vehicles via water."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000550 a owl:Class;
                    rdfs:label "Morning"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun dawns (approximately 6:00am) and reaches its apex (approximately 12:00pm)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000551 a owl:Class;
                    rdfs:label "Organism"@en;
                    rdfs:subClassOf pobo:BFO_0000030;
                    skos:definition "An Object that is an Animal or Plant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000552 a owl:Class;
                    rdfs:label "Explosive Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000196 ; 
                                     owl:someValuesFrom comcore:ont00000841];
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of a violent release of energy caused by the exothermic reaction of an explosive material."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Explosive_weapon&oldid=1062481268"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000553 a owl:Class;
                    rdfs:label "Process Prohibition"@en;
                    rdfs:subClassOf comcore:ont00001324;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001324
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001800 ; 
                                                             owl:someValuesFrom pobo:BFO_0000015]) ; 
                                         a owl:Class];
                    skos:definition "A Process Regulation that prohibits some Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000554 a owl:Class;
                    rdfs:label "Gain of Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000004;
                    skos:definition "A Change in which an Independent Continuant becomes the bearer or carrier of some Dependent Continuant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000555 a owl:Class;
                    rdfs:label "Enhanced Stasis"@en;
                    rdfs:subClassOf comcore:ont00000135;
                    skos:altLabel "Enhanced"@en;
                    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has undergone improvement (i.e., an increase or gain) due to a previous action or event such that the Independent Continuant is now of greater value, usefulness, or functionality."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/enhance";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000556 a owl:Class;
                    rdfs:label "Payload"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    skos:definition "A Material Entity that is transported by a Vehicle during an Act of Location Change for the purpose of being delivered to or performing one or more functions at a predefined location."@en;
                    skos:scopeNote "Depending on the nature of the Flight or Mission, the Payload of a Vehicle may include cargo, passengers, flight crew, munitions, scientific instruments or experiments, or other equipment. Extra fuel, when optionally carried, is also considered part of the payload."@en,
                                   "In each case, the Payload is what provides the immediate reason for performing the Act of Location Change (e.g. transporting the passengers of a commercial airline flight to their destination; transporting food, fuel, oxygen, research equipment, and spare parts to the International Space Station; or conveying an array of sensors, cameras, and communications systems so they can operate during a Sun-Synchronous Earth Orbit)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Payload&oldid=1035953573"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000557 a owl:Class;
                    rdfs:label "Stasis of Non-Mission Capable"@en;
                    rdfs:subClassOf comcore:ont00001132;
                    skos:definition "A Stasis of Mission Capability during which the participating Continuant is not capable of performing any of its primary functions for the specified Mission."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000558 a owl:Class;
                    rdfs:label "Visible Light Reflection Process"@en;
                    rdfs:subClassOf comcore:ont00000099;
                    skos:definition "A Wave Process in which an Electromagnetic Wave with a Visible Light Frequency is reflected off a portion of matter."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000560 a owl:Class;
                    rdfs:label "Cone Shape"@en;
                    rdfs:subClassOf comcore:ont00001360;
                    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a Round base that tapers smoothly to an apex."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cone&oldid=1058362269"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000561 a owl:Class;
                    rdfs:label "Dam"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to impound surface water or underground streams."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Dam&oldid=1053601756";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000562 a owl:Class;
                    rdfs:label "Animal"@en;
                    rdfs:subClassOf comcore:ont00000551;
                    skos:definition "An Organism that is multicellular, eukaryotic, heterotrophic, and capable of motility for part of its life."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Animal&oldid=1063873549"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000563 a owl:Class;
                    rdfs:label "Hydrographic Feature"@en;
                    rdfs:subClassOf comcore:ont00001081;
                    skos:definition "A Geographic Feature associated with water."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000564 a owl:Class;
                    rdfs:label "Educational Organization"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    skos:definition "An Organization whose primary purpose is to provide training or otherwise facilitate learning or the acquisition of knowledge, Skills, values, beliefs, or habits."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000565 a owl:Class;
                    rdfs:label "Cube Shape"@en;
                    rdfs:subClassOf comcore:ont00000478;
                    skos:definition "A Cuboidal shape inhering in a bearer in virtue of it having six Square faces."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000566 a owl:Class;
                    rdfs:label "Act of Artifact Employment"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of using a Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000567 a owl:Class;
                    rdfs:label "Operational Area"@en;
                    rdfs:subClassOf comcore:ont00000487;
                    skos:definition "A Geospatial Location in which an Agent conducts some activity."@en;
                    skos:scopeNote "This is a general term that applies to both military and civilian activities, such as the Geospatial Region within which a company conducts its business."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000568 a owl:Class;
                    rdfs:label "Organization Capability"@en;
                    rdfs:subClassOf comcore:ont00001379;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001379
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001889 ; 
                                                             owl:someValuesFrom comcore:ont00001180]) ; 
                                         a owl:Class];
                    skos:definition "An Agent Capability that inheres in an Organization to the extent of that Organization's capacity to realize it in Intentional Acts of a certain type."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000569 a owl:Class;
                    rdfs:label "Sensor"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom [a owl:Class ; 
                                                                                 owl:unionOf (comcore:ont00001241
                                                                                              comcore:ont00002073)]]) ; 
                                         a owl:Class];
                    skos:definition "A Material Entity that bears a Sensor Function or Sensor Role."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sensor&oldid=1059883466"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000570 a owl:Class;
                    rdfs:label "Force"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    skos:definition "A Process Profile that is the rate of change of an object's Momentum, is the product of an object's Mass and Acceleration with respect to an inertial frame of reference, and is measured in units of Newtons (N)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000571 a owl:Class;
                    rdfs:label "Article of Solid Waste"@en;
                    rdfs:subClassOf comcore:ont00000980;
                    skos:definition "A Portion of Waste Material that has a low liquid content."@en;
                    comcore:ont00001754 "https://stats.oecd.org/glossary/detail.asp?ID=2508";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000572 a owl:Class;
                    rdfs:label "Sound Production"@en;
                    rdfs:subClassOf comcore:ont00000765;
                    skos:altLabel "Sound Production Process"@en;
                    skos:definition "A Wave Production Process that produces a Sound Wave."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000573 a owl:Class;
                    rdfs:label "Act of Religious Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000687;
                    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tenets and/or practices of a religion from an Agent or communication medium that realizes a capacity derived from its affiliation with a Religious Organization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000574 a owl:Class;
                    rdfs:label "Environmental Feature"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    skos:definition "A Material Entity that is either a natural or man-made feature of the environment."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000575 a owl:Class;
                    rdfs:label "Quality Specification"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000965
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001942 ; 
                                                             owl:someValuesFrom pobo:BFO_0000019]) ; 
                                         a owl:Class];
                    skos:definition "A Prescriptive Information Content Entity that prescribes some Quality."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000576 a owl:Class;
                    rdfs:label "Scalp"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of the skin covering the top of the head of a human or other animal."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000577 a owl:Class;
                    rdfs:label "Power Rectifier"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to convert alternating current (AC) to direct current (DC)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rectifier&oldid=1049943028"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000578 a owl:Class;
                    rdfs:label "Sloped"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border which is not level."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000579 a owl:Class;
                    rdfs:label "Thin"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Narrow"@en,
                                  "Slender"@en;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a width or depth which is significantly smaller in proportion to its length or height."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000580 a owl:Class;
                    rdfs:label "Sine Waveform"@en;
                    rdfs:subClassOf comcore:ont00001286;
                    skos:altLabel "Sinusoidal Waveform"@en;
                    skos:definition "A Waveform that is characterized by a smooth curved shape due to the continuous non-linear transitions between minimum and maximum Amplitudes of the Wave Cycle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000581 a owl:Class;
                    rdfs:label "Tool"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to assist in the performance of manual or mechanical work and not to be consumed in that process."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tool&oldid=1061967184"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000583 a owl:Class;
                    rdfs:label "Motel"@en;
                    rdfs:subClassOf comcore:ont00000180;
                    skos:definition "A Hotel that is designed to accommodate motor vehicles along with their occupants."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motel&oldid=1063898961"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000584 a owl:Class;
                    rdfs:label "Act of Position Change"@en;
                    rdfs:subClassOf comcore:ont00000357;
                    skos:definition "An Act of Motion in which the position (i.e. the orientation, alignment, or arrangement) of some Object or of one or more of an Object's parts is changed by some Agent."@en;
                    skos:example "a top spinning in place",
                                 "adjusting your posture",
                                 "raising your left arm",
                                 "swivelling your office chair to face the window";
                    skos:scopeNote "An Act of Position Change does not entail a change of location."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000585 a owl:Class;
                    rdfs:label "Sawtooth Waveform"@en;
                    rdfs:subClassOf comcore:ont00001286;
                    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from minimum to maximum Amplitudes followed by a near-instantaneous transition from the maximum to minimum Amplitudes of the Wave Cycle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000586 a owl:Class;
                    rdfs:label "Controllable Pitch Propeller"@en;
                    rdfs:subClassOf comcore:ont00000238;
                    skos:altLabel "Variable-Pitch Propeller"@en;
                    skos:definition "A Propeller whose blades are designed to be alterable by rotating the blades about their vertical axis by means of mechanical or hydraulic arrangement."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Variable-pitch_propeller&oldid=1041375492"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000587 a owl:Class;
                    rdfs:label "Ally Role"@en;
                    rdfs:subClassOf comcore:ont00000392;
                    skos:definition "An Allegiance Role that inheres in an Agent in virtue of that Agent's commitment to perform Acts that support the Objectives of a particular Agent or Group of Agents."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000588 a owl:Class;
                    rdfs:label "Act of Mass Media Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication intended to reach a large audience using a medium such as the internet, television, radio, newspaper, and magazine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Media&oldid=1062799283"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000589 a owl:Class;
                    rdfs:label "Julian Date Fraction"@en;
                    rdfs:subClassOf comcore:ont00000973;
                    skos:altLabel "Julian Date Time Identifier"@en,
                                  "Julian Day Fraction"@en;
                    skos:definition "A Decimal Time of Day Identifier that designates an approximate Temporal Instant that is part of some Julian Day."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000590 a owl:Class;
                    rdfs:label "Convex Shape"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line connecting a pair of points on the surface of the bearer will lie outside."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000591 a owl:Class;
                    rdfs:label "Artifact Location"@en;
                    rdfs:subClassOf pobo:BFO_0000029;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000029
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000124 ; 
                                                             owl:someValuesFrom comcore:ont00000995]) ; 
                                         a owl:Class];
                    skos:definition "A Site that is the location of some Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000592 a owl:Class;
                    rdfs:label "Veracity Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    skos:altLabel "Accuracy of Information"@en,
                                  "Trueness Measurement"@en,
                                  "Veracity Measurement"@en;
                    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which a description conforms to the reality it describes."@en;
                    skos:scopeNote "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en,
                                   "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information ('Veracity Measurement Information Content Entity'), and adherance-to-expectations (see: 'Deviation Measurement Information Content Entity')."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000593 a owl:Class;
                    rdfs:label "Portion of Propellant"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:definition "A Portion of Material that is designed to be used as an input in a Propulsion Process to produce Thrust."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000594 a owl:Class;
                    rdfs:label "Ignition Process"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:altLabel "Ignition"@en;
                    skos:definition "A Natural Process that initiates a Combustion process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000595 a owl:Class;
                    rdfs:label "Act of Cargo Transportation"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change wherein some Payload is moved from one location to another."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000597 a owl:Class;
                    rdfs:label "Material Copy of a Instrument Display Panel"@en;
                    rdfs:subClassOf comcore:ont00000798;
                    skos:altLabel "Instrument Display Panel"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry information about some Material Artifact that is derived by the instrumentation Sensors of that Material Artifact."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flight_instruments&oldid=1062972990"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000598 a owl:Class;
                    rdfs:label "Valve"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that is designed to regulate, direct, or control the flow of fluid by opening, closing, or partially obstructing the fluid from moving along a passageway."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Valve&oldid=1048906126"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000599 a owl:Class;
                    rdfs:label "Interpersonal Relationship Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in a Person in virtue of the obligations, expectations, or social norms that govern that Person's Intentional Acts within the context of a relationship with another Person."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000600 a owl:Class;
                    rdfs:label "Legal Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of giving legal advice to clients drafting legal documents for clients and representing clients in legal negotiations and court proceedings such as lawsuits."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Law&oldid=1060821734"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000601 a owl:Class;
                    rdfs:label "Imaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that inheres in Material Artifacts that are designed to create one or more new Images."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000603 a owl:Class;
                    rdfs:label "Navigation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to determine the precise location of itself or another object and plan a route to a specified destination."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000604 a owl:Class;
                    rdfs:label "Maximum Ordinal Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001010;
                    skos:definition "An Ordinal Measurement Information Content Entity that is a measurement of some entity in virtue of it being the largest or having the greatest amount relative to a nominally described set of like entities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000605 a owl:Class;
                    rdfs:label "Abbreviated Name"@en;
                    rdfs:subClassOf comcore:ont00000003;
                    skos:definition "A Designative Name that is a shortened form of a Proper Name."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000606 a owl:Class;
                    rdfs:label "Truck"@en;
                    rdfs:subClassOf comcore:ont00000053;
                    skos:definition "A Ground Motor Vehicle that is designed to be used to transport cargo."@en;
                    skos:scopeNote "Trucks vary greatly in their size and power -- ranging from small ultra-light trucks to enormous heavy trucks. Trucks also vary greatly in their configurations -- ranging from very basic flatbeds or box trucks to highly specialized cargo carriers. Trucks may also be configured to mount specialized equipment, such as in the case of fire trucks, concrete mixers, and suction excavators."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Truck&oldid=1060924486"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000607 a owl:Class;
                    rdfs:label "Thickness"@en;
                    rdfs:subClassOf comcore:ont00000892;
                    skos:definition "A Depth that inheres in a bearer in virtue of it extending inward through an object."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000608 a owl:Class;
                    rdfs:label "Financial Value"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A quality that inheres in an independent continuant to the degree that that independent continuant can serve as a medium of exchange in an economic system at a particular time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000609 a owl:Class;
                    rdfs:label "Gain of Disposition"@en;
                    rdfs:subClassOf comcore:ont00000642,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000016]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes the bearer of some Disposition."@en;
                    skos:scopeNote "This class should be used to demarcate the start of the temporal interval (through the BFO 'occupies temporal region' property) that the Entity bears the Disposition."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000610 a owl:Class;
                    rdfs:label "Ultraviolet Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 750 terahertz and 30 petahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000611 a owl:Class;
                    rdfs:label "Increase of Realizable Entity"@en;
                    rdfs:subClassOf comcore:ont00001214;
                    skos:definition "An Increase of Specifically Dependent Continuant in which some Independent Continuant has an increase of some Realizable Entity that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000612 a owl:Class;
                    rdfs:label "Act of Weapon Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Weapon."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000613 a owl:Class;
                    rdfs:label "Loss of Role"@en;
                    rdfs:subClassOf comcore:ont00000250;
                    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000614 a owl:Class;
                    rdfs:label "Mass"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the amount of matter in that bearer."@en;
                    skos:scopeNote "'Matter' here can also refer to the inertial energy of an object."@en,
                                   "Typical unit of measure is the kilogram or pound."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000615 a owl:Class;
                    rdfs:label "Act of Encounter"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association wherein two or more Persons meet in a casual or unplanned manner."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=encounter (Sense Key: Encounter%2:38:00)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000616 a owl:Class;
                    rdfs:label "Religion"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    skos:definition "An Information Content Entity that consists of a collection of claims about the meaning or origin of existence or about the existence or nature of one or more deities, an afterlife, or spiritual or sacred entities, and which is accepted as true by an Agent or Group of Agents."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/religion";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000617 a owl:Class;
                    rdfs:label "Infrared Camera"@en;
                    rdfs:subClassOf comcore:ont00000199;
                    skos:altLabel "Thermal Imaging Camera"@en,
                                  "Thermographic Camera"@en;
                    skos:definition "A Camera that is designed to form and record an image generated from infrared radiation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermographic_camera&oldid=1063916009"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000618 a owl:Class;
                    rdfs:label "Ground Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000713;
                    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by some form of ground travel."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Category:Land_vehicles&oldid=546083623"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000619 a owl:Class;
                    rdfs:label "Week"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00000225];
                    skos:definition "A Temporal Interval that is equal to seven consecutive Days."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=week";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000620 a owl:Class;
                    rdfs:label "Radiopacity"@en;
                    rdfs:subClassOf comcore:ont00001384;
                    skos:altLabel "Radiodensity"@en;
                    skos:definition "An Opacity that inheres in a bearer in virtue of its capacity to allow or prevent X-rays to pass through it."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radiodensity&oldid=1048274724"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000621 a owl:Class;
                    rdfs:label "Inverse Sawtooth Waveform"@en;
                    rdfs:subClassOf comcore:ont00001286;
                    skos:definition "A Waveform that is characterized by a sawtooth shape due to the continuous linear transition from maximum to minimum Amplitudes followed by a near-instantaneous transition from the minimum to maximum Amplitudes of the Wave Cycle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000622 a owl:Class;
                    rdfs:label "Stasis of Fully Mission Capable"@en;
                    rdfs:subClassOf comcore:ont00001132;
                    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing all of its primary functions for the specified Mission."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000623 a owl:Class;
                    rdfs:label "Impact Shielding Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact reduces the damage caused to the shielded object by an impact with another object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000624 a owl:Class;
                    rdfs:label "Material Copy of a Report"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002043];
                    skos:altLabel "Report"@en;
                    skos:definition "A Material Copy of a Document that is designed to carry some specific Information Content Entity that conveys an account of some event, situation, or the result of some observation or inquiry."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Report&oldid=1063765657"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000625 a owl:Class;
                    rdfs:label "Nozzle Throat"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that consists of the narrowest portion of a Nozzle that is designed to converge the flow of fluid in order to increase the Velocity of the flow."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000626 a owl:Class;
                    rdfs:label "Predictive Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000853;
                    skos:altLabel "Prediction"@en,
                                  "Prediction Information Content Entity"@en;
                    skos:definition "A Descriptive Information Content Entity that describes an uncertain future event."@en;
                    skos:scopeNote "Since predictions are inherently about not-yet-existant things, the Modal Relation Ontology term 'describes' (i.e. mro:describes) should be used (instead of the standard cco:describes) to relate instances of Predictive Information Content Entity to the entities they are about."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000627 a owl:Class;
                    rdfs:label "Infrastructure Element"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00001141]) ; 
                                         a owl:Class];
                    skos:definition "A Material Entity that bears an Infrastructure Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000628 a owl:Class;
                    rdfs:label "Disposition to Interact with Electromagnetic Radiation"@en;
                    rdfs:subClassOf pobo:BFO_0000016;
                    skos:definition "A Disposition that inheres in a bearer in virtue of how that bearer interacts with electromagnetic radiation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000629 a owl:Class;
                    rdfs:label "Deception Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes which misinform or mislead some other entity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Deception&oldid=1061346984"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000630 a owl:Class;
                    rdfs:label "Universal Time Reference System"@en;
                    rdfs:subClassOf comcore:ont00000124;
                    skos:definition "A Solar Time Reference System that is based on the average speed of the Earth's rotation and which uses the prime meridian at 0° longitude as a reference point."@en;
                    comcore:ont00001753 "UT";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000631 dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023.";
                    dcterms:created "2023-02-06T10:14:09-05:00"@en;
                    a owl:Class;
                    rdfs:label "Material Territory of a Country"@en;
                    rdfs:subClassOf comcore:ont00000662;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000662
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000171 ; 
                                                             owl:someValuesFrom comcore:ont00000139]) ; 
                                         a owl:Class];
                    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a The Domain of a Country."@en;
                    skos:prefLabel "Material Territory of a Country"@en;
                    comcore:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000632 a owl:Class;
                    rdfs:label "Magnetism"@en;
                    rdfs:subClassOf pobo:BFO_0000016;
                    skos:definition "A Disposition that is realized when its bearer exerts a magnetic force on another entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000633 a owl:Class;
                    rdfs:label "Weight"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in some material entity with a mass in virtue of its location in some gravitational field."@en;
                    skos:scopeNote """When an object is \"weighed\", in the typical case, it is done so by taking into account the local force of gravity to determine the object's mass, whose standard of measure is the kilogram. The actual unit of measure of weight is the newton."""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000634 a owl:Class;
                    rdfs:label "Steam Engine"@en;
                    rdfs:subClassOf comcore:ont00000431;
                    skos:definition "An External Combustion Engine that is designed to use steam as its working fluid."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Steam_engine&oldid=1064097686"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000635 a owl:Class;
                    rdfs:label "Refraction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a refraction event in which the Material Artifact causes a change in direction of wave propagation due to a change in its transmission medium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000636 a owl:Class;
                    rdfs:label "Act of Appraisal"@en;
                    rdfs:subClassOf comcore:ont00000345;
                    skos:definition "An Act of Measuring that involves evaluating, assessing, estimating, or judging the nature, value, importance, condition, or quality of something or someone."@en;
                    skos:example "a food critic rating the quality of a restaurant's ambiance, service, and food",
                                 "a mechanic assessing whether a damaged vehicle is repairable",
                                 "an insurance agent appraising the financial value of a building";
                    skos:scopeNote "In the context of an Act of Appraisal, the terms 'value', 'condition', and 'quality' do not have the same meanings as their counterparts that are defined in the Common Core Ontologies. For example, a knife may be appraised to be of high quality if it is sharp and sturdy or to be of inferior quality if it is dull or fragile."@en,
                                   "Note that, while most if not all Acts of Appraisal involve some estimating and many Acts of Estimation involve some appraising (i.e. these classes are not disjoint), neither class subsumes the other. For example, some Acts of Appraisal (e.g. a tax assessor appraising the value of a building) impart a normative element to the measured value while others (e.g. a gustatory appraisal that fresh green beans taste better than canned green beans) involve complete information. Furthermore, many Acts of Estimation (e.g. estimating the height of a tree) are concerned solely with determining a numerical value (as opposed to the nature, value, importance, condition, or quality)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000637 a owl:Class;
                    rdfs:label "Portion of Gaseous Propellant"@en;
                    rdfs:subClassOf comcore:ont00000593;
                    skos:definition "A Portion of Propellant that is stored in a gaseous state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000638 a owl:Class;
                    rdfs:label "Heat Engine"@en;
                    rdfs:subClassOf comcore:ont00000210;
                    skos:definition "An Engine that is designed to convert thermal energy into mechanical energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000639 a owl:Class;
                    rdfs:label "Mine"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to support the extraction of minerals or other geological materials from an orebody, lode, vein, seam, reef, or placer deposit within the earth."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mining&oldid=1062844924"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000640 a owl:Class;
                    rdfs:label "Material Copy of a Email Message"@en;
                    rdfs:subClassOf comcore:ont00001002,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002012];
                    skos:altLabel "Email Message"@en;
                    skos:definition "A Material Copy of a Message that is transmitted to the recipient's Email Box."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email&oldid=1063646749"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000641 a owl:Class;
                    rdfs:label "Entertainment Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to host activities that are intended to hold the interest of, or give pleasure or delight to, an audience."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Entertainment&oldid=1061851778"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000642 a owl:Class;
                    rdfs:label "Gain of Realizable Entity"@en;
                    rdfs:subClassOf comcore:ont00000395,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000017]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Specifically Dependent Continuant in which some Independent Continuant becomes the bearer of some Realizable Entity."@en;
                    skos:example "An informant becomes unreliable (disposition), A person begins to speak French (function), a person becomes a welder (role).";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000643 a owl:Class;
                    rdfs:label "Low Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 5"@en;
                    skos:definition "A Radio Frequency that is between 30 and 300 kHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 10–1 km"@en;
                    comcore:ont00001753 "LF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000644 a owl:Class;
                    rdfs:label "Oscillation Process"@en;
                    rdfs:subClassOf comcore:ont00000004;
                    skos:altLabel "Oscillation"@en;
                    skos:definition "A Change in which the dependent entity alternates between two or more stases."@en;
                    skos:scopeNote "Oscillation is often thought of in the sense of motion, e.g., a swinging clock pendulum. However, the repetitive variation in location around a central point is technically a process of vibration, sometimes referred to as mechanical oscillation. Use the term Vibration Motion for those cases."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oscillation&oldid=1002978272"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000645 dcterms:created "2023-03-29T20:17:54-04:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Permanent Resident"@en;
                    rdfs:subClassOf comcore:ont00001262;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000917]) ; 
                                         a owl:Class];
                    skos:definition "A person with a Permanent Resident Role."@en;
                    skos:prefLabel "Permanent Resident"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000646 a owl:Class;
                    rdfs:label "Highway"@en;
                    rdfs:subClassOf comcore:ont00000247;
                    skos:definition "A Road that is designed to enable Ground Vehicles to travel on routes that connect relatively major destinations."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Highway&oldid=1063985949"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000647 a owl:Class;
                    rdfs:label "Organization Member"@en;
                    rdfs:subClassOf comcore:ont00001262,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001939 ; 
                                     owl:someValuesFrom comcore:ont00001180];
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000175]) ; 
                                         a owl:Class];
                    skos:definition "A Person who is affiliated with some Organization by being a member of that Organization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000648 a owl:Class;
                    rdfs:label "Color Brightness"@en;
                    rdfs:subClassOf comcore:ont00000784;
                    skos:altLabel "Color Intensity"@en;
                    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect or radiate light."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000649 a owl:Class;
                    rdfs:label "Non-Name Identifier"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    skos:altLabel "ID"@en,
                                  "Identifier"@en;
                    skos:definition "A Designative Information Content Entity that consists of a string of characters that designates an entity within a specified namespace or context, is not a Designative Name, may be automatically or randomly generated, and typically has no preexisting cultural or social significance."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000650 a owl:Class;
                    rdfs:label "Ground Moving Target Indication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000214;
                    skos:definition "A Moving Target Indication Artifact Function that inheres in Material Artifacts that are designed to identify and track entities moving on or near the ground."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000651 a owl:Class;
                    rdfs:label "Containing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which one entity contains another."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/containing";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000652 a owl:Class;
                    rdfs:label "Decoy"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to distract or conceal what an individual or group might be looking for."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Decoy&oldid=1058455081"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000653 a owl:Class;
                    rdfs:label "Algorithm"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    skos:definition "A Prescriptive Information Content Entity that prescribes some Process and contains a finite sequence of unambiguous instructions in order to achieve some Objective."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000064"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000654 a owl:Class;
                    rdfs:label "Act of Terrorism"@en;
                    rdfs:subClassOf comcore:ont00001147;
                    skos:definition "An Act of Violence which creates fear and which is prescribed by religious, political or ideological objectives, and which deliberately target or disregard the safety of civilians and are committed by members of non-government organizations."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Terrorism&oldid=1063471352"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000655 a owl:Class;
                    rdfs:label "Mailing Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for the systematic physical transportation of documents and packages."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mail&oldid=1057401839"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000656 a owl:Class;
                    rdfs:label "Radiological Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by means of releasing radioactive material."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radiological_warfare&oldid=1060817328"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000657 a owl:Class;
                    rdfs:label "Distance Measurement Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001100;
                    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the spatial Distance to a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000658 a owl:Class;
                    rdfs:label "Missile Launcher"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to launch one or more Precision-Guided Missiles."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000659 a owl:Class;
                    rdfs:label "Measurement Unit of Torque"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:altLabel "Measurement Unit of Moment of Force"@en,
                                  "Measurement Unit of Rotational Force"@en;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the rate of change of angular momentum of an object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000660 a owl:Class;
                    rdfs:label "Effect"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000015
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001819 ; 
                                                             owl:someValuesFrom pobo:BFO_0000015]) ; 
                                         a owl:Class];
                    skos:altLabel "Consequence"@en;
                    skos:definition "A Process that follows and is caused by some previous Process."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=effect";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000661 a owl:Class;
                    rdfs:label "Government Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes in which public policy is administered and the actions of its members are directed."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000662 dcterms:bibliographicCitation "Convention on Rights and Duties of States (inter-American); December 26, 1933. https://avalon.law.yale.edu/20th_century/intam03.asp. Accessed 6 Apr. 2023.";
                    dcterms:created "2023-02-06T10:14:09-05:00"@en;
                    a owl:Class;
                    rdfs:label "Material Territory of a Government Domain"@en;
                    rdfs:subClassOf comcore:ont00001341;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001341
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000171 ; 
                                                             owl:someValuesFrom comcore:ont00001152]) ; 
                                         a owl:Class];
                    skos:definition "The portions of lithosphere, hydrosphere, or atmosphere that together exactly occupy a Government Domain"@en;
                    skos:prefLabel "Material Territory of a Government Domain"@en;
                    comcore:ont00001754 "https://avalon.law.yale.edu/20th_century/intam03.asp";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000663 a owl:Class;
                    rdfs:label "Power Transmission Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to transfer and regulate Power flow from a Power Source to an application point."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000664 a owl:Class;
                    rdfs:label "Radio Relay Station"@en;
                    rdfs:subClassOf comcore:ont00000531;
                    skos:definition "A Communications Facility that is designed to support the receiving and re-transmitting of radio signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000665 a owl:Class;
                    rdfs:label "Cleaning Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to remove foreign objects from another object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000666 a owl:Class;
                    rdfs:label "Neutral Person"@en;
                    rdfs:subClassOf comcore:ont00001262;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000486]) ; 
                                         a owl:Class];
                    skos:altLabel "Unallied Person";
                    skos:definition "A Person who is the bearer of some Neutral Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000667 a owl:Class;
                    rdfs:label "Combat Outpost"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed to support the conduction of combat operations of limited scope or size."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Outpost_(military)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000668 a owl:Class;
                    rdfs:label "Battery Terminal"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to connect a load or charger to a single or multiple-cell Battery."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Battery_terminal&oldid=1059455659"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000669 a owl:Class;
                    rdfs:label "Distance Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001022;
                    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a One-Dimensional Extent inhering in some Site that is externally connected to two Independent Continuants."@en;
                    skos:scopeNote "Displacement (vector) is the shortest possible distance (scalar) between two points. Further thought is needed to adequately handle measurements of distance traveled along a path, e.g., a circuitous path or an arc (such as the surface of a planet), versus the simple case of a direct, straight line between two points."@en,
                                   "Distance is a measure between two reference points, which are located on or in, or in some manner part of, the two obejcts for which the length of the extent between is sought. For exmple, the center point of the indentation of a ball in the sand and the edge of the foul line, the forwardmost point on a car's bumper and the closest point on the 2-dimensional plane that serves as the fiat boundary of a crosswalk, the center of an antenna array and closest point on ground."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000670 a owl:Class;
                    rdfs:label "Distribution Port"@en;
                    rdfs:subClassOf comcore:ont00001258;
                    skos:definition "A Port that is designed with the cargo handling equipment necessary for the loading and unloading of Watercraft"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Port&oldid=1064091505"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000671 a owl:Class;
                    rdfs:label "Anti-Bacterial Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000415;
                    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some bacterium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Antibiotic&oldid=1063633090"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000672 a owl:Class;
                    rdfs:label "Super Low Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 2"@en;
                    skos:definition "A Radio Frequency that is between 30 and 300 Hz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 10,000–1,000 km"@en;
                    comcore:ont00001753 "SLF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000673 a owl:Class;
                    rdfs:label "Prosthetic Foot"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace a missing foot."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000674 a owl:Class;
                    rdfs:label "Calendar Year"@en;
                    rdfs:subClassOf comcore:ont00000832;
                    skos:definition "A Year that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Year."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000675 a owl:Class;
                    rdfs:label "Sound Wave Process"@en;
                    rdfs:subClassOf comcore:ont00001028,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00001227];
                    skos:definition "A Mechanical Wave Process of Pressure and displacement that is parallel to the propogation direction of the Wave Process through a medium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sound&oldid=1050465877"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000676 a owl:Class;
                    rdfs:label "Act of Inhabitancy"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which a Person lives at a Site for a period of time that may be as short as 1 day/night or as long as the Person's entire life."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/inhabit";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000677 a owl:Class;
                    rdfs:label "Product Transport Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to transport some product."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000678 a owl:Class;
                    rdfs:label "Voltage Regulating Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to cause a change in the voltage magnitude between the sending and receiving end of an electrical component."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Voltage_regulation&oldid=1045628774"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000679 a owl:Class;
                    rdfs:label "Attitude Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:altLabel "Orientation Control Artifact Function"@en;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in an attitude control process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000680 a owl:Class;
                    rdfs:label "Medical Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store medical supplies."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000681 a owl:Class;
                    rdfs:label "External Navigation Lighting System"@en;
                    rdfs:subClassOf comcore:ont00000236;
                    skos:definition "A Lighting System that is designed to be attached to some Vehicle and to emit colored light in order to signal that Vehicle's position, heading, and status."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Navigation_light&oldid=1034200601"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000682 a owl:Class;
                    rdfs:label "Mirror"@en;
                    rdfs:subClassOf comcore:ont00000136;
                    skos:definition "An Optical Instrument that is designed to reflect light that has a wavelength within a given range and is incident on its relflecting surface such that the reflected light maintains most of the characteristics of the original light."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mirror&oldid=1063296474"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000683 a owl:Class;
                    rdfs:label "Diminutive Name"@en;
                    rdfs:subClassOf comcore:ont00000605;
                    skos:definition "An Abbreviated Name that is a familiar form of a Proper Name."@en;
                    skos:example "Alex, Bob, Cathy";
                    skos:scopeNote """\"Familiar form of a Proper Name\" means: that the name is (originally) a short, affectionate version of the fuller name, used (originally) by family or friends."""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000684 a owl:Class;
                    rdfs:label "Act of Contract Formation"@en;
                    rdfs:subClassOf comcore:ont00000821;
                    skos:definition "An Act of Promising having a lawful object entered into voluntarily by two or more agents with legal capacity, each of whom intends to create one or more legal obligations between them."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Contract&oldid=1061365227"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000685 a owl:Class;
                    rdfs:label "Government Domain Border"@en;
                    rdfs:subClassOf comcore:ont00000207;
                    skos:definition "A Geospatial Boundary that is a boundary of some Government Domain."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Border&oldid=1061275162"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000686 a owl:Class;
                    rdfs:label "Designative Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    owl:disjointWith comcore:ont00000853,
                                     comcore:ont00000965;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000958
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:altLabel "Designative ICE"@en;
                    skos:definition "An Information Content Entity that consists of a set of symbols that designate some Entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000687 a owl:Class;
                    rdfs:label "Act of Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000234;
                    skos:definition "An Act of Training performed by an Agent by acquiring knowledge from another Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000688 a owl:Class;
                    rdfs:label "Turbofan Air-Breathing Jet Engine"@en;
                    rdfs:subClassOf comcore:ont00000294;
                    skos:definition "An Air-Breathing Jet Engine that uses a Turbofan, which consists of a Turbine and a Fan."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Turbofan&oldid=1063724215"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000689 a owl:Class;
                    rdfs:label "Switch Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process of breaking an electric circuit by interrupting the current or diverting it from one conductor to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Switch&oldid=1059685800"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000690 a owl:Class;
                    rdfs:label "Telecommunication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000346;
                    skos:definition "A Communication Instrument that is designed for use by some Agent in some Act of Communication where the recipient of that communication is potentially a significant distance away from the Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000691 a owl:Class;
                    rdfs:label "Fuel Tank"@en;
                    rdfs:subClassOf comcore:ont00000020;
                    skos:definition "A Container that is designed to store a Portion of Fuel."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000692 a owl:Class;
                    rdfs:label "Probability Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    skos:altLabel "Likelihood Measurement"@en,
                                  "Probability Measurement"@en;
                    skos:definition "A Measurement Information Content Entity that is a measurement of the likelihood that a Process or Process Aggregate occurs."@en;
                    skos:scopeNote "Every probability measurement is made within a particular context given certain background assumptions."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Probability&oldid=1059657543"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000693 a owl:Class;
                    rdfs:label "Mass Specification"@en;
                    rdfs:subClassOf comcore:ont00000575;
                    skos:definition "A Quality Specification that prescribes the Amount of Mass that a Material Entity should have."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000694 a owl:Class;
                    rdfs:label "Nozzle Mouth"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that consists of the portion of a Nozzle at the end that is designed to be where the flow of fluid exits the Nozzle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000695 a owl:Class;
                    rdfs:label "Radiolucent"@en;
                    rdfs:subClassOf comcore:ont00000620;
                    skos:altLabel "Hypodense"@en,
                                  "Transradiance"@en;
                    skos:definition "A Radiopacity that inheres in a bearer in virtue of its capacity to permit most X-rays to pass through it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000696 a owl:Class;
                    rdfs:label "Ideology"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    skos:definition "An Information Content Entity that consists of a collection of claims about how some part of the world is or should be and which is accepted as true by an Agent or Group of Agents such that it forms the basis of their beliefs, goals, expectations, and motivations."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000697 a owl:Class;
                    rdfs:label "Enemy Person"@en;
                    rdfs:subClassOf comcore:ont00001262;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000279]) ; 
                                         a owl:Class];
                    skos:definition "A Person who is the bearer of some Enemy Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000698 a owl:Class;
                    rdfs:label "Convergent-Divergent Nozzle"@en;
                    rdfs:subClassOf comcore:ont00000252;
                    skos:altLabel "CD Nozzle"@en,
                                  "de Laval Nozzle"@en;
                    skos:definition "A Nozzle that consists of a tube with an asymmetric hourglass shape that is designed to accelerate hot pressurized gas by converting the heat energy of the gas flow into kinetic energy as it passes through the Nozzle Throat to generate increased Exhaust Velocity of the gas as it exits the Nozzle."@en;
                    skos:scopeNote "By increasing the Exhaust Velocity of the gas, the Nozzle increases the Thrust generated."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=De_Laval_nozzle&oldid=1062746288"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000699 a owl:Class;
                    rdfs:label "Afternoon"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun is at its apex (approximately 12:00pm) and when it sets (approximately 6:00pm)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000700 a owl:Class;
                    rdfs:label "Computer Network"@en;
                    rdfs:subClassOf comcore:ont00000998;
                    skos:altLabel "Data Network"@en;
                    skos:definition "A Telecommunication Network that is designed to allow the exchange of data between two or more computers connected to the network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Computer_network&oldid=1061571662"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000701 a owl:Class;
                    rdfs:label "Wire Receiver"@en;
                    rdfs:subClassOf comcore:ont00001145;
                    skos:definition "A Radio Receiver that uses a Wire Antenna to intercept radio signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000702 a owl:Class;
                    rdfs:label "Material Copy of an Image"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002004];
                    skos:altLabel "Image"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry an Information Content Entity that represents some entity owing to a visual isomorphism between the carrying artifact and the entity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Image&oldid=1062709732"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000703 a owl:Class;
                    rdfs:label "Material Copy of a System Clock"@en;
                    rdfs:subClassOf comcore:ont00000159;
                    skos:altLabel "System Clock"@en;
                    skos:definition "A Material Copy of a Timekeeping Instrument that is part of a computer and is designed to issue a steady high-frequency signal that is used to synchronize all of the computer's internal components."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/system+clock";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000704 a owl:Class;
                    rdfs:label "Constructed Tunnel"@en;
                    rdfs:subClassOf comcore:ont00000254;
                    skos:definition "A Transportation Artifact that is designed to be substantially enclosed, have access constrained to portals, and to enable travel through surrounding soil, earth, or rock formation."@en;
                    skos:scopeNote "This class is not intended to include natural tunnels, such as caves."@en;
                    comcore:ont00001754 "Federal Highway Administration. Guidance on Structures Subject to the National Tunnel Inspection Standards (NTIS). United States Department of Transportation, 27 Oct. 2015";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000705 a owl:Class;
                    rdfs:label "Power Transmission Line"@en;
                    rdfs:subClassOf comcore:ont00000677;
                    skos:definition "A Product Transport Facility that is designed to transmit electricity over distance via a system of above ground wires including their supports."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_power_transmission&oldid=1062551058"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000706 a owl:Class;
                    rdfs:label "Terminal Board"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to join electrical terminations and create an electrical circuit by means of a block which connects individual wires without a splice or physically joining the ends."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electrical_connector&oldid=1061247409"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000707 a owl:Class;
                    rdfs:label "Measurement Unit of Angle"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the angle between two lines or planes in relation to a vertex."@en;
                    skos:example "degrees, radians";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000708 a owl:Class;
                    rdfs:label "Water Tower"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Facility that is the bearer of functions realized in processes of storing water in an elevated container."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Water_tower&oldid=1059754959"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000709 a owl:Class;
                    rdfs:label "Visual Prosthesis"@en;
                    rdfs:subClassOf comcore:ont00001248;
                    skos:altLabel "Bionic Eye"@en;
                    skos:definition "An Artificial Eye that is designed to replace a missing eye, which performs the function of an eye."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Visual_prosthesis&oldid=1059269261"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000710 a owl:Class;
                    rdfs:label "Command Post Facility"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed to support the command and control of Military Operations or Forces."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/command-post";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000711 a owl:Class;
                    rdfs:label "Semi-automatic Pistol"@en;
                    rdfs:subClassOf comcore:ont00000156;
                    skos:definition "A Hand Gun that has a single fixed firing chamber machined into the rear of the barrel and an ammunition magazine capable of holding multiple Cartridges such that the Hand Gun is designed to automatically reload each time it is fired and to fire a Bullet with each successive pull of the trigger until the stored ammunition is depleted."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Semi-automatic_pistol&oldid=1058568715"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000712 a owl:Class;
                    rdfs:label "Acceleration"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000117 ; 
                                     owl:someValuesFrom comcore:ont00000763],
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00001133];
                    skos:definition "A Process Profile that is the rate of change of the Velocity of an object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Acceleration&oldid=1062249960"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000713 a owl:Class;
                    rdfs:label "Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to facilitate the movement of material entities from one location to another by conveying them there."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle&oldid=1063682179"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000714 a owl:Class;
                    rdfs:label "Horn Antenna"@en;
                    rdfs:subClassOf comcore:ont00001192;
                    skos:altLabel "Microwave Horn"@en;
                    skos:definition "A Radio Antenna that consists of a flaring metal waveguide shaped like a horn to direct radio waves in a beam and can be used on its own or as a feeder for larger antenna structures, such as Parabolic Antennas."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Horn_antenna&oldid=1050375403"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000715 a owl:Class;
                    rdfs:label "Prosthesis"@en;
                    rdfs:subClassOf comcore:ont00001381;
                    skos:definition "A Medical Artifact that is designed to replace a missing body part."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prosthesis&oldid=1063749698"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000716 a owl:Class;
                    rdfs:label "Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:altLabel "Battery"@en;
                    skos:definition "An Electrical Power Source that is designed to produce electric power by converting chemical energy to electrical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Battery_(electricity)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000717 a owl:Class;
                    rdfs:label "Fossil Fuel Power Plant"@en;
                    rdfs:subClassOf comcore:ont00001076;
                    skos:definition "An Electric Power Station that is designed to convert fossil fuels (e.g. coal, natural gas, or petroleum) into electrical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fossil_fuel&oldid=1062298144"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000718 a owl:Class;
                    rdfs:label "Village"@en;
                    rdfs:subClassOf comcore:ont00000460;
                    skos:definition "A Local Administrative Region in which a human population permanently resides that is typically larger than the population of a hamlet but smaller than that of a Town."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/village";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000719 a owl:Class;
                    rdfs:label "Counterfeit Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to be a fake replica of some genuine Material Artifact."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit&oldid=1063493600"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000720 a owl:Class;
                    rdfs:label "Cryogenic Storage Dewar"@en;
                    rdfs:subClassOf comcore:ont00000020;
                    skos:definition "A Container that is designed to store a Portion of Cryogenic Material (such as liquid helium or liquid oxygen) and which consists of, minimally, walls that are constructed from two or more layers that are separated by a high vacuum to provide thermal insulation between the interior and exterior of the dewar."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cryogenic_storage_dewar&oldid=1021282649"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000721 a owl:Class;
                    rdfs:label "Polarizing Prism"@en;
                    rdfs:subClassOf comcore:ont00000804;
                    skos:definition "A Prism designed to split a beam of light entering the Prism into components of varying polarization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000722 a owl:Class;
                    rdfs:label "Sea Level"@en;
                    rdfs:subClassOf pobo:BFO_0000146;
                    skos:definition "A Fiat Surface that divides the spheroid composed of Earth and its atmosphere at some point that corresponds to the mean level of calm water in the Earth’s oceans."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000723 a owl:Class;
                    rdfs:label "Vehicle Control System"@en;
                    rdfs:subClassOf comcore:ont00000781;
                    skos:definition "A Control System that is designed to enable some Agent to control some Vehicle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000724 a owl:Class;
                    rdfs:label "Parabolic Antenna"@en;
                    rdfs:subClassOf comcore:ont00001192;
                    skos:altLabel "Dish Antenna"@en,
                                  "Parabolic Dish"@en;
                    skos:definition "A Radio Antenna that uses a parabolic reflector to direct or receive radio waves and has a very high gain."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Parabolic_antenna&oldid=1057213241"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000725 a owl:Class;
                    rdfs:label "Wedding"@en;
                    rdfs:subClassOf comcore:ont00000455;
                    skos:altLabel "Act of Wedding Ceremony"@en;
                    skos:definition "An Act of Ceremony in which two Persons are united in Marriage or a similar institution."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wedding&oldid=1063857279"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000726 a owl:Class;
                    rdfs:label "Decrease of Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000004;
                    skos:definition "A Change in which some Independent Continuant has a decrease in the level of some Dependent Continuant that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000727 a owl:Class;
                    rdfs:label "Communication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which meaningful signs are conveyed from one entity to another."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000728 a owl:Class;
                    rdfs:label "Submillimeter Wavelength Radio Telescope"@en;
                    rdfs:subClassOf comcore:ont00000215;
                    skos:altLabel "Microwave Telescope"@en;
                    skos:definition "A Radio Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing radio waves from the submillimeter waveband (i.e. microwaves) to form an enhanced image of the Object."@en;
                    skos:scopeNote "The submillimeter waveband is between the far-infrared and microwave wavebands and is typically taken to have a wavelength of between a few hundred micrometers and a millimeter."@en;
                    comcore:ont00001754 "http://kp12m.as.arizona.edu/docs/what_is_submillimeter.htm, https://en.wikipedia.org/wiki/Submillimetre_astronomy";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000729 a owl:Class;
                    rdfs:label "Spherical Coordinate System"@en;
                    rdfs:subClassOf comcore:ont00000275;
                    skos:definition "A Spatial Reference System for three-dimensional spatial regions that identifies each point using an ordered triple of numerical coordinates that consist of the radial distance of the point of interest from a fixed origin, its polar angle measured from a fixed zenith direction, and the azimuth angle of its orthogonal projection measured from a fixed direction on a reference plane that passes through the origin and is orthogonal to the zenith."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spherical_coordinate_system&oldid=1061029174"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000730 a owl:Class;
                    rdfs:label "Hydraulic Power Transfer Unit"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to transfer hydraulic power from one of an Aircraft's hydraulic systems to another in the event that a system has failed or been turned off."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000731 a owl:Class;
                    rdfs:label "Deviation Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    skos:altLabel "Conformance Measurement"@en,
                                  "Degree of Conformance"@en,
                                  "Degree of Deviation"@en,
                                  "Deviation Measurement"@en;
                    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity conforms to how it is expected or supposed to be."@en;
                    skos:example "a missile impact deviates from its target location by 100 feet",
                                 "a satellite deviaties from its predicted orbital path by 5 kilometers",
                                 "an overweight piece of luggage deviates from an airline's maximum allowed weight by +10 pounds";
                    skos:scopeNote "'Deviation Measurement Information Content Entity' and 'Veracity Measurement Information Content Entity' are complementary notions. Deviation is a measure of whether reality conforms to an ICE (e.g., a plan or prediction), whereas Veracity is a measure of whether a Descriptive ICE conforms to reality."@en,
                                   "In order for a Deviation to exist, an entity must first be expected, represented, prescribed, or predicted as being a certain way. Then, at a future time, this value can be compared to its actual, reported, or measured value to determine the Deviation between these values."@en,
                                   "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance (see: 'Reliability Measurement Information Content Entity'), correctness-of-information (see: 'Veracity Measurement Information Content Entity'), and adherance-to-expectations ('Deviation Measurement Information Content Entity')."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000732 a owl:Class;
                    rdfs:label "Microwave Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:definition "A Radio Frequency that is between 300 MHz and 300 GHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 1,000–1 mm"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Microwave&oldid=1062124842"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000733 a owl:Class;
                    rdfs:label "Spherical"@en;
                    rdfs:subClassOf comcore:ont00001360;
                    skos:definition "A Three Dimensional Shape inhering in a bearer in virtue of all of its cross sections being round."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000734 a owl:Class;
                    rdfs:label "Explosive Land Mine"@en;
                    rdfs:subClassOf comcore:ont00002066;
                    skos:altLabel "Land Mine"@en;
                    skos:definition "An Explosive Mine that is designed to be concealed under or on the ground."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Land_mine&oldid=1060289159"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000735 a owl:Class;
                    rdfs:label "Geospatial Region Bounding Box Identifier List"@en;
                    rdfs:subClassOf comcore:ont00000406;
                    skos:definition "A Measurement Unit of Geocoordinate that is comprised of 4 pairs of coordinates, one for each of the 4 defining points (North, West, South, East) of a Geospatial Region Bounding Box."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000736 a owl:Class;
                    rdfs:label "Transducer"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to convert one form of energy to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transducer&oldid=1053290948"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000737 a owl:Class;
                    rdfs:label "Forward Operations Base"@en;
                    rdfs:subClassOf comcore:ont00000483;
                    skos:altLabel "Forward Operating Base"@en;
                    skos:definition "A Military Base that is located relatively close to an offensive Area of Operations, is supported by the Base of Operations, and is designed to support local strategic objectives and tactical operations."@en;
                    comcore:ont00001753 "FOB";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Forward_operating_base&oldid=1059263624"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000738 a owl:Class;
                    rdfs:label "Length"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's greatest extent in one direction."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000739 a owl:Class;
                    rdfs:label "Act of Sojourn"@en;
                    rdfs:subClassOf comcore:ont00000676;
                    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling temporarily, often during stages of an Act of Travel."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000740 a owl:Class;
                    rdfs:label "Resource"@en;
                    rdfs:subClassOf pobo:BFO_0000002;
                    skos:definition "A Continuant that is owned by, in the possession of, or is otherwise controlled by an Agent such that it could be used by that Agent."@en;
                    skos:example "a group of interns",
                                 "a knowledge base",
                                 "a plot of land",
                                 "a software program",
                                 "a sum of money",
                                 "a vehicle";
                    skos:scopeNote "Resources are Resources for some Agent. If no instance of Agent existed, no instance of Resource would exist either. It is not a requirement that something be valuable in order for it to be a Resource. Thus the value of something can drastically change without altering whether that thing is a Resource."@en,
                                   "This class is designed to group continuants according to a very broad criterion and is not intended to be used as a parent class for entities that can be more specifically represented under another class. Hence, Natural Resource may be an appropriate subtype but Money, Oil, and Gold Mine are not."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000741 a owl:Class;
                    rdfs:label "Act of Targeting"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act wherein some Agent maintains one or more entities as the objects of potential action given some operational requirement."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000742 a owl:Class;
                    rdfs:label "Ignition System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to produce an Ignition process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000743 a owl:Class;
                    rdfs:label "Material Copy of a Chart"@en;
                    rdfs:subClassOf comcore:ont00000702,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002005];
                    skos:altLabel "Chart"@en;
                    skos:definition "A Material Copy of an Image that is designed to carry some Representational Information Content Entity that is prescribed by some canonical visual format."@en;
                    comcore:ont00001754 "Adapted from “Chart.” Merriam-Webster.com Dictionary, Merriam-Webster, https://www.merriam-webster.com/dictionary/chart. Accessed 4 Aug. 2024.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000744 a owl:Class;
                    rdfs:label "Act of Social Group Membership"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association wherein a Person belongs to some Social Group."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000745 a owl:Class;
                    rdfs:label "Point Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001176;
                    skos:altLabel "Best Estimate"@en,
                                  "Point Estimate"@en,
                                  "Point Estimate Measurement Information Content Entity"@en;
                    skos:definition "An Estimate Information Content Entity that consists of a single value for the measured entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000746 a owl:Class;
                    rdfs:label "Combustion Engine"@en;
                    rdfs:subClassOf comcore:ont00000638;
                    skos:definition "A Heat Engine that is designed to convert thermal energy that is generated through a local Combustion process into mechanical energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000747 a owl:Class;
                    rdfs:label "Canal"@en;
                    rdfs:subClassOf comcore:ont00000549;
                    skos:definition "A Water Transportation Artifact that is an artificial Hydrographic Feature designed to convey water or enable Watercraft to travel inland."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Canal&oldid=1059514223";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000748 a owl:Class;
                    rdfs:label "Bullet"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to be projected by a Firearm, Sling, Slingshot, or Air Gun, but which does not (typically) contain explosives."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bullet&oldid=1062391591"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000749 a owl:Class;
                    rdfs:label "Julian Day Number"@en;
                    rdfs:subClassOf comcore:ont00000894,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001916 ; 
                                     owl:someValuesFrom comcore:ont00000498];
                    skos:definition "A Decimal Date Identifier that designates some Julian Day by using a number to indicate the sequential ordering of the Day since the Julian Date epoch."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000750 a owl:Class;
                    rdfs:label "Text Messaging"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Text Messaging"@en,
                                  "Act of Texting"@en;
                    skos:definition "An Act of Communication by Media involving the exchange of brief written messages between fixed-line phone or mobile phone and fixed or portable devices over a network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Text_messaging&oldid=1062261405"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000751 a owl:Class;
                    rdfs:label "Action Permission"@en;
                    rdfs:subClassOf comcore:ont00001324;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001324
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001910 ; 
                                                             owl:someValuesFrom pobo:BFO_0000015]) ; 
                                         a owl:Class];
                    skos:altLabel "Authorization"@en,
                                  "License"@en;
                    skos:definition "A Process Regulation that permits some Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000752 a owl:Class;
                    rdfs:label "Wave Process Profile"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000144
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000132 ; 
                                                             owl:someValuesFrom comcore:ont00000099]) ; 
                                         a owl:Class];
                    skos:definition "A Process Profile of a Wave Process."@en;
                    skos:scopeNote "This is a defined class used to group process profiles of Wave Processes. Note that not every relevant process profile can be asserted as a subtype, however, because they (e.g. Frequency and Amplitude) are applicable to other processes as well (e.g. Oscillation Process)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000753 a owl:Class;
                    rdfs:label "Ultra Low Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 3"@en;
                    skos:definition "A Radio Frequency that is between 300 Hz and 3 kHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 1,000–100 km"@en;
                    comcore:ont00001753 "ULF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000754 a owl:Class;
                    rdfs:label "Electromagnetic Radiation Frequency"@en;
                    rdfs:subClassOf comcore:ont00001047,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000951];
                    skos:definition "A Frequency that is characterized by the rate of Oscillations per second of an Electromagnetic Wave."@en;
                    skos:scopeNote "Divisions between EM radiation frequencies are fiat and sources vary on where to draw boundaries."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000755 a owl:Class;
                    rdfs:label "Zenith"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that extends from a given location upward along the local vertical direction pointing in the direction opposite the apparent Gravitational Force at that location."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Zenith&oldid=1052625030"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000756 a owl:Class;
                    rdfs:label "Material Copy of a Database"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002006];
                    skos:altLabel "Database"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry some set of specific Information Content Entities and to be rapidly searchable and retrievable."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Database&oldid=1057024641"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000757 a owl:Class;
                    rdfs:label "Synagogue"@en;
                    rdfs:subClassOf comcore:ont00000052;
                    skos:definition "A Religious Facility that is designed for Judaic worship and prayer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Synagogue&oldid=1063773298"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000758 a owl:Class;
                    rdfs:label "Component Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an entity having a discrete structure in virtue of that entity being part of a system considered at a particular level of analysis."@en;
                    comcore:ont00001754 "ISO/IEC. 1998. Information Technology ― System and Software Integrity Levels Geneva, Switzerland: International Organization for Standardization (ISO)/International Electrotechnical Commission (IEC). ISO/IEC. 15026:1998. : 3.1"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000759 a owl:Class;
                    rdfs:label "Color Saturation"@en;
                    rdfs:subClassOf comcore:ont00000784;
                    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect high intensity light distributed across fewer wavelengths, typically considered on a continuum of purity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000760 a owl:Class;
                    rdfs:label "Surface Wave Profile"@en;
                    rdfs:subClassOf comcore:ont00000752;
                    skos:altLabel "Surface Wave"@en;
                    skos:definition "A Wave Process Profile in which the Wave Process propogates along the surface of a medium and which involves both transverse and longitudinal wave profiles such that the motion of the displacement of participating particles is circular or elliptical."@en;
                    skos:example "the motion of an ocean wave";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000761 a owl:Class;
                    rdfs:label "Pier"@en;
                    rdfs:subClassOf comcore:ont00000226;
                    skos:definition "A Transportation Facility that is designed to partially enclose a harbor and form a landing place for Watercraft."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pier&oldid=1057802753"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000762 a owl:Class;
                    rdfs:label "Fungicide Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000415;
                    skos:definition "An Anti-Microbial Artifact Function that is realized in a process which causes harm to, or the death of, some fungus or fungal spore."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fungicide&oldid=1056769271"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000763 a owl:Class;
                    rdfs:label "Velocity"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00001133];
                    skos:definition "A Process Profile of an object's Motion that is characterized by its Speed and direction with respect to a frame of reference."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Velocity&oldid=1063300750"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000764 a owl:Class;
                    rdfs:label "Optical Focusing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000504;
                    skos:definition "An Optical Processing Artifact Function that is realized by a Material Artifact participating in a light focusing event in which the Material Artifact causes the light beam to converge on a target spatial point."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000765 a owl:Class;
                    rdfs:label "Wave Production"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:altLabel "Wave Production Process"@en;
                    skos:definition "A Natural Process in which a Wave Process is generated."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000766 a owl:Class;
                    rdfs:label "Hardness"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which it can be turned, bowed, or twisted without breaking."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000767 a owl:Class;
                    rdfs:label "Lubrication System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to contain, transfer, and regulate the flow of lubricant to multiple locations in a Material Artifact."@en;
                    skos:scopeNote "A Lubrication System typical consists of a reservoir, pump, heat exchanger, filter, regulator, valves, sensors, pipes, and hoses. In some cases it also includes the passageways and openings within the artifact it is designed to lubricate. For example, the oil holes in a bearing and crankshaft."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000768 a owl:Class;
                    rdfs:label "Amount"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the total, aggregate or sum of a number of discrete items or material the entity contains as parts."@en;
                    comcore:ont00001754 "http://en.wiktionary.org/wiki/amount";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000769 a owl:Class;
                    rdfs:label "Act of Requesting"@en;
                    rdfs:subClassOf comcore:ont00000133;
                    skos:definition "An Act of Directive Communication performed by asking for something."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/request";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000770 a owl:Class;
                    rdfs:label "Measurement Unit of Density"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the mass of an object per unit of its total volume."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000771 a owl:Class;
                    rdfs:label "Imaging Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000995
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000601]) ; 
                                         a owl:Class];
                    skos:definition "A Material Artifact that is designed to bear an Imaging Artifact Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000772 a owl:Class;
                    rdfs:label "Impulsive Force"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    skos:altLabel "Imp"@en,
                                  "Impulse"@en,
                                  "J"@en;
                    skos:definition "A Process Profile that is the integral of a Force that is applied to a portion of matter over a period of time."@en;
                    skos:scopeNote "An Impulse changes the Momentum (and potentially also the direction of Motion) of the object it is applied to and is typically measured in Newton meters."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000773 a owl:Class;
                    rdfs:label "Curvilinear Motion"@en;
                    rdfs:subClassOf comcore:ont00000789;
                    skos:altLabel "Curved Motion"@en;
                    skos:definition "A Translational Motion process in which an Object moves along a curved path."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000774 a owl:Class;
                    rdfs:label "Video Camera"@en;
                    rdfs:subClassOf comcore:ont00000199;
                    skos:definition "A Camera that is designed to form and digitally or physically record a continuous stream of subsequent images of an entity or scene such that the images can be played back in succession as a video."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000775 a owl:Class;
                    rdfs:label "Locomotive"@en;
                    rdfs:subClassOf comcore:ont00000796;
                    skos:definition "A Rail Transport Vehicle that is designed to provide the motive power for a Train."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Locomotive&oldid=1062802629"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000776 a owl:Class;
                    rdfs:label "Signal Detection Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in the process of discerning between information-bearing patterns and random patterns, or noise, that distract from the information."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Detection_theory&oldid=1049765804"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000777 a owl:Class;
                    rdfs:label "Hydraulic Motor"@en;
                    rdfs:subClassOf comcore:ont00001221;
                    skos:definition "A Physically Powered Engine that converts hydraulic pressure and flow into torque and angular displacement."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydraulic_motor&oldid=1027427666"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000778 a owl:Class;
                    rdfs:label "Chemical Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store chemicals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000779 a owl:Class;
                    rdfs:label "Portion of Cryosphere"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A fiat object part of the frozen part of a natural satellite's hydosphere"@en;
                    comcore:ont00001754 "NOAA. “What Is the Cryosphere?” National Ocean Service, 16 June 2024, oceanservice.noaa.gov/facts/cryosphere.html. Accessed 24 Mar. 2026.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000780 a owl:Class;
                    rdfs:label "Ethnicity"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in its bearers by virtue of a common heritage, often consisting of a common language, a common culture (often including a shared religion) and an ideology that stresses common ancestry or endogamy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ethnic_group&oldid=1063804490"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000781 a owl:Class;
                    rdfs:label "Control System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to manage, command, direct, or regulate the behavior of at least one other Material Artifact."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Control_system&oldid=1061817176"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000782 a owl:Class;
                    rdfs:label "Factory"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for manufacturing or refining material products."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Factory&oldid=1064125324"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000783 a owl:Class;
                    rdfs:label "Stasis of Non-Mission Capable Maintenance"@en;
                    rdfs:subClassOf comcore:ont00000557,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001819 ; 
                                     owl:someValuesFrom comcore:ont00000950];
                    skos:definition "A Stasis of Non-Mission Capable during which the participating Continuant is not capable of performing its primary functions for the specified Mission due to participating in an Act Of Maintenance."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000784 a owl:Class;
                    rdfs:label "Optical Property"@en;
                    rdfs:subClassOf comcore:ont00000628;
                    skos:definition "A Disposition to Interact with Electromagnetic Radiation that is realized when its bearer interacts with electromagnetic waves within the visible light spectrum."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000785 a owl:Class;
                    rdfs:label "Radio Repeater"@en;
                    rdfs:subClassOf comcore:ont00001320;
                    skos:definition "A Radio Transceiver that is designed to receive a radio signal, amplify it, and retransmit it (often on another frequency)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Repeater&oldid=1040047439"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000786 a owl:Class;
                    rdfs:label "Increase of Role"@en;
                    rdfs:subClassOf comcore:ont00000611;
                    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Role that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000787 a owl:Class;
                    rdfs:label "Altitude"@en;
                    rdfs:subClassOf comcore:ont00000967;
                    skos:definition "A Height that inheres in a Site that externally connects an Independent Continuant to either the surface of the Earth or the Earth's mean Sea Level."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000788 a owl:Class;
                    rdfs:label "Turbine Steam Engine"@en;
                    rdfs:subClassOf comcore:ont00000634;
                    skos:altLabel "Steam Turbine"@en;
                    skos:definition "A Steam Engine that is designed to extract thermal energy from pressurized steam and use it to do mechanical work on a rotating output shaft."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Steam_turbine&oldid=1060224962"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000789 a owl:Class;
                    rdfs:label "Translational Motion"@en;
                    rdfs:subClassOf comcore:ont00001133,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000763];
                    skos:definition "A Motion Process in which the participating Object changes its position from one portion of space to another."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000790 a owl:Class;
                    rdfs:label "Direct Current Power Source"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that is designed to transfer electrical power in the form of direct current."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000791 a owl:Class;
                    rdfs:label "Chemical Reaction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process that leads to the transformation of one set of chemical substances to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Chemical_reaction&oldid=1063262412"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000792 a owl:Class;
                    rdfs:label "Catadioptric Optical Telescope"@en;
                    rdfs:subClassOf comcore:ont00001009;
                    skos:altLabel "Catadioptric Telescope"@en;
                    skos:definition "An Optical Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light through the use of a combination of Lenses and Mirrors to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Catadioptric_system&oldid=1017210114"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000793 a owl:Class;
                    rdfs:label "Fuel Ventilation System"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that is designed to allow air into the Fuel Tank to take the place of burned fuel."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft_fuel_system&oldid=1003132173"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000794 a owl:Class;
                    rdfs:label "Geospatial Ellipse"@en;
                    rdfs:subClassOf comcore:ont00000207;
                    skos:definition "A One-Dimensional Geospatial Boundary that is formed by following a symmetric arc between four vertices which are connected to the center point of the ellipse via a straight line."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000795 a owl:Class;
                    rdfs:label "Electrical Conduction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:definition "An Electrical Artifact Function that is realized by a Material Artifact being used to conduct an electric current."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000796 a owl:Class;
                    rdfs:label "Rail Transport Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000618;
                    skos:definition "A Ground Vehicle that is designed to convey cargo, passengers, or equipment by Railway."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rail_transport&oldid=1063793805"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000797 a owl:Class;
                    rdfs:label "Hazel"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is a combination of Brown and Green, typically associated with eye color."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000798 a owl:Class;
                    rdfs:label "Information Bearing Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00000958],
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000893];
                    skos:altLabel "Information Carrying Artifact"@en;
                    skos:definition "A Material Artifact that carries an Information Content Entity and is designed to do so using a particular format or structure."@en;
                    skos:scopeNote "This class continues to use the word ‘bearing’ in its rdfs:label for legacy reasons. It should be understood that all instances of this class are carriers of information content entities and only, strictly speaking, a bearer of their concretizations."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000799 a owl:Class;
                    rdfs:label "Material Copy of a List"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002007];
                    skos:altLabel "List"@en;
                    skos:definition "An Information Bearing Artifact that consists of one or more Information Bearing Artifacts that carry Information Content Entities and are the subjects of some Sequence Position Ordinality."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=List_(abstract_data_type)&oldid=1041588680"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000800 a owl:Class;
                    rdfs:label "Day"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00000619];
                    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one rotation around its Rotational Axis as specified relative to a particular Temporal Reference System."@en;
                    skos:scopeNote "Unless otherwise specified, a Day is assumed to be relative to the rotational motion of the Earth and is approximately equal to a twenty-four hour temporal region for which the start and end times are specified by the Temporal Reference System used."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=day";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000801 a owl:Class;
                    rdfs:label "y-Axis"@en;
                    rdfs:subClassOf comcore:ont00000161;
                    skos:definition "A Coordinate System Axis designated by the variable 'y'."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000802 a owl:Class;
                    rdfs:label "Stage"@en;
                    rdfs:subClassOf comcore:ont00000641;
                    skos:definition "An Entertainment Facility that is designed to provide a space upon which entertaining performances or productions can occur."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Stage_(theatre)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000803 a owl:Class;
                    rdfs:label "Round"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Circular"@en;
                    skos:definition "A Shape Quality that inheres in a bearer in virtue of every point along its circumference being equidistant from the center."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/round";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000804 a owl:Class;
                    rdfs:label "Prism"@en;
                    rdfs:subClassOf comcore:ont00000136;
                    skos:definition "An Optical Instrument that is designed to refract light and which consists of a transparent material with flat polished surfaces where at least two of these surfaces have an angle between them."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Prism&oldid=1060221124"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000805 a owl:Class;
                    rdfs:label "Coiled"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer being wound in concentric rings or spirals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000806 a owl:Class;
                    rdfs:label "Power Tool"@en;
                    rdfs:subClassOf comcore:ont00000581;
                    skos:definition "A Tool that is designed to be actuated by a Power Source and mechanism other than or in addition to manual labor."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_tool&oldid=1057147715"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000807 a owl:Class;
                    rdfs:label "Compression Ignition Engine"@en;
                    rdfs:subClassOf comcore:ont00000394;
                    skos:definition "An Internal Combustion Engine that is designed to operate by igniting a portion of Fuel and Oxidizer mixture using heat generated via compression of the mixture."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000808 a owl:Class;
                    rdfs:label "Reactant Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which a substance or compound is added to a system in order to bring about a chemical reaction and is consumed in the course of the reaction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reagent&oldid=1017651471"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000809 a owl:Class;
                    rdfs:label "Submersible Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes of operating while submerged in water."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Submersible&oldid=1062994844"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000810 a owl:Class;
                    rdfs:label "Multi-Week Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000619];
                    skos:definition "A one-dimensional temporal region that is measured in Weeks and spans at least one Week."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000811 a owl:Class;
                    rdfs:label "Radio Wave Conversion Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact being used to convert electric power into radio waves or radio waves into electric power."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000812 a owl:Class;
                    rdfs:label "Electromagnetic Pulse"@en;
                    rdfs:subClassOf comcore:ont00000951;
                    skos:altLabel "EMP"@en,
                                  "Transient Electromagnetic Disturbance"@en;
                    skos:definition "An Electromagnetic Wave Process that consists of a short high-energy burst of electromagnetic energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_pulse&oldid=1060859738"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000813 a owl:Class;
                    rdfs:label "Portion of Nuclear Fuel"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:definition "A Portion of Material that is designed to be used in a nuclear fission process to produce energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000814 a owl:Class;
                    rdfs:label "Water Treatment Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for making water more acceptable for a specific end-use."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Water_treatment&oldid=1061706931"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000815 a owl:Class;
                    rdfs:label "Folded"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of one part of the bearer being layered over another connected part."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000816 a owl:Class;
                    rdfs:label "Portion of Liquid Nitrogen"@en;
                    rdfs:subClassOf comcore:ont00000255;
                    skos:definition "A Portion of Cryogenic Material that is composed (almost) entirely of liquid nitrogen."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000817 a owl:Class;
                    rdfs:label "Geospatial Line String"@en;
                    rdfs:subClassOf comcore:ont00000207;
                    skos:definition "A One-Dimensional Geospatial Boundary that has two or more Geospatial Positions as vertices, where each vertex is connected to only one other vertex by a straight line."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000818 a owl:Class;
                    rdfs:label "Orange"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is between Red and Yellow with a wavelength in the visible spectrum typically between 590 to 635 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000819 a owl:Class;
                    rdfs:label "Stasis"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    skos:definition "A Process in which one or more Independent Continuants endure in an unchanging condition."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000820 a owl:Class;
                    rdfs:label "Stasis of Function"@en;
                    rdfs:subClassOf comcore:ont00000246;
                    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Function that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000821 a owl:Class;
                    rdfs:label "Act of Promising"@en;
                    rdfs:subClassOf comcore:ont00001162;
                    skos:definition "An Act of Commissive Communication performed by declaring that the promising agent will do, or refrain from doing, the specified action."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/promise";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000822 a owl:Class;
                    rdfs:label "Very Low Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 4"@en;
                    skos:definition "A Radio Frequency that is between 3 and 30 kHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 100–10 km"@en;
                    comcore:ont00001753 "VLF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000823 a owl:Class;
                    rdfs:label "Optical Communication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001148;
                    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of visible light."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000824 a owl:Class;
                    rdfs:label "Stasis of Role"@en;
                    rdfs:subClassOf comcore:ont00000246;
                    skos:definition "A Stasis of Realizable Entity in which some Independent Continuant bears some Role that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000825 a owl:Class;
                    rdfs:label "Telecommunication Network Line"@en;
                    rdfs:subClassOf comcore:ont00000346;
                    skos:definition "A Communication Artifact that is designed to be the physical transmission medium that connects two or more Telecommunication Network Nodes within a Telecommunication Network to facilitate communication between the Nodes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_link&oldid=1062252217"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000826 a owl:Class;
                    rdfs:label "Refractivity"@en;
                    rdfs:subClassOf comcore:ont00001137;
                    skos:definition "A Radiation Reflectivity that inheres in a bearer in virtue of the capacity of that bearer to change the direction of a propagating wave when passing through it."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refractive_index&oldid=1062519140"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000827 a owl:Class;
                    rdfs:label "Time of Day Identifier"@en;
                    rdfs:subClassOf comcore:ont00000540;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000540
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom comcore:ont00000223]) ; 
                                         a owl:Class];
                    skos:definition "A Temporal Instant Identifier that designates some Time of Day."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000828 a owl:Class;
                    rdfs:label "Pesticide Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001123;
                    skos:definition "A Poison Artifact Function that is realized in a process which causes illness in, or the death of, a living thing that is detrimental to humans or human concerns."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/pesticide";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000829 a owl:Class;
                    rdfs:label "Time Zone Identifier"@en;
                    rdfs:subClassOf comcore:ont00000390;
                    skos:definition "A Spatial Region Identifier that designates the region associated with some uniform standard time for legal, commercial, or social purposes."@en;
                    skos:scopeNote """Standards of date, time, and time zone data formats:
ISO/WD 8601-2 (http://www.loc.gov/standards/datetime/iso-tc154-wg5_n0039_iso_wd_8601-2_2016-02-16.pdf)
W3C (https://www.w3.org/TR/NOTE-datetime)"""@en,
                                   "There is no class 'Time Zone' (the region), only 'Time Zone Identifier' (the designator for some region). Instances of 'Time Zone Identifier' should be related to instances of 'Information Bearing Entity' by means of the object properites 'uses time zone identifier' and 'time zone identifier used by' as appropriate. This is supposed to be analogous to the way we represent the relationship between measurement values and measurement units, where the relevant instance of Information Bearing Entity 'uses measurement unit' some instance of Measurement Unit (i.e., an instance of Information Content Entity)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000830 a owl:Class;
                    rdfs:label "Speed"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00001133];
                    skos:definition "A Process Profile that is characterized by the magnitude of an object's motion with respect to a frame of reference during some time period."@en;
                    skos:scopeNote "An object's speed is the scalar absolute value of it's Velocity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Speed&oldid=1058949945"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000831 a owl:Class;
                    rdfs:label "Herbicide Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000828;
                    skos:definition "A Pesticide Artifact Function that is realized in a process which causes harm to, or the death to, unwanted plants."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Herbicide&oldid=1061228045"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000832 a owl:Class;
                    rdfs:label "Year"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00001088];
                    skos:definition "A Temporal Interval that is equal to the approximate length of time required for an Astronomical Body to complete one Orbital Revolution around its Primary Body as specified relative to a particular Temporal Reference System."@en;
                    skos:scopeNote "Unless otherwise specified, a Year is assumed to be relative to the Orbiting of the Earth around the Sun and is approximately equal to 12 Months or 365 Days."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=year";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000833 a owl:Class;
                    rdfs:label "Julian Date Identifier"@en;
                    rdfs:subClassOf comcore:ont00000973,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00000589],
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00000749],
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001916 ; 
                                     owl:someValuesFrom comcore:ont00000359];
                    skos:definition "A Decimal Time of Day Identifier that designates a Julian Date and is composed of both a Julian Day Number and a Julian Date Fraction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000834 a owl:Class;
                    rdfs:label "Mid Infrared Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00001337;
                    skos:definition "An Infrared Light Frequency that is between 20 and 214 terahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000835 a owl:Class;
                    rdfs:label "Body Shape"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a Person's body by virtue of the body's general outline or figure."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000836 a owl:Class;
                    rdfs:label "Act of Financial Instrument Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Financial Instrument."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000837 a owl:Class;
                    rdfs:label "Family"@en;
                    rdfs:subClassOf comcore:ont00000914;
                    skos:definition "A Group of Persons related to one another by ancestry or marriage."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000838 a owl:Class;
                    rdfs:label "Portion of Fuel"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:definition "A Portion of Material that is designed to release thermal energy when reacted with other substances."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000839 a owl:Class;
                    rdfs:label "Act of Donating"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is tranfered by an Agent (the Donor) to another Agent (the Recipient) without return consideration."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Donation&oldid=1059373518"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000840 a owl:Class;
                    rdfs:label "Bicycle"@en;
                    rdfs:subClassOf comcore:ont00000618;
                    skos:definition "A Ground Vehicle that consists of two wheels, one in front of the other, attached to a frame along with handlebars and pedals such that it is designed to receive its motive power from pedaling."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bicycle&oldid=1063761124"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000841 a owl:Class;
                    rdfs:label "Explosive Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001153;
                    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of the rapid increase in volume and release of energy in an extreme manner."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/explosive";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000842 a owl:Class;
                    rdfs:label "Sub-Bass Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 20 and 60 Hz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000843 a owl:Class;
                    rdfs:label "Solar Panel"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that consists in part of one or more photovoltaic (i.e. solar) cells that convert light energy (photons) directly into electricity by means of the photovoltaic effect."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solar_cell&oldid=1063439932"^^xsd:anyURI,
                                        "https://en.wikipedia.org/w/index.php?title=Solar_panel&oldid=1064397496"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000844 a owl:Class;
                    rdfs:label "Measurement Unit of Temperature"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the thermal energy in an object."@en;
                    skos:example "celsius, fahrenheit, kelvin";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000845 a owl:Class;
                    rdfs:label "Proportional Ratio Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001022;
                    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a portion of a whole (described by the numerator) compared against that whole (described by the denominator) where the whole is a nominally described set of like entities."@en;
                    skos:scopeNote "A percentage is one way to express a proportional measure where the decimal expression of the proportion is multiplied by 100, thus giving the proportional value with respect to a whole of 100. E.g., the ratio of pigs to cows on a farm is 44 to 79 (44:79 or 44/79). The proportion of pigs to total animals is 44 to 123 or 44/123. The percentage of pigs is the decimal equivalent of the proportion (0.36) multiplied by a 100 (36%). The percentage can be expressed as a proportion where the numerator value is transformed for a denominator of 100, i.e., 36 of a 100 animals are pigs (36/100)."@en,
                                   "We may want to add either a subclass for Percentage or a data property (has percentage value) that links the percentage expression for a proportion to the relevant IBE."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000846 a owl:Class;
                    rdfs:label "Hydroelectric Power Plant"@en;
                    rdfs:subClassOf comcore:ont00001076;
                    skos:definition "An Electric Power Station that is designed to convert hydropower into electrical power."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hydroelectricity&oldid=1062438236"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000847 a owl:Class;
                    rdfs:label "Active Stasis"@en;
                    rdfs:subClassOf comcore:ont00001213;
                    owl:disjointWith comcore:ont00000936;
                    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact is realizing one or more of its designed Artifact Functions (especially one of its primary functions)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000848 a owl:Class;
                    rdfs:label "Mounted Gun"@en;
                    rdfs:subClassOf comcore:ont00000088;
                    skos:definition "A Firearm that is designed to be fired while mounted."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000849 a owl:Class;
                    rdfs:label "Heating System"@en;
                    rdfs:subClassOf comcore:ont00000453;
                    skos:definition "An Environment Control System that is designed to heat the air or objects in a Site."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000850 a owl:Class;
                    rdfs:label "Stasis of Quality"@en;
                    rdfs:subClassOf comcore:ont00000135;
                    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Quality that remains unchanged during a Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000851 a owl:Class;
                    rdfs:label "Light Machine Gun"@en;
                    rdfs:subClassOf comcore:ont00001104;
                    skos:definition "A Long Gun that is designed to fire bullets in quick succession from an ammunition belt or magazine and to be employed by an individual soldier, with or without assistance, and typically weighing 9-22 lbs."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Light_machine_gun&oldid=1063598801"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000852 a owl:Class;
                    rdfs:label "Measurement Unit of Work"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of displacements of points to which Forces have been applied."@en;
                    skos:example "joule, erg, kilowatt hour";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000853 a owl:Class;
                    rdfs:label "Descriptive Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    owl:disjointWith comcore:ont00000965;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000958
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001982 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:altLabel "Descriptive ICE"@en;
                    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000854 a owl:Class;
                    rdfs:label "Decrease of Realizable Entity"@en;
                    rdfs:subClassOf comcore:ont00000290;
                    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Realizable Entity that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000855 a owl:Class;
                    rdfs:label "Effect of Location Change"@en;
                    rdfs:subClassOf comcore:ont00000660,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000065],
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001819 ; 
                                     owl:someValuesFrom comcore:ont00000065];
                    skos:definition "An Effect caused by some Act of Location Change and which results in an Object being located in a different place."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000856 a owl:Class;
                    rdfs:label "Artifact History"@en;
                    rdfs:subClassOf pobo:BFO_0000182;
                    skos:definition "A History of a Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000857 a owl:Class;
                    rdfs:label "Ultra High Frequency Communication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some Ultra High Frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000858 a owl:Class;
                    rdfs:label "Improvised Explosive Device"@en;
                    rdfs:subClassOf comcore:ont00000552;
                    skos:definition "An Explosive Weapon that is designed to be used in non-conventional military action."@en;
                    comcore:ont00001753 "IED";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Improvised_explosive_device&oldid=1063432318"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000859 a owl:Class;
                    rdfs:label "Television Broadcast"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Television Broadcasting"@en;
                    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a television network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Television_broadcasting&oldid=1063890047"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000860 a owl:Class;
                    rdfs:label "Allied Person"@en;
                    rdfs:subClassOf comcore:ont00001262;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001262
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000587]) ; 
                                         a owl:Class];
                    skos:definition "A Person who is the bearer of some Ally Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000861 a owl:Class;
                    rdfs:label "Split"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a linear opening, or having been divided into parts."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000862 a owl:Class;
                    rdfs:label "Sound Process Profile"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000144
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000132 ; 
                                                             owl:someValuesFrom comcore:ont00000675]) ; 
                                         a owl:Class];
                    skos:altLabel "Sound Quality"@en;
                    skos:definition "A Process Profile that is part of a sound reception process and is characterized by properties of incoming sound waves as they are translated by some sensory system."@en;
                    comcore:ont00001754 "http://www.animations.physics.unsw.edu.au/waves-sound/quantifying/index.html",
                                        "https://en.wikipedia.org/w/index.php?title=Sound&oldid=1050465877"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000863 a owl:Class;
                    rdfs:label "Act of Confessing"@en;
                    rdfs:subClassOf comcore:ont00000379;
                    skos:definition "An Act of Representative Communication in which a person makes an admission of misdeeds or faults."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000864 a owl:Class;
                    rdfs:label "Public Safety Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of preventing and responding to events that could endanger the safety of the general public from significant danger, injury/harm, or damage, such as crimes or disasters (natural or man-made)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_security&oldid=1058257389"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000865 a owl:Class;
                    rdfs:label "Loss of Specifically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000876;
                    skos:definition "A Loss of Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Specifically Dependent Continuant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000866 a owl:Class;
                    rdfs:label "Radio Broadcast"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Radio Broadcasting"@en;
                    skos:definition "An Act of Communciation by Media that is transmitted to an audience through a radio network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_network&oldid=1037183126"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000867 a owl:Class;
                    rdfs:label "Pipeline"@en;
                    rdfs:subClassOf comcore:ont00000677;
                    skos:definition "A Product Transport Facility that is designed to transport goods or materials through a pipe."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Pipeline&oldid=1024308788"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000868 a owl:Class;
                    rdfs:label "Rocket Pod"@en;
                    rdfs:subClassOf comcore:ont00001173;
                    skos:definition "A Rocket Launcher that is designed to contain several Unguided Rockets held in individual tubes and to be used by Aircraft or Helicopters for close air support."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000869 a owl:Class;
                    rdfs:label "Optical Camera"@en;
                    rdfs:subClassOf comcore:ont00000199;
                    skos:definition "A Camera that is designed to form and record an image generated from visible light."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Camera&oldid=1063931551"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000870 a owl:Class;
                    rdfs:label "Infrastructure System"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    skos:altLabel "Infrastructure"@en;
                    skos:definition "A Material Entity that is composed of elements bearing Infrastructure Roles and is by itself sufficient to provide a planned service or benefit to some organization that maintains its elements."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000871 a owl:Class;
                    rdfs:label "Plant"@en;
                    rdfs:subClassOf comcore:ont00000551;
                    skos:definition "An Organism that is multicellular, eukaryotic, autotrophic, and has cells that contain chloroplasts and walls made of cellulose."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Plant&oldid=1060821100"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000872 a owl:Class;
                    rdfs:label "Brown"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that consists of dark orange and red, and of very low intensity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000873 a owl:Class;
                    rdfs:label "Physiographic Feature"@en;
                    rdfs:subClassOf comcore:ont00001081;
                    skos:definition "A Geographic Feature that is a geomorphological unit characterized by its surface form and location in the landscape."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Landform&oldid=1060439172"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000874 a owl:Class;
                    rdfs:label "Material Copy of a Video"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002009];
                    skos:altLabel "Video"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity in the form of a sequence of representations that are presented sufficiently rapidly to create the appearance of motion and continuity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Video&oldid=1049376249"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000875 a owl:Class;
                    rdfs:label "Act of Personal Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication having a small audience."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000876 a owl:Class;
                    rdfs:label "Loss of Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000004;
                    skos:definition "A Change in which some Independent Continuant ceases to be the bearer or carrier of some Dependent Continuant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000877 a owl:Class;
                    rdfs:label "Brake Control System"@en;
                    rdfs:subClassOf comcore:ont00000723;
                    skos:definition "A Vehicle Control System that is designed to control the process of braking with the aim of preventing rolling, skidding, and hydroplaning."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000878 a owl:Class;
                    rdfs:label "Identification Friend or Foe Transponder"@en;
                    rdfs:subClassOf comcore:ont00000325;
                    skos:altLabel "IFF"@en;
                    skos:definition "A Radio Transponder that is designed to automatically transmit a predefined signal in response to receiving an appropriate interrogation signal such that the entity it is located on can be positively identified as friendly."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Identification_friend_or_foe&oldid=1055168718"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000879 a owl:Class;
                    rdfs:label "Act of Religious Group Affiliation"@en;
                    rdfs:subClassOf comcore:ont00000433;
                    skos:definition "An Act of Association wherein some Person belongs to some Religious Demonination or sub-Denomination."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000880 a owl:Class;
                    rdfs:label "Religious Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes related to worship and prayer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Religion&oldid=1063431202"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000881 a owl:Class;
                    rdfs:label "Storage Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to store materials or goods."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Storage&oldid=1048222564"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000882 a owl:Class;
                    rdfs:label "Wind Farm"@en;
                    rdfs:subClassOf comcore:ont00001076;
                    skos:definition "An Electric Power Station that is designed to convert the wind's kinetic energy into electrical power by means of wind turbines."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wind_farm&oldid=1062817899"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000883 a owl:Class;
                    rdfs:label "Act of Inviting"@en;
                    rdfs:subClassOf comcore:ont00001162;
                    skos:definition "An Act of Commissive Communication performed by requesting the presence or participation of the audience, and which may include offering an incentive or inducement."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/invite";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000884 a owl:Class;
                    rdfs:label "Act of Loaning"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is given by an Agent (the Creditor) to another Agent (the Debtor) in order to receive Repayments from the Debtor which are of greater Financial Value."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Loan&oldid=1063513958"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000885 a owl:Class;
                    rdfs:label "Wavy"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Undulate"@en;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of it having a sinuous or rippled border."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000886 a owl:Class;
                    rdfs:label "Wired Communication Reception Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000422;
                    skos:definition "A Communication Reception Artifact Function that is realized during events in which a Material Artifact receives information transmitted from another Material Artifact, where the transmission of information occurs via a direct connection using an electrical conductor."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000887 a owl:Class;
                    rdfs:label "City"@en;
                    rdfs:subClassOf comcore:ont00000460;
                    skos:definition "A Local Administrative Region in which a relatively large human population permanently resides; is designated as a city based on a particular administrative, legal, or historical status; and which delimits a local Government that typically oversees the provision of systems for sanitation, utilities, land usage, housing, and transportation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=City&oldid=1062635325"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000888 a owl:Class;
                    rdfs:label "High Frequency Communication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is designed to participate in some process that has process part some High Frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000889 a owl:Class;
                    rdfs:label "Visible Observation"@en;
                    rdfs:subClassOf comcore:ont00000037,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000558];
                    skos:definition "An Act of Observation that involves visual perception."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000890 a owl:Class;
                    rdfs:label "Act of Travel"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change wherein one or more Persons move between relatively distant geographical locations for any purpose and any duration, with or without any means of transport."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Travel&oldid=1037229469"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000891 a owl:Class;
                    rdfs:label "Calendar System"@en;
                    rdfs:subClassOf comcore:ont00001328;
                    skos:definition "A Temporal Reference System that is designed to organize and identify dates."@en;
                    skos:scopeNote "Calendars typically organize dates through the use of naming and temporal conventions based on Days, Weeks, Months, and Years."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000892 a owl:Class;
                    rdfs:label "Depth"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a downward, backward, or inward direction."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000893 a owl:Class;
                    rdfs:label "Information Medium Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to have some Information Bearing Artifact as part."@en;
                    skos:example "A magnetic hard drive",
                                 "A notebook";
                    skos:scopeNote "An empty notebook, when manufactured, is a medium but not yet a carrier of information content. However, a book, in the sense of a novel or collection of philosophical essays or poems, depends necessarily on it carrying some information content. Thus, there are no empty books. Likewise, there are no empty databases, only portions of digital storage that have not yet been configured to carry some information content according to a database software application."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000894 a owl:Class;
                    rdfs:label "Decimal Date Identifier"@en;
                    rdfs:subClassOf comcore:ont00000529;
                    skos:definition "A Date Identifier that designates some Day by using a number to indicate the sequential ordering of the Day since a specified Reference Time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000895 a owl:Class;
                    rdfs:label "Married"@en;
                    rdfs:subClassOf comcore:ont00000335;
                    skos:altLabel "Married Stasis"@en;
                    skos:definition "A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws."@en;
                    comcore:ont00001754 "Haviland, William A.; Prins, Harald E. L.; McBride, Bunny; Walrath, Dana (2011). Cultural Anthropology: The Human Challenge (13th ed.). Cengage Learning. ISBN 978-0-495-81178-7",
                                        "https://en.wikipedia.org/w/index.php?title=Marriage&oldid=1064076951"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000896 a owl:Class;
                    rdfs:label "Mean Point Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000745;
                    skos:altLabel "Arithmetic Mean"@en,
                                  "Average"@en,
                                  "Mean"@en;
                    skos:definition "A Point Estimate Information Content Entity that is a measurement of a set of values and is equal to the sum of all the values in the set divided by the total number of values in the set."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000897 a owl:Class;
                    rdfs:label "Portion of Oxidizer"@en;
                    rdfs:subClassOf comcore:ont00000457;
                    skos:altLabel "Portion of Oxidant"@en,
                                  "Portion of Oxidizing Agent"@en;
                    skos:definition "A Portion of Material that is disposed to steal electrons from other substances (i.e. to oxidize other substances) as a participant in a reduction-oxidation process."@en;
                    skos:example "oxygen, hydrogen peroxide, chlorine, sulfiric acid, potassium nitrate";
                    skos:scopeNote "Oxidizers are essential participants in many processes including combustion and rusting. Hence, a portion of oxidizer must always be present along with a portion of fuel in order for combustion to occur."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000898 dcterms:bibliographicCitation "University, Utah State. Geopolitical Power | Aggies GO. https://chass.usu.edu/international-studies/aggies-go/power. Accessed 6 Apr. 2023.";
                    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Geopolitical Power Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000197 ; 
                                     owl:someValuesFrom comcore:ont00001180];
                    skos:definition "A Role had by an Organization, that is perceived by an International Community as capable of performing influential acts in that community, and which would be realized in performing such acts."@en;
                    skos:prefLabel "Geopolitical Power Role"@en;
                    comcore:ont00001754 "https://chass.usu.edu/international-studies/aggies-go/power";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000900 a owl:Class;
                    rdfs:label "Radio Communication Relay Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001169;
                    skos:definition "A Communication Relay Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information without the use of wires from one Material Artifact to another for the purpose of communiction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000901 a owl:Class;
                    rdfs:label "Decontamination Facility"@en;
                    rdfs:subClassOf comcore:ont00001375;
                    skos:definition "A Washing Facility that is designed to wash personnel or equipment after (potential) contamination by radioactive, biological, or chemical material."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Decontamination&oldid=1049850150"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000902 a owl:Class;
                    rdfs:label "Act of Facility Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which an Agent makes use of some Facility."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000903 a owl:Class;
                    rdfs:label "Radio Communication Instrument"@en;
                    rdfs:subClassOf comcore:ont00000346;
                    skos:definition "A Communication Instrument that is designed to enable communication between two or more entities via the use of radio waves."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000904 a owl:Class;
                    rdfs:label "Vehicle Track"@en;
                    rdfs:subClassOf comcore:ont00000205,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001855 ; 
                                     owl:someValuesFrom comcore:ont00000122];
                    skos:definition "An Object Track for a Vehicle during some motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000905 a owl:Class;
                    rdfs:label "Post Office"@en;
                    rdfs:subClassOf comcore:ont00000655;
                    skos:definition "A Mailing Facility that is designed for serving customers of the national postal system."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Post_office&oldid=1063684373"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000906 a owl:Class;
                    rdfs:label "Email Box"@en;
                    rdfs:subClassOf comcore:ont00000690;
                    skos:definition "A Telecommunication Instrument that is designed to be the delivery destination of Email Messages that are addressed to the corresponding Email Address."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Email_box&oldid=1061295368"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000907 a owl:Class;
                    rdfs:label "Telephone"@en;
                    rdfs:subClassOf comcore:ont00000690;
                    skos:altLabel "Phone"@en;
                    skos:definition "A Telecommunication Instrument that is designed to provide point-to-point communication between agents by means of audio messages."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone&oldid=1060006278"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000908 a owl:Class;
                    rdfs:label "Act of Material Artifact Processing"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of performing a series of physical operations on a material artifact in order to change or preserve the artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000909 a owl:Class;
                    rdfs:label "Emergency AC/DC Power Source"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that is designed to provide electrical power in an emergency situation by means of both alternating current and direct current."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000910 a owl:Class;
                    rdfs:label "Amplitude"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00000644];
                    skos:definition "A Process Profile of an Oscillation Process that is the absolute value of the maximum displacement from a zero, equilibrium, or mean value during one cycle of the Oscillation Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000911 a owl:Class;
                    rdfs:label "Semi-Major Axis"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that is equal to half the length of the Major Axis of an Ellipse."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000912 a owl:Class;
                    rdfs:label "Pyramidal"@en;
                    rdfs:subClassOf comcore:ont00001360;
                    skos:definition "A Three Dimensional Shape that inheres in a bearer in virtue of it having a polygonal base with vertices that all connect to the same apex to form triangular faces."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Pyramid_(geometry)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000913 a owl:Class;
                    rdfs:label "Maroon"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color consisting of purple and brown hue."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000914 a owl:Class;
                    rdfs:label "Group of Persons"@en;
                    rdfs:subClassOf comcore:ont00000300,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00001262],
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:allValuesFrom comcore:ont00001262];
                    skos:definition "A Group of Agents that has only Persons as member parts."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000915 a owl:Class;
                    rdfs:label "Acronym"@en;
                    rdfs:subClassOf comcore:ont00000605;
                    skos:definition "An Abbreviated Name that combines the initial letters of a Designative Name and which is pronounced as a word."@en;
                    skos:example "Wi-Fi, ASCII, OPSEC";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000916 a owl:Class;
                    rdfs:label "Lunar Calendar System"@en;
                    rdfs:subClassOf comcore:ont00000891;
                    skos:definition "A Calendar System that is designed to organize and identify dates based on the cycles of the Moon's phases."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lunar_calendar&oldid=1055396837"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000917 dcterms:bibliographicCitation "Permanent Residency - Wikipedia. https://en.wikipedia.org/wiki/Permanent_residency. Accessed 10 Feb. 2023.";
                    dcterms:created "2023-03-29T20:17:54-04:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Permanent Resident Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A role inhering in a Person by virtue of that Person being recognized as having legal resident status in a Government Domain in which that person is not a citizen but where they have the right to reside on a permanent basis."@en;
                    skos:prefLabel "Permanent Resident Role"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Permanent_residency";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000918 a owl:Class;
                    rdfs:label "Telecommunication Network Node"@en;
                    rdfs:subClassOf comcore:ont00000346,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00000998];
                    skos:definition "A Communication Artifact that consists of a connection point, redistribution point, or endpoint that is designed to be part of a Telecommunication Network and can be either active or passive."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Node_(networking)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000919 a owl:Class;
                    rdfs:label "Parts List"@en;
                    rdfs:subClassOf comcore:ont00000575;
                    skos:definition "A Quality Specification that prescribes the Amount of some type of Material Artifact that are part of or located on another Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000920 a owl:Class;
                    rdfs:label "Death"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:definition "A Natural Process in which all biological functions that sustain a living organism cease."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Death&oldid=1064114499"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000921 a owl:Class;
                    rdfs:label "Calendar Day"@en;
                    rdfs:subClassOf comcore:ont00000800;
                    skos:definition "A Day that begins and ends concurrently with the Seconds specified by a Calendar System to be the first and last Seconds of the Day."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000922 a owl:Class;
                    rdfs:label "Act of Arrival"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change that consists of the participating entity reaching its destination such that the larger Act of Location Change is completed."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000923 a owl:Class;
                    rdfs:label "Arbitrary Identifier"@en;
                    rdfs:subClassOf comcore:ont00000649;
                    skos:altLabel "Arbitrary ID"@en;
                    skos:definition "A Non-Name Identifier that consists of a string of characters that does not follow an encoding system."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000924 a owl:Class;
                    rdfs:label "Beginning of Life Stasis"@en;
                    rdfs:subClassOf comcore:ont00001191;
                    skos:definition "A Operational Stasis that holds during a Temporal Interval when a Material Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels."@en;
                    skos:scopeNote "A Beginning of Life Stasis (BoL) is a relatively brief Operational Stasis that is primarily of interest for the purpose of establishing a baseline for operational parameters to be compared to the designed specifications as well as the Material Artifact's performance throughout its operational life."@en;
                    comcore:ont00001753 "BOL",
                                        "BoL";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000925 a owl:Class;
                    rdfs:label "Act of Military Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000687;
                    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of Military Operations from an Agent or communication medium that realizes a capacity derived from its affiliation with a Military Organization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000926 a owl:Class;
                    rdfs:label "Act of Apologizing"@en;
                    rdfs:subClassOf comcore:ont00000123;
                    skos:definition "An Act of Expressive Communication performed by acknowledging and expressing regret for a fault, shortcoming, or failure."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=apologizing";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000927 a owl:Class;
                    rdfs:label "Bass Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 60 and 250 Hz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000928 a owl:Class;
                    rdfs:label "Train Car"@en;
                    rdfs:subClassOf comcore:ont00000796;
                    skos:altLabel "Railroad Car"@en;
                    skos:definition "A Rail Transport Vehicle that consists of a single Vehicle that is not a Train but is designed to be connected to other Train Cars along with at least one Locomotive to form a Train."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Railroad_car&oldid=1063802472"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000929 a owl:Class;
                    rdfs:label "Part Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an entity in virtue of it being part of some other entity without being subject to further subdivision or disassembly without destruction of its designated use."@en;
                    comcore:ont00001754 "http://origins.sese.asu.edu/ses405/Class%20Notes/Sys-Hier-WBS_Module_V1.0_PAS.pdf"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000930 a owl:Class;
                    rdfs:label "Nickel-metal Hydride Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001105;
                    skos:altLabel "NiMH Battery"@en;
                    skos:definition "A Secondary Cell Electric Battery that has a metal-hydride anode and nickel oxide hydroxide cathode."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nickel%E2%80%93metal_hydride_battery&oldid=1061626676"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000932 a owl:Class;
                    rdfs:label "Computing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a computation process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000933 a owl:Class;
                    rdfs:label "Landline Telephone"@en;
                    rdfs:subClassOf comcore:ont00000907;
                    skos:definition "A Telephone that is connected to a Telephone Network through a pair of wires."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone&oldid=1060006278"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000934 a owl:Class;
                    rdfs:label "Constituent State"@en;
                    rdfs:subClassOf comcore:ont00000126;
                    skos:altLabel "State"@en;
                    skos:definition "A First-Order Administrative Region that is part of a Country and delimits a centralized regional Government that holds constitutionally-defined administrative jurisdiction over the defined geographic territory that bounds the State."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Constituent_state&oldid=1063662102"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000935 a owl:Class;
                    rdfs:label "Act of Legal Instrument Use"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which some Agent uses some Legal Instrument."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000936 a owl:Class;
                    rdfs:label "Deactivated Stasis"@en;
                    rdfs:subClassOf comcore:ont00001213;
                    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact is not realizing any of its designed Artifact Functions (or at least not realizing any of its primary functions)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000937 a owl:Class;
                    rdfs:label "Inhibiting Motion Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to inhibit the motion of some object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000938 a owl:Class;
                    rdfs:label "Financial Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of managing money."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000939 a owl:Class;
                    rdfs:label "Geospatial Line"@en;
                    rdfs:subClassOf comcore:ont00000817;
                    skos:definition "A Geospatial Line String that has only two vertices."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00000940 a owl:Class;
                    rdfs:label "Measurement Unit of Momentum"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the Momentum of a portion of matter that is in Motion."@en;
                    skos:example "kg m/s, slug ft/s, g m/s";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000941 a owl:Class;
                    rdfs:label "Phosphorescence"@en;
                    rdfs:subClassOf comcore:ont00001126;
                    skos:definition "A Luminescent Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light after absorbing shorter wavelength radiation, and to continue emitting after the absorbing process has ceased."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Phosphorescence&oldid=1060815719"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000942 a owl:Class;
                    rdfs:label "Sniper Rifle"@en;
                    rdfs:subClassOf comcore:ont00000204;
                    skos:definition "A Rifle that is designed to be highly accurate for long-range precision tactical shooting."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sniper_rifle&oldid=1061592308"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000943 a owl:Class;
                    rdfs:label "Ocular Prosthesis"@en;
                    rdfs:subClassOf comcore:ont00001248;
                    skos:definition "An Artificial Eye that is designed to replace a missing eye, but which does not function as an eye."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ocular_prosthesis&oldid=1061336760"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000944 a owl:Class;
                    rdfs:label "Thermal Imaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000601;
                    skos:definition "An Imaging Artifact Function that is realized during events in which a Material Artifact is used to create a visual representation of an entity using radiation from the far infrared region of the electromagnetic spectrum that the entity emits"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000945 a owl:Class;
                    rdfs:label "X-ray Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing X-rays to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=X-ray_telescope&oldid=1035025593"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000946 a owl:Class;
                    rdfs:label "Government Building"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for the administration of a community."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Administration_(government)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000947 a owl:Class;
                    rdfs:label "Temperature Measurement Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001100;
                    skos:definition "A Measurement Artifact Function that is realized during events in which a Material Artifact is used to measure the Temperature of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000948 a owl:Class;
                    rdfs:label "Act of Religious Worship"@en;
                    rdfs:subClassOf comcore:ont00000455;
                    skos:definition "An Act of Ceremony wherein there occurs acts of religious devotion usually directed towards a deity."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Worship (Sense Key: Worship%2:42:00 or Worship%1:04:00::)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000949 a owl:Class;
                    rdfs:label "Act of Consumption"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which a resource is ingested or used up."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000950 a owl:Class;
                    rdfs:label "Act of Maintenance"@en;
                    rdfs:subClassOf comcore:ont00000970;
                    skos:definition "An Act of Artifact Modification in which a Material Artifact is modified in order to preserve or restore one or more of its designed Qualities or Functions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000951 a owl:Class;
                    rdfs:label "Electromagnetic Wave Process"@en;
                    rdfs:subClassOf comcore:ont00000099,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000514];
                    skos:altLabel "Electromagnetic Radiation"@en;
                    skos:definition "A Wave Process that is produced by charged particles, involves the periodic Oscillation of electric and magnetic fields at right angles to each other and the direction of wave propogation such that it has a Transverse Wave Profile, and which transfers electromagnetic radiant energy through a portion of space or matter."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000952 a owl:Class;
                    rdfs:label "Electric Motor"@en;
                    rdfs:subClassOf comcore:ont00000210;
                    skos:altLabel "Electric Engine"@en;
                    skos:definition "An Engine that is designed to convert electrical energy into mechanical energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_motor&oldid=1063829856"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000953 a owl:Class;
                    rdfs:label "Pitch"@en;
                    rdfs:subClassOf comcore:ont00000862;
                    skos:definition "A Sound Process Profile that is characterized by the frequency of translated sound waves, typically on a continuum from low to high."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000954 a owl:Class;
                    rdfs:label "Telecommunication Infrastructure"@en;
                    rdfs:subClassOf comcore:ont00000870;
                    skos:definition "An Infrastructure System that is designed to support the use of Telecommunication Instruments to communicate."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Category:Telecommunications_infrastructure&oldid=989151314"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000955 a owl:Class;
                    rdfs:label "Angular Momentum"@en;
                    rdfs:subClassOf comcore:ont00000278;
                    skos:definition "A Momentum that is the product of an object's moment of inertia and its Angular Velocity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Angular_momentum&oldid=1063992505"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000956 a owl:Class;
                    rdfs:label "Highway Interchange"@en;
                    rdfs:subClassOf comcore:ont00001086;
                    skos:definition "A Road Junction that is designed to enable Ground Vehicles to exit one or more Highways and enter another Highway without directly crossing any other traffic stream."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Interchange_(road)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000957 a owl:Class;
                    rdfs:label "Reservoir"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store water in a man-made open enclosure or area."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Reservoir&oldid=1055068000"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00000958 a owl:Class;
                    rdfs:label "Information Content Entity"@en;
                    rdfs:subClassOf pobo:BFO_0000031;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000031
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001808 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:altLabel "ICE"@en;
                    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en;
                    skos:scopeNote "Information Content Entity is here intended to be a class of Entities whose instances are the informational content of Information Bearing Entities. For example, three instances of information bearers -- such as a bar chart, color-coded map, and a written report -- each of which lists the GDP of Countries for the year 2010 are each different carriers of the same information content. It is this content that is generically dependent upon its carrier. This treatment of Informational Content Entity (cf. the Information Artifact Ontology) leads to a principle of subtyping based upon the relationship that ICE's have with the Entity they are about rather than characteristics such as format, language, measurement scale, or media. The latter are treated here as being Qualities of bearers."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/IAO_0000030";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000959 a owl:Class;
                    rdfs:label "Measurement Unit of Frequency"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the number of times an event repeats per unit of time."@en;
                    skos:example "hertz, revolutions per minute";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000960 a owl:Class;
                    rdfs:label "Fixed Line Network Telephone Call"@en;
                    rdfs:subClassOf comcore:ont00001190;
                    skos:definition "A Telephone Call transmitted over a telephone network where the telephones are wired into a single telephone exchange."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000961 a owl:Class;
                    rdfs:label "Current Conversion Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:definition "An Electrical Artifact Function that is realized by processes in which some Material Artifact is used to convert some electrical current."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000962 a owl:Class;
                    rdfs:label "Portion of Liquid Propellant"@en;
                    rdfs:subClassOf comcore:ont00000593;
                    skos:definition "A Portion of Propellant that is stored in a liquid state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000963 a owl:Class;
                    rdfs:label "Fuel Transfer System"@en;
                    rdfs:subClassOf comcore:ont00000256;
                    skos:definition "A Fluid Control Artifact that is designed to facilitate the transfer of some Portion of Fuel from the Fuel Tank for use in some Engine."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000964 a owl:Class;
                    rdfs:label "Medium Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 6"@en;
                    skos:definition "A Radio Frequency that is between 300 kHz and 3 MHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 1,000–100 m"@en;
                    comcore:ont00001753 "MF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000965 a owl:Class;
                    rdfs:label "Prescriptive Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000958
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001942 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:altLabel "Directive ICE"@en;
                    skos:definition "An Information Content Entity that consists of a set of propositions or images (as in the case of a blueprint) that prescribe some Entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000967 a owl:Class;
                    rdfs:label "Height"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the bearer's extension in a vertical direction."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000968 a owl:Class;
                    rdfs:label "Assault Rifle"@en;
                    rdfs:subClassOf comcore:ont00000204;
                    skos:definition "A Rifle that is designed to have selective-fire functionality and use an intermediate Cartridge and a detachable magazine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Assault_rifle&oldid=1063774380"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000969 a owl:Class;
                    rdfs:label "Measurement Unit of Speed"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the rates at which objects traverse distance."@en;
                    skos:example "miles per hour, kilometers per hour, knot, mach";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00000970 a owl:Class;
                    rdfs:label "Act of Artifact Modification"@en;
                    rdfs:subClassOf comcore:ont00000908;
                    skos:definition "An Act of Material Artifact Processing in which an existing Material Artifact is acted upon in a manner that changes, adds, or removes one or more of its Qualities, Dispositions, or Functions."@en;
                    skos:scopeNote "Excluded from this class are instances of role change or role creation such as the introduction of an artifact as a piece of evidence in a trial or the loading of artifacts onto a ship for transport."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000971 a owl:Class;
                    rdfs:label "Act of Deceptive Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "Ac Act of Communication intended to mislead the audience by distortion or falsification of evidence and induce a reaction that is prejudicial to the interests of the audience."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000973 a owl:Class;
                    rdfs:label "Decimal Time of Day Identifier"@en;
                    rdfs:subClassOf comcore:ont00000827;
                    skos:altLabel "Fractional Time of Day Identifier"@en;
                    skos:definition "A Time of Day Identifier that designates an approximate Temporal Instant that is part of some Day and is specified using a decimal value for the portion of the Day that preceded the Temporal Instant."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000974 a owl:Class;
                    rdfs:label "Plan"@en;
                    rdfs:subClassOf comcore:ont00000965,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00000476];
                    skos:definition "A Prescriptive Information Content Entity that prescribes some set of intended Intentional Acts through which some Agent expects to achieve some Objective."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Plan&oldid=1047320560"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000975 a owl:Class;
                    rdfs:label "Cyan"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is between Green and Blue with a wavelength in the visible spectrum typically between 490 and 520 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000976 a owl:Class;
                    rdfs:label "Political Orientation"@en;
                    rdfs:subClassOf comcore:ont00000696;
                    skos:definition "An Ideology that characterizes the political thinking of an Agent or Group of Agents, usually with respect to the political environment within a particular nation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000977 a owl:Class;
                    rdfs:label "Act of Publishing Mass Media Documentary"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving the preparation and public issuance of information that provides a factual record or report."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000978 a owl:Class;
                    rdfs:label "Cause"@en;
                    rdfs:subClassOf pobo:BFO_0000015;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000015
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001803 ; 
                                                             owl:someValuesFrom pobo:BFO_0000015]) ; 
                                         a owl:Class];
                    skos:definition "A Process that is the cause of or one of the causes of some other Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000979 a owl:Class;
                    rdfs:label "Closure"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the degree to which that bearer affords passage or sightline through it via an opening, aperture, orifice, or vent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000980 a owl:Class;
                    rdfs:label "Portion of Waste Material"@en;
                    rdfs:subClassOf comcore:ont00001084;
                    skos:definition "A Portion of Processed Material that serves no further use in terms of the initial user's own purposes of production, transformation, or consumption such that the Agent wants to dispose of it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000981 a owl:Class;
                    rdfs:label "Act of Portion of Material Consumption"@en;
                    rdfs:subClassOf comcore:ont00000566;
                    skos:definition "An Act of Artifact Employment in which a Portion of Material is expended."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000982 a owl:Class;
                    rdfs:label "Decrease of Function"@en;
                    rdfs:subClassOf comcore:ont00000543;
                    skos:definition "A Decrease of Disposition in which some Independent Continuant has a decrease of some Function that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000983 a owl:Class;
                    rdfs:label "Shear Wave Process"@en;
                    rdfs:subClassOf comcore:ont00001028;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001028
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001777 ; 
                                                             owl:someValuesFrom comcore:ont00000514]) ; 
                                         a owl:Class];
                    skos:definition "A Mechanical Wave that has a Transverse Wave Profile."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000984 a owl:Class;
                    rdfs:label "Occupation Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent in virtue of the responsibilities that Agent is expected to fulfill within the context of some Act of Employment."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000985 a owl:Class;
                    rdfs:label "Thermal Insulation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001350;
                    skos:definition "A Thermal Control Artifact Function that is realized during events in which a Material Artifact prevents or reduces the transfer of heat between objects that are in thermal contact or in range of radiative influence."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Thermal_insulation&oldid=1059273300"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000986 a owl:Class;
                    rdfs:label "Scar"@en;
                    rdfs:subClassOf comcore:ont00000084;
                    skos:definition "A Bodily Component that consists of a portion of fibrous connective tissue on skin or within body tissue and which was formed due to an injury that has not healed completely."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Scar&oldid=1057179533"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000987 a owl:Class;
                    rdfs:label "Citizen Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in a Person by virtue of that Person being legally recognized as a member of a particular state, with associated rights and obligations."@en;
                    comcore:ont00001754 "http://en.wikitionary.org/wiki/citizen";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00000988 a owl:Class;
                    rdfs:label "Reflective Prism"@en;
                    rdfs:subClassOf comcore:ont00000804;
                    skos:definition "A Prism designed to reflect light in order to flip, invert, rotate, deviate, or displace a beam of light entering the Prism."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000989 a owl:Class;
                    rdfs:label "Super High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000732;
                    skos:altLabel "ITU Band Number 10"@en;
                    skos:definition "A Microwave Frequency that is between 3 and 30 GHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 100–10 mm"@en;
                    comcore:ont00001753 "SHF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00000990 a owl:Class;
                    rdfs:label "Nickname"@en;
                    rdfs:subClassOf comcore:ont00000003;
                    skos:definition "A Designative Name that is a familiar or humorous substitute for an entity's Proper Name."@en;
                    skos:example "Ike, Chief, P-Fox";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00000991 a owl:Class;
                    rdfs:label "Bent"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Angular"@en,
                                  "Kinked"@en;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having one or more angles along its border."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000992 a owl:Class;
                    rdfs:label "Second"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00000085];
                    skos:definition "A Temporal Interval that is equal to the duration of 9,192,631,770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the cesium 133 atom."@en;
                    skos:scopeNote "The Second is used as the basic SI unit of time."@en;
                    comcore:ont00001754 "https://physics.nist.gov/cuu/Units/second.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00000993 a owl:Class;
                    rdfs:label "Power Rectifying Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000961;
                    skos:definition "A Current Conversion Artifact Function that is realized by processes in which some Material Artifact is used to convert alternating current (AC) to direct current (DC)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000994 a owl:Class;
                    rdfs:label "Electrical Power Production Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:definition "An Electrical Artifact Function that is realized during events in which a Material Artifact is used to generate electrical power."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000995 a owl:Class;
                    rdfs:label "Material Artifact"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000996 a owl:Class;
                    rdfs:label "Ramjet Engine"@en;
                    rdfs:subClassOf comcore:ont00000294;
                    skos:altLabel "Ramjet"@en;
                    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air (without the use of an axial compressor) and decelerate it to subsonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ramjet&oldid=1062836331"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000997 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Disrupting Disposition"@en;
                    rdfs:subClassOf pobo:BFO_0000016;
                    skos:definition "A disposition the realization of which would disrupt a process some entity has an interest in."@en;
                    skos:editorialNote "This is a defined class. A Disrupting Disposition is indexed by the interest_in object property. A disposition can be a Disrupting Disposition according to one index and not a Disrupting Disposition according to another index.";
                    skos:prefLabel "Threat"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00000998 a owl:Class;
                    rdfs:label "Telecommunication Network"@en;
                    rdfs:subClassOf comcore:ont00001036;
                    skos:definition "A Communication System that is designed to enable the transmission of information over significant distances between Telecommunication Endpoints via Telecommunication Network Nodes and Lines."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications_network&oldid=1063347482"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00000999 a owl:Class;
                    rdfs:label "Defunct Stasis"@en;
                    rdfs:subClassOf comcore:ont00001213;
                    owl:disjointWith comcore:ont00001191;
                    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact no longer maintains its designed set of Artifact Functions (or at least no longer maintains its primary functions)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001000 a owl:Class;
                    rdfs:label "Spray Nozzle"@en;
                    rdfs:subClassOf comcore:ont00000252;
                    skos:definition "A Nozzle that is designed to facilitate a conversion of the flow of a portion of liquid into a dynamic collection of drops dispersed in a portion of gas."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001001 a owl:Class;
                    rdfs:label "Drooping"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a border that hangs downwards."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001002 a owl:Class;
                    rdfs:label "Material Copy of a Message"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002010];
                    skos:altLabel "Message"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity that is relatively brief and to be transmitted from a sender to a recipient."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Message&oldid=1060098631"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001003 a owl:Class;
                    rdfs:label "Cartridge"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to package a Bullet, a propellant substance, and a primer within a case that is designed to fit within the firing chamber of a Firearm."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Cartridge_(firearms)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001004 a owl:Class;
                    rdfs:label "Measurement Unit of Electromagnetic Force"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the electromagnetic force between electrically charged entities."@en;
                    skos:example "volt, ampere, coulomb";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001005 a owl:Class;
                    rdfs:label "Turbojet Air-Breathing Jet Engine"@en;
                    rdfs:subClassOf comcore:ont00000294;
                    skos:definition "An Air-Breathing Jet Engine that uses a Turbojet, which consists of a Turbine with a Propelling Nozzle."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Turbojet&oldid=1060948529"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001006 a owl:Class;
                    rdfs:label "Operator Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in an Agent by virtue of that Agent's responsibilities to operate or control some Material Artifact."@en;
                    skos:example "the role of driving a car",
                                 "the role of flying an airplane",
                                 "the role of operating a crane";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001007 a owl:Class;
                    rdfs:label "Passenger Train Car"@en;
                    rdfs:subClassOf comcore:ont00000928;
                    skos:definition "A Train Car that is designed to transport passengers."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Passenger_car_(rail)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001008 a owl:Class;
                    rdfs:label "Biological Weapon"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, incapacity, or death by means of releasing disease-producing agents—such as bacteria, viruses, or fungi."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Biological_warfare&oldid=1062972883"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001009 a owl:Class;
                    rdfs:label "Optical Telescope"@en;
                    rdfs:subClassOf comcore:ont00000547;
                    skos:definition "A Telescope that is designed to aid in the observation of spatially distant Objects by means of collecting and focusing visible light to form an enhanced image of the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Optical_telescope&oldid=1062201329"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001010 a owl:Class;
                    rdfs:label "Ordinal Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    owl:disjointWith comcore:ont00001022,
                                     comcore:ont00001364;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001163
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001811 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:definition "A Measurement Information Content Entity that consists of a symbol that places an Entity into some rank order."@en;
                    skos:example """The sentence \"The coldest day in history in Chicago, IL. is January 20, 1985.\" is the carrier of an ordinal measurment."""@en,
                                 "a measurement that places Geospatial Regions into a rank order of small, medium, large",
                                 "a measurement that places military units onto a readiness rank order of red, yellow, green";
                    skos:scopeNote """Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001011 a owl:Class;
                    rdfs:label "Automobile"@en;
                    rdfs:subClassOf comcore:ont00000053;
                    skos:definition "A Ground Motor Vehicle that is designed to transport a small number of passengers while traveling on four tired wheels."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Car&oldid=1064116950"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001013 a owl:Class;
                    rdfs:label "Heating Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which the thermal energy of a system increases."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001014 a owl:Class;
                    rdfs:label "Proper Name"@en;
                    rdfs:subClassOf comcore:ont00000003;
                    skos:definition "A Designative Name that is an official name for a particular entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001015 a owl:Class;
                    rdfs:label "Controlled-Access Highway"@en;
                    rdfs:subClassOf comcore:ont00000646;
                    skos:altLabel "Expressway"@en,
                                  "Freeway"@en,
                                  "Motorway"@en;
                    skos:definition "A Highway that is designed for high-speed vehicular traffic, with traffic flow and ingress/egress regulated."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Controlled-access_highway&oldid=1063655601"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001016 a owl:Class;
                    rdfs:label "Portion of Lithosphere"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A fiat object part of the rigid, outermost rocky shell of a natural satellite."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lithosphere&oldid=1143215085"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001017 a owl:Class;
                    rdfs:label "Agent"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    owl:equivalentClass [owl:intersectionOf (pobo:BFO_0000040
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00001379]) ; 
                                         a owl:Class];
                    skos:definition "A Material Entity that bears an Agent Capability."@en;
                    comcore:ont00001754 """Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001018 a owl:Class;
                    rdfs:label "Equipment Cooling System"@en;
                    rdfs:subClassOf comcore:ont00000350;
                    skos:definition "A Cooling System that is designed to cool some piece of equipment."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001019 a owl:Class;
                    rdfs:label "Steering Control System"@en;
                    rdfs:subClassOf comcore:ont00000723;
                    skos:definition "A Vehicle Control System that is designed to control the direction some Vehicle is traveling."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001020 a owl:Class;
                    rdfs:label "Portion of Gaseous Fuel"@en;
                    rdfs:subClassOf comcore:ont00000838;
                    skos:definition "A Portion of Fuel that is stored in a gaseous state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001021 a owl:Class;
                    rdfs:label "Act of Denying"@en;
                    rdfs:subClassOf comcore:ont00000379;
                    skos:definition "An Act of Representative Communication performed by either asserting that something is not true or real or refusing to satisfy a request or desire."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/denial";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001022 a owl:Class;
                    rdfs:label "Ratio Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    owl:disjointWith comcore:ont00001364;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001163
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001983 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:definition "A Measurement Information Content Entity that consists of a symbol that places a Quality of an Entity onto an interval scale having a true zero value."@en;
                    skos:example """The sentence \"The temperature reached 240.372 degrees Kelvin on January 20, 1985 in Chicago, IL.\" is the carrier of a ratio measurement as 0 degrees on the Kelvin scale does describe absolute zero."""@en,
                                 "a measurement of the barometric pressure at 1,000 feet above sea level",
                                 "a measurement of the measure of air temperature on the Kelvin scale",
                                 "a measurement of the number of members in an Organization";
                    skos:scopeNote """Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001023 a owl:Class;
                    rdfs:label "Calendar Week"@en;
                    rdfs:subClassOf comcore:ont00000619;
                    skos:definition "A Week that begins and ends concurrently with the Days specified by a Calendar System to be the first and last Days of the Week."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=calendar+week";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001024 a owl:Class;
                    rdfs:label "Spark Ignition Engine"@en;
                    rdfs:subClassOf comcore:ont00000394;
                    skos:definition "An Internal Combustion Engine that is designed to operate by generating a spark to ignite a portion of Fuel and Oxidizer mixture."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001025 a owl:Class;
                    rdfs:label "Electric Generator"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:definition "An Electrical Power Source that is designed to convert mechanical energy to electrical energy for use in an external circuit."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electric_generator&oldid=1057805035"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001026 a owl:Class;
                    rdfs:label "Pointing Orientation"@en;
                    rdfs:subClassOf comcore:ont00000119;
                    skos:altLabel "Facing Orientation"@en;
                    skos:definition "A Spatial Orientation of a Material Entity in which one or more of its designated components are oriented toward a specified direction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001027 a owl:Class;
                    rdfs:label "Trim Tab"@en;
                    rdfs:subClassOf comcore:ont00000095;
                    skos:definition "A Control Surface that is designed to counteract hydro-, aerodynamic, or other forces in order to stabilize the Vehicle it is part of in the desired Attitude."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Trim_tab&oldid=1054550485"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001028 a owl:Class;
                    rdfs:label "Mechanical Wave Process"@en;
                    rdfs:subClassOf comcore:ont00000099;
                    skos:definition "A Wave Process that involves Oscillation of a portion of matter such that energy is transferred through the material medium."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Mechanical_wave&oldid=1057233679"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001029 a owl:Class;
                    rdfs:label "Unguided Rocket"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:altLabel "Rocket"@en;
                    skos:definition "A Portion of Ammunition that is designed to be a self-propelled, but unguided, projectile that delivers some payload (explosive or other) over relatively long distances through the use of a Rocket Engine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Rocket_(weapon)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001030 a owl:Class;
                    rdfs:label "Train"@en;
                    rdfs:subClassOf comcore:ont00000796;
                    skos:altLabel "Railroad Train"@en,
                                  "Railway Train"@en;
                    skos:definition "A Rail Transport Vehicle that consists of a series of connected Train Cars or Railcars."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Train&oldid=1064071492"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001031 a owl:Class;
                    rdfs:label "Act of Volunteering"@en;
                    rdfs:subClassOf comcore:ont00001162;
                    skos:definition "An Act of Commissive Communication performed by voluntarily undertaking or expressing a willingness to undertake a service."@en;
                    skos:example "entering into military service voluntarily",
                                 "rendering a service voluntarily";
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/volunteer";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001032 a owl:Class;
                    rdfs:label "Act of Assignment"@en;
                    rdfs:subClassOf comcore:ont00001374;
                    skos:definition "An Act of Declarative Communication in which rights held by one party (the assignor) are transferred to another party (the assignee) with regard to a particular entity as specified by the details of the assignment, which is often prescribed by a contract."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Assignment_(law)&oldid=1056101591"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001033 a owl:Class;
                    rdfs:label "Biological Sex"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality inhering in a bearer by virtue of the bearer's ability to undergo sexual reproduction in order to differentiate the individuals or types involved."@en;
                    comcore:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000047";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001034 a owl:Class;
                    rdfs:label "Full Motion Video Camera"@en;
                    rdfs:subClassOf comcore:ont00000774;
                    skos:definition "A Video Camera that is designed to capture and record images of sufficiently high quality and in rapid enough succession that the resulting video supports smooth playback."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001035 a owl:Class;
                    rdfs:label "Pitch Axis"@en;
                    rdfs:subClassOf comcore:ont00000387;
                    skos:altLabel "Lateral Axis"@en;
                    skos:definition "An Axis of Rotation that passes through the center of an object's Mass and is perpendicular both to the direction of the object's motion and to the object's Yaw Axis."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001036 a owl:Class;
                    rdfs:label "Communication System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to enable some Act of Communication by means of transmission systems, relay stations, tributary stations, and data terminal equipment, usually capable of interconnection and interoperation to form an integrated whole."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communications_system&oldid=1058600948"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001037 a owl:Class;
                    rdfs:label "Constructed Feature"@en;
                    rdfs:subClassOf comcore:ont00001197;
                    skos:definition "An Anthropogenic Feature that has been constructed by deliberate human effort."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001038 a owl:Class;
                    rdfs:label "Nickel Cadmium Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001105;
                    skos:altLabel "NiCad Battery"@en;
                    skos:definition "A Secondary Cell Electric Battery that has a cadmium anode and nickel oxide hydroxide cathode."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nickel%E2%80%93cadmium_battery&oldid=1061809659"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001039 a owl:Class;
                    rdfs:label "Act of Repayment"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is transferred by an Agent (the Debtor) to another Agent (the Creditor) to decrease the amount the Debtor owes to the Creditor from an earlier Act of Loaning."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Loan&oldid=1063513958"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001040 a owl:Class;
                    rdfs:label "Nadir"@en;
                    rdfs:subClassOf pobo:BFO_0000026;
                    skos:definition "A One-Dimensional Spatial Region that extends from a given location downward along the local vertical direction pointing in the direction of the apparent Gravitational Force at that location."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Nadir&oldid=1057007248"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001041 a owl:Class;
                    rdfs:label "Sequence Position Ordinality"@en;
                    rdfs:subClassOf comcore:ont00001010;
                    skos:definition "An Ordinal Measurement Information Content Entity that is about the position of some entity in some ordered sequence."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001042 a owl:Class;
                    rdfs:label "Equipment Mount"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to support a Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001043 a owl:Class;
                    rdfs:label "Aircraft"@en;
                    rdfs:subClassOf comcore:ont00000713;
                    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by air travel."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft&oldid=1063924562"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001044 a owl:Class;
                    rdfs:label "Nuclear Radiation Detection Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to detect the presence of nuclear radiation particles."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001045 a owl:Class;
                    rdfs:label "Artifact Model"@en;
                    rdfs:subClassOf comcore:ont00000319;
                    skos:definition "A Prescriptive Information Content Entity that prescribes a common set of Functions and Qualities to inhere in a set of artifact instances."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001046 a owl:Class;
                    rdfs:label "Material Copy of a Notification Message"@en;
                    rdfs:subClassOf comcore:ont00001002,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002013];
                    skos:altLabel "Notification Message"@en;
                    skos:definition "A Material Copy of a Message that is designed to carry an Information Content Entity that describes a scenario that has been determined to merit attention by the recipient."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001047 a owl:Class;
                    rdfs:label "Frequency"@en;
                    rdfs:subClassOf pobo:BFO_0000144;
                    skos:altLabel "Temporal Frequency"@en;
                    skos:definition "A Process Profile that is characterized by the number of repetitive processes during a particular time period."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Frequency&oldid=1062800545"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001048 a owl:Class;
                    rdfs:label "Increase of Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000004;
                    skos:definition "A Change in which some Independent Continuant has an increase in the level of some Dependent Continuant that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001049 a owl:Class;
                    rdfs:label "Electrical Power Source"@en;
                    rdfs:subClassOf comcore:ont00000288;
                    skos:definition "A Power Source that is designed to generate, control, and transfer power in the form of electrical energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001050 a owl:Class;
                    rdfs:label "Primary Cell Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00000716;
                    skos:altLabel "Primary Cell Battery"@en;
                    skos:definition "A Electric Battery that is designed for one-time use and not to be recharged."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Primary_cell&oldid=1047226932"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001051 a owl:Class;
                    rdfs:label "Projectile Launcher"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict damage or harm by means of launching a high-velocity projectile at a target."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Projectile&oldid=1062048285"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001052 a owl:Class;
                    rdfs:label "Military Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to support a Military Force."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Military&oldid=1063431234"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001053 a owl:Class;
                    rdfs:label "Act of Collision"@en;
                    rdfs:subClassOf comcore:ont00000065;
                    skos:definition "An Act of Location Change involving the movement of one object such that it collides with another object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001054 a owl:Class;
                    rdfs:label "Helical Antenna"@en;
                    rdfs:subClassOf comcore:ont00000499;
                    skos:definition "A Wire Antenna that consists of a conducting wire wound in the form of a helix that is typically mounted over a ground plane with a feed line connected between the bottom of the helix and the ground plane."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Helical_antenna&oldid=1062343033"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001055 a owl:Class;
                    rdfs:label "Branched"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having subdivisions or offshoots."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001056 a owl:Class;
                    rdfs:label "Visible Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 400 and 800 terahertz."@en;
                    skos:scopeNote "Visible light overlaps with near infrared and near ultraviolet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Light&oldid=1062630851"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001057 a owl:Class;
                    rdfs:label "Act of Issuing Mass Media Press Release"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation an official statement issued to one or more members of the media for the purpose of announcing newsworthy information."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001058 a owl:Class;
                    rdfs:label "Hour"@en;
                    rdfs:subClassOf pobo:BFO_0000202,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001869 ; 
                                     owl:someValuesFrom comcore:ont00000800];
                    skos:definition "A Temporal Interval that is equal to sixty consecutive Minutes."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=hour";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001059 a owl:Class;
                    rdfs:label "Shape Quality"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the ratios between dimensions of external features of that bearer."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001060 a owl:Class;
                    rdfs:label "Fuel System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to pump, manage, and deliver some Portion of Fuel to the Propulsion System and Auxiliary Power Unit of some Vehicle."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aircraft_fuel_system&oldid=1003132173"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001061 a owl:Class;
                    rdfs:label "Motorcycle"@en;
                    rdfs:subClassOf comcore:ont00000053;
                    skos:altLabel "Motorbike"@en;
                    skos:definition "A Ground Motor Vehicle that is designed to transport a very small number of passengers (usually 1 or 2) while traveling on two or three tired wheels."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Motorcycle&oldid=1063743553"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001062 dcterms:bibliographicCitation "The International Community. 5 Apr. 2023, https://dictionary.cambridge.org/us/dictionary/english/international-community.";
                    dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "International Community"@en;
                    rdfs:subClassOf comcore:ont00000300;
                    skos:definition "A maximal Group of Geopolitical Organizations engaged in geopolitics with one another."@en;
                    skos:prefLabel "International Community"@en;
                    comcore:ont00001754 "https://dictionary.cambridge.org/us/dictionary/english/international-community";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001063 a owl:Class;
                    rdfs:label "Straight"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:altLabel "Linear"@en;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer not having curves, bends, or angles along its borders."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001064 a owl:Class;
                    rdfs:label "Material Copy of a Barcode"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002014];
                    skos:altLabel "Barcode"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry one or more geometric shapes that concretize some Prescriptive Information Content Entity."@en;
                    skos:scopeNote "For information on types of barcodes, see: https://www.scandit.com/types-barcodes-choosing-right-barcode/"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Barcode&oldid=1059844765"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001065 a owl:Class;
                    rdfs:label "Two Dimensional Extent"@en;
                    rdfs:subClassOf comcore:ont00001202;
                    skos:altLabel "Area"@en;
                    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in two dimensions."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001066 a owl:Class;
                    rdfs:label "Loss of Disposition"@en;
                    rdfs:subClassOf comcore:ont00000250;
                    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Disposition."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001067 a owl:Class;
                    rdfs:label "Laser"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to emit light coherently through a process of optical amplification based on the stimulated emission of electromagnetic radiation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Laser&oldid=1059215159"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001068 a owl:Class;
                    rdfs:label "Gain of Quality"@en;
                    rdfs:subClassOf comcore:ont00000395,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000019]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Specifically Dependent Continuant in which an Independent Continuant becomes the bearer of some Quality."@en;
                    skos:example "A person becoming pregnant.";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001069 a owl:Class;
                    rdfs:label "Representational Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000958;
                    owl:disjointWith comcore:ont00001163;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000958
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001938 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:definition "An Information Content Entity that represents some Entity."@en;
                    skos:example "the content of a court transcript represents a courtroom proceeding",
                                 "the content of a photograph of the Statue of Liberty represents the Statue of Liberty",
                                 "the content of a video of a sporting event represents that sporting event";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001070 a owl:Class;
                    rdfs:label "Fluid Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes in which some Material Artifact is used to control the direction or flow of some fluid."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001071 a owl:Class;
                    rdfs:label "Payload Capacity"@en;
                    rdfs:subClassOf comcore:ont00000323,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000197 ; 
                                     owl:someValuesFrom comcore:ont00000713];
                    skos:definition "An Artifact Function that inheres in a Vehicle that is designed to transport Payload, and which is typically characterized by the maximum Weight, Mass, or Volume of Payload that the Vehicle can transport."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Payload&oldid=1035953573"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001072 a owl:Class;
                    rdfs:label "FM Radio Broadcast Frequency"@en;
                    rdfs:subClassOf comcore:ont00000169;
                    skos:altLabel "Frequency Modulation Radio Broadcast Frequency"@en;
                    skos:definition "A Very High Frequency that is between 88 and 108 MHz."@en;
                    comcore:ont00001754 "International Telecommunication Union (ITU) Region 2";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001073 a owl:Class;
                    rdfs:label "Financial Value of Property"@en;
                    rdfs:subClassOf comcore:ont00000608;
                    skos:altLabel "Property Value"@en;
                    skos:definition "Financial Value that inheres in an material entity that is the object of an Act of Ownership."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001074 a owl:Class;
                    rdfs:label "Act of Educational Training Acquisition"@en;
                    rdfs:subClassOf comcore:ont00000687;
                    skos:definition "An Act of Training Acquisition performed by an Agent by acquiring knowledge of a curriculum from an Agent or communication medium that realizes a capacity derived from its affiliation with some Educational Organization."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001075 a owl:Class;
                    rdfs:label "Act of Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00000234;
                    skos:definition "An Act of Training performed by an Agent by imparting knowledge to another Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001076 a owl:Class;
                    rdfs:label "Electric Power Station"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:altLabel "Power Plant"@en;
                    skos:definition "A Facility that is designed to generate electrical power."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_station&oldid=1052973815"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001077 a owl:Class;
                    rdfs:label "Heavy Machine Gun"@en;
                    rdfs:subClassOf comcore:ont00000848;
                    skos:definition "A Mounted Gun that is designed to fire ammunition greater than .50 caliber or 12.7mm ammunition in quick succession from an ammunition belt, and which typically weighs more than 30lbs."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Heavy_machine_gun&oldid=1047303735"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001078 a owl:Class;
                    rdfs:label "Airport"@en;
                    rdfs:subClassOf comcore:ont00000226;
                    skos:definition "A Transportation Facility that is designed for launching, receiving, and housing Aircraft."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Airport&oldid=1063243963"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001079 a owl:Class;
                    rdfs:label "Blond"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that ranges from nearly white to a light greyish yellow"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001080 a owl:Class;
                    rdfs:label "Far Infrared Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00001337;
                    skos:definition "An Infrared Light Frequency that is between 300 gigahertz and 20 terahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_spectrum&oldid=1063851392"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001081 a owl:Class;
                    rdfs:label "Geographic Feature"@en;
                    rdfs:subClassOf comcore:ont00000574;
                    skos:definition "An Environmental Feature that is a natural (i.e. not human made) topographical feature having a (relatively) stable location in some Geospatial Region which can be designated by location-specific data."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001082 a owl:Class;
                    rdfs:label "Patch Receiver"@en;
                    rdfs:subClassOf comcore:ont00001145;
                    skos:definition "A Radio Receiver that uses a Patch Antenna to intercept radio signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001083 a owl:Class;
                    rdfs:label "Air-Breathing Combustion Engine"@en;
                    rdfs:subClassOf comcore:ont00000056;
                    skos:definition "A Reaction Engine that functions by drawing a continuous stream of air into and through the Engine where it is compressed, mixed with a Portion of Fuel, ignited, and then expelled as exhaust gas."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Engine&oldid=1063879193"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001084 a owl:Class;
                    rdfs:label "Portion of Processed Material"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is the output of an Act of Material Artifact Processing."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001085 a owl:Class;
                    rdfs:label "Reflection Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact participating in a reflection event in which the Material Artifact causes a change in a wavefront at an interface between the reflecting medium and the transmission medium such that the wavefront returns into the transmission medium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001086 a owl:Class;
                    rdfs:label "Road Junction"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to enable Ground Vehicles to exit one Road and enter another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Junction_(road)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001087 a owl:Class;
                    rdfs:label "Orientation Observation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001306;
                    skos:altLabel "Attitude Observation Artifact Function"@en;
                    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the Orientation of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001088 a owl:Class;
                    rdfs:label "Decade"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that is equal to a period of ten consecutive Years."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=decade";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001089 a owl:Class;
                    rdfs:label "Petrochemical Refinery"@en;
                    rdfs:subClassOf comcore:ont00001283;
                    skos:definition "A Refinery that is designed for refining crude oil, intermediate petroleum products, or synthetic petroleum into products of value."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Petrochemical&oldid=1060574535"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001090 a owl:Class;
                    rdfs:label "Measurement Unit of Pressure"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of Force applied perpendicular to a surface per unit area."@en;
                    skos:example "pascal, atmosphere, pound-force per square inch";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001091 a owl:Class;
                    rdfs:label "Fort"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed to support the defense of or solidification of rule over some Geospatial Region and its inhabitants."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fortification&oldid=1060156408"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001092 a owl:Class;
                    rdfs:label "Electrical Power Storage Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000098;
                    skos:altLabel "Capacitance"@en;
                    skos:definition "An Electrical Artifact Function that is realized during events in which a Material Artifact is used to store electrical power to be released at a later time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001093 a owl:Class;
                    rdfs:label "Coin"@en;
                    rdfs:subClassOf comcore:ont00000475;
                    skos:definition "A Portion of Cash that consists of a flat, portable, round pieces of metal designed to bear some specified Financial Value."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001094 a owl:Class;
                    rdfs:label "Act of Espionage"@en;
                    rdfs:subClassOf comcore:ont00001251;
                    skos:definition "An Act of Intelligence Gathering involving the obtaining of information that is considered secret or confidential without the permission of the holder of the information."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Espionage&oldid=1062702647"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001095 a owl:Class;
                    rdfs:label "Cellular Telecommunication Network"@en;
                    rdfs:subClassOf comcore:ont00000363;
                    skos:altLabel "Cellular Network"@en,
                                  "Mobile Telecommunication Network"@en;
                    skos:definition "A Wireless Telecommunication Network where the last link between the network and the end user is wireless and is distributed over service areas called cells."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cellular_network&oldid=1061429562"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001096 a owl:Class;
                    rdfs:label "Submachine Gun"@en;
                    rdfs:subClassOf comcore:ont00001104;
                    skos:definition "An Long Gun that is designed to be have automatic-fire functionality, fire pistol-caliber ammunition that is magazine-fed, and which is usually smaller than other automatic firearms."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Submachine_gun&oldid=1063939013"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001097 a owl:Class;
                    rdfs:label "Common Stock"@en;
                    rdfs:subClassOf comcore:ont00001278;
                    skos:definition "Stock that entitles its holder to voting on corporate decisions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001098 a owl:Class;
                    rdfs:label "Hospital"@en;
                    rdfs:subClassOf comcore:ont00000055;
                    skos:definition "A Healthcare Facility that is designed to provide patient treatment with specialized staff and equipment."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospital&oldid=1063047817"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001099 a owl:Class;
                    rdfs:label "Bridge"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to span physical obstacles without closing the way underneath to enable Persons or Ground Vehicles to pass over the obstacles."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bridge&oldid=1061858310";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001100 a owl:Class;
                    rdfs:label "Measurement Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to measure one or more features of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001101 a owl:Class;
                    rdfs:label "Interval Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001176;
                    skos:altLabel "Interval Estimate"@en,
                                  "Interval Estimate Measurement Information Content Entity"@en;
                    skos:definition "An Estimate Information Content Entity that consists of an interval of possible (or probable) values for the measured entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001102 a owl:Class;
                    rdfs:label "Commercial Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for buying and selling goods and services, especially on a large scale."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Commerce&oldid=1063120985"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001103 a owl:Class;
                    rdfs:label "Artifact Model Name"@en;
                    rdfs:subClassOf comcore:ont00000686;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000686
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001916 ; 
                                                             owl:someValuesFrom comcore:ont00001045]) ; 
                                         a owl:Class];
                    skos:definition "A Designative Information Content Entity that designates some Material Artifact Model."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001104 a owl:Class;
                    rdfs:label "Long Gun"@en;
                    rdfs:subClassOf comcore:ont00000088;
                    skos:definition "A Firearm that is designed to have a longer barrel than a Hand Gun and to be fired while braced against the shoulder."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Long_gun&oldid=1063715506"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001105 a owl:Class;
                    rdfs:label "Secondary Cell Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00000716;
                    skos:altLabel "Rechargeable Battery"@en,
                                  "Secondary Cell Battery"@en;
                    skos:definition "An Electric Battery that is designed to be recharged."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rechargeable_battery&oldid=1064096406"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001106 a owl:Class;
                    rdfs:label "Roll Axis"@en;
                    rdfs:subClassOf comcore:ont00000387;
                    skos:altLabel "Longitudinal Axis"@en;
                    skos:definition "An Axis of Rotation that passes through the center of an object's Mass from the front to the back of the object as defined by the direction of the object's motion."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001107 a owl:Class;
                    rdfs:label "Landfill"@en;
                    rdfs:subClassOf comcore:ont00001315;
                    skos:definition "A Waste Management Facility that is designed for disposing of waste by burial."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Landfill&oldid=1058364420"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001108 a owl:Class;
                    rdfs:label "Ultra High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000732;
                    skos:altLabel "ITU Band Number 9"@en;
                    skos:definition "A Microwave Frequency that is between 300 MHz and 3 GHz."@en;
                    skos:scopeNote """The corresponding Wavelength range is 1–0.1 m.

Note that the ITU definition of UHF is broader than the definition given by IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands, which sets the frequency range at 300 MHz to 1 GHz."""@en;
                    comcore:ont00001753 "UHF";
                    comcore:ont00001754 "International Telecommunication Union (ITU)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001109 a owl:Class;
                    rdfs:label "Counter-Clockwise Rotational Motion"@en;
                    rdfs:subClassOf comcore:ont00000368;
                    skos:altLabel "Anti-Clockwise Rotation"@en,
                                  "CCW Rotational Motion"@en,
                                  "Counter-Clockwise Rotation"@en;
                    skos:definition "A Rotational Motion in which the direction of rotation is toward the left as seen relative to the designated side of the plane of rotation."@en;
                    skos:example "the axial rotation of the Earth as seen from above the North Pole";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001110 a owl:Class;
                    rdfs:label "Evening"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that consists of the temporal regions between when the sun sets (approximately 6:00pm) and when people typically retire to sleep (approximately 9:00pm)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001111 a owl:Class;
                    rdfs:label "Low Midrange Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 250 and 500 Hz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001112 a owl:Class;
                    rdfs:label "Proper Acceleration"@en;
                    rdfs:subClassOf comcore:ont00000712;
                    skos:definition "An Acceleration of an object relative to a free-fall, or inertial, observer who is momentarily at rest relative to the object being measured (hence, gravity does not cause Proper Acceleration)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Proper_acceleration&oldid=1058169867"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001113 a owl:Class;
                    rdfs:label "Magenta"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color consisting of red and blue hues."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001114 a owl:Class;
                    rdfs:label "Division of Delimiting Domain"@en;
                    rdfs:subClassOf comcore:ont00000472,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000176 ; 
                                     owl:someValuesFrom comcore:ont00001203];
                    owl:disjointWith comcore:ont00001203;
                    skos:definition "A Geospatial Region that is a fiat division of a Delimiting Domain and not a Delimiting Domain."@en;
                    skos:example "Flatbush, French Quarter, Western New York, Texas Panhandle, Greater Montreal Area of Quebec, Pacific Northwest, southwest area of Al Anbar Province, Northern Iraq.";
                    skos:scopeNote "Instances of this class are not proper Delimiting Domains, but in some cases may have an organization that exercises some control over the region, such as the homeowners' association for a neighborhood."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001115 a owl:Class;
                    rdfs:label "Private Network Telephone Call"@en;
                    rdfs:subClassOf comcore:ont00001190;
                    skos:definition "A Telephone Call transmitted over a network where a closed group of telephones are connected primarily to each other and use a gateway to reach the outside world, usually used inside companies and call centers (a.k.a. private branch exchange (PBX))."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001116 a owl:Class;
                    rdfs:label "Reference Time"@en;
                    rdfs:subClassOf pobo:BFO_0000203;
                    skos:altLabel "Epoch"@en,
                                  "Epoch Time"@en,
                                  "Reference Date"@en;
                    skos:definition "A Temporal Instant specified as the origin for which other Temporal Regions are measured or identified."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Epoch_(reference_date)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001117 a owl:Class;
                    rdfs:label "Propelling Nozzle"@en;
                    rdfs:subClassOf comcore:ont00000252;
                    skos:altLabel "Jet Nozzle"@en;
                    skos:definition "A Nozzle that is used to convert a propulsion Engine into a Jet Engine and functions by using its narrowest part, the throat, to increase Pressure within the Engine by constricting flow, usually until the flow chokes, then expanding the exhaust stream to, or near to, atmospheric pressure, while forming it into a high speed jet to propel the Vehicle."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propelling_nozzle&oldid=1061239812"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001118 a owl:Class;
                    rdfs:label "Surface Tension"@en;
                    rdfs:subClassOf pobo:BFO_0000016;
                    skos:definition "A Disposition that inheres in a liquid and is realized when the cohesive forces of the molecules in the bearer at the surface are greater than the adhesive forces of the molecules in the surrounding air."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Surface_tension&oldid=1062753527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001119 a owl:Class;
                    rdfs:label "Material Copy of a Form Document"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002044];
                    skos:altLabel "Document Form"@en;
                    skos:definition "A Material Copy of a Document that has one or more Material Copy of a Document Field as parts in which to write or select prescribed content."@en;
                    skos:example "A spreadsheet template",
                                 "A survey";
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Form_(document)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001120 a owl:Class;
                    rdfs:label "Act of Religious Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00001075;
                    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with some Religious Organization by imparting knowledge of the tenets and/or practices of a religion to an Agent either directly or indirectly through some communication medium."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001121 a owl:Class;
                    rdfs:label "Scramjet Engine"@en;
                    rdfs:subClassOf comcore:ont00000294;
                    skos:altLabel "Scramjet"@en,
                                  "Supersonic Combusting Ramjet"@en;
                    skos:definition "An Air-Breathing Jet Engine that uses the forward motion of the Engine to compress incoming air at supersonic speeds before adding the fuel and constantly combusting the mixture then expelling the exhaust out through the rear Propelling Nozzle to generate Thrust."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Scramjet&oldid=1062429697"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001122 a owl:Class;
                    rdfs:label "Radio Interference"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:definition "A Natural Process in which a radio signal is disrupted, whether unintentionally or as the result of an Act of Radio Jamming, Act of Radio Spoofing, or similar Planned Act."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001123 a owl:Class;
                    rdfs:label "Poison Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001153;
                    skos:definition "A Damaging Artifact Function that is realized in a process which causes illness in, or the death of, a living thing."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/poison";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001124 a owl:Class;
                    rdfs:label "Precision-Guided Missile"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to be a self-propelled and precision-guided projectile that delivers some payload (explosive or other) over relatively long distances."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Missile&oldid=1062028589"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001125 a owl:Class;
                    rdfs:label "Set of Eyes"@en;
                    rdfs:subClassOf comcore:ont00000084,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00000500];
                    skos:definition "A Bodily Component that consists of two or more Eyes that are part of a single Agent."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001126 a owl:Class;
                    rdfs:label "Luminescent Property"@en;
                    rdfs:subClassOf comcore:ont00000784;
                    skos:definition "An Optical Property that inheres in a bearer in virtue of that bearer's capacity to emit visible light, but which isn't the result of the bearer being heated."@en;
                    skos:scopeNote "There are a variety of photometric measurements, such as luminous flux/power or luminous intensity, whose units are lumen and candela respectively, which attempt to describe properties associated with the perception of light. These are weighted measurements, typically by the luminosity function, as thus exist on the side of information content. It is a point of further development to add the needed intrinsic properties of radiation that such measurements are about."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Luminescence&oldid=1050169944"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001127 a owl:Class;
                    rdfs:label "Loss of Quality"@en;
                    rdfs:subClassOf comcore:ont00000865;
                    skos:definition "A Loss of Specifically Dependent Continuant in which some Independent Continuant ceases to be the bearer of some Quality."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001128 a owl:Class;
                    rdfs:label "Act of Residing"@en;
                    rdfs:subClassOf comcore:ont00000676;
                    skos:definition "An Act of Inhabitancy in which a Person lives in a dwelling permanently or for an extended period of time."@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/reside";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001129 a owl:Class;
                    rdfs:label "Pressurization Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000113;
                    skos:definition "A Ventilation Control Artifact Function that is realized by processes in which some Material Artifact is used to control the partial pressure of air in some space."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001130 a owl:Class;
                    rdfs:label "Geospatial Polygon"@en;
                    rdfs:subClassOf comcore:ont00000817;
                    skos:definition "A Geospatial Line String that has at least three vertices where the connecting lines form a closed loop."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001132 a owl:Class;
                    rdfs:label "Stasis of Mission Capability"@en;
                    rdfs:subClassOf comcore:ont00000246;
                    skos:definition "A Stasis of Realizable Entity that holds during a temporal interval when a Continuant's capability (or lack thereof) to perform its intended Functions, tasks, or Objectives remains at a relatively constant level."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001133 a owl:Class;
                    rdfs:label "Motion"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:definition "A Natural Process in which a Continuant changes its Location or Spatial Orientation over some Temporal Interval."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001134 a owl:Class;
                    rdfs:label "Vehicle Frame"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to be the main supporting structure of some Vehicle."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Vehicle_frame&oldid=1054003530"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001135 a owl:Class;
                    rdfs:label "Portion of Liquid Fuel"@en;
                    rdfs:subClassOf comcore:ont00000838;
                    skos:definition "A Portion of Fuel that is stored in a liquid state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001136 a owl:Class;
                    rdfs:label "Ultrasonic Frequency"@en;
                    rdfs:subClassOf comcore:ont00000008;
                    skos:definition "A Sound Frequency that is greater than 20 kHz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001137 a owl:Class;
                    rdfs:label "Radiation Reflectivity"@en;
                    rdfs:subClassOf comcore:ont00000628;
                    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to scatter or reflect electromagnetic radiation of a given frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001138 a owl:Class;
                    rdfs:label "Beverage Antenna"@en;
                    rdfs:subClassOf comcore:ont00000499;
                    skos:definition "A Wire Antenna that consists of a horizontal wire one-half to two wavelengths long that is suspended above the ground with one end attached to the receiver feedline and the other grounded and which is typically used in the low and medium frequency radio bands."@en;
                    comcore:ont00001754 "Adapted from: https://en.wikipedia.org/wiki/Beverage_antenna";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001139 a owl:Class;
                    rdfs:label "Spacecraft"@en;
                    rdfs:subClassOf comcore:ont00000713;
                    skos:definition "A Vehicle that is designed to convey passengers, cargo, or equipment from one location to another by Spaceflight."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Spacecraft&oldid=1062102614"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001140 a owl:Class;
                    rdfs:label "Flywheel"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to store rotational energy such that it has a significant moment of inertia which enables it to resist changes in rotational speed."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Flywheel&oldid=1061360783"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001141 a owl:Class;
                    rdfs:label "Infrastructure Role"@en;
                    rdfs:subClassOf pobo:BFO_0000023;
                    skos:definition "A Role that inheres in the bearer of a Disposition and has been assigned to an Infrastructure System such that the realization of that Disposition is sometimes part of the functioning of the Infrastructure System."@en;
                    skos:scopeNote "The disposition will typically be a function of an artifact, which is often designed to be part of some Infrastructure system. But not always. In some cases an entity may be repurposed to be an element of some Infrastructure. In those cases it is a capability of that entity that supports the functioning of the system."@en;
                    comcore:ont00001754 "https://archive.org/details/economicsprincip00osul/page/n489/mode/2up"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001142 a owl:Class;
                    rdfs:label "Violet"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is lower than Blue with a wavelength in the visible spectrum typically between 400 and 450 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001143 a owl:Class;
                    rdfs:label "Facsimile Transmission"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Facsimile Transmission"@en,
                                  "Act of Faxing"@en;
                    skos:definition "An Act of Communication by Media in which the Information Content Entity that inheres in a Document is transmitted over a Telephone Network."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fax&oldid=1054674158"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001144 a owl:Class;
                    rdfs:label "Act of Entertainment"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act consisting of any activity which provides a diversion or permits people to amuse themselves."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Entertainment&oldid=1061851778"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001145 a owl:Class;
                    rdfs:label "Radio Receiver"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is an electronic device that is designed to extract information from radio waves intercepted by a Radio Antenna by using electronic filters to separate the desired radio frequency signal from other signals, an electronic amplifier to increase the power of the signal, and demodulation to recover the desired information."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Radio_receiver&oldid=1060111342"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001146 a owl:Class;
                    rdfs:label "Sidereal Time Reference System"@en;
                    rdfs:subClassOf comcore:ont00001328;
                    skos:definition "A Temporal Reference System that is based on Earth's rate of rotation measured relative to one or more fixed Stars (rather than the Sun)."@en;
                    skos:scopeNote "Sidereal Time is the angle measured from an observer's meridian along the celestial equator to the Great Circle that passes through the March equinox and both poles. This angle is usually expressed in Hours, Minutes, and Seconds."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001147 a owl:Class;
                    rdfs:label "Act of Violence"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of causing harm to oneself or to another through the use of physical or verbal force."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Violence&oldid=1063681926"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001148 a owl:Class;
                    rdfs:label "Electromagnetic Communication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000727;
                    skos:definition "A Communication Artifact Function that is realized in a process that conveys meaningful signs by means of electromagnetic radiation."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001149 a owl:Class;
                    rdfs:label "Data Range Interval Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001101;
                    skos:definition "A Ratio Measurement Information Content Entity that is a measurement of a set of values and is equal to the absolute difference between the largest value and the smallest value in the set."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001150 a owl:Class;
                    rdfs:label "Portion of Ammunition"@en;
                    rdfs:subClassOf comcore:ont00000445;
                    skos:definition "A Weapon that is designed to inflict harm, damage, or incapacity by being projected toward its target at a significant Velocity."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ammunition&oldid=1062875850"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001151 a owl:Class;
                    rdfs:label "Portion of Paper"@en;
                    rdfs:subClassOf comcore:ont00000893;
                    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of pressing together moist fibres of cellulose pulp derived from wood, rags, or grasses, and drying them into flexible sheets."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Paper&oldid=1057624743"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001152 a owl:Class;
                    rdfs:label "Government Domain"@en;
                    rdfs:subClassOf comcore:ont00001203;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001203
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001864 ; 
                                                             owl:someValuesFrom comcore:ont00001335]) ; 
                                         a owl:Class];
                    skos:definition "A Delimiting Domain that delimits the authority of a Government to exercise its control within the bounded area."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001153 a owl:Class;
                    rdfs:label "Damaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which the structural integrity of an entity is impaired."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001154 a owl:Class;
                    rdfs:label "Multi-Second Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000992];
                    skos:definition "A one-dimensional temporal region that is measured in Seconds and spans at least one Second."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001155 a owl:Class;
                    rdfs:label "Full Motion Video Imaging Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000601;
                    skos:definition "An Imaging Artifact Function that inheres in Material Artifacts that are designed to produce video of entities that is of high enough quality to make the represented motion appear continuous to human viewers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001156 a owl:Class;
                    rdfs:label "Material Copy of a Information Line"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002037];
                    skos:altLabel "Information Line"@en;
                    skos:definition "An Information Bearing Artifact that consists of a single line or row of some larger Information Bearing Artifact of which it is a part."@en;
                    skos:example "a line in a computer file that bears a portion of code for some computer program",
                                 "a line of data in a database",
                                 "a line of text in a book";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001157 a owl:Class;
                    rdfs:label "Hydraulic Power Source"@en;
                    rdfs:subClassOf comcore:ont00000288;
                    skos:definition "A Power Source that is designed to generate, control, or transmit power by means of pressurized liquid."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001158 a owl:Class;
                    rdfs:label "Act of Data Transformation"@en;
                    rdfs:subClassOf comcore:ont00000366;
                    skos:definition "An Act of Information Processing in which an algorithm is executed to act upon one or more input Information Content Entities into one or more output Information Content Entities."@en;
                    skos:scopeNote """It is not a requirement that the output Information Content Entity(ies) be qualitatively distinct from the input(s) as a result of an Act of Data Transformation, though doing so is typically the goal of performing this Act. Consider, for example, selecting a column in an Excel spreadsheet then executing the \\\"Remove Duplicates\\\" Algorithm on it. The intent is to remove rows in that column containing duplicate content. If no duplicate values are present, the information in the column remains unchanged but an Act of Data Transformation was nonetheless performed."""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001159 a owl:Class;
                    rdfs:label "Bond"@en;
                    rdfs:subClassOf comcore:ont00000537;
                    skos:definition "A Financial Instrument that is designed to secure an Agent's debt for the holders of that debt."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Bond_(finance)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001160 a owl:Class;
                    rdfs:label "Solvent Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in the dissolving of other substances (namely, solutes) without change in the former's chemical structure."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Solvent&oldid=1062572314"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001161 a owl:Class;
                    rdfs:label "Counterfeit Legal Instrument"@en;
                    rdfs:subClassOf comcore:ont00000719;
                    skos:definition "A Counterfeit Instrument that is designed to be a fake replica of some genuine Legal Instrument."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Counterfeit&oldid=1063493600"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001162 a owl:Class;
                    rdfs:label "Act of Commissive Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication in which an Agent commits themselves to doing, or refraining from doing, some future action."@en;
                    skos:scopeNote "Examples: agreeing, betting, guaranteeing, inviting, offering, promising, swearing, volunteering"@en;
                    comcore:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001163 a owl:Class;
                    rdfs:label "Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00000853;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000853
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001966 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:altLabel "Measurement ICE"@en;
                    skos:definition "A Descriptive Information Content Entity that describes the extent, dimensions, quantity, or quality of an Entity relative to some standard."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001164 a owl:Class;
                    rdfs:label "County"@en;
                    rdfs:subClassOf comcore:ont00001152;
                    skos:definition "A Government Domain that is part of either a First-Order or Second-Order Administrative Region."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=County&oldid=1062817834"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001165 a owl:Class;
                    rdfs:label "Terrorist Training Camp"@en;
                    rdfs:subClassOf comcore:ont00000332;
                    skos:definition "A Training Camp designed to teach students methods of terrorism."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Terrorist_training_camp&oldid=1037856600"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001166 a owl:Class;
                    rdfs:label "Multi-Minute Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000085];
                    skos:definition "A one-dimensional temporal region that is measured in Minutes and spans at least one Minute."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001167 a owl:Class;
                    rdfs:label "Midrange Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 500 Hz and 2 kHz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001168 a owl:Class;
                    rdfs:label "Reaction Mass"@en;
                    rdfs:subClassOf pobo:BFO_0000040;
                    skos:altLabel "Working Mass"@en;
                    skos:definition "A Material Entity against which a Propulsion System operates in order to produce Acceleration."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Working_mass&oldid=1057126114"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001169 a owl:Class;
                    rdfs:label "Communication Relay Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information from one Material Artifact to another for the purpose of communiction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001170 a owl:Class;
                    rdfs:label "Hard X-ray Frequency"@en;
                    rdfs:subClassOf comcore:ont00000490;
                    skos:definition "An X-Ray Frequency that is between 3 and 30 exahertz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001171 a owl:Class;
                    rdfs:label "Wireless Network Telephone Call"@en;
                    rdfs:subClassOf comcore:ont00001190;
                    skos:definition "A Telephone Call transmitted over a network where the telephones are mobile and can move anywhere within the coverage area."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001172 a owl:Class;
                    rdfs:label "Portion of Gelatinous Propellant"@en;
                    rdfs:subClassOf comcore:ont00000593;
                    skos:definition "A Portion of Propellant that is stored in a gelatinous state."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001173 a owl:Class;
                    rdfs:label "Rocket Launcher"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to launch one or more Unguided Rockets."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket_launcher&oldid=1049900727"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001174 a owl:Class;
                    rdfs:label "Electromagnetic Shielding Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which an electromagnetic field is blocked by barriers made of conductive or magnetic materials."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_shielding&oldid=1063432544"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001175 a owl:Class;
                    rdfs:label "Language"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    skos:definition "A Prescriptive Information Content Entity that prescribes a canonical format for communication."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001176 a owl:Class;
                    rdfs:label "Estimate Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    skos:altLabel "Estimate"@en,
                                  "Estimate Measurement Information Content Entity"@en,
                                  "Estimated Value"@en;
                    skos:definition "A Measurement Information Content Entity that is a measurement of an entity based on partial information about that entity or an appropriately similar entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001177 a owl:Class;
                    rdfs:label "Roll Orientation"@en;
                    rdfs:subClassOf comcore:ont00000119;
                    skos:altLabel "Roll"@en;
                    skos:definition "A Spatial Orientation of an Object relative to its Roll Axis."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001178 a owl:Class;
                    rdfs:label "Railway Crossing"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:altLabel "Level Crossing"@en;
                    skos:definition "A Land Transportation Artifact that is designed to enable Persons or Ground Vehicles to cross a Railway when traveling along a road or path that is perpendicular to and at the same elevation as the Railway at the point where they overlap."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001179 a owl:Class;
                    rdfs:label "Digital Storage Device"@en;
                    rdfs:subClassOf comcore:ont00000893;
                    skos:definition "An Information Medium Artifact that is designed to bear some Information Content Entity by means of recording that information in digital (binary) format."@en;
                    skos:example "A computer's Hard Disk Drive",
                                 "A portable USB Drive";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Data_storage&oldid=1060116427"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001180 a owl:Class;
                    rdfs:label "Organization"@en;
                    rdfs:subClassOf comcore:ont00000300;
                    skos:definition "A Group of Agents which can be the bearer of roles, has members, and has a set of organization rules."@en;
                    skos:scopeNote "Members of organizations are either Organizations themselves or individual Persons. Members can bear specific Organization Member Roles that are determined in the organization rules. The organization rules also determine how decisions are made on behalf of the Organization by the organization members."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/OBI_0000245";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001181 a owl:Class;
                    rdfs:label "Triple Inertial Navigation System"@en;
                    rdfs:subClassOf comcore:ont00000287;
                    skos:altLabel "Triple INS"@en;
                    skos:definition "An Inertial Navigation System that is designed to use three redundant computers to continuously calculate via dead reckoning the position, orientation, and velocity of a moving object without the need for external references, in such a way that eliminates the need for a navigator."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001182 a owl:Class;
                    rdfs:label "Phase Angle"@en;
                    rdfs:subClassOf pobo:BFO_0000145;
                    skos:altLabel "Orbital Phase Angle"@en;
                    skos:definition "A Relational Quality that is the angle between the light incident onto an observed Object and the light reflected from the Object."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Phase_angle_(astronomy)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001183 a owl:Class;
                    rdfs:label "Social Network"@en;
                    rdfs:subClassOf comcore:ont00000300;
                    skos:definition "A Group of Agents that are connected in dyadic relations by similar personal or career interests, activities, backgrounds, or real-life connections."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001184 a owl:Class;
                    rdfs:label "Spinning Motion"@en;
                    rdfs:subClassOf comcore:ont00000368;
                    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that passes through the Object's Center of Mass."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001185 a owl:Class;
                    rdfs:label "Rocket"@en;
                    rdfs:subClassOf comcore:ont00000713;
                    skos:definition "A Vehicle that is designed to travel through air or space and which obtains Thrust from a Rocket Engine."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rocket&oldid=1063307477"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001186 a owl:Class;
                    rdfs:label "Color Hue"@en;
                    rdfs:subClassOf comcore:ont00000784;
                    skos:definition "An Optical Property that inheres in a bearer in virtue of its capacity to reflect a dominant wavelength of the visible light spectrum, which is typically divided up into 6 to 8 ranges."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001187 a owl:Class;
                    rdfs:label "Navigation System"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to enable an Agent or Material Artifact to determine the position or direction of some object, usually for the purpose of monitoring or controlling the movement of some Vehicle from one place to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Navigation&oldid=1064122463"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001188 a owl:Class;
                    rdfs:label "Denture"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace missing teeth."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Dentures&oldid=1056527226"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001189 a owl:Class;
                    rdfs:label "Blue"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is between Cyan and Violet with a wavelength in the visible spectrum typically between 450 to 490 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001190 a owl:Class;
                    rdfs:label "Telephone Call"@en;
                    rdfs:subClassOf comcore:ont00000517;
                    skos:altLabel "Act of Telephone Calling"@en;
                    skos:definition "An Act of Communciation by Media transmitted over a telephone network to two or more Persons."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telephone_network&oldid=1046265527"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001191 a owl:Class;
                    rdfs:label "Operational Stasis"@en;
                    rdfs:subClassOf comcore:ont00001213;
                    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when a Material Artifact maintains its designed set of Artifact Functions (or at least maintains its primary functions)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001192 a owl:Class;
                    rdfs:label "Radio Antenna"@en;
                    rdfs:subClassOf comcore:ont00000092;
                    skos:definition "A Bidirectional Transducer that is designed to convert electric power into radio waves, and radio waves into electric power."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Antenna_(radio)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001193 a owl:Class;
                    rdfs:label "Fatigability"@en;
                    rdfs:subClassOf pobo:BFO_0000017;
                    skos:definition "A Realizable Entity that is realized when its bearer loses strength and tires quickly."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001194 a owl:Class;
                    rdfs:label "Gain of Role"@en;
                    rdfs:subClassOf comcore:ont00000642,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000057 ; 
                                     owl:someValuesFrom [owl:intersectionOf (pobo:BFO_0000004
                                                                             [a owl:Restriction ; 
                                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                                             owl:someValuesFrom pobo:BFO_0000023]) ; 
                                                         a owl:Class]];
                    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes bearer of some Role."@en;
                    skos:scopeNote "This class should be used to demarcate the start of the temporal interval (through the occupies temporal region property) that the Entity bears the Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001195 a owl:Class;
                    rdfs:label "Geospatial Error Region"@en;
                    rdfs:subClassOf comcore:ont00000207;
                    skos:definition "A One-Dimensional Geospatial Boundary that bounds some Geospatial Region according to probability estimations for locating some object within it."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001196 a owl:Class;
                    rdfs:label "Act of Artifact Assembly"@en;
                    rdfs:subClassOf comcore:ont00000908;
                    skos:definition "An Act of Material Artifact Processing wherein a new Material Artifact are created by fitting component parts together."@en;
                    skos:example "putting together a piece of furniture purchased from Ikea";
                    skos:scopeNote "Many Acts of Manufacturing and Construction involve one or more Acts of Artifact Assembly, but Acts of Artifact Assembly can also occur in isolation from these activities."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001197 a owl:Class;
                    rdfs:label "Anthropogenic Feature"@en;
                    rdfs:subClassOf comcore:ont00000574;
                    skos:definition "An Environmental Feature that is related to or is the result of the influence of human beings on the environment."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/anthropogenic";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001198 a owl:Class;
                    rdfs:label "Railcar"@en;
                    rdfs:subClassOf comcore:ont00000796;
                    skos:definition "A Rail Transport Vehicle that consists of a single self-propelled Vehicle that is not a Train, is designed to transport passengers, and which may also be designed to connect to other Railcars to form a Train."@en;
                    skos:scopeNote "In American-English, the term 'Railcar' is often used in a broader sense that is interchangeable with 'Railroad Car'."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Railcar&oldid=1063519348"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001199 a owl:Class;
                    rdfs:label "Protruding"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a part of an object in virtue of the part extending out above or beyond the surface of the object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001200 a owl:Class;
                    rdfs:label "Structural Support Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact providing physical support to another object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001201 a owl:Class;
                    rdfs:label "Trail"@en;
                    rdfs:subClassOf comcore:ont00001326;
                    skos:definition "A Land Transportation Artifact that is designed to enable transport through rough country, such as a forest or moor."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Trail&oldid=1056047142"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001202 a owl:Class;
                    rdfs:label "Size Quality"@en;
                    rdfs:subClassOf pobo:BFO_0000019;
                    skos:definition "A Quality that inheres in a bearer in virtue of the bearer's extension in one or more dimensions."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001203 dcterms:created "2022-12-30T21:32:27-05:00"^^xsd:dateTime;
                    dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Delimiting Domain"@en;
                    rdfs:subClassOf comcore:ont00000472;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00000472
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001864 ; 
                                                             owl:someValuesFrom comcore:ont00001180]) ; 
                                         a owl:Class];
                    skos:definition "A Geospatial Region that delimits the authority of an Organization to exercise its control within the bounded area."@en;
                    skos:prefLabel "Delimiting Domain"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001204 a owl:Class;
                    rdfs:label "Night"@en;
                    rdfs:subClassOf pobo:BFO_0000202;
                    skos:definition "A Temporal Interval that consists of the temporal regions between when people typically retire to sleep (approximately 9:00pm) and when the sun dawns (approximately 6:00am)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001205 a owl:Class;
                    rdfs:label "Priority Scale"@en;
                    rdfs:subClassOf comcore:ont00000398;
                    skos:definition "A Reference System that is designed to be used to rank or identify the importance of entities of the specified type."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001206 a owl:Class;
                    rdfs:label "Multi-Year Temporal Interval"@en;
                    rdfs:subClassOf pobo:BFO_0000038,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001924 ; 
                                     owl:someValuesFrom comcore:ont00000832];
                    skos:definition "A one-dimensional temporal region that is measured in Years and spans at least one Year."@en;
                    skos:scopeNote "This is a defined class."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/TimeOntology"^^xsd:anyURI.
comcore:ont00001207 a owl:Class;
                    rdfs:label "Optical Lens"@en;
                    rdfs:subClassOf comcore:ont00000136;
                    skos:altLabel "Lens"@en;
                    skos:definition "An Optical Instrument that is designed to focus or disperse a beam of light entering the lens by means of refraction."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Lens_(optics)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001208 a owl:Class;
                    rdfs:label "High Frequency"@en;
                    rdfs:subClassOf comcore:ont00000150;
                    skos:altLabel "ITU Band Number 7"@en;
                    skos:definition "A Radio Frequency that is between 3 and 30 MHz."@en;
                    skos:scopeNote "The corresponding Wavelength range is 100–10 m"@en;
                    comcore:ont00001753 "HF";
                    comcore:ont00001754 "International Telecommunication Union (ITU) and IEEE 521-2002 - IEEE Standard Letter Designations for Radar-Frequency Bands";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001210 a owl:Class;
                    rdfs:label "Retail Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of selling goods or merchandise in small or individual lots for direct consumption by persons or organizations."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Retail&oldid=1061431295"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001211 a owl:Class;
                    rdfs:label "Lifting Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to lift some object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001212 a owl:Class;
                    rdfs:label "Female Sex"@en;
                    rdfs:subClassOf comcore:ont00001033;
                    skos:definition "A Biological Sex inhering in an individual that only produces gametes that can be fertilized by male gametes."@en;
                    comcore:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000383";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001213 a owl:Class;
                    rdfs:label "Stasis of Artifact Operationality"@en;
                    rdfs:subClassOf comcore:ont00000246;
                    skos:definition "A Stasis of Realizable Entity that holds during a Temporal Interval when a Material Artifact's designed set of Artifact Functions (or at least its primary functions) or the realizations of those functions remain unchanged."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001214 a owl:Class;
                    rdfs:label "Increase of Specifically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00001048;
                    skos:definition "An Increase of Dependent Continuant in which some Independent Continuant has an increase of some Specifically Dependent Continuant that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001215 a owl:Class;
                    rdfs:label "Funeral"@en;
                    rdfs:subClassOf comcore:ont00000455;
                    skos:altLabel "Act of Funeral Ceremony"@en;
                    skos:definition "An Act of Ceremony in which the Life of a Person who has died is celebrated, sanctified, or remembered."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Funeral&oldid=1060270978"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001216 a owl:Class;
                    rdfs:label "Periscope"@en;
                    rdfs:subClassOf comcore:ont00000136;
                    skos:definition "An Optical Instrument that is designed to enable observation of an object that is located over, around, or through another object, obstacle, or condition that prevents direct line-of-sight observation from the observer's current position."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Periscope&oldid=1030400442"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001217 a owl:Class;
                    rdfs:label "Medium Machine Gun"@en;
                    rdfs:subClassOf comcore:ont00000848;
                    skos:definition "A Mounted Gun that is designed to fire full-power rifle Cartridges (less than .50 caliber or 12.7mm) in quick succession from an ammunition belt, and which typically weighs 22-30 lbs."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Medium_machine_gun&oldid=1063571269"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001218 a owl:Class;
                    rdfs:label "Signal Processing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in the process of transferring or processing information contained in signals."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Signal_processing&oldid=1062720685"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001219 a owl:Class;
                    rdfs:label "Delta-v"@en;
                    rdfs:subClassOf pobo:BFO_0000144,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000117 ; 
                                     owl:someValuesFrom comcore:ont00000763];
                    skos:altLabel "Change in Velocity"@en,
                                  "DeltaV"@en;
                    skos:definition "A Process Profile that is the total change in Velocity of an object's Motion."@en;
                    skos:scopeNote "Delta-v is not equivalent to and should not be confused with Acceleration, which is the rate of change of Velocity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001220 a owl:Class;
                    rdfs:label "Opaque"@en;
                    rdfs:subClassOf comcore:ont00001384;
                    skos:definition "An Opacity that inheres in a bearer in virtue of that bearer's incapacity to transmit electromagnetic radiation of a given frequency through the bearer such that the bearer reflects, scatters, or absorbs all electromagnetic radiation of that frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001221 a owl:Class;
                    rdfs:label "Physically Powered Engine"@en;
                    rdfs:subClassOf comcore:ont00000210;
                    skos:altLabel "Physical Engine"@en;
                    skos:definition "An Engine that is designed to convert potential or kinetic energy into mechanical energy."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001222 a owl:Class;
                    rdfs:label "Solar Panel System"@en;
                    rdfs:subClassOf comcore:ont00001049;
                    skos:altLabel "Photovoltaic System"@en,
                                  "Solar Array"@en;
                    skos:definition "An Electrical Power Source that consists in part of one or more Solar Panels, a power inverter, electrical wiring between the components, a mounting and support structure, and may also include a battery and/or a solar tracking system and is the bearer of functions realized in processes of deriving, transferring, and storing electrical energy derived from light energy."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Photovoltaic_system&oldid=1063366598"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001223 a owl:Class;
                    rdfs:label "Dish Receiver"@en;
                    rdfs:subClassOf comcore:ont00001145;
                    skos:definition "A Radio Receiver that uses a Parabolic (or Dish) Antenna to intercept radio signals."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001224 a owl:Class;
                    rdfs:label "Process Requirement"@en;
                    rdfs:subClassOf comcore:ont00001324;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001324
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001974 ; 
                                                             owl:someValuesFrom pobo:BFO_0000015]) ; 
                                         a owl:Class];
                    skos:altLabel "Duty"@en,
                                  "Obligation"@en;
                    skos:definition "A Process Regulation that requires some Process."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001225 a owl:Class;
                    rdfs:label "Yellow"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is between Orange and Green with a wavelength in the visible spectrum typically between 560 to 590 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001226 a owl:Class;
                    rdfs:label "Act of Employment by an Organization"@en;
                    rdfs:subClassOf comcore:ont00002071;
                    skos:definition "An Act of Employment wherein an Organization assigns a set of activities to some Person to be performed in exchange for financial compensation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001227 a owl:Class;
                    rdfs:label "Longitudinal Wave Profile"@en;
                    rdfs:subClassOf comcore:ont00000752,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000132 ; 
                                     owl:someValuesFrom comcore:ont00001028];
                    skos:altLabel "Compression Wave"@en,
                                  "Longitudinal Wave"@en;
                    skos:definition "A Wave Process Profile in which the displacement of participating particles is parallel to the direction of the Wave Process' propogation such that the particles alternate between participating in processes of compression and rarefaction as they participate in individual Wave Processes."@en;
                    comcore:ont00001754 "http://www.acs.psu.edu/drussell/Demos/waves/wavemotion.html";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001228 a owl:Class;
                    rdfs:label "Material Copy of a Journal Article"@en;
                    rdfs:subClassOf comcore:ont00001298,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002045];
                    skos:altLabel "Journal Article"@en;
                    skos:definition "A Material Copy of a Document that is designed to carry a specific brief composition on a specific topic as part of a Journal Issue."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Academic_journal&oldid=1059723283"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001229 a owl:Class;
                    rdfs:label "Alkaline Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001050;
                    skos:definition "A Primary Cell Electric Battery that has a Zinc anode and Manganese (IV) oxide cathode."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Alkaline_battery&oldid=1055652562"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001230 a owl:Class;
                    rdfs:label "Rhombic Antenna"@en;
                    rdfs:subClassOf comcore:ont00000499;
                    skos:definition "A Wire Antenna that consists of one to three parallel wires suspended above the ground by poles or towers at each vertex in a rhombic shape with each of the four sides being the same length (typically at least one wavelength or longer)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Rhombic_antenna&oldid=1057114456"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001231 a owl:Class;
                    rdfs:label "Brilliance Frequency"@en;
                    rdfs:subClassOf comcore:ont00000530;
                    skos:definition "A Sonic Frequency that is between 6 and 20 kHz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001232 a owl:Class;
                    rdfs:label "Act of Possession"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act in which an agent intentionally exercises control towards a thing."@en;
                    skos:scopeNote "In all cases, to possess something, an agent must have an intention to possess it."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Possession_(law)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001233 a owl:Class;
                    rdfs:label "Crushing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001153;
                    skos:definition "A Damaging Artifact Function that is realized in a process in which the structural integrity of an entity is impaired because of significant pressure."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/crushing";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001234 a owl:Class;
                    rdfs:label "Neutralization Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which an acid and a base react quantitatively with each other."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Neutralization_(chemistry)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001235 a owl:Class;
                    rdfs:label "Military Time Zone Identifier"@en;
                    rdfs:subClassOf comcore:ont00000829;
                    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Zulu time, which has no offset from Coordinated Universal Time."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001236 a owl:Class;
                    rdfs:label "Act of Suicide"@en;
                    rdfs:subClassOf comcore:ont00001147,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001803 ; 
                                     owl:someValuesFrom comcore:ont00000920];
                    skos:altLabel "Suicide"@en;
                    skos:definition "An Act of Violence in which some Agent intentionally and voluntarily causes their own death."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/suicide";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001237 a owl:Class;
                    rdfs:label "Birth"@en;
                    rdfs:subClassOf comcore:ont00000007;
                    skos:definition "A Process of bringing forth offspring."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Birth&oldid=1063718655"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001238 a owl:Class;
                    rdfs:label "Initialism"@en;
                    rdfs:subClassOf comcore:ont00000605;
                    skos:definition "An Abbreviated Name that consists of the initial letters of some words (or syllables) in a Designative Name, and in which each letter is pronounced separately."@en;
                    skos:example "USA, CPU, BBC";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001239 a owl:Class;
                    rdfs:label "Group of Organizations"@en;
                    rdfs:subClassOf comcore:ont00000300,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:someValuesFrom comcore:ont00001180],
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000178 ; 
                                     owl:allValuesFrom comcore:ont00001180];
                    skos:definition "A Group of Agents that has only Organizations as member parts."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001240 a owl:Class;
                    rdfs:label "Radio Communication Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001148;
                    skos:definition "An Electromagnetic Communication Artifact Function that is realized in a process that conveys meaningful signs by means of radio waves."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telecommunications&oldid=1061143810"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001241 a owl:Class;
                    rdfs:label "Sensor Function"@en;
                    rdfs:subClassOf pobo:BFO_0000034;
                    skos:definition "A Function that is realized in processes wherein an attribute of its bearer is a proxy for some aspect of its sensing environment."@en;
                    skos:scopeNote "A proxy in the sense used here is a stand-in used in place of something else, often because the original is unavailable or not directly accessible."@en,
                                   "Subtypes of Sensor Function should be differentiated based on the type of modality they sense. Where a modality is a specific type of energy, phenomenon, or information input that the Sensor is designed to detect, measure, or otherwise respond to."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sensor&oldid=1059883466"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001242 a owl:Class;
                    rdfs:label "Actuator"@en;
                    rdfs:subClassOf comcore:ont00000736;
                    skos:definition "A Transducer that is designed to convert some control signal into mechanical motion."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Actuator&oldid=1064000375"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001243 a owl:Class;
                    rdfs:label "Material Copy of a Document Field"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002038];
                    skos:definition "An Information Bearing Entity that is a part of some document into which carriers of prescribed information can be written or selected."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001244 a owl:Class;
                    rdfs:label "Act of Issuing Mass Media Article"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation a non-fictional essay, especially one included with others in a newspaper, magazine, or journal."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001246 a owl:Class;
                    rdfs:label "Under Active Control"@en;
                    rdfs:subClassOf comcore:ont00000847,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000566];
                    skos:definition "An Active Stasis during which a Material Artifact participates in an Act of Artifact Employment."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001247 a owl:Class;
                    rdfs:label "Telecommunication Endpoint"@en;
                    rdfs:subClassOf comcore:ont00000918;
                    skos:definition "A Telecommunication Network Node that connects a Telecommunication Terminal to a Telecommunication Network."@en;
                    skos:scopeNote "A Telecommunication Terminal is an end user device such as a Telephone, fax machine, or Computer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Communication_endpoint&oldid=1020569501"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001248 a owl:Class;
                    rdfs:label "Artificial Eye"@en;
                    rdfs:subClassOf comcore:ont00000715;
                    skos:definition "A Prosthesis that is designed to replace a missing eye."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Artificial_eye&oldid=1046672400"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001249 a owl:Class;
                    rdfs:label "Cabin Pressurization Control System"@en;
                    rdfs:subClassOf comcore:ont00000453;
                    skos:definition "An Environment Control System that is designed to control the process in which conditioned air is pumped into the Cabin of some Aircraft or Spacecraft in order to create a safe and comfortable environment for passengers and crew flying at high altitudes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cabin_pressurization&oldid=1062243955"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001250 a owl:Class;
                    rdfs:label "Interior Lighting System"@en;
                    rdfs:subClassOf comcore:ont00000236;
                    skos:definition "A Lighting System that is designed to emit light within the interior of some area."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001251 a owl:Class;
                    rdfs:label "Act of Intelligence Gathering"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act of producing and/or gathering information by a government or other Organization to guide decisions and actions by answering questions or obtaining advance warning of events and movements deemed to be important or otherwise relevant."@en;
                    comcore:ont00001754 "http://en.wikipedia.org/wiki/Intelligence_(information_gathering)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001252 a owl:Class;
                    rdfs:label "Propulsion Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000448;
                    skos:definition "A Motion Artifact Function that is realized in a process in which the bearer of the function creates force leading to an entity's movement."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propulsion&oldid=1022034059"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001253 a owl:Class;
                    rdfs:label "Fuel Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes in which a Portion of Fuel is reacted with other substances in order to release chemical or nuclear energy to be used for heat or for work."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fuel&oldid=1063590518"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001254 a owl:Class;
                    rdfs:label "Revolver"@en;
                    rdfs:subClassOf comcore:ont00000156;
                    skos:definition "A Hand Gun having a number of firing chambers in a revolving cylinder, where each chamber in the cylinder can be loaded with a single Cartridge."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Revolver&oldid=1060461644"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001255 a owl:Class;
                    rdfs:label "Insecticide Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000828;
                    skos:definition "A Pesticide Artifact Function that is realized in a process that causes harm to, or the death of, an insect."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Insecticide&oldid=1063322558"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001256 a owl:Class;
                    rdfs:label "Reliability Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    skos:altLabel "Accuracy of Process"@en,
                                  "Reliability Measurement"@en;
                    skos:definition "A Measurement Information Content Entity that is a measurement of the extent to which an entity can consistently produce an outcome."@en;
                    skos:scopeNote "Note, the term 'accuracy' is avoided due to its ambiguity between: correctness-of-performance ('Reliability Measurement Information Content Entity'), correctness-of-information (see: 'Veracity Measurement Information Content Entity'), and adherance-to-expectations (see: 'Deviation Measurement Information Content Entity')."@en,
                                   "Reliability concerns both a measure of past performance and the expectation that future performance will conform to the range of past performances."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Reliability_(statistics)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001257 a owl:Class;
                    rdfs:label "Nuclear Storage Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store nuclear material."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001258 a owl:Class;
                    rdfs:label "Port"@en;
                    rdfs:subClassOf comcore:ont00000226;
                    skos:definition "A Transportation Facility that is designed to contain harbors for docking Watercraft and for transfering people or cargo to and from land."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Port&oldid=1064091505"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001259 a owl:Class;
                    rdfs:label "Portion of Atmosphere"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A fiat object part of the layer of gas or layers of gases that envelop a natural satellite."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Atmosphere&oldid=1135486662"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001261 a owl:Class;
                    rdfs:label "Act of Identifying"@en;
                    rdfs:subClassOf comcore:ont00000379;
                    skos:definition "An Act of Representative Communication performed by asserting who or what a particular person or thing is."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/identify";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001262 a owl:Class;
                    rdfs:label "Person"@en;
                    rdfs:subClassOf comcore:ont00000562;
                    skos:altLabel "Human"@en;
                    skos:definition "An Animal that is a member of the species Homo sapiens."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Human&oldid=1063145185"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001263 a owl:Class;
                    rdfs:label "Act of Issuing Mass Media Documentary"@en;
                    rdfs:subClassOf comcore:ont00000588;
                    skos:definition "An Act of Mass Media Communication involving sending forth, distributing, or putting into circulation information that provides a factual record or report."@en;
                    comcore:ont00001754 "JC3IEDM-MIRD-DMWG-Edition_3.0.2_20090514";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001265 a owl:Class;
                    rdfs:label "Public Address System"@en;
                    rdfs:subClassOf comcore:ont00001036;
                    skos:altLabel "PA System"@en;
                    skos:definition "A Communication System that is designed to allow a Person to speak to a large audience."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Public_address_system&oldid=1059177344"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001266 a owl:Class;
                    rdfs:label "Act of Vocational Training Instruction"@en;
                    rdfs:subClassOf comcore:ont00001075;
                    skos:definition "An Act of Training Instruction performed by an Agent who realizes a capacity derived from the Agent's affiliation with a Vocational School, Technical School, Trade Organization, or Industry Educational Program Provider by imparting skills required for a specific occupation in industry, agriculture or trade to an Agent either directly or indirectly through some communication medium."@en;
                    comcore:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=vocational%20training";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001267 a owl:Class;
                    rdfs:label "Act of Propaganda"@en;
                    rdfs:subClassOf comcore:ont00000971;
                    skos:definition "An Act of Deceptive Communication Propaganda intended to influence the attitude of a mass audience toward some cause or position by presenting facts selectively (thus possibly lying by omission) or by using loaded messages to produce an emotional rather than rational response to the information presented."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Propaganda&oldid=1062472484"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001269 a owl:Class;
                    rdfs:label "Act of Warning"@en;
                    rdfs:subClassOf comcore:ont00000133;
                    skos:definition "An Act of Directive Communication performed by indicating a possible or impending danger, problem, or other unpleasant situation."@en;
                    comcore:ont00001754 "http://www.merriam-webster.com/dictionary/warning";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001270 a owl:Class;
                    rdfs:label "Howitzer"@en;
                    rdfs:subClassOf comcore:ont00000268;
                    skos:definition "A Cannon that is designed to have a relatively short barrel and to use relatively small propellant charges to propel projectiles in relatively high trajectories with a steep angle of descent."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Howitzer&oldid=1059576383"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001271 a owl:Class;
                    rdfs:label "Wired Communication Relay Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001169;
                    skos:definition "A Communication Relay Artifact Function that is realized during events in which a Material Artifact is used to first receive and then transmit information by means of wires from one Material Artifact to another for the purpose of communiction."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001272 a owl:Class;
                    rdfs:label "Act of Murder"@en;
                    rdfs:subClassOf comcore:ont00000191;
                    skos:definition "An Act of Homicide with malice aforethought."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001274 a owl:Class;
                    rdfs:label "Infrasonic Frequency"@en;
                    rdfs:subClassOf comcore:ont00000008;
                    skos:definition "A Sound Frequency that is below 20 Hz."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001275 a owl:Class;
                    rdfs:label "Nominal Speed Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001353;
                    skos:definition "A Speed Artifact Function that is realized in some process in which the Artifact bearing the Artifact Function attains a speed that does not exceed some specified tolerance of that Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001276 a owl:Class;
                    rdfs:label "Carrier Air Wing"@en;
                    rdfs:subClassOf comcore:ont00000426;
                    skos:definition "A Military Force that is trained and equipped to conduct air operations while embarked on an aircraft carrier."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001277 a owl:Class;
                    rdfs:label "Red"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that is above Orange with a wavelength in the visible spectrum typically between 635 to 700 nanometers."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001278 a owl:Class;
                    rdfs:label "Stock"@en;
                    rdfs:subClassOf comcore:ont00000537;
                    skos:definition "A Financial Instrument that entitles holders to an ownership interest (equity) in the specified Incorporated Organization."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Stock&oldid=1064040249"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001279 a owl:Class;
                    rdfs:label "Vibration Motion"@en;
                    rdfs:subClassOf comcore:ont00001133;
                    skos:altLabel "Mechanical Oscillation"@en,
                                  "Oscillation Motion"@en,
                                  "Vibration"@en;
                    skos:definition "A Motion wherein some participant repetitively deviates from a central location to two surrounding locations."@en;
                    comcore:ont00001754 "https://physicsabout.com/motion/"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001280 a owl:Class;
                    rdfs:label "Flat"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of the bearer having a horizontal border without a significant deviation."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001281 a owl:Class;
                    rdfs:label "Emulsifier Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000791;
                    skos:definition "A Chemical Reaction Artifact Function that is realized in a process in which two or more liquids that are normally immiscible are mixed."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Emulsion&oldid=1056901580"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001282 a owl:Class;
                    rdfs:label "Hydraulic Valve"@en;
                    rdfs:subClassOf comcore:ont00000598;
                    skos:definition "A Valve that is designed to regulate, direct, or control the flow of a liquid by opening, closing, or partially obstructing various passageways."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Power_transfer_unit&oldid=1002682083"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001283 a owl:Class;
                    rdfs:label "Refinery"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed for refining raw materials into products of value."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Refinery&oldid=1027092124"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001284 a owl:Class;
                    rdfs:label "Crew"@en;
                    rdfs:subClassOf comcore:ont00000914;
                    skos:definition "A Group of Persons that bear Roles realized by the operation of the specified Vehicle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001285 a owl:Class;
                    rdfs:label "Revolving Motion"@en;
                    rdfs:subClassOf comcore:ont00000368;
                    skos:definition "A Rotational Motion of an Object around an Axis of Rotation that is located externally to the Site occupied by the Object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001286 a owl:Class;
                    rdfs:label "Waveform"@en;
                    rdfs:subClassOf comcore:ont00000752;
                    skos:definition "A Wave Process Profile that is the shape of the Wave Cycles of the Wave Process when depicted in a visual graph."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001287 a owl:Class;
                    rdfs:label "Maintenance Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to be used to perform actions to maintain or improve the state of some property or equipment."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/maintain";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001288 a owl:Class;
                    rdfs:label "Round Shot"@en;
                    rdfs:subClassOf comcore:ont00001150;
                    skos:definition "A Portion of Ammunition that is designed to be a solid projectile without explosive charge and to be fired from a cannon."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Round_shot&oldid=1062790260"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001289 a owl:Class;
                    rdfs:label "Damaged Stasis"@en;
                    rdfs:subClassOf comcore:ont00000135;
                    skos:altLabel "Compromised"@en,
                                  "Damaged"@en,
                                  "Injured"@en;
                    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to a previous action or event such that the Independent Continuant is now of lesser value, usefulness, or functionality."@en;
                    skos:scopeNote "This class can be used to instantiate instances that might otherwise be treated by defined classes such as Damaged Vehicle or Wounded Person. The Independent Continuant and Quality or Realizable Entity are participants of the stasis which can in turn be related to the temporal interval via the occupies temporal region property. "@en;
                    comcore:ont00001754 "http://www.thefreedictionary.com/damaged";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001290 a owl:Class;
                    rdfs:label "Measurement Unit of Length"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of one-dimensional regions or Geospatial Regions."@en;
                    skos:example "foot, meter, kilometer, mile";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001291 a owl:Class;
                    rdfs:label "Radiation Absorptivity"@en;
                    rdfs:subClassOf comcore:ont00000628;
                    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of the capacity of that bearer to absorb electromagnetic radiation of a given frequency."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001292 a owl:Class;
                    rdfs:label "Bus"@en;
                    rdfs:subClassOf comcore:ont00000053;
                    skos:definition "A Ground Motor Vehicle that is designed to transport a large number of people and to travel on six or more tired wheels."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bus&oldid=1055341487"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001293 a owl:Class;
                    rdfs:label "Perimeter"@en;
                    rdfs:subClassOf comcore:ont00001367;
                    skos:definition "A One Dimensional Extent that inheres in a bearer in virtue of the extent of a boundary which encloses the bearer."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001294 a owl:Class;
                    rdfs:label "Three Dimensional Extent"@en;
                    rdfs:subClassOf comcore:ont00001202;
                    skos:altLabel "Volume"@en;
                    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in three dimensions."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001295 a owl:Class;
                    rdfs:label "Financial Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to support the management of money."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Finance&oldid=1062402926"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001296 a owl:Class;
                    rdfs:label "Pitch Orientation"@en;
                    rdfs:subClassOf comcore:ont00000119;
                    skos:altLabel "Pitch"@en;
                    skos:definition "A Spatial Orientation of an Object relative to its Pitch Axis."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001297 a owl:Class;
                    rdfs:label "Military Headquarters Facility"@en;
                    rdfs:subClassOf comcore:ont00001052;
                    skos:definition "A Military Facility that is designed for military administration and coordination."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Headquarters&oldid=1046429636"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001298 a owl:Class;
                    rdfs:label "Material Copy of a Document"@en;
                    rdfs:subClassOf comcore:ont00000798,
                                    [a owl:Restriction ; 
                                     owl:onProperty pobo:BFO_0000101 ; 
                                     owl:someValuesFrom comcore:ont00002039];
                    skos:altLabel "Document"@en;
                    skos:definition "An Information Bearing Artifact that is designed to carry some specific Information Content Entity in a series of paragraphs of text or diagrams in the form of physical pieces of paper or an electronic word processor file."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Document&oldid=1057829688"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001299 a owl:Class;
                    rdfs:label "Wetting Agent Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000344;
                    skos:definition "A Surfactant Artifact Function that is realized in a process that reduces the water repellent tendency of a substance thereby allowing it to become wet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Wetting&oldid=1062806793"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001300 a owl:Class;
                    rdfs:label "Patch Antenna"@en;
                    rdfs:subClassOf comcore:ont00001192;
                    skos:altLabel "Microstrip Patch Antenna"@en,
                                  "Rectangular Microstrip Antenna"@en;
                    skos:definition "A Radio Antenna that consists of a flat rectangular sheet (or patch) of metal mounted over a larger sheet of metal called a ground plane which is typically contained inside a plastic radome for protection and is small enough that it can be mounted on a flat surface."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Patch_antenna&oldid=1016658507"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001301 a owl:Class;
                    rdfs:label "Service Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process of providing intangible goods to consumers."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_and_services&oldid=1063137197"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001302 a owl:Class;
                    rdfs:label "Civil Organization"@en;
                    rdfs:subClassOf comcore:ont00001180;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001180
                                                             [a owl:Restriction ; 
                                                             owl:onProperty pobo:BFO_0000196 ; 
                                                             owl:someValuesFrom comcore:ont00000173]) ; 
                                         a owl:Class];
                    skos:definition "An Organization that is not commercial or military and is the bearer of a Civilian Role."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001303 a owl:Class;
                    rdfs:label "Position Observation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001306;
                    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the position of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001304 a owl:Class;
                    rdfs:label "Dimension Specification"@en;
                    rdfs:subClassOf comcore:ont00000575;
                    skos:definition "An Quality Specification that prescribes some Size Quality."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001305 a owl:Class;
                    rdfs:label "Loss of Function"@en;
                    rdfs:subClassOf comcore:ont00001066;
                    skos:definition "A Loss of Disposition in which some Independent Continuant ceases to be the bearer of some Function."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001306 a owl:Class;
                    rdfs:label "Observation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized during events in which a Material Artifact is used to collect information about a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001307 a owl:Class;
                    rdfs:label "Measurement Unit of Mass Flow Rate"@en;
                    rdfs:subClassOf comcore:ont00000061;
                    skos:definition "A Measurement Unit of Flow that is used as a standard for measurement of the rate at which the Mass of a substance passes per unit time."@en;
                    skos:example "kilogram per second, slug per second, pound per second";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001308 a owl:Class;
                    rdfs:label "Sewage Treatment Facility"@en;
                    rdfs:subClassOf comcore:ont00001315;
                    skos:definition "A Waste Management Facility that is designed for removing contaminants from wastewater, especially sewage."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Sewage_treatment&oldid=1062966352"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001309 a owl:Class;
                    rdfs:label "Lot Number"@en;
                    rdfs:subClassOf comcore:ont00000077;
                    skos:definition "A Code Identifier that designates a particular quantity or lot of material from a single manufacturer."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lot_number&oldid=1061846325"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001310 a owl:Class;
                    rdfs:label "Covering Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which an entity is covered."@en;
                    comcore:ont00001754 "http://www.dictionary.com/browse/covering";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001311 a owl:Class;
                    rdfs:label "Aircraft Manufacturing Facility"@en;
                    rdfs:subClassOf comcore:ont00000782;
                    skos:definition "A Factory that is designed to manufacture Aircraft."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Aerospace_manufacturer&oldid=1059223410"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001312 a owl:Class;
                    rdfs:label "Paramilitary Force"@en;
                    rdfs:subClassOf comcore:ont00000274;
                    skos:definition "An Armed Force whose organizational structure, training, subculture, and (often) function are similar to those of a professional Military, and which is not included as part of a Government's formal Armed Forces."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Paramilitary&oldid=1063281359"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001313 a owl:Class;
                    rdfs:label "Article of Clothing"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to cover some portion of a body."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Clothing&oldid=1063505718"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001314 a owl:Class;
                    rdfs:label "Legal System Act"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act performed by an Agent that realizes their role within the context of a legal system of some jurisdiction."@en;
                    comcore:ont00001754 "http://www.id.uscourts.gov/glossary.htm";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001315 a owl:Class;
                    rdfs:label "Waste Management Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed for managing waste for some portion of the waste's existence."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Waste_management&oldid=1062844209"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001316 a owl:Class;
                    rdfs:label "Gimbal"@en;
                    rdfs:subClassOf comcore:ont00001042;
                    skos:definition "An Equipment Mount that consists of a pivoted support that allows a Material Artifact to Rotate about one or more Axes."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Gimbal&oldid=1053306885"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001317 a owl:Class;
                    rdfs:label "Measurement Unit of Volume"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of sites or three-dimensional spatial regions."@en;
                    skos:example "cubic feet, cubic meter, quart, liter";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001318 a owl:Class;
                    rdfs:label "Yaw Orientation"@en;
                    rdfs:subClassOf comcore:ont00000119;
                    skos:altLabel "Yaw"@en;
                    skos:definition "A Spatial Orientation of an Object relative to its Yaw Axis."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001319 a owl:Class;
                    rdfs:label "Tank"@en;
                    rdfs:subClassOf comcore:ont00000427;
                    skos:definition "An Armored Fighting Vehicle that is designed to carry heavy firepower, have a powerful Engine, and travel on one or more continuous tracks such that it is suitable for front-line combat and can provide operational maneuverability as well as tactical offensive and defensive capabilities."@en;
                    skos:scopeNote "Tank firepower is normally provided by a large-caliber main gun mounted in a rotating turret, which is supported by secondary machine guns. A tank's heavy armour and all-terrain mobility provide protection for both the tank and its crew, allowing it to perform all primary tasks of the armoured troops on the battlefield."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Tank&oldid=1060527612"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001320 a owl:Class;
                    rdfs:label "Radio Transceiver"@en;
                    rdfs:subClassOf comcore:ont00000903;
                    skos:definition "A Radio Communication Instrument that is an electronic device composed of both a Radio Transmitter and a Radio Receiver that share common circuitry or a single housing."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Transceiver&oldid=1058453736"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001321 a owl:Class;
                    rdfs:label "Lead Acid Electric Battery"@en;
                    rdfs:subClassOf comcore:ont00001105;
                    skos:definition "A Secondary Cell Electric Battery that has a lead anode and lead oxide cathode."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Lead%E2%80%93acid_battery&oldid=1061641405"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001322 a owl:Class;
                    rdfs:label "Decrease of Generically Dependent Continuant"@en;
                    rdfs:subClassOf comcore:ont00000726;
                    skos:definition "A Decrease of Dependent Continuant in which some Independent Continuant has a decrease in the level of a Generically Dependent Continuant that it bears."@en;
                    skos:scopeNote "For the most part Generically Dependent Continuants do not inhere in their bearers over some continuous scale. The primary exception is religion and this class allows annotation of those cases where an Agent is described as becoming less religious. Other cases would include the decrease of an organization's bearing of some objective."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001323 a owl:Class;
                    rdfs:label "Bearing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in processes in which the Material Artifact constrains relative motion to only the desired motion, and reduces friction between moving parts."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001324 a owl:Class;
                    rdfs:label "Process Regulation"@en;
                    rdfs:subClassOf comcore:ont00000965;
                    skos:definition "A Prescriptive Information Content Entity that prescribes an Process as required, prohibited, or permitted, and is the output of an Process which realizes some Authority Role."@en;
                    skos:scopeNote "Although regulations often regulate processes which involve agents--as the regulating or regulated participant--it is unclear how causally active an agents need to be in those regulated processes. For example, it is not clear how causally active a human agent is in the process of a traffic light regulating the motion of a self-driving vehicle."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001325 a owl:Class;
                    rdfs:label "Act of Renting"@en;
                    rdfs:subClassOf comcore:ont00001334;
                    skos:definition "An Act of Purchasing wherein a Financial Instrument is used by an Agent (the Renter) as a payment to acquire temporary possession or use of a good or property that is owned or controlled by another Agent (the Seller)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001326 a owl:Class;
                    rdfs:label "Land Transportation Artifact"@en;
                    rdfs:subClassOf comcore:ont00000254;
                    skos:definition "A Transportation Artifact that facilitates the movement of Agents and Vehicles via land"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001327 a owl:Class;
                    rdfs:label "Social Act"@en;
                    rdfs:subClassOf comcore:ont00000228;
                    skos:definition "A Planned Act having an objective that affects, is performed by, or is performed on behalf of, a community or group of Persons."@en;
                    comcore:ont00001754 "http://en.wiktionary.org/wiki/commually";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001328 a owl:Class;
                    rdfs:label "Temporal Reference System"@en;
                    rdfs:subClassOf comcore:ont00000398;
                    skos:altLabel "Temporal Reference Frame"@en,
                                  "Time Scale"@en;
                    skos:definition "A Reference System that describes a set of standards for measuring time as well as understanding the context of and organizing temporal data."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001329 a owl:Class;
                    rdfs:label "Education Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of transmiting accumulated knowledge skills and values from one generation to another."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Education&oldid=1064011752"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001330 a owl:Class;
                    rdfs:label "Telemetry Process"@en;
                    rdfs:subClassOf comcore:ont00000110,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000345],
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001777 ; 
                                     owl:someValuesFrom comcore:ont00000517];
                    skos:definition "A Mechanical Process that is highly automated and in which measurements are made or other data is collected and transmitted to receiving equipment to facilitate the monitoring of environmental conditions or equipment parameters at a remote or inaccessible location."@en;
                    skos:example "using a GPS tag to track a shark's migratory pattern",
                                 "using a portable cardiac monitor to remotely collect data on a patient's heart activity (biotelemetry)";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Telemetry&oldid=1061697851"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001331 a owl:Class;
                    rdfs:label "Legal Name"@en;
                    rdfs:subClassOf comcore:ont00001014;
                    skos:definition "A Proper Name that is an official name for the designated entity as determined by a Government or court of law."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001332 a owl:Class;
                    rdfs:label "Extreme Ultraviolet Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00000610;
                    skos:definition "An Ultraviolet Light Frequency that is between 3 and 30 petahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ultraviolet&oldid=1062593453"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001333 a owl:Class;
                    rdfs:label "Rosy"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color consisting of red hue and yellow hue and high brightness."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001334 a owl:Class;
                    rdfs:label "Act of Purchasing"@en;
                    rdfs:subClassOf comcore:ont00000836;
                    skos:definition "An Act of Financial Instrument Use wherein a Financial Instrument is used by an Agent (the Purchaser) to acquire a good or service from another Agent (the Provider)."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Purchasing&oldid=1050163120"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001335 dcterms:creator "https://cubrc.org"^^xsd:anyURI;
                    a owl:Class;
                    rdfs:label "Government"@en;
                    rdfs:subClassOf comcore:ont00001180,
                                    [a owl:Restriction ; 
                                     owl:onProperty comcore:ont00001859 ; 
                                     owl:someValuesFrom comcore:ont00001203];
                    skos:definition "An Organization that is the highest legitimate authority delimited by some Delimiting Domain and that exercises executive, legislative, or judicial authority in that Domain."@en;
                    skos:editorialNote "Highest legitimate authority should not be confused with highest legitimate authority of a particular kind. For example, while the judicial branch of the United States government has the highest judicial authority in a Delimiting Domain, it is not the highest legitimate authority delimited by that domain. The combination of executive, judicial, and legislative branches is higher because it wields more legitimate authority than any branch on its own."@en,
                                       """Importantly, the definition states \"highest legitimate authority delimited by some Delimiting Domain\" and not \"highest legitimate authority in some Delimiting Domain.\" The government of Wales is the highest legitimate authority delimited by some Delimiting Domain but it is not the highest legitimate authority in that domain, which would be the government of the United Kingdom."""@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Government&oldid=1063736308"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001336 a owl:Class;
                    rdfs:label "Act of Ownership"@en;
                    rdfs:subClassOf comcore:ont00001232;
                    skos:definition "An Act of Possession that includes an agent having certain rights and duties over the property owned."@en;
                    skos:scopeNote "The relation between the owner and property may be private, collective, or common and the property may be objects, land, real estate, or intellectual property."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Ownership&oldid=1058224617"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001337 a owl:Class;
                    rdfs:label "Infrared Light Frequency"@en;
                    rdfs:subClassOf comcore:ont00000754;
                    skos:definition "An Electromagnetic Radiation Frequency of some Electromagnetic Wave that is between 300 gigahertz and 430 tetrahertz."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infrared&oldid=1064111319"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001338 a owl:Class;
                    rdfs:label "Timbre"@en;
                    rdfs:subClassOf comcore:ont00000862;
                    skos:definition "A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001339 a owl:Class;
                    rdfs:label "Act of Walking"@en;
                    rdfs:subClassOf comcore:ont00000890;
                    skos:definition "An Act of Travel that proceeds by foot."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001340 a owl:Class;
                    rdfs:label "Calendar Date Identifier"@en;
                    rdfs:subClassOf comcore:ont00000529;
                    skos:definition "A Date Identifier that designates some Day by using a combination of Day, Week, Month, or Year Identifiers formatted according to an implementation of a Calendar System."@en;
                    skos:example "January 1, 2018; 1 January 2018; 01/01/18; 01Jan18";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001341 a owl:Class;
                    rdfs:label "Portion of Geosphere"@en;
                    rdfs:subClassOf pobo:BFO_0000024;
                    skos:definition "A fiat object part that is composed of one or more portions of the atmosphere, cryosphere, hydrosphere, or lithosphere"@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Geosphere&oldid=1137306949"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001342 a owl:Class;
                    rdfs:label "Infantry Fighting Vehicle"@en;
                    rdfs:subClassOf comcore:ont00000427;
                    skos:definition "An Armored Fighting Vehicle that is designed to carry infantry into battle and to provide fire support for them."@en;
                    skos:scopeNote "Infantry Fighting Vehicles (IFVs) are differentiated from Armored Personnel Carriers (APCs) because they are designed to give direct fire support to the dismounted infantry and so usually have significantly enhanced armament. IFVs also often have improved armour and firing ports (allowing the infantry to fire personal weapons while mounted)."@en;
                    comcore:ont00001753 "IFV";
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Infantry_fighting_vehicle&oldid=1062470745"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001343 a owl:Class;
                    rdfs:label "Circuit Breaker"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to protect an electrical circuit from damage caused by excess current from an overload or short circuit."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Circuit_breaker&oldid=1060854893"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001344 a owl:Class;
                    rdfs:label "Biological Depot"@en;
                    rdfs:subClassOf comcore:ont00000881;
                    skos:definition "A Storage Facility that is designed to store biological agents."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001345 a owl:Class;
                    rdfs:label "Measurement Unit of Impulse"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of the integral of a Force applied to a portion of matter over a temporal interval."@en;
                    skos:example "N s, dyne second";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001346 a owl:Class;
                    rdfs:label "Legal Instrument"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed as a formally executed written document that can be formally attributed to its author, records and formally expresses a legally enforceable act, process, or contractual duty, obligation, or right, and therefore evidences that act, process, or agreement."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Legal_instrument&oldid=1054387344"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001347 a owl:Class;
                    rdfs:label "Behavior"@en;
                    rdfs:subClassOf comcore:ont00000005;
                    skos:definition "An Act in which an Independent Continuant participates as an Agent in response to external or internal stimuli and following some pattern which is dependent upon some combination of that Independent Continuant's internal state and external conditions."@en;
                    comcore:ont00001754 "http://purl.obolibrary.org/obo/GO_0007610";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001348 a owl:Class;
                    rdfs:label "Three-Dimensional Position"@en;
                    rdfs:subClassOf pobo:BFO_0000028;
                    skos:definition "A Three-Dimensional Spatial Region that encompasses the (minimal) spatial region in which some object is located at a particular time."@en;
                    skos:scopeNote "For an object in motion, its Three-Dimensional Position is part of its Three-Dimensional Path."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/GeospatialOntology"^^xsd:anyURI.
comcore:ont00001349 a owl:Class;
                    rdfs:label "Grey"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color between white and black colors."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001350 a owl:Class;
                    rdfs:label "Thermal Control Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by a Material Artifact increasing, decreasing, or maintaining the temperature of itself, a part of itself, or another object."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001351 a owl:Class;
                    rdfs:label "Cartesian Coordinate System"@en;
                    rdfs:subClassOf comcore:ont00000275;
                    skos:altLabel "Rectangular Coordinate System"@en;
                    skos:definition "A Spatial Reference System that identifies each point in a spatial region of n-dimensions using an ordered n-tuple of numerical coordinates that are the signed (i.e. positive or negative) distances measured in the same unit of length from the zero point where the fixed perpendicular Coordinate System Axes meet."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Cartesian_coordinate_system&oldid=1058613323"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001352 a owl:Class;
                    rdfs:label "Greenwich Mean Time Zone Identifier"@en;
                    rdfs:subClassOf comcore:ont00000829;
                    skos:definition "A Time Zone Identifier that designates a spatial region where the local time is calculated according to the specified offset from Greenwich Mean Time."@en;
                    skos:scopeNote "Greenwich Mean Time (GMT) is the mean solar time at the Royal Observatory in Greenwich, London and has been superseded by Coordinated Universal Time (UTC)."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001353 a owl:Class;
                    rdfs:label "Speed Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000448;
                    skos:definition "A Motion Artifact Function that is realized in some process in which its bearer has some speed."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001354 a owl:Class;
                    rdfs:label "Vermilion"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color consisting of red and orange hue with a slight amount of gray."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001355 a owl:Class;
                    rdfs:label "Freight Train Car"@en;
                    rdfs:subClassOf comcore:ont00000928;
                    skos:altLabel "Freight Car"@en;
                    skos:definition "A Train Car that is designed to transport cargo."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Goods_wagon&oldid=1062686785"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001356 a owl:Class;
                    rdfs:label "Increase of Disposition"@en;
                    rdfs:subClassOf comcore:ont00000611;
                    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Disposition that it bears."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001357 a owl:Class;
                    rdfs:label "Measurement Unit of Time"@en;
                    rdfs:subClassOf comcore:ont00000120;
                    skos:definition "A Measurement Unit that is used as a standard for measurement of temporal regions."@en;
                    skos:example "second, minute, hour, day";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001358 a owl:Class;
                    rdfs:label "School"@en;
                    rdfs:subClassOf comcore:ont00000270;
                    skos:definition "An Education Facility that is designed to provide learning space and environments for teaching of students under the direction of teachers."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=School&oldid=1063515394"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001359 a owl:Class;
                    rdfs:label "Act of Manufacturing"@en;
                    rdfs:subClassOf comcore:ont00000908;
                    skos:definition "An Act of Material Artifact Processing wherein Material Artifacts are mass produced in a Facility for the purpose of being sold or distributed to consumers."@en;
                    skos:scopeNote "An Act of Manufacturing typically involves the mass production of goods."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001360 a owl:Class;
                    rdfs:label "Three Dimensional Shape"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality that inheres only in a three dimensional entity."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001361 a owl:Class;
                    rdfs:label "Healing Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized in a process in which health is restored to an unbalanced, diseased, or damaged organism."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Healing&oldid=1053920678"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001362 a owl:Class;
                    rdfs:label "Gas Processing Facility"@en;
                    rdfs:subClassOf comcore:ont00001283;
                    skos:definition "A Refinery that is designed for refining natural gas into products of value."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Natural-gas_processing&oldid=1056700541"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001363 a owl:Class;
                    rdfs:label "Male Sex"@en;
                    rdfs:subClassOf comcore:ont00001033;
                    skos:definition "A Biological Sex inhering in an individual whose sex organs contain only male gametes."@en;
                    comcore:ont00001754 "http://purl.org/obo/owl/PATO#PATO_0000384";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001364 a owl:Class;
                    rdfs:label "Interval Measurement Information Content Entity"@en;
                    rdfs:subClassOf comcore:ont00001163;
                    owl:equivalentClass [owl:intersectionOf (comcore:ont00001163
                                                             [a owl:Restriction ; 
                                                             owl:onProperty comcore:ont00001877 ; 
                                                             owl:someValuesFrom pobo:BFO_0000001]) ; 
                                         a owl:Class];
                    skos:definition "A Measurement Information Content Entity that places a Quality of an Entity onto some interval scale having no true zero value."@en;
                    skos:example """The sentence \"The temperature reached -27 degrees Fahrenheit on January 20, 1985 in Chicago, IL.\" is the carrier of an interval measurement as 0 degrees on the Fahrenheit scale does not describe absolute zero."""@en;
                    skos:scopeNote """Four of the subtypes of measurements used here (Interval, Nominal, Ordinal, and Ratio) were originally defined by S.S. Stevens in the article \"On the Theory of Scales of Measurement\" in Science, Vol. 103 No. 2684 on June 7, 1946. For an introductory article with links to additional content including criticisms and alternate classifications of measurements see https://en.wikipedia.org/wiki/Level_of_measurement"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI.
comcore:ont00001365 a owl:Class;
                    rdfs:label "Maximum Speed Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001353;
                    skos:definition "A Speed Artifact Function that is realized in some process in which the Material Artifact bearing the Artifact Function attains the highest speed at which that Material Artifact is designed to operate."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001366 a owl:Class;
                    rdfs:label "Powering Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact is used to supply power to some Material Artifact."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001367 a owl:Class;
                    rdfs:label "One Dimensional Extent"@en;
                    rdfs:subClassOf comcore:ont00001202;
                    skos:definition "A Size Quality that inheres in a bearer in virtue of the bearer's extension in one dimension."@en;
                    skos:scopeNote "Subclasses of one dimensional extent are included for usability. It is doubtful any of them can be objectively distinguished (on the side of the bearing entity) without some reference to external properties such as orientation and perspective."@en;
                    comcore:ont00001754 "International Organization for Standardization. 2019. Quantities and units -- Part 3: Space and time (ISO 80000-3:2019). International Organization for Standardization. Available at: https://www.iso.org/standard/64974.html."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001368 a owl:Class;
                    rdfs:label "Motion Observation Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001306;
                    skos:definition "An Observation Artifact Function that is realized during events in which a Material Artifact is used to collect information about the Motion of a specified object or class of objects."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001369 a owl:Class;
                    rdfs:label "Rectangular"@en;
                    rdfs:subClassOf comcore:ont00001059;
                    skos:definition "A Shape Quality inhering in a bearer in virtue of having four sides and four 90 degree angles."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001370 a owl:Class;
                    rdfs:label "Machine Bearing"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed to constrain relative motion to only desired motion and reduces friction between moving parts."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Bearing_(mechanical)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001371 a owl:Class;
                    rdfs:label "Electromagnetic Induction Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000323;
                    skos:definition "An Artifact Function that is realized by processes in which some Material Artifact that is used to produce electromotive force across an electrical conductor due to its dynamic interaction with a magnetic field."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Electromagnetic_induction&oldid=1061836930"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001372 a owl:Class;
                    rdfs:label "Fertilizer Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00000437;
                    skos:definition "An Enhancing Artifact Function that is realized in processes of supplying soilds or plant tissues with one or more plant nutrients essential to growth."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fertilizer&oldid=1062923261"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001373 a owl:Class;
                    rdfs:label "Bow"@en;
                    rdfs:subClassOf comcore:ont00001051;
                    skos:definition "A Projectile Launcher that is designed to launch Arrows."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Bow_and_arrow&oldid=1062193194"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001374 a owl:Class;
                    rdfs:label "Act of Declarative Communication"@en;
                    rdfs:subClassOf comcore:ont00000402;
                    skos:definition "An Act of Communication that changes the reality in accord with the proposition of the declaration."@en;
                    skos:scopeNote "Examples: Baptism, Sentencing a person to imprisonment, Pronouncing a couple husband and wife, Declaring war"@en;
                    comcore:ont00001754 "Derived (loosely) from: John Searle's Speech Acts: An Essay in the Philosophy of Language";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001375 a owl:Class;
                    rdfs:label "Washing Facility"@en;
                    rdfs:subClassOf comcore:ont00000192;
                    skos:definition "A Facility that is designed to wash personnel or equipment."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Washing&oldid=1035998791"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001376 a owl:Class;
                    rdfs:label "Torque"@en;
                    rdfs:subClassOf comcore:ont00000570;
                    skos:altLabel "Moment of Force"@en;
                    skos:definition "A Force that is applied to an object in a direction that would tend to cause the object to rotate around an Axis of Rotation and is the rate of change of an object's Angular Momentum."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Torque&oldid=1063339484"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI.
comcore:ont00001377 a owl:Class;
                    rdfs:label "Gold Color"@en;
                    rdfs:subClassOf comcore:ont00000378;
                    skos:definition "A Color that resembles a yellow-orange Hue with the added feature of having a metallic shine."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001378 a owl:Class;
                    rdfs:label "Hospitality Artifact Function"@en;
                    rdfs:subClassOf comcore:ont00001301;
                    skos:definition "A Service Artifact Function that is realized in processes of accommodation food and beverage meeting and events gaming entertainment and recreation tourism services and visitor information."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Hospitality&oldid=1049599161"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001379 a owl:Class;
                    rdfs:label "Agent Capability"@en;
                    rdfs:subClassOf pobo:BFO_0000017;
                    skos:definition "A Realizable Entity that inheres in a Material Entity in virtue of that Material Entity's capacity to realize it in some Planned Act."@en;
                    comcore:ont00001754 """Schlosser, Markus, \"Agency\", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/"""@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/AgentOntology"^^xsd:anyURI.
comcore:ont00001380 a owl:Class;
                    rdfs:label "Farm"@en;
                    rdfs:subClassOf comcore:ont00000339;
                    skos:definition "An Agricultural Facility that is designed to produce food and other crops."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Farm&oldid=1058311769"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001381 a owl:Class;
                    rdfs:label "Medical Artifact"@en;
                    rdfs:subClassOf comcore:ont00000995;
                    skos:definition "A Material Artifact that is designed for diagnosing, treating, or preventing disease, disability, or death."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001382 a owl:Class;
                    rdfs:label "Electronic Cash"@en;
                    rdfs:subClassOf comcore:ont00000475;
                    skos:definition "A Portion of Cash that consists of Bytes."@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI.
comcore:ont00001383 a owl:Class;
                    rdfs:label "Fire Station"@en;
                    rdfs:subClassOf comcore:ont00000479;
                    skos:altLabel "Fire Hall"@en,
                                  "Fire House"@en;
                    skos:definition "A Public Safety Facility that is designed for the storage of firefighting apparatus."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/w/index.php?title=Fire_station&oldid=1060666629"^^xsd:anyURI;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/FacilityOntology"^^xsd:anyURI.
comcore:ont00001384 a owl:Class;
                    rdfs:label "Opacity"@en;
                    rdfs:subClassOf comcore:ont00000628;
                    skos:definition "A Disposition to Interact with Electromagnetic Radiation that inheres in a bearer in virtue of that bearer's capacity to transmit electromagnetic radiation of a given frequency through the bearer instead of reflecting, scattering, or absorbing electromangentic radiation of that frequency."@en;
                    skos:scopeNote "Note that it is important to specify the frequency of electromagnetic radiation when representing a bearer's Opacity since a bearer may be Opaque with respect to electromagnetic radiation of one frequency, but be transparent with respect to electromagnetic radiation of another frequency. Unless otherwise stated, statements about a bearer's Opacity are assumed to be about electromagnetic radiation with a frequency in the visible spectrum."@en;
                    comcore:ont00001754 "https://en.wikipedia.org/wiki/Opacity_(optics)";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/QualityOntology"^^xsd:anyURI.
comcore:ont00001385 a owl:NamedIndividual,
                      comcore:ont00000518;
                    rdfs:label "Haiti Gourde"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00001386 a owl:NamedIndividual,
                      comcore:ont00000518;
                    rdfs:label "Yemeni Rial"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00001387 a owl:NamedIndividual,
                      comcore:ont00000518;
                    rdfs:label "Mauritania Ouguiya"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00001388 a owl:NamedIndividual,
                      comcore:ont00000707;
                    rdfs:label "Minute of Arc Measurement Unit"@en;
                    skos:altLabel "Arcminute"@en,
                                  "MOA"@en,
                                  "am"@en,
                                  "amin"@en,
                                  "arcmin"@en;
                    comcore:ont00001740 "'";
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001389 a owl:NamedIndividual,
                      comcore:ont00000518;
                    rdfs:label "Kenyan Shilling"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/CurrencyUnitOntology"^^xsd:anyURI.
comcore:ont00001390 a owl:NamedIndividual,
                      comcore:ont00000239;
                    rdfs:label "Slug Measurement Unit"@en;
                    skos:altLabel "slug"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001391 a owl:NamedIndividual,
                      comcore:ont00000229,
                      comcore:ont00000444,
                      comcore:ont00000852;
                    rdfs:label "Erg Measurement Unit"@en;
                    skos:altLabel "erg"@en;
                    comcore:ont00001760 "https://www.commoncoreontologies.org/UnitsOfMeasureOntology"^^xsd:anyURI.
comcore:ont00001392 a owl:NamedIndividual,
                      comcore:ont00001352;
                    rdfs:label "GMT-8"@en;
