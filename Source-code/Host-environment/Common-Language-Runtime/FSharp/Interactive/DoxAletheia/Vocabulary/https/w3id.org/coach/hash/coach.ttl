                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                      rdfs:subPropertyOf coach:dimension;
                      <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their level of extraversion, as defined within the ExtraversionScheme."@en.
coach:hasLanguage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:label "hasLanguage";
                  rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.wikidata.org/prop/direct/P31> ; 
                              <http://www.w3.org/2002/07/owl#hasValue> <http://www.wikidata.org/entity/Q33742> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
                  rdfs:subPropertyOf coach:dimension;
                  <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with the natural languages they speak."@en;
                  <http://www.w3.org/2004/02/skos/core#editorialNote> "More than a language is allowed"@en.
coach:hasNeuroticism a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:label "hasNeuroticism"@en;
                     rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> coach:NeuroticismScheme ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                     rdfs:subPropertyOf coach:dimension;
                     <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their level of neuroticism, as defined within the NeuroticismScheme."@en.
coach:hasOpenness a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:label "hasOpenness"@en;
                  rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
