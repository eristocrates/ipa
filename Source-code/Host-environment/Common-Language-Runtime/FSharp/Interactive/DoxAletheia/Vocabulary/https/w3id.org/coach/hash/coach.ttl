                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>];
                              rdfs:subPropertyOf coach:dimension;
                              <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their political orientation."@en.
coach:hasReligion a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
