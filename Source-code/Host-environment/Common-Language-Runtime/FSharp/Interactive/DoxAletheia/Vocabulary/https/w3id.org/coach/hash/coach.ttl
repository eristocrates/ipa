                  rdfs:subPropertyOf coach:dimension;
                  <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their level of openness, as defined within the   OpennessScheme."@en.
coach:hasPoliticalOrientation a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                              rdfs:label "hasPoliticalOrientation"@en;
                              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                                                   <http://www.w3.org/2002/07/owl#hasValue> coach:PoliticalOrientationScheme ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.wikidata.org/prop/direct/P31> ; 
