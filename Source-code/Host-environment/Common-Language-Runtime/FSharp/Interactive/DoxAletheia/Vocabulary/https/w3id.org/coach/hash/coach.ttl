@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix wdt: <http://www.wikidata.org/prop/direct/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix coach: <https://w3id.org/coach#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix wikidata: <http://www.wikidata.org/entity/>.
@prefix schemas: <https://schema.org/>.

dcterms:abstract a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
rdf:langString a rdfs:Datatype.
skos:definition a owl:AnnotationProperty.
skos:editorialNote a owl:AnnotationProperty.
skos:inScheme a owl:ObjectProperty.
skos:notation a owl:AnnotationProperty.
wikidata:Q12909644 a owl:NamedIndividual;
                   rdfs:label "political ideology"@en.
wikidata:Q17888 a owl:NamedIndividual;
                rdfs:isDefinedBy <https://www.wikidata.org/>;
                rdfs:label "sexual orientation"@en.
wikidata:Q33742 a owl:NamedIndividual;
                rdfs:isDefinedBy <https://www.wikidata.org/>;
                rdfs:label "natural language"@en.
wikidata:Q4369513 a owl:NamedIndividual;
                  rdfs:isDefinedBy <https://www.wikidata.org/>;
                  rdfs:label "sex of humans"@en.
wikidata:Q6256 a owl:NamedIndividual;
               rdfs:isDefinedBy <https://www.wikidata.org/>;
               rdfs:label "country"@en.
wikidata:Q9174 a owl:NamedIndividual;
               rdfs:isDefinedBy <https://www.wikidata.org/>;
               rdfs:label "religion"@en.
wdt:P31 a owl:ObjectProperty;
        rdfs:label "instance of"@en.
foaf:fundedBy a owl:AnnotationProperty.
foaf:homepage a owl:AnnotationProperty.
foaf:mbox a owl:AnnotationProperty.
foaf:name a owl:AnnotationProperty.
<https://gitlab.com/canevesecamilla> a owl:NamedIndividual;
                                     foaf:mbox <mailto:canevesecamilla@gmail.com>;
                                     foaf:name "Camilla Canevese".
<https://gitlab.com/ecow> a owl:NamedIndividual;
                          foaf:mbox <mailto:enrico@fagnoni.it>;
                          foaf:name "Enrico Fagnoni".
<https://gitlab.com/linkeddatacenter> a owl:NamedIndividual;
                                      foaf:homepage "https://linkeddata.center/";
                                      foaf:name "LinkedData.Center".
schemas:citation a owl:AnnotationProperty.
schemas:codeRepository a owl:AnnotationProperty.
schemas:image a owl:AnnotationProperty;
              rdfs:range schemas:MediaObject.
coach: dcterms:abstract "An upper ontology to classify a character by some conceptual dimensions"@en;
       dcterms:created "2025-02-02T10:11:00"^^xsd:dateTime;
       dcterms:creator <https://gitlab.com/ecow>,
                       <https://gitlab.com/canevesecamilla>;
       dcterms:description "This ontology describes a person character as a vector of demographic traits, each dimension refers to a concept contained within a specific  taxonomy or to an instance of a  wikidata item."@en;
       dcterms:license <https://creativecommons.org/licenses/by-nc/4.0/>;
       dcterms:title "Character of a Character Ontology (COACH)"@en;
       vann:preferredNamespacePrefix "coach";
       vann:preferredNamespaceUri "https://w3id.org/coach#";
       a owl:Ontology;
       rdfs:isDefinedBy coach:;
       rdfs:label "COACH"@en;
       owl:versionIRI coach:;
       owl:versionInfo "0.9.0";
       foaf:fundedBy <https://gitlab.com/linkeddatacenter>;
       schemas:citation "C.Canevese, E.Fagnoni. Character of a Character Ontology (w3id.org/coach)"@en;
       schemas:codeRepository <https://gitlab.com/linkeddatacenter/coach>;
       schemas:image "/uml.png";
       <https://w3id.org/widoco/vocab#introduction> "TBD introduction"@en.
coach:AgeScheme a owl:NamedIndividual;
                rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/age-taxonomy.ttl>,
                                 coach:.
coach:AgreeablenessScheme a owl:NamedIndividual;
                          rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                           coach:.
coach:Character a owl:Class;
                rdfs:isDefinedBy coach:;
                rdfs:label "Character"@en;
                owl:equivalentClass [owl:someValuesFrom owl:Thing ; 
                                     owl:onProperty coach:dimension ; 
                                     a owl:Restriction];
                skos:definition "Represents an entity, real or fictional, characterized by various attributes (or dimensions) such as personality traits, cultural background, and preferences."@en.
coach:ConscientiousnessScheme a owl:NamedIndividual;
                              rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                               coach:.
coach:EducationScheme a owl:NamedIndividual;
                      rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/isced-taxonomy.ttl>.
coach:ExtraversionScheme a owl:NamedIndividual;
                         rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                          coach:.
coach:NeuroticismScheme a owl:NamedIndividual;
                        rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                         coach:.
coach:OpenessScheme a owl:NamedIndividual;
                    rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>.
coach:PoliticalOrientationScheme a owl:NamedIndividual;
                                 rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/political-orientation-taxonomy.ttl>.
coach:dimension a owl:ObjectProperty;
                rdfs:domain coach:Character;
                rdfs:isDefinedBy coach:;
                rdfs:label "hasDimension"@en;
                skos:definition "Identifies an essential feature or attribute of a Character, including personal, cultural, or psychological dimensions."@en.
coach:dislikes a owl:ObjectProperty;
               rdfs:label "dislikes"@en;
               rdfs:range owl:Thing;
               rdfs:subPropertyOf coach:dimension;
               owl:propertyDisjointWith coach:likes;
               skos:definition "Represents anything a Character dislikes."@en;
               skos:editorialNote "Better to use a wikipedia item"@en.
coach:hasAge a owl:ObjectProperty,
               owl:FunctionalProperty;
             rdfs:label "hasAge"@en;
             rdfs:range [owl:onProperty skos:inScheme ; 
                         owl:hasValue coach:AgeScheme ; 
                         a owl:Restriction];
             rdfs:subPropertyOf coach:dimension;
             skos:definition "Associates a Character with their age, as defined within the AgeScheme."@en.
coach:hasAgreeableness a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:label "hasAgreeableness"@en;
                       rdfs:range [owl:onProperty skos:inScheme ; 
                                   owl:hasValue coach:AgreeablenessScheme ; 
                                   a owl:Restriction];
                       rdfs:subPropertyOf coach:dimension;
                       skos:definition "Associates a Character with their level of agreeableness, as defined in the AgreeablenessScheme."@en.
coach:hasCitizenship a owl:ObjectProperty;
                     rdfs:label "hasCitizenship"@en;
                     rdfs:range [owl:onProperty wdt:P31 ; 
                                 owl:hasValue wikidata:Q6256 ; 
                                 a owl:Restriction];
                     rdfs:subPropertyOf coach:dimension;
                     skos:definition "Associates a Character with their country of citizenship."@en;
                     skos:editorialNote "More than a citizenship is allowed"@en.
coach:hasConscientiousness a owl:ObjectProperty,
                             owl:FunctionalProperty;
                           rdfs:label "hasConscientiousness"@en;
                           rdfs:range [owl:onProperty skos:inScheme ; 
                                       owl:hasValue coach:ConscientiousnessScheme ; 
                                       a owl:Restriction];
                           rdfs:subPropertyOf coach:dimension;
                           skos:definition "Associates a Character with their level of conscientiousness, as defined in the ConscientiousnessScheme."@en.
coach:hasCountryOfBirth a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:label "hasCountryOfBirth"@en;
                        rdfs:range [owl:onProperty wdt:P31 ; 
                                    owl:hasValue wikidata:Q6256 ; 
                                    a owl:Restriction];
                        rdfs:subPropertyOf coach:dimension;
                        skos:definition "Associates a Character with their country of birth, specifying the nation where the character was born."@en.
coach:hasEducation a owl:ObjectProperty,
                     owl:FunctionalProperty;
                   rdfs:label "hasEducation"@en;
                   rdfs:range [owl:onProperty skos:inScheme ; 
                               owl:hasValue coach:EducationScheme ; 
                               a owl:Restriction];
                   rdfs:subPropertyOf coach:dimension;
                   skos:definition "Associates a Character with their educational background, as defined within the EducationScheme."@en.
coach:hasExtraversion a owl:ObjectProperty,
                        owl:FunctionalProperty;
                      rdfs:label "hasExtraversion"@en;
                      rdfs:range [owl:onProperty skos:inScheme ; 
                                  owl:hasValue coach:ExtraversionScheme ; 
                                  a owl:Restriction];
                      rdfs:subPropertyOf coach:dimension;
                      skos:definition "Associates a Character with their level of extraversion, as defined within the ExtraversionScheme."@en.
coach:hasLanguage a owl:ObjectProperty;
                  rdfs:label "hasLanguage";
                  rdfs:range [owl:onProperty wdt:P31 ; 
                              owl:hasValue wikidata:Q33742 ; 
                              a owl:Restriction];
                  rdfs:subPropertyOf coach:dimension;
                  skos:definition "Associates a Character with the natural languages they speak."@en;
                  skos:editorialNote "More than a language is allowed"@en.
coach:hasNeuroticism a owl:ObjectProperty,
                       owl:FunctionalProperty;
                     rdfs:label "hasNeuroticism"@en;
                     rdfs:range [owl:onProperty skos:inScheme ; 
                                 owl:hasValue coach:NeuroticismScheme ; 
                                 a owl:Restriction];
                     rdfs:subPropertyOf coach:dimension;
                     skos:definition "Associates a Character with their level of neuroticism, as defined within the NeuroticismScheme."@en.
coach:hasOpenness a owl:ObjectProperty,
                    owl:FunctionalProperty;
                  rdfs:label "hasOpenness"@en;
                  rdfs:range [owl:onProperty skos:inScheme ; 
                              owl:hasValue coach:OpenessScheme ; 
                              a owl:Restriction];
                  rdfs:subPropertyOf coach:dimension;
                  skos:definition "Associates a Character with their level of openness, as defined within the   OpennessScheme."@en.
coach:hasPoliticalOrientation a owl:ObjectProperty,
                                owl:FunctionalProperty;
                              rdfs:label "hasPoliticalOrientation"@en;
                              rdfs:range [owl:unionOf ([owl:onProperty skos:inScheme ; 
                                                       owl:hasValue coach:PoliticalOrientationScheme ; 
                                                       a owl:Restriction]
                                                       [owl:onProperty wdt:P31 ; 
                                                       owl:hasValue wikidata:Q12909644 ; 
                                                       a owl:Restriction]) ; 
                                          a owl:Class];
                              rdfs:subPropertyOf coach:dimension;
                              skos:definition "Associates a Character with their political orientation."@en.
coach:hasReligion a owl:ObjectProperty,
                    owl:FunctionalProperty;
                  rdfs:label "hasReligion"@en;
                  rdfs:range [owl:onProperty wdt:P31 ; 
                              owl:hasValue wikidata:Q9174 ; 
                              a owl:Restriction];
                  rdfs:subPropertyOf coach:dimension;
                  skos:definition "Associates a Character with their religion, specifying the religious belief system they adhere to."@en.
coach:hasSex a owl:ObjectProperty,
               owl:FunctionalProperty;
             rdfs:label "hasSex"@en;
             rdfs:range [owl:onProperty wdt:P31 ; 
                         owl:hasValue wikidata:Q4369513 ; 
                         a owl:Restriction];
             rdfs:subPropertyOf coach:dimension;
             skos:definition "Associates a Character with their biological sex"@en.
coach:hasSexualOrientation a owl:ObjectProperty,
                             owl:FunctionalProperty;
                           rdfs:label "hasSexualOrientation"@en;
                           rdfs:range [owl:onProperty wdt:P31 ; 
                                       owl:hasValue wikidata:Q17888 ; 
                                       a owl:Restriction];
                           rdfs:subPropertyOf coach:dimension;
                           skos:definition "Associates a Character with their sexual orientation"@en.
coach:likes a owl:ObjectProperty;
            rdfs:label "likes"@en;
            rdfs:range owl:Thing;
            rdfs:subPropertyOf coach:dimension;
            skos:definition "Anything a Character dislikes"@en;
            skos:editorialNote "Better to use a wikipedia item."@en.
<https://w3id.org/widoco/vocab#introduction> a owl:AnnotationProperty.
<https://www.omg.org/spec/Commons/AnnotationVocabulary/synonym> a owl:AnnotationProperty.
