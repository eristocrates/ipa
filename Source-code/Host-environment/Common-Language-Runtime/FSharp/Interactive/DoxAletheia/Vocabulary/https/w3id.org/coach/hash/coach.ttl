coach: <http://purl.org/dc/terms/abstract> "An upper ontology to classify a character by some conceptual dimensions"@en;
       <http://purl.org/dc/terms/created> "2025-02-02T10:11:00"^^xsd:dateTime;
       <http://purl.org/dc/terms/creator> <https://gitlab.com/ecow>,
                                          <https://gitlab.com/canevesecamilla>;
       <http://purl.org/dc/terms/description> "This ontology describes a person character as a vector of demographic traits, each dimension refers to a concept contained within a specific  taxonomy or to an instance of a  wikidata item."@en;
       <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by-nc/4.0/>;
       <http://purl.org/dc/terms/title> "Character of a Character Ontology (COACH)"@en;
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "coach";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/coach#";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:isDefinedBy coach:;
       rdfs:label "COACH"@en;
       <http://www.w3.org/2002/07/owl#versionIRI> coach:;
       <http://www.w3.org/2002/07/owl#versionInfo> "0.9.0";
       <http://xmlns.com/foaf/0.1/fundedBy> <https://gitlab.com/linkeddatacenter>;
       <https://schema.org/citation> "C.Canevese, E.Fagnoni. Character of a Character Ontology (w3id.org/coach)"@en;
       <https://schema.org/codeRepository> <https://gitlab.com/linkeddatacenter/coach>;
       <https://schema.org/image> "/uml.png";
       <https://w3id.org/widoco/vocab#introduction> "TBD introduction"@en.
coach:AgeScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/age-taxonomy.ttl>,
                                 coach:.
coach:AgreeablenessScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                          rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                           coach:.
coach:Character a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy coach:;
                rdfs:label "Character"@en;
                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/2002/07/owl#Thing> ; 
                                                                 <http://www.w3.org/2002/07/owl#onProperty> coach:dimension ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2004/02/skos/core#definition> "Represents an entity, real or fictional, characterized by various attributes (or dimensions) such as personality traits, cultural background, and preferences."@en.
coach:ConscientiousnessScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                              rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                               coach:.
coach:EducationScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                      rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/isced-taxonomy.ttl>.
coach:ExtraversionScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                         rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                          coach:.
coach:NeuroticismScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                        rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>,
                                         coach:.
coach:OpenessScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                    rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/big5-taxonomy.ttl>.
coach:PoliticalOrientationScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                 rdfs:isDefinedBy <https://gitlab.com/linkeddatacenter/coach/-/raw/main/src/taxonomies/political-orientation-taxonomy.ttl>.
coach:dimension a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain coach:Character;
                rdfs:isDefinedBy coach:;
                rdfs:label "hasDimension"@en;
                <http://www.w3.org/2004/02/skos/core#definition> "Identifies an essential feature or attribute of a Character, including personal, cultural, or psychological dimensions."@en.
coach:dislikes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "dislikes"@en;
               rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:subPropertyOf coach:dimension;
               <http://www.w3.org/2002/07/owl#propertyDisjointWith> coach:likes;
               <http://www.w3.org/2004/02/skos/core#definition> "Represents anything a Character dislikes."@en;
               <http://www.w3.org/2004/02/skos/core#editorialNote> "Better to use a wikipedia item"@en.
coach:hasAge a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:label "hasAge"@en;
             rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                         <http://www.w3.org/2002/07/owl#hasValue> coach:AgeScheme ; 
                         a <http://www.w3.org/2002/07/owl#Restriction>];
             rdfs:subPropertyOf coach:dimension;
             <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their age, as defined within the AgeScheme."@en.
coach:hasAgreeableness a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                       rdfs:label "hasAgreeableness"@en;
                       rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                   <http://www.w3.org/2002/07/owl#hasValue> coach:AgreeablenessScheme ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                       rdfs:subPropertyOf coach:dimension;
                       <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their level of agreeableness, as defined in the AgreeablenessScheme."@en.
coach:hasCitizenship a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:label "hasCitizenship"@en;
                     rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.wikidata.org/prop/direct/P31> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> <http://www.wikidata.org/entity/Q6256> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                     rdfs:subPropertyOf coach:dimension;
                     <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their country of citizenship."@en;
                     <http://www.w3.org/2004/02/skos/core#editorialNote> "More than a citizenship is allowed"@en.
coach:hasConscientiousness a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                           rdfs:label "hasConscientiousness"@en;
                           rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> coach:ConscientiousnessScheme ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                           rdfs:subPropertyOf coach:dimension;
                           <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their level of conscientiousness, as defined in the ConscientiousnessScheme."@en.
coach:hasCountryOfBirth a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:label "hasCountryOfBirth"@en;
                        rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.wikidata.org/prop/direct/P31> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> <http://www.wikidata.org/entity/Q6256> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                        rdfs:subPropertyOf coach:dimension;
                        <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their country of birth, specifying the nation where the character was born."@en.
coach:hasEducation a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:label "hasEducation"@en;
                   rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> coach:EducationScheme ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
                   rdfs:subPropertyOf coach:dimension;
                   <http://www.w3.org/2004/02/skos/core#definition> "Associates a Character with their educational background, as defined within the EducationScheme."@en.
coach:hasExtraversion a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:label "hasExtraversion"@en;
                      rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
