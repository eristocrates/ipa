@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix epplan: <https://w3id.org/ep-plan#>.

<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/net/p-plan#Activity> a <http://www.w3.org/2002/07/owl#Class>;
                                      <http://www.w3.org/2002/07/owl#equivalentClass> epplan:Activity.
<http://purl.org/net/p-plan#Bundle> a <http://www.w3.org/2002/07/owl#Class>;
                                    <http://www.w3.org/2002/07/owl#equivalentClass> epplan:ExecutionTraceBundle.
<http://purl.org/net/p-plan#Entity> a <http://www.w3.org/2002/07/owl#Class>;
                                    <http://www.w3.org/2002/07/owl#equivalentClass> epplan:Entity.
<http://purl.org/net/p-plan#MultiStep> a <http://www.w3.org/2002/07/owl#Class>;
                                       <http://www.w3.org/2002/07/owl#equivalentClass> epplan:MultiStep.
<http://purl.org/net/p-plan#Plan> a <http://www.w3.org/2002/07/owl#Class>;
                                  <http://www.w3.org/2002/07/owl#equivalentClass> epplan:Plan.
<http://purl.org/net/p-plan#Step> a <http://www.w3.org/2002/07/owl#Class>;
                                  <http://www.w3.org/2002/07/owl#equivalentClass> epplan:Step.
<http://purl.org/net/p-plan#Variable> a <http://www.w3.org/2002/07/owl#Class>;
                                      <http://www.w3.org/2002/07/owl#equivalentClass> epplan:Variable.
<http://purl.org/net/p-plan#correspondsToStep> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:correspondsToStep.
<http://purl.org/net/p-plan#correspondsToVariable> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:correspondsToVariable.
<http://purl.org/net/p-plan#hasInputVar> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:hasInputVariable.
<http://purl.org/net/p-plan#hasOutputVar> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:hasOutputVariable.
<http://purl.org/net/p-plan#isDecomposedAsPlan> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isDecomposedAsPlan.
<http://purl.org/net/p-plan#isInputVarOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isInputVariableOf.
<http://purl.org/net/p-plan#isOutputVarOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                           <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isOutputVariableOf.
<http://purl.org/net/p-plan#isPrecededBy> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isPrecededBy.
<http://purl.org/net/p-plan#isStepOfPlan> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isStepOfPlan.
<http://purl.org/net/p-plan#isSubPlanOfPlan> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isSubPlanOfPlan.
<http://purl.org/net/p-plan#isVariableOfPlan> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              <http://www.w3.org/2002/07/owl#equivalentProperty> epplan:isVariableOfPlan.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:Resource a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Activity> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Agent> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Bundle> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Collection> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Communication> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Entity> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov#Plan> a <http://www.w3.org/2002/07/owl#Class>.
<https://w3id.org/ep-plan> <http://purl.org/dc/terms/created> "2019-03-06"^^xsd:date;
                           <http://purl.org/dc/terms/creator> "https://www.abdn.ac.uk/ncs/profiles/milan.markovic/"^^xsd:anyURI,
                                                              "http://delicias.dia.fi.upm.es/members/DGarijo#me"^^xsd:anyURI;
                           <http://purl.org/dc/terms/description> "PROV extension for linking Plans and parts of plans to their respective executions."@en;
                           <http://purl.org/dc/terms/license> "http://creativecommons.org/licenses/by-nc-sa/2.0/";
                           <http://purl.org/dc/terms/title> "The EP-Plan ontology"@en;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "ep-plan";
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/ep-plan";
                           a <http://www.w3.org/2002/07/owl#Ontology>;
                           rdfs:comment "PROV extension for linking Plans and parts of plans to their respective executions. ";
                           <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
epplan:Activity a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An element of an execution trace representing an individual process/activity corresponding to a  step of a plan and which used and/or generated  trace entities.";
                rdfs:label "Activity";
                rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>.
epplan:Agent a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A human or computational agent that can be responsible for the execution of an activity corresponding to a planned step or the overall plan execution.";
             rdfs:label "Agent";
             rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>.
epplan:Communication a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "ep-plan:Communication is a type of prov:Communication representing a transfer of an entity between two activities according to some planned specification expressed as ep-plan:CommunicationSpecification.";
                     rdfs:label "Communication";
                     rdfs:subClassOf <http://www.w3.org/ns/prov#Communication>.
epplan:CommunicationSpecification a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A specification of how communication/exchange of variables between two steps should be performed.";
                                  rdfs:label "CommunicationSpecification";
                                  <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Constraint
                                                                                                                         epplan:Policy
                                                                                                                         epplan:ResponsibleAgent
                                                                                                                         epplan:Step) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>].
epplan:Constraint a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A restriction placed on a particular step or a plan that is evaluated against an execution trace.";
                  rdfs:label "Constraint";
                  <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                                                         epplan:Policy
                                                                                                         epplan:ResponsibleAgent
                                                                                                         epplan:Step) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
epplan:ConstraintEvaluation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A concept used to qualify the relationship between a trace activity and a constraint associated with a step to which such activity corresponds to. The concept provides an opportunity to link additional information documenting the constraint evaluation process (e.g. a tool or an algorithm used to check for constraint violations, time when constraints were evaluated, etc.).";
                            rdfs:label "ConstraintEvaluation".
epplan:Entity a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An element of an execution trace representing an indidual entity corresponding to a  variable of a plan which was used and/or generated by activities recorded in the execution trace.";
              rdfs:label "Entity";
              rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>.
epplan:EntityCollection a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A collection of entities corresponding to ep-plan:MultiVariable. ep-pla:Entity contained in such collection corresponds to ep-plan:Variable that is linked to ep-plan:MultiVariable and defined in the subplan of a plan that the  ep-plan:MultiVariable is defined in.  Entity Collection is typically used or generated by  ep-plan:MultiActivity.";
                        rdfs:label "Entity Collection";
                        rdfs:subClassOf <http://www.w3.org/ns/prov#Collection>,
                                        epplan:Entity.
epplan:ExecutionTraceBundle a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A collection of trace elements that were generated during a single plan execution.";
                            rdfs:label "Execution Trace Bundle";
                            rdfs:subClassOf <http://www.w3.org/ns/prov#Bundle>,
                                            epplan:Entity.
epplan:FailedActivity a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A concept representing an activity that was not executed in full, for example, due to constraint violation. Such an activity usually marks the point when the plan execution was interrupted due to some problem.";
                      rdfs:label "Failed Activity";
                      rdfs:subClassOf epplan:Activity.
epplan:MultiActivity a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An activity that typically corresponds to a MultiStep which is decomposed as a Plan or the main execution activity that executed the plan. ep-plan:MultiActivity typically generates ep-plan:ExecutionTraceBundle.";
                     rdfs:label "Multi Activity";
                     rdfs:subClassOf epplan:Activity.
epplan:MultiStep a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "ep-plan:MultiStep is the representation of a composite step that can be described (decomposed) as another ep-plan:Plan.";
                 rdfs:label "MultiStep";
                 rdfs:subClassOf epplan:Step.
epplan:MultiVariable a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "ep-plan:MultiVariable represents a composite variable that can be broken down into smaller parts represented as ep-plan:Variable(s).";
                     rdfs:label "MultiVariable";
                     rdfs:subClassOf epplan:Variable.
epplan:Objective a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment " ep-plan:Objective describes information detailing a specific purpose of a plan. Plans can have more than one objectives. Users are encouraged to extend this class, for example, to identify primary and secondary objectives of a plan.";
                 rdfs:label "Objective".
epplan:Plan a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An ep-plan:Plan is a specific type of prov:Plan. It is composed of smaller steps that use and produce variables.";
            rdfs:label "Plan";
            rdfs:subClassOf <http://www.w3.org/ns/prov#Plan>.
epplan:Policy a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A generic representation of a collection of rules that may be applicable in the context of a specific plan. A policy can provide a rationale for constraints being applied to steps as well as explain reasons including other plan elements. For example, a data protection policy might require that steps are executed by specific agents and that a data anonymisation step is included in the plan.";
              rdfs:label "Policy";
              <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                                                     epplan:Constraint
                                                                                                     epplan:ResponsibleAgent
                                                                                                     epplan:Step) ; 
                                                            a <http://www.w3.org/2002/07/owl#Class>].
epplan:Rationale a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A generic concept describing a specific justification of a plan or an individual plan element. For example, a  data anonymisation step might be included in the plan to protect personal information as a result of a data protection policy associated with a plan (i.e. the reason for including such a step in a plan). Similarly, a data protection policy associated with a plan can be linked to a description of the General Data Protection Regulation (GDPR) which provides the reason why such policy was implemented.";
                 rdfs:label "Rationale".
epplan:ResponsibleAgent a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An agent that can bear some responsibility for execution of activities corresponding to the planned steps.";
                        rdfs:label "ResponsibleAgent";
                        <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                                                               epplan:Constraint
                                                                                                               epplan:Policy
                                                                                                               epplan:Step) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
epplan:Step a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An ep-plan:Step represents the planned execution activity.";
            rdfs:label "Step";
            <http://www.w3.org/2002/07/owl#disjointWith> epplan:Variable.
epplan:Variable a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An ep-plan:Variable represents a description of the input of the planned Activity (ep-plan:Step)";
                rdfs:label "Variable".
epplan:achieves a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Inverse of ep-plan:isAchievedBy.";
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                      epplan:Constraint
                                                                      epplan:Plan
                                                                      epplan:ResponsibleAgent
                                                                      epplan:Step
                                                                      epplan:Variable) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "achieves";
                rdfs:range epplan:Objective;
                <http://www.w3.org/2002/07/owl#inverseOf> epplan:isAchievedBy.
epplan:constrains a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Inverse of ep-plan:hasConstraint.";
                  rdfs:domain epplan:Constraint;
                  rdfs:label "constrains";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                       epplan:Plan
                                                                       epplan:Step) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  <http://www.w3.org/2002/07/owl#inverseOf> epplan:hasConstraint.
epplan:correspondsToCommunicationSpecification a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                               rdfs:comment "ep-plan:correspondsToCommunicationSpecification links ep-plan:Communication to its planned specification.";
                                               rdfs:domain epplan:Communication;
                                               rdfs:label "correspondsToCommunicationSpecification";
                                               rdfs:range epplan:CommunicationSpecification;
                                               <http://www.w3.org/2002/07/owl#inverseOf> epplan:hasCorrespondingCommunication.
epplan:correspondsToStep a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                           <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                         rdfs:comment "ep-plan:correspondsToStep links a ep-plan:Activity to its planned ep-plan:Step";
                         rdfs:domain epplan:Activity;
                         rdfs:label "correspondsToStep";
                         rdfs:range epplan:Step;
                         <http://www.w3.org/2002/07/owl#inverseOf> epplan:hasCorrespondingActivity.
epplan:correspondsToVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                             rdfs:comment "ep-plan:correspondsToVariable binds a ep-plan:Entity (used by a ep-plan:Activity in the execution of a plan) to the ep-plan:Variable it represented it in the ep-plan:Plan.";
                             rdfs:domain epplan:Entity;
                             rdfs:label "correspondsToVariable";
                             rdfs:range epplan:Variable;
                             <http://www.w3.org/2002/07/owl#inverseOf> epplan:hasCorrespondingEntity.
epplan:decomposesMultiStep a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Inverse of ep-plan:isDecomposedAsPlan.";
                           rdfs:domain epplan:Plan;
                           rdfs:label "decomposesMultiStep";
                           rdfs:range epplan:MultiStep;
                           <http://www.w3.org/2002/07/owl#inverseOf> epplan:isDecomposedAsPlan.
epplan:evaluatedAgainst a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "ep-plan:evaluatedAgainst links ep-plan:Activity or ep-plan:Communication to an ep-plan:Constraint. The use of subproperties of ep-plan:evaluatedAgainst is encouraged to indicate whether the execution trace element satisfied the constraint.";
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                              epplan:Communication) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:label "evaluatedAgainst";
                        rdfs:range epplan:Constraint;
                        <http://www.w3.org/2002/07/owl#inverseOf> epplan:evaluatedFor.
epplan:evaluatedFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Inverse of ep-plan:evaluatedAgainst.";
                    rdfs:domain epplan:Constraint;
                    rdfs:label "evaluatedFor";
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                         epplan:Communication) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
epplan:evaluatedTraceElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "ep-plan:evaluatedTraceElement links ep-plan:ConstriantEvaluation to a ep-plan:Activity or ep-plan:Communication that were evaluated against a ep-plan:Constraint defined in the plan.";
                             rdfs:domain epplan:ConstraintEvaluation;
                             rdfs:label "evaluatedTraceElement";
                             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                                  epplan:Communication) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                             <http://www.w3.org/2002/07/owl#inverseOf> epplan:wasEvaluatedtraceElement.
epplan:hasConstraint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "ep-plan:hasConstraint links ep-plan:Step, ep-plan:CommunicationSpec or ep-plan:Plan to a ep-plan:Constraint. Please note, that we do not stipulate that this constriant must be strictly satisfied before the plan can continue. This is to enable inclusions of constraints defined by policies which can be violated under certain conditions and to also enable capture of incorrect behaviour of a system (e.g. a plan ignored a constriant).";
                     rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                           epplan:Plan
                                                                           epplan:Step) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                     rdfs:label "hasConstraint";
                     rdfs:range epplan:Constraint.
epplan:hasConstraintImplementation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "ep-plan:hasConstraintImplementation links ep-plan:Constraint to any resource that provides details on how such constraint is implemented (e.g. a rule, script, etc.).";
                                   rdfs:domain epplan:Constraint;
                                   rdfs:label "hasConstraintImplementation";
                                   rdfs:range rdfs:Resource;
                                   <http://www.w3.org/2002/07/owl#inverseOf> epplan:isConstraintImplementationOf.
epplan:hasCorrespondingActivity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Inverse of ep-plan:correspondsToStep.";
                                rdfs:domain epplan:Step;
                                rdfs:label "hasCorrespondingActivity";
                                rdfs:range epplan:Activity.
epplan:hasCorrespondingCommunication a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "Inverse of correspondsToCommunicationSpecification";
                                     rdfs:domain epplan:CommunicationSpecification;
                                     rdfs:label "hasCorrespondingCommunication";
                                     rdfs:range epplan:Communication.
epplan:hasCorrespondingEntity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Inverse of ep-plan:correspondsToVariable.";
                              rdfs:domain epplan:Variable;
                              rdfs:label "hasCorrespondingEntity";
                              rdfs:range epplan:Entity.
epplan:hasInputVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "ep-plan:hasInputVariable binds a ep-plan:Step to the ep-plan:Variable that takes as input for the planned execution.";
                        rdfs:domain epplan:Step;
                        rdfs:label "hasInputVariable";
                        rdfs:range epplan:Variable;
                        <http://www.w3.org/2002/07/owl#inverseOf> epplan:isInputVariableOf.
epplan:hasOutputVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "ep-plan:hasOutputVariable binds a ep-plan:Step to the ep-plan:Variable that will be produced as output in the planned execution";
                         rdfs:domain epplan:Step;
                         rdfs:label "hasOutputVariable";
                         rdfs:range epplan:Variable;
                         <http://www.w3.org/2002/07/owl#inverseOf> epplan:isOutputVariableOf.
epplan:hasPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "ep-plan:hasPart links amn ep-plan:MultiVariable to another ep-plan:Variable that represents a smaller part of a composite variable.";
               rdfs:domain epplan:MultiVariable;
               rdfs:label "hasPart";
               rdfs:range epplan:Variable;
               <http://www.w3.org/2002/07/owl#inverseOf> epplan:isPartOf.
epplan:hasPayload a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "ep-plan:hasPayload links an ep-plan:Variable to an ep-plan:CommunicationSpecification and identyfies the variable that will be transferred according to the ep-plan:CommunicationSpecification.";
                  rdfs:domain epplan:CommunicationSpecification;
                  rdfs:label "hasPayload";
                  rdfs:range epplan:Variable;
                  <http://www.w3.org/2002/07/owl#inverseOf> epplan:isPayloadIn.
epplan:hasPermittedAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "ep-plan:hasPermittedAgent links ep-plan:Step or the overall ep-plan:Plan to an ep-plan:ResponsibleAgent denoting that  the agent is allowed to assume some form of responsibility during the execution. Please note that not all linked ep-plan:ResponsibleAgent(s) must also appear in the execution trace as ep-plan:Agent. ep-plan:hasPermittedAgent relationship merely indicates that it is possible for this agent to asssume some responsibility during the execution.";
                         rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Plan
                                                                               epplan:Step) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                         rdfs:label "hasPermittedAgent";
                         rdfs:range epplan:ResponsibleAgent;
                         <http://www.w3.org/2002/07/owl#inverseOf> epplan:isPermittedAgentFor.
epplan:hasRationale a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "A property linking a plan element to the description of a rationale which provides some information on why such element was included in a plan.";
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                          epplan:Constraint
                                                                          epplan:Objective
                                                                          epplan:Plan
                                                                          epplan:ResponsibleAgent
                                                                          epplan:Step
                                                                          epplan:Variable) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:label "hasRationale";
                    rdfs:range epplan:Rationale;
                    <http://www.w3.org/2002/07/owl#inverseOf> epplan:isRationaleOf.
epplan:hasRecipient a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "ep-plan:hasRecipient links an ep-plan:Step to an ep-plan:CommunicationSpecification and indicates that the step is expected to receive an ep-plan:Variable that will be transferred according to the ep-plan:CommunicationSpecification.";
                    rdfs:domain epplan:CommunicationSpecification;
                    rdfs:label "hasRecipient";
                    rdfs:range epplan:Step;
                    <http://www.w3.org/2002/07/owl#inverseOf> epplan:isRecipientIn.
epplan:hasSender a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "ep-plan:hasSender links an ep-plan:Step to  an ep-plan:CommunicationSpecification and indicates that the step is expected to produce an ep-plan:Variable that will be transferred according to the ep-plan:CommunicationSpecification.";
                 rdfs:domain epplan:CommunicationSpecification;
                 rdfs:label "hasSender";
                 rdfs:range epplan:Step;
                 <http://www.w3.org/2002/07/owl#inverseOf> epplan:isSenderIn.
epplan:hasTraceElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "ep-plan:hasTraceElement links ep-plan:ExecutionTraceBundle to execution trace elements ( i.e. ep-plan:Agent,ep-plan:Activity or ep-plan:Entity).";
                       rdfs:domain epplan:ExecutionTraceBundle;
                       rdfs:label "hasTraceElement";
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                            epplan:Agent
                                                                            epplan:Communication
                                                                            epplan:Entity) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       <http://www.w3.org/2002/07/owl#inverseOf> epplan:isElementOfTrace.
epplan:includesCommunicationSpecification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "Inverse of ep-plan:isCommunicationSpecificationOfPlan.";
                                          rdfs:domain epplan:Plan;
                                          rdfs:label "includesCommunicationSpecification";
                                          rdfs:range epplan:CommunicationSpecification;
                                          rdfs:subPropertyOf epplan:includesPlanElement;
                                          <http://www.w3.org/2002/07/owl#inverseOf> epplan:isCommunicationSpecificationOfPlan.
epplan:includesConstraint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Inverse of ep-plan:isConstraintOfPlan.";
                          rdfs:domain epplan:Plan;
                          rdfs:label "includesConstraint";
                          rdfs:range epplan:Constraint;
                          rdfs:subPropertyOf epplan:includesPlanElement;
                          <http://www.w3.org/2002/07/owl#inverseOf> epplan:isConstraintOfPlan.
epplan:includesObjective a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Inverse of ep-plan:isObjectiveOfPlan.";
                         rdfs:domain epplan:Plan;
                         rdfs:label "includesObjective";
                         rdfs:range epplan:Objective;
                         rdfs:subPropertyOf epplan:includesPlanElement;
                         <http://www.w3.org/2002/07/owl#inverseOf> epplan:isObjectiveOfPlan.
epplan:includesPlanElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Inverse of ep-plan:isElementOfPlan.";
                           rdfs:domain epplan:Plan;
                           rdfs:label "includesPlanElement";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                                epplan:Constraint
                                                                                epplan:Objective
                                                                                epplan:Plan
                                                                                epplan:ResponsibleAgent
                                                                                epplan:Step
                                                                                epplan:Variable) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                           <http://www.w3.org/2002/07/owl#inverseOf> epplan:isElementOfPlan.
epplan:includesPolicy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Inverse of ep-plan:isPolicyOfPlan.";
                      rdfs:domain epplan:Plan;
                      rdfs:label "includesPolicy";
                      rdfs:range epplan:Policy;
                      rdfs:subPropertyOf epplan:includesPlanElement;
                      <http://www.w3.org/2002/07/owl#inverseOf> epplan:isPolicyOfPlan.
epplan:includesResponsibleAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Inverse of ep-plan:isResponsibleAgentOfPlan.";
                                rdfs:domain epplan:Plan;
                                rdfs:label "includesResponsibleAgent";
                                rdfs:range epplan:ResponsibleAgent;
                                rdfs:subPropertyOf epplan:includesPlanElement;
                                <http://www.w3.org/2002/07/owl#inverseOf> epplan:isResponsibleAgentOfPlan.
epplan:includesStep a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Inverse of ep-plan:isStepOfPlan.";
                    rdfs:domain epplan:Plan;
                    rdfs:label "includesStep";
                    rdfs:range epplan:Step;
                    rdfs:subPropertyOf epplan:includesPlanElement;
                    <http://www.w3.org/2002/07/owl#inverseOf> epplan:isStepOfPlan.
epplan:includesSubPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                       rdfs:comment "Inverse of ep-plan:isSubPlanOf.";
                       rdfs:domain epplan:Plan;
                       rdfs:label "includesSubPlan";
                       rdfs:range epplan:Plan;
                       rdfs:subPropertyOf epplan:includesPlanElement;
                       <http://www.w3.org/2002/07/owl#inverseOf> epplan:isSubPlanOfPlan.
epplan:includesVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Inverse of ep-plan:isVariableOfPlan.";
                        rdfs:domain epplan:Plan;
                        rdfs:label "includesVariable";
                        rdfs:range epplan:Variable;
                        rdfs:subPropertyOf epplan:includesPlanElement;
                        <http://www.w3.org/2002/07/owl#inverseOf> epplan:isVariableOfPlan.
epplan:isAchievedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "ep-plan:isAchievedBy links ep-plan:Objective to a plan or individual plan element that is expected to achieve the objective specified by ep-plan:Objective.";
                    rdfs:domain epplan:Objective;
                    rdfs:label "isAchievedBy";
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                         epplan:Constraint
                                                                         epplan:Plan
                                                                         epplan:ResponsibleAgent
                                                                         epplan:Step
                                                                         epplan:Variable) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
epplan:isCommunicationSpecificationOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "ep-plan:isCommunicationSpecificationOfPlan binds a ep-plan:CommunicationSpecification to the ep-plan:Plan it corresponds to.";
                                          rdfs:domain epplan:CommunicationSpecification;
                                          rdfs:label "isCommunicationSpecificationOfPlan";
                                          rdfs:range epplan:Plan;
                                          rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isConstraintImplementationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "Inverse of ep-plan:hasConstraintImplementation.";
                                    rdfs:domain rdfs:Resource;
                                    rdfs:label "isConstraintImplementationOf";
                                    rdfs:range epplan:Constraint.
epplan:isConstraintOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "ep-plan:isConstraintOfPlan binds a ep-plan:Constraint to the ep-plan:Plan it corresponds to.";
                          rdfs:domain epplan:Constraint;
                          rdfs:label "isConstraintOfPlan";
                          rdfs:range epplan:Plan;
                          rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isDecomposedAsPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "The ep-plan:isDecomposedAsPlan relationship binds a ep-plan:MultiStep to the ep-plan:Plan holding the definition of that step. That is, ep-plan:isDecomposedAsPlan links the MultiStep to the Plan sptecification where it is decomposed.";
                          rdfs:domain epplan:MultiStep;
                          rdfs:label "isDecomposedAsPlan";
                          rdfs:range epplan:Plan.
epplan:isElementOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "ep-plan:isElementOfPlan binds a ep-plan:PlanElement to the ep-plan:Plan it corresponds to.";
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                             epplan:Constraint
                                                                             epplan:Objective
                                                                             epplan:Plan
                                                                             epplan:ResponsibleAgent
                                                                             epplan:Step
                                                                             epplan:Variable) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:label "isElementOfPlan";
                       rdfs:range epplan:Plan.
epplan:isElementOfTrace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Inverse of ep-plan:hasTraceElement.";
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                              epplan:Agent
                                                                              epplan:Communication
                                                                              epplan:Entity) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:label "isElementOfTrace";
                        rdfs:range epplan:ExecutionTraceBundle.
epplan:isInputVariableOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Inverse of ep-plan:hasInputVariable";
                         rdfs:domain epplan:Variable;
                         rdfs:label "isInputVariableOf";
                         rdfs:range epplan:Step.
epplan:isObjectiveOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "ep-plan:isObjectiveOfPlan binds a ep-plan:Objective to the ep-plan:Plan it corresponds to.";
                         rdfs:domain epplan:Objective;
                         rdfs:label "isObjectiveOfPlan";
                         rdfs:range epplan:Plan;
                         rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isOutputVariableOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Inverse of p-plan:hasOutputVariable.";
                          rdfs:domain epplan:Variable;
                          rdfs:label "isOutputVariableOf";
                          rdfs:range epplan:Step.
epplan:isPartOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Inverse of ep-plan:hasPart.";
                rdfs:domain epplan:Variable;
                rdfs:label "isPartOf";
                rdfs:range epplan:MultiVariable.
epplan:isPayloadIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Inverse of ep-plan:hasPayload.";
                   rdfs:domain epplan:Variable;
                   rdfs:label "isPayloadIn";
                   rdfs:range epplan:CommunicationSpecification.
epplan:isPermittedAgentFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Inverse of ep-plan:hasPermittedAgent.";
                           rdfs:domain epplan:ResponsibleAgent;
                           rdfs:label "isPermittedAgentFor";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Plan
                                                                                epplan:Step) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>].
epplan:isPolicyOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "ep-plan:isPolicyOfPlan binds a ep-plan:Policy to the ep-plan:Plan it corresponds to.";
                      rdfs:domain epplan:Policy;
                      rdfs:label "isPolicyOfPlan";
                      rdfs:range epplan:Plan;
                      rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isPrecededBy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                    rdfs:comment "Property that asserts which Step preceeds the current one.";
                    rdfs:domain epplan:Step;
                    rdfs:label "isPrecededBy";
                    rdfs:range epplan:Step;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                    <http://www.w3.org/2002/07/owl#inverseOf> epplan:precedes.
epplan:isQualifiedEvaluationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Inverse of ep-plan:qualifiedEvaluation.";
                               rdfs:domain epplan:ConstraintEvaluation;
                               rdfs:label "isQualifiedEvaluationOf";
                               rdfs:range epplan:Constraint;
                               <http://www.w3.org/2002/07/owl#inverseOf> epplan:qualifiedEvaluation.
epplan:isRationaleOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Inverse of hasRationale.";
                     rdfs:domain epplan:Rationale;
                     rdfs:label "isRationaleOf";
                     rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:CommunicationSpecification
                                                                          epplan:Constraint
                                                                          epplan:Objective
                                                                          epplan:Plan
                                                                          epplan:ResponsibleAgent
                                                                          epplan:Step
                                                                          epplan:Variable) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>].
epplan:isRecipientIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Inverse of ep-plan:hasRecipient.";
                     rdfs:domain epplan:Step;
                     rdfs:label "isRecipientIn";
                     rdfs:range epplan:CommunicationSpecification.
epplan:isResponsibleAgentOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "ep-plan:isResponsibleAgentOfPlan binds a ep-plan:ResponsibleAgent to the ep-plan:Plan it corresponds to.";
                                rdfs:domain epplan:ResponsibleAgent;
                                rdfs:label "isResposibleAgentOfPlan";
                                rdfs:range epplan:Plan;
                                rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isSenderIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Inverse of ep-plan:hasSender.";
                  rdfs:domain epplan:Step;
                  rdfs:label "isSenderIn";
                  rdfs:range epplan:CommunicationSpecification.
epplan:isStepOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "ep-plan:isStepOfPlan binds a ep-plan:Step to the ep-plan:Plan it corresponds to.";
                    rdfs:domain epplan:Step;
                    rdfs:label "isStepOfPlan";
                    rdfs:range epplan:Plan;
                    rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isSubPlanOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                       rdfs:comment "ep-plan:Plan may be a subplan of another bigger ep-plan:Plan. The relation ep-plan:isSubPlanOfPlan is used to state the link among the two different plans. Note that if p1 is a sub-plan of p2, p1 will not necessarily be a step of p2. A multistep will represent p1 in p2, and link to p1 with the hasStepDecomposition relationship.";
                       rdfs:domain epplan:Plan;
                       rdfs:label "isSubPlanOfPlan";
                       rdfs:range epplan:Plan;
                       rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:isVariableOfPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "ep-plan:isVariableOfPlan binds a ep-plan:Variable to the ep-plan:Plan it corresponds to.";
                        rdfs:domain epplan:Variable;
                        rdfs:label "isVariableOfPlan";
                        rdfs:range epplan:Plan;
                        rdfs:subPropertyOf epplan:isElementOfPlan.
epplan:precedes a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                rdfs:comment "Inverse of ep-plan:isPrecededBy.";
                rdfs:domain epplan:Step;
                rdfs:label "precedes";
                rdfs:range epplan:Step.
epplan:qualifiedEvaluation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "ep-plan:qualifiedEvaluation links ep-plan:Constraint to ep-plan:ConstriantEvaluation.";
                           rdfs:domain epplan:Constraint;
                           rdfs:label "qualifiedEvaluation";
                           rdfs:range epplan:ConstraintEvaluation.
epplan:satisfied a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "ep-plan:satisfied links ep-plan:Activity or ep-plan:Communication to a ep-plan:Constraint. The property indicates that the execution trace element satisfied the constraint.";
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                       epplan:Communication) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "satisfied";
                 rdfs:range epplan:Constraint;
                 rdfs:subPropertyOf epplan:evaluatedAgainst;
                 <http://www.w3.org/2002/07/owl#inverseOf> epplan:satisfiedBy.
epplan:satisfiedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Inverse of ep-plan:satisfied.";
                   rdfs:domain epplan:Constraint;
                   rdfs:label "satisfiedBy";
                   rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                        epplan:Communication) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:subPropertyOf epplan:evaluatedFor.
epplan:violated a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "ep-plan:satisfied links ep-plan:Activity or ep-plan:Communication to a ep-plan:Constraint. The property indicates that the execution trace element did not satisfy the constraint.";
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                      epplan:Communication) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "violated";
                rdfs:range epplan:Constraint;
                rdfs:subPropertyOf epplan:evaluatedAgainst;
                <http://www.w3.org/2002/07/owl#inverseOf> epplan:violatedBy.
epplan:violatedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Inverse of ep-plan:violated.";
                  rdfs:domain epplan:Constraint;
                  rdfs:label "violatedBy";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                       epplan:Communication) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf epplan:evaluatedFor.
epplan:wasEvaluatedtraceElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Inverse of ep-plan:evaluatedTraceElement.";
                                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (epplan:Activity
                                                                                      epplan:Communication) ; 
                                             a <http://www.w3.org/2002/07/owl#Class>];
                                rdfs:label "wasEvaluatedTraceElement";
                                rdfs:range epplan:ConstraintEvaluation.
