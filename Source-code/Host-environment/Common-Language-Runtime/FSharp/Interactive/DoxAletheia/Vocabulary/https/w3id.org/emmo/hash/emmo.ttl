                                   owl:hasValue 0e+00 ; 
                                   a owl:Restriction];
                  skos:prefLabel "CoulombMetre"@en;
                  emmo:EMMO_0b1cbe60_d380_4787_b92e_be26bdacf2c2 "A26";
