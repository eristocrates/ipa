emmo:EMMO_4299e344_a321_4ef2_a744_bacfcce80afc a owl:Class;
                                               rdfs:comment """A task is a generic part of a workflow, without taking care of the task granularities.
It means that you can declare that e.g. tightening a bolt is a task of building an airplane, without caring of the coarser tasks to which this tightening belongs."""@en,
                                                            "A procedure that is an hoilistic part of a workflow."@en;
                                               rdfs:isDefinedBy <https://w3id.org/emmo/multiperspective/workflow#>;
                                               rdfs:label "Task"@en;
