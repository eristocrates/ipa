                                               emmo:EMMO_8de5d5bf_db1c_40ac_b698_095ba3b18578 "10-4.3";
                                               emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "1/12 of the mass of an atom of the nuclide 12C in the ground state at rest."@en;
