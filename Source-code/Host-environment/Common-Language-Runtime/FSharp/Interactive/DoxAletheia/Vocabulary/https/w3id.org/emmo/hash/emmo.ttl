emmo:EMMO_70bbb94e_2ca7_4d73_ba01_6397f134d172 a owl:Class;
                                               rdfs:comment "The class for entities which stands for data expressed using a symbolic encoding."@en,
                                                            "A symbolic data is a a data that is rooted on some symbolic based encoding, such as floating point numbers, strings, integer. They are not to be intended as mathematical entities (even if they may be interpreted as such) but as syntactic structures (datastructures or datatypes) based on concatenated tokens (or symbols, letters) that can deliver data."@en;
                                               rdfs:isDefinedBy <https://w3id.org/emmo/multiperspective/symbolic#>;
                                               rdfs:label "SymbolicData"@en;
                                               rdfs:seeAlso "https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps",
                                                            "https://www.w3schools.com/xml/schema_dtypes_numeric.asp",
                                                            "https://www.w3.org/TR/rdf11-concepts/"^^xsd:anyURI,
                                                            "https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes"^^xsd:anyURI;
