                                       owl:hasValue 1e+00 ; 
                                       a owl:Restriction],
                                      emmo:EMMO_1273eb34_de48_43a9_925f_104110469dd2;
                      skos:altLabel "Watt per Steradian"@en;
                      skos:prefLabel "WattPerSteradian"@en;
                      emmo:EMMO_1f1b164d_ec6a_4faa_8d5e_88bda62316cc "http://qudt.org/vocab/unit/W-PER-SR";
                      emmo:EMMO_33ae2d07_5526_4555_a0b4_8f4c031b5652 "W.sr-1";
