                                          <https://w3id.org/emmo/disciplines/units/coherentsiunits#>;
                         rdfs:label "JoulePerSquareTesla"@en;
                         rdfs:seeAlso "http://www.eng.fsu.edu/~dommelen/quantum/style_a/elecmagfld.html";
                         rdfs:subClassOf [owl:onProperty emmo:EMMO_d088a3cb_d3e3_4eb2_9897_00aef0cb00cd ; 
                                          owl:hasValue 0e+00 ; 
