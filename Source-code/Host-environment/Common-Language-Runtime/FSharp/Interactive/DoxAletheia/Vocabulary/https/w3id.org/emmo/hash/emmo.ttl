emmo:EMMO_2553c342_fc28_47d8_8e19_7a98fa08f150 a owl:Class;
                                               rdfs:comment "An object which is an holistic temporal part of another object."@en,
                                                            "Here we consider a temporal interval that is lower than the characteristic time of the physical process that provides the causality connection between the object parts."@en;
                                               rdfs:isDefinedBy <https://w3id.org/emmo/multiperspective/persholistic#>;
                                               rdfs:label "SubObject"@en;
                                               rdfs:subClassOf emmo:EMMO_0e1f2009_bf12_49d1_99f3_1422e5287d82,
                                                               emmo:EMMO_90ae56e4_d197_49b6_be1a_0049e4756606;
                                               skos:example "If an inhabited house is considered as an house that is occupied by some people in its majority of time, then an interval of inhabited house in which occasionally nobody is in there is no more an inhabited house, but an unhinabited house, since this temporal part does not satisfy the criteria of the whole."@en;
                                               skos:prefLabel "SubObject"@en;
                                               emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "An object which is an holistic temporal part of another object."@en.
