                                 [owl:allValuesFrom vas:UAV_LiDAR ; 
                                  owl:onProperty sosa:isHostedBy ; 
                                  a owl:Restriction],
                                 vas:Remote_Sensing_UAVs.
vas:RS_UAV_Microwave a owl:Class;
                     rdfs:comment "Represents the general sensorization of RS_UAV_Microwave. Observes SM."@en;
                     rdfs:subClassOf [owl:hasValue resource:Soil_moisture ; 
                                      owl:onProperty sosa:observes ; 
