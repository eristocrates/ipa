                                   [owl:allValuesFrom vas:MODIS-Terra ; 
                                    owl:onProperty sosa:isHostedBy ; 
                                    a owl:Restriction],
                                   vas:Remote_Sensing_Satellites.
vas:RS_SMAP a owl:Class;
            rdfs:comment "Represents the general sensorization of SMAP. Observes Soil Moisture.";
            rdfs:subClassOf [owl:hasValue resource:Soil_moisture ; 
                             owl:onProperty sosa:observes ; 
                             a owl:Restriction],
                            [owl:allValuesFrom vas:SMAP ; 
                             owl:onProperty sosa:isHostedBy ; 
                             a owl:Restriction],
                            vas:Remote_Sensing_Satellites.
vas:RS_SMOS a owl:Class;
            rdfs:comment "Represents the general sensorization of satellite SMOS. Observes AGB, DroughtIndex, Soil Moisture."@en;
            rdfs:subClassOf [owl:hasValue resource:Soil_moisture ; 
                             owl:onProperty sosa:observes ; 
                             a owl:Restriction],
                            [owl:hasValue resource:Drought ; 
                             owl:onProperty sosa:observes ; 
                             a owl:Restriction],
                            [owl:hasValue <http://codes.wmo.int/grib2/codeflag/4.2/2-0-1> ; 
                             owl:onProperty sosa:observes ; 
                             a owl:Restriction],
                            [owl:hasValue agrovoc:c_1373987580598 ; 
                             owl:onProperty sosa:observes ; 
                             a owl:Restriction],
                            [owl:allValuesFrom vas:SMOS ; 
                             owl:onProperty sosa:isHostedBy ; 
                             a owl:Restriction],
                            vas:Remote_Sensing_Satellites.
vas:RS_Sentinel-1 a owl:Class;
                  rdfs:comment "Represents the general sensorization of satellite Sentinel 1 or S1. Observes Soil Moisture."@en;
                  rdfs:subClassOf [owl:hasValue resource:Soil_moisture ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom vas:Sentinel-1 ; 
                                   owl:onProperty sosa:isHostedBy ; 
                                   a owl:Restriction],
                                  vas:Remote_Sensing_Satellites.
vas:RS_Sentinel-2 a owl:Class;
                  rdfs:comment "Represents the general sensorization of satellite Sentinel 2 or  S2. Observes Chl, EVI, FAPAR, LAI, LandCover, NDVI, SAVI, SR ..."@en;
                  rdfs:subClassOf [owl:hasValue resource:Chlorophyll ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue resource:Soil-adjusted_vegetation_index ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation> ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/normalized_difference_vegetation_index> ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue resource:Enhanced_vegetation_index ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  vas:Remote_Sensing_Satellites,
                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/land_cover_lccs> ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue vas:simple_ratio ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/leaf_area_index> ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom vas:Sentinel-2 ; 
                                   owl:onProperty sosa:isHostedBy ; 
                                   a owl:Restriction].
vas:RS_Sentinel-3_OLCI a owl:Class;
                       rdfs:comment "Represents the general sensorization of satellite Sentinel 3 ( S3)  OLCI. Observes FAPAR , Chl."@en;
                       rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation> ; 
                                        owl:onProperty sosa:observes ; 
