                                                              rdfs:subPropertyOf vas:commonProductProperties.
<http://khaos.uma.es/green-senti/earth-observation#highprobacloudspercentage> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                              rdfs:comment """High proba clouds percentage

Example: 0.232073"""@en;
                                                                              rdfs:domain vas:Sentinel-2_Product;
