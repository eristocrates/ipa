             rdfs:comment "Corine Land Cover (CLC) code."@en;
             rdfs:domain vas:Land_Cover_Classes;
             rdfs:range xsd:integer.
vas:commonProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:label "CommonProperties"@en.
vas:controlArea a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Control Area indicates if it is 1x1 km or 10x10 km in VAS.";
                rdfs:range vas:ControlArea.
vas:coordinatesLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Indicates the coordinates in which the station is located."@en,
                                     "Indica las coordinadas en las que está localizado la estación."@es;
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/sosa/Platform>
                                                                              vas:ControlArea) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:label "Coordinates location"@en;
                        rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                        rdfs:subPropertyOf vas:locatedIn,
                                           <http://www.w3.org/2003/01/geo/wgs84_pos#location>.
vas:file_description a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain vas:SMOS_Product;
                     rdfs:label "File Description";
                     rdfs:subPropertyOf vas:smosProductsProperties.
vas:geo_WGS84 a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
vas:gridMapping a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain vas:SMAP_Product;
                rdfs:label "Grid Mapping"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:smapProductProperties.
vas:groundTrackDirection a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:label "Ground Track Direction";
                         rdfs:range xsd:string;
                         rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:hasObservation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A Snapshot has a satellite observation"@en;
                   rdfs:domain vas:Snapshot;
                   rdfs:range vas:Satellite_Observation;
                   <http://www.w3.org/2002/07/owl#inverseOf> vas:isObservationOf.
vas:hasProduct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Someting (usually a snapshot) has product."@en;
               rdfs:domain vas:Snapshot;
               rdfs:label "has product"@en;
               rdfs:range vas:Satellite_Product.
vas:hasSatelliteSource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "The satellite products have satellite sources"@en;
                       rdfs:domain vas:Satellite_Product;
                       rdfs:range vas:Satellite;
                       rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                       <http://www.w3.org/2002/07/owl#inverseOf> vas:isSatelliteSourceOf.
vas:hasTypeOfCover a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The property indicates the type of cover classes."@en;
                   rdfs:range vas:Land_Cover_Classes.
vas:isObservationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain vas:Satellite_Observation;
                    rdfs:range vas:Snapshot;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
vas:isSatelliteSourceOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain vas:Satellite;
                        rdfs:range vas:Satellite_Product.
vas:landPixels a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:label "Land pixels";
               rdfs:range xsd:decimal;
               rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:landsat8ProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "Landsat 8 product properties"@en;
                              rdfs:domain vas:Landsat-8_Product.
vas:locatedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Indicates the location of the stations."@en,
                           "Indica la localización de las estaciones"@es;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/sosa/Platform>
                                                                    vas:ControlArea) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "Located in"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://schema.org/AdministrativeArea>
                                                                   <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>) ; 
                          a <http://www.w3.org/2002/07/owl#Class>].
vas:locatedInMunicipality a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Indicates the municipality in which a sensor is located."@en,
                                       "Indica el municipio en el que está localizado un sensor."@es;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/sosa/Platform>
                                                                                vas:ControlArea) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:label "Located in municipality"@en;
                          rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>;
                          rdfs:subPropertyOf vas:locatedIn,
                                             <http://www.w3.org/2003/01/geo/wgs84_pos#location>.
vas:locatedInProvince a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Indicates the province in which a sensor is located."@en;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/sosa/Platform>
                                                                            vas:ControlArea) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "Located in province"@en;
                      rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia>;
                      rdfs:subPropertyOf vas:locatedIn,
                                         <http://www.w3.org/2003/01/geo/wgs84_pos#location>.
vas:longName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain vas:SMAP_Product,
                         vas:MODIS-Terra_Product,
                         vas:MODIS-Aqua_Product;
             rdfs:label "Longname"@en;
             rdfs:range xsd:string;
             rdfs:subPropertyOf vas:commonProductProperties.
vas:missingValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain vas:SMAP_Product;
                 rdfs:label "Missing Value";
                 rdfs:range xsd:float;
                 rdfs:subPropertyOf vas:smapProductProperties.
vas:mission a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain vas:SMOS_Product;
            rdfs:label "Mission"@en;
            rdfs:subPropertyOf vas:smosProductsProperties.
vas:modisProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "MODIS Aqua / Terra product properties"@en;
                           rdfs:domain vas:MODIS-Terra_Product,
                                       vas:MODIS-Aqua_Product.
vas:number a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:label "number";
           rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:postList a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:label "Post List"@en;
             rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint>.
vas:precipitable_water_content a vas:Land_Atmosphere_Interaction_Property,
                                 vas:Atmosphere_Property,
                                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
                               rdfs:comment "Precipitable Water Content (PWC) refers to the amount of water vapor present in a vertical column of the Earth's atmosphere. It is typically expressed in terms of thickness or depth, such as millimeters (mm) or inches (inches), and represents the total depth of liquid water that would result if all the water vapor in the column were condensed and collected."@en;
                               rdfs:label "PWC"@en;
                               <http://www.w3.org/ns/sosa/isObservedBy> vas:PWC_METEOSAT_Sensor_1.
vas:productName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:label "Product name";
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:productType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:label "Product type";
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:relativeOrbitNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:label "Relative Orbit Number";
                        rdfs:range xsd:integer;
                        rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:scale_factor a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain vas:MODIS-Terra_Product,
                             vas:MODIS-Aqua_Product;
                 rdfs:label "Scale Factor"@en;
                 rdfs:subPropertyOf vas:modisProductProperties.
vas:sentinel2ProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:comment "Sentinel-2 product properties"@en;
                               rdfs:domain vas:Sentinel-2_Product.
vas:sentinel3ProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:comment "Sentinel-3 product properties"@en;
                               rdfs:domain vas:Sentinel-3_Product.
vas:simple_ratio <http://purl.org/dc/elements/1.1/source> "http://gsp.humboldt.edu/olm/Courses/GSP_216/lessons/Spectral-Enhancements/NDVI.html#:~:text=Simplest%20ratio-based%20index%20is,indicate%20soil%2C%20water%20or%20ice."@en;
                 a vas:Vegetation_Property,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                 rdfs:comment "Simplest ratio-based index is called the Simple Ratio (SR) or Ratio Vegetation Index (RVI). This index is simply the reflectance in the NIR band divided by the reflectance in the red band. A larger SR value indicates healthy vegetation, while lower values indicate soil, water or ice. SR = Near Infrared / Red"@en;
                 rdfs:label "SR"@en;
                 <http://www.w3.org/ns/sosa/isObservedBy> vas:SR_UAV_Multispectral_Sensor_1,
                                                          vas:SR_S2_Sensor_1,
                                                          vas:SR_L9_Sensor_1,
                                                          vas:SR_L8_Sensor_1.
vas:smapProductProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "SMAP product properties"@en;
                          rdfs:domain vas:SMAP_Product.
vas:smosProductsProperties a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "SMOS product properties"@en;
                           rdfs:domain vas:SMOS_Product.
vas:srsName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:label "SRS Name"@en;
            rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint>.
vas:startTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:label "Start time"@en;
              rdfs:range xsd:dateTime;
              rdfs:subPropertyOf vas:acquisitionPeriod.
vas:stopTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:label "Stop time"@en;
             rdfs:range xsd:dateTime;
             rdfs:subPropertyOf vas:acquisitionPeriod.
vas:surface_net_radiation a vas:Radiation_Property,
                            <http://www.w3.org/2002/07/owl#NamedIndividual>;
                          rdfs:comment "Earth's net radiation, sometimes called net flux, is the balance between incoming and outgoing energy at the top of the atmosphere."@en;
                          <http://www.w3.org/ns/sosa/isObservedBy> vas:RN_g_RAD_Sensor_1.
vas:temperature_in_ground_depth_05 a <http://dbpedia.org/resource/Soil_Property>,
                                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                   <http://www.w3.org/2004/02/skos/core#definition> "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                                                    "Subsoil temperature at a depth of 5 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                   <http://www.w3.org/ns/sosa/isObservedBy> vas:Thermometer_AEMET_Sensor_UTIEL.
vas:temperature_in_ground_depth_20 a <http://dbpedia.org/resource/Soil_Property>,
                                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                   <http://www.w3.org/2004/02/skos/core#definition> "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                                                    "Subsoil temperature at a depth of 20 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                   <http://www.w3.org/ns/sosa/isObservedBy> vas:Thermometer_AEMET_Sensor_UTIEL.
vas:temperature_in_ground_next_ground a <http://dbpedia.org/resource/Soil_Property>,
                                        <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                      <http://www.w3.org/2004/02/skos/core#definition> "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                                                       "Ground temperature, instantaneous temperature next to the ground and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                      <http://www.w3.org/ns/sosa/isObservedBy> vas:Thermometer_AEMET_Sensor_UTIEL.
vas:timeliness a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:label "Timeliness";
               rdfs:range xsd:string;
               rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:unit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain vas:SMAP_Product,
                     vas:MODIS-Terra_Product,
                     vas:MODIS-Aqua_Product;
         rdfs:label "Unit"@en;
         rdfs:range xsd:string;
         rdfs:subPropertyOf vas:commonProductProperties.
vas:validMax a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain vas:SMAP_Product;
             rdfs:label "Valid Max"@en;
             rdfs:range xsd:float;
             rdfs:subPropertyOf vas:smapProductProperties.
vas:validMin a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain vas:SMAP_Product;
             rdfs:label "Valid Min"@en;
             rdfs:range xsd:float;
             rdfs:subPropertyOf vas:smapProductProperties.
<https://sws.geonames.org/6361960/> <http://purl.org/dc/elements/1.1/source> "https://sws.geonames.org/";
                                    a <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>,
                                      <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                    rdfs:label "Caudete de las Fuentes".
<https://sws.geonames.org/6362114/> a <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>,
                                      <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                    rdfs:label "Utiel".
<https://www.w3.org/2005/Incubator/ssn/ssnx/meteo/aws#Albedometer> a <http://www.w3.org/2002/07/owl#Class>;
                                                                   rdfs:comment """Sensor that takes \"soil albedo\" measurements in RAD Station"""@en;
                                                                   rdfs:label "SurfaceAlbedo_g";
                                                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> <https://mmisw.org/ont/cf/parameter/soil_albedo> ; 
                                                                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/observes> ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> vas:RAD_Station ; 
                                                                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isHostedBy> ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                   vas:Ground_Based_Sensing.
