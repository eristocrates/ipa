qudt:unitOfSystem a owl:AnnotationProperty.
qudt:wikidataMatch a owl:AnnotationProperty.
qk:Length a owl:NamedIndividual;
          rdfs:comment "Length".
sou:SI a owl:NamedIndividual;
       rdfs:comment "System International of measures."@en.
unit:CentiM dcterms:description "A centimetre is a unit of length in the metric system, equal to one hundredth of a metre, which is the SI base unit of length. Centi is the SI prefix for a factor of $10^{-2}$.  The centimetre is the base unit of length in the now deprecated centimetre-gram-second (CGS) system of units."^^qudt:LatexString;
            qudt:applicableSystem sou:SI;
            qudt:conversionMultiplier 0.01;
            qudt:conversionMultiplierSN "0.01"^^xsd:double;
            qudt:dbpediaMatch "http://dbpedia.org/resource/Centimetre"^^xsd:anyURI;
            qudt:hasQuantityKind qk:Length;
            qudt:iec61360Code "0112/2///62720#UAA375";
            qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA375"^^xsd:anyURI,
                                      "http://en.wikipedia.org/wiki/Centimetre?oldid=494931891"^^xsd:anyURI;
            qudt:scalingOf unit:M;
            qudt:symbol "cm";
            qudt:ucumCode "cm"^^qudt:UCUMcs;
            qudt:uneceCommonCode "CMT";
            qudt:wikidataMatch wikidata:Q174728;
            a qudt:Unit,
              qudt:DerivedUnit,
              owl:NamedIndividual;
            rdfs:comment "A centimetre is a unit of length in the metric system, equal to one hundredth of a metre, which is the SI base unit of length. Centi is the SI prefix for a factor of 10-2 . The centimetre is the base unit of length in the now deprecated centimetre-gram-second (CGS) system of units."@en;
            rdfs:isDefinedBy <http://qudt.org/vocab/unit>;
            rdfs:label "Centimetre"@tr,
                       "Centimetre"@en,
                       "Centiméter"@hu,
                       "Centimetru"@ro,
                       "Centimetro"@it,
                       "Centimeter"@sl,
                       "Centimeter"@ms,
                       "Centimeter"@en-us,
                       "Centimeter"@de,
                       "Centimetr"@pl,
                       "Centimetr"@cs,
                       "Centimètre"@fr.
unit:DEG dcterms:description "A degree (in full, a degree of arc, arc degree, or arcdegree), usually denoted by \\(^\\circ\\) (the degree symbol), is a measurement of plane angle, representing 1/360 of a full rotation; one degree is equivalent to  \\(2\\pi /360 rad\\), \\(0.017453 rad\\). It is not an SI unit, as the SI unit for angles is radian, but is an accepted SI unit."^^qudt:LatexString;
         qudt:conversionMultiplier 0.0174532925;
         qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1;
         qudt:hasQuantityKind qk:Angle;
         qudt:iec61360Code "0112/2///62720#UAA024";
         qudt:informativeReference "http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-331"^^xsd:anyURI;
         qudt:omUnit oum:degree;
         qudt:symbol "°";
         qudt:ucumCode "deg"^^qudt:UCUMcs;
         qudt:udunitsCode "°";
         qudt:uneceCommonCode "DD";
         a qudt:Unit,
           owl:NamedIndividual;
         rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                          <http://qudt.org/vocab/unit>;
         rdfs:label "Degree"@en.
unit:DEG_C dcterms:description "\\(\\textit{Celsius}\\), also known as centigrade, is a scale and unit of measurement for temperature. It can refer to a specific temperature on the Celsius scale as well as a unit to indicate a temperature interval, a difference between two temperatures or an uncertainty. This definition fixes the magnitude of both the degree Celsius and the kelvin as precisely 1 part in 273.16 (approximately 0.00366) of the difference between absolute zero and the triple point of water. Thus, it sets the magnitude of one degree Celsius and that of one kelvin as exactly the same. Additionally, it establishes the difference between the two scales' null points as being precisely \\(273.15\\,^{\\circ}{\\rm C}\\).</p>"^^qudt:LatexString;
           qudt:allowedUnitOfSystem sou:SI;
           qudt:conversionMultiplier 1.0;
           qudt:conversionOffset 273.15;
           qudt:dbpediaMatch "http://dbpedia.org/resource/Celsius"^^xsd:anyURI;
           qudt:expression "\\(degC\\)"^^qudt:LatexString;
           qudt:guidance "<p>See NIST section <a href=http://physics.nist.gov/Pubs/SP811/sec06.html#6.2.8>SP811 section 6.2.8</a></p>"^^rdf:HTML,
                         "<p>See NIST section <a href=http://physics.nist.gov/Pubs/SP811/sec04.html#4.2.1.1>SP811 section 4.2.1.1</a></p>"^^rdf:HTML;
           qudt:hasDimensionVector qkdv:A0E0L0I0M0H1T0D0;
           qudt:hasQuantityKind qk:MeltingPoint,
                                qk:FlashPoint,
                                qk:Temperature,
                                qk:BoilingPoint;
           qudt:iec61360Code "0112/2///62720#UAA033";
           qudt:informativeReference "http://en.wikipedia.org/wiki/Celsius?oldid=494152178"^^xsd:anyURI;
           qudt:latexDefinition "\\(\\,^{\\circ}{\\rm C}\\)"^^qudt:LatexString;
           qudt:omUnit oum:degreeCelsius;
           qudt:symbol "°C";
           qudt:ucumCode "Cel"^^qudt:UCUMcs;
           qudt:udunitsCode "°C",
                            "℃";
           qudt:uneceCommonCode "CEL";
           a owl:NamedIndividual,
             qudt:Unit,
             qudt:DerivedUnit;
           rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                            <http://qudt.org/2.1/vocab/unit>;
           rdfs:label "Degree Celsius"@en;
           skos:altLabel "degree-centigrade".
unit:GM-PER-M3 qudt:conversionMultiplier 0.001;
               qudt:hasDimensionVector qkdv:A0E0L-3I0M1H0T0D0;
               qudt:hasQuantityKind qk:MassDensity;
               qudt:iec61360Code "0112/2///62720#UAA487";
               qudt:plainTextDescription "0,001-fold of the SI base unit kilogram divided by the power of the SI base unit metre with the exponent 3";
               qudt:symbol "g/m³";
               qudt:ucumCode "g/m3"^^qudt:UCUMcs,
                             "g.m-3"^^qudt:UCUMcs;
               qudt:uneceCommonCode "A93";
               a qudt:Unit,
                 owl:NamedIndividual;
               rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                                <http://qudt.org/2.1/vocab/unit>;
               rdfs:label "Gram Per Cubic Meter"@en-us,
                          "Gram Per Cubic Metre"@en.
unit:HR dcterms:description "The hour (common symbol: h or hr) is a unit of measurement of time. In modern usage, an hour comprises 60 minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted for use with SI, represented by the symbol h."^^rdf:HTML;
        qudt:applicableSystem sou:SI,
                              sou:IMPERIAL,
                              sou:USCS;
        qudt:conversionMultiplier 3600.0;
        qudt:dbpediaMatch "http://dbpedia.org/resource/Hour"^^xsd:anyURI;
        qudt:definedUnitOfSystem sou:USCS;
        qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T1D0;
        qudt:hasQuantityKind qk:Time;
        qudt:iec61360Code "0112/2///62720#UAA525";
        qudt:informativeReference "http://en.wikipedia.org/wiki/Hour?oldid=495040268"^^xsd:anyURI;
        qudt:omUnit oum:hour;
        qudt:symbol "hr";
        qudt:ucumCode "h"^^qudt:UCUMcs;
        qudt:udunitsCode "h";
        qudt:uneceCommonCode "HUR";
        a owl:NamedIndividual,
          qudt:Unit;
        rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                         <http://qudt.org/vocab/unit>;
        rdfs:label "Hour"@en.
unit:HectoPA dcterms:description "Hectopascal is a unit of pressure. 1 Pa is approximately the pressure exerted by a 10-g mass resting on a 1-cm2 area. 1013 hPa = 1 atm. There are 100 pascals in 1 hectopascal."^^rdf:HTML;
             qudt:applicableSystem sou:SI;
             qudt:conversionMultiplier 100.0;
             qudt:exactMatch unit:MilliBAR;
             qudt:hasDimensionVector qkdv:A0E0L-1I0M1H0T-2D0;
             qudt:hasQuantityKind qk:ForcePerArea,
                                  qk:ModulusOfElasticity,
                                  qk:VaporPressure;
             qudt:iec61360Code "0112/2///62720#UAA527";
             qudt:symbol "hPa";
             qudt:ucumCode "hPa"^^qudt:UCUMcs;
             qudt:uneceCommonCode "A97";
             a qudt:Unit,
               owl:NamedIndividual,
               qudt:DerivedUnit;
             rdfs:comment "Hectopascal is commonly used in meteorology to report values for atmospheric pressure. It is equivalent to millibar.";
             rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                              <http://qudt.org/vocab/unit>;
             rdfs:label "Hectopascal"@en.
unit:KiloPA dcterms:description "Kilopascal is a unit of pressure. 1 kPa is approximately the pressure exerted by a 10-g mass resting on a 1-cm2 area. 101.3 kPa = 1 atm. There are 1,000 pascals in 1 kilopascal."^^rdf:HTML;
            qudt:allowedUnitOfSystem sou:SI;
            qudt:conversionMultiplier 1000.0;
            qudt:dbpediaMatch "http://dbpedia.org/resource/Pascal_%28unit%29"^^xsd:anyURI;
            qudt:hasDimensionVector qkdv:A0E0L-1I0M1H0T-2D0;
            qudt:hasQuantityKind qk:VaporPressure,
                                 qk:ForcePerArea;
            qudt:iec61360Code "0112/2///62720#UAA575";
            qudt:isScalingOf unit:PA;
            qudt:symbol "kPa";
            qudt:ucumCode "kPa"^^qudt:UCUMcs;
            qudt:uneceCommonCode "KPA";
            qudt:unitOfSystem sou:SI;
            a qudt:Unit,
              qudt:DerivedUnit,
              owl:NamedIndividual;
            rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                             <http://qudt.org/2.1/vocab/unit>;
            rdfs:label "Kilopascal"@en.
unit:M dcterms:description "The metric and SI base unit of distance.  The 17th General Conference on Weights and Measures in 1983 defined the meter as that distance that makes the speed of light in a vacuum equal to exactly 299 792 458 meters per second. The speed of light in a vacuum, \\(c\\), is one of the fundamental constants of nature. The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches."^^qudt:LatexString;
       qudt:conversionMultiplier 1.0;
       qudt:dbpediaMatch "http://dbpedia.org/resource/Metre"^^xsd:anyURI;
       qudt:definedUnitOfSystem sou:SI;
       qudt:hasQuantityKind qk:Length;
       qudt:iec61360Code "0112/2///62720#UAA726";
       qudt:informativeReference "http://en.wikipedia.org/wiki/Metre?oldid=495145797"^^xsd:anyURI;
       qudt:isUnitOfSystem sou:SI;
       qudt:omUnit oum:metre;
       qudt:plainTextDescription "The metric and SI base unit of distance.   The meter is equal to approximately 1.093 613 3 yards, 3.280 840 feet, or 39.370 079 inches.";
       qudt:symbol "m";
       qudt:ucumCode "m"^^qudt:UCUMcs;
       qudt:udunitsCode "m";
       qudt:uneceCommonCode "MTR";
       a qudt:Unit,
         owl:NamedIndividual;
       rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                        <http://qudt.org/2.1/vocab/unit>;
       rdfs:label "Metre"@en,
                  "Meter"@en-us.
unit:M-PER-SEC dcterms:description """Metre per second is an SI derived unit of both speed (scalar) and velocity (vector quantity which specifies both magnitude and a specific direction), defined by distance in metres divided by time in seconds.
The official SI symbolic abbreviation is mu00b7s-1, or equivalently either m/s."""^^rdf:HTML;
               qudt:conversionMultiplier 1.0;
               qudt:definedUnitOfSystem sou:SI;
               qudt:derivedCoherentUnitOfSystem sou:SI;
               qudt:expression "\\(m/s\\)"^^qudt:LatexString;
               qudt:hasDimensionVector qkdv:A0E0L1I0M0H0T-1D0;
               qudt:hasQuantityKind qk:Velocity,
                                    qk:ElectromagneticWavePhaseSpeed,
                                    qk:Speed;
               qudt:iec61360Code "0112/2///62720#UAA733";
               qudt:symbol "m/s";
               qudt:ucumCode "m.s-1"^^qudt:UCUMcs,
                             "m/s"^^qudt:UCUMcs;
               qudt:uneceCommonCode "MTS";
               a qudt:Unit,
                 qudt:DerivedUnit,
                 owl:NamedIndividual;
               rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                                <http://qudt.org/2.1/vocab/unit>;
               rdfs:label "Meter per Second"@en-us,
                          "Metre per Second"@en.
unit:M3-PER-M3 qudt:conversionMultiplier 1.0;
               qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1;
               qudt:hasQuantityKind qk:VolumeFraction;
               qudt:iec61360Code "0112/2///62720#UAA767";
               qudt:isUnitOfSystem sou:SI;
               qudt:plainTextDescription "power of the SI base unit metre with the exponent 3 divided by the power of the SI base unit metre with the exponent 3";
               qudt:symbol "m³/m³";
               qudt:ucumCode "m3.m-3"^^qudt:UCUMcs;
               qudt:uneceCommonCode "H60";
               a owl:NamedIndividual,
                 qudt:Unit;
               rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                                <http://qudt.org/2.1/vocab/unit>;
               rdfs:label "Cubic Meter Per Cubic Meter"@en-us,
                          "Cubic Metre Per Cubic Metre"@en.
unit:MicroG-PER-CentiM2 qudt:conversionMultiplier "0.01"^^xsd:double;
                        qudt:conversionOffset "0.0"^^xsd:double;
                        qudt:hasDimensionVector qkdv:A0E0L-2I0M1H0T0D0;
                        qudt:hasQuantityKind qk:MassPerArea;
                        qudt:plainTextDescription "A unit of mass per area, equivalent to 0.01 grammes per square metre";
                        qudt:symbol "µg/cm²";
                        a qudt:Unit,
                          owl:NamedIndividual;
                        rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                                         <http://qudt.org/2.1/vocab/unit>;
                        rdfs:label "Microgram per square centimetre"@en.
unit:MicroMOL-PER-M2 dcterms:description "One part per 10**6 (million) of the SI unit of quantity of matter (the mole) per SI unit area."@en;
                     qudt:conversionMultiplier 0.000001;
                     qudt:hasDimensionVector qkdv:A1E0L-2I0M0H0T0D0;
                     qudt:symbol "µmol/m²";
                     qudt:ucumCode "umol.m-2"^^qudt:UCUMcs,
                                   "umol/m2"^^qudt:UCUMcs;
                     a qudt:Unit,
                       owl:NamedIndividual;
                     rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                                      <http://qudt.org/2.1/vocab/unit>;
                     rdfs:label "Micromoles per square metre"@en.
unit:MilliGM-PER-GM qudt:conversionMultiplier 0.001;
                    qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1;
                    qudt:hasQuantityKind qk:MassRatio;
                    qudt:iec61360Code "0112/2///62720#UAA822";
                    qudt:isUnitOfSystem sou:SI;
                    qudt:plainTextDescription "0.000001-fold of the SI base unit kilogram divided by the 0.001-fold of the SI base unit kilogram";
                    qudt:qkdvDenominator qkdv:A0E0L0I0M1H0T0D0;
                    qudt:qkdvNumerator qkdv:A0E0L0I0M1H0T0D0;
                    qudt:symbol "mg/gm";
                    qudt:ucumCode "mg.g-1"^^qudt:UCUMcs,
                                  "mg/g"^^qudt:UCUMcs;
                    qudt:uneceCommonCode "H64";
                    a owl:NamedIndividual,
                      qudt:Unit;
                    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                                     <http://qudt.org/vocab/unit>;
                    rdfs:label "Milligram Per Gram"@en.
unit:MilliGM-PER-HA qudt:conversionMultiplier 0.0000000001;
                    qudt:hasDimensionVector qkdv:A0E0L-2I0M1H0T0D0;
                    qudt:hasQuantityKind qk:MassPerArea;
                    qudt:iec61360Code "0112/2///62720#UAA818";
                    qudt:isUnitOfSystem sou:SI;
                    qudt:plainTextDescription "0.000001-fold of the SI base unit kilogram divided by the 10,0000-fold of the power of the SI base unit metre with the exponent 2";
                    qudt:ucumCode "mg.har-1"^^qudt:UCUMcs;
                    a qudt:Unit,
                      owl:NamedIndividual;
                    rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                                     <http://qudt.org/vocab/unit>;
                    rdfs:label "Milligram Per Hectare"@en.
unit:MilliGM-PER-M2-SEC qudt:conversionMultiplier 0.000001;
                        qudt:hasDimensionVector qkdv:A0E0L-2I0M1H0T-1D0;
                        qudt:hasQuantityKind qk:MassPerAreaTime;
                        qudt:symbol "mg/(m²⋅s)";
                        qudt:ucumCode "mg.m-2.s-1"^^qudt:UCUMcs;
                        a owl:NamedIndividual,
                          qudt:Unit;
                        rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                                         <http://qudt.org/vocab/unit>;
                        rdfs:label "Milligrams per square metre per second"@en.
unit:MilliM dcterms:description "The millimetre (International spelling as used by the International Bureau of Weights and Measures) or millimeter (American spelling) (SI unit symbol mm) is a unit of length in the metric system, equal to one thousandth of a metre, which is the SI base unit of length. It is equal to 1000 micrometres or 1000000 nanometres. A millimetre is equal to exactly 5/127 (approximately 0.039370) of an inch."^^rdf:HTML;
            qudt:applicableSystem sou:SI;
            qudt:conversionMultiplier 0.001;
            qudt:dbpediaMatch "http://dbpedia.org/resource/Millimetre"^^xsd:anyURI;
            qudt:expression "\\(mm\\)"^^qudt:LatexString;
            qudt:hasQuantityKind qk:Length;
            qudt:iec61360Code "0112/2///62720#UAA862";
            qudt:informativeReference "http://en.wikipedia.org/wiki/Millimetre?oldid=493032457"^^xsd:anyURI;
            qudt:isUnitOfSystem sou:SI;
            qudt:prefix <http://qudt.org/vocab/prefix/Milli>;
            qudt:symbol "mm";
            qudt:ucumCode "mm"^^qudt:UCUMcs;
            qudt:uneceCommonCode "MMT";
            a qudt:DerivedUnit,
              owl:NamedIndividual,
              qudt:Unit;
            rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                             <http://qudt.org/vocab/unit>;
            rdfs:label "Millimetre"@en,
                       "Millimeter"@en-us;
            skos:altLabel "mil"@en-gb.
unit:NUM dcterms:description "Number is a unit for  'Dimensionless' expressed as (\\#\\)."^^rdf:HTML;
         qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1;
         qudt:hasQuantityKind qk:TotalAngularMomentumQuantumNumber,
                              qk:HyperfineStructureQuantumNumber,
                              qk:ChargeNumber,
                              qk:OrbitalAngularMomentumQuantumNumber,
                              qk:Landau-GinzburgNumber,
                              qk:NuclearSpinQuantumNumber,
                              qk:SpinQuantumNumber,
                              qk:ReynoldsNumber,
                              qk:Dimensionless,
                              qk:NeutronNumber,
                              qk:PrincipalQuantumNumber,
                              qk:FrictionCoefficient,
                              qk:MassNumber,
                              qk:NucleonNumber,
                              qk:IonTransportNumber,
                              qk:QuantumNumber,
                              qk:DimensionlessRatio,
                              qk:MagneticQuantumNumber,
                              qk:Population,
                              qk:StoichiometricNumber;
         qudt:symbol "#";
         qudt:ucumCode "1"^^qudt:UCUMcs,
                       "{#}"^^qudt:UCUMcs;
         a qudt:Unit,
           qudt:CountingUnit,
           owl:NamedIndividual;
         rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                          <http://qudt.org/2.1/vocab/unit>;
         rdfs:label "Number"@en.
unit:PERCENT_RH dcterms:description "Percent relative humidity is the ratio of the partial pressure of water vapor to the equilibrium vapor pressure of water at a given temperature, expressed as a percentage."^^rdf:HTML;
                qudt:applicableSystem sou:PLANCK,
                                      sou:CGS-ESU,
                                      sou:SI,
                                      sou:IMPERIAL,
                                      sou:ASU;
                qudt:conversionMultiplier 0.01;
                qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1;
                qudt:hasQuantityKind qk:RelativeHumidity;
                qudt:plainTextDescription "Percent relative humidity is the ratio of the partial pressure of water vapor to the equilibrium vapor pressure of water at a given temperature, expressed as a percentage.";
                qudt:symbol "%RH";
                a qudt:Unit,
                  owl:NamedIndividual;
                rdfs:isDefinedBy <http://qudt.org/2.1/vocab/unit>,
                                 <http://qudt.org/vocab/unit>;
                rdfs:label "Percent Relative Humidity"@en.
unit:W-PER-M2 dcterms:description "Watt per Square Meter} is a unit of irradiance defined as the power received per area. This is a unit in the category of Energy flux. It is also known as watts per square meter, watt per square metre, watts per square metre, watt/square meter, watt/square metre. This unit is commonly used in the SI unit system. Watt Per Square Meter (\\(W/m^2\\)) has a dimension of \\(MT^{-3\\) where M is mass, and T is time. This unit is the standard SI unit in this category."^^qudt:LatexString;
              qudt:conversionMultiplier 1.0;
              qudt:definedUnitOfSystem sou:SI;
              qudt:derivedCoherentUnitOfSystem sou:SI;
              qudt:expression "\\(W/m^2\\)"^^qudt:LatexString;
              qudt:hasDimensionVector qkdv:A0E0L0I0M1H0T-3D0;
              qudt:hasQuantityKind qk:PowerPerArea,
                                   qk:PoyntingVector;
              qudt:iec61360Code "0112/2///62720#UAA310";
              qudt:informativeReference "http://www.efunda.com/glossary/units/units--energy_flux--watt_per_square_meter.cfm"^^xsd:anyURI;
              qudt:symbol "W/m²";
              qudt:ucumCode "W.m-2"^^qudt:UCUMcs,
                            "W/m2"^^qudt:UCUMcs;
              qudt:uneceCommonCode "D54";
              a owl:NamedIndividual,
                qudt:DerivedUnit,
                qudt:Unit;
              rdfs:isDefinedBy <http://qudt.org/vocab/unit>,
                               <http://qudt.org/2.1/vocab/unit>;
              rdfs:label "Watt per Square Metre"@en,
                         "Watt per Square Meter"@en-us.
schema:AdministrativeArea dc11:source "Catálogo de Objetos Geográficos BTN100 where the official encoding associated is represented by the codigoINE property and its geometry is represented by the geosparql: hasGeometry property."@en;
                          a owl:Class;
                          rdfs:comment "“La Unión Europea entiende como unidades administrativas aquellas áreas donde los Estados miembros tienen o ejercen sus derechos jurisdiccionales a efectos de administración local, regional y nacional. Están separadas mediante límites administrativos y frecuentemente están organizadas jerárquicamente, reflejando los distintos grados de responsabilidad implicados” [INSPIRE ANEXO 1.Tema 4]. Definen las áreas de cada municipio o condominio, provincia, comunidad autónoma y nación española."@es,
                                       "The European Union understands administrative units as those areas where the Member States have or exercise their jurisdictional rights for the purposes of local, regional and national administration. They are separated by administrative boundaries and are frequently organized hierarchically, reflecting the different degrees of responsibility involved ”[INSPIRE ANNEX 1. Topic 4]. They define the areas of each municipality or condominium, province, autonomous community and Spanish nation."@en;
                          rdfs:isDefinedBy "https://datos.ign.es/def/btn100"@en;
                          rdfs:label "AdministrativeUnit"@en;
                          rdfs:subClassOf [owl:allValuesFrom xsd:string ; 
                                           owl:onProperty esadm:codigoINE ; 
                                           a owl:Restriction],
                                          [owl:allValuesFrom xsd:string ; 
                                           owl:onProperty dcterms:title ; 
                                           a owl:Restriction].
schema:domainIncludes a owl:AnnotationProperty.
schema:rangeIncludes a owl:AnnotationProperty.
esadm:Autonomia a owl:Class;
                rdfs:comment "Uniprovincial or multiprovincial entity with specific territorial limits within the kingdom of Spain, which is endowed with legislative autonomy and executive powers in everything that is not common with the rest of the State."@en,
                             "Autonomía (Comunidad Autónoma o Ciudad Autónoma) a la que pertenece un fenómeno geográfico o una entidad administrativa"@es,
                             "Autonomy (Autonomous Community or Autonomous City) to which a geographical phenomenon or an administrative entity belongs"@en;
                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                rdfs:label "Autonomy"@en;
                rdfs:subClassOf schema:AdministrativeArea.
esadm:CiudadAutonoma a owl:Class;
                     rdfs:comment "Autonomous City to which a geographical phenomenon or an administrative entity belongs"@en;
                     rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                     rdfs:label "Autonomous City"@en;
                     rdfs:subClassOf esadm:Autonomia.
esadm:ComunidadAutonoma a owl:Class;
                        rdfs:comment "Autonomous Community to which a geographical phenomenon or an administrative entity belongs"@en;
                        rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                        rdfs:label "Autonomous Community"@en;
                        rdfs:subClassOf esadm:Autonomia.
esadm:ComunidadJurisdiccional a owl:Class;
                              rdfs:comment "Jurisdictional Community"@en;
                              rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                              rdfs:label "Jurisdictional Community"@en;
                              rdfs:subClassOf schema:AdministrativeArea.
esadm:Municipio a owl:Class;
                rdfs:comment "Un municipio es una entidad administrativa que puede agrupar una sola localidad o varias, puede hacer referencia a una ciudad o un pueblo."@es,
                             "A municipality is an administrative entity that can group a single locality or several, it can refer to a city or a town."@en;
                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                rdfs:label "Municipality"@en;
                rdfs:subClassOf schema:AdministrativeArea.
esadm:Pais a owl:Class;
           rdfs:comment "Un país  es un territorio con características geográficas y culturales propias, que puede o no constituir un Estado soberano o una entidad política dentro de un Estado. También es utilizado como sinónimo de Estado, conjunto de instituciones políticas dotadas de territorio, población y soberanía."@es,
                        "A country is a territory with its own geographical and cultural characteristics, which may or may not constitute a sovereign State or a political entity within a State. It is also used as a synonym for State, a set of political institutions endowed with territory, population and sovereignty."@en;
           rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
           rdfs:label "Country"@en;
           rdfs:subClassOf schema:AdministrativeArea.
esadm:Provincia a owl:Class;
                rdfs:comment "Una provincia es una entidad subnacional del Estado"@es,
                             "In Spain, < regionName >  in Tpeg Location or < administrativeArea > in Location ReferencePoint"@en,
                             "A province is a subnational entity of the State"@en;
                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>;
                rdfs:label "Province"@en;
                rdfs:subClassOf schema:AdministrativeArea.
esadm:codigoINE a owl:DatatypeProperty;
                rdfs:comment "Coding assigned by the INE Nomenclature"@en;
                rdfs:isDefinedBy "http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"@es;
                rdfs:label "code INE"@en;
                rdfs:range rdfs:Literal.
geosparql:Feature dc11:contributor "Matthew Perry";
                  dc11:creator "OGC GeoSPARQL 1.0 Standard Working Group";
                  dc11:date "2011-06-16"^^xsd:date;
                  dc11:description """
      This class represents the top-level feature type. This class is 
      equivalent to GFI_Feature defined in ISO 19156:2011, and it is 
      superclass of all feature types.
    """@en;
                  a owl:Class;
                  rdfs:comment """
      This class represents the top-level feature type. This class is 
      equivalent to GFI_Feature defined in ISO 19156:2011, and it is 
      superclass of all feature types.
    """@en;
                  rdfs:isDefinedBy <http://www.opengis.net/ont/gml>,
                                   <http://www.opengis.net/ont/geosparql>,
                                   <http://www.opengis.net/spec/geosparql/1.0>;
                  rdfs:label "Feature"@en;
                  rdfs:subClassOf geosparql:SpatialObject;
                  owl:disjointWith geosparql:Geometry;
                  skos:definition """
      This class represents the top-level feature type. This class is 
      equivalent to GFI_Feature defined in ISO 19156:2011, and it is 
      superclass of all feature types.
    """@en;
                  skos:prefLabel "Feature"@en.
geosparql:Geometry dc11:contributor "Matthew Perry";
