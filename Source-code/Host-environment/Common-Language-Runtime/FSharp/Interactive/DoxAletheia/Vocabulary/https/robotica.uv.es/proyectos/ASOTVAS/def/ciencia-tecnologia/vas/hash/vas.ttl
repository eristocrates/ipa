vas:Temperature_in_air_AEMET_Observation a owl:Class;
                                         rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/air_temperature> ; 
                                                          owl:onProperty sosa:observedProperty ; 
