vas:Ground_Station a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Ground Station is defined as a physical platform located on the Earth’s surface that hosts one or more sensors used to perform in-situ environmental observations."@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onClass> vas:Land_Cover_Classes ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> vas:hasTypeOfCover ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onClass> vas:ControlArea ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> vas:controlArea ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://www.w3.org/ns/sosa/Platform>.
vas:Ground_based_Observation a <http://www.w3.org/2002/07/owl#Class>;
