                                                                     rdfs:domain vas:Sentinel-2_Product;
                                                                     rdfs:label "Link to product"@en;
                                                                     rdfs:range xsd:anyURI;
                                                                     rdfs:subPropertyOf vas:sentinel2ProductProperties.
<http://khaos.uma.es/green-senti/earth-observation#mapprojection> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
