                   dc11:date "2011-06-16"^^xsd:date;
                   dc11:description """
      (true) if this geometric object has no anomalous geometric 
      points, such as self intersection or self tangency.
    """@en;
                   a owl:DatatypeProperty;
                   rdfs:comment """
