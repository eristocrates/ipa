                                                sosa:isObservedBy vas:Roughness_SMOS_CATDS_Sensor_1.
<http://datos.gob.es/recurso/sector-publico/territorio/Autonomia/Comunitat-Valenciana> a esadm:ComunidadAutonoma,
                                                                                         owl:NamedIndividual;
                                                                                       rdfs:label "Comunitat Valenciana".
<http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia> dc11:source "http://datos.gob.es/recurso/sector-publico/territorio/Provincia/";
                                                                           a esadm:Provincia,
