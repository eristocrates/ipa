                                                owl:onProperty sosa:madeBySensor ; 
                                                a owl:Restriction],
                                               vas:EVI_Satellite_Observation.
vas:EVI_MODIS-Terra_Observation a owl:Class;
                                rdfs:comment "Sensor that takes Enhanced Vegetation Index (EVI) measurements from MODIS-Terra.",
                                             "Daily temporality, 500 m resolution, product MYD09GA_006_EVI",
                                             "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en;
                                rdfs:subClassOf [owl:allValuesFrom vas:RS_MODIS-Terra ; 
                                                 owl:onProperty sosa:madeBySensor ; 
                                                 a owl:Restriction],
                                                vas:EVI_Satellite_Observation.
vas:EVI_Result a owl:Class;
               rdfs:comment "Result that is normally obtained by Enhanced Vegetation Index (EVI) sensors. Dimensionless."@en;
               rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                owl:onProperty qudt:numericValue ; 
                                a owl:Restriction],
                               [owl:hasValue unit:NUM ; 
                                owl:onProperty qudt:unit ; 
                                a owl:Restriction],
                               sosa:Result.
vas:EVI_S2_Observation a owl:Class;
                       rdfs:comment "Sensor that takes EVI measurements from Sentinel-2.",
                                    "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en;
                       rdfs:subClassOf [owl:allValuesFrom vas:RS_Sentinel-2 ; 
                                        owl:onProperty sosa:madeBySensor ; 
