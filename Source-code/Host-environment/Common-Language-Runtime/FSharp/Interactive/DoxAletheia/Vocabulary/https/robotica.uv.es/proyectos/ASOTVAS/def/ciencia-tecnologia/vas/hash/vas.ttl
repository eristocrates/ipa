vas:Precipitation_AEMET_Result a owl:Class;
                               rdfs:comment "Result that is normally obtained by Pluviometer_AEMET sensors in AEMET Staion. Unit of measure Millimetre (mm)."@en;
                               rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                                owl:onProperty qudt:numericValue ; 
                                                a owl:Restriction],
                                               [owl:hasValue unit:MilliM ; 
                                                owl:onProperty qudt:unit ; 
                                                a owl:Restriction],
                                               sosa:Result.
vas:RAD_Station a owl:Class;
                rdfs:comment "Class that represents solar radiation stations"@en;
                rdfs:label "RAD_Station"@en;
                rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (vas:I_dif_g
                                                                 vas:I_dir_g
                                                                 vas:LW_down_g
                                                                 vas:LW_up_g
                                                                 vas:RN_g
                                                                 vas:SW_down_g
                                                                 vas:SW_up_g
                                                                 <https://www.w3.org/2005/Incubator/ssn/ssnx/meteo/aws#Albedometer>) ; 
                                                    a owl:Class] ; 
                                 owl:onProperty sosa:hosts ; 
                                 a owl:Restriction],
                                vas:Ground_Station.
vas:RAD_Station_1 geosparql:hasGeometry vas:GeoRADStation1;
                  a vas:RAD_Station,
                    owl:NamedIndividual;
                  rdfs:comment "RAD Station number 1"@en;
                  sosa:hosts vas:SurfaceAlbedo_g_RAD_Sensor_1,
                             vas:SW_down_g_RAD_Sensor_1,
                             vas:I_dif_g_RAD_Sensor_1,
                             vas:LW_up_g_RAD_Sensor_1,
                             vas:LW_down_g_RAD_Sensor_1,
                             vas:I_dir_g_RAD_Sensor_1,
                             vas:RN_g_RAD_Sensor_1,
                             vas:SW_up_g_RAD_Sensor_1;
                  vas:controlArea vas:1km_x_1km;
                  vas:hasTypeOfCover vas:Bare_Soils;
                  vas:locatedInMunicipality <https://sws.geonames.org/6361960/>;
                  vas:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia>.
vas:RN_g a owl:Class;
         rdfs:comment """Sensor that takes \"surface net radiation\" measurements in RAD Station"""@en;
         rdfs:subClassOf [owl:hasValue vas:surface_net_radiation ; 
                          owl:onProperty sosa:observes ; 
                          a owl:Restriction],
                         [owl:allValuesFrom vas:RAD_Station ; 
                          owl:onProperty sosa:isHostedBy ; 
                          a owl:Restriction],
                         vas:Ground_Based_Sensing.
vas:RN_g_RAD_Sensor_1 a vas:RN_g,
                        owl:NamedIndividual;
                      rdfs:comment "RN_g_RAD Sensor hosted by RAD_Station_1"@en;
                      sosa:isHostedBy vas:RAD_Station_1;
                      sosa:observes vas:surface_net_radiation.
vas:RS_Landsat-8 a owl:Class;
                 rdfs:comment "Represents the general sensorization of satellite Landsat-8. Observes Chl, EVI, FAPAR, LAI, LST, NDVI, ,SAVI, SR, TDVI ..."@en;
                 rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/leaf_area_index> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/normalized_difference_vegetation_index> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue vas:simple_ratio ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue resource:Enhanced_vegetation_index ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_temperature> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue resource:Soil-adjusted_vegetation_index ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue resource:Chlorophyll ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 vas:Remote_Sensing_Satellites,
                                 [owl:allValuesFrom vas:Landsat-8 ; 
                                  owl:onProperty sosa:isHostedBy ; 
                                  a owl:Restriction].
vas:RS_Landsat-9 a owl:Class;
                 rdfs:comment "Represents the general sensorization of satellite Lansat-9.Observes Chl, EVI, FAPAR, LAI, LST, NDVI, ,SAVI, SR, TDVI ..."@en;
                 rdfs:subClassOf [owl:hasValue resource:Enhanced_vegetation_index ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue resource:Soil-adjusted_vegetation_index ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue vas:simple_ratio ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/leaf_area_index> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_temperature> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 vas:Remote_Sensing_Satellites,
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue <https://mmisw.org/ont/cf/parameter/normalized_difference_vegetation_index> ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:hasValue resource:Chlorophyll ; 
                                  owl:onProperty sosa:observes ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom vas:Landsat-9 ; 
                                  owl:onProperty sosa:isHostedBy ; 
                                  a owl:Restriction].
vas:RS_METEOSAT a owl:Class;
                rdfs:comment "Represents the general sensorization of satellite METEOSAT. Observes CloudMask, CloudType and PWC."@en;
                rdfs:subClassOf [owl:hasValue vas:precipitable_water_content ; 
                                 owl:onProperty sosa:observes ; 
                                 a owl:Restriction],
                                [owl:hasValue vas:cloud_type ; 
                                 owl:onProperty sosa:observes ; 
                                 a owl:Restriction],
                                [owl:hasValue vas:cloud_mask ; 
                                 owl:onProperty sosa:observes ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom vas:METEOSAT ; 
                                 owl:onProperty sosa:isHostedBy ; 
                                 a owl:Restriction],
                                vas:Remote_Sensing_Satellites.
vas:RS_MODIS-Aqua a owl:Class;
                  rdfs:comment "Represents the general sensorization of satellite MODIS-Aqua. Observes EVI , FAPAR, LST, NDVI, ..."@en;
                  rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_temperature> ; 
                                   owl:onProperty sosa:observes ; 
                                   a owl:Restriction],
                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/normalized_difference_vegetation_index> ; 
