                                       <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Velocity>,
                                                                                     <http://qudt.org/vocab/quantitykind/ElectromagneticWavePhaseSpeed>,
                                                                                     <http://qudt.org/vocab/quantitykind/Speed>;
                                       <http://qudt.org/schema/qudt/iec61360Code> "0112/2///62720#UAA733";
                                       <http://qudt.org/schema/qudt/symbol> "m/s";
                                       <http://qudt.org/schema/qudt/ucumCode> "m.s-1"^^<http://qudt.org/schema/qudt/UCUMcs>,
                                                                              "m/s"^^<http://qudt.org/schema/qudt/UCUMcs>;
                                       <http://qudt.org/schema/qudt/uneceCommonCode> "MTS";
