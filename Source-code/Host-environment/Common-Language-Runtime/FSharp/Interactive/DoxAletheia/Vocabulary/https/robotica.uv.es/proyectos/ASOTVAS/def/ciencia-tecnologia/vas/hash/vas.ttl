                   rdfs:comment "A Ground Station is defined as a physical platform located on the Earth’s surface that hosts one or more sensors used to perform in-situ environmental observations."@en;
                   rdfs:subClassOf [owl:onClass vas:Land_Cover_Classes ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty vas:hasTypeOfCover ; 
                                    a owl:Restriction],
                                   [owl:onClass vas:ControlArea ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty vas:controlArea ; 
                                    a owl:Restriction],
                                   sosa:Platform.
vas:Ground_based_Observation a owl:Class;
                             rdfs:comment "Observation collected in situ."@en;
                             rdfs:subClassOf sosa:Observation.
