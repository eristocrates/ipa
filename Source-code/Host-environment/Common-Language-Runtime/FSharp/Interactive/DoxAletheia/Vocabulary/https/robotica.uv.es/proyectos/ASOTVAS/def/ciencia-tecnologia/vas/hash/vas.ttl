vas:Satellite a owl:Class;
              rdfs:label "Satellite"@en;
              rdfs:subClassOf sosa:Platform.
vas:Satellite_Observation a owl:Class;
                          rdfs:comment "Observation collected by satellite."@en;
                          rdfs:subClassOf [owl:onClass vas:Image_Result ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty sosa:hasResult ; 
                                           a owl:Restriction],
                                          sosa:Observation.
vas:Satellite_Product a owl:Class;
                      rdfs:comment "A Satellite Product is a processed dataset generated from raw satellite measurements, typically including radiometric, geometric, and atmospheric corrections. These products provide georeferenced environmental variables (e.g., reflectance, vegetation indices, land surface temperature, soil moisture) at defined spatial, temporal, and spectral resolutions, and serve as inputs for environmental monitoring, modelling, and validation workflows."@en;
                      rdfs:label "Satellite Product"@en;
                      rdfs:subClassOf [owl:someValuesFrom vas:ControlArea ; 
                                       owl:onProperty vas:controlArea ; 
                                       a owl:Restriction],
                                      geosparql:Feature;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:intersectionOf ([owl:someValuesFrom xsd:dateTime ; 
                                                               owl:onProperty sosa:resultTime ; 
                                                               a owl:Restriction]
                                                               [owl:allValuesFrom xsd:dateTime ; 
                                                               owl:onProperty sosa:resultTime ; 
                                                               a owl:Restriction])],
                                          [a owl:Class ; 
                                           owl:intersectionOf ([owl:someValuesFrom vas:Satellite ; 
                                                               owl:onProperty vas:hasSatelliteSource ; 
                                                               a owl:Restriction]
                                                               [owl:allValuesFrom vas:Satellite ; 
                                                               owl:onProperty vas:hasSatelliteSource ; 
                                                               a owl:Restriction])];
                      skos:example "Examples include NDVI, FAPAR, LST, or surface reflectance products obtained from Sentinel-2, Sentinel-3, Landsat, or other EO missions."@en.
vas:Sclerophyllous_vegetation a vas:Land_Cover_Classes,
                                owl:NamedIndividual;
                              rdfs:comment "Class Level 3 CORINE Land Cover - CLC"@en;
                              rdfs:label "Sclerophyllous vegetation"@en;
                              vas:code_CLC 321 .
vas:Sensible_Heat_Flux_Observation a owl:Class;
                                   rdfs:comment "Class that represents observations related to Sensible heat flux (W/m2)."@en;
                                   rdfs:subClassOf [owl:onClass vas:Sensible_Heat_Flux_Result ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty sosa:hasResult ; 
                                                    a owl:Restriction],
                                                   [owl:hasValue <https://mmisw.org/ont/mmi/usglobec/heat_flux_sens> ; 
                                                    owl:onProperty sosa:observedProperty ; 
                                                    a owl:Restriction],
                                                   [owl:allValuesFrom vas:Hs_g ; 
                                                    owl:onProperty sosa:madeBySensor ; 
                                                    a owl:Restriction],
                                                   [owl:unionOf ([owl:hasValue resource:Atmosphere_of_Earth ; 
                                                                 owl:onProperty sosa:hasFeatureOfInterest ; 
                                                                 a owl:Restriction]
                                                                 [owl:hasValue resource:Soil ; 
                                                                 owl:onProperty sosa:hasFeatureOfInterest ; 
