vas:SM_Observation a owl:Class;
                   rdfs:comment "Class that represents observations related to Soil Moisture (SM). Unit of measure Cubic Metre per Cubic Metre."@en;
                   rdfs:subClassOf [owl:onClass vas:SM_Result ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty sosa:hasResult ; 
                                    a owl:Restriction],
                                   [owl:hasValue resource:Soil_moisture ; 
                                    owl:onProperty sosa:observedProperty ; 
                                    a owl:Restriction],
                                   [owl:hasValue resource:Soil ; 
                                    owl:onProperty sosa:hasFeatureOfInterest ; 
                                    a owl:Restriction],
                                   [owl:allValuesFrom vas:SM_g ; 
                                    owl:onProperty sosa:madeBySensor ; 
                                    a owl:Restriction],
                                   vas:Ground_based_Observation.
vas:SM_Result a owl:Class;
              rdfs:comment "Result that is normally obtained by SM (Soil Moisture) sensors. Unit of measure Cubic Metre per Cubic Metre."@en;
              rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                               owl:onProperty qudt:numericValue ; 
                               a owl:Restriction],
                              [owl:hasValue unit:M3-PER-M3 ; 
                               owl:onProperty qudt:unit ; 
                               a owl:Restriction],
                              sosa:Result.
