vas:RS_UAV_RGB a owl:Class;
               rdfs:comment "Represents the general sensorization of RS_UAV_RGB. Observes  ORTHOPHOTO"@en;
               rdfs:subClassOf [owl:hasValue resource:Orthophoto ; 
                                owl:onProperty sosa:observes ; 
                                a owl:Restriction],
                               [owl:allValuesFrom vas:UAV_RGB ; 
                                owl:onProperty sosa:isHostedBy ; 
                                a owl:Restriction],
                               vas:Remote_Sensing_UAVs.
vas:RS_UAV_Thermal a owl:Class;
                   rdfs:comment "Represents the general sensorization of RS_UAV_Thermal. Observes  LST."@en;
                   rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_temperature> ; 
                                    owl:onProperty sosa:observes ; 
                                    a owl:Restriction],
                                   [owl:allValuesFrom vas:UAV_Thermal ; 
                                    owl:onProperty sosa:isHostedBy ; 
                                    a owl:Restriction],
                                   vas:Remote_Sensing_UAVs.
vas:Radiation_Property a owl:Class;
                       rdfs:comment "Class that represents all Radiation properties"@en;
                       rdfs:subClassOf sosa:ObservableProperty.
vas:Remote_Sensing_Satellites a owl:Class;
                              rdfs:comment "Satellite  Sensors (remote sensing)."@en;
                              rdfs:subClassOf sosa:Sensor.
vas:Remote_Sensing_UAVs a owl:Class;
                        rdfs:comment "Drone Sensors (remote sensing)."@en;
                        rdfs:subClassOf sosa:Sensor.
vas:Roughness_SMOS_CATDS_Sensor_1 a vas:RS_SMOS,
                                    owl:NamedIndividual;
                                  rdfs:comment "Roughness_SMOS_CATDS Sensor hosted by SMOS Product_1"@en;
                                  sosa:isHostedBy vas:SMOS_Product_1;
                                  sosa:observes <http://codes.wmo.int/grib2/codeflag/4.2/2-0-1>.
vas:SAVI_L8_Observation a owl:Class;
                        rdfs:comment "Sensor that takes SAVI measurements from Landsat-8.",
                                     "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI)."@en;
                        rdfs:subClassOf [owl:allValuesFrom vas:RS_Landsat-8 ; 
                                         owl:onProperty sosa:madeBySensor ; 
                                         a owl:Restriction],
                                        vas:SAVI_Satellite_Observation.
vas:SAVI_L8_Sensor_1 a vas:RS_Landsat-8,
                       owl:NamedIndividual;
                     rdfs:comment "SAVI_L8 Sensor hosted by Landsat-8 Product_1"@en;
                     sosa:isHostedBy vas:Landsat-8_Product_1;
                     sosa:observes resource:Soil-adjusted_vegetation_index.
vas:SAVI_L9_Observation a owl:Class;
                        rdfs:comment "Sensor that takes SAVI measurements from Landsat-9.",
                                     "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI)."@en;
                        rdfs:subClassOf [owl:allValuesFrom vas:RS_Landsat-9 ; 
                                         owl:onProperty sosa:madeBySensor ; 
                                         a owl:Restriction],
                                        vas:SAVI_Satellite_Observation.
vas:SAVI_L9_Sensor_1 a vas:RS_Landsat-9,
                       owl:NamedIndividual;
                     rdfs:comment "SAVI_L9 Sensor hosted by Landsat-9 Product_1"@en;
                     sosa:isHostedBy vas:Landsat-9_Product_1;
                     sosa:observes resource:Soil-adjusted_vegetation_index.
vas:SAVI_Result a owl:Class;
                rdfs:comment "Result that is normally obtained by Soil Adjusted Vegetation Index (SAVI) sensors.  Dimensionless."@en;
                rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                 owl:onProperty qudt:numericValue ; 
                                 a owl:Restriction],
                                [owl:hasValue unit:NUM ; 
                                 owl:onProperty qudt:unit ; 
                                 a owl:Restriction],
                                sosa:Result.
vas:SAVI_S2_Observation a owl:Class;
                        rdfs:comment "Sensor that takes SAVI measurements from Sentinel-2.",
                                     "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI)."@en;
                        rdfs:subClassOf [owl:allValuesFrom vas:RS_Sentinel-2 ; 
                                         owl:onProperty sosa:madeBySensor ; 
                                         a owl:Restriction],
                                        vas:SAVI_Satellite_Observation.
vas:SAVI_S2_Sensor_1 a vas:RS_Sentinel-2,
                       owl:NamedIndividual;
                     rdfs:comment "SAVI_S2_Sensor hosted by Sentinel-2 Product_1"@en;
                     sosa:isHostedBy vas:Sentinel-2_Product_1;
                     sosa:observes resource:Soil-adjusted_vegetation_index.
vas:SAVI_Satellite_Observation a owl:Class;
                               rdfs:comment "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI). Dimensionless."@en;
                               rdfs:subClassOf [owl:onClass vas:SAVI_Result ; 
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onProperty sosa:hasResult ; 
                                                a owl:Restriction],
                                               [owl:hasValue resource:Soil-adjusted_vegetation_index ; 
                                                owl:onProperty sosa:observedProperty ; 
                                                a owl:Restriction],
                                               [owl:hasValue resource:Vegetation ; 
                                                owl:onProperty sosa:hasFeatureOfInterest ; 
                                                a owl:Restriction],
                                               vas:Satellite_Observation.
vas:SAVI_UAV_Multispectral_Sensor_1 a vas:RS_UAV_Multispectral,
                                      owl:NamedIndividual;
                                    rdfs:comment "Sensor SAVI UAV Multispectral hosted by UAV Multispectral 1."@en;
                                    sosa:isHostedBy vas:UAV_Multispectral_1;
                                    sosa:observes resource:Soil-adjusted_vegetation_index.
vas:SAVI_UAV_Observation a owl:Class;
                         rdfs:comment "Class that represents observations related to Soil Adjusted Vegetation Index (SAVI).  Dimensionless."@en;
                         rdfs:subClassOf [owl:onClass vas:SAVI_Result ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty sosa:hasResult ; 
                                          a owl:Restriction],
                                         [owl:hasValue resource:Soil-adjusted_vegetation_index ; 
                                          owl:onProperty sosa:observedProperty ; 
                                          a owl:Restriction],
                                         [owl:hasValue resource:Vegetation ; 
                                          owl:onProperty sosa:hasFeatureOfInterest ; 
                                          a owl:Restriction],
                                         [owl:allValuesFrom vas:RS_UAV_Multispectral ; 
                                          owl:onProperty sosa:madeBySensor ; 
                                          a owl:Restriction],
                                         vas:UAV_Observation.
vas:SMAP a owl:Class;
         rdfs:label "SMAP"@en;
