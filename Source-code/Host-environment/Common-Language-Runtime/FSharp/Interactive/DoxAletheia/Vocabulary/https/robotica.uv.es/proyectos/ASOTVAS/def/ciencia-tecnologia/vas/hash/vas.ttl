                                                                  rdfs:label "Map projection"@en;
                                                                  rdfs:range xsd:string;
                                                                  rdfs:subPropertyOf vas:landsat8ProductProperties.
<http://khaos.uma.es/green-senti/earth-observation#orbitdirection> a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                                                                     <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                                   rdfs:comment """Orbit direccion while taking he product

