                    sosa:isHostedBy vas:Landsat-9_Product_1;
                    sosa:observes resource:Enhanced_vegetation_index.
vas:EVI_MODIS-Aqua_Observation a owl:Class;
                               rdfs:comment "Sensor that takes Enhanced Vegetation Index (EVI) measurements from MODIS-Aqua.",
                                            "Daily temporality, resolution 500 m, product MYD09GA_006_EVI",
                                            "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en;
