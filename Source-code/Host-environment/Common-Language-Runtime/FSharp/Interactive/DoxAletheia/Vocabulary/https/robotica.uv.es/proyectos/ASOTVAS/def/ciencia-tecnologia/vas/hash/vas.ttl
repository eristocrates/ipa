                                        [owl:allValuesFrom vas:Sentinel-3_SLSTR ; 
                                         owl:onProperty sosa:isHostedBy ; 
                                         a owl:Restriction],
                                        vas:Remote_Sensing_Satellites.
vas:RS_UAV_Hyperspectral a owl:Class;
                         rdfs:comment "Represents the general sensorization of RS_UAV_Hyperspectral. Observes  NRI,  CRI, NDWI, AGB. DiseaseStatus."@en;
                         rdfs:subClassOf [owl:hasValue vas:Normalized_Difference_Water_Index ; 
