vas:Nitrogen_Reflectance_Index a vas:Vegetation_Property,
                                 owl:NamedIndividual;
                               rdfs:comment "The Nitrogen Reflectance Index (NRI) is a spectral index designed to estimate the nitrogen status of vegetation using reflectance measurements in the visible region. It exploits the sensitivity of chlorophyll‐related absorption features to nitrogen concentration."@en;
                               rdfs:label "NRI"@en.
