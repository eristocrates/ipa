                                sosa:isHostedBy vas:AEMET_UTIEL_Station;
                                sosa:observes <https://mmisw.org/ont/cf/parameter/wind_from_direction>.
vas:WindVane_EddyCovariance a owl:Class;
                            rdfs:comment "Sensor belongs to EddyCovariance Station.  Sensor that takes wind direction  [0º-360º]  measurements."@en;
                            rdfs:label "WindVane_EddyCovariance"@en;
                            rdfs:subClassOf [owl:allValuesFrom vas:EddyCovariance_Station ; 
                                             owl:onProperty sosa:isHostedBy ; 
                                             a owl:Restriction],
                                            aws:WindVane.
vas:WindVane_EddyCovariance_Sensor_1 a vas:WindVane_EddyCovariance,
                                       owl:NamedIndividual;
                                     rdfs:comment "Sensor WindVane_EddyCovariance hosted by EddyCovariance_Station_1"@en;
                                     sosa:isHostedBy vas:EddyCovariance_Station_1;
                                     sosa:observes <https://mmisw.org/ont/cf/parameter/wind_from_direction>.
vas:Wind_Direction_AEMET_Observation a owl:Class;
                                     rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en;
                                     rdfs:subClassOf [owl:allValuesFrom vas:WindVane_AEMET ; 
                                                      owl:onProperty sosa:madeBySensor ; 
                                                      a owl:Restriction],
                                                     vas:Wind_Direction_Observation.
vas:Wind_Direction_EddyCovariance_Observation a owl:Class;
                                              rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en;
                                              rdfs:subClassOf [owl:allValuesFrom vas:WindVane_AEMET ; 
                                                               owl:onProperty sosa:madeBySensor ; 
                                                               a owl:Restriction],
                                                              vas:Wind_Direction_Observation.
vas:Wind_Direction_Observation a owl:Class;
                               rdfs:comment "Class that represents observations related to wind direction. Angle Degree."@en;
                               rdfs:subClassOf [owl:onClass vas:Wind_Direction_Result ; 
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onProperty sosa:hasResult ; 
                                                a owl:Restriction],
                                               [owl:hasValue <https://mmisw.org/ont/cf/parameter/wind_from_direction> ; 
                                                owl:onProperty sosa:observedProperty ; 
                                                a owl:Restriction],
                                               [owl:hasValue resource:Air ; 
                                                owl:onProperty sosa:hasFeatureOfInterest ; 
                                                a owl:Restriction],
                                               vas:Ground_based_Observation.
vas:Wind_Direction_Result a owl:Class;
                          rdfs:comment "Result that is normally obtained by WindVane sensors. Unit of measure Angle Degree."@en;
                          rdfs:subClassOf [owl:someValuesFrom xsd:nonNegativeInteger ; 
                                           owl:onProperty qudt:numericValue ; 
                                           a owl:Restriction],
                                          [owl:hasValue unit:DEG ; 
                                           owl:onProperty qudt:unit ; 
                                           a owl:Restriction],
                                          sosa:Result.
vas:Wind_Speed_AEMET_Observation a owl:Class;
                                 rdfs:comment "Class that represents observations related to wind speed in AEMET Station. (m/s)"@en;
                                 rdfs:subClassOf [owl:allValuesFrom <http://aemet.linkeddata.es/ontology/Anemometer> ; 
                                                  owl:onProperty sosa:madeBySensor ; 
                                                  a owl:Restriction],
                                                 vas:Wind_Speed_Observation.
vas:Wind_Speed_EddyCovariance_Observation a owl:Class;
                                          rdfs:comment "Class that represents observations related to wind speed in EddyCovariance Station. (m/s)"@en;
                                          rdfs:subClassOf [owl:allValuesFrom vas:Anemometer_EddyCovariance ; 
                                                           owl:onProperty sosa:madeBySensor ; 
                                                           a owl:Restriction],
                                                          vas:Wind_Speed_Observation.
vas:Wind_Speed_Observation a owl:Class;
                           rdfs:comment "Class that represents observations related to wind speed. (m/s)"@en;
                           rdfs:subClassOf [owl:onClass vas:Wind_Speed_Result ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty sosa:hasResult ; 
                                            a owl:Restriction],
                                           [owl:hasValue <https://mmisw.org/ont/cf/parameter/wind_speed> ; 
                                            owl:onProperty sosa:observedProperty ; 
                                            a owl:Restriction],
                                           [owl:hasValue resource:Air ; 
                                            owl:onProperty sosa:hasFeatureOfInterest ; 
                                            a owl:Restriction],
                                           vas:Ground_based_Observation.
vas:Wind_Speed_Result a owl:Class;
                      rdfs:comment "Result that is normally obtained by Anemometer sensors. Unit of measure Metre per Second (m/s)."@en;
                      rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                       owl:onProperty qudt:numericValue ; 
                                       a owl:Restriction],
                                      [owl:hasValue unit:M-PER-SEC ; 
                                       owl:onProperty qudt:unit ; 
                                       a owl:Restriction],
                                      sosa:Result.
vas:abbreviation a owl:DatatypeProperty;
                 rdfs:label "Abbreviation"@en;
                 rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#filename>.
vas:acquisitionPeriod a owl:DatatypeProperty;
                      rdfs:label "Adquisition Period";
                      rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:cloud_mask a vas:Atmosphere_Property,
                 owl:NamedIndividual;
               rdfs:comment """A 'cloud mask' in remote sensing refers to a technique or dataset used to identify and delineate areas covered by clouds in an image captured from a satellite or other observation platform. This technique is crucial in remote sensing as clouds can obstruct visibility of the Earth's surface, making it challenging to interpret images and analyze data.\""""@en;
               sosa:isObservedBy vas:CloudMask_METEOSAT_Sensor_1.
vas:cloud_type a vas:Atmosphere_Property,
                 owl:NamedIndividual;
               rdfs:comment """\"'Cloud type' in remote sensing refers to the classification or categorization of clouds based on their visual characteristics and structural features observed in satellite or aerial imagery."""@en;
               sosa:isObservedBy vas:CloudType_METEOSAT_Sensor_1.
vas:cloudyPixels a owl:DatatypeProperty;
                 rdfs:label "Cloudy pixels";
                 rdfs:range xsd:decimal;
                 rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:code_CLC a owl:DatatypeProperty;
             rdfs:comment "Corine Land Cover (CLC) code."@en;
             rdfs:domain vas:Land_Cover_Classes;
             rdfs:range xsd:integer.
vas:commonProductProperties a owl:DatatypeProperty;
                            rdfs:label "CommonProperties"@en.
vas:controlArea a owl:ObjectProperty;
                rdfs:comment "Control Area indicates if it is 1x1 km or 10x10 km in VAS.";
                rdfs:range vas:ControlArea.
vas:coordinatesLocation a owl:ObjectProperty;
                        rdfs:comment "Indicates the coordinates in which the station is located."@en,
                                     "Indica las coordinadas en las que está localizado la estación."@es;
                        rdfs:domain [owl:unionOf (sosa:Platform
                                                  vas:ControlArea) ; 
                                     a owl:Class];
                        rdfs:label "Coordinates location"@en;
                        rdfs:range wgspos:SpatialThing;
                        rdfs:subPropertyOf vas:locatedIn,
                                           wgspos:location.
vas:file_description a owl:DatatypeProperty;
                     rdfs:domain vas:SMOS_Product;
                     rdfs:label "File Description";
                     rdfs:subPropertyOf vas:smosProductsProperties.
vas:geo_WGS84 a owl:DatatypeProperty.
vas:gridMapping a owl:DatatypeProperty;
                rdfs:domain vas:SMAP_Product;
                rdfs:label "Grid Mapping"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:smapProductProperties.
vas:groundTrackDirection a owl:DatatypeProperty;
                         rdfs:label "Ground Track Direction";
                         rdfs:range xsd:string;
                         rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:hasObservation a owl:ObjectProperty;
                   rdfs:comment "A Snapshot has a satellite observation"@en;
                   rdfs:domain vas:Snapshot;
                   rdfs:range vas:Satellite_Observation;
                   owl:inverseOf vas:isObservationOf.
vas:hasProduct a owl:ObjectProperty;
               rdfs:comment "Someting (usually a snapshot) has product."@en;
               rdfs:domain vas:Snapshot;
               rdfs:label "has product"@en;
               rdfs:range vas:Satellite_Product.
vas:hasSatelliteSource a owl:ObjectProperty;
                       rdfs:comment "The satellite products have satellite sources"@en;
                       rdfs:domain vas:Satellite_Product;
                       rdfs:range vas:Satellite;
                       rdfs:subPropertyOf owl:topObjectProperty;
                       owl:inverseOf vas:isSatelliteSourceOf.
vas:hasTypeOfCover a owl:ObjectProperty;
                   rdfs:comment "The property indicates the type of cover classes."@en;
                   rdfs:range vas:Land_Cover_Classes.
vas:isObservationOf a owl:ObjectProperty;
                    rdfs:domain vas:Satellite_Observation;
                    rdfs:range vas:Snapshot;
                    rdfs:subPropertyOf owl:topObjectProperty.
vas:isSatelliteSourceOf a owl:ObjectProperty;
                        rdfs:domain vas:Satellite;
                        rdfs:range vas:Satellite_Product.
vas:landPixels a owl:DatatypeProperty;
               rdfs:label "Land pixels";
               rdfs:range xsd:decimal;
               rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:landsat8ProductProperties a owl:DatatypeProperty;
                              rdfs:comment "Landsat 8 product properties"@en;
                              rdfs:domain vas:Landsat-8_Product.
vas:locatedIn a owl:ObjectProperty;
              rdfs:comment "Indicates the location of the stations."@en,
                           "Indica la localización de las estaciones"@es;
              rdfs:domain [owl:unionOf (sosa:Platform
                                        vas:ControlArea) ; 
                           a owl:Class];
              rdfs:label "Located in"@en;
              rdfs:range [owl:unionOf (schema:AdministrativeArea
                                       wgspos:SpatialThing) ; 
                          a owl:Class].
vas:locatedInMunicipality a owl:ObjectProperty;
                          rdfs:comment "Indicates the municipality in which a sensor is located."@en,
                                       "Indica el municipio en el que está localizado un sensor."@es;
                          rdfs:domain [owl:unionOf (sosa:Platform
                                                    vas:ControlArea) ; 
                                       a owl:Class];
                          rdfs:label "Located in municipality"@en;
                          rdfs:range esadm:Municipio;
                          rdfs:subPropertyOf vas:locatedIn,
                                             wgspos:location.
vas:locatedInProvince a owl:ObjectProperty;
                      rdfs:comment "Indicates the province in which a sensor is located."@en;
                      rdfs:domain [owl:unionOf (sosa:Platform
                                                vas:ControlArea) ; 
                                   a owl:Class];
                      rdfs:label "Located in province"@en;
                      rdfs:range esadm:Provincia;
                      rdfs:subPropertyOf vas:locatedIn,
                                         wgspos:location.
vas:longName a owl:DatatypeProperty;
             rdfs:domain vas:SMAP_Product,
                         vas:MODIS-Terra_Product,
                         vas:MODIS-Aqua_Product;
             rdfs:label "Longname"@en;
             rdfs:range xsd:string;
             rdfs:subPropertyOf vas:commonProductProperties.
vas:missingValue a owl:DatatypeProperty;
                 rdfs:domain vas:SMAP_Product;
                 rdfs:label "Missing Value";
                 rdfs:range xsd:float;
                 rdfs:subPropertyOf vas:smapProductProperties.
vas:mission a owl:DatatypeProperty;
            rdfs:domain vas:SMOS_Product;
            rdfs:label "Mission"@en;
            rdfs:subPropertyOf vas:smosProductsProperties.
vas:modisProductProperties a owl:DatatypeProperty;
                           rdfs:comment "MODIS Aqua / Terra product properties"@en;
                           rdfs:domain vas:MODIS-Terra_Product,
                                       vas:MODIS-Aqua_Product.
vas:number a owl:DatatypeProperty;
           rdfs:label "number";
           rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:postList a owl:DatatypeProperty;
             rdfs:label "Post List"@en;
             rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint>.
vas:precipitable_water_content a vas:Land_Atmosphere_Interaction_Property,
                                 vas:Atmosphere_Property,
                                 owl:NamedIndividual;
                               rdfs:comment "Precipitable Water Content (PWC) refers to the amount of water vapor present in a vertical column of the Earth's atmosphere. It is typically expressed in terms of thickness or depth, such as millimeters (mm) or inches (inches), and represents the total depth of liquid water that would result if all the water vapor in the column were condensed and collected."@en;
                               rdfs:label "PWC"@en;
                               sosa:isObservedBy vas:PWC_METEOSAT_Sensor_1.
vas:productName a owl:DatatypeProperty;
                rdfs:label "Product name";
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:productType a owl:DatatypeProperty;
                rdfs:label "Product type";
                rdfs:range xsd:string;
                rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:relativeOrbitNumber a owl:DatatypeProperty;
                        rdfs:label "Relative Orbit Number";
                        rdfs:range xsd:integer;
                        rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:scale_factor a owl:DatatypeProperty;
                 rdfs:domain vas:MODIS-Terra_Product,
                             vas:MODIS-Aqua_Product;
                 rdfs:label "Scale Factor"@en;
                 rdfs:subPropertyOf vas:modisProductProperties.
vas:sentinel2ProductProperties a owl:DatatypeProperty;
                               rdfs:comment "Sentinel-2 product properties"@en;
                               rdfs:domain vas:Sentinel-2_Product.
vas:sentinel3ProductProperties a owl:DatatypeProperty;
                               rdfs:comment "Sentinel-3 product properties"@en;
                               rdfs:domain vas:Sentinel-3_Product.
vas:simple_ratio dc11:source "http://gsp.humboldt.edu/olm/Courses/GSP_216/lessons/Spectral-Enhancements/NDVI.html#:~:text=Simplest%20ratio-based%20index%20is,indicate%20soil%2C%20water%20or%20ice."@en;
                 a vas:Vegetation_Property,
                   owl:NamedIndividual;
                 rdfs:comment "Simplest ratio-based index is called the Simple Ratio (SR) or Ratio Vegetation Index (RVI). This index is simply the reflectance in the NIR band divided by the reflectance in the red band. A larger SR value indicates healthy vegetation, while lower values indicate soil, water or ice. SR = Near Infrared / Red"@en;
                 rdfs:label "SR"@en;
                 sosa:isObservedBy vas:SR_UAV_Multispectral_Sensor_1,
                                   vas:SR_S2_Sensor_1,
                                   vas:SR_L9_Sensor_1,
                                   vas:SR_L8_Sensor_1.
vas:smapProductProperties a owl:DatatypeProperty;
                          rdfs:comment "SMAP product properties"@en;
                          rdfs:domain vas:SMAP_Product.
vas:smosProductsProperties a owl:DatatypeProperty;
                           rdfs:comment "SMOS product properties"@en;
                           rdfs:domain vas:SMOS_Product.
vas:srsName a owl:DatatypeProperty;
            rdfs:label "SRS Name"@en;
            rdfs:subPropertyOf <http://khaos.uma.es/green-senti/earth-observation#footprint>.
vas:startTime a owl:DatatypeProperty;
              rdfs:label "Start time"@en;
              rdfs:range xsd:dateTime;
              rdfs:subPropertyOf vas:acquisitionPeriod.
vas:stopTime a owl:DatatypeProperty;
             rdfs:label "Stop time"@en;
             rdfs:range xsd:dateTime;
             rdfs:subPropertyOf vas:acquisitionPeriod.
vas:surface_net_radiation a vas:Radiation_Property,
                            owl:NamedIndividual;
                          rdfs:comment "Earth's net radiation, sometimes called net flux, is the balance between incoming and outgoing energy at the top of the atmosphere."@en;
                          sosa:isObservedBy vas:RN_g_RAD_Sensor_1.
vas:temperature_in_ground_depth_05 a resource:Soil_Property,
                                     owl:NamedIndividual;
                                   skos:definition "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                   "Subsoil temperature at a depth of 5 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                   sosa:isObservedBy vas:Thermometer_AEMET_Sensor_UTIEL.
vas:temperature_in_ground_depth_20 a resource:Soil_Property,
                                     owl:NamedIndividual;
                                   skos:definition "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                   "Subsoil temperature at a depth of 20 cm and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                   sosa:isObservedBy vas:Thermometer_AEMET_Sensor_UTIEL.
vas:temperature_in_ground_next_ground a resource:Soil_Property,
                                        owl:NamedIndividual;
                                      skos:definition "The temperature at any given depth (or in a layer) below the surface of the ground, excluding surficial snow and ice (but not permafrost or soil). For temperatures in surface lying snow and ice, the more specific standard names temperature_in_surface_snow and land_ice_temperature should be used. For temperatures measured or modelled specifically for the soil layer (the near-surface layer where plants sink their roots) the standard name soil_temperature should be used."@en,
                                                      "Ground temperature, instantaneous temperature next to the ground and corresponding to the 10 minutes prior to the date given by 'fint' (degrees Celsius)"@en;
                                      sosa:isObservedBy vas:Thermometer_AEMET_Sensor_UTIEL.
vas:timeliness a owl:DatatypeProperty;
               rdfs:label "Timeliness";
               rdfs:range xsd:string;
               rdfs:subPropertyOf vas:sentinel3ProductProperties.
vas:unit a owl:DatatypeProperty;
         rdfs:domain vas:SMAP_Product,
                     vas:MODIS-Terra_Product,
                     vas:MODIS-Aqua_Product;
         rdfs:label "Unit"@en;
         rdfs:range xsd:string;
         rdfs:subPropertyOf vas:commonProductProperties.
vas:validMax a owl:DatatypeProperty;
             rdfs:domain vas:SMAP_Product;
             rdfs:label "Valid Max"@en;
             rdfs:range xsd:float;
             rdfs:subPropertyOf vas:smapProductProperties.
vas:validMin a owl:DatatypeProperty;
             rdfs:domain vas:SMAP_Product;
             rdfs:label "Valid Min"@en;
             rdfs:range xsd:float;
             rdfs:subPropertyOf vas:smapProductProperties.
<https://sws.geonames.org/6361960/> dc11:source "https://sws.geonames.org/";
                                    a esadm:Municipio,
