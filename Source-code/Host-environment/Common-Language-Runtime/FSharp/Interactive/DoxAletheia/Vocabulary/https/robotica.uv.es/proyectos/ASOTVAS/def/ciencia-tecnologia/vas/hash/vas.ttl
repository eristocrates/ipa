                                         [owl:allValuesFrom vas:UAV_Hyperspectral ; 
                                          owl:onProperty sosa:isHostedBy ; 
                                          a owl:Restriction],
                                         vas:Remote_Sensing_UAVs.
vas:RS_UAV_LiDAR a owl:Class;
                 rdfs:comment "Represents the general sensorization of RS_UAV_LiDAR. Observes  CHM, DTM, DSM. DBH, AGB."@en;
                 rdfs:subClassOf [owl:hasValue vas:Digital_Terrain_Model ; 
