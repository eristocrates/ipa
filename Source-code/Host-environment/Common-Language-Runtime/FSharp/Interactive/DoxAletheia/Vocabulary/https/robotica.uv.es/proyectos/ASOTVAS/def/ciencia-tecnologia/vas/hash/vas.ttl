vas:EVI_S2_Sensor_1 a vas:RS_Sentinel-2,
                      owl:NamedIndividual;
                    rdfs:comment "EVI_S2 Sensor hosted by Sentinel-2 Product_1"@en;
                    sosa:isHostedBy vas:Sentinel-2_Product_1;
                    sosa:observes resource:Enhanced_vegetation_index.
vas:EVI_Satellite_Observation a owl:Class;
                              rdfs:comment "Class that represents observations related to Enhanced Vegetation Index (EVI). Dimensionless."@en;
                              rdfs:subClassOf [owl:onClass vas:EVI_Result ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty sosa:hasResult ; 
                                               a owl:Restriction],
                                              [owl:hasValue resource:Enhanced_vegetation_index ; 
                                               owl:onProperty sosa:observedProperty ; 
                                               a owl:Restriction],
                                              [owl:unionOf ([owl:hasValue resource:Soil ; 
                                                            owl:onProperty sosa:hasFeatureOfInterest ; 
                                                            a owl:Restriction]
                                                            [owl:hasValue resource:Vegetation ; 
                                                            owl:onProperty sosa:hasFeatureOfInterest ; 
                                                            a owl:Restriction]) ; 
                                               a owl:Class],
                                              vas:Satellite_Observation.
vas:EVI_UAV_Multispectral_Sensor_1 a vas:RS_UAV_Multispectral,
                                     owl:NamedIndividual;
                                   rdfs:comment "Sensor EVI UAV Multispectral hosted by UAV Multispectral 1."@en;
                                   sosa:isHostedBy vas:UAV_Multispectral_1;
                                   sosa:observes resource:Enhanced_vegetation_index.
vas:EVI_UAV_Observation a owl:Class;
                        rdfs:comment "Class that represents observations related to Enhanced Vegetation Index (EVI). DImensionless."@en;
                        rdfs:subClassOf [owl:onClass vas:EVI_Result ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
