vas:Temperature_in_ground_depth_20_AEMET_Observation a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> vas:temperature_in_ground_depth_20 ; 
