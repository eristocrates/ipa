vas:Temperature_in_ground_next_ground_AEMET_Observation a <http://www.w3.org/2002/07/owl#Class>;
                                                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> vas:temperature_in_ground_next_ground ; 
