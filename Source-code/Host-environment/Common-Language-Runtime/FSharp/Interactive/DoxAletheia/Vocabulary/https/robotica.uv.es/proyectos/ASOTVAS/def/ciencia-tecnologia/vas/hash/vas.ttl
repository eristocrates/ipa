vas:DHP_Station a owl:Class;
                rdfs:comment "Class that represents Digital Hemispheric Picture (DHP) stations"@en;
                rdfs:label "DHP_Station"@en;
                rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (vas:FAPAR_dhp
                                                                 vas:FCOVER_dhp
                                                                 vas:LAI_dhp) ; 
                                                    a owl:Class] ; 
                                 owl:onProperty sosa:hosts ; 
                                 a owl:Restriction],
                                vas:Ground_Station.
vas:DHP_Station_1 geosparql:hasGeometry vas:GeoDHPStation1;
                  a owl:NamedIndividual,
                    vas:DHP_Station;
                  rdfs:comment "DHP Station number 1"@en;
                  sosa:hosts vas:FCOVER_dhp_Sensor_1,
                             vas:FAPAR_dhp_Sensor_1,
                             vas:LAI_dhp_Sensor_1;
                  vas:controlArea vas:1km_x_1km;
                  vas:hasTypeOfCover vas:Vineyards;
                  vas:locatedInMunicipality <https://sws.geonames.org/6361960/>;
                  vas:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia>.
vas:DHP_Station_2 geosparql:hasGeometry vas:GeoDHPStation2;
                  a owl:NamedIndividual,
                    vas:DHP_Station;
                  rdfs:comment "DHP Station number 2"@en;
                  sosa:hosts vas:LAI_dhp_Sensor_2,
                             vas:FAPAR_dhp_Sensor_2,
                             vas:FCOVER_dhp_Sensor_2;
                  vas:controlArea vas:1km_x_1km;
                  vas:hasTypeOfCover <https://robotica.uv.es/proyectos/ASOTVAS/def/ciencia-tecnologia/vas#Fruit_trees_and_berry_plantations_(olive,_almond)>;
                  vas:locatedInMunicipality <https://sws.geonames.org/6361960/>;
                  vas:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia>.
vas:DHP_Station_3 geosparql:hasGeometry vas:GeoDHPStation3;
                  a owl:NamedIndividual,
                    vas:DHP_Station;
                  rdfs:comment "DHP Station number 3"@en;
                  sosa:hosts vas:LAI_dhp_Sensor_3,
                             vas:FCOVER_dhp_Sensor_3,
                             vas:FAPAR_dhp_Sensor_3;
                  vas:controlArea vas:10km_x_10km;
                  vas:hasTypeOfCover vas:Sclerophyllous_vegetation;
                  vas:locatedInMunicipality <https://sws.geonames.org/6361960/>;
                  vas:locatedInProvince <http://datos.gob.es/recurso/sector-publico/territorio/Provincia/Valencia>.
vas:DSM_Result a owl:Class;
               rdfs:comment "Result that normally is obtained by DSM sensors. Unit of measure Metre."@en;
               rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                owl:onProperty qudt:numericValue ; 
                                a owl:Restriction],
                               [owl:hasValue unit:M ; 
                                owl:onProperty qudt:unit ; 
                                a owl:Restriction],
                               sosa:Result.
vas:DSM_UAV_LiDAR_Sensor_1 a vas:RS_UAV_LiDAR,
                             owl:NamedIndividual;
                           rdfs:comment "Sensor DSM UAV LiDAR  hosted by UAV LiDAR 1."@en;
                           sosa:isHostedBy vas:UAV_LiDAR_1;
                           sosa:observes vas:Digital_Surface_Model.
vas:DSM_UAV_Observation a owl:Class;
                        rdfs:comment "Class that represents observations related to DSM (Digital Surface Model).Unit of measure Metre."@en;
                        rdfs:subClassOf [owl:onClass vas:DSM_Result ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty sosa:hasResult ; 
                                         a owl:Restriction],
                                        [owl:hasValue vas:Digital_Surface_Model ; 
                                         owl:onProperty sosa:observedProperty ; 
                                         a owl:Restriction],
                                        [owl:hasValue resource:Vegetation ; 
                                         owl:onProperty sosa:hasFeatureOfInterest ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom vas:RS_UAV_LiDAR ; 
                                         owl:onProperty sosa:madeBySensor ; 
                                         a owl:Restriction],
                                        vas:UAV_Observation.
vas:DTM_Result a owl:Class;
               rdfs:comment "Result that normally is obtained by DTM sensors.Unit of measure Metre."@en;
               rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                owl:onProperty qudt:numericValue ; 
                                a owl:Restriction],
                               [owl:hasValue unit:M ; 
                                owl:onProperty qudt:unit ; 
                                a owl:Restriction],
                               sosa:Result.
vas:DTM_UAV_LiDAR_Sensor_1 a vas:RS_UAV_LiDAR,
                             owl:NamedIndividual;
                           rdfs:comment "Sensor DTM UAV LiDAR  hosted by UAV LiDAR 1."@en;
                           sosa:isHostedBy vas:UAV_LiDAR_1;
                           sosa:observes vas:Digital_Terrain_Model.
vas:DTM_UAV_Observation a owl:Class;
                        rdfs:comment "Class that represents observations related to DTM (Digital Terrain Model).Unit of measure Metre."@en;
                        rdfs:subClassOf [owl:onClass vas:DTM_Result ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty sosa:hasResult ; 
                                         a owl:Restriction],
                                        [owl:hasValue vas:Digital_Terrain_Model ; 
                                         owl:onProperty sosa:observedProperty ; 
                                         a owl:Restriction],
                                        [owl:hasValue resource:Vegetation ; 
                                         owl:onProperty sosa:hasFeatureOfInterest ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom vas:RS_UAV_LiDAR ; 
                                         owl:onProperty sosa:madeBySensor ; 
                                         a owl:Restriction],
                                        vas:UAV_Observation.
vas:Diffuse_Irradiance_Observation a owl:Class;
                                   rdfs:comment "Class that represents observations related to Diffuse radiation (W/m2)"@en;
                                   rdfs:subClassOf [owl:onClass vas:Diffuse_Irradiance_Result ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty sosa:hasResult ; 
                                                    a owl:Restriction],
                                                   [owl:hasValue resource:Diffuse_sky_radiation ; 
                                                    owl:onProperty sosa:observedProperty ; 
                                                    a owl:Restriction],
                                                   [owl:hasValue resource:Radiation ; 
                                                    owl:onProperty sosa:hasFeatureOfInterest ; 
                                                    a owl:Restriction],
                                                   [owl:allValuesFrom vas:I_dif_g ; 
                                                    owl:onProperty sosa:madeBySensor ; 
                                                    a owl:Restriction],
                                                   vas:Ground_based_Observation.
vas:Diffuse_Irradiance_Result a owl:Class;
                              rdfs:comment "Result that is normally obtained by I_dif sensors. Unit of measure Watt per Square Metre (W/m2)."@en;
                              rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                               owl:onProperty qudt:numericValue ; 
                                               a owl:Restriction],
                                              [owl:hasValue unit:W-PER-M2 ; 
                                               owl:onProperty qudt:unit ; 
                                               a owl:Restriction],
                                              sosa:Result.
vas:Digital_Surface_Model a vas:Vegetation_Property,
                            resource:Soil_Property,
                            owl:NamedIndividual;
                          rdfs:comment """Digital Surface Model (DSM).
A DSM is a LiDAR-derived raster representing the elevation of the uppermost surfaces in the scene, including vegetation, buildings, and all above-ground objects. Pixel values correspond to absolute height in meters (m)."""@en;
                          rdfs:label "DSM"@en;
                          sosa:isObservedBy vas:DSM_UAV_LiDAR_Sensor_1.
vas:Digital_Terrain_Model a resource:Soil_Property,
                            owl:NamedIndividual;
                          rdfs:comment """Digital Terrain Model (DTM).
A DTM is a LiDAR-derived raster representing the elevation of the bare ground surface, with vegetation and artificial structures removed. Each pixel stores the ground height expressed in meters (m)."""@en;
                          rdfs:label "DTM"@en;
                          sosa:isObservedBy vas:DTM_UAV_LiDAR_Sensor_1.
vas:Direct_Irradiance_Observation a owl:Class;
                                  rdfs:comment "Class that represents observations related to Direct solar radiation (W/m2)"@en;
                                  rdfs:subClassOf [owl:onClass vas:Direct_Irradiance_Result ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty sosa:hasResult ; 
                                                   a owl:Restriction],
                                                  [owl:hasValue resource:Direct_insolation ; 
                                                   owl:onProperty sosa:observedProperty ; 
                                                   a owl:Restriction],
                                                  [owl:hasValue resource:Radiation ; 
                                                   owl:onProperty sosa:hasFeatureOfInterest ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom vas:I_dir_g ; 
                                                   owl:onProperty sosa:madeBySensor ; 
                                                   a owl:Restriction],
                                                  vas:Ground_based_Observation.
vas:Direct_Irradiance_Result a owl:Class;
                             rdfs:comment "Result that is normally obtained by I_dir sensors. Unit of measure Watt per Square Metre (W/m2)."@en;
                             rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                              owl:onProperty qudt:numericValue ; 
                                              a owl:Restriction],
                                             [owl:hasValue unit:W-PER-M2 ; 
                                              owl:onProperty qudt:unit ; 
                                              a owl:Restriction],
                                             sosa:Result.
vas:DiseaseStatus_Result a owl:Class;
                         rdfs:comment "Result that normally is obtained by DiseaseStatus sensors. Dimensionless."@en;
                         rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                          owl:onProperty qudt:numericValue ; 
                                          a owl:Restriction],
                                         [owl:hasValue unit:NUM ; 
                                          owl:onProperty qudt:unit ; 
                                          a owl:Restriction],
                                         sosa:Result.
vas:DiseaseStatus_UAV_Hyperspectral_Sensor_1 a vas:RS_UAV_Hyperspectral,
                                               owl:NamedIndividual;
                                             rdfs:comment "Sensor Diseasestatus UAV Hyperspectral hosted by UAV Hyperspectral 1."@en;
                                             sosa:isHostedBy vas:UAV_Hyperspectral_1;
                                             sosa:observes resource:Plant_disease.
vas:DiseaseStatus_UAV_Observation a owl:Class;
                                  rdfs:comment "Class that represents observations related to DiseaseStatus. Dimensionless."@en;
                                  rdfs:subClassOf [owl:onClass vas:DiseaseStatus_Result ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty sosa:hasResult ; 
                                                   a owl:Restriction],
                                                  [owl:hasValue resource:Plant_disease ; 
                                                   owl:onProperty sosa:observedProperty ; 
                                                   a owl:Restriction],
                                                  [owl:hasValue resource:Vegetation ; 
                                                   owl:onProperty sosa:hasFeatureOfInterest ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom vas:RS_UAV_Hyperspectral ; 
                                                   owl:onProperty sosa:madeBySensor ; 
                                                   a owl:Restriction],
                                                  vas:UAV_Observation.
vas:DroughtIndex_SMOS_CATDS_Sensor_1 a vas:RS_SMOS,
                                       owl:NamedIndividual;
                                     rdfs:comment "DroughtIndex_SMOS_CATDS Sensor hosted by SMOS Product_1"@en;
                                     sosa:isHostedBy vas:SMOS_Product_1;
                                     sosa:observes resource:Drought.
vas:Duration_of_Sunshine_AEMET_Result a owl:Class;
                                      rdfs:comment "Result that is normally obtained by Heliograph sensors in AEMET Station. Unit of measure Hour."@en;
                                      rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                                       owl:onProperty qudt:numericValue ; 
                                                       a owl:Restriction],
                                                      [owl:hasValue unit:HR ; 
                                                       owl:onProperty qudt:unit ; 
                                                       a owl:Restriction],
                                                      sosa:Result.
vas:EVI_L8_Observation a owl:Class;
                       rdfs:comment "Sensor that takes EVI measurements from Landsat-8.",
                                    "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en;
                       rdfs:subClassOf [owl:allValuesFrom vas:RS_Landsat-8 ; 
                                        owl:onProperty sosa:madeBySensor ; 
                                        a owl:Restriction],
                                       vas:EVI_Satellite_Observation.
vas:EVI_L8_Sensor_1 a vas:RS_Landsat-8,
                      owl:NamedIndividual;
                    rdfs:comment "EVI_L8 Sensor hosted by Landsat-8 Product_1"@en;
                    sosa:isHostedBy vas:Landsat-8_Product_1;
                    sosa:observes resource:Enhanced_vegetation_index.
vas:EVI_L9_Observation a owl:Class;
                       rdfs:comment "Sensor that takes EVI measurements from  Landsat-9.",
                                    "Class that represents observations related to Enhanced Vegetation Index (EVI)."@en;
