vas:FAPAR_Observation a owl:Class;
                      rdfs:comment "Class that represents observations related to fraction of absorved photosynthetically active radiation (FAPAR). Dimensionless."@en;
                      rdfs:subClassOf [owl:onClass vas:FAPAR_Result ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty sosa:hasResult ; 
                                       a owl:Restriction],
                                      [owl:hasValue <https://mmisw.org/ont/cf/parameter/fraction_of_surface_downwelling_photosynthetic_radiative_flux_absorbed_by_vegetation> ; 
                                       owl:onProperty sosa:observedProperty ; 
                                       a owl:Restriction],
                                      [owl:hasValue resource:Vegetation ; 
