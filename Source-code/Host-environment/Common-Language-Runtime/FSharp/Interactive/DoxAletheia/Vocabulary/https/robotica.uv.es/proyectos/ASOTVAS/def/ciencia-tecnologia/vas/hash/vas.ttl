                                                                 owl:onProperty sosa:madeBySensor ; 
                                                                 a owl:Restriction],
                                                                vas:Ground_based_Observation.
vas:Upwelling_Shortwave_Flux_In_Air_Result a owl:Class;
                                           rdfs:comment "Result that is normally obtained by SW_up sensors. Unit of measure Watt per Square Metre (W/m2)."@en;
                                           rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                                            owl:onProperty qudt:numericValue ; 
                                                            a owl:Restriction],
                                                           [owl:hasValue unit:W-PER-M2 ; 
                                                            owl:onProperty qudt:unit ; 
                                                            a owl:Restriction],
                                                           sosa:Result.
vas:Vegetation_Property a owl:Class;
                        rdfs:comment "Class that represents all Vegetation properties"@en;
                        rdfs:subClassOf sosa:ObservableProperty.
vas:Vegetation_Result a owl:Class;
                      rdfs:comment "Result that is normally obtained by Vegetation ( EVI. SAVI, TDVI ...) sensors. Dimensionless."@en;
                      rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                       owl:onProperty qudt:numericValue ; 
                                       a owl:Restriction],
                                      [owl:hasValue unit:NUM ; 
                                       owl:onProperty qudt:unit ; 
                                       a owl:Restriction],
                                      sosa:Result.
vas:Vineyards a vas:Land_Cover_Classes,
                owl:NamedIndividual;
              rdfs:comment "Class Level 3 CORINE Land Cover - CLC"@en;
              rdfs:label "Vineyards"@en;
              vas:code_CLC 221 .
vas:WaterVapourFlux_g a owl:Class;
                      rdfs:comment "Sensor that takes water flow measurements"@en;
                      rdfs:subClassOf [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_water_evaporation_flux> ; 
                                       owl:onProperty sosa:observes ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom vas:EddyCovariance_Station ; 
                                       owl:onProperty sosa:isHostedBy ; 
                                       a owl:Restriction],
                                      vas:Ground_Based_Sensing.
vas:WaterVapourFlux_g_EddyCovariance_Sensor_1 a vas:WaterVapourFlux_g,
                                                owl:NamedIndividual;
                                              rdfs:comment "Sensor WaterVapourFlux_g_EddyCovariance hosted by EddyCovariance_Station_1"@en;
                                              sosa:isHostedBy vas:EddyCovariance_Station_1;
                                              sosa:observes <https://mmisw.org/ont/cf/parameter/surface_water_evaporation_flux>.
vas:Water_Vapour_Flux_Observation a owl:Class;
                                  rdfs:comment "Class that represents observations related to water vapour flux (W/m2)"@en;
                                  rdfs:subClassOf [owl:onClass vas:Water_Vapour_Flux_Result ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty sosa:hasResult ; 
                                                   a owl:Restriction],
                                                  [owl:hasValue <https://mmisw.org/ont/cf/parameter/surface_water_evaporation_flux> ; 
                                                   owl:onProperty sosa:observedProperty ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom vas:WaterVapourFlux_g ; 
                                                   owl:onProperty sosa:madeBySensor ; 
                                                   a owl:Restriction],
                                                  [owl:unionOf ([owl:hasValue resource:Atmosphere_of_Earth ; 
                                                                owl:onProperty sosa:hasFeatureOfInterest ; 
                                                                a owl:Restriction]
                                                                [owl:hasValue resource:Soil ; 
                                                                owl:onProperty sosa:hasFeatureOfInterest ; 
                                                                a owl:Restriction]
                                                                [owl:hasValue resource:Vegetation ; 
                                                                owl:onProperty sosa:hasFeatureOfInterest ; 
                                                                a owl:Restriction]) ; 
                                                   a owl:Class],
                                                  vas:Ground_based_Observation.
vas:Water_Vapour_Flux_Result a owl:Class;
                             rdfs:comment "Result that is normally obtained by WatervapourFlux (water vapour flux) sensors. Unit of measure Watt per Square Metre (W/m2)."@en;
                             rdfs:subClassOf [owl:someValuesFrom xsd:double ; 
                                              owl:onProperty qudt:numericValue ; 
                                              a owl:Restriction],
                                             [owl:hasValue unit:W-PER-M2 ; 
                                              owl:onProperty qudt:unit ; 
                                              a owl:Restriction],
                                             sosa:Result.
vas:WindVane_AEMET a owl:Class;
                   rdfs:comment "Sensor belongs to AEMET Station. Sensor that takes wind direction  [0º-360º]  measurements"@en;
                   rdfs:label "WindVane_AEMET";
                   rdfs:subClassOf [owl:allValuesFrom <http://aemet.linkeddata.es/ontology/WeatherStation> ; 
                                    owl:onProperty sosa:isHostedBy ; 
                                    a owl:Restriction],
                                   aws:WindVane.
vas:WindVane_AEMET_Sensor_UTIEL a vas:WindVane_AEMET,
                                  owl:NamedIndividual;
