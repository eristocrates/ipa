                                                        <http://qudt.org/2.1/vocab/unit>;
                                       rdfs:label "Meter per Second"@en-us,
                                                  "Metre per Second"@en.
<http://qudt.org/vocab/unit/M3-PER-M3> <http://qudt.org/schema/qudt/conversionMultiplier> 1.0;
