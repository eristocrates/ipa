@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix omv: <http://omv.ontoware.org/2005/05/ontology#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.
@prefix iadopt: <https://w3id.org/iadopt/ont/>.

omv:conformsToKnowledgeRepresentationParadigm a owl:AnnotationProperty.
omv:designedForOntologyTask a owl:AnnotationProperty.
omv:hasFormalityLevel a owl:AnnotationProperty.
omv:hasOntologyLanguage a owl:AnnotationProperty.
omv:hasOntologySyntax a owl:AnnotationProperty.
omv:usedOntologyEngineeringMethodology a owl:AnnotationProperty.
omv:usedOntologyEngineeringTool a owl:AnnotationProperty.
dcterms:abstract a owl:AnnotationProperty.
dcterms:contributor a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:language a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
aerdcat:keyword a owl:AnnotationProperty.
foaf:primaryTopic a owl:AnnotationProperty.
<https://w3id.org/iadopt/ont> omv:conformsToKnowledgeRepresentationParadigm <https://www.isibang.ac.in/ns/mod/index.html#DescriptionLogics>;
                              omv:designedForOntologyTask "semantically precise description and mapping of variables";
                              omv:hasFormalityLevel <https://www.isibang.ac.in/ns/mod/index.html#Schema>;
                              omv:hasOntologyLanguage <https://www.isibang.ac.in/ns/mod/index.html#OWL-DL>;
                              omv:hasOntologySyntax <https://www.isibang.ac.in/ns/mod/index.html#OWL/XML>;
                              omv:usedOntologyEngineeringMethodology <https://www.isibang.ac.in/ns/mod/index.html#MethOntology>;
                              omv:usedOntologyEngineeringTool "https://www.isibang.ac.in/ns/mod/index.html#Protege";
                              dcterms:abstract "The I-ADOPT Framework ontology provides machine-readable variable descriptions in which the components are mapped to FAIR vocabulary terms.";
                              dcterms:contributor "Robert Huber, University Bremen, Germany",
                                                  "Simon J D Cox , CSIRO Land and Water, Australia; ORCID: 0000-0002-3884-3420",
                                                  "John Graybeal, Stanford University, School of Medicine, USA, ORCID: 0000-0001-6875-5360";
                              dcterms:created "October 15, 2021";
                              dcterms:creator "Sirko Schindler, Institute of Data Science, German Aerospace Center (DLR), ORCID: 0000-0002-0964-4457",
                                              "Maria Stoica, University of Colorado, Boulder , ORCID: 0000-0002-6612-3439",
                                              "Anusuriya Devaraju, Terrestrial Ecosystem Research Network (TERN), University of Queensland, Australia, ORCID: 0000-0003-0870-3192",
                                              "Gwenaelle Moncoiffe, National Oceanography Centre, British Oceanographic Data Centre, UK, ORCID: 0000-0001-6559-4178",
                                              "Alison Pamment, National Centre for Atmospheric Science / Centre for Environmental Data Analysis, STFC Rutherford Appleton Laboratory, UK, ORCID: 0000-0001-5040-4626",
                                              "Barbara Magagna, Environment Agency Austria, ORCID: 0000-0003-2195-3997";
                              dcterms:language <http://lexvo.org/id/iso639-3/eng>;
                              dcterms:license "CC BY 4.0";
                              dcterms:title "I-ADOPT Framework ontology";
                              a owl:Ontology;
                              rdfs:label "I-ADOPT Framework ontology";
                              owl:versionIRI iadopt:0.9.1;
                              owl:versionInfo "0.9.1";
                              aerdcat:keyword "observable property",
                                              "variable";
                              foaf:primaryTopic "Variable",
                                                "Entity",
                                                "Property".
iadopt:Constraint a owl:Class;
                  rdfs:comment "A Constraint limits the scope of the observation and confines the context to a particular state. It describes properties of the involved entities that are relevant to the particular observation.";
                  rdfs:label "Constraint".
iadopt:Entity a owl:Class;
              rdfs:comment "An object or process that has a role in an observation. An Entity may play one of the following roles: ObjectOfInterest, ContextObject, Matrix. Whether the involvement of a particular entity is meaningful enough to include in the variable description depends on the specific context.";
              rdfs:label "Entity".
iadopt:Property a owl:Class;
                rdfs:comment "A type of a characteristic of the ObjectOfInterest.";
                rdfs:label "Property".
iadopt:Variable a owl:Class;
                rdfs:comment "A description of something observed or derived, minimally consisting of  an ObjectOfInterest and its Property.";
                rdfs:label "Variable";
                owl:equivalentClass [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty iadopt:hasObjectOfInterest ; 
                                     owl:onClass iadopt:Entity ; 
                                     a owl:Restriction],
                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty iadopt:hasProperty ; 
                                     owl:onClass iadopt:Property ; 
                                     a owl:Restriction].
iadopt:constrains a owl:ObjectProperty;
                  rdfs:comment "A Constraint constrains an Entity having a role in the Variable description.";
                  rdfs:domain iadopt:Constraint;
                  rdfs:label "constrains";
                  rdfs:range iadopt:Entity.
iadopt:hasConstraint a owl:ObjectProperty;
                     rdfs:comment "A Variable has a Constraint, that confines an Entity involved in the observation.";
                     rdfs:domain iadopt:Variable;
                     rdfs:label "hasConstraint";
                     rdfs:range iadopt:Constraint.
iadopt:hasContextObject a owl:ObjectProperty;
                        rdfs:comment "A Variable has an Entity that provides additional background information regarding the ObjectOfInterest.";
                        rdfs:domain iadopt:Variable;
                        rdfs:label "hasContextObject";
                        rdfs:range iadopt:Entity.
iadopt:hasMatrix a owl:ObjectProperty;
                 rdfs:comment "A Variable might have an Entity in which the ObjectOfInterest is contained.";
                 rdfs:domain iadopt:Variable;
                 rdfs:label "hasMatrix";
                 rdfs:range iadopt:Entity;
                 rdfs:subPropertyOf iadopt:hasContextObject.
iadopt:hasObjectOfInterest a owl:ObjectProperty;
                           rdfs:comment "A Variable has an Entity whose Property is observed.";
                           rdfs:domain iadopt:Variable;
                           rdfs:label "hasObjectOfInterest";
                           rdfs:range iadopt:Entity.
iadopt:hasProperty a owl:ObjectProperty;
                   rdfs:comment "A Variable has a Property that characterizes an Entity.";
                   rdfs:domain iadopt:Variable;
                   rdfs:label "hasProperty";
                   rdfs:range iadopt:Property.
