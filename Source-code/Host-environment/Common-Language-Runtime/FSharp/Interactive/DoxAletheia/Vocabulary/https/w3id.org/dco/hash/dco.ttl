                     rdfs:subClassOf dco:BuildingModel.
dco:BuildingTotalSpace a owl:Class;
                       rdfs:label "Building total space";
                       rdfs:subClassOf dco:BuildingMetadata;
                       skos:definition "Represent the total space of a building measured in meter square.".
dco:BuildingType a owl:Class;
                 rdfs:label "Building type";
                 rdfs:subClassOf dco:BuildingMetadata;
