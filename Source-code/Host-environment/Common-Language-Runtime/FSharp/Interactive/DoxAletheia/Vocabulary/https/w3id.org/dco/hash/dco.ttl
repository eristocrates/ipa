                                      skos:definition "Represent the service of closed loop energy efficiency.".
dco:Controller a owl:Class;
               rdfs:label "Controller";
               rdfs:subClassOf ssnx:Device;
               skos:definition "A controller is a device that monitors inputs and controls outputs within a building automation system. A controller may be physical (having placement within a spatial structure) or logical (a software interface or aggregated within a programmable physical controller).".
dco:CubicMeter a owl:Class;
               rdfs:label "Cubic meter";
               rdfs:subClassOf dco:VolumeUnit;
               skos:definition """\"A volume unit which is equal to the volume of a cube with edges one meter in length. One cubic meter equals to 1000 liters.\" [NIST:NIST]""".
