                   rdfs:label "Amperage clamp 2";
                   rdfs:subClassOf dco:AmperageProperty.
dco:AmperageClamp3 a owl:Class;
                   rdfs:label "Amperage clamp 3";
                   rdfs:subClassOf dco:AmperageProperty.
dco:AmperageProperty a owl:Class;
                     rdfs:label "Amperage property";
                     rdfs:subClassOf dco:Property.
dco:Ampere a owl:Class;
           rdfs:label "Ampere";
           rdfs:subClassOf dco:ElectricUnit.
dco:Apartment a owl:Class;
              rdfs:label "Apartment";
              rdfs:subClassOf dco:Space.
dco:Appliance a owl:Class;
              rdfs:label "Appliance";
              rdfs:subClassOf ssnx:Device;
              skos:definition "An electrical/mechanical machine that accomplish some household functions, such as cleaning or cooking.".
dco:AreaUnit a owl:Class;
             rdfs:label "Area unit";
             rdfs:subClassOf dco:UnitsOfMeasurements;
             skos:definition """\"An area unit which is equal to an area enclosed by a square with sides each 1 meter long.\" [NIST:NIST]""".
dco:Bathroom a owl:Class;
             rdfs:label "Bathroom";
             rdfs:subClassOf dco:Room.
dco:BatteryLevel a owl:Class;
                 rdfs:label "Battery level";
                 rdfs:subClassOf dco:BatteryProperty;
                 skos:definition "The level of remaining battery (if any : in percent) for a device.".
dco:BatteryProperty a owl:Class;
                    rdfs:label "Battery Property";
                    rdfs:subClassOf dco:Property.
dco:Bedroom a owl:Class;
            rdfs:label "Bedroom";
            rdfs:subClassOf dco:Room.
dco:Building a owl:Class;
             rdfs:label "Building";
             rdfs:subClassOf dco:Space;
             skos:definition "A building represents a structure that provides shelter for its occupants or contents and stands in one place. The building is also used to provide a basic element within the spatial structure hierarchy for the components of a building project (together with site, storey, and space). The basement floor of a building is floor number 0.".
dco:BuildingAddress a owl:Class;
                    rdfs:label "Building address";
                    rdfs:subClassOf dco:BuildingMetadata;
                    skos:definition "Represent the address of the building".
dco:BuildingCity a owl:Class;
                 rdfs:label "Building city";
                 rdfs:subClassOf dco:BuildingMetadata;
                 skos:definition "Represent the city of where the building is located".
dco:BuildingConstructionYear a owl:Class;
                             rdfs:label "Building construction year";
                             rdfs:subClassOf dco:BuildingMetadata.
dco:BuildingHeatedSurface a owl:Class;
                          rdfs:label "Building heated surface";
                          rdfs:subClassOf dco:BuildingMetadata;
                          skos:definition "Represent the total heated surface of a building.".
dco:BuildingLivingArea a owl:Class;
                       rdfs:label "Building living area";
                       rdfs:subClassOf dco:BuildingMetadata;
                       skos:definition "Represent the total living area of a building. This can me measured in square meter.".
dco:BuildingMetadata a owl:Class;
                     rdfs:label "Building metadata";
                     rdfs:subClassOf dco:BuildingModel.
dco:BuildingModel a owl:Class;
                  rdfs:label "Building model";
