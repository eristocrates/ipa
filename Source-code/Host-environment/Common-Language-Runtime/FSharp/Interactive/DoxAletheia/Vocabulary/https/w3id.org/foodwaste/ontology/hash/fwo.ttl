dcterms:alternative dcterms:description "The distinction between titles and alternative titles is application-specific."@en;
                    dcterms:issued "2000-07-11"^^xsd:date;
                    a owl:AnnotationProperty,
                      owl:NamedIndividual,
                      owl:DatatypeProperty;
                    rdfs:comment "An alternative name for the resource."@en;
                    rdfs:isDefinedBy dcterms:;
