fwo:avoidsAllergen a owl:ObjectProperty;
                   rdfs:comment "Links a user to an allergen they need to avoid";
                   rdfs:domain fwo:NGO;
                   rdfs:label "avoids Allergen";
                   rdfs:range fwo:Allergen.
fwo:claimedBy a owl:ObjectProperty,
                owl:FunctionalProperty;
              rdfs:comment "Indicates the user who has claimed this donation.";
              rdfs:domain fwo:FoodDonation;
              rdfs:label "claimed by";
              rdfs:range fwo:NGO.
fwo:containsAllergen a owl:ObjectProperty;
                     rdfs:comment "Denotes that a donation includes a specified allergen.";
                     rdfs:domain fwo:FoodDonation;
                     rdfs:label "contains Allergen";
                     rdfs:range fwo:Allergen.
fwo:don12345_Location a owl:NamedIndividual.
fwo:donatedBy a owl:ObjectProperty;
              rdfs:comment "Indicates the user or farmer who made this donation.";
              rdfs:domain fwo:FoodDonation;
              rdfs:label "donated by";
              rdfs:range fwo:Donor;
              owl:inverseOf fwo:hasDonated.
fwo:donor456_Donor a owl:NamedIndividual,
                     fwo:Donor.
fwo:hasDonated a owl:ObjectProperty;
               rdfs:comment "Links a user to the donations they have made.";
               rdfs:label "has donated".
fwo:hasDonationStatus a owl:ObjectProperty,
                        owl:FunctionalProperty;
                      rdfs:comment "Associates a donation with its current status.";
                      rdfs:domain fwo:FoodDonation;
                      rdfs:label "has donation status";
                      rdfs:range fwo:DonationStatus.
fwo:hasExpiryDate a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:comment "Denotes the expiration date of a donated food item";
                  rdfs:domain fwo:FoodDonation;
                  rdfs:label "has expiry date"@en;
                  rdfs:range xsd:dateTime.
fwo:hasFoodType a owl:ObjectProperty;
                rdfs:comment "Specifies the type of food in this donation.";
                rdfs:domain fwo:FoodDonation;
                rdfs:label "has food type";
                rdfs:range fwo:FoodType.
fwo:hasHigherPriorityThan a owl:ObjectProperty,
                            owl:TransitiveProperty;
                          rdfs:comment "Indicates that one priority level is higher than another.";
                          rdfs:domain fwo:Priority;
                          rdfs:label "has higher priority than";
                          rdfs:range fwo:Priority;
                          owl:inverseOf fwo:hasLowerPriorityThan.
fwo:hasLowerPriorityThan a owl:ObjectProperty,
                           owl:TransitiveProperty;
                         rdfs:comment "Indicates that one priority level is lower than another.";
                         rdfs:domain fwo:Priority;
                         rdfs:label "has lower priority than";
                         rdfs:range fwo:Priority.
fwo:hasParentType a owl:ObjectProperty;
                  rdfs:comment "Relates a food type to its more general parent category.";
                  rdfs:domain fwo:FoodType;
                  rdfs:label "has parent type";
                  rdfs:range fwo:FoodType.
fwo:hasPriority a owl:ObjectProperty;
                rdfs:comment "Specifies the priority level assigned to a donation.";
                rdfs:domain fwo:FoodDonation;
                rdfs:label "has priority";
                rdfs:range fwo:Priority.
fwo:isPreferredBy a owl:ObjectProperty;
                  rdfs:comment "Indicates that a donation is preferred by a particular user.";
                  rdfs:label "is preferred by";
                  owl:inverseOf fwo:prefersFoodType.
fwo:isRejectedBy a owl:ObjectProperty;
                 rdfs:comment "Indicates that a donation type has been rejected by a particular user.";
                 rdfs:label "is rejected by";
                 owl:inverseOf fwo:rejectsFoodType.
fwo:prefersFoodType a owl:ObjectProperty;
                    rdfs:comment "Links a user to the types of food they prefer.";
                    rdfs:domain fwo:NGO;
                    rdfs:label "prefers food type";
                    rdfs:range fwo:FoodType.
fwo:rejectsFoodType a owl:ObjectProperty;
