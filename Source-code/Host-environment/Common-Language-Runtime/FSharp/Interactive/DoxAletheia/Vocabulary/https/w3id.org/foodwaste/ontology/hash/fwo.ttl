dc11:contributor dcterms:description "The guidelines for using names of persons or organizations as creators also apply to contributors.  Typically, the name of a Contributor should be used to indicate the entity."@en;
                 dcterms:issued "1999-07-02"^^xsd:date;
                 a owl:AnnotationProperty;
