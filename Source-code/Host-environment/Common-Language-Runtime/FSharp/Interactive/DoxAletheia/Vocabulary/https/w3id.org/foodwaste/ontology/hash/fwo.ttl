wgspos: dc11:date "$Date: 2009/04/20 15:00:30 $";
        dc11:description """A vocabulary for representing latitude, longitude and 
 altitude information in the WGS84 geodetic reference datum. 
 Version $Id: wgs84_pos.rdf,v 1.22 2009/04/20 15:00:30 timbl Exp $. See http://www.w3.org/2003/01/geo/ for more details.""";
        dc11:title "WGS84 Geo Positioning: an RDF vocabulary";
        rdfs:comment """
Recent changes to this namespace:
$Log: wgs84_pos.rdf,v $
Revision 1.22  2009/04/20 15:00:30  timbl
Remove the time bits which have been deal with elsewhere eg in iCal.

Revision 1.21  2009/04/20 12:52:47  timbl
try again

Revision 1.20  2009/04/20 12:42:11  timbl
Add Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)

Revision 1.19  2009/04/20 12:36:31  timbl
Add Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)

Revision 1.18  2006/02/01 22:01:04  danbri
Clarified that lat and long are decimal degrees, and that alt is decimal metres about local reference ellipsoid

Revision 1.17  2004/02/06 17:38:12  danbri
Fixed a bad commit screwup

Revision 1.15  2003/04/19 11:24:08  danbri
Fixed the typo even more.

Revision 1.14  2003/04/19 11:16:56  danbri
fixed a typo

Revision 1.13  2003/02/19 22:27:27  connolly
relaxed domain constraints on lat/long/alt from Point to SpatialThing

Revision 1.12  2003/01/12 01:41:41  danbri
Trying local copy of XSLT doc.

Revision 1.11  2003/01/12 01:20:18  danbri
added a link to morten's xslt rdfs viewer.

Revision 1.10  2003/01/11 18:56:49  danbri
Removed datatype range from lat and long properties, since they would
have required each occurance of the property to mention the datatype.

Revision 1.9  2003/01/11 11:41:31  danbri
Another typo; repaired rdfs:Property to rdf:Property x4

Revision 1.8  2003/01/11 11:05:02  danbri
Added an rdfs:range for each lat/long/alt property,
http://www.w3.org/2001/XMLSchema#float

Revision 1.7  2003/01/10 20:25:16  danbri
Longer rdfs:comment for Point, trying to be Earth-centric and neutral about
coordinate system(s) at the same time. Feedback welcomed.

Revision 1.6  2003/01/10 20:18:30  danbri
Added CVS log comments into the RDF/XML as an rdfs:comment property of the
vocabulary. Note that this is not common practice (but seems both harmless
and potentially useful).


revision 1.5
date: 2003/01/10 20:14:31;  author: danbri;  state: Exp;  lines: +16 -5
Updated schema:
Added a dc:date, added url for more info. Changed the rdfs:label of the
namespace from gp to geo. Added a class Point, set as the rdfs:domain of
each property. Added XML comment on the lat_long property suggesting that
we might not need it (based on #rdfig commentary from implementors).

revision 1.4
date: 2003/01/10 20:01:07;  author: danbri;  state: Exp;  lines: +6 -5
Fixed typo; several rdfs:about attributes are now rdf:about. Thanks to MortenF in
#rdfig for catching this error.

revision 1.3
date: 2003/01/10 11:59:03;  author: danbri;  state: Exp;  lines: +4 -3
fixed buglet in vocab, added more wgs links

revision 1.2
date: 2003/01/10 11:01:11;  author: danbri;  state: Exp;  lines: +4 -4
Removed alt from the as-a-flat-string property, and switched from
space separated to comma separated.

revision 1.1
date: 2003/01/10 10:53:23;  author: danbri;  state: Exp;
basic geo vocab

""";
        rdfs:label "geo".
wgspos:Point a owl:Class;
             rdfs:comment """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  """,
                          """A point, typically described using a coordinate system relative to Earth, such as WGS84.
  """;
             rdfs:label "point";
             rdfs:subClassOf wgspos:SpatialThing.
wgspos:SpatialThing a owl:Class;
                    rdfs:comment """Anything with spatial extent, i.e. size, shape, or position.
 e.g. people, places, bowling balls, as well as abstract areas like cubes.
""";
                    rdfs:label "SpatialThing".
wgspos:alt a owl:AnnotationProperty;
           rdfs:comment """The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid).""";
           rdfs:domain wgspos:SpatialThing;
           rdfs:label "altitude".
wgspos:lat a owl:AnnotationProperty;
           rdfs:comment "The WGS84 latitude of a SpatialThing (decimal degrees).";
           rdfs:domain wgspos:SpatialThing;
           rdfs:label "latitude".
wgspos:lat_long rdfs:comment "A comma-separated representation of a latitude, longitude coordinate.";
                rdfs:label "lat/long".
wgspos:location a owl:AnnotationProperty,
                  owl:ObjectProperty;
                rdfs:comment """The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .
 """;
                rdfs:label "location";
                rdfs:range wgspos:SpatialThing;
                rdfs:subPropertyOf foaf:based_near.
wgspos:long a owl:AnnotationProperty;
            rdfs:comment "The WGS84 longitude of a SpatialThing (decimal degrees).";
            rdfs:domain wgspos:SpatialThing;
            rdfs:label "longitude".
skos:note a owl:AnnotationProperty.
nsprov:wasGeneratedBy a owl:AnnotationProperty.
foaf:based_near a owl:AnnotationProperty.
foaf:logo a owl:AnnotationProperty.
schemas:includedInDataCatalog a owl:AnnotationProperty.
<https://w3id.org/foodwaste/ontology> dc11:creator "Shivam Ganguly";
                                      dc11:description "An ontology to model food donation logistics."@en;
                                      dc11:title "Food Wastage Ontology"@en;
                                      dcterms:bibliographicCitation "http://purl.org/dc/elements/1.1/"^^rdfs:Literal;
                                      dcterms:created "2025-05-16"^^rdfs:Literal;
                                      dcterms:identifier "https://w3id.org/foodwaste/ontology"^^rdfs:Literal;
                                      dcterms:issued "2025-06-16"^^rdfs:Literal;
                                      dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
                                      dcterms:publisher "Shivam Ganguly";
                                      dcterms:source <https://github.com/MonarchRyuzaki/FoodWastageOntology>;
                                      dcterms:status "draft"@en;
                                      bibo:doi "10.5281/zenodo.16788052";
                                      vann:preferredNamespacePrefix "fwo";
                                      vann:preferredNamespaceUri "https://w3id.org/foodwaste/ontology#";
                                      a owl:Ontology;
                                      owl:imports vann:,
                                                  <http://www.w3.org/ns/prov-o-inverses-20130430>;
                                      owl:versionIRI <https://w3id.org/foodwaste/ontology/v1>;
                                      owl:versionInfo "v1.0";
                                      nsprov:wasGeneratedBy "Protégé"@en;
                                      foaf:logo <https://raw.githubusercontent.com/MonarchRyuzaki/FoodWastageFrontend/refs/heads/master/public/logo.svg>;
                                      schemas:includedInDataCatalog <https://github.com/MonarchRyuzaki/FoodWastageOntology>.
fwo:6832c9d165d2ec4756cab2ed_Donor a owl:NamedIndividual,
                                     fwo:Donor.
fwo:6841464540dd1a066f42dc98_Donor a owl:NamedIndividual,
                                     fwo:Donor.
fwo:Allergen a owl:Class;
             rdfs:comment "An enumeration of substances that may cause allergic reactions.";
             rdfs:label "Allergens";
             owl:equivalentClass [owl:oneOf (fwo:Crustacean_shellfish
                                             fwo:Eggs
                                             fwo:Fish
                                             fwo:Milk
                                             fwo:Sesame
                                             fwo:Soybeans
                                             fwo:Tree_Nuts
                                             fwo:Wheat) ; 
                                  a owl:Class].
fwo:AtRiskDonation a owl:Class;
                   rdfs:comment "A food donation that is nearing its expiry and should be prioritized.";
                   rdfs:label "At‑Risk Donation";
                   owl:equivalentClass [owl:intersectionOf (fwo:FoodDonation
                                                            [owl:onProperty fwo:hasPriority ; 
                                                            owl:hasValue fwo:High ; 
                                                            a owl:Restriction]) ; 
                                        a owl:Class].
fwo:Available a owl:NamedIndividual.
fwo:BakedGoods a owl:NamedIndividual.
fwo:Beverages a owl:NamedIndividual.
fwo:Claimed a owl:NamedIndividual.
fwo:ClaimedDonation a owl:Class;
                    rdfs:comment "A food donation that has been claimed by a recipient.";
                    rdfs:label "Claimed Donation";
                    rdfs:subClassOf [owl:onProperty fwo:hasDonationStatus ; 
                                     owl:hasValue fwo:Claimed ; 
                                     a owl:Restriction],
                                    fwo:FoodDonation.
fwo:CookedFood a owl:NamedIndividual.
fwo:Crustacean_shellfish a owl:NamedIndividual.
fwo:Dairy a owl:NamedIndividual.
fwo:DairyProducts a owl:NamedIndividual.
fwo:Delivered a owl:NamedIndividual,
                fwo:DonationStatus.
fwo:Diabetic_Sweets a owl:NamedIndividual.
fwo:DonationStatus a owl:Class;
                   rdfs:comment "An enumeration of possible statuses for a food donation (e.g., At Risk, Claimed).";
                   rdfs:label "Donation Status";
                   owl:equivalentClass [owl:oneOf (fwo:Available
                                                   fwo:Claimed
                                                   fwo:Delivered) ; 
                                        a owl:Class].
fwo:Donor a owl:Class;
          rdfs:comment "User is a donor";
          rdfs:label "Donor";
          rdfs:subClassOf fwo:User;
          owl:disjointWith fwo:NGO.
fwo:Donor1 a owl:NamedIndividual,
             fwo:Donor.
fwo:Donor10 a owl:NamedIndividual.
fwo:Donor_xyzq a owl:NamedIndividual,
                 fwo:Donor.
fwo:Eggs a owl:NamedIndividual.
fwo:Fish a owl:NamedIndividual.
fwo:FoodDonation a owl:Class;
                 rdfs:comment "A record representing a donation of food items.";
                 rdfs:label "Food Donation";
                 rdfs:subClassOf [owl:someValuesFrom fwo:Allergen ; 
                                  owl:onProperty fwo:containsAllergen ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom fwo:DonationStatus ; 
                                  owl:onProperty fwo:hasDonationStatus ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom fwo:FoodType ; 
                                  owl:onProperty fwo:hasFoodType ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom fwo:Priority ; 
                                  owl:onProperty fwo:hasPriority ; 
                                  a owl:Restriction].
fwo:FoodType a owl:Class;
             rdfs:comment "An enumeration of categories of food (e.g., fruits, vegetables, dairy)";
             rdfs:label "Food Type";
             owl:equivalentClass [owl:oneOf (fwo:BakedGoods
                                             fwo:Beverages
                                             fwo:CookedFood
                                             fwo:DairyProducts
                                             fwo:Diabetic_Sweets
                                             fwo:FreshProduce
                                             fwo:Grains_and_Cerals
                                             fwo:Meat
                                             fwo:Non_Diabetic_Sweets
                                             fwo:Processed_and_Packaged
                                             fwo:Sea_Food
                                             fwo:Snacks
                                             fwo:Spices_and_Condiments
                                             fwo:Staple_Foods) ; 
                                  a owl:Class].
fwo:FreshProduce a owl:NamedIndividual.
fwo:Fruit a owl:NamedIndividual.
fwo:Gluten a owl:NamedIndividual.
fwo:Grains_and_Cerals a owl:NamedIndividual.
fwo:High a owl:NamedIndividual;
         fwo:hasHigherPriorityThan fwo:Medium.
fwo:Low a owl:NamedIndividual,
          fwo:Priority.
fwo:Meat a owl:NamedIndividual.
fwo:Medium a owl:NamedIndividual;
           fwo:hasHigherPriorityThan fwo:Low.
fwo:Milk a owl:NamedIndividual.
fwo:NGO a owl:Class;
        rdfs:comment "User is an NGO";
        rdfs:label "NGO";
        rdfs:subClassOf [owl:someValuesFrom fwo:Allergen ; 
                         owl:onProperty fwo:avoidsAllergen ; 
                         a owl:Restriction],
                        [owl:someValuesFrom fwo:FoodType ; 
                         owl:onProperty fwo:prefersFoodType ; 
                         a owl:Restriction],
                        [owl:someValuesFrom fwo:FoodType ; 
                         owl:onProperty fwo:rejectsFoodType ; 
                         a owl:Restriction],
                        fwo:User.
