                                                                            <http://purl.org/net/p-plan#>;
                                    <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
swemls:ApplicationDomain a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The application domain in which the SWeML systems solve tasks (e.g. Chemistry, Legal)";
                         rdfs:label "Application Domain".
swemls:Area a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Positioning of the Paper in relation to research araeas e.g. Explainable AI or Semantic Web Mining";
            rdfs:label "Area".
swemls:Atomic-Pattern a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Basic pattern type: a single algorithmic module consumes a single input";
                      rdfs:label "Atomic Pattern";
                      rdfs:subClassOf swemls:Pattern.
swemls:Australia a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   swemls:Country;
                 rdfs:label "Australia".
swemls:Austria a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 swemls:Country;
               rdfs:label "Austria".
swemls:Belgium a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 swemls:Country;
               rdfs:label "Belgium".
swemls:Brazil a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                swemls:Country;
              rdfs:label "Brazil".
swemls:Bulgaria a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  swemls:Country;
                rdfs:label "Bulgaria".
swemls:Canada a <http://www.w3.org/2002/07/owl#NamedIndividual>,
