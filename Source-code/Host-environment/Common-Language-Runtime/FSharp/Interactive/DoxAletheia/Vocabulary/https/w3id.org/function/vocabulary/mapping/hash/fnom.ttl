rdf:List rdfs:label "array";
         <http://www.w3.org/2004/02/skos/core#broader> xsd:anyAtomicType.
xsd:anyAtomicType rdfs:label "(any)";
                  <http://www.w3.org/2004/02/skos/core#narrower> rdf:List,
                                                                 xsd:dateTime,
                                                                 xsd:decimal,
                                                                 xsd:integer,
                                                                 xsd:string.
xsd:dateTime rdfs:label "dateTime";
             <http://www.w3.org/2004/02/skos/core#broader> xsd:anyAtomicType.
xsd:decimal rdfs:label "decimal";
            <http://www.w3.org/2004/02/skos/core#broader> xsd:anyAtomicType;
            <http://www.w3.org/2004/02/skos/core#narrower> xsd:integer.
xsd:integer rdfs:label "integer";
            <http://www.w3.org/2004/02/skos/core#broader> xsd:anyAtomicType,
                                                          xsd:decimal.
xsd:string rdfs:label "string";
           <http://www.w3.org/2004/02/skos/core#broader> xsd:anyAtomicType.
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a owl:AnnotationProperty.
