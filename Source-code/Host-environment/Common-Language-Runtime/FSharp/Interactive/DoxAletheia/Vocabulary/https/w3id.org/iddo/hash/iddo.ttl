                                        <http://www.w3.org/2002/07/owl#onProperty> iddo:CategoryOfGroupOfProperties ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#oneOf> ("Alternative use"
                                                                                                                            "Class"
                                                                                                                            "Composed property"
                                                                                                                            "Domain"
                                                                                                                            "Reference document") ; 
                                                                                     a rdfs:Datatype] ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> iddo:CreatorsLanguage ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:Dimension ; 
