                    <http://www.w3.org/2004/02/skos/core#scopeNote> "PA038";
                    iddo:code "PA038",
                              "PA038"@de-de.
iddo:Tolerance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Fuer numerische Werte; der Gesamtbetrag, um den eine be-stimmte Einheit schwanken darf; sie ist die Differenz zwischen dem Hoechstwert und dem Mindestwert fuer die Einheit"@de-de,
                            "For numerical values; the total amount that a specific unit is permitted to vary; it is the difference between the maximum and the minimum limits for the unit";
               rdfs:domain iddo:Property;
               rdfs:label "Toleranz"@de-de,
                          "Tolerance";
               rdfs:range xsd:decimal;
               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>;
               <http://www.w3.org/2004/02/skos/core#scopeNote> "PA036";
               iddo:code "PA036",
                         "PA036"@de-de.
iddo:Unit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "Masseinheit fuer den digitalen Texttyp"@de-de,
                       "Unit of measurement for the digital text type";
          rdfs:domain iddo:DigitalFormatItem;
          rdfs:label "Einheit"@de-de,
                     "Unit";
          rdfs:range <http://qudt.org/schema/qudt/Unit>;
          rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
          <http://www.w3.org/2004/02/skos/core#scopeNote> "PA037";
          iddo:code "PA037",
                    "PA037"@de-de.
iddo:Units a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment """Eine Einheit zur Darstellung einer Skala, die es ermoeglicht, einen Wert zu messen
es ist moeglich, dieses Attribut zu verwenden, um zu erlaeutern, dass dem Merkmal keine Einheit zugeordnet ist, indem einheitslos verwendet wird"""@de-de,
                        """A unit to represent a scale that enables a value to be measured
It is possible to use this attribute to explain there is no unit attached to the property by using unitless""";
           rdfs:domain iddo:Property;
           rdfs:label "Einheiten"@de-de,
                      "Units";
           rdfs:range <http://qudt.org/schema/qudt/Unit>;
           rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "PA033";
           iddo:code "PA033",
                     "PA033"@de-de.
iddo:VersionNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "This version number allows tracking of major changes. Experts decide if a new version number must be applied",
                                "Diese Versionsnummer ermoeglicht die Verfolgung groesserer aenderungen. Sachverstaendige entscheiden, ob eine neue Ver-sionsnummer angewendet werden muss."@de-de;
                   rdfs:domain iddo:GroupOfProperties,
                               iddo:Property;
                   rdfs:label "Versionsnummer"@de-de,
                              "Version number";
                   rdfs:range xsd:integer;
                   rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "PA009/GA009";
                   iddo:code "PA009/GA009",
                             "PA009/GA009"@de-de.
iddo:VisualRepresentation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Bildliche Darstellung des Merkmals durch Skizzen, Fotos, Videos oder sonstige Multimedia-Objekte"@de-de,
                                       "Visual representation of the group of properties through sketches, photos, videos or other multimedia objects";
                          rdfs:domain iddo:GroupOfProperties,
                                      iddo:Property;
                          rdfs:label "Bildliche Darstellung"@de-de,
                                     "Visual representation";
                          rdfs:range xsd:string;
                          rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "PA023/GA018";
                          iddo:code "PA023/GA018",
                                    "PA023/GA018"@de-de.
iddo:code a rdf:Property,
            <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "Code that can be used to identify the attribute",
                       "Code, der zur Identifizierung des Attributs verwendet werden kann"@de-de;
          rdfs:domain rdfs:Resource;
          rdfs:isDefinedBy rdfs:;
          rdfs:label "Code",
                     "Code"@de-de;
          rdfs:range rdfs:Literal.
iddo:hasDictionaryReferenceDocument a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:domain iddo:DictionarySubset;
                                    rdfs:label "has relation to a reference document",
                                               "hat den Verweis auf ein Referenzdokument"@de-de;
                                    rdfs:range iddo:DictionaryReferenceDocument;
                                    rdfs:subPropertyOf <http://www.w3.org/ns/dcat#distribution>.
iddo:hasDictionarySubset a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain iddo:Dictionary;
                         rdfs:label "has dictionary subset",
                                    "hat Teilmenge eines Katalogs"@de-de;
                         rdfs:range iddo:DictionarySubset;
                         rdfs:subPropertyOf <http://www.w3.org/ns/dcat#dataset>.
iddo:hasProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Attaches a property to a feature of interest (FOI)",
                              "Fuegt ein Merkmal zu einem Feature of Interest (FOI) hinzu"@de-de;
                 rdfs:label "has property",
                            "hat Merkmal"@de-de;
                 rdfs:range iddo:AssignedProperty;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
iddo:hasPropertyGroupReference a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Attaches a property group reference to a iddo:ReferenceDocument",
                                            "Fuegt eine Merkmalsgruppe (oberstes in der Hierarchie) zu einer iddo:ReferenceDocument hinzu"@de-de;
                               rdfs:domain iddo:ReferenceDocument;
                               rdfs:label "has property group reference",
                                          "hat Merkmalsgruppenreferenz"@de-de;
                               rdfs:range iddo:GroupOfProperties;
                               rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>,
                                                  <http://www.w3.org/ns/dcat#distribution>.
iddo:hasPropertyReference a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Attaches a property reference to a property assignment",
                                       "Fuegt ein Merkmal zu einer Merkmalszuweisung hinzu"@de-de;
                          rdfs:domain iddo:AssignedProperty;
                          rdfs:label "has Property Reference",
                                     "hat Merkmalreferenz"@de-de;
                          rdfs:range iddo:Property;
                          rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
