iddo:GivenGroupsOfProperties a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Globally unique identifier of a group of properties (attribute GA001) for the symbol assigned to the property.",
                                          "Global eindeutiger Bezeichner einer Merkmalsgruppe (Attribut GA001) fuer das dem Merkmal zugeordnetem Symbol"@de-de;
                             rdfs:domain iddo:Property;
