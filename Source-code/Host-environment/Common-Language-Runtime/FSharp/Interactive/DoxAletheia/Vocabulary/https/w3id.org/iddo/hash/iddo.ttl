                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:DeprecationExplanation ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                        <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> 1  ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:RelationsOfTheGroupOfPropertiesIdentifiersInTheInterconnectedDataDictionaries ; 
                                        <http://www.w3.org/2002/07/owl#onClass> iddo:RelationOfTheGroupOfPropertiesIdentifiersInTheInterconnectedDataDictionaries ; 
                                        <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 0  ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:VisualRepresentation ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                        <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 1  ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
