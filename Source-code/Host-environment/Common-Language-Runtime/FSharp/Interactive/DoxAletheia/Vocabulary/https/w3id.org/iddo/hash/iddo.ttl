iddo:MethodOfMeasurement a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Evaluation of construction products to ensure their fitness according to requirements in harmonised technical specifications",
                                      "Beurteilung von Bauprodukten, um ihre Tauglichkeit entsprechend den Anforderungen in harmonisierten technischen Spezifikationen sicherzustellen";
                         rdfs:domain iddo:Property;
