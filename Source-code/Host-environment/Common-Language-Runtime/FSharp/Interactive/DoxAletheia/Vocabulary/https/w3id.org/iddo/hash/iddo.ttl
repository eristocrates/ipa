                         rdfs:label "Symbol of the property in a given property group",
                                    "Symbol des Merkmals in einer gegebenen Merkmalsgruppe"@de-de;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> iddo:GivenGroupsOfProperties ; 
                                          <http://www.w3.org/2002/07/owl#onClass> iddo:GroupOfProperties ; 
