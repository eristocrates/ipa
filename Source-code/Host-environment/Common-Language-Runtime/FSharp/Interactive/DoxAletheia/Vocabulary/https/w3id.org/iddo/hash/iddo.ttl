                          rdfs:range iddo:SymbolOfTheProperty;
                          rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "PA022";
                          iddo:code "PA022",
                                    "PA022"@de-de.
iddo:TextFormat a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment """Pair for text type (encoding, number of characters)
The encoding is set according to Name of encoding standard of IANA, RFC 2978""",
                             """Paar fuer den Texttyp (Ver-schluesselung, Anzahl der Zeichen)
die Verschluesselung wird nach Name der Codierungsnorm von IANA, RFC 2978 festgelegt"""@de-de;
                rdfs:domain iddo:Property;
                rdfs:label "Textformat"@de-de,
                           "Text format";
                rdfs:range iddo:TextFormatItem;
                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "PA038";
                iddo:code "PA038",
                          "PA038"@de-de.
iddo:TextFormatItem a rdfs:Class;
                    rdfs:comment """Paar fuer den Texttyp (Verschluesselung, Anzahl der Zeichen)
die Verschluesselung wird nach Name der Codierungsnorm von IANA, RFC 2978 festgelegt"""@de-de,
                                 """Pair for text type (encoding, number of characters)
The encoding is set according to Name of encoding standard of IANA, RFC 2978""";
                    rdfs:label "Text format item",
                               "Textformat-Item"@de-de;
                    rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                                    [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> iddo:Encoding ; 
                                     <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
