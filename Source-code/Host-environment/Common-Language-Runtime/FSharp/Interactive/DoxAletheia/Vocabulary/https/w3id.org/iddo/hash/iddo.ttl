                              <http://www.w3.org/2004/02/skos/core#scopeNote> "PA011";
                              iddo:code "PA011",
                                        "PA011"@de-de.
iddo:ListOfReplacingGroupsOfProperties a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "List of globally unique identifiers of the replacing groups of properties",
                                                    "Liste von globalen Bezeichnern fuer die ersetzenden Merkmalsgruppen"@de-de;
                                       rdfs:domain iddo:GroupOfProperties;
                                       rdfs:label "Liste ersetzender Merkmalsgruppen"@de-de,
