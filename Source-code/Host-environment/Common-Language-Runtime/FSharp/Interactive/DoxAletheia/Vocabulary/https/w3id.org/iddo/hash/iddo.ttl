                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:integer ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:ListOfReplacedGroupsOfProperties ; 
