                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                        <http://www.w3.org/2002/07/owl#minQualifiedCardinality> 0  ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> iddo:Status ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#oneOf> ("active"
                                                                                                                            "inactive") ; 
                                                                                     a rdfs:Datatype] ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> iddo:DateOfRevision ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> iddo:DateOfVersion ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:dateTime ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#onProperty> iddo:CountryOfUse ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
