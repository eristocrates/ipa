                                        a <http://www.w3.org/2002/07/owl#Restriction>].
iddo:GroupsOfProperties a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Liste von global eindeutigen Bezeichnern von Merkmalsgruppen (Attribut GA001), denen das Merkmal angehoert"@de-de,
                                     "List of globally unique identifiers of groups of properties (attribute GA001) to which the property is attached";
                        rdfs:domain iddo:Property;
                        rdfs:label "Group(s) of properties",
                                   "Merkmalsgruppe(n)"@de-de;
                        rdfs:range iddo:GroupOfProperties;
