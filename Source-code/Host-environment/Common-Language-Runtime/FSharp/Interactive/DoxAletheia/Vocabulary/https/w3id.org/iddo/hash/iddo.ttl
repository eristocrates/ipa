iddo:NameOfTheDefiningValues a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "In case of an array, this attribute provides the names of the column headers defined as a list of pairs (name, language)",
                                          "Im Falle eines Feldes liefert dieses Attribut die Namen der Spaltenkoepfe, festgelegt als Liste von Paaren (Name, Sprache)"@de-de;
                             rdfs:label "Names of the defining values",
                                        "Name der definierenden Werte"@de-de;
                             rdfs:range rdf:langString;
