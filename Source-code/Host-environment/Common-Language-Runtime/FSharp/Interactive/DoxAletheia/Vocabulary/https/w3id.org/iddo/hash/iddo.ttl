iddo:SymbolsOfTheProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "List of pairs (symbol of the property, globally unique identifier of the group of properties (attribute GA001))",
                                       "Liste von Paaren (Symbol des Merkmals, global eindeutiger Bezeichner der Merkmalsgruppe (Attribut GA001))"@de-de;
                          rdfs:domain iddo:Property;
                          rdfs:label "Symbols of the property in a given property group",
