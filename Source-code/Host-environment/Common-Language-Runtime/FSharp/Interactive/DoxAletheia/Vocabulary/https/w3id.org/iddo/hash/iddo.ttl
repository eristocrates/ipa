iddo:GloballyUniqueIdentifier a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "Eindeutiger Bezeichner, der mit dem in RFC 4122 beschriebenen Algorithmus erzeugt wird"@de-de,
                                           "Unique identifier generated using the algorithm denoted in RFC 4122";
                              rdfs:domain iddo:GroupOfProperties,
                                          iddo:Property;
                              rdfs:label "Global eindeutiger Bezeichner (GUID)"@de-de,
                                         "Globally Unique Identifier (GUID)";
                              rdfs:range xsd:string;
                              rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "PA001/GA001";
                              iddo:code "PA001/GA001",
                                        "PA001/GA001"@de-de.
iddo:GroupOfProperties a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Collection enabling the properties to be prearranged or organized",
                                    "Sammlung, die es ermoeglicht, die Merkmale vorauszuplanen oder zu organisieren"@de-de;
                       rdfs:label "Group of properties",
                                  "Merkmalsgruppe"@de-de;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> 1  ; 
