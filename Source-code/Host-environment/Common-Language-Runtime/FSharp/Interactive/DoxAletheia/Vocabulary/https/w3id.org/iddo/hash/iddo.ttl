                                                "GA011"@de-de.
iddo:ListOfReplacedProperties a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Globally unique identifier of the replaced property (or properties)",
                                           "Global eindeutiger Bezeichner des ersetzten Merkmals (oder der Merkmale)"@de-de;
                              rdfs:domain iddo:Property;
                              rdfs:label "List of replaced properties",
