@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix modp: <https://w3id.org/mod#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix pko: <https://w3id.org/pko#>.
@prefix doi: <https://doi.org/>.
@prefix dcam: <http://purl.org/dc/dcam/>.
@prefix ror: <https://ror.org/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix w3: <http://www.w3.org/>.
@prefix p-plan: <http://purl.org/net/p-plan#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix w3id: <https://w3id.org/>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix m4i: <http://w3id.org/nfdi4ing/metadata4ing#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix pro: <http://purl.org/spar/pro/>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.
@prefix schemas: <https://schema.org/>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dcam:domainIncludes a owl:AnnotationProperty.
dcam:rangeIncludes a owl:AnnotationProperty.
dc11:contributor a owl:AnnotationProperty.
dc11:creator a owl:AnnotationProperty.
dcterms:MediaTypeOrExtent a owl:Class;
                          rdfs:label "Media Type Or Extent".
dcterms:PeriodOfTime a owl:Class;
                     rdfs:label "Period Of Time".
dcterms:contributor a owl:AnnotationProperty.
dcterms:created dcam:domainIncludes aerdcat:Resource;
                dcam:rangeIncludes xsd:dateTime;
                a owl:DatatypeProperty;
                rdfs:label "created";
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the creation dateTime of a Resource (e.g., a Procedure)."@en.
dcterms:creator dcam:domainIncludes aerdcat:Resource;
                dcam:rangeIncludes nsprov:Agent;
                a owl:ObjectProperty;
                rdfs:label "creator";
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to the Agent that created it."@en.
dcterms:description dcam:domainIncludes aerdcat:Resource,
                                        nsprov:Activity;
                    dcam:rangeIncludes xsd:string;
                    a owl:DatatypeProperty;
                    rdfs:label "description";
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent a description of an entity, including: a Procedure, a Step, a Procedure Execution, a Step Execution, a Step Verification, a Resource that is referenced by or which a Procedure was extracted from."@en.
dcterms:format dcam:domainIncludes dcterms:MediaTypeOrExtent,
                                   aerdcat:Resource;
               a owl:ObjectProperty;
               rdfs:label "format";
               skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure or a Resource referenced by a Procedure), to the Media Type or Extent of the resource."@en.
dcterms:identifier dcam:domainIncludes aerdcat:Resource;
                   dcam:rangeIncludes xsd:string;
                   a owl:DatatypeProperty;
                   rdfs:label "identifier";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the identifier of an entity, including: a Procedure, a Step, a Procedure Execution, a Step Execution, a Step Verification, a FAQ Category, a FAQ Target, a Resource that is referenced by or which a Procedure was extracted from."@en.
dcterms:language dcam:domainIncludes aerdcat:Resource;
                 dcam:rangeIncludes xsd:string;
                 a owl:DatatypeProperty;
                 rdfs:label "language";
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the language of a Resource (e.g., a Procedure)."@en.
dcterms:license a owl:AnnotationProperty.
dcterms:modified dcam:domainIncludes aerdcat:Resource;
                 dcam:rangeIncludes xsd:dateTime;
                 a owl:DatatypeProperty;
                 rdfs:label "modified";
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the dateTime when a Resource  (e.g., a Procedure) has been modified."@en.
dcterms:publisher a owl:AnnotationProperty.
dcterms:references dcam:domainIncludes aerdcat:Resource;
                   dcam:rangeIncludes aerdcat:Resource;
                   a owl:ObjectProperty;
                   rdfs:label "references";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to another Resource (e.g., a document, an image, or another Procedure) that the Procedure references."@en.
dcterms:temporal dcam:domainIncludes pro:RoleInTime;
                 dcam:rangeIncludes dcterms:PeriodOfTime;
                 a owl:ObjectProperty;
                 rdfs:label "temporal";
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Role In Time held by an Agent to the Period of Time in which that Role is valid."@en.
dcterms:title dcam:domainIncludes aerdcat:Resource;
              dcam:rangeIncludes xsd:string;
              a owl:AnnotationProperty,
                owl:DatatypeProperty;
              rdfs:label "title";
              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the name/title of an entity, including: a Procedure, a Step, a Procedure Execution, a Step Execution, a Step Verification, a FAQ Category, a FAQ Target, a Resource that is referenced by or which a Procedure was extracted from."@en.
p-plan:MultiStep a owl:Class;
                 rdfs:label "Multi Step".
p-plan:Plan a owl:Class;
            rdfs:label "Plan".
p-plan:Step a owl:Class;
            rdfs:label "Step".
p-plan:Variable a owl:Class;
                rdfs:label "Variable".
p-plan:correspondsToVariable dcam:domainIncludes nsprov:Entity;
                             dcam:rangeIncludes p-plan:Variable;
                             a owl:ObjectProperty;
                             rdfs:label "corresponds to variable";
                             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Entity used by an Activity (either a Procedure Execution or a Step Execution) to the Variable it represented in the Procedure."@en.
p-plan:hasInputVar dcam:domainIncludes p-plan:Step;
                   dcam:rangeIncludes p-plan:Variable;
                   a owl:ObjectProperty;
                   rdfs:label "has input var";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the Variable that the Step needs to take as input for the Step Execution."@en.
p-plan:hasOutputVar dcam:domainIncludes p-plan:Step;
                    dcam:rangeIncludes p-plan:Variable;
                    a owl:ObjectProperty;
                    rdfs:label "has output var";
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the Variable that the Step needs to produce as output of the Step Execution."@en.
p-plan:isStepOfPlan dcam:domainIncludes p-plan:Step,
                                        pko:Procedure;
                    a owl:ObjectProperty;
                    rdfs:label "is step of plan";
                    owl:inverseOf pko:hasStep;
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the Procedure it is a step of."@en.
bibo:status a owl:AnnotationProperty.
pro:Role a owl:Class;
         rdfs:label "Role".
pro:RoleInTime a owl:Class;
               rdfs:label "Role In Time".
pro:holdsRoleInTime dcam:domainIncludes nsprov:Agent;
                    dcam:rangeIncludes pro:RoleInTime;
                    a owl:ObjectProperty;
                    rdfs:label "holds role in time";
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Agent to the Role In Time, that is the role that the Agent holds for a certain Period of Time."@en.
pro:relatesTo dcam:domainIncludes pro:RoleInTime;
              dcam:rangeIncludes aerdcat:Resource;
              a owl:ObjectProperty;
              rdfs:label "relates to";
              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Role In Time, that is the role that an Agent holds for a certain Period of Time, to the Resource (e.g., a Procedure) that the Role relates to."@en.
pro:withRole dcam:domainIncludes pro:RoleInTime;
             dcam:rangeIncludes pro:Role;
             a owl:ObjectProperty;
             rdfs:label "with role";
             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Role In Time, that is the role that an Agent holds for a certain Period of Time, to the Role that is held."@en.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
m4i:Tool a owl:Class;
         rdfs:label "Tool";
         skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents an object needed to execute a Step of a Procedure."@en.
rdfs:label a owl:AnnotationProperty.
owl:Thing a owl:Class;
          rdfs:label "Thing".
owl:priorVersion a owl:AnnotationProperty.
owl:versionIRI a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
skos:scopeNote a owl:AnnotationProperty.
time:Duration a owl:Class;
              rdfs:label "Duration".
time:TemporalUnit a owl:Class;
                  rdfs:label "Temporal Unit".
time:numericDuration dcam:domainIncludes time:Duration;
                     dcam:rangeIncludes xsd:date;
                     a owl:DatatypeProperty;
                     rdfs:label "numeric duration";
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the value of a temporal extent expressed as a number scaled by a temporal unit (in the form of xsd:decimal)."@en.
time:unitType dcam:domainIncludes time:Duration;
              dcam:rangeIncludes time:TemporalUnit;
              a owl:ObjectProperty;
              rdfs:label "unit type";
              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Duration of time to the Temporal Unit which provides the precision of a date-time value or scale of a temporal extent."@en.
adms:status dcam:domainIncludes aerdcat:Resource;
            dcam:rangeIncludes pko:ProcedureStatus;
            a owl:ObjectProperty;
            rdfs:label "status";
            skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link either a Procedure or a Procedure Execution to its Status."@en.
aerdcat:Resource a owl:Class;
                 rdfs:label "Resource".
aerdcat:accessURL dcam:domainIncludes aerdcat:Resource;
                  a owl:DatatypeProperty;
                  rdfs:label "access u r l";
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent a URL of a Resource (e.g., a Procedure or a document referenced by a Procedure) that gives access to a distribution of it."@en.
aerdcat:endDate dcam:domainIncludes dcterms:PeriodOfTime;
                dcam:rangeIncludes xsd:date;
                a owl:DatatypeProperty;
                rdfs:label "end date";
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the end of a Period Of Time."@en.
aerdcat:hasCurrentVersion dcam:domainIncludes pko:Procedure;
                          dcam:rangeIncludes pko:Procedure;
                          a owl:ObjectProperty;
                          rdfs:label "has current version";
                          owl:inverseOf pko:isCurrentVersionOf;
                          skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure, for which we want to manage version control, to its current version."@en.
aerdcat:hasVersion dcam:domainIncludes pko:Procedure;
                   dcam:rangeIncludes pko:Procedure;
                   a owl:ObjectProperty;
                   rdfs:label "has version";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure, for which we want to manage version control, to one of its versions."@en.
aerdcat:isVersionOf dcam:domainIncludes pko:Procedure;
                    dcam:rangeIncludes pko:Procedure;
                    a owl:ObjectProperty;
                    rdfs:label "is version of";
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to a version of a procedure to the Procedure, for which we want to manage version control."@en.
aerdcat:keyword dcam:domainIncludes aerdcat:Resource;
                dcam:rangeIncludes xsd:string;
                a owl:DatatypeProperty;
                rdfs:label "keyword";
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent a keyword or tag describing a Resource (e.g, a Procedure)."@en.
aerdcat:previousVersion dcam:domainIncludes pko:Procedure;
                        dcam:rangeIncludes pko:Procedure;
                        a owl:ObjectProperty;
                        rdfs:label "previous version";
                        owl:inverseOf pko:nextVersion;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a version of a Procedure to its direct previous version of the same Procedure."@en.
aerdcat:startDate dcam:domainIncludes dcterms:PeriodOfTime;
                  dcam:rangeIncludes xsd:date;
                  a owl:DatatypeProperty;
                  rdfs:label "start date";
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the start of a Period Of Time."@en.
nsprov:Activity a owl:Class;
                rdfs:label "Activity".
nsprov:Agent a owl:Class;
             rdfs:label "Agent".
nsprov:Entity a owl:Class;
              rdfs:label "Entity".
nsprov:InstantaneousEvent a owl:Class;
                          rdfs:label "Instantaneous Event".
nsprov:Organization a owl:Class;
                    rdfs:label "Organization".
nsprov:atLocation skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Target to the Location where is Target is located."@en.
nsprov:atTime dcam:domainIncludes nsprov:InstantaneousEvent;
              dcam:rangeIncludes xsd:dateTime;
              a owl:DatatypeProperty;
              rdfs:label "at time";
              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the dateTime at which an InstantaneousEvent occurred."@en.
nsprov:endedAtTime dcam:domainIncludes nsprov:Activity;
                   dcam:rangeIncludes xsd:dateTime;
                   a owl:DatatypeProperty;
                   rdfs:label "ended at time";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the dateTime at which an activity ended."@en.
nsprov:startedAtTime dcam:domainIncludes nsprov:Activity;
                     dcam:rangeIncludes xsd:dateTime;
                     a owl:DatatypeProperty;
                     rdfs:label "started at time";
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the dateTime at which an activity started."@en.
nsprov:used dcam:domainIncludes pko:StepExecution;
            dcam:rangeIncludes nsprov:Entity;
            a owl:ObjectProperty;
            rdfs:label "used";
            skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to an Entity that is being used during execution, and that may correspond to an input Variable of the Step."@en.
nsprov:wasAssociatedWith dcam:domainIncludes nsprov:Activity;
                         dcam:rangeIncludes nsprov:Agent;
                         a owl:ObjectProperty;
                         rdfs:label "was associated with";
                         skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (either a Procedure Execution or a Step Execution) to an Agent that had some role/responsibility in that Activity."@en.
nsprov:wasGeneratedBy dcam:domainIncludes nsprov:Entity;
                      dcam:rangeIncludes pko:StepExecution;
                      a owl:ObjectProperty;
                      rdfs:label "was generated by";
                      skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to an Entity that was generated during execution, and that may correspond to an output Variable of the Step."@en.
foaf:Organization a owl:Class.
foaf:Person a owl:Class.
foaf:name a owl:AnnotationProperty.
<https://orcid.org/0000-0001-5791-8427> a owl:NamedIndividual,
                                          foaf:Person;
                                        foaf:name "Ilaria Baroni"@en.
<https://orcid.org/0000-0001-9962-7193> a owl:NamedIndividual,
                                          foaf:Person;
                                        foaf:name "Irene Celino"@en.
<https://orcid.org/0000-0002-8235-7331> a owl:NamedIndividual,
                                          foaf:Person;
                                        foaf:name "Mario Scrocca"@en.
<https://orcid.org/0000-0002-9066-1229> a owl:NamedIndividual,
                                          foaf:Person;
                                        foaf:name "Antonia Azzini"@en.
<https://orcid.org/0000-0003-1427-3723> a owl:NamedIndividual,
                                          foaf:Person;
                                        foaf:name "Valentina Anita Carriero"@en.
ror:046bfkz44 a owl:NamedIndividual,
                foaf:Organization;
              foaf:name "Cefriel"@en.
schemas:citation a owl:AnnotationProperty.
schemas:funding a owl:AnnotationProperty.
modp:createdWith a owl:AnnotationProperty.
w3id:pko dcterms:contributor <https://orcid.org/0000-0001-5791-8427>,
                             <https://orcid.org/0000-0001-9962-7193>,
                             <https://orcid.org/0000-0002-9066-1229>;
         dcterms:creator <https://orcid.org/0000-0003-1427-3723>,
                         <https://orcid.org/0000-0002-8235-7331>;
         dcterms:description "The Procedural Knowledge Ontology (PKO) addresses the Procedural Knowledge (PK) domain, and models procedures, their executions, and related resources and agents.";
         dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
         dcterms:publisher ror:046bfkz44;
         dcterms:title "Procedural Knowledge Ontology (PKO)";
         bibo:status "Published Ontology"@en;
         vann:preferredNamespacePrefix "pko";
         vann:preferredNamespaceUri "https://w3id.org/pko#";
         a owl:NamedIndividual,
           owl:Ontology;
         rdfs:label "Procedural Knowledge Ontology (PKO)";
         owl:priorVersion <https://w3id.org/pko/0.1.0>;
         owl:versionIRI <https://w3id.org/pko/1.0.0>;
         owl:versionInfo "1.0.0";
         schemas:citation "Carriero, V.A., Scrocca, M., Baroni, I., Azzini, A., Celino, I. (2025). Procedural Knowledge Ontology (PKO).";
         schemas:funding <https://doi.org/10.3030/101120323>;
         modp:createdWith <https://chowlk.linkeddata.es/>.
pko:Action a owl:Class;
           rdfs:comment "This class represents an Action performed by a human Agent."@en;
           rdfs:label "Action";
           skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents an action that needs to be performed by a human Agent (a Person) for executing a Step of a Procedure."@en.
pko:Approval a owl:NamedIndividual,
               pko:ProcedureStatus.
pko:Approved a owl:NamedIndividual,
               pko:ProcedureStatus.
pko:Cancelled a owl:NamedIndividual,
                pko:ProcedureExecutionStatus.
pko:Completed a owl:NamedIndividual,
                pko:ProcedureExecutionStatus.
pko:Draft a owl:NamedIndividual,
            pko:ProcedureStatus.
pko:Error a owl:Class;
          rdfs:comment "This class represents an Error that can be encountered while executing an activity."@en;
          rdfs:label "Error";
          skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents an error that an Agent can encounter during a Procedure or Step Execution. An Error can be associated with a description, an error code, and an error cause. The Procedure may contain a (fallback) step to address such error."@en.
pko:ExpertiseLevel a owl:Class;
                   rdfs:comment "This class represents the Expertise Level of an Agent with respect to certain activities/responsibilities."@en;
                   rdfs:label "Expertise Level";
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the expertise level linked to a Step, or MultiStep, of a Procedure, meaning that the Step, or MultiStep, is targeted at persons with a certain level of expertise (e.g., junior, senior)."@en.
pko:FAQCategory a owl:Class;
                rdfs:comment "This class represents the Category of a Frequently Asked Question (FAQ)."@en;
                rdfs:label "F A Q Category".
pko:FAQTarget a owl:Class;
              rdfs:comment "This class represents the Target of a Frequently Asked Question (FAQ)."@en;
              rdfs:label "F A Q Target".
pko:FrequentlyAskedQuestion a owl:Class;
                            rdfs:comment "A Frequently Asked Question (FAQ) is a Resource representing a question that people often ask about a particular resource, and the answer to the question."@en;
                            rdfs:label "Frequently Asked Question";
                            rdfs:subClassOf aerdcat:Resource;
                            skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents a Frequently Asked Question (FAQ) of a Procedure, and is described with an identifier, a question, an answer, and is linked to a FAQ Category and a FAQ Target."@en.
pko:Function a owl:Class;
             rdfs:comment "This class represents a Function performed by a Software Agent."@en;
             rdfs:label "Function";
             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents a function that needs to be performed by a Software Agent for executing a Step of a Procedure."@en.
pko:InProgress a owl:NamedIndividual,
                 pko:ProcedureExecutionStatus.
pko:IssueOccurrence a owl:Class;
                    rdfs:comment "This class represents the occurrence of an issue during an Activity."@en;
                    rdfs:label "Issue Occurrence";
                    rdfs:subClassOf nsprov:InstantaneousEvent;
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of an issue during the Procedure or Step Execution. The Issue Occurrence is associated with the cause as identified and defined by the Agent, the solution as identified and applied by the Agent, and is linked to the Agent that encountered the issue."@en.
pko:Paused a owl:NamedIndividual,
             pko:ProcedureExecutionStatus.
pko:Procedure a owl:Class;
              rdfs:comment "A Procedure represents a sequence of actions to be executed in order to achieve a desired outcome."@en;
              rdfs:label "Procedure";
              rdfs:subClassOf p-plan:Plan,
                              aerdcat:Resource.
pko:ProcedureExecution a owl:Class;
                       rdfs:comment "A Procedure Execution is an Activity representing the execution of a certain Procedure, performed by one or more Agents, during a time interval."@en;
                       rdfs:label "Procedure Execution";
                       rdfs:subClassOf nsprov:Activity.
pko:ProcedureExecutionStatus a owl:Class;
                             rdfs:comment "This class represents the Status of the Procedure Execution (e.g., in progress, completed, paused, cancelled)."@en;
                             rdfs:label "Procedure Execution Status";
                             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), a Procedure Execution is linked to its Procedure Execution Status with the property adms:status."@en.
pko:ProcedureStatus a owl:Class;
                    rdfs:comment "This class represents the Status of the Procedure (e.g.,draft, validated)."@en;
                    rdfs:label "Procedure Status";
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), a Procedure  is linked to its Procedure Status with the property adms:status."@en.
pko:ProcedureTarget rdfs:comment "This class represents the Target of a Procedure, that is the object at which the actions of the Procedure are directed."@en;
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO),  a Procedure Target can be, for instance: a Machine, an Equipment, a Workstation."@en.
pko:ProcedureTargetType rdfs:comment "This class represents the Type of a Procedure Target."@en.
pko:ProcedureType a owl:Class;
                  rdfs:comment "This class represents the Type of a Procedure."@en;
                  rdfs:label "Procedure Type";
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), an example of Procedure Type is LOTO Procedure."@en.
pko:StepExecution a owl:Class;
                  rdfs:comment "A Procedure Execution is an Activity representing the execution of a certain Step of a Procedure, performed by one or more Agents, during a time interval."@en;
                  rdfs:label "Step Execution";
                  rdfs:subClassOf nsprov:Activity.
pko:StepVerification a owl:Class;
                     rdfs:comment "A Step Verification is a description of the way in which the execution of a Step can be verified."@en;
                     rdfs:label "Step Verification";
                     rdfs:subClassOf p-plan:Step.
pko:UserFeedbackOccurrence a owl:Class;
                           rdfs:comment "This class represents the occurrence of a feedback that was provided by a user during an activity."@en;
                           rdfs:label "User Feedback Occurrence";
                           rdfs:subClassOf nsprov:InstantaneousEvent;
                           skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of a feedback provided by an Agent during the Procedure or Step Execution. The User Feedback Occurrence is associated with the feedback, that is about either the Procedure or the Procedure Execution, and is linked to the Agent providing the feedback."@en.
pko:UserQuestionOccurrence a owl:Class;
                           rdfs:comment "This class represents the occurrence of a question that an Agent came up with during the Procedure or Step Execution."@en;
                           rdfs:label "User Question Occurrence";
                           rdfs:subClassOf nsprov:InstantaneousEvent;
                           skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this class represents the occurrence of a question that an Agent came up with during the Procedure or Step Execution. The User Question Occurrence is associated with the question, and is linked to the Agent asking the question. Also, it can be linked to a Resource addressing the question."@en.
pko:Validation a owl:NamedIndividual,
                 pko:ProcedureStatus.
pko:addressesError a owl:ObjectProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a (Multi)Step of a Procedure to the Error it addresses. Such (Multi)Step represents a Fallback procedure."@en;
                   rdfs:domain p-plan:Step;
                   rdfs:label "addresses error";
                   rdfs:range pko:Error;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a (Multi)Step of a Procedure to the Error it addresses. Such (Multi)Step represents a Fallback procedure."@en.
pko:answer a owl:DatatypeProperty;
           rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the answer of a Frequently Asked Question."@en;
           rdfs:domain pko:FrequentlyAskedQuestion;
           rdfs:label "answer";
           rdfs:range xsd:string;
           skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the answer of a Frequently Asked Question."@en.
pko:changelogDescription a owl:DatatypeProperty;
                         rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the changelog description of a Procedure, that details all updates with respect to the previous version of the same Procedure."@en;
                         rdfs:domain pko:Procedure;
                         rdfs:label "changelog description";
                         rdfs:range xsd:string;
                         skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the changelog description of a Procedure, that details all updates with respect to the previous version of the same Procedure."@en.
pko:errorCause a owl:DatatypeProperty;
               rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the cause of an Error that can be encountered during the Procedure or Step Execution."@en;
               rdfs:domain pko:Error;
               rdfs:label "error cause";
               rdfs:range xsd:string;
               skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the cause of an Error that can be encountered during the Procedure or Step Execution."@en.
pko:errorCode a owl:DatatypeProperty;
              rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the code of an Error that can be encountered during the Procedure or Step Execution."@en;
              rdfs:domain pko:Error;
              rdfs:label "error code";
              rdfs:range xsd:string;
              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the code of an Error that can be encountered during the Procedure or Step Execution."@en.
pko:executesProcedure a owl:ObjectProperty;
                      rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution to the Procedure that is being executed."@en;
                      rdfs:domain pko:ProcedureExecution;
                      rdfs:label "executes procedure";
                      rdfs:range pko:Procedure;
                      skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution to the Procedure that is being executed."@en.
pko:executesStep a owl:ObjectProperty;
                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to the Step that is being executed."@en;
                 rdfs:domain pko:StepExecution;
                 rdfs:label "executes step";
                 rdfs:range p-plan:Step;
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to the Step that is being executed."@en.
pko:feedbackOnProcedure a owl:DatatypeProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the feedback on the procedure that was provided by an Agent during the Procedure or Step Execution."@en;
                        rdfs:domain pko:UserFeedbackOccurrence;
                        rdfs:label "feedback on procedure";
                        rdfs:range xsd:string;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the feedback on the procedure that was provided by an Agent during the Procedure or Step Execution."@en.
pko:feedbackOnProcedureExecution a owl:DatatypeProperty;
                                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the feedback on the procedure execution that was provided by an Agent during the Procedure or Step Execution."@en;
                                 rdfs:domain pko:UserFeedbackOccurrence;
                                 rdfs:label "feedback on procedure execution";
                                 rdfs:range xsd:string;
                                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the feedback on the procedure execution that was provided by an Agent during the Procedure or Step Execution."@en.
pko:hasEncounteredError a owl:ObjectProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link the Occurrence of an Issue to the Error that is being encountered by the Agent executing a Procedure or Step."@en;
                        rdfs:domain pko:IssueOccurrence;
                        rdfs:label "has encountered error";
                        rdfs:range pko:Error;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link the Occurrence of an Issue to the Error that is being encountered by the Agent executing a Procedure or Step."@en.
pko:hasExpectedDuration a owl:ObjectProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link the Occurrence of an Issue to the Error that is being encountered by the Agent executing a Procedure or Step."@en;
                        rdfs:domain [owl:unionOf (p-plan:Step
                                                  pko:Procedure) ; 
                                     a owl:Class];
                        rdfs:label "has expected duration";
                        rdfs:range time:Duration;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link either a Procedure or a Step to the Duration that is expected for the execution of that Procedure/Step."@en.
pko:hasFAQCategory a owl:ObjectProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Frequently Asked Question to a Category it belongs to."@en;
                   rdfs:domain pko:FrequentlyAskedQuestion;
                   rdfs:label "has f a q category";
                   rdfs:range pko:FAQCategory;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Frequently Asked Question to a Category it belongs to."@en.
pko:hasFAQTarget a owl:ObjectProperty;
                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Frequently Asked Question to the Target of such FAQ."@en;
                 rdfs:domain pko:FrequentlyAskedQuestion;
                 rdfs:label "has f a q target";
                 rdfs:range pko:FAQTarget;
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Frequently Asked Question to the Target of such FAQ."@en.
pko:hasFallbackStep a owl:ObjectProperty;
                    rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to a (Multi)Step that represents a Fallback procedure for a specific Error that can be encountered during execution."@en;
                    rdfs:domain pko:Procedure;
                    rdfs:label "has fallback step";
                    rdfs:range p-plan:Step;
                    skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to a (Multi)Step that represents a Fallback procedure for a specific Error that can be encountered during execution."@en.
pko:hasFirstStep a owl:ObjectProperty;
                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its first Step."@en;
                 rdfs:domain [owl:unionOf (p-plan:MultiStep
                                           pko:Procedure) ; 
                              a owl:Class];
                 rdfs:label "has first step";
                 rdfs:range p-plan:Step;
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its first Step."@en.
pko:hasIssueOccurrence a owl:ObjectProperty;
                       rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution or Step Execution to an Issue Occurrence, that is the occurrence of an issue during the execution."@en;
                       rdfs:domain nsprov:Activity;
                       rdfs:label "has issue occurrence";
                       rdfs:range pko:IssueOccurrence;
                       skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution or Step Execution to an Issue Occurrence, that is the occurrence of an issue during the execution."@en.
pko:hasProcedureTarget a owl:ObjectProperty;
                       rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to its Procedure Target(s), that is the object at which the actions of the Procedure are directed. A Procedure Target can be, for instance: a Machine, an Equipment, a Workstation."@en;
                       rdfs:domain pko:Procedure;
                       rdfs:label "has procedure target";
                       rdfs:range owl:Thing;
                       skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to its Procedure Target(s), that is the object at which the actions of the Procedure are directed. A Procedure Target can be, for instance: a Machine, an Equipment, a Workstation."@en.
pko:hasProcedureTargetType rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a ProcedureTarget to its Procedure Target Type."@en;
                           skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a ProcedureTarget to its Procedure Target Type."@en.
pko:hasProcedureType a owl:ObjectProperty;
                     rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to its Procedure Type (e.g., a LOTO Procedure)."@en;
                     rdfs:domain pko:Procedure;
                     rdfs:label "has procedure type";
                     rdfs:range pko:ProcedureType;
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to its Procedure Type (e.g., a LOTO Procedure)."@en.
pko:hasStep a owl:ObjectProperty;
            rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its Steps."@en;
            rdfs:domain [owl:unionOf (p-plan:MultiStep
                                      pko:Procedure) ; 
                         a owl:Class];
            rdfs:label "has step";
            rdfs:range p-plan:Step;
            skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure or a MultiStep to its Steps."@en.
pko:hasStepVerification a owl:ObjectProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step of a Procedure to a Step Verification, that is the way in which the execution of the step can be verified."@en;
                        rdfs:domain p-plan:Step;
                        rdfs:label "has step verification";
                        rdfs:range pko:StepVerification;
                        owl:inverseOf pko:isStepVerificationOf;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step of a Procedure to a Step Verification, that is the way in which the execution of the step can be verified."@en.
pko:hasUserFeedbackOccurrence a owl:ObjectProperty;
                              rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution to a User Feedback Occurrence, that is the occurrence of a feedback that the user provides during execution about wither the Procedure or the Procedure Execution."@en;
                              rdfs:domain nsprov:Activity;
                              rdfs:label "has user feedback occurrence";
                              rdfs:range pko:UserFeedbackOccurrence;
                              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution to a User Feedback Occurrence, that is the occurrence of a feedback that the user provides during execution about wither the Procedure or the Procedure Execution."@en.
pko:hasUserQuestionOccurrence a owl:ObjectProperty;
                              rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution or Step Execution to a User Question Occurrence, that is the occurrence of a question that the user came up with during execution."@en;
                              rdfs:domain nsprov:Activity;
                              rdfs:label "has user question occurrence";
                              rdfs:range pko:UserQuestionOccurrence;
                              skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure Execution or Step Execution to a User Question Occurrence, that is the occurrence of a question that the user came up with during execution."@en.
pko:isAdoptedBy a owl:ObjectProperty;
                rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to an Organization which the Procedure is adopted by."@en;
                rdfs:domain pko:Procedure;
                rdfs:label "is adopted by";
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Procedure to an Organization which the Procedure is adopted by."@en.
pko:isCurrentVersionOf a owl:ObjectProperty;
                       rdfs:domain pko:Procedure;
                       rdfs:label "is current version of";
                       rdfs:range pko:Procedure.
pko:isIncludedInProcedureExecution a owl:ObjectProperty;
                                   rdfs:domain pko:StepExecution;
                                   rdfs:label "is included in procedure execution";
                                   rdfs:range pko:ProcedureExecution.
pko:isQuestionAddressedBy a owl:ObjectProperty;
                          rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Question Occurrence to a Resource that addresses/answers to the question that the user came up with during the Procedure/Step Execution."@en;
                          rdfs:domain pko:UserQuestionOccurrence;
                          rdfs:label "is question addressed by";
                          rdfs:range aerdcat:Resource;
                          skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Question Occurrence to a Resource that addresses/answers to the question that the user came up with during the Procedure/Step Execution."@en.
pko:isStepForExpertiseLevel a owl:ObjectProperty;
                            rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the Expertise Level, meaning that the Step, or MultiStep, is targeted at persons with a certain level of expertise (e.g., junior, senior)."@en;
                            rdfs:domain p-plan:Step;
                            rdfs:label "is step for expertise level";
                            rdfs:range pko:ExpertiseLevel;
                            skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the Expertise Level, meaning that the Step, or MultiStep, is targeted at persons with a certain level of expertise (e.g., junior, senior)."@en.
pko:isStepOfMultiStep a owl:ObjectProperty;
                      rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the MultiStep it is a step of."@en;
                      rdfs:domain p-plan:Step;
                      rdfs:label "is step of multi step";
                      rdfs:range p-plan:MultiStep;
                      skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to the MultiStep it is a step of."@en.
pko:isStepVerificationOf a owl:ObjectProperty;
                         rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Verification, that is the way in which the execution of the step can be verified, to the Step it verifies."@en;
                         rdfs:domain pko:StepVerification;
                         rdfs:label "is step verification of";
                         rdfs:range p-plan:Step;
                         skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Verification, that is the way in which the execution of the step can be verified, to the Step it verifies."@en.
pko:isTemplate a owl:DatatypeProperty;
               rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent whether a Procedure is a Template or not. A Procedure is a Template if it is associated with a preset of Steps that can be used to define an Executable Procedure. Such steps are not directly executable in the form they are specified."@en;
               rdfs:domain pko:Procedure;
               rdfs:label "is template";
               rdfs:range xsd:boolean;
               skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent whether a Procedure is a Template or not. A Procedure is a Template if it is associated with a preset of Steps that can be used to define an Executable Procedure. Such steps are not directly executable in the form they are specified."@en.
pko:issueCauseBySoftwareAgent a owl:DatatypeProperty;
                              rdfs:domain pko:IssueOccurrence;
                              rdfs:label "issue cause by software agent";
                              rdfs:range xsd:string.
pko:issueCauseByUser a owl:DatatypeProperty;
                     rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the cause of an issue, encountered during a Procedure/Step Execution, as identified and defined by the user."@en;
                     rdfs:domain pko:IssueOccurrence;
                     rdfs:label "issue cause by user";
                     rdfs:range xsd:string;
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the cause of an issue, encountered during a Procedure/Step Execution, as identified and defined by the user."@en.
pko:issueSolutionBySoftwareAgent a owl:DatatypeProperty;
                                 rdfs:domain pko:IssueOccurrence;
                                 rdfs:label "issue solution by software agent";
                                 rdfs:range xsd:string.
pko:issueSolutionByUser a owl:DatatypeProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the solution of an issue, encountered during a Procedure/Step Execution, as identified and applied by the user."@en;
                        rdfs:domain pko:IssueOccurrence;
                        rdfs:label "issue solution by user";
                        rdfs:range xsd:string;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the solution of an issue, encountered during a Procedure/Step Execution, as identified and applied by the user."@en.
pko:maxRepetitions a owl:DatatypeProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the maximum number of repetitions for a Step. If the maxRepetitions is equal to 1, it means that the Step is not repeatable."@en;
                   rdfs:domain p-plan:Step;
                   rdfs:label "max repetitions";
                   rdfs:range xsd:integer;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the maximum number of repetitions for a Step. If the maxRepetitions is equal to 1, it means that the Step is not repeatable."@en.
pko:minRepetitions a owl:DatatypeProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the maximum number of repetitions for a Step. If the minRepetitions is equal to 1, it means that the Step is mandatory. If the minRepetitions is equal to 0, it means that the Step is optional."@en;
                   rdfs:domain p-plan:Step;
                   rdfs:label "min repetitions";
                   rdfs:range xsd:integer;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the maximum number of repetitions for a Step. If the minRepetitions is equal to 1, it means that the Step is mandatory. If the minRepetitions is equal to 0, it means that the Step is optional."@en.
pko:newVersionMotivation a owl:DatatypeProperty;
                         rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the motivation for creating a new version of a Procedure, for which we want to manage access control."@en;
                         rdfs:domain pko:Procedure;
                         rdfs:label "new version motivation";
                         rdfs:range xsd:string;
                         skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the motivation for creating a new version of a Procedure, for which we want to manage access control."@en.
pko:nextAlternativeStep a owl:ObjectProperty;
                        rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to at least two alternative Steps, if only one of such steps should be executed."@en;
                        rdfs:domain p-plan:Step;
                        rdfs:label "next alternative step";
                        rdfs:range p-plan:Step;
                        skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to at least two alternative Steps, if only one of such steps should be executed."@en.
pko:nextStep a owl:ObjectProperty;
             rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct next Step."@en;
             rdfs:domain p-plan:Step;
             rdfs:label "next step";
             rdfs:range p-plan:Step;
             owl:inverseOf pko:previousStep;
             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct next Step."@en.
pko:nextStepExecution a owl:ObjectProperty;
                      rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct next Step Execution."@en;
                      rdfs:domain pko:StepExecution;
                      rdfs:label "next step execution";
                      rdfs:range pko:StepExecution;
                      owl:inverseOf pko:previousStepExecution;
                      skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct next Step Execution."@en.
pko:nextVersion a owl:ObjectProperty;
                rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a version of a Procedure to its direct next version of the same Procedure."@en;
                rdfs:domain pko:Procedure;
                rdfs:label "next version";
                rdfs:range pko:Procedure;
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a version of a Procedure to its direct next version of the same Procedure."@en.
pko:notesBySoftwareAgent a owl:DatatypeProperty;
                         rdfs:domain owl:Thing;
                         rdfs:label "notes by software agent";
                         rdfs:range xsd:string.
pko:notesByUser a owl:DatatypeProperty;
                rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the notes taken by the user about either a question that occurred during the Procedure/Step Execution (User Question Occurrence) or an issue that occurred during the Procedure/Step Execution (Issue Occurrence)."@en;
                rdfs:domain owl:Thing;
                rdfs:label "notes by user";
                rdfs:range xsd:string;
                skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the notes taken by the user about either a question that occurred during the Procedure/Step Execution (User Question Occurrence) or an issue that occurred during the Procedure/Step Execution (Issue Occurrence)."@en.
pko:previousStep a owl:ObjectProperty;
                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct previous Step."@en;
                 rdfs:domain p-plan:Step;
                 rdfs:label "previous step";
                 rdfs:range p-plan:Step;
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to its direct previous Step."@en.
pko:previousStepExecution a owl:ObjectProperty;
                          rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct previous Step Execution."@en;
                          rdfs:domain pko:StepExecution;
                          rdfs:label "previous step execution";
                          rdfs:range pko:StepExecution;
                          skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step Execution to its direct previous Step Execution."@en.
pko:question a owl:DatatypeProperty;
             rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the question of a Frequently Asked Question."@en;
             rdfs:domain pko:FrequentlyAskedQuestion;
             rdfs:label "question";
             rdfs:range xsd:string;
             skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the question of a Frequently Asked Question."@en.
pko:questionByUser a owl:DatatypeProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the question that a user came up with during the Procedure/Step Execution (User Question Occurrence)."@en;
                   rdfs:domain pko:UserQuestionOccurrence;
                   rdfs:label "question by user";
                   rdfs:range xsd:string;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the question that a user came up with during the Procedure/Step Execution (User Question Occurrence)."@en.
pko:requiresAction a owl:ObjectProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to an Action that needs to be performed by a human Agent (a Person) for executing the Step."@en;
                   rdfs:domain p-plan:Step;
                   rdfs:label "requires action";
                   rdfs:range pko:Action;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to an Action that needs to be performed by a human Agent (a Person) for executing the Step."@en.
pko:requiresFunction a owl:ObjectProperty;
                     rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to a Function that needs to be performed by a Software Agent for executing the Step."@en;
                     rdfs:domain p-plan:Step;
                     rdfs:label "requires function";
                     rdfs:range pko:Function;
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step to a Function that needs to be performed by a Software Agent for executing the Step."@en.
pko:requiresTool a owl:ObjectProperty;
                 rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step of a Procedure to a Tool required by the Step, that is an object needed to execute the Step."@en;
                 rdfs:domain p-plan:Step;
                 rdfs:label "requires tool";
                 rdfs:range m4i:Tool;
                 skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Step of a Procedure to a Tool required by the Step, that is an object needed to execute the Step."@en.
pko:stepNumber a owl:DatatypeProperty;
               rdfs:domain p-plan:Step;
               rdfs:label "step number";
               rdfs:range xsd:string.
pko:versionNumber a owl:DatatypeProperty;
                  rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the number of the version of a Procedure, for which we want to manage access control."@en;
                  rdfs:domain pko:Procedure;
                  rdfs:label "version number";
                  rdfs:range xsd:string;
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to represent the number of the version of a Procedure, for which we want to manage access control."@en.
pko:wasAskedBy a owl:ObjectProperty;
               rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Question Occurrence to the Agent that asked the question during the Procedure/Step Execution."@en;
               rdfs:domain pko:UserQuestionOccurrence;
               rdfs:label "was asked by";
               rdfs:range nsprov:Agent;
               skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Question Occurrence to the Agent that asked the question during the Procedure/Step Execution."@en.
pko:wasConfirmedBy a owl:ObjectProperty;
                   rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (e.g., a Step Execution) to the Agent that confirmed the Activity."@en;
                   rdfs:domain nsprov:Activity;
                   rdfs:label "was confirmed by";
                   rdfs:range nsprov:Agent;
                   rdfs:subPropertyOf nsprov:wasAssociatedWith;
                   skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (e.g., a Step Execution) to the Agent that confirmed the Activity."@en.
pko:wasEncounteredBy a owl:ObjectProperty;
                     rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Issue Occurrence to the Agent that encountered the issue during the Procedure/Step Execution."@en;
                     rdfs:domain pko:IssueOccurrence;
                     rdfs:label "was encountered by";
                     rdfs:range nsprov:Agent;
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Issue Occurrence to the Agent that encountered the issue during the Procedure/Step Execution."@en.
pko:wasExecutedBy a owl:ObjectProperty;
                  rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (e.g., a Step Execution) to the Agent that executed the Activity."@en;
                  rdfs:domain nsprov:Activity;
                  rdfs:label "was executed by";
                  rdfs:range nsprov:Agent;
                  rdfs:subPropertyOf nsprov:wasAssociatedWith;
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link an Activity (e.g., a Step Execution) to the Agent that executed the Activity."@en.
pko:wasExtractedFrom a owl:ObjectProperty;
                     rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to the Resource it was extracted from."@en;
                     rdfs:domain aerdcat:Resource;
                     rdfs:label "was extracted from";
                     rdfs:range aerdcat:Resource;
                     skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to the Resource it was extracted from."@en.
pko:wasModifiedBy a owl:ObjectProperty;
                  rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to the Agent that modified the Resource."@en;
                  rdfs:domain aerdcat:Resource;
                  rdfs:label "was modified by";
                  rdfs:range nsprov:Agent;
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a Resource (e.g., a Procedure) to the Agent that modified the Resource."@en.
pko:wasProvidedBy a owl:ObjectProperty;
                  rdfs:comment "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Feedback Occurrence to the Agent that provided the feedback about either the procedure or the procedure execution during the Procedure Execution."@en;
                  rdfs:domain pko:UserFeedbackOccurrence;
                  rdfs:label "was provided by";
                  rdfs:range nsprov:Agent;
                  skos:scopeNote "In the context of the Procedural Knowledge Ontology (PKO), this property is used to link a User Feedback Occurrence to the Agent that provided the feedback about either the procedure or the procedure execution during the Procedure Execution."@en.
