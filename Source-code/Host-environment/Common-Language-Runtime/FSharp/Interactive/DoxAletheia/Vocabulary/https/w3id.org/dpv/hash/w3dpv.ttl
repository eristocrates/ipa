                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataProcessingAgreement;
                             <http://www.w3.org/2004/02/skos/core#definition> "Creation, completion, fulfilment, or performance of a contract, with Data Controllers as parties being Joint Data Controllers, and involving specified processing of data or technologies. NOTE: This concept is being deprecated - use dpv:JointDataControllersAgreement which has a more explicit definition of the entities involved and the intent of the contract"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:contract-types-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Controller Contract"@en.
w3dpv:DataControllerDataSource <http://purl.org/dc/terms/created> "2023-10-12"^^xsd:date;
                               a w3dpv:DataSource,
                                 rdfs:Class,
                                 <http://www.w3.org/2004/02/skos/core#Concept>;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataSource;
                               <http://www.w3.org/2004/02/skos/core#definition> "Data Sourced from Data Controller(s), e.g. a Controller inferring data or generating data"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Controller as Data Source"@en.
w3dpv:DataDeletionPolicy <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                                _:Bb4025b4c989c25034fd54e030bd87587;
                         <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                         a <http://www.w3.org/2004/02/skos/core#Concept>,
                           w3dpv:OrganisationalMeasure,
                           rdfs:Class;
                         rdfs:isDefinedBy w3dpv:;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                         <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataProcessingPolicy;
                         <http://www.w3.org/2004/02/skos/core#definition> "Policy regarding deletion of data"@en;
                         <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Deletion Policy"@en;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Deletion and Erasure are distinct activities where deletion refers to logical removal of data with the possibility of retrieval whereas erasure refers to destruction of data such that it cannot be retrieved. See dpv:DataErasurePolicy"@en.
w3dpv:DataErasurePolicy <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                        <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                        a rdfs:Class,
                          w3dpv:OrganisationalMeasure,
                          <http://www.w3.org/2004/02/skos/core#Concept>;
                        rdfs:isDefinedBy w3dpv:;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                        <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataProcessingPolicy;
                        <http://www.w3.org/2004/02/skos/core#definition> "Policy regarding erasure of data"@en;
                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Erasure Policy"@en;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Erasure or data destruction or secure removal of data refers to irreversible erasure of data. See dpv:DataDeletion for reversible or logical deletion of data"@en.
w3dpv:DataExporter <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                          _:B39a5f196e4ce742b655078f42dbb4759,
                                                          _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                          _:B29bc11fedcb726098feeea009f5b976c;
                   <http://purl.org/dc/terms/created> "2021-09-08"^^xsd:date;
