                     w3dpv:Location,
                     rdfs:Class;
                   rdfs:isDefinedBy w3dpv:;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "sunset"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:LocalLocation;
                   <http://www.w3.org/2004/02/skos/core#definition> "Location is local and entirely within a device, such as a smartphone"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:jurisdiction-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Within Device (deprecated)"@en;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept will be deprecated in a future DPV release, it is suggested to use the existing concepts representing device as tech:Device to have parity and consistency between the use of device as a technology and for data storage"@en.
w3dpv:WithinPhysicalEnvironment <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                                <http://purl.org/dc/terms/created> "2020-10-06"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2025-05-04"^^xsd:date;
                                a <http://www.w3.org/2004/02/skos/core#Concept>,
                                  w3dpv:Location,
                                  rdfs:Class;
                                rdfs:isDefinedBy w3dpv:;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "sunset"@en;
                                <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Location;
                                <http://www.w3.org/2004/02/skos/core#definition> "Location is local and entirely within a physical environment, such as a room"@en;
                                <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:jurisdiction-classes;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Within Physical Environment"@en;
                                <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept will be deprecated in a future DPV release, it is suggested to use other concepts that also represent the nature of the location e.g. dpv:PrivateSpace or its accessibility dpv:PubliclyAccessibleSpace"@en.
w3dpv:WithinVirtualEnvironment <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                               <http://purl.org/dc/terms/created> "2020-10-06"^^xsd:date;
                               <http://purl.org/dc/terms/modified> "2025-05-04"^^xsd:date;
                               a <http://www.w3.org/2004/02/skos/core#Concept>,
                                 w3dpv:Location,
                                 rdfs:Class;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "sunset"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Location;
                               <http://www.w3.org/2004/02/skos/core#definition> "Location is local and entirely within a virtual environment, such as a software system"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:jurisdiction-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Within Virtual Environment"@en;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept will be deprecated in a future DPV release, it is suggested to use the existing concepts representing device as tech:Software and its taxonomy to have parity and consistency between the use of software as a technology and as a virtual environment for data storage and operations"@en.
