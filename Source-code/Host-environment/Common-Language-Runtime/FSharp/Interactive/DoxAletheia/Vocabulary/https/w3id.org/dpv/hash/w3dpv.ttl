                <http://www.w3.org/2004/02/skos/core#prefLabel> "Immigrant"@en.
w3dpv:Impact <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                    _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                    _:Bb4025b4c989c25034fd54e030bd87587,
                                                    _:Ba465069b0d9baa82d8b0bc064f94369f,
                                                    _:B08d083b5138b7461471bee8584a27726;
             <http://purl.org/dc/terms/created> "2022-03-23"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2024-08-16"^^xsd:date;
             <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0027>,
                                                  <https://w3id.org/dpv/examples#E0069>,
                                                  <https://w3id.org/dpv/examples#E0068>;
             a <http://www.w3.org/2004/02/skos/core#Concept>,
               rdfs:Class;
             rdfs:isDefinedBy w3dpv:;
             rdfs:subClassOf w3dpv:Consequence;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Consequence;
             <http://www.w3.org/2004/02/skos/core#definition> "The impact(s) possible or arising as a consequence from specified context"@en;
             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact"@en;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Impact is a stronger notion of consequence in terms of influence, change, or effect on something e.g. for impact assessments"@en.
w3dpv:ImpactAssessment <http://purl.org/dc/terms/contributor> _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                              _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B29bc11fedcb726098feeea009f5b976c;
                       <http://purl.org/dc/terms/created> "2020-11-04"^^xsd:date;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         w3dpv:OrganisationalMeasure,
                         rdfs:Class;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RiskAssessment;
                       <http://www.w3.org/2004/02/skos/core#definition> "Calculating or determining the likelihood of impact of an existing or proposed process, which can involve risks or detriments."@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Impact Assessment"@en.
w3dpv:ImpliedConsent <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                            _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                            _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:B29bc11fedcb726098feeea009f5b976c;
                     <http://purl.org/dc/terms/created> "2022-06-21"^^xsd:date;
                     a w3dpv:LegalBasis,
                       <http://www.w3.org/2004/02/skos/core#Concept>,
                       rdfs:Class;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:InformedConsent;
                     <http://www.w3.org/2004/02/skos/core#definition> "Consent that is implied indirectly through an action not associated solely with conveying a consenting decision"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-types-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Implied Consent"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Implied consent is expected to also be Informed Consent. An example is a CCTV notice outside a monitored area that informs the individuals that by walking in they would be consenting to the use of camera for surveillance."@en.
w3dpv:Importance <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                        _:B08d083b5138b7461471bee8584a27726,
