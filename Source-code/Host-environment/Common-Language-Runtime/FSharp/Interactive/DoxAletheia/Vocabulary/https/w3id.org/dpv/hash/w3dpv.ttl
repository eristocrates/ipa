w3dpv:ReuseCompatibility <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                                _:B1317b1df403c3d8a0f15f964829f0d11,
                                                                _:Bb4025b4c989c25034fd54e030bd87587,
                                                                _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                                _:B08d083b5138b7461471bee8584a27726;
                         <http://purl.org/dc/terms/created> "2025-06-19"^^xsd:date;
                         a rdfs:Class,
                           <http://www.w3.org/2004/02/skos/core#Concept>;
                         rdfs:isDefinedBy w3dpv:;
                         rdfs:subClassOf w3dpv:Status;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                         <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Status;
                         <http://www.w3.org/2004/02/skos/core#definition> "Concept indicating whether the specified context is compatible with another earlier context"@en;
                         <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "ReuseCompatibility"@en;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "Compatibility refers to whether two contexts, such as dpv:Process instances, are compatible with each other based on a criteria which is not defined by the concept. This criteria can be based on requirements from law, such as GDPR's purpose compatibility or can be based on privacy norms such as contextual integrity. To express such interpretations, further concepts should be expanded from this base concept"@en.
w3dpv:ReversingProcessEffects <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                                     _:Bad162a9a08e8d61a3cd3c1311f4688cb,
                                                                     _:Bb4025b4c989c25034fd54e030bd87587;
                              <http://purl.org/dc/terms/created> "2024-05-11"^^xsd:date;
                              a <http://www.w3.org/2004/02/skos/core#Concept>,
                                w3dpv:EntityPermissiveInvolvement,
                                rdfs:Class;
                              rdfs:isDefinedBy w3dpv:;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:EntityPermissiveInvolvement;
                              <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity can reverse effects of specified context"@en;
                              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Reversing Process Effects"@en;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Effects refer to consequences and impacts arising from the process or from the outputs of a process"@en.
w3dpv:ReversingProcessInput <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                                   _:Bb4025b4c989c25034fd54e030bd87587,
                                                                   _:Bad162a9a08e8d61a3cd3c1311f4688cb;
                            <http://purl.org/dc/terms/created> "2024-05-11"^^xsd:date;
                            a w3dpv:EntityPermissiveInvolvement,
                              rdfs:Class,
                              <http://www.w3.org/2004/02/skos/core#Concept>;
                            rdfs:isDefinedBy w3dpv:;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                            <http://www.w3.org/2004/02/skos/core#broader> w3dpv:EntityPermissiveInvolvement;
                            <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity can reverse input of specified context"@en;
                            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Reversing Process Input"@en;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Reversion can be considered a form of correction in some instances. We welcome inputs to further explore and define this relation between correction and reversion concepts."@en.
w3dpv:ReversingProcessOutput <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                                    _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                                    _:Bad162a9a08e8d61a3cd3c1311f4688cb;
                             <http://purl.org/dc/terms/created> "2024-05-11"^^xsd:date;
                             a w3dpv:EntityPermissiveInvolvement,
                               rdfs:Class,
                               <http://www.w3.org/2004/02/skos/core#Concept>;
                             rdfs:isDefinedBy w3dpv:;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:EntityPermissiveInvolvement;
                             <http://www.w3.org/2004/02/skos/core#definition> "Involvement where entity can reverse output of specified context"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Reversing Process Output"@en;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "Reversing of outputs indicate discarding the output and going back to the previous output. This is different from correction of output which allows modification of the output - implying continuation of the process."@en.
w3dpv:ReviewImpactAssessment <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                                    _:B29bc11fedcb726098feeea009f5b976c;
                             <http://purl.org/dc/terms/created> "2022-10-22"^^xsd:date;
                             a w3dpv:OrganisationalMeasure,
                               rdfs:Class,
                               <http://www.w3.org/2004/02/skos/core#Concept>;
                             rdfs:isDefinedBy w3dpv:;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ImpactAssessment,
                                                                           w3dpv:ReviewProcedure;
                             <http://www.w3.org/2004/02/skos/core#definition> "Procedures to review impact assessments in terms of continued validity, adequacy for intended purposes, and conformance of processes with findings"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Review Impact Assessment"@en.
w3dpv:ReviewProcedure <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                             _:B29bc11fedcb726098feeea009f5b976c;
                      <http://purl.org/dc/terms/created> "2022-10-22"^^xsd:date;
                      a rdfs:Class,
                        w3dpv:OrganisationalMeasure,
                        <http://www.w3.org/2004/02/skos/core#Concept>;
                      rdfs:isDefinedBy w3dpv:;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:GovernanceProcedures;
                      <http://www.w3.org/2004/02/skos/core#definition> "A procedure or process that reviews the correctness and validity of other procedures and policies e.g. to ensure continued validity, adequacy for intended purposes, and conformance of processes with findings"@en;
                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Review Procedure"@en.
w3dpv:Right <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                   _:B29bc11fedcb726098feeea009f5b976c,
                                                   _:Bb4025b4c989c25034fd54e030bd87587;
            <http://purl.org/dc/terms/created> "2020-11-18"^^xsd:date;
            <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0067>;
            a <http://www.w3.org/2004/02/skos/core#Concept>,
              rdfs:Class;
            rdfs:isDefinedBy w3dpv:;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
            <http://www.w3.org/2004/02/skos/core#definition> "The right(s) applicable, provided, or expected"@en;
            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Right"@en;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "A 'right' is a legal, social, or ethical principle of freedom or entitlement which dictate the norms regarding what is allowed or owed. Rights as a concept encompass a broad area of norms and entities, and are not specific to Individuals or Data Protection / Privacy. For individual specific rights, see dpv:DataSubjectRight"@en.
w3dpv:RightExerciseActivity <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                                   _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                   _:Bb4025b4c989c25034fd54e030bd87587,
                                                                   _:B29bc11fedcb726098feeea009f5b976c;
                            <http://purl.org/dc/terms/created> "2022-11-02"^^xsd:date;
                            <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0059>;
                            a w3dpv:OrganisationalMeasure,
                              rdfs:Class,
                              <http://www.w3.org/2004/02/skos/core#Concept>;
                            rdfs:isDefinedBy w3dpv:;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                            <http://www.w3.org/2004/02/skos/core#broader> w3dpv:OrganisationalMeasure;
                            <http://www.w3.org/2004/02/skos/core#definition> "An activity representing an exercising of an active right"@en;
                            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Exercise Activity"@en;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "There may be multiple activities associated with exercising and fulfilling rights. See the RightExerciseRecord concept for record-keeping of such activities in a cohesive manner."@en.
w3dpv:RightExerciseNotice <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                                 _:B29bc11fedcb726098feeea009f5b976c,
                                                                 _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                 _:B08d083b5138b7461471bee8584a27726;
                          <http://purl.org/dc/terms/created> "2022-10-22"^^xsd:date;
                          a rdfs:Class,
                            w3dpv:OrganisationalMeasure,
                            <http://www.w3.org/2004/02/skos/core#Concept>;
                          rdfs:isDefinedBy w3dpv:;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                          <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightNotice;
                          <http://www.w3.org/2004/02/skos/core#definition> "Information associated with exercising of an active right such as where and how to exercise the right, information required for it, or updates on an exercised rights request"@en;
                          <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Exercise Notice"@en;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is intended for providing information regarding a right exercise. For specific instances of such exercises, see RightExerciseActivity and RightExerciseRecord."@en.
w3dpv:RightExerciseRecord <http://purl.org/dc/terms/contributor> _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                 _:Bb4025b4c989c25034fd54e030bd87587,
                                                                 _:B29bc11fedcb726098feeea009f5b976c,
                                                                 _:B08d083b5138b7461471bee8584a27726;
                          <http://purl.org/dc/terms/created> "2022-11-02"^^xsd:date;
                          <http://purl.org/dc/terms/modified> "2025-08-17"^^xsd:date;
                          <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0057>;
                          a rdfs:Class,
                            <http://www.w3.org/2004/02/skos/core#Concept>,
                            w3dpv:OrganisationalMeasure;
                          rdfs:isDefinedBy w3dpv:;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en;
                          <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RecordsOfActivities;
                          <http://www.w3.org/2004/02/skos/core#definition> "Record of a Right being exercised"@en;
                          <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Exercise Record"@en;
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept represents a record of one or more right exercise activities, such as those associated with a single data subject or service or entity"@en.
w3dpv:RightFulfilmentNotice <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                                   _:Bb4025b4c989c25034fd54e030bd87587;
                            <http://purl.org/dc/terms/created> "2022-11-02"^^xsd:date;
                            a rdfs:Class,
                              <http://www.w3.org/2004/02/skos/core#Concept>,
                              w3dpv:OrganisationalMeasure;
                            rdfs:isDefinedBy w3dpv:;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                            <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightExerciseNotice;
                            <http://www.w3.org/2004/02/skos/core#definition> "Notice provided regarding fulfilment of a right"@en;
                            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Fulfilment Notice"@en;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "This notice is associated with situations where information is provided with the intention of progressing the fulfilment of a right. For example, a notice asking for more information regarding the scope of the right, or providing information on where to access the data provided under a right."@en.
w3dpv:RightNonFulfilmentNotice <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                                      _:Bb4025b4c989c25034fd54e030bd87587;
                               <http://purl.org/dc/terms/created> "2022-11-02"^^xsd:date;
                               <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0058>,
                                                                    <https://w3id.org/dpv/examples#E0061>;
                               a w3dpv:OrganisationalMeasure,
                                 <http://www.w3.org/2004/02/skos/core#Concept>,
                                 rdfs:Class;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightExerciseNotice;
                               <http://www.w3.org/2004/02/skos/core#definition> "Notice provided regarding non-fulfilment of a right"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Non-Fulfilment Notice"@en;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> "This notice is associated with situations where information is provided with the intention of communicating non-fulfilment of a right. For example, to provide justifications on why a right could not be fulfilled or providing information about another entity who should be approached for exercising this right."@en.
w3dpv:RightNotice <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                  <http://purl.org/dc/terms/created> "2024-06-16"^^xsd:date;
                  a w3dpv:OrganisationalMeasure,
                    rdfs:Class,
                    <http://www.w3.org/2004/02/skos/core#Concept>;
                  rdfs:isDefinedBy w3dpv:;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                  <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Notice;
                  <http://www.w3.org/2004/02/skos/core#definition> "Information associated with rights, such as which rights exist, when and where they are applicable, and other relevant information"@en;
                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Right Notice"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept also covers information about rights exercise, with dpv:RightExerciseNotice specifically representing information provided in connection with exercising of rights. Both notices may be needed, e.g. RightNotice for providing information about existence and exercise of rights, and RightExerciseNotice for providing additional information specifically about exercise of rights - such as to request more information or provide updates on an exercised rights request"@en.
w3dpv:RightsFulfilment <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                              _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B1317b1df403c3d8a0f15f964829f0d11,
                                                              _:B29bc11fedcb726098feeea009f5b976c;
                       <http://purl.org/dc/terms/created> "2024-02-14"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2025-08-06"^^xsd:date;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         w3dpv:Purpose,
                         rdfs:Class;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:LegalObligation;
                       <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with the fulfillment of rights specified in law"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:purposes-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Rights Fulfilment"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Where Rights Fulfillment includes activities that are not legal obligations, for example conducting Identity Verification, the documentation should indicate this by expressing them as separate purposes within the same activity"@en.
w3dpv:RightsImpactAssessment <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                             <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                             a <http://www.w3.org/2004/02/skos/core#Concept>,
                               w3dpv:OrganisationalMeasure,
                               rdfs:Class;
                             rdfs:isDefinedBy w3dpv:;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ImpactAssessment;
                             <http://www.w3.org/2004/02/skos/core#definition> "Impact assessment which involves determining the impact on rights and freedoms"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Rights Impact Assessment"@en;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "The rights and freedoms may be those defined in law or other norms, and may be bound to a jurisdiction"@en.
w3dpv:RightsManagement <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                              _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B29bc11fedcb726098feeea009f5b976c;
                       <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                       a rdfs:Class,
                         w3dpv:OrganisationalMeasure,
                         <http://www.w3.org/2004/02/skos/core#Concept>;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:OrganisationalMeasure;
                       <http://www.w3.org/2004/02/skos/core#definition> "Methods associated with rights management where 'rights' refer to controlling who can do what with a resource"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Rights Management"@en.
w3dpv:Risk <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
           <http://purl.org/dc/terms/created> "2020-11-18"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2024-08-16"^^xsd:date;
           <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0068>,
                                                <https://w3id.org/dpv/examples#E0027>,
                                                <https://w3id.org/dpv/examples#E0071>;
           a rdfs:Class,
             <http://www.w3.org/2004/02/skos/core#Concept>;
           rdfs:isDefinedBy w3dpv:;
           rdfs:subClassOf w3dpv:RiskConcept;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
           <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RiskConcept;
           <http://www.w3.org/2004/02/skos/core#definition> "A risk or possibility or uncertainty of negative effects, impacts, or consequences"@en;
           <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk"@en;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Risks can be associated with one or more different concepts such as purpose, processing, personal data, technical or organisational measure"@en.
w3dpv:RiskAssessment <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                     <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                       rdfs:Class,
                       w3dpv:OrganisationalMeasure;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Assessment;
                     <http://www.w3.org/2004/02/skos/core#definition> "Assessment involving identification, analysis, and evaluation of risk"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Assessment"@en.
w3dpv:RiskConcept <http://purl.org/dc/terms/contributor> _:B7726889e1ec55eede55b01be3aefef6c,
                                                         _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                         _:Bb4025b4c989c25034fd54e030bd87587;
                  <http://purl.org/dc/terms/created> "2024-08-16"^^xsd:date;
                  a <http://www.w3.org/2004/02/skos/core#Concept>,
                    rdfs:Class;
                  rdfs:isDefinedBy w3dpv:;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> "Parent concept for combining concepts associated with risk assessment such as actual and potential Risk, Risk Source, Consequences, and Impacts"@en;
                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Concept"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "RiskConcept is a generic concept used for creation of specific taxonomies in the RISK extension to provide guidance on how a concept can potentially be a risk, risk source, consequence, and impact. It is not intended to be used directly and is only created for organisation of concepts in DPV vocabularies"@en.
w3dpv:RiskLevel <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                <http://purl.org/dc/terms/created> "2022-07-20"^^xsd:date;
                <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0068>,
                                                     <https://w3id.org/dpv/examples#E0071>;
                a rdfs:Class,
                  <http://www.w3.org/2004/02/skos/core#Concept>;
                rdfs:isDefinedBy w3dpv:;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                <http://www.w3.org/2004/02/skos/core#definition> "The magnitude of a risk expressed as an indication to aid in its management"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Level"@en;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Risk Levels can be defined as a combination of different characteristics. For example, ISO 31073:2022 defines it as a combination of consequences and their likelihood. Another example would be the Risk Matrix where Risk Level is defined as a combination of Likelihood and Severity associated with the Risk."@en.
w3dpv:RiskMitigationMeasure <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                                   _:Bb4025b4c989c25034fd54e030bd87587,
                                                                   _:B4891803172dbcb772b94bd1e09c7b5ff;
                            <http://purl.org/dc/terms/created> "2020-11-04"^^xsd:date;
                            <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0068>;
                            a <http://www.w3.org/2004/02/skos/core#Concept>,
                              rdfs:Class;
                            rdfs:isDefinedBy w3dpv:;
                            rdfs:subClassOf w3dpv:TechnicalOrganisationalMeasure;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                            <http://www.w3.org/2004/02/skos/core#broader> w3dpv:TechnicalOrganisationalMeasure;
                            <http://www.w3.org/2004/02/skos/core#definition> "Measures intended to mitigate, minimise, or prevent risk."@en;
                            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Risk Mitigation Measure"@en.
w3dpv:Rule <http://purl.org/dc/terms/contributor> _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                  _:Bb4025b4c989c25034fd54e030bd87587,
                                                  _:B08d083b5138b7461471bee8584a27726,
                                                  _:B29bc11fedcb726098feeea009f5b976c;
           <http://purl.org/dc/terms/created> "2022-10-19"^^xsd:date;
           <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0030>;
           a <http://www.w3.org/2004/02/skos/core#Concept>,
             rdfs:Class;
           rdfs:isDefinedBy w3dpv:;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
           <http://www.w3.org/2004/02/skos/core#definition> "A rule describing a process or control that directs or determines if and how an activity should be conducted"@en;
           <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Rule"@en.
w3dpv:RuleFulfilled <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                    <http://purl.org/dc/terms/created> "2024-09-10"^^xsd:date;
                    a rdfs:Class,
                      <http://www.w3.org/2004/02/skos/core#Concept>,
                      w3dpv:RuleFulfilmentStatus;
                    rdfs:isDefinedBy w3dpv:;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RuleFulfilmentStatus;
                    <http://www.w3.org/2004/02/skos/core#definition> "Status indicating a rule has been fulfilled, completed, or satisfied"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Rule Fulfilled"@en.
w3dpv:RuleFulfilmentStatus <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                           <http://purl.org/dc/terms/created> "2024-09-10"^^xsd:date;
                           <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0084>;
                           a <http://www.w3.org/2004/02/skos/core#Concept>,
                             rdfs:Class;
                           rdfs:isDefinedBy w3dpv:;
                           rdfs:subClassOf w3dpv:Status;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                           <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Status;
                           <http://www.w3.org/2004/02/skos/core#definition> "Status associated with a rule for indicating whether it is applicable, or has been utilised, and whether the requirements of the rule have been fulfilled or violated"@en;
                           <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Rule Fulfilment Status"@en.
w3dpv:RuleUnfulfilled <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                      <http://purl.org/dc/terms/created> "2024-09-10"^^xsd:date;
                      a w3dpv:RuleFulfilmentStatus,
                        rdfs:Class,
                        <http://www.w3.org/2004/02/skos/core#Concept>;
                      rdfs:isDefinedBy w3dpv:;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RuleFulfilmentStatus;
                      <http://www.w3.org/2004/02/skos/core#definition> "Status indicating a rule has not been fulfilled nor violated"@en;
                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Rule Unfulfilled"@en.
w3dpv:RuleViolated <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                   <http://purl.org/dc/terms/created> "2024-09-10"^^xsd:date;
                   a rdfs:Class,
                     w3dpv:RuleFulfilmentStatus,
                     <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:isDefinedBy w3dpv:;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RuleFulfilmentStatus;
                   <http://www.w3.org/2004/02/skos/core#definition> "Status indicating a rule has been violated, breached, broken, or infracted"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Rule Violated"@en.
w3dpv:SMEOrganisation <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c;
                      <http://purl.org/dc/terms/created> "2024-12-01"^^xsd:date;
                      a rdfs:Class,
