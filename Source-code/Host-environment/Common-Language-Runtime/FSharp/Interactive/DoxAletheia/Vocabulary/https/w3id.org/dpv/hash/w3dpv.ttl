                         <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:technical-measures-classes;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Activity Monitoring"@en.
w3dpv:ActivityNotCompleted <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                           <http://purl.org/dc/terms/created> "2022-11-30"^^xsd:date;
                           a w3dpv:ActivityStatus,
                             <http://www.w3.org/2004/02/skos/core#Concept>,
                             rdfs:Class;
                           rdfs:isDefinedBy w3dpv:;
