                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Consumer Standard Form Contract"@en.
w3dpv:Context <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                     _:Ba2416326dc3d91dcd1256fc59ee2731f,
                                                     _:Baf7d74c4f8d058e7a1f817db63038c46,
                                                     _:Ba465069b0d9baa82d8b0bc064f94369f,
                                                     _:Bc914451e0ac3f4301e657f24e78ec8c6,
                                                     _:B134b75479df774569db6271449293ea2;
              <http://purl.org/dc/terms/created> "2019-04-05"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2022-06-15"^^xsd:date;
              a rdfs:Class,
                <http://www.w3.org/2004/02/skos/core#Concept>;
              rdfs:isDefinedBy w3dpv:;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
              <http://www.w3.org/2004/02/skos/core#definition> "Contextually relevant information"@en;
              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:context-classes;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Context"@en;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Context is a catch-all concept for information of relevance not possible to represent through other core concepts. DPV offers specific contextual concepts such as Necessity, Frequency, and Duration. More can be created by extending Context within use-cases."@en.
w3dpv:ContextuallyAnonymisedData <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                                 <http://purl.org/dc/terms/created> "2024-06-11"^^xsd:date;
                                 a <http://www.w3.org/2004/02/skos/core#Concept>,
                                   rdfs:Class;
                                 rdfs:isDefinedBy w3dpv:;
                                 rdfs:subClassOf w3dpv:PseudonymisedData;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PseudonymisedData;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Data that can be considered as being fully anonymised within the context but in actuality is not fully anonymised and is still personal data as it can be de-anonymised outside that context"@en;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Contextually Anonymised Data"@en;
                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "To distinguish between partially anonymised data that can be effectively treated as anonymised data (e.g. in processing) within a context (e.g. an organisation), the concept ContextuallyAnonymisedData should be used instead of AnonymisedData. Transfer of this data outside of the context should consider that it is not fully anonymised and that it is still personal data"@en.
w3dpv:ContinuousFrequency <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
