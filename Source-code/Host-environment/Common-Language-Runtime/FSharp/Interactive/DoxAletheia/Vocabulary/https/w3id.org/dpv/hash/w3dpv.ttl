                                  <http://www.w3.org/2004/02/skos/core#definition> "Use of cryptographic methods to restrict access and execution to trusted parties and code within a dedicated execution environment"@en;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:technical-measures-classes;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Trusted Execution Environment"@en.
w3dpv:UnacceptableRule <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                              _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                              _:B08d083b5138b7461471bee8584a27726,
                                                              _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                              _:B1317b1df403c3d8a0f15f964829f0d11,
                                                              _:B29bc11fedcb726098feeea009f5b976c;
                       <http://purl.org/dc/terms/created> "2025-06-19"^^xsd:date;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         rdfs:Class,
                         w3dpv:Rule;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Rule;
                       <http://www.w3.org/2004/02/skos/core#definition> "A rule that is unacceptable where it is not desirable if it occurs"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rules-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Unacceptable Rule"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> """Unacceptable is a subjective concept that enables specifying something is to be avoided as compared to \"acceptable\". By itself it does not signal any deterrence or prohibition - for which further specific concepts are defined"""@en.
w3dpv:UncategorisedData <http://purl.org/dc/terms/contributor> _:B7726889e1ec55eede55b01be3aefef6c,
                                                               _:Bb4025b4c989c25034fd54e030bd87587;
                        <http://purl.org/dc/terms/created> "2025-03-09"^^xsd:date;
                        a <http://www.w3.org/2004/02/skos/core#Concept>,
                          rdfs:Class;
                        rdfs:isDefinedBy w3dpv:;
                        rdfs:subClassOf w3dpv:Data;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                        <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Data;
                        <http://www.w3.org/2004/02/skos/core#definition> "Data whose categorisation is not known e.g. whether it is personal or non-personal data"@en;
                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Uncategorised Data"@en;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is intended for indicating that a legally relevant categorisation of data has not been made - specifically regarding whether it is personal data or not, but it can also be extended for other categorisations such as sensitive data or domain-specific confidential data"@en.
w3dpv:Unexpected <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                        _:Bb4025b4c989c25034fd54e030bd87587,
                                                        _:B29bc11fedcb726098feeea009f5b976c,
                                                        _:B4891803172dbcb772b94bd1e09c7b5ff;
                 <http://purl.org/dc/terms/created> "2024-05-10"^^xsd:date;
                 a w3dpv:ExpectationStatus,
                   <http://www.w3.org/2004/02/skos/core#Concept>,
                   rdfs:Class;
                 rdfs:isDefinedBy w3dpv:;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ExpectationStatus;
                 <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the specified context was unexpected i.e. not expected"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Unexpected"@en.
w3dpv:UninformedConsent <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                               _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                               _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                               _:Bb4025b4c989c25034fd54e030bd87587;
                        <http://purl.org/dc/terms/created> "2022-06-21"^^xsd:date;
                        a <http://www.w3.org/2004/02/skos/core#Concept>,
                          rdfs:Class,
                          w3dpv:LegalBasis;
                        rdfs:isDefinedBy w3dpv:;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                        <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Consent;
                        <http://www.w3.org/2004/02/skos/core#definition> "Consent that is uninformed i.e. without requirement to provide sufficient information to make a consenting decision"@en;
                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-types-classes;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Uninformed Consent"@en.
w3dpv:Unintended <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                        _:B29bc11fedcb726098feeea009f5b976c,
                                                        _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                        _:B4891803172dbcb772b94bd1e09c7b5ff;
                 <http://purl.org/dc/terms/created> "2024-05-10"^^xsd:date;
                 a rdfs:Class,
                   <http://www.w3.org/2004/02/skos/core#Concept>,
                   w3dpv:IntentionStatus;
                 rdfs:isDefinedBy w3dpv:;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:IntentionStatus;
                 <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the specified context was unintended i.e. not intended"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Unintended"@en.
w3dpv:UnknownApplicability <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                           <http://purl.org/dc/terms/created> "2023-08-24"^^xsd:date;
                           a w3dpv:Applicability,
                             <http://www.w3.org/2004/02/skos/core#Concept>,
                             rdfs:Class;
                           rdfs:isDefinedBy w3dpv:;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                           <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Applicability;
                           <http://www.w3.org/2004/02/skos/core#definition> "Concept indicating information or context availability is unknown i.e. it is not known if the information exists or is applicable and therefore statements about its availability cannot be made (yet)"@en;
                           <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:context-classes;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Unknown Applicability"@en;
                           <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is useful when describing situations where it cannot be stated whether the context applies or whether the information is not available yet. For example, if a form field asks about whether a process X was completed and it is not yet known whether X applies or not and therefore it is also unclear whether X was completed or not. Using UnknownApplicability is a signal that the applicability of X should be assessed, and if applicable, then information about X should be identified and used here."@en.
w3dpv:Unlawful <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
               <http://purl.org/dc/terms/created> "2022-10-19"^^xsd:date;
               a <http://www.w3.org/2004/02/skos/core#Concept>,
                 w3dpv:Lawfulness,
                 rdfs:Class;
               rdfs:isDefinedBy w3dpv:;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Lawfulness;
               <http://www.w3.org/2004/02/skos/core#definition> "State of being unlawful or legally non-compliant"@en;
               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Unlawful"@en.
w3dpv:UnstructuredData <http://purl.org/dc/terms/contributor> _:B7726889e1ec55eede55b01be3aefef6c,
                                                              _:Bb4025b4c989c25034fd54e030bd87587;
                       <http://purl.org/dc/terms/created> "2025-03-09"^^xsd:date;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         rdfs:Class;
                       rdfs:isDefinedBy w3dpv:;
                       rdfs:subClassOf w3dpv:Data;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Data;
                       <http://www.w3.org/2004/02/skos/core#definition> "Data that is without a predefined data model or is not organised in a pre-defined manner"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Unstructured Data"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is relevant to application of privacy/data protection regulations like GDPR as unstructured data may contain PII/personal data and it is useful to flag such data with unknown or incomplete modelling information for audits. It is also useful to flag data for potential quality issues"@en.
w3dpv:UntilEventDuration <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                         <http://purl.org/dc/terms/created> "2022-06-15"^^xsd:date;
