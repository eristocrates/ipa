w3dpv:HumanInvolved <http://purl.org/dc/terms/created> "2022-09-03"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                    a w3dpv:HumanInvolvement,
                      rdfs:Class,
                      <http://www.w3.org/2004/02/skos/core#Concept>;
                    rdfs:isDefinedBy w3dpv:;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                    <http://www.w3.org/2004/02/skos/core#definition> "Humans are involved in the specified context"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Human involved"@en;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept only indicates that humans are involved. For specific involvement, see specialised concepts e.g. involved for input, oversight."@en.
w3dpv:HumanInvolvement <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                       <http://purl.org/dc/terms/created> "2022-01-26"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2024-04-20"^^xsd:date;
                       <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0013>,
                                                            <https://w3id.org/dpv/examples#E0074>;
                       a rdfs:Class,
                         <http://www.w3.org/2004/02/skos/core#Concept>;
                       rdfs:isDefinedBy w3dpv:;
                       rdfs:subClassOf w3dpv:EntityInvolvement;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:EntityInvolvement;
                       <http://www.w3.org/2004/02/skos/core#definition> "The involvement of humans in specified context"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Human Involvement here broadly refers to any involvement by a human in the context of carrying out processing. This may include verification of outcomes, providing input data for making decisions, or overseeing activities. To indicate whether humans are involved or not, see relevant concepts of dpv:HumanInvolved and dpv:HumanNotInvolved. The term 'Human in the loop' and its varieties are absent from DPV due to their contradictory and non-compatible use across different sources."@en.
w3dpv:HumanInvolvementForControl <http://purl.org/dc/terms/created> "2022-09-04"^^xsd:date;
                                 <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                                 a rdfs:Class,
                                   <http://www.w3.org/2004/02/skos/core#Concept>,
                                   w3dpv:HumanInvolvement;
                                 rdfs:isDefinedBy w3dpv:;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of exercising control over the specified operations in context"@en;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for control"@en;
                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Control is a broad term that can be applied to various stages and operations. It maps to None, Assistive, and Partial automation models."@en.
w3dpv:HumanInvolvementForDecision <http://purl.org/dc/terms/created> "2022-09-06"^^xsd:date;
                                  <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                                  a w3dpv:HumanInvolvement,
                                    <http://www.w3.org/2004/02/skos/core#Concept>,
                                    rdfs:Class;
                                  rdfs:isDefinedBy w3dpv:;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                  <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of exercising decisions over the specified operations in context"@en;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for decision"@en;
                                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Decisions are about exercising control over the operation, and are distinct from input (data or parameters)."@en.
w3dpv:HumanInvolvementForInput <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                               <http://purl.org/dc/terms/created> "2022-09-07"^^xsd:date;
                               <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                               a w3dpv:HumanInvolvement,
                                 <http://www.w3.org/2004/02/skos/core#Concept>,
                                 rdfs:Class;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                               <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of providing inputs to the specified context"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for Input"@en;
                               <http://www.w3.org/2004/02/skos/core#scopeNote> "Inputs can be in the form of data or other resources."@en.
w3dpv:HumanInvolvementForIntervention <http://purl.org/dc/terms/created> "2022-09-05"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                                      a <http://www.w3.org/2004/02/skos/core#Concept>,
                                        rdfs:Class,
                                        w3dpv:HumanInvolvement;
                                      rdfs:isDefinedBy w3dpv:;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of exercising interventions over the specified operations in context"@en;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for intervention"@en;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Intervention indicates the ability to intervene in operations, which can be at various stages. It maps to Conditional and High automation models."@en.
w3dpv:HumanInvolvementForOversight <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                                   <http://purl.org/dc/terms/created> "2022-09-07"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                                   a rdfs:Class,
                                     <http://www.w3.org/2004/02/skos/core#Concept>,
                                     w3dpv:HumanInvolvement;
                                   rdfs:isDefinedBy w3dpv:;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of having oversight over the specified context regarding its operations, inputs, or outputs"@en;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for Oversight"@en;
                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Oversight by itself does not indicate the ability to intervene or control the operations."@en.
w3dpv:HumanInvolvementForVerification <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                                      <http://purl.org/dc/terms/created> "2022-09-07"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2023-12-10"^^xsd:date;
                                      a w3dpv:HumanInvolvement,
                                        rdfs:Class,
                                        <http://www.w3.org/2004/02/skos/core#Concept>;
                                      rdfs:isDefinedBy w3dpv:;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                                      <http://www.w3.org/2004/02/skos/core#definition> "Human involvement for the purposes of verification of specified context to ensure its operations, inputs, or outputs are correct or are acceptable."@en;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Involvement for Verification"@en;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Verification by itself does not imply ability to Control, Intervene, or having Oversight."@en.
w3dpv:HumanNotInvolved <http://purl.org/dc/terms/created> "2023-12-10"^^xsd:date;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         rdfs:Class,
                         w3dpv:HumanInvolvement;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanInvolvement;
                       <http://www.w3.org/2004/02/skos/core#definition> "Humans are not involved in the specified context"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Human not involved"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This maps to Autonomous and Full Automation models if no humans are involved."@en.
w3dpv:HumanResourceManagement <http://purl.org/dc/terms/contributor> _:B39a5f196e4ce742b655078f42dbb4759,
                                                                     _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                     _:B29bc11fedcb726098feeea009f5b976c,
                                                                     _:B08d083b5138b7461471bee8584a27726,
                                                                     _:Bb4025b4c989c25034fd54e030bd87587;
                              <http://purl.org/dc/terms/created> "2021-09-01"^^xsd:date;
                              <http://purl.org/dc/terms/source> _:B76b0611bfab2e11b788b040eb92ca4f6;
                              a <http://www.w3.org/2004/02/skos/core#Concept>,
                                rdfs:Class,
                                w3dpv:Purpose;
                              rdfs:isDefinedBy w3dpv:;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Purpose;
                              <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with managing humans and 'human resources' within the organisation for effective and efficient operations."@en;
                              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:purposes-classes;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Resource Management"@en;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "HR is a broad concept. Its management includes, amongst others - recruiting employees and intermediaries e.g. brokers, independent representatives; payroll administration, remunerations, commissions, and wages; and application of social legislation."@en.
w3dpv:HumanSubject <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                          _:Bb4025b4c989c25034fd54e030bd87587;
                   <http://purl.org/dc/terms/created> "2024-12-17"^^xsd:date;
                   <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0074>;
                   a rdfs:Class,
                     <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:isDefinedBy w3dpv:;
                   rdfs:subClassOf w3dpv:LegalEntity;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:LegalEntity;
                   <http://www.w3.org/2004/02/skos/core#definition> "The individual (or category of individuals) that is the subject within some context such as personal data (dpv:DataSubject) or technology (tech:Subject)"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:entities-datasubject-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Human Subject"@en.
w3dpv:HybridPublicPrivateSpace <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                      _:B29bc11fedcb726098feeea009f5b976c,
                                                                      _:B1317b1df403c3d8a0f15f964829f0d11,
                                                                      _:Bb4025b4c989c25034fd54e030bd87587;
                               <http://purl.org/dc/terms/created> "2025-04-07"^^xsd:date;
