                                                       _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                       _:Bb4025b4c989c25034fd54e030bd87587;
                <http://purl.org/dc/terms/created> "2021-09-22"^^xsd:date;
                a <http://www.w3.org/2004/02/skos/core#Concept>,
                  w3dpv:OrganisationalMeasure,
                  rdfs:Class;
                rdfs:isDefinedBy w3dpv:;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                <http://www.w3.org/2004/02/skos/core#broader> w3dpv:OrganisationalMeasure;
                <http://www.w3.org/2004/02/skos/core#definition> "A safeguard is a precautionary measure for the protection against or mitigation of negative effects"@en;
                <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Safeguard"@en;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept is relevant given the requirement to assert safeguards in cross-border data transfers"@en.
w3dpv:SafeguardForDataTransfer <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                                      _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                      _:B39a5f196e4ce742b655078f42dbb4759,
                                                                      _:B29bc11fedcb726098feeea009f5b976c;
                               <http://purl.org/dc/terms/created> "2021-09-22"^^xsd:date;
                               a rdfs:Class,
                                 w3dpv:OrganisationalMeasure,
                                 <http://www.w3.org/2004/02/skos/core#Concept>;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Safeguard;
                               <http://www.w3.org/2004/02/skos/core#definition> "Represents a safeguard used for data transfer. Can include technical or organisational measures."@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Safeguard for Data Transfer"@en.
w3dpv:Scale <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
