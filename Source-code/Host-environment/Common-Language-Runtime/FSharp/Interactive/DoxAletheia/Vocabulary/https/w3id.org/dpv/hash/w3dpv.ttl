                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Data;
                   <http://www.w3.org/2004/02/skos/core#definition> "Data directly or indirectly associated or related to an individual"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Personal Data"@en;
                   <http://www.w3.org/2004/02/skos/core#related> <https://specialprivacy.ercim.eu/langs/usage-policy#AnyData>;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "This definition of personal data encompasses the concepts used in GDPR Art.4-1 for 'personal data' and ISO/IEC 2700 for 'personally identifiable information (PII)'."@en.
w3dpv:PersonalDataAudit <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                               _:B4891803172dbcb772b94bd1e09c7b5ff;
                        <http://purl.org/dc/terms/created> "2024-12-17"^^xsd:date;
