                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:contract-status-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Activation Status"@en.
w3dpv:ContractActive <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                            _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:Ba7946b0ce44c504a47853c5ae5fff15a;
                     <http://purl.org/dc/terms/created> "2025-01-09"^^xsd:date;
                     a w3dpv:ContractActivationStatus,
                       rdfs:Class,
                       <http://www.w3.org/2004/02/skos/core#Concept>;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ContractActivationStatus;
                     <http://www.w3.org/2004/02/skos/core#definition> "Status representing contract that has been fully executed and whose terms are considered active i.e. they are applicable and are required to be performed"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:contract-status-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Contract Active"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "A contract being active only refers to its terms now being required to be fulfilled, while dpv:ContractBeingPerformed states that they are being performed"@en.
w3dpv:ContractAmended <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                             _:Bb4025b4c989c25034fd54e030bd87587,
                                                             _:B29bc11fedcb726098feeea009f5b976c;
                      <http://purl.org/dc/terms/created> "2025-01-09"^^xsd:date;
                      a rdfs:Class,
