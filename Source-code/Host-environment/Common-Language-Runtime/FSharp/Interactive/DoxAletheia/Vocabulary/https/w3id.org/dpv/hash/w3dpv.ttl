w3dpv:NonPersonalData <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                      <http://purl.org/dc/terms/created> "2022-01-19"^^xsd:date;
                      a <http://www.w3.org/2004/02/skos/core#Concept>,
                        rdfs:Class;
                      rdfs:isDefinedBy w3dpv:;
                      rdfs:subClassOf w3dpv:Data;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Data;
                      <http://www.w3.org/2004/02/skos/core#definition> "Data that is not Personal Data"@en;
                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-Personal Data"@en;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "The term NonPersonalData is provided to distinguish between PersonalData and other data, e.g. for indicating which data is regulated by privacy laws. To specify personal data that has been anonymised, the concept AnonymisedData should be used as the anonymisation process has a risk of not being fully effective and such anonymous data may be found to be personal data depending on circumstances."@en.
w3dpv:NonPersonalDataProcess <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                             <http://purl.org/dc/terms/created> "2024-05-09"^^xsd:date;
                             a rdfs:Class,
                               <http://www.w3.org/2004/02/skos/core#Concept>;
                             rdfs:isDefinedBy w3dpv:;
                             rdfs:subClassOf w3dpv:Process;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Process;
                             <http://www.w3.org/2004/02/skos/core#definition> "An action, activity, or method involving non-personal data, and asserting that no personal data is involved"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:process-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Non-Personal Data Process"@en;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "Use of personal data within NonPersonalDataProcess should be considered a violation of the explicit constraint that no personal data is involved."@en.
