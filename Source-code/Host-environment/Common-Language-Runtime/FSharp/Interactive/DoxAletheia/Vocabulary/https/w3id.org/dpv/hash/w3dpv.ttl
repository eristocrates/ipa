                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Data;
                    <http://www.w3.org/2004/02/skos/core#definition> "Data deemed sensitive"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensitive Data"@en.
w3dpv:SensitiveNonPersonalData <http://purl.org/dc/terms/created> "2024-02-14"^^xsd:date;
                               <http://purl.org/dc/terms/source> "DGA 30(a)"@en;
                               a <http://www.w3.org/2004/02/skos/core#Concept>,
                                 rdfs:Class;
                               rdfs:isDefinedBy w3dpv:;
                               rdfs:subClassOf w3dpv:SensitiveData;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:SensitiveData;
                               <http://www.w3.org/2004/02/skos/core#definition> "Non-personal data deemed sensitive"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensitive Non Personal Data"@en.
w3dpv:SensitivePersonalData <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                            <http://purl.org/dc/terms/created> "2022-01-19"^^xsd:date;
                            <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0010>,
                                                                 <https://w3id.org/dpv/examples#E0045>;
                            a rdfs:Class,
                              <http://www.w3.org/2004/02/skos/core#Concept>;
                            rdfs:isDefinedBy w3dpv:;
                            rdfs:subClassOf w3dpv:SensitiveData,
                                            w3dpv:PersonalData;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                            <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PersonalData,
                                                                          w3dpv:SensitiveData;
                            <http://www.w3.org/2004/02/skos/core#definition> "Personal data that is considered 'sensitive' in terms of privacy and/or impact, and therefore requires additional considerations and/or protection"@en;
                            <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensitive Personal Data"@en;
                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Sensitivity' is a matter of context, and may be defined within legal frameworks. For GDPR, Special categories of personal data are considered a subset of sensitive data. To illustrate the difference between the two, consider the situation where Location data is collected, and which is considered 'sensitive' but not 'special'. As a probable rule, sensitive data require additional considerations whereas special category data requires additional legal basis / justifications."@en.
w3dpv:SensitivityLevel <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                       <http://purl.org/dc/terms/created> "2023-08-24"^^xsd:date;
                       a rdfs:Class,
                         <http://www.w3.org/2004/02/skos/core#Concept>;
                       rdfs:isDefinedBy w3dpv:;
                       rdfs:subClassOf w3dpv:Severity;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Severity;
                       <http://www.w3.org/2004/02/skos/core#definition> "Sensitivity' reflects the risk of impact if not secured or utilised with appropriate measures and controls e.g. for sensitive data"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensitivity Level"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> """ISO/IEC TS 38505-3:2021 defines 'data sensitivity' as the potential harm of unauthorised disclosure. DPV's use of the concept goes beyond disclosure as it refers to the level of safeguards or controls the data requires as a reflection of its 'sensitive' nature. To indicate quantified levels of sensitivity, e.g. \"high sensitivity\", instances of severity can be directly used or specialised"""@en.
w3dpv:Service <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
              <http://purl.org/dc/terms/created> "2024-05-09"^^xsd:date;
              <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0031>,
                                                   <https://w3id.org/dpv/examples#E0041>;
              a rdfs:Class,
                <http://www.w3.org/2004/02/skos/core#Concept>;
              rdfs:isDefinedBy w3dpv:;
              rdfs:subClassOf w3dpv:Process;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Process;
              <http://www.w3.org/2004/02/skos/core#definition> "A service is a process where one entity provides some benefit or assistance to another entity"@en;
              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:process-classes;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Service"@en;
              <http://www.w3.org/2004/02/skos/core#scopeNote> "Service Provider and Service Consumer reflect the roles associated with a service. 'Service' as a process is a distinct concept from the use of 'service' as a provision method in Tech extension"@en.
w3dpv:ServiceConsumer <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
