w3dpv:EvaluationScoring <http://purl.org/dc/terms/contributor> _:Bc86b1cc0d93ccd3435a7a6803aab4850,
                                                               _:Bb4025b4c989c25034fd54e030bd87587;
                        <http://purl.org/dc/terms/created> "2020-11-04"^^xsd:date;
                        <http://purl.org/dc/terms/source> _:Ba99cf6837f22d365ec65cc9223e68624;
                        a rdfs:Class,
                          <http://www.w3.org/2004/02/skos/core#Concept>;
                        rdfs:isDefinedBy w3dpv:;
                        rdfs:subClassOf w3dpv:ProcessingContext;
