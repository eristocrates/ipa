                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataProcessor;
                       <http://www.w3.org/2004/02/skos/core#definition> "A 'sub-processor' is a processor engaged by another processor"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:entities-legalrole-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Sub-Processor"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "A 'Sub-Processor' is always a 'Processor' with the distinction of not directly being appointed by the 'Controller'"@en.
w3dpv:DataSubject <http://purl.org/dc/terms/contributor> _:Ba2416326dc3d91dcd1256fc59ee2731f,
                                                         _:Baf7d74c4f8d058e7a1f817db63038c46;
                  <http://purl.org/dc/terms/created> "2019-04-05"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2024-12-17"^^xsd:date;
                  <http://purl.org/dc/terms/source> _:B187da68f7e604e3cc779a2cfdcc6c185;
                  <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0074>,
                                                       <https://w3id.org/dpv/examples#E0039>;
                  a <http://www.w3.org/2004/02/skos/core#Concept>,
                    rdfs:Class;
                  rdfs:isDefinedBy w3dpv:;
                  rdfs:subClassOf w3dpv:HumanSubject;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "modified"@en;
                  <http://www.w3.org/2004/02/skos/core#broader> w3dpv:HumanSubject;
                  <http://www.w3.org/2004/02/skos/core#definition> "The individual (or category of individuals) whose personal data is being processed"@en;
                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:entities-datasubject-classes;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "The term 'data subject' is specific to the GDPR, but is functionally equivalent to the term 'individual associated with data' and the ISO/IEC term 'PII Principle'"@en.
w3dpv:DataSubjectContract <http://purl.org/dc/terms/created> "2023-12-10"^^xsd:date;
                          <http://purl.org/dc/terms/modified> "2024-08-27"^^xsd:date;
                          a w3dpv:LegalBasis,
                            <http://www.w3.org/2004/02/skos/core#Concept>,
                            rdfs:Class;
