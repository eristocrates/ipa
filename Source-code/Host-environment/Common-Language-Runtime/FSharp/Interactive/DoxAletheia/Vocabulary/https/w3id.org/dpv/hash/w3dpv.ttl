                                 w3dpv:Location,
                                 rdfs:Class;
                               rdfs:isDefinedBy w3dpv:;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PublicSpace,
                                                                             w3dpv:PrivateSpace;
                               <http://www.w3.org/2004/02/skos/core#definition> "A space that is a hybrid space i.e it has both public and private components - such as by having part of it be a private space or which is operated privately"@en;
                               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:jurisdiction-classes;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Hybrid Public Private Space"@en.
w3dpv:IPRManagement <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                           _:B29bc11fedcb726098feeea009f5b976c,
                                                           _:Bb4025b4c989c25034fd54e030bd87587;
                    <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                    <http://purl.org/dc/terms/source> "DGA 3.1.c"@en;
                    a <http://www.w3.org/2004/02/skos/core#Concept>,
                      rdfs:Class,
                      w3dpv:OrganisationalMeasure;
                    rdfs:isDefinedBy w3dpv:;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightsManagement;
                    <http://www.w3.org/2004/02/skos/core#definition> "Management of Intellectual Property Rights with a view to identify and safeguard and enforce them"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Intellectual Property Rights Management"@en.
w3dpv:IdentifyingPersonalData <http://purl.org/dc/terms/created> "2024-02-14"^^xsd:date;
                              a <http://www.w3.org/2004/02/skos/core#Concept>,
                                rdfs:Class;
                              rdfs:isDefinedBy w3dpv:;
                              rdfs:subClassOf w3dpv:PersonalData;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PersonalData;
                              <http://www.w3.org/2004/02/skos/core#definition> "Personal Data that explicitly and by itself is sufficient to identify a person"@en;
                              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:personal-data-classes;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Identifying Personal Data"@en;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "DPV does not use PII ('Personally Identifiable Information') as it has varying and conflicting definitions across sources. Instead the concept 'identifying personal data' is intended to provide a clear categorisation of its interpretation. Where multiple data categories can be combined to create an 'identifying' category e.g. fingerprinting, this concept represents the combined category."@en.
w3dpv:IdentityAuthentication <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                                    _:B29bc11fedcb726098feeea009f5b976c,
