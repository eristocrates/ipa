                         <http://www.w3.org/2004/02/skos/core#definition> "Purposes associated with scientific research"@en;
                         <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:purposes-classes;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Scientific Research"@en.
w3dpv:Scope <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
            <http://purl.org/dc/terms/created> "2022-06-15"^^xsd:date;
            a <http://www.w3.org/2004/02/skos/core#Concept>,
              rdfs:Class;
            rdfs:isDefinedBy w3dpv:;
