                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject Informed"@en.
w3dpv:DataSubjectRight <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B29bc11fedcb726098feeea009f5b976c,
                                                              _:B08d083b5138b7461471bee8584a27726;
                       <http://purl.org/dc/terms/created> "2020-11-18"^^xsd:date;
                       a rdfs:Class,
                         w3dpv:Right,
                         <http://www.w3.org/2004/02/skos/core#Concept>;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Right;
                       <http://www.w3.org/2004/02/skos/core#definition> "The rights applicable or provided to a Data Subject"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:rights-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject Right"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Based on use of definitions, the notion of 'Data Subject Right' can be equivalent to 'Individual Right' or 'Right of a Person'"@en.
w3dpv:DataSubjectRightsManagement <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                                         _:Bb4025b4c989c25034fd54e030bd87587,
                                                                         _:B29bc11fedcb726098feeea009f5b976c;
                                  <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                                  <http://purl.org/dc/terms/source> "DGA 12.m"@en;
                                  a <http://www.w3.org/2004/02/skos/core#Concept>,
                                    rdfs:Class,
                                    w3dpv:OrganisationalMeasure;
                                  rdfs:isDefinedBy w3dpv:;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                  <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightsManagement;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Methods to provide, implement, and exercise data subjects' rights"@en;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Subject Rights Management"@en;
                                  <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept only concerns the organisational management of rights, and does not represent the rights themselves - especially where such 'rights' are legally recognised or defined for the data subject or individual. The concept dpv:DataSubjectRight is provided to represent such legal rights."@en.
