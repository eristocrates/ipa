                       <http://purl.org/dc/terms/source> [<https://schema.org/url> "https://eur-lex.europa.eu/eli/reg/2016/679/art_4/par_5/oj" ; 
                                                          <https://schema.org/name> "GDPR Art.4-5" ; 
                                                          a <https://schema.org/WebPage>];
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         rdfs:Class,
                         w3dpv:TechnicalMeasure;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Deidentification;
                       <http://www.w3.org/2004/02/skos/core#definition> "Pseudonymisation means the processing of personal data in such a manner that the personal data can no longer be attributed to a specific data subject without the use of additional information, provided that such additional information is kept separately and is subject to technical and organisational measures to ensure that the personal data are not attributed to an identified or identifiable natural person;"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:technical-measures-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Pseudonymisation"@en.
