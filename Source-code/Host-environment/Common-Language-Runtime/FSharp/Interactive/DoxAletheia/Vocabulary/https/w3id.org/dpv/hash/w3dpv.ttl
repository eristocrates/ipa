w3dpv:ConsumerStandardFormContract <http://purl.org/dc/terms/created> "2024-08-27"^^xsd:date;
                                   a rdfs:Class,
                                     <http://www.w3.org/2004/02/skos/core#Concept>,
                                     w3dpv:LegalBasis;
