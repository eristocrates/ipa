w3dpv:AutomatedDecisionMaking <http://purl.org/dc/terms/contributor> _:Bc86b1cc0d93ccd3435a7a6803aab4850,
                                                                     _:Bb4025b4c989c25034fd54e030bd87587;
                              <http://purl.org/dc/terms/created> "2020-11-04"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2022-09-07"^^xsd:date;
                              <http://purl.org/dc/terms/source> _:Ba99cf6837f22d365ec65cc9223e68624;
                              a <http://www.w3.org/2004/02/skos/core#Concept>,
                                rdfs:Class;
                              rdfs:isDefinedBy w3dpv:;
                              rdfs:subClassOf w3dpv:DecisionMaking;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DecisionMaking;
                              <http://www.w3.org/2004/02/skos/core#definition> "Processing that involves automated decision making"@en;
                              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "Automated Decision Making"@en;
                              <http://www.w3.org/2004/02/skos/core#scopeNote> "Automated decision making can be defined as “the ability to make decisions by technological means without human involvement.” (“Guidelines on Automated individual decision-making and Profiling for the purposes of Regulation 2016/679 (wp251rev.01)”, 2018, p. 8)"@en.
w3dpv:AutomatedScoringOfIndividuals <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                                    <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                                    a <http://www.w3.org/2004/02/skos/core#Concept>,
                                      rdfs:Class,
                                      w3dpv:ScoringOfIndividuals;
                                    rdfs:isDefinedBy w3dpv:;
                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ScoringOfIndividuals;
                                    <http://www.w3.org/2004/02/skos/core#definition> "Processing that involves automated scoring of individuals"@en;
                                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Automated Scoring of Individuals"@en;
                                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Scoring can lead to the action being considered Decision Making if the scoring is itself a decision - see 2023-MAR-16 opinion of Advocate General on Case C 634/21. Therefore, the assessment of whether scoring was automated or not is important given the legal obligations surrounding automated decision making e.g. in GDPR"@en.
w3dpv:AutomationLevel <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                             _:Bb4025b4c989c25034fd54e030bd87587;
                      <http://purl.org/dc/terms/created> "2023-12-10"^^xsd:date;
