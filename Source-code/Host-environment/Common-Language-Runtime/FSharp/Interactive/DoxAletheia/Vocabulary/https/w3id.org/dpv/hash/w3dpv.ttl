                <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:context-classes;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Necessity"@en;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Necessity can be used to express need, essentiality, requirement, or compulsion."@en.
w3dpv:NegotiateContract <http://purl.org/dc/terms/created> "2024-08-27"^^xsd:date;
                        a <http://www.w3.org/2004/02/skos/core#Concept>,
                          rdfs:Class;
