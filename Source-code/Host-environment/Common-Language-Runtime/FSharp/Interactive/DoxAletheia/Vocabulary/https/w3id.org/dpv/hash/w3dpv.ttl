w3dpv:NotApplicable <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                    <http://purl.org/dc/terms/created> "2023-08-24"^^xsd:date;
                    a w3dpv:Applicability,
                      rdfs:Class,
