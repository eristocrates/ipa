                      <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0013>;
                      a rdfs:Class,
                        <http://www.w3.org/2004/02/skos/core#Concept>;
                      rdfs:isDefinedBy w3dpv:;
                      rdfs:subClassOf w3dpv:ProcessingContext;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ProcessingContext;
                      <http://www.w3.org/2004/02/skos/core#definition> "Indication of degree or level of automation associated with specified context"@en;
                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Automation Level"@en;
                      <http://www.w3.org/2004/02/skos/core#scopeNote> "This concept was called 'Automation' in previous versions"@en.
w3dpv:Autonomous <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                        _:Bb4025b4c989c25034fd54e030bd87587;
                 <http://purl.org/dc/terms/created> "2023-12-10"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2024-04-20"^^xsd:date;
                 <http://purl.org/dc/terms/source> _:B9829657dc90c3ac59322bf6bcf1e0cc6;
                 a rdfs:Class,
                   w3dpv:AutomationLevel,
                   <http://www.w3.org/2004/02/skos/core#Concept>;
                 rdfs:isDefinedBy w3dpv:;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:AutomationLevel;
                 <http://www.w3.org/2004/02/skos/core#definition> "Level of automation corresponding to Level 6 in ISO/IEC 22989:2022 where the automation in system is capable of modifying its operation domain or its goals without external intervention, control or oversight"@en;
                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-context-classes;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Autonomous"@en;
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Though Autonomous, such operations can still be associated with dpv:HumanInvolved e.g. for inputs, oversight or verification"@en.
