              a <http://www.w3.org/2004/02/skos/core#Concept>,
                w3dpv:LegalBasis,
                rdfs:Class;
              rdfs:isDefinedBy w3dpv:;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
              <http://www.w3.org/2004/02/skos/core#broader> w3dpv:LegalBasis;
              <http://www.w3.org/2004/02/skos/core#definition> "Consent of the Data Subject for specified process or activity"@en;
              <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:legal-basis-classes;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent"@en.
w3dpv:ConsentControl <http://purl.org/dc/terms/created> "2024-05-11"^^xsd:date;
                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                       rdfs:Class;
                     rdfs:isDefinedBy w3dpv:;
                     rdfs:subClassOf w3dpv:EntityInvolvement;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:EntityInvolvement;
                     <http://www.w3.org/2004/02/skos/core#definition> "The control or activity associated with obtaining, providing, withdrawing, or reaffirming consent"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-controls-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Control"@en.
w3dpv:ConsentExpired <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                            _:B29bc11fedcb726098feeea009f5b976c,
                                                            _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:B4891803172dbcb772b94bd1e09c7b5ff;
                     <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                     <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                     a w3dpv:ConsentStatus,
                       <http://www.w3.org/2004/02/skos/core#Concept>,
                       rdfs:Class;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                     <http://www.w3.org/2004/02/skos/core#definition> "The state where the temporal or contextual validity of consent has 'expired'"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Expired"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the obtained consent has been assigned a duration - which has lapsed or 'expired', making it invalid to be used further for processing data"@en.
w3dpv:ConsentGiven <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                          _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                          _:B29bc11fedcb726098feeea009f5b976c,
                                                          _:B4891803172dbcb772b94bd1e09c7b5ff;
                   <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                   <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                   a <http://www.w3.org/2004/02/skos/core#Concept>,
                     w3dpv:ConsentStatus,
                     rdfs:Class;
                   rdfs:isDefinedBy w3dpv:;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusValidForProcessing;
                   <http://www.w3.org/2004/02/skos/core#definition> "The state where consent has been given"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Given"@en;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the individual clicks on a button, ticks a checkbox, verbally agrees - or any other form that communicates their decision agreeing to the processing of data"@en.
w3dpv:ConsentInvalidated <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                _:B29bc11fedcb726098feeea009f5b976c,
                                                                _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                _:Bb4025b4c989c25034fd54e030bd87587;
                         <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                         <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                         a w3dpv:ConsentStatus,
                           <http://www.w3.org/2004/02/skos/core#Concept>,
                           rdfs:Class;
                         rdfs:isDefinedBy w3dpv:;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                         <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                         <http://www.w3.org/2004/02/skos/core#definition> "The state where consent has been deemed to be invalid"@en;
                         <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Invalidated"@en;
                         <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is where an investigating authority or a court finds the collected consent did not meet requirements, and 'invalidates' both prior and future uses of it to carry out processing"@en.
w3dpv:ConsentManagement <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726,
                                                               _:Bb4025b4c989c25034fd54e030bd87587,
                                                               _:B29bc11fedcb726098feeea009f5b976c;
                        <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
                        <http://purl.org/dc/terms/source> "DGA 12.n"@en;
                        a <http://www.w3.org/2004/02/skos/core#Concept>,
                          w3dpv:OrganisationalMeasure,
                          rdfs:Class;
                        rdfs:isDefinedBy w3dpv:;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                        <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PermissionManagement;
                        <http://www.w3.org/2004/02/skos/core#definition> "Methods to obtain, provide, modify, and withdraw consent along with maintaining a record of consent, retrieving records, and processing changes in consent states"@en;
                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Management"@en.
w3dpv:ConsentNotice <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                           _:B29bc11fedcb726098feeea009f5b976c,
                                                           _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                           _:B4891803172dbcb772b94bd1e09c7b5ff;
                    <http://purl.org/dc/terms/created> "2022-06-21"^^xsd:date;
                    <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0072>;
                    a rdfs:Class,
                      <http://www.w3.org/2004/02/skos/core#Concept>,
                      w3dpv:OrganisationalMeasure;
                    rdfs:isDefinedBy w3dpv:;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:PrivacyNotice;
                    <http://www.w3.org/2004/02/skos/core#definition> "A Notice for information provision associated with Consent"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:notice-classes,
                                                                   w3dpv:organisational-measures-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Notice"@en.
w3dpv:ConsentReceipt <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                     <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                       w3dpv:OrganisationalMeasure,
                       rdfs:Class;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentRecord;
                     <http://www.w3.org/2004/02/skos/core#definition> "A record of consent or consent related activities that is provided to another entity"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Receipt"@en.
w3dpv:ConsentRecord <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                           _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                           _:Bb4025b4c989c25034fd54e030bd87587,
                                                           _:Ba7946b0ce44c504a47853c5ae5fff15a;
                    <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                    <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0023>,
                                                         <https://w3id.org/dpv/examples#E0016>;
                    a <http://www.w3.org/2004/02/skos/core#Concept>,
                      w3dpv:OrganisationalMeasure,
                      rdfs:Class;
                    rdfs:isDefinedBy w3dpv:;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:DataProcessingRecord;
                    <http://www.w3.org/2004/02/skos/core#definition> "A Record of Consent or Consent related activities"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:organisational-measures-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Record"@en.
w3dpv:ConsentRefused <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                            _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:B29bc11fedcb726098feeea009f5b976c,
                                                            _:B4891803172dbcb772b94bd1e09c7b5ff;
                     <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                     <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                     a rdfs:Class,
                       <http://www.w3.org/2004/02/skos/core#Concept>,
                       w3dpv:ConsentStatus;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                     <http://www.w3.org/2004/02/skos/core#definition> "The state where consent has been refused"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Refused"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the individual clicks on a 'disagree' or 'reject' or 'refuse' button, or leaves a checkbox unticked"@en.
w3dpv:ConsentRequestDeferred <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                                    _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                    _:Bb4025b4c989c25034fd54e030bd87587,
                                                                    _:B4891803172dbcb772b94bd1e09c7b5ff;
                             <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                             <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                             a w3dpv:ConsentStatus,
                               rdfs:Class,
                               <http://www.w3.org/2004/02/skos/core#Concept>;
                             rdfs:isDefinedBy w3dpv:;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                             <http://www.w3.org/2004/02/skos/core#definition> "State where a request for consent has been deferred without a decision"@en;
                             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Request Deferred"@en;
                             <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when the individual closes or dismisses a notice without making a decision. This state is intended for making the distinction between a notice being provided (as a consent request) and the individual interacting with the notice without making a decision - where the 'ignoring of a notice' is taken as consent being neither given nor refused"@en.
w3dpv:ConsentRequested <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                              _:B29bc11fedcb726098feeea009f5b976c,
                                                              _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:B4891803172dbcb772b94bd1e09c7b5ff;
                       <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                       <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                       a <http://www.w3.org/2004/02/skos/core#Concept>,
                         w3dpv:ConsentStatus,
                         rdfs:Class;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                       <http://www.w3.org/2004/02/skos/core#definition> "State where a request for consent has been made and is awaiting a decision"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Requested"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when a notice has been presented to the individual but they have not made a decision"@en.
w3dpv:ConsentRevoked <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                            _:B29bc11fedcb726098feeea009f5b976c,
                                                            _:Ba7946b0ce44c504a47853c5ae5fff15a;
                     <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                     <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                       w3dpv:ConsentStatus,
                       rdfs:Class;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                     <http://www.w3.org/2004/02/skos/core#definition> "The state where the consent is revoked by an entity other than the data subject and which prevents it from being further used as a valid state"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Revoked"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "An example of this state is when a Data Controller stops utilising previously obtaining consent, such as when that service no longer exists"@en.
w3dpv:ConsentStatus <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                           _:Bb4025b4c989c25034fd54e030bd87587,
                                                           _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                           _:B4891803172dbcb772b94bd1e09c7b5ff;
                    <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                    <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                    a <http://www.w3.org/2004/02/skos/core#Concept>,
                      rdfs:Class;
                    rdfs:isDefinedBy w3dpv:;
                    rdfs:subClassOf w3dpv:Status;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                    <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Status;
                    <http://www.w3.org/2004/02/skos/core#definition> "The state or status of 'consent' that provides information reflecting its operational status and validity for processing data"@en;
                    <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Status"@en;
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "States are useful as information artefacts to implement them in controlling processing, and to reflect the process and flow of obtaining and maintaining consent. For example, a database table that stores consent states for specific processing and can be queried to obtain them in an efficient manner. States are also useful in investigations to determine the use and validity of consenting practices"@en.
w3dpv:ConsentStatusInvalidForProcessing <http://purl.org/dc/terms/contributor> _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                               _:B29bc11fedcb726098feeea009f5b976c,
                                                                               _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                               _:Bb4025b4c989c25034fd54e030bd87587;
                                        <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                                        <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                                        a <http://www.w3.org/2004/02/skos/core#Concept>,
                                          w3dpv:ConsentStatus,
                                          rdfs:Class;
                                        rdfs:isDefinedBy w3dpv:;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                        <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatus;
                                        <http://www.w3.org/2004/02/skos/core#definition> "States of consent that cannot be used as valid justifications for processing data"@en;
                                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Status Invalid for Processing"@en;
                                        <http://www.w3.org/2004/02/skos/core#scopeNote> "This identifies the stages associated with consent that should not be used to process data"@en.
w3dpv:ConsentStatusValidForProcessing <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                             _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                             _:Bb4025b4c989c25034fd54e030bd87587,
                                                                             _:B29bc11fedcb726098feeea009f5b976c;
                                      <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                                      <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                                      a rdfs:Class,
                                        <http://www.w3.org/2004/02/skos/core#Concept>,
                                        w3dpv:ConsentStatus;
                                      rdfs:isDefinedBy w3dpv:;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                      <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatus;
                                      <http://www.w3.org/2004/02/skos/core#definition> "States of consent that can be used as valid justifications for processing data"@en;
                                      <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Status Valid for Processing"@en;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Practically, given consent is the only valid state for processing"@en.
w3dpv:ConsentUnknown <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                            _:B29bc11fedcb726098feeea009f5b976c,
                                                            _:Bb4025b4c989c25034fd54e030bd87587,
                                                            _:B4891803172dbcb772b94bd1e09c7b5ff;
                     <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                     <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                       rdfs:Class,
                       w3dpv:ConsentStatus;
                     rdfs:isDefinedBy w3dpv:;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                     <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                     <http://www.w3.org/2004/02/skos/core#definition> "State where information about consent is not available or is unknown"@en;
                     <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Unknown"@en;
                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Consent states can be unknown, for example, when information is not available, or cannot be trusted, or is known to be inaccurate"@en.
w3dpv:ConsentWithdrawn <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                              _:B29bc11fedcb726098feeea009f5b976c,
                                                              _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                              _:Bb4025b4c989c25034fd54e030bd87587;
                       <http://purl.org/dc/terms/created> "2022-06-22"^^xsd:date;
                       <http://purl.org/dc/terms/source> _:B065a01047e132090ed8dbdf49275d462;
                       a rdfs:Class,
                         w3dpv:ConsentStatus,
                         <http://www.w3.org/2004/02/skos/core#Concept>;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ConsentStatusInvalidForProcessing;
                       <http://www.w3.org/2004/02/skos/core#definition> "The state where the consent is withdrawn or revoked specifically by the data subject and which prevents it from being further used as a valid state"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-status-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Consent Withdrawn"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "This state can be considered a form of 'revocation' of consent, where the revocation can only be performed by the data subject. Therefore we suggest using ConsentRevoked when it is a non-data-subject entity, and ConsentWithdrawn when it is the data subject"@en.
