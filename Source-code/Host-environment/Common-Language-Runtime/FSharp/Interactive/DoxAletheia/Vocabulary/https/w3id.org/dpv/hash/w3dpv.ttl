                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Evaluation and Scoring"@en.
w3dpv:ExpectationStatus <http://purl.org/dc/terms/contributor> _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                               _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                               _:Bb4025b4c989c25034fd54e030bd87587,
                                                               _:B29bc11fedcb726098feeea009f5b976c;
                        <http://purl.org/dc/terms/created> "2024-05-10"^^xsd:date;
                        a rdfs:Class,
                          <http://www.w3.org/2004/02/skos/core#Concept>;
                        rdfs:isDefinedBy w3dpv:;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> "Status indicating whether the specified context was intended or unintended"@en;
                        <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Expectation Status"@en;
                        <http://www.w3.org/2004/02/skos/core#scopeNote> "Expectation is associated with the outcome of a goal or purpose for what is expected to happen i.e. an ex-post indication of what was expected to happen in the specified context. Intention and Expectation are closely related terms. We recommend using Intention when the entity has the ability to control the implementation and Expectation for when the entity does not have control or for what happens after or beyond the exercise of control."@en.
w3dpv:Expected <http://purl.org/dc/terms/contributor> _:B16e5ae55fcfd5b0dea0ff5bc84ea73e7,
                                                      _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                      _:Bb4025b4c989c25034fd54e030bd87587,
                                                      _:B29bc11fedcb726098feeea009f5b976c;
               <http://purl.org/dc/terms/created> "2024-05-10"^^xsd:date;
               a <http://www.w3.org/2004/02/skos/core#Concept>,
                 rdfs:Class,
                 w3dpv:ExpectationStatus;
               rdfs:isDefinedBy w3dpv:;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
               <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ExpectationStatus;
               <http://www.w3.org/2004/02/skos/core#definition> "Status indicating the specified context was expected"@en;
               <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:status-classes;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Expected"@en.
w3dpv:ExplicitlyExpressedConsent <http://purl.org/dc/terms/contributor> _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                                        _:B4891803172dbcb772b94bd1e09c7b5ff,
                                                                        _:Bb4025b4c989c25034fd54e030bd87587,
                                                                        _:B29bc11fedcb726098feeea009f5b976c;
                                 <http://purl.org/dc/terms/created> "2022-06-21"^^xsd:date;
                                 <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0018>;
                                 a <http://www.w3.org/2004/02/skos/core#Concept>,
                                   w3dpv:LegalBasis,
                                   rdfs:Class;
                                 rdfs:isDefinedBy w3dpv:;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                                 <http://www.w3.org/2004/02/skos/core#broader> w3dpv:ExpressedConsent;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Consent that is expressed through an explicit action solely conveying a consenting decision"@en;
                                 <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-types-classes;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Explicitly Expressed Consent"@en;
                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Explicitly expressed consent is a more specific form of Expressed consent where the action taken must 'explicitly' relate to only the consent decision. Expressed consent where the consenting is part of other matters therefore cannot satisfy the requirements of explicitly expressed consent. An example of explicit action expressing the consenting decision is a button on a web form where the form only relates to consent, or it is accompanied with suitable text that reiterates what the consenting decision is about"@en.
w3dpv:Export <http://purl.org/dc/terms/contributor> _:B08d083b5138b7461471bee8584a27726;
             <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
             <http://purl.org/dc/terms/source> "DGA 2.20"@en;
             a w3dpv:Processing,
               <http://www.w3.org/2004/02/skos/core#Concept>,
               rdfs:Class;
             rdfs:isDefinedBy w3dpv:;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
             <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Disclose;
             <http://www.w3.org/2004/02/skos/core#definition> "to provide a copy of data from one system to another"@en;
             <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-classes;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Export"@en.
w3dpv:ExpressedConsent <http://purl.org/dc/terms/contributor> _:B29bc11fedcb726098feeea009f5b976c,
                                                              _:Bb4025b4c989c25034fd54e030bd87587,
                                                              _:Ba7946b0ce44c504a47853c5ae5fff15a,
                                                              _:B4891803172dbcb772b94bd1e09c7b5ff;
                       <http://purl.org/dc/terms/created> "2022-06-21"^^xsd:date;
                       <http://purl.org/vocab/vann/example> <https://w3id.org/dpv/examples#E0018>;
                       a rdfs:Class,
                         <http://www.w3.org/2004/02/skos/core#Concept>,
                         w3dpv:LegalBasis;
                       rdfs:isDefinedBy w3dpv:;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                       <http://www.w3.org/2004/02/skos/core#broader> w3dpv:InformedConsent;
                       <http://www.w3.org/2004/02/skos/core#definition> "Consent that is expressed through an action intended to convey a consenting decision"@en;
                       <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:consent-types-classes;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Expressed Consent"@en;
                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Expressed consent requires the individual take a specific and unambiguous action that directly indicates their consent. This action may be a part of other processes such as setting preferences, or agreeing to a contract, or other matters not relating to consent. An example of expressed consent is interacting with a checkbox within a dashboard or clicking a button on a web form"@en.
w3dpv:FRIA <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
           <http://purl.org/dc/terms/created> "2024-04-14"^^xsd:date;
           <http://purl.org/dc/terms/source> "AI Act Art.27"@en;
           a <http://www.w3.org/2004/02/skos/core#Concept>,
             w3dpv:OrganisationalMeasure,
             rdfs:Class;
           rdfs:isDefinedBy w3dpv:;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
           <http://www.w3.org/2004/02/skos/core#broader> w3dpv:RightsImpactAssessment;
           <http://www.w3.org/2004/02/skos/core#definition> "Impact assessment which assesses the potential and actual impact on fundamental rights occurring due to processing activities"@en;
           <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:risk-classes;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Fundamental Rights Impact Assessment (FRIA)"@en;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "The fundamental rights and freedoms may be those defined in law or other norms, and may be bound to a jurisdiction - for example see EU Charter of Fundamental Rights"@en.
w3dpv:FederatedLocations <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                         <http://purl.org/dc/terms/created> "2022-06-15"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2020-10-05"^^xsd:date;
                         a rdfs:Class,
                           <http://www.w3.org/2004/02/skos/core#Concept>,
                           w3dpv:LocationFixture;
                         rdfs:isDefinedBy w3dpv:;
