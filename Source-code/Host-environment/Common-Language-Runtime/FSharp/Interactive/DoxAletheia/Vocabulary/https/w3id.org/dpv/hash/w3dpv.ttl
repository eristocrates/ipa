                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "accepted"@en;
                   <http://www.w3.org/2004/02/skos/core#broader> w3dpv:Transform;
                   <http://www.w3.org/2004/02/skos/core#definition> "to replace personal identifiable information by artificial identifiers"@en;
                   <http://www.w3.org/2004/02/skos/core#inScheme> w3dpv:processing-classes;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Pseudonymise"@en.
w3dpv:PseudonymisedData <http://purl.org/dc/terms/contributor> _:Bb4025b4c989c25034fd54e030bd87587;
                        <http://purl.org/dc/terms/created> "2022-01-19"^^xsd:date;
