                           skos:inScheme dpv:organisational-measures-classes;
                           skos:prefLabel "Review Impact Assessment"@en.
dpv:ReviewProcedure dcterms:contributor _:Bb4025b4c989c25034fd54e030bd87587,
                                        _:B29bc11fedcb726098feeea009f5b976c;
                    dcterms:created "2022-10-22"^^xsd:date;
