              dpv:HumanSubject,
              rdfs:Class;
            rdfs:isDefinedBy dpv:;
            status:term_status "modified"@en;
            skos:broader dpv:HumanSubject;
            skos:definition "Humans that are tourists i.e. not citizens and not immigrants"@en;
