                         rdfs:isDefinedBy dpv:;
                         status:term_status "accepted"@en;
                         skos:broader dpv:RecordsOfActivities;
                         skos:definition "Record of data processing, whether ex-ante or ex-post"@en;
                         skos:inScheme dpv:organisational-measures-classes;
                         skos:prefLabel "Data Processing Record"@en.
dpv:DataProcessor dcterms:contributor _:Bb4025b4c989c25034fd54e030bd87587;
                  dcterms:created "2019-06-04"^^xsd:date;
                  dcterms:source [schemas:url "https://eur-lex.europa.eu/eli/reg/2016/679/art_4/par_8/oj" ; 
                                  schemas:name "GDPR Art.4-8" ; 
