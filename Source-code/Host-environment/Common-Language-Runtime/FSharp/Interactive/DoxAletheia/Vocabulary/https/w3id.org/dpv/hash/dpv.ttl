                     dcterms:created "2019-04-05"^^xsd:date;
                     dcterms:modified "2022-11-24"^^xsd:date;
                     dcterms:source [schemas:url "https://eur-lex.europa.eu/eli/reg/2016/679/art_4/par_5/oj" ; 
