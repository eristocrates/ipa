dpv:SensitiveNonPersonalData dcterms:created "2024-02-14"^^xsd:date;
                             dcterms:source "DGA 30(a)"@en;
                             a skos:Concept,
                               rdfs:Class;
                             rdfs:isDefinedBy dpv:;
                             rdfs:subClassOf dpv:SensitiveData;
                             status:term_status "accepted"@en;
                             skos:broader dpv:SensitiveData;
                             skos:definition "Non-personal data deemed sensitive"@en;
