dpv:DataJurisdictionPolicy dcterms:contributor _:Bb4025b4c989c25034fd54e030bd87587;
                           dcterms:created "2024-04-14"^^xsd:date;
                           a skos:Concept,
                             dpv:OrganisationalMeasure,
                             rdfs:Class;
                           rdfs:isDefinedBy dpv:;
                           status:term_status "accepted"@en;
                           skos:broader dpv:DataProcessingPolicy;
