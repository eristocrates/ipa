                         <http://www.w3.org/2004/02/skos/core#definition> "Points the CAEX file to the Instance Hierarchy"@en;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInstanceHierarchy"@en.
aml:hasInterface a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:range aml:InterfaceClass.
aml:hasInterfaceClass a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain aml:InterfaceClassLib;
                      rdfs:range aml:InterfaceClass;
                      <http://www.w3.org/2004/02/skos/core#definition> "Model the relation between Interface Class Lib and Interface Class"@en;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInterfaceClass"@en.
