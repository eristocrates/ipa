aml:hasSupportedRoleClassSUC a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:domain aml:SystemUnitClass;
                             rdfs:range aml:RoleClass;
                             rdfs:subPropertyOf aml:hasSupportedRoleClass.
aml:hasSystemUnitClass a <http://www.w3.org/2002/07/owl#ObjectProperty>;
