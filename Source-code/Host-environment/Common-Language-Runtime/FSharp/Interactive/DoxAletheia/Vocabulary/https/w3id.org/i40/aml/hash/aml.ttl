aml:hasInternalElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain aml:InstanceHierarchy;
                       rdfs:range aml:InternalElement;
                       <http://www.w3.org/2004/02/skos/core#definition> "Hierarchy has many internal elements"@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "hasInternalElement"@en.
aml:hasInternalLink a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain aml:InternalElement;
