                     rdfs:domain aml:Attribute;
                     rdfs:range rdf:PlainLiteral;
                     rdfs:subPropertyOf aml:hasName.
aml:hasNameFile a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
