aml:isConnectedToEClass a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        <http://www.w3.org/2004/02/skos/core#definition> "Points to the eCl@ass connection for a given element"@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "eClassIsConnectedTo"@en.
aml:isPartOfIC a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:domain aml:InterfaceClass;
