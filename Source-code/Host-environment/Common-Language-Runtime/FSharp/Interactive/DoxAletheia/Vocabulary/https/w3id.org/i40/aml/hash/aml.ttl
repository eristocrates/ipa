                        <http://www.w3.org/2004/02/skos/core#definition> "Stores the name of the parent class"@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "refBaseClassPath"@en.
aml:hasRefBaseClassPathIC a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain aml:InterfaceClass;
