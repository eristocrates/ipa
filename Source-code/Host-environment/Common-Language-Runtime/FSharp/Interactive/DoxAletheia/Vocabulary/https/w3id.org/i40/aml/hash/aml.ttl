                    <http://www.w3.org/2004/02/skos/core#prefLabel> "has Project Release",
                                                                    "hasProjectTitle"@en.
aml:hasRefBaseClassPath a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain aml:ExternalInterface,
                                    aml:InterfaceClass,
