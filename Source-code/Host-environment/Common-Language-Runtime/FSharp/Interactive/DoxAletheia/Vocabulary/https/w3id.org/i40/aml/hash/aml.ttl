aml:hasExternalReferenceAlias a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain aml:ExternalReference;
                              rdfs:range xsd:string;
                              <http://www.w3.org/2004/02/skos/core#definition> "A external Reference of a CAEX File has Alias";
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "externalReferenceAlias"@en.
aml:hasExternalReferencePath a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain aml:ExternalReference;
                             rdfs:range xsd:string;
                             <http://www.w3.org/2004/02/skos/core#definition> "A external Reference of a CAEX File contains path to the file";
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "externalReferencePath"@en.
aml:hasICID a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "Unique ID for the Interface Class"@en;
            rdfs:domain aml:InterfaceClass;
            rdfs:range xsd:string;
            rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/identifier>.
aml:hasIDIE a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:domain aml:InternalElement;
            rdfs:range xsd:string;
            rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/identifier>;
            <http://www.w3.org/2004/02/skos/core#definition> "Unique Id of an Internal Element"@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "internalElementId"@en.
aml:hasIRDIeClass a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
