              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNameIE"@en.
aml:hasNameIH a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain aml:InstanceHierarchy;
              rdfs:range rdf:PlainLiteral;
              rdfs:subPropertyOf aml:hasName;
              <http://www.w3.org/2004/02/skos/core#altLabel> "hasInstanceHierarchyName"@en;
              <http://www.w3.org/2004/02/skos/core#definition> "Given Name of the Instance Hierarchy"@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNameIH"@en.
aml:hasNameRC a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
