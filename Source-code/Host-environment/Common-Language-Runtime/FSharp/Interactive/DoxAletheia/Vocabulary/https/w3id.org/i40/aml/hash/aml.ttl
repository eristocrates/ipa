               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasNameSUC"@en.
aml:hasProject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain aml:AdditionalInformation;
               rdfs:range aml:Project;
               <http://www.w3.org/2004/02/skos/core#definition> "Related Project for the CAEX File"@en;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hasProject"@en.
