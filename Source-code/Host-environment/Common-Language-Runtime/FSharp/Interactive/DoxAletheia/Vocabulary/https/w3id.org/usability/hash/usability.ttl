                                    [<http://www.w3.org/2002/07/owl#onClass> usability:Image ; 
                                     <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> usability:hasImage ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minInclusive 0.000000e+0]) ; 
                                                                                  <http://www.w3.org/2002/07/owl#onDatatype> xsd:double ; 
                                                                                  a rdfs:Datatype] ; 
                                     <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> usability:hasMinWidth ; 
