                                    "wasPerformedBy"@en;
                         rdfs:range usability:User.
usability:wasPerformedOn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Связывает сессию с устройством, на котором она выполнялась"@ru,
                                      "The property that associates a session with the device on which the session was run"@en;
                         rdfs:domain usability:Session;
                         rdfs:label "былаВыполненаНа"@ru,
                                    "wasPerformedOn"@en;
                         rdfs:range usability:Device;
                         <http://www.w3.org/2002/07/owl#inverseOf> usability:wasUsedIn.
usability:wasUsedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Связывает устройство с сессиями, которые были на нем запущены"@ru,
                                 "The property that associates a device with the sessions which were run on that device"@en;
                    rdfs:domain usability:Device;
                    rdfs:label "былоИспользованоВ"@ru,
                               "wasUsedIn"@en;
                    rdfs:range usability:Session.
