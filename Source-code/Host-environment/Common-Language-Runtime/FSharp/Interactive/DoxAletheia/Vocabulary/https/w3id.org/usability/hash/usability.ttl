                            rdfs:label "связанаС"@ru,
                                       "wasAssociatedWith"@en;
                            <http://www.w3.org/2002/07/owl#inverseOf> usability:wasInvokedIn.
usability:wasImaged a <http://www.w3.org/2002/07/owl#ObjectProperty>;
