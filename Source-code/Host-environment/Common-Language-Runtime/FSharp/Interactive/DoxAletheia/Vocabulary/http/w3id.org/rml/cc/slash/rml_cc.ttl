@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rml_cc: <http://w3id.org/rml/cc/>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/ontology/bibo/status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/rml/GatherMap> a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Denotes a term map that generates a collection (rdf:List) or container (rdf:Bag, rdf:Seq, rdf:Alt)."@en;
                                rdfs:isDefinedBy rml_cc:;
                                rdfs:label "Gather Map";
                                rdfs:subClassOf <http://w3id.org/rml/TermMap>.
<http://w3id.org/rml/Strategy> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/rml/TermMap> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/rml/allowEmptyListAndContainer> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                 rdfs:comment "Indicates the behavior of a GatherMap in case rml:gather does not yield any element"@en;
                                                 rdfs:domain <http://w3id.org/rml/GatherMap>;
                                                 rdfs:isDefinedBy rml_cc:;
                                                 rdfs:label "allow empty list and container";
                                                 rdfs:range xsd:boolean.
<http://w3id.org/rml/append> a <http://w3id.org/rml/Strategy>,
                               <http://www.w3.org/2002/07/owl#NamedIndividual>;
                             rdfs:comment "Informs that the sets of RDF terms generated by each TermMap of the GatherMap are to be appended within the collection or container."@en;
                             rdfs:isDefinedBy rml_cc:;
                             rdfs:label "Append".
<http://w3id.org/rml/cartessianProduct> a <http://w3id.org/rml/Strategy>,
                                          <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                        rdfs:comment "Informs that the RDF terms generated by each TermMap of the GatherMap are to be grouped (in the constructed collection or container) by doing a cartesian product of these terms."@en;
                                        rdfs:isDefinedBy rml_cc:;
                                        rdfs:label "Cartessian Product".
rml_cc: <http://purl.org/dc/terms/contributor> "Christophe Debruyne",
                                               "Ana Iglesias Molina",
                                               "Franck Michel";
        <http://purl.org/dc/terms/created> "2023-03-14";
        <http://purl.org/dc/terms/description> "RML module to generate RDF collections and containers"@en;
        <http://purl.org/dc/terms/license> <http://purl.org/NET/rdflicense/cc-by4.0>;
        <http://purl.org/dc/terms/modified> "2023-06-15";
        <http://purl.org/dc/terms/publisher> <https://www.w3.org/community/kg-construct/>;
        <http://purl.org/dc/terms/title> "RML-Containers"@en;
        <http://purl.org/ontology/bibo/status> "draft";
        <http://purl.org/vocab/vann/preferredNamespacePrefix> "rml";
        <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/rml/";
        a <http://www.w3.org/2002/07/owl#Ontology>;
        <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/rml/cc>;
        <http://www.w3.org/2002/07/owl#versionInfo> "0.1.0".
<http://w3id.org/rml/gather> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Specifies where the terms of a collection or container come from."@en;
                             rdfs:domain <http://w3id.org/rml/GatherMap>;
                             rdfs:isDefinedBy rml_cc:;
                             rdfs:label "gather".
<http://w3id.org/rml/gatherAs> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Relates a GatherMap with the desired result type of collection or container."@en;
                               rdfs:domain <http://w3id.org/rml/GatherMap>;
                               rdfs:isDefinedBy rml_cc:;
                               rdfs:label "gather as";
                               rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> (rdf:Alt
                                                                                  rdf:Bag
                                                                                  rdf:List
                                                                                  rdf:Seq) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>].
<http://www.linkedmodel.org/schema/vaem#acronym> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdf:Alt a <http://www.w3.org/2002/07/owl#NamedIndividual>.
rdf:Bag a <http://www.w3.org/2002/07/owl#NamedIndividual>.
rdf:List a <http://www.w3.org/2002/07/owl#NamedIndividual>.
rdf:Seq a <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
