@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix te: <http://www.w3.org/2006/time-entry#>.
@prefix tzont: <http://www.w3.org/2006/timezone#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://www.w3.org/2006/time-entry> a owl:Ontology;
                                    rdfs:comment "An entry sub-ontology of time (OWL-Time).";
                                    rdfs:seeAlso <http://www.w3.org/TR/owl-time>.
te:CalendarClockDescription a owl:Class;
                            rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:dayOfYearField ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:month ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:week ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:month ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:day ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:second ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:day ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:dayOfYearField ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:hour ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:minute ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:hour ; 
                                             a owl:Restriction],
                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:unitType ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:timeZone ; 
                                             a owl:Restriction],
                                            [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:unitType ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:year ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:week ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:year ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:dayOfWeekField ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:timeZone ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:minute ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:dayOfWeekField ; 
                                             a owl:Restriction],
                                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty te:second ; 
                                             a owl:Restriction].
te:CalendarClockInterval a owl:Class;
                         rdfs:subClassOf te:ProperInterval.
te:DurationDescription a owl:Class;
                       rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:hours ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:years ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:months ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:days ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:months ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:weeks ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:minutes ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:days ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:seconds ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:hours ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:weeks ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:years ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:minutes ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty te:seconds ; 
                                        a owl:Restriction].
te:Event a owl:Class;
         rdfs:subClassOf te:TemporalThing;
         owl:unionOf (te:InstantEvent
                      te:IntervalEvent),
                     (te:InstantEvent
                      te:IntervalEvent).
te:Instant a owl:Class;
           rdfs:subClassOf te:InstantThing,
                           te:TemporalEntity.
te:InstantEvent a owl:Class;
                rdfs:subClassOf te:Event,
                                te:InstantThing.
te:InstantThing a owl:Class;
                rdfs:subClassOf te:TemporalThing;
                owl:unionOf (te:Instant
                             te:InstantEvent),
                            (te:Instant
                             te:InstantEvent).
te:InstantThingPair a owl:Class;
                    rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty te:secondInstantThing ; 
                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty te:firstInstantThing ; 
                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty te:secondInstantThing ; 
                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty te:firstInstantThing ; 
                                     a owl:Restriction].
te:Interval a owl:Class;
            rdfs:subClassOf te:IntervalThing,
                            te:TemporalEntity.
te:IntervalEvent a owl:Class;
                 rdfs:subClassOf te:Event,
                                 te:IntervalThing.
te:IntervalThing a owl:Class;
                 rdfs:subClassOf te:TemporalThing;
                 owl:unionOf (te:Interval
                              te:IntervalEvent),
                             (te:Interval
                              te:IntervalEvent).
te:ProperInterval a owl:Class;
                  rdfs:subClassOf te:ProperIntervalThing,
                                  te:Interval;
                  owl:disjointWith te:Instant.
te:ProperIntervalThing a owl:Class;
                       rdfs:subClassOf te:IntervalThing;
                       owl:disjointWith te:InstantThing.
te:TemporalEntity a owl:Class;
                  rdfs:subClassOf te:TemporalThing;
                  owl:unionOf (te:Instant
                               te:Interval),
                              (te:Instant
                               te:Interval).
te:TemporalThing a owl:Class;
                 owl:unionOf (te:InstantThing
                              te:IntervalThing),
                             (te:InstantThing
                              te:IntervalThing).
te:TemporalUnit a owl:Class;
                owl:oneOf (te:unitSecond
                           te:unitMinute
                           te:unitHour
                           te:unitDay
                           te:unitWeek
                           te:unitMonth
                           te:unitYear),
                          (te:unitSecond
                           te:unitMinute
                           te:unitHour
                           te:unitDay
                           te:unitWeek
                           te:unitMonth
                           te:unitYear).
te:after a owl:ObjectProperty;
         owl:inverseOf te:before.
te:before a owl:TransitiveProperty,
            owl:ObjectProperty;
          rdfs:domain te:TemporalThing;
          rdfs:range te:TemporalThing.
te:begins a owl:FunctionalProperty,
            owl:ObjectProperty;
          rdfs:domain te:TemporalThing;
          rdfs:range te:InstantThing.
te:calendarClockDescriptionDataType a owl:DatatypeProperty;
                                    rdfs:domain te:CalendarClockInterval;
                                    rdfs:range xsd:dateTime.
te:calendarClockDescriptionOf a owl:ObjectProperty;
                              rdfs:domain te:CalendarClockInterval;
                              rdfs:range te:CalendarClockDescription.
te:day a owl:DatatypeProperty;
       rdfs:domain te:CalendarClockDescription;
       rdfs:range xsd:gDay.
te:dayOfWeekField a owl:DatatypeProperty;
                  rdfs:domain te:CalendarClockDescription;
                  rdfs:range xsd:nonNegativeInteger.
te:dayOfYearField a owl:DatatypeProperty;
                  rdfs:domain te:CalendarClockDescription;
                  rdfs:range xsd:nonNegativeInteger.
te:days a owl:DatatypeProperty;
        rdfs:domain te:DurationDescription;
        rdfs:range xsd:decimal.
te:durationDescriptionDataType a owl:DatatypeProperty;
                               rdfs:domain te:TemporalThing;
                               rdfs:range xsd:duration.
te:durationDescriptionOf a owl:ObjectProperty;
                         rdfs:domain te:TemporalThing;
                         rdfs:range te:DurationDescription.
te:ends a owl:FunctionalProperty,
          owl:ObjectProperty;
        rdfs:domain te:TemporalThing;
        rdfs:range te:InstantThing.
te:firstInstantThing a owl:ObjectProperty;
                     rdfs:domain te:InstantThingPair;
                     rdfs:range te:InstantThing.
te:hour a owl:DatatypeProperty;
        rdfs:domain te:CalendarClockDescription;
        rdfs:range xsd:nonNegativeInteger.
te:hours a owl:DatatypeProperty;
         rdfs:domain te:DurationDescription;
         rdfs:range xsd:decimal.
te:inCalendarClock a owl:ObjectProperty;
                   rdfs:domain te:InstantThing;
                   rdfs:range te:CalendarClockDescription.
te:inCalendarClockDataType a owl:DatatypeProperty;
                           rdfs:domain te:InstantThing;
                           rdfs:range xsd:dateTime.
te:inside a owl:ObjectProperty;
          rdfs:domain te:IntervalThing;
          rdfs:range te:InstantThing.
te:instantPairDurationDescriptionDataType a owl:DatatypeProperty;
                                          rdfs:domain te:InstantThingPair;
                                          rdfs:range xsd:duration.
te:instantPairDurationDescriptionOf a owl:ObjectProperty;
                                    rdfs:domain te:InstantThingPair;
                                    rdfs:range te:DurationDescription.
te:intAfter a owl:ObjectProperty;
            rdfs:subPropertyOf te:nonoverlap;
            owl:inverseOf te:intBefore.
te:intBefore a owl:ObjectProperty;
             rdfs:domain te:ProperIntervalThing;
             rdfs:range te:ProperIntervalThing;
             rdfs:subPropertyOf te:nonoverlap,
                                te:before.
te:intContains a owl:ObjectProperty;
               owl:inverseOf te:intDuring.
te:intDuring a owl:ObjectProperty;
             rdfs:domain te:ProperIntervalThing;
             rdfs:range te:ProperIntervalThing;
             rdfs:subPropertyOf te:startsOrDuring.
te:intEquals a owl:ObjectProperty;
             rdfs:domain te:ProperIntervalThing;
             rdfs:range te:ProperIntervalThing.
te:intFinishedBy a owl:ObjectProperty;
                 owl:inverseOf te:intFinishes.
te:intFinishes a owl:ObjectProperty;
               rdfs:domain te:ProperIntervalThing;
               rdfs:range te:ProperIntervalThing.
te:intMeets a owl:ObjectProperty;
            rdfs:domain te:ProperIntervalThing;
            rdfs:range te:ProperIntervalThing;
            rdfs:subPropertyOf te:nonoverlap.
te:intMetBy a owl:ObjectProperty;
            rdfs:subPropertyOf te:nonoverlap;
            owl:inverseOf te:intMeets.
te:intOverlappedBy a owl:ObjectProperty;
                   owl:inverseOf te:intOverlaps.
te:intOverlaps a owl:ObjectProperty;
               rdfs:domain te:ProperIntervalThing;
               rdfs:range te:ProperIntervalThing.
te:intStartedBy a owl:ObjectProperty;
                owl:inverseOf te:intStarts.
te:intStarts a owl:ObjectProperty;
             rdfs:domain te:ProperIntervalThing;
             rdfs:range te:ProperIntervalThing;
             rdfs:subPropertyOf te:startsOrDuring.
te:minute a owl:DatatypeProperty;
          rdfs:domain te:CalendarClockDescription;
          rdfs:range xsd:nonNegativeInteger.
te:minutes a owl:DatatypeProperty;
           rdfs:domain te:DurationDescription;
           rdfs:range xsd:decimal.
te:month a owl:DatatypeProperty;
         rdfs:domain te:CalendarClockDescription;
         rdfs:range xsd:gMonth.
te:months a owl:DatatypeProperty;
          rdfs:domain te:DurationDescription;
          rdfs:range xsd:decimal.
te:nonoverlap a owl:ObjectProperty;
              rdfs:domain te:ProperIntervalThing;
              rdfs:range te:ProperIntervalThing.
te:second a owl:DatatypeProperty;
          rdfs:domain te:CalendarClockDescription;
          rdfs:range xsd:decimal.
te:secondInstantThing a owl:ObjectProperty;
                      rdfs:domain te:InstantThingPair;
                      rdfs:range te:InstantThing.
te:seconds a owl:DatatypeProperty;
           rdfs:domain te:DurationDescription;
           rdfs:range xsd:decimal.
te:startsOrDuring a owl:ObjectProperty;
                  rdfs:domain te:ProperIntervalThing;
                  rdfs:range te:ProperIntervalThing.
te:timeZone a owl:ObjectProperty;
            rdfs:domain te:CalendarClockDescription;
            rdfs:range tzont:TimeZone.
te:unitDay a te:TemporalUnit.
te:unitHour a te:TemporalUnit.
te:unitMinute a te:TemporalUnit.
te:unitMonth a te:TemporalUnit.
te:unitSecond a te:TemporalUnit.
te:unitType a owl:ObjectProperty;
            rdfs:domain te:CalendarClockDescription;
            rdfs:range te:TemporalUnit.
te:unitWeek a te:TemporalUnit.
te:unitYear a te:TemporalUnit.
te:week a owl:DatatypeProperty;
        rdfs:domain te:CalendarClockDescription;
        rdfs:range xsd:nonNegativeInteger.
te:weeks a owl:DatatypeProperty;
         rdfs:domain te:DurationDescription;
         rdfs:range xsd:decimal.
te:year a owl:DatatypeProperty;
        rdfs:domain te:CalendarClockDescription;
        rdfs:range xsd:gYear.
te:years a owl:DatatypeProperty;
         rdfs:domain te:DurationDescription;
         rdfs:range xsd:decimal.
tzont:TimeZone a owl:Class.
