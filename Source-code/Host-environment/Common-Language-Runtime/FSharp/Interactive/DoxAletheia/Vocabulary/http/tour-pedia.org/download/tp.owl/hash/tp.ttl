@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix tp: <http://tour-pedia.org/download/tp.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix planet: <http://dbpedia.org/>.
@prefix dbpedia-owl: <http://dbpedia.org/ontology/>.
@prefix accom: <http://purl.org/acco/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix wgspos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix vcard2006: <http://www.w3.org/2006/vcard/ns#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

[] vcard2006:fn "".
dbpedia-owl:address a owl:DatatypeProperty;
                    rdfs:domain tp:Place.
dbpedia-owl:location a owl:ObjectProperty;
                     rdfs:domain tp:Place.
dbpedia-owl:wikiPageExternalLink a owl:ObjectProperty;
                                 rdfs:domain tp:Place.
accom:Accommodation owl:equivalentClass tp:Accommodation.
<http://purl.org/marl/0.2/ns#hasPolarity> a owl:ObjectProperty;
                                          rdfs:domain nsprov:Entity.
schema:CivicStructure owl:equivalentClass tp:POI.
schema:LodgingBusiness owl:equivalentClass tp:Accommodation.
schema:Restaurant owl:equivalentClass tp:Restaurant.
schema:TouristAttraction a owl:Class;
                         owl:equivalentClass tp:Attraction.
schema:sameAs rdfs:domain tp:Place.
<http://tour-pedia.org/download/tp.owl> dc11:creator "Angelica Lo Duca";
                                        dc11:title "Tourpedia Ontology";
                                        dcterms:description "A vocabulary to describe touristic places: accommodations, points of interest, restaurants and attractions.";
                                        dcterms:issued "2014-06-08";
                                        dcterms:license "http://creativecommons.org/licenses/by/1.0/";
                                        dcterms:modified "2015-06-08";
                                        dcterms:rights "Copyright Â© 2015 Tourpedia";
                                        vann:preferredNamespacePrefix "tp";
                                        a owl:Ontology;
                                        rdfs:comment "A vocabulary to describe touristic places: accommodations, points of interest, restaurants and attractions.";
                                        rdfs:isDefinedBy "http://tour-pedia.org/download/tp.owl";
                                        rdfs:label "Tourpedia Ontology";
                                        owl:imports accom:,
                                                    <http://purl.org/vocommons/voaf>,
                                                    <http://www.semanticweb.org/ontologies/2012/4/accommodation-17042012.owl>,
                                                    nsprov:,
                                                    <http://schema.rdfs.org/all>;
                                        owl:versionInfo "1.0";
                                        status:term_status "testing".
tp:Accommodation a owl:Class;
                 rdfs:subClassOf tp:Place;
                 owl:equivalentClass <http://www.semanticweb.org/ontologies/2010/3/hotel-15072010.owl#Accommodation>.
tp:Attraction a owl:Class;
              rdfs:subClassOf tp:Place.
tp:POI a owl:Class;
       rdfs:subClassOf tp:Place.
tp:Place a owl:Class;
         rdfs:comment "The generic class for a touristic place.";
         rdfs:label "Place";
         owl:equivalentClass nsprov:Entity.
tp:Restaurant a owl:Class;
              rdfs:subClassOf tp:Place.
wgspos:lat a owl:DatatypeProperty;
           rdfs:domain tp:Place.
wgspos:long a owl:DatatypeProperty;
            rdfs:domain tp:Place.
skos:related a owl:ObjectProperty;
             rdfs:domain tp:Accommodation.
vcard2006:fn a owl:DatatypeProperty;
             rdfs:domain tp:Place.
vcard2006:hasPhoto a owl:DatatypeProperty;
                   rdfs:domain tp:Place.
vcard2006:hasTelephone a owl:DatatypeProperty;
                       rdfs:domain tp:Place.
