@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix admin: <http://webns.net/mvcb/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix grddl: <http://www.w3.org/2003/g/data-view#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.

<http://lists.w3.org/Archives/Public/public-grddl-comments/> rdfs:label "public-grddl-comments".
<http://www.w3.org/2001/sw-grddl-wg/> rdfs:label "the GRDDL Working Group".
owl:FunctionalProperty rdfs:label "FunctionalProperty".
<http://www.w3.org/2003/g/data-view> admin:generatorAgent <http://purl.org/NET/erdf/extract>;
                                     <http://www.rddl.org/purposes#normative-reference> <http://www.w3.org/TR/xslt>,
                                                                                        <http://www.w3.org/TR/grddl/>,
                                                                                        <http://www.w3.org/TR/rdf-concepts/>;
                                     foaf:maker grddl:grddl-wg.
grddl:InformationResource a rdfs:Class;
                          rdfs:comment "A resource which has the property that all of its essential characteristics can be conveyed in a message";
                          rdfs:isDefinedBy <http://www.w3.org/TR/2004/REC-webarch-20041215/#def-information-resource>;
                          rdfs:label "InformationResource".
grddl:RDFGraph a rdfs:Class;
               rdfs:comment """a
    set of RDF triples""";
               rdfs:isDefinedBy <http://www.w3.org/TR/2004/REC-rdf-concepts-20040210/#dfn-rdf-graph>;
               rdfs:label "RDFGraph",
                          "RDF graphs".
grddl:RootNode a rdfs:Class;
               rdfs:comment """the root of the tree in the XPath data
    model""";
               rdfs:isDefinedBy <http://www.w3.org/TR/1999/REC-xpath-19991116#root-node>;
               rdfs:label "XML document root nodes",
                          "RootNode".
grddl:Transformation a rdfs:Class;
                     rdfs:comment """an InformationResource that specifies
    a transformation from a set of XML documents to RDF graphs""";
                     rdfs:label "Transformation";
                     rdfs:subClassOf grddl:InformationResource;
                     owl:onProperty grddl:transformationProperty;
                     owl:someValuesFrom grddl:TransformationProperty.
grddl:TransformationProperty a rdfs:Class;
                             rdfs:comment """a FunctionalProperty that relates
    XML document root nodes to
    RDF graphs""";
                             rdfs:domain grddl:RootNode;
                             rdfs:label "TransformationProperty";
                             rdfs:range grddl:RDFGraph;
                             rdfs:subClassOf owl:FunctionalProperty.
grddl:danc foaf:homepage <http://www.w3.org/People/Connolly/>;
           foaf:name "Dan Connolly".
grddl:grddl-wg foaf:homepage <http://www.w3.org/2001/sw-grddl-wg/>.
grddl:grddlProject doap:homepage <http://www.w3.org/2003/g/data-view>;
                   doap:mailing-list <http://lists.w3.org/Archives/Public/public-grddl-comments/>;
                   doap:shortdesc """GRDDL
    is a technique for gleaning resource
    descriptions from dialects of
    languages. It's a way of extracting Semantic Web
    data in RDF from XML formats (especially
    XHTML dialects or microformats) via
    transformations identified by URIs and typically expressed in
    XSLT.""".
grddl:namespaceTransformation a rdf:Property;
                              rdfs:comment """relates a namespace to a transformation for
    all documents in that namespace""";
                              rdfs:label "namespaceTransformation";
                              rdfs:range grddl:Transformation.
grddl:profileTransformation a rdf:Property;
                            rdfs:comment """relates a profile document to a
    transformation for all documents bearing that profile""";
                            rdfs:label "profileTransformation";
                            rdfs:range grddl:Transformation.
grddl:result a rdf:Property;
             rdfs:comment """an
    RDF graph obtained from an information resource by directly
    parsing a representation in the standard RDF/XML syntax or
    indirectly by parsing some other dialect using a transformation
    nominated by the document""";
             rdfs:domain grddl:InformationResource;
             rdfs:label "result";
             rdfs:range grddl:RDFGraph.
grddl:transformation a rdf:Property;
                     rdfs:comment """relates a source document to a
    transformation, usually represented in XSLT, that relates the source document syntax
    to the RDF graph syntax""";
                     rdfs:domain grddl:RootNode;
                     rdfs:label "transformation";
                     rdfs:range grddl:Transformation.
grddl:transformationProperty a owl:FunctionalProperty;
                             rdfs:comment """relates a transformation to the algorithm
    specified by the property that computes an RDF graph from an XML
    document node""";
                             rdfs:domain grddl:Transformation;
                             rdfs:label "transformationProperty";
                             rdfs:range grddl:TransformationProperty.
<http://www.w3.org/People/Connolly/> rdfs:label "Dan Connolly".
<http://www.w3.org/TR/1999/REC-xpath-19991116#root-node> rdfs:label """section
    5.1 Root Node in XML Path Language (XPath) Version
    1.0""".
<http://www.w3.org/TR/2004/REC-rdf-concepts-20040210/#dfn-rdf-graph> rdfs:label """definition
    in Resource Description Framework (RDF): Concepts and
    Abstract Syntax""".
<http://www.w3.org/TR/2004/REC-webarch-20041215/#def-information-resource> rdfs:label "definition in Architecture of the World Wide Web, Volume One".
<http://www.w3.org/TR/grddl/> dc11:date "2005-05-15";
                              dc11:title """Gleaning
        Resource Descriptions from Dialects of Languages
        (GRDDL)""";
                              rdfs:label """Gleaning
        Resource Descriptions from Dialects of Languages
        (GRDDL), 16
        May 2005""".
<http://www.w3.org/TR/rdf-concepts/> dc11:date "2004-02-10";
                                     dc11:title """Resource
      Description Framework (RDF): Concepts and Abstract
      Syntax""";
                                     rdfs:label """Resource
      Description Framework (RDF): Concepts and Abstract
      Syntax, 10
      February 2004""".
<http://www.w3.org/TR/xslt> rdfs:label "XSLT".
