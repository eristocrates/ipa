admingeo:Borough a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Borough"@en;
                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>.
admingeo:CivilAdministrativeArea a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "Civil Administrative Area";
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onClass> admingeo:EuropeanRegion ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> admingeo:inEuropeanRegion ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://data.ordnancesurvey.co.uk/ontology/geometry/AbstractGeometry> ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> <http://data.ordnancesurvey.co.uk/ontology/geometry/extent> ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 <http://www.w3.org/2002/07/owl#Thing>;
                                 <http://www.w3.org/2002/07/owl#disjointWith> admingeo:CivilVotingArea.
admingeo:CivilParish a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Parishes are subdivisions of local authorities in many parts of England, and their councils are the most local level of government. Unlike electoral wards/divisions however, parishes are not found in all parts of England. The Welsh equivalents are communities. Note that the full term for administrative parishes is &apos;civil parishes&apos;, to distinguish them from the ecclesiastical parishes which are found in all parts of the UK."@en;
                     rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                     rdfs:label "Civil Parish"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#notation> ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onClass> admingeo:County ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> admingeo:inCounty ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onClass> [<http://www.w3.org/2002/07/owl#unionOf> (admingeo:District
                                                                                                                        admingeo:MetropolitanDistrict
                                                                                                                        admingeo:UnitaryAuthority) ; 
                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> admingeo:inDistrict ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasCensusCode ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     admingeo:CivilAdministrativeArea,
                                     [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:CivilVotingArea a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Civil Voting Area";
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://data.ordnancesurvey.co.uk/ontology/geometry/AbstractGeometry> ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> <http://data.ordnancesurvey.co.uk/ontology/geometry/extent> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onClass> admingeo:EuropeanRegion ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> admingeo:inEuropeanRegion ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:Community a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The Welsh equivalent of Civil Parish."@en;
                   rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                   rdfs:label "Community"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasCensusCode ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#notation> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   admingeo:CivilAdministrativeArea,
                                   [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onClass> admingeo:UnitaryAuthority ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> admingeo:inDistrict ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:Constituency a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Constituencies are used to elect members to legislatures.";
                      rdfs:label "Constituency";
                      rdfs:subClassOf admingeo:CivilVotingArea.
admingeo:County a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Counties were formerly administrative units across the whole UK. Due to various administrative restructurings however then the only administrative areas still referred to as counties are the non-metropolitan (shire) counties of England. The English metropolitan counties, although no longer administrative units, are also used for statistical purposes."@en;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                rdfs:label "County"@en;
                rdfs:subClassOf admingeo:CivilAdministrativeArea,
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                 <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#altLabel> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasCensusCode ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#notation> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> admingeo:District ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> admingeo:district ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:CountyElectoralDivision a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Apart from the special cases of the Isles of Scilly and the Greater London Authority (GLA), the English county councils are the only type of local authority in the UK which does not use standard electoral wards/divisions for electing councillors. Instead they use their own larger units, which are confusingly also termed electoral divisions. These county electoral divisions must be confined within district boundaries, but need not be based on whole electoral wards. Like electoral wards/divisions, county electoral divisions are defined by the Boundary Committee for England (BCFE)."@en;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "County Electoral Division"@en;
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                  <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                  <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                                  <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onClass> admingeo:County ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> admingeo:inCounty ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 admingeo:CivilVotingArea.
admingeo:District a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Districts are local administrative units and have at various times been used in all four countries of the UK. The only current references to districts however are found in metropolitan and non-metropolitan districts in England, and district council areas in Northern Ireland."@en;
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                  rdfs:label "District"@en;
                  rdfs:subClassOf admingeo:CivilAdministrativeArea,
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasCensusCode ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> rdfs:label ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onClass> admingeo:County ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> admingeo:inCounty ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#altLabel> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> admingeo:DistrictWard ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> admingeo:ward ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:DistrictWard a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                      rdfs:label "District Ward"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#notation> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onClass> admingeo:County ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> admingeo:inCounty ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> admingeo:District ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> admingeo:inDistrict ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasCensusCode ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      admingeo:Ward,
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#prefLabel> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasAreaCode ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                       <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> admingeo:hasUnitID ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
admingeo:EuropeanRegion a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "European Regions correspond to Scotland, Wales and the nine Government Office Regions of England. The nine Government Office Regions (GORs) are the primary statistical subdivisions of England and also the areas in which the Government Offices for the Regions fulfil their role. Each GOR covers a number of local authorities.";
                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                        rdfs:label "European Region";
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> admingeo:WestminsterConstituency ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> admingeo:westminsterConstituency ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        <http://www.w3.org/2002/07/owl#Thing>,
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://data.ordnancesurvey.co.uk/ontology/geometry/AbstractGeometry> ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://data.ordnancesurvey.co.uk/ontology/geometry/extent> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                         <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
