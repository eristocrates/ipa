@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#>.
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/sequence.owl> cpa:coversRequirements "What is before what?,What's next?,What's immediately following this?"^^rdf:PlainLiteral;
                                                            cpa:extractedFrom "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                            cpa:hasAuthor "Valentina Presutti"^^rdf:PlainLiteral,
                                                                          "Sara Bernardini"^^rdf:PlainLiteral;
                                                            cpa:hasConsequences "We can represent and reason over transitive or intransitive sequences of any kind. However, since coreference cannot be expressed in OWL, it is not possible to represent and reason over loops and other sequences involving coreference."^^rdf:PlainLiteral;
                                                            cpa:hasIntent """To represent sequence schemas. It defines the notion of transitive and intransitive precedence and their inverses. 
It can then be used between tasks, processes, time intervals, spatially locate objects, situations, etc."""^^rdf:PlainLiteral;
                                                            a owl:Ontology;
                                                            rdfs:label "sequence"^^rdf:PlainLiteral,
                                                                       "ordering"^^rdf:PlainLiteral,
                                                                       "precedence"^^rdf:PlainLiteral;
                                                            owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                            owl:versionInfo """1.1
- Revised and annotated for ODP submission by Aldo Gangemi
1.0
- Created by Valentina Presutti and Sara Bernardini"""^^rdf:PlainLiteral,
                                                                            "1.1 added rdfs:isDefinedBy for all named entities".
seq:directlyFollows a owl:ObjectProperty;
                    rdfs:comment "The intransitive follows relation. For example, Wednesday directly precedes Thursday. Directness of precedence depends on the designer conceptualization.";
                    rdfs:domain owl:Thing;
                    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl>;
                    rdfs:label "segue direttamente"@it,
                               "directly follows"@en;
                    rdfs:range owl:Thing;
                    rdfs:subPropertyOf seq:follows;
                    owl:inverseOf seq:directlyPrecedes.
seq:directlyPrecedes a owl:ObjectProperty;
                     rdfs:comment "The intransitive precedes relation. For example, Monday directly precedes Tuesday. Directness of precedence depends on the designer conceptualization.";
                     rdfs:domain owl:Thing;
                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl>;
                     rdfs:label "precede direttamente"@it,
                                "directly precedes"@en;
                     rdfs:range owl:Thing;
                     rdfs:subPropertyOf seq:precedes.
seq:follows a owl:TransitiveProperty,
              owl:ObjectProperty;
            rdfs:comment """A relation between entities, expressing a 'sequence' schema. 
E.g. 'year 2000 follows 1999', 'preparing coffee' follows 'deciding what coffee to use', 'II World War follows I World War', etc. 
It can be used between tasks, processes or time intervals, and subproperties would fit best in order to distinguish the different uses.""";
            rdfs:domain owl:Thing;
            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl>;
            rdfs:label "segue"@it,
                       "follows"@en;
            rdfs:range owl:Thing.
seq:precedes a owl:TransitiveProperty,
               owl:ObjectProperty;
             rdfs:comment """A relation between entities, expressing a 'sequence' schema. 
E.g. 'year 1999 precedes 2000', 'deciding what coffee to use' precedes 'preparing coffee', 'World War II follows World War I', 'in the Milan to Rome autoroute, Bologna precedes Florence', etc.
It can then be used between tasks, processes, time intervals, spatially locate objects, situations, etc. 
Subproperties can be defined in order to distinguish the different uses.""";
             rdfs:domain owl:Thing;
             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl>;
             rdfs:label "precede"@it,
                        "precedes"@en;
             rdfs:range owl:Thing;
             owl:inverseOf seq:follows.
cpa:coversRequirements a owl:AnnotationProperty.
cpa:extractedFrom a owl:AnnotationProperty.
cpa:hasAuthor a owl:AnnotationProperty.
cpa:hasConsequences a owl:AnnotationProperty.
cpa:hasIntent a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:Thing a owl:Class.
owl:versionInfo a owl:AnnotationProperty.
