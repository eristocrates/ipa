@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vartrans: <http://www.w3.org/ns/lemon/vartrans#>.

<http://www.w3.org/2002/07/owl#topObjectProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/lemon/vartrans> <http://creativecommons.org/ns#license> <https://creativecommons.org/publicdomain/zero/1.0/>;
                                      <http://purl.org/dc/elements/1.1/contributor> <http://www.ilc.cnr.it/en/content/anas-fahad-khan>,
                                                                                    <http://mayor2.dia.fi.upm.es/oeg-upm/index.php/en/teachers/52-emontiel>,
                                                                                    <http://www.paulbuitelaar.net/>,
                                                                                    <http://www.oeg-upm.net/index.php/teachers/53-lupe>,
                                                                                    <http://jogracia.url.ph/web/>,
                                                                                    <http://art.uniroma2.it/stellato/>,
                                                                                    <http://www.istc.cnr.it/people/aldo-gangemi>,
                                                                                    <http://art.uniroma2.it/fiorelli/>,
                                                                                    <http://www.dfki.de/~declerck/>,
                                                                                    <https://sites.google.com/site/francescafrontini/>;
                                      <http://purl.org/dc/elements/1.1/creator> <http://www.cimiano.de/>,
                                                                                <http://john.mccr.ae/>;
                                      <http://purl.org/dc/elements/1.1/description> "A model for the representation of lexical information relative to ontologies. Variation and translation module."@en;
                                      <http://purl.org/dc/elements/1.1/issued> "2016-01-10"^^xsd:date;
                                      <http://purl.org/dc/elements/1.1/modified> "2016-01-10"^^xsd:date;
                                      <http://purl.org/dc/elements/1.1/publisher> <http://www.w3.org/community/ontolex>;
                                      <http://purl.org/dc/elements/1.1/rights> "CC-Zero";
                                      <http://purl.org/dc/elements/1.1/title> "Lexicon Model for Ontologies - Vartrans"@en;
                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "vartrans";
                                      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.w3.org/ns/lemon/vartrans#";
                                      a <http://purl.org/vocommons/voaf#Vocabulary>,
                                        <http://www.w3.org/2002/07/owl#Ontology>;
                                      rdfs:comment """-Version 1.0: depreciation with minor change in metadata for LOV publication
-Version 1.1: creation"""@en;
                                      <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/lemon/ontolex>;
                                      vartrans:imports <http://www.w3.org/ns/lemon/ontolex>;
                                      vartrans:versionInfo 1.1.
vartrans:ConceptualRelation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Отношение между двумя понятиями"@ru,
                                         "A relationship between two concepts"@en;
                            rdfs:label "relación entre conceptos"@es,
                                       "Konzeptbeziehung"@de,
                                       "conceptual relation"@en,
                                       "relazione di concetti"@it,
                                       "отношение понятий"@ru,
                                       "conceptrelatie"@nl;
                            rdfs:subClassOf vartrans:LexicoSemanticRelation,
                                            [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> vartrans:relates ; 
                                             <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/lemon/ontolex#LexicalConcept> ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>].
vartrans:LexicalRelation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "'Лексическое отношение' - это лексико-семантическое отношение, которое представляет собой отношение между двумя словарными единицами, поверхностные формы которых связаны грамматически, стилистически или неким процессом, обусловленным лингвистической экономией."@ru,
                                      "A 'lexical relation' is a lexico-semantic relation that represents the relation between two lexical entries the surface forms of which are related grammatically, stylistically or by some operation motivated by linguistic economy."@en;
                         rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                         rdfs:label "lexical relation"@en,
                                    "lexikalische Beziehung"@de,
                                    "lexikaal relatie"@nl,
                                    "relation lexicale"@fr,
                                    "relație lexicală"@ro,
                                    "lexikalisk relation"@sv,
                                    "relação semantica"@pt,
                                    "лексическое отношение"@ru,
                                    "relación léxica"@es,
                                    "relazione lessicale"@it,
                                    "leksikale relasie"@af;
                         rdfs:subClassOf vartrans:LexicoSemanticRelation,
                                         [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> vartrans:relates ; 
                                          <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/lemon/ontolex#LexicalEntry> ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:LexicoSemanticRelation a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "'Лексико-семантическое отношение' представляет собой связь между двумя словарными единицами или лексическими смыслами, которые связаны некими лексическими или семантическими отношениями."@ru,
                                             "A 'lexico-semantic relation' represents the relation between two lexical entries or lexical senses that are related by some lexical or semantic relationship."@en;
                                rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                                rdfs:label "relação lexica semantica"@pt,
                                           "relație lexico-semantică"@ro,
                                           "лексико-семантическое отношение"@ru,
                                           "lexikalisk-semantisk relation"@sv,
                                           "lexikosemantische Beziehung"@de,
                                           "lexico-semantic relation"@en,
                                           "lexikosemantische relatie"@nl,
                                           "leksikosemantiese relasie"@af,
                                           "relation lexico-sémantique"@fr,
                                           "relazione lessico-semantica"@it,
                                           "relación léxico semántica"@es;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> vartrans:relates ; 
                                                 <http://www.w3.org/2002/07/owl#onClass> [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/lemon/ontolex#LexicalConcept>
                                                                                                                                   <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>
                                                                                                                                   <http://www.w3.org/ns/lemon/ontolex#LexicalSense>) ; 
                                                                                          a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:SenseRelation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "'Отношение смыслов' (SenseRelation) - это лексико-семантическое отношение, которое представляет собой связь между двумя лексическими смыслами, значения которых связаны между собой."@ru,
                                    "A 'sense relation' is a lexico-semantic relation that represents the relation between two lexical senses the meanings of which are related."@en;
                       rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                       rdfs:label "отношение смыслов"@ru,
                                  "relación entre acepciones"@es,
                                  "relație de sens"@ro,
                                  "sense relation"@en,
                                  "betydelserelation"@sv,
                                  "relation sémantique"@fr,
                                  "relação semantica"@pt,
                                  "sinnrelatie"@nl,
                                  "relazione di sensi"@it,
                                  "Sinnbeziehung"@de,
                                  "sinsrelasie"@af;
                       rdfs:subClassOf vartrans:LexicoSemanticRelation,
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "2"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> vartrans:relates ; 
                                        <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>];
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:TerminologicalRelation a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A 'terminological relation' is a sense relation that relates two lexical senses of terms that are semantically related in the sense that they can be exchanged in most contexts, but their surface forms are not directly related. The variants vary along dimensions that are not captured by the given ontology and are intentionally (pragmatically) caused."@en,
                                             "'Терминологическое отношение' - это смысловое отношение, которое связывает два лексических смысла терминов, семантически связанных в том смысле, что они могут взаимозаменяться в большинстве контекстов, но их поверхностные (внешние) формы непосредственно не связаны. В форматах, не фиксируемых в данной онтологии и намеренно (прагматически) обусловленных, данные варианты разнятся (отличаются)."@ru;
                                rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                                rdfs:label "variante terminológica"@es,
                                           "variantă terminologică"@ro,
                                           "variante terminologique"@fr,
                                           "terminologiese variant"@af,
                                           "terminologische variant"@nl,
                                           "terminologische Variante"@de,
                                           "variante terminologica"@pt,
                                           "variante terminologica"@it,
                                           "terminological relation"@en,
                                           "terminologivariant"@sv,
                                           "терминологическое отношение"@ru;
                                rdfs:subClassOf vartrans:SenseRelation;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:Translation a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "'Перевод' представляет собой 'отношение смыслов', показывающее, что два лексических смысла, соответствующие двум словарным единицам в разных языках, могут быть взаимно переведены без каких-либо существенных искажений смысла."@ru,
                                  "A 'translation' is a 'sense relation' expressing that two lexical senses corresponding to two lexical entries in different languages can be translated to each other without any major meaning shifts."@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                     rdfs:label "Übersetzung"@de,
                                "tradução"@pt,
                                "vertaling"@nl,
                                "vertaling"@af,
                                "перевод"@ru,
                                "traducción"@es,
                                "traduction"@fr,
                                "translation"@en,
                                "traducere"@ro,
                                "versättning"@sv,
                                "traduzione"@it;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> vartrans:target ; 
                                      <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/ns/lemon/ontolex#LexicalSense> ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     vartrans:SenseRelation;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:TranslationSet a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "'Набор переводов' - это совокупность переводов, которые имеют общий источник."@ru,
                                     "A 'translation set' is a set of translations that have some common source."@en;
                        rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                        rdfs:label "conjunto de traducciones"@es,
                                   "banque de traductions"@fr,
                                   "Übersetzungsatz"@de,
                                   "translation set"@en,
                                   "bance traduzioni"@it,
                                   "verzameling van vertalingen"@nl,
                                   "набор переводов"@ru;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:category a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "The 'category' property indicates the specific type of relation by which two lexical entries or two lexical senses are related."@en,
                               "Свойство 'категория' указывает конкретный тип отношения, которым связаны две словарные единицы или два лексических смысла."@ru;
                  rdfs:domain vartrans:LexicoSemanticRelation;
                  rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                  rdfs:label "kategori"@sv,
                             "contexte"@fr,
                             "category"@en,
                             "categoría"@es,
                             "categoria"@pt,
                             "categoria"@it,
                             "Kategorie"@de,
                             "kategorie"@af,
                             "categorie"@ro,
                             "categorie"@nl,
                             "категория"@ru;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:conceptRel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "A relationship between two concepts"@en,
                                 "Отношения между двумя понятиями"@ru;
                    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalConcept>;
                    rdfs:label "relación entre conceptos"@es,
                               "relazione di concetti"@it,
                               "отношение понятий"@ru,
                               "Konzeptbeziehung"@de,
                               "concept relation"@en,
                               "conceptrelatie"@nl;
                    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalConcept>.
vartrans:lexicalRel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "The 'lexicalRel' property relates two lexical entries that stand in some lexical relation."@en,
                                 "Свойство 'lexicalRel' связывает две словарных единицы, которые находятся в некотором лексическом отношении."@ru;
                    rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>;
                    rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                    rdfs:label "лексическое отношение"@ru,
                               "lexikalische Beziehung"@de,
                               "lexikaal relatie"@nl,
                               "relación léxica"@es,
                               "lexical relation"@en,
                               "relation lexicale"@fr,
                               "relazione lessicale"@it;
                    rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:relates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The 'relates' property links a lexico-semantic relation to the two lexical entries or lexical senses between which it establishes the relation."@en,
                              "Свойство 'связывает' связывает лексико-семантическим отношением две словарные единицы или два лексических смысла, между которыми оно (данное свойство) устанавливает отношение."@ru;
                 rdfs:domain vartrans:LexicoSemanticRelation;
                 rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                 rdfs:label "relates"@en,
                            "relateert"@nl,
                            "bezieht"@de,
                            "relate"@fr,
                            "связывает"@ru,
                            "relaciona"@es,
                            "rapporta"@it;
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://www.w3.org/ns/lemon/ontolex#LexicalConcept>
                                                                      <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>
                                                                      <http://www.w3.org/ns/lemon/ontolex#LexicalSense>) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:senseRel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Свойство 'отношение смыслов' (senseRel) связывает два лексических смысла, которые находятся в некоторой смысловой связи."@ru,
                               "The 'senseRel' property relates two lexical senses that stand in some sense relation."@en;
                  rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalSense>;
                  rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                  rdfs:label "Sinnbeziehung"@de,
                             "sinnrelatie"@nl,
                             "отношение смыслов"@ru,
                             "sense relation"@en,
                             "relation sémantique"@fr,
                             "relación entre acepciones"@es,
                             "relazione di sensi"@it;
                  rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalSense>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:source a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "Свойство 'источник' обозначает лексический смысл или словарную единицу, вовлеченную в лексико-семантическое отношение как 'источник'."@ru,
                             "The 'source' property indicates the lexical sense or lexical entry involved in a lexico-semantic relation as a 'source'."@en;
                rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                rdfs:label "source"@fr,
                           "source"@en,
                           "källa"@sv,
                           "источник"@ru,
                           "origine"@it,
                           "sursă"@ro,
                           "origem"@pt,
                           "origen"@es,
                           "Quelle"@de,
                           "bron"@nl,
                           "bron"@af;
                rdfs:subPropertyOf vartrans:relates;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:target a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Свойство 'цель' обозначает лексический смысл или словарную единицу, вовлеченную в лексико-семантическое отношение как 'цель'."@ru,
                             "The 'target' property indicates the lexical sense or lexical entry involved in a lexico-semantic relation as a 'target'."@en;
                rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                rdfs:label "doel"@nl,
                           "doel"@af,
                           "mål"@sv,
                           "цель"@ru,
                           "destino"@es,
                           "destino"@pt,
                           "destinazione"@it,
                           "Ziel"@de,
                           "target"@en,
                           "destination"@fr,
                           "ţintă"@ro;
                rdfs:subPropertyOf vartrans:relates;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:trans a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Свойство 'перевод' связывает НаборПереводов с одним из его переводов."@ru,
                            "The property 'trans' relates a TranslationSet to one of its translations."@en;
               rdfs:domain vartrans:TranslationSet;
               rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
               rdfs:label "translation"@en,
                          "traducere"@ro,
                          "traducción"@es,
                          "versättning"@sv,
                          "traduction"@fr,
                          "traduzione"@it,
                          "tradução"@pt,
                          "перевод"@ru,
                          "Übersetzung"@de,
                          "vertaling"@nl,
                          "vertaling"@af;
               rdfs:range vartrans:Translation;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:translatableAs a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                        rdfs:comment "Свойство 'переводится как' связывает словарную единицу на каком-либо языке со словарной единицей на другом языке, на который она может быть переведена соответствующим образом в зависимости от конкретного контекста и специфических смыслов данных словарных единиц."@ru,
                                     "The 'translatableAs' property relates a lexical entry in some language to a lexical entry in another language that it can be translated as depending on the particular context and specific senses of the involved lexical entries."@en;
                        rdfs:domain <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>;
                        rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                        rdfs:label "übersetzbar als"@de,
                                   "traducibile come"@it,
                                   "traduzivel como"@pt,
                                   "vertaalbar als"@nl,
                                   "traductibil ca"@ro,
                                   "traducibile como"@es,
                                   "översättbar som"@sv,
                                   "переводится как"@ru,
                                   "traduisible par"@fr,
                                   "vertaalbaar As"@af,
                                   "translatable as"@en;
                        rdfs:range <http://www.w3.org/ns/lemon/ontolex#LexicalEntry>;
                        rdfs:subPropertyOf vartrans:lexicalRel;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (<http://www.w3.org/ns/lemon/ontolex#isSenseOf>
                                                                            vartrans:translation
                                                                            <http://www.w3.org/ns/lemon/ontolex#sense>);
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
vartrans:translation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The 'translation' property relates two lexical senses of two lexical entries that stand in a translation relation to one another. "@en,
                                  "Свойство 'перевод' связывает два лексических смысла двух словарных единиц, которые находятся в отношении перевода друг к другу."@ru;
                     rdfs:isDefinedBy <http://www.w3.org/ns/lemon/vartrans>;
                     rdfs:label "Übersetzung"@de,
                                "traducción"@es,
                                "traduzione"@it,
                                "vertaling"@nl,
                                "translation"@en,
                                "vertaling"@af,
                                "tradução"@pt,
                                "versättning"@sv,
                                "traducere"@ro,
                                "перевод"@ru,
                                "traduction"@fr;
                     rdfs:subPropertyOf vartrans:senseRel;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
