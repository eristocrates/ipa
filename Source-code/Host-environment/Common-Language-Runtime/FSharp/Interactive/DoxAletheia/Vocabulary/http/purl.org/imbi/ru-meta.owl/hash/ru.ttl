@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ru: <http://purl.org/imbi/ru-meta.owl#>.

<http://purl.org/imbi/ru-meta.owl> a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment """This is the dirst draft for a recommendation for metadata on Representational Units (RU) which appear in ontologies. It is so far harmonized for implementation through owl annotation properties.
Comments to: OBI discussion list, metadata wiki or to  schober at ebi.ac.uk""";
                                   rdfs:label "RU_metadata_ontology";
                                   <http://www.w3.org/2002/07/owl#versionInfo> "0.1"^^xsd:float.
ru:UMLS_connect a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                rdfs:comment "A link to a UMLS semantic Type CUI.".
ru:_deleted a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This residual category holds deleted classes";
            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ru:_inclusion_list a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This residual category holds yet to be classified (mass-)imported terms as a simple list.";
                   rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ru:_temp_orphan a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A temporal store for classes that are being worked on.";
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ru:abbrev a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "A common accepted abbreviation for the RU-name. A word formed from the initials of one or more words describing the name, that is pronounceable like a normal word.".
ru:acronym a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "A common accepted acronyn for the RU-name.".
ru:action_item a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "A description of a task / action for the RU editor to solve an issue related to the RU.".
ru:alt_def a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "An alternative definition. Usually the non-aristotelian natural language definition initially provided by domain specialists.".
ru:alt_spr_cls a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "An alternative superclass assertion. Used to capture multiple parenthood.".
ru:axiom a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
         rdfs:comment "General axioms to be fulfilled by instances of the class can be captured in an informal way in natural language here.".
ru:change_note a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment """A note that indicates what was modified or changed concerning the RU. 
Might become RU specific, i.e. cls_change_note AND prpty_change_note""".
ru:cls_del a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "Allows to state the reason why a RU has been deleted.".
ru:cls_expl a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "A prototypical example subclass for the class.".
ru:cls_id a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "A unique Identifyer for the class, consisting of a groups prefix, underscore and unique number.".
ru:cls_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "Any name of the class. ??? Will change according to Synonym implementation...".
ru:cls_prov a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment """The class name provenance. It can be a source publication, a database or ontology entry, a group,  person name or a URL (dbxref in obo)
A database cross reference. ???""".
ru:context_keyword a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                   rdfs:comment "The main usage contexts can be stated, e.g. for text mining purposes or translation purposes.".
ru:creation_date a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:comment "The date when a RU was first created. (Will be provided automatically by Protege 4).".
ru:curation_status a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                   rdfs:comment "The status (stability level) of the class. Specifies tracking information. E.g. unstable, experimental, stable.".
ru:def a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
       rdfs:comment "The arestotelian, formalized and normalized class definition layed out according to IFOMIS-best practice, explanaining the meaning of a class.".
ru:def_prov a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "The definition provenance (was: Defsource). It can be a source publication, a database or ontology entry, a group or person name or a URL (dbxref in obo)".
ru:del_date a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "The date a RU was deleted.".
ru:editor a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "The name of a specific editior/curator who is responsible for and edits this RU.".
ru:editor_note a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "A note related to the RU intended for its editor.".
ru:formal_cls_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                   rdfs:comment "A name for the class that is formaly controlled through linguistical rules and axioms. E.G. OBOL normalized ones that adhere to defined principles of word/morpheme/affix order and form. ???".
ru:inst_expl a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment "An example  value or instance for the class or Database entry which will be annotated through this RU.".
ru:modif_date a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
              rdfs:comment "The date on which the RU was last modified.".
ru:old_cls_state a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:comment "State wheather a class was defined or primitive when deleted.".
ru:old_spr_cls a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "For deleted classes state their last position within the ontology, state the old superclasses.".
ru:old_sub_cls a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "For deleted classes state their last position within the ontology, state the old subclasses.".
ru:ont_imp a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "To mark from where on in the Class-hierarchy we want to import / refer to a complete subclass hierarchy from an other ontology (was: refer to) ??? Maybe better: cls_imp".
ru:pref_cls_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:comment "The preferred name for a class, usually the one used to display in the Hierarchy-browser. As now captured in the rdf:label ???".
ru:pref_propty_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                    rdfs:comment "The preferred name for a class, usually the one used to display in the Hierarchy-browser.".
ru:prpty_del a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment "State the reason why a property was deleted, analogously as for cla_del.".
ru:prpty_expl a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
              rdfs:comment "A prototypic example od a sub-property of this property )when property hierarchies are allowed.".
ru:prpty_id a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "A unique formal identifyer for the property, analogously to the cls_id.".
ru:prpty_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
              rdfs:comment "A name of the property, analogously as a cls_name.".
ru:prpty_prov a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
              rdfs:comment """The property name provenance. It can be a source publication, a database or ontology entry, a group,  person name or a URL (dbxref in obo)
A database cross reference. ???""".
ru:refact a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "When a class has been refactored into more atomic classes, then the original compound class is made obsolete and this deleted source class which gave birth to the new atomic child classes is mentioned here for all new atomic classes.".
ru:replace a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "When a new RU-name replaces an old one, state here which one was replaced. ???".
ru:rights a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "Indicate access rights for a RU. The security policy should be compliant with the rule-based access control standards,INCITS, InterNational Committee for Information Technology Standards (formerly NCITS). (2003). Role Based Access Control. INCITS 359 DRAF, 4/4/2003. http://csrc.nist.gov/rbac/ Those offer, in at the same time, a consistent layered approach for security policy definition and management and for compliance with a growing set of supporting tools.".
ru:scope_note a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
              rdfs:comment "Any general formless remark or note about the scope of the RU (was: rem, note).".
ru:short_cls_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                  rdfs:comment "A short class name suitable for graph visualisations etc.".
ru:short_prpty_name a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                    rdfs:comment "A shortproperty name suitable for graph visualisations etc.".
ru:source a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment """??? rel to ont_imp
??? rel to def_prov or cls_prov ?
Do we need this separately for diff RUs? Eg. cls_src, prprty_src,…?""".
ru:synonym a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment "An alternative name for the RU used as synonym (can be used in the same manner as the name in different contexts).".
ru:temp_def a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
            rdfs:comment "Indicates definitions which need to be refined.".
ru:unresolved_issue a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                    rdfs:comment "An important problematic issue that has to be tackled by the editors.".
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
