@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix arch: <http://purl.org/archival/vocab/arch#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

<http://purl.org/archival/vocab/arch> dc11:creator "Aaron Rubinstein";
                                      dc11:description "An RDF vocabulary for describing archival collections and the names associated with them";
                                      dc11:title "Archival";
                                      a owl:Ontology.
arch:Archive a owl:Class;
             rdfs:comment "An organization that holds archival collections.";
             rdfs:subClassOf foaf:Organization.
arch:Collection a owl:Class;
                rdfs:comment "A collection of documents organized according to the principle of provenance.".
arch:Family a owl:Class;
            rdfs:comment "For representing a family, a subclass of foaf:Group.  This class might be equivalent to a similar class in genealogical vocabularies.";
            rdfs:subClassOf foaf:Group.
arch:Manuscript a owl:Class;
                rdfs:comment "An unpublished document in an arch:Collection";
                rdfs:subClassOf arch:Collection.
arch:appearsWith a owl:SymmetricProperty,
                   owl:ObjectProperty;
                 rdfs:comment "Name appears with another name in an archival collection";
                 rdfs:subPropertyOf foaf:knows.
arch:bulkEnd a owl:ObjectProperty;
             rdfs:comment "The end of a collection's bulk dates";
             rdfs:subPropertyOf dcterms:created.
arch:bulkStart a owl:ObjectProperty;
               rdfs:comment "The beginning of a collection's bulk dates";
               rdfs:subPropertyOf dcterms:created.
arch:correspondedWith a owl:SymmetricProperty,
                        owl:ObjectProperty;
                      rdfs:subPropertyOf foaf:knows.
arch:hasProvenance a owl:ObjectProperty;
                   rdfs:comment "Property relating a arch:Collection to the names that are the provenance of that collection.  Inverse of arch:primaryProvenanceOf.";
                   rdfs:domain arch:Collection;
                   rdfs:range foaf:Agent;
                   owl:inverseOf arch:primaryProvenanceOf.
arch:heldBy a owl:ObjectProperty;
            rdfs:comment "Relates a arch:Collection to the archive that holds it.  Inverse of arch:holds";
            rdfs:domain arch:Collection;
            rdfs:range arch:Archive;
            owl:inverseOf arch:holds.
arch:holds a owl:ObjectProperty;
           rdfs:comment "Relates an arch:Archive to a collection that it holds.  Inverse of arch:heldBy";
           rdfs:domain arch:Archive;
           rdfs:range arch:Collection.
arch:inclusiveEnd a owl:ObjectProperty;
                  rdfs:comment "The end of a collection's inclusive dates";
                  rdfs:subPropertyOf dcterms:created.
arch:inclusiveStart a owl:ObjectProperty;
                    rdfs:comment "The beginning of a collection's inclusive dates";
                    rdfs:subPropertyOf dcterms:created.
arch:primaryProvenanceOf a owl:ObjectProperty;
                         rdfs:comment "Relates a foaf:Person, foaf:Organization, or arch:Family to the arch:Collection that they created.  This might be more than one entity.  Inverse of arch:hasProvenance.";
                         rdfs:domain foaf:Agent;
                         rdfs:range arch:Collection.
arch:referencedIn a owl:ObjectProperty;
                  rdfs:comment "Relates a foaf:Person, foaf:Organization, or arch:Family to a arch:Collection that they are referenced in.";
                  rdfs:domain foaf:Person,
                              foaf:Organization,
                              arch:Family;
                  rdfs:range arch:Collection.
arch:relatedSubject a owl:ObjectProperty;
                    rdfs:comment "Related Subject",
                                 "Subjects related to a name in an archival collection.  Usually represents the subjects from a collection that a name is the arch:primaryProvenanceOf";
                    rdfs:subPropertyOf dcterms:subject.
dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:created a owl:ObjectProperty.
dcterms:subject a owl:ObjectProperty.
foaf:Agent a owl:Class.
foaf:Group a owl:Class;
           rdfs:subClassOf foaf:Agent.
foaf:Organization a owl:Class;
                  rdfs:subClassOf foaf:Agent.
foaf:Person a owl:Class;
            rdfs:subClassOf foaf:Agent.
foaf:knows a owl:ObjectProperty.
