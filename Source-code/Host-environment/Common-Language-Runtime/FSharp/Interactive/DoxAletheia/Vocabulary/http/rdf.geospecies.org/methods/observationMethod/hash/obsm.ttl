@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix obsm: <http://rdf.geospecies.org/methods/observationMethod#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

dcterms:created a owl:DatatypeProperty.
dcterms:identifier a owl:DatatypeProperty.
dcterms:modified a owl:DatatypeProperty.
dcterms:publisher a owl:DatatypeProperty.
dcterms:title a owl:DatatypeProperty.
obsm:Above-Ground_Sticky_Trap a owl:Class;
                              rdfs:comment "Collection method based using a sticky substance that traps insects and other arthropods, usually in the form of a card with a sticky glue-like substance on one side. Often colored yellow or blue.";
                              rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Aerial_Collection_Net a owl:Class;
                           rdfs:comment """\"Butterfly\" Type Net""";
                           rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:ArthropodCollectionMethods a owl:Class.
obsm:Aspirator a owl:Class;
               rdfs:comment "A handheld device operated by suction from the lungs of the collector or a vacuum fan, used to collect arthropods.";
               rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:Barrier_Pitfall_Trap a owl:Class;
                          rdfs:comment "A form of Pitfall Trap that uses a barrier wall that directs arthropods into one of two pitfall traps at either end.";
                          rdfs:subClassOf obsm:Pitfall_Based_Trap.
obsm:Berlese_Sample a owl:Class;
                    rdfs:comment "Method of arthropod collection for soil and litter samples";
                    rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:CO2_Trap a owl:Class;
              rdfs:comment "Usually a suction-based trap that collects arthropods attracted to light and CO2 (carbon dioxide)";
              rdfs:subClassOf obsm:Hanging_Suction_Based_Attraction_Trap.
obsm:Cantharidin_Baited_Jar_Trap a owl:Class;
                                 rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Cantharidin_Baited_Lindgren_Trap a owl:Class;
                                      rdfs:subClassOf obsm:Lindgren_Trap.
obsm:Chicken-Mash_Baited_Trap a owl:Class;
                              rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Flight_Intercept_Trap a owl:Class;
                           rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Ground-based_Sticky_Trap a owl:Class;
                              rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Hand_Collected a owl:Class;
                    rdfs:comment "Collection by hand, usually into a jar or container";
                    rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:Hanging_Suction_Based_Attraction_Trap a owl:Class;
                                           rdfs:comment "Suction based traps, usually for flying insects. Often combined with an attractant.";
                                           rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Human_Bite_Collection a owl:Class;
                           rdfs:comment "Manual collection of insects and other arthropods that bite humans using an aspirator. Usually used to collect mosquitoes or other blood feeding insects.";
                           rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:Human_Observation a owl:Class.
obsm:Light_and_CO2_Trap a owl:Class;
                        rdfs:comment "Usually a suction-based trap that collects arthropods attracted to light and CO2.";
                        rdfs:subClassOf obsm:Hanging_Suction_Based_Attraction_Trap.
obsm:Lindgren_Trap a owl:Class;
                   rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Malaise_Trap a owl:Class;
                  rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Manual_Collection_Method a owl:Class;
                              rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Photographed a owl:Class.
obsm:Pitfall_Based_Trap a owl:Class;
                        rdfs:comment "Ground base traps that arthropods fall into.";
                        rdfs:subClassOf obsm:ArthropodCollectionMethods.
obsm:Pitfall_Trap a owl:Class;
                  rdfs:comment "A cup-like trap, place in the ground that captures terrestrial wandering arthropods which fall in.";
                  rdfs:subClassOf obsm:Pitfall_Based_Trap.
obsm:Sweep_Net a owl:Class;
               rdfs:comment "Similar to an Aerial net, but constructed of stronger fabric for sweeping through vegetation.";
               rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:UV_Light_Trap a owl:Class;
                   rdfs:subClassOf obsm:Hanging_Suction_Based_Attraction_Trap.
obsm:Unbaited_Lindgren_Funnel_Trap a owl:Class;
                                   rdfs:subClassOf obsm:Lindgren_Trap.
obsm:Vacuum_Collector a owl:Class;
                      rdfs:comment "A large, often back-mounted vacuum device to collect arthropods from vegetation.";
                      rdfs:subClassOf obsm:Manual_Collection_Method.
obsm:Visible_Light_Trap a owl:Class;
                        rdfs:subClassOf obsm:Hanging_Suction_Based_Attraction_Trap.
obsm:alpha-piniene_Baited_Lindgren_Trap a owl:Class;
                                        rdfs:subClassOf obsm:Lindgren_Trap.
obsm:ipsdiend_Baited_Lindgren_Trap a owl:Class;
                                   rdfs:subClassOf obsm:Lindgren_Trap.
<http://rdf.geospecies.org/methods/observationMethod.rdf> dcterms:created "2009-01-31";
                                                          dcterms:identifier "http://rdf.geospecies.org/methods/observationMethod.rdf";
                                                          dcterms:isPartOf <http://people.geospecies.org/projects/GeoSpecies_Knowledge_Base/>;
                                                          dcterms:modified "2009-02-15";
                                                          dcterms:publisher "Peter J. DeVries"@en-us;
                                                          dcterms:title "Observation Methods"@en-us;
                                                          a owl:Ontology;
                                                          rdfs:comment "This is a taxonomy of some observation methods. It is incomplete.";
                                                          foaf:maker <http://people.geospecies.org/people/Peter_J_DeVries/>.
doap:Project a owl:ObjectProperty.
foaf:maker a owl:ObjectProperty.
