@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ceon-actor: <http://w3id.org/CEON/ontology/actor/>.

<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
ceon-actor: <http://purl.org/dc/terms/contributor> "Eva Blomqvist",
                                                   "Mikael Lindecrantz",
                                                   "Robin Keskisärkkä";
            <http://purl.org/dc/terms/created> "2024-11-13"^^xsd:date;
            <http://purl.org/dc/terms/creator> "Huanyu Li";
            <http://purl.org/dc/terms/description> "The Actor module of CEON (Circular Economy Ontology Network).";
            <http://purl.org/dc/terms/issued> "2025-06-30"^^xsd:date;
            <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/";
            <http://purl.org/dc/terms/publisher> "Onto-DESIDE";
            <http://purl.org/dc/terms/title> "Circular Economy Ontology Network (CEON) - Actor Module";
            <http://purl.org/vocab/vann/preferredNamespacePrefix> "ceon-actor";
            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/CEON/ontology/actor/";
            <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: C0-1, C0-2, C3-4, T3-4.",
                                                                                                      "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: C0-1, C0-2, C3-4, T3-4.";
            a <http://www.w3.org/2002/07/owl#Ontology>;
            rdfs:seeAlso <https://github.com/LiUSemWeb/CEON>;
            <http://www.w3.org/2002/07/owl#imports> <http://w3id.org/CEON/ontology/actorODP/0.4/>;
            <http://www.w3.org/2002/07/owl#priorVersion> 0.3;
            <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/CEON/ontology/actor/0.4/>;
            <http://www.w3.org/2002/07/owl#versionInfo> 0.4.
ceon-actor:ActorCVNRole a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The role(s) of an actor in a Circular Value Network, which is a specific type of collaboration.";
                        rdfs:label "Actor Circular Value Network role";
                        rdfs:subClassOf ceon-actor:ActorCollaborationRole.
ceon-actor:ActorCollaborationRole a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "The roles of an actor involved in a collaboration.";
                                  rdfs:label "Actor collaboration role";
                                  rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/Role>.
ceon-actor:ActorProcessRole a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The role(s) of an actor involved in a process.";
                            rdfs:label "Actor process role";
                            rdfs:subClassOf ceon-actor:ActorCollaborationRole.
ceon-actor:ActorResourceRole a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The role(s) of an actor in relation to a resource.";
                             rdfs:label "Actor resource role";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/Role>.
ceon-actor:BuyingResource a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The relation where the role of the actor is the buyer of a certain resource.";
                          rdfs:label "Buying resource";
                          rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                           [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                           <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:buyer ; 
                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:CVNParticipation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A participation-relation, that represents the participation of an actor in a CVN with a certain role. For instance, a specific company playing the role of recycler in a certain flow of a CVN. The participation may also be related to a certain time (or time interval).";
                            rdfs:label "Circular Value Network Participation";
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation>
                                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-actor:ActorCVNRole ; 
                                                                                             <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/actorODP/Actor> ; 
                                                                                             <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participatingActor> ; 
                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/cvn/CVN> ; 
                                                                                             <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participationIn> ; 
                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                             a <http://www.w3.org/2002/07/owl#Class>],
                                            <http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation>.
ceon-actor:ConsumingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the consumer of a certain resource.";
                             rdfs:label "Consuming resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:consumer ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:DismantlingResource a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The relation where the role of the actor is the dismantler of a certain resource.";
                               rdfs:label "Dismantling resource";
                               rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                                [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:dismantler ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:IssuingResource a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The relation where the role of the actor is the issuer of a certain resource.";
                           rdfs:label "Issuing resource";
                           rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:issuer ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:ManufacturingResource a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "The relation where the role of the actor is the manufacturer of a certain resource.";
                                 rdfs:label "Manufacturing resource";
                                 rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                                  [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:manufacturer ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:Organisation a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment """Person or group of people that has its own functions with responsibilities, authorities, and relationships to achieve its objectives. The concept of organization includes, but is not limited to sole-trader, company, corporation, firm, enterprise, authority, partnership, charity or institution, or part or combination thereof, whether incorporated or not, public or private (e.g. foundation, union, association, agency, municipality, region, country, intergovernmental agencies). A group of organizations can also be considered as	an organization that has, alone or collectively,their own objectives."""@en;
                        rdfs:isDefinedBy "ISO 59004:2024 - 3.4.1 organization";
                        rdfs:label "Organisation"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-actor:OrganisationLocation ; 
                                                                                         <http://www.w3.org/2002/07/owl#onProperty> ceon-actor:hasOrganisationLocation ; 
                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                         [<http://www.w3.org/2002/07/owl#onProperty> ceon-actor:hasOrganisationLocation ; 
                                                                                         <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-actor:OrganisationLocation ; 
                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:string ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> ceon-actor:hasOrganisationName ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        <http://w3id.org/CEON/ontology/actorODP/Actor>.
ceon-actor:OrganisationLocation a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Location of an organisation";
                                rdfs:label "Organisation Location";
                                rdfs:subClassOf <http://w3id.org/CEON/ontology/location/Location>.
ceon-actor:OwningResource a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The relation where the role of the actor is the owner of a certain resource.";
                          rdfs:label "Owning resource";
                          rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                           [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                           <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:owner ; 
                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:Person a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Person"@en;
                  rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/Actor>.
ceon-actor:ProcessParticipation a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Participation of a certain actor in a certain process, with a certain role. For instance, a certain department of a recycling company having the role of quality controllant, or material sorter, in a certain recycling process. The participation may also be given a time, e.g. a start and end time.";
                                rdfs:label "Process Participation";
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation>
                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-actor:ActorProcessRole ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/actorODP/Actor> ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participatingActor> ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/processODP/Process> ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participationIn> ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                 a <http://www.w3.org/2002/07/owl#Class>],
                                                <http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation>.
ceon-actor:ProducingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the producer of a certain resource.";
                             rdfs:label "Producing resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:producer ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:ProvidingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the provider of a certain resource.";
                             rdfs:label "Providing resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:provider ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:RecyclingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the recycler of a certain resource.";
                             rdfs:label "Recycling resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:recycler ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:RepairingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the repairer of a certain resource.";
                             rdfs:label "Repairing resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:repairer ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:ResellingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the reseller of a certain resource.";
                             rdfs:label "Reselling resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:reseller ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:SellingResource a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The relation where the role of the actor is the seller of a certain resource.";
                           rdfs:label "Selling resource";
                           rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:seller ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:Stakeholder a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Person or organization that can affect, be affected by, or perceive itself to be affected by a decision or activity. To “perceive itself to be affected” means the perception has been made known to the organization."@en;
                       rdfs:isDefinedBy "ISO 59004:2024 - 3.4.2 interested party, stakeholder";
                       rdfs:label "Stakeholder"@en,
                                  "Interested Party";
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> (ceon-actor:Organisation
                                                                                 ceon-actor:Person) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:SupplyingResource a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "The relation where the role of the actor is the supplier of a certain resource.";
                             rdfs:label "Supplying resource";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:supplier ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:TakingBackResource a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "Taking back resource",
                                         "The relation where the role of the actor is the collector of a certain resource.";
                              rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                               [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                               <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:collector ; 
                                                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                               a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:UpdatingResource a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The relation where the role of the actor is the updater of a certain resource.";
                            rdfs:label "Updating resource";
                            rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:updater ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:UsingResource a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The relation where the role of the actor is the user of a certain resource.";
                         rdfs:label "Using resource";
                         rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:user ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                          a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:ViewingResource a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The relation where the role of the actor is the viewer of a certain resource.";
                           rdfs:label "Viewing resource";
                           rdfs:subClassOf <http://w3id.org/CEON/ontology/actorODP/ResourceRelation>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/ResourceRelation>
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#hasValue> ceon-actor:viewer ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
ceon-actor:buyer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   ceon-actor:ActorResourceRole.
ceon-actor:capabilityExtent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "The extent of this capability, e.g. stating whether there are limist to the capability, such as a maximum amount or size of something.";
                            rdfs:domain <http://w3id.org/CEON/ontology/actorODP/Capability>;
                            rdfs:label "capability extent";
                            rdfs:subPropertyOf <http://w3id.org/CEON/ontology/actorODP/capabilityProperty>.
ceon-actor:collector a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                       ceon-actor:ActorCVNRole.
ceon-actor:consumer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorResourceRole.
ceon-actor:dismantler a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        ceon-actor:ActorCVNRole.
ceon-actor:hasOrganisationLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "Represent that an organisation has some locations.";
                                   rdfs:domain ceon-actor:Organisation;
                                   rdfs:label "has organisation location";
                                   rdfs:range ceon-actor:OrganisationLocation;
                                   rdfs:subPropertyOf <http://w3id.org/CEON/ontology/location/hasLocation>.
ceon-actor:hasOrganisationName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:domain ceon-actor:Organisation;
                               rdfs:label "Represent name of an organisation.",
                                          "has organisation name";
                               rdfs:range xsd:string.
ceon-actor:issuer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                    ceon-actor:ActorResourceRole.
ceon-actor:manufacturer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                          ceon-actor:ActorCVNRole.
ceon-actor:neededResourceRelation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "In order for an actor to have a capability, it needs to have certain resources, e.g. materials, infrastrucutre, know-how, information etc.";
                                  rdfs:domain <http://w3id.org/CEON/ontology/actorODP/Capability>;
                                  rdfs:label "needed resource relations";
                                  rdfs:subPropertyOf <http://w3id.org/CEON/ontology/actorODP/capabilityProperty>.
ceon-actor:owner a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   ceon-actor:ActorResourceRole.
ceon-actor:producer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorResourceRole.
ceon-actor:provider a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorResourceRole.
ceon-actor:recycler a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorCVNRole.
ceon-actor:repairer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorResourceRole.
ceon-actor:reseller a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorCVNRole,
                      ceon-actor:ActorResourceRole.
ceon-actor:seller a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                    ceon-actor:ActorCVNRole,
                    ceon-actor:ActorResourceRole.
ceon-actor:supplier a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ceon-actor:ActorCVNRole,
                      ceon-actor:ActorResourceRole.
ceon-actor:updater a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     ceon-actor:ActorResourceRole.
ceon-actor:user a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  ceon-actor:ActorCVNRole,
                  ceon-actor:ActorResourceRole.
ceon-actor:viewer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                    ceon-actor:ActorResourceRole.
<http://w3id.org/CEON/ontology/actorODP/Actor> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/actorODP/Capability> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/actorODP/CollaborationParticipation> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/actorODP/Participation> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/actorODP/ResourceRelation> a <http://www.w3.org/2002/07/owl#Class>;
                                                          rdfs:comment "A relation between a resource, an actor, and the role the actor has in relation to the resource. For instance, the role of owner that a certain actor takes for a certain resource for a certain period of time. Or the seller of a certain resource, until that resource has been sold, and the actor no longer has that role in relation to the resource.";
                                                          rdfs:label "Resource Relation";
                                                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://w3id.org/CEON/ontology/actorODP/Participation>
                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-actor:ActorResourceRole ; 
                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participantRole> ; 
                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/actorODP/Actor> ; 
                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participatingActor> ; 
                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/resourceODP/Resource> ; 
                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/actorODP/participatingResource> ; 
                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>].
<http://w3id.org/CEON/ontology/actorODP/Role> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/actorODP/capabilityProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/actorODP/participantRole> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/actorODP/participatingActor> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/actorODP/participatingResource> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/actorODP/participationIn> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/cvn/CVN> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/location/Location> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/location/hasLocation> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/processODP/Process> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/resourceODP/Resource> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
