@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix aiiso: <http://purl.org/vocab/aiiso/schema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

<http://creativecommons.org/licenses/by/2.0/uk/> <http://web.resource.org/cc/permits> <http://web.resource.org/cc/Reproduction>,
                                                                                      <http://web.resource.org/cc/Distribution>,
                                                                                      <http://web.resource.org/cc/DerivativeWorks>;
                                                 <http://web.resource.org/cc/requires> <http://web.resource.org/cc/Notice>,
                                                                                       <http://web.resource.org/cc/Attribution>;
                                                 a <http://web.resource.org/cc/License>.
<http://purl.org/vocab/aiiso/schema> dc11:contributor "Ian Corns",
                                                      "Sarah Bartlett",
                                                      "Chris Wallace";
                                     dc11:creator "Rob Styles",
                                                  "Nadeem Shabir";
                                     dc11:date "2008-05-20";
                                     dc11:identifier "http://purl.org/vocab/aiiso/schema-20080925";
                                     dc11:rights "Copyright © 2008 Talis Information Ltd";
                                     dc11:title "Academic Institution Internal Structure Ontology (AIISO)"@en;
                                     dcterms:hasFormat <http://purl.org/vocab/aiiso/schema-20080925.html>,
                                                       <http://purl.org/vocab/aiiso/schema-20080925.rdf>;
                                     dcterms:isVersionOf aiiso:;
                                     dcterms:issued "2008-05-14";
                                     dcterms:replaces <http://purl.org/vocab/aiiso/schema-20080520>;
                                     vann:preferredNamespacePrefix "aiiso";
                                     vann:preferredNamespaceUri "http://purl.org/vocab/aiiso/schema#";
                                     vann:usageNote <http://purl.org/vocab/aiiso/usagenote.html>;
                                     <http://web.resource.org/cc/license> <http://creativecommons.org/licenses/by/2.0/uk/>;
                                     a owl:Ontology,
                                       <http://web.resource.org/cc/Work>;
                                     rdfs:comment """
			The Academic Institution Internal Structure Ontology (AIISO) provides classes and properties to describe the internal organizational structure of an academic institution. AIISO is designed to work in partnership with Participation (http://purl.org/vocab/participation/schema), FOAF (http://xmlns.com/foaf/0.1/) and aiiso-roles (http://purl.org/vocab/aiiso-roles/schema) to describe the roles that people play within an institution.
    	"""@en;
                                     skos:historyNote [dc11:date "2008-05-20" ; 
                                                       dc11:creator "Nadeem Shabir" ; 
                                                       rdf:value "Added statement of responsibility for both knowledgeGrouping and organizationalUnit"],
                                                      [dc11:date "2008-09-25" ; 
                                                       dc11:creator "Rob Styles" ; 
                                                       rdf:value "Changed subclassing to subclass from foaf:Organization and deprecated organizationalUnit"],
                                                      [dc11:date "2008-09-25" ; 
                                                       dc11:creator "Rob Styles" ; 
                                                       rdf:value "Deprecated name in favour of foaf:name"],
                                                      [dc11:date "2008-05-14" ; 
                                                       dc11:creator "Rob Styles" ; 
                                                       rdf:value "First cut of the ontology published"],
                                                      [dc11:date "2008-05-20" ; 
                                                       dc11:creator "Rob Styles" ; 
                                                       rdf:value "Corrected classes with more than one possible domain class to use owl:unionOf"].
aiiso:Center dcterms:issued "2008-05-14";
             a rdfs:Class;
             rdfs:comment "A Center is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a center.";
             rdfs:isDefinedBy aiiso:;
             rdfs:label "Center"@en;
             rdfs:subClassOf foaf:Organization.
aiiso:College dcterms:issued "2008-05-14";
              a rdfs:Class;
              rdfs:comment "A College is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a college.";
              rdfs:isDefinedBy aiiso:;
              rdfs:label "College"@en;
              rdfs:subClassOf foaf:Organization.
aiiso:Course dcterms:issued "2008-05-14";
             a rdfs:Class;
             rdfs:comment "A Course is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a course.";
             rdfs:isDefinedBy aiiso:;
             rdfs:label "Course"@en;
             rdfs:subClassOf aiiso:KnowledgeGrouping.
aiiso:Department dcterms:issued "2008-05-14";
                 a rdfs:Class;
                 rdfs:comment "A Department is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a department.";
                 rdfs:isDefinedBy aiiso:;
                 rdfs:label "Department"@en;
                 rdfs:subClassOf foaf:Organization.
aiiso:Division dcterms:issued "2008-05-14";
               a rdfs:Class;
               rdfs:comment "A Division is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a division.";
               rdfs:isDefinedBy aiiso:;
               rdfs:label "Division"@en;
               rdfs:subClassOf foaf:Organization.
aiiso:Faculty dcterms:issued "2008-05-14";
              a rdfs:Class;
              rdfs:comment "A Faculty is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a faculty.";
              rdfs:isDefinedBy aiiso:;
              rdfs:label "Faculty"@en;
              rdfs:subClassOf foaf:Organization.
aiiso:Institute dcterms:issued "2008-05-14";
                a rdfs:Class;
                rdfs:comment "An Institute is a group of people recognised by an organization as forming a cohesive group referred to by the organization as an institute.";
                rdfs:isDefinedBy aiiso:;
                rdfs:label "Institute"@en;
                rdfs:subClassOf foaf:Organization.
aiiso:Institution dcterms:issued "2008-05-14";
                  a rdfs:Class;
                  rdfs:comment "An Institution is the upper most level of an academic institution.";
                  rdfs:isDefinedBy aiiso:;
                  rdfs:label "Institution"@en;
                  rdfs:subClassOf foaf:Organization.
aiiso:KnowledgeGrouping dcterms:issued "2008-05-14";
                        a rdfs:Class,
                          owl:Class;
                        rdfs:comment "A KnowledgeGrouping represents a collection of resources, learning objectives, timetables, and other materials. The more specific subclasses of Subject, Programme, Course and Module are preferred.";
                        rdfs:isDefinedBy aiiso:;
                        rdfs:label "KnowledgeGrouping"@en;
                        owl:disjointWith foaf:Organization;
                        skos:historyNote [dc11:date "2008-09-25" ; 
                                          dc11:creator "Rob Styles" ; 
                                          rdf:value "Deprecated in favour of foaf:Organization"].
aiiso:Module dcterms:issued "2008-05-14";
             a rdfs:Class;
             rdfs:comment "A Module is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a module.";
             rdfs:isDefinedBy aiiso:;
             rdfs:label "Module"@en;
             rdfs:subClassOf aiiso:KnowledgeGrouping.
aiiso:Programme dcterms:issued "2008-05-14";
                a rdfs:Class;
                rdfs:comment "A Programme is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a programme.";
                rdfs:isDefinedBy aiiso:;
                rdfs:label "Programme"@en;
                rdfs:subClassOf aiiso:KnowledgeGrouping.
aiiso:ResearchGroup dcterms:issued "2008-05-14";
                    a rdfs:Class;
                    rdfs:comment "A Research Group is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a research group.";
                    rdfs:isDefinedBy aiiso:;
                    rdfs:label "Research Group"@en;
                    rdfs:subClassOf foaf:Organization.
aiiso:School dcterms:issued "2008-05-14";
             a rdfs:Class;
             rdfs:comment "A School is a group of people recognised by an organization as forming a cohesive group referred to by the organization as a school. This class refers schools within a higher education institution such as 'Harvard Law School' it does not refer to schools involved in earlier education.";
             rdfs:isDefinedBy aiiso:;
             rdfs:label "School"@en;
             rdfs:subClassOf foaf:Organization.
aiiso:Subject dcterms:issued "2008-05-14";
              a rdfs:Class;
              rdfs:comment "A Subject is a KnowledgeGrouping that represents a cohesive collection of educational material referred to by the owning organization as a subject.";
              rdfs:isDefinedBy aiiso:;
              rdfs:label "Subject"@en;
              rdfs:subClassOf aiiso:KnowledgeGrouping.
aiiso:code dcterms:issued "2008-05-14";
           a rdf:Property;
           rdfs:comment "The code used by an Institution to refer to a KnowledgeGrouping or Organization.";
           rdfs:domain [owl:unionOf (aiiso:KnowledgeGrouping
                                     foaf:Organization) ; 
                        a owl:Class];
           rdfs:isDefinedBy aiiso:;
           rdfs:label "code"@en;
           rdfs:range xsd:string;
           skos:historyNote [dc11:date "2008-05-20" ; 
                             dc11:creator "Rob Styles" ; 
                             rdf:value "Corrected the domain to use an owl:unionOf the two classes, allowing subjects of this property to be either a Knowledge Grouping or an organizational Unit rather than having to be both."].
aiiso:description dcterms:issued "2008-05-14";
                  a rdf:Property;
                  rdfs:comment "A Description of the KnowledgeGrouping or Organization.";
                  rdfs:domain [owl:unionOf (aiiso:KnowledgeGrouping
                                            foaf:Organization) ; 
                               a owl:Class];
                  rdfs:isDefinedBy aiiso:;
                  rdfs:label "description"@en;
                  rdfs:range xsd:string;
                  skos:historyNote [dc11:date "2008-05-20" ; 
                                    dc11:creator "Rob Styles" ; 
                                    rdf:value "Corrected the domain to use an owl:unionOf the two classes, allowing subjects of this property to be either a Knowledge Grouping or an organizational Unit rather than having to be both."].
aiiso:knowledgeGrouping dcterms:issued "2008-05-14";
                        a rdf:Property;
                        rdfs:comment "A KnowledgeGrouping may be contained by another KnowledgeGrouping or an organizationalUnit using knowledgeGrouping.";
                        rdfs:domain [owl:unionOf (aiiso:KnowledgeGrouping
                                                  foaf:Organization) ; 
                                     a owl:Class];
                        rdfs:isDefinedBy aiiso:;
                        rdfs:label "knowledgeGrouping"@en;
                        rdfs:range aiiso:KnowledgeGrouping;
                        status:term_status "Deprecated";
                        skos:historyNote [dc11:date "2008-05-20" ; 
                                          dc11:creator "Rob Styles" ; 
                                          rdf:value "Corrected the domain to use an owl:unionOf the two classes, allowing subjects of this property to be either a Knowledge Grouping or an organizational Unit rather than having to be both."],
                                         [dc11:date "2008-09-25" ; 
                                          dc11:creator "Rob Styles" ; 
                                          rdf:value "Deprecated due to poor and ambiguous naming"].
aiiso:name dcterms:issued "2008-05-14";
           a rdf:Property;
           rdfs:comment "Deprecated in favour of foaf:name. The name given to a KnowledgeGrouping or Organization.";
           rdfs:domain [owl:unionOf (aiiso:KnowledgeGrouping
                                     foaf:Organization) ; 
                        a owl:Class];
           rdfs:isDefinedBy aiiso:;
           rdfs:label "name"@en;
           rdfs:range xsd:string;
           rdfs:subPropertyOf rdfs:Label;
           status:term_status "Deprecated";
           skos:historyNote [dc11:date "2008-09-25" ; 
                             dc11:creator "Rob Styles" ; 
                             rdf:value "Deprecated in favour of foaf:name"],
                            [dc11:date "2008-05-20" ; 
                             dc11:creator "Rob Styles" ; 
                             rdf:value "Corrected the domain to use an owl:unionOf the two classes, allowing subjects of this property to be either a Knowledge Grouping or an organizational Unit rather than having to be both."].
aiiso:organization dcterms:issued "2008-09-25";
                   a rdf:Property;
                   rdfs:comment "A foaf Organization may contain other subsidiary Organizations using organization.";
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy aiiso:;
                   rdfs:label "organization"@en;
                   rdfs:range foaf:Organization;
                   owl:inverseOf aiiso:part_of;
                   skos:historyNote [dc11:date "2008-09-25" ; 
                                     dc11:creator "Rob Styles" ; 
                                     rdf:value "introduced to replace organizationalUnit"].
aiiso:organizationalUnit dcterms:issued "2008-05-14";
                         a rdf:Property,
                           rdfs:Class;
                         rdfs:comment "Deprecated due to poor naming, you should use organization and part_of instead. An organizationalUnit may contain other organizationalUnits using organizationalUnit.",
                                      "organizationalUnit is now deprecated, it was used to describe a group of people that form a part of an organizations institutional hierarchy. More specific classes of Institution, Department, Faculty, School, College, Center, Division and Institute exist were previously subclassed from here. They now subclass foaf:Organization.";
                         rdfs:domain foaf:Organization;
                         rdfs:isDefinedBy aiiso:;
                         rdfs:label "organizational Unit"@en,
                                    "organizationalUnit"@en;
                         rdfs:range foaf:Organization;
                         status:term_status "Deprecated";
                         skos:historyNote [dc11:date "2008-09-25" ; 
                                           dc11:creator "Rob Styles" ; 
                                           rdf:value "Deprecated due to poor and ambiguous naming"],
                                          [dc11:date "2008-09-25" ; 
                                           dc11:creator "Rob Styles" ; 
                                           rdf:value "Deprecated in favour of foaf:Organization"].
aiiso:part_of dcterms:issued "2008-09-25";
              a rdf:Property;
              rdfs:comment "A foaf Organization may refer to its parent Organizations using part_of.";
              rdfs:domain foaf:Organization;
              rdfs:isDefinedBy aiiso:;
              rdfs:label "part of"@en;
              rdfs:range foaf:Organization;
              owl:inverseOf aiiso:organization;
              skos:historyNote [dc11:date "2008-09-25" ; 
                                dc11:creator "Rob Styles" ; 
                                rdf:value "introduced to replace organizationalUnit"].
aiiso:responsibilityOf dcterms:issued "2008-05-20";
                       a rdf:Property;
                       rdfs:domain [owl:unionOf (aiiso:KnowledgeGrouping
                                                 foaf:Organization) ; 
                                    a owl:Class];
                       rdfs:isDefinedBy aiiso:;
                       rdfs:label "responsibility of"@en;
                       rdfs:range <http://xmlns.com/foaf/spec/Agent>;
                       owl:inverseOf aiiso:responsibleFor.
aiiso:responsibleFor dcterms:issued "2008-09-25";
                     a rdf:Property;
                     rdfs:domain <http://xmlns.com/foaf/spec/Agent>;
                     rdfs:isDefinedBy aiiso:;
                     rdfs:label "responsible for"@en;
                     rdfs:range [owl:unionOf (aiiso:KnowledgeGrouping
                                              foaf:Organization) ; 
                                 a owl:Class];
                     owl:inverseOf aiiso:responsibilityOf;
                     skos:historyNote [dc11:date "2008-09-25" ; 
                                       dc11:creator "Rob Styles" ; 
                                       rdf:value "Added as inverse of Responsibility Of"].
aiiso:teaches dcterms:issued "2008-09-25";
              a rdf:Property;
              rdfs:comment "An organization may specify the Knowledge Groupings that it teaches using this property.";
              rdfs:domain foaf:Organization;
              rdfs:isDefinedBy aiiso:;
              rdfs:label "teaches"@en;
              rdfs:range aiiso:KnowledgeGrouping.
<http://purl.org/vocab/aiiso/schema-20080925.html> dc11:format [rdfs:label "HTML"@en ; 
                                                                rdf:value "text/html" ; 
                                                                a dcterms:IMT];
                                                   a dcmitype:Text.
<http://purl.org/vocab/aiiso/schema-20080925.rdf> dc11:format [rdfs:label "RDF"@en ; 
                                                               rdf:value "application/rdf+xml" ; 
                                                               a dcterms:IMT];
                                                  a dcmitype:Text.
foaf:Organization a owl:Class.
