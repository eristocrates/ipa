@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ceon-process: <http://w3id.org/CEON/ontology/process/>.

<http://w3id.org/CEON/ontology/energy/Energy> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:comment "An amount of energy.";
                                              rdfs:label "Energy";
                                              rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Resource>.
ceon-process: <http://purl.org/dc/terms/contributor> "Eva Blomqvist",
                                                     "Mikael Lindecrantz",
                                                     "Robin Keskisärkkä";
              <http://purl.org/dc/terms/created> "2025-05-21"^^xsd:date;
              <http://purl.org/dc/terms/creator> "Huanyu Li";
              <http://purl.org/dc/terms/description> "The Process module of CEON (Circular Economy Ontology Network).";
              <http://purl.org/dc/terms/issued> "2025-06-30"^^xsd:date;
              <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/";
              <http://purl.org/dc/terms/publisher> "Onto-DESIDE";
              <http://purl.org/dc/terms/title> "Circular Economy Ontology Network (CEON) - Process Module";
              <http://purl.org/vocab/vann/preferredNamespacePrefix> "ceon-process";
              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/CEON/ontology/process/";
              <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: T8-2.",
                                                                                                        "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: T8-2.";
              a <http://www.w3.org/2002/07/owl#Ontology>;
              rdfs:seeAlso <https://github.com/LiUSemWeb/CEON>;
              <http://www.w3.org/2002/07/owl#imports> <http://w3id.org/CEON/ontology/processODP/0.5/>;
              <http://www.w3.org/2002/07/owl#priorVersion> 0.4;
              <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/CEON/ontology/process/0.5/>;
              <http://www.w3.org/2002/07/owl#versionInfo> 0.5.
ceon-process:AssemblingProcess a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "A process of assembling.";
                               rdfs:label "Assembling Process";
                               rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:BuyResourceProcess a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A process of buying a resource.";
                                rdfs:label "Buy Resource Process";
                                rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:CO2Emission a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An amount of CO2.";
                         rdfs:label "CO2 emission";
                         rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Resource>.
ceon-process:Catalyst a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A resource that is needed as a catalyst by a process, but that is not considered the direct input or output of it.";
                      rdfs:label "Catalyst";
                      rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Resource>.
ceon-process:ChangeResourceProcess a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A process of a changing resource.";
                                   rdfs:label "Change Resource Process";
                                   rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:ContactProcess a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A contact process.";
                            rdfs:label "Contact Process";
                            rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:DeconstructionProcess a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A process of deconstruction.";
                                   rdfs:label "Deconstruction Process";
                                   rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:DisassemblingProcess a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A process of disassembling.";
                                  rdfs:label "Disassembling Process";
                                  rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:DismantleProcess a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A process of dismantling.";
                              rdfs:label "Dismantle Process";
                              rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:EnsureClaimProcess a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A process of ensuring a claim.";
                                rdfs:label "Ensure Claim Process";
                                rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:IssuingCertificateProcess a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A process of issuing a certificate.";
                                       rdfs:label "Issuing Certificate Process";
                                       rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:ManufacturingProcess a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A process of manufacturing.";
                                  rdfs:label "Manufacturing Process";
                                  rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:OffsetProcess a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A process of offsetting.";
                           rdfs:label "Offset Process";
                           rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:ProductionProcess a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "A process of production.";
                               rdfs:label "Production Process";
                               rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:RecycleProcess a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A process of recycling.";
                            rdfs:label "Recycle Process";
                            rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:RefurbishmentProcess a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A process of refurbishment.";
                                  rdfs:label "Refurbishment Process";
                                  rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:RemoveProcess a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A process of removing.";
                           rdfs:label "Remove Process";
                           rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:RemoveResourceProcess a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A process of removing a resource.";
                                   rdfs:label "Remove Resource Process";
                                   rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:RepairProcess a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A process of repairing.";
                           rdfs:label "Repair Process";
                           rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:ResellProcess a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A process of reselling.";
                           rdfs:label "Resell Process";
                           rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:ReuseProcess a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A process of reusing.";
                          rdfs:label "Reuse Process";
                          rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:SellResourceProcess a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A process of selling a resource.";
                                 rdfs:label "Sell Resource Process";
                                 rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:ServiceProcess a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A process of servicing.";
                            rdfs:label "Service Process";
                            rdfs:subClassOf ceon-process:TransformationProcess.
ceon-process:ShareResourceProcess a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A process of sharing a resource.";
                                  rdfs:label "Share Resource Process";
                                  rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:TakeBackProcess a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A process of taking back.";
                             rdfs:label "Take Back Process";
                             rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:TransformationProcess a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Set of interrelated or interacting activities that transforms inputs into outputs."@en;
                                   rdfs:isDefinedBy "ISO 59004:2024  - 3.5.5 process";
                                   rdfs:label "Transformation Process";
                                   rdfs:seeAlso "https://ref.gs1.org/epcis/Transformation";
                                   rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Process>.
ceon-process:Transition a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A transition is a situation that creates a context for two additional different Situations, one Process, and at least one Object: one Situation is the state before the transition, the second Situation is the state after the transition, the Process is the invariance under some different transitions, in which at least one Object is situated. Finally, one or more time interval(s) may position the situations and the transitional event in time, and we may include the event that triggered the transition as well.";
                        rdfs:label "Transition";
                        rdfs:subClassOf <http://w3id.org/CEON/ontology/processODP/Situation>.
ceon-process:affectsObject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "A certain transition may affect objects, e.g. material that changes its state from one situation to another.";
                           rdfs:domain ceon-process:Transition;
                           rdfs:label "affects object";
                           rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/isSettingFor>.
ceon-process:needsEnergy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "The energy needed to perform a certain process.";
                         rdfs:label "needs energy";
                         rdfs:range <http://w3id.org/CEON/ontology/energy/Energy>;
                         rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/hasInput>.
ceon-process:producesCO2 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "The CO2 released or produced by the process.";
                         rdfs:label "produces CO2";
                         rdfs:range ceon-process:CO2Emission;
                         rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/hasOutput>.
ceon-process:resultingResource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "The resource that is the output (product, i.e. what is produced) from a certain process.";
                               rdfs:label "resulting resource";
                               rdfs:range <http://w3id.org/CEON/ontology/resourceODP/Resource>;
                               rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/hasOutput>.
ceon-process:usesCatalyst a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "The catalyst used in a process.";
                          rdfs:label "uses catalyst";
                          rdfs:range ceon-process:Catalyst;
                          rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/hasInput>.
<http://w3id.org/CEON/ontology/processODP/Event> a <http://www.w3.org/2002/07/owl#Class>;
                                                 rdfs:seeAlso "https://ref.gs1.org/epcis/EPCISEvent".
<http://w3id.org/CEON/ontology/processODP/hasInput> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/processODP/hasOutput> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/resourceODP/Resource> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "Some resources can be specifically associated with processes.".
