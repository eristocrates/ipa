@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix w3id: <https://w3id.org/>.
@prefix aeros: <https://w3id.org/aerOS/continuum#>.
@prefix modp: <https://w3id.org/mod#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix rml-fnml: <http://w3id.org/rml/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.

dcterms:conformsTo a owl:DatatypeProperty;
                   rdfs:isDefinedBy dcterms:;
                   rdfs:label "conforms to".
dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty,
                      owl:DatatypeProperty;
                    rdfs:isDefinedBy dcterms:;
                    rdfs:label "description".
dcterms:identifier a owl:DatatypeProperty;
                   rdfs:isDefinedBy dcterms:;
                   rdfs:label "identifier";
                   rdfs:range rdfs:Literal.
dcterms:license a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:publisher a owl:ObjectProperty;
                  rdfs:isDefinedBy dcterms:;
                  rdfs:label "publisher".
dcterms:source a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:example a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
rml-fnml:TriplesMap a owl:Class;
                    rdfs:isDefinedBy rml-fnml:;
                    rdfs:label "Triples Map".
xsd:date a rdfs:Datatype.
owl:versionInfo a owl:AnnotationProperty.
skos:Concept a owl:Class;
             rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>;
             rdfs:label "Concept".
skos:ConceptScheme a owl:Class;
                   rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>;
                   rdfs:label "Concept Scheme".
skos:inScheme a owl:ObjectProperty;
              rdfs:domain skos:Concept;
              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core>;
              rdfs:label "in scheme";
              rdfs:range skos:ConceptScheme.
aerdcat:Catalog a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "Catalog".
aerdcat:DataService a owl:Class;
                    rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                    rdfs:label "Data Service".
aerdcat:Dataset a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "Dataset".
aerdcat:Distribution a owl:Class;
                     rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                     rdfs:label "Distribution".
aerdcat:accessService a owl:ObjectProperty;
                      rdfs:domain aerdcat:Distribution;
                      rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                      rdfs:label "access service";
                      rdfs:range aerdcat:DataService.
aerdcat:accessURL a owl:DatatypeProperty;
                  rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                  rdfs:label "access url".
aerdcat:catalog a owl:ObjectProperty;
                rdfs:domain aerdcat:Catalog;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "catalog";
                rdfs:range aerdcat:Catalog.
aerdcat:dataset a owl:ObjectProperty;
                rdfs:domain aerdcat:Catalog;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "dataset";
                rdfs:range aerdcat:Dataset.
aerdcat:distribution a owl:ObjectProperty;
                     rdfs:domain aerdcat:Dataset;
                     rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                     rdfs:label "distribution";
                     rdfs:range aerdcat:Distribution.
aerdcat:endpointURL a owl:DatatypeProperty;
                    rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                    rdfs:label "endpoint url".
aerdcat:keyword a owl:DatatypeProperty;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "keyword".
aerdcat:mediaType a owl:DatatypeProperty;
                  rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                  rdfs:label "media type".
aerdcat:servesDataset a owl:ObjectProperty;
                      rdfs:domain aerdcat:DataService;
                      rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                      rdfs:label "serves dataset";
                      rdfs:range aerdcat:Dataset.
aerdcat:service a owl:ObjectProperty;
                rdfs:domain aerdcat:Catalog;
                rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                rdfs:label "service";
                rdfs:range aerdcat:DataService.
aerdcat:theme a owl:ObjectProperty;
              rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
              rdfs:label "theme".
aerdcat:themeTaxonomy a owl:ObjectProperty;
                      rdfs:domain aerdcat:Catalog;
                      rdfs:isDefinedBy <http://www.w3.org/ns/dcat>;
                      rdfs:label "theme taxonomy".
org:Membership a owl:Class;
               rdfs:isDefinedBy org:;
               rdfs:label "Membership".
org:Organization a owl:Class;
                 rdfs:isDefinedBy org:;
                 rdfs:label "Organization".
org:Role a owl:Class;
         rdfs:isDefinedBy org:;
         rdfs:label "Role".
org:member a owl:ObjectProperty;
           rdfs:domain org:Membership;
           rdfs:isDefinedBy org:;
           rdfs:label "member".
org:organization a owl:ObjectProperty;
                 rdfs:domain org:Membership;
                 rdfs:isDefinedBy org:;
                 rdfs:label "organization";
                 rdfs:range org:Organization.
org:role a owl:ObjectProperty;
         rdfs:domain org:Membership;
         rdfs:isDefinedBy org:;
         rdfs:label "role";
         rdfs:range org:Role.
aeros:Domain a owl:Class;
             rdfs:isDefinedBy <https://w3id.org/aerOS/continuum>;
             rdfs:label "Domain".
aeros:User a owl:Class;
           rdfs:isDefinedBy <https://w3id.org/aerOS/continuum>;
           rdfs:label "User".
aeros:domain a owl:ObjectProperty;
             rdfs:isDefinedBy <https://w3id.org/aerOS/continuum>;
             rdfs:label "domain";
             rdfs:range aeros:Domain.
<https://w3id.org/aerOS/data-catalog#> dcterms:creator "Ignacio Dominguez Martinez-Casanueva";
                                       dcterms:description """
                                        Ontology that defines concepts for representing the aerOS Data Catalog
                                        """;
                                       dcterms:license <http://purl.org/NET/rdflicense/APACHE2.0>;
                                       dcterms:modified "2024-08-23"^^xsd:date;
                                       dcterms:source <https://gitlab.aeros-project.eu/wp4/t4.1/data-catalog-ontology>;
                                       dcterms:title "aerOS Data Catalog Ontology";
                                       vann:preferredNamespacePrefix "aerdcat";
                                       vann:preferredNamespaceUri <https://w3id.org/aerOS/data-catalog#>;
                                       a owl:Ontology;
                                       rdfs:label "aerOS Data Catalog Ontology"@en;
                                       owl:versionIRI <https://w3id.org/aerOS/data-catalog>;
                                       owl:versionInfo "1.0.0";
                                       modp:createdWith <https://chowlk.linkeddata.es/>.
<https://w3id.org/aerOS/data-catalog#ContextBroker> a owl:Class;
                                                    rdfs:comment "Represents an NGSI-LD Context Broker.";
                                                    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                    rdfs:label "Context Broker";
                                                    rdfs:subClassOf aerdcat:DataService.
<https://w3id.org/aerOS/data-catalog#DataProduct> a owl:Class;
                                                  rdfs:comment "Representation of a data product as wrapper of a dataset.";
                                                  rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                  rdfs:label "Data Product";
                                                  rdfs:subClassOf aerdcat:Dataset.
<https://w3id.org/aerOS/data-catalog#DataProductOwner> a owl:NamedIndividual,
                                                         org:Role;
                                                       rdfs:comment "Person responsible for the creation and publication of a data product.";
                                                       rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                       rdfs:label "Data Product Owner".
<https://w3id.org/aerOS/data-catalog#contextBroker> a owl:ObjectProperty;
                                                    rdfs:comment "Relation with a context broker.";
                                                    rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                    rdfs:label "context broker";
                                                    rdfs:range <https://w3id.org/aerOS/data-catalog#ContextBroker>;
                                                    rdfs:subPropertyOf aerdcat:service.
<https://w3id.org/aerOS/data-catalog#dataProduct> a owl:ObjectProperty;
                                                  rdfs:comment "Relation with a data product.";
                                                  rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                  rdfs:label "data product";
                                                  rdfs:range <https://w3id.org/aerOS/data-catalog#DataProduct>;
                                                  rdfs:subPropertyOf aerdcat:dataset.
<https://w3id.org/aerOS/data-catalog#servesDataProduct> a owl:ObjectProperty;
                                                        rdfs:comment "Denotes a data product exposed by a data service.";
                                                        rdfs:isDefinedBy <https://w3id.org/aerOS/data-catalog>;
                                                        rdfs:label "serves data product";
                                                        rdfs:range <https://w3id.org/aerOS/data-catalog#DataProduct>;
                                                        rdfs:subPropertyOf aerdcat:servesDataset.
modp:createdWith a owl:AnnotationProperty.
