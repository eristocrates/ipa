@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix tzont: <http://www.w3.org/2006/timezone#>.

<http://www.w3.org/2006/timezone> a <http://www.w3.org/2002/07/owl#Ontology>;
                                  rdfs:comment """
      A time zone ontology.
    """;
                                  rdfs:seeAlso <http://www.w3.org/TR/owl-time>;
                                  <http://www.w3.org/2002/07/owl#imports> <http://www.daml.org/2001/09/countries/iso-3166-ont>,
                                                                          <http://www.daml.ri.cmu.edu/ont/USRegionState.daml>.
tzont:City a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf tzont:PoliticalRegion.
tzont:Country a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf tzont:PoliticalRegion.
tzont:County a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf tzont:PoliticalRegion;
             <http://www.w3.org/2002/07/owl#subClassOf> [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasParentRegion ; 
                                                         <http://www.w3.org/2002/07/owl#allValuesFrom> tzont:State ; 
                                                         a <http://www.w3.org/2002/07/owl#Restriction>].
tzont:DLSendDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:range xsd:date.
tzont:DLSstartDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:range xsd:date.
tzont:DaylightSavingsPolicy a <http://www.w3.org/2002/07/owl#Class>.
tzont:EnumeratedDaylightSavingsPolicy a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> tzont:DLSstartDate ; 
                                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:DLSendDate ; 
                                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      tzont:DaylightSavingsPolicy.
tzont:GMToffset a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain tzont:TimeZone;
                rdfs:range xsd:duration.
tzont:PoliticalRegion a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> tzont:name ; 
                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasParentRegion ; 
                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasTimeZone ; 
                                       <http://www.w3.org/2002/07/owl#maxCardinality> "3"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:observesDaylightSavingsTime ; 
                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasDaylightSavingsPolicy ; 
                                       <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:exceptionalRegion ; 
                                       <http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> tzont:timeZonePart ; 
                                       <http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      tzont:Region.
tzont:Region a <http://www.w3.org/2002/07/owl#Class>.
tzont:Reservation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf tzont:PoliticalRegion;
                  <http://www.w3.org/2002/07/owl#subClassOf> [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasParentRegion ; 
                                                              <http://www.w3.org/2002/07/owl#allValuesFrom> tzont:Country ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>].
tzont:State a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf tzont:PoliticalRegion;
            <http://www.w3.org/2002/07/owl#subClassOf> [<http://www.w3.org/2002/07/owl#onProperty> tzont:hasParentRegion ; 
                                                        <http://www.w3.org/2002/07/owl#allValuesFrom> tzont:Country ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>].
tzont:TimeZone a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> tzont:name ; 
                                <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> tzont:GMToffset ; 
                                <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
tzont:countryOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:range tzont:Country;
                rdfs:subPropertyOf tzont:hasParentRegion.
tzont:exceptionalRegion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain tzont:Region;
                        rdfs:range tzont:Region.
tzont:hasAncestorRegion a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                        rdfs:domain tzont:Region;
                        rdfs:range tzont:Region.
tzont:hasDaylightSavingsPolicy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:domain tzont:Region;
                               rdfs:range tzont:DaylightSavingsPolicy.
tzont:hasParentRegion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:subPropertyOf tzont:hasAncestorRegion.
tzont:hasTimeZone a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain tzont:Region;
                  rdfs:range tzont:TimeZone.
tzont:name a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.daml.org/2001/09/countries/iso-3166-ont#name>.
tzont:observesDaylightSavingsTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:domain tzont:Region;
                                  rdfs:range xsd:boolean.
tzont:stateOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:range tzont:State;
              rdfs:subPropertyOf tzont:hasParentRegion.
tzont:timeZonePart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain tzont:Region;
                   rdfs:range tzont:Region.
