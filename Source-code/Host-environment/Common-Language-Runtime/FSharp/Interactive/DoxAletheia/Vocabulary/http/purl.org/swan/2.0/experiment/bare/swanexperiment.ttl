@base <http://swan.mindinformatics.org/ontologies/1.3/SWAN-MyExp.owl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://swan.mindinformatics.org/ontologies/1.3/SWAN-MyExp.owl#>.
@prefix SWAN-MyExp: <http://swan.mindinformatics.org/ontologies/1.3/SWAN-MyExp.owl#>.
@prefix experiment: <http://purl.org/swan/2.0/experiment#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix swanexperiment: <http://purl.org/swan/2.0/experiment>.

swanexperiment: a owl:Ontology;
                rdfs:label "v. 0.1".
experiment:Assay a owl:Class;
                 rdfs:subClassOf experiment:Data_Acquisition.
experiment:Biological_Factor a owl:Class;
                             rdfs:subClassOf experiment:Factor.
experiment:Biomaterial a owl:Class;
                       rdfs:subClassOf [a owl:Restriction ; 
                                        owl:onProperty experiment:derived_from ; 
                                        owl:someValuesFrom experiment:Population],
                                       [a owl:Restriction ; 
                                        owl:onProperty experiment:participates_in ; 
                                        owl:someValuesFrom experiment:Assay],
                                       [a owl:Restriction ; 
                                        owl:onProperty experiment:has_biomaterial_characteristics ; 
                                        owl:someValuesFrom experiment:Biomaterial_Characteristics].
experiment:Biomaterial_Characteristics a owl:Class;
                                       rdfs:subClassOf experiment:Biological_Factor.
experiment:Case_Control_Design a owl:Class;
                               rdfs:subClassOf experiment:Observational_Design.
experiment:Cohort_Based_Design a owl:Class;
                               rdfs:subClassOf experiment:Observational_Design.
experiment:Cross-sectional_Design a owl:Class;
                                  rdfs:subClassOf experiment:Observational_Design.
experiment:Data a owl:Class.
experiment:Data_Acquisition a owl:Class;
                            rdfs:subClassOf [a owl:Restriction ; 
                                             owl:onProperty experiment:has_output ; 
                                             owl:someValuesFrom experiment:Primary_Data],
                                            [a owl:Restriction ; 
                                             owl:onProperty experiment:part_of ; 
                                             owl:someValuesFrom experiment:Study].
experiment:Data_Analysis a owl:Class;
                         rdfs:subClassOf [a owl:Restriction ; 
                                          owl:onProperty experiment:has_output ; 
                                          owl:someValuesFrom experiment:Derived_Data],
                                         [a owl:Restriction ; 
                                          owl:onProperty experiment:part_of ; 
                                          owl:someValuesFrom experiment:Study],
                                         [a owl:Restriction ; 
                                          owl:onProperty experiment:has_partcipant ; 
                                          owl:someValuesFrom experiment:Design].
experiment:Data_Interpretation a owl:Class;
                               rdfs:subClassOf [a owl:Restriction ; 
                                                owl:onProperty experiment:part_of ; 
                                                owl:someValuesFrom experiment:Study],
                                               [a owl:Restriction ; 
                                                owl:onProperty experiment:has_input ; 
                                                owl:someValuesFrom experiment:Derived_Data].
experiment:Data_Processing a owl:Class;
                           rdfs:subClassOf [a owl:Restriction ; 
                                            owl:onProperty experiment:has_output ; 
                                            owl:someValuesFrom experiment:Derived_Data],
                                           [a owl:Restriction ; 
                                            owl:onProperty experiment:part_of ; 
                                            owl:someValuesFrom experiment:Study],
                                           [a owl:Restriction ; 
                                            owl:onProperty experiment:has_input ; 
                                            owl:someValuesFrom experiment:Primary_Data].
experiment:Derived_Data a owl:Class;
                        rdfs:subClassOf experiment:Data.
experiment:Design a owl:Class;
                  rdfs:subClassOf [a owl:Restriction ; 
                                   owl:onProperty experiment:part_of ; 
                                   owl:someValuesFrom experiment:Study].
experiment:Environmental_Factor a owl:Class;
                                rdfs:subClassOf experiment:Factor.
experiment:Factor a owl:Class;
                  rdfs:subClassOf [a owl:Restriction ; 
                                   owl:onProperty experiment:participates_in ; 
                                   owl:someValuesFrom experiment:Design].
experiment:Interventional_Design a owl:Class;
                                 rdfs:subClassOf experiment:Design.
experiment:Measurement a owl:Class;
                       rdfs:subClassOf experiment:Data_Acquisition.
experiment:Methodological_Factor a owl:Class;
                                 rdfs:subClassOf experiment:Factor.
experiment:Observational_Design a owl:Class;
                                rdfs:subClassOf experiment:Design.
experiment:Population a owl:Class;
                      rdfs:subClassOf [a owl:Restriction ; 
                                       owl:onProperty experiment:participates_in ; 
                                       owl:someValuesFrom experiment:Measurement].
experiment:Primary_Data a owl:Class;
                        rdfs:subClassOf experiment:Data,
                                        [a owl:Restriction ; 
                                         owl:onProperty experiment:is_about ; 
                                         owl:someValuesFrom experiment:Biomaterial],
                                        [a owl:Restriction ; 
                                         owl:onProperty experiment:is_about ; 
                                         owl:someValuesFrom experiment:Population].
experiment:Protocol a owl:Class;
                    rdfs:subClassOf [a owl:Restriction ; 
                                     owl:onProperty experiment:participates_in ; 
                                     owl:someValuesFrom experiment:Design].
experiment:Study a owl:Class;
                 rdfs:subClassOf [a owl:Restriction ; 
                                  owl:onProperty experiment:has_study_name ; 
                                  owl:someValuesFrom rdfs:Literal],
                                 [a owl:Restriction ; 
                                  owl:onProperty experiment:has_study_description ; 
                                  owl:someValuesFrom rdfs:Literal],
                                 [a owl:Restriction ; 
                                  owl:onProperty experiment:has_keyword ; 
                                  owl:someValuesFrom rdfs:Literal].
experiment:derived_from a owl:ObjectProperty.
experiment:has_biomaterial_characteristics a owl:ObjectProperty;
                                           rdfs:subPropertyOf owl:topObjectProperty.
experiment:has_input a owl:ObjectProperty;
                     rdfs:subPropertyOf owl:topObjectProperty.
experiment:has_keyword a owl:DatatypeProperty;
                       rdfs:subPropertyOf owl:topDataProperty.
experiment:has_output a owl:ObjectProperty;
                      rdfs:subPropertyOf owl:topObjectProperty.
experiment:has_part a owl:ObjectProperty;
                    rdfs:subPropertyOf owl:topObjectProperty.
experiment:has_partcipant a owl:ObjectProperty;
                          rdfs:subPropertyOf owl:topObjectProperty.
experiment:has_study_description a owl:DatatypeProperty;
                                 rdfs:subPropertyOf owl:topDataProperty.
experiment:has_study_name a owl:DatatypeProperty;
                          rdfs:subPropertyOf owl:topDataProperty.
experiment:is_about a owl:ObjectProperty.
experiment:part_of a owl:ObjectProperty;
                   rdfs:subPropertyOf owl:topObjectProperty;
                   owl:inverseOf experiment:has_part.
experiment:participates_in a owl:ObjectProperty;
                           rdfs:subPropertyOf owl:topObjectProperty.
:genid13 rdfs:comment "".
rdfs:comment a owl:AnnotationProperty.
owl:topDataProperty a owl:DatatypeProperty;
                    rdfs:range xsd:string.
owl:topObjectProperty a owl:ObjectProperty.
