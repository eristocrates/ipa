@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ti: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What is the end time of this interval? What is the starting time of this interval? What is the date of this time interval?";
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """We can represent time intervals as objects.
However, the dates of the time interval are not part of the domain of discourse, they are datatype values. If there is the need of reasoning about dates, this CP should be used in composition with the region CP.""";
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent time intervals.";
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "It is a component of time-indexed person role, time indexed part of, and can be composed with other CPs when temporal aspects need to be represented.";
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "The time inter val “January 2008” starts at 2008 − 01 − 0 and ends at 2008 − 01 − 31.";
                                                                a <http://www.w3.org/2002/07/owl#Ontology>;
                                                                rdfs:comment """The time interval pattern. 
This pattern is extracted from DOLCE-UltraLite by partial clone of elements and expansion. Two datatype properties have been added which allow to express the boundaries of the time interval.
Ranges of datatype properties are not indicated, because otherwise specializing them with different xsd datatypes would lead to inconsistencies."""^^rdf:PlainLiteral;
                                                                <http://www.w3.org/2002/07/owl#imports> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                                <http://www.w3.org/2002/07/owl#versionInfo> "Created by Valentina Presutti",
                                                                                                            "1.1 added rdfs:isDefinedBy for all named entities".
ti:TimeInterval a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """Any Region in a dimensional space that aims at representing time.
It should be used when you want to talk about time as an object having some characteristics.""";
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>;
                rdfs:label "Time interval"@en,
                           "Intervallo di tempo"@it;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ti:hasIntervalStartDate ; 
                                 <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> ti:hasIntervalEndDate ; 
                                 <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
ti:hasIntervalDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "A datatype property that encodes values from xsd:date (or any other date-related xsd datatype) for a TimeInterval; a same TimeInterval can have more than one date value: begin date, end date, date at which the interval holds, as well as dates expressed in different formats: xsd:gYear, xsd:dateTime, etc.";
                   rdfs:domain ti:TimeInterval;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>;
                   rdfs:label "has interval date"@en,
                              "intervallo ha data"@it.
ti:hasIntervalEndDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The end date of a time interval.";
                      rdfs:domain ti:TimeInterval;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>;
                      rdfs:label "interval has end date"@en;
                      rdfs:subPropertyOf ti:hasIntervalDate.
ti:hasIntervalStartDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "The start date of a time interval.";
                        rdfs:domain ti:TimeInterval;
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>;
                        rdfs:label "interval has start date"@en;
                        rdfs:subPropertyOf ti:hasIntervalDate.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
