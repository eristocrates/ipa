                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      [<http://www.w3.org/2002/07/owl#onProperty> ssno:hasOutput ; 
                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:Output ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                                      [<http://www.w3.org/2002/07/owl#onProperty> ssno:implementedBy ; 
                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:System ; 
                                                       a <http://www.w3.org/2002/07/owl#Restriction>].
<http://www.w3.org/ns/sosa/Result> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isResultOf> ; 
                                                    <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>].
<http://www.w3.org/ns/sosa/Sample> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isResultOf> ; 
                                                    <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isSampleOf> ; 
                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/FeatureOfInterest> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isSampleOf> ; 
                                                    <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isResultOf> ; 
                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Sampling> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   <http://www.w3.org/ns/sosa/FeatureOfInterest>,
                                                   <http://www.w3.org/ns/sosa/Result>.
<http://www.w3.org/ns/sosa/Sampler> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ssno:implements ; 
                                                     <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/madeSampling> ; 
                                                     <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Sampling> ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    ssno:System.
<http://www.w3.org/ns/sosa/Sampling> a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/resultTime> ; 
                                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/hasResult> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Sample> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ; 
                                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/madeBySampler> ; 
                                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/usedProcedure> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Procedure> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/FeatureOfInterest> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/madeBySampler> ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Sampler> ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/hasResult> ; 
                                                      <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
<http://www.w3.org/ns/sosa/Sensor> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ssno:implements ; 
                                                    <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/observes> ; 
                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/ObservableProperty> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/madeObservation> ; 
                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Observation> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#onProperty> ssno:detects ; 
                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:Stimulus ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   ssno:System.
<http://www.w3.org/ns/sosa/actsOnProperty> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/hasResult> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/hasSample> a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/hasSimpleResult> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/hosts> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (ssno:inDeployment
                                                                                      ssno:deployedSystem).
<http://www.w3.org/ns/sosa/isActedOnBy> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/isFeatureOfInterestOf> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/isHostedBy> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/isObservedBy> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/isResultOf> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/isSampleOf> a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeActuation> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeByActuator> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeBySampler> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeBySensor> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeObservation> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/madeSampling> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/observedProperty> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/observes> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                     rdfs:subPropertyOf ssno:forProperty.
<http://www.w3.org/ns/sosa/phenomenonTime> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/resultTime> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>.
<http://www.w3.org/ns/sosa/usedProcedure> rdfs:isDefinedBy <http://www.w3.org/ns/sosa/>;
                                          <http://www.w3.org/2002/07/owl#propertyChainAxiom> (<http://www.w3.org/ns/sosa/madeBySensor>
                                                                                              ssno:implements),
                                                                                             (<http://www.w3.org/ns/sosa/madeByActuator>
                                                                                              ssno:implements),
                                                                                             (<http://www.w3.org/ns/sosa/madeBySampler>
                                                                                              ssno:implements).
ssno: <http://purl.org/dc/terms/created> "2017-04-17"^^xsd:date;
      <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "W3C/OGC Spatial Data on the Web Working Group"@en ; 
                                          a <http://xmlns.com/foaf/0.1/Agent>];
      <http://purl.org/dc/terms/description> "This ontology describes sensors, actuators and observations, and related concepts. It does not describe domain concepts, time, locations, etc. these are intended to be included from other ontologies via OWL imports."@en;
      <http://purl.org/dc/terms/license> <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document>,
                                         <http://www.opengeospatial.org/ogc/Software>;
      <http://purl.org/dc/terms/rights> "Copyright 2017 W3C/OGC.";
      <http://purl.org/dc/terms/title> "Semantic Sensor Network Ontology"@en;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "ssn";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.w3.org/ns/ssn/";
      a <http://purl.org/vocommons/voaf#Vocabulary>,
        <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "Please report any errors to the W3C Spatial Data on the Web Working Group via the SDW WG Public List public-sdw-wg@w3.org"@en;
      rdfs:seeAlso <https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology>;
      <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/sosa/>;
      <http://www.w3.org/2002/07/owl#versionInfo> """New modular version of the SSN ontology. 

This ontology was originally developed in 2009-2011 by the W3C Semantic Sensor Networks Incubator Group (SSN-XG). For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/. The ontology was revised and modularized in 2015-2017 by the W3C/OGC Spatial Data on the Web Working Group, see: https://www.w3.org/2015/spatial/wiki/Semantic_Sensor_Network_Ontology. 

In particular, (a) the scope is extended to include actuation and sampling; (b) the core concepts and properties are factored out into the SOSA ontology. The SSN ontology imports SOSA and adds formal axiomatization consistent with the text definitions in SOSA, and adds classes and properties to accommodate the scope of the original SSN ontology. """@en.
ssno:Deployment a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en;
                rdfs:isDefinedBy ssno:;
                rdfs:label "Deployment"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ssno:deployedSystem ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:System ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> ssno:deployedOnPlatform ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Platform> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> ssno:forProperty ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:Property ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2004/02/skos/core#definition> "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en;
                <http://www.w3.org/2004/02/skos/core#example> "For example, a temperature Sensor deployed on a wall, or a whole network of Sensors deployed for an Observation campaign."@en.
ssno:Input a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Any information that is provided to a Procedure for its use."@en;
           rdfs:isDefinedBy ssno:;
           rdfs:label "Input"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:hasInput] ; 
                            <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:hasInput] ; 
                            <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Procedure> ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2004/02/skos/core#definition> "Any information that is provided to a Procedure for its use."@en.
ssno:Output a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Any information that is reported from a Procedure."@en;
            rdfs:isDefinedBy ssno:;
            rdfs:label "Output"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:hasOutput] ; 
                             <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:hasOutput] ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Procedure> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2004/02/skos/core#definition> "Any information that is reported from a Procedure."@en.
ssno:Property a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en;
              rdfs:isDefinedBy ssno:;
              rdfs:label "Property"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> ssno:isPropertyOf ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/FeatureOfInterest> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2004/02/skos/core#definition> "A quality of an entity. An aspect of an entity that is intrinsic to and cannot exist without the entity."@en.
ssno:Stimulus a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en;
              rdfs:isDefinedBy ssno:;
              rdfs:label "Stimulus"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:wasOriginatedBy] ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Observation> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:detects] ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Sensor> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> ssno:isProxyFor ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/ObservableProperty> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2004/02/skos/core#definition> "An event in the real world that 'triggers' the Sensor. The properties associated to the Stimulus may be different to the eventual observed ObservableProperty. It is the event, not the object, that triggers the Sensor."@en.
ssno:System a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "System is a unit of abstraction for pieces of infrastructure that implements Procedures. A System may have components, its subsystems, which are other systems."@en;
            rdfs:isDefinedBy ssno:;
            rdfs:label "System"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> ssno:hasSubSystem] ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:System ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> ssno:implements ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Procedure> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> ssno:hasSubSystem ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:System ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/sosa/isHostedBy> ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/ns/sosa/Platform> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> ssno:hasDeployment ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> ssno:Deployment ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2004/02/skos/core#definition> "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other systems."@en.
ssno:deployedOnPlatform a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Relation between a Deployment and the Platform on which the Systems are deployed."@en;
                        rdfs:isDefinedBy ssno:;
                        rdfs:label "deployed on platform"@en;
                        <http://www.w3.org/2002/07/owl#inverseOf> ssno:inDeployment;
                        <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Deployment and the Platform on which the Systems are deployed."@en.
ssno:deployedSystem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relation between a Deployment and a deployed System."@en;
                    rdfs:isDefinedBy ssno:;
                    rdfs:label "deployed system"@en;
                    <http://www.w3.org/2002/07/owl#inverseOf> ssno:hasDeployment;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Deployment and a deployed System."@en.
ssno:detects a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A relation from a Sensor to the Stimulus that the Sensor can detect. The Stimulus itself will be serving as a proxy for some ObservableProperty."@en;
             rdfs:isDefinedBy ssno:;
             rdfs:label "detects"@en;
             <http://www.w3.org/2004/02/skos/core#definition> "A relation from a Sensor to the Stimulus that the Sensor detects. The Stimulus itself will be serving as a proxy for some ObservableProperty."@en.
ssno:forProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A relation between some aspect of an entity and a Property."@en;
                 rdfs:isDefinedBy ssno:;
                 rdfs:label "for property"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> "A relation between some aspect of an entity and a Property."@en;
                 <http://www.w3.org/2004/02/skos/core#example> "For example, from a Sensor to the properties it can observe; from an Actuator to the properties it can act on; from a Deployment to the properties it was installed to observe or act on; from a SystemCapability to the Property the capability is described for."@en.
ssno:hasDeployment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relation between a System and a Deployment, recording that the System is deployed in that Deployment."@en;
                   rdfs:isDefinedBy ssno:;
                   rdfs:label "has deployment"@en;
                   <http://www.w3.org/2002/07/owl#inverseOf> ssno:deployedSystem;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relation between a System and a Deployment, recording that the System is deployed in that Deployment."@en.
ssno:hasInput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relation between a Procedure and an Input to it."@en;
              rdfs:isDefinedBy ssno:;
              rdfs:label "has input"@en;
              <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Procedure and an Input to it."@en.
ssno:hasOutput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relation between a Procedure and an Output of it."@en;
               rdfs:isDefinedBy ssno:;
               rdfs:label "has output"@en;
               <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Procedure and an Output of it."@en.
ssno:hasProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relation between an entity and a Property of that entity."@en;
                 rdfs:isDefinedBy ssno:;
                 rdfs:label "has property"@en;
                 <http://www.w3.org/2002/07/owl#inverseOf> ssno:isPropertyOf;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relation between an entity and a Property of that entity."@en.
ssno:hasSubSystem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relation between a System and its component parts."@en;
                  rdfs:isDefinedBy ssno:;
                  rdfs:label "has subsystem"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relation between a System and its component parts."@en.
ssno:implementedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way."@en;
                   rdfs:isDefinedBy ssno:;
                   rdfs:label "implemented by"@en;
                   <http://www.w3.org/2002/07/owl#inverseOf> ssno:implements;
                   <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way."@en;
                   <http://www.w3.org/2004/02/skos/core#example> "For example, the relationship between a scientific measuring Procedure and a sensor that senses via that Procedure."@en.
ssno:implements a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method)."@en;
                rdfs:isDefinedBy ssno:;
                rdfs:label "implements"@en;
                <http://www.w3.org/2002/07/owl#inverseOf> ssno:implementedBy;
                <http://www.w3.org/2004/02/skos/core#definition> "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method)."@en;
                <http://www.w3.org/2004/02/skos/core#example> "For example, the relationship between a sensor and the scientific measuring Procedure via which it senses."@en.
ssno:inDeployment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform."@en;
                  rdfs:isDefinedBy ssno:;
                  rdfs:label "in deployment"@en;
                  <http://www.w3.org/2002/07/owl#inverseOf> ssno:deployedOnPlatform;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Platform and a Deployment, meaning that the deployedSystems of the Deployment are hosted on the Platform."@en;
                  <http://www.w3.org/2004/02/skos/core#example> "For example, a relation between a buoy and a deployment of several Sensors."@en.
ssno:isPropertyOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relation between a Property and the entity it belongs to."@en;
                  rdfs:isDefinedBy ssno:;
                  rdfs:label "is property of"@en;
                  <http://www.w3.org/2002/07/owl#inverseOf> ssno:hasProperty;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relation between a Property and the entity it belongs to."@en.
ssno:isProxyFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for."@en;
                rdfs:isDefinedBy ssno:;
                rdfs:label "is proxy for"@en;
                <http://www.w3.org/2004/02/skos/core#definition> "A relation from a Stimulus to the Property that the Stimulus is serving as a proxy for."@en;
                <http://www.w3.org/2004/02/skos/core#example> "For example, the expansion of quicksilver is a stimulus that serves as a proxy for some temperature property. An increase or decrease in the velocity of spinning cups on a wind sensor is serving as a proxy for the wind speed."@en.
ssno:wasOriginatedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment "Relation between an Observation and the Stimulus that originated it."@en;
                     rdfs:isDefinedBy ssno:;
                     rdfs:label "was originated by"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relation between an Observation and the Stimulus that originated it."@en.
<http://xmlns.com/foaf/0.1/Agent> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
