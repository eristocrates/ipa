@base <http://www.w3.org/2000/10/swap/pim/travelFig>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix r: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dia: <http://www.lysator.liu.se/~alla/dia/>.
@prefix owl: <http://www.w3.org/2002/07/owl@@#>.
@prefix w3: <http://www.w3.org/>.
@prefix travelFig: <http://www.w3.org/2000/10/swap/pim/travelFig#>.

travelFig:O0 a rdfs:Class;
             rdfs:label "Flight";
             rdfs:subClassOf travelFig:O3.
travelFig:O1 a rdfs:Class;
             rdfs:label "Economy";
             rdfs:subClassOf travelFig:O0.
travelFig:O10 a rdf:Property;
              rdfs:domain travelFig:O3;
              rdfs:label "toLocation";
              rdfs:range travelFig:O5.
travelFig:O11 a rdfs:Class;
              rdfs:label "TemporalThing".
travelFig:O13 a rdf:Property;
              rdfs:domain travelFig:O0;
              rdfs:label "arrivalTime";
              rdfs:range travelFig:O14.
travelFig:O14 a rdfs:Class;
              rdfs:label "TimeString";
              rdfs:subClassOf travelFig:O18.
travelFig:O15 a rdfs:Class;
              rdfs:label "AirlineCompany";
              rdfs:subClassOf travelFig:O21.
travelFig:O16 a rdf:Property;
              rdfs:domain travelFig:O0;
              rdfs:label "carrier";
              rdfs:range travelFig:O15.
travelFig:O17 a rdf:Property;
              rdfs:domain travelFig:O0;
              rdfs:label "departureTime";
              rdfs:range travelFig:O14.
travelFig:O18 a rdfs:Class;
              rdfs:label "Literal".
travelFig:O20 a rdf:Property;
              rdfs:domain travelFig:O21;
              rdfs:label "nameOfAgent";
              rdfs:range travelFig:O18.
travelFig:O21 a rdfs:Class;
              rdfs:label "Agent".
travelFig:O23 a rdfs:Class;
              rdfs:label "Airport-Physical";
              rdfs:subClassOf travelFig:O5.
travelFig:O25 a rdfs:Class;
              rdfs:label "Event".
travelFig:O26 a rdf:Property;
              rdfs:domain travelFig:O25;
              rdfs:label "subEvents";
              rdfs:range travelFig:O25.
travelFig:O28 a rdf:Property;
              rdfs:domain travelFig:O7;
              rdfs:label "dt:date";
              rdfs:range travelFig:O18.
travelFig:O29 a rdf:Property;
              rdfs:domain travelFig:O0;
              rdfs:label "flightNumber";
              rdfs:range travelFig:O18.
travelFig:O3 a rdfs:Class;
             rdfs:label "Translocation";
             rdfs:subClassOf travelFig:O11,
                             travelFig:O25.
travelFig:O5 a rdfs:Class;
             rdfs:label "PartiallyTangible".
travelFig:O6 a rdf:Property;
             rdfs:domain travelFig:O3;
             rdfs:label "fromLocation";
             rdfs:range travelFig:O5.
travelFig:O7 a rdfs:Class;
             rdfs:label "Date";
             owl:hasAtLeastOne travelFig:O28.
travelFig:O8 a rdf:Property;
             rdfs:domain travelFig:O11;
             rdfs:label "startingDate";
             rdfs:range travelFig:O7.
travelFig:O9 a rdf:Property;
             rdfs:domain travelFig:O11;
             rdfs:label "endingDate";
             rdfs:range travelFig:O7.
