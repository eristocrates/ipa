<http://vocab.org/changeset/changesets-example2-20060321.html> <http://purl.org/dc/terms/title> "Linked ChangeSets".
<http://vocab.org/changeset/changesets-example3-20060321.html> <http://purl.org/dc/terms/title> "Implementing Undo With ChangeSets".
<http://vocab.org/changeset/schema.html> <http://purl.org/dc/elements/1.1/format> "text/html";
                                         a <http://purl.org/dc/dcmitype/Text>,
                                           <http://xmlns.com/foaf/0.1/Document>;
                                         rdfs:label "HTML".
<http://vocab.org/changeset/schema.json> <http://purl.org/dc/elements/1.1/format> "application/json";
                                         a <http://purl.org/dc/dcmitype/Text>,
                                           <http://xmlns.com/foaf/0.1/Document>;
                                         rdfs:label "JSON".
<http://vocab.org/changeset/schema.rdf> <http://purl.org/dc/terms/hasFormat> <http://vocab.org/changeset/schema.html>,
                                                                             <http://vocab.org/changeset/schema.json>,
                                                                             <http://vocab.org/changeset/schema.turtle>;
                                        a <http://xmlns.com/foaf/0.1/Document>,
                                          <http://purl.org/dc/dcmitype/Text>;
                                        <http://xmlns.com/foaf/0.1/primaryTopic> <http://purl.org/vocab/changeset/schema>;
                                        <http://xmlns.com/foaf/0.1/topic> <http://purl.org/vocab/changeset/schema>.
<http://vocab.org/changeset/schema.turtle> <http://purl.org/dc/elements/1.1/format> "text/plain";
                                           a <http://purl.org/dc/dcmitype/Text>,
                                             <http://xmlns.com/foaf/0.1/Document>;
                                           rdfs:label "Turtle".
