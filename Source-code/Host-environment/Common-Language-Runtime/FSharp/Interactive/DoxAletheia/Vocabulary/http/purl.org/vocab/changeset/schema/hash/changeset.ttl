@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix changeset: <http://purl.org/vocab/changeset/schema#>.

<http://iandavis.com/id/me> a <http://xmlns.com/foaf/0.1/Person>;
                            <http://xmlns.com/foaf/0.1/name> "Ian Davis".
<http://purl.org/vocab/changeset/schema> <http://purl.org/dc/terms/creator> <http://iandavis.com/id/me>,
                                                                            "Sam Tunnicliffe";
                                         <http://purl.org/dc/terms/date> "2006-03-21";
                                         <http://purl.org/dc/terms/identifier> "http://purl.org/vocab/changeset/schema-20060321";
                                         <http://purl.org/dc/terms/isVersionOf> changeset:;
                                         <http://purl.org/dc/terms/issued> "2005-12-14";
                                         <http://purl.org/dc/terms/replaces> <http://purl.org/vocab/changeset/schema-20051214>;
                                         <http://purl.org/dc/terms/rights> "Copyright © 2005 Talis Information Ltd.";
                                         <http://purl.org/dc/terms/title> "Changeset"@en;
                                         <http://purl.org/vocab/vann/example> <http://vocab.org/changeset/changesets-example-20060321.html>,
                                                                              <http://vocab.org/changeset/changesets-example2-20060321.html>,
                                                                              <http://vocab.org/changeset/changesets-example3-20060321.html>;
                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "cs";
                                         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/vocab/changeset/schema#";
                                         a <http://www.w3.org/2002/07/owl#Ontology>;
                                         rdfs:comment """
      The vocabulary introduces the notion of a ChangeSet which encapsulates the delta between two versions of a 
      resource description. In this context a resource description is the set of triples that in some way comprise a 
      description of a resource. The delta is represented by two sets of triples: additions and removals. A ChangeSet can be used to 
      modify a resource description by first removing all triples from the description that are in the removals set and
      adding the triples in the additions set.
    """@en,
                                                      """
      This vocabulary defines a set of terms for describing changes to resource descriptions.
    """@en;
                                         <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                                           <http://purl.org/dc/terms/creator> <http://iandavis.com/id/me> ; 
                                                                                           rdfs:label "Improved documentation"@en],
                                                                                          [<http://purl.org/dc/terms/date> "2006-06-23" ; 
                                                                                           <http://purl.org/dc/terms/creator> <http://iandavis.com/id/me> ; 
                                                                                           rdfs:label "Fixed invalid RDF"@en];
                                         <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2009-05-18" ; 
                                                                                            <http://purl.org/dc/terms/creator> <http://iandavis.com/id/me> ; 
                                                                                            rdfs:label "Updated dublin core properties to new namespace"@en],
                                                                                           [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                                            <http://purl.org/dc/terms/creator> <http://iandavis.com/id/me> ; 
                                                                                            rdfs:label "Introduced statement property"@en].
changeset:ChangeSet <http://purl.org/dc/terms/issued> "2005-12-14";
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                    rdfs:label "ChangeSet"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#onProperty> changeset:statement ; 
                                                                                     <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#onProperty> changeset:previousChangeSet ; 
                                                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#onProperty> changeset:subjectOfChange ; 
                                                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#onProperty> changeset:createdDate ; 
                                                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#onProperty> changeset:creatorName ; 
                                                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                     [<http://www.w3.org/2002/07/owl#onProperty> changeset:changeReason ; 
                                                                                     <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                    <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                      <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                      rdf:value "Improved documentation"];
                    <http://www.w3.org/2004/02/skos/core#definition> "The encapsulation of a delta between two versions of a resource description"@en;
                    <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                       <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                       rdf:value "Added property cardinality restrictions"].
changeset:addition <http://purl.org/dc/terms/issued> "2005-12-14";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment """
      By convention the subject of the triple being added should be the same as the subjectOfChange
    """@en;
                   rdfs:domain changeset:ChangeSet;
                   rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                   rdfs:label "addition"@en;
                   rdfs:range rdf:Statement;
                   rdfs:subPropertyOf changeset:statement;
                   <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                     <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                     rdf:value "Added definitition and documentation"];
                   <http://www.w3.org/2004/02/skos/core#definition> "a triple to be added to the resource description"@en;
                   <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                      <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                      rdf:value "Made a sub-property of statement"],
                                                                     [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                      <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                      rdf:value "Made owl:ObjectProperty"].
changeset:changeReason <http://purl.org/dc/terms/issued> "2005-12-14";
                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain changeset:ChangeSet;
                       rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                       rdfs:label "changeReason"@en;
                       rdfs:range rdfs:Literal;
                       <http://www.w3.org/2004/02/skos/core#definition> "a  short, human readable description of the purpose for the changeset"@en;
                       <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                          <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                          rdf:value "Made owl:DatatypeProperty"].
changeset:createdDate <http://purl.org/dc/terms/issued> "2005-12-14";
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment """
      The date should be in W3CDTF format
    """@en;
                      rdfs:domain changeset:ChangeSet;
                      rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                      rdfs:label "createdDate"@en;
                      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>;
                      <http://www.w3.org/2004/02/skos/core#definition> "the date that the changeset was created"@en;
                      <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                         <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                         rdf:value "Made owl:DatatypeProperty"].
changeset:creatorName <http://purl.org/dc/terms/issued> "2005-12-14";
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain changeset:ChangeSet;
                      rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                      rdfs:label "creatorName"@en;
                      rdfs:range rdfs:Literal;
                      <http://www.w3.org/2004/02/skos/core#definition> "the name of the entity responsible for creating the changeset"@en;
                      <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                         <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                         rdf:value "Made owl:DatatypeProperty"].
changeset:precedingChangeSet <http://purl.org/dc/terms/issued> "2005-12-14";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment """
      This property can be used to build a history of changes to a particular resource description. The first
      ChangeSet in the history will have no precedingChangeSet property. Each subsequent ChangeSet added
      to the history references the preceding one resulting in a singly-linked list of changes.  Care must be taken
      not to introduce cycles in the history.
    """@en,
                                          """
      In systems that assume a closed world, the most recent ChangeSet for a particular resource description 
      can be discovered by looking for the ChangeSet that is not the value of a precedingChangeSet property. 
      Conversely, the earliest ChangeSet is the one that is not the subject of a precedingChangeSet property.
    """@en;
                             rdfs:domain changeset:ChangeSet;
                             rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                             rdfs:label "precedingChangeSet"@en;
                             rdfs:range changeset:ChangeSet;
                             <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                               <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                               rdf:value "Added definitition and documentation"];
                             <http://www.w3.org/2004/02/skos/core#definition> "the changeset that immediately precedes this one"@en;
                             <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                                <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                                rdf:value "Made owl:ObjectProperty"].
changeset:removal <http://purl.org/dc/terms/issued> "2005-12-14";
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """
      By convention the subject of the triple being removed should be the same as the subjectOfChange
    """@en;
                  rdfs:domain changeset:ChangeSet;
                  rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                  rdfs:label "removal"@en;
                  rdfs:range rdf:Statement;
                  rdfs:subPropertyOf changeset:statement;
                  <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                    <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                    rdf:value "Added definitition and documentation"];
                  <http://www.w3.org/2004/02/skos/core#definition> "a triple to be removed from the resource description"@en;
                  <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                     <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                     rdf:value "Made owl:ObjectProperty"],
                                                                    [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                     <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                     rdf:value "Made a sub-property of statement"].
changeset:statement <http://purl.org/dc/terms/issued> "2006-03-21";
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain changeset:ChangeSet;
                    rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                    rdfs:label "statement"@en;
                    rdfs:range rdf:Statement;
                    <http://www.w3.org/2004/02/skos/core#definition> "a triple included in this set of changes"@en.
changeset:subjectOfChange <http://purl.org/dc/terms/issued> "2005-12-14";
                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain changeset:ChangeSet;
                          rdfs:isDefinedBy <http://purl.org/vocab/changeset/schema>;
                          rdfs:label "subjectOfChange"@en;
                          rdfs:range rdfs:Resource;
                          <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                            <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                            rdf:value "Added definitition and documentation"];
                          <http://www.w3.org/2004/02/skos/core#definition> "the resource to which this set of changes applies"@en;
                          <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/terms/date> "2006-03-21" ; 
                                                                             <http://purl.org/dc/terms/creator> "Ian Davis" ; 
                                                                             rdf:value "Made owl:ObjectProperty"].
