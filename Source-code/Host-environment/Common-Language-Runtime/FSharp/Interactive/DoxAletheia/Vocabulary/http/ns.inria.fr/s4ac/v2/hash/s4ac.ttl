@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix s4ac: <http://ns.inria.fr/s4ac/v2#>.

<http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control> a <http://xmlns.com/foaf/0.1/Organization>.
<http://ns.inria.fr/s4ac/v2> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                             <http://purl.org/dc/elements/1.1/description> "A vocabulary to describe the access policies which protect an RDF data store."@en;
                             <http://purl.org/dc/elements/1.1/issued> "2011-06-28"^^xsd:date;
                             <http://purl.org/dc/elements/1.1/modified> "2011-10-06"^^xsd:date;
                             <http://purl.org/dc/elements/1.1/publisher> <http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control>;
                             <http://purl.org/dc/elements/1.1/title> "Social Semantic SPARQL Security For Access Control (S4AC) Ontology"@en;
                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "s4ac";
                             <http://purl.org/vocab/vann/preferredNamespaceUri> "http://ns.inria.fr/s4ac/v2#";
                             a <http://www.w3.org/2002/07/owl#Ontology>;
                             <http://www.w3.org/2002/07/owl#versionInfo> 0.2;
                             <http://xmlns.com/foaf/0.1/page> <http://ns.inria.fr/s4ac/v2/s4ac_v2.html>.
s4ac:AccessCondition a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The Access Condition (AC) allows the users to access specific resources. An AC is a SPARQL 1.1 ASK query. If a solution exists, the ASK query returns true, and the AC is said to be verified. If no solution exists, the ASK query returns false, and the AC is said not to be verified."@en;
                     rdfs:isDefinedBy s4ac:;
                     rdfs:label "AccessCondition"@en;
                     rdfs:subClassOf <http://rdfs.org/sioc/ns#Item>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:AccessConditionSet a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment """An Access Condition Set (ACS) represents a set of Access Conditions which can be either Conjunctive or Disjunctive.
		"""@en;
                        rdfs:isDefinedBy s4ac:;
                        rdfs:label "AccessConditionSet"@en;
                        rdfs:subClassOf <http://rdfs.org/sioc/ns#Container>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:AccessEvaluationContext a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "An Access Evaluation Context (AEC) is a list L of predetermined bound variables names of the form (var1, val1) for which a SPARQL 1.1 Binding Clause constrains the ASK query evaluation (i.e., the evaluation of the Access Conditions) when verifying the Access Conditions."@en;
                             rdfs:isDefinedBy s4ac:;
                             rdfs:label "AccessEvaluationContext"@en;
                             <http://www.w3.org/2002/07/owl#isEquivalentTo> <http://ns.inria.fr/prissma/v2#Context>;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:AccessPolicy a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An Access Policy (AP) is a composed by an Access Condition Set, a Subject, an Access Evaluation Context, an Access Privilege, and a URI of the resource to which it is applied. "@en;
                  rdfs:isDefinedBy s4ac:;
                  rdfs:label "AccessPolicy"@en;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:AccessPrivilege a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This class represents the kind of access privileges which is granted to the user (Create, Read, Update, Delete)."@en;
                     rdfs:isDefinedBy s4ac:;
                     rdfs:label "AccessPrivilege"@en;
                     rdfs:subClassOf <http://rdfs.org/sioc/ns#Item>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:ConjunctiveAccessConditionSet a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment """A Conjunctive ACS (CACS) is a logical conjunction of Access Conditions, and it is said to be verified if and only if every Access Condition it contains is verified.
		"""@en;
                                   rdfs:isDefinedBy s4ac:;
                                   rdfs:label "ConjontiveAccessConditionSet"@en;
                                   rdfs:subClassOf s4ac:AccessConditionSet;
                                   <http://www.w3.org/2002/07/owl#disjointWith> s4ac:DisjunctiveAccessConditionSet;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:Create a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a create access on the resource. This class is equivalent to acl:Append."@en;
            rdfs:isDefinedBy s4ac:;
            rdfs:label "Create"@en;
            rdfs:subClassOf s4ac:AccessPrivilege;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.w3.org/ns/auth/acl#Append>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
            <http://www.w3.org/2004/02/skos/core#related> <http://spinrdf.org/sp#InsertData>,
                                                          <http://spinrdf.org/sp#Create>,
                                                          <http://spinrdf.org/sp#Load>.
s4ac:Delete a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a delete access on the resource."@en;
            rdfs:isDefinedBy s4ac:;
            rdfs:label "Delete"@en;
            rdfs:subClassOf s4ac:AccessPrivilege;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
            <http://www.w3.org/2004/02/skos/core#related> <http://spinrdf.org/sp#Clear>,
                                                          <http://spinrdf.org/sp#Drop>,
                                                          <http://spinrdf.org/sp#DeleteWhere>,
                                                          <http://spinrdf.org/sp#DeleteData>.
s4ac:DisjunctiveAccessConditionSet a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment """A Disjunctive ACS (DACS) is a logical disjunction of Access Conditions, and it is said to be verified if and only if at least one Access Condition it contains is verified.
		"""@en;
                                   rdfs:isDefinedBy s4ac:;
                                   rdfs:label "DisjontiveAccessConditionSet"@en;
                                   rdfs:subClassOf s4ac:AccessConditionSet;
                                   <http://www.w3.org/2002/07/owl#disjointWith> s4ac:ConjunctiveAccessConditionSet;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:Read a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents a read access on the resource. This class is equivalent to acl:Read."@en;
          rdfs:isDefinedBy s4ac:;
          rdfs:label "Read"@en;
          rdfs:subClassOf s4ac:AccessPrivilege;
          <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.w3.org/ns/auth/acl#Read>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
          <http://www.w3.org/2004/02/skos/core#related> <http://spinrdf.org/sp#Describe>,
                                                        <http://spinrdf.org/sp#Select>,
                                                        <http://spinrdf.org/sp#Construct>,
                                                        <http://spinrdf.org/sp#Ask>.
s4ac:Update a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents an update access on the resource."@en;
            rdfs:isDefinedBy s4ac:;
            rdfs:label "Update"@en;
            rdfs:subClassOf s4ac:AccessPrivilege;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
            <http://www.w3.org/2004/02/skos/core#related> <http://spinrdf.org/sp#Modify>.
s4ac:Value a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class is used to describe the value assigned to the variables used in the Access Conditions."@en;
           rdfs:isDefinedBy s4ac:;
           rdfs:label "Value"@en;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:Variable a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class is used to describe the variables used in the Access Conditions."@en;
              rdfs:isDefinedBy s4ac:;
              rdfs:label "Variable"@en;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:appliesTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property associates the Access Policy to the URI of the resource to which the policy is applied."@en;
               rdfs:domain s4ac:AccessPolicy;
               rdfs:isDefinedBy s4ac:;
               rdfs:label "appliesTo"@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasAccessCondition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property adds an Access Condition to an Access Condition Set."@en;
                        rdfs:domain s4ac:AccessConditionSet;
                        rdfs:isDefinedBy s4ac:;
                        rdfs:label "hasAccessCondition"@en;
                        rdfs:range s4ac:AccessCondition;
                        <http://www.w3.org/2002/07/owl#inverseOf> s4ac:isAccessConditionOf;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasAccessConditionSet a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "This property defines whether the Access Condition Set (ACS) of an Access Policy is a Conjunctive ACS, or a Disjunctive ACS."@en;
                           rdfs:domain s4ac:AccessPolicy;
                           rdfs:isDefinedBy s4ac:;
                           rdfs:label "hasAccessConditionSet"@en;
                           rdfs:range s4ac:AccessConditionSet;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasAccessEvaluationContext a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "This property associates an Access Policy with an Access Evaluation Context."@en;
                                rdfs:domain s4ac:AccessPolicy;
                                rdfs:isDefinedBy s4ac:;
                                rdfs:label "hasAccessEvaluationContext"@en;
                                rdfs:range s4ac:AccessEvaluationContext;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasAccessPrivilege a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property associates the Access Privileges to the Access Policies."@en;
                        rdfs:domain s4ac:AccessPolicy;
                        rdfs:isDefinedBy s4ac:;
                        rdfs:label "hasAccessPrivilege"@en;
                        rdfs:range s4ac:AccessPrivilege;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasDescription a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property associates a description of the variable used in the Access Condition Set to explain their use in the definition of the policies. "@en;
                    rdfs:domain s4ac:Variable;
                    rdfs:isDefinedBy s4ac:;
                    rdfs:label "hasDescription"@en;
                    rdfs:range rdfs:Literal;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasName a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "This property assigns a name to an Access Condition."@en;
             rdfs:domain s4ac:AccessCondition;
             rdfs:isDefinedBy s4ac:;
             rdfs:label "hasName"@en;
             rdfs:range rdfs:Literal;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasQueryAsk a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This property defines the SPARQL 1.1 ASK queries which represent the Access Conditions."@en;
                 rdfs:domain s4ac:AccessCondition;
                 rdfs:isDefinedBy s4ac:;
                 rdfs:label "hasQueryAsk"@en;
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "This property associates a value to the variable used in the Access Conditions."@en;
              rdfs:domain s4ac:Variable;
              rdfs:isDefinedBy s4ac:;
              rdfs:label "hasValue"@en;
              rdfs:range s4ac:Value;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasVarName a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property associates a name to the variable used in the Access Conditions."@en;
                rdfs:domain s4ac:Variable;
                rdfs:isDefinedBy s4ac:;
                rdfs:label "hasVarName"@en;
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:hasVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The property associates the variables and the Access Condition Set where they are used."@en;
                 rdfs:domain s4ac:AccessConditionSet;
                 rdfs:isDefinedBy s4ac:;
                 rdfs:label "hasVariable"@en;
                 rdfs:range s4ac:Variable;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
s4ac:isAccessConditionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property says that an Access Condition is part of an Access Condition Set."@en;
                         rdfs:domain s4ac:AccessCondition;
                         rdfs:isDefinedBy s4ac:;
                         rdfs:label "isAccessConditionOf"@en;
                         rdfs:range s4ac:AccessConditionSet;
                         <http://www.w3.org/2002/07/owl#inverseOf> s4ac:hasAccessCondition;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
