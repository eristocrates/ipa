@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix osgb: <http://data.ordnancesurvey.co.uk/id/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix admingeo: <http://data.ordnancesurvey.co.uk/ontology/admingeo/>.
@prefix postcode: <http://data.ordnancesurvey.co.uk/ontology/postcode/>.
@prefix spacerel: <http://data.ordnancesurvey.co.uk/ontology/spatialrelations/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

admingeo:County a owl:Class.
admingeo:District a owl:Class.
admingeo:LondonBorough a owl:Class.
admingeo:MetropolitanDistrict a owl:Class.
admingeo:UnitaryAuthority a owl:Class.
admingeo:UnitaryAuthorityElectoralDivision a owl:Class.
admingeo:Ward a owl:Class.
postcode: dc11:creator "Ordnance Survey"@en;
          dcterms:creator osgb:ordnancesurvey;
          dcterms:publisher osgb:ordnancesurvey;
          a owl:Ontology;
          rdfs:comment "An ontology describing the postcode geography in Great Britain."@en;
          rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
          rdfs:label "Postcode Ontology"@en;
          owl:imports admingeo:,
                      <http://www.w3.org/2004/02/skos/core>.
postcode:LH a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:comment "NHS health authority code";
            rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
            rdfs:label "LH";
            rdfs:seeAlso postcode:nhsHA.
postcode:PQ a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:comment "Positional Quality Indicator (see http://www.ordnancesurvey.co.uk/oswebsite/products/codepoint/pdf/cpuserguide.pdf)";
            rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
            rdfs:label "PQ";
            rdfs:seeAlso postcode:positionalQualityIndicator.
postcode:PositionalQualityIndicator a owl:Class;
                                    rdfs:comment """The importance of checking the Positional Quality Indicator (PQI), to establish Code-Point Open location coordinate (CPLC) positional quality, cannot be overemphasised.

It indicates the positional accuracy of the Code-Point Open coordinates. There are seven PQI values for the positional quality of CPLCs. The order shown indicates the level of quality associated with the PQI; PQ10 is the most accurate and PQ90 the least. The PQI assigned to the CPLC will depend on the coordinates available in ADDRESS-POINT to generate the CPLC. If the ADDRESS-POINT PQI is PQ3, the best it can be, then the Code-Point Open PQI will be PQ10.""";
                                    rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                                    rdfs:label "Positional Quality Indicator";
                                    rdfs:subClassOf skos:Concept.
postcode:PostCodeType a owl:Class;
                      rdfs:label "Postcode Type".
postcode:PostcodeArea a owl:Class;
                      rdfs:comment "An area given a unique alphabetic coding by Royal Mail to facilitate the delivering of mail. The area is identified by one or two alpha characters at the start of the full postcode, the letters being derived from a town, city or district falling within the postcode area. There are, at present, 120 postcode areas in Great Britain, for example, SO for Southampton, MK for Milton Keynes, B for Birmingham or W for London West. The postcode area code constitutes the first part of the outward code.";
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                      rdfs:label "Postcode Area";
                      rdfs:subClassOf [owl:someValuesFrom postcode:PostcodeDistrict ; 
                                       owl:onProperty spacerel:contains ; 
                                       a owl:Restriction].
postcode:PostcodeDistrict a owl:Class;
                          rdfs:comment """A sub-area of the postcode area, specified by the character sub-string within the first half of a full postcode, which may be numeric, alphabetic or alphanumeric; for example, 42 from MK42 6GH or 1A from W1A 4WW. There are approximately 2 800 postcode districts in Great Britain.
NOTE: there are certain non-geographic districts. In these instances, a district code is allocated to cover all large users in the postcode area.""";
                          rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                          rdfs:label "Postcode District";
                          rdfs:subClassOf [owl:someValuesFrom postcode:PostcodeArea ; 
                                           owl:onProperty spacerel:within ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom postcode:PostcodeSector ; 
                                           owl:onProperty spacerel:contains ; 
                                           a owl:Restriction].
postcode:PostcodeSector a owl:Class;
                        rdfs:comment "A sub-area of a postcode district, whose area is identified by the number third from the end of a full postcode. There are approximately 9000 postcode sectors in Great Britain. An example of a postcode sector code is 3, from GU12 3DH.";
                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                        rdfs:label "Postcode Sector";
                        rdfs:subClassOf [owl:someValuesFrom postcode:PostcodeUnit ; 
                                         owl:onProperty spacerel:contains ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom postcode:PostcodeDistrict ; 
                                         owl:onProperty spacerel:within ; 
                                         a owl:Restriction].
postcode:PostcodeUnit a owl:Class;
                      rdfs:comment """An area covered by a particular postcode. Postcodes are an alphanumeric abbreviated form of address. Postcode units are unique references and identify an average of 15 addresses. In some cases, where an address receives a substantial amount of mail, a postcode will apply to only one address (a large-user postcode). The maximum number of addresses in a postcode is 100.

A sub-area of a postcode sector, indicated by the two letters of the inward postcode, which identifies one or more small-user postcode delivery points or an individual large-user postcode. There are approximately 1.7 million postcode units in the UK.""";
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                      rdfs:label "Postcode Unit";
                      rdfs:subClassOf [owl:someValuesFrom postcode:PostcodeSector ; 
                                       owl:onProperty spacerel:within ; 
                                       a owl:Restriction].
postcode:RH a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:comment "NHS regional health authority code";
            rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
            rdfs:label "RH";
            rdfs:seeAlso postcode:nhsRegionalHA.
postcode:country a owl:ObjectProperty,
                   owl:FunctionalProperty;
                 rdfs:comment "The country that the Code-Point Open location coordinate lies in.";
                 rdfs:domain postcode:PostcodeUnit;
                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                 rdfs:label "country".
postcode:county a owl:ObjectProperty,
                  owl:FunctionalProperty;
                rdfs:comment "County in which Code-Point Open location coordinate falls.";
                rdfs:domain postcode:PostcodeUnit;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                rdfs:label "county";
                rdfs:range admingeo:County.
postcode:district a owl:ObjectProperty,
                    owl:FunctionalProperty;
                  rdfs:comment """Unitary Authority, Metropolitan and Non- Metropolitan District, London
Borough or Scottish Council Area in which Code-Point Open location coordinate falls.""";
                  rdfs:domain postcode:PostcodeUnit;
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                  rdfs:label "district";
                  rdfs:range [owl:unionOf (admingeo:District
                                           admingeo:LondonBorough
                                           admingeo:MetropolitanDistrict
                                           admingeo:UnitaryAuthority) ; 
                              a owl:Class].
postcode:nhsHA a owl:ObjectProperty;
               rdfs:comment "English Strategic Health Authority or Scottish Health Board in which Code-Point Open location coordinate falls.";
               rdfs:domain postcode:PostcodeUnit;
               rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
               rdfs:label "NHS Health Authority".
postcode:nhsRegionalHA a owl:ObjectProperty;
                       rdfs:comment "English Pan Strategic Health Authority in which Code-Point Open location coordinate falls.";
                       rdfs:domain postcode:PostcodeUnit;
                       rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                       rdfs:label "NHS Regional Health Authority".
postcode:positionalQualityIndicator a owl:ObjectProperty;
                                    rdfs:comment """Indicates the source of the data indicator used and, hence, the quality of the
coordinates provided for each record. It is determined by the best available
data in ADDRESS-POINT.""";
                                    rdfs:domain postcode:PostcodeUnit;
                                    rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
                                    rdfs:label "Positional Quality Indicator";
                                    rdfs:range postcode:PositionalQualityIndicator.
postcode:postcode a owl:ObjectProperty;
                  rdfs:comment "This property lets you relate an object to its PostcodeUnit. ";
                  rdfs:label "postcode";
                  rdfs:range postcode:PostcodeUnit;
                  rdfs:subPropertyOf owl:topObjectProperty.
postcode:pqi a owl:NamedIndividual;
             rdfs:label "Positional Quality Indicator Concept Scheme";
             skos:hasTopConcept <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/10>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/20>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/30>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/40>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/50>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/60>,
                                <http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/90>.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/10> a owl:NamedIndividual;
                                                            rdfs:comment "Within the building of the matched address closest to the postcode mean determined automatically by Ordnance Survey.";
                                                            rdfs:label "10";
                                                            skos:notation "10";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/20> a owl:NamedIndividual;
                                                            rdfs:comment "As above, but determined by visual inspection by NRS.";
                                                            rdfs:label "20";
                                                            skos:notation "20";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/30> a owl:NamedIndividual;
                                                            rdfs:comment "Approximate to within 50 m of true position (postcodes relating to developing sites may be within 100 m of true position).";
                                                            rdfs:label "30";
                                                            skos:notation "30";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/40> a owl:NamedIndividual;
                                                            rdfs:comment "The mean of the positions of addresses previously matched in ADDRESS-POINT but that have subsequently been deleted or recoded (very rarely used).";
                                                            rdfs:label "40";
                                                            skos:notation "40";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/50> a owl:NamedIndividual;
                                                            rdfs:comment "Estimated position based on surrounding postcode coordinates, usually to 100m resolution, but 10 m in Scotland.";
                                                            rdfs:label "50";
                                                            skos:notation "50";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/60> a owl:NamedIndividual;
                                                            rdfs:comment "Postcode sector mean (direct copy from ADDRESS-POINT).";
                                                            rdfs:label "60";
                                                            skos:notation "60";
                                                            skos:topConceptOf postcode:pqi.
<http://data.ordnancesurvey.co.uk/ontology/postcode/pqi/90> a owl:NamedIndividual;
                                                            rdfs:comment "No coordinates available.";
                                                            rdfs:label "90";
                                                            skos:notation "90";
                                                            skos:topConceptOf postcode:pqi.
postcode:ward a owl:ObjectProperty;
              rdfs:comment "Electoral Ward or Division in which Code-Point Open location coordinate falls.";
              rdfs:domain postcode:PostcodeUnit;
              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/postcode.owl>;
              rdfs:label "ward";
              rdfs:range [owl:unionOf (admingeo:UnitaryAuthorityElectoralDivision
                                       admingeo:Ward) ; 
                          a owl:Class].
spacerel:easting a owl:DatatypeProperty.
spacerel:northing a owl:DatatypeProperty.
spacerel:within a owl:ObjectProperty.
dc11:creator a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:publisher a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:topObjectProperty a owl:ObjectProperty.
skos:notation a owl:DatatypeProperty,
                owl:FunctionalProperty;
              rdfs:range rdfs:Literal.
