@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rev: <http://purl.org/stuff/rev#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix grddl: <http://www.w3.org/2003/g/data-view#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

<http://creativecommons.org/licenses/by/1.0/> <http://web.resource.org/cc/permits> <http://web.resource.org/cc/DerivativeWorks>,
                                                                                   <http://web.resource.org/cc/Distribution>,
                                                                                   <http://web.resource.org/cc/Reproduction>;
                                              <http://web.resource.org/cc/requires> <http://web.resource.org/cc/Attribution>,
                                                                                    <http://web.resource.org/cc/Notice>;
                                              a <http://web.resource.org/cc/License>.
dc11:date a owl:DatatypeProperty.
dc11:description a owl:DatatypeProperty.
dc11:title a owl:DatatypeProperty.
<http://purl.org/stuff/rev> dc11:type dcmitype:Text;
                            <http://web.resource.org/cc/license> <http://creativecommons.org/licenses/by/1.0/>;
                            a <http://web.resource.org/cc/Work>.
rev: dc11:date "2007-11-08";
     dc11:description "Vocabulary for expressing reviews and ratings using the Resource Description Framework. It is compatible with hReview and conforms to OWL Lite";
     vann:preferredNamespacePrefix "rev";
     vann:preferredNamespaceUri "http://purl.org/stuff/rev#";
     a owl:Thing,
       owl:Ontology;
     rdfs:label "RDF Review Vocabulary";
     status:userdocs <http://vocab.org/review/html>;
     grddl:profileTransformation <http://danja.talis.com/xmlns/rev_2007-11-09/hreview2rdfxml.xsl>.
rev:Comment a owl:Class,
              rdfs:Class;
            rdfs:comment "A comment on a review";
            rdfs:isDefinedBy rev:;
            rdfs:label "Comment";
            status:moreinfo "proposed by iterating.com";
            status:term_status "deprecated".
rev:Feedback a owl:Class,
               rdfs:Class;
             rdfs:comment "Feedback on the review. Expresses whether the review was useful or not";
             rdfs:isDefinedBy rev:;
             rdfs:label "Feedback";
             status:moreinfo "proposed by iterating.com";
             status:term_status "deprecated",
                                "testing".
rev:Review a owl:Class,
             rdfs:Class;
           rdfs:comment "A review of an work"@en;
           rdfs:isDefinedBy rev:;
           rdfs:label "Review"@en;
           status:moreinfo "core term";
           status:term_status "stable".
rev:commenter a rdf:Property,
                owl:ObjectProperty;
              rdfs:comment "The commenter on the review";
              rdfs:domain rev:Feedback,
                          rev:Comment;
              rdfs:isDefinedBy rev:;
              rdfs:label "commenter";
              rdfs:range foaf:Agent;
              status:moreinfo "proposed by iterating.com";
              status:term_status "deprecated".
rev:hasComment a owl:ObjectProperty,
                 rdf:Property;
               rdfs:comment "Used to associate a review with a comment on the review";
               rdfs:domain rev:Review;
               rdfs:isDefinedBy rev:;
               rdfs:label "hasComment";
               rdfs:range rev:Comment;
               status:moreinfo "proposed by iterating.com";
               status:term_status "deprecated".
rev:hasFeedback a owl:ObjectProperty,
                  rdf:Property;
                rdfs:comment "Associates a review with a feedback on the review";
                rdfs:domain rev:Review;
                rdfs:isDefinedBy rev:;
                rdfs:label "hasFeedback";
                rdfs:range rev:Feedback;
                status:moreinfo "proposed by iterating.com";
                status:term_status "deprecated".
rev:hasReview a owl:ObjectProperty,
                rdf:Property;
              rdfs:comment "Associates a work with a a review"@en;
              rdfs:domain rdfs:Resource;
              rdfs:isDefinedBy rev:;
              rdfs:label "has Review"@en;
              rdfs:range rev:Review;
              status:moreinfo "core term";
              status:term_status "stable".
rev:maxRating dc11:description "Maximum value for rating property"@en;
              a rdf:Property;
              rdfs:comment "A numeric value"@en;
              rdfs:isDefinedBy rev:;
              rdfs:label "max Rating"@en;
              status:moreinfo "Introduced by request of Revyu.com";
              status:term_status "stable".
rev:minRating dc11:description "Minimum value for rating property"@en;
              a rdf:Property;
              rdfs:comment "A numeric value"@en;
              rdfs:isDefinedBy rev:;
              rdfs:label "min Rating"@en;
              status:moreinfo "Introduced by request of Revyu.com";
              status:term_status "stable".
rev:positiveVotes a owl:DatatypeProperty,
                    rdf:Property;
                  rdfs:comment "Number of positive usefulness votes (integer)";
                  rdfs:domain rev:Review;
                  rdfs:isDefinedBy rev:;
                  rdfs:label "positiveVotes";
                  rdfs:range rdfs:Literal;
                  status:moreinfo "proposed by iterating.com";
                  status:term_status "deprecated".
rev:rating a owl:DatatypeProperty,
             rdf:Property;
           rdfs:comment "A numeric value"@en;
           rdfs:isDefinedBy rev:;
           rdfs:label "rating"@en;
           status:moreinfo "core term";
           status:term_status "stable".
rev:reviewer a owl:ObjectProperty,
               rdf:Property;
             rdfs:comment "The person that has written the review"@en;
             rdfs:domain rev:Review;
             rdfs:isDefinedBy rev:;
             rdfs:label "reviewer"@en;
             rdfs:range foaf:Person;
             status:moreinfo "core term";
             status:term_status "stable".
rev:text a owl:DatatypeProperty,
           rdf:Property;
         rdfs:comment "The text of the review"@en;
         rdfs:isDefinedBy rev:;
         rdfs:label "text"@en;
         status:moreinfo "core term";
         status:term_status "stable".
rev:title a rdf:Property,
            owl:DatatypeProperty;
          rdfs:comment "The title of the review";
          rdfs:domain rev:Review;
          rdfs:isDefinedBy rev:;
          rdfs:label "title";
          rdfs:range rdfs:Literal;
          rdfs:subPropertyOf dc11:title;
          status:moreinfo "proposed by iterating.com";
          status:term_status "deprecated".
rev:totalVotes a owl:DatatypeProperty,
                 rdf:Property;
               rdfs:comment "Number of usefulness votes (integer)";
               rdfs:domain rev:Review;
               rdfs:isDefinedBy rev:;
               rdfs:label "totalVotes";
               rdfs:range rdfs:Literal;
               status:moreinfo "proposed by iterating.com";
               status:term_status "deprecated".
rev:type a owl:DatatypeProperty,
           rdf:Property;
         rdfs:comment "The type of media of a work under review";
         rdfs:isDefinedBy rev:;
         rdfs:label "type";
         status:moreinfo "core term";
         status:term_status "deprecated".
<http://vocab.org/review/terms.html> dc11:format "text/html";
                                     a foaf:Document,
                                       dcmitype:Text;
                                     rdfs:label "HTML".
<http://vocab.org/review/terms.json> dc11:format "application/json";
                                     a foaf:Document,
                                       dcmitype:Text;
                                     rdfs:label "JSON".
<http://vocab.org/review/terms.rdf> dcterms:hasFormat <http://vocab.org/review/terms.turtle>,
                                                      <http://vocab.org/review/terms.json>,
                                                      <http://vocab.org/review/terms.html>;
                                    a dcmitype:Text,
                                      foaf:Document;
                                    foaf:primaryTopic rev:;
                                    foaf:topic rev:.
<http://vocab.org/review/terms.turtle> dc11:format "text/plain";
                                       a foaf:Document,
                                         dcmitype:Text;
                                       rdfs:label "Turtle".
rdfs:Class a owl:Class.
rdfs:Resource a owl:Class.
status:moreinfo a owl:AnnotationProperty.
status:term_status a owl:AnnotationProperty.
foaf:Agent a owl:Class.
foaf:Person a owl:Class.
