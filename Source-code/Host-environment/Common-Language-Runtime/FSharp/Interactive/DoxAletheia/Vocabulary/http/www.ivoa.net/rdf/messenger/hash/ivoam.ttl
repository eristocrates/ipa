@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ivoam: <http://www.ivoa.net/rdf/messenger#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

dcterms:created a owl:AnnotationProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
<http://www.ivoa.net/rdf/messenger> dcterms:created "2020-08-26";
                                    dcterms:creator [foaf:name "Demleitner, M."],
                                                    [foaf:name "Plante, R."];
                                    dcterms:description """A vocabulary of particles used for observations in astronomy.
This list started its existence as the controlled vocabulary for
VODataService's vs:Waveband type; the machine-readable identifiers are in
upper case for backwards compatibility.""";
                                    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/>;
                                    dcterms:title "Messengers"@en;
                                    <http://www.ivoa.net/rdf/ivoasem#vocflavour> "RDF Class";
                                    a owl:Ontology;
                                    rdfs:label "Messengers"@en.
ivoam:EUV a rdfs:Class;
          rdfs:comment "      Photon with an energy between 12 eV and 120 eV";
          rdfs:label "Extreme UV";
          rdfs:subClassOf ivoam:UV.
ivoam:Gamma-ray a rdfs:Class;
                rdfs:comment "       Photon with an energy above 120 keV";
                rdfs:label "Gamma Ray";
                rdfs:subClassOf ivoam:Photon.
ivoam:Infrared a rdfs:Class;
               rdfs:comment "        Photon with a wavelength between 1 µm and 100 µm";
               rdfs:label "Infrared";
               rdfs:subClassOf ivoam:Photon.
ivoam:Millimeter a rdfs:Class;
                 rdfs:comment "      Photon with a wavelength between 0.1 mm and 10 mm (or 30 GHz<=ν<300 GHz)";
                 rdfs:label "Millimeter";
                 rdfs:subClassOf ivoam:Photon.
ivoam:Neutrino a rdfs:Class;
               rdfs:comment "        This term comprises all generations of neutrinos (electron, µ, τ), and particles as well as antiparticles.";
               rdfs:label "Neutrino".
ivoam:Optical a rdfs:Class;
              rdfs:comment "         Photon with a wavelength between 300 nm and 1000 nm";
              rdfs:label "Optical";
              rdfs:subClassOf ivoam:Photon.
ivoam:Photon a rdfs:Class;
             rdfs:comment "          Carrier particles of the electromagnetic interaction";
             rdfs:label "Photon".
ivoam:Radio a rdfs:Class;
            rdfs:comment "           Photon with a wavelength longer than 10 mm (or ν<30 GHz)";
            rdfs:label "Radio";
            rdfs:subClassOf ivoam:Photon.
ivoam:UV a rdfs:Class;
         rdfs:comment "     Photon with a wavelength between 100 nm and 300 nm";
         rdfs:label "Ultraviolet";
         rdfs:subClassOf ivoam:Photon.
ivoam:X-ray a rdfs:Class;
            rdfs:comment "           Photon with an energy between 120 eV and 120 keV";
            rdfs:label "X-Ray";
            rdfs:subClassOf ivoam:Photon.
