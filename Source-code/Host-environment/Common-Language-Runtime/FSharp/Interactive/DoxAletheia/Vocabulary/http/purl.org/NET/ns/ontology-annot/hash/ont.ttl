@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ont: <http://purl.org/net/ns/ontology-annot#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

<http://purl.org/net/ns/ontology-annot> ont:created "2007-10-08";
                                        ont:creator <urn:pin:MK705>;
                                        ont:modified "2007-11-07";
                                        rdfs:comment "オントロジーのアノテーションに用いるプロパティを、汎用プロパティと関連付けるための回避策としての語彙"@ja,
                                                     "Vocabulary to define some annotation properties as subproperties of common terms. Because owl:Ontology resource cannot have properties other than annotation, these terms are defined as owl:AnnotationProperty type in dliser.rdf that is to be imported. However, some RDF application might want those properties to be related to well known terms such as Dublin Core. Hence this vocabulary redefines these properties as ordinary RDF/OWL terms and subProperty of others.";
                                        rdfs:label "Ontology annotation DLiser vocabulary";
                                        owl:versionInfo "Version 0.12".
ont:created a rdf:Property;
            rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
            rdfs:label "created";
            rdfs:subPropertyOf dcterms:created.
ont:creator a rdf:Property;
            rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
            rdfs:label "creator";
            rdfs:subPropertyOf dc11:creator.
ont:deprecatedBy a rdf:Property;
                 rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
                 rdfs:label "deprecated by";
                 rdfs:subPropertyOf ont:seeOther.
ont:description a rdf:Property;
                rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
                rdfs:label "description";
                rdfs:subPropertyOf dc11:description.
ont:modified a rdf:Property;
             rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
             rdfs:label "modified";
             rdfs:subPropertyOf dcterms:modified.
ont:relation a rdf:Property;
             rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
             rdfs:label "relation";
             rdfs:subPropertyOf dc11:relation.
ont:seeOther a rdf:Property;
             rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
             rdfs:label "see other";
             rdfs:subPropertyOf rdfs:seeAlso.
ont:title a rdf:Property;
          rdfs:isDefinedBy <http://purl.org/net/ns/ontology-annot>;
          rdfs:label "title";
          rdfs:subPropertyOf dc11:title.
<urn:pin:MK705> a foaf:Person;
                rdfs:seeAlso <http://www.kanzaki.com/info/webwho.rdf>;
                foaf:homepage <http://www.kanzaki.com/>;
                foaf:name "神崎正英"@ja.
