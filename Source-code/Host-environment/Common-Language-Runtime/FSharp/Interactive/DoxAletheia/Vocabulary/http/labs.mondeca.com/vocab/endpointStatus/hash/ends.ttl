@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ends: <http://labs.mondeca.com/vocab/endpointStatus#>.

<http://dbpedia.org/resource/Mondeca> a <http://xmlns.com/foaf/0.1/Organization>;
                                      <http://xmlns.com/foaf/0.1/name> "Mondeca".
<http://labs.mondeca.com/foaf/mondeca.rdf#pyv> a <http://xmlns.com/foaf/0.1/Person>;
                                               <http://xmlns.com/foaf/0.1/name> "Pierre-Yves Vandenbussche".
<http://labs.mondeca.com/vocab/endpointStatus> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                               <http://purl.org/dc/terms/creator> <http://labs.mondeca.com/foaf/mondeca.rdf#pyv>;
                                               <http://purl.org/dc/terms/description> "Endpoint Status vocabulary intends to dsecribe endpoint availability"@en;
                                               <http://purl.org/dc/terms/modified> "2011-02-24";
                                               <http://purl.org/dc/terms/publisher> <http://dbpedia.org/resource/Mondeca>;
                                               <http://purl.org/dc/terms/title> "Vocabulary of endpoint status (availability, responseTime)"@en;
                                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "ends";
                                               <http://purl.org/vocab/vann/preferredNamespaceUri> "http://labs.mondeca.com/vocab/endpointStatus#";
                                               <http://purl.org/vocommons/voaf#classNumber> "1";
                                               <http://purl.org/vocommons/voaf#metadataVoc> <http://xmlns.com/foaf/0.1>,
                                                                                            <http://creativecommons.org/licenses/by/3.0/>,
                                                                                            <http://purl.org/vocommons/voaf>,
                                                                                            <http://purl.org/vocab/vann/>,
                                                                                            <http://purl.org/dc/terms>;
                                               <http://purl.org/vocommons/voaf#propertyNumber> "4";
                                               <http://purl.org/vocommons/voaf#reliesOn> <http://purl.org/dc/terms/>;
                                               <http://purl.org/vocommons/voaf#specializes> <http://vocab.deri.ie/void>;
                                               a <http://purl.org/vocommons/voaf#Vocabulary>,
                                                 <http://www.w3.org/2002/07/owl#Ontology>;
                                               rdfs:isdefinedby <http://labs.mondeca.com/vocab/endpointStatus>;
                                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ends:EndpointStatus a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A Status of a void:Dataset endpoint at a particular time"@en;
                    rdfs:isDefinedBy <http://labs.mondeca.com/vocab/endpointStatus>;
                    rdfs:label "Endpoint status"@en;
                    <http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#onProperty> ends:statusIsAvailable ; 
                                                             <http://www.w3.org/2002/07/owl#cardinality> "1" ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                             [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/date> ; 
                                                             <http://www.w3.org/2002/07/owl#cardinality> "1" ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                             [<http://www.w3.org/2002/07/owl#onProperty> ends:statusResponseTime ; 
                                                             <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                             [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                                             <http://www.w3.org/2002/07/owl#maxCardinality> "1" ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>]);
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ends:status a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relation between a void:Dataset and an ends:EndpointStatus"@en;
            rdfs:domain <http://rdfs.org/ns/void#Dataset>;
            rdfs:isDefinedBy <http://labs.mondeca.com/vocab/endpointStatus>;
            rdfs:label "has status"@en;
            rdfs:range ends:EndpointStatus;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ends:statusIsAvailable a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Describes whether a void:Dataset endpoint is available or not"@en;
                       rdfs:domain ends:EndpointStatus;
                       rdfs:isDefinedBy <http://labs.mondeca.com/vocab/endpointStatus>;
                       rdfs:label "is endpoint available"@en;
                       rdfs:range xsd:boolean;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ends:statusResponseTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "If a void:Dataset endpoint is available, this property indicates in milliseconds the responseTime to a simple Select query"@en;
                        rdfs:domain ends:EndpointStatus;
                        rdfs:isDefinedBy <http://labs.mondeca.com/vocab/endpointStatus>;
                        rdfs:label "endpoint response time"@en;
                        rdfs:range xsd:integer;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
