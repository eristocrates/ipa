@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.

<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:Class a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#Thing> rdfs:label "Thing".
<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a <http://www.w3.org/2002/07/owl#Class>;
                                                       rdfs:label "Spatial Thing".
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2004/02/skos/core#Concept> rdfs:label "Concept".
foaf: <http://purl.org/dc/elements/1.1/description> "The Friend of a Friend (FOAF) RDF vocabulary, described using W3C RDF Schema and the Web Ontology Language.";
      <http://purl.org/dc/elements/1.1/title> "Friend of a Friend (FOAF) vocabulary";
      a <http://www.w3.org/2002/07/owl#Ontology>.
foaf:Agent a rdfs:Class,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An agent (eg. person, group, software or physical artifact).";
           rdfs:label "Agent";
           <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.org/dc/terms/Agent>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:Document a <http://www.w3.org/2002/07/owl#Class>,
                rdfs:Class;
              rdfs:comment "A document.";
              rdfs:isDefinedBy foaf:;
              rdfs:label "Document";
              <http://www.w3.org/2002/07/owl#disjointWith> foaf:Project,
                                                           foaf:Organization;
              <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/CreativeWork>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:Group a <http://www.w3.org/2002/07/owl#Class>,
             rdfs:Class;
           rdfs:comment "A class of Agents.";
           rdfs:label "Group";
           rdfs:subClassOf foaf:Agent;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:Image a <http://www.w3.org/2002/07/owl#Class>,
             rdfs:Class;
           rdfs:comment "An image.";
           rdfs:isDefinedBy foaf:;
           rdfs:label "Image";
           rdfs:subClassOf foaf:Document;
           <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/ImageObject>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:LabelProperty a <http://www.w3.org/2002/07/owl#Class>,
                     rdfs:Class;
                   rdfs:comment "A foaf:LabelProperty is any RDF property with texual values that serve as labels.";
                   rdfs:isDefinedBy foaf:;
                   rdfs:label "Label Property";
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:OnlineAccount a <http://www.w3.org/2002/07/owl#Class>,
                     rdfs:Class;
                   rdfs:comment "An online account.";
                   rdfs:isDefinedBy foaf:;
                   rdfs:label "Online Account";
                   rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:OnlineChatAccount a <http://www.w3.org/2002/07/owl#Class>,
                         rdfs:Class;
                       rdfs:comment "An online chat account.";
                       rdfs:isDefinedBy foaf:;
                       rdfs:label "Online Chat Account";
                       rdfs:subClassOf foaf:OnlineAccount;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:OnlineEcommerceAccount a <http://www.w3.org/2002/07/owl#Class>,
                              rdfs:Class;
                            rdfs:comment "An online e-commerce account.";
                            rdfs:isDefinedBy foaf:;
                            rdfs:label "Online E-commerce Account";
                            rdfs:subClassOf foaf:OnlineAccount;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:OnlineGamingAccount a <http://www.w3.org/2002/07/owl#Class>,
                           rdfs:Class;
                         rdfs:comment "An online gaming account.";
                         rdfs:isDefinedBy foaf:;
                         rdfs:label "Online Gaming Account";
                         rdfs:subClassOf foaf:OnlineAccount;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:Organization a <http://www.w3.org/2002/07/owl#Class>,
                    rdfs:Class;
                  rdfs:comment "An organization.";
                  rdfs:isDefinedBy foaf:;
                  rdfs:label "Organization";
                  rdfs:subClassOf foaf:Agent;
                  <http://www.w3.org/2002/07/owl#disjointWith> foaf:Document,
                                                               foaf:Person;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:Person a rdfs:Class,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A person.";
            rdfs:isDefinedBy foaf:;
            rdfs:label "Person";
            rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
                            foaf:Agent;
            <http://www.w3.org/2002/07/owl#disjointWith> foaf:Project,
                                                         foaf:Organization;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/Person>,
                                                            <http://www.w3.org/2000/10/swap/pim/contact#Person>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:PersonalProfileDocument a <http://www.w3.org/2002/07/owl#Class>,
                               rdfs:Class;
                             rdfs:comment "A personal profile RDF document.";
                             rdfs:label "PersonalProfileDocument";
                             rdfs:subClassOf foaf:Document;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:Project a <http://www.w3.org/2002/07/owl#Class>,
               rdfs:Class;
             rdfs:comment "A project (a collective endeavour of some kind).";
             rdfs:isDefinedBy foaf:;
             rdfs:label "Project";
             <http://www.w3.org/2002/07/owl#disjointWith> foaf:Document,
                                                          foaf:Person;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:account a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:comment "Indicates an account held by this agent.";
             rdfs:domain foaf:Agent;
             rdfs:isDefinedBy foaf:;
             rdfs:label "account";
             rdfs:range foaf:OnlineAccount;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:accountName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "Indicates the name (identifier) associated with this online account.";
                 rdfs:domain foaf:OnlineAccount;
                 rdfs:isDefinedBy foaf:;
                 rdfs:label "account name";
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:accountServiceHomepage a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              rdf:Property;
                            rdfs:comment "Indicates a homepage of the service provide for this online account.";
                            rdfs:domain foaf:OnlineAccount;
                            rdfs:isDefinedBy foaf:;
                            rdfs:label "account service homepage";
                            rdfs:range foaf:Document;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:age a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
           <http://www.w3.org/2002/07/owl#FunctionalProperty>,
           rdf:Property;
         rdfs:comment "The age in years of some agent.";
         rdfs:domain foaf:Agent;
         rdfs:isDefinedBy foaf:;
         rdfs:label "age";
         rdfs:range rdfs:Literal;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:aimChatID a rdf:Property,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
               rdfs:comment "An AIM chat ID";
               rdfs:domain foaf:Agent;
               rdfs:isDefinedBy foaf:;
               rdfs:label "AIM chat ID";
               rdfs:range rdfs:Literal;
               rdfs:subPropertyOf foaf:nick;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:based_near a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "A location that something is based near, for some broadly human notion of near.";
                rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                rdfs:isDefinedBy foaf:;
                rdfs:label "based near";
                rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:birthday a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                rdf:Property;
              rdfs:comment "The birthday of this Agent, represented in mm-dd string form, eg. '12-31'.";
              rdfs:domain foaf:Agent;
              rdfs:isDefinedBy foaf:;
              rdfs:label "birthday";
              rdfs:range rdfs:Literal;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:currentProject a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      rdf:Property;
                    rdfs:comment "A current project this person works on.";
                    rdfs:domain foaf:Person;
                    rdfs:isDefinedBy foaf:;
                    rdfs:label "current project";
                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:depiction a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 rdf:Property;
               rdfs:comment "A depiction of some thing.";
               rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:isDefinedBy foaf:;
               rdfs:label "depiction";
               rdfs:range foaf:Image;
               <http://www.w3.org/2002/07/owl#inverseOf> foaf:depicts;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:depicts a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:comment "A thing depicted in this representation.";
             rdfs:domain foaf:Image;
             rdfs:isDefinedBy foaf:;
             rdfs:label "depicts";
             rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
             <http://www.w3.org/2002/07/owl#inverseOf> foaf:depiction;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:dnaChecksum a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "A checksum for the DNA of some thing. Joke.";
                 rdfs:isDefinedBy foaf:;
                 rdfs:label "DNA checksum";
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:familyName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment "The family name of some person.";
                rdfs:domain foaf:Person;
                rdfs:isDefinedBy foaf:;
                rdfs:label "familyName";
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:family_name a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "The family name of some person.";
                 rdfs:domain foaf:Person;
                 rdfs:isDefinedBy foaf:;
                 rdfs:label "family_name";
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:firstName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 rdf:Property;
               rdfs:comment "The first name of a person.";
               rdfs:domain foaf:Person;
               rdfs:isDefinedBy foaf:;
               rdfs:label "firstName";
               rdfs:range rdfs:Literal;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:focus a <http://www.w3.org/2002/07/owl#ObjectProperty>,
             rdf:Property;
           rdfs:comment "The underlying or 'focal' entity associated with some SKOS-described concept.";
           rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
           rdfs:isDefinedBy foaf:;
           rdfs:label "focus";
           rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:fundedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                rdf:Property;
              rdfs:comment "An organization funding a project or person.";
              rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
              rdfs:isDefinedBy foaf:;
              rdfs:label "funded by";
              rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:geekcode a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                rdf:Property;
              rdfs:comment "A textual geekcode for this person, see http://www.geekcode.com/geek.html";
              rdfs:domain foaf:Person;
              rdfs:isDefinedBy foaf:;
              rdfs:label "geekcode";
              rdfs:range rdfs:Literal;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:gender a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>,
              rdf:Property;
            rdfs:comment "The gender of this Agent (typically but not necessarily 'male' or 'female').";
            rdfs:domain foaf:Agent;
            rdfs:isDefinedBy foaf:;
            rdfs:label "gender";
            rdfs:range rdfs:Literal;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:givenName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 rdf:Property;
               rdfs:comment "The given name of some person.";
               rdfs:isDefinedBy foaf:;
               rdfs:label "Given name";
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:givenname a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 rdf:Property;
               rdfs:comment "The given name of some person.";
               rdfs:isDefinedBy foaf:;
               rdfs:label "Given name";
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:holdsAccount a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    rdf:Property;
                  rdfs:comment "Indicates an account held by this agent.";
                  rdfs:domain foaf:Agent;
                  rdfs:isDefinedBy foaf:;
                  rdfs:label "account";
                  rdfs:range foaf:OnlineAccount;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
foaf:homepage a rdf:Property,
                <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
              rdfs:comment "A homepage for some thing.";
              rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
              rdfs:isDefinedBy foaf:;
              rdfs:label "homepage";
              rdfs:range foaf:Document;
              rdfs:subPropertyOf foaf:page,
                                 foaf:isPrimaryTopicOf;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:icqChatID a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                 rdf:Property,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "An ICQ chat ID";
               rdfs:domain foaf:Agent;
               rdfs:isDefinedBy foaf:;
               rdfs:label "ICQ chat ID";
               rdfs:range rdfs:Literal;
               rdfs:subPropertyOf foaf:nick;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:img a <http://www.w3.org/2002/07/owl#ObjectProperty>,
           rdf:Property;
         rdfs:comment "An image that can be used to represent some thing (ie. those depictions which are particularly representative of something, eg. one's photo on a homepage).";
         rdfs:domain foaf:Person;
         rdfs:isDefinedBy foaf:;
         rdfs:label "image";
         rdfs:range foaf:Image;
         rdfs:subPropertyOf foaf:depiction;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:interest a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                rdf:Property;
              rdfs:comment "A page about a topic of interest to this person.";
              rdfs:domain foaf:Agent;
              rdfs:isDefinedBy foaf:;
              rdfs:label "interest";
              rdfs:range foaf:Document;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:isPrimaryTopicOf a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                        rdf:Property;
                      rdfs:comment "A document that this thing is the primary topic of.";
                      rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                      rdfs:isDefinedBy foaf:;
                      rdfs:label "is primary topic of";
                      rdfs:range foaf:Document;
                      rdfs:subPropertyOf foaf:page;
                      <http://www.w3.org/2002/07/owl#inverseOf> foaf:primaryTopic;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:jabberID a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                rdf:Property;
              rdfs:comment "A jabber ID for something.";
              rdfs:domain foaf:Agent;
              rdfs:isDefinedBy foaf:;
              rdfs:label "jabber ID";
              rdfs:range rdfs:Literal;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:knows a <http://www.w3.org/2002/07/owl#ObjectProperty>,
             rdf:Property;
           rdfs:comment "A person known by this person (indicating some level of reciprocated interaction between the parties).";
           rdfs:domain foaf:Person;
           rdfs:isDefinedBy foaf:;
           rdfs:label "knows";
           rdfs:range foaf:Person;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:lastName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                rdf:Property;
              rdfs:comment "The last name of a person.";
              rdfs:domain foaf:Person;
              rdfs:isDefinedBy foaf:;
              rdfs:label "lastName";
              rdfs:range rdfs:Literal;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:logo a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
            <http://www.w3.org/2002/07/owl#ObjectProperty>,
            rdf:Property;
          rdfs:comment "A logo representing some thing.";
          rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
          rdfs:isDefinedBy foaf:;
          rdfs:label "logo";
          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:made a <http://www.w3.org/2002/07/owl#ObjectProperty>,
            rdf:Property;
          rdfs:comment "Something that was made by this agent.";
          rdfs:domain foaf:Agent;
          rdfs:isDefinedBy foaf:;
          rdfs:label "made";
          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
          <http://www.w3.org/2002/07/owl#inverseOf> foaf:maker;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:maker a rdf:Property,
             <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "An agent that  made this thing.";
           rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
           rdfs:isDefinedBy foaf:;
           rdfs:label "maker";
           rdfs:range foaf:Agent;
           <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/dc/terms/creator>;
           <http://www.w3.org/2002/07/owl#inverseOf> foaf:made;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:mbox a <http://www.w3.org/2002/07/owl#ObjectProperty>,
            <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
            rdf:Property;
          rdfs:comment "A  personal mailbox, ie. an Internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that  there is (across time and change) at most one individual that ever has any particular value for foaf:mbox.";
          rdfs:domain foaf:Agent;
          rdfs:isDefinedBy foaf:;
          rdfs:label "personal mailbox";
          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:mbox_sha1sum a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                    rdf:Property;
                  rdfs:comment "The sha1sum of the URI of an Internet mailbox associated with exactly one owner, the  first owner of the mailbox.";
                  rdfs:domain foaf:Agent;
                  rdfs:isDefinedBy foaf:;
                  rdfs:label "sha1sum of a personal mailbox URI name";
                  rdfs:range rdfs:Literal;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
foaf:member a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              rdf:Property;
            rdfs:comment "Indicates a member of a Group";
            rdfs:domain foaf:Group;
            rdfs:isDefinedBy foaf:;
            rdfs:label "member";
            rdfs:range foaf:Agent;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
foaf:membershipClass a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                       rdf:Property;
                     rdfs:comment "Indicates the class of individuals that are a member of a Group";
                     rdfs:isDefinedBy foaf:;
                     rdfs:label "membershipClass";
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
foaf:msnChatID a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 rdf:Property;
