@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ngeo: <http://geovocab.org/geometry#>.

<http://geovocab.org/geometry> a <http://www.w3.org/2002/07/owl#Ontology>;
                               rdfs:comment "A vocabulary for describing geographical regions in RDF. $Id: geometry# 81 2012-02-05 11:06:49Z non88sense@gmail.com $";
                               rdfs:label "NeoGeo Geometry Ontology";
                               <http://www.w3.org/2002/07/owl#imports> <http://geovocab.org/mappings/geometry>.
ngeo:BoundingBox a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Represents a bounding box composed by four line segments.";
                 rdfs:label "Bounding Box";
                 rdfs:subClassOf ngeo:Geometry;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:Geometry a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Super-class grouping all geometrical representations (also ones in non-RDF formats, such as KML, GML, WKT...).";
              rdfs:label "Geometry";
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ngeo:GeometryCollection a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Super-class grouping all composite geometrical representations.";
                        rdfs:label "Geometry Collection";
                        rdfs:subClassOf ngeo:Geometry;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:LineString a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Represents a series of points connected by straight lines.";
                rdfs:label "LineString";
                rdfs:subClassOf ngeo:Geometry;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:LinearRing a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Represents a series of points connected by straight lines, which form a closed shape. Last point must be the same as the first point.";
                rdfs:label "LinearRing";
                rdfs:subClassOf ngeo:LineString;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:MultiLineString a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Describes a geometric shape composed of several LineString resources.";
                     rdfs:label "MultiLineString";
                     rdfs:subClassOf ngeo:GeometryCollection;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:MultiPoint a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Describes a collection of Point resources, which define a resource's geometric representation.";
                rdfs:label "MultiPoint";
                rdfs:subClassOf ngeo:GeometryCollection;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:MultiPolygon a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Describes a geometric shape composed of several Polygon resources.";
                  rdfs:label "MultiPolygon";
                  rdfs:subClassOf ngeo:GeometryCollection;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:Polygon a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A closed area defined by an exterior boundary, and optionally one or more interior boundaries.";
             rdfs:label "Polygon";
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> ngeo:LinearRing ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ngeo:interior ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ngeo:exterior ; 
                              <http://www.w3.org/2002/07/owl#onClass> ngeo:LinearRing ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             ngeo:Geometry;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:asWKT a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "WKT serialization of the geometry.";
           rdfs:label "As WKT";
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
ngeo:bbox a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "Relates a Geometry to its Bounding Box.";
          rdfs:domain ngeo:Geometry;
          rdfs:label "bounding box";
          rdfs:range ngeo:BoundingBox;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:boundary a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Super-property that groups all properties defining a polygon's boundaries.";
              rdfs:domain ngeo:Polygon;
              rdfs:label "boundary";
              rdfs:range ngeo:LinearRing;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:exterior a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Defines a polygon's outer boundary.";
              rdfs:domain ngeo:Polygon;
              rdfs:label "exterior";
              rdfs:range ngeo:LinearRing;
              rdfs:subPropertyOf ngeo:boundary;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:geometry a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates a resource to its geometric shape.";
              rdfs:label "geometry";
              rdfs:range ngeo:Geometry;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
ngeo:interior a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Defines an polygon's boundary within its outer boundary, i.e. a polygon with 'holes' in it.";
              rdfs:domain ngeo:Polygon;
              rdfs:label "interior";
              rdfs:range ngeo:LinearRing;
              rdfs:subPropertyOf ngeo:boundary;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:lineStringMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links a LineString simple geometry to a MultiLineString composite geometry.";
                      rdfs:domain ngeo:MultiLineString;
                      rdfs:label "LineString member";
                      rdfs:range ngeo:LineString;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:partOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relates a point to a geometric shape's boundary.";
            rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
            rdfs:label "part of";
            rdfs:range ngeo:LineString;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:pointMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Links a Point simple geometry to a MultiPoint composite Geometry.";
                 rdfs:domain ngeo:MultiPoint;
                 rdfs:label "Point member";
                 rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:polygonMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Links a Polygon simple geometry to a MultiPolygon composite geometry.";
                   rdfs:domain ngeo:MultiPolygon;
                   rdfs:label "Polygon member";
                   rdfs:range ngeo:Polygon;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
ngeo:posList a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Relates a LineString or LinearRing to the points that define them.";
             rdfs:domain ngeo:LineString;
             rdfs:label "position list";
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:label "Point".
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
