<http://linkeddata.center/kees/v1> <http://purl.org/dc/elements/1.1/creator> "Enrico Fagnoni"@en;
                                   <http://purl.org/dc/elements/1.1/description> "KEES (Knowledge Exchenge Engine Schema ) ontology describes a knowledge base configuration in terms of ABox and TBox statements together with their accrual and reasoning policies.  This vocabulary is designed to drive automatic data ingestion in a graph database according KEES (Knowledge Exchange Engine Schema) and Linked (Open) Data principles.  For a pratical use  of KEES ontology see  http://linkeddata.center/help/devop/kees-profile article."@en,
                                                                                 <http://linkeddata.center/kees/images/cycle.png>;
                                   <http://purl.org/dc/elements/1.1/rights> """The KEES ontology is available under the Creative Commons Attribution 3.0 Unported license; see http://creativecommons.org/licenses/by/3.0/. In a nutshell, you are free to copy, distribute and transmit the work; to remix/adapt the work (e.g. to import the ontology and create specializations of its elements), as long as you attribute the work in the manner specified by the author or licensor (but not in any way that suggests that they endorse you or your use of the work). Proper Attribution: Simply include the statement \"This work is based on the KEES ontology, developed by Enrico Fagnoni\" and link back to http:/linkeddata.center/kees/v1"""@en;
                                   <http://purl.org/dc/elements/1.1/subject> "Knowledge Exchange Engine Schema Ontology."@en;
                                   <http://purl.org/dc/elements/1.1/title> "The KEES Vocabulary for knowledge  base management"@en;
                                   <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/>;
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:label "KEES Ontology"@en;
                                   rdfs:seeAlso <http://linkeddata.center/help/devop/kees-profile>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "V 1.1.19 Release 2016-02-04";
                                   <http://xmlns.com/foaf/0.1/homepage> <http://linkeddata.center/kees/>.
kees:ABoxGraph a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A named graph containing only facts."@en;
               rdfs:label "ABox Graph"@en;
               rdfs:subClassOf kees:KnowledgeGraph;
               <http://www.w3.org/2002/07/owl#disjointWith> kees:TBoxGraph.
kees:Activity a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating knowledge base entities. It is a subclass of prov:Activity class."@en;
              rdfs:label "Activity"@en.
kees:Agent a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A software agent running kees compliant software. It is a subclass of prov:SoftwareAgent"@en;
           rdfs:label "Agent"@en.
kees:Answer a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A query that returns a boolean value (true or false). Realized by a SPARQL ASK construct."@en;
            rdfs:label "Answer"@en;
            rdfs:subClassOf kees:Query.
kees:AuthenticationPolicy a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "An authentication method used to access a resource"@en;
                          rdfs:label "Authentication Method"@en;
                          rdfs:subClassOf kees:Policy.
kees:BootGraph a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A special graph that can include boot directive that are copiet to config graph."@en;
               rdfs:label "Boot Graph"@en;
               rdfs:subClassOf kees:ABoxGraph.
kees:BulkAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An accrual policy that creates a knowledge graph in the knowlegde base  from a  web resource exposing  RDF data. Implies that the described resource kees:generatesGraphType  kees:LinkedDataGraph."@en,
                                    "Linked data platform  Rdf Resource accrual policy"@en;
                       rdfs:label "Bulk Accrual Policy"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> kees:source ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> kees:generatesGraphType ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       kees:LDPRSAccrualPolicy.
kees:BulkIngestor a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A processor that processes bulk accrual policies."@en;
                  rdfs:label "Bulk Ingestor"@en;
                  rdfs:subClassOf kees:LDPRSAccrualPolicyProcessor.
kees:ConfigAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An accrual policy that creates a knowledge graph in the knowlegde base  from a resource exposing KEES ontology RDF data. Implies that the described resource kees:generatesGraphType  keesConfigDataGraph."@en;
                         rdfs:label "Config Accrual Policy"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> kees:includes ; 
                                          <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> kees:generatesGraphType ; 
                                          <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         kees:LDPRSAccrualPolicy.
kees:ConfigImporter a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A processor that processes config accrual policies."@en;
                    rdfs:label "Config Importer"@en;
                    rdfs:subClassOf kees:LDPRSAccrualPolicyProcessor.
kees:ConstructRule a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A rule that create new facts in a Knowledge base"@en;
                   rdfs:label "Construct Rule"@en;
                   rdfs:subClassOf kees:ReasoningPolicy;
                   <http://www.w3.org/2002/07/owl#disjointWith> kees:DestructRule.
kees:DestructRule a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A rule that destroy (invalidated) facts in a knowledge base"@en;
                  rdfs:label "Destruct Rule"@en;
                  rdfs:subClassOf kees:ReasoningPolicy.
kees:Entity a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An kees entity is a something about the  Knowledge Base.   It is a subclass of prov:Entity Class"@en;
            rdfs:label "Entity"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:tripleCount ; 
                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> kees:byteCount ; 
                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>].
kees:FailureReport a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A  report  that states a processing error."@en;
                   rdfs:label "Failure Report"@en;
                   rdfs:subClassOf kees:ProcessingReport.
kees:Graph a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A query that returns an RDF graph. Realized by a SPARQL CONSTRUCT."@en;
           rdfs:label "Graph"@en;
           rdfs:subClassOf kees:Query.
kees:HttpBasicAuthentication a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "http basic autentication method as described in RFC 2617"@en;
                             rdfs:label "Http Basic Autentication Method"@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> kees:password ; 
                                              <http://www.w3.org/2002/07/owl#onDataRange> xsd:success ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> kees:username ; 
                                              <http://www.w3.org/2002/07/owl#onDataRange> xsd:success ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             kees:AuthenticationPolicy.
kees:InferredKnowledgeGraph a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A named graph containing inferred facts (by axioms or rules)"@en;
                            rdfs:label "Inferred Knowledge Graph"@en;
                            rdfs:subClassOf kees:ABoxGraph.
kees:IngestionActivityReportGraph a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "A named graph that stores statements about an ingestion activity.  By default all report about completed activities older than 24 hours are purged away."@en;
                                  rdfs:label "Ingestion Activity Report Graph"@en;
                                  rdfs:subClassOf kees:ABoxGraph.
kees:IngestionCycle a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The kees cycle window processing activity ( ie.  Booting, Learning, reasoning)"@en;
                    rdfs:label "Ingestion Cycle"@en;
                    rdfs:subClassOf kees:Activity;
                    <http://www.w3.org/2002/07/owl#disjointWith> kees:KnowledgeAccrual.
kees:IngestionFromLDPRS a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Indexing of a web RDF resource using INSERT DATA sparql update construct. This activity is pretty flexible but requires an extra loading and parsing of resources. It recognize LDPRS accual policies."@en;
                        rdfs:label "Ingestion From LDPRS"@en;
                        rdfs:subClassOf kees:ResourceIngestion;
                        <http://www.w3.org/2002/07/owl#disjointWith> kees:SimplifiedResourceIngestion.
kees:IngestionFromLodLaundromat a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "An activity to index a streamed RDF resouce provided by a LOD Laundromat service."@en;
                                rdfs:label "Ingestion From a Lod Laundromat"@en;
                                rdfs:seeAlso <http://lodlaundromat.org/>;
                                rdfs:subClassOf kees:ResourceIngestion.
kees:IngestionFromSparqlService a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "An activity to index  RDF triples extracted from a sparql service."@en;
                                rdfs:label "Ingestion From Sparql Service"@en;
                                rdfs:subClassOf kees:ResourceIngestion.
kees:IngestionPlan a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A plan that describe the objective  for a data ingestion activity."@en;
                   rdfs:label "Ingestion Plan"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:expectedParts ; 
                                    <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> kees:havingTargetGraphName ; 
                                    <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onProperty> kees:expectedTriples ; 
                                    <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   kees:Plan.
kees:KBConfigGraph a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A named graph that contains knowlege base configuration data. Data consist in instances of Accrual Policies."@en;
                   rdfs:label "Knowledge Base Config Graph"@en;
                   rdfs:subClassOf kees:ABoxGraph.
kees:KnowledgeAccrual a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The abstract superclass for activities that builds knowledge graphs."@en;
                      rdfs:label "Knowledge Accrual"@en;
                      rdfs:subClassOf kees:Activity.
kees:KnowledgeAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The superclass for all the policies that describe how to learn facts from the web. The Accrual policy describes how to create and maintain ABox and TBox statements in a knowledge base."@en;
                            rdfs:label "Knowledge Accrual Policy"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:generatesGraphType ; 
                                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:requiresAuthentication ; 
                                             <http://www.w3.org/2002/07/owl#onClass> kees:AuthenticationPolicy ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:url ; 
                                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:onFetchingError ; 
                                             <http://www.w3.org/2002/07/owl#onClass> kees:RetentionPolicy ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:hasUpdatePolicy ; 
                                             <http://www.w3.org/2002/07/owl#onClass> kees:UpdatePolicy ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            kees:Policy,
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:forceAccept ; 
                                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> kees:createsGraphName ; 
                                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>].
kees:KnowledgeBase a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A RDF graph database composed by ABox and TBox statements organized in named graph."@en;
                   rdfs:label "Knowledge Base"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kees:KBConfigGraph ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> kees:hasConfigGraph ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> kees:InferredKnowledgeGraph ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> kees:hasInferenceGraph ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> kees:hasBootGraph ; 
                                    <http://www.w3.org/2002/07/owl#onClass> kees:BootGraph ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   kees:Entity.
kees:KnowledgeGraph a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:subClassOf kees:Entity.
kees:LDPRSAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An accrual policy to  create a  named  graph in the graph database from a Linked Data Platform Rdf Source , using eTag and lastUpdate http caching info. It recognizes LDP paging protocol.  Standard RDF resource loading  policy for  any  web resource exposing RDF data."@en;
                        rdfs:label "LDPRS Accrual Policy"@en;
                        rdfs:seeAlso <http://www.w3.org/TR/ldp/#dfn-linked-data-platform-resource>;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:supportsLDPPP ; 
                                         <http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                         <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#onProperty> kees:supportsHttpCaching ; 
                                         <http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                         <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        kees:KnowledgeAccrualPolicy.
kees:LDPRSAccrualPolicyProcessor a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "The abstract superclass for processors that manage  LDPRS accual policies."@en;
                                 rdfs:label "LDPRS Accrual Policy Processor"@en;
                                 rdfs:subClassOf kees:Agent.
kees:LinkedDataGraph a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An ABox named graph that stores facts from  linked data learned from web 3.0 resources."@en;
                     rdfs:label "Linked Data Graph"@en;
                     rdfs:subClassOf kees:ABoxGraph.
kees:LodLaundromatAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "An accrual policy that creates a knowledge graph in the knowlegde base  from a resource contained in lod laundromatic service."@en;
                                rdfs:label "Lod Laundromat Accrual Policy"@en;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> kees:lodLaundromatUrl ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                kees:KnowledgeAccrualPolicy.
kees:LodLaundromatAgent a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A client for lod laundromat web service. A processor that processes lod laundromat  accrual policies."@en;
                        rdfs:label "Lod Laundromat Agent"@en;
                        rdfs:subClassOf kees:Agent.
kees:NoChangeReport a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A report that states that the knowledge base was not changed by the processing activity."@en;
                    rdfs:label "No Change Report"@en;
                    rdfs:subClassOf kees:ProcessingReport.
kees:Page a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A paged resource,  a subclass of http://www.w3.org/ns/ldp#Page."@en;
          rdfs:label "Page"@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kees:PagingData ; 
                           <http://www.w3.org/2002/07/owl#onProperty> kees:hasPagingData ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> kees:hasOffset ; 
                           <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          kees:Entity.
kees:PagingData a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Page sequence info"@en;
                rdfs:label "Paging Data"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:prevPage ; 
                                 <http://www.w3.org/2002/07/owl#onClass> kees:Page ; 
                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> kees:nextPage ; 
                                 <http://www.w3.org/2002/07/owl#onClass> kees:Page ; 
                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> kees:isLastPage ; 
                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> kees:pageNum ; 
                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:positiveInteger ; 
                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kees:Entity.
kees:Plan a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "An entity that represents a set of actions or steps intended by one or more processor  to achieve some goals. It is equivalent to prov:Plan."@en;
          rdfs:label "Plan"@en;
          rdfs:subClassOf kees:Entity.
kees:Policy a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A plan or course of action by an authority, intended to influence and determine  actions, and other matters. Can be considered a subclass of dct:Plan Class."@en;
            rdfs:label "Policy"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:policyName ; 
                             <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                             <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            kees:Entity.
kees:ProcessingReport a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The report about the result of a processing activity."@en;
                      rdfs:label "Processing Report"@en;
                      rdfs:subClassOf kees:Entity.
kees:Query a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A generic query expressed by a SPARQL construct."@en;
           rdfs:label "Query"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> kees:queryText ; 
                            <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           kees:Entity.
kees:Reasoner a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A processor that create new facts using inference, rules and axioms."@en;
              rdfs:label "reasoner"@en;
              rdfs:subClassOf kees:Agent.
kees:Reasoning a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The activity of materializing RDF statements from rules and axioms."@en;
               rdfs:label "Reasoning"@en;
               rdfs:subClassOf kees:KnowledgeAccrual;
               <http://www.w3.org/2002/07/owl#disjointWith> kees:ResourceIngestion.
kees:ReasoningPlan a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A  plan for a reasoning activity  that concens the creation or the destruction of   facts from a production rule."@en;
                   rdfs:label "Reasoning Plan"@en;
                   rdfs:subClassOf kees:Plan.
kees:ReasoningPolicy a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A construction rule according a legacy syntax derived from stardog DL entilement rules"@en;
                     rdfs:label "Reasoning Policy"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> kees:ruleText ; 
                                      <http://www.w3.org/2002/07/owl#onDataRange> xsd:success ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> kees:executionPriority ; 
                                      <http://www.w3.org/2002/07/owl#onDataRange> xsd:integer ; 
                                      <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> kees:ruleName ; 
                                      <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                                      <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     kees:Policy.
kees:ResourceIngestion a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A super class for all activities that get data from a web resource."@en;
                       rdfs:label "Resource Ingestion"@en;
                       rdfs:subClassOf kees:KnowledgeAccrual.
kees:RetentionPolicy <http://purl.org/dc/elements/1.1/description> "How to manage errors during learning phase: is default  dropDataset "@en;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Retention Policy"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> kees:hasResilience ; 
                                      <http://www.w3.org/2002/07/owl#onDataRange> xsd:negativeInteger ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     kees:Policy.
kees:SimplifiedResourceIngestion a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Indexing of a web resource useing the LOAD construct in sparql update. This Ingestion activity doe not supports content negotiation, http chahcing, LDP paging and depends from baking quadstore server inplementation. Should be used when possible because it is portable and fast. It recognize LDPRS accual policies."@en;
                                 rdfs:label "Simplified Resource Ingestion"@en;
                                 rdfs:subClassOf kees:ResourceIngestion.
kees:SparqlIngestor a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "a processor that manages sparql service accrual policies."@en;
                    rdfs:label "Sparql Ingestor"@en;
                    rdfs:subClassOf kees:Agent.
kees:SparqlServiceAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment """Load RDF resource executing a sparql query to a sparql endpoint (using POST).
The query must be contained (unencoded) in accrualOption propery"""@en;
                                rdfs:label "SPARQL Ingestion Accrual Policy"@en;
                                rdfs:subClassOf kees:KnowledgeAccrualPolicy,
                                                [<http://www.w3.org/2002/07/owl#onProperty> kees:toPage ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> kees:sparqlEndpoint ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> kees:constructQuery ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:success ; 
                                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> kees:queryMethod ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                                                                              a rdfs:Datatype] ; 
                                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> kees:queryName ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> kees:fromPage ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:positiveInteger ; 
                                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> kees:pageSize ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>].
kees:SuccessReport a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A report that states a succesful processing result."@en;
                   rdfs:label "Success Report"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> kees:transactionCount ; 
                                    <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#maxQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   kees:ProcessingReport.
kees:TBoxAccrualPolicy a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An accrual policy that creates a knowledge graph in the knowlegde base  from a resource exposing ontologies in RDF (owl, rdfs, skos). Implies that the described resource kees:generatesGraphType  kees:TBoxGraph."@en;
                       rdfs:label "TBox Accrual Policy"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> kees:generatesGraphType ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> kees:vocabulary ; 
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:anyURI ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       kees:LDPRSAccrualPolicy.
kees:TBoxGraph a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A named graph that contains vocabularies and taxonomies."@en;
               rdfs:label "TBox Graph"@en;
               rdfs:subClassOf kees:KnowledgeGraph.
kees:TBoxIngestor a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A processor that processes TBox accrual policies."@en;
                  rdfs:label "TBox Ingestor"@en;
                  rdfs:subClassOf kees:LDPRSAccrualPolicyProcessor.
kees:Table a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A query that returns a table of data. Realized by a SPARQL SELECT construct."@en;
           rdfs:label "Table"@en;
           rdfs:subClassOf kees:Query.
kees:UpdatePolicy a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A forecasted  rate at which change recurs in an ABox Graph ."@en;
                  rdfs:label "Update Policy"@en;
                  rdfs:seeAlso <http://purl.org/dc/terms/Frequency>;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> kees:hasFrequencyPeriod ; 
                                   <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  kees:Policy.
kees:Workflow a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A plan for a kees Cycle processing."@en;
              rdfs:label "Workflow"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> kees:workflowStructure ; 
                               <http://www.w3.org/2002/07/owl#onDataRange> xsd:string ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              kees:Plan.
kees:byteCount a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "is the number of bytes processed by an ingestion activity."@en;
               rdfs:domain kees:SuccessReport;
               rdfs:label "byte count"@en;
               rdfs:range xsd:nonNegativeInteger.
kees:constructQuery a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment """The SPARQL 1.1.  query to extract data from a SPARQL endpoint. No paging constructs allowed ( OFSET and LIMIT ), use pageSize, fromPage and toPage instead. If not specified \"CONSTRUCT { ?s ?p ?o }  WHERE { ?s ?p ?o }\" apply"""@en;
                    rdfs:domain kees:SparqlServiceAccrualPolicy;
                    rdfs:label "construct query"@en;
                    rdfs:range xsd:string.
kees:createsGraphName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "The related uri is used as as the name of the graph produced according the described accrual policy. If not specified the same value of kees:url is inferred."@en;
                      rdfs:domain kees:KnowledgeAccrualPolicy;
                      rdfs:label "creates graph name";
                      rdfs:range xsd:anyURI.
kees:executionPriority a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                       rdfs:comment "An optional integer that determine the ordere of execution of a rule ( ascending)."@en;
                       rdfs:domain kees:ReasoningPolicy;
                       rdfs:label "execution priority"@en;
                       rdfs:range xsd:integer.
kees:expectedParts a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "the number of expected resource partitions (i.e pages)."@en;
                   rdfs:domain kees:IngestionPlan;
                   rdfs:label "expected parts"@en;
                   rdfs:range xsd:nonNegativeInteger.
kees:expectedTriples a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment "the expected maximum number of triple to be indexed by an activity."@en;
                     rdfs:domain kees:IngestionPlan;
                     rdfs:label "expected triples"@en;
                     rdfs:range xsd:nonNegativeInteger.
kees:forceAccept a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment "Define specified http accept header in requesting source. The sintax must be complain to RFC 2616 for HTTP 1.1. accept header. If not specified 'application/n-triples,application/ld+json,application/rdf+xml,text/turtle,*/*;q=0.4' it is used."@en;
                 rdfs:domain kees:KnowledgeAccrualPolicy;
                 rdfs:label "force accept"@en;
                 rdfs:range xsd:string.
kees:fromPage a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "The first page returned by a SPARQL in a query iteration. Defaults to 1 if not present."@en;
              rdfs:domain kees:SparqlServiceAccrualPolicy;
              rdfs:label "from page"@en;
              rdfs:range xsd:positiveInteger.
kees:generatesGraphType a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:comment "The  described accrual policy has the objective to generate/maintain a knowledge graph of the related type. If the property is not specified, nor explicitely nor implicitely (by axioms), kees:LinkedDataGraph is inferred."@en;
                        rdfs:domain kees:KnowledgeAccrualPolicy;
                        rdfs:label "generates  graph type"@en;
                        rdfs:range xsd:anyURI.
kees:hasABoxGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "The related resource is one of the ABox graphs that contain linked data facts in the described  knowlege base."@en;
                  rdfs:domain kees:KnowledgeBase;
                  rdfs:label "has ABox graph"@en;
                  rdfs:range kees:ABoxGraph;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasAccrualPolicy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "The related resource is a policy governing the addition of a named graph to the described knowledge base. Very similar to the dct:accrualPolicy property."@en;
                      rdfs:domain kees:KnowledgeBase;
                      rdfs:label "has accrual policy"@en;
                      rdfs:range kees:KnowledgeAccrualPolicy;
                      rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasBootGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "This property states that annotated knowledge base as a referened boot graph."@en;
                  rdfs:domain kees:KnowledgeGraph;
                  rdfs:label "has boot graph"@en;
                  rdfs:range kees:BootGraph.
kees:hasConfigGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "The related resource is one of the configuration graph that caracterize the described knowledge base."@en;
                    rdfs:domain kees:KnowledgeBase;
                    rdfs:label "has config graph"@en;
                    rdfs:range kees:KBConfigGraph;
                    rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasFrequencyPeriod a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:comment "Frequency period in seconds."@en;
                        rdfs:domain kees:UpdatePolicy;
                        rdfs:label "has frequency period"@en;
                        rdfs:range xsd:nonNegativeInteger;
                        rdfs:seeAlso <http://www.w3.org/TR/swbp-xsch-datatypes/#section-duration>.
kees:hasInferenceGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                       rdfs:comment "The related resource is the graph where reasoners places all materialized triples."@en;
                       rdfs:domain kees:KnowledgeBase;
                       rdfs:label "has inference graph"@en;
                       rdfs:range kees:InferredKnowledgeGraph;
                       rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasIngestionActivityReportGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                     rdfs:comment "The related resource is a graph used to store logs  about a kees cycle executions."@en;
                                     rdfs:domain kees:KnowledgeBase;
                                     rdfs:label "has ingestion activity report graph"@en;
                                     rdfs:range kees:IngestionActivityReportGraph;
                                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasLimit a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "the max size in RDF triple of a paged resource"@en;
              rdfs:label "has limit"@en.
kees:hasOffset a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "first record ofset of a page."@en;
               rdfs:domain kees:Page;
               rdfs:label "has offset"@en;
               rdfs:range xsd:nonNegativeInteger.
kees:hasPagingData a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "The related resource is a dataset that contains the page info about the annotated paged resource."@en;
                   rdfs:domain kees:Page;
                   rdfs:label "has Paging Data"@en;
                   rdfs:range kees:PagingData.
kees:hasReasoningRule a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "this property states that the annotated Knowledge Accrual has a reasoning policy."@en;
                      rdfs:label "hasReasoningPolicy"@en.
kees:hasResilience a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment """The number of times  ABOX graph is retained in storage after a failure in fetchin it. The default is 0 that means that when a graph fails to load it is removed from the knowledge base. If the value of this attribute is, for instance 3, this means that the Graph will be keept in the knowledge base untill its loading fails for three consecutive  times (the fourth error drives a graph drop). A succesfull loading reset the fail counter.N.B. a \"not modified\" message does not reset the fail counter."""@en;
                   rdfs:domain kees:RetentionPolicy;
                   rdfs:label "has resilience"@en;
                   rdfs:range xsd:nonNegativeInteger.
kees:hasTBoxGraph a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "The related resource is one of the ABox graphs that contain vocabularies and taxonomies used in the described  knowlege base."@en;
                  rdfs:domain kees:KnowledgeBase;
                  rdfs:label "has TBox graph"@en;
                  rdfs:range kees:TBoxGraph;
                  rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:hasUpdatePolicy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment "The related resource is a policy that suggest a time frame, expressed in seconds after witch the described accrual policy should check data for update.  If not specified , a period of one hour is guessed . A policy that specify a long interval greatly improves ingestion engines performances."@en;
                     rdfs:domain kees:KnowledgeAccrualPolicy;
                     rdfs:label "has update policy"@en;
                     rdfs:range kees:UpdatePolicy;
                     rdfs:seeAlso <http://purl.org/dc/terms/accrualPeriodicity>;
                     rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
kees:havingTargetGraphName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                           rdfs:comment "States that the described ingestion plan is about the creation/maintenance of a graph named as the referenced object."@en;
                           rdfs:domain kees:IngestionPlan;
                           rdfs:label "having target graph name"@en;
                           rdfs:range xsd:anyURI.
kees:includes a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "The URL of a web resource exposing a Kees configuration data."@en;
              rdfs:domain kees:ConfigAccrualPolicy;
              rdfs:label "include"@en;
              rdfs:range xsd:anyURI;
              rdfs:subPropertyOf kees:url.
kees:isLastPage a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "states that the referenced page is the last one. If not present defautlt is false."@en;
                rdfs:domain kees:Page;
                rdfs:label "is the last page"@en;
                rdfs:range xsd:boolean.
kees:lodLaundromatUrl a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "An url of a resource stored in the  lod laundromat wardrobe. similar to llo:url."@en;
                      rdfs:domain kees:LodLaundromatAccrualPolicy;
                      rdfs:label "lod laundromat url"@en;
                      rdfs:range xsd:anyURI;
                      rdfs:seeAlso <http://lodlaundromat.org/>;
                      rdfs:subPropertyOf kees:url.
kees:nextPage a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "States that referred Page has a next page."@en;
              rdfs:domain kees:Page;
              rdfs:label "next page"@en;
              rdfs:range kees:Page.
kees:onFetchingError a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment "The related resource declares the policy to adopt when an error occurs during the execution of the described accrual policy. If not present any error in data loading removes the related graph the in knowledge base."@en;
                     rdfs:domain kees:KnowledgeAccrualPolicy;
                     rdfs:label "on fetching error"@en;
                     rdfs:range kees:RetentionPolicy.
kees:pageNum a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "A page sequence number ."@en;
             rdfs:domain kees:Page;
             rdfs:label "page number"@en;
             rdfs:range xsd:positiveInteger.
kees:pageSize a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "The size for a SPARQL query page. Equivalent  with LIMIT clause. Defaults to 1000 if not defined"@en;
              rdfs:domain kees:SparqlServiceAccrualPolicy;
              rdfs:label "page size"@en;
              rdfs:range xsd:positiveInteger.
kees:password a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "Password in basic autentication method"@en;
              rdfs:domain kees:HttpBasicAuthentication;
              rdfs:label "password"@en;
              rdfs:range xsd:string.
kees:policyName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "a conventional name for a Policy. Should be univoque inside the knowledge base."@en;
                rdfs:domain kees:Policy;
                rdfs:label "policy name"@en.
kees:prevPage a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "states that referred Page has a previous page"@en;
              rdfs:domain kees:Page;
              rdfs:label "previous page"@en;
              rdfs:range kees:Page.
kees:queryMethod a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment """The http request method used in a SPARQL query. Accepted metods: \"POST\"  and \"GET\". Defaults to \"POST\" if not specified."""@en;
                 rdfs:domain kees:SparqlServiceAccrualPolicy;
                 rdfs:label "query method"@en;
                 rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                             a rdfs:Datatype].
kees:queryName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "The name of the graph that will contain a sparql query result. If not specfied hinerit the sparql service endpoint url."@en;
               rdfs:domain kees:SparqlServiceAccrualPolicy;
               rdfs:label "query name"@en;
               rdfs:range xsd:anyURI;
               rdfs:subPropertyOf kees:createsGraphName.
kees:queryText a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "the text of a sparql query. In the query text you can inject variables with the form %varname=default value% where varname is a word a default value a string."@en;
               rdfs:domain kees:Query;
               rdfs:label "query text"@en;
               rdfs:range xsd:string.
kees:requiresAuthentication a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                            rdfs:comment "The related resource is an authentication method to be used to access dataset during the execution of the described accrual policy. If not present, no authentication required."@en;
                            rdfs:domain kees:KnowledgeAccrualPolicy;
                            rdfs:label "requires authentication"@en;
                            rdfs:range kees:AuthenticationPolicy.
kees:ruleName a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "a conventional name for a Reasoning Policy. Should be univoque inside the knowledge base."@en;
              rdfs:domain kees:ReasoningPolicy;
              rdfs:label "rule  name"@en;
              rdfs:subPropertyOf kees:policyName.
kees:ruleText a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment """The rule text body in the form:
prefixes declaration
IF { sparql where clause }
THEN { sparql insert(delete clause }.

Example:
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX gr: <http://purl.org/goodrelations/v1#>
PREFIX :<urn:test:>
IF {
           ?offering gr:hasPriceSpecification ?ps .
           ?ps gr:hasCurrencyValue ?price .
           FILTER (?price >= 200.00).
}
THEN {
           ?offering a :ExpensiveProduct .
}

"""@en;
              rdfs:domain kees:ReasoningPolicy;
              rdfs:range xsd:string.
kees:source a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "The URL of a web resource exposing RDF data facts."@en;
            rdfs:domain kees:BulkAccrualPolicy;
            rdfs:label "source"@en;
            rdfs:range xsd:anyURI;
            rdfs:subPropertyOf kees:url.
kees:sparqlEndpoint a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "An url of a sparql service endpoint. similar to sd:endpoint"@en;
                    rdfs:domain kees:SparqlServiceAccrualPolicy;
                    rdfs:label "sparql endpoint"@en;
                    rdfs:range xsd:anyURI;
                    rdfs:subPropertyOf kees:url.
kees:supportsHttpCaching a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                           <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                         rdfs:comment "Support http caching specification (RFC 2616 ) in sending HTTP requests. If not present, true is inferred."@en;
                         rdfs:domain kees:LDPRSAccrualPolicy;
                         rdfs:label "supports http caching"@en;
                         rdfs:range xsd:boolean.
kees:supportsLDPPP a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "The described accrual  policy supports the Linked Data Platform Paging Protocol following link=next in http headers. If not specified false is inferred false."@en;
                   rdfs:domain kees:LDPRSAccrualPolicy;
                   rdfs:label "supports LDPPP"@en;
                   rdfs:range xsd:boolean.
kees:toPage a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "The last page returned by a SPARQL query. If not present defaults to 1."@en;
            rdfs:domain kees:SparqlServiceAccrualPolicy;
            rdfs:label "to page"@en;
            rdfs:range xsd:positiveInteger.
kees:transactionCount a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "is the number of SPARQL uopdate transaction performed to complete a knowledge accrual activity."@en,
                                   "transaction count"@en;
                      rdfs:domain kees:SuccessReport;
                      rdfs:range xsd:nonNegativeInteger.
kees:tripleCount a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment "is the number of triples ingested by an accrual activity."@en,
                              "triple count"@en;
                 rdfs:domain kees:Entity;
                 rdfs:range xsd:nonNegativeInteger.
kees:url a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
           <http://www.w3.org/2002/07/owl#FunctionalProperty>;
         rdfs:comment "An url"@en;
         rdfs:domain kees:KnowledgeAccrualPolicy;
         rdfs:label "url"@en;
         rdfs:range xsd:anyURI.
kees:usedMemory a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "Extimated RAM bytes used by activity processing."@en;
                rdfs:domain kees:SuccessReport;
                rdfs:label "used memory"@en;
                rdfs:range xsd:nonNegativeInteger.
kees:username a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "Username in basic http autentication method"@en;
              rdfs:domain kees:HttpBasicAuthentication;
              rdfs:label "username"@en;
              rdfs:range xsd:string.
kees:vocabulary a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "It's datasource for a resource that contains TBox statements."@en;
                rdfs:domain kees:TBoxAccrualPolicy;
                rdfs:label "vocabulary"@en;
                rdfs:range xsd:anyURI;
                rdfs:subPropertyOf kees:url.
kees:workflowStructure a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                       rdfs:comment """A kees cycle description  in the form \"booting => learning => reasoning \" with some phases that can be omitted (i.e.  \"learning => reasoning \")"""@en;
                       rdfs:domain kees:Workflow;
                       rdfs:label "workflow structure"@en;
                       rdfs:range xsd:string.
<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/modifed> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/subject> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
xsd:success rdfs:label "has input"@en;
            <http://www.w3.org/2002/07/owl#priorVersion> "task  processor input as a json structure."@en.
<http://www.w3.org/2002/07/owl#deprecated> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://xmlns.com/foaf/0.1/homepage> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
