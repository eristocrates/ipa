@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gts: <http://resource.geosciml.org/ontology/timescale/gts#>.

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata#Medium.name> rdfs:label "Medium.name".
<http://resource.geosciml.org/ontology/timescale/gts> <http://purl.org/dc/elements/1.1/contributor> "Stephen M RICHARD";
                                                      <http://purl.org/dc/elements/1.1/creator> "Simon J D COX";
                                                      <http://purl.org/dc/elements/1.1/description> "This is an RDF/OWL representation of the GeoSciML Geologic Timescale model, which has been adapted from the model described in Cox, S.J.D, & Richard, S.M. (2005) A formal model for the geologic timescale and GSSP, compatible with geospatial information transfer standards, Geosphere, Geological Society of America 1/3, 119–137.";
                                                      <http://purl.org/dc/elements/1.1/rights> "Copyright © 2012-2017 CSIRO";
                                                      <http://purl.org/dc/elements/1.1/source> "Cox, S.J.D, & Richard, S.M. (2005) A formal model for the geologic timescale and GSSP, compatible with geospatial information transfer standards, Geosphere, Geological Society of America 1/3, 119–137.";
                                                      <http://purl.org/dc/elements/1.1/title> "Geologic Timescale model";
                                                      <http://purl.org/dc/terms/created> "2011-01-01"^^xsd:date;
                                                      <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
                                                      <http://purl.org/dc/terms/modified> "2017-04-28"^^xsd:date;
                                                      <http://purl.org/vocab/vann/preferredNamespacePrefix> "gts";
                                                      <http://purl.org/vocab/vann/preferredNamespaceUri> gts:;
                                                      a <http://www.w3.org/2002/07/owl#Ontology>,
                                                        <http://purl.org/vocommons/voaf#Vocabulary>;
                                                      rdfs:seeAlso <http://dx.doi.org/10.1130/GES00022.1>,
                                                                   <doi:10.1130/GES00022.1>,
                                                                   <http://geosphere.gsapubs.org/cgi/doi/10.1130/GES00022.1>,
                                                                   <http://www.geosciml.org/>;
                                                      <http://www.w3.org/2002/07/owl#imports> <http://resource.geosciml.org/ontology/timescale/thors>;
                                                      <http://www.w3.org/2002/07/owl#priorVersion> <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201402/Geoscience/GeologicTimeScale/gts.rdf>;
                                                      <http://www.w3.org/2002/07/owl#versionIRI> <https://github.com/GeoscienceAustralia/geosciml.org/commit/24d302bf3f0fa315c1dddc2c734b84f52299cd02#diff-73b17e22072459ab7e06e9ab664a9d48>;
                                                      <http://www.w3.org/2004/02/skos/core#changeNote> "2017-04-28 - removed imports ISO ontologies".
gts:Age a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:subClassOf gts:GeochronologicEra.
gts:Eon a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:subClassOf gts:GeochronologicEra.
gts:Epoch a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf gts:GeochronologicEra.
gts:Era a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:subClassOf gts:GeochronologicEra.
gts:EraCode a rdfs:Datatype;
            rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
            rdfs:label "Era code";
            <http://www.w3.org/2002/07/owl#equivalentClass> [a rdfs:Datatype ; 
                                                             <http://www.w3.org/2002/07/owl#onDataType> xsd:string ; 
                                                             <http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:pattern "a[12](.[1-9])*"])].
gts:GeochronologicBoundary a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                           rdfs:label "Geochronologic Boundary"@en;
                           rdfs:subClassOf <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary>,
                                           [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                            <http://www.w3.org/2002/07/owl#allValuesFrom> gts:StratigraphicPoint ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> gts:stratotype];
                           <http://www.w3.org/2002/07/owl#disjointWith> gts:NumericEraBoundary.
gts:GeochronologicEra a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                      rdfs:label "Geochronologic Era"@en;
                      rdfs:subClassOf <http://resource.geosciml.org/ontology/timescale/thors#Era>,
                                      [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> gts:StratigraphicSection ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> gts:stratotype],
                                      [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#notation> ; 
                                       <http://www.w3.org/2002/07/owl#someValuesFrom> gts:EraCode].
gts:GeochronologicEraRank a rdfs:Class;
                          rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                          rdfs:label "Geochronologic Era Rank"@en;
                          rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
gts:GeologicTimescale a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                      rdfs:label "Geologic Timescale"@en;
                      rdfs:subClassOf <http://resource.geosciml.org/ontology/timescale/thors#ReferenceSystem>,
                                      [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> gts:GeochronologicEra ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://resource.geosciml.org/ontology/timescale/thors#component>],
                                      [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> [a <http://www.w3.org/2002/07/owl#Class> ; 
                                                                                      <http://www.w3.org/2002/07/owl#unionOf> (gts:GeochronologicBoundary
                                                                                                                               gts:NumericEraBoundary)] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://resource.geosciml.org/ontology/timescale/thors#referencePoint>].
gts:NumericEraBoundary a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                       rdfs:label "Numeric Era Boundary"@en;
                       rdfs:subClassOf <http://resource.geosciml.org/ontology/timescale/thors#EraBoundary>,
                                       [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> gts:status];
                       <http://www.w3.org/2002/07/owl#disjointWith> gts:GeochronologicBoundary.
gts:Period a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf gts:GeochronologicEra.
gts:StratigraphicEvent a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A subclass of Geologic Event (placeholder) ";
                       rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                       rdfs:label "Stratigraphic Event"@en.
gts:StratigraphicPoint a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                       rdfs:label "Stratigraphic Point"@en;
                       rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> gts:correlationEvent],
                                       [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> gts:status],
                                       [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                        <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> gts:ratifiedGSSP].
gts:StratigraphicSection a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                         rdfs:label "Stratigraphic Section"@en;
                         rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> gts:geologicDescription],
                                         [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                          <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> gts:geologicSetting].
gts:Sub-Period a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf gts:GeochronologicEra.
gts:Super-Eon a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf gts:GeochronologicEra.
gts:boundary a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "geochronologic boundary corresponding with this point";
             rdfs:domain gts:StratigraphicPoint;
             rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
             rdfs:label "geochronologic boundary";
             rdfs:range gts:GeochronologicBoundary.
gts:boundaryLevel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "the level within the section of the point characterizing the boundary";
                  rdfs:domain gts:StratigraphicPoint;
                  rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                  rdfs:label "boundary level".
gts:correlatesWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "This property points from a geologic feature or event to a geochronologic element";
                   rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                   rdfs:label "correlating boundary or era";
                   rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                               <http://www.w3.org/2002/07/owl#unionOf> (gts:GeochronologicBoundary
                                                                        gts:GeochronologicEra)].
gts:correlationEvent a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "the stratigraphic event that is intended to be represented by this stratigraphic point";
                     rdfs:domain gts:StratigraphicPoint;
                     rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                     rdfs:label "correlation event".
gts:era a <http://www.w3.org/2002/07/owl#ObjectProperty>;
        rdfs:comment "geochronologic era corresponding with this section";
        rdfs:domain gts:StratigraphicSection;
        rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
        rdfs:label "geochronologic era";
        rdfs:range gts:GeochronologicEra.
gts:event a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "stratigraphic event corresponding with this boundary or point";
          rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                       <http://www.w3.org/2002/07/owl#unionOf> (gts:GeochronologicBoundary
                                                                gts:StratigraphicPoint)];
          rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
          rdfs:label "stratigraphic event";
          rdfs:range gts:StratigraphicEvent.
gts:geologicDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain gts:StratigraphicSection;
                        rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                        rdfs:label "geologic description".
gts:geologicSetting a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain gts:StratigraphicSection;
                    rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                    rdfs:label "geologic setting".
gts:manifestedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This property points from a geochronologic element to a geologic feature";
                 rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                              <http://www.w3.org/2002/07/owl#unionOf> (gts:GeochronologicBoundary
                                                                       gts:GeochronologicEra)];
                 rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
                 rdfs:label "geologic manifestation";
                 <http://www.w3.org/2002/07/owl#inverseOf> gts:correlatesWith.
gts:positionalUncertainty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:label "Uncertainty in time position".
gts:rank a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:comment """Elements of all ranks are included in the class 'gts:GeochronologicEra'. 
The rank may be indicated by membership of a sub-class, or is indicated using the 'gts:rank' property.""";
         rdfs:domain gts:GeochronologicEra;
         rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
         rdfs:label "Geochronologic era rank";
         rdfs:range gts:GeochronologicEraRank.
gts:ratifiedGSSP a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "'true' if ratified by ICS";
                 rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                              <http://www.w3.org/2002/07/owl#unionOf> (gts:StratigraphicPoint
                                                                       gts:GeochronologicBoundary
                                                                       gts:NumericEraBoundary)];
                 rdfs:label "ratified";
                 rdfs:range xsd:boolean.
gts:status a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "formal ICS status of this boundary and point";
           rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                        <http://www.w3.org/2002/07/owl#unionOf> (gts:NumericEraBoundary
                                                                 gts:StratigraphicPoint)];
           rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
           rdfs:label "status".
gts:stratotype a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "the characteristic point or section corresponding with a geochronologic concept";
               rdfs:domain [a <http://www.w3.org/2002/07/owl#Class> ; 
                            <http://www.w3.org/2002/07/owl#unionOf> (gts:GeochronologicBoundary
                                                                     gts:GeochronologicEra)];
               rdfs:isDefinedBy <http://resource.geosciml.org/ontology/timescale/gts>;
               rdfs:label "stratotype";
               rdfs:range [a <http://www.w3.org/2002/07/owl#Class> ; 
                           <http://www.w3.org/2002/07/owl#unionOf> (gts:StratigraphicPoint
                                                                    gts:StratigraphicSection)].
