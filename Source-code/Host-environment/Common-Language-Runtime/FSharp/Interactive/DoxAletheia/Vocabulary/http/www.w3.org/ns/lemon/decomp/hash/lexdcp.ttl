@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix lexdcp: <http://www.w3.org/ns/lemon/decomp#>.
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#>.
@prefix synsem: <http://www.w3.org/ns/lemon/synsem#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

status:term_status a owl:AnnotationProperty.
<http://www.w3.org/ns/lemon/decomp> ccrel:license <https://creativecommons.org/publicdomain/zero/1.0/>;
                                    dc11:contributor <http://www.oeg-upm.net/index.php/teachers/53-lupe>,
                                                     <http://www.paulbuitelaar.net/>,
                                                     <http://www.istc.cnr.it/people/aldo-gangemi>,
                                                     <http://art.uniroma2.it/stellato/>,
                                                     <https://sites.google.com/site/francescafrontini/>,
                                                     <http://jogracia.url.ph/web/>,
                                                     <http://www.ilc.cnr.it/en/content/anas-fahad-khan>,
                                                     <http://art.uniroma2.it/fiorelli/>,
                                                     <http://www.dfki.de/~declerck/>,
                                                     <http://mayor2.dia.fi.upm.es/oeg-upm/index.php/en/teachers/52-emontiel>;
                                    dc11:creator <http://www.cimiano.de/>,
                                                 <http://john.mccr.ae/>;
                                    dc11:description "A model for the representation of lexical information relative to ontologies. Decomposition module."@en;
                                    dc11:issued "2016-01-10"^^xsd:date;
                                    dc11:modified "2016-01-10"^^xsd:date;
                                    dc11:publisher <http://www.w3.org/community/ontolex>;
                                    dc11:rights "CC-Zero";
                                    dc11:title "Lexicon Model for Ontologies - Decomp"@en;
                                    vann:preferredNamespacePrefix "decomp";
                                    vann:preferredNamespaceUri "http://www.w3.org/ns/lemon/decomp#";
                                    a voaf:Vocabulary,
                                      owl:Ontology;
                                    rdfs:comment """-Version 1.0: depreciation with minor change in metadata for LOV publication
-Version 1.1: creation"""@en;
                                    owl:imports <http://www.w3.org/ns/lemon/ontolex>;
                                    owl:versionInfo 1.1.
lexdcp:Component a owl:Class;
                 rdfs:comment "A component is a particular realization of a lexical entry that forms part of a compound lexical entry."@en,
                              "Компонент является конкретной реализацией лексического элемента, который образует часть составной лексической записи."@ru;
                 rdfs:isDefinedBy <http://www.w3.org/ns/lemon/decomp>;
                 rdfs:label "компонент"@ru,
                            "composant"@fr,
                            "component"@ro,
                            "component"@en,
                            "bestanddeel"@nl,
                            "komponent"@sv,
                            "komponent"@af,
                            "Komponente"@de,
                            "componente"@pt,
                            "componente"@es,
                            "componente"@it;
                 status:term_status "stable".
lexdcp:constituent a owl:ObjectProperty;
                   rdfs:comment "Свойство 'составной' связывает словарную единицу или компонент с компонентом, который он образует."@ru,
                                "The property 'constituent' relates a lexical entry or component to a component that it is constituted by."@en;
                   rdfs:domain [owl:unionOf (lexdcp:Component
                                             ontolex:LexicalEntry) ; 
                                a owl:Class];
                   rdfs:isDefinedBy <http://www.w3.org/ns/lemon/decomp>;
                   rdfs:label "constituent"@nl,
                              "constituent"@fr,
                              "constituent"@en,
                              "constituent"@ro,
                              "costituente"@it,
                              "Konstituente"@de,
                              "составной"@ru,
                              "konstituent"@sv,
                              "konstituent"@af,
                              "constituinte"@pt,
                              "constituyente"@es;
                   rdfs:range lexdcp:Component;
                   rdfs:subPropertyOf owl:topObjectProperty;
                   status:term_status "stable".
lexdcp:correspondsTo a owl:ObjectProperty;
                     rdfs:comment "The property 'correspondsTo' links a component to a corresponding lexical entry or argument."@en,
                                  "Свойство 'соответствие' связывает компонент с соответствующей словарной единицей или аргументом."@ru;
                     rdfs:domain lexdcp:Component;
                     rdfs:isDefinedBy <http://www.w3.org/ns/lemon/decomp>;
                     rdfs:label "соответствие"@ru,
                                "corresponds to"@en,
                                "correspond à"@fr,
                                "corrisponde a"@it,
                                "komt overeen met"@nl,
                                "corresponde a"@es,
                                "entspricht"@de;
                     rdfs:range [owl:unionOf (ontolex:LexicalEntry
                                              synsem:SyntacticArgument) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf owl:topObjectProperty;
                     status:term_status "stable".
lexdcp:subterm a owl:ObjectProperty;
               rdfs:comment "The property 'subterm' relates a compound lexical entry to one of the lexical entries it is composed of."@en,
                            "Свойство 'подчинение' связывает составную словарную единицу с одной из словарных единиц, из которых она состоит."@en;
               rdfs:domain ontolex:LexicalEntry;
               rdfs:isDefinedBy <http://www.w3.org/ns/lemon/decomp>;
               rdfs:label "sotto-termine"@it,
                          "subtermo"@pt,
                          "Teilterm"@de,
                          "subterm"@nl,
                          "sous-terme"@fr,
                          "subterm"@af,
                          "subtermen"@ro,
                          "подчинение"@ru,
                          "underterm"@sv,
                          "sub-término"@es;
               rdfs:range ontolex:LexicalEntry;
               rdfs:subPropertyOf owl:topObjectProperty;
               status:term_status "stable".
synsem:SyntacticArgument a owl:Class.
