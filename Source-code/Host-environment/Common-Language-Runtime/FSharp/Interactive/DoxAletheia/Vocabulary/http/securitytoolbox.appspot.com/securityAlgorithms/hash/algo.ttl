@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix algo: <http://securitytoolbox.appspot.com/securityAlgorithms#>.

algo: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
      <http://purl.org/dc/elements/1.1/contributor> <mailto:gyrard@eurecom.fr>;
      <http://purl.org/dc/elements/1.1/description> "An ontology to describe various cryptographic algorithms"@en;
      <http://purl.org/dc/elements/1.1/title> "Security Algorithms"@en;
      <http://purl.org/dc/terms/creator> <mailto:luo@itd.nrl.navy.mil>,
                                         <mailto:kim@itd.nrl.navy.mil>,
                                         <mailto:mkang@itd.nrl.navy.mil>;
      <http://purl.org/dc/terms/issued> "2005-08-31"^^xsd:date;
      <http://purl.org/dc/terms/modified> "2014-01-24"^^xsd:date;
      <http://purl.org/dc/terms/source> <http://www.dtic.mil/cgi-bin/GetTRDoc?AD=ADA437938>;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "algo";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://securitytoolbox.appspot.com/securityAlgorithms#";
      a <http://purl.org/vocommons/voaf#Vocabulary>,
        <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment " An ontology to describe various cryptographic algorithms";
      <http://www.w3.org/2002/07/owl#versionInfo> 0.2;
      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Finished";
      <http://www.w3.org/2004/02/skos/core#historyNote> "Ontology extracted from the paper Security Ontology for Annotating Resources. [Kim et al. 2005] (See APPENDIX D. OWL Representations of the NRL Security Ontology) Security ontology to faciliate web service description and discovery."@en.
algo:AES algo:hasNSALevel <http://securitytoolbox.appspot.com/securityAssurance.owl#Type3>;
         a algo:SymmetricAlgorithm.
algo:Algorithm a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> algo:isNISTStandard ; 
                                <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
algo:AsymmetricAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:subClassOf algo:EncryptionAlgorithm.
algo:Blowfish a algo:SymmetricAlgorithm.
algo:CAST a algo:SymmetricAlgorithm.
algo:CBC-MAC a algo:MACAlgorithm.
algo:CRAYON algo:hasNSALevel <http://securitytoolbox.appspot.com/securityAssurance.owl#Typel>;
            a algo:SymmetricAlgorithm.
algo:CRC-16 a algo:ChecksumAlgorithm.
algo:CRC-32 a algo:ChecksumAlgorithm.
algo:CRC-8 a algo:ChecksumAlgorithm.
algo:ChecksumAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf algo:Algorithm.
algo:DES algo:hasNSALevel <http://securitytoolbox.appspot.com/securityAssurance.owl#Type3>;
         algo:keyLength "64"^^xsd:int;
         a algo:SymmetricAlgorithm;
         rdfs:comment "Refers only to single DES".
algo:DiffieHellman a algo:KeyExchangeAlgorithm.
algo:ECC a algo:AsymmetricAlgorithm;
         rdfs:comment "Elliptic Curve Crypto".
algo:EncryptionAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:subClassOf algo:Algorithm.
algo:HMAC a algo:MACAlgorithm.
algo:HashAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """
Key dependent function; useful in providing user authentication without a
secret key
""";
                   rdfs:subClassOf algo:SignatureAlgorithm.
algo:KEA a algo:KeyExchangeAlgorithm.
algo:KeyExchangeAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:subClassOf algo:Algorithm.
algo:MACAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf algo:SignatureAlgorithm.
algo:MD4 a algo:HashAlgorithm.
algo:MD5 a algo:HashAlgorithm.
algo:Oakley a algo:KeyExchangeAlgorithm.
algo:RC4 a algo:SymmetricAlgorithm.
algo:RIPE-MD a algo:HashAlgorithm.
algo:RSA a algo:AsymmetricAlgorithm.
algo:SHA-1 a algo:HashAlgorithm.
algo:SHA-256 a algo:HashAlgorithm;
             rdfs:comment "usually used with AES".
algo:SignatureAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:subClassOf algo:Algorithm.
algo:Skipjack algo:hasNSALevel <http://securitytoolbox.appspot.com/securityAssurance.owl#Type2>;
              a algo:SymmetricAlgorithm.
algo:SymmetricAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://securitytoolbox.appspot.com/hasNSALevel> ; 
                                         <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        algo:EncryptionAlgorithm.
algo:TripleDES a algo:SymmetricAlgorithm.
algo:hasNSALevel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "These can be Typel, Type 2, Type3, or Type4";
                 rdfs:domain algo:SynmmetricAlgorithm;
                 rdfs:range <http://securitytoolbox.appspot.com/securityAssurance.owl#NSA>.
algo:isNISTStandard a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "NIST FIPS Standard";
                    rdfs:domain algo:Algorithm;
                    rdfs:range xsd:boolean.
algo:keyLength a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain algo:SymmetricAlgorithm;
               rdfs:range xsd:nonNegativeInteger.
algo:modeOfOperation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Can be CBC, ECB, OFB, CFB, or Counter";
                     rdfs:domain algo:SymmetricAlgorithm;
                     rdfs:range xsd:string.
<http://securitytoolbox.appspot.com/securityAssurance.owl#Type3> a algo:hasNSALevel.
<mailto:gyrard@eurecom.fr> a <http://xmlns.com/foaf/0.1/Person>;
                           <http://xmlns.com/foaf/0.1/name> "Amelie Gyrard".
<mailto:kim@itd.nrl.navy.mil> a <http://xmlns.com/foaf/0.1/Person>;
                              <http://xmlns.com/foaf/0.1/name> "Anya Kim".
<mailto:luo@itd.nrl.navy.mil> a <http://xmlns.com/foaf/0.1/Person>;
                              <http://xmlns.com/foaf/0.1/name> "Jim Luo".
<mailto:mkang@itd.nrl.navy.mil> a <http://xmlns.com/foaf/0.1/Person>;
                                <http://xmlns.com/foaf/0.1/name> "Myong Kang".
