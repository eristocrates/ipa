@base <https://www.w3.org/ns/shacl-shacl.ttl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shsh: <http://www.w3.org/ns/shacl-shacl#>.

shsh: rdfs:comment "This shapes graph can be used to validate SHACL shapes graphs against a subset of the syntax rules."@en;
      rdfs:label "SHACL for SHACL"@en;
      sh:declare [sh:prefix "shsh" ; 
                  sh:namespace "http://www.w3.org/ns/shacl-shacl#"].
shsh:EntailmentShape a sh:NodeShape;
                     sh:nodeKind sh:IRI;
                     sh:targetObjectsOf sh:entailment.
shsh:ListNodeShape a sh:NodeShape;
                   rdfs:comment "Defines constraints on what it means for a node to be a node within a well-formed RDF list. Note that this does not check whether the rdf:rest items are also well-formed lists as this would lead to unsupported recursion."@en;
                   rdfs:label "List node shape"@en;
                   sh:or ([sh:hasValue rdf:nil ; 
                          sh:property [sh:path rdf:first ; 
                                       sh:maxCount 0 ] ; 
                          sh:property [sh:path rdf:rest ; 
                                       sh:maxCount 0 ]]
                          [sh:not [sh:hasValue rdf:nil] ; 
                          sh:property [sh:path rdf:first ; 
                                       sh:maxCount 1  ; 
                                       sh:minCount 1 ] ; 
                          sh:property [sh:path rdf:rest ; 
                                       sh:maxCount 1  ; 
                                       sh:minCount 1 ]]).
shsh:ListShape a sh:NodeShape;
               rdfs:comment "A shape describing well-formed RDF lists. Currently does not check for non-recursion. This could be expressed using SHACL-SPARQL."@en;
               rdfs:label "List shape"@en;
               rdfs:seeAlso <https://www.w3.org/TR/shacl/#syntax-rule-SHACL-list>;
               sh:property [sh:path [sh:zeroOrMorePath rdf:rest] ; 
                            rdfs:comment "Each list member (including this node) must be have the shape shsh:ListNodeShape."@en ; 
                            sh:hasValue rdf:nil ; 
                            sh:node shsh:ListNodeShape].
shsh:NodeShapeShape a sh:NodeShape;
                    sh:property [sh:path sh:path ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:lessThan ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:lessThanOrEquals ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:maxCount ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:minCount ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:qualifiedValueShape ; 
                                 sh:maxCount 0 ],
                                [sh:path sh:uniqueLang ; 
                                 sh:maxCount 0 ];
                    sh:targetObjectsOf sh:node.
shsh:PathListWithAtLeast2Members a sh:NodeShape;
                                 sh:node shsh:ListShape;
                                 sh:property [sh:path [sh:oneOrMorePath rdf:rest] ; 
                                              sh:minCount 2 ].
shsh:PathNodeShape sh:xone ([sh:nodeKind sh:IRI]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:node shsh:PathListWithAtLeast2Members]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:closed true ; 
                            sh:property [sh:path sh:alternativePath ; 
                                         sh:node shsh:PathListWithAtLeast2Members ; 
                                         sh:minCount 1  ; 
                                         sh:maxCount 1 ]]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:closed true ; 
                            sh:property [sh:path sh:inversePath ; 
                                         sh:minCount 1  ; 
                                         sh:maxCount 1 ]]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:closed true ; 
                            sh:property [sh:path sh:zeroOrMorePath ; 
                                         sh:minCount 1  ; 
                                         sh:maxCount 1 ]]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:closed true ; 
                            sh:property [sh:path sh:oneOrMorePath ; 
                                         sh:minCount 1  ; 
                                         sh:maxCount 1 ]]
                            [sh:nodeKind sh:BlankNode ; 
                            sh:closed true ; 
                            sh:property [sh:path sh:zeroOrOnePath ; 
                                         sh:minCount 1  ; 
                                         sh:maxCount 1 ]]).
shsh:PathShape a sh:NodeShape;
               rdfs:comment "A shape that can be used to validate the syntax rules of well-formed SHACL paths."@en;
               rdfs:label "Path shape"@en;
               rdfs:seeAlso <https://www.w3.org/TR/shacl/#property-paths>;
               sh:property [sh:path [sh:zeroOrMorePath [sh:alternativePath (([sh:zeroOrMorePath rdf:rest]
                                                                            rdf:first)
                                                                            (sh:alternativePath
                                                                            [sh:zeroOrMorePath rdf:rest]
                                                                            rdf:first)
                                                                            sh:inversePath
                                                                            sh:zeroOrMorePath
                                                                            sh:oneOrMorePath
                                                                            sh:zeroOrOnePath)]] ; 
                            sh:node shsh:PathNodeShape].
shsh:PropertyShapeShape a sh:NodeShape;
                        sh:property [sh:path sh:path ; 
                                     sh:maxCount 1  ; 
                                     sh:minCount 1  ; 
                                     sh:node shsh:PathShape];
                        sh:targetObjectsOf sh:property.
shsh:ShapeShape a sh:NodeShape;
                rdfs:comment "A shape that can be used to validate syntax rules for other shapes."@en;
                rdfs:label "Shape shape"@en;
                sh:or ([sh:not [sh:class rdfs:Class ; 
                               sh:or ([sh:class sh:NodeShape]
                                      [sh:class sh:PropertyShape])]]
                       [sh:nodeKind sh:IRI]);
                sh:property [sh:path sh:targetNode ; 
                             sh:nodeKind sh:IRIOrLiteral],
                            [sh:path sh:targetClass ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:targetSubjectsOf ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:targetObjectsOf ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:severity ; 
                             sh:maxCount 1  ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:message ; 
                             sh:or ([sh:datatype xsd:string]
                                    [sh:datatype rdf:langString])],
                            [sh:path sh:deactivated ; 
                             sh:maxCount 1  ; 
                             sh:in (true
                                    false)],
                            [sh:path sh:and ; 
                             sh:node shsh:ListShape],
                            [sh:path sh:class ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:closed ; 
                             sh:datatype xsd:boolean ; 
                             sh:maxCount 1 ],
                            [sh:path sh:ignoredProperties ; 
                             sh:node shsh:ListShape ; 
                             sh:maxCount 1 ],
                            [sh:path (sh:ignoredProperties
                                      [sh:zeroOrMorePath rdf:rest]
                                      rdf:first) ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:datatype ; 
                             sh:nodeKind sh:IRI ; 
                             sh:maxCount 1 ],
                            [sh:path sh:disjoint ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:equals ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:in ; 
                             sh:maxCount 1  ; 
                             sh:node shsh:ListShape],
                            [sh:path sh:languageIn ; 
                             sh:maxCount 1  ; 
                             sh:node shsh:ListShape],
                            [sh:path (sh:languageIn
                                      [sh:zeroOrMorePath rdf:rest]
                                      rdf:first) ; 
                             sh:datatype xsd:string],
                            [sh:path sh:lessThan ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:lessThanOrEquals ; 
                             sh:nodeKind sh:IRI],
                            [sh:path sh:maxCount ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:maxExclusive ; 
                             sh:maxCount 1  ; 
                             sh:nodeKind sh:Literal],
                            [sh:path sh:maxInclusive ; 
                             sh:maxCount 1  ; 
                             sh:nodeKind sh:Literal],
                            [sh:path sh:maxLength ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:minCount ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:minExclusive ; 
                             sh:maxCount 1  ; 
                             sh:nodeKind sh:Literal],
                            [sh:path sh:minInclusive ; 
                             sh:maxCount 1  ; 
                             sh:nodeKind sh:Literal],
                            [sh:path sh:minLength ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:nodeKind ; 
                             sh:in (sh:BlankNode
                                    sh:IRI
                                    sh:Literal
                                    sh:BlankNodeOrIRI
                                    sh:BlankNodeOrLiteral
                                    sh:IRIOrLiteral) ; 
                             sh:maxCount 1 ],
                            [sh:path sh:or ; 
                             sh:node shsh:ListShape],
                            [sh:path sh:pattern ; 
                             sh:datatype xsd:string ; 
                             sh:maxCount 1 ],
                            [sh:path sh:flags ; 
                             sh:datatype xsd:string ; 
                             sh:maxCount 1 ],
                            [sh:path sh:qualifiedMaxCount ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:qualifiedMinCount ; 
                             sh:datatype xsd:integer ; 
                             sh:maxCount 1 ],
                            [sh:path sh:qualifiedValueShape ; 
                             sh:maxCount 1 ],
                            [sh:path sh:qualifiedValueShapesDisjoint ; 
                             sh:datatype xsd:boolean ; 
                             sh:maxCount 1 ],
                            [sh:path sh:uniqueLang ; 
                             sh:datatype xsd:boolean ; 
                             sh:maxCount 1 ],
                            [sh:path sh:xone ; 
                             sh:node shsh:ListShape];
                sh:targetClass sh:NodeShape,
                               sh:PropertyShape;
                sh:targetObjectsOf sh:node,
                                   sh:not,
                                   sh:property,
                                   sh:qualifiedValueShape;
                sh:targetSubjectsOf sh:targetClass,
                                    sh:targetNode,
                                    sh:targetObjectsOf,
                                    sh:targetSubjectsOf,
                                    sh:and,
                                    sh:class,
                                    sh:closed,
                                    sh:datatype,
                                    sh:disjoint,
                                    sh:equals,
                                    sh:flags,
                                    sh:hasValue,
                                    sh:ignoredProperties,
                                    sh:in,
                                    sh:languageIn,
                                    sh:lessThan,
                                    sh:lessThanOrEquals,
                                    sh:maxCount,
                                    sh:maxExclusive,
                                    sh:maxInclusive,
                                    sh:maxLength,
                                    sh:minCount,
                                    sh:minExclusive,
                                    sh:minInclusive,
                                    sh:minLength,
                                    sh:node,
                                    sh:nodeKind,
                                    sh:not,
                                    sh:or,
                                    sh:pattern,
                                    sh:property,
                                    sh:qualifiedMaxCount,
                                    sh:qualifiedMinCount,
                                    sh:qualifiedValueShape,
                                    sh:qualifiedValueShapesDisjoint,
                                    sh:sparql,
                                    sh:uniqueLang,
                                    sh:xone;
                sh:xone (shsh:NodeShapeShape
                         shsh:PropertyShapeShape).
shsh:ShapesGraphShape a sh:NodeShape;
                      sh:nodeKind sh:IRI;
                      sh:targetObjectsOf sh:shapesGraph.
shsh:ShapesListShape a sh:NodeShape;
                     sh:property [sh:path ([sh:zeroOrMorePath rdf:rest]
                                           rdf:first) ; 
                                  sh:node shsh:ShapeShape];
                     sh:targetObjectsOf sh:and,
                                        sh:or,
                                        sh:xone.
