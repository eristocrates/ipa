@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vrank: <http://purl.org/voc/vrank#>.

vrank:Algorithm a rdfs:Class,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A ranking algorithm used to compute the ranking scores associated with an item (vrank:Rank).";
                rdfs:label "algorithm".
vrank:Feature a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A feature of a vrank:Algorithm such as Granularity, RankingFactor, etc.";
              rdfs:label "feature".
vrank:Parameter a rdfs:Class,
                  <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A parameter of a vrank:Algorithm such as number of iterations or damping factor.";
                rdfs:label "parameter".
vrank:Rank a rdfs:Class,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Represents a ranking score associated with an item.";
           rdfs:label "rank".
vrank:computedBy a rdf:Property;
                 rdfs:comment "A vrank:Rank is computed by an vrank:Algorithm.";
                 rdfs:domain vrank:Rank;
                 rdfs:label "computed by";
                 rdfs:range vrank:Algorithm.
vrank:featureId a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "The id associated to a vrank:Feature.";
                rdfs:domain vrank:Feature;
                rdfs:label "feature id";
                rdfs:range xsd:string.
vrank:featureValue a rdf:Property,
                     <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "The value associated to a vrank:Feature.";
                   rdfs:domain vrank:Feature;
                   rdfs:label "feature value";
                   rdfs:range xsd:string.
vrank:hasFeature a rdf:Property;
                 rdfs:comment "TODO.";
                 rdfs:domain vrank:Algorithm;
                 rdfs:label "has feature";
                 rdfs:range vrank:Feature.
vrank:hasName a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "A vrank:Algorithm has a name.";
              rdfs:domain vrank:Algorithm;
              rdfs:label "has name";
              rdfs:range xsd:string.
vrank:hasParameter a rdf:Property;
                   rdfs:comment "TODO.";
                   rdfs:domain vrank:Algorithm;
                   rdfs:label "has parameter";
                   rdfs:range vrank:Parameter.
vrank:hasRank a rdf:Property;
              rdfs:comment "A subject, property or object hasRank a vrank:Rank.";
              rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
              rdfs:label "has rank";
              rdfs:range vrank:Rank.
vrank:hasRankTimeStamp a rdf:Property,
                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                       rdfs:comment "The time when a vrank:Rank was computed.";
                       rdfs:domain vrank:Rank;
                       rdfs:label "has rank timestamp";
                       rdfs:range xsd:datetime.
vrank:paramId a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "The id associated to a vrank:Parameter.";
              rdfs:domain vrank:Parameter;
              rdfs:label "parameter id";
              rdfs:range xsd:string.
vrank:paramValue a rdf:Property,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment "The value associated to a vrank:Parameter.";
                 rdfs:domain vrank:Parameter;
                 rdfs:label "parameter value";
                 rdfs:range xsd:string.
vrank:rankValue a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "The numerical value associated to a vrank:Rank.";
                rdfs:domain vrank:Rank;
                rdfs:label "has rank value";
                rdfs:range xsd:float.
<http://vocab.sti2.at/vrank> <http://purl.org/dc/elements/1.1/creator> <http://vocab.sti2.at/vrank#andtha>,
                                                                       <http://vocab.sti2.at/vrank#aroa>,
                                                                       <http://vocab.sti2.at/vrank#itoma>;
                             <http://purl.org/dc/terms/created> "2012-06-05"^^xsd:date;
                             <http://purl.org/dc/terms/description> "The Vocabulary for Ranking (vRank) is an RDF Schema vocabulary for materializing ranking computations.";
                             <http://purl.org/dc/terms/modified> "2012-06-05"^^xsd:date;
                             <http://purl.org/dc/terms/partOf> <http://vocab.sti2.at/>;
                             <http://purl.org/dc/terms/publisher> "http://vocab.sti2.at/vrank#STI%20Innsbruck";
                             <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                             <http://purl.org/dc/terms/title> "Vocabulary for Ranking (vRank)";
                             <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                             <http://purl.org/vocab/vann/preferredNamespacePrefix> "vrank";
                             <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/voc/vrank#";
                             a <http://www.w3.org/2002/07/owl#Ontology>;
                             <http://xmlns.com/foaf/0.1/homepage> <http://vocab.sti2.at/vrank.html>.
<http://vocab.sti2.at/vrank#STI%20Innsbruck> a <http://purl.org/dc/terms/Agent>;
                                             <http://xmlns.com/foaf/0.1/homepage> <http://vocab.sti2.at/vrank>;
                                             <http://xmlns.com/foaf/0.1/member> <http://vocab.sti2.at/vrank#andtha>,
                                                                                <http://vocab.sti2.at/vrank#aroa>,
                                                                                <http://vocab.sti2.at/vrank#itoma>;
                                             <http://xmlns.com/foaf/0.1/name> "STI Innsbruck".
<http://vocab.sti2.at/vrank#andtha> a <http://xmlns.com/foaf/0.1/Person>;
                                    <http://xmlns.com/foaf/0.1/homepage> <http://vocab.sti2.at/vrank>;
                                    <http://xmlns.com/foaf/0.1/name> "Andreas Thalhammer".
<http://vocab.sti2.at/vrank#aroa> a <http://xmlns.com/foaf/0.1/Person>;
                                  <http://xmlns.com/foaf/0.1/homepage> <http://vocab.sti2.at/vrank>;
                                  <http://xmlns.com/foaf/0.1/name> "Antonio J. Roa-Valverde".
<http://vocab.sti2.at/vrank#itoma> a <http://xmlns.com/foaf/0.1/Person>;
                                   <http://xmlns.com/foaf/0.1/homepage> <http://vocab.sti2.at/vrank>;
                                   <http://xmlns.com/foaf/0.1/name> "Ioan Toma".
<http://vocab.sti2.at/vrank#rdf> <http://purl.org/dc/terms/FileFormat> <http://vocab.sti2.at/vrank>.
