marcrole:abr madsrdf:authoritativeLabel "Abridger"@en;
             madsrdf:code "abr";
             a madsrdf:Topic,
               skos:Concept,
               madsrdf:Authority,
               rdf:Property,
               owl:ObjectProperty;
             rdfs:label "Abridger"@en;
             rdfs:subPropertyOf marcrole:role;
             skos:notation "abr";
             skos:prefLabel "Abridger"@en.
