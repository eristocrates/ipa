spfood:hasGeographicalProvenance a owl:ObjectProperty;
                                 rdfs:domain [owl:unionOf (spfood:FoodOrDrinkItem
                                                           spfood:Recipe) ; 
                                              a owl:Class];
                                 rdfs:range <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#PhysicalGeographicEntity>.
spfood:hasGuest a owl:ObjectProperty;
                rdfs:domain spfood:MealContext;
                rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Person>;
                rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#includesAgent>.
spfood:hasHealthProfile a owl:ObjectProperty;
                        rdfs:subPropertyOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/user.owl#hasProfile>.
spfood:hasIngredient a owl:ObjectProperty;
                     rdfs:domain [owl:unionOf (spfood:FoodOrDrinkItem
                                               spfood:Recipe) ; 
                                  a owl:Class];
                     rdfs:range spfood:IngredientPortion;
                     rdfs:subPropertyOf <http://kmi.open.ac.uk/projects/smartproducts/ontologies/generic.owl#hasSubComponent>.
spfood:hasMealCourse a owl:ObjectProperty;
                     rdfs:domain spfood:MealStructure;
                     rdfs:range spfood:MealCourseRole;
                     rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#definesRole>.
spfood:hasMealStructure a owl:ObjectProperty;
                        rdfs:domain spfood:MealContext;
                        rdfs:range spfood:MealStructure;
                        rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#satisfies>.
spfood:hasNutrient a owl:ObjectProperty;
                   rdfs:domain spfood:FoodOrDrinkItem;
                   rdfs:range spfood:NutrientPortion;
                   rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#hasPart>.
spfood:hasScore a owl:DatatypeProperty;
                rdfs:domain spfood:DietAssessment;
                rdfs:range xsd:double.
spfood:impliesPreference a owl:ObjectProperty;
                         rdfs:domain spfood:HealthProfile;
                         rdfs:range <http://kmi.open.ac.uk/projects/smartproducts/ontologies/user.owl#Preference>.
spfood:numberOfGuests a owl:DatatypeProperty;
                      rdfs:range xsd:int.
spfood:producedByRecipe a owl:ObjectProperty;
                        rdfs:domain spfood:FoodOrDrinkItem;
                        rdfs:range spfood:Recipe;
                        owl:inverseOf spfood:producesFoodItem.
spfood:producesFoodItem a owl:ObjectProperty;
                        rdfs:domain spfood:Recipe;
                        rdfs:range spfood:FoodOrDrinkItem.
spfood:suitableForDiet a owl:ObjectProperty;
                       rdfs:domain spfood:FoodOrDrinkItem;
                       rdfs:range spfood:DietAssessment;
                       rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#hasQuality>.
spfood:suitableForMealCourse a owl:ObjectProperty;
                             rdfs:domain spfood:FoodOrDrinkItem;
                             rdfs:range spfood:MealCourseType.
