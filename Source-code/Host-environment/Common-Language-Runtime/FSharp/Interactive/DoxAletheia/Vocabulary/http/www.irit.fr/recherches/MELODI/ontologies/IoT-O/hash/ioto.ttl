@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix obws: <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#>.
@prefix dogont: <http://elite.polito.it/ontologies/dogont.owl#>.
@prefix msm: <http://iserve.kmi.open.ac.uk/ns/msm#>.
@prefix muo: <http://purl.oclc.org/NET/muo/muo#>.
@prefix ssnx: <http://purl.oclc.org/NET/ssnx/ssn#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix ioto: <http://www.irit.fr/recherches/MELODI/ontologies/IoT-O#>.
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix lifecycle: <http://purl.org/vocab/lifecycle/schema#>.
@prefix san: <http://www.irit.fr/recherches/MELODI/ontologies/SAN#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix wsl: <http://www.wsmo.org/ns/wsmo-lite#>.

obws:State owl:equivalentClass lifecycle:State.
dogont:BuildingEnvironment rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalPlace>.
dogont:BuildingThing rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalObject>.
dogont:Command rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#InformationEntity>.
dogont:ContinuousValue rdfs:label "Continuous value".
dogont:DiscreteValue rdfs:label "Discrete value".
dogont:Functionality rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Abstract>.
dogont:NetworkSpecificStateValue rdfs:label "Network specific state value".
dogont:Notification rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#InformationEntity>.
dogont:State rdfs:subClassOf lifecycle:State.
dogont:StateValue rdfs:label "State value";
                  rdfs:subClassOf lifecycle:State.
dogont:hasState rdfs:label "has state".
dogont:hasStateValue rdfs:label "has state value".
<http://elite.polito.it/ontologies/poweront.owl#PowerConsumption> rdfs:label "Power consumption";
                                                                  rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute>.
<http://elite.polito.it/ontologies/poweront.owl#PowerConsumptionValue> rdfs:label "Power consumption value".
<http://elite.polito.it/ontologies/poweront.owl#consumptionOf> rdfs:label "consumption of".
<http://elite.polito.it/ontologies/poweront.owl#consumptionValue> rdfs:label "Consumption value".
<http://elite.polito.it/ontologies/poweront.owl#hasConsumption> rdfs:label "has consumption".
<http://elite.polito.it/ontologies/poweront.owl#whenIn> rdfs:label "when in".
msm:MessagePart rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Object>.
msm:Operation rdfs:comment "An operation is a function provided by a service. It implements a functionnality, and can be accessed by an end user by any mean offered by the service.";
              rdfs:subClassOf [owl:someValuesFrom <http://www.wsmo.org/ns/hrests#URITemplate> ; 
                               owl:onProperty <http://www.wsmo.org/ns/hrests#hasAddress> ; 
                               a owl:Restriction],
                              [owl:someValuesFrom msm:MessageContent ; 
                               owl:onProperty msm:hasOutput ; 
                               a owl:Restriction],
                              [owl:someValuesFrom msm:MessageContent ; 
                               owl:onProperty msm:hasInput ; 
                               a owl:Restriction],
                              wsl:Operation.
msm:Service rdfs:comment "A service is a set of operation, and provides a user a way to issu requests  through an interface. Underlying implementation needn't to be known by the end user.";
            rdfs:subClassOf [owl:someValuesFrom msm:Operation ; 
                             owl:onProperty msm:hasOperation ; 
                             a owl:Restriction],
                            wsl:Service.
muo:PhysicalQuality rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#PhysicalAttribute>.
ssnx:Device rdfs:subClassOf ioto:IoT_Thing.
ssnx:MeasurementCapability rdfs:subClassOf [owl:someValuesFrom <http://qudt.org/schema/qudt#QuantityKind> ; 
                                            owl:onProperty ssnx:forProperty ; 
                                            a owl:Restriction].
ssnx:MeasurementProperty rdfs:subClassOf [owl:someValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#Amount> ; 
                                          owl:onProperty ssnx:hasValue ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom <http://qudt.org/schema/qudt#Unit> ; 
                                          owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isParametrizedBy> ; 
                                          a owl:Restriction].
ssnx:ObservationValue rdfs:subClassOf [owl:someValuesFrom xsd:integer ; 
                                       owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue> ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom <http://qudt.org/schema/qudt#Unit> ; 
                                       owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#isParametrizedBy> ; 
                                       a owl:Restriction].
ssnx:OperatingProperty rdfs:subClassOf [owl:someValuesFrom xsd:integer ; 
                                        owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue> ; 
                                        a owl:Restriction].
lifecycle:State rdfs:subClassOf [owl:someValuesFrom dogont:StateValue ; 
                                 owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasParticipant> ; 
                                 a owl:Restriction].
<http://qudt.org/schema/qudt#QuantityKind> a owl:Class.
<http://qudt.org/schema/qudt#Unit> a owl:Class.
<http://www.irit.fr/recherches/MELODI/ontologies/IoT-O> ccrel:license <http://creativecommons.org/licenses/by/4.0/>;
                                                        dc11:creator "Nicolas Seydoux, Mahdi Ben Alaya, Khalil Drira, Nathalie Hernandez, Thierry Monteil";
                                                        dc11:description """IoT-O is a core domain Internet of Things ontology. It is intended to model horizontal knowledge about IoT systems and applications, and to be extended with vertical, application specific knowledge.
It is constituted of different modules : 
 - A sensing module, based on W3C's SSN (http://purl.oclc.org/NET/ssnx/ssn)
 - An acting module, based on SAN (http://www.irit.fr/recherches/MELODI/ontologies/SAN)
 - A service module, based on MSM (http://iserve.kmi.open.ac.uk/ns/msm/msm-2014-09-03.rdf) and hRest (http://www.wsmo.org/ns/hrests)
 - A lifecycle module, based on a lifecycle vocabulary (http://vocab.org/lifecycle/schema-20080603.rdf) and an iot-specific extension (http://www.irit.fr/recherches/MELODI/ontologies/IoT-Lifecycle)
 - An energy module, based on powerOnt (ttp://elite.polito.it/ontologies/poweront.owl)

IoT-O developping team also contributes to the oneM2M IoT interoperability standard.""";
                                                        dc11:publisher "LAAS-CNRS (https://www.laas.fr)",
                                                                       "IRIT (https://www.irit.fr/)";
                                                        dc11:title "IoT-O";
                                                        dcterms:issued "2015-02-20";
                                                        dcterms:modified "2016-02-26";
                                                        vann:preferredNamespacePrefix "iot-o";
                                                        vann:preferredNamespaceURI "http://www.irit.fr/recherches/MELODI/ontologies/IoT-O";
                                                        voaf:extends <http://purl.oclc.org/NET/ssnx/ssn>,
                                                                     <http://elite.polito.it/ontologies/poweront.owl>,
                                                                     <http://iserve.kmi.open.ac.uk/ns/msm/msm-2014-09-03.rdf>,
                                                                     <http://www.irit.fr/recherches/MELODI/ontologies/IoT-Lifecycle>,
                                                                     <http://www.irit.fr/recherches/MELODI/ontologies/SAN>;
                                                        a owl:Ontology,
                                                          voaf:Vocabulary;
                                                        owl:imports <http://iserve.kmi.open.ac.uk/ns/msm/msm-2014-09-03.rdf>,
                                                                    <http://elite.polito.it/ontologies/poweront.owl>,
                                                                    <http://www.irit.fr/recherches/MELODI/ontologies/IoT-Lifecycle>,
                                                                    <http://www.irit.fr/recherches/MELODI/ontologies/SAN>,
                                                                    <http://purl.oclc.org/NET/ssnx/ssn>;
                                                        owl:versionInfo "2.0";
                                                        foaf:primaryTopic "IoT".
ioto:BusinessOperation a owl:Class;
                       rdfs:comment "Service operation that is relevant to the business function of the service (and the object underneath in the case of IoT). This type of functions may be linked to a property the object deals with (monitoring or modification)";
                       rdfs:label "Business operation";
                       rdfs:subClassOf msm:Operation.
ioto:BusinessService a owl:Class;
                     rdfs:comment "Service intended to be an interface for the functionnalities the object was designed to perform : measure temperature for a temperature sensor, switch on/off for a switch...";
                     rdfs:label "Business service";
                     rdfs:subClassOf [owl:someValuesFrom ssnx:Property ; 
                                      owl:onProperty ioto:hasRelationshipWithProperty ; 
                                      a owl:Restriction],
                                     msm:Service.
ioto:ControlledSystem a owl:Class;
                      rdfs:comment "System implementing a control feedback loop in order to control an actuator thanks to the feedback of some sensors.";
                      rdfs:label "Controlled system";
                      rdfs:subClassOf [owl:someValuesFrom ssnx:Sensor ; 
                                       owl:onProperty ioto:getsFeedbackFrom ; 
                                       a owl:Restriction],
                                      ssnx:System.
ioto:DefectuousSystem a owl:Class;
                      rdfs:comment "Controlled system that requires an operator attention, because it is not functionnig properly. Detected when the difference between the Observations and the Actuation made on the monitored property is out of its operating range.";
                      rdfs:label "Defectuous System";
                      rdfs:subClassOf ioto:ControlledSystem.
ioto:DeviceManagementOperation a owl:Class;
                               rdfs:comment "Service operation that deals with device management";
                               rdfs:label "Device management operation";
                               rdfs:subClassOf msm:Operation.
ioto:DeviceManagementService a owl:Class;
                             rdfs:comment "This kind of service offers a set of operations regarding device management. That means it's not related to the functionnality of the object itsefl, but rather to its inner working : battery state, connectivity, firmware update...";
                             rdfs:label "Device management service";
                             rdfs:subClassOf msm:Service.
ioto:EmptyMessage a owl:NamedIndividual,
                    wsl:Message;
                  rdfs:comment """Specific message that has no content, its sole transfer achieves its purpose. For example, if an empty message is sent to the \"switch light on\" service of a light bulb, there is no need for an explicit content of the message asking the light to be turned on.""";
                  rdfs:label "Empty message".
ioto:ImpactOnProperty a owl:Class;
                      rdfs:comment "This class describes the impact an operation may have on a property. It makes sense in an IoT environement, where things can manage properties of their environment and modify them.";
                      rdfs:label "Impact on property";
                      rdfs:subClassOf wsl:Effect.
ioto:IoT_Thing a owl:Class;
               rdfs:comment "Most general thing in an iot ontology, a Thing can either be a physical connected object, an application, an abstracted interface... The class Object of DUL, from whom it inherits, doen't only represent physical objects, and can cover a fonction for instance.";
               rdfs:label "IoT-Thing",
                          "Thing";
               rdfs:subClassOf [owl:someValuesFrom msm:Service ; 
                                owl:onProperty ioto:hasService ; 
                                a owl:Restriction],
                               <http://www.loa-cnr.it/ontologies/DUL.owl#Object>.
ioto:Manager a owl:Class;
             rdfs:comment "A manager is an application that offers management capabilities as described in the OneM2M norm.";
             rdfs:label "Manager";
             rdfs:subClassOf ioto:IoT_Thing.
ioto:SimpleDataContent a owl:NamedIndividual,
                         msm:MessageContent;
                       rdfs:comment "This individual represents the body of a request containing simple data, such as a numerical value.";
                       rdfs:label "Simple data content".
ioto:getsFeedbackFrom a owl:ObjectProperty;
                      rdfs:comment "Relation between a controlled system and the entities that provide it with a feedback about its action, usually sensors.";
                      rdfs:domain ioto:ControlledSystem;
                      rdfs:label "gets feedback from";
                      rdfs:range ssnx:System;
                      owl:inverseOf ioto:providesFeedbackTo.
ioto:hasFeatureOfInterest a owl:ObjectProperty;
                          rdfs:comment "Relationship between a Thing and a property of the environment. In a cyber-physical system, devices and software agents may have one to many feature of interest from the environment. This feature can be a property, another device, a person...";
                          rdfs:domain ioto:IoT_Thing;
                          rdfs:label "has feature of interest";
                          rdfs:range ssnx:FeatureOfInterest.
ioto:hasId a owl:DatatypeProperty;
           rdfs:comment "Characterizes a unique identifier for a thing";
           rdfs:domain ioto:IoT_Thing;
           rdfs:label "has id";
           rdfs:range xsd:string.
ioto:hasImpact a owl:ObjectProperty;
               rdfs:comment "Relationship between an operation and its impact on a property";
               rdfs:domain msm:Operation;
               rdfs:label "has impact";
               rdfs:range ioto:ImpactOnProperty;
               owl:inverseOf ioto:isImpactOf.
ioto:hasImpactonProperty a owl:ObjectProperty;
                         rdfs:comment "Relationship between an impact and the impacted property";
                         rdfs:domain ioto:ImpactOnProperty;
                         rdfs:label "on property";
                         rdfs:range ssnx:Property;
                         owl:inverseOf ioto:propertyIsImpactedBy.
ioto:hasRelationshipWithProperty a owl:ObjectProperty;
                                 rdfs:comment "Generic property that marks the relationship between some entity and some ssn:Property. Dependant on context, it can be sensing, acting or else. Useful to descrie a generic service offered by a complex system that aggregates both sensors and actuators.";
                                 rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity>;
                                 rdfs:label "has relationship with property";
                                 rdfs:range ssnx:Property.
ioto:hasService a owl:ObjectProperty;
                rdfs:comment "Relationship between an Entity and a service that is accessible through it.";
                rdfs:domain <http://www.loa-cnr.it/ontologies/DUL.owl#Entity>;
                rdfs:label "has service";
                rdfs:range wsl:Service.
ioto:hasTimeStamp a owl:DatatypeProperty;
                  rdfs:comment "Associates an Instant individual with a timestamp";
                  rdfs:domain time:Instant;
                  rdfs:range xsd:dateTimeStamp.
ioto:isFeatureOfInterestOf a owl:ObjectProperty;
                           rdfs:comment "Indicates that the property is the feature of interest of some entity of an IoT system, that can measure it/act upon it.";
                           rdfs:domain ssnx:FeatureOfInterest;
                           rdfs:label "is feature of interest for";
                           rdfs:range ioto:IoT_Thing;
                           owl:inverseOf ioto:hasFeatureOfInterest.
ioto:isImpactOf a owl:ObjectProperty;
                rdfs:label "is impact of".
ioto:isInputMessageOf a owl:ObjectProperty;
                      rdfs:label "is input message of".
ioto:isServiceOf a owl:ObjectProperty;
                 rdfs:comment "Relationship between a service and an entity that accesses it.";
                 rdfs:domain wsl:Service;
                 rdfs:label "is service of";
                 rdfs:range <http://www.loa-cnr.it/ontologies/DUL.owl#Entity>;
                 owl:inverseOf ioto:hasService.
ioto:propertyIsImpactedBy a owl:ObjectProperty;
                          rdfs:label "property impacted by".
ioto:providesFeedbackTo a owl:ObjectProperty;
                        rdfs:comment "Relationship between an entity that provides informations to a system and this system, that interprets these informations as a feedback of its action.";
                        rdfs:domain ssnx:System;
                        rdfs:label "provides feedback to";
                        rdfs:range ioto:ControlledSystem.
san:ActuationValue rdfs:subClassOf [owl:someValuesFrom lifecycle:Transition ; 
                                    owl:onProperty <http://www.irit.fr/recherches/MELODI/ontologies/IoT-Lifecycle#triggersTransition> ; 
                                    a owl:Restriction].
san:impactsState a owl:ObjectProperty;
                 rdfs:range lifecycle:State.
vaem:dateUnion a owl:Class;
               rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#TimeInterval>.
<http://www.loa-cnr.it/ontologies/DUL.owl#hasDataValue> a owl:DatatypeProperty.
<http://www.loa-cnr.it/ontologies/DUL.owl#isParametrizedBy> a owl:AnnotationProperty,
                                                              owl:ObjectProperty.
time:Instant a owl:Class.
<http://www.wsmo.org/ns/hrests#URITemplate> a rdfs:Datatype,
                                              owl:Class;
                                            rdfs:comment "Template providing information about the construction of the URI providing access to the service";
                                            rdfs:label "URI Template";
                                            rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#InformationEntity>.
<http://www.wsmo.org/ns/hrests#hasAddress> a owl:ObjectProperty,
                                             owl:DatatypeProperty;
                                           rdfs:comment "Associates a ressource to a URI in compliance with REST principles";
                                           rdfs:domain wsl:Operation;
                                           rdfs:label "has address";
                                           rdfs:range <http://www.wsmo.org/ns/hrests#URITemplate>.
<http://www.wsmo.org/ns/hrests#hasMethod> a owl:ObjectProperty,
                                            owl:DatatypeProperty;
                                          rdfs:domain wsl:Operation;
                                          rdfs:label "has method";
                                          rdfs:range xsd:string.
wsl:Condition rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Event>.
wsl:Effect rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#Event>.
wsl:Message a owl:Class;
            rdfs:comment "A Message is a instance of data that is sent by a source and that is received by a target";
            rdfs:label "Message";
            rdfs:subClassOf [owl:someValuesFrom msm:MessagePart ; 
                             owl:onProperty <http://www.loa-cnr.it/ontologies/DUL.owl#hasPart> ; 
                             a owl:Restriction],
                            <http://www.loa-cnr.it/ontologies/DUL.owl#Object>.
wsl:Operation a owl:Class;
              rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#FormalEntity>.
wsl:Service a owl:Class;
            rdfs:comment "A Service is the abstract representation of a set of data and requests processing functionnalities, generally linked by common traits (domain, service provider...)";
            rdfs:label "Service";
            rdfs:subClassOf <http://www.loa-cnr.it/ontologies/DUL.owl#FormalEntity>.
wsl:hasInputMessage a owl:ObjectProperty;
                    rdfs:comment "Relationship between an Operation that requires some Message as its input";
                    rdfs:domain wsl:Operation;
                    rdfs:label "has input message";
                    rdfs:range wsl:Message;
                    owl:inverseOf ioto:isInputMessageOf.
wsl:hasOperation a owl:ObjectProperty;
                 rdfs:domain wsl:Service;
                 rdfs:label "has operation";
                 rdfs:range wsl:Operation.
wsl:hasOutputMessage a owl:ObjectProperty;
                     rdfs:comment "Relashionship between an Operation and the Message that it will output as the result of its processing";
                     rdfs:domain wsl:Operation;
                     rdfs:label "has output message";
                     rdfs:range wsl:Message.
