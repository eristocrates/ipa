                                                                           <http://www.w3.org/2003/11/swrl#argument1> pattern:x ; 
                                                                           a <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom>]
                                                                           [<http://www.w3.org/2003/11/swrl#propertyPredicate> pattern:hasName ; 
                                                                           <http://www.w3.org/2003/11/swrl#argument2> pattern:s ; 
                                                                           <http://www.w3.org/2003/11/swrl#argument1> pattern:y ; 
                                                                           a <http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom>]);
                                    <http://www.w3.org/2003/11/swrl#head> ().
