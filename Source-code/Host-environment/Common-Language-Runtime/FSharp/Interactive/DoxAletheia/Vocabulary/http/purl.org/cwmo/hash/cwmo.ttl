@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cwmo: <http://purl.org/cwmo/#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix schemas: <https://schema.org/>.

cwmo: dc11:contributor "Alex Gabriel"@en,
                       "Mauricio Camargo"@en,
                       "Davy Monticolo"@en,
                       "Mario Bourgault"@en;
      dc11:creator "Alex Gabriel"@en;
      dc11:description "Creative Workshop Management Ontology (CWMO) - an ontology designed to describe the creative workshop domain, to permit reasoning on creative method and to describe resources gathered inside Creative Support System. The primary goal of the ontology is to cover all knowledge about creative workshop and creative method necessary for Creative support system. The second goal is to provide interoperability between distributed Creative Support System."@en;
      dc11:modified "16/02/2017";
      dc11:publisher "Alex Gabriel"@en;
      dc11:rights "This ontology is distributed under a Creative Commons Attribution License - http://creativecommons.org/licenses/by/3.0 <br/> If your reuse it for an academic purpose, please quote this article: Gabriel, A., Monticolo, D., Camargo, M., Bourgault, M., 2016. Ontology to represent the knowledge domain of a creative workshop. Presented at the The 12th International Conference on Signal Image Technology & Internet Systems, Naples, Italy."@en;
      dc11:title "Creative Workshop Management Ontology (CWMO)"@en;
      <http://purl.org/vocab/vannpreferredNamespacePrefix> "cwmo";
      <http://purl.org/vocab/vannpreferredNamespaceUri> "http://purl.org/cwmo/#";
      a owl:Ontology;
      rdfs:label "Creative Workshop Management Ontology"^^rdfs:Literal;
      owl:priorVersion 0.41;
      owl:versionInfo 0.42.
cwmo:ABTesting cwmo:hasCreativePhase cwmo:ImplementAndMonitoring;
               cwmo:hasFunction cwmo:Evaluation;
               cwmo:hasInputType cwmo:Behavioral;
               cwmo:isProducingData cwmo:QuantitativeData;
               cwmo:isRelatedTo cwmo:Experiment,
                                cwmo:KeyPerfIndicator,
                                cwmo:WebAnalytics;
               dcterms:description "Comparing two version of a same solution in order to see which one produce the statistically best results according to a defined objective."@en;
               dcterms:title "A/B Testing"@en;
               a cwmo:CreativeTechnique,
                 owl:NamedIndividual.
cwmo:AM a owl:NamedIndividual,
          cwmo:ContextType;
        rdfs:label "Advertising/ Management"@en.
cwmo:Activity a owl:Class;
              rdfs:comment "The activity class gather the different activities realised during a creative workshop"@en;
              rdfs:label "Activity"@en.
cwmo:Advice a owl:Class;
            rdfs:comment "The advice is provided by the expert to a creative team and can concern an idea or a technique."@en;
            rdfs:label "Advice"@en.
cwmo:AffinityDiagramming cwmo:hasCreativePhase cwmo:EvalAndRafinement,
                                               cwmo:ImplementAndMonitoring,
                                               cwmo:Synthesis,
                                               cwmo:Ideation;
                         cwmo:hasFunction cwmo:Generation;
                         cwmo:hasInputType cwmo:Attitudinal,
                                           cwmo:Behavioral;
                         cwmo:isProducingData cwmo:QualitativeData;
                         cwmo:isRelatedTo cwmo:UsabilityTesting,
                                          cwmo:ContextualDesign,
                                          cwmo:KJTechnique;
                         cwmo:requireEquipment cwmo:PostIt;
                         dcterms:title "Diagramme d'affinités"@fr,
                                       "Affinity Diagramming"@en;
                         a owl:NamedIndividual,
                           cwmo:CreativeTechnique.
cwmo:ApplicationMode a owl:Class;
                     rdfs:comment "The application mode class defined the different mode of application of a creative technique"@en;
                     rdfs:label "Application Mode"@en.
cwmo:Artifact a owl:Class;
              rdfs:comment "The artefact class is a visual or physical representation of an idea."@en;
              rdfs:label "Artifact"@en.
cwmo:BendItShapeIt cwmo:appliedInContextType cwmo:NPD,
                                             cwmo:PSI;
                   cwmo:difficulty "Low"^^rdfs:Literal;
                   cwmo:duration 30 ;
                   cwmo:energy "Low"^^rdfs:Literal;
                   cwmo:funFactor "Low"^^rdfs:Literal;
                   cwmo:hasApplicationMode cwmo:IndividualMode,
                                           cwmo:CollectiveMode;
                   cwmo:ideaQuantity "Medium"^^rdfs:Literal;
                   cwmo:novelty "Medium"^^rdfs:Literal;
                   cwmo:requireStimuliType cwmo:Related,
                                           cwmo:Unrelated;
                   dcterms:title "Bend It, Shape It"@en;
                   a cwmo:CreativeTechnique,
                     owl:NamedIndividual;
                   rdfs:label "Bend It, Shape It"@en.
cwmo:Bodystorming cwmo:hasCreativePhase cwmo:Ideation;
                  cwmo:hasFunction cwmo:Generation;
                  cwmo:hasInputType cwmo:Behavioral;
                  cwmo:isProducingData cwmo:QualitativeData;
                  cwmo:isRelatedTo cwmo:Roleplaying,
                                   cwmo:ExperiencePrototyping,
                                   cwmo:SimulationExercise;
                  dcterms:description "This method is a mix role play, simulating exercise to inspire new idea and spontaneous prototyping based on empathy."@en;
                  dcterms:title "Bodystorming"@en;
                  a owl:NamedIndividual,
                    cwmo:CreativeTechnique.
cwmo:CollectiveMode a owl:NamedIndividual,
                      cwmo:ApplicationMode.
cwmo:Completeness a owl:NamedIndividual,
                    cwmo:EvaluationCriteria.
cwmo:Complexity a owl:NamedIndividual,
                  cwmo:EvaluationCriteria.
cwmo:ConceptGeneration a owl:NamedIndividual,
                         cwmo:CreativePhase;
                       rdfs:comment "the phase of concept generation and eraly prototyping is an itarative phase that involves participatory and generative design activities. Classification of the application of creative technic based on the Universal Method of Design (Martin et al., 2008)."@en;
                       rdfs:label "Concept generation and early prototyping"@en;
                       owl:sameAs cwmo:Ideation.
cwmo:Constraint a owl:Class;
                rdfs:comment "The constraint class is the textual description of the element that limit the subject. It is related to the strategy of the company, the constraint associated with the activity domain of the organizations, …"@en;
                rdfs:label "Constraint"@en.
cwmo:Context a owl:Class;
             rdfs:comment "organizational condition in wich the problem is defined (Stratégique, Nouveau produit, processus ou service, Améliorations produit, processus ou service, publicité/marketing, Ressources humaines)"@en;
             rdfs:label "Context"@en.
cwmo:ContextType a owl:Class;
                 rdfs:comment "The context type class gather the typology of creative workshop context"@en;
                 rdfs:label "Context Type"@en.
cwmo:CreativePhase a owl:Class;
                   rdfs:comment "The creative phase class is the decompastion of the creative process into steps/ phases which implies different nature of activities, goals and interaction."@en;
                   rdfs:label "Creative Phase"@en.
cwmo:CreativeStrategy a owl:Class;
                      rdfs:comment "The creative strategy is a selection of creative techniques defined by the a facilitator in order to respond to the subject"@en;
                      rdfs:label "Creative Strategy"@en.
cwmo:CreativeTeam a owl:Class;
                  rdfs:comment "The creative team class is a group of ideator who attempt to generated ideas to respond a problematic"@en;
                  rdfs:label "Creative Team"@en.
cwmo:CreativeTechnique a owl:Class;
                       rdfs:comment "The creativre technic class is the technic applied by the ideator to generated ideas"@en;
                       rdfs:label "Creative Technique"@en;
                       rdfs:subClassOf cwmo:Activity.
cwmo:CreativeWorkshop a owl:Class;
                      rdfs:comment "The CreativeWorkshop class  represent an event organized by an organizer to solve a problem formulated into a subject and provided by a decision-maker, and solved by a creative team."@en;
                      rdfs:label "CreativeWorkshop"@en;
                      rdfs:subClassOf schema:Event.
cwmo:DataType a owl:Class;
              rdfs:comment "Data type class define the form in which that content is typically collected and communicated."@en;
              rdfs:label "Data Type"@en.
cwmo:DecisionMaker a owl:Class;
                   rdfs:comment "Decision Maker is one of the role assumed by a person during the creative workshop. He provides the problem to solve during the workshop and has the decision ability concerning the future of the idea generated."@en;
                   rdfs:label "Decision Maker"@en.
cwmo:Definition a owl:NamedIndividual,
                  cwmo:CreativePhase;
                rdfs:comment "The defintion class is a phase of the creative process where project parameters are explored and defined. Classification of the application of creative technic based on the Universal Method of Design (Martin et al., 2008)."@en;
                rdfs:label "planning, scoping and definition"@en.
cwmo:DesignProcess a owl:NamedIndividual,
                     cwmo:ParticipantRole.
cwmo:DigitalTool a owl:Class;
                 rdfs:comment "The digital tools class gather the tools available for a digital application of creative techniques"@en;
                 rdfs:label "Digital Tools"@en;
                 rdfs:subClassOf cwmo:Tool.
cwmo:Effectivness a owl:NamedIndividual,
                    cwmo:EvaluationCriteria.
cwmo:Equipment a owl:Class;
               rdfs:comment "The material class represent the physical material/ equipment needed."@en;
               rdfs:label "Equipment"@en.
cwmo:EvalAndRafinement a owl:NamedIndividual,
                         cwmo:CreativePhase;
                       rdfs:comment "The evaluation and rafinement is an iterative phase of testing and feedback about a production. Classification of the application of creative technic based on the Universal Method of Design (Martin et al., 2008)."@en;
                       rdfs:label "Evaluation and Rafinement"@en;
                       owl:sameAs cwmo:IdeaEvaluation,
                                  cwmo:Implementation.
cwmo:Evaluation a owl:NamedIndividual,
                  cwmo:TechniqueFunction;
                rdfs:comment "The evluation class is a creative technic which has the purpose to evaluate/sort/contextualise the ideas."@en;
                rdfs:label "Evaluation"@en;
                rdfs:seeAlso cwmo:Exploration,
                             cwmo:Generation.
cwmo:EvaluationCriteria a owl:Class;
                        rdfs:comment "The Evaluation criteria class is the specific aspect to obsverve on idea. It is defined according to the constraints of the subject."@en;
                        rdfs:label "Evaluation Criteria"@en.
cwmo:EvaluationStrategy a owl:Class;
                        rdfs:comment "The evaluation strategy class gather the information concerning the evaluation technics, the criteria, and the evaluators affected to respond to the objectives of the creative workshop."@en;
                        rdfs:label "Evaluation Strategy"@en.
cwmo:EvaluationTechnic a owl:Class;
                       rdfs:comment "The evaluation technic class is the way the idea is evaluated. It can be qualitative (Review, sorting (top5),...) or quantitative (rating)."@en;
                       rdfs:label "Evaluation Technic"@en;
                       rdfs:subClassOf cwmo:Activity.
cwmo:Evaluator a owl:Class;
               rdfs:comment "Evaluator is one of the role assumed by a person during the creative workshop. He evaluate the ideas based on the evaluation strategy according to the evaluation techniques and the criteria associated."@en;
               rdfs:label "Evaluator"@en.
cwmo:Expert a owl:Class;
            rdfs:comment "Expert is one of the role assumed by a person during the creative workshop. He share his knowledge about the problem or the domain to helps the ideator or the evaluation."@en;
            rdfs:label "Expert"@en.
cwmo:Exploration a owl:NamedIndividual,
                   cwmo:TechniqueFunction;
                 rdfs:comment "The exploration class is a creativ technic which has the porpose to explore the problem, to redefine the scope or the focus of the problem, or to collect further information"@en;
                 rdfs:label "Exploration"@en;
                 rdfs:seeAlso cwmo:Evaluation,
                              cwmo:Generation.
cwmo:ExpressionMode a owl:Class;
                    rdfs:label "Expression Mode"@en,
                               "The expression mode class define the different mode of experssion exploited by a creative technique"@en.
cwmo:Expressivness a owl:NamedIndividual,
                     cwmo:EvaluationCriteria.
cwmo:Facilitator a owl:Class;
                 rdfs:comment "Facilitator is one of the role assumed by a person during the creative workshop. He is the person who assist the group of ideator in the application of the activities (creative technique and evaluation technique)"@en;
                 rdfs:label "Facilitator"@en.
cwmo:Feasibility cwmo:isCriterizedBy cwmo:Anon3;
                 cwmo:scale 5 ;
                 cwmo:weight 40 ;
                 a owl:NamedIndividual,
                   cwmo:EvaluationCriteria.
cwmo:FreeReview cwmo:applyEvaluationThanks cwmo:Complexity;
                cwmo:evalTechAppliedBy cwmo:Anon3;
                a owl:NamedIndividual,
                  cwmo:EvaluationTechnic.
cwmo:Generation a owl:NamedIndividual,
                  cwmo:TechniqueFunction;
                rdfs:comment "The Generation class is a creative technic which has the purpose to generate ideas."@en;
                rdfs:label "Generation"@en;
                rdfs:seeAlso cwmo:Evaluation,
                             cwmo:Exploration.
cwmo:GuidedReview a owl:NamedIndividual,
                    cwmo:EvaluationTechnic.
cwmo:Idea a owl:Class;
          rdfs:comment "The idea class is a beginning of response to the problem. An idea can be from a Creative technic"@en;
          rdfs:label "Idea"@en;
          rdfs:seeAlso skos:Concept.
cwmo:IdeaEvaluation a owl:NamedIndividual,
                      cwmo:CreativePhase;
                    rdfs:comment "The idea evaluation class is a phase of the creative process where the idea are evluated, sorted or ranked."@en;
                    rdfs:label "IdeaEvaluation"@en;
                    rdfs:seeAlso cwmo:Ideation,
                                 cwmo:Implementation,
                                 cwmo:ProblemAnalysis;
                    owl:sameAs cwmo:Implementation.
cwmo:Ideation a owl:NamedIndividual,
                cwmo:CreativePhase;
              rdfs:comment "The ideation class is a phase of the creative process where ideas to respond to the problematic are generated."@en;
              rdfs:label "Ideation"@en;
              rdfs:seeAlso cwmo:IdeaEvaluation,
                           cwmo:Implementation,
                           cwmo:ProblemAnalysis.
cwmo:Ideator a owl:Class;
             rdfs:comment "Ideator is one of the role assumed by a person during the creative workshop. He is the person who solve the problem and produce ideas by applying creative techniques"@en;
             rdfs:label "Ideator"@en;
             owl:disjointWith [owl:unionOf (cwmo:DecisionMaker
                                            cwmo:Organizer) ; 
                               a owl:Class].
cwmo:ImplementAndMonitoring a owl:NamedIndividual,
                              cwmo:CreativePhase;
                            rdfs:comment "The Implementation and monitoring class is a phase of the creative process where the readiness of the idea  is tested. Classification of the application of creative technic based on the Universal Method of Design (Martin et al., 2008)."@en;
                            rdfs:label "Lunch and Monitoring"@en.
cwmo:Implementability a owl:NamedIndividual,
                        cwmo:EvaluationCriteria.
cwmo:Implementation a owl:NamedIndividual,
                      cwmo:CreativePhase;
                    rdfs:comment "The implementation class is a phase of the creative process where the most interesting ideas are experimented in real condition."@en;
                    rdfs:label "Implementation"@en;
                    rdfs:seeAlso cwmo:IdeaEvaluation,
                                 cwmo:Ideation,
                                 cwmo:ProblemAnalysis.
cwmo:IndividualMode a owl:NamedIndividual,
                      cwmo:ApplicationMode.
cwmo:InputType a owl:Class;
               rdfs:comment "type of centent most appropriatly targeted by the method"@en;
               rdfs:label "Input Type"@en.
cwmo:KnowledgeDomain a owl:Class;
                     rdfs:comment "The Knowledge domain class is the overall knowledge that a person posses or which is associated to an idea or a problem"@en;
                     rdfs:label "Knowledge Domain"@en.
cwmo:MindMapping cwmo:hasCreativePhase cwmo:Synthesis;
                 cwmo:hasFunction cwmo:Exploration;
                 cwmo:hasInputType cwmo:Attitudinal;
                 cwmo:isProducingData cwmo:QualitativeData;
                 cwmo:isRelatedTo cwmo:ConceptMapping,
                                  cwmo:BrainstormGraphicOrganizers,
                                  cwmo:Collage;
                 cwmo:isSupportedBy cwmo:Coggle;
                 dcterms:description "Visually organize the different elements of a complex problem in order to better understand it."@en;
                 dcterms:title "Mind Mapping"@en;
                 a cwmo:CreativeTechnique,
                   owl:NamedIndividual.
cwmo:NPD a owl:NamedIndividual,
           cwmo:ContextType;
         rdfs:label "New Products/ Process/ Services"@en.
cwmo:Objective a owl:Class;
               rdfs:comment "The objective is a description of the result expected by the organizations concerning the creative workshop"@en;
               rdfs:label "Objective"@en.
cwmo:Organization a owl:Class;
                  rdfs:comment "An organization such as a company, SME, institutions, NGO, corporation,  etc."@en;
                  rdfs:label "Organization"@en.
cwmo:Organizer a owl:Class;
               rdfs:comment "Organizer is one of the role assumed by a person during the creative workshop. He is the person who manage the entre workshop by providing the materials, the infrastructure and communicate with the others persons."@en;
               rdfs:label "Organizer"@en.
cwmo:Originality cwmo:scale 4 ;
                 cwmo:weight 40 ;
                 dcterms:description "Originality is evaluated by considered both the interest of the idea and the novelty";
                 a owl:NamedIndividual,
                   cwmo:EvaluationCriteria.
cwmo:PSI a owl:NamedIndividual,
           cwmo:ContextType;
         rdfs:label "Product/ Process / Services Improvement"@en.
cwmo:ParticipantRole a owl:Class;
                     rdfs:comment "The particpant role class define the role of the person involved in a creative technique. (Martin et al., 2013). It should be distinguished from the role involved in the entire creative workshop process."@en;
                     rdfs:label "Participant Role"@en.
cwmo:Participatory a owl:NamedIndividual,
                     cwmo:ParticipantRole.
cwmo:Personas cwmo:hasCreativePhase cwmo:Ideation;
              cwmo:hasFunction cwmo:Generation;
              cwmo:hasInputType cwmo:Attitudinal,
                                cwmo:Behavioral;
              cwmo:isProducingData cwmo:QualitativeData;
              cwmo:isRelatedTo cwmo:UserJourneyMaps,
                               cwmo:Scenarios;
              dcterms:description "Personas is a consolidated descriptions of typical behaviors under the format of user profil. It permits to humanize the 'client' of the solution, to try scenarios, and ease the communication of the solution."@en;
              dcterms:title "Personas"@en;
              a cwmo:CreativeTechnique,
                owl:NamedIndividual.
cwmo:Problem a owl:Class;
             rdfs:comment "The problem class is the description of the elements that leads the organization to initiate a creative workshop."@en;
             rdfs:label "Problem"@en.
cwmo:ProblemAnalysis a owl:NamedIndividual,
                       cwmo:CreativePhase;
                     rdfs:comment "The problem analysis class is a phase of the creative process where the problem is formalized and the information seeked and organized."@en;
                     rdfs:label "Problem Analysis"@en;
                     rdfs:seeAlso cwmo:IdeaEvaluation,
                                  cwmo:Ideation,
                                  cwmo:Implementation.
cwmo:QualitativeData a owl:NamedIndividual,
                       cwmo:DataType.
cwmo:QuantitativeData a owl:NamedIndividual,
                        cwmo:DataType.
cwmo:Related a owl:NamedIndividual,
               cwmo:StimuliType.
cwmo:Relevance a owl:NamedIndividual,
                 cwmo:EvaluationCriteria.
cwmo:Stimuli a owl:Class;
             rdfs:comment "Stimuli is used to initiate a creative technique"@en;
             rdfs:label "Stimuli"@en.
cwmo:StimuliType a owl:Class;
                 rdfs:comment "Typology of stimuli"@en;
                 rdfs:label "Stimuli Type"@en.
cwmo:Strategy a owl:NamedIndividual,
                cwmo:ContextType.
cwmo:Subject a owl:Class;
             rdfs:comment "The subject class is the description of the problerm to solve by the creative group during the creative workshop. It is a transformation/reformulation of the problem."@en;
             rdfs:label "Subject"@en.
cwmo:Synthesis a owl:NamedIndividual,
                 cwmo:CreativePhase;
               rdfs:comment "Exploration, synthesis and design implications"@en,
                            "The synthesis class represent the phase of the creative process where further information a researched. Classification of the application of creative technic based on the Universal Method of Design (Martin et al., 2008)."@en;
               rdfs:seeAlso cwmo:Definition,
                            cwmo:EvalAndRafinement,
                            cwmo:ImplementAndMonitoring.
cwmo:TechniqueFunction a owl:Class;
                       rdfs:comment "Technique Function class define the primary purpose of a creative technique."@en;
                       rdfs:label "Technique Function"@en.
cwmo:Tool a owl:Class;
          rdfs:comment "The tool class is the software and interface used to ease the application of a creative technic and/or collect the data of the creative technic."@en;
          rdfs:label "Tool"@en.
cwmo:Unrelated a owl:NamedIndividual,
                 cwmo:StimuliType.
cwmo:Verbal a owl:NamedIndividual,
              cwmo:ExpressionMode.
cwmo:Workability a owl:NamedIndividual,
                   cwmo:EvaluationCriteria.
cwmo:Written a owl:NamedIndividual,
               cwmo:ExpressionMode.
cwmo:adviceAdressedTo a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:IrreflexiveProperty;
                      rdfs:domain cwmo:Advice;
                      rdfs:range cwmo:CreativeTeam.
cwmo:advicedBy a owl:ObjectProperty,
                 owl:AsymmetricProperty,
                 owl:IrreflexiveProperty;
               rdfs:domain cwmo:Advice;
               rdfs:range cwmo:Expert;
               owl:inverseOf cwmo:provideAdvice.
cwmo:appliedInContextType a owl:ObjectProperty,
                            owl:AsymmetricProperty,
                            owl:IrreflexiveProperty;
                          rdfs:domain cwmo:CreativeTechnique;
                          rdfs:range cwmo:ContextType.
cwmo:applyEvaluationThanks a owl:ObjectProperty,
                             owl:AsymmetricProperty,
                             owl:IrreflexiveProperty;
                           rdfs:comment "Evaluation technic apply evaluation criteria to do the evaluation."@en;
                           rdfs:domain cwmo:EvaluationTechnic;
                           rdfs:range cwmo:EvaluationCriteria;
                           owl:inverseOf cwmo:isEvaluatedDuring.
cwmo:coverDomain a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:domain [owl:unionOf (cwmo:Problem
                                           cwmo:Subject) ; 
                              a owl:Class];
                 rdfs:range cwmo:KnowledgeDomain;
                 owl:inverseOf cwmo:isCoveredBy.
cwmo:criteriaIsDefinedBy a owl:ObjectProperty,
                           owl:AsymmetricProperty;
                         rdfs:comment "Evaluation criteria is defined by the decision maker and/or the organizer."@en;
                         rdfs:domain cwmo:EvaluationCriteria;
                         rdfs:range [owl:unionOf (cwmo:DecisionMaker
                                                  cwmo:Organizer) ; 
                                     a owl:Class].
cwmo:difficulty a owl:DatatypeProperty;
                rdfs:comment "estimates how complicated is a technic to implement. Low, medium, high"@en;
                rdfs:domain cwmo:CreativeTechnique.
cwmo:duration a owl:DatatypeProperty;
              rdfs:comment "minimun amount of time required to apply a technic."@en;
              rdfs:domain cwmo:CreativeTechnique;
              rdfs:range xsd:integer.
cwmo:energy a owl:DatatypeProperty;
            rdfs:comment "how much energy must be invested to complete the technic."@en;
            rdfs:domain cwmo:CreativeTechnique.
cwmo:equipe a owl:ObjectProperty,
              owl:AsymmetricProperty,
              owl:IrreflexiveProperty;
            rdfs:domain cwmo:Equipment;
            rdfs:range cwmo:CreativeTechnique;
            owl:inverseOf cwmo:requireEquipment.
cwmo:evalStratPlannedBy a owl:ObjectProperty,
                          owl:AsymmetricProperty;
                        rdfs:domain cwmo:EvaluationStrategy;
                        rdfs:range [owl:unionOf (cwmo:DecisionMaker
                                                 cwmo:Organizer) ; 
                                    a owl:Class].
cwmo:evalTechAppliedBy a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:comment "Evaluation technic is applied by evaluator."@en,
                                    "restreindre la relation en fonction de la strategy: TechA evalTechappliedBy Anon for a given strategy";
                       rdfs:domain cwmo:EvaluationTechnic;
                       rdfs:range cwmo:Evaluator.
cwmo:evaluateResponseTo a owl:ObjectProperty,
                          owl:AsymmetricProperty,
                          owl:IrreflexiveProperty;
                        rdfs:comment "An evaluation strategy evaluate the ideas associated to a subject. The strategy is dependant of the differnt element that define the subject (context, decision-maker, ...)"@en;
                        rdfs:domain cwmo:EvaluationStrategy;
                        rdfs:range cwmo:Subject.
cwmo:funFactor a owl:DatatypeProperty;
               rdfs:comment "estimated likelihood that a technic will provoke mirth and humor. Low, medium, high."@en;
               rdfs:domain cwmo:CreativeTechnique.
cwmo:function a owl:DatatypeProperty;
              rdfs:comment "creative technqiue has different function: exploration of the subject/ domain of the problem, generation of idea, and evluation of idea"@en;
              rdfs:domain cwmo:CreativeTechnique;
              rdfs:range xsd:string.
cwmo:hasApplicationMode a owl:ObjectProperty,
                          owl:AsymmetricProperty,
                          owl:IrreflexiveProperty;
                        rdfs:domain cwmo:CreativeTechnique;
                        rdfs:range cwmo:ApplicationMode.
cwmo:hasAuthor a owl:ObjectProperty,
                 owl:AsymmetricProperty;
               rdfs:comment "An idea is written by an ideator."@en;
               rdfs:domain cwmo:Idea;
               rdfs:range cwmo:Ideator.
cwmo:hasCTSource a owl:ObjectProperty,
                   owl:AsymmetricProperty;
                 rdfs:comment "An idea has been produced during the application of a creative technic."@en;
                 rdfs:domain cwmo:Idea;
                 rdfs:range cwmo:CreativeTechnique.
cwmo:hasCWSource a owl:ObjectProperty,
                   owl:AsymmetricProperty;
                 rdfs:comment "An idea has been produced during the a creative workshop."@en;
                 rdfs:domain cwmo:Idea;
                 rdfs:range cwmo:CreativeWorkshop.
cwmo:hasContext a owl:ObjectProperty,
                  owl:AsymmetricProperty;
                rdfs:comment "A problem is defined according to a context."@en;
                rdfs:domain cwmo:Problem;
                rdfs:range cwmo:Context.
cwmo:hasContextType a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain cwmo:Context;
                    rdfs:range cwmo:ContextType.
cwmo:hasCreatTechnic a owl:ObjectProperty,
                       owl:AsymmetricProperty;
                     rdfs:comment "Creative Strategy is composed by one or several creative techniques"@en;
                     rdfs:domain cwmo:CreativeStrategy;
                     rdfs:range cwmo:CreativeTechnique.
cwmo:hasCreativePhase a owl:ObjectProperty,
                        owl:AsymmetricProperty;
                      rdfs:domain cwmo:CreativeTechnique;
                      rdfs:range cwmo:CreativePhase.
cwmo:hasEquivalent a owl:ObjectProperty,
                     owl:SymmetricProperty;
                   rdfs:domain cwmo:KnowledgeDomain;
                   rdfs:range cwmo:KnowledgeDomain.
cwmo:hasEvalStrat a owl:ObjectProperty,
                    owl:AsymmetricProperty;
                  rdfs:comment "Evaluation technic is part of an evaluation strategy."@en;
                  rdfs:domain cwmo:EvaluationTechnic;
                  rdfs:range cwmo:EvaluationStrategy;
                  owl:inverseOf cwmo:hasEvalTechnic.
cwmo:hasEvalTechnic a owl:ObjectProperty,
                      owl:AsymmetricProperty;
                    rdfs:comment "Evaluation strategy is composed by evaluation technic."@en;
                    rdfs:domain cwmo:EvaluationStrategy;
                    rdfs:range cwmo:EvaluationTechnic.
cwmo:hasExpressionMode a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:domain cwmo:CreativeTechnique;
                       rdfs:range cwmo:ExpressionMode.
cwmo:hasFunction a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "A creative method produce different results which can be classified according to these typology: exploration, generation, and/or evaluation."@en;
                 rdfs:domain cwmo:CreativeTechnique;
                 rdfs:range cwmo:TechniqueFunction.
cwmo:hasGeneralization a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:domain cwmo:KnowledgeDomain;
                       rdfs:range cwmo:KnowledgeDomain;
                       owl:inverseOf cwmo:hasSpecialization.
cwmo:hasGenerated a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:domain cwmo:CreativeTeam;
                  rdfs:range cwmo:Idea;
                  owl:inverseOf cwmo:hasGroupAuthor.
cwmo:hasGroupAuthor a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:comment "Idea is generated into and by a team."@en;
                    rdfs:domain cwmo:Idea;
                    rdfs:range cwmo:CreativeTeam.
cwmo:hasHypernym a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "Concept whose semantic field is broader than that of a hyponym."@en;
                 rdfs:domain skos:Concept;
                 rdfs:range skos:Concept;
                 owl:inverseOf cwmo:hasHyponym.
cwmo:hasHyponym a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:comment "Concept whose semantic field is more specific than its hypernym"@en;
                rdfs:domain skos:Concept;
                rdfs:range skos:Concept.
cwmo:hasIdeator a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:comment "A creative Team is composed by several ideator"@en;
                rdfs:domain cwmo:CreativeTeam;
                rdfs:range cwmo:Ideator;
                owl:equivalentProperty <http://xmlns.com/foaf/0.1/#member>.
cwmo:hasInput a owl:DatatypeProperty;
              rdfs:comment "A creative method requires some parametrs to be applied properly. these inputs can be a problematic, aditional information, ..."@en;
              rdfs:domain cwmo:CreativeTechnique.
cwmo:hasInputType a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:domain cwmo:CreativeTechnique;
                  rdfs:range cwmo:InputType.
cwmo:hasKnowledge a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:domain foaf:Person;
                  rdfs:range cwmo:KnowledgeDomain.
cwmo:hasNext a owl:ObjectProperty,
               owl:AsymmetricProperty,
               owl:IrreflexiveProperty;
             rdfs:comment "The creative technic can be follewed by another creative technic."@en;
             rdfs:domain cwmo:Activity;
             rdfs:range cwmo:Activity;
             owl:inverseOf cwmo:hasPrevious.
cwmo:hasOutput a owl:DatatypeProperty;
               rdfs:domain cwmo:CreativeTechnique.
cwmo:hasParticipant a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:comment "Creative workshop has participant with different role."@en;
                    rdfs:domain cwmo:CreativeWorkshop;
                    rdfs:range foaf:Person;
                    owl:inverseOf cwmo:isParticipatingTo.
cwmo:hasPlanified a owl:ObjectProperty,
                    owl:AsymmetricProperty;
                  rdfs:comment "Facilitator define the creative strategy"@en;
                  rdfs:domain cwmo:Facilitator;
                  rdfs:range cwmo:CreativeStrategy;
                  owl:inverseOf cwmo:isPlanifiedBy.
cwmo:hasPrevious a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "The creative technic can be preceed by another creative technic."@en;
                 rdfs:domain cwmo:Activity;
                 rdfs:range cwmo:Activity.
cwmo:hasRole a owl:ObjectProperty,
               owl:AsymmetricProperty,
               owl:IrreflexiveProperty;
             rdfs:domain foaf:Person;
             rdfs:range [owl:unionOf (cwmo:DecisionMaker
                                      cwmo:Evaluator
                                      cwmo:Expert
                                      cwmo:Facilitator
                                      cwmo:Ideator
                                      cwmo:Organizer) ; 
                         a owl:Class].
cwmo:hasSpecialization a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:domain cwmo:KnowledgeDomain;
                       rdfs:range cwmo:KnowledgeDomain.
cwmo:hasStimuliInput a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:domain cwmo:CreativeTechnique;
                     rdfs:range cwmo:Stimuli.
cwmo:hasStimuliType a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain cwmo:Stimuli;
                    rdfs:range cwmo:StimuliType.
cwmo:hasSynonym a owl:ObjectProperty,
                  owl:SymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:comment "Concept that means exactly or nearly the same as another concept."@en;
                rdfs:domain skos:Concept;
                rdfs:range skos:Concept.
cwmo:hasWeight a owl:DatatypeProperty;
               rdfs:domain cwmo:EvaluationCriteria;
               rdfs:range owl:real.
cwmo:ideaQuantity a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:comment "probability of a technic will result a relatively large quantity of ideas within the available time. Low, medium, high probability"@en;
                  rdfs:domain cwmo:CreativeTechnique.
cwmo:identifier a owl:DatatypeProperty;
                rdfs:domain [owl:unionOf (cwmo:CreativeStrategy
                                          cwmo:CreativeTeam
                                          cwmo:CreativeWorkshop
                                          cwmo:EvaluationStrategy) ; 
                             a owl:Class].
cwmo:innovationRange a owl:DatatypeProperty;
                     rdfs:domain cwmo:Objective.
cwmo:innovationScope a owl:DatatypeProperty;
                     rdfs:domain cwmo:Objective.
cwmo:isAppliedInContext a owl:ObjectProperty,
                          owl:AsymmetricProperty;
                        rdfs:comment "A creative technic is applied in certain context."@en;
                        rdfs:domain cwmo:CreativeTechnique;
                        rdfs:range cwmo:Context.
cwmo:isConstraintedBy a owl:ObjectProperty,
                        owl:AsymmetricProperty;
                      rdfs:comment "Properety indicating that a problem is constrainted by constraint of different nature ( the problem itself, the domain, the context, the actor of the domain…)"@en;
                      rdfs:domain cwmo:Problem;
                      rdfs:range cwmo:Constraint.
cwmo:isCoveredBy a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:domain cwmo:KnowledgeDomain;
                 rdfs:range [owl:unionOf (cwmo:Problem
                                          cwmo:Subject) ; 
                             a owl:Class].
cwmo:isCriterizedBy a owl:ObjectProperty,
                      owl:AsymmetricProperty;
                    rdfs:comment "Evaluation criteria is defined by the decision maker and/or the organizer."@en;
                    rdfs:domain cwmo:EvaluationCriteria;
                    rdfs:range [owl:unionOf (cwmo:DecisionMaker
                                             cwmo:Organizer) ; 
                                a owl:Class].
cwmo:isEvaluatedDuring a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:comment "Evaluation criteria is applied during an evaluation technic."@en;
                       rdfs:domain cwmo:EvaluationCriteria;
                       rdfs:range cwmo:EvaluationTechnic.
cwmo:isEvaluating a owl:ObjectProperty,
                    owl:AsymmetricProperty;
                  rdfs:comment "Evaluation technic evaluate idea."@en;
                  rdfs:domain cwmo:EvaluationTechnic;
                  rdfs:range cwmo:Idea.
cwmo:isFollowedBy a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:comment "in theory, the creative technic can be follewed by another creative technic. it means the 2 creative technic are by default related by a temporal relation."@en;
                  rdfs:domain cwmo:CreativeTechnique;
                  rdfs:range cwmo:CreativeTechnique.
cwmo:isFormalizedFrom a owl:ObjectProperty,
                        owl:AsymmetricProperty;
                      rdfs:comment "A subject is formalized from a problem."@en;
                      rdfs:domain cwmo:Subject;
                      rdfs:range cwmo:Problem;
                      owl:inverseOf cwmo:isFormalizedInto.
cwmo:isFormalizedInto a owl:ObjectProperty,
                        owl:AsymmetricProperty;
                      rdfs:comment "A problem is formalized into a subject in order to be adapted for a creative workshop."@en;
                      rdfs:domain cwmo:Problem;
                      rdfs:range cwmo:Subject.
cwmo:isFormalizing a owl:ObjectProperty,
                     owl:AsymmetricProperty;
                   rdfs:comment "The decision maker define the problem that will be solved during the creative workshop."@en;
                   rdfs:domain cwmo:DecisionMaker;
                   rdfs:range cwmo:Problem.
cwmo:isGeneralizedBy a owl:ObjectProperty,
                       owl:AsymmetricProperty;
                     rdfs:comment "Properety indicating that an idea is generalized by a concept."@en;
                     rdfs:domain cwmo:Idea;
                     rdfs:range skos:Concept;
                     owl:inverseOf cwmo:isGeneralizing.
cwmo:isGeneralizing a owl:ObjectProperty,
                      owl:AsymmetricProperty;
                    rdfs:comment "Property indicating that a concept generalize an idea. Althought ideas are different, several can represent the same concept."@en;
                    rdfs:domain skos:Concept;
                    rdfs:range cwmo:Idea.
cwmo:isIncompatibleWith a owl:ObjectProperty,
                          owl:AsymmetricProperty;
                        rdfs:comment "All creative technic are not compatible with each other. A creative technic is not compatible with another."@en;
                        rdfs:domain cwmo:CreativeTechnique;
                        rdfs:range cwmo:CreativeTechnique.
cwmo:isMaterializedBy a owl:ObjectProperty,
                        owl:AsymmetricProperty;
                      rdfs:comment "Property indicating that an idea as been conctreatized into some physical or visual"@en;
                      rdfs:domain cwmo:Idea;
                      rdfs:range cwmo:Artifact;
                      owl:inverseOf cwmo:isMaterializing.
cwmo:isMaterializing a owl:ObjectProperty,
                       owl:AsymmetricProperty;
                     rdfs:comment "Property indicating that an artifact represent/ symbolize an idea."@en;
                     rdfs:domain cwmo:Artifact;
                     rdfs:range cwmo:Idea.
cwmo:isParticipatingTo a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:comment "The person with a role is participating to the workshop"@en;
                       rdfs:domain foaf:Person;
                       rdfs:range cwmo:CreativeWorkshop.
cwmo:isPlanifiedBy a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:comment "The creative strategy is defined by a facilitator"@en;
                   rdfs:domain cwmo:CreativeStrategy;
                   rdfs:range cwmo:Facilitator.
cwmo:isProducingData a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:comment "A creative technic produce data (that leads to idea) which is qualitative, quantitative or both."@en;
                     rdfs:domain cwmo:CreativeTechnique;
                     rdfs:range cwmo:DataType.
cwmo:isRealisedBy a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:comment "An artefact has been realised by one or several persons. In opposite to the ideas which is from the group, the realisation is individualised."@en;
                  rdfs:domain cwmo:Artifact;
                  rdfs:range foaf:Person.
cwmo:isRelatedTo a owl:ObjectProperty,
                   owl:SymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "A creative method is related to another creative method according to the method principle or mechanism involved."@en;
                 rdfs:domain cwmo:CreativeTechnique;
                 rdfs:range cwmo:CreativeTechnique.
cwmo:isSolvedDuring a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:comment "A subject is solved during a creative workshop ."@en;
                    rdfs:domain cwmo:Subject;
                    rdfs:range cwmo:CreativeWorkshop.
cwmo:isSupportedBy a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:comment "A creative technic application is supported by tools."@en;
                   rdfs:domain cwmo:CreativeTechnique;
                   rdfs:range cwmo:Tool;
                   owl:inverseOf cwmo:support.
cwmo:novelty a owl:DatatypeProperty;
             rdfs:comment "probability that ideas produced will possess statistical infrequency. Low, medium, high probability"@en;
             rdfs:domain cwmo:CreativeTechnique;
             rdfs:range rdfs:Literal.
cwmo:organize a owl:ObjectProperty,
                owl:AsymmetricProperty,
                owl:IrreflexiveProperty;
              rdfs:comment "An organizer organize a creative workshop. He has the responsability of this workshop."@en;
              rdfs:domain cwmo:Organizer;
              rdfs:range cwmo:CreativeWorkshop.
cwmo:organizeResponseTo a owl:ObjectProperty,
                          owl:AsymmetricProperty,
                          owl:IrreflexiveProperty;
                        rdfs:comment "Creative Strategy is design to respond to a subject."@en;
                        rdfs:domain cwmo:CreativeStrategy;
                        rdfs:range cwmo:Subject.
cwmo:possessEquipment a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:IrreflexiveProperty;
                      rdfs:domain cwmo:CreativeWorkshop;
                      rdfs:range cwmo:Equipment.
cwmo:possessObjective a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:IrreflexiveProperty;
                      rdfs:comment "A subject is described by objective."@en;
                      rdfs:domain cwmo:Subject;
                      rdfs:range cwmo:Objective.
cwmo:problematic a owl:DatatypeProperty;
                 rdfs:comment "the subject is summerized into an open question that pose the problem."@en;
                 rdfs:domain cwmo:Subject;
                 rdfs:range xsd:string.
cwmo:procedure a owl:DatatypeProperty;
               rdfs:comment "procedure details how implement the creative technic ."@en;
               rdfs:domain cwmo:CreativeTechnique;
               rdfs:range xsd:string.
cwmo:progress a owl:ObjectProperty,
                owl:FunctionalProperty,
                owl:AsymmetricProperty,
                owl:IrreflexiveProperty;
              rdfs:domain cwmo:CreativeWorkshop;
              rdfs:range cwmo:CreativePhase.
cwmo:provideAdvice a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:domain cwmo:Expert;
                   rdfs:range cwmo:Advice.
cwmo:requireEquipment a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:IrreflexiveProperty;
                      rdfs:comment "Creative technic require some equipement to be implemented."@en;
                      rdfs:domain cwmo:CreativeTechnique;
                      rdfs:range cwmo:Equipment.
cwmo:requireStimuliType a owl:ObjectProperty,
                          owl:AsymmetricProperty,
                          owl:IrreflexiveProperty;
                        rdfs:domain cwmo:CreativeTechnique;
                        rdfs:range cwmo:StimuliType.
cwmo:scale a owl:DatatypeProperty;
           rdfs:comment "Scale on which the evaluation criteria should be evaluated"@en;
           rdfs:domain cwmo:EvaluationCriteria;
           rdfs:range xsd:integer.
cwmo:score a owl:DatatypeProperty;
           rdfs:comment "the idea has a score once it has been evaluated by the evaluator."@en;
           rdfs:domain cwmo:Idea;
           rdfs:range xsd:float.
cwmo:stimuli a owl:DatatypeProperty;
             rdfs:comment "creative technique require stimuli to permit ideator apply correctly the method. This stimuli can be related or unrelated to the subject."@en;
             rdfs:domain cwmo:CreativeTechnique;
             rdfs:range xsd:string.
cwmo:support a owl:ObjectProperty,
               owl:AsymmetricProperty,
               owl:IrreflexiveProperty;
             rdfs:comment "A tool support the application of a creative technic."@en;
             rdfs:domain cwmo:Tool;
             rdfs:range cwmo:CreativeTechnique.
cwmo:usecase a owl:DatatypeProperty;
             rdfs:comment "Usecase is used to describe the idea in context of use."@en;
             rdfs:domain cwmo:Idea;
             rdfs:range xsd:string.
cwmo:website a owl:DatatypeProperty;
             rdfs:domain cwmo:DigitalTool;
             rdfs:range rdfs:Literal.
cwmo:weight a owl:DatatypeProperty;
            rdfs:domain cwmo:EvaluationCriteria.
dc11:contributor a owl:AnnotationProperty.
dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:modified a owl:AnnotationProperty.
dc11:publisher a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:description a owl:DatatypeProperty;
                    rdfs:comment "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en;
                    rdfs:domain [owl:unionOf (cwmo:Constraint
                                              cwmo:CreativeTechnique
                                              cwmo:CreativeWorkshop
                                              cwmo:Equipment
                                              cwmo:EvaluationTechnic
                                              cwmo:Idea
                                              cwmo:Objective
                                              cwmo:Problem
                                              cwmo:Subject
                                              cwmo:Tool) ; 
                                 a owl:Class];
                    rdfs:isDefinedBy dcterms:description;
                    rdfs:label "description"@en.
dcterms:title a owl:DatatypeProperty,
                owl:FunctionalProperty;
              rdfs:comment "Describes the title of an entity (e.g. idea title, idea contest tile, review title etc.)."@en;
              rdfs:domain [owl:unionOf (cwmo:CreativeTechnique
                                        cwmo:CreativeWorkshop
                                        cwmo:EvaluationTechnic
                                        cwmo:Idea
                                        cwmo:Subject) ; 
                           a owl:Class];
              rdfs:label "title"@en.
schema:Event a owl:Class.
schema:endDate a owl:DatatypeProperty;
               rdfs:comment "Indicate the ending day of a creative workshop."@en;
               rdfs:domain schema:Event;
               rdfs:range xsd:dateTime.
schema:keyword a owl:DatatypeProperty;
               rdfs:comment "Keywords or tags used to describe this content. Multiple entries in a keywords list are typically delimited by commas."@en;
               rdfs:domain cwmo:Idea;
               rdfs:label "keyword"@en;
               rdfs:range xsd:string.
schema:location a owl:DatatypeProperty;
                rdfs:comment "Place where the event occur."@en;
                rdfs:domain schema:Event;
                rdfs:isDefinedBy schema:location;
                rdfs:range xsd:string.
schema:startDate a owl:DatatypeProperty;
                 rdfs:comment "Indicate the starting day of a creative workshop."@en;
                 rdfs:domain schema:Event;
                 rdfs:isDefinedBy schema:startDate;
                 rdfs:label "startDate"@en;
                 rdfs:range xsd:dateTime.
skos:Concept a owl:Class;
             rdfs:comment "The concept class is the generalization of specific ideas."@en;
             rdfs:isDefinedBy skos:Concept;
             rdfs:label "Concept"@en;
             rdfs:seeAlso cwmo:Idea.
<http://xmlns.com/foaf/0.1/#firstName> a owl:DatatypeProperty;
                                       rdfs:comment "The first name of a person."@en;
                                       rdfs:domain foaf:Person;
                                       rdfs:isDefinedBy foaf:firstName.
<http://xmlns.com/foaf/0.1/#lastName> a owl:DatatypeProperty;
                                      rdfs:comment "The last name of a person."@en;
                                      rdfs:domain foaf:Person;
                                      rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/#lastName>.
<http://xmlns.com/foaf/0.1/#member> a owl:ObjectProperty,
                                      owl:AsymmetricProperty,
                                      owl:IrreflexiveProperty;
                                    rdfs:comment "A creative Team is composed by several ideator"@en;
                                    rdfs:domain cwmo:CreativeTeam;
                                    rdfs:isDefinedBy "http://xmlns.com/foaf/0.1/member";
                                    rdfs:range cwmo:Ideator;
                                    rdfs:seeAlso "do not confuse with https://schema.org/member whih don't have the same domain or range".
foaf:Person a owl:Class;
            rdfs:comment "The person class represent people whatever his state"@en;
            rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/#term_Person>;
            rdfs:label "Person"@en.
<http://xmlns.com/foaf/spec/#firstName> a owl:AnnotationProperty.
<http://xmlns.com/foaf/spec/#lastName> a owl:AnnotationProperty.
schemas:legalName a owl:DatatypeProperty;
                  rdfs:domain cwmo:Organization;
                  rdfs:range xsd:string.
schemas:member a owl:ObjectProperty,
                 owl:AsymmetricProperty,
                 owl:IrreflexiveProperty;
               rdfs:comment "An organization has persons as member."@en;
               rdfs:domain cwmo:Organization;
               rdfs:isDefinedBy "https://schema.org/member"@en;
               rdfs:range foaf:Person;
               rdfs:seeAlso "do not confuse with http://xmlns.com/foaf/0.1/member that don't have the same domain or range";
               owl:inverseOf schemas:memberOf.
schemas:memberOf a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "The memberOf point an Organization to which this Person  belongs"@en;
                 rdfs:domain foaf:Person;
                 rdfs:isDefinedBy "https://schema.org/memberOf"@en;
                 rdfs:range cwmo:Organization.
