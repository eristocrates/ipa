@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix opo: <http://online-presence.net/opo/ns#>.

_:B0a3416324d8c106dcad5fd0c87fca102 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:NotificationsProhibited
                                                                                     opo:NotificationsConstrained).
_:B57699467aa94aa1611e9b2818c3019c0 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:Visible
                                                                                     opo:Invisible).
_:B98204acabecacfacebe05c09b01c33d3 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:NotificationsProhibited
                                                                                     opo:AllNotificationsPass).
_:B9af58a167ff2c0c8c59f01a31cbd53b1 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:Active
                                                                                     opo:ProlongedInactive).
_:Bb726a01dfa8570e9717ddc7972d262c1 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:DoNotDistrub
                                                                                     opo:Available).
_:Bbc5345ae8f40e10ba77ab2ede43c8814 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:Inactive
                                                                                     opo:ProlongedInactive).
_:Bc0303ce46122e8fb93a26fbfa8ca5eab a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:FreelyContactable
                                                                                     opo:ConstrainedContactability).
_:Bc283d7f603dae447c53e0768afa883f0 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:Active
                                                                                     opo:Inactive).
_:Bd1f825b1347ab0b86526bdad8dc1d205 a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:PubliclyFindable
                                                                                     opo:ConstrainedFindability).
_:Be84f53a4439288bef3dbf208170c27de a <http://www.w3.org/2002/07/owl#AllDifferent>;
                                    <http://www.w3.org/2002/07/owl#distinctMembers> (opo:AllNotificationsPass
                                                                                     opo:NotificationsConstrained).
<http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent> a <http://www.w3.org/2002/07/owl#Class>.
opo: <http://purl.org/dc/elements/1.1/contributor> "Jelena Jovanovic",
                                                   "Alexandre Passant";
     <http://purl.org/dc/elements/1.1/creator> "Milan Stankovic";
     <http://purl.org/dc/elements/1.1/date> "2010-07-01"^^xsd:date;
     <http://purl.org/dc/elements/1.1/description> "Ontology for representing OnlinePresence."@en;
     <http://purl.org/dc/elements/1.1/title> "OnlinePresence Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Thing>,
       <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:seeAlso <http://online-presence.net/opo/spec/>;
     <http://www.w3.org/2002/07/owl#versionInfo> "Revision 0.5.2".
opo:Action a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An action currently performed by the Agent (e.g., listening to music, reading a book)."@en;
           rdfs:isDefinedBy opo:;
           rdfs:label "Action"@en;
           rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>;
           <http://www.w3.org/2002/07/owl#disjointWith> opo:SourceOfPublishing,
                                                        opo:OnlinePresence.
opo:Active a opo:Activity;
           rdfs:comment "The Agent is active on the system."@en;
           rdfs:isDefinedBy opo:;
           rdfs:label "Active"@en.
opo:Activity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """OnlineStatusComponent used to represent the state of
			Activity of the Agent (e.g., Active, Inactive,
			ProlongedInactive)."""@en;
             rdfs:isDefinedBy opo:;
             rdfs:label "Activity"@en;
             rdfs:subClassOf opo:OnlineStatusComponent;
             <http://www.w3.org/2002/07/owl#disjointWith> opo:Visibility,
                                                          opo:Disturbability,
                                                          opo:Contactability.
opo:AllNotificationsPass a opo:Notifiability;
                         rdfs:comment "Agent can receive notifications from applications"@en;
                         rdfs:isDefinedBy opo:;
                         rdfs:label "AllNotificationsPass"@en.
opo:Available a opo:Disturbability;
              rdfs:comment """The agent is not busy and therefore available for contatc by
			other Agents."""@en;
              rdfs:isDefinedBy opo:;
              rdfs:label "Available"@en.
opo:ConstrainedContactability a opo:Contactability;
                              rdfs:comment """The Agent cannot be contated by anyone on the Web, but the
			contactability is controled by some rules/policies."""@en;
                              rdfs:isDefinedBy opo:;
                              rdfs:label "ConstrainedContactability"@en.
opo:ConstrainedFindability a opo:Findability;
                           rdfs:comment """The Agent's contact details cannot be found by anyone on
			the Web, but the findability is controled by some
			rules/policies."""@en;
                           rdfs:isDefinedBy opo:;
                           rdfs:label "ConstrainedFindability"@en.
opo:Contactability a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """OnlineStatusComponent used to represent the state of
			contactability of an Agent. Contatctability relates to the
			possiblity of other Agents to conatct the Agent freely or
			only with regard to some conditions."""@en;
                   rdfs:isDefinedBy opo:;
                   rdfs:label "Contactability"@en;
                   rdfs:subClassOf opo:OnlineStatusComponent;
                   <http://www.w3.org/2002/07/owl#disjointWith> opo:Activity,
                                                                opo:Visibility,
                                                                opo:Disturbability.
opo:Disturbability a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """OnlineStatusComponent used to represent the wish of an Agent
			to be or not to be disturbed."""@en;
                   rdfs:isDefinedBy opo:;
                   rdfs:label "Disturbability"@en;
                   rdfs:subClassOf opo:OnlineStatusComponent;
                   <http://www.w3.org/2002/07/owl#disjointWith> opo:Contactability,
                                                                opo:Activity,
                                                                opo:Visibility.
opo:DoNotDistrub a <http://www.w3.org/2002/07/owl#Thing>.
opo:DoNotDisturb a opo:Disturbability;
                 rdfs:comment """The Agent is busy and does not want to be contacted by other
			Agents."""@en;
                 rdfs:isDefinedBy opo:;
                 rdfs:label "DoNotDisturb"@en.
opo:Findability a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """The OnlinePresenceComponent used to represent the
			possibility to find contact details of an Agent in a public
			listing"""@en;
                rdfs:isDefinedBy opo:;
                rdfs:label "Findability"@en;
                rdfs:subClassOf opo:OnlinePresenceComponent;
                <http://www.w3.org/2002/07/owl#disjointWith> opo:OnlineStatus,
                                                             opo:Notifiability.
opo:FreelyContactable a opo:Contactability;
                      rdfs:comment "The Agent can be contacted by anyone on the Web"@en;
                      rdfs:isDefinedBy opo:;
                      rdfs:label "FreelyContactable"@en.
opo:Inactive opo:inactivityPeriod "PT5M"^^xsd:duration;
             a opo:Activity;
             rdfs:comment "The Agent is inactive for at least 5 min."@en;
             rdfs:isDefinedBy opo:;
             rdfs:label "Inactive"@en.
opo:Invisible a opo:Visibility;
              rdfs:comment "The Agent's OnlineStatus is not visible to other Agents"@en;
              rdfs:isDefinedBy opo:;
              rdfs:label "Invisible"@en.
opo:Notifiability a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """The OnlinePresenceComponent used to represent the attitude
			of an Agent towards interaction with applications i.e., the
			possibility of applications to show notifications."""@en;
                  rdfs:isDefinedBy opo:;
                  rdfs:label "Notifiability"@en;
                  rdfs:subClassOf opo:OnlinePresenceComponent;
                  <http://www.w3.org/2002/07/owl#disjointWith> opo:Findability,
                                                               opo:OnlineStatus.
opo:NotificationsConstrained a opo:Notifiability;
                             rdfs:comment """The acceptance of notifications from applications is somehow
			constrained (by using some rules or policies)."""@en;
                             rdfs:isDefinedBy opo:;
                             rdfs:label "NotificationsConstrained"@en.
opo:NotificationsProhibited a opo:Notifiability;
                            rdfs:comment "Agent cannot receive any notification form applications"@en;
                            rdfs:isDefinedBy opo:;
                            rdfs:label "NotificationsProhibited"@en.
opo:OnlinePresence a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """OnlinePresence, described in termes of various
			OnlinePresenceComponents to represent the attitude of an
			Agent towards interaction with other Agents and
			Applications."""@en;
                   rdfs:isDefinedBy opo:;
                   rdfs:label "OnlinePresence"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onClass> opo:Notifiability ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onClass> opo:Findability ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://www.w3.org/2002/07/owl#Thing>,
                                   [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onClass> opo:OnlineStatus ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2002/07/owl#disjointWith> opo:Action,
                                                                opo:OnlinePresenceComponent,
                                                                opo:SourceOfPublishing.
opo:OnlinePresenceComponent a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment """A component of OnlinePresence used to represent one of its
			dimensions."""@en;
                            rdfs:isDefinedBy opo:;
                            rdfs:label "OnlinePresenceComponent"@en;
                            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                            <http://www.w3.org/2002/07/owl#disjointWith> opo:OnlinePresence.
opo:OnlineStatus a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """The OnlinePresenceComponent used to represent the attitude
			of an Agent towards the possibility of communication with
			other Agents. The OnlineStatus is defined by its components."""@en;
                 rdfs:isDefinedBy opo:;
                 rdfs:label "OnlineStatus"@en;
                 rdfs:subClassOf opo:OnlinePresenceComponent,
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onClass> opo:Disturbability ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onClass> opo:Activity ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onClass> opo:Notifiability ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onClass> opo:Visibility ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> opo:hasStatusComponent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#disjointWith> opo:OnlineStatusComponent,
                                                              opo:Findability,
                                                              opo:Notifiability.
opo:OnlineStatusComponent a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment """The component of the OnlineStatus representing one of its
			dimensions."""@en;
                          rdfs:isDefinedBy opo:;
                          rdfs:label "OnlineStatusComponent"@en;
                          rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                          <http://www.w3.org/2002/07/owl#disjointWith> opo:OnlineStatus.
opo:ProlongedInactive opo:inactivityPeriod "PT20M"^^xsd:duration;
                      a opo:Activity;
                      rdfs:comment "The Agent is inactive for at least 20 min."@en;
                      rdfs:isDefinedBy opo:;
                      rdfs:label "ProlongedInactive"@en.
opo:PubliclyFindable a opo:Findability;
                     rdfs:comment """The Agent's contact details canbe found by anyone on the
			Web"""@en;
                     rdfs:isDefinedBy opo:;
                     rdfs:label "PubliclyFindable"@en.
opo:SharingSpace a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A group of people belonging to a space for sharing online psresence data - the intended audience of data."@en;
                 rdfs:isDefinedBy opo:;
                 rdfs:label "SharingSpace"@en;
                 rdfs:subClassOf <http://xmlns.com/foaf/0.1/Group>.
opo:SourceOfPublishing a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "The source that can publish Online Presence data."@en;
                       rdfs:isDefinedBy opo:;
                       rdfs:label "SourceOfPublishing"@en;
                       rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                       <http://www.w3.org/2002/07/owl#disjointWith> opo:Action,
                                                                    opo:OnlinePresence.
opo:StatusMessage a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A status message that cannot be commented on."@en;
                  rdfs:isDefinedBy opo:;
                  rdfs:label "StatusMessage"@en;
                  rdfs:subClassOf <http://rdfs.org/sioc/ns#Item>.
opo:Visibility a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """OnlineStatusComponent used to represent the possiblity of
			others to see the OnlineStatus of the Agent"""@en;
               rdfs:isDefinedBy opo:;
               rdfs:label "Visibility"@en;
               rdfs:subClassOf opo:OnlineStatusComponent;
               <http://www.w3.org/2002/07/owl#disjointWith> opo:Contactability,
                                                            opo:Activity,
                                                            opo:Disturbability.
opo:Visible a opo:Visibility;
            rdfs:comment "The Agent's OnlineStatus is visible to other Agents"@en;
            rdfs:isDefinedBy opo:;
            rdfs:label "Visible"@en.
opo:attendedOrganisedEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "The organised event attended by people in the Sharing Space."@en;
                           rdfs:domain opo:SharingSpace;
                           rdfs:isDefinedBy opo:;
                           rdfs:label "Attended Organised Event"@en;
                           rdfs:range <http://data.semanticweb.org/ns/swc/ontology#OrganisedEvent>.
opo:avatar a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment """The graphical representation of the Agent used to depict him
			in online systems."""@en;
           rdfs:domain opo:OnlinePresence;
           rdfs:isDefinedBy opo:;
           rdfs:label "avatar"@en;
           rdfs:range <http://xmlns.com/foaf/0.1/Image>.
opo:basedNear a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The location where members of the Sharing Space are based."@en;
              rdfs:domain opo:SharingSpace;
              rdfs:isDefinedBy opo:;
              rdfs:label "Based Near"@en;
              rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
opo:closestFriendsOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The Person who's closest friends belog to the Sharing Space."@en;
                     rdfs:domain opo:SharingSpace;
                     rdfs:isDefinedBy opo:;
                     rdfs:label "Closest Friends Of"@en;
                     rdfs:range <http://xmlns.com/foaf/0.1/Person>.
opo:commonInterest a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "An interst shared by people in the Sharing Space."@en;
                   rdfs:domain opo:SharingSpace;
                   rdfs:isDefinedBy opo:;
                   rdfs:label "Common Interest"@en;
                   rdfs:range <http://xmlns.com/foaf/0.1/Document>.
opo:currentAction a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Current action performed by the Agent"@en;
                  rdfs:domain opo:OnlinePresence;
                  rdfs:isDefinedBy opo:;
                  rdfs:label "currentAction"@en;
                  rdfs:range opo:Action.
opo:currentLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Current location of the Agent"@en;
                    rdfs:domain opo:OnlinePresence;
                    rdfs:isDefinedBy opo:;
                    rdfs:label "currentLocation"@en;
                    rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
opo:currentlyIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The current location of people in the Sharing Space."@en;
                rdfs:domain opo:SharingSpace;
                rdfs:isDefinedBy opo:;
                rdfs:label "Currently In"@en;
                rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
opo:customMessage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """A message associated with the OnlinePresence, often used in
			chat programs and social networks as custom title as well as in microblogging as status message."""@en;
                  rdfs:domain opo:OnlinePresence;
                  rdfs:isDefinedBy opo:;
                  rdfs:label "customMessage"@en;
                  rdfs:range <http://rdfs.org/sioc/ns#Item>.
opo:declaredBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The Agent that declared the OnlinePresence"@en;
               rdfs:domain opo:OnlinePresence;
               rdfs:isDefinedBy opo:;
               rdfs:label "declaredBy"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
               <http://www.w3.org/2002/07/owl#inverseOf> opo:declaresOnlinePresence.
opo:declaredOn a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The sioc:UserAccount account where the OnlinePresence was declared."@en;
               rdfs:domain opo:OnlinePresence;
               rdfs:isDefinedBy opo:;
               rdfs:label "declaredOn"@en;
               rdfs:range <http://rdfs.org/sioc/ns#UserAccount>;
               rdfs:subPropertyOf <http://rdfs.org/sioc/ns#has_creator>.
opo:declaresOnlinePresence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "The OnlinePresence declared by the Agent"@en;
                           rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                           rdfs:isDefinedBy opo:;
                           rdfs:label "declaresOnlinePresence"@en;
                           rdfs:range opo:OnlinePresence;
                           <http://www.w3.org/2002/07/owl#inverseOf> opo:declaredBy.
opo:duration a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment """The estimated duration of the OnlinePresence after the
			startTime"""@en;
             rdfs:domain opo:OnlinePresence;
             rdfs:isDefinedBy opo:;
             rdfs:label "duration"@en;
             rdfs:range xsd:duration.
opo:familyOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "The Person who's family members belog to the Sharing Space."@en;
             rdfs:domain opo:SharingSpace;
             rdfs:isDefinedBy opo:;
             rdfs:label "Family Of"@en;
             rdfs:range <http://xmlns.com/foaf/0.1/Person>.
opo:hasPresenceComponent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "OnlinePresenceComponent included in this OnlinePresence"@en;
                         rdfs:domain opo:OnlinePresence;
                         rdfs:isDefinedBy opo:;
                         rdfs:label "hasOnlinePresence"@en;
                         rdfs:range opo:OnlinePresenceComponent;
                         <http://www.w3.org/2002/07/owl#inverseOf> opo:isPresenceComponentOf.
opo:hasStatusComponent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "OnlineStatusComponent included in this OnlineStatus"@en;
                       rdfs:domain opo:OnlineStatus;
                       rdfs:isDefinedBy opo:;
                       rdfs:label "hasStatusComponent"@en;
                       rdfs:range opo:OnlineStatusComponent;
                       <http://www.w3.org/2002/07/owl#inverseOf> opo:isStatusComponentOf.
opo:inactivityPeriod a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Period of inactivity on a certain service"@en;
                     rdfs:domain opo:Activity;
                     rdfs:isDefinedBy opo:;
                     rdfs:label "inactivityPeriod"@en;
                     rdfs:range xsd:duration.
opo:intendedFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A group of people belonging to a space for sharing online psresence data - the intended audience of presence information."@en;
                rdfs:domain opo:OnlinePresence;
                rdfs:isDefinedBy opo:;
                rdfs:label "intendedFor"@en;
                rdfs:range opo:SharingSpace.
opo:isPresenceComponentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "The OnlinePresence that has this OnlinePresenceComponent"@en;
                          rdfs:domain opo:OnlinePresenceComponent;
                          rdfs:isDefinedBy opo:;
                          rdfs:label "isPresenceComponentOf"@en;
                          rdfs:range opo:OnlinePresence;
                          <http://www.w3.org/2002/07/owl#inverseOf> opo:hasPresenceComponent.
opo:isStatusComponentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "The OnlineStatus that includes this OnlineStatusComponent."@en;
                        rdfs:domain opo:OnlineStatusComponent;
                        rdfs:isDefinedBy opo:;
                        rdfs:label "isStatusComponentOf"@en;
                        rdfs:range opo:OnlineStatus;
                        <http://www.w3.org/2002/07/owl#inverseOf> opo:hasStatusComponent.
opo:onlineStatusName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment """A name used by chat systems to distinguish their various
			statuses."""@en;
                     rdfs:domain opo:OnlineStatus;
                     rdfs:isDefinedBy opo:;
                     rdfs:label "OnlineStatusName"@en;
                     rdfs:range xsd:string.
opo:publishedFrom a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The source from which the OnlinePresence is declared (e.g., a mobile device)"@en;
                  rdfs:domain opo:OnlinePresence;
                  rdfs:isDefinedBy opo:;
