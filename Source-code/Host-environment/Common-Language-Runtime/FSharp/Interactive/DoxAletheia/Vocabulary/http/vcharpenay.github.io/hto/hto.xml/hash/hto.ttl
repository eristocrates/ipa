                rdfs:label "Cooling Coil";
                rdfs:subClassOf hto:Section.
hto:Discharge a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Discharge";
              rdfs:subClassOf hto:Section.
hto:Efficiency a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Efficiency";
               rdfs:subClassOf hto:Measurement.
hto:Entering a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Entering";
             rdfs:subClassOf hto:Section.
hto:Equipment a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Equipment";
              rdfs:subClassOf hto:HEntity,
                              <http://purl.oclc.org/NET/ssnx/ssn#Platform>.
hto:Exhaust a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Exhaust";
            rdfs:subClassOf hto:Section.
hto:Fan a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "Fan";
        rdfs:subClassOf hto:Section.
hto:Flow a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "Flow";
         rdfs:subClassOf hto:Measurement.
hto:Frequency a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Frequency";
              rdfs:subClassOf hto:Measurement.
hto:Gas a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "Gas";
        rdfs:subClassOf hto:PhysicalBody.
hto:HEntity a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "HEntity".
hto:HTag a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "HTag".
hto:HVAC a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "HVAC";
         rdfs:subClassOf hto:Equipment.
hto:HeatingCoil a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Heating Coil";
                rdfs:subClassOf hto:Section.
hto:Historized a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Historized";
               rdfs:subClassOf hto:PointProperty.
hto:Humidity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Humidity";
             rdfs:subClassOf hto:Measurement.
hto:IsolationValve a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Isolation Valve";
                   rdfs:subClassOf hto:Valve.
hto:Leaving a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Leaving";
            rdfs:subClassOf hto:Section.
hto:LightLevel a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Light Level";
               rdfs:subClassOf hto:Measurement.
hto:LightsGroup a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Lights Group";
                rdfs:subClassOf hto:Equipment.
hto:Measurement a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Measurement".
hto:Meter a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Meter";
          rdfs:subClassOf hto:Equipment.
hto:Mixed a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Mixed";
          rdfs:subClassOf hto:Section.
hto:OnOff a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "On/Off";
          rdfs:subClassOf hto:Measurement.
hto:Percentage a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Percentage";
               rdfs:subClassOf hto:Measurement.
hto:PerimeterHeat a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Perimeter Heat";
                  rdfs:subClassOf hto:Section.
hto:PhysicalBody a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Physical Body".
hto:Point a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Point";
          rdfs:subClassOf hto:HEntity.
hto:PointProperty a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Point Property".
hto:Power a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Power";
          rdfs:subClassOf hto:Measurement.
hto:Pressure a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Pressure";
             rdfs:subClassOf hto:Measurement.
hto:Pump a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "Pump";
         rdfs:subClassOf hto:VFD.
hto:RTU a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "RTU";
        rdfs:subClassOf hto:AHU.
hto:RealTime a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Real time";
             rdfs:subClassOf hto:PointProperty.
hto:RefrigerantSubstance a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Refrigirant Substance";
                         rdfs:subClassOf hto:PhysicalBody.
hto:Return a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Return";
           rdfs:subClassOf hto:Section.
hto:Section a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Section";
            rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#FeatureOfInterest>.
hto:Sensor hto:associatedTo hto:sensor;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Sensor";
           rdfs:subClassOf hto:Point,
                           <http://purl.oclc.org/NET/ssnx/ssn#SensingDevice>.
hto:SetPoint a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Set Point";
             rdfs:subClassOf hto:Point.
hto:Site a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "Site";
         rdfs:subClassOf hto:HEntity.
hto:Speed a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Speed";
          rdfs:subClassOf hto:Measurement.
hto:Steam a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Steam";
          rdfs:subClassOf hto:PhysicalBody.
hto:Temperature a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Temperature";
                rdfs:subClassOf hto:Measurement.
hto:VAV a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "VAV";
        rdfs:subClassOf hto:HVAC.
hto:VFD a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:label "VFD";
        rdfs:subClassOf hto:Equipment.
hto:VFDFan a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "VFD Fan";
           rdfs:subClassOf hto:VFD.
hto:Valve a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Valve";
          rdfs:subClassOf hto:Section.
hto:Water a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Water";
          rdfs:subClassOf hto:PhysicalBody.
hto:Writable a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Writable";
             rdfs:subClassOf hto:PointProperty.
hto:Zone a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "Zone";
         rdfs:subClassOf hto:Section.
hto:ahu hto:associatedTo hto:AHU;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Air Handler Unit which heats and/or cools air.".
hto:air hto:associatedTo hto:Air;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Point associated with the measurement or control of air. In regards to `wetBulb`, points with the 'air' tag are associated with dry bulb.".
hto:associatedTo a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:comment "gives the OWL class defined in the present ontology that should be associated to the individual defined as subject.";
                 rdfs:domain hto:HTag.
hto:belongsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain hto:Point;
              rdfs:range hto:Equipment;
              rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#onPlatform>.
hto:boiler hto:associatedTo hto:Boiler;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "note: does not fully implement specification (no boilerPlant). However, is still a TODO in project Haystack.",
                        "  Boiler `equip` used to generate hot water or steam for heating.".
hto:bypass a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "  If used with `valve` indicates a by-pass in a piping system. If used in combination with the `damper` tag on an `ahu` to indicate a damper in the ductwork to by-pass the VAV boxs and create a direct circuit between the discharge and return of the unit.".
hto:chilled hto:associatedTo hto:ChilledSystem;
            a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Marker tag used with `water` for the chilled water system between `chiller` and `ahu`.".
hto:chiller hto:associatedTo hto:Chiller;
            a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "note: does not fully implement specification (no chillerPlant, no CoolingTower).",
                         "  Chillers remove heat from a liquid via a vapor compression or an absorption refrigeration cycle.".
hto:cmd hto:associatedTo hto:Command;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Classifies a `point` as an output, AO/BO, command, or actuator.".
hto:co2 hto:associatedTo hto:CO2;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment """  Carbon dioxide level `point` measured in \"ppm\".""".
hto:condenser hto:associatedTo hto:CondenserSystem;
              a hto:HTag,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              rdfs:comment "  When combined with the `water` tag, this indicates points in a condenser water system between a `chiller` and `coolingTower`. When used with the `refrig` tag, this indicates points on the condenser mechanism used to convert a refrigerant from its gaseous to liquid state. If paired with the `cmd` tag this tag indicates the command status of a condensor in a `chiller` modeled as true/false (on/off) or 0% to 100%.".
hto:cool hto:associatedTo hto:CoolingCoil;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "  Cooling coil as bool or numeric `point` used with `ahu` equip.  If multiple stages are used, then also specify the `stage` tag. If the cooling coil is controlled by a valve, then this point is mesaured from 0% to 100%, otherwise it should be a boolean point.".
hto:cooling a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Associated with the cooling mode of an HVAC system.".
hto:damper hto:associatedTo hto:Percentage;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "note: indicates the measurement of how open the damper of a AHU is (0-100%)",
                        "  Damper position measured from 0% (fully closed) to 100% (fully open).".
hto:delta a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Indicates a differential of `air`, `water`, or `steam` between the `entering` and `leaving` sensors.".
hto:dis a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:domain hto:HEntity.
hto:discharge hto:associatedTo hto:Discharge;
              a hto:HTag,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              rdfs:comment "  Associated with the discharge air an `ahu` or `vav`.".
hto:effective a hto:HTag,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              rdfs:comment "  Used to indicate the effective setpoint which takes into account various other mode based setpoints the equip might define.  See [zone setpoints]`Zones#zonePoints` for complete example of how this tag is used.".
hto:efficiency hto:associatedTo hto:Efficiency;
               a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment """  Efficiency point of a `chiller` measured in \"COP\" or \"kW/ton\".""".
hto:elec a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "note: according to the documentation, is assocated to either point or equip",
                      "  Used on `point` or `equip` entities relating to electricity. When paried with `meter` indicates a electric meter.".
hto:enable hto:associatedTo hto:OnOff;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "  Secondary on/off `point` of an `equip` especially used with a `vfd`. Enable is used with Bool points where true indicates on and false indicates off.  Equip with an enable should always also define a `run` point which indicates the primary on/off state of the equipment.".
hto:energy a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment """  Applied to `point` entities which measure energy consumption:   - Electric meters: \"kWh\"   - Thermal meters: \"BTU\"   - Gas meters: \"mÂ³_gas\"   - Chillers: \"tonrefh\"""".
hto:entering hto:associatedTo hto:Entering;
             a hto:HTag,
               <http://www.w3.org/2002/07/owl#NamedIndividual>;
             rdfs:comment "  Indicates `water` or `steam` entering a piece of equipment like a `boiler` or `chiller`.  Used with `vav` for air flow into the unit from the AHU.".
hto:evaporator a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment "  Indicates points on the evaporator mechanism used to convert a refrigerant from its liquid to gageous state.  It is often paired with the `refrig` marker tag.".
hto:exhaust hto:associatedTo hto:Exhaust;
            a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Associated with the exhaust air an `ahu`.".
hto:faceBypass a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment "  A `point` of an `ahu` indicating air flow is by-passing the heating/cooling elements. If a boolean point, then true indicates the unit is in by-pass mode and false indicates by-pass is disabled.  If the point is an analog point then 100% indicates full by-pass mode and 0% that by-pass is completely disabled.".
hto:fan a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "note: according to the documentation, is assocated to either point or equip. Should use reasoning to choose the right one for a given HEntity",
                     "  Fan `point` or `equip` associated with an `ahu`, `vav`, or `coolingTower`.".
hto:filter hto:associatedTo hto:Pressure;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment """  Differential pressure across the filter of an `ahu`.  If a boolean point then true indicates successful airflow and false indicates a clogged filter.  If a numeric then the pressure differential should be measured in \"inHâ‚‚O\" or \"kPa\"""".
hto:flow hto:associatedTo hto:Flow;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment """  Marker tag on a `point` which measures rate of volume currently flowing through a flow meter, duct, or pipe .   - Air flow: \"cfm\" or \"L/s\"   - Gas/water flow: \"gal/min\" or \"mÂ³/s\"""".
hto:freezeStat hto:associatedTo hto:OnOff;
               a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment "  A boolean `point` of an `ahu` indicating a freezing condition which might require a control sequence to protect the equipment. If true then a freeze condition is deteted, or false if not.".
hto:freq hto:associatedTo hto:Frequency;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment """  Electrical A/C frequency `point` measured in \"Hz\" for `elec` `meter` or a `vfd`.""".
hto:gas hto:associatedTo hto:Gas;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Used on `point` or `equip` entities relating to natural gas. When paried with `meter` indicates a gas meter.".
hto:hasRef a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>;
           <http://www.w3.org/2002/07/owl#inverseOf> hto:isRefedBy.
hto:hasSection a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain hto:Equipment;
               rdfs:range hto:Section.
hto:hasTag a <http://www.w3.org/2002/07/owl#ObjectProperty>.
hto:heat hto:associatedTo hto:HeatingCoil;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "  Heating coil as bool or float point on an `ahu` or `vav`. If multiple stages are used, then also specify the `stage` tag. If the heating coil is controlled by a valve, then this point is mesaured from 0% to 100%, otherwise it should be a boolean point.".
hto:heatWheel hto:associatedTo hto:OnOff;
              a hto:HTag,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              rdfs:comment "  Bool `point` which models the on or off state of an `ahu` heat wheel.".
hto:heating a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Associated with the heating mode of an HVAC system.".
hto:humidifier hto:associatedTo hto:OnOff;
               a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment "  Boolean or numeric `point` of an `ahu` used to indicate if if the humidifier is on or off.".
hto:humidity hto:associatedTo hto:Humidity;
             a hto:HTag,
               <http://www.w3.org/2002/07/owl#NamedIndividual>;
             rdfs:comment "  Humidity measured from 0% to 100%.".
hto:hvac hto:associatedTo hto:HVAC;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "  Associated with HVAC (Heating, Ventilating, Air Conditioning)".
hto:isRefedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>.
hto:isolation hto:associatedTo hto:IsolationValve;
              a hto:HTag,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              rdfs:comment "  Indicates a `valve` used to isolate a piece of equipment from a piping system.".
hto:leaving hto:associatedTo hto:Leaving;
            a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Indicates `water` or `steam` exiting a piece of equipment like a `boiler` or `chiller`.".
hto:lightLevel hto:associatedTo hto:LightLevel;
               a hto:HTag,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment """  Light level sensor point under `lightsGroup` measured in \"lux\" or \"lumen\".""".
hto:lights hto:associatedTo hto:LightLevel;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "note: according to the documentation, subsumes sensor. But associated here to a Measurement type and redundant with the tag lightLevel.",
                        "  Lighting on/off status as a boolean or if dimmable a numeric between 0% and 100%.".
hto:lightsGroup hto:associatedTo hto:LightsGroup;
                a hto:HTag,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                rdfs:comment "  Equip level of the lighting system which is a group of one or more `lights` points.".
hto:load hto:associatedTo hto:Percentage;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment """  Models a `point` on a `chiller` used to command or measure the chiller's load as a percentage from \"0%\" to \"100%\".  When paired with `cmd` this models the chiller's load limit.  When paired with `sensor` this models the chiller's current load factor.""".
hto:locatedOn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain hto:Point;
              rdfs:range hto:Section;
              rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#isPropertyOf>.
hto:measuredOn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain hto:Measurement;
               rdfs:range hto:PhysicalBody.
hto:meter hto:associatedTo hto:Meter;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Equip which meters usage of `elec` energy, thermal energy, `gas`, `water` or `steam`.".
hto:mixed hto:associatedTo hto:Mixed;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Associated with the mixed air of an `ahu`.".
hto:occupancyIndicator hto:associatedTo hto:OnOff;
                       a hto:HTag,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>;
                       rdfs:comment "note: according to the documentation, subsumes sensor. But associated here to a Measurement type. Similarly, lights and lightLevel tags both refer to the class LightLevel.",
                                    "  Occupancy sensor under `lightsGroup`.  Point must be Bool where true indicates occupied and false indicates unoccupied";
                       rdfs:seeAlso "http://project-haystack.org/tag/lights".
hto:perimeterHeat hto:associatedTo hto:PerimeterHeat;
                  a hto:HTag,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>;
                  rdfs:comment "  Auxiliary heating points associated with a `vav`.".
hto:point hto:associatedTo hto:Point;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Data point such as a sensor or actuator.".
hto:power hto:associatedTo hto:Power;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment """  Applied to `point` entities which measure energy consumed per unit time. For 'elec meter' this is the electrical demand.   - Electric meters: \"kW\"   - Thermal meters: \"BTU/h\"   - Chillers: \"tonref\" or \"kW\" refrigeration""".
hto:pressure hto:associatedTo hto:Pressure;
             a hto:HTag,
               <http://www.w3.org/2002/07/owl#NamedIndividual>;
             rdfs:comment "  Static pressure associated with the measurement or control of fluids such as air, oxygen, water, steam, gas, oil, etc.".
hto:quantifies a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain hto:Point;
               rdfs:range hto:Measurement;
               rdfs:subPropertyOf <http://purl.oclc.org/NET/ssnx/ssn#observes>.
hto:refrig hto:associatedTo hto:RefrigerantSubstance;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "  Indicates points associated with the measurment or control of the refrigerant substance in a cooling system like a `chiller`.".
hto:return hto:associatedTo hto:Return;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "  Associated with the return air an `ahu`.".
hto:rooftop hto:associatedTo hto:RTU;
            a hto:HTag,
              <http://www.w3.org/2002/07/owl#NamedIndividual>;
            rdfs:comment "  Used with `ahu` to mark an AHU as a packaged rooftop unit (RTU).".
hto:run hto:associatedTo hto:OnOff;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "note: according to the documentation, subsumes sensor. But associated here to a Measurement type.",
                     "  Primary on/off `point` of an `equip` especially used with a `vfd`. Run is used with Bool points where true indicates on and false indicates off. When paired with `cmd` this is the commanded state of the equipment. When paired with `sensor` this is the actual status of the equip.  If the equipment also defines an `enable` point then both must be commanded on in order to run the equipment.".
hto:sensor hto:associatedTo hto:Sensor;
           a hto:HTag,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "  Classifies a `point` as an input, AI/BI, or sensor.".
hto:sp hto:associatedTo hto:SetPoint;
       a hto:HTag,
         <http://www.w3.org/2002/07/owl#NamedIndividual>;
       rdfs:comment "  Classifies a `point` as a setpoint, soft point, or process control variable.".
hto:speed hto:associatedTo hto:Speed;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment """  Speed `point` of a `vfd` measured in \"%\" where 0% is off and 100% is the fastest speed.""".
hto:steam hto:associatedTo hto:Steam;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Point associated with the measurement or control of steam. This tag is often paired with `entering` versus `leaving` versus `delta`. It may also be paired with `meter` to indicate a steam meter.".
hto:temp hto:associatedTo hto:Temperature;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "  Temperature measured in Â°C or Â°F.".
hto:valve hto:associatedTo hto:Valve;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Marker tag on `point` which indicates a valve used to regulate or control the flow or pressure of a fluid.  It is used with `cmd` to indicate the valve command: true/false (open/close) or 0% to 100%.  It may also be used with `sensor` to indicate a feedback sensor such as a voltage giving exact position between 0% and 100%.".
hto:vav hto:associatedTo hto:VAV;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Variable Volume Volume supply duct `equip`.".
hto:vfd hto:associatedTo hto:VFD;
        a hto:HTag,
          <http://www.w3.org/2002/07/owl#NamedIndividual>;
        rdfs:comment "  Marker for a motor `equip` with variable frequency drive.  Commonly used in combination with `fan` and `pump`.".
hto:water hto:associatedTo hto:Water;
          a hto:HTag,
            <http://www.w3.org/2002/07/owl#NamedIndividual>;
          rdfs:comment "  Point associated with the measurement or control of water.  This tag is often paired:   - `entering` versus `leaving` versus `delta`   - `chilled` versus `condenser` It may also be paired with `meter` to indicate a water meter.".
hto:zone hto:associatedTo hto:Zone;
         a hto:HTag,
           <http://www.w3.org/2002/07/owl#NamedIndividual>;
         rdfs:comment "  Associated with a conditioned [zone]`Zones` of a building.".
