<http://vcharpenay.github.io/hto/hto.xml> <http://creativecommons.org/ns#license> """Academic Free License (\"AFL\") 3.0""";
                                          <http://purl.org/dc/elements/1.1/creator> "Victor Charpenay <victor.charpenay[at]siemens.com>";
                                          <http://purl.org/dc/elements/1.1/title> "Haystack Tagging Ontology";
                                          <http://purl.org/dc/terms/modified> "2016-10-20"^^xsd:date;
                                          a <http://www.w3.org/2002/07/owl#Ontology>;
                                          rdfs:comment "The Haystack Tagging Ontology is an OWL ontology for Project Haystack, a domain vocabulary for Building Automation Systems.";
                                          rdfs:seeAlso "http://vcharpenay.github.io/hto/"^^xsd:anyURI;
                                          <http://www.w3.org/2002/07/owl#imports> <http://purl.oclc.org/NET/ssnx/ssn>;
                                          <http://www.w3.org/2002/07/owl#versionInfo> "0.2.0".
