@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lsmap: <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-data.owl#>.

lsmap:Characteristic rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Characteristic>,
                                     <http://semanticscience.org/resource/SIO_000614>.
lsmap:DatasetManifestation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf <http://www.w3.org/ns/dcat#Distribution>.
lsmap:Entity rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Entity>,
                             <http://semanticscience.org/resource/SIO_000776>.
lsmap:Format a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf <http://purl.org/dc/terms/MediaTypeOrExtent>.
lsmap:GeographicRegion <http://semanticscience.org/resource/example> "America";
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf <http://purl.org/dc/terms/Location>.
lsmap:GeospatialDataset a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:subClassOf <http://www.w3.org/ns/dcat#Dataset>.
lsmap:Provider a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>.
lsmap:Theme a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
lsmap:TimePeriod a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:subClassOf <http://purl.org/dc/terms/PeriodOfTime>.
lsmap:Unit a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf <http://ecoinformatics.org/oboe/oboe.1.0/oboe-core.owl#Unit>,
                           <http://semanticscience.org/resource/SIO_000074>.
lsmap:encodedInFormat a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:subPropertyOf <http://www.w3.org/ns/dcat#mediaType>.
lsmap:hasManifestation rdfs:subPropertyOf <http://www.w3.org/ns/dcat#distribution>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#Processing> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasAssociatedWith> rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasAssociatedWith>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasMeasuredBy> rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasGeneratedBy>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-edac.owl#wasModelledBy> rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasGeneratedBy>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceActivity> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                               rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceAgent> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#ProjectionActivity> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                        rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceActivity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                    rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                 rdfs:subClassOf <http://www.w3.org/ns/prov#SoftwareAgent>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingAlgorithm> rdfs:subClassOf <http://semanticscience.org/resource/SIO_000094>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameter> rdfs:subClassOf <http://semanticscience.org/resource/SIO_000144>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingParameters> rdfs:subClassOf <http://semanticscience.org/resource/SIO_000616>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#SpeciesModellingSoftware> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-lifemapper.owl#LifemapperServiceAgent>,
                                                                                                             <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent>,
                                                                                                             <http://semanticscience.org/resource/SIO_000140>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#CardioSHAREActivity> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SADIActivity> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceActivity>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SADIService> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent>.
<http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-service.owl#SHAREClient> rdfs:subClassOf <http://ontology.cybershare.utep.edu/ELSEWeb/elseweb-modelling.owl#ServiceAgent>.
