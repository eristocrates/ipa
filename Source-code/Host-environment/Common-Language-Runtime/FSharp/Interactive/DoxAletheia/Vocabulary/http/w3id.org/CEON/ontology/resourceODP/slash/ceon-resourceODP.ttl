@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ceon-resourceODP: <http://w3id.org/CEON/ontology/resourceODP/>.

<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/CEON/ontology/location/Location> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/location/hasLocation> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
ceon-resourceODP: <http://purl.org/dc/terms/contributor> "Eva Blomqvist";
                  <http://purl.org/dc/terms/created> "2025-03-20"^^xsd:date;
                  <http://purl.org/dc/terms/creator> "Huanyu Li";
                  <http://purl.org/dc/terms/description> "A core ODP of the CEON ontology network defining aspects of the resource concept.";
                  <http://purl.org/dc/terms/issued> "2025-06-30"^^xsd:date;
                  <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/";
                  <http://purl.org/dc/terms/publisher> "Onto-DESIDE";
                  <http://purl.org/dc/terms/title> "Circular Economy Ontology Network (CEON) - Resource ODP";
                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "ceon-resourceODP";
                  <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/CEON/ontology/resourceODP/";
                  <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "Covers the following requirements from Onto-DESIDE D3.2: CE1-2, CE3-3, CE4-3, CE5-2, CE9-1, CE10-1, CE11-8, CE12-2, CE12-4, C7-3, E2-2, E4-6, E5-1, E6-3, T3-1, T19-1, T20-1, T22-2.",
                                                                                                            "Covers the following requirements from Onto-DESIDE D3.1: CVN-Resource-1,3, CVN-Composition-1,2, CVN-ResrouceType-4, C7-3, E2-2, E4-6, E5-1, E6-3, T3-1.";
                  a <http://www.w3.org/2002/07/owl#Ontology>;
                  rdfs:seeAlso <https://github.com/LiUSemWeb/CEON>;
                  <http://www.w3.org/2002/07/owl#priorVersion> 0.4;
                  <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/CEON/ontology/resourceODP/0.5/>;
                  <http://www.w3.org/2002/07/owl#versionInfo> 0.5.
ceon-resourceODP:Asset a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Asset is sth that is valuable and useful to be used in activities, or owned by actors.";
                       rdfs:label "Asset".
ceon-resourceODP:BatchOfObjects a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A batch of objects is a collection of physical objects that are of the same type, e.g. a set of items (product instances) adhering to the same product model.";
                                rdfs:label "Batch Of Objects";
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:PhysicalObject ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasPhysicalObject ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                 [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasPhysicalObject ; 
                                                                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:PhysicalObject ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                 a <http://www.w3.org/2002/07/owl#Class>],
                                                [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:batchSize ; 
                                                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                ceon-resourceODP:Resource.
ceon-resourceODP:Constituent a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A constituent is a component of object.";
                             rdfs:label "Constituent";
                             rdfs:seeAlso "http://emmo.info/emmo#EMMO_ceaaf9f7_fd11_424b_8fda_9afa186af186".
ceon-resourceODP:DigitalObject a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "A digital object, e.g. a computer file, that is located on some server, hard drive, or on the web. Most often the digital object is the realization of some piece of information.";
                               rdfs:label "Digital object";
                               rdfs:subClassOf ceon-resourceODP:Resource.
ceon-resourceODP:Information a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Information is an abstract concept that represents any kind of interpretations. For instance, information can be data generated by software systems or data used by people for communications.";
                             rdfs:label "Information";
                             rdfs:seeAlso "http://emmo.info/emmo#EMMO_64c72d00_7582_44ea_a0b5_3a14e50acc36";
                             rdfs:subClassOf ceon-resourceODP:Asset.
ceon-resourceODP:Matter a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A matter is a physical substance.";
                        rdfs:label "Matter";
                        rdfs:seeAlso "http://emmo.info/emmo#EMMO_5b2222df_4da6_442f_8244_96e9e45887d1".
ceon-resourceODP:PhysicalObject a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A physical object is a collection of matter.";
                                rdfs:label "Physical object";
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:Constituent ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasConstituent ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                 [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasConstituent ; 
                                                                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:Constituent ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                 a <http://www.w3.org/2002/07/owl#Class>],
                                                [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:Matter ; 
                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasMatter ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                 [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasMatter ; 
                                                                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:Matter ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                 a <http://www.w3.org/2002/07/owl#Class>],
                                                ceon-resourceODP:Resource.
ceon-resourceODP:Resource a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Asset from which a solution is created or implemented. Depending on the context, reference to “resource” includes “raw material”, “feedstock”, “material” or “component”. Resource includes any energy type (e.g. the energy content or energy potential of materials). Note 4 to entry: Resources can be considered concerning both stocks and flows.";
                          rdfs:isDefinedBy "ISO 59004:2024 - 3.1.5 resource";
                          rdfs:label "Resource";
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:ResourceCondition ; 
                                                                                           <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceCondition ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                           [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceCondition ; 
                                                                                           <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:ResourceCondition ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>],
                                          [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:ResourceProperty ; 
                                                                                           <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceProperty ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                           [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceProperty ; 
                                                                                           <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:ResourceProperty ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>],
                                          [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:ResourceQuality ; 
                                                                                           <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceQuality ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                           [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasResourceQuality ; 
                                                                                           <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:ResourceQuality ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>],
                                          ceon-resourceODP:Asset.
ceon-resourceODP:ResourceCondition a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The status of a resource.";
                                   rdfs:label "Resource Condition".
ceon-resourceODP:ResourceProperty a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "The characteristics or attribuets of a resource.";
                                  rdfs:label "Resource Property".
ceon-resourceODP:ResourceQuality a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Resource quality is derived based on assessments of resources considering the conditions and properties.";
                                 rdfs:label "Resource Quality".
ceon-resourceODP:SetOfObjects a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A set of objects is a set of physical objects (items) that can be of different types, i.e. different kinds of items.";
                              rdfs:label "Set of objects";
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:BatchOfObjects ; 
                                                                                               <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasBatch ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                               [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasBatch ; 
                                                                                               <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:BatchOfObjects ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                               a <http://www.w3.org/2002/07/owl#Class>],
                                              [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-resourceODP:PhysicalObject ; 
                                                                                               <http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasPhysicalObject ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                               [<http://www.w3.org/2002/07/owl#onProperty> ceon-resourceODP:hasPhysicalObject ; 
                                                                                               <http://www.w3.org/2002/07/owl#allValuesFrom> ceon-resourceODP:PhysicalObject ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                               a <http://www.w3.org/2002/07/owl#Class>],
                                              ceon-resourceODP:Resource.
ceon-resourceODP:batchID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "identifier for a batch";
                         rdfs:domain ceon-resourceODP:BatchOfObjects;
                         rdfs:label "batch ID";
                         rdfs:range xsd:string.
ceon-resourceODP:batchLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "label for a batch";
                            rdfs:domain ceon-resourceODP:BatchOfObjects;
                            rdfs:label "batch label";
                            rdfs:range xsd:string.
ceon-resourceODP:batchSize a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "batchSize intends to repsent how many physical objects are belong to a batch of objects.";
                           rdfs:domain ceon-resourceODP:BatchOfObjects;
                           rdfs:label "batch size";
                           rdfs:range xsd:nonNegativeInteger.
ceon-resourceODP:containsInformation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "Indicating that some piece of information is contained in a larger collection of information, e.g. a data sheet contains a statement about a certain parameter of a product.";
                                     rdfs:domain ceon-resourceODP:Information;
                                     rdfs:label "contains information";
                                     rdfs:range ceon-resourceODP:Information;
                                     rdfs:subPropertyOf ceon-resourceODP:hasPart.
ceon-resourceODP:hasBatch a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "hasBatch intends to represent that a set of objects can be captured by a number of batches where each batch contains a number of physical objects.";
                          rdfs:domain ceon-resourceODP:SetOfObjects;
                          rdfs:label "has batch";
                          rdfs:range ceon-resourceODP:BatchOfObjects.
ceon-resourceODP:hasConstituent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "hasConstitutent intends to represent that a physical object can have a collection of composing components.";
                                rdfs:domain ceon-resourceODP:PhysicalObject;
                                rdfs:label "has constituent";
                                rdfs:range ceon-resourceODP:Constituent;
                                rdfs:subPropertyOf ceon-resourceODP:hasPart.
ceon-resourceODP:hasMatter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "hasMatter intends to represent that a physical object can have a collection of matter.";
                           rdfs:domain ceon-resourceODP:PhysicalObject;
                           rdfs:label "has matter";
                           rdfs:range ceon-resourceODP:Matter.
ceon-resourceODP:hasPart a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                           <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                         rdfs:comment "Indicating that something is part of or is contained by something else.";
                         rdfs:label "has part".
ceon-resourceODP:hasPhysicalObject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:comment "hasPhysicalObject intends to represent that a batch of objects or a set of objects can have composing components of physical objects.";
                                   rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (ceon-resourceODP:BatchOfObjects
                                                                                         ceon-resourceODP:SetOfObjects) ; 
                                                a <http://www.w3.org/2002/07/owl#Class>];
                                   rdfs:label "has physical object";
                                   rdfs:range ceon-resourceODP:PhysicalObject.
ceon-resourceODP:hasResourceCondition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:comment "A resource can has specifc conditions.";
                                      rdfs:domain ceon-resourceODP:Resource;
                                      rdfs:label "has resource condition";
                                      rdfs:range ceon-resourceODP:ResourceCondition.
ceon-resourceODP:hasResourceLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "Defines the location of a resource.";
                                     rdfs:domain ceon-resourceODP:Resource;
                                     rdfs:label "has resource location";
                                     rdfs:range <http://w3id.org/CEON/ontology/location/Location>;
                                     rdfs:subPropertyOf <http://w3id.org/CEON/ontology/location/hasLocation>.
ceon-resourceODP:hasResourceProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "A resource can has specifc properties.";
                                     rdfs:domain ceon-resourceODP:Resource;
                                     rdfs:label "has resource property";
                                     rdfs:range ceon-resourceODP:ResourceProperty.
ceon-resourceODP:hasResourceQuality a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "A resource can has specifc qualities.";
                                    rdfs:domain ceon-resourceODP:Resource;
                                    rdfs:label "has resource quality";
                                    rdfs:range ceon-resourceODP:ResourceQuality.
ceon-resourceODP:isAbout a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Connecting the information to the object (physical, virtual, imaginary) that the information is about.";
                         rdfs:domain ceon-resourceODP:Information;
                         rdfs:label "is about".
ceon-resourceODP:isRealizationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Relates a thing, e.g. a digital object, or a physical object, to the information it is a realization of. C.f. a physical book that is the realization of a novel, or a pdf or Excel-file that is a realization of a certain data sheet.";
                                 rdfs:label "is realization of";
                                 rdfs:range ceon-resourceODP:Information.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.opengis.net/ont/geosparql#geoJSONLiteral> a rdfs:Datatype.
<http://www.opengis.net/ont/geosparql#gmlLiteral> a rdfs:Datatype.
<http://www.opengis.net/ont/geosparql#wktLiteral> a rdfs:Datatype.
xsd:date a rdfs:Datatype.
