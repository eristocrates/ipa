@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://aims.fao.org/aos/agrontology#>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.

("Chemicals"
 "Geographical country level"
 "Geographical above country level"
 "Geographical below country level"
 "Fishery related term"
 "Land Vocabulary") a rdf:List.
_:autos5868 a rdf:List.
_:autos5869 a rdf:List.
_:autos5870 a rdf:List.
_:autos5871 a rdf:List.
_:autos5872 a rdf:List.
("Acronym"
 "Common name for animals"
 "Common name for bacteria"
 "Common name for fungi"
 "Common name for plants"
 "Common name for viruses"
 "Taxonomic terms for animals"
 "Taxonomic terms for bacteria"
 "Taxonomic terms for fungi"
 "Taxonomic terms for plants"
 "Taxonomic terms for viruses") a rdf:List.
_:autos5875 a rdf:List.
_:autos5876 a rdf:List.
_:autos5877 a rdf:List.
_:autos5878 a rdf:List.
_:autos5879 a rdf:List.
_:autos5880 a rdf:List.
_:autos5881 a rdf:List.
_:autos5882 a rdf:List.
_:autos5883 a rdf:List.
_:autos5884 a rdf:List.
<http://aims.fao.org/aos/agrontology> dc:creator "Food and Agriculture Organization of the United Nations"@en,
                                                 "Organisation des Nations Unies pour l'alimentation et l'agriculture"@fr,
                                                 "Organización de las Naciones Unidas para la Alimentación y la Agricultura"@es,
                                                 "Продовольственная и сельскохозяйственная организация Объединенных Наций"@ru,
                                                 "منظمة الأغذية والزراعة للأمم المتحدة"@ar,
                                                 "联合国粮食及农业组织"@zh;
                                      dc:rights "CC-BY 4.0";
                                      dcterms:creator <https://www.wikidata.org/wiki/Q82151>;
                                      dcterms:licence <https://creativecommons.org/licenses/by/4.0/>;
                                      dcterms:modified "2023-12-01T17:27:42Z"^^xsd:dateTime;
                                      voaf:classNumber 3 ;
                                      voaf:dataset <http://aims.fao.org/aos/agrovoc>,
                                                   <http://aims.fao.org/aos/biotechglossary>;
                                      voaf:propertyNumber 168 ;
                                      a voaf:Vocabulary,
                                        owl:Ontology;
                                      owl:imports dc:,
                                                  dcterms:,
                                                  <http://www.w3.org/2008/05/skos-xl>.
:RangeOfHasTermType a rdfs:Datatype;
                    owl:equivalentClass [a rdfs:Datatype ; 
                                         owl:oneOf ()].
:RangeOfIsPartOfSubvocabulary a rdfs:Datatype;
                              owl:equivalentClass [a rdfs:Datatype ; 
                                                   owl:oneOf ()].
:actsUpon a owl:ObjectProperty;
          rdfs:label "Acts upon"@en;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isActedUponBy.
:affects a owl:ObjectProperty;
         rdfs:comment """X <afecta> Y. La acción del agente X cambia el estado o la ubicación de Y. Ej. \"Agotamiento del agua\" <afecta> \"Capa freática\", \"Daños mecánicos\" <afecta> \"Aptitud para el transporte\". No lo utilice para enfermedades o trastornos; para ellos, utilice <aflige/está afligido por>. """@es,
                      """X <affecte> Y. L'agent X agit sur l'objet Y de telle sorte que Y change d'état ou de localisation. Par exemple, \"tarissement\" <affecte> \"nappe souterraine\",  \"dégât mécanique\" <affecte> \"aptitude au transport\". Ne l'utilisez pas pour des maladies ou des désordres : pour ceux-là, utilisez <afflige/est affligé par>."""@fr,
                      """X <affects> Y. Action of agent X changes the state or location of Y. E.g. \"water depletion\" <affects> \"groundwater table\", \"mechanical damage\" <affects> “transporting quality”. Do not use for diseases or disorders; for those, use <afflicts/is afflicted by>. """@en,
                      """X <влияет на> Y. Действие агента X изменяет состояние или местоположение Y. Например, \"истощение водных ресурсов\" <влияет на> \"уровень грунтовых вод\", \"механические повреждения\" <влияют на> \"пригодность к транспортировке\". Не используйте для болезней или расстройств; для них используйте <поражает/на ... негативно влияет болезнь .....>. """@ru,
                      "X<影响> Y。媒介X的行为改变Y的状态或位置。例如：“水枯竭”<影响> “地下水位”，“机械损伤”<影响> “运输性能”。请勿用于疾病或病症；对于疾病和病症，使用<损害/受...损害>。"@zh,
                      """س <يؤثر على> ع. أي إجراء من العامل س يؤدي إلى تغيير حالة أو موقع ع
على سبيل المثال: \"نضوب المياه\" <يؤثر على> \"منسوب المياه الجوفية\"
\"الضرر الميكانيكي\" <يؤثر على> \"جودة النقل\"
لا تستخدم للأمراض أو الاضطرابات. لهؤلاء استخدم <afflicts / isAfflictedBy>."""@ar;
         rdfs:label "Afecta"@es,
                    "Affecte"@fr,
                    "Affects"@en,
                    "влияет на"@ru,
                    "يؤثر"@ar,
                    "影响"@zh;
         rdfs:subPropertyOf :causativeRelationship;
         owl:inverseOf :isAffectedBy.
:afflicts a owl:ObjectProperty;
          rdfs:comment """X <afflicts> Y. The disease or disorder X could have negative effects in Y, such as adversely affect the health of an organism or body part Y. E.g. \"scrapie\" <afflicts> \"sheep\", “glossitis” <afflicts> “tongue”."""@en,
                       """X <afflige> Y. La maladie ou le désordre X pourrait avoir des effets négatifs sur Y, tels que nuire à la santé d'un organisme ou d'une partie du corps Y. Par exemple, \"tremblante\" <afflige> \"mouton\", \"glossite\" <afflige> \"langue\". """@fr,
                       """X <aflige> Y. La enfermedad o el trastorno X podría tener efectos negativos en Y, como por ejemplo, afectar negativamente a la salud de un organismo o una parte del cuerpo Y. Ej. \"Scrapie\" <aflige> \"Ovinos\", “Glositis” <aflige> “Lengua”."""@es,
                       """X <поражает> Y. Болезнь или расстройство X может иметь негативные последствия для Y, например, отрицательно повлиять на здоровье организма или части тела Y. Например, \"скрейпи\" <поражает> \"овцы\", \"глоссит\" <поражает> \"язык\"."""@ru,
                       "X<损伤>Y。疾病或病症X可能对Y造成负面影响，如对生物体或身体部分Y的健康造成不利影响。例如：“羊瘙痒病”<损伤>“绵羊”，“舌炎”<损伤>“舌”。"@zh,
                       """س < يصيب > ع. يمكن أن يكون للمرض أو الاضطراب س آثار سلبية في ع. مثل التأثير سلبًا على صحة كائن حي أو جزء من الجسم ع
على سبيل المثال \"مرض سكرابي\" <يصيب> \"الخروف\" ،
 \"التهاب اللسان\" <يصيب> \"اللسان\".  """@ar;
          rdfs:label "Afflicts"@en,
                     "Afflige"@fr,
                     "Aflige"@es,
                     "поражает"@ru,
                     "لهجمات"@ar,
                     "损伤"@zh;
          rdfs:subPropertyOf :affects;
          owl:inverseOf :isAfflictedBy.
:benefitsFrom a owl:ObjectProperty;
              rdfs:comment """Y <benefitsFrom> X. A result Y  that is advantageous to some beneficiary, produced by the behaviour of an agent X. A consequence Y achieved through a means X. E.g. \"biological control\" <benefitsFrom> \"biological control arthropods\"; \"plant health\" <benefitsFrom> \"pest control\";"""@en;
              rdfs:label "Benefits from"@en;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :isBeneficialFor.
:causativeRelationship a owl:ObjectProperty,
                         owl:SymmetricProperty;
                       rdfs:comment "Super-property for causative relationships"@en,
                                    "Super-propriété pour les relations causales "@fr,
                                    "Superpropiedad de las relaciones causales"@es,
                                    "Сверхсвойство для причинно-следственных связей"@ru,
                                    "خاصية فائقة للعلاقات السببية"@ar,
                                    "所有引起关系的父类属性"@zh;
                       rdfs:domain skos:Concept;
                       rdfs:label "Causative relationship"@en,
                                  "Relaciones causales "@es,
                                  "Relations causales "@fr,
                                  "причинно-следственная связь"@ru,
                                  "العلاقات السببية"@ar,
                                  "引起关系"@zh;
                       rdfs:range skos:Concept;
                       rdfs:subPropertyOf skos:related.
:causes a owl:ObjectProperty;
        rdfs:comment """X  <causa> Y. El agente X (animado o inanimado) provoca un resultado Y. Ej. \"Priones\" <causa> \"Encefalopatía espongiforme\", \"Déficit de humedad en el suelo\"  <causa> \"Marchitamiento\"."""@es,
                     """X  <cause> Y. L'agent X (animé ou inanimé) produit un résultat Y. Par exemple, \"prion\" <cause> \"encéphalopathie spongiforme\", \"déficit d'humidité du sol\" <cause> \"fanaison\"."""@fr,
                     """X <causes> Y. Agent X (animate or inanimate) brings about a result Y. E.g. \"prions\" <causes> \"spongiform encephalopathy\", \"soil moisture deficit\" <causes> \"wilting\"."""@en,
                     """X <вызывает > Y. Агент X (одушевленный или неодушевленный) приводит к результату Y. Например, \"прионы\" <вызывает>  \"губкообразная энцефалопатия\", \"водный дефицит в почве\" <вызывает> \"увядание\"."""@ru,
                     "X<引起>Y。媒介X（生物或非生物）引起结果Y。例如：“朊病毒”<引起>“海绵状脑病”，“土壤水分亏缺”<引起>“萎蔫”。"@zh,
                     """س <يسبب> ع. العامل س (حي أو غير حي) يحقق نتيجة ع.
على سبيل المثال: \"البريونات\" <تسبب> \"الاعتلال الدماغي الاسفنجي\"
\"نقص في رطوبة التربة\" <يسبب> \"الذبول\""""@ar;
        rdfs:label "Causa"@es,
                   "Cause"@fr,
                   "Causes"@en,
                   "вызывает"@ru,
                   "الأسباب"@ar,
                   "引起关系"@zh;
        rdfs:subPropertyOf :causativeRelationship;
        owl:inverseOf :isCausedBy.
:compose a owl:ObjectProperty;
         rdfs:comment """Y -  <то, из чего состоит> X. Y - это материал или вещество, из которого состоит X. Например, \"микробная флора\" - <то, из чего состоит>  \"почвенная флора\", \"вулканогенные материалы\" - <то, из чего состоит>  \"туф (вулканический)."""@ru,
                      """Y <compone> X. Y es el material o sustancia de la que se compone X. Ej. Par exemple, \"Flora microbiana\" <compone> \"Flora del suelo\", \"Materiales volcánicos\" <compone> \"Toba\"."""@es,
                      """Y <compose> X. Y est le matériau ou la substance dont X est composé. Par exemple, \"flore microbienne\" <compose> \"flore du sol\", \"matériau volcanique\" <compose> \"tuff\"."""@fr,
                      """Y <compose> X. Y is the material or substance of which X is composed. E.g. “microbial flora” <compose> \"soil flora\", “volcanic materials” <compose> \"tuff\"."""@en,
                      "Y<组成>X。Y是组成X的材料或物质。例如：“微生物菌群”<组成>“土壤植物区系”，“火山灰物质”<组成>“凝灰岩”。"@zh,
                      """ع <يؤلف> س. ع هي الأداة أو المادة التي تتكون منها س.
على سبيل المثال: \"النباتات الجرثومية\" <تؤلف > \"نباتات التربة\"
\"مواد بركانية\" <تؤلف> \" صخر tuff\"
"""@ar;
         rdfs:label "Compone"@es,
                    "Compose"@en,
                    "Compose"@fr,
                    "то, из чего состоит"@ru,
                    "تتكون Y من "@ar,
                    "组成"@zh;
         rdfs:subPropertyOf :isPartOf;
         owl:inverseOf :isComposedOf.
:controls a owl:ObjectProperty;
          rdfs:label "Controls"@en;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isControlledBy.
:developsFrom a owl:ObjectProperty,
                owl:TransitiveProperty;
              rdfs:domain skos:Concept;
              rdfs:label "Develops from"@en;
              rdfs:subPropertyOf :temporalRelationship;
              owl:inverseOf :developsInto.
:developsInto a owl:ObjectProperty,
                owl:TransitiveProperty;
              rdfs:label "Develops into"@en;
              rdfs:subPropertyOf :temporalRelationship;
              owl:inverseOf :developsFrom.
:follows a owl:ObjectProperty;
         rdfs:domain skos:Concept;
         rdfs:label "Follows"@en;
         rdfs:range skos:Concept;
         rdfs:subPropertyOf :temporalRelationship;
         owl:inverseOf :precedes.
:formerlyIncludedIn a owl:ObjectProperty;
                    rdfs:comment "An inclusion that was valid in the past but currently is not valid anymore."@en;
                    rdfs:label "Formerly included in"@en;
                    rdfs:subPropertyOf :isIncludedIn;
                    owl:inverseOf :formerlyIncludes.
:formerlyIncludes a owl:ObjectProperty;
                  rdfs:label "Formerly includes"@en;
                  rdfs:subPropertyOf :includes;
                  owl:inverseOf :formerlyIncludedIn.
:greaterThan a owl:ObjectProperty;
             rdfs:label "Greater than"@en;
             rdfs:subPropertyOf :quantitativeRelationship;
             owl:inverseOf :smallerThan.
:growsln a owl:ObjectProperty;
         rdfs:comment """X <growsIn> Y. A taxon X grows in an environment Y. Use this in a plant and related domain (e.g. fungi). E.g. \"jasmine rice\" <growsIn> \"isarn region\"; \"rice\" <growsIn> \"moist soil\";"""@en;
         rdfs:label "Grows in"@en;
         rdfs:subPropertyOf :causativeRelationship;
         owl:inverseOf :isAGrowthEnvironmentFor.
:hasAbbreviation a owl:ObjectProperty;
                 rdfs:domain skosxl:Label;
                 rdfs:label "Has abbreviation"@en;
                 rdfs:subPropertyOf :hasSynonym;
                 owl:inverseOf :isAbbreviationOf.
:hasAcronym a owl:ObjectProperty;
            rdfs:comment """X <a l'acronyme> Y. Un acronyme est une abréviation formée des lettres initiales d'autres mots, souvent prononcées comme un mot.  Par exemple, “syndrome d'immunodéficience acquise\" <a l'acronyme>”sida (maladie)”. """@fr,
                         "X <has acronym> Y. An acronym is an abbreviation formed from the initial letters of other words, often pronounced as a word. E.g. “acquired immunodeficiency syndrome” <has acronym>”AIDS”. "@en,
                         """X <tiene acrónimo> Y. Un acrónimo es una abreviatura formada por las letras iniciales de otras palabras, a menudo pronunciadas como una palabra. Por ejemplo, \"Síndrome de inmunodeficiencia adquirida\" <tiene acrónimo> \"SIDA\". """@es,
                         """X <имеет акроним> Y. Акроним - это аббревиатура, образованная из начальных букв других слов, часто произносимых как одно слово. Например, \"синдром приобретенного иммунодефицита\" <имеет акроним> \"СПИД\". """@ru,
                         "X<有缩略语>Y。缩略语由其他单词首字母组成，通常读作一个词。例如：“获得性免疫缺陷综合征”<有缩略语>“艾滋病”。"@zh,
                         """س <لها الاختصار> ع. الاختصار هو اختصار يتكون من الأحرف الأولى للكلمات الأخرى ، وغالبًا ما يتم نطقه ككلمة. 
على سبيل المثال: \"متلازمة نقص المناعة المكتسبة\" <لها الاختصار> \"مرض الايدز\"."""@ar;
            rdfs:label "A l'acronyme"@fr,
                       "Has acronym"@en,
                       "Tiene acrónimo"@es,
                       "имеет акроним"@ru,
                       "له اختصار"@ar,
                       "有缩略语"@zh;
            rdfs:subPropertyOf :hasAbbreviation;
            owl:inverseOf :isAcronymOf.
:hasAntonym a owl:ObjectProperty,
              owl:SymmetricProperty;
            rdfs:label "Has antonym or Has opposite"@en;
            rdfs:subPropertyOf skos:related.
:hasBiologicalControlAgent a owl:ObjectProperty;
                           rdfs:label "Has biological control agent"@en;
                           rdfs:subPropertyOf :causativeRelationship;
                           owl:inverseOf :isBiologicalControlAgentOf.
:hasBreedingMethod a owl:ObjectProperty;
                   rdfs:label "Has breeding method"@en;
                   rdfs:subPropertyOf :causativeRelationship;
                   owl:inverseOf :isBreedingMethodOf.
:hasBroaderSynonym a owl:ObjectProperty;
                   rdfs:domain skosxl:Label;
                   rdfs:label "Has broader synonym"@en;
                   rdfs:range skosxl:Label;
                   rdfs:subPropertyOf :hasSynonym;
                   owl:inverseOf :hasNarrowerSynonym.
:hasChemicalFormula a owl:ObjectProperty;
                    rdfs:label "Has chemical formula"@en;
                    rdfs:subPropertyOf skosxl:labelRelation;
                    owl:inverseOf :isChemicalFormulaOf.
:hasCodeAsc a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:domain skosxl:Label;
            rdfs:label "Has ASC code"@en;
            rdfs:range xsd:string;
            rdfs:subPropertyOf skos:notation.
:hasCodeAsfa a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:domain skosxl:Label;
             rdfs:label "Has ASFA code"@en;
             rdfs:range xsd:string;
             rdfs:subPropertyOf skos:notation.
:hasCodeFaoPa a owl:DatatypeProperty,
                owl:FunctionalProperty;
              rdfs:domain skosxl:Label;
              rdfs:label "Has code in the schema FAO Priority Area"@en;
              rdfs:range xsd:string;
              rdfs:subPropertyOf skos:notation.
:hasCodeFaoterm a owl:DatatypeProperty,
                  owl:FunctionalProperty;
                rdfs:domain skosxl:Label;
                rdfs:label "Has FAO term code"@en;
                rdfs:range xsd:string;
                rdfs:subPropertyOf skos:notation.
:hasCodeFishery3Alpha a owl:DatatypeProperty,
                        owl:FunctionalProperty;
                      rdfs:domain skosxl:Label;
                      rdfs:label "Has fishery 3 alpha code"@en;
                      rdfs:range xsd:string;
                      rdfs:subPropertyOf skos:notation.
:hasCodeISO3Country a owl:DatatypeProperty,
                      owl:FunctionalProperty;
                    rdfs:comment "La Norme internationale des codes des noms de pays et de leurs subdivisions. Code alpha-3 – code à trois lettres utilisé pour la représentation des noms de pays, permettant une association visuelle avec le nom usuel du pays."@fr,
                                 "La norma internacional para los códigos de nombres de países y sus subdivisiones. Código Alfa-3: código de tres letras utilizado para la representación de nombres de países, que permite la asociación visual con el nombre común del país."@es,
                                 "The International Standard for country codes and codes for their subdivisions. Alpha-3 code – a three-letter code that represents a country name, which is usually more closely related to the country name"@en,
                                 "ИСО 3166 является международным стандартом для представления названий стран и единиц их административно-территориального деления."@ru,
                                 """المعيار الدولي لرموز الدول ورموز التقسيمات الفرعية الخاصة بهم.
رمز Alpha-3 - رمز مكون من ثلاثة أحرف يمثل اسم البلد ، والذي يكون عادةً أكثر ارتباطًا باسم البلد """@ar,
                                 "国家代码及其分区代码的国际标准。Alpha-3代码是代表国家名称的三位字母代码，通常更接近于国家名称。"@zh;
                    rdfs:domain skos:Concept;
                    rdfs:label "A le code pays ISO3"@fr,
                               "Has ISO 3 country code"@en,
                               "Tiene código ISO3 de país "@es,
                               "Имеет код страны ISO3"@ru,
                               "لديه رمز البلد ISO3 "@ar,
                               "有ISO3国家码"@zh;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf skos:notation.
:hasCodeTaxonomic a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:domain skosxl:Label;
                  rdfs:label "Has taxonomic code"@en;
                  rdfs:range xsd:string;
                  rdfs:subPropertyOf skos:notation.
:hasCommonNameConcept a owl:ObjectProperty;
                      rdfs:comment """Y <a nom commun de concept> X. Y est un concept scientifiquement défini pour un organisme ou un groupe d'organismes avec des noms scientifiques comme terme, ayant un rang taxonomique spécifique. \"Apis mellifera\" <a nom commun de concept> \"abeille domestique\". Utilisation au niveau du concept lorsque le nom commun et le nom scientifique sont des concepts distincts. Pour une relation terme à terme à utiliser dans un concept, utilisez <a nom scientifique/ est le nom scientifique>.
"""@fr,
                                   """Y <has common name concept> X. Y is a scientifically defined concept for an organism or a group of organisms with scientific name as labels, having a specific taxonomic rank. \"Apis mellifera” <has common name concept> “honey bees”. Use at concept level when common name and scientific name are separate concepts. For label-to-label relationship for use within a concept, use <has scientific name / scientific name of>. 
"""@en,
                                   """Y <tiene nombre común del concepto> X. Y es un concepto definido científicamente para un organismo o un grupo de organismos con nombre científico como etiquetas, que tiene un rango taxonómico específico. \"Apis mellifera\" <tiene nombre común del concepto> \"Abeja melífera\". Se utiliza a nivel de concepto cuando el nombre común y el nombre científico son conceptos separados. Para la relación de etiqueta a etiqueta para su uso dentro de un concepto, utilice <tiene nombre científico / es el nombre científico de>. 
"""@es,
                                   """Y <имеет обиходное название> X. Y - это научно определенное понятие для организма или группы организмов с научным названием в качестве меток, имеющих определенный таксономический ранг. \"Apis mellifera\" <имеет обиходное название> \"медоносные пчелы\". Используется на уровне понятия, когда обиходное название и научное название являются отдельными понятиями. Для связи между метками в пределах понятия используйте <имеет научное название/явлется научным названием>. """@ru,
                                   "Y<有常用名概念>X。Y是某一生物体或生物群X的学名概念，其标签为学名，具有特定的分类等级。“Apis mellifera”<有常用名概念>“蜜蜂”。当常用名和学名是独立的概念时，在概念层面使用。对于标签间关系，在同一个概念内使用<有学名/是...的学名>。"@zh,
                                   """ع <لها مفهوم الاسم الشائع> س. ع هو مفهوم محدد علميًا لكائن حي أو مجموعة من الكائنات الحية التي تحمل اسمًا علميًا كعلامات ، ولها رتبة تصنيفية محددة 
على سبيل المثال\"Apis mellifera\". <لها مفهوم الاسم الشائع> \"نحل العسل\".
يستخدم على مستوى المفهوم عندما يكون الاسم الشائع والاسم العلمي مفهومين منفصلين.
 لعلاقة التسمية إلى التسمية للاستخدام ضمن المفهوم ، استخدم <له اسم علمي / اسم علمي لـ>. """@ar;
                      rdfs:domain skos:Concept;
                      rdfs:label "A nom commun de concept"@fr,
                                 "Has common name concept"@en,
                                 "Tiene nombre común del concepto"@es,
                                 "имеет обиходное название"@ru,
                                 "له مفهوم الاسم الشائع"@ar,
                                 "有常用名概念"@zh;
                      rdfs:range skos:Concept;
                      rdfs:subPropertyOf :taxonomicRelationship;
                      owl:inverseOf :hasTaxonomicConcept.
:hasComponent a owl:ObjectProperty;
              rdfs:comment """Y <a le composant> X. Un objet X qui fait partie d'un Y entier et a également une existence indépendamment de Y. Par exemple, \"arbre\" <a le composant> \"feuille\", \"organe de véhicule\" <a le composant> \"moteur\"."""@fr,
                           """Y <has component> X. An object X that is a part of a whole Y and also has an existence independently from Y. E.g. \"trees\" <has component> \"leaves\",  \"vehicle systems\" <has component> \"engines\"."""@en,
                           """Y <tiene componente> X. Un objeto X que es una parte de un todo Y y tiene también una existencia independiente de Y. Ex. Par exemple, \"Árboles\" <tiene componente> \"Hojas\", \"Componentes del vehículo\" <tiene componente> \"Motores\". """@es,
                           """Y <имеет компонент> X. Объект X, который является частью целого Y и также имеет существование независимо от Y. Например, \"деревья\" <имеет компонент \"листья\", \"системы машин\" <имеет компонент> \"двигатели\"."""@ru,
                           "Y<有组成部分>X。物体X是整体Y的一部分，同时也独立于Y存在。例如：“树”<有组成部分>“叶”，“车辆系统”<有组成部分>“发动机”。"@zh,
                           """س <يحتوي على> ع. الكائن س هو جزء من ع بالكامل وله أيضاً وجود مستقل عن ع. 
على سبيل المثال: \"الأشجار\" <تحتوي على > \"الأوراق\"
\" منظومات المركبات\" <تحتوي على > \"المحركات\".
"""@ar;
              rdfs:label "A le composant"@fr,
                         "Has component"@en,
                         "Tiene componente"@es,
                         "имеет компонент"@ru,
                         "مكون"@ar,
                         "有组成部分"@zh;
              rdfs:subPropertyOf :hasPart;
              owl:inverseOf :isComponentOf.
:hasComposition a owl:ObjectProperty;
                rdfs:label "Has composition"@en;
                rdfs:subPropertyOf :partitiveRelationship;
                owl:inverseOf :isCompositionOf.
:hasControlMethod a owl:ObjectProperty;
                  rdfs:label "Has control method"@en;
                  rdfs:subPropertyOf :causativeRelationship;
                  owl:inverseOf :isControlMethodOf.
:hasCropingSystem a owl:ObjectProperty;
                  rdfs:label "Has cropping system"@en;
                  rdfs:subPropertyOf :causativeRelationship;
                  owl:inverseOf :isCropingSystemOf.
:hasCultivationProcess a owl:ObjectProperty;
                       rdfs:label "Has cultivation process"@en;
                       rdfs:subPropertyOf :processRelationship;
                       owl:inverseOf :isCultivationProcessOf.
:hasDisease a owl:ObjectProperty;
            rdfs:comment """ X <a la maladie> Y. L'organisme X peut avoir la maladie Y. Par exemple, \"Sorghum\" <a la maladie> \"charbon nu du sorgho\" . Relation entre l'organisme et la maladie."""@fr,
                         """X <has disease> Y. Organism X can have disease Y. E.g. “Sorghum” <has disease> “loose smut of sorghum”. Organism to disease relationship. 
"""@en,
                         """X <tiene la enfermedad> Y. El organismo X puede tener la enfermedad Y. Ej.  \"Sorghum” <tiene la enfermedad> “Carbón suelto del sorgo”. Relación organismo-enfermedad."""@es,
                         """X <имеет болезнь> Y. Организм X может иметь болезнь Y. Например, “Sorghum” <имеет болезнь> “мелкопузырчатая головня сорго”. Отношения между организмом и болезнью. 
"""@ru,
                         "X<有疾病>Y。生物体X可能会有疾病Y。例如：“高粱属”<有疾病>“高粱散黑粉病”。生物体-疾病关系。"@zh,
                         """س <لديه مرض> ع. يمكن أن يكون لدى الكائن س المرض ع.
على سبيل المثال: \"الذرة الرفيعة\" <لديها مرض> \"تفحم الذرة الرفيعة\".
علاقة الكائن الحي بالمرض."""@ar;
            rdfs:domain skos:Concept;
            rdfs:label "A la maladie"@fr,
                       "Has disease"@en,
                       "Tiene la enfermedad"@es,
                       "имеет болезнь"@ru,
                       "لديه مرض"@ar,
                       "有疾病"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :isDiseaseFor.
:hasDisorder a owl:ObjectProperty;
             rdfs:label "Has disorder"@en;
             rdfs:subPropertyOf :causativeRelationship;
             owl:inverseOf :isDisorderOf.
:hasGoalOrProcess a owl:ObjectProperty;
                  rdfs:comment """X <a le but ou le processus> Y. X a un objectif ou un processus prévu Y. Par exemple: \"service vétérinaire\" <a le but ou le processus> \"santé animale\", \"coupe de rajeunissement\" <a le but ou le processus> \"régénération naturelle\"."""@fr,
                               """X <has goal or process> Y. X has intended goal or  process Y. E.g. “veterinary services” <has goal or process> “animal health”, “coppicing” <has goal or process> “natural regeneration”. 
"""@en,
                               """X <tiene el objetivo o el proceso> Y. Ej. \"Servicios veterinarios\" <tiene el objetivo o el proceso> \"Sanidad animal\", \"Corta de renuevos\"  <tiene el objetivo o el proceso> \"Regeneración natural\"."""@es,
                               """X <направлен на> Y. X направлен на цель или процесс Y. Например, \"ветеринарные услуги\" <направлен на> \"здоровье животных\", \"рубки обновления\" <направлен на>  \"естественное возобновление\"."""@ru,
                               "X<有目标或过程>Y。X有预期的目标或过程Y。例如：“兽医服务”<有目标或过程>“家畜健康”，“矮林作业”<有目标或过程>“天然更新”。"@zh,
                               """س <لديه هدف أو عملية > ع.يحتوي س على الهدف المقصود أو العملية ع. 
على سبيل المثال \"الخدمات البيطرية\" <هدفها> \"صحة الحيوان\" . 
"""@ar;
                  rdfs:label "A le but ou le processus"@fr,
                             "Has goal or process"@en,
                             "Tiene el objetivo o el proceso"@es,
                             "направлен на"@ru,
                             "لديه الهدف"@ar,
                             "有目标或过程"@zh;
                  rdfs:subPropertyOf :processRelationship;
                  owl:inverseOf :isAchievedByMeansOf.
:hasHost a owl:ObjectProperty;
         rdfs:comment """X <a le vecteur ou l'hôte> Y.  X a un organisme hôte ou un vecteur Y. Par exemple, \"Plasmodium\" <A le vecteur ou l'hôte> \"Anopheles\". """@fr,
                      "X <has vector or host> Y.  X has organism host or vector  Y.  E.g. “Plasmodium” <has host> ”Anopheles”."@en,
                      "X <tiene huesped u vector> Y. X tiene el organismo huésped o vector Y. Ej. “Plasmodium” <tiene huesped u vector> ”Anopheles”."@es,
                      """X <имеет переносчика или хозяина> Y. X имеет организм-хозяина или организм-переносчика Y. Например, \"Plasmodium\" <имеет переносчика или хозяина> \"Anopheles\"."""@ru,
                      "X<有寄主>Y。X有生物寄主或传播媒介Y。例如：“疟原虫属”<有寄主>“按蚊属” 。"@zh,
                      """س <لديه ناقل أو مضيف> ع. س لديه الكائن الحي الناقل أو المضيف ع.
على سبيل المثال: \"المتصورة\" <لديها المضيف> \"بعوضة الملاريا\"."""@ar;
         rdfs:label "A le vecteur ou l'hôte "@fr,
                    "Has vector or host "@en,
                    "Tiene huésped u vector"@es,
                    "имеет переносчика или хозяина"@ru,
                    "لديه مضيف"@ar,
                    "有寄主"@zh;
         rdfs:subPropertyOf :causativeRelationship;
         owl:inverseOf :isHostFor.
:hasInfectionPart a owl:ObjectProperty;
                  rdfs:label "Has infection part"@en;
                  rdfs:subPropertyOf :causativeRelationship;
                  owl:inverseOf :isInfectedPartOf.
:hasLocalName a owl:ObjectProperty;
              rdfs:label "Has local name"@en;
              rdfs:subPropertyOf :hasSynonym;
              owl:inverseOf :isLocalNameOf.
:hasMember a owl:ObjectProperty;
           rdfs:comment """Y <a un membre> X. Un groupe social ou politique Y est constitué d'une ou plusieurs unités sociales ou politiques subsidiaires (groupe ou individu) X. Par exemple, \"Afrique francophone\" <a un membre> \"Bénin\", \"colonie d'abeilles\" <a un membre> \"abeille ouvrière\". Limiter l'utilisation aux unités géographiques/socio-politiques. Ne pas utiliser pour regrouper les organismes par utilisation, climat ou rang taxonomique."""@fr,
                        """Y <has member> X. A social or political group Y consists of one or more subsidiary social or political units (group or individual) X. E.g. \"Francophone Africa\" <has member> \"Benin\", \"bee colonies\" <has member> \"worker bees\". Limit use to geographical or socio-political units. Do not use for grouping organisms by use, climate, or taxonomic rank. Use <includes> / <included in> if describing spatial or temporal relation, if more loose than <has part/is part of>."""@en,
                        """Y <tiene miembro> X. Un grupo social o político Y se compone de una o más unidades sociales o políticas subsidiarias (grupo o individuo) X. Ej. \"Africa de habla francesa\" <tiene miembro> \"Bénin\", \"Colonia de abejas\" <tiene miembro> \"Abejas obrera\". Limitar el uso a unidades geográficas/sociopolíticas. No utilizar para agrupar organismos por uso, clima o rango taxonómico."""@es,
                        """Y <имеет члена> X. Социальная или политическая группа Y состоит из одной или более дочерних социальных или политических единиц (группы или индивида) X. Например, \"франкоязычная Африка\" <имеет члена> \"Бенин\", \"челиные семьи\" <имеет члена> \"рабочие пчелы\". Ограничьте использование географическими/социально-политическими единицами. Не используйте для группировки организмов по использованию, климату или таксономическому рангу. Используйте <включает/ входит в> при описании пространственных или временных отношений, если они более свободные, чем <имеет часть/является частью>."""@ru,
                        "Y <有成员>X。社会或政治团体Y由一个或多个附属的社会或政治单位（团体或个人）X组成。例如：“法语非洲”<有成员>“贝宁”，“蜜蜂群”<有成员>“工蜂”。限用于地理/社会政治单位。请勿用于按用途、气候或分类等级对生物体进行分组。对于空间或时间关系，使用<包含/包含于>，但比<有部分/是...的部分>更为松散。"@zh,
                        """ع <لديه عضو> س. تتكون المجموعة الاجتماعية أو السياسية ع من وحدة اجتماعية أو سياسية فرعية واحدة أو أكثر (مجموعة أو فرد) س.
على سبيل المثال: \"أفريقيا الناطقة باللغة الفرنسية\" <لديها العضو> بنن
\" مستعمرات النحل\" <لديها العضو > \"النحلات العاملات\".
قصر الاستخدام على الوحدات الجغرافية / الاجتماعية السياسية.
لا تستخدم لتجميع الكائنات الحية حسب الاستخدام أو المناخ أو الترتيب التصنيفي.
استخدم <تتضمن> / <مضمن في> إذا كنت تصف العلاقة المكانية أو الزمنية ، إذا كانت فضفاضة أكثر يستخدم <لها جزء / جزء من>. """@ar;
           rdfs:label "A un membre"@fr,
                      "Has member"@en,
                      "Tiene miembro"@es,
                      "имеет члена"@ru,
                      "لديه عضو"@ar,
                      "有成员"@zh;
           rdfs:subPropertyOf :partitiveRelationship;
           owl:inverseOf :isMemberOf.
:hasNarrowerSynonym a owl:ObjectProperty;
                    rdfs:domain skosxl:Label;
                    rdfs:label "Has narrower synonym"@en;
                    rdfs:range skosxl:Label;
                    rdfs:subPropertyOf :hasSynonym;
                    owl:inverseOf :hasBroaderSynonym.
:hasNaturalEnemy a owl:ObjectProperty;
                 rdfs:label "Has natural enemy"@en;
                 rdfs:subPropertyOf :causativeRelationship;
                 owl:inverseOf :isNaturalEnemyOf.
:hasNearSynonym a owl:ObjectProperty,
                  owl:SymmetricProperty;
                rdfs:label "Has near synonym"@en;
                rdfs:subPropertyOf :hasSynonym.
:hasObjectOfActivity a owl:ObjectProperty;
                     rdfs:comment """X <a objet d'activité> Y. Le concept X est au centre de l'activité Y. \"tonte\" <a objet d'activité> \"laine\", \"ratification\" <a objet d'activité> \"traité\"."""@fr,
                                  """X <has object of activity> Y. Activity X focuses on Y. E.g. “shearing” <has object of activity> “wool”, “ratification” <has object of activity> “treaties”.
"""@en,
                                  """X <tiene objeto de la actividad> Y. El concepto X es el foco de la actividad Y.Ej. “Esquileo” <tiene objeto de la actividad> “Lana”, “Ratificación” <tiene objeto de la actividad> “Tratados”.
 """@es,
                                  """X <имеет объект деятельности> Y. Действие X сосредоточено на Y. Например,  \"стрижка\" <имеет объект деятельности> \"шерсть\", \"ратификация\" <имеет объект деятельности> \"пакты\".
"""@ru,
                                  "X <有活动对象> Y。活动X关注对象Y。例如：“剪毛”<有活动对象>“羊毛”，“批准”<有活动对象>“条约”。"@zh,
                                  """س <له هدف النشاط> ع.  يركز النشاط س على ع. 
على سبيل المثال \"الجز\" <له هدف> \"الصوف\" ، 
\"التصديق\" <له هدف> \"المعاهدات\"."""@ar;
                     rdfs:label "A objet d'activité"@fr,
                                "Has object of activity"@en,
                                "Tiene objeto de la actividad"@es,
                                "имеет объект деятельности"@ru,
                                "له هدف النشاط"@ar,
                                "有活动对象"@zh;
                     rdfs:subPropertyOf :processRelationship;
                     owl:inverseOf :isObjectOfActivity.
:hasOldName a owl:ObjectProperty;
            rdfs:comment "X <a nom ancien> Y. À utiliser pour les étiquettes obsolètes, comme les anciens noms de pays. Par exemple, “Bulgaria”<a nom ancien>”République populaire de Bulgarie”. Utilisez uniquement entre les termes pour le même concept dans une langue spécifique. "@fr,
                         "X <has old name> Y. Use for obsolete labels, such as old names of countries. E.g. “Bulgaria”<has old name>”People’s Republic of Bulgaria”. Use only between labels for the same concept in a specific language."@en,
                         """X <tiene nombre antiguo> Y. Se utiliza para etiquetas obsoletas , como nombres antiguos de países. Por ejemplo, \"Bulgaria\" <tiene nombre antiguo> \"República Popular de Bulgaria\". Usar sólo entre etiquetas para el mismo concepto en un idioma específico.
"""@es,
                         """X <имеет старое название> Y. Используется для устаревших обозначений, например, старых названий стран. Например, \"Болгария\" <имеет старое название> \"Народная Республика Болгария\". Используется только между обозначениями для одного и того же понятия на определенном языке."""@ru,
                         "X<有曾用名>Y。用于过时的标签，如国家的旧名。例如：“保加利亚”<有曾用名>“保加利亚人民共和国”。限用于同一概念某一特定语言的不同标签。"@zh,
                         """س <له الاسم القديم> ع. يستخدم للتسميات القديمة ، مثل الأسماء القديمة للبلدان
على سبيل المثال:  \"بلغاريا\" <لها الاسم القديم> \"جمهورية بلغاريا الشعبية\"
تستخدم فقط بين التسميات لنفس المفهوم بلغة معينة.
"""@ar;
            rdfs:label "Has old name"@en,
                       "a nom ancien"@fr,
                       "tiene nombre antiguo"@es,
                       "имеет старое название"@ru,
                       "له اسم قديم"@ar,
                       "有曾用名"@zh;
            rdfs:subPropertyOf :hasSynonym;
            owl:inverseOf :isOldNameOf.
:hasParent a owl:ObjectProperty;
           rdfs:label "Has parent"@en;
           rdfs:subPropertyOf skos:related;
           owl:inverseOf :isParentOf.
:hasPart a owl:ObjectProperty;
         rdfs:comment """ X <a partie> Y.  Une entité composite X qui peut être identifiée comme composée d'une ou plusieurs parties, entre lesquelles Y. Par exemple, \"tige\" <a partie> \"cortex\", \"racine\" <a partie> \"nodosité racinaire\". Utilisez cette relation lorsqu'aucune des autres relations partitives inférieures (<a le composant>, <est composé de>, <membre de>) ne s'applique."""@fr,
                      "X <has part> Y. A composite entity X that can be identified as being composed of one or more parts, between which Y. E.g. “stems” <has part> “cortex”, “roots” <has part>“root nodules”. Use this relationship when none of the other lower partitive relations (<has component>, <is composed of>, <member>) apply. "@en,
                      """X <tiene parte> Y. Una entidad compuesta X que puede ser identificada como compuesta por una o más partes, entre las cuales Y. Por ejemplo, \"Tallos\" <tiene parte> \"Cortex\", \"Raíces\" <tiene parte> \"Nudosidades radiculares\". Utilice esta relación cuando ninguna de las otras relaciones partitivas inferiores (<tiene componente>, <está compuesto de>, <miembro>)  sea aplicable. """@es,
                      """X <имеет часть> Y. Составная сущность X, которая может быть идентифицирована как состоящая из одной или более частей, между которыми Y. Например, \"стебли\" <имеет часть> \"кортекс\", \"корни\" <имеет часть> \"корневые клубеньки\". Используйте это отношение, когда ни одно из других низших партитивных отношений (<имеет компонент>, <состоит из>, <является членом>) не применимо. """@ru,
                      "X<有部分>Y。复合实体X可被认定为由一个或多个部分组成，其中包括Y。例如：“茎”<有部分>“皮层”，“根”<有部分>“根节结”。用于其他下位整体部分关系（<有组成部分>，<是...的组成部分>，<是...的成员>）都不适用时。"@zh,
                      """س <له جزء> ع. الكيان المركب س يمكن تحديده على أنه مكون من جزء واحد أو أكثر ، بينها ع. 
على سبيل المثال: \"الساق\" <لها جزء>\" القشرة\"
\"الجذور\" <لها جزء> \"عقد الجذور\".
استخدم هذه العلاقة عندما لا تنطبق أي من العلاقات الجزئية السفلية الأخرى (<لها مكون> ، <مكون من> ، <عضو>). """@ar;
         rdfs:label "A partie"@fr,
                    "Has part"@en,
                    "Tiene parte"@es,
                    "имеет часть"@ru,
                    "لديه جزء"@ar,
                    "有部分"@zh;
         rdfs:subPropertyOf :partitiveRelationship;
         owl:inverseOf :isPartOf.
:hasPathogen a owl:ObjectProperty;
             rdfs:comment """X <a l'agent pathogène> Y. L'organisme X a un agent pathogène Y. Les agents pathogènes sont des microorganismes pathogènes tels que : des virus, des bactéries et des champignons. Par exemple, \"Olea europaea\" <a l'agent pathogène> \"Xylella fastidiosa\"."""@fr,
                          """X <has pathogen> Y. Organism X has pathogen Y. Pathogens are pathogenic microorganism such as viruses, bacteria and fungi. E.g. \"Olea europaea\" <has pathogen> \"Xylella fastidiosa\"."""@en,
                          """X <tiene patógeno> Y. El organismo X tiene el patógeno Y. Los patógenos son microorganismos patógenos como virus, bacterias y hongos. Ej. \"Olea europaea\" <tiene patógeno> \"Xylella fastidiosa\".
"""@es,
                          """X <имеет патоген> Y. Организм X имеет патоген Y. Патогены - это патогенные микроорганизмы, такие как вирусы, бактерии и грибы. Например, \"Olea europaea\" <имеет патоген> \"Xylella fastidiosa\". 
"""@ru,
                          "X<有病原体>Y。生物体X有病原体Y。病原体指病毒、细菌和真菌等致病性微生物。例如：“Olea europaea”<有病原体>“Xylella fastidiosa”。"@zh,
                          """س <لديه مسببات مرض> ع. الكائن الحي لديه مسببات مرض ع. مسببات الأمراض هي الكائنات الحية الدقيقة المسببة للأمراض مثل الفيروسات والبكتيريا والفطريات 
على سبيل المثال: \"Olea europaea \"<لديها مسببات مرض>\" Xylella fastidiosa \" """@ar;
             rdfs:label "A l'agent pathogène"@fr,
                        "Has pathogen"@en,
                        "Tiene patógeno"@es,
                        "имеет патоген"@ru,
                        "لديه مسببات الأمراض"@ar,
                        "有病原体"@zh;
             rdfs:subPropertyOf :causativeRelationship;
             owl:inverseOf :isPathogenOf.
:hasPest a owl:ObjectProperty;
         rdfs:comment """Y <a peste> X. Un organisme Y dans lequel le ravageur X cause des dommages. Les ravageurs sont des insectes, des nématodes et des rongeurs qui causent des dommages. Par exemple, \"Apis mellifera\" <a peste> \"Varroa destructor\", \"Olea europaea\" <a peste> \"Bactrocera oleae\". 
"""@fr,
                      """Y <has pest> X. An organism Y in which the pest X causes harm. Pests are insects, nematodes and rodents that cause damage. E.g. \"Apis mellifera\" <has pest> \"Varroa destructor\", \"Olea europaea\" <has pest> \"Bactrocera oleae\"."""@en,
                      """Y <tiene plaga> X. Un organismo Y en el que la plaga X causa daños. Las plagas son insectos, nematodos y roedores que causan daños. Ej. \"Apis mellifera\" <tiene plaga> \"Varroa destructor\", \"Olea europaea\" <tiene plaga> \"Bactrocera oleae\".
"""@es,
                      "Y<有有害生物>X。有害生物X对生物体Y造成损害。有害生物指造成损害的昆虫、线虫和啮齿动物。例如：“西方蜜蜂”<有有害生物>“Varroa destructor”，“Olea europaea”<有有害生物>“油橄榄果实蝇”。"@zh,
                      """У Y <имеется вредитель> X. Организм Y, которому вредитель X причиняет вред. Вредители - это насекомые, нематоды и грызуны, которые причиняют вред. Например, У \"Apis mellifera\" <имеется вредитель> \"Varroa destructor\", У \"Olea europaea\" <имеется вредитель> \"Bactrocera oleae\".
"""@ru,
                      """ع <لديه الآفة> س. الكائن الحي ع الذي تسبب فيه الآفة س الضرر. الآفات هي الحشرات والديدان الخيطية والقوارض التي تسبب الضرر.
على سبيل المثال:   \"Apis mellifera\" < لديه الآفة> \"Varroa destructor\",
\"Olea europaea\"  <لديه الآفة> \"Bactrocera oleae\"."""@ar;
         rdfs:label "A peste"@fr,
                    "Has pest"@en,
                    "Tiene plaga"@es,
                    "У ... имеется вредитель ..."@ru,
                    "لديه آفة"@ar,
                    "有有害生物"@zh;
         rdfs:subPropertyOf :causativeRelationship;
         owl:inverseOf :pestOf.
:hasPhysiologicalFunction a owl:ObjectProperty;
                          rdfs:label "Has physiological function"@en;
                          rdfs:subPropertyOf :causativeRelationship;
                          owl:inverseOf :isPhysiologicalFunctionOf.
:hasPlural a owl:DatatypeProperty;
           rdfs:domain skosxl:Label;
           rdfs:label "Has plural"@en.
:hasPostProductionPractice a owl:ObjectProperty;
                           rdfs:label "Has post-production practice"@en;
                           rdfs:subPropertyOf :hasPractice;
                           owl:inverseOf :isPostProductionPracticeFor.
:hasPractice a owl:ObjectProperty;
             rdfs:label "Has practice"@en;
             rdfs:subPropertyOf :causativeRelationship;
             owl:inverseOf :isPracticeFor.
:hasProduct a owl:ObjectProperty;
            rdfs:comment """ X <a le produit> Y. X est la source du produit Y, avec un élément de traitement. Par exemple: \"exploitation forestière\" <a le produit> \"déchet d'exploitation forestière\",  \"Espagne\" <a le produit> \"xérès\"."""@fr,
                         "X <has product> Y. X is the source of product Y, with a processing element. E.g. “logging”<has product> “logging wastes”, “Spain” <has product> “sherry”."@en,
                         "X <tiene el producto> Y. X es la fuente del producto Y, con un elemento de procesamiento. Ej. “Aprovechamiento de la madera” <tiene el producto> “Residuos de explotación forestal”, “España” <tiene el producto> “Jerez”."@es,
                         """X <имеет продукт> Y. X является источником продукта Y, с элементом переработки. Например, \"брожение\" <имеет продукт> \"ферментированные продукты\", \"Испания\" <имеет продукт> \"херес\"."""@ru,
                         "X<有产品>Y。X是产品Y的来源，其中有加工处理的要素。例如：“森林采运”<有产品>“砍伐损失”，“ 西班牙”<有产品>“雪利酒”。"@zh,
                         """س <لديه المنتج> ع. س هو مصدر المنتج ع مع عنصر معالجة.
على سبيل المثال: \"قطع الجذور\" <لديه المنتج> \"نفايات قطع الأخشاب\"
اسبانيا <لديها المنتج> الخمر شيري"""@ar;
            rdfs:label "A le produit"@fr,
                       "Has product"@en,
                       "Tiene el producto"@es,
                       "имеет продукт"@ru,
                       "لديه المنتج"@ar,
                       "有产品"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :productOf.
:hasPropagationMaterial a owl:ObjectProperty;
                        rdfs:label "Has propagation material"@en;
                        rdfs:subPropertyOf :causativeRelationship;
                        owl:inverseOf :isPropagationMaterialOf.
:hasPropagationProcess a owl:ObjectProperty;
                       rdfs:label "Has Propagation process"@en;
                       rdfs:subPropertyOf :causativeRelationship;
                       owl:inverseOf :isPropagationProcessOf.
:hasProperty a owl:ObjectProperty;
             rdfs:comment """X <a la propriété> Y. Une propriété peut être une qualité ou un trait. Par exemple, \"semence\" <a la propriété> \"grosseur des semences\",  \"plante médicinale\" <a la propriété> \"propriété pharmacologique\"."""@fr,
                          """X <has property> Y. A property might be a quality or trait. E.g. “seed” <has property> “seed size\", “medicinal plants” <has property> “medicinal properties”."""@en,
                          """X <tiene propriedad> Y. Una propiedad puede ser una cualidad o un rasgo. Ej. “Semillas” <tiene propriedad> “Tamaño de la semilla\", “Plantas medicinales” <tiene propriedad> “Propiedades medicinales”."""@es,
                          """X <обладает свойством> Y. Свойство может быть качеством или признаком. Например, \"семенной материал\" <обладает свойством> \"крупность семян\", \"лекарственные растения\" <обладает свойством> \"фармакологические свойства\".
"""@ru,
                          "X<有属性>Y。属性可以是一种性质或特点。例如：“种子”<有属性>“种子大小”和“种子活力”，“药用植物类” <有属性>“药物属性”。"@zh,
                          """س <لديه خاصية> ع. الخاصية قد تكون جودة أو ميزة.
على سبيل المثال: البذرة\"<لديها خاصية> \"حجم البذرة\"
\"النباتات الطبية\" <لديها خاصية> \"الخصائص الطبية\""""@ar;
             rdfs:label "A la propriété"@fr,
                        "Has property"@en,
                        "Tiene propriedad"@es,
                        "обладает свойством"@ru,
                        "لديه ممتلكات"@ar,
                        "有属性"@zh;
             rdfs:subPropertyOf :causativeRelationship;
             owl:inverseOf :isPropertyOf.
:hasScientificName a owl:ObjectProperty;
                   rdfs:comment """X <a nom scientifique> Y. Par exemple, \"truite de mer\" <a nom scientifique> \"Salmo trutta\". Relation concept à concept à utiliser dans un concept. À utiliser lorsque le nom commun et le nom scientifique ne sont pas des concepts distincts, ou lorsqu'une relation distincte entre le nom scientifique et le nom commun est nécessaire pour une langue spécifique. Lorsque le nom commun et le nom scientifique sont des concepts distincts, utilisez la relation de concept à concept <a concept taxonomique /a nom commun de concept>."""@fr,
                                """X <has scientific name> Y. E.g. “sea trout” <has scientific name> \"Salmo trutta”. Label-to-label relationship for use within a concept. Use when common name and scientific name are not separate concepts, or when a separate relation between scientific and common name is needed for a specific language. When common name and scientific name are separate concepts, use concept-to-concept relation <has taxonomic concept/has common name concept>."""@en,
                                """X <tiene nombre científico> Y. Ej. \"Trucha de mar\" <tiene nombre científico> \"Salmo trutta\". Relación de etiqueta a etiqueta para su uso dentro de un concepto. Se utiliza cuando el nombre común y el nombre científico no son conceptos separados, o cuando se necesita una relación separada entre el nombre científico y el nombre común para un idioma específico. Cuando el nombre común y el nombre científico son conceptos separados, utilice la relación de concepto a concepto <tiene concepto taxonómico/tiene nombre común del concepto>."""@es,
                                """X <имеет научное название> Y. Например, \"морская форель\" <имеет научное название> \"Salmo trutta\". Отношения между метками для использования внутри понятия. Используется, когда обычное название и научное название не являются отдельными понятиями, или когда отдельное отношение между научным и обычным названием необходимо для конкретного языка. Когда обычное название и научное название являются отдельными понятиями, используйте отношение между понятиями <имеет  таксономическое понятие/имеет обиходное название>."""@ru,
                                "X<有学名>Y。例如：“褐鳟”<有学名>“Salmo trutta”。可用于同一概念内的标签间关系。当俗名和学名不是独立的概念，或者当特定的语言需要在学名和俗名之间建立单独的关系时使用。当俗名和学名是独立的概念时，使用概念间关系<有分类学概念/有常用名概念>。"@zh,
                                """س <لها الاسم العلمي> ع. 
على سبيل المثال:  \"التروت البحري\" <له الاسم العلمي> \"Salmo trutta”
علاقة التسمية إلى التسمية للاستخدام داخل المفهوم.
يستخدم عندما لا يكون الاسم الشائع والاسم العلمي مفهومين منفصلين ، أو عندما تكون هناك حاجة لعلاقة منفصلة بين الاسم العلمي والاسم الشائع للغة معينة. عندما يكون الاسم الشائع والاسم العلمي مفهومين منفصلين ، استخدم علاقة المفهوم بالمفهوم <له مفهوم تصنيفي / له مفهوم اسم شائع>. """@ar;
                   rdfs:label "A nom scientifique"@fr,
                              "Has scientific name"@en,
                              "Tiene nombre científico"@es,
                              "имеет научное название"@ru,
                              "له اسم علمي"@ar,
                              "有学名"@zh;
                   rdfs:subPropertyOf :hasSynonym;
                   owl:inverseOf :scientificNameOf.
:hasSingular a owl:DatatypeProperty;
             rdfs:domain skosxl:Label;
             rdfs:label "Has singular"@en.
:hasSubstitute a owl:ObjectProperty;
               rdfs:label "Has substitute"@en;
               rdfs:subPropertyOf skos:related;
               owl:inverseOf :isSubstituteFor.
:hasSymbol a owl:ObjectProperty;
           rdfs:comment """X <a le symbole> Y. \"fer\" <a le symbole> \"Fe (symbole)\". À utiliser pour lever l'ambiguïté des symboles d'éléments chimiques à partir d'autres abréviations similaires. """@fr,
                        "X <has symbol> Y. “iron” has symbol ”Fe (symbol)”. Use for disambiguation of chemical element symbols from other similar abbreviations."@en,
                        """X <tiene símbolo> Y. \"Hierro\" <tiene símbolo> \"Fe (símbolo)\". Se utiliza para desambiguar los símbolos de elementos químicos de otras abreviaturas similares."""@es,
                        """X <обозначается символом> Y. \"железо\" обозначается символом  \"Fe\". Используется, чтобы отличить символы химических элементов от других подобных сокращений."""@ru,
                        "X<有符号>Y。“铁”<有符号>“Fe(元素)”。用于化学元素符号与其他类似缩写的消歧。"@zh,
                        """س <لها الرمز الكيميائي> ع.
على سبيل المثال: \" الحديد\" <لها الرمز الكيميائي> \"Fe\"
يستخدم لتوضيح رموز العناصر الكيميائية من الاختصارات المشابهة الأخرى."""@ar;
           rdfs:label "A le symbole"@fr,
                      "Has symbol"@en,
                      "Tiene símbolo"@es,
                      "обозначается символом"@ru,
                      "لها الرمز الكيميائي"@ar,
                      "有符号"@zh;
           rdfs:subPropertyOf :hasSynonym;
           owl:inverseOf :isSymbolFor.
:hasSymptom a owl:ObjectProperty;
            rdfs:comment """X <a symptôme> Y. Une maladie ou un désordre X présente une maladie caractéristique Y dans un organisme. Par exemple, \"malnutrition\" <a symptôme> \"maigreur\", \"septicémie\" <a symptôme> \"choc septique\". """@fr,
                         """X <has symptom> Y. A disease or disorder X presents disease characteristic Y in an organism. E.g. \"malnutrition\" <has symptom> \"thinness\", \"septicaemia\" <has symptom> \"septic shock\". """@en,
                         """X <tiene síntoma> Y. Una enfermedad o trastorno X presenta la característica de enfermedad Y en un organismo. Ej. \"Malnutrición\" <tiene síntoma> \"Delgadez\", \"Septicemia\" <tiene síntoma> \"Shock séptico\". """@es,
                         """X <имеет симптом> Y. Заболевание или расстройство X представляет характеристику болезни Y в организме. Например,  \"септицемия\" <имеет симптом> \"септический шок\"."""@ru,
                         "X<有症状>Y。疾病或病症X在生物体内显示出疾病特征Y。例如：“营养不良”<有症状>“体瘦”，“败血症”<有症状>“感染性休克”。"@zh,
                         """س <لديه أعراض> ع. المرض او الاضطراب س يعرض سمة المرض ع في كائن حي.
على سبيل المثال: \"سوء التغذية\" <لديها أعراض> \"النحافة\"،
\" التسمم الدموي\" <لديه أعراض> \" الصدمة الانتانية\""""@ar;
            rdfs:domain skos:Concept;
            rdfs:label "A symptôme"@fr,
                       "Has symptom"@en,
                       "Tiene síntoma"@es,
                       "имеет симптом"@ru,
                       "له أعراض"@ar,
                       "有症状"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :indicates.
:hasSynonym a owl:ObjectProperty,
              owl:SymmetricProperty;
            rdfs:comment "X <a le synonyme> Y. Y <a le synonyme> X .“Bulgarie” <a le synonyme> ”République de Bulgarie”. Utilisé pour distinguer un synonyme exact et actuel des termes obsolètes qui auraient pu être utilisés dans le passé (pour cela, utiliser <a nom ancien>). "@fr,
                         "X <has synonym> Y. Y <has synonym> X. “Bulgaria”<has synonym>”Republic of Bulgaria”. Used to distinguish an exact and current synonym from obsolete terms which might have been used in the past (for that, use <has old name>). Use only between labels for the same concept in a specific language."@en,
                         """X <tiene sinónimo> Y. Y <tiene sinónimo> X. \"Bulgaria\" <tiene sinónimo> \"República de Bulgaria\". Se utiliza para distinguir un sinónimo exacto y actual de los términos obsoletos que pudieran haberse utilizado en el pasado (para ello, utilice <tiene nombre antiguo>). Se utiliza sólo entre etiquetas para el mismo concepto en un idioma específico."""@es,
                         """X <имеет синоним> Y. Y <имеет синоним> X. \"Болгария\" <имеет синоним> \"Республика Болгария\". Используется, чтобы отличить точный и актуальный синоним от устаревших терминов, которые могли использоваться в прошлом (для этого используйте hasOldName). Используется только между обозначениями одного и того же понятия на определенном языке."""@ru,
                         "X<有同义词>Y。Y<有同义词>X。“保加利亚”<有同义词>“保加利亚共和国”。 用于区分准确的、目前的同义词和过去的、可能使用过的过时的术语（对于后者，使用<有曾用名>）。限用于同一概念某一特定语言的不同标签。"@zh,
                         """س <له المرادف> ع. ع <له المرادف> س
على سبيل المثال: \"بلغاريا\" <لها المرادف> \"جمهورية بلغاريا\"
يستخدم لتمييز المرادف الدقيق والحالي عن المصطلحات القديمة التي ربما تم استخدامها في الماضي (لذلك ، استخدم <له اسم قديم>). استخدم فقط بين التسميات لنفس المفهوم بلغة معينة"""@ar;
            rdfs:domain skosxl:Label;
            rdfs:label "A le synonyme"@fr,
                       "Has synonym"@en,
                       "Tiene sinónimo"@es,
                       "химеет синоним"@ru,
                       "له مرادف"@ar,
                       "有同义词"@zh;
            rdfs:range skosxl:Label;
            rdfs:subPropertyOf skosxl:labelRelation.
:hasTaxonomicConcept a owl:ObjectProperty;
                     rdfs:comment """X <a concept taxonomique> Y. X est un concept de nom commun pour un organisme ou un groupe d'organismes. Y est le nom de concept scientifiquement défini pour le même organisme ou un groupe d'organismes, ayant un rang taxonomique spécifique. Par exemple, \"abeille domestique\" <a concept taxonomique> \"Apis mellifera\". À utiliser au niveau du concept lorsque le nom commun et le nom scientifique sont des concepts distincts. Pour une relation terme à terme à utiliser dans un concept, utilisez <a nom scientifique/ est le nom scientifique>."""@fr,
                                  "X <has taxonomic concept> Y.  X is a common name concept for an organism or organism group. Y is the scientifically defined concept name for the same organism or a group of organisms, having a specific taxonomic rank. E.g. “honey bees” <has taxonomic concept> ”Apis mellifera”. Use at concept level when common name and scientific name are separate concepts. For label-to-label relationship for use within a concept, use <has scientific name / scientific name of>. "@en,
                                  """X <tiene concepto taxonómico> Y. X es un concepto de nombre común para un organismo o grupo de organismos. Y es el nombre conceptual definido científicamente para el mismo organismo o grupo de organismos, que tiene un rango taxonómico específico. Por ejemplo, \"Abeja melífera\" <tiene concepto taxonómico> \"Apis mellifera\". Se utiliza a nivel de concepto cuando el nombre común y el nombre científico son conceptos separados. Para la relación de etiqueta a etiqueta para su uso dentro de un concepto, utilice <tiene nombre científico / es el nombre científico de>."""@es,
                                  """X <имеет таксономическое понятие> Y. X - это обиходное название для организма или группы организмов. Y - это научно определенное название понятия для того же организма или группы организмов, имеющее определенный таксономический ранг. Например, \"медоносные пчелы\" <имеет таксономическое понятие> \"Apis mellifera\". Используется на уровне понятий, когда обиходное название и научное название являются отдельными понятиями. Для связи между метками в пределах понятия используйте <имеет научное название /является научным названием>. """@ru,
                                  "X<有分类学概念>Y。X是某一生物体或生物体组别的常用名概念。Y是同一生物体或生物群的学名概念，有特定的分类等级。 例如：“蜜蜂”<有分类学概念>“Apis mellifera”。当常用名和学名是独立的概念时，在概念层面使用。对于标签间关系，在同一个概念内使用<有学名/是...的学名>。"@zh,
                                  """س <لها مفهوم تصنيفي> ع. س هو مفهوم الاسم الشائع لكائن أو مجموعة الكائن. ع هو اسم المفهوم المحدد علمياً لنفس الكائن الحي أو لمجموعة من الكائنات ، لها رتبة تصنيفية محددة.
على سبيل المثال \"نحل العسل\" <له مفهوم التصنيف> \"Apis mellifera\".
يستخدم على مستوى المفهوم عندما يكون الاسم الشائع والاسم العلمي مفهومين منفصلين.
 لعلاقة التسمية إلى التسمية للاستخدام ضمن المفهوم ، استخدم <له اسم علمي / اسم علمي لـ>. """@ar;
                     rdfs:domain skos:Concept;
                     rdfs:label "A concept taxonomique"@fr,
                                "Has taxonomic concept"@en,
                                "Tiene concepto taxonómico"@es,
                                "имеет таксономическое понятие"@ru,
                                "مفهوم التصنيف"@ar,
                                "有分类学概念"@zh;
                     rdfs:range skos:Concept;
                     rdfs:subPropertyOf :taxonomicRelationship;
                     owl:inverseOf :hasCommonNameConcept.
:hasTaxonomicRank a owl:ObjectProperty;
                  rdfs:comment """X <a le rang taxonomique> Y. Décrit le rang taxonomique Y de l'organisme X. \"Spodoptera frugiperda\" <a le rang taxonomique> \"espèce (taxon)\" """@fr,
                               "X <has taxonomic rank> Y. Describes taxonomic rank Y of organism X. “Spodoptera frugiperda” <has taxonomic rank> “species (taxa)”. "@en,
                               """X <tiene el rango taxonómico> Y. Describe el rango taxonómico Y del organismo X. Ej. \"Spodoptera frugiperda\" <tiene el rango taxonómico>  \"Especie (taxón)\". """@es,
                               """X <имеет таксономический ранг> Y. Описывает таксономический ранг Y организма X. \"Spodoptera frugiperda\" <имеет таксономический ранг> \"вид (таксон)\"."""@ru,
                               "X<有分类等级>Y。描述了生物体X的分类等级Y。例如：“草地贪夜蛾”<有分类等级>“物种(分类单位)”。"@zh,
                               """س <لها مرتبة تصنيفية في> ع. تصف المرتبة التصنيفية ع الكائن الحي س.
على سبيل المثال:  \"Spodoptera frugiperda\" <لها مرتبة تصنيفية في> \"الأنواع (نظام التصنيف)\".
"""@ar;
                  rdfs:label "A le rang taxonomique"@fr,
                             "Has taxonomic rank"@en,
                             "Tiene el rango taxonómico"@es,
                             "имеет таксономический ранг"@ru,
                             "لديها المرتبة التصنيفية"@ar,
                             "有分类等级"@zh;
                  rdfs:subPropertyOf :taxonomicRelationship;
                  owl:inverseOf :isTaxonomicRankOf.
:hasTermType a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:domain skosxl:Label;
             rdfs:label "Has term type"@en;
             rdfs:range :RangeOfHasTermType.
:hasTheme a owl:ObjectProperty;
          rdfs:comment "From CWR ontology."@en;
          rdfs:label "Has theme"@en;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isThemeOf.
:hasTradeName a owl:ObjectProperty;
              rdfs:label "Has trade name, has commercial name"@en;
              rdfs:subPropertyOf :hasSynonym;
              owl:inverseOf :isTradeNameOf.
:hasTransliteration a owl:ObjectProperty;
                    rdfs:domain skosxl:Label;
                    rdfs:label "Has transliteration"@en;
                    rdfs:subPropertyOf skosxl:labelRelation;
                    owl:inverseOf :isTransliterationOf.
:hasType a owl:ObjectProperty;
         rdfs:comment """El concepto X tiene tipos Y. <tiene tipo> es más amplio y bastante similar a <skos:broader>, pero no es exclusivo.  Ej. \"Aires del caballo\" <tiene tipo> \"Galope\", pero también los elefantes y los camellos pueden galopar."""@es,
                      """X <a le type> Y. Le concept X a des types Y. <a le type> est plus large et assez similaire à <skos:broader>, mais il n'est pas exclusif.  Par exemple, \"allure de cheval\" <a le type> \"galop\", mais aussi les éléphants et les chameaux peuvent galoper."""@fr,
                      "X <has type> Y. Concept X has types Y. <type of> is broader and quite similar to <skos:broader>, but  it is not exclusive.  E.g. “horse gaits” <has type> “gallop”, but also elephants and camels can gallop."@en,
                      """X <имеет разновидность > Y. Понятие X имеет разновидности Y. Связь <имеет разновидность> шире и очень похожа на <skos:broader>, но не является исключительной.  Например, \"походки лошади\" <имеет разновидность> \"галоп\", но также слоны и верблюды могут скакать галопом."""@ru,
                      "X<有类型>Y。概念X有类型Y。<有类型>的范围更广，与<skos:broader>十分相似，但不具有排他性。例如：“马的步态”<有类型>“驰骋”，但大象和骆驼也可以驰骋。"@zh,
                      """س <لديه النمط> ع. للمفهوم س الأنماط ع.<نمط من> أوسع ويشبه تمامًا <skos: أوسع> ، لكنه ليس حصريًا
على سبيل المثال: \"مشي الخيل\" <لديها نمط> \"العدو السريع\"، ولكن أيضاً الفيلة والإبل يمكنها العدو السريع"""@ar;
         rdfs:label "A le type"@fr,
                    "Has type"@en,
                    "Tiene tipo"@es,
                    "имеет разновидность"@ru,
                    "لديه نوع"@ar,
                    "有类型"@zh;
         rdfs:subPropertyOf :partitiveRelationship;
         owl:inverseOf :typeOf.
:hasVariety a owl:ObjectProperty,
              owl:SymmetricProperty;
            rdfs:comment "Simmetric relationship indicating that two concepts are variety each other."@en;
            rdfs:label "Has variety"@en;
            rdfs:subPropertyOf :taxonomicRelationship.
:hasWeed a owl:ObjectProperty;
         rdfs:label "Has weed"@en;
         rdfs:subPropertyOf :causativeRelationship;
         owl:inverseOf :isWeedOf.
:includes a owl:ObjectProperty;
          rdfs:comment """X <comprend> Y. X est une entité qui inclut l'élément Y. Par exemple, \"méthode d'élevage\" <comprend> \"écornage\", \"analyse de l'eau\" <comprend> \"analyse microbiologique\"."""@fr,
                       "X <includes> Y. X is an entity that includes the element Y. For example: “animal husbandry methods” <includes> ”dehorning”, “water analysis” <includes> ”microbiological analysis”."@en,
                       """X <incluye> Y. X es una entidad que incluye el elemento Y. Ej. 
\"Métodos de crianza\" <incluye> \"Descorne\", \" Análisis de agua\" <incluye> \"Análisis microbiológico\"."""@es,
                       """X <включает> Y. X - это сущность, которая включает элемент Y. Например, 
\"методы выращивания и содержания животных\" <включает> \"удаление рогов\", \"анализ воды\" <включает> \"микробиологический анализ\"."""@ru,
                       "X<包含>Y。实体X包含元素Y。例如：“家畜饲养方法”<包含>“断角术”，“水分析”<包含>“微生物分析”。"@zh,
                       """س <يتضمن> ع. س هو كيان يتضمن العنصر ع
على سبيل المثال: \"طرق رعاية الحيوان\" <تتضمن> \"عملية إزالة القرون\"
\"تحليل المياه\" <تتضمن> \" تخصيص الموارد\""""@ar;
          rdfs:label "Comprend"@fr,
                     "Includes"@en,
                     "Incluye"@es,
                     "включает"@ru,
                     "يشمل"@ar,
                     "包含"@zh;
          rdfs:subPropertyOf :partitiveRelationship;
          owl:inverseOf :isIncludedIn.
:includesSubprocess a owl:ObjectProperty;
                    rdfs:comment """X <includesSubprocess> Y. Process X naturally or conventionally realized at the minimum through process Y. Equivalent to <stageOf>. E.g. \"milk production\" <includesSubprocess> \"pasteurization\";"""@en;
                    rdfs:label "Includes subprocess"@en;
                    rdfs:subPropertyOf :includes;
                    owl:inverseOf :isSubprocessOf.
:indicates a owl:ObjectProperty;
           rdfs:comment """Y <indica> X. Una enfermedad o trastorno característico Y en un organismo indica enfermedad X. Ej. \"Shock séptico\" <indica> \"Septicemia\". Úselo solo para enfermedades. Pero, \"Acidez\" <si mide mediante> \"pH\"."""@es,
                        """Y <indicates> X. A disease or disorder characteristic Y in an organism indicates disease X. E.g. \"septic shock\" <indicates> \"septicaemia\". Use only for diseases. However, \"acidity\" <is measured by> \"pH\"."""@en,
                        """Y <indique> X. Une maladie ou un désordre caractéristique Y dans un organisme indique une maladie X. Par ex. \"choc septique\" <indique> \"septicémie\". Utiliser uniquement pour les maladies. Cependant, \"acidité\" <est mesuré par> \"pH\". 
"""@fr,
                        """Y <является симптомом> X. Характеристика болезни или расстройства Y в организме указывает на болезнь X. Например, \"септицемия\" <является симптомом> \"септический шок\". Используется только для болезней. Однако \"кислотность\" <измеряется> \"pH\"."""@ru,
                        "Y<指示>X。生物体的疾病或病征Y指示疾病X。例如：“感染性休克”<指示>“败血症”。仅适用于疾病。但是，“酸性”<由...测量>“酸碱度”。"@zh,
                        """ع <يشير إلى> س. المرض او الاضطراب ع في كائن حي يشير إلى المرض س
على سبيل المثال: \" الصدمة الانتانية <تشير إلى> \" التسمم الدموي\".
تستخدم فقط للأمراض. ومع ذلك ، \"الحموضة\" <تقاس بـ> \"درجة الحموضة\""""@ar;
           rdfs:label "Indica"@es,
                      "Indicates"@en,
                      "Indique"@fr,
                      "является симптомом"@ru,
                      "يُظهر"@ar,
                      "指示"@zh;
           rdfs:subPropertyOf :causativeRelationship;
           owl:inverseOf :hasSymptom.
:influences a owl:ObjectProperty;
            rdfs:label "Influences"@en;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :isInfluencedBy.
:isAGrowthEnvironmentFor a owl:ObjectProperty;
                         rdfs:comment """Y <isAGrowthEnvironmentFor> X. An environment Y favorable to a taxon X. This is used as the inverse relationship of <growsIn>. Use this in a plant and related domain (e.g. fungi). E.g. \"isarn region\" <isAGrowthEnvironmentFor> \"jasmine rice\"; \"moist soil\" <isAGrowthEnvironmentFor> \"rice\";"""@en;
                         rdfs:label "Is a growth environment for"@en;
                         rdfs:subPropertyOf :causativeRelationship;
                         owl:inverseOf :growsln.
:isAbbreviationOf a owl:ObjectProperty;
                  rdfs:label "Is abbreviation of"@en;
                  rdfs:subPropertyOf :hasSynonym;
                  owl:inverseOf :hasAbbreviation.
:isAchievedByMeansOf a owl:ObjectProperty;
                     rdfs:comment """Y <est réalisée au moyen de>X. Y est un objectif ou un processus utilisé par X, sans que Y fasse nécessairement partie de X. Par exemple : \"confusion sexuelle\" <est réalisée au moyen de> \"analogue phéromone\", \"prise de décision\" <est réalisée au moyen de> \"système d'aide à la décision\"."""@fr,
                                  "Y <is achieved by means of> X. Y is an objective or process used by X, without Y necessarily being part of X. E.g. “mating disruption” <is achieved by means of> “pheromone analogues”, “decision making” <is achieved by means of> “decision support systems”."@en,
                                  "Y <se consigue por medio de> X. Y es un objetivo o proceso utilizado por X, sin que Y sea necesariamente parte de X. Ej. “Confusión sexual” <se consigue por medio de> “Feromonas sintéticas”, “Toma de decisiones” <se consigue por medio de> “Sistemas de apoyo a las decisiones”. "@es,
                                  """Y <достигается с помощью> X. Y  это цель или процесс, используемый X, при этом Y не обязательно является частью X. Например, \"нарушение спаривания\" <достигается с помощью> \"аналоги феромонов\", \"принятие решений\" <достигается с помощью> \"системы поддержки принятия решений\"."""@ru,
                                  "Y<通过…手段实现>X。Y是X的目标或是X使用的过程，不一定是X的一部分。例如：“交配干扰”<通过…手段实现>“信息素类似物”，“决策”<通过…手段实现>“决策支持系统”。"@zh,
                                  """ع <يتم تحقيقه عن طريق> س . ع  هو هدف أو عملية يستخدمها س ، دون أن يكون ع بالضرورة جزءاً من س. 
على سبيل المثال اضطراب التزاوج \"<يتحقق عن طريق>\" نظائر الفرمون \"  ،
 \"إتخاذ القرار\" <يتم تحقيقه عن طريق> \"نظام دعم القرار\"."""@ar;
                     rdfs:label "Est réalisée au moyen de"@fr,
                                "Is achieved by means of"@en,
                                "Se consigue por medio de"@es,
                                "достигается с помощью"@ru,
                                "يتم تحقيقه عن طريق"@ar,
                                "通过…手段实现"@zh;
                     rdfs:subPropertyOf :processRelationship;
                     owl:inverseOf :hasGoalOrProcess.
:isAcronymOf a owl:ObjectProperty;
             rdfs:comment """Y <es acrónimo de> X. Un acrónimo es una abreviatura formada por las letras iniciales de otras palabras, que a menudo se pronuncia como una palabra.  \"SIDA\" <es acrónimo de> \"Síndrome de inmunodeficiencia adquirida\"."""@es,
                          "Y <est l'acronyme de> X. Un acronyme est une abréviation formée des lettres initiales d'autres mots, souvent prononcées comme un mot. “UE” <est l'acronyme de> ”Union européenne”. "@fr,
                          "Y <is acronym of> X. An acronym is an abbreviation formed from the initial letters of other words, often pronounced as a word.  “AIDS” <is acronym of>”acquired immunodeficiency syndrome”."@en,
                          """Y <является акронимом> X. Акроним - это аббревиатура, образованная из начальных букв других слов, часто произносимая как слово.  \"СПИД\" <является акронимом> \"синдром приобретенного иммунодефицита\"."""@ru,
                          "Y<是...的缩略语>X。缩略语由其他单词首字母组成，通常读作一个词。“艾滋病”<是...的缩略语>“获得性免疫缺陷综合征”。"@zh,
                          """ع <هي اختصار لـ> س. الاختصار هو اختصار يتكون من الأحرف الأولى للكلمات الأخرى ، وغالبًا ما يتم نطقه ككلمة. 
على سبيل المثال:  \"مرض الايدز\" <هو اختصار لـ> \"متلازمة نقص المناعة المكتسبة\"
"""@ar;
             rdfs:label "Es acrónimo de"@es,
                        "Est l'acronyme de"@fr,
                        "Is acronym of"@en,
                        "является акронимом"@ru,
                        "هو اختصار"@ar,
                        "是...的缩略语"@zh;
             rdfs:subPropertyOf :isAbbreviationOf;
             owl:inverseOf :hasSynonym.
:isActedUponBy a owl:ObjectProperty;
               rdfs:label "Is acted upon by"@en;
               rdfs:subPropertyOf :causativeRelationship;
               owl:inverseOf :actsUpon.
:isAffectedBy a owl:ObjectProperty;
              rdfs:comment """Y <est affecté par> X. Un objet Y change d'état ou de localisation suite à l'action d'un agent X. Par exemple, \"arbre\" <est affecté par> \"arboricide\", \"aptitude au transport\" <est affecté par> \"dégât mécanique\". Ne l'utilisez pas pour des maladies ou des désordres: pour ceux-là, utilisez <afflige/est affligé par>."""@fr,
                           """Y <está afectado por> X. Un objeto Y cambia de estado o ubicación debido a la acción de un agente X. Ej. \"Árboles\" <está afectado por> \"Arboricidas\", \"Aptitud para el transporte\" <está afectado por> \"Daños mecánicos\". No lo utilice para enfermedades o trastornos; para ellos, utilice <aflige/está afligido por>. """@es,
                           """Y <is affected by> X. An object Y changes state or location because of an action of an agent X. E.g. \"trees\" <is affected by> \"arboricides\", \"transporting quality\" <is affected by> \"mechanical damage\". Do not use for diseases or disorders; for those, use <afflicts/is afflicted by>. """@en,
                           "Y<受...影响> X。对象Y的状态或位置由于媒介X的行为而发生变化。例如：“树”<受...影响>“树木毒杀剂”，“运输性能”<受...影响>“机械损伤”。 请勿用于疾病或病症；对于疾病和病症，使用<损伤/受...损伤>。"@zh,
                           """на Y влияет X. Объект Y изменяет состояние или местоположение из-за действия агента X. Например, на \"деревья\" влияет \"арборициды\", на \"качество транспортировки\" влияет \"механические повреждения\".  Не используйте для болезней или расстройств; для них используйте <поражает/на ... негативно влияет болезнь .....>. """@ru,
                           """ع <يتأثر بـ >س . يغير الكائن \"ع\" حالته أو موقعه بسبب إجراء قام به العامل \"س\".
على سبيل المثال. \"الأشجار\" تتأثر بـ \"مبيدات الشجر\" ، 
\"جودة النقل\" تتأثر \"بالضرر الميكانيكي\".
لا تستخدم للأمراض أو الاضطرابات. لهؤلاء استخدم <afflicts / isAfflictedBy>."""@ar;
              rdfs:label "Est affecté par"@fr,
                         "Está afectado por"@es,
                         "Is affected by"@en,
                         "на ... влияет ...."@ru,
                         "يتأثر بها"@ar,
                         "受...影响"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :affects.
:isAfflictedBy a owl:ObjectProperty;
               rdfs:comment """ Y <поражается> болезнью X. На здоровье или благополучие организма или части тела Y может негативно повлиять болезнь X. Например,  \"медоносные пчелы\" <поражается> \"варроатоз\",  \"язык\" <поражается> \"глоссит\"."""@ru,
                            """Y <est affligé par> X. La santé ou le bien-être d'un organisme ou d'une partie du corps Y pourrait être affecté par la maladie ou le désordre X. Par exemple, \"abeille domestique\" <est affligé par> \"varroase\", \"langue\" <est affligé par> \"glossite\"."""@fr,
                            """Y <está afligido por> X. La salud o el bienestar de un organismo o parte del cuerpo Y podría verse afectado negativamente por la enfermedad X. Ej.  \"Abeja melífera\" <está afligido por> \"Varroosis\", \"Lengua\" <está afligido por> \"Glositis\". """@es,
                            """Y <is afflicted by> X. The health or wellbeing of an organism or body part Y could adversely be affected by the disease X. E.g. \"honey bees\" <is afflicted by> \"varoosis\", \"tongue\" <is afflicted by> \"glossitis\". """@en,
                            "Y<受...损伤>X。生物体或身体部分Y的健康可能受到疾病X的负面影响。例如：“蜜蜂”<受...损伤>“蜂螨病”，“舌”<受...损伤>“舌炎”。"@zh,
                            """ع < يصاب بـ > س. يمكن أن تتأثر صحة أو رفاهية كائن حي أو جزء من الجسم ع سلبًا بالمرض س.
\"  على سبيل المثال \"نحل العسل\" <يصاب بـ > \"امرض الفاروا\" ، 
\"اللسان\" <يصاب بـ> \"التهاب اللسان\".  """@ar;
               rdfs:label "Is afflicted by"@en,
                          "est affligé par"@fr,
                          "está afligido por"@es,
                          "поражается"@ru,
                          "تتأثر ... بـ ..."@ar,
                          "受...损伤"@zh;
               rdfs:subPropertyOf :isAffectedBy;
               owl:inverseOf :afflicts.
:isBeneficialFor a owl:ObjectProperty;
                 rdfs:comment """X <isBeneficialFor> Y. Agent X behaves in a way that produces some result Y that is advantageous to some beneficiary. A means X through which a consequence Y can be achieved. E.g. \"biological control arthropods\" <isBeneficialFor> \"biological control\"; \"pest control\" <isBeneficialFor> \"plant health\";"""@en;
                 rdfs:label "Is beneficial for"@en;
                 rdfs:subPropertyOf :causativeRelationship;
                 owl:inverseOf :benefitsFrom.
:isBiologicalControlAgentOf a owl:ObjectProperty;
                            rdfs:label "Is biological control agent of"@en;
                            rdfs:subPropertyOf :causativeRelationship;
                            owl:inverseOf :hasBiologicalControlAgent.
:isBreedingMethodOf a owl:ObjectProperty;
                    rdfs:label "Is breeding method of"@en;
                    rdfs:subPropertyOf :causativeRelationship;
                    owl:inverseOf :hasBreedingMethod.
:isCausedBy a owl:ObjectProperty;
            rdfs:comment """Y <est causée par> X. Un résultat Y s'est produit à cause d'un agent X (animé ou inanimé). Par exemple, \"encéphalopathie spongiforme\" <est causée par> \"prion\", \"fanaison\" <est causée par> \"déficit d'humidité du sol\". """@fr,
                         """Y <está causado por> X. Un resultado Y se produjo debido a un agente X (animado o inanimado). Ej. \"Encefalopatía espongiforme\" <está causado por> \"Prione\", \"Marchitamiento\" <está causado por> \"Déficit de humedad en el suelo\"."""@es,
                         """Y <is caused by> X. A result Y occurred because of an agent X (animate or inanimate). E.g. \"spongiform encephalopathy\" <is caused by> “prions”, \"soil moisture deficit” <is caused by> \"wilting\"."""@en,
                         """Y <вызывается> X. Результат Y произошел из-за агента X (одушевленного или неодушевленного). Например, \"губчатая энцефалопатия\" <вызывается> \"прионы\", \"увядание\" <вызывается> \"дефицит влажности почвы\". """@ru,
                         "Y<由...引起>X。结果Y由于媒介X（生物或非生物）而发生。例如：“海绵状脑病”<由...引起>“朊病毒”，“萎蔫”<由...引起>“土壤水分亏缺”。"@zh,
                         """ع <سببه> س. النتيجة ع تحدث بسبب العامل س (الحي أو غير الحي)
على سبيل المثال: \"الاعتلال الدماغي الاسفنجي\" <سببه> \"البريونات\"
الذبول\" <سببه> \"النقص في رطوبة التربة\""""@ar;
            rdfs:label "Est causée par"@fr,
                       "Está causado por"@es,
                       "Is caused by"@en,
                       "вызывается"@ru,
                       "هو سبب"@ar,
                       "由...引起"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :causes.
:isChemicalFormulaOf a owl:ObjectProperty;
                     rdfs:label "Is chemical formula of"@en;
                     rdfs:subPropertyOf skosxl:labelRelation;
                     owl:inverseOf :hasChemicalFormula.
:isComponentOf a owl:ObjectProperty;
               rdfs:comment """ X <is component of> Y. An object X that is a part of a whole Y, also has an existence independently from Y. E.g. \"leaves\" <is component of> \"trees\", \"engines\" <is component of> \"vehicle systems\"."""@en,
                            " X<是...的组成部分>Y。物体X是整体Y的一部分，同时也独立于Y存在。例如：“叶”<是...的组成部分>“树”，“发动机”<是...的组成部分>“车辆系统”。"@zh,
                            """X <es componente de> Y. Un objeto X que forma parte de un conjunto Y, también tiene una existencia independiente de Y. Ej. \"Hojas\" <es componente de> \"Árboles\", \"Motores\" <es componente de> \"Componentes del vehículo\"."""@es,
                            """X <est un composant de> Y. Un objet X qui fait partie d'un Y entier, a également une existence indépendante de Y. Par exemple, \"feuille\" <est un composant de> \"arbre\",  \"moteur\" <est un composant de> \"organe de véhicule\" ."""@fr,
                            """X <является компонентом> Y. Объект X, который является частью целого Y, также имеет существование независимо от Y. Например, \"листья\" <является компонентом> \"деревья\", \"двигатели\" <является компонентом> \"системы машин\"."""@ru,
                            """س <هي مكون من> ع. الكائن س هو جزء من ع بالكامل وله أيضاً وجود مستقل عن ع. 
على سبيل المثال: \"الورقة\" <هي مكون من > \"الشجرة\"
\" المحركات\" <هي مكون من > \"منظومات المركبات\".
"""@ar;
               rdfs:label "Es componente de"@es,
                          "Est un composant de"@fr,
                          "Is component of"@en,
                          "является компонентом"@ru,
                          "هو مكون من"@ar,
                          "是...的组成部分"@zh;
               rdfs:subPropertyOf :isPartOf;
               owl:inverseOf :hasComponent.
:isComposedOf a owl:ObjectProperty;
              rdfs:comment """X <est composé de> Y.  X est composé de la matière ou de la substance Y. Par exemple, \"flore du sol\" <est composé de\"flore microbienne\", \"tuff\" <est composé de> \"matériau volcanique\". """@fr,
                           """X <está compuesto de> Y.  X está compuesto de materia o sustancia Y. Ej. \"Flora del suelo\" <está compuesto de> \"Flora microbiana\", \"Toba\" <está compuesto de> \"Materiales volcánicos\".  """@es,
                           "X <is composed of> Y. X is composed of material or substance Y . E.g. “soil flora” <is composed of> “microbial flora”, “tuff”<is composed of> “volcanic materials”."@en,
                           """X <состоит из> Y. X состоит из материала или вещества Y. Например, \"почвенная флора\" <состоит из> \"микробная флора\", \"туф (вулканический)\" <состоит из> \"вулканогенные материалы\".
"""@ru,
                           "X<由...组成>Y。X由材料或物质Y组成。例如：“土壤植物区系”<由...组成>“微生物菌群”，“凝灰岩”<由...组成>“火山灰物质”。"@zh,
                           """س <يتكون من> ع. يتكون س من المادة أو الأداة ع.
على سبيل المثال: \"نباتات التربة\" <تتكون من > \"نباتات جرثومية\"
\" صخر tuff\"<يتكون من> \"مواد بركانية\".
"""@ar;
              rdfs:label "Est composé de"@fr,
                         "Está compuesto de"@es,
                         "Is composed of"@en,
                         "состоит из"@ru,
                         "يتكون من"@ar,
                         "由...组成"@zh;
              rdfs:subPropertyOf :hasPart;
              owl:inverseOf :compose.
:isCompositionOf a owl:ObjectProperty;
                 rdfs:label "Is composition of"@en;
                 rdfs:subPropertyOf :partitiveRelationship;
                 owl:inverseOf :hasComposition.
:isControlMethodOf a owl:ObjectProperty;
                   rdfs:label "Is control method of"@en;
                   rdfs:subPropertyOf :causativeRelationship;
                   owl:inverseOf :hasControlMethod.
:isControlledBy a owl:ObjectProperty;
                rdfs:comment "";
                rdfs:label "Is controlled by"@en;
                rdfs:subPropertyOf :causativeRelationship;
                owl:inverseOf :controls.
:isCropingSystemOf a owl:ObjectProperty;
                   rdfs:label "Is cropping system of"@en;
                   rdfs:subPropertyOf :causativeRelationship;
                   owl:inverseOf :hasCropingSystem.
:isCultivationProcessOf a owl:ObjectProperty;
                        rdfs:label "Is cultivation process of"@en;
                        rdfs:subPropertyOf :processRelationship;
                        owl:inverseOf :hasCultivationProcess.
:isDerivedFrom a owl:ObjectProperty;
               rdfs:comment "X <es derivado de> Y. Una sustancia o producto X obtenido exclusivamente de la fuente Y sin ninguna sustancia o producto adicional. Ej. “Aceite de almendra” <es derivado de> “Almendra”, “Zumo de naranja” <es derivado de> “Naranja dulce”. Se utiliza para relacionar un organismo con un producto derivado: “Carne de carnero” <es derivado de> “Ovinos”. "@es,
                            """X <est dérivé de> Y. Une substance ou un produit X obtenu exclusivement à partir de la source Y sans aucune substance ou produit supplémentaire. Par exemple, \"huile d'amande\" <est dérivé de> \"amande\", \"jus d'orange\" <est dérivé de> \"orange douce\". À utiliser pour relier un organisme à un produit dérivé \"viande ovine\" <est dérivé de> \"ovin\"."""@fr,
                            "X <is derived from> Y. A substance or product X obtained exclusively from source Y without any additional substance or product. E.g. “almond oil” <is derived from> “almonds”, “orange juice” <is derived from> “sweet oranges”. Use to relate an organism with a derived product: “mutton” <is derived from> “sheep”. "@en,
                            """X <получен из> Y. Вещество или продукт X, полученный исключительно из источника Y без каких-либо дополнительных веществ или продуктов. Например, \"миндальное масло\" <получен из> \"миндаль (орехи)\", \"апельсиновый сок\" <получен из> \"сладкие апельсины\". Используется, чтобы показать связь между организмом и полученным из него продуктом: \"баранина\" <получен из> \"овцы\". """@ru,
                            "X<源自>Y。物质或产品X的获得完全源自Y，不含额外的物质或产品。例如：“杏仁油”<源自>“杏仁”，“橙汁”<源自>“甜橙”。用于表示生物体及其衍生产品的关系：“羊肉”<源自>“绵羊”。"@zh,
                            """س <مشتق من> ع. يتم الحصول على المادة و المنتج س حصريً من المصدر ع وبدون أي مادة أو منتج إضافي.
على سبيل المثال: \" زيت اللوز\" <مشتق من> \" اللوز\"
\"عصير البرتقال\" <مشتق من> \" البرتقال الحلو\".
تستخدم لربط كائن حي بمنتج مشتق: \"لحم الضأن\" <مشتق من> \"الخروف\"."""@ar;
               rdfs:label "Es derivado de"@es,
                          "Est dérivé de"@fr,
                          "Is derived from"@en,
                          "получен из"@ru,
                          "مشتق من"@ar,
                          "源自"@zh;
               rdfs:subPropertyOf :causativeRelationship;
               owl:inverseOf :isSourceOf.
:isDiseaseFor a owl:ObjectProperty;
              rdfs:comment """Y <es la enfermedad por> X. La enfermedad Y es enfermedad del organismo X. Ej. \"Carbón suelto del sorgo” <es la enfermedad por> “Sorghum\". Relación entre la enfermedad y el organismo."""@es,
                           """Y <est maladie de> X. La maladie Y est un maladie de l'organisme X. Par exemple, \"charbon nu du sorgho\" <est maladie de> \"Sorghum\". Relation entre la maladie et l'organisme."""@fr,
                           """Y <is disease for> X. Disease Y is disease of organism X. E.g. “loose smut of sorghum”<is disease for> “Sorghum\". Disease to organism relationship."""@en,
                           """Y <является болезнью для> X. Болезнь Y является болезнью организма X. Например, \"мелкопузырчатая головня сорго\" <является болезнью для> \"Sorghum\". Отношения между болезнью и организмом."""@ru,
                           "Y<是...的疾病>X。疾病Y是生物体X的疾病。例如：“高粱散黑粉病”<是...的疾病>“高粱属”。疾病-生物体关系。"@zh,
                           """ع هو <مرض> س. المرض ع هو مرض الكائن س.
على سبيل المثال: \"تفحم الذرة الرفيعة\" هو <مرض> \"الذرة\".
علاقة المرض بالكائن الحي."""@ar;
              rdfs:label "Es la enfermedad por"@es,
                         "Est maladie de"@fr,
                         "Is disease for"@en,
                         "является болезнью для"@ru,
                         "هو مرض"@ar,
                         "是...的疾病"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :hasDisease.
:isDisorderOf a owl:ObjectProperty;
              rdfs:label "Is disorder of"@en;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :hasDisorder.
:isHostFor a owl:ObjectProperty;
           rdfs:comment """Y <Is vector or host for> X. Organism Y is host or vector for X.  E.g. “Anopheles” <is vector or host for> ”Plasmodium”. 
"""@en,
                        """Y <possède un vecteur ou est hôte de> X. L'organisme Y est l'hôte ou le vecteur de X. Par exemple, \"Anophele\" <possède un vecteur ou est hôte de> \"Plasmodium\"."""@fr,
                        """Y <tiene vector o es huésped de> X. El organismo Y es huésped o vector de Y. Ej. “Anopheles” <tiene vector o es huésped de> ”Plasmodium”. 
"""@es,
                        """Y <является переносчиком или хозяином для> X. Организм Y является переносчиком или хозяином для X. \"Anopheles\" <является переносчиком или хозяином для>  \"Plasmodium\". 
"""@ru,
                        "Y<是...的寄主>X。生物体Y是X的寄主或传播媒介。例如：“按蚊属”<是...的寄主>“疟原虫属” 。"@zh,
                        """ع <هو الناقل أو المضيف لـ > س. الكائن الحي ع هو ميف أو ناقل لـ س.
على سبيل المثال: \"بعوضة الملاريا\" <هي الناقل أو المضيف لـ> \"المتصورة\"."""@ar;
           rdfs:label "Es vector o es huésped de"@es,
                      "Est vecteur ou est hôte de"@fr,
                      "Is vector or host for"@en,
                      "является переносчиком или хозяином для"@ru,
                      "مضيف لـ"@ar,
                      "是...的寄主"@zh;
           rdfs:subPropertyOf :causativeRelationship;
           owl:inverseOf :hasHost.
:isIncludedIn a owl:ObjectProperty;
              rdfs:comment """X <est inclus dans>  Y. X est une entité qui inclut l'élément Y. Par exemple, \"écornage\" <est inclus dans> \"méthode d'élevage\", \"analyse microbiologique\" <est inclus dans> \"analyse de l'eau\"."""@fr,
                           """Y <incluido en>X. X es una entidad que incluye el elemento Y. Ej. \"Descorne\" <incluido en> \"Métodos de crianza\", \"Análisis microbiológico\" <incluido en> \"Análisis de agua\"."""@es,
                           """Y <is included in>X. X is an entity that includes the element Y. For example: \"dehorning” <included in> ”animal husbandry methods”, “microbiological analysis\" <included in> “water analysis”"""@en,
                           """Y <включен в> X. X - это сущность, которая включена в элемент Y. Например, \"удаление рогов\" <включен в> \"методы выращивания и содержания животных\", \"микробиологический анализ\" <включен в> \"анализ воды\"."""@ru,
                           "Y<包含于>X。实体X包含元素Y。例如：“断角术”<包含于>“家畜饲养方法”，“微生物分析”<包含于>“水分析”。"@zh,
                           """ع <متضمن في> س. س هو كيان يتضمن العنصر ع
على سبيل المثال: \"عملية إزالة القرون\" <متضمنة في>\"طرق رعاية الحيوان\"
\" تخصيص الموارد\" <متضمنة في> \"تحليل المياه\""""@ar;
              rdfs:label "Est inclus dans"@fr,
                         "Incluido en"@es,
                         "Is included in"@en,
                         "включен в"@ru,
                         "مدرج في"@ar,
                         "包含于"@zh;
              rdfs:subPropertyOf :partitiveRelationship;
              owl:inverseOf :includes.
:isInfectedPartOf a owl:ObjectProperty;
                  rdfs:label "Is infected part of"@en;
                  rdfs:subPropertyOf :causativeRelationship;
                  owl:inverseOf :hasInfectionPart.
:isInfluencedBy a owl:ObjectProperty;
                rdfs:label "Is influenced by or Depends on"@en;
                rdfs:subPropertyOf :causativeRelationship;
                owl:inverseOf :influences.
:isInputFor a owl:ObjectProperty;
            rdfs:label "Is input for"@en;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :isOutputFrom.
:isLocalNameOf a owl:ObjectProperty;
               rdfs:label "Is a local name of"@en;
               rdfs:subPropertyOf :hasSynonym;
               owl:inverseOf :hasLocalName.
:isMadeFrom a owl:ObjectProperty;
            rdfs:comment """ X <está hecho de> Y.  El producto X se fabrica principalmente a partir de una sustancia o un producto Y. Ej. \"Queso de oveja\" <está hecho de> \"Leche de oveja\", \"Hormigón\" <está hecho de> \"Cemento\", \"Tocino magro\" <está hecho de> \"Carne de cerdo\". Elemento de procesamiento más fuerte que <es fuente de>."""@es,
                         """ X <is made from> Y.  Product X is mainly made from substance or a product Y. E.g. \"sheep cheese\" <is made from> \"ewe milk\", \"concrete\" <is made from> \"cement\", \"bacon\" <is made from> \"pork\". Stronger processing element than <is source of>."""@en,
                         """ X <сделан из> Y. Продукт X в основном производится из вещества или продукта Y. Например, \"овечий сыр\" <сделан из> \"овечье молоко\", \"бетон\" <сделан из> \"цемент\", \"бекон,\" <сделан из> \"свинина\". Более сильный элемент обработки, чем <сделан из>."""@ru,
                         " X<由...制成>Y。产品X主要由物质或产品Y制成。例如：“绵羊乳干酪”<由...制成> “绵羊奶”，“混凝土”<由...制成>“水泥”，“培根”<由...制成>“猪肉”。比<是...的来源>有更强的加工要素。"@zh,
                         """X <est fait de> Y. Le produit X est principalement fabriqué à partir d'une substance ou d'un produit Y. Par exemple, \"fromage de brebis\" <est fait de> \"lait de brebis\", \"béton\" <est fait de> \"ciment\", \"bacon\" <est fait de> \"viande porcine\". Élément de traitement plus puissant que <est source de>.
"""@fr,
                         """س <مصنوع من> ع. المنتج س مصنوع بشكل أساسي من المادة أو المنتج ع.
على سبيل المثال:  \"جبن الغنم\" <مصنوع من> \"حليب النعجة\" 
\"الخرسانة\" <مصنوعة من> \"الأسمنت\"
\"لحم الخنزير المملح\" <مصنوع من> \"لحم الخنزير\".
عنصر معالجة أقوى من <هو مصدر>"""@ar;
            rdfs:label "Est fait de"@fr,
                       "Está hecho de"@es,
                       "Is made from"@en,
                       "сделан из"@ru,
                       "مصنوعه من"@ar,
                       "由...制成"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :isUsedToMake.
:isMeansFor a owl:ObjectProperty;
            rdfs:comment """X <isMeansFor> Y. An object or process X mainly used to perform a process Y. See also <usedAs>. E.g. \"curry paste grinding\" <performedWithInstrument> \"curry paste grinding machine\"; \"weapon\" <instrumentFor> \"killing\"; \"fishing pole\" <instrumentFor> \"fishing\"; \"alcohol\" <instrumentFor> \"cleaning\"; Ploughs <isMeansFor> Ploughing ;but NOT \"knives\" <instrumentFor> \"felling\" (because knives are not primarily used for cutting down trees);"""@en;
            rdfs:label "Is means for"@en;
            rdfs:subPropertyOf :processRelationship;
            owl:inverseOf :isPerformedByMeansOf.
:isMeasuredBy a owl:ObjectProperty;
              rdfs:comment """X <est mesuré par> Y. Une propriété quantitative de X est mesurée par Y. Par exemple : \"température\" <est mesuré par> \"thermomètre\", \"changement social\" <est mesuré par> \"indicateur social\"."""@fr,
                           """X <is measured by> Y. A quantitative property of X is measured by Y. For example: “temperature” <is measured by> “thermometers”, “social change” <is measured by> “social indicators\"."""@en,
                           """X <si mide mediante> Y. Una propiedad cuantitativa de X se mide con Y. Ej. “Temperatura” <si mide mediante> “Termómetros”, “Cambio social” <si mide mediante> \"Indicadores sociales\"."""@es,
                           """X <измеряется> Y. Количественное свойство X измеряется Y. Например, \"температура\" <измеряется> \"термометры\", \"социальные изменения\" <измеряется> \"социальные показатели\"."""@ru,
                           "X<由...测量>Y。X数量方面的属性由Y测量。例如：“温度”<由...测量>“体温计”，“社会变迁”<由...测量>“社会指标”。"@zh,
                           """س <تُقاس من قبل> ع. يتم قياس خاصية الكمية لـ س بواسطة ع 
على سبيل المثال: \"الحرارة\" <تُقاس من قبل> \"ميزان الحرارة\"
التغير الاجتماعي <يُقاس من قبل> \" المؤشرات الاجتماعية\""""@ar;
              rdfs:label "Est mesuré par"@fr,
                         "Is measured by"@en,
                         "Si mide mediante"@es,
                         "измеряется"@ru,
                         "يتم قياس x بواسطة y"@ar,
                         "由...测量"@zh;
              rdfs:subPropertyOf :quantitativeRelationship;
              owl:inverseOf :measures.
:isMemberOf a owl:ObjectProperty;
            rdfs:comment """ X <es miembro de> Y. Una unidad social o política (grupo o individuo) X pertenece a un grupo social o político Y. Ej. \"Benin\" <es miembro de> \"Africa de habla francesa\", \"Abejas obreras\" <es miembro de> \"Colonia de abejas\".  Limitar el uso a unidades geográficas/sociopolíticas. No utilizar para agrupar organismos por uso, clima o rango taxonómico."""@es,
                         """ X <est membre de> Y: est membre de. Une unité sociale ou politique (groupe ou individu) X appartient à un groupe social ou politique Y. Par exemple, \"Bénin\" <est membre de> \"Afrique francophone\", \"abeille ouvrière\" <est membre de> \"colonie d'abeilles\". Limiter l'utilisation aux unités géographiques/socio-politiques, ne pas utiliser pour regrouper des organismes (par exemple, par utilisation, climat ou rang taxonomique). """@fr,
                         """X <is member of> Y. A social or political unit (group or individual) X belongs to a social or political group Y. E.g. \"Benin\" <is member of> \"Francophone Africa\", \"worker bees\" <is member of> \"bee colonies\". Limit use to geographical or socio-political units, do not use for grouping organisms (e.g. by use, climate, or taxonomic rank). Use <includes/included in> if describing spatial or temporal relation, but more loose than <is part of.>"""@en,
                         """X <является членом> Y. Социальная или политическая единица (группа или индивид) X принадлежит к социальной или политической группе Y. Например, \"бенин\" <является членом> \"франкоязычная африка\", \"рабочие пчелы\" <является членом> \"пчелиные семьи\". Ограничьте использование географическими/социально-политическими единицами, не используйте для группировки организмов (например, по использованию, климату или таксономическому рангу)."""@ru,
                         "X<是...的成员>Y。社会或政治单位（团体或个人）X属于社会或政治团体Y。例如：“贝宁”<是...的成员>“法语非洲”，“工蜂”<是...的成员>“蜜蜂群”。限用于地理/社会政治单位。请勿用于对生物体进行分组（如按用途、气候或分类等级）。对于空间或时间关系，使用<包含/包含于>，但比<有部分/是...的部分>更为松散。"@zh,
                         """س <هو عضو في> ع. تنتمي الوحدة الاجتماعية أو السياسية (مجموعة أو فرد) س إلى مجموعة اجتماعية أو سياسية ع
على سبيل المثال: \"Benin\" <هي عضو في> \" إفريقيا الناطقة بالفرنسية\"
\"النحلات العاملات\" <هي عضو > \"مستعمرات النحل\".
قصر الاستخدام على الوحدات الجغرافية / الاجتماعية السياسية.
لا تستخدم لتجميع الكائنات الحية حسب الاستخدام أو المناخ أو الترتيب التصنيفي.
استخدم <تتضمن> / <مضمن في> إذا كنت تصف العلاقة المكانية أو الزمنية ، إذا كانت فضفاضة أكثر يستخدم <جزء من>."""@ar;
            rdfs:label "Es miembro de"@es,
                       "Est membre de  "@fr,
                       "Is member of"@en,
                       "является членом"@ru,
                       "هو عضو في"@ar,
                       "是...的成员"@zh;
            rdfs:subPropertyOf :partitiveRelationship;
            owl:inverseOf :hasMember.
:isNaturalEnemyOf a owl:ObjectProperty;
                  rdfs:label "Is natural enemy of"@en;
                  rdfs:subPropertyOf :causativeRelationship;
                  owl:inverseOf :hasNaturalEnemy.
:isObjectOfActivity a owl:ObjectProperty;
                    rdfs:comment "X<是活动...的对象>Y。概念X是活动Y关注的对象。例如：“羊毛”<是活动...的对象>“剪毛”，“条约”<是活动...的对象>“批准”。"@zh,
                                 """Y <es objeto de la actividad> X. La actividad Y tiene como foco el concepto X. Ej. “Lana” <es objeto de la actividad> \"Esquileo”, “Tratados\" <es objeto de la actividad> “Ratificación”. """@es,
                                 """Y <est l'objet de l'activité> X. Y est le centre de l'activité X. Par exemple, “laine\" <est l'objet de l'activité> \"tonte\", “traité” <est l'objet de l'activité> “ratification”."""@fr,
                                 """Y <is object of activity> X. Y is the focus of activity X.  E.g. “wool” <is object of activity> \"shearing”, “treaties\" <is object of activity> “ratification”."""@en,
                                 """Y <является объектом деятельности> X. Y является центром деятельности X. Например, \"шерсть\" <является объектом деятельности> \"стрижка\", \"пакты\" <является объектом деятельности> \"ратификация\"."""@ru,
                                 """ع <هو هدف النشاط> س . ع هو محور النشاط س. 
على سبيل المثال \"الصوف\" <هو محور> \"الجز\" ،
 \"المعاهدات\" <هي محور > \"التصديق\"."""@ar;
                    rdfs:label "Es objeto de la actividad"@es,
                               "Est l'objet de l'activité"@fr,
                               "Is object of activity"@en,
                               "является объектом деятельности"@ru,
                               "هو محور النشاط"@ar,
                               "是活动...的对象"@zh;
                    rdfs:subPropertyOf :causativeRelationship;
                    owl:inverseOf :hasObjectOfActivity.
:isOldNameOf a owl:ObjectProperty;
             rdfs:comment """Y <es nombre antiguo de> X. Se utiliza para etiquetas obsoletas, como nombres antiguos de países.  Por ejemplo, \"República Popular de Bulgaria\" <es nombre antiguo de> \"Bulgaria\". Usar sólo para etiquetas del mismo concepto en un idioma específico."""@es,
                          """Y <est nom ancien de> X. À utiliser pour les étiquettes obsolètes, comme les anciens noms de pays. Par exemple, \"République populaire de Bulgarie\" <est nom ancien de> \"Bulgarie\".  Utilisez uniquement entre les termes pour le même concept dans une langue spécifique. """@fr,
                          "Y <is old name of> X. Use for obsolete labels , like old names of countries. E.g. “People’s Republic of Bulgaria” <is old name of> ”Bulgaria”. Use only for labels for the same concept in a specific language."@en,
                          """Y <является старым названием> X. Используется для устаревших обозначений, например, старых названий стран. Например, \"Народная Республика Болгария\" <является старым названием> \"Болгария\". Использовать только для обозначения одного и того же понятия на определенном языке."""@ru,
                          "Y<是...的曾用名>X。用于过时的标签，如国家的旧名。例如：“保加利亚人民共和国”<是...的曾用名>“保加利亚”。限用于同一概念某一特定语言的不同标签。"@zh,
                          """ع <هي الاسم القديم لـ> س .يستخدم للتسميات القديمة ، مثل الأسماء القديمة للبلدان
على سبيل المثال:  \"جمهورية بلغاريا الشعبية\" <هي الاسم القديم لـ> \"بلغاريا\"
تستخدم فقط بين التسميات لنفس المفهوم بلغة معينة."""@ar;
             rdfs:label "Es nombre antiguo de"@es,
                        "Est nom ancien de"@fr,
                        "Is old name of"@en,
                        "является старым названием"@ru,
                        "هو الاسم القديم ل"@ar,
                        "是...的曾用名"@zh;
             rdfs:subPropertyOf :hasSynonym;
             owl:inverseOf :hasOldName.
:isOutputFrom a owl:ObjectProperty;
              rdfs:label "Is output from"@en;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :isInputFor.
:isParentOf a owl:ObjectProperty;
            rdfs:label "Is parent of"@en;
            rdfs:subPropertyOf skos:related;
            owl:inverseOf :hasParent.
:isPartOf a owl:ObjectProperty;
          rdfs:comment """ Y <es parte de> X. X está compuesto por una o más partes, donde Y es una parte. Ej. \"Cortex\" <es parte de> \"Tallos\", \"Nudosidades radiculares\" <es parte de> \"Raíces\". Utilice esta relación cuando no se aplique ninguna de las otras relaciones partitivas inferiores (<está compuesto de>, <tiene miembro>). """@es,
                       """ Y <is part of> X. X is composed of one or more parts, where Y is one part. E.g. “cortex” <is part of> “stems”, “root nodules” <is part of> “roots\". Use this relationship when none of the other lower partitive relations (<is composed of>, <has member>) apply. """@en,
                       """ Y <является частью> X. X состоит из одной или нескольких частей, где Y - одна часть. Например, \"кортекс\" <является частью> \"стебли\", \"корневые узелки\" <является частью> \"корни\". Используйте это отношение, когда ни одно из других низших партитивных отношений (<состоит из>, <hasMember>) не применимо."""@ru,
                       " Y<是...的部分>X。X由一个或多个部分组成，其中包括Y。例如：“皮层”<是...的部分>“茎”，“根节结”<是...的部分>“根”。 用于其他下位整体部分关系（<有组成部分>，<是...的组成部分>，<有成员>）都不适用时。"@zh,
                       """Y <fait partie de> X. X est composé d'une ou plusieurs parties, où Y est une partie. Par exemple, \"cortex\" <fait partie de> \"tige\", \"nodosité racinaire\" <fait partie de> \"racine\". Utilisez cette relation lorsqu'aucune des autres relations de partition inférieure (<est composé de>, <a un membre>) ne s'applique."""@fr,
                       """ع <هو جزء من> س. يتكون س من جزء واحد أو أكثر ، حيث ع جزء واحد.
على سبيل المثال: \"القشرة\" <هي جزء من> \"الساق\"
\"عقد الجذور\" <هي جزء من> \"الجذور\"
استخدم هذه العلاقة عندما لا تنطبق أي من العلاقات الجزئية السفلية الأخرى ( <مكون من>، <لديه عضو> )"""@ar;
          rdfs:label "Es parte de"@es,
                     "Fait partie de"@fr,
                     "Is part of"@en,
                     "является частью"@ru,
                     "وهو جزء من"@ar,
                     "是...的部分"@zh;
          rdfs:subPropertyOf :partitiveRelationship;
          owl:inverseOf :hasPart.
:isPartOfSubvocabulary a owl:DatatypeProperty;
                       rdfs:domain skos:Concept;
                       rdfs:label "ES PARTE DE UN SUBVOCABULARIO"@es,
                                  "FAIT PARTIE DU SOUS-VOCABULAIRE"@fr,
                                  "Is part of subvocabulary"@en,
                                  "ЯВЛЯЕТСЯ ЧАСТЬЮ МИКРОТЕЗАУРУСА"@ru;
                       rdfs:range :RangeOfIsPartOfSubvocabulary.
:isPathogenOf a owl:ObjectProperty;
              rdfs:comment """Y <es patógeno de> X . Y es un patógeno del organismo X. Ej. \"Xylella fastidiosa\" <es patógeno de> \"Olea europaea\"."""@es,
                           """Y <est pathogène de> X. Y est l'agent pathogène de l'organisme X. Par exemple, \"Xylella fastidiosa\" <est pathogène de> \"Olea europaea\". """@fr,
                           """Y <is pathogen of> X . Y is pathogen of organism X. E.g. \"Xylella fastidiosa\" <is pathogen of> \"Olea europaea\"."""@en,
                           """Y <является патогеном> X .Y является патогеном организма X. Например, \"Xylella fastidiosa\" <является патогеном> \"Olea europaea\"."""@ru,
                           "Y<是...的病原体>X。Y是生物体X的病原体。例如：“Xylella fastidiosa”<是...的病原体>“Olea europaea”。"@zh,
                           """ع <هوالعامل الممرض لـ > س. ع هو العامل الممرض للكائن الحي س. 
على سبيل المثال: \" Xylella fastidiosa \"  هو <العامل الممرض لـ > \"Olea europaea \""""@ar;
              rdfs:label "Es patógeno de"@es,
                         "Est pathogène de"@fr,
                         "Is pathogen of"@en,
                         "является патогеном"@ru,
                         "هو أحد مسببات الأمراض"@ar,
                         "是...的病原体"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :hasPathogen.
:isPerformedBy a owl:ObjectProperty;
               rdfs:label "Is performed by"@en;
               rdfs:subPropertyOf :causativeRelationship;
               owl:inverseOf :performs.
:isPerformedByMeansOf a owl:ObjectProperty;
                      rdfs:comment """Y <isPerformedByMeansOf> X. An object or process X mainly used to perform a process Y. See also <usedAs>. E.g. \"curry paste grinding\" <isPerformedByMeansOf> \"curry paste grinding machine\"; \"weapon\" <meansFor> \"killing\"; \"fishing pole\" <meansFor> \"fishing\"; \"alcohol\" <meansFor> \"cleaning\"; but NOT \"knives\" <meansFor> \"felling\" (because knives are not primarily used for cutting down trees);"""@en;
                      rdfs:label "Is performed by means of"@en;
                      rdfs:subPropertyOf :processRelationship;
                      owl:inverseOf :isMeansFor.
:isPhysiologicalFunctionOf a owl:ObjectProperty;
                           rdfs:label "Is physiological function of"@en;
                           rdfs:subPropertyOf :causativeRelationship;
                           owl:inverseOf :hasPhysiologicalFunction.
:isPostProductionPracticeFor a owl:ObjectProperty;
                             rdfs:label "Is post-production practice for"@en;
                             rdfs:subPropertyOf :isPracticeFor;
                             owl:inverseOf :hasPostProductionPractice.
:isPracticeFor a owl:ObjectProperty;
               rdfs:label "Is practice for"@en;
               rdfs:subPropertyOf :causativeRelationship;
               owl:inverseOf :hasPractice.
:isPreventedBy a owl:ObjectProperty;
               rdfs:comment """X <est empêché par> Y. X peut être réduit, interrompu ou empêché par Y. Par exemple, \"transmission des maladies\" <est empêché par> \"lavage des mains\", \"risque professionnel\" <est empêché par> \"sécurité du travail\". """@fr,
                            """X <is prevented by> Y. X can be reduced, interrupted or prevented by Y. E.g. \"disease transmission\" <is prevented by> \"hand hygiene\", \"occupational hazards\" <is prevented by> \"safety at work\"."""@en,
                            """X <se previene con> Y. X puede ser reducido, interrumpido o prevenido por Y.  Ej. \"Transmisión de enfermedades\" <se previene con> \"Higiene de manos\", \"Riesgos ocupacionales\" <se previene con> \"Seguridad en el trabajo\"."""@es,
                            """X <предотвращается> Y. X может быть уменьшен, прерван или предотвращен Y. Например, \"передача болезни\" <предотвращается> \"мытье рук\", \"профессиональные риски\" <предотвращается> \"безопасность труда\"."""@ru,
                            "X<由...防止>Y。X可通过Y来减少、中断或防止。例如：“疾病传播”<由...防止> “洗手”， “职业危害”<由...防止>“工作安全”。"@zh,
                            """س <يُمنع من خلال> ع. يمكن تقليل س أو مقاطعته أو منعه بواسطة ع. 
على سبيل المثال: \"نقل المرض\" <يتم منعه من خلال> \"نظافة اليدين\"،
 \"المخاطر المهنية\" <يتم منعها بواسطة> \"السلامة في العمل\". """@ar;
               rdfs:label "Est empêché par"@fr,
                          "Is prevented by"@en,
                          "Se previene con"@es,
                          "предотвращается"@ru,
                          "تم منعه بواسطة"@ar,
                          "由...防止"@zh;
               rdfs:subPropertyOf :causativeRelationship;
               owl:inverseOf :prevents.
:isProcessFor a owl:ObjectProperty;
              rdfs:comment """Y <es un proceso para> X. Una o varias acciones, actividades, métodos X que producen un cambio o desarrollo Y. Ej.  \"Esterilización (reproducción)\" <es un proceso para> \"Liberación de insectos estériles\", \"Fermentación alcohólica\" <es un proceso para> \"Vinificación\". """@es,
                           """Y <est un processus pour> X. Une ou plusieurs actions, activités, méthodes Y qui produisent un changement ou un développement pour X. Par exemple, \"stérilisation\" <est un processus pour> \"lâcher d'insectes stériles\", \"fermentation alcoolique\" <est un processus pour> \"vinification\". """@fr,
                           "Y <is process for> X. One or more actions, activities, methods Y that produce a change or development for X. E.g. ”sterilization” <is process for> “sterile insect release”, “alcoholic fermentation” <is process for> “winemaking”."@en,
                           """Y <является процессом для> X. Одно или несколько действий, мероприятий, методов Y, которые приводят к изменению или развитию X. Например, ”стерилизация” <является процессом для> “выпуск стерильных насекомых”, “спиртовое брожение\" <является процессом для> “виноделие\"."""@ru,
                           "Y<是…的过程>X。一个或多个行动、活动、方法Y造成X的变化或发展。例如：“绝育” <是…的过程>“不孕昆虫释放”，“酒精发酵” <是…的过程>“酿酒”。"@zh,
                           """ع <هي عملية لـ> س. إجراء واحد أو أكثر ،أنشطة أو طرق من ع تنتج تغييرًا أو تطويرًا لـ س.
 على سبيل المثال ”تعقيم” هي العملية لـ“إطلاق حشرة معقمة\",
 \"تخمير كحولي” هي العملية لـ “إعداد الخمور”."""@ar;
              rdfs:label "Es un proceso para"@es,
                         "Est un processus pour"@fr,
                         "Is process for"@en,
                         "вляется процессом для"@ru,
                         "هي العملية ل"@ar,
                         "是…的过程"@zh;
              rdfs:subPropertyOf :hasGoalOrProcess;
              owl:inverseOf :usesProcess.
:isProducedBy a owl:ObjectProperty;
              rdfs:comment """X <es producido por> Y. Restringir el uso a los procesos naturales (como los frutos que crecen en las plantas, los huevos, la leche), pero también a los procesos químicos.   Ej. “Miel” <es producido por> “Abeja melífera”, “Papa” <es producido por> “Solanum tuberosum\".  Pero, “Queso” <producto de> “Fabricación del queso”."""@es,
                           """X <est produit par> Y. Restreindre l'utilisation aux processus naturels (tels que les fruits poussant sur les plantes, les œufs, le lait) - mais aussi les processus chimiques. Par exemple, \"miel\" <est produit par> \"abeille domestique\", \"pomme de terre\" <est produit par> \"Solanum tuberosum\". Cependant, \"fromage\" <produit de> \"fabrication du fromage\". """@fr,
                           """X <is produced by> Y. Restrict use to natural processes (such as fruits growing on plants, eggs, milk) - but also chemical processes. E.g. “honey” <is produced by> “honey bees”, “potatoes” <is produced by> “Solanum tuberosum\". However, “cheese” <product of> “cheese-making”."""@en,
                           """X <производится> Y. Ограничьте использование естественными процессами (такими, как растущие на растениях плоды, яйца, молоко), а также химическими процессами. Например, \"мед\" <производится> \"медоносные пчелы\", \"картофель (клубни)\" <производится> \"Solanum tuberosum\". Однако \"сыры\" <является продуктом> \" сыроделие\"."""@ru,
                           "X<由...生产>Y。限用于自然过程（如长在植物上的水果，蛋类，牛奶），也可用于化学过程。例如：“蜂蜜”<由...生产>“蜜蜂”，“马铃薯”<由...生产>“阳芋”。但是，“干酪”<是...的产品>“奶酪制作”。"@zh,
                           """س <يُنتج من قبل> ع. تقييد الاستخدام للعمليات الطبيعية (مثل الفاكهة التي تنمو على النباتات والبيض والحليب) - ولكن أيضًا العمليات الكيميائية 
على سبيل المثال: \"العسل\" <يُنتج من قبل> \"نحل العسل\"
البطاطا <يُنتج من قبل> \"Solanum tuberosum\"
ومع ذلك ، \"الجبن\" <هو نتاج> \"صناعة الجبن\". """@ar;
              rdfs:label "Es producido por"@es,
                         "Est produit par"@fr,
                         "Is produced by"@en,
                         "производится"@ru,
                         "من إنتاج"@ar,
                         "由...生产"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :produces.
:isPropagationMaterialOf a owl:ObjectProperty;
                         rdfs:label "Is propagation material of"@en;
                         rdfs:subPropertyOf :causativeRelationship;
                         owl:inverseOf :hasPropagationMaterial.
:isPropagationProcessOf a owl:ObjectProperty;
                        rdfs:label "Is propagation process of"@en;
                        rdfs:subPropertyOf :causativeRelationship;
                        owl:inverseOf :hasPropagationProcess.
:isPropertyOf a owl:ObjectProperty;
              rdfs:comment "Y  <es propriedad de> X. Una propiedad puede ser una cualidad o un rasgo. Ej. “Viabilidad de la semilla” <es propriedad de> “Semillas”, “Propiedades medicinales” <es propriedad de> “Plantas medicinales”."@es,
                           """Y <est une propriété de> X. Une propriété peut être une qualité ou un trait. Par exemple, \"viabilité des semences\" <est une propriété de> \"semence\", \"propriété pharmacologique\" <est une propriété de> \"plante médicinale\"."""@fr,
                           "Y <is property of> X. A property might be a quality or trait. E.g. “seed viability” <is property of> “seed”, “medicinal properties” <is property of> “medicinal plants”."@en,
                           """Y <является свойством> X. Свойство может быть качеством или признаком. Например, \"жизнеспособность семян\" <является свойством> \"семенной материал\", \"фармакологические свойства\" <является свойством> \"лекарственные растения\"."""@ru,
                           "Y<是...的属性>X。属性可以是一种性质或特点。例如：“种子活力”<是...的属性>“种子”，“药物属性”<是...的属性>“药用植物类”。"@zh,
                           """ع <هي خاصية لـ> س. الخاصية قد تكون جودة أو ميزة.
على سبيل المثال: \"صلاحية البذور\" <هي خاصية لـ> \"البذور\" ، \"الخصائص الطبية\" <هي خاصية لـ> \"النباتات الطبية\". """@ar;
              rdfs:label "Es propriedad de"@es,
                         "Est une propriété de"@fr,
                         "Is property of"@en,
                         "является свойством"@ru,
                         "هي ملكية لـ"@ar,
                         "是...的属性"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :hasProperty.
:isSourceOf a owl:ObjectProperty;
            rdfs:comment """Y <es fuente de> X. E.g. “Almendra\" <es fuente de> “Aceite de almendra\", “Naranja dulce” <es fuente de> “Zumo de naranja\". Se utiliza para relacionar un organismo con un producto derivado: “Ovinos” <es fuente de> “Carne de carnero”.  (Pero “Miel” <es producido por> “Abeja melífera”, “Efluentes del ensilaje” <producto de> “Ensilado”.)"""@es,
                         """Y <est source de> X. Ex. \"amande\" <est source de> \"huile d'amande\", \"oranges douce\" <est source de> \"jus d'orange\". Utiliser pour relier un organisme à un produit dérivé : \"ovin\" <est source de> \"viande ovine\". (Mais \"miel\" <est produit par> \"abeille domestique\", \"effluent d'ensilage\" <est le produit de> \"ensilage (produit)\".)"""@fr,
                         """Y <is source of> X. E.g. “almonds\" <is source of> “almond oil”, “sweet oranges”<is source of> “orange juice\". Use to relate an organism with a derived product: “sheep” <is source of> “mutton”.  (But “honey” <is produced by> “honey bees”, “silage effluents” <product of> “silage”.)"""@en,
                         """Y <является источником> X. Например, \" миндаль (орехи)\" <является источником> \"миндальное масло\", \"апельсины\" <является источником> \"апельсиновый сок\". Используется, чтобы показать связь между организмом и производным продуктом: \"овцы\" <является источником> \"баранина\".  (Но \"Однако \"мед\" <производится> \"медоносные пчелы\", \" силосные стоки\" <является продуктом> \"силос\")."""@ru,
                         "Y<是...的来源>X。例如：“杏仁”<是...的来源>“杏仁油”，“甜橙”<是...的来源>“橙汁”。用于表示生物体及其衍生产品的关系：“绵羊”<是...的来源>“羊肉”。（但是，“蜂蜜”<由...生产> “蜜蜂”，“青贮料渗出液”<是...的产品>“青贮饲料”。）"@zh,
                         """ع <هو مصدر> س.
على سبيل المثال: \" اللوز\" <هو مصدر> \"زيت اللوز\"
\"البرتقال الحلو\" <هو مصدر> \" عصير البرتقال\"
تستخدم لربط كائن حي بمنتج مشتق: \"الخروف\" <هو مصدر> \"لحم الضأن\"
(لكن العسل <يتم إنتاجه من قبل> \"نحل العسل\"، \"مخلفات العلف المخزون\" <هي نتاج> \" العلف المخزون\")"""@ar;
            rdfs:label "Es fuente de"@es,
                       "Est source de"@fr,
                       "Is source of"@en,
                       "является источником"@ru,
                       "هو مصدر"@ar,
                       "是...的来源"@zh;
            rdfs:subPropertyOf :causativeRelationship;
            owl:inverseOf :isDerivedFrom.
:isSpatiallyIncludedIn a owl:ObjectProperty;
                       rdfs:comment """Y <est spatialement inclus dans> X. La région Y est une partie spatiale inaliénable de la région spatiale X. Par exemple, \"eaux continentales africaines\" <est spatialement inclus dans> \"Afrique\", \"Pérou\" <est spatialement inclus dans> \"région andine\". """@fr,
                                    """Y <is spatially included in> X. Spatial region Y is an inalienable spatial part of spatial region X. E.g. \"African inland waters\" <is spatially included in> \"Africa\", \"Peru\" <is spatially included in> \"Andean region\"."""@en,
                                    """Y <se incluye espacialmente en> X. La región Y es una parte espacial inalienable de la región espacial X. Ej. \"Aguas interiores de África\" <se incluye espacialmente en> \"África\", \"Perú\" <se incluye espacialmente en> \"Región andina\"."""@es,
                                    """Y <пространственно включен в> X. Пространственная область Y является неотъемлемой пространственной частью пространственной области X. Например, \"внутренние воды Африки\" <пространственно включен в> \"Африка\", \"Перу\" <пространственно включен в> \"Андский регион\"."""@ru,
                                    "Y<空间包含于>X。空间区域Y是空间区域X不可分割的空间部分。例如：“非洲大陆水体”<空间包含于>“非洲”，“秘鲁”<空间包含于>“安第斯山脉地区”。"@zh,
                                    """ع <مُدرج مكانياً في> س. المنطقة المكانية ع هي جزء مكاني غير قابل للتصرف من المنطقة المكانية س. 
على سبيل المثال: \"المياه الداخلية الإفريقية\" <مدرجة مكانيًا في> \"إفريقيا\" ، 
و \"البيرو\" <مدرجة مكانيًا في> \"منطقة الأنديز\". """@ar;
                       rdfs:domain skos:Concept;
                       rdfs:label "Est spatialement inclus dans"@fr,
                                  "Is spatially included in"@en,
                                  "Se incluye espacialmente en"@es,
                                  "пространственно включен в"@ru,
                                  "مدرج مكانيًا في"@ar,
                                  "空间包含于"@zh;
                       rdfs:subPropertyOf :spatialRelationship;
                       owl:inverseOf :spatiallyIncludes.
:isSpatiallyIncludedInCity a owl:DatatypeProperty,
                             owl:FunctionalProperty;
                           rdfs:domain skos:Concept;
                           rdfs:label "Is spatially included in city"@en;
                           rdfs:range xsd:string.
:isSpatiallyIncludedInState a owl:DatatypeProperty,
                              owl:FunctionalProperty;
                            rdfs:domain skos:Concept;
                            rdfs:label "Is spatially included in state"@en;
                            rdfs:range xsd:string.
:isStudiedBy a owl:ObjectProperty;
             rdfs:comment """X <es estudiado por > Y. El concepto X es estudiado por el campo, la ciencia o el grupo Y. Ej. “Paleontología” <es estudiado por> \"Paleontólogos”, “Condiciones de trabajo” <es estudiado por> “Ergonomía”.
"""@es,
                          """X <est étudié par> Y. Le concept X est étudié par domaine, science ou groupe Y. Par exemple, \"paléontologie\" <est étudié par> \"paléontologue\", \"condition de travail\" <est étudié par> \"ergonomie\"."""@fr,
                          """X <is studied by> Y. Concept X is studied by field, science or group Y. E.g. “palaeontology”<is studied by> \"palaeontologists”, “working conditions” <is studied by> “ergonomics”."""@en,
                          """X <изучается> Y. Понятие X изучается областью знаний, наукой или группой людей Y. Например, \"палеонтология\" <изучается> \"палеонтологи\", \"условия труда\" <изучается> \"эргономика\"."""@ru,
                          "X<被...研究>Y。概念X是领域、科学或组群Y的研究对象。例如：“古生物学”<被...研究>“古生物学家”，“工作条件”<被...研究>“人机工程学”。"@zh,
                          """س <تُدرس من قبل> ع. يتم دراسة المفهوم س حسب المجال أو العلم أو المجموعة ع. 
على سبيل المثال \"علم الحفريات\" <تمت دراسته من قبل> \"علماء الحفريات\" 
\"ظروف العمل\" <تمت دراستها من قبل>\" بيئة العمل"""@ar;
             rdfs:label "<изучается>"@ru,
                        "Es estudiado por "@es,
                        "Est étudié par "@fr,
                        """Is studied by
"""@en,
                        "تدرس من قبل"@ar,
                        "被...研究"@zh;
             rdfs:subPropertyOf :processRelationship;
             owl:inverseOf :study.
:isSubprocessOf a owl:ObjectProperty;
                rdfs:comment """Y <isSubprocessOf> X. Y is one of one or more processes naturally or conventionally associated with the realization of process X. E.g. \"pasteurization\" <isSubprocessOf> \"milk production\";"""@en;
                rdfs:label "Is subprocess of"@en;
                rdfs:subPropertyOf :isIncludedIn;
                owl:inverseOf :includesSubprocess.
:isSubstituteFor a owl:ObjectProperty;
                 rdfs:domain skos:Concept;
                 rdfs:label "Is substitute for"@en;
                 rdfs:subPropertyOf skos:related;
                 owl:inverseOf :hasSubstitute.
:isSymbolFor a owl:ObjectProperty;
             rdfs:comment """Y <es símbolo de> X. \"Fe (símbolo)\" <es símbolo de> \"Hierro\". Se utiliza para desambiguar los símbolos de elementos químicos de otras abreviaturas similares."""@es,
                          """Y <est le symbole de> X. \"Fe (symbole)\" <est le symbole de> \"fer\". À utiliser pour lever l'ambiguïté des symboles d'éléments chimiques à partir d'autres abréviations similaires. """@fr,
                          "Y <is symbol for> X. ”Fe (symbol)” <is symbol for> “iron”. Use for disambiguation of chemical element symbols from other similar abbreviations."@en,
                          """Y <символ для> X. \"Fe\" <символ для> \"железо\". Используется для разотождествления символов химических элементов от других подобных сокращений."""@ru,
                          "Y<是...的符号>X。“Fe(元素)”<是...的符号>“铁”。用于化学元素符号与其他类似缩写的消歧。"@zh,
                          """ع <هي الرمز الكيميائي لـ> س.
على سبيل المثال: \" Fe\" <هي الرمز الكيميائي لـ> \"الحديد\"
يستخدم لتوضيح رموز العناصر الكيميائية من الاختصارات المشابهة الأخرى."""@ar;
             rdfs:label "Es símbolo de"@es,
                        "Est le symbole de"@fr,
                        "Is symbol for"@en,
                        "символ для"@ru,
                        "هو رمز كيميائي لـ"@ar,
                        "是...的符号"@zh;
             rdfs:subPropertyOf :hasSynonym;
             owl:inverseOf :hasSymbol.
:isTaxonomicRankOf a owl:ObjectProperty;
                   rdfs:comment """ Y <es el rango taxonómico de> X. Describe el rango taxonómico Y del organismo X. Ej. 
\"Especie (taxón)\" <es el rango taxonómico de> \"Spodoptera frugiperda\"."""@es,
                                " Y <is taxonomic rank of> X. Describes taxonomic rank Y of organism X. E.g. “species (taxa)” <is taxonomic rank of> “Spodoptera frugiperda”."@en,
                                " Y<是...的分类等级>X。描述了生物体X的分类等级Y。例如：“物种(分类单位)”<是...的分类等级>“草地贪夜蛾”。"@zh,
                                """Y <est le rang taxonomique de> X. Décrit le rang taxonomique Y de l'organisme X. \"espèce (taxons)\" <est le rang taxonomique de> \"Spodoptera frugiperda\"."""@fr,
                                """Y <является таксономическим рангом> X. Описывает таксономический ранг Y организма X. Например, \"вид (таксон)\" <является таксономическим рангом> \"Spodoptera frugiperda\"."""@ru,
                                """ع <هي رتبة تصنيفية لـ> س. تصف المرتبة التصنيفية ع الكائن الحي س.
على سبيل المثال: \"الأنواع (نظام التصنيف)\" <هي رتبة تصنيفية لـ> \"Spodoptera frugiperda\""""@ar;
                   rdfs:domain skos:Concept;
                   rdfs:label "Es el rango taxonómico de"@es,
                              "Est le rang taxonomique de"@fr,
                              "Is taxonomic rank of"@en,
                              "является таксономическим рангом"@ru,
                              "هي رتبة تصنيفية"@ar,
                              "是...的分类等级"@zh;
                   rdfs:range skos:Concept;
                   rdfs:subPropertyOf :taxonomicRelationship;
                   owl:inverseOf :hasTaxonomicRank.
:isThemeOf a owl:ObjectProperty;
           rdfs:comment "From CWR ontology."@en;
           rdfs:label "Is theme of"@en;
           rdfs:subPropertyOf :causativeRelationship;
           owl:inverseOf :hasTheme.
:isTradeNameOf a owl:ObjectProperty;
               rdfs:label "Is a trade name of"@en;
               rdfs:subPropertyOf :hasSynonym;
               owl:inverseOf :hasTradeName.
:isTransliterationOf a owl:ObjectProperty;
                     rdfs:label "Is a transliteration of"@en;
                     rdfs:subPropertyOf skosxl:labelRelation;
                     owl:inverseOf :hasTransliteration.
:isUseOf a owl:ObjectProperty;
         rdfs:comment """Y <es el uso de> X.  Ej. \"Edulcorantes\" <es el uso de> '\"Sorbitol\",  \"Combustibles\" <es el uso de> \"Etánol\"."""@es,
                      """Y <est l'utilisation de> X.  Par exemple:  \"édulcorant\" <est l'utilisation de> \"sorbitol\",  \"combustible\" <est l'utilisation de> \"éthanol\"."""@fr,
                      """Y <is use of> X.  For example, \"sweeteners\" <is use of> '\"sorbitol\",  \"fuels\" <is use of> \"ethanol\"."""@en,
                      """Y <это использование> X.  Например,   \"подсластители\" <это использование> \"стевиозид\",  \"топливо\" <это использование> \"этанол\".  """@ru,
                      """Y <هو استخدام> X: \"محليات\" <هو استخدام> '\"سربتول\""""@ar,
                      """Y <是使用> X.  例如 : \"甜味剂\" <是使用> '\"山梨醇\",  \"燃料\" <是使用> \"乙醇\"."""@zh;
         rdfs:label "Es el uso de"@es,
                    "Est l'utilisation de"@fr,
                    "Is use of"@en,
                    "это использование"@ru,
                    "هو استخدام"@ar,
                    "是使用"@zh;
         rdfs:subPropertyOf :processRelationship;
         owl:inverseOf :isUsedAs.
:isUsedAs a owl:ObjectProperty;
          rdfs:comment """ X  <مستعمل ك> Y: \"سربتول\" <مستعمل ك> \"محليات\"; \"إيثانول\" <مستعمل ك> \"وقود\"."""@ar,
                       """X <est utilisé comme> Y. Par exemple: \"sorbitol\" <est utilisé comme> \"édulcorant\"; \"éthanol\" <est utilisé comme> \"combustible\"."""@fr,
                       """X <is used as> Y. E.g. \"sorbitol\" <is used as> \"sweetener\"; \"ethanol\" <is used as> \"fuel\"."""@en,
                       """X <se utiliza como> Y. Ej. \"Sorbitol\" <se utiliza como> \"Edulcorantes\"; \"Etánol\" <se utiliza como> \"Combustibles\"."""@es,
                       """X <направлен на> Y. X направлен на цель или процесс Y. Например, \"ветеринарные услуги\" <направлен на> \"здоровье животных\", \"рубки обновления\" <направлен на>  \"естественное возобновление\"."""@ru,
                       """X <用作> Y. 例如 :  \"山梨醇\" <用作> \"甜味剂\"; \"乙醇\" <用作> \"燃料\"."""@zh;
          rdfs:label "Est utilisé comme"@fr,
                     "Is used as"@en,
                     "Se utiliza como"@es,
                     "используется как"@ru,
                     "مستعمل ك"@ar,
                     "用作"@zh;
          rdfs:subPropertyOf :processRelationship;
          owl:inverseOf :isUseOf.
:isUsedIn a owl:ObjectProperty;
          rdfs:comment """X <es utilizado en> Y. X se usa habitualmente en Y, es normal usar X en la práctica de Y.  Ej. \"Tripa\" <es utilizado en> \"Salchicha\", \"Trenes\" <es utilizado en> \"Transporte por ferrocarriles\". """@es,
                       """X <est utilisé dans> Y.  X est habituellement utilisé dans Y, il est normal d'utiliser X dans la pratique de Y. Par exemple, \"boyau\" <est utilisé dans> \"saucisse\", \"train\" <est utilisé dans> \"transport ferroviaire\"."""@fr,
                       "X <is used in> Y. X is habitually used in Y, it is normal to use X in the practice of Y. E.g. “casings” <is used in> “sausages”, “trains” <is used in> “rail transport”."@en,
                       """X <используется в> Y. X обычно используется в Y, нормально использовать X при обращении с Y. Например, \"экструдеры\"  <используется в> \"экструзия\", \"фильтры\"  <используется в> \"сепараторы\"."""@ru,
                       "X<被用于>Y。 X习惯性地被用于Y中，在做法Y中通常使用X。例如：“肠衣”<被用于>“香肠”，“火车”<被用于>“铁路运输”。"@zh,
                       """س <يستخدم في> ع. 
يتم استخدام س عادة في ع ، ومن الطبيعي استخدام س في ممارسة ع
على سبيل المثال: \"الأغلفة\" تستخدم في \"النقانق\"
\"القطارات\" تستخدم في \"النقل بالسكك الحديدية\""""@ar;
          rdfs:label "Es utilizado en"@es,
                     "Est utilisé dans"@fr,
                     "Is used in"@en,
                     "используется в"@ru,
                     "يستخدم في"@ar,
                     "被用于"@zh;
          rdfs:subPropertyOf :processRelationship;
          owl:inverseOf :makeUseOf.
:isUsedToMake a owl:ObjectProperty;
              rdfs:comment """Y <est utilisé pour fabriquer> X. Une substance ou un produit Y est utilisé pour fabriquer le produit X. Ex. \"lait de brebis\" <est utilisé pour fabriquer> \"fromage de brebis\",  \"ciment\" <est utilisé pour fabriquer> \"béton\", \"viande porcine\" <est utilisé pour fabriquer> \"bacon\". Élément de traitement plus puissant que <est dérivé de>. """@fr,
                           """Y <is used to make> X. A substance or a product Y is used to make product X. E.g. \"ewe milk\" <is used to make> \"sheep cheese\", \"cement\" <is used to make> \"concrete\", \"pork\" <is used to make> \"bacon\". Stronger processing element than <is source of>."""@en,
                           """Y <se utiliza para  hacer> X. Una sustancia o un producto Y se utiliza para fabricar el producto X. Ej. \"Leche de oveja\" <se utiliza para  hacer> \"Queso de oveja\", \"Cemento\" <se utiliza para  hacer> \"Hormigón\", \"Carne de cerdo\" <se utiliza para  hacer> \"Tocino magro\". Elemento de procesamiento más fuerte que <es fuente de>."""@es,
                           """Y <используется для производства> X. Вещество или продукт Y используется для производства продукта X. Например, \"овечье молоко\" <используется для производства> \"овечий сыр\", \"цемент\" <используется для производства> \"бетон\", \"свинина\" <используется для производства> \"бекон\". Более сильная степень обработки, чем <является источником>."""@ru,
                           "Y<用于制作> X。物质或产品Y用于制作产品X。例如：“绵羊奶”<用于制作> “绵羊乳干酪”，“水泥”<用于制作>“混凝土”，“猪肉”<用于制作> “培根”。比<是...的来源>有更强的加工要素。"@zh,
                           """ع <يستخدم لصنع> س. المادة أو المنتج ع تستخدم لصنع المنتج س.
على سبيل المثال: \"حليب النعجة\" <يستخدم لصنع> \"جبن الغنم\"
\"الاسمنت\" <يستخدم لصنع> \"الخرسانة\"
عنصر معالجة أقوى من <هو مصدر>"""@ar;
              rdfs:label "Est utilisé pour fabriquer"@fr,
                         "Is used to make"@en,
                         "Se utiliza para hacer"@es,
                         "используется для производства"@ru,
                         "يستخدم لصنع"@ar,
                         "用于制作"@zh;
              rdfs:subPropertyOf :causativeRelationship;
              owl:inverseOf :isMadeFrom.
:isWeedOf a owl:ObjectProperty;
          rdfs:label "Is weed of"@en;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :hasWeed.
:m49Code a owl:DatatypeProperty;
         rdfs:comment """UN M49  أو معيار البلد أو رموز المنطقة للاستخدام الإحصائي
  (السلسلة M، رقم 49) هو معيار لرموز المنطقة التي تستخدمها الأمم المتحدة للأغراض الإحصائية وتطويرها والتي تحتفظ بها شعبة الإحصاءات في الأمم المتحدة. """@ar,
                      "UN M49 o Códigos de país o área estándar para fines estadísticos (serie M, nº 49) es un estándar para los códigos de área utilizados por las Naciones Unidas con fines estadísticos, desarrollado y mantenido por la División de Estadística de las Naciones Unidas."@es,
                      "UN M49 or the Standard Country or Area Codes for Statistical Use (Series M, No. 49) is a standard for area codes used by the United Nations for statistical purposes, developed and maintained by the United Nations Statistics Division."@en,
                      "UN M49 ou les codes de pays ou de zone standard à usage statistique (série M, n ° 49) est une norme pour les codes de zone utilisés par les Nations Unies à des fins statistiques, développée et maintenue par la Division de statistique des Nations Unies."@fr,
                      "Стандарт ООН M.49 (англ. UN M.49) — стандарт для кодов регионов, используемый ООН для статистических целей, разработанный и поддерживаемый Статистическим отделом ООН"@ru,
                      "联合国M49，即统计用标准国家或地区代码（M系列，第49号）是联合国用于统计目的的地区代码标准，由联合国统计司制定和维护。"@zh;
         rdfs:domain skos:Concept;
         rdfs:label "Code M49"@fr,
                    "Código M49"@es,
                    "M.49"@ru,
                    "M49 code"@en,
                    "M49码"@zh,
                    "UN M49"@ar;
         rdfs:range xsd:string;
         rdfs:subPropertyOf skos:notation.
:makeUseOf a owl:ObjectProperty;
           rdfs:comment """Y <fait usage de> X. L'activité Y utilise le processus ou l'intrant X. Par exemple, \"navigation\" <fait usage de> \"aide à la navigation\", \"agriculture de précision\" <fait usage de> \"système d'information géographique\", \"transport ferroviaire\" <fait usage de> \"train\"."""@fr,
                        """Y <hace uso de> X. La actividad Y utiliza el proceso o la entrada X. Ej. \"Navegación\" <hace uso de> \"Ayuda a la navegación\", \"Agricultura de precisión\" <hace uso de> \"Sistemas de información geográfica\", \"Transporte por ferrocarrilese\" <hace uso de> \"Trenes\". """@es,
                        "Y <make use of> X. Activity Y makes use of process or input X. E.g. “navigation” <make use of> ”navigational aids”, “precision agriculture” <make use of> ”geographical information systems”, “rail transport” <make use of> “trains”."@en,
                        """Y <использует> X. Действие Y использует процесс, оборудование или данные X. Например,  \"навигация\" <использует> \"навигационное оборудование\", \"точное сельское хозяйство\" <использует> \"географические информационные системы\",  \"сварка\" <использует> \"сварочное обрудование\"."""@ru,
                        "Y<利用>X。活动Y使用过程或投入物X。例如：“航海”<利用>“导航设备”，“精准农业”<利用>“地理信息系统”，“铁路运输”<利用>“火车”。"@zh,
                        """ع  <يستفد من> س. يستفيدالنشاط ع من العملية أو الإدخال س.
 على سبيل المثال \"لملاحة\" <تستفيد من> \"المساعدات الملاحية\"،
\"الزراعة الدقيقة \" <تستفيد من> \"نظم المعلومات الجغرافية\". 
\"النقل بالسكك الحديدية\" <تستفيد من> \" القطارات\""""@ar;
           rdfs:label "Fait usage de"@fr,
                      "Hace uso de"@es,
                      "Make use of"@en,
                      "использует"@ru,
                      "يستفاد من"@ar,
                      "利用"@zh;
           rdfs:subPropertyOf :processRelationship;
           owl:inverseOf :isUsedIn.
:measures a owl:ObjectProperty;
          rdfs:comment "Y <measures> X. Y is used to measure a quantitative property of X. For example: “thermometers” <measures> “temperature”, “social indicators” <measures> ”social change”."@en,
                       "Y <medidas> X. Y se utiliza para medir una propiedad cuantitativa de X. Ej. “Termómetros” <medidas> “Temperatura”, “Indicadores sociales” <medidas> ”Cambio social”."@es,
                       """Y <mesure> X. Y est utilisé pour mesurer une propriété quantitative de X. Par exemple, \"thermomètre\"  <mesure> \"température\", \"indicateur social\"  <mesure> \"changement social\"."""@fr,
                       """Y <измеряет> X. Y используется для измерения количественного свойства X. Например: \"термометры\" <измеряет> \"температура\", \"социальные показатели\" <измеряет> \"социальные изменения\"."""@ru,
                       "Y<测量>X。Y用于测量X数量方面的属性。例如：“体温计”<测量>“温度”，“社会指标”<测量>“社会变迁”。"@zh,
                       """ع <يقيس> س.يتم استخدام ع لقياس خاصية الكمية لـ س.
على سبيل المثال: \" ميزان الحرارة\" <يقيس> \"درجة الحرارة\"
\"المؤشرات الاجتماعية \" <تقيس> \" التغير الاجتماعي\""""@ar;
          rdfs:label "Measures"@en,
                     "Medidas"@es,
                     "Mesure"@fr,
                     "измеряет"@ru,
                     "س يقيس ص"@ar,
                     "测量"@zh;
          rdfs:subPropertyOf :quantitativeRelationship;
          owl:inverseOf :isMeasuredBy.
:partitiveRelationship a owl:ObjectProperty,
                         owl:SymmetricProperty;
                       rdfs:comment "Super-property for partitive relationships"@en,
                                    "Super-propriété pour les relations partitives"@fr,
                                    "Superpropiedad de las relaciones partitivas"@es,
                                    "Суперсвойство для партитивных отношений"@ru,
                                    "خاصية فائقة للعلاقات الجزئية"@ar,
                                    "所有整体部分关系的父类属性"@zh;
                       rdfs:domain skos:Concept;
                       rdfs:label "Partitive relationship"@en,
                                  "Relaciones partitivas"@es,
                                  "Relations partitives"@fr,
                                  "партитивные отношения"@ru,
                                  "العلاقات الجزئية"@ar,
                                  "整体部分关系"@zh;
                       rdfs:range skos:Concept;
                       rdfs:subPropertyOf skos:related.
:performs a owl:ObjectProperty;
          rdfs:label "Performs"@en;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isPerformedBy.
:pestOf a owl:ObjectProperty;
        rdfs:comment """X <es una plaga de> Y. La plaga X causa daños al organismo Y. Ej. \"Varroa destructor\" <es una plaga de> \"Apis mellifera\"."""@es,
                     """X <est peste de> Y. Le ravageur X cause des dommages à l'organisme Y. Les ravageurs sont des insectes, des nématodes et des rongeurs qui causent des dommages. Par ex. \"Varroa destructor\" <est peste de> \"Apis mellifera\". """@fr,
                     """X <pest of> Y. Pest X causes harm to organism Y. E.g. \"Varroa destructor\" <pest of> \"Apis mellifera\"."""@en,
                     "X<是...的有害生物>Y。有害生物 X对生物体Y造成损害。例如：“Varroa destructor”<是...的有害生物>“西方蜜蜂”。"@zh,
                     """Х вредитель Y. Вредитель Х наносит вред организму Y. Например, \"Varroa destructor\" <вредитель> \"Apis mellifera\"."""@ru,
                     """س <هي آفة> ع. الآفة س تسبب ضرراً للكائن الحي ع.
على سبيل المثال  \"Varroa destructor\"  <هي آفة>  \"Apis mellifera\" """@ar;
        rdfs:label "Es una plaga de"@es,
                   "Est peste de"@fr,
                   "Is a pest of"@en,
                   "вредитель"@ru,
                   "هي الآفة"@ar,
                   "是...的有害生物"@zh;
        rdfs:subPropertyOf :causativeRelationship;
        owl:inverseOf :hasPest.
:precedes a owl:ObjectProperty;
          rdfs:subPropertyOf :temporalRelationship;
          owl:inverseOf :follows.
:prevents a owl:ObjectProperty;
          rdfs:comment "Y <prevents> X. Y is an element which prevents, interrupts or reduces harm or damage X. E.g. “hand hygiene” <prevents> “disease transmission”, “safety at work”<prevents> “occupational hazards”."@en,
                       """Y <previene> X. Y es un elemento que previene, interrumpe o reduce el daño o perjuicio X. Ej. “Higiene de manos\" <previene> “Transmisión de enfermedades”, “Seguridad en el trabajo” <previene> “Riesgos ocupacionales”."""@es,
                       """Y <prévient> X. Y est un élément qui prévient, interrompt ou réduit les dommages ou dommages X. Par exemple, \"lavage des mains\" <prévient> \"transmission des maladies\", \"sécurité du travail\" <prévient> \"risque professionnel\"."""@fr,
                       """Y <предотвращает> X. Y - это элемент, который предотвращает, прерывает или уменьшает вред или ущерб X. Например, \"мытье рук\" <предотвращает> \"передача болезни\", \"безопасность труда\" <предотвращает> \"профессиональные риски\"."""@ru,
                       "Y<防止>X。Y可以防止、中断或减少伤害或损害X。例如：“洗手”<防止> “疾病传播”，“工作安全”<防止>“职业危害”。"@zh,
                       """ع <يمنع> س. ع عنصر يمنع أو يقطع أو يقلل من الضرر أو الضرر س. 
على سبيل المثال: \"نظافة اليدين\" <تمنع> \"نقل المرض\"،
 \"السلامة في العمل\" <تمنع> \"المخاطر المهنية\". """@ar;
          rdfs:label "Prevents"@en,
                     "Previene"@es,
                     "Prévient"@fr,
                     "предотвращает"@ru,
                     "يمنع"@ar,
                     "防止"@zh;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isPreventedBy.
:processRelationship a owl:ObjectProperty,
                       owl:SymmetricProperty;
                     rdfs:comment "Super-property for process relationships"@en,
                                  "Super-propriété pour les relations de processus "@fr,
                                  "Superpropiedad para relaciones de procesos"@es,
                                  "процессные отношения"@ru,
                                  "خاصية فائقة لعلاقات العملية"@ar,
                                  "所有过程关系的父类属性"@zh;
                     rdfs:domain skos:Concept;
                     rdfs:label "Process relationships"@en,
                                "Relaciones de procesos "@es,
                                "Relations de processus"@fr,
                                "процессные отношения"@ru,
                                "علاقات العملية"@ar,
                                "过程关系"@zh;
                     rdfs:range skos:Concept;
                     rdfs:subPropertyOf skos:related.
:produces a owl:ObjectProperty;
          rdfs:comment """Y <produce> X. E.g. “Abeja melífera” <produce> “Miel”,  “Solanum tuberosum” <produce> \"Papa\". Pero “Fabricación del queso” <tiene el producto> ”Queso”."""@es,
                       """Y <produces> X. E.g. “honey bees” <produces>“honey”,  “Solanum tuberosum” <produces> \"potatoes\". However, “cheese-making” <has product>”cheese”."""@en,
                       """Y <produit> X. Ex. \"abeille domestique\" <produit> \"miel\", “Solanum tuberosum” <produit> \"pomme de terre\".  Cependant, \"fabrication fromagère\" <a le produit> \"fromage\"."""@fr,
                       """Y <производит> X. Например, \"медоносные пчелы\" <производит> \"мед\", \"Solanum tuberosum\" <производит> \"картофель (клубни)\". Однако \"сыроделие\" <имеет продукт> \"сыры\"."""@ru,
                       "Y<生产>X。例如：“蜜蜂”<生产>“蜂蜜”，“阳芋”<生产>“马铃薯”。但是，“奶酪制作”<有产品>“干酪”。"@zh,
                       """ع <ينتج> س. . 
على سبيل المثال: \"نحل العسل\" <ينتج> \"العسل\"،
\"Solanum tuberosum\"<تنتج> \"البطاطا\". 
ومع ذلك ، فإن \"صناعة الجبن\" <لها منتج> \"جبن\". """@ar;
          rdfs:label "Produce"@es,
                     "Produces"@en,
                     "Produit"@fr,
                     "производит"@ru,
                     "ينتج عنه"@ar,
                     "生产"@zh;
          rdfs:subPropertyOf :causativeRelationship;
          owl:inverseOf :isProducedBy.
:productOf a owl:ObjectProperty;
           rdfs:comment """Y <est le produit de> X, avec un élément de traitement. Y est produit ou fabriqué à la suite de X. Par exemple, \"déchet d'exploitation forestière\" <est le produit de> \"exploitation forestière\", \"xérès\" <est le produit de> \"Espagne\". Cependant, \"miel\" <est produit par> \"abeille domestique\". """@fr,
                        "Y <product of> X, with a processing element. Y is produced or manufactured as a result or consequence of X. E.g. “logging wastes” <product of> “logging”, “sherry” <product of> “Spain”. However, “honey” <is produced by> “honey bees”."@en,
                        "Y <producto de> X, con un elemento de transformación. Y se produce o fabrica como resultado o consecuencia de X. Ej. “Residuos de explotación forestal” <producto de> “Aprovechamiento de la madera”, “Jerez” <producto de> “España”. Pero, “Miel” <es producido por> “Abeja melífera”."@es,
                        """Y является продуктом X, Y <является продуктом> X, с элементом обработки. Y производится или изготавливается как результат или следствие X. Например, \"ферментированные продукты\" <является продуктом> \"брожение\", \"херес\" <является продуктом> \"Испания\". Однако \"мед\" <производится> \"медоносные пчелы\"."""@ru,
                        "Y<是...的产品>X，其中有加工处理的要素。Y的生产或制造是X的结果或后果。例如：“砍伐损失”<是...的产品>“森林采运”，“雪利酒”<是...的产品>“ 西班牙”。但是，“蜂蜜” <由...生产>“蜜蜂”。"@zh,
                        """ع <هو نتاج> س مع عنصر معالجة. ع يتم إنتاجها أو تصنيعها كنتيجة أو عاقبة لـ س. 
على سبيل المثال: \"نفايات قطع الأخشاب\" <هو نتاج> \"قطع الجذور\"
\"الخمر شيري\" <هو نتاج> \"اسبانيا\"
\"العسل\" <هو نتاج> \"نحل العسل\""""@ar;
           rdfs:label "Est le produit de"@fr,
                      "Product of"@en,
                      "Producto de"@es,
                      "является продуктом"@ru,
                      "هو نتاج"@ar,
                      "是...的产品"@zh;
           rdfs:subPropertyOf :causativeRelationship;
           owl:inverseOf :hasProduct.
:quantitativeRelationship a owl:ObjectProperty,
                            owl:SymmetricProperty;
                          rdfs:comment "Super-property for quantitative relationships. All relationships involving a quantity or a measure."@en,
                                       "Super-propriété pour les relations quantitatives  Toutes les relations impliquant une quantité ou une mesure."@fr,
                                       "Superpropiedad para las relaciones cuantitativas. Todas las relaciones que implican una cantidad o una medida."@es,
                                       "Сверхсвойство для количественных отношений. Все отношения, связанные с количеством или мерой."@ru,
                                       "خاصية فائقة للعلاقات الكمية. كل العلاقات التي تتضمن كمية أو مقياس. "@ar,
                                       "所有数量关系的父类属性"@zh;
                          rdfs:domain skos:Concept;
                          rdfs:label "Quantitative relationship"@en,
                                     "Relaciones cuantitativas"@es,
                                     "Relations quantitatives "@fr,
                                     "количественные отношения"@ru,
                                     "العلاقات الكمية"@ar,
                                     "数量关系"@zh;
                          rdfs:range skos:Concept;
                          rdfs:subPropertyOf skos:related.
:scientificNameOf a owl:ObjectProperty;
                  rdfs:comment """Y <es el nombre científico de> X. Ej.\"Salmo trutta\" <es el nombre científico de> \"Trucha de mar\". Relación de etiqueta a etiqueta para su uso dentro de un concepto. Se utiliza cuando el nombre común y el nombre científico no son conceptos separados, o cuando se necesita una relación separada entre el nombre científico y el nombre común para un idioma específico. Cuando el nombre común y el nombre científico son conceptos separados, utilice la relación de concepto a concepto <tiene concepto taxonómico/tiene nombre común del concepto>."""@es,
                               """Y <est le nom scientifique de> X. \"Salmo trutta\" <est le nom scientifique de> \"truite de mer\". Relation terme à terme à utiliser dans un concept. À utiliser lorsque le nom commun et le nom scientifique ne sont pas des concepts distincts, ou lorsqu'une relation distincte entre le nom scientifique et le nom commun est nécessaire pour un Lorsque le nom commun et le nom scientifique sont des concepts distincts, utilisez la relation de concept à concept <a concept taxonomique /a nom commun de concept>. """@fr,
                               """Y <scientific name of> X. E.g. “Salmo trutta” <scientific name of> \"sea trout”. Label-to-label relationship for use within a concept. Use when common name and scientific name are not separate concepts, or when a separate relation between scientific and common name is needed for a specific language. When common name and scientific name are separate concepts, use concept-to-concept relation <has taxonomic concept/has common name concept>."""@en,
                               """Y <является научным названием> X. Например, \"Salmo trutta\" <является научным названием> \"морская форель\". Связь между метками для использования внутри понятия. Используется, когда обычное название и научное название не являются отдельными понятиями, или когда отдельное отношение между научным и обычным названием необходимо для конкретного языка. Если обычное название и научное название являются отдельными понятиями, используйте отношение между понятиями <имеет  таксономическое понятие/имеет обиходное название>."""@ru,
                               "Y<是...的学名>X。例如：“Salmo trutta”<是...的学名>“褐鳟”。可用于同一概念内的标签间关系。当俗名和学名不是独立的概念，或者当特定的语言需要在学名和俗名之间建立单独的关系时使用。当俗名和学名是独立的概念时，使用概念间关系<有分类学概念/有常用名概念>。"@zh,
                               """ع <هي الاسم العلمي لـ> س. 
على سبيل المثال:  \"Salmo trutta” <هي الاسم العلمي لـ> \"التروت البحري\" 
علاقة التسمية إلى التسمية للاستخدام داخل المفهوم.
يستخدم عندما لا يكون الاسم الشائع والاسم العلمي مفهومين منفصلين ، أو عندما تكون هناك حاجة لعلاقة منفصلة بين الاسم العلمي والاسم الشائع للغة معينة. عندما يكون الاسم الشائع والاسم العلمي مفهومين منفصلين ، استخدم علاقة المفهوم بالمفهوم <له مفهوم تصنيفي / له مفهوم اسم شائع>. """@ar;
                  rdfs:label "Es el nombre científico de"@es,
                             "Est le nom scientifique de"@fr,
                             "Scientific name of"@en,
                             "является научным названием"@ru,
                             "هو الاسم العلمي ل"@ar,
                             "是...的学名"@zh;
                  rdfs:subPropertyOf :hasSynonym;
                  owl:inverseOf :hasScientificName.
:smallerThan a owl:ObjectProperty;
             rdfs:label "Smaller than"@en;
             rdfs:subPropertyOf :quantitativeRelationship;
             owl:inverseOf :greaterThan.
:spatialRelationship a owl:ObjectProperty,
                       owl:SymmetricProperty;
                     rdfs:comment "Super-property for spatial relationships"@en,
                                  "Super-propriété pour les relations spatiales "@fr,
                                  "Superpropiedad de las relaciones espaciales"@es,
                                  "Сверхсвойство для пространственных отношений"@ru,
                                  "خاصية فائقة للعلاقات المكانية"@ar,
                                  "所有空间关系的父类属性"@zh;
                     rdfs:domain skos:Concept;
                     rdfs:label "Relaciones espaciales "@es,
                                "Relations spatiales "@fr,
                                "Spatial relationship"@en,
                                """пространственные отношения
"""@ru,
                                "العلاقات المكانية"@ar,
                                "空间关系"@zh;
                     rdfs:range skos:Concept;
                     rdfs:subPropertyOf skos:related.
:spatiallyIncludes a owl:ObjectProperty;
                   rdfs:comment """X <incluye espacialmente> Y. La parte X es una parte inalienable de Y (la región espacial ocupada por Y es una parte de la región espacial ocupada por X). Ej. \"África\" <incluye espacialmente> \"Aguas interiores de África\", \"Región andina\" <incluye espacialmente> \"Perú\". """@es,
                                """X <spatialement inclut> Y. La région X comprend spatialement comme partie inaliénable la région spatiale Y. Par exemple, \"Afrique\" <spatialement inclu> \"eaux continentales africaines\", \"région andine\" <spatialement inclu> \"Pérou\"."""@fr,
                                """X <spatially includes> Y. Region X spatially includes as inalienable part the spatial region Y. E.g. \"Africa\" <spatially includes> \"African inland waters\", \"Andean region\" <spatially includes> \"Peru\"."""@en,
                                """X <пространственно включает> Y. Регион X пространственно включает в качестве неотъемлемой части пространственный регион Y. Например, \"Африка\" <пространственно включает> \"внутренние воды Африки\", \"Андский регион\" <пространственно включает> \"Перу\"."""@ru,
                                "X<空间包含>Y。区域X在空间上包含空间区域Y ，作为其不可分割的一部分。例如：“非洲”<空间包含>“非洲大陆水体”，“安第斯山脉地区”<空间包含>“秘鲁”。"@zh,
                                """س <يشمل مكانياً > ع. تتضمن المنطقة س مكانيًا كجزء غير قابل للتصرف المنطقة المكانية ع  
على سبيل المثال: \"إفريقيا\" <تشمل مكانياً> \"المياه الداخلية الإفريقية\" ، 
و \"منطقة الأنديز\" <تشمل مكانيًا> \"البيرو\". """@ar;
                   rdfs:label "Incluye espacialmente"@es,
                              "Spatialement inclut"@fr,
                              "Spatially includes"@en,
                              "x مكانيًا يشمل y"@ar,
                              "пространственно включает"@ru,
                              "空间包含"@zh;
                   rdfs:subPropertyOf :spatialRelationship;
                   owl:inverseOf :isSpatiallyIncludedIn.
:spellingVariant a owl:ObjectProperty,
                   owl:SymmetricProperty;
                 rdfs:label "Has spelling variant"@en;
                 rdfs:subPropertyOf :hasSynonym.
:study a owl:ObjectProperty;
       rdfs:comment """Y <estudia> X. El campo, la ciencia o el grupo Y estudia el concepto X. Ej. “Sedimentología” <estudia> “Sedimento”,
“Anatomía de la madera” <estudia> “Duramen”."""@es,
                    """Y <study> X. Field, science or group Y studies concept X. E.g. “sedimentology” <study> “sediment”,
“wood anatomy” <study> “heartwood”."""@en,
                    """Y <étude> X. Domaine, science ou groupe Y étude concept X. Par exemple, \"sédimentologie\" <étude> \"sédiment\", \"anatomie du bois\" <étude> \"bois de coeur\"."""@fr,
                    """Y <изучает> X. Область, наука или группа Y изучает понятие X. Например, \"седиментология\" <изучает> \"осадок\", \"строение древесины\" <изучает> \"ядровая древесина\".
\"строение древесины\" <изучает> \"ядровая древесина\"."""@ru,
                    "Y<研究>X。领域、科学或组群Y研究X。例如：“沉积学”<研究>“沉积物”，“木材解剖学”<研究>“心材”。"@zh,
                    """ع<تدرس>س. العلم أو المجموعة ع تدرس المفهوم س. 
على سبيل المثال \"علم الرواسب\" <تدرس>\"الرواسب\" ،
 \"تشريح الخشب\" <تدرس> \"قلب الخشب\"."""@ar;
       rdfs:domain skos:Concept;
       rdfs:label "Estudia"@es,
                  "Study"@en,
                  "Étude"@fr,
                  "изучает"@ru,
                  "دراسات"@ar,
                  "研究"@zh;
       rdfs:range skos:Concept;
       rdfs:subPropertyOf :processRelationship;
       owl:inverseOf :isStudiedBy.
:surroundedBy a owl:ObjectProperty;
              rdfs:comment """X <est entouré par> Y. L'objet X est physiquement entouré par l'objet Y. Par exemple, \"pupe\" <est entouré par> \"cocon\", \"endosperme\" <est entouré par> \"cellule à aleurone\". Utiliser uniquement pour les termes qui sont physiquement immédiatement adjacents à chacun autre. Pour la géographie, utilisez  <est spatialement inclus dans>."""@fr,
                           """X <rodeado de> Y. El objeto X está físicamente rodeado por el objeto Y. Ej. “Pupa” <rodeado de> “Capullos“, \"Endosperma” <rodeado de> “Células de aleurona\". Utilizar sólo para los términos que son físicamente adyacentes entre sí. Para la geografía, utilice  <se incluye espacialmente en>.
"""@es,
                           """X <surrounded by> Y. The object X is physically surrounded by object Y. E.g. “pupae” <surrounded by> “cocoons“, \"endosperm” <surrounded by> “aleurone cells\". Use only for the terms that are physically immediately adjacent to each other. For geography use <is spatially included in>."""@en,
                           """X <окружен> Y. Объект X физически окружен объектом Y. Например, \"куколки\" <окружен> \"коконы\", \"эндосперм\" <окружен> \"алейроновые клетки\". Используйте только для терминов, которые физически непосредственно примыкают друг к другу. Для географии используйте <пространственно включен в>."""@ru,
                           "X<被...围绕>Y。物体X在物理上被物体Y围绕。例如：“蛹”<被...围绕>“茧”，“胚乳”<被...围绕>“糊粉细胞”。仅可用于物理上彼此紧邻的术语。对于地理，使用<空间包含于>。"@zh,
                           """س <مُحاط بـ > ع. الكائن س محاط فيزيائياً بالكائن ع. 
على سبيل المثال: \"الخادرة\" <محاطة بـ> \"الشرانق\" ، 
و \"السويداء\" <محاطة بـ> \"خلايا ألورون\".
تستخدم فقط للمصطلحات المتاخمة فعلياً لبعضها البعض. للاستخدام الجغرافي <مدرج مكانيًا في>. """@ar;
              rdfs:label "Est entouré par"@fr,
                         "Rodeado de"@es,
                         "Surrounded by"@en,
                         "окружен"@ru,
                         "وتحيط به"@ar,
                         "被...围绕"@zh;
              rdfs:subPropertyOf :spatialRelationship;
              owl:inverseOf :surrounds.
:surrounds a owl:ObjectProperty;
           rdfs:comment """Y <alrededor de> X. El objeto Y rodea físicamente al objeto X. Ej. ”Capullos\" <alrededor de> “Pupa“, \"Células de aleurona” <alrededor de> “Endosperma\". Utilizar sólo para los términos que son físicamente adyacentes entre sí. Para la geografía, utilice  <incluye espacialmente>."""@es,
                        """Y <entoure> X. L'objet Y entoure physiquement l'objet X. Par exemple,\"cocon\" <entoure> \"pupe\", \"cellule à aleurone\" <entoure> \"endosperme\". À utiliser uniquement pour les termes qui sont physiquement immédiatement adjacents les uns aux autres.  Pour la géographie, utilisez <spatialement inclut>."""@fr,
                        """Y <surrounds> X. The object Y is physically surrounding object X. E.g. “cocoons” <surrounds> “pupae“, \"aleurone cells” <surrounds> “endosperm\". Use only for the terms that are physically immediately adjacent to each other. For geography use <spatially Includes>."""@en,
                        """Y <окружает> X. Объект Y физически окружает объект X. Например, \"коконы\" <окружает> \"куколки\", \"алейроновые клетки\" <окружает> \"эндосперм\". Используйте только для терминов, которые физически непосредственно примыкают друг к другу. Для географии используйте <пространственно включает>."""@ru,
                        "Y<围绕>X。物体Y在物理上围绕物体X。例如：“茧”<围绕>“蛹”，“糊粉细胞”<围绕>“胚乳”。仅可用于物理上彼此紧邻的术语。对于地理，使用<空间包含>。"@zh,
                        """ع <يحيط بـ > س. الكائن ع يحيط فيزيائياً بالكائن س. 
على سبيل المثال: \"الشرانق\" <تحيط بـ> \"الخادرة\" ، 
و \"خلايا ألورون\" <تحيط بـ> \"السويداء\".
تستخدم فقط للمصطلحات المتاخمة فعلياً لبعضها البعض. للاستخدام الجغرافي <يشمل مكانيًا>. """@ar;
           rdfs:label "Alrededor de"@es,
                      "Entoure"@fr,
                      "Surrounds"@en,
                      "окружает"@ru,
                      "يحيط"@ar,
                      "围绕"@zh;
           rdfs:subPropertyOf :spatialRelationship;
           owl:inverseOf :surroundedBy.
:taxonomicRelationship a owl:ObjectProperty,
                         owl:SymmetricProperty;
                       rdfs:comment "Super-property for taxonomic relationships. "@en,
                                    "Super-propriété pour les relations taxonomiques"@fr,
                                    "Superpropiedad para relaciones taxonómicas "@es,
                                    "Суперсвойство для таксономических отношений"@ru,
                                    "الملكية الفائقة للعلاقات التصنيفية"@ar,
                                    "所有分类学关系的父类属性"@zh;
                       rdfs:domain skos:Concept;
                       rdfs:label "Relaciones taxonómicas"@es,
                                  "Relations taxonomiques"@fr,
                                  "Taxonomic relationship"@en,
                                  "таксономические отношения"@ru,
                                  "العلاقات التصنيفية"@ar,
                                  "分类学关系"@zh;
                       rdfs:range skos:Concept;
                       rdfs:subPropertyOf skos:related.
:temporalRelationship a owl:ObjectProperty,
                        owl:SymmetricProperty;
                      rdfs:domain skos:Concept;
                      rdfs:label "Temporal relations"@en;
                      rdfs:range skos:Concept;
                      rdfs:subPropertyOf skos:related.
:typeOf a owl:ObjectProperty;
        rdfs:comment """Y  <es tipo de>  X. <es tipo te> es más amplio y bastante similar a <skos:broader>, pero no es exclusivo.  Ej.\"Galope\" <es tipo de> \"Aires del caballo\", pero también los elefantes y los camellos pueden galopar."""@es,
                     """Y <est un type de> X. Concept Y est un type de X. <est un type de> est plus large et assez similaire à <skos:broader>, mais il n'est pas exclusif. Par exemple, \"galop\" <est un type de> \"allure de cheval\", mais aussi les éléphants et les chameaux peuvent galoper."""@fr,
                     "Y <type of> X. Concept Y is a type of X.  <type of> is broader and quite similar to <skos:broader>, but  it is not exclusive.  E.g. “gallop” <type of> “horse gaits”, but also elephants and camels can gallop."@en,
                     """Y <является разновидностью> X. Понятие Y является разновидностью X. Связь <является разновидностью> шире и очень похожа на <skos:broader>, но не является исключительной.  Например, \"галоп\" <является разновидностью> \"походки лошади\", но также слоны и верблюды могут скакать галопом."""@ru,
                     "Y<是...的类型>X。概念Y是X的一种类型。<是...的类型>的范围更广，与<skos:broader>十分相似，但不具有排他性。例如：“驰骋”<是...的类型>“马的步态”，但大象和骆驼也可以驰骋。"@zh,
                     """ع <هو نمط من > س. المفهوم ع هو نمط من س.<نمط من> أوسع ويشبه تمامًا <skos: أوسع> ، لكنه ليس حصريًا
على سبيل المثال: \"العدو السريع\" <هو نمط من > \"مشي الخيل\"، ولكن أيضاً الفيلة والإبل يمكنها العدو السريع"""@ar;
        rdfs:label "Es tipo de"@es,
                   "Est un type de"@fr,
                   "Type of"@en,
                   "является разновидностью"@ru,
                   "هو نوع من"@ar,
                   "是...的类型"@zh;
        rdfs:subPropertyOf :partitiveRelationship;
        owl:inverseOf :hasType.
:usesProcess a owl:ObjectProperty;
             rdfs:comment """ X <utiliza el proceso> Y. Una o varias acciones, actividades, métodos X que producen un cambio o desarrollo Y. Ej. \"Cultivos de invierno\" <utiliza el proceso> \"Vernalización\", “Envasado” <utiliza el proceso> \"Esterilización”. """@es,
                          "X <uses process> Y. X uses one or more actions, activities, methods Y as a process. E.g. “winter crops” <uses process> “vernalization”, “canning” <uses process> “sterilizing”."@en,
                          """X <utilise le processus> Y. X utilise une ou plusieurs actions, activités, méthodes Y comme processus. Par exemple, \"culture d'hiver\" <utilise le processus> \"vernalisation\", “mise en conserve” <utilise le processus> \"stérilisation (germes)”."""@fr,
                          "X <использует процесс> Y. X использует одно или несколько действий, мероприятий, методов Y в качестве процесса. Например, “озимые культуры” <использует процесс> “яровизация”, “консервирование в герметичной таре” <использует процесс> “обеззараживание”."@ru,
                          "X<使用过程>Y。X使用一个或多个行动、活动、方法Y作为其过程。例如：“越冬作物”<使用过程>“春化”，“罐藏”<使用过程>“灭菌”。"@zh,
                          """س <يستخدم العملية> ع. يستخدم س واحدًا أو أكثر من الإجراءات والأنشطة والطرق للعملية ع. 
على سبيل المثال “محاصيل شتوية” <تستخدم عملية> “التنشيط بالبرد“,
 “التعليب” <يستخدم عملية> “التعقيم”."""@ar;
             rdfs:label "Uses process"@en,
                        "Utilise le processus"@fr,
                        "Utiliza el proceso"@es,
                        "использует процесс "@ru,
                        "يستخدم العملية"@ar,
                        "使用过程"@zh;
             rdfs:subPropertyOf :isAchievedByMeansOf;
             owl:inverseOf :isProcessFor.
:usingValue a owl:ObjectProperty;
            rdfs:comment "A concept that make use of a specific value."@en;
            rdfs:label "Using value"@en;
            rdfs:subPropertyOf :quantitativeRelationship;
            owl:inverseOf :valueUsedIn.
:valueUsedIn a owl:ObjectProperty;
             rdfs:comment "A measure or other value used in a specific activity or methods or for any purpose."@en;
             rdfs:label "Value used in"@en;
             rdfs:subPropertyOf :quantitativeRelationship;
             owl:inverseOf :usingValue.
