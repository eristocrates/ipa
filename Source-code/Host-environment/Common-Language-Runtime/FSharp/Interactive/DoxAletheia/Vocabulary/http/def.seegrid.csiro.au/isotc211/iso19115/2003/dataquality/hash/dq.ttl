                                                                 dc11:date "2012-05-25T00:00:00"^^xsd:dateTime;
                                                                 dc11:description "An OWL representation of parts of the Geographic Metadata model described in ISO 19115:2003 with Corrigendum 2006 - DQ Package";
                                                                 dc11:source """ISO 19115:2003
ISO 19115:2006 Corrigendum""";
                                                                 dc11:title "OWL representation of ISO 19115 (Geographic Information - Metadata - Data quality package)";
                                                                 dcterms:created "2012-05-18T00:00:00"^^xsd:dateTime;
