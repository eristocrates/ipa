                                                                         rdf:value "Added comment"],
                                                                        [<http://purl.org/dc/elements/1.1/date> "2005-08-09" ; 
                                                                         <http://purl.org/dc/elements/1.1/creator> "Ian Davis" ; 
                                                                         rdf:value "Extracted definition from existing comment"];
                       <http://www.w3.org/2004/02/skos/core#definition> "An organization or group of individuals and/or other organizations."@en.
frbrcore:Data <http://purl.org/dc/terms/issued> "2005-10-14";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
              rdfs:label "data"@en;
              rdfs:subClassOf frbrcore:Expression.
frbrcore:Endeavour <http://purl.org/dc/terms/issued> "2005-07-15";
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class represents any one of the FRBR group one entities."@en;
                   rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                   rdfs:label "endeavour"@en;
                   <http://www.w3.org/2002/07/owl#disjointWith> frbrcore:ResponsibleEntity,
                                                                frbrcore:Subject;
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (frbrcore:Expression
                                                                                                             frbrcore:Item
                                                                                                             frbrcore:Manifestation
                                                                                                             frbrcore:Work) ; 
                                                                    rdfs:label "the union of all expressions, items, manifestations and works"@en ; 
                                                                    a <http://www.w3.org/2002/07/owl#Class>];
                   <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/elements/1.1/date> "2005-08-08" ; 
