                                                                  [<http://purl.org/dc/elements/1.1/date> "2005-08-08" ; 
                                                                   <http://purl.org/dc/elements/1.1/creator> "Ian Davis" ; 
                                                                   rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                 <http://www.w3.org/2004/02/skos/core#definition> "An abstract idea or notion."@en;
                 <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/elements/1.1/date> "2005-08-08" ; 
                                                                    <http://purl.org/dc/elements/1.1/creator> "Ian Davis" ; 
                                                                    rdf:value "Made subclass of skos:Concept"].
frbrcore:CorporateBody <http://purl.org/dc/terms/issued> "2005-07-15";
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "This class corresponds to the FRBR group two entity 'Corporate Body'."@en;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "corporate body"@en;
                       rdfs:subClassOf frbrcore:ResponsibleEntity;
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (<http://xmlns.com/foaf/0.1/Organization>
                                                                                                                 <http://xmlns.com/foaf/0.1/Group>) ; 
                                                                        rdfs:label "the union of all organizations and groups"@en ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>];
                       <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/elements/1.1/date> "2005-08-08" ; 
                                                                         <http://purl.org/dc/elements/1.1/creator> "Ian Davis" ; 
                                                                         rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                                                                        [<http://purl.org/dc/elements/1.1/date> "2005-08-08" ; 
