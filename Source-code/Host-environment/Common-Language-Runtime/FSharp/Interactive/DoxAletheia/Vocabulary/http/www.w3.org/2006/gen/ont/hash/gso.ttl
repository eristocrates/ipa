@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gso: <http://www.w3.org/2006/gen/ont#>.

<http://www.w3.org/2006/gen/ont> <http://purl.org/dc/elements/1.1/title> "An Ontology for Relating Generic and Specific Information Resources";
                                 rdfs:comment """
    This ontology implements concepts discussed in the Generic URIs 'DesignIsues' note.
    It is also the topic of the W3C TAG issue and a related TAG finding.
    This ontology does not model the fact that representations of a resource can be
    customised as a function of things like user agent, target media,
    the geographical position of the user,
    the preferences of the user, etc.  These could be and can be added.
    The FixedResource class is defined to be specific to ANY variation,
    as is the fixedResource property.
    """;
                                 rdfs:seeAlso <http://www.w3.org/DesignIssues/Generic>;
                                 <http://www.w3.org/2000/10/swap/pim/doc#creator> <http://www.w3.org/People/Berners-Lee/card#i>;
                                 <http://www.w3.org/2000/10/swap/pim/doc#ipr> <http://www.w3.org/2000/10/swap/LICENSE.n3>;
                                 <http://www.w3.org/2000/10/swap/pim/doc#version> "$Id: ont.rdf,v 1.7 2009/04/20 10:12:30 timbl Exp $".
gso:ContentTypeGenericResource rdfs:comment """A resource which may have representations in
    many different Content-Types.""";
                               rdfs:label "Content-Type-generic resource";
                               rdfs:subClassOf gso:InformationResource.
gso:ContentTypeSpecificResource rdfs:comment """A resource of which all representations are in the
		same Internet media type, or 'Content-Type'.""";
                                rdfs:label "Content-Type-specific resource";
                                rdfs:subClassOf gso:InformationResource.
gso:FixedResource a rdfs:Class;
                  rdfs:comment """A resource whose representation type and content will not
	    change under any circumstances.""";
                  rdfs:label "fixed resource";
                  rdfs:subClassOf gso:LanguageSpecificResource,
                                  gso:contentTypeSpecificResource,
                                  gso:timeSpecificResource.
gso:InformationResource a rdfs:Class;
                        rdfs:comment """An Information Resource is defined by the Architecture of
	    the WWW.""";
                        rdfs:label "information resource".
gso:LanguageGenericResource rdfs:comment """A resource defiend without constraint as to
	the particular natural language in which it
        maight be expressed.""";
                            rdfs:label "language-generic resource";
                            rdfs:subClassOf gso:InformationResource.
gso:LanguageSpecificResource rdfs:comment """A resource of which all representations are in the
		same natural language.""";
                             rdfs:label "language-specific resource";
                             rdfs:subClassOf gso:InformationResource.
gso:TimeGenericResource rdfs:comment """A Information Resource which may have many versions,
    and therfore representations of the resource at different times may vary.""";
                        rdfs:label "Time-generic resource";
                        rdfs:subClassOf gso:InformationResource.
gso:TimeSpecificResource rdfs:comment """A resource of which all representations are in the
		same version.  Representations of the resource will
                not change as a result of th resource neing updated to a
                version with time.  The dates of creation and
                of last modification of such a resource would be
                expected to be the same.""";
                         rdfs:label "version";
                         rdfs:subClassOf gso:InformationResource.
gso:contentTypeGeneric a rdf:Property;
                       rdfs:domain gso:ContentTypeSpecificResource;
                       rdfs:label "Content-Type generic";
                       rdfs:range gso:ContentTypeGenericResource;
                       rdfs:subPropertyOf gso:sameWorkAs.
gso:contentTypeSpecific a rdf:Property;
                        rdfs:domain gso:ContentTypeGenericResource;
                        rdfs:label "Content-Type specific";
                        rdfs:range gso:ContentTypeSpecificResource;
                        rdfs:subPropertyOf gso:sameWorkAs;
                        <http://www.w3.org/2002/07/owl#inverseOf> gso:ContentTypeGeneric.
gso:fixedResource a rdf:Property;
                  rdfs:comment """A relation between a generic resource and a fixedResource
    which is an everything-specific version of it.""";
                  rdfs:domain gso:InformationResource;
                  rdfs:label "Content-Type specific";
                  rdfs:range gso:FixedResource;
                  rdfs:subPropertyOf gso:contentTypeSpecific,
                                     gso:languageSpecific,
                                     gso:timeSpecific.
gso:languageGeneric a rdf:Property;
                    rdfs:domain gso:LanguageSpecificResource;
                    rdfs:label "language generic";
                    rdfs:range gso:LanguageGenericResource;
                    rdfs:subPropertyOf gso:sameWorkAs.
gso:languageSpecific a rdf:Property;
                     rdfs:domain gso:LanguageGenericResource;
                     rdfs:label "language specific";
                     rdfs:range gso:LanguageSpecificResource;
                     rdfs:subPropertyOf gso:sameWorkAs;
                     <http://www.w3.org/2002/07/owl#inverseOf> gso:languageGeneric.
gso:sameWorkAs a rdf:Property,
                 <http://www.w3.org/2002/07/owl#SymmetricProperty>;
               rdfs:comment """The equivalence relation linking all versions of a work,
            specific or generic along various axes.""";
               rdfs:domain gso:InformationResource;
               rdfs:label "same work as";
               rdfs:range gso:InformationResource.
gso:timeGeneric a rdf:Property;
                rdfs:comment """The related resource which for this time-sepcific resource
            is the related time-generic resource.
            A representation of the time-generic resource may be expected to be
            the most recent time-specific resource at the time of
            the representation.""";
                rdfs:domain gso:TimeSpecificResource;
                rdfs:label "time generic";
                rdfs:range gso:TimeGenericResource;
                rdfs:subPropertyOf gso:sameWorkAs.
gso:timeSpecific a rdf:Property;
                 rdfs:domain gso:TimeGenericResource;
                 rdfs:label "version";
                 rdfs:range gso:TimeSpecificResource;
                 rdfs:subPropertyOf gso:sameWorkAs;
                 <http://www.w3.org/2002/07/owl#inverseOf> gso:timeGeneric.
