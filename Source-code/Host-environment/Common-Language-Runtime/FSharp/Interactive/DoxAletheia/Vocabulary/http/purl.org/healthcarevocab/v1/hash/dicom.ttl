                        rdfs:isDefinedBy <http://purl.org/healthcarevocab/v1>;
                        rdfs:label "A-line Pixel Spacing";
                        rdfs:range xsd:double;
                        owl:equivalentProperty dicom:Tag.0052.0014.
dicom:ALineRate a owl:DatatypeProperty;
                rdfs:domain dicom:IE.Image;
                rdfs:isDefinedBy <http://purl.org/healthcarevocab/v1>;
