                               rdfs:label "RDA Syntax Encoding Scheme"@en;
                               rdfs:subClassOf rdfs:Datatype;
                               skos:definition "This subclass has been created to gather the Syntax Encoding Schemes used in RDA. "@en.
rdagr1:RepresentationOfCartographicImagesClass <http://metadataregistry.org/uri/profile/RegAp/name> "RepresentationOfCartographicImagesClass"@en;
                                               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
