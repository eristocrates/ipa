@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix hifm: <http://purl.org/net/hifm/ontology#>.

hifm: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/3.0/>;
      <http://purl.org/dc/terms/contributor> <https://plus.google.com/+BojanNajdenov>;
      <http://purl.org/dc/terms/creator> <https://plus.google.com/+MilosJovanovik>;
      <http://purl.org/dc/terms/description> "An ontology for describing brand-name drugs.";
      <http://purl.org/dc/terms/issued> "2014-04-01";
      <http://purl.org/dc/terms/modified> "2016-08-28";
      <http://purl.org/dc/terms/publisher> <http://finki.ukim.mk/>;
      <http://purl.org/dc/terms/rights> "Copyright 2014, Milos Jovanovik";
      <http://purl.org/dc/terms/title> "HIFM Ontology";
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "hifm";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/net/hifm/ontology#";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "The HIFM Ontology.";
      <http://www.w3.org/2002/07/owl#versionInfo> "1.1".
hifm:Drug a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents a brand-name drug.".
hifm:dosageForm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "This property represents the dosage form of the medicine.";
                rdfs:domain hifm:Drug;
                rdfs:range xsd:string.
hifm:id a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:comment "This is the ID that the medicine has in the local system of the Health Insurance Fund of Macedonia";
        rdfs:domain hifm:Drug;
        rdfs:range xsd:string.
hifm:manufacturer a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "This property represents a manufacturer of a drug.";
                  rdfs:domain hifm:Drug;
                  rdfs:range xsd:string.
hifm:notes a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "This property represents additional notes related to a medicine.";
           rdfs:domain hifm:Drug;
           rdfs:range xsd:string.
hifm:packaging a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "This property represents the number of units per drug package.";
               rdfs:domain hifm:Drug;
               rdfs:range xsd:nonNegativeInteger.
hifm:refPriceNoVAT a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "This property represents the referent price of the medicine in macedonian denars (MKD), with NO VAT calculated";
                   rdfs:domain hifm:Drug;
                   rdfs:range xsd:float.
hifm:refPriceWithVAT a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "This property represents the referent value of the medicine in macedonian denars (MKD), with VAT calculated";
                     rdfs:domain hifm:Drug;
                     rdfs:range xsd:float.
hifm:similarTo a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                 <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property represents a similarity that is known between two drugs.";
               rdfs:domain hifm:Drug;
               rdfs:range hifm:Drug.
hifm:strength a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "This property represents the strength of the drug, in milligrams.";
              rdfs:domain hifm:Drug;
              rdfs:range xsd:string.
