@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix hifm: <http://purl.org/net/hifm/ontology#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

hifm: ccrel:license <https://creativecommons.org/licenses/by/3.0/>;
      dcterms:contributor <https://plus.google.com/+BojanNajdenov>;
      dcterms:creator <https://plus.google.com/+MilosJovanovik>;
      dcterms:description "An ontology for describing brand-name drugs.";
      dcterms:issued "2014-04-01";
      dcterms:modified "2016-08-28";
      dcterms:publisher <http://finki.ukim.mk/>;
      dcterms:rights "Copyright 2014, Milos Jovanovik";
      dcterms:title "HIFM Ontology";
      vann:preferredNamespacePrefix "hifm";
      vann:preferredNamespaceUri "http://purl.org/net/hifm/ontology#";
      a owl:Ontology;
      rdfs:comment "The HIFM Ontology.";
      owl:versionInfo "1.1".
hifm:Drug a owl:Class;
          rdfs:comment "This class represents a brand-name drug.".
hifm:dosageForm a owl:DatatypeProperty;
                rdfs:comment "This property represents the dosage form of the medicine.";
                rdfs:domain hifm:Drug;
                rdfs:range xsd:string.
hifm:id a owl:DatatypeProperty;
        rdfs:comment "This is the ID that the medicine has in the local system of the Health Insurance Fund of Macedonia";
        rdfs:domain hifm:Drug;
        rdfs:range xsd:string.
hifm:manufacturer a owl:DatatypeProperty;
                  rdfs:comment "This property represents a manufacturer of a drug.";
                  rdfs:domain hifm:Drug;
                  rdfs:range xsd:string.
hifm:notes a owl:DatatypeProperty;
           rdfs:comment "This property represents additional notes related to a medicine.";
           rdfs:domain hifm:Drug;
           rdfs:range xsd:string.
hifm:packaging a owl:DatatypeProperty;
               rdfs:comment "This property represents the number of units per drug package.";
               rdfs:domain hifm:Drug;
               rdfs:range xsd:nonNegativeInteger.
hifm:refPriceNoVAT a owl:DatatypeProperty;
                   rdfs:comment "This property represents the referent price of the medicine in macedonian denars (MKD), with NO VAT calculated";
                   rdfs:domain hifm:Drug;
                   rdfs:range xsd:float.
hifm:refPriceWithVAT a owl:DatatypeProperty;
                     rdfs:comment "This property represents the referent value of the medicine in macedonian denars (MKD), with VAT calculated";
                     rdfs:domain hifm:Drug;
                     rdfs:range xsd:float.
hifm:similarTo a owl:TransitiveProperty,
                 owl:SymmetricProperty,
                 owl:ObjectProperty;
               rdfs:comment "This property represents a similarity that is known between two drugs.";
               rdfs:domain hifm:Drug;
               rdfs:range hifm:Drug.
hifm:strength a owl:DatatypeProperty;
              rdfs:comment "This property represents the strength of the drug, in milligrams.";
              rdfs:domain hifm:Drug;
              rdfs:range xsd:string.
