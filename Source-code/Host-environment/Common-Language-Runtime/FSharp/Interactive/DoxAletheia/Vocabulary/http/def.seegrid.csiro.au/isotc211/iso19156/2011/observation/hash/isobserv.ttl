@prefix isobserv: <http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation#>.

<http://def.seegrid.csiro.au/isotc211/iso19156/2011/observation> <http://purl.org/dc/elements/1.1/creator> """Simon Jonathan David COX
CSIRO""";
                                                                 <http://purl.org/dc/elements/1.1/description> "An OWL representation of the Observation Schema described in clause 6 of ISO 19156:2011 Geographic Information - Observations and Measurements";
                                                                 <http://purl.org/dc/elements/1.1/rights> "Copyright © 2012-2013 CSIRO";
                                                                 <http://purl.org/dc/elements/1.1/source> "ISO 19156:2011";
                                                                 <http://purl.org/dc/elements/1.1/title> "OWL representation of ISO 19156 (Observation model)";
                                                                 <http://purl.org/dc/terms/created> "2011-07-07T00:00:00"^^xsd:dateTime;
