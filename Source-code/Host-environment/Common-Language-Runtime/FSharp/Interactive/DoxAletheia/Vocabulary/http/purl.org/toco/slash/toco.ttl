<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
toco: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
      <http://purl.org/dc/terms/contributor> <https://www.hw.ac.uk/staff/uk/eps/stephen-mclaughlin.htm>,
                                             <https://www.eng.ed.ac.uk/about/people/mr-mohammad-dehghani-soltani>,
                                             <http://www.macs.hw.ac.uk/~ajg33/>;
      <http://purl.org/dc/terms/creator> <https://www.gla.ac.uk/schools/computing/staff/qianruzhou/>;
      <http://purl.org/dc/terms/description> "A ontology developed for telecommunciation network systems with hybrid technologies, e.g., WiFi, LiFi, LTE, 2G/3G, optical, etc.";
      <http://purl.org/dc/terms/issued> "2015-3-1"^^xsd:date;
      <http://purl.org/dc/terms/modified> "2019-3-29"^^xsd:date;
      <http://purl.org/dc/terms/publisher> <http://hw.ac.uk/>;
      <http://purl.org/dc/terms/rights> "Copyright  © 2015 Qianru Zhou";
      <http://purl.org/dc/terms/title> "Toucan Ontology"@en;
      <http://purl.org/vacob/vann/preferredNamespacePrefix> "toco";
      <http://purl.org/vacob/vann/preferredNamespaceUri> "http://purl.org/toco/";
      a <http://purl.org/vocommons/voaf#Vocabulary>,
        <http://www.w3.org/2002/07/owl#NamedIndividual>,
        <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "Version 1.1: creation"@en;
      <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
toco:AccessPoint a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "a wireless access point, or more generally just access point (AP), is a networking hardware device that allows a Wi-Fi/Li-Fi device to connect to a wired network. The AP usually connects to a router (via a wired network) as a standalone device, but it can also be an integral component of the router itself. An AP is differentiated from a hotspot, which is the physical location where Wi-Fi access to a WLAN is available.";
                 rdfs:subClassOf toco:SystemDevice.
toco:Action a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "the action of a flow defined in OpenFlow protocol";
            rdfs:subClassOf toco:ConceptEntities.
toco:Attached a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf toco:UserDeviceStatus.
toco:AudioService a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf toco:Service.
toco:AudioSession a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf toco:Session.
toco:BaseStation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """a \"land station in the land mobile service.\" -- according to the International Telecommunication Union's (ITU) Radio Regulations (RR).

it is a transceiver connecting a number of other devices to one another and/or to a wider area. In LTE, it is also known as eNodeB.""";
                 rdfs:subClassOf toco:SystemDevice.
toco:CellularUserEquipment a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "User deivce in a Cellular network.";
                           rdfs:subClassOf toco:UserEquipment.
toco:ConceptEntities a <http://www.w3.org/2002/07/owl#Class>;
                     <http://www.w3.org/2002/07/owl#disjointWith> toco:PhysicalInfrastructure.
toco:Detached a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf toco:UserDeviceStatus.
toco:Device a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """represent all the devices in the physical infrastructure of telecommunciation system. 

According to its user, could be divided into UserDevice and SystemDevice.""";
            rdfs:subClassOf toco:PhysicalInfrastructure.
toco:Drop a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf toco:Action.
toco:FileTransferService a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:subClassOf toco:Service.
toco:Flow a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "the flow entry in a flow table inside a switch or route. Defined by OpenFlow protocol.";
          rdfs:subClassOf toco:ConceptEntities.
toco:Forward a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf toco:Action.
toco:Host a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A host is a computer or other device connected to a computer network. It is a network node that is assigned a network address.";
          rdfs:subClassOf toco:UserDevice.
toco:Interface a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf toco:PhysicalInfrastructure.
toco:LTEAssociation a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "the electromagnetic wave carring modulated signal between LTE base station, or eNodeB, and user equipment";
                    rdfs:subClassOf toco:WirelessAssociation.
toco:LiFiAccessPoint a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The access point in Li-Fi network. Li-Fi is a wireless optical networking technology that uses light-emitting diodes (LEDs) for data transmission.";
                     rdfs:subClassOf toco:AccessPoint.
toco:LiFiAssociation a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "the visiable light carring modulated signals in Li-Fi network. Transmited and received by LiFi user equipment and LiFi access point.";
                     rdfs:subClassOf toco:WirelessAssociation.
toco:LiFiUserEquipment a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "any device used directly by an end-user to communicate. It can be a hand-held telephone, a laptop computer equipped with a mobile broadband adapter, or any other device.";
                       rdfs:subClassOf toco:UserEquipment.
toco:LiFiWLAN a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "WLAN interface on the devices in LIFi network, e.g., LiFi user equipment, LiFi access point.";
              rdfs:subClassOf toco:WLAN.
toco:Link a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf toco:PhysicalInfrastructure.
toco:Output a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf toco:Action.
toco:PathFlow a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf toco:Flow.
toco:PhysicalInfrastructure a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment """Describe all the physical resources in a telecommunication network system, which is divided into three main modules, namely, device, interface, link. 

Please be reminded the electromagnetic wave (which is the links of all wireless communication netwoks), even if it is invisable, physically exists. Thus, it is also described in the subclass of \"net;PhysicalInfrastructure\".""".
toco:SatelliteAssociation a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "the milli-meter electromagnetic wave carring modulated signal between satellite base stations and ground station.";
                          rdfs:subClassOf toco:WirelessAssociation.
toco:SatelliteGroundStation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "used in satellite network. Also known as earth station, or earth terminal, it is a terrestrial radio station designed for extraplanetary telecommunication with spacecraft (constituting part of the ground segment of the spacecraft system), or reception of radio waves from astronomical radio sources. Ground stations may be located either on the surface of the Earth, or in its atmosphere.[1] Earth stations communicate with spacecraft by transmitting and receiving radio waves in the super high frequency or extremely high frequency bands (e.g., microwaves). When a ground station successfully transmits radio waves to a spacecraft (or vice versa), it establishes a telecommunications link. A principal telecommunications device of the ground station is the parabolic antenna.";
                            rdfs:subClassOf toco:UserEquipment.
toco:SatelliteRelayStation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "An artificial satellite, that relays and amplifies radio telecommunications signals via a transponder; it creates a communication channel between a source transmitter and a receiver at different locations on Earth. Communications satellites are used for television, telephone, radio, internet, and military applications.";
                           rdfs:subClassOf toco:SystemDevice.
toco:Service a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "a communication service, e.g., voice, video, file uploading/downloading, etc.";
             rdfs:subClassOf toco:ConceptEntities.
toco:Session a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:subClassOf toco:ConceptEntities.
toco:Switch a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A network switch (also called switching hub, bridging hub, officially MAC bridge) is a computer networking device that connects devices together on a computer network by using packet switching to receive, process, and forward data to the destination device.";
            rdfs:subClassOf toco:SystemDevice.
toco:SystemDevice a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "All the physical facilities in the telecommunication system that provide the communication service to uses. For example: base station towers, Wi-Fi access points, switches, servers, etc.";
                  rdfs:subClassOf toco:Device.
toco:Text a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf toco:Service.
toco:User a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "reused from foaf (http://xmlns.com/foaf/0.1/). Represent a user in the telecommunication system.";
          rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
toco:UserDevice a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "User Devices, requiring connectivity services, e.g., phones, tablets, laptops, wearable devices, etc.";
                rdfs:subClassOf toco:Device.
toco:UserDeviceStatus a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf toco:ConceptEntities.
toco:UserEquipment a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "any device used directly by an end-user to communicate. It can be a hand-held telephone, a laptop computer equipped with a mobile broadband adapter, or any other device.";
                   rdfs:subClassOf toco:UserDevice.
toco:VideoService a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf toco:Service.
toco:VideoSession a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf toco:Session.
toco:WLAN a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A wireless local area network (WLAN) interface, also known as WLAN, is the interface of a wireless computer network that links two or more devices using wireless communication within a limited area such as a home, school, computer laboratory, or office building.";
          rdfs:subClassOf toco:Interface.
toco:WiFiAccessPoint a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An access point in a WiFi network";
                     rdfs:subClassOf toco:AccessPoint.
toco:WiFiAssociation a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "the electromagnetic wave carring modulated signal between LTE base station, or eNodeB, and user equipment";
                     rdfs:subClassOf toco:WirelessAssociation.
