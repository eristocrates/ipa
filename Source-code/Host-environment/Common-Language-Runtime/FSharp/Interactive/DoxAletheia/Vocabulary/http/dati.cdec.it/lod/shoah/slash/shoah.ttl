@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix shoah: <http://dati.cdec.it/lod/shoah/>.

shoah: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/4.0/>;
       <http://purl.org/dc/elements/1.1/creator> "Laura Brazzo";
       <http://purl.org/dc/elements/1.1/description> "The ontology describing the Shoah domain, proposed here in beta version, aims to formally describe concepts and relationships that characterize the process of persecution and deportation of Jews in Italy between 1943 and 1945."@en;
       <http://purl.org/dc/terms/creator> <https://plus.google.com/+silviamazzini_lod/>,
                                          shoah:www.cdec.it,
                                          shoah:www.regesta.com;
       <http://purl.org/dc/terms/issued> "2014-01-01"^^xsd:date;
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "shoah";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://dati.cdec.it/lod/shoah/";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       <http://www.w3.org/2002/07/owl#imports> <http://purl.org/vocab/bio/0.1/>,
                                               <http://xmlns.com/foaf/0.1/>;
       <http://www.w3.org/2002/07/owl#versionIRI> shoah:0.1;
       <http://www.w3.org/2002/07/owl#versionInfo> "beta version".
shoah:Convoy a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Convoy"@en.
shoah:DetentionPlace a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Detention Place"@en.
shoah:DetentionPlaceTransfer a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "Detention Place Transfer"@en.
shoah:Liberation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Liberation"@en.
shoah:Massacre a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Massacre"@en.
shoah:NaziCamp a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Nazi Camp"@en.
shoah:NaziCampTransfer a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Nazi Camp Transfer"@en.
shoah:Persecution a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Persecution"@en.
shoah:Place a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Place"@en.
shoah:arrestDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain shoah:Persecution;
                 rdfs:label "Arrest Date"@en;
                 rdfs:range xsd:string.
shoah:arrestPlace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain shoah:Persecution;
                  rdfs:label "Arrest Place"@en;
                  rdfs:range shoah:Place.
shoah:arrestedBy a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain shoah:Persecution;
                 rdfs:label "Arrested By"@en;
                 rdfs:range xsd:string.
shoah:arrivalDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain shoah:Convoy;
                  rdfs:label "Arrival Date"@en.
shoah:auntOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
             rdfs:label "Aunt of"@en;
             rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:brotherOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                rdfs:label "Brother of"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:campSerialNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain shoah:Persecution;
                       rdfs:label "Camp Serial Number"@en;
                       rdfs:range xsd:string.
shoah:consortFamilyName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                        rdfs:label "Consort Family Name"@en;
                        rdfs:range xsd:string.
shoah:consortFirstName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                       rdfs:label "Consort First Name"@en;
                       rdfs:range xsd:string.
shoah:consortOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                rdfs:label "Consort of"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:consortReligion a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                      rdfs:label "Consort Religion"@en;
                      rdfs:range xsd:string.
shoah:convoy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain shoah:Persecution;
             rdfs:label "Convoy"@en;
             rdfs:range shoah:Convoy.
shoah:convoyDeparturePlace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain shoah:Persecution;
                           rdfs:label "Last Place before Deportation"@en;
                           rdfs:range shoah:DetentionPlace.
shoah:convoyNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain shoah:Persecution;
                   rdfs:label "Convoy Number"@en.
shoah:country a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain shoah:Place;
              rdfs:label "Country"@en;
              rdfs:range xsd:string.
shoah:dateOfBirth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                  rdfs:label "Date of Birth"@en;
                  rdfs:range xsd:dateTime.
shoah:dateOfDeath a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                  rdfs:label "Date of Death"@en;
                  rdfs:range xsd:dateTime.
shoah:deathDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                       rdfs:label "Death Description"@en;
                       rdfs:range xsd:string.
shoah:deathInItaly a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain shoah:Persecution;
                   rdfs:label "Death in Italy"@en;
                   rdfs:range xsd:boolean.
shoah:departureDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain shoah:Persecution;
                    rdfs:label "Departure Date"@en;
                    rdfs:range xsd:dateTime.
shoah:detentionPlace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain shoah:Persecution;
                     rdfs:label "Detention Place"@en;
                     rdfs:range shoah:DetentionPlace.
shoah:detentionPlaceTransfer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:domain shoah:Persecution;
                             rdfs:label "Detention Place Transfer"@en;
                             rdfs:range shoah:DetentionPlaceTransfer.
shoah:districtOfResidence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                          rdfs:label "District of Residence"@en;
                          rdfs:range xsd:string.
shoah:fatherName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                 rdfs:label "Father Name"@en;
                 rdfs:range xsd:string.
shoah:fatherOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
               rdfs:label "Father of"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:fromNaziCamp a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain shoah:NaziCampTransfer;
                   rdfs:label "from Camp"@en;
                   rdfs:range shoah:NaziCamp.
shoah:fromPrison a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain shoah:DetentionPlaceTransfer;
                 rdfs:label "from Prison"@en;
                 rdfs:range shoah:DetentionPlace.
shoah:grandfatherOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                    rdfs:label "Grandfather of"@en;
                    rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:grandmotherOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                    rdfs:label "Grandmother of"@en;
                    rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:liberation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain shoah:Persecution;
                 rdfs:label "Liberation"@en;
                 rdfs:range shoah:Liberation.
shoah:liberationDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain shoah:Liberation;
                     rdfs:label "Liberation Date"@en;
                     rdfs:range xsd:dateTime.
shoah:massacre a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain shoah:Persecution;
               rdfs:label "Massacre in Italy"@en;
               rdfs:range shoah:Massacre.
shoah:motherMaidenName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                       rdfs:label "Mother Maiden Name"@en;
                       rdfs:range xsd:string.
shoah:motherName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                 rdfs:label "Mother Name"@en;
                 rdfs:range xsd:string.
shoah:motherOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
               rdfs:label "Mother of"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:naziCampTransfer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain shoah:Persecution;
                       rdfs:label "Nazi Camp Transfer"@en;
                       rdfs:range shoah:NaziCampTransfer.
shoah:parentPlace a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain shoah:Place;
                  rdfs:label "Parent Place"@en;
                  rdfs:range xsd:string.
shoah:parentReligion a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                     rdfs:label "Parent Religion"@en;
                     rdfs:range xsd:string.
shoah:persecution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                  rdfs:label "Persecution"@en;
                  rdfs:range shoah:Persecution.
shoah:persecutionCategory a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain shoah:Persecution;
                          rdfs:label "Reason of Deportation"@en;
                          rdfs:range xsd:dateTime.
shoah:placeOfBirth a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                   rdfs:label "Place of Birth"@en;
                   rdfs:range shoah:Place.
shoah:placeOfDeath a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                   rdfs:label "Place of Death"@en;
                   rdfs:range shoah:Place.
shoah:returnDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain shoah:Liberation;
                 rdfs:label "Return Date"@en;
                 rdfs:range xsd:dateTime.
shoah:returnPlace a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain shoah:Liberation;
                  rdfs:label "Return Place"@en;
                  rdfs:range xsd:string.
shoah:shoahSurvivor a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                    rdfs:label "Shoah Survivor"@en;
                    rdfs:range xsd:boolean.
shoah:sisterOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
               rdfs:label "Sister of"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:subCampOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain shoah:NaziCamp;
                rdfs:label "Sub Camp of"@en;
                rdfs:range shoah:NaziCamp.
shoah:toNaziCamp a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain shoah:NaziCampTransfer,
                             shoah:Persecution;
                 rdfs:label "to Camp"@en;
                 rdfs:range shoah:NaziCamp.
shoah:toPrison a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain shoah:DetentionPlaceTransfer;
               rdfs:label "to Prison"@en;
               rdfs:range shoah:DetentionPlace.
shoah:transferDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain shoah:NaziCampTransfer;
                   rdfs:label "Transfer Date"@en;
                   rdfs:range xsd:string.
shoah:uncleOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
              rdfs:label "Uncle of"@en;
              rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:widowOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
              rdfs:label "Widow of"@en;
              rdfs:range <http://xmlns.com/foaf/0.1/Person>.
shoah:widowerOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                rdfs:label "Widower of"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>.
