@base <http://www.daml.org/services/owl-s/1.2/ProfileAdditionalParameters.owl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix profile: <http://www.daml.org/services/owl-s/1.2/Profile.owl#>.
@prefix : <http://www.daml.org/services/owl-s/1.2/ProfileAdditionalParameters.owl#>.
@prefix owlsProfileAdditionalParameters: <http://www.daml.org/services/owl-s/1.2/ProfileAdditionalParameters.owl#>.

<http://www.daml.org/services/owl-s/1.2/ProfileAdditionalParameters.owl> a owl:Ontology;
                                                                         rdfs:comment """
      Process and Service Coalition
      Additional concepts and definitions that augment the OWL-S Profile
      ontology.
      These accompany the OWL-S Release
      Created by Terry Payne (terryp@cs.cmu.edu).
      Modified by Massimo Paolucci (paolucci@cs.cmu.edu)

    """;
                                                                         rdfs:seeAlso <http://www.daml.org/services>;
                                                                         owl:imports <http://www.daml.org/services/owl-s/1.2/Profile.owl>;
                                                                         owl:versionInfo """
      $Id: ProfileAdditionalParameters.owl,v 1.11 2004/11/28 16:29:55 martin Exp $
    """.
:AverageResponseTime a owl:Class;
                     rdfs:subClassOf profile:ServiceParameter,
                                     [a owl:Restriction ; 
                                      owl:onProperty profile:sParameter ; 
                                      owl:allValuesFrom :Duration].
:Duration a owl:Class.
:GeographicRadius a owl:Class;
                  rdfs:subClassOf profile:ServiceParameter,
                                  [a owl:Restriction ; 
                                   owl:onProperty profile:sParameter ; 
                                   owl:allValuesFrom <http://www.daml.org/services/owl-s/1.2/Country.owl#Country>].
:MaxResponseTime a owl:Class;
                 rdfs:subClassOf profile:ServiceParameter,
                                 [a owl:Restriction ; 
                                  owl:onProperty profile:sParameter ; 
                                  owl:allValuesFrom :Duration].
:NAICS a owl:Class;
       rdfs:comment """
      Hook to the NAICS taxonomy 
    """;
       rdfs:subClassOf profile:ServiceCategory,
                       [a owl:Restriction ; 
                        owl:onProperty profile:categoryName ; 
                        owl:hasValue """
	  NAICS 
	"""],
                       [a owl:Restriction ; 
                        owl:onProperty profile:taxonomy ; 
                        owl:hasValue """
	  www.naics.com
	"""].
:UNSPSC a owl:Class;
        rdfs:comment """
      Hook to the UNSPSC taxonomy 
      """;
        rdfs:subClassOf profile:ServiceCategory,
                        [a owl:Restriction ; 
                         owl:onProperty profile:categoryName ; 
                         owl:hasValue """
	   UNSPSC
	"""],
                        [a owl:Restriction ; 
                         owl:onProperty profile:taxonomy ; 
                         owl:hasValue """
	  www.un-spsc.net
	"""].
