@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vsearch: <http://purl.org/vsearch/>.

vsearch: <http://purl.org/dc/elements/1.1/creator> <http://dblp.org/pers/hd/s/Stavrakantonakis:Ioannis>;
         <http://purl.org/dc/terms/created> "2016-01-16"^^xsd:date;
         <http://purl.org/dc/terms/description> "The vSearch vocabulary facilitates the querying and retrieval of vocabulary terms from a vocabularies directory. It can be used to map keywords with mapped result terms accompanied with a ranking value.";
         <http://purl.org/dc/terms/modified> "2016-01-16"^^xsd:date;
         <http://purl.org/dc/terms/title> "vSearch Vocabulary";
         <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "vsearch";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/vsearch/";
         a <http://www.w3.org/2002/07/owl#Ontology>;
         <http://www.w3.org/2002/07/owl#sameAs> <http://vocab.sti2.at/vsearch/>;
         <http://www.w3.org/2002/07/owl#versionInfo> "v0.1";
         <http://xmlns.com/foaf/0.1/homepage> <https://istavrak.github.io/vSearch>.
vsearch:Query a <http://www.w3.org/2002/07/owl#Class>,
                rdfs:Class;
              rdfs:comment "A query.";
              rdfs:isDefinedBy vsearch:;
              rdfs:label "query"@en.
vsearch:ResultTerm a <http://www.w3.org/2002/07/owl#Class>,
                     rdfs:Class;
                   rdfs:comment "A result term.";
                   rdfs:isDefinedBy vsearch:;
                   rdfs:label "result term"@en.
vsearch:doQuery a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "A query that an entity executes.";
                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:isDefinedBy vsearch:;
                rdfs:label "do query"@en;
                rdfs:range vsearch:Query.
vsearch:hasRank a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "The rank for a result term.";
                rdfs:domain <http://purl.org/ResultTerm>;
                rdfs:isDefinedBy vsearch:;
                rdfs:label "has rank"@en;
                rdfs:range <http://purl.org/voc/vrank#Rank>.
vsearch:hasResultTerm a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        rdf:Property;
                      rdfs:comment "A result term for a query.";
                      rdfs:domain vsearch:Query;
                      rdfs:isDefinedBy vsearch:;
                      rdfs:label "has result term"@en;
                      rdfs:range vsearch:ResultTerm.
vsearch:keyword a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment "The keyword of the query.";
                rdfs:domain vsearch:Query;
                rdfs:isDefinedBy vsearch:;
                rdfs:label "keyword"@en;
                rdfs:range xsd:string.
vsearch:language a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "The language of the query keyword.";
                 rdfs:domain vsearch:Query;
                 rdfs:isDefinedBy vsearch:;
                 rdfs:label "language"@en;
                 rdfs:range xsd:string.
vsearch:rankValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    rdf:Property;
                  rdfs:comment "The rank value of a term's ranking.";
                  rdfs:domain <http://purl.org/voc/vrank#Rank>;
                  rdfs:isDefinedBy <http://purl.org/voc/vrank/>;
                  rdfs:label "rank value"@en;
                  rdfs:range xsd:float.
vsearch:termURI a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment "The URI of the result term.";
                rdfs:domain vsearch:ResultTerm;
                rdfs:isDefinedBy vsearch:;
                rdfs:label "term URI"@en;
                rdfs:range xsd:string.
