@base <http://www.w3.org/2000/10/swap/pim/doc>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://www.w3.org/2000/01/rdf-schema#>.
@prefix doc: <http://www.w3.org/2000/10/swap/pim/doc#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix r: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix swap_doc: <http://www.w3.org/2000/10/swap/pim/doc#>.

<http://www.w3.org/2000/10/swap/pim/doc> doc:creator <http://www.w3.org/People/Berners-Lee/card#i>;
                                         doc:ipr <http://www.w3.org/2000/10/swap/LICENSE.n3>;
                                         doc:version "$Id: doc.rdf,v 1.4 2006/07/29 20:18:43 timbl Exp $".
doc:OpenSourceLicense rdfs:comment """Class of licenses which can be called Open Soutrce
                according to opensource.org""";
                      rdfs:label "Opem Source licence";
                      rdfs:subClassOf doc:Work.
doc:Work a rdfs:Class;
         rdfs:comment "An abstract information thing of value, typically intellectual property";
         rdfs:label "work".
doc:adminPage a rdf:Property;
              rdfs:comment """A web page allowing a human user to administer this work,
            for example changing access control, version control information etc.""";
              rdfs:domain doc:Work;
              rdfs:label "administrative page".
doc:creator a rdf:Property;
            rdfs:comment "The person (not string) who created this.";
            rdfs:domain doc:Work;
            rdfs:label "creator";
            rdfs:range <http://www.w3.org/2000/10/swap/pim/contact#SocialEntity>.
doc:dependsOn a rdf:Property;
              rdfs:comment "The meaning or value of this work depends on that of that work.";
              rdfs:domain doc:Work;
              rdfs:label "depends on";
              rdfs:range doc:Work.
doc:derivativeWork a rdf:Property;
                   rdfs:comment "A work wholey or partly used in the creation of this one.";
                   rdfs:domain doc:Work;
                   rdfs:label "derivative work";
                   rdfs:range doc:Work;
                   owl:inverseOf doc:derivedFrom.
doc:derivedFrom a rdf:Property;
                rdfs:comment "A work wholey or partly used in the creation of this one.";
                rdfs:domain doc:Work;
                rdfs:label "derived from";
                rdfs:range doc:Work.
doc:ipr a rdf:Property;
        rdfs:comment "Terms and intellectual property rights licensing conditions.";
        rdfs:domain doc:Work;
        rdfs:label "rights";
        rdfs:range doc:Work.
doc:mayControl a rdf:Property;
               rdfs:comment "This may change that access control for that";
               rdfs:domain <http://www.w3.org/2000/10/swap/pim/contact#SocialEntity>;
               rdfs:label "may control";
               rdfs:range doc:Work.
doc:mayRead a rdf:Property;
            rdfs:comment "This may access that for read -- compare 'r' unix";
            rdfs:domain <http://www.w3.org/2000/10/swap/pim/contact#SocialEntity>;
            rdfs:label "may read";
            rdfs:range doc:Work.
doc:mayWrite a rdf:Property;
             rdfs:comment "This may access that to modify it -- compare 'w' unix";
             rdfs:domain <http://www.w3.org/2000/10/swap/pim/contact#SocialEntity>;
             rdfs:label "may write";
             rdfs:range doc:Work.
doc:obsoletes a rdf:Property;
              rdfs:comment "This work is more upto date than that and makes it obsolete.";
              rdfs:domain doc:Work;
              rdfs:label "obsoletes";
              rdfs:range doc:Work.
doc:persistencePolicy a rdf:Property;
                      rdfs:comment """Publishers policy regarding the peristence of the mapping
                between URI and its meaning and/or representation in bits.""";
                      rdfs:domain doc:Work;
                      rdfs:label "persistence policy";
                      rdfs:range doc:Work.
doc:rules a rdf:Property;
          rdfs:comment """
	The subject is a namespace document; the object is a document
	containing rules. The rules are valid information about the terms
	defined in the namespace document.
	""";
          rdfs:domain <http://www.w3.org/2000/10/swap/pim/contact#Work>;
          rdfs:label "rules";
          rdfs:range <http://www.w3.org/2000/10/swap/pim/contact#Work>.
doc:subLicense a rdf:Property,
                 owl:TransitiveProperty;
               rdfs:comment """For any license, a sublicense is a licensing offering a subset of the rights. 
If A doc:sublicense B then anything under license A can be released under
licence B.""";
               rdfs:domain doc:Work;
               rdfs:label "sub-license";
               rdfs:range doc:Work.
doc:version a rdf:Property;
            rdfs:comment """This generic work has a specific version in the
	follwing specific document""",
                         "This version of this document (eg number, date, etc). A string";
            rdfs:domain doc:Work;
            rdfs:label "version";
            rdfs:range doc:Work.
doc:versionOf a rdf:Property;
              rdfs:comment """This work is a a specific version of the follwing generic document.
		OBSOLETE - use its inverse, version.""";
              rdfs:domain doc:Work;
              rdfs:range doc:Work;
              owl:inverseOf doc:version.
