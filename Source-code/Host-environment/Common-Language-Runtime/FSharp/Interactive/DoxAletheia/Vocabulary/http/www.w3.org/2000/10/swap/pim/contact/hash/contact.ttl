@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix contact: <http://www.w3.org/2000/10/swap/pim/contact#>.

<http://www.w3.org/2000/10/swap/pim/contact> <http://purl.org/dc/elements/1.1/description> """
 To illustrate with examples the creation of a schema of RDF properties
 and classes, but using abstract things for people, rather than strings, etc.
 If you have an \"Assistant's phone number\", then really you have an assitant who has
 a phone number - and that is much more useful in general.
 For example, when data about you and your assietnt in merged,
 you will end up with an \"assistant's email\" and the like.
""",
                                                                                           "$Id: contact.rdf,v 1.18 2011/02/01 04:13:21 timbl Exp $";
                                             <http://purl.org/dc/elements/1.1/title> "Contact: Utility concepts for everyday life";
                                             <http://www.w3.org/2000/10/swap/pim/doc#creator> <http://www.w3.org/People/Berners-Lee/card#i>;
                                             <http://www.w3.org/2000/10/swap/pim/doc#persistencePolicy> [<http://purl.org/dc/elements/1.1/description> """If you change this, you have to tell the W3C SemWeb AD
   folk, including Dan Connolly; so agreed 5 Jun 2001.
   TimBl takes this as being met by a mail to sw-team.""" ; 
                                                                                                         a contact:_SubjectToChange];
                                             <http://www.w3.org/2000/10/swap/pim/doc#rules> <http://www.w3.org/2000/10/swap/pim/contact-rules>.
contact:Address a rdfs:Class.
contact:ContactLocation a rdfs:Class;
                        rdfs:comment """A place, or mobile situation, with address, phone number, fax, etc. 
    Related to a person by home, office, etc.
    Note one person's workplace may be another person's home.
    A person may have more than one home and more than one workplace.
    (In practice it sometimes maybe useful with restriucted datasets to
    assume that this is not the case, when extracting data from other ontologies
    with no concept of ContactLocation).  Strongly related to a person: 
    in some ways a role that a person can be in.""";
                        rdfs:label "contact point".
contact:Fax rdfs:label "fax";
            rdfs:subClassOf contact:Phone.
contact:Female a rdfs:Class.
contact:LanguageCode a rdfs:Class.
contact:Male a rdfs:Class.
contact:MobilePhone rdfs:label "mobile";
                    rdfs:subClassOf contact:Phone.
contact:Pager rdfs:subClassOf contact:Phone.
contact:Person rdfs:comment "A person in the normal sense of the word.";
               rdfs:subClassOf contact:SocialEntity.
contact:Phone a rdfs:Class;
              rdfs:comment """
    An end-point in the public swiitched telephone system.
    Anything identified by a URI with tel: scheme is in this class.
    """;
              rdfs:label "phone"@en,
                         "tel."@fr.
contact:SocialEntity a rdfs:Class;
                     rdfs:comment """The sort of thing which can have a phone number.
    Typically a person or an incorporated company, or unincorporated group.""".
contact:_SubjectToChange rdfs:label "subject to change".
contact:_addressProperty a rdf:Property.
contact:address a rdf:Property;
                rdfs:domain contact:ContactLocation;
                rdfs:label "address"@en;
                rdfs:range contact:Address.
contact:assistant a rdf:Property;
                  rdfs:comment "A person (or other agent) who is an assistant to the subject.";
                  rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
                  rdfs:label "assistant";
                  rdfs:ramge <http://xmlns.com/foaf/0.1/Agent>.
contact:birthday a rdf:Property;
                 rdfs:domain contact:SocialEntity;
                 rdfs:range contact:Date.
contact:child a rdf:Property.
contact:city rdfs:domain contact:Address.
contact:country rdfs:domain contact:Address.
contact:departmentName rdfs:domain contact:Person.
contact:description a rdf:Property.
contact:emailAddress a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                     rdfs:comment "emailAddress is a string.  Use of this is discouraged. Use :mailbox instead ";
                     rdfs:domain contact:SocialEntity;
                     rdfs:label "email";
                     rdfs:range contact:_EmailAddress;
                     contact:_example """
            <rdf:Description xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" rdf:about=\"http://www.w3.org/2000/10/swap/pim/contact#_Dan\">
                <con:emailAddress xmlns:con=\"http://www.w3.org/2000/10/swap/pim/contact#\">connolly@w3.org</con:emailAddress>
            </rdf:Description>
        """^^rdf:XMLLiteral.
contact:emergency a rdf:Property;
                  rdfs:domain contact:Person;
                  rdfs:label "emergency only";
                  rdfs:range contact:ContactLocation.
contact:familyName rdfs:domain contact:Person.
contact:fax a rdf:Property;
            rdfs:domain contact:ContactLocation;
            rdfs:range contact:Fax.
contact:firstName rdfs:domain contact:Person.
contact:fullName a rdf:Property;
                 rdfs:label "full name".
contact:givenName rdfs:domain contact:Person.
contact:home a rdf:Property;
             rdfs:domain contact:Person;
             rdfs:label "home";
             rdfs:range contact:ContactLocation.
contact:homePage a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                 rdfs:subPropertyOf contact:webPage;
                 contact:_addressProperty contact:homePageAddress.
contact:homePageAddress a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                        rdfs:comment "Use is discouraged".
contact:knownAs a rdf:Property;
                rdfs:comment """A person may be known as various strings.
	For example, an email friendly name string.
	If you have an email from someone using a string as the human-readable phrase,
	then it is reasonable to assume that there are :knownAs that.""";
                rdfs:label "name".
contact:lastName rdfs:domain contact:Person.
contact:mailbox a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                rdfs:domain contact:SocialEntity;
                rdfs:range contact:Mailbox;
                contact:_addressProperty contact:mailboxURI;
                contact:_example """
            <rdf:Description xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" rdf:about=\"http://www.w3.org/2000/10/swap/pim/contact#_Dan\">
                <con:mailbox xmlns:con=\"http://www.w3.org/2000/10/swap/pim/contact#\" rdf:resource=\"mailto:connolly@w3.org\"></con:mailbox>
            </rdf:Description>
        """^^rdf:XMLLiteral.
contact:mailboxURI a <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                   rdfs:comment "mailboxURI is a string.  Use of this is discouraged. Use :mailbox instead ";
                   rdfs:domain contact:SocialEntity;
                   rdfs:range contact:_URI;
                   contact:_example """
            <rdf:Description xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" rdf:about=\"http://www.w3.org/2000/10/swap/pim/contact#_Dan\">
                <con:mailboxURI xmlns:con=\"http://www.w3.org/2000/10/swap/pim/contact#\">mailto:connolly@w3.org</con:mailboxURI>
            </rdf:Description>
        """^^rdf:XMLLiteral.
contact:middleInitial rdfs:domain contact:Person.
contact:middleName rdfs:domain contact:Person.
contact:mobile a rdf:Property;
               rdfs:domain contact:Person;
               rdfs:label "mobile";
               rdfs:range contact:ContactLocation.
contact:motherTongue a rdf:Property;
                     rdfs:domain contact:Person;
                     rdfs:range contact:LanguageCode.
contact:nearestAirport a rdf:Property;
                       rdfs:comment """?X nearestAirport ?Y locates ?X in an international
   context; for example, for the purpose of organizing a face-to-face
   meeting of a W3C working group. This property is intended to mitigate
   privacy risks of giving out detailed contact info.""";
                       rdfs:label "nearest airport";
                       rdfs:seeAlso <http://lists.w3.org/Archives/Public/www-webont-wg/2001Nov/0006.html>,
                                    <http://www.perceive.net/pages/page/articles/year/2002/month/12#9>,
                                    <http://www.w3.org/2001/sw/Europe/200303/geo/intro.html>,
                                    <http://www.w3.org/2001/sw/WebOnt/webont-airports.rdf>,
                                    <http://www.w3.org/2001/tag/ilist#httpRange-14>.
contact:office a rdf:Property;
               rdfs:domain contact:Person;
               rdfs:label "work";
               rdfs:range contact:ContactLocation.
contact:organization rdfs:domain contact:Person.
contact:participant a rdf:Property;
                    rdfs:comment "A person (or other agent) who  particpates in an event, meeting, etc.";
                    rdfs:label "participant";
                    rdfs:ramge <http://xmlns.com/foaf/0.1/Agent>.
contact:partner a rdf:Property;
                rdfs:domain contact:Person;
                rdfs:range contact:Person.
contact:personalSuffix rdfs:domain contact:Person.
contact:personalTitle rdfs:domain contact:Person.
contact:phone a rdf:Property;
              rdfs:domain contact:ContactLocation;
              rdfs:range contact:Phone.
contact:postalCode rdfs:domain contact:Address.
contact:preferredURI a rdf:Property;
                     rdfs:comment "A string which is the URI a person, organization, etc, prefers that people use for them.";
                     rdfs:label "preferred".
contact:publicHomePage rdfs:subPropertyOf contact:homePage.
contact:region a rdf:Property;
               rdfs:comment """The sub-national unit such as state (us),
province (ca), county (uk), département (fr), and so on""";
               rdfs:label "region".
contact:sortName a rdf:Property;
                 rdfs:comment "re-arranged for lexicographic ordering; ala Doe, John";
                 rdfs:label "sort name".
contact:stateOrProvince rdfs:domain contact:Address.
contact:street rdfs:domain contact:Address.
contact:street2 rdfs:domain contact:Address.
contact:street3 rdfs:domain contact:Address.
contact:title rdfs:domain contact:Person.
contact:vacationHome a rdf:Property;
                     rdfs:domain contact:Person;
                     rdfs:label "vacation";
                     rdfs:range contact:ContactLocation.
contact:webPage a rdf:Property;
                rdfs:comment "A related web page";
                rdfs:label "web page".
contact:zip rdfs:subPropertyOf contact:postalCode.
<http://www.w3.org/2000/10/swap/pim/doc#persistencePolicy> rdfs:seeAlso <http://www.w3.org/1999/10/nsuri>.
