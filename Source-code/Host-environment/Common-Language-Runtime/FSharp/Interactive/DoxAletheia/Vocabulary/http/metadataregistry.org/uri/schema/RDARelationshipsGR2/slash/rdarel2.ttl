<http://metadataregistry.org/uri/RegStatus/1002> a skos:Concept;
                                                 skos:prefLabel "New-Proposed"@en.
<http://metadataregistry.org/uri/schema/RDARelationshipsGR2> dc11:title "RDA Relationships for Persons, Corporate Bodies, Families"@en.
rdarel2:alternateIdentity <http://metadataregistry.org/uri/profile/RegAp/name> "alternateIdentity"@en;
                          <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                          a rdf:Property;
                          rdfs:domain rdafrbr:Person;
                          rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                          rdfs:label "andere Identität"@de,
                                     "Alternate identity"@en;
                          rdfs:subPropertyOf rdarel2:relatedPersonPerson;
                          skos:definition "A pseudonymous or other identity assumed by the person."@en,
                                          "Das Pseudonym bzw. die andere Identität, welche die Person annimmt."@de.
rdarel2:descendantFamily <http://metadataregistry.org/uri/profile/RegAp/name> "descendantFamily"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:Family;
                         rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                         rdfs:label "Abstammende Familie"@de,
                                    "Descendant Family"@en;
                         rdfs:subPropertyOf rdarel2:relatedFamily;
                         skos:definition "Die Familie, die von der anderen Familie abstammt."@de,
                                         "A family descended from the other family."@en.
rdarel2:descendants <http://metadataregistry.org/uri/profile/RegAp/name> "descendants"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:domain rdafrbr:Family;
                    rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                    rdfs:label "Nachkommen"@de,
                               "Descendants"@en;
                    rdfs:subPropertyOf rdarel2:relatedPerson;
                    skos:definition "A family descended from the particular person."@en,
                                    "Die Familie, die von der bestimmten Person abstammt."@de.
rdarel2:employee <http://metadataregistry.org/uri/profile/RegAp/name> "employee"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:domain rdafrbr:Person;
                 rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                 rdfs:label "Arbeitnehmer"@de,
                            "Employee"@en;
                 rdfs:subPropertyOf rdarel2:relatedCorporateBodyPerson;
                 skos:definition "Die Person, die bei einer Körperschaft beschäftigt ist."@de,
                                 "A person employed by a corporate body."@en.
rdarel2:employer <http://metadataregistry.org/uri/profile/RegAp/name> "employer"@en;
                 <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                 a rdf:Property;
                 rdfs:domain rdafrbr:CorporateBody;
                 rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                 rdfs:label "Arbeitgeber"@de,
                            "Employer"@en;
                 rdfs:subPropertyOf rdarel2:relatedPersonCorporateBody;
                 skos:definition "A corporate body that employs the person."@en,
                                 "Die Körperschaft, welche die Person beschäftigt."@de.
rdarel2:explanationOfRelationship <http://metadataregistry.org/uri/profile/RegAp/name> "explanationOfRelationship"@en;
                                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                  a rdf:Property;
                                  rdfs:domain rdafrbr:Agent;
                                  rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                  rdfs:label "Explanation of Relationship"@en,
                                             "Erläuterung der Beziehung"@de;
                                  skos:definition "Information elaborating on or clarifying the relationship between an entity represented by a preferred access point and/or identifier and a related entity."@en,
                                                  "Informationen, die die Beziehung zwischen einer Entität, die durch eine Ansetzungsform des Sucheinstiegs und/oder Identifier repräsentiert wird, und einer damit in Beziehung stehenden Entität herausstellt oder erläutert. "@de.
rdarel2:familyMember <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:progenitor;
                     <http://metadataregistry.org/uri/profile/RegAp/name> "familyMember"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Person;
                     rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                     rdfs:label "Familienmitglied"@de,
                                "Family member"@en;
                     rdfs:subPropertyOf rdarel2:relatedFamilyPerson;
                     skos:definition "A person who is a member of the family."@en,
                                     "Die Person, die ein Mitglied der Familie ist."@de.
rdarel2:foundedOrganization <http://metadataregistry.org/uri/profile/RegAp/name> "foundedOrganization"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:CorporateBody;
                            rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                            rdfs:label "Founded organization"@en,
                                       "gegründete Organisation"@de;
                            rdfs:subPropertyOf rdarel2:relatedFamilyCorporateBody;
                            skos:definition "A corporate body that the family founded."@en,
                                            "Die Körperschaft, welche die Familie gründete."@de.
rdarel2:founder <http://metadataregistry.org/uri/profile/RegAp/name> "founder"@en;
                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                a rdf:Property;
                rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                rdfs:label "Founder"@en,
                           "Gründer"@de;
                rdfs:subPropertyOf rdarel2:relatedCorporateBodyPerson;
                skos:definition "A person who founded the corporate body."@en,
                                "Die Person, welche die Körperschaft gegründet hat."@de.
rdarel2:foundingFamily <http://metadataregistry.org/uri/profile/RegAp/name> "foundingFamily"@en;
                       <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                       a rdf:Property;
                       rdfs:domain rdafrbr:Family;
                       rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                       rdfs:label "Founding Family"@en,
                                  "Gründerfamilie"@de;
                       rdfs:subPropertyOf rdarel2:relatedCorporateBody;
                       skos:definition "Die Familie, welche die Körperschaft gegründet hat."@de,
                                       "A family that founded the corporate body."@en.
rdarel2:groupMember <http://metadataregistry.org/uri/profile/RegAp/name> "groupMember"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:domain rdafrbr:Person;
                    rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                    rdfs:label "Group member"@en,
                               "Gruppenmitglied"@de;
                    rdfs:subPropertyOf rdarel2:relatedCorporateBodyPerson;
                    skos:definition "Die Person, die ein Mitglied der aufführenden Gruppe, einer Expedition, etc. ist."@de,
                                    "A person who is a member of the performing group, expedition, etc."@en.
rdarel2:hierarchicalSubordinate <http://metadataregistry.org/uri/profile/RegAp/name> "hierarchicalSubordinate"@en;
                                <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                a rdf:Property;
                                rdfs:domain rdafrbr:CorporateBody;
                                rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                rdfs:label "Hierarchical subordinate"@en,
                                           "untergeordnete Körperschaft"@de;
                                skos:definition "A corporate body that is subordinate to the other corporate body (e.g., a parent body)."@en,
                                                "Die Körperschaft, die einer anderen Körperschaft untergeordnet ist (z. B. der Muttergesellschaft)."@de.
rdarel2:hierarchicalSuperior <http://metadataregistry.org/uri/profile/RegAp/name> "hierarchicalSuperior"@en;
                             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                             a rdf:Property;
                             rdfs:domain rdafrbr:CorporateBody;
                             rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                             rdfs:label "Hierarchical superior"@en,
                                        "übergeordnete Körperschaft"@de;
                             rdfs:subPropertyOf rdarel2:relatedCorporateBodyCorporateBody;
                             skos:definition "Die Körperschaft, die einer anderen Körperschaft übergeordnet ist."@de,
                                             "A corporate body that is hierarchically superior to the other corporate body."@en.
rdarel2:incumbent <http://metadataregistry.org/uri/profile/RegAp/name> "incumbent"@en;
                  <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                  a rdf:Property;
                  rdfs:domain rdafrbr:Person;
                  rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                  rdfs:label "Amtsinhaber"@de,
                             "Incumbent"@en;
                  rdfs:subPropertyOf rdarel2:relatedCorporateBodyPerson;
                  skos:definition "Die Person, die ihren Amtssitz in der Körperschaft hat (z.B. der amtierende Präsident)."@de,
                                  "A person holding an office in the corporate body (e.g., the incumbent president)."@en.
rdarel2:mergee <http://metadataregistry.org/uri/profile/RegAp/name> "mergee"@en;
               <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
               a rdf:Property;
               rdfs:domain rdafrbr:CorporateBody;
               rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
               rdfs:label "Mergee"@en,
                          "fusionierte Körperschaft"@de;
               rdfs:subPropertyOf rdarel2:relatedCorporateBodyCorporateBody;
               skos:definition "Die Körperschaft, die mit der anderen Körperschaft fusioniert hat."@de,
                               "A corporate body that merged with the other corporate body to form a third."@en.
rdarel2:predecessor <http://metadataregistry.org/uri/profile/RegAp/name> "predecessor"@en;
                    <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                    a rdf:Property;
                    rdfs:domain rdafrbr:CorporateBody;
                    rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                    rdfs:label "Predecessor"@en,
                               "Vorgänger"@de;
                    rdfs:subPropertyOf rdarel2:relatedCorporateBodyCorporateBody;
                    skos:definition "A corporate body that precedes the other corporate body."@en,
                                    "Die Körperschaft, die einer anderen Körperschaft vorausgeht."@de.
rdarel2:productOfAMerger <http://metadataregistry.org/uri/profile/RegAp/name> "productOfAMerger"@en;
                         <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                         a rdf:Property;
                         rdfs:domain rdafrbr:CorporateBody;
                         rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                         rdfs:label "Product of a merger"@en,
                                    "Ergebnis einer Fusion"@de;
                         rdfs:subPropertyOf rdarel2:relatedCorporateBodyCorporateBody;
                         skos:definition "Die Körperschaft, die aus der Fusion einer oder mehrerer Körperschaften entsteht."@de,
                                         "A corporate body that resulted from a merger of two or more other corporate bodies."@en.
rdarel2:productOfASplit <http://metadataregistry.org/uri/profile/RegAp/name> "productOfASplit"@en;
                        <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                        a rdf:Property;
                        rdfs:domain rdafrbr:CorporateBody;
                        rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                        rdfs:label "Ergebnis einer Teilung"@de,
                                   "Product of a split"@en;
                        rdfs:subPropertyOf rdarel2:relatedCorporateBodyCorporateBody;
                        skos:definition "Die Körperschaft, die aus einer Spaltung oder Teilung von der anderen Körperschaft entsteht."@de,
                                        "A corporate body that resulted from a split or division of the other corporate body."@en.
rdarel2:progenitor <http://metadataregistry.org/uri/profile/RegAp/name> "progenitor"@en;
                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                   a rdf:Property;
                   rdfs:domain rdafrbr:Person;
                   rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                   rdfs:label "Progenitor"@en,
                              "Vorfahre, Stammvater"@de;
                   rdfs:subPropertyOf rdarel2:familyMember;
                   skos:definition "Die Person, von der die Familie abstammt."@de,
                                   "A person from whom the family is descended."@en.
rdarel2:realIdentity <http://metadataregistry.org/uri/profile/RegAp/name> "realIdentity"@en;
                     <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                     a rdf:Property;
                     rdfs:domain rdafrbr:Person;
                     rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                     rdfs:label "wirkliche Identität"@de,
                                "Real identity"@en;
                     rdfs:subPropertyOf rdarel2:relatedPersonPerson;
                     skos:definition "A real person who assumes the alternate identity."@en,
                                     "Die reale Person, die die andere Identität annimmt."@de.
rdarel2:relatedCorporateBody <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:relatedCorporateBodyFamily,
                                                                                            rdarel2:foundingFamily,
                                                                                            rdarel2:sponsoringFamily;
                             <http://metadataregistry.org/uri/profile/RegAp/name> "relatedCorporateBody"@en;
                             <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                             a rdf:Property;
                             rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                             rdfs:label "Related Corporate Body"@en,
                                        "In Beziehung stehende Körperschaft "@de;
                             skos:definition "Eine Körperschaft, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z.B. eine Musikgruppe, der eine Person angehört, eine Tochterfirma). Zu den in Beziehung stehenden  Körperschaften gehören auch Körperschaften, die der Institution, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird, als Ergebnis einer Namensänderung vorangeht oder nachfolgt. "@de,
                                             "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en.
rdarel2:relatedCorporateBodyCorporateBody <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:productOfASplit,
                                                                                                         rdarel2:successor,
                                                                                                         rdarel2:productOfAMerger,
                                                                                                         rdarel2:predecessor,
                                                                                                         rdarel2:hierarchicalSuperior,
                                                                                                         rdarel2:mergee;
                                          <http://metadataregistry.org/uri/profile/RegAp/name> "relatedCorporateBodyCorporateBody"@en;
                                          <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                          a rdf:Property;
                                          rdfs:domain rdafrbr:CorporateBody;
                                          rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                          rdfs:label "In Beziehung stehende Körperschaft (Körperschaft)"@de,
                                                     "Related Corporate Body (Corporate Body)"@en;
                                          skos:definition "Eine Körperschaft, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z.B. eine Musikgruppe, der eine Person angehört, eine Tochterfirma). Zu den in Beziehung stehenden  Körperschaften gehören auch Körperschaften, die der Institution, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird, als Ergebnis einer Namensänderung vorangeht oder nachfolgt. "@de,
                                                          """A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a
musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an
authorized access point and/or identifier as the result of a change of name."""@en.
rdarel2:relatedCorporateBodyFamily <http://metadataregistry.org/uri/profile/RegAp/name> "relatedCorporateBodyFamily"@en;
                                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                   a rdf:Property;
                                   rdfs:domain rdafrbr:Family;
                                   rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                   rdfs:label "In Beziehung stehende Körperschaft (Familie)"@de,
                                              "Related Corporate Body (Family)"@en;
                                   rdfs:subPropertyOf rdarel2:relatedCorporateBody;
                                   skos:definition "Eine Körperschaft, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z.B. eine Musikgruppe, der eine Person angehört, eine Tochterfirma). Zu den in Beziehung stehenden  Körperschaften gehören auch Körperschaften, die der Institution, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird, als Ergebnis einer Namensänderung vorangeht oder nachfolgt. "@de,
                                                   "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en.
rdarel2:relatedCorporateBodyPerson <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:incumbent,
                                                                                                  rdarel2:groupMember,
                                                                                                  rdarel2:employee,
                                                                                                  rdarel2:founder,
                                                                                                  rdarel2:sponsor,
                                                                                                  rdarel2:alternateIdentity,
                                                                                                  rdarel2:realIdentity;
                                   <http://metadataregistry.org/uri/profile/RegAp/name> "relatedCorporateBodyPerson"@en;
                                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                   a rdf:Property;
                                   rdfs:domain rdafrbr:Person;
                                   rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                   rdfs:label "In Beziehung stehende Körperschaft (Person)"@de,
                                              "Related Corporate Body (Person)"@en;
                                   skos:definition "Eine Körperschaft, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z.B. eine Musikgruppe, der eine Person angehört, eine Tochterfirma). Zu den in Beziehung stehenden  Körperschaften gehören auch Körperschaften, die der Institution, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird, als Ergebnis einer Namensänderung vorangeht oder nachfolgt. "@de,
                                                   "A corporate body that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a musical group to which a person belongs, a subsidiary company). Related corporate bodies include corporate bodies that precede or succeed the body represented by an authorized access point and/or identifier as the result of a change of name."@en.
rdarel2:relatedFamily <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:relatedFamilyFamily,
                                                                                     rdarel2:descendantFamily;
                      <http://metadataregistry.org/uri/profile/RegAp/name> "relatedFamily"@en;
                      <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                      a rdf:Property;
                      rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                      rdfs:label "in Beziehung stehende Familie"@de,
                                 "Related Family"@en;
                      skos:definition "Eine Familie, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z. B. die Familie einer Person, eine Familie, die die Kapitalmehrheit in einer Körperschaft hat). "@de,
                                      "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en.
rdarel2:relatedFamilyCorporateBody <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> rdarel2:sponsoredOrganization,
                                                                                                  rdarel2:foundedOrganization;
                                   <http://metadataregistry.org/uri/profile/RegAp/name> "relatedFamilyCorporateBody"@en;
                                   <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                                   a rdf:Property;
                                   rdfs:domain rdafrbr:CorporateBody;
                                   rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                                   rdfs:label "in Beziehung stehende Familie"@de,
                                              "Related Family (Corporate Body)"@en;
                                   skos:definition "A family that is associated with the person, family, or corporate body represented by a preferred access point and/or identifier (e.g., a person’s family, a family that owns the controlling interest in a corporate body)."@en,
                                                   "Eine Familie, die mit der Person, Familie oder Körperschaft in Verbindung steht, die durch eine Ansetzungsform des Sucheinstiegs und/oder einen Identifier repräsentiert wird (z. B. die Familie einer Person, eine Familie, die die Kapitalmehrheit in einer Körperschaft hat). "@de.
rdarel2:relatedFamilyFamily <http://metadataregistry.org/uri/profile/RegAp/name> "relatedFamilyFamily"@en;
                            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1002>;
                            a rdf:Property;
                            rdfs:domain rdafrbr:Family;
                            rdfs:isDefinedBy <http://metadataregistry.org/uri/schema/RDARelationshipsGR2>;
                            rdfs:label "in Beziehung stehende Familie (Familie)"@de,
