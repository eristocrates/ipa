@base <http://www.w3.org/2000/10/swap/reason>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://www.w3.org/2000/01/rdf-schema#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix re: <http://www.w3.org/2000/10/swap/reason#>.

re:Binding a rdfs:Class;
           rdfs:comment """A binding is given eg in a proof or query result.
	The binding specifies which variable was bound (:variable),
	and what term it was bound to.
	""";
           rdfs:label "binding".
re:CommandLine rdfs:subClassOf re:Step.
re:Conjunction rdfs:label """The step of conjunction introduction: 
	taking a bunch of compent statements
	and building a formula from them.""";
               rdfs:subClassOf re:Step.
re:Extraction rdfs:comment """The step of taking one statement out of a formula.
	The step is identified by the :gives formula (the statement)
	and the :because step's :gives formula (the formula extracted
	from).
	""";
              rdfs:label "Conjunction elimination";
              rdfs:subClassOf re:Step.
re:Inference rdfs:label "GMP Inference";
             rdfs:subClassOf re:Step.
re:Parsing rdfs:comment """The formula given was derived from parsing a
	resource.""";
           rdfs:label "parsing";
           rdfs:subClassOf re:Step.
re:Proof rdfs:comment """A Proof step is the last step in the proof, 
	a step which :gives that which was to be proved.
	Typically a document will assert just one :Proof,
	which a checker can then check and turn into
	the Formula proved - Q.E.D. .
	""";
         rdfs:label "proof";
         rdfs:subClassOf re:Step.
re:Step a rdfs:Class;
        rdfs:comment """A step in a proof.

	See :gives for the arc to the formula actually proved at this step.
	""";
        rdfs:label "proof step".
re:args a rdf:Property,
          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
        rdfs:domain re:Commandline;
        rdfs:label """A human-readable representation of the arguments given
	    on the command line""".
re:because a rdf:Property;
           rdfs:comment "gives the step whose data was input to this step.";
           rdfs:domain re:Extraction;
           rdfs:label "from";
           rdfs:range re:Step.
re:boundTo a rdf:Property,
             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
           rdfs:comment """
	This binding binds its variable to this term.
	""";
           rdfs:domain re:Binding;
           rdfs:label "bound to";
           rdfs:range <http://www.w3.org/2000/10/swap/reify#Term>.
re:component a rdf:Property;
             rdfs:comment "A step whose data was used in building this conjunction";
             rdfs:domain re:Conjunction;
             rdfs:label "component";
             rdfs:range re:Step.
re:evidence a rdf:Property,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment """The :evidence for a GMP inference step is a list of
    formulas, each proved by other means, which combined entail the
    result of making the given substitution in the antecedent of the rule.""";
            rdfs:domain re:Inference;
            rdfs:label "antecedents";
            rdfs:range rdf:List.
re:gives a rdf:Property;
         rdfs:comment """The proof step gives the formula as a result.
	For some steps, like extraction of a statement from a formula,
	it is essential to give the result formula in a proof to define
	what step has been taken.  For other steps, such as GMP inference,
	the specification of the rule and bindings defines the result,
	and so the proof can still be checked if the reason:gives ars""";
         rdfs:domain re:Step;
         rdfs:label "gives";
         rdfs:range <http://www.w3.org/2000/10/swap/reify#Formula>.
re:rule a rdf:Property,
          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
        rdfs:comment """The inference step was performed using a rule (implication)
    given.""";
        rdfs:domain re:Inference;
        rdfs:label "rule";
        rdfs:range re:Step.
re:source a rdf:Property,
            <http://www.w3.org/2002/07/owl#FunctionalProperty>;
          rdfs:comment """The source document which was parsed.
	""";
          rdfs:domain re:Parsing;
          rdfs:label "source";
          rdfs:range <http://www.w3.org/2000/10/swap/pim/soc#Work>.
re:variable a rdf:Property,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment """
	The given string is that used as the identifier of the variable
	which is bound by this binding.  The variable name has to be given as
	a string, rather than the variable being put here, or the variable
	would be treated as a variable.""";
            rdfs:domain re:Binding;
            rdfs:label "variable";
            rdfs:range <http://www.w3.org/2000/10/swap/reify#String>.
