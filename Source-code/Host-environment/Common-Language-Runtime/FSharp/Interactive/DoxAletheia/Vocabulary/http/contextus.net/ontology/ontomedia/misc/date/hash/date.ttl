@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix date: <http://contextus.net/ontology/ontomedia/misc/date#>.

date: <http://purl.org/dc/elements/1.1/creator> "Mischa M Tuffield (mailto:mmt04r@ecs.soton.ac.uk)",
                                                "K Faith Lawrence (mailto:kf03r@ecs.soton.ac.uk)",
                                                "Michael O. Jewell (mailto:moj@ecs.soton.ac.uk)";
      <http://purl.org/dc/elements/1.1/description> "OntoMedia (Ontology for Media) Date Component has been designed to describe the different ways of marking time in media."@en;
      <http://purl.org/dc/elements/1.1/title> "OntoMedia Date-Component Part Representation"@en;
      <http://purl.org/dc/terms/created> "2005-05-11";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:label "OntoMedia Date Part Representation";
      <http://www.w3.org/2002/07/owl#versionInfo> "0.21".
date:Calendar a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents a system of representing time";
              rdfs:label "Calendar";
              rdfs:subClassOf <http://contextus.net/ontology/ontomedia/ext/detail/know#Culture>.
date:CalendarReferencePoint a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "This class represents a reference point which a calendar measures other dates relative to";
                            rdfs:label "Calendar Reference Point";
                            rdfs:subClassOf date:Date.
date:Date a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents a value representing time";
          rdfs:label "Date";
          rdfs:subClassOf <http://contextus.net/ontology/ontomedia/ext/common/trait#Value>.
date:Date-Component a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "This class represents the parts of a date";
                    rdfs:label "Date Component";
                    rdfs:subClassOf <http://contextus.net/ontology/ontomedia/ext/common/trait#AbstractComponent>.
date:Date-Ordering a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class represents the order in which components describing a date should be displayed";
                   rdfs:label "Date Ordering";
                   rdfs:subClassOf <http://contextus.net/ontology/ontomedia/ext/common/trait#Ordering>.
date:Day a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "This class represents the part of a date which is the day designaition";
         rdfs:label "Day";
         rdfs:subClassOf date:Date-Component.
date:Hour a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents the part of a date which is the hour designaition";
          rdfs:label "Hour";
          rdfs:subClassOf date:Date-Component.
date:Minute a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the part of a date which is the minute designaition";
            rdfs:label "Minute";
            rdfs:subClassOf date:Date-Component.
date:Month a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents the part of a date which is the month designaition";
           rdfs:label "Month";
           rdfs:subClassOf date:Date-Component.
date:Qualifier a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class represents the textual qualifier that may be part of the data i.e. AD, BCE etc";
               rdfs:label "Qualifier";
               rdfs:subClassOf date:Date-Component.
date:Second a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the part of a date which is the second designaition";
            rdfs:label "Second";
            rdfs:subClassOf date:Date-Component.
date:Standard a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents the International Standard form of the date";
              rdfs:label "International Standard";
              rdfs:subClassOf date:Date-Ordering.
date:Year a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents the part of a date which is the year designaition";
          rdfs:label "Year";
          rdfs:subClassOf date:Date-Component.
date:abstracted-from-occurrence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "The occurrance of an event from which the reference point was abstracted";
                                rdfs:domain date:Date;
                                rdfs:label "Abstracted From Occurrence";
                                rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Occurrence>.
date:after-reference-point a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "The relative reference point after which the desired point of time occurs";
                           rdfs:domain date:Date;
                           rdfs:label "After Reference Point";
                           rdfs:range date:CalendarReferencePoint.
date:before-reference-point a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "The relative reference point before which the desired point of time occurs";
                            rdfs:domain date:Date;
                            rdfs:label "Before Reference Point";
                            rdfs:range date:CalendarReferencePoint.
date:has-date-component a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property specifies the name represented by the component";
                        rdfs:domain date:Date;
                        rdfs:label "Has Date Component";
                        rdfs:range date:Date-Component.
date:has-reference-point a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property specifies a point of reference in a Calendar";
                         rdfs:domain date:Calendar;
                         rdfs:label "Has Reference Point";
                         rdfs:range date:CalendarReferencePoint.
date:reference-point-minus-one a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "The Year Preceeding the Reference Point Year";
                               rdfs:domain date:CalendarReferencePoint;
                               rdfs:label "Reference Point Minus One";
                               rdfs:range date:Year.
date:reference-point-plus-one a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "The Year Following the Reference Point Year";
                              rdfs:domain date:CalendarReferencePoint;
                              rdfs:label "Reference Point Plus One";
                              rdfs:range date:Year.
date:uses-calendar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The calandar which the date uses";
                   rdfs:domain date:Date;
                   rdfs:label "Uses Calendar";
                   rdfs:range date:Calendar.
