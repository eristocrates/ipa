@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pwo: <http://purl.org/spar/pwo/>.
@prefix odpart: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#>.
@prefix seq: <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#>.
@prefix tis: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#>.
@prefix ti: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix swrl: <http://www.w3.org/2003/11/swrl#>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix situ: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#>.

_:B4ca38e8398d996d4b49dce452c757914 a swrl:AtomList.
_:B5bf15d7d924bb18853e569c4b0b58e0c a swrl:AtomList.
_:B6f00cd9318d0cc63567027afdb83001b a swrl:AtomList.
([swrl:argument1 <urn:swrl#si> ; 
 swrl:propertyPredicate <http://www.essepuntato.it/2009/10/error/hasError> ; 
 swrl:argument2 "A step cannot need a resource that will be produced by a following step" ; 
 a swrl:DatavaluedPropertyAtom]) a swrl:AtomList.
([swrl:argument1 <urn:swrl#si> ; 
 swrl:classPredicate pwo:Step ; 
 a swrl:ClassAtom]
 [swrl:argument1 <urn:swrl#sj> ; 
 swrl:classPredicate pwo:Step ; 
 a swrl:ClassAtom]
 [swrl:argument1 <urn:swrl#si> ; 
 swrl:argument2 <urn:swrl#r> ; 
 swrl:propertyPredicate pwo:needs ; 
 a swrl:IndividualPropertyAtom]
 [swrl:argument1 <urn:swrl#sj> ; 
 swrl:argument2 <urn:swrl#r> ; 
 swrl:propertyPredicate pwo:produces ; 
 a swrl:IndividualPropertyAtom]
 [swrl:argument2 <urn:swrl#sj> ; 
 swrl:argument1 <urn:swrl#si> ; 
 swrl:propertyPredicate seq:precedes ; 
 a swrl:IndividualPropertyAtom]) a swrl:AtomList.
_:Bd68f8c57c65355567fe725f89b195860 a swrl:AtomList.
_:Be510bc39a3c31d1e1718276ce4771aa9 a swrl:Imp;
                                    swrl:body ();
                                    swrl:head ().
dc11:contributor a owl:AnnotationProperty.
dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
<http://purl.org/spar/pwo> dc11:creator "Silvio Peroni",
                                        "David Shotton",
                                        "Aldo Gangemi";
                           dc11:date "2015-06-18";
                           dc11:description "The Publishing Workflow Ontology (PWO) is a simple ontology written in OWL 2 DL for the characterization of the main stages in the workflow associated with the publication of a document (e.g. being written, under review, XML capture, page design, publication to the Web)."@en,
                                            <https://svn.code.sf.net/p/sempublishing/code/PWO/pwo.png>;
                           dc11:rights "This work is distributed under a Creative Commons Attribution License (http://creativecommons.org/licenses/by/3.0/)."@en;
                           dc11:title "The Publishing Workflow Ontology (PWO)";
                           a owl:Ontology;
                           rdfs:comment "The Publishing Workflow Ontology (PWO) is an ontology for describing the workflow associated with the publication of a document.  It forms part of SPAR, a suite of Semantic Publishing and Referencing Ontologies."@en;
                           owl:imports <http://www.w3.org/2006/time>,
                                       <http://www.essepuntato.it/2009/10/error>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/controlflow.owl>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>,
                                       <http://www.ontologydesignpatterns.org/cp/owl/participation.owl>;
                           owl:versionInfo "2.2".
pwo:Action a owl:Class;
           rdfs:comment "An event with at least one agent that is participant in it and that is linked to a workflow execution and to a step of the related workflow description.";
           rdfs:label "action";
           rdfs:subClassOf [owl:intersectionOf (<http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#Action>
                                                <http://www.ontologydesignpatterns.org/cp/owl/taskexecution.owl#Action>
                                                tis:TimeIndexedSituation) ; 
                            a owl:Class].
pwo:Step a owl:Class;
         rdfs:comment "An atomic unit of a workflow, that may be characterized by a starting time and an ending time, and may be associated with one or more events.  A workflow step usually involves some input information, material or energy needed to complete the step, and some output information, material or energy produced by that step.  In the case of a publishing workflow, a step typically results in the creation of a publication entity, usually by the modification of another pre-existing publication entity, e.g. the creation of an edited paper from a rough draft, or of an HTML representation from an XML mark-up."@en;
         rdfs:label "step"@en;
         rdfs:subClassOf [owl:allValuesFrom pwo:Workflow ; 
                          owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#isTaskDefinedIn> ; 
                          a owl:Restriction],
                         [owl:someValuesFrom pwo:Action ; 
                          owl:onProperty pwo:involvesAction ; 
                          a owl:Restriction],
                         [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                          owl:onClass time:DurationDescription ; 
                          owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/parameter.owl#hasParameter> ; 
                          a owl:Restriction],
                         <http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Task>.
pwo:Workflow a owl:Class;
             rdfs:comment "A sequence of connected steps, representing a sequence of publishing operations undertaken by agents. A workflow may be seen as an abstract model of real work."@en;
             rdfs:label "workflow"@en;
             rdfs:subClassOf [owl:someValuesFrom pwo:Step ; 
                              owl:onProperty pwo:hasFirstStep ; 
                              a owl:Restriction],
                             <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#Plan>.
pwo:WorkflowExecution a owl:Class;
                      rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (pwo:Action
                                                                               [owl:someValuesFrom pwo:Step ; 
                                                                               owl:onProperty pwo:isActionInvolvedIn ; 
                                                                               a owl:Restriction]) ; 
                                                           a owl:Class] ; 
                                       owl:onProperty pwo:involvesAction ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom pwo:Workflow ; 
                                       owl:onProperty pwo:executes ; 
                                       a owl:Restriction],
                                      tis:TimeIndexedSituation,
                                      <http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution>.
pwo:executes a owl:ObjectProperty;
             rdfs:comment "This property allows to link a workflow execution to the related workflow description."@en;
             rdfs:label "executes"@en;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#satisfies>;
             owl:inverseOf pwo:isExecutedBy.
pwo:hasFirstStep a owl:ObjectProperty;
                 rdfs:comment "A workflow that starts with a particular step."@en;
                 rdfs:label "has first step"@en;
                 rdfs:range [owl:complementOf [owl:someValuesFrom pwo:Step ; 
                                               owl:onProperty pwo:hasPreviousStep ; 
                                               a owl:Restriction] ; 
                             a owl:Class];
                 rdfs:subPropertyOf pwo:hasStep.
pwo:hasNextStep a owl:ObjectProperty;
                rdfs:comment "A property linking a step in a workflow with the step that directly follows it."@en;
                rdfs:domain pwo:Step;
                rdfs:label "has next step"@en;
                rdfs:range pwo:Step;
                rdfs:subPropertyOf seq:directlyPrecedes;
                owl:inverseOf pwo:hasPreviousStep.
pwo:hasPreviousStep a owl:ObjectProperty;
                    rdfs:comment "A property linking a step in a workflow with the step that directly precedes it."@en;
                    rdfs:label "has previous step"@en;
                    rdfs:subPropertyOf seq:directlyFollows.
pwo:hasStep a owl:ObjectProperty;
            rdfs:comment "The property linking a workflow to a component step."@en;
            rdfs:domain pwo:Workflow;
            rdfs:label "has step"@en;
            rdfs:range pwo:Step;
            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#definesTask>.
pwo:involvesAction a owl:ObjectProperty;
                   rdfs:comment "The property linking a step in a workflow or a particular execution of a workflow to an action."@en;
                   rdfs:domain [owl:unionOf (pwo:Step
                                             pwo:WorkflowExecution) ; 
                                a owl:Class];
                   rdfs:label "involves action"@en;
                   rdfs:range pwo:Action;
                   owl:propertyChainAxiom (pwo:executes
                                           pwo:hasStep
                                           pwo:involvesAction).
pwo:isActionInvolvedIn a owl:ObjectProperty;
                       rdfs:comment "The property linking an event to a step in a workflow or to a particular execution of a workflow description."@en;
                       rdfs:label "is action involved in step"@en;
                       owl:inverseOf pwo:involvesAction;
                       owl:propertyChainAxiom (pwo:isActionInvolvedIn
                                               pwo:isStepOf
                                               pwo:isExecutedBy).
pwo:isExecutedBy a owl:ObjectProperty;
                 rdfs:comment "This property allows to link a workflow description to the related workflow execution.";
                 rdfs:label "is executed by";
                 rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/basicplan.owl#isSatisfiedBy>.
pwo:isNeededBy a owl:ObjectProperty;
               rdfs:comment "The property linking a thing required to undertake a workflow step to the step itself."@en;
               rdfs:label "is needed by"@en;
               owl:inverseOf pwo:needs.
pwo:isProducedBy a owl:ObjectProperty;
                 rdfs:comment "The property linking something to the workflow step that produces, creates or results in that thing."@en;
                 rdfs:label "is produced by"@en;
                 owl:inverseOf pwo:produces.
pwo:isStepOf a owl:ObjectProperty,
               owl:FunctionalProperty;
             rdfs:comment "The property linking a step in a workflow to the workflow of which it is a component."@en;
             rdfs:label "is step of"@en;
             rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#isTaskDefinedIn>;
             owl:inverseOf pwo:hasStep.
pwo:needs a owl:ObjectProperty;
          rdfs:comment "The property linking a workflow step to anything required to undertake that step."@en;
          rdfs:domain pwo:Step;
          rdfs:label "needs"@en.
pwo:produces a owl:ObjectProperty;
             rdfs:comment "The property linking a workflow step to the thing that the step produces, creates or results in."@en;
             rdfs:domain pwo:Step;
             rdfs:label "produces"@en.
<http://www.essepuntato.it/2009/10/error/hasError> a owl:DatatypeProperty.
<http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#definesTask> a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/basicplandescription.owl#isTaskDefinedIn> a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/basicplanexecution.owl#PlanExecution> a owl:Class.
odpart:Event a owl:Class.
odpart:Object a owl:Class.
odpart:hasParticipant a owl:ObjectProperty.
odpart:isParticipantIn a owl:ObjectProperty.
seq:directlyFollows a owl:ObjectProperty.
seq:directlyPrecedes a owl:ObjectProperty.
seq:precedes a owl:ObjectProperty.
situ:Situation a owl:Class.
situ:isSettingFor a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/taskexecution.owl#Action> a owl:Class.
<http://www.ontologydesignpatterns.org/cp/owl/taskexecution.owl#executesTask> a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/taskexecution.owl#isExecutedIn> a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/taskrole.owl#Task> a owl:Class.
tis:TimeIndexedSituation a owl:Class.
tis:atTime a owl:ObjectProperty;
           rdfs:comment "A step is performed within a time interval."@en;
           rdfs:label "at time"@en.
tis:forEntity a owl:ObjectProperty.
tis:hasTimeIndexedSetting a owl:ObjectProperty.
ti:TimeInterval a owl:Class.
ti:hasIntervalDate a owl:DatatypeProperty.
<http://www.semanticweb.org/owlapi#nodeID> a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
<urn:swrl#r> a swrl:Variable.
<urn:swrl#si> a swrl:Variable.
<urn:swrl#sj> a swrl:Variable.
