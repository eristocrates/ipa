@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#>.
@prefix iol: <http://www.ontologydesignpatterns.org/ont/dul/IOLite.owl#>.
@prefix lmm1: <http://www.ontologydesignpatterns.org/ont/lmm/LMM_L1.owl#>.
@prefix lmm2: <http://www.ontologydesignpatterns.org/ont/lmm/LMM_L2.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

dul:Collection a owl:Class.
dul:Concept a owl:Class;
            rdfs:subClassOf lmm1:Meaning.
dul:Description a owl:Class;
                rdfs:subClassOf lmm1:Meaning.
dul:InformationObject a owl:Class.
dul:PhysicalArtifact a owl:Class;
                     rdfs:subClassOf lmm1:Reference.
dul:Plan a owl:Class.
dul:Role a owl:Class.
dul:Situation a owl:Class;
              rdfs:subClassOf lmm1:Reference.
dul:TypeCollection a owl:Class.
dul:classifies a owl:ObjectProperty.
dul:hasMember a owl:ObjectProperty.
dul:hasPart a owl:ObjectProperty.
dul:hasRole a owl:ObjectProperty.
dul:hasSetting a owl:ObjectProperty.
dul:isClassifiedBy a owl:ObjectProperty.
dul:isConceptUsedIn a owl:ObjectProperty.
dul:isMemberOf a owl:ObjectProperty.
dul:isRoleOf a owl:ObjectProperty.
dul:isUnifiedBy a owl:ObjectProperty.
dul:specializes a owl:ObjectProperty.
iol:FormalExpression a owl:Class.
iol:LinguisticFunction a owl:Class;
                       rdfs:subClassOf [owl:allValuesFrom iol:LinguisticObject ; 
                                        owl:onProperty lmm2:isSyntacticFunctionOf ; 
                                        a owl:Restriction],
                                       dul:Role.
iol:LinguisticObject a owl:Class;
                     rdfs:subClassOf [owl:allValuesFrom iol:LinguisticFunction ; 
                                      owl:onProperty lmm2:hasSyntacticFunction ; 
                                      a owl:Restriction].
iol:Term a owl:Class.
iol:Text a owl:Class.
iol:isLexicalizedBy a owl:ObjectProperty.
iol:lexicalizes a owl:ObjectProperty.
lmm1:CoText a owl:Class.
lmm1:ConstructionRule a owl:Class.
lmm1:Expression a owl:Class;
                rdfs:label "Expression"@en.
lmm1:Meaning a owl:Class;
             rdfs:label "Meaning"@en;
             rdfs:subClassOf [owl:allValuesFrom lmm1:Meaning ; 
                              owl:onProperty dul:specializes ; 
                              a owl:Restriction].
lmm1:Reference a owl:Class;
               rdfs:label "Reference"@en.
lmm1:denotes a owl:ObjectProperty.
lmm1:isDenotedBy a owl:ObjectProperty.
lmm1:isInterpretantFor a owl:ObjectProperty.
lmm1:relatedMeaning a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/ont/lmm/LMM_L2.owl> a owl:Ontology;
                                                           rdfs:comment """An ontology for aligning existing linguistic ontologies, and for describing the research objects of NLP.
It uses the ontology IOLite.owl, a plugin of DOLCE-Ultralite for information objects; it imports LMM_L1.owl, a design pattern for the basic semiotic categories.
The ontology also includes a proposal to match term types to referenced entity types, as an example of the usage of this ontology in NER and sense tagging applications.""";
                                                           rdfs:label "Lexical MetaModel Level 2";
                                                           owl:imports <http://www.ontologydesignpatterns.org/ont/lmm/LMM_L1.owl>;
                                                           owl:versionInfo """1.2
1.1
- Edited annotations
- Added class: Gloss
- Added property: hasCoInterpretant
1.2
- Simplified several restrictions (in non-lossy way) in order to reduce complexity of reasoning""".
lmm2:AnalyticFeature a owl:Class;
                     rdfs:comment """Any 'feature' used in automatic classification, learning, and in general in all feature-based analyses.
In NLP, this role can be applied to a LinguisticFunction, a PartOfSpeech, a graphical feature, etc.
A feature role holds in the context of an ExperimentalSetting, where also parameters and operations on the featured enities can be defined.""";
                     rdfs:label "Analytic feature"@en;
                     rdfs:subClassOf [owl:someValuesFrom lmm2:ExperimentalSetting ; 
                                      owl:onProperty dul:isConceptUsedIn ; 
                                      a owl:Restriction],
                                     dul:Role.
lmm2:AssociativeContext a owl:Class;
                        rdfs:comment "An associative rule is a lmm1:CoText where a neighborhood of a chunk of text is built out of the terms related to the chunk across the texts of a corpus, e.g. given a certain statistical threshold.";
                        rdfs:label "Associative context"@en;
                        rdfs:subClassOf [owl:someValuesFrom lmm2:AssociativeRule ; 
                                         owl:onProperty dul:isUnifiedBy ; 
                                         a owl:Restriction],
                                        lmm1:CoText.
lmm2:AssociativeRule a owl:Class;
                     rdfs:label "Associative rule"@en;
                     rdfs:subClassOf lmm1:ConstructionRule.
lmm2:ConceptExpression a owl:Class;
                       rdfs:comment "A Term that expresses a Meaning, and denotes a MultipleReference, e.g. 'Dog', 'Black box'";
                       rdfs:label "Concept expression"@en;
                       rdfs:subClassOf [owl:someValuesFrom lmm2:MultipleReference ; 
                                        owl:onProperty lmm1:denotes ; 
                                        a owl:Restriction],
                                       [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty lmm2:hasSyntacticFunction ; 
                                        a owl:Restriction],
                                       lmm1:Expression,
                                       iol:Term;
                       owl:disjointWith lmm2:Name,
                                        lmm2:ContextualExpression.
lmm2:ConceptReference a owl:Class;
                      rdfs:comment """A MultipleReference that is also a TypeCollection, i.e. a Collection whose members constitute the maximal set of individuals that share the same (named) type, i.e. a Concept . 
E.g. 'the Italians', 'the nurses', 'the automotive workers'. 

The Expressions that denote such references are typically composed by a determiner ('the' in English), and a noun phrase in plural form.

Concept references can be empty collections, e.g. 'the square circles'.""";
                      rdfs:label "Concept reference"@en;
                      rdfs:subClassOf [owl:someValuesFrom lmm2:ConceptExpression ; 
                                       owl:onProperty lmm1:isDenotedBy ; 
                                       a owl:Restriction],
                                      lmm2:MultipleReference,
                                      dul:TypeCollection.
lmm2:ContextualExpression a owl:Class;
                          rdfs:comment "A Term that denotes a Reference via anaphora or deixis, e.g. 'the dog over there', 'all my family', 'the current ACME employees', 'the lion described above'.";
                          rdfs:label "Contextual expression"@en;
                          rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty lmm2:hasSyntacticFunction ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom [owl:unionOf (lmm2:ContextualReference
                                                                            lmm2:ExtensionalReference) ; 
                                                               a owl:Class] ; 
                                           owl:onProperty lmm1:denotes ; 
                                           a owl:Restriction],
                                          lmm1:Expression,
                                          iol:Term;
                          owl:disjointWith lmm2:Name.
lmm2:ContextualReference a owl:Class;
                         rdfs:comment """An IndividualReference that is denoted by a ContextualExpression (anaphoric or deictic), e.g. 'the book in my bag', 'the book mentioned at the beginning of the story'.
The extensional interpretation of Named and Contextual references in a de-reified model can be equivalent, reflecting the paraphrastic property of natural languages, e.g. the extensional interpretations of 'Linosa' and 'the Italian most southern island' are equivalent. This corresponds to saying that names and contextual expressions can denote the same entities.""";
                         rdfs:label "Contextual reference"@en;
                         rdfs:subClassOf [owl:someValuesFrom lmm2:ContextualExpression ; 
                                          owl:onProperty lmm1:isDenotedBy ; 
                                          a owl:Restriction],
                                         lmm2:IndividualReference.
lmm2:EnumeratedExpression a owl:Class;
                          rdfs:comment "An AnaphoricExpression that denotes an enumerated PluralReference, e.g. 'John, Mary, and me'. Enumerated expressions typically have names and anaphoric expressions (e.g. pronouns) as parts.";
                          rdfs:label "Enumerated expression"@en;
                          rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (lmm2:ContextualExpression
                                                                            lmm2:Name) ; 
                                                               a owl:Class] ; 
                                           owl:onProperty dul:hasPart ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom lmm2:ExtensionalReference ; 
                                           owl:onProperty lmm1:denotes ; 
                                           a owl:Restriction],
                                          lmm2:ContextualExpression.
lmm2:ExperimentalSetting a owl:Class;
                         rdfs:comment "A plan modeled in order to carry out experiments. Roles ('features') can be defined for featured entities that provide evidence for classifying an entity, describing a behavior, etc.";
                         rdfs:label "Experimental setting";
                         rdfs:subClassOf dul:Plan.
lmm2:ExtensionalReference a owl:Class;
                          rdfs:comment """Extensional references are collections that require an extensional enumeration (e.g. 'John and Mary'), or an anaphora that allows to extract an implicit enumeration (e.g. 'the books on my table'). Hence, extensional references have individual references as members.

Individual references in the extensional reference must be in the setting of some Situation, which means that extensional references only exist if some fact is described by an observer/interpreter.

The terms expressing extensional references can be names or contextual expressions.

The extensional interpretation of Concept and Extensional references in a de-reified (abstract) model can be equivalent, reflecting the paraphrastic property of natural languages, e.g. the extensional interpretations of 'IberianCountry' and {Spain, Portugal, Andorra, Gibraltar} are equivalent. This corresponds to saying that concept expressions and contextual expressions can denote the same entities, while having different intensional interpretations (meanings).""";
                          rdfs:label "Extensional reference"@en;
                          rdfs:subClassOf [owl:someValuesFrom lmm2:ContextualExpression ; 
                                           owl:onProperty lmm1:isDenotedBy ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom [owl:intersectionOf (lmm2:IndividualReference
                                                                                   [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                   owl:onProperty dul:hasSetting ; 
                                                                                   a owl:Restriction]) ; 
                                                               a owl:Class] ; 
                                           owl:onProperty dul:hasMember ; 
                                           a owl:Restriction],
                                          lmm2:MultipleReference.
lmm2:Gloss a owl:Class;
           rdfs:comment "A text used as an informal definition or comment to a term, lexeme, etc.";
           rdfs:label "Gloss";
           rdfs:subClassOf [owl:someValuesFrom dul:InformationObject ; 
                            owl:onProperty lmm1:isInterpretantFor ; 
                            a owl:Restriction],
                           iol:Text.
lmm2:IndividualReference a owl:Class;
                         rdfs:comment "Any LMM1:Reference that isInstanceOf a dul:Concept";
                         rdfs:label "Individual reference"@en;
                         rdfs:subClassOf [owl:someValuesFrom lmm2:MultipleReference ; 
                                          owl:onProperty dul:isMemberOf ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom dul:Concept ; 
                                          owl:onProperty lmm2:isInstanceOf ; 
                                          a owl:Restriction],
                                         lmm1:Reference.
lmm2:LSARule a owl:Class;
             rdfs:label "LSA rule"@en;
             rdfs:subClassOf lmm2:AssociativeRule.
lmm2:LatentContext a owl:Class;
                   rdfs:label "Latent context"@en;
                   rdfs:subClassOf [owl:someValuesFrom lmm2:LSARule ; 
                                    owl:onProperty dul:isUnifiedBy ; 
                                    a owl:Restriction],
                                   lmm2:AssociativeContext.
lmm2:MultipleReference a owl:Class;
                       rdfs:comment """Any LMM1:Reference that is also a dul:Collection, and can have members that are individual references.
As a collection, a multiple reference can be covered by a dul:Concept, whose instances are the members of the MultipleReference . For example, JohnDoe (an IndividualReference) isMemberOf ACMEEmployees (a MultipleReference), that dul:isCoveredBy the Employee concept. It also holds that JohnDoe isInstanceOf Employee""";
                       rdfs:label "Multiple reference"@en;
                       rdfs:subClassOf lmm1:Reference,
                                       dul:Collection.
lmm2:Name a owl:Class;
          rdfs:comment "A proper noun that denotes an IndividualReference, e.g. 'John Zorn', 'Daimler Benz'.";
          rdfs:label "Name"@en;
          rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                           owl:onProperty lmm2:hasSyntacticFunction ; 
                           a owl:Restriction],
                          [owl:someValuesFrom [owl:unionOf (lmm2:ExtensionalReference
                                                            lmm2:NamedEntity) ; 
                                               a owl:Class] ; 
                           owl:onProperty lmm1:denotes ; 
                           a owl:Restriction],
                          lmm1:Expression,
                          iol:Term.
lmm2:NamedEntity a owl:Class;
                 rdfs:comment "An IndividualReference that is denoted by a Name, e.g. 'John_Zorn' (as an Entity).";
                 rdfs:label "Named entity"@en;
                 rdfs:subClassOf [owl:someValuesFrom lmm2:Name ; 
                                  owl:onProperty lmm1:isDenotedBy ; 
                                  a owl:Restriction],
                                 lmm2:IndividualReference.
lmm2:OEisLexicalizedBy a owl:ObjectProperty;
                       rdfs:domain iol:FormalExpression;
                       rdfs:label "OEis lexicalized by"@en;
                       rdfs:range iol:LinguisticObject;
                       rdfs:subPropertyOf iol:isLexicalizedBy;
                       owl:inverseOf lmm2:lexicalizesOE.
lmm2:PolyrhematicConceptExpression a owl:Class;
                                   rdfs:comment """A complex ConceptExpression that denotes a MultipleReference, e.g. 'the antique books'.
A polyrhematic expression usually has an associated 'head word'.""";
                                   rdfs:label "Polyrhematic concept expression"@en;
                                   rdfs:subClassOf [owl:someValuesFrom lmm2:MultipleReference ; 
                                                    owl:onProperty lmm1:denotes ; 
                                                    a owl:Restriction],
                                                   lmm2:ConceptExpression.
lmm2:SimpleConceptExpression a owl:Class;
                             rdfs:comment "A simple ConceptExpression that denotes a ClassReference, e.g. 'the nurses'.";
                             rdfs:label "Simple concept expression"@en;
                             rdfs:subClassOf [owl:someValuesFrom lmm2:ConceptReference ; 
                                              owl:onProperty lmm1:denotes ; 
                                              a owl:Restriction],
                                             lmm2:ConceptExpression.
lmm2:SyntacticContext a owl:Class;
                      rdfs:comment "A lmm1:CoText that is equivalent to a neighborhood of a certain chunk of text, which can be built based on a syntagmatic rule, e.g. all words from the sentence where the chunk occurs.";
                      rdfs:label "Syntactic context"@en;
                      rdfs:subClassOf [owl:someValuesFrom lmm2:SyntacticRule ; 
                                       owl:onProperty dul:isUnifiedBy ; 
                                       a owl:Restriction],
                                      lmm1:CoText.
lmm2:SyntacticRule a owl:Class;
                   rdfs:subClassOf lmm1:ConstructionRule.
lmm2:hasCoInterpretant a owl:SymmetricProperty,
                         owl:ObjectProperty;
                       rdfs:comment "A relation between two meanings that are both interpretant for a same information object.";
                       rdfs:domain lmm1:Meaning;
                       rdfs:label "has co-interpretant";
                       rdfs:range lmm1:Meaning;
                       rdfs:subPropertyOf lmm1:relatedMeaning.
lmm2:hasInstance a owl:ObjectProperty;
                 rdfs:domain dul:Concept;
                 rdfs:label "has instance"@en;
                 rdfs:range lmm1:Reference;
                 rdfs:subPropertyOf dul:classifies.
lmm2:hasSyntacticFunction a owl:ObjectProperty;
                          rdfs:domain iol:LinguisticObject;
                          rdfs:label "has syntactic function"@en;
                          rdfs:range iol:LinguisticFunction;
                          rdfs:subPropertyOf dul:hasRole;
                          owl:inverseOf lmm2:isSyntacticFunctionOf.
lmm2:isInstanceOf a owl:ObjectProperty;
                  rdfs:domain lmm1:Reference;
                  rdfs:label "is instance of"@en;
                  rdfs:range dul:Concept;
                  rdfs:subPropertyOf dul:isClassifiedBy;
                  owl:inverseOf lmm2:hasInstance.
lmm2:isSyntacticFunctionOf a owl:ObjectProperty;
                           rdfs:domain iol:LinguisticFunction;
                           rdfs:label "is syntactic function of"@en;
                           rdfs:range iol:LinguisticObject;
                           rdfs:subPropertyOf dul:isRoleOf.
lmm2:lexicalizesOE a owl:ObjectProperty;
                   rdfs:comment "Lexicalization for ontology elements.";
                   rdfs:domain iol:LinguisticObject;
                   rdfs:label "lexicalizes oE"@en;
                   rdfs:range iol:FormalExpression;
                   rdfs:subPropertyOf iol:lexicalizes.
owl:Thing a owl:Class.
