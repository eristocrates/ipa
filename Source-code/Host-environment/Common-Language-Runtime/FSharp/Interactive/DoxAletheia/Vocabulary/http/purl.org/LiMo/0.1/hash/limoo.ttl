limoo:Rights a owl:Class;
             rdfs:label "Diritti concessi dai termini legali"@it;
             rdfs:subClassOf limoo:LegalTerms;
             status:term_status "stable".
limoo:URL a owl:DatatypeProperty;
          rdfs:domain limoo:LicenseModel;
          rdfs:range xsd:anyURI.
limoo:UseConditions a owl:Class;
                    rdfs:label "Condizioni legali d'uso"@it;
                    rdfs:subClassOf limoo:LegalTerms;
                    status:term_status "stable".
limoo:areDefinedBy a owl:ObjectProperty;
                   rdfs:domain limoo:DistributionConditions;
                   rdfs:range limoo:LicenseModel.
limoo:areGuaranteedBy a owl:ObjectProperty;
                      rdfs:domain limoo:Rights;
                      rdfs:range limoo:LicenseModel.
limoo:areImposedBy a owl:ObjectProperty;
                   rdfs:domain limoo:UseConditions;
                   rdfs:range limoo:LicenseModel.
limoo:attributionCondition a owl:DatatypeProperty;
                           rdfs:domain limoo:DistributionConditions;
                           rdfs:range xsd:boolean.
limoo:compatibleWith a owl:ObjectProperty;
                     rdfs:domain limoo:licenseModel;
                     rdfs:range limoo:licenseModel.
limoo:coverDatasets a owl:ObjectProperty;
                    rdfs:domain limoo:LicenseModel;
                    rdfs:range limoo:Dataset.
limoo:createCondition a owl:DatatypeProperty;
                      rdfs:domain limoo:Rights;
                      rdfs:range xsd:boolean.
limoo:creator a owl:DatatypeProperty;
              rdfs:domain limoo:LicenseModel;
              rdfs:range xsd:Name.
limoo:define a owl:ObjectProperty;
             rdfs:domain limoo:LicenseModel;
             rdfs:range limoo:DistributionConditions;
             owl:inverseOf limoo:areDefinedBy.
limoo:guarantee a owl:ObjectProperty;
                rdfs:domain limoo:LicenseModel;
                rdfs:range limoo:Rights;
                owl:inverseOf limoo:areGuaranteedBy.
limoo:hasLicenseModel a owl:ObjectProperty;
                      rdfs:domain limoo:Dataset;
                      rdfs:range limoo:LicenseModel;
                      owl:inverseOf limoo:coverDatasets.
limoo:icon a owl:DatatypeProperty;
           rdfs:domain limoo:LicenseModel;
           rdfs:range xsd:anyURI.
limoo:impose a owl:ObjectProperty;
             rdfs:domain limoo:LicenseModel;
             rdfs:range limoo:UseConditions;
             owl:inverseOf limoo:areImposedBy.
limoo:noCopyrightCondition a owl:DatatypeProperty;
                           rdfs:domain limoo:DistributionConditions;
                           rdfs:range xsd:boolean.
limoo:nonCommercialCondition a owl:DatatypeProperty;
                             rdfs:domain limoo:UseConditions;
                             rdfs:range xsd:boolean.
limoo:nonDerivativeWorksCondition a owl:DatatypeProperty;
                                  rdfs:domain limoo:UseConditions;
                                  rdfs:range xsd:boolean.
limoo:remixCondition a owl:DatatypeProperty;
                     rdfs:domain limoo:Rights;
                     rdfs:range xsd:boolean.
limoo:shareAlikeCondition a owl:DatatypeProperty;
                          rdfs:domain limoo:DistributionConditions;
                          rdfs:range xsd:boolean.
limoo:shareCondition a owl:DatatypeProperty;
                     rdfs:domain limoo:Rights;
                     rdfs:range xsd:boolean.
