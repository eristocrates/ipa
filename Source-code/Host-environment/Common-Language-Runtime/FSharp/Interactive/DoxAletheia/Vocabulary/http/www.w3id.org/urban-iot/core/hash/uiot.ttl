@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix uiot: <http://www.w3id.org/urban-iot/core#>.

<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/Location> <http://purl.org/vocab/vann/usageNote> "Usata per descrivere la localizzazione di uno schema:Place (Luogo)."@it;
                                    a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:label "Localizzazione"@it,
                                               "Location"@en.
<http://purl.org/dc/terms/bibliographicCitation> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/identifier> <http://purl.org/vocab/vann/usageNote> "Usata per associare un identificativo univoco ad una instanza."@it;
                                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:label "identificativo"@it,
                                                 "identifier"@en.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/usageNote> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://schema.org/ContactPoint> a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:label "Contact Point"@en,
                                            "Punto di Contatto"@it.
<http://schema.org/DayOfWeek> <http://purl.org/vocab/vann/usageNote> "Istanze della classe usate per definire una schema:OpeningHoursSpecification (Specifica Orari di Apertura)."@it;
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "Day of Week"@en,
                                         "Giorno della Settimana"@it.
<http://schema.org/Event> a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "Event"@en,
                                     "Evento"@it.
<http://schema.org/Offer> a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "Offer"@en,
                                     "Offerta"@it.
<http://schema.org/OpeningHoursSpecification> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:label "Opening Hours Specification"@en,
                                                         "Specifica Orari di Apertura"@it.
<http://schema.org/Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:label "Organization"@en,
                                            "Organizzazione"@it.
<http://schema.org/Person> a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "Person"@en,
                                      "Persona"@it.
<http://schema.org/Place> a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "Luogo"@it,
                                     "Place"@en.
<http://schema.org/Service> a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "Service"@en,
                                       "Servizio"@it.
<http://schema.org/ServiceChannel> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:label "Canale del Servizio"@it,
                                              "Service Channel"@en.
<http://schema.org/alternateName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:label "alternate name"@en,
                                             "nome alternativo"@it.
<http://schema.org/areaServed> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Service (Servizio) allo schema:Place (Luogo) che è servito dal servizio e in cui il servizio è accessibile."@it;
                               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:label "area served"@en,
                                          "area servita"@it.
<http://schema.org/availableChannel> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Service (Servizio) ad uno schema:ServiceChannel (Canale del Servizio)."@it;
                                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:label "available channel"@en,
                                                "canale disponibile"@it.
<http://schema.org/availableLanguage> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:label "available language"@en,
                                                 "lingua disponibile"@it.
<http://schema.org/birthDate> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:label "birth date"@en,
                                         "data di nascita"@it.
<http://schema.org/closes> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:label "chiude"@it,
                                      "closes"@en.
<http://schema.org/contactPoint> <http://purl.org/vocab/vann/usageNote> "Usata per associare una schema:Organization (Organizzazione) ad un suo schema:ContactPoint (Punto di Contatto) disponibile."@it;
                                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:label "contact point"@en,
                                            "punto di contatto"@it.
<http://schema.org/dayOfWeek> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:label "day of week"@en,
                                         "giorno della settimana"@it.
<http://schema.org/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:label "description"@en,
                                           "descrizione"@it.
<http://schema.org/duration> <http://purl.org/vocab/vann/usageNote> "Literal consigliato xsd:duration."@it;
                             a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:label "durata"@it,
                                        "duration"@en.
<http://schema.org/email> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:label "email"@en,
                                     "email"@it.
<http://schema.org/endDate> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:label "data di fine"@it,
                                       "end date"@en.
<http://schema.org/gender> <http://purl.org/vocab/vann/usageNote> "Literal datatype xsd:string."@it;
                           a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:label "gender"@en,
                                      "genere"@it.
<http://schema.org/hoursAvailable> <http://purl.org/vocab/vann/usageNote> "Associa un Servizio alla Specifica Orari Apertura che descrive gli orari in cui è reso disponibile."@it;
                                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                   rdfs:label "hours available"@en,
                                              "orari disponibili"@it.
<http://schema.org/itemCondition> <http://purl.org/vocab/vann/usageNote> "Usata per associare una schema:Offer (Offerta) ad una descrizione testuale (xsd:string) dei criteri di applicazione, calcolo del costo, periodo di validità e informazioni addizionali."@it;
                                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:label "condizioni dell'oggetto"@it,
                                             "item condition"@en.
<http://schema.org/itemOffered> <http://purl.org/vocab/vann/usageNote> "Usata per associare una schema:Offer (Offerta) al schema:Service (Servizio) a cui è riferita."@it;
                                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:label "item offered"@en,
                                           "oggetto offerto"@it.
<http://schema.org/legalName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:label "legal name"@en,
                                         "nome legale"@it.
<http://schema.org/name> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:label "name"@en,
                                    "nome"@it.
<http://schema.org/offers> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Service (Servizio) alle schema:Offer (Offerta) disponibili."@it;
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "offers"@en,
                                      "offre"@it.
<http://schema.org/openingHoursSpecification> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Place (Luogo) alla sua schema:OpeningHoursSpecification (Specifica Orari di Apertura)."@it;
                                              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:label "opening hours specification"@en,
                                                         "specifica orari di apertura"@it.
<http://schema.org/opens> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:label "apre"@it,
                                     "opens"@en.
<http://schema.org/price> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:label "prezzo"@it,
                                     "price"@en.
<http://schema.org/priceCurrency> <http://purl.org/vocab/vann/usageNote> """Valori secondo lo standard ISO 4217 (es. \"EUR\" per l'Euro)."""@it;
                                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:label "price currency"@en,
                                             "valuta del prezzo"@it.
<http://schema.org/provider> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Service (Servizio) alla schema:Organization (Organizzazione) che lo eroga."@it;
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:label "erogatore"@it,
                                        "provider"@en.
<http://schema.org/servicePhone> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:ServiceChannel (Canale del Servizio) ad uno schema:ContactPoint (Punto di Contatto)."@it;
                                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:label "contatto del servizio"@it,
                                            "service phone"@en.
<http://schema.org/serviceUrl> <http://purl.org/vocab/vann/usageNote> "Usato per associare uno schema:ServiceChannel (Canale del Servizio) ad un url (xsd:anyURI)."@it;
                               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:label "service url"@en,
                                          "url del servizio"@it.
<http://schema.org/startDate> <http://purl.org/vocab/vann/usageNote> "Literal datatype xsd:dateTime."@it;
                              a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:label "data di inizio"@it,
                                         "start date"@en.
<http://schema.org/telephone> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "Literal datatype xsd:string."@en;
                              rdfs:label "telefono"@it,
                                         "telephone"@en.
<http://schema.org/url> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Literal datatype xsd:anyURI."@en;
                        rdfs:label "url"@en,
                                   "url"@it.
<http://www.w3.org/2006/time#timeZone> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:label "fuso orario"@it,
                                                  "time zone"@en.
<http://www.w3.org/ns/legal#LegalEntity> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:label "Entità Legale"@it,
                                                    "Legal Entity"@en.
<http://www.w3.org/ns/locn#Address> <http://purl.org/vocab/vann/usageNote> "Usato per definire l'indirizzo associato ad una dcterms:Location, ad una schema:Person (Persona) o la sede legale di una legal:LegalEntity (Entità Legale). Nel caso di luoghi in Italia può essere utilizzato il profilo italiano (https://w3id.org/italia/onto/CLV/) allineato con locn:Address."@it;
                                    a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:label "Address"@en,
                                               "Indirizzo"@it.
<http://www.w3.org/ns/locn#Geometry> <http://purl.org/vocab/vann/usageNote> "E' consigliato di utilizzare la GeoSPARQL specification (http://www.w3.org/2011/02/GeoSPARQL.pdf) per l'encoding."@it;
                                     a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:label "Geometria"@it,
                                                "Geometry"@en.
<http://www.w3.org/ns/locn#address> <http://purl.org/vocab/vann/usageNote> "Usata per associare una locn:Location (Localizzazione) o una schema:Persona (Person) al suo indirizzo (locn:Address)."@it;
                                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:label "address"@en,
                                               "indirizzo"@it.
<http://www.w3.org/ns/locn#fullAddress> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                        rdfs:label "full address"@en,
                                                   "indirizzo completo"@it.
<http://www.w3.org/ns/locn#geometry> <http://purl.org/vocab/vann/usageNote> "Associa una dcterms:Location (Localizzazione) alla locn:Geometry (Geometria) che la descrive."@it;
                                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:label "geometria"@it,
                                                "geometry"@en.
<http://www.w3.org/ns/locn#location> <http://purl.org/vocab/vann/usageNote> "Usata per associare uno schema:Place (Luogo) alla locn:Location che descrive la sua localizzazione."@it;
                                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:label "localizzazione"@it,
                                                "location"@en.
<http://www.w3.org/ns/locn#postCode> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                     rdfs:label "codice postale"@it,
                                                "post code"@en.
<http://www.w3.org/ns/locn#postName> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                     rdfs:label "divisione postale"@it,
                                                "post name"@en.
<http://www.w3.org/ns/locn#registeredAddress> <http://purl.org/vocab/vann/usageNote> "Usata per associare una legal:LegalEntity (Entità Legale) al locn:Address (Indirizzo) della sua sede legale."@it;
                                              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:label "registered address"@en,
                                                         "sede legale"@it.
<http://www.w3.org/ns/sosa/ObservableProperty> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:label "Observable Property"@en,
                                                          "Proprietà Campionabile"@it.
<http://www.w3.org/ns/sosa/Observation> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:label "Campionamento"@it,
                                                   "Observation"@en.
<http://www.w3.org/ns/sosa/Sensor> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:label "Sensor"@en,
                                              "Sensore"@it.
<http://www.w3.org/ns/sosa/hasResult> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      rdfs:label "ha risultato"@it,
                                                 "has result"@en.
<http://www.w3.org/ns/sosa/hasSimpleResult> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                            rdfs:label "ha valore semplice"@it,
                                                       "has simple result"@en.
<http://www.w3.org/ns/sosa/madeBySensor> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:label "eseguita dal sensore"@it,
                                                    "made by sensor"@en.
<http://www.w3.org/ns/sosa/madeObservation> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                            rdfs:label "ha eseguito campionamento"@it,
                                                       "made observation"@en.
<http://www.w3.org/ns/sosa/observedProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                             rdfs:label "observed property"@en,
                                                        "proprietà campionata"@it.
<http://www.w3.org/ns/sosa/observes> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:label "observes"@en,
                                                "osserva"@it.
<http://www.w3id.org/urban-iot/core> <http://purl.org/dc/elements/1.1/contributor> "Direzione Mobilità e Trasporti - Area Pianificazione e Programmazione Mobilità (Comune di Milano)",
                                                                                   "Direzione Sistemi Informativi ed Agenda Digitale - Area Gestione ed Integrazione Dati (Comune di Milano)",
                                                                                   "Area Pianificazione e Monitoraggio (AMAT Milano)";
                                     <http://purl.org/dc/elements/1.1/creator> "Irene Celino (Cefriel)",
                                                                               "Mario Scrocca (Cefriel)",
                                                                               "Ilaria Baroni (Cefriel)";
                                     <http://purl.org/dc/elements/1.1/publisher> "Comune di Milano";
                                     <http://purl.org/dc/elements/1.1/rights> "Copyright Comune di Milano, 2020";
                                     <http://purl.org/dc/elements/1.1/title> "Ontologie per gli Apparati IoT Urbani - Modulo Core"@it,
                                                                             "Urban IoT Ontologies - Core Module"@en;
                                     <http://purl.org/dc/terms/bibliographicCitation> "Comune di Milano. Urban IoT Ontologies - Core Module (v1.0.0). http://www.w3id.org/urban-iot/core";
                                     <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
                                     <http://purl.org/vocab/vann/preferredNamespacePrefix> "uiot";
                                     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.w3id.org/urban-iot/core#";
                                     a <http://www.w3.org/2002/07/owl#Ontology>;
                                     rdfs:comment "Core module of the suite of ontologies for urban IoT devices."@en,
                                                  "Modulo core delle ontologie per gli apparati IoT urbani."@it;
                                     rdfs:label "Urban IoT Ontologies - Core Module"@en,
                                                "Ontologie per gli Apparati IoT Urbani - Modulo Core"@it;
                                     <http://www.w3.org/2002/07/owl#versionIRI> <http://www.w3id.org/urban-iot/core/1.0.0>;
                                     <http://www.w3.org/2002/07/owl#versionInfo> "v1.0.0".
uiot:MobilityStation a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A Place characterized by mobility services. A Mobility Station can include more specific Mobility Station (Sharing Station, Charging Station, ecc.)."@en,
                                  "Un Luogo caratterizzato dalla presenza di servizi di mobilità. Può includere altre Stazioni di Mobilità dedicate a specifici servizi per la mobilità (Stazioni di Sharing, Stazioni di Ricarica, etc.)."@it;
                     rdfs:label "Mobility Station"@en,
                                "Stazione di Mobilità"@it;
                     rdfs:subClassOf <http://schema.org/Place>.
uiot:SensorRecord a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A Sensor Record aggregates a set of observations associated to the same timestamp and the same sensor."@en,
                               "Un Record del Sensore aggrega un insieme di campionamenti associati allo stesso timestamp e allo stesso sensore."@it;
                  rdfs:label "Record del Sensore"@it,
                             "Sensor Record"@en.
uiot:ServiceBusinessUser a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Entità Legale con contratto business per accedere al servizio. Un Utente Business non può utilizzare direttamente il servizio ma può abilitare un Utente Privato del Servizio a farlo."@it,
                                      "Legal Entity with a business contract for the service. A Service Business User can not directly use the service but can enable a Service Private User to do so."@en;
                         rdfs:label "Service Business User"@en,
                                    "Utente Business del Servizio"@it;
                         rdfs:subClassOf <http://www.w3.org/ns/legal#LegalEntity>,
                                         uiot:ServiceUser.
uiot:ServicePrivateUser a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A natural person using a service."@en,
                                     "Una persona fisica utilizzatore di un servizio."@it;
                        rdfs:label "Service Private User"@en,
                                   "Utente Privato del Servizio"@it;
                        rdfs:subClassOf <http://schema.org/Person>,
                                        uiot:ServiceUser.
uiot:ServiceResource a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A Resource made available by a Service to be used in a Usage Session."@en,
                                  "Risorsa messa a disposizione da un Servizio che può essere utilizzata in una Sessione di Utilizzo."@it;
                     rdfs:label "Risorsa del Servizio"@it,
                                "Service Resource"@en.
uiot:ServiceUser a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A User using a Service."@en,
                              "Utente utilizzatore di un Servizio."@it;
                 rdfs:label "Service User"@en,
                            "Utente del Servizio"@it.
uiot:UsageSession a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A Usage Session is an Event associated to a Service and a Service Resource representing a usage of the resource made available by the Service."@en,
                               "Una Sessione di Utilizzo è un Evento associato ad un Servizio e ad una Risorsa del Servizio che rappresenta un utilizzo della risorsa resa disponibile dal Servizio."@it;
                  rdfs:label "Sessione di Utilizzo"@it,
                             "Usage Session"@en;
                  rdfs:subClassOf <http://schema.org/Event>.
uiot:associatedBusiness a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Associa una Sessione di Utilizzo all'Utente Business del Servizio che la abilita."@it,
                                     "Associates a Usage Session with the Service Business User enabling it."@en;
                        rdfs:domain uiot:UsageSession;
                        rdfs:label "associated business"@en,
                                   "business associato"@it;
                        rdfs:range uiot:ServiceBusinessUser.
uiot:birthYear a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Associa una persona al suo anno di nascita."@it,
                            "Associates a person with her/his birth year."@it;
               rdfs:domain <http://schema.org/Person>;
               rdfs:label "anno di nascita"@it,
                          "birth year"@en;
               rdfs:range xsd:int;
               rdfs:subPropertyOf <http://schema.org/birthDate>.
uiot:containsObservation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Associa un Record del Sensore ad un Campionamento contenuto nel record."@it,
                                      "Associates a Sensor Record with a Observation contained in it."@en;
                         rdfs:domain uiot:SensorRecord;
                         rdfs:label "contains observation"@en,
                                    "contiene campionamento"@it;
                         rdfs:range <http://www.w3.org/ns/sosa/Observation>;
                         <http://www.w3.org/2002/07/owl#inverseOf> uiot:observationIn.
uiot:deregistrationDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Data in cui l'Utente del Servizio ha chiesto la cancellazione della registrazione dal Servizio."@it,
                                     "Date in which a Service User deregistered from a Service."@en;
                        rdfs:domain uiot:ServiceUser;
                        rdfs:label "data di disdetta"@it,
                                   "deregistration date"@en;
                        rdfs:range xsd:dateTime.
uiot:enablesSession a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Associa un Servizio ad una Sessione di Utilizzo abilitata dal Servizio."@it,
                                 "Associates a Service with a Usage Session enabled by the service."@en;
                    rdfs:domain <http://schema.org/Service>;
                    rdfs:label "abilita sessione"@it,
                               "enables session"@en;
                    rdfs:range uiot:UsageSession;
                    <http://www.w3.org/2002/07/owl#inverseOf> uiot:sessionEnabledBy.
uiot:fixedAmount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Associates an Offer with a fixed amount required from it."@en,
                              "Indica un costo fisso dell'Offerta."@it;
                 rdfs:domain <http://schema.org/Offer>;
                 rdfs:label "costo fisso"@it,
                            "fixed amount"@en;
                 rdfs:range xsd:double;
                 rdfs:subPropertyOf <http://schema.org/price>.
uiot:hasEnabledUser a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Associa un Utente Business del Servizio ad un Utente Privato abilitato dall'utenza business."@it,
                                 "Associates a Service Business User with the Service Private User enabled by that business user."@en;
                    rdfs:domain uiot:ServiceBusinessUser;
                    rdfs:label "ha utente abilitato"@it,
                               "has enabled user"@en;
                    rdfs:range uiot:ServicePrivateUser;
                    <http://www.w3.org/2002/07/owl#inverseOf> uiot:userEnabledBy.
uiot:hasUser a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Associa un Servizio ad un Utente del Servizio."@it,
                          "Associates a Service to a Service User."@en;
             rdfs:domain <http://schema.org/Service>;
             rdfs:label "ha utente"@it,
                        "has user"@en;
             rdfs:range uiot:ServiceUser;
             <http://www.w3.org/2002/07/owl#inverseOf> uiot:userOfService.
uiot:includedInMobilityStation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Associa una Stazione di Mobilità ad una Stazione di Mobilità che la include."@it,
                                            "Associates a Mobility Station with another Mobility Station including it."@en;
                               rdfs:domain uiot:MobilityStation;
                               rdfs:label "included in mobility station"@en,
                                          "inclusa nella stazione di mobilità"@it;
                               rdfs:range uiot:MobilityStation.
uiot:latestRecord a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Associa un Sensore all'ultimo Record del Sensore registrato."@it,
                               "Associates a Sensor with the latest registered Sensor Record."@en;
                  rdfs:domain <http://www.w3.org/ns/sosa/Sensor>;
                  rdfs:label "latest record"@en,
                             "ultimo record"@it;
                  rdfs:range uiot:SensorRecord;
                  rdfs:subPropertyOf uiot:registersRecord.
uiot:madeAvailableBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Associa una Risorsa del Servizio al Servizio che la rende disponibile."@it,
                                  "Associates a Service Resource with the Service making it available."@en;
                     rdfs:domain uiot:ServiceResource;
                     rdfs:label "made available by"@en,
                                "resa disponibile da"@it;
                     rdfs:range <http://schema.org/Service>;
                     <http://www.w3.org/2002/07/owl#inverseOf> uiot:makesAvailable.
uiot:makesAvailable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Associa un Servizio ad una risorsa che rende disponibile."@it,
                                 "Associates a Service with the Service Resource that makes available."@en;
                    rdfs:domain <http://schema.org/Service>;
                    rdfs:label "makes available"@en,
                               "rende disponibile"@it;
                    rdfs:range uiot:ServiceResource.
uiot:observationIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Associa un Campionamento al Record del Sensore di cui fa parte."@it,
                                "Associates an Observation with the Sensor Record containing it."@en;
                   rdfs:domain <http://www.w3.org/ns/sosa/Observation>;
                   rdfs:label "campionamento in"@it,
                              "observation in"@en;
                   rdfs:range uiot:SensorRecord.
uiot:offerAssociated a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Associa una Sessione di Utilizzo alla tariffa (Offerta) applicata alla specifica sessione."@it,
                                  "Associates a Usage Session with the tariff (Offer) applied to the specific session."@en;
                     rdfs:domain uiot:UsageSession;
                     rdfs:label "offer associated"@en,
                                "offerta associata"@it;
                     rdfs:range <http://schema.org/Offer>.
uiot:performsSession a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Associa un Utente Privato del Servizio ad una Sessione di Utilizzo effettuata."@it,
                                  "Associates a Service Private User with a Usage Session performed."@en;
                     rdfs:domain uiot:ServicePrivateUser;
                     rdfs:label "effettua sessione"@it,
                                "performs session"@en;
                     rdfs:range uiot:UsageSession;
                     <http://www.w3.org/2002/07/owl#inverseOf> uiot:sessionPerformedBy.
uiot:recordRegisteredBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Associa un Record del Sensore al Sensore che lo ha registrato."@it,
                                     "Associates a Sensor Record with the Sensor registering it."@en;
                        rdfs:domain uiot:SensorRecord;
                        rdfs:label "record registered by"@en,
                                   "record registrato da"@it;
                        rdfs:range <http://www.w3.org/ns/sosa/Sensor>;
                        <http://www.w3.org/2002/07/owl#inverseOf> uiot:registersRecord.
uiot:recordTimestamp a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Timestamp associated with a Sensor Record."@en,
                                  "Timestamp associato ad un Record del Sensore."@it;
                     rdfs:domain uiot:SensorRecord;
                     rdfs:label "record timestamp"@en,
                                "timestamp del record"@it;
                     rdfs:range xsd:dateTime.
uiot:registeredTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Associa un Utente al Servizio a cui è registrato."@it,
                               "Associates a Service User to the Service to which the user is registered to."@en;
                  rdfs:domain uiot:ServiceUser;
                  rdfs:label "registered to"@en,
                             "registrato a"@it;
                  rdfs:range <http://schema.org/Service>.
uiot:registersRecord a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Associa un Sensore ad un Record del Sensore."@it,
                                  "Associates a Sensor with a registered Sensor Record."@en;
                     rdfs:domain <http://www.w3.org/ns/sosa/Sensor>;
                     rdfs:label "registers record"@en,
                                "registra record"@it;
                     rdfs:range uiot:SensorRecord.
uiot:registrationDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Data di registrazione dell'Utente del Servizio al Servizio."@it,
                                   "Date in which a Service User registered to the Service."@en;
                      rdfs:domain uiot:ServiceUser;
                      rdfs:label "data di registrazione"@it,
                                 "registration date"@en;
                      rdfs:range xsd:dateTime.
uiot:reservationUsed a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Indica se un meccanismo di prenotazione è stato utilizzato per una Sessione di Utilizzo."@it,
                                  "Indicates whether a reservation mechanism has been used for a Usage Session."@en;
                     rdfs:domain uiot:UsageSession;
                     rdfs:label "prenotazione utilizzata"@it,
                                "reservation used"@en;
                     rdfs:range xsd:boolean.
uiot:resourceUsedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Associa una Risorsa del Servizio ad una Sessione di Utilizzo in cui è stata utilizzata."@it,
                                 "Associates a Service Resource with a Usage Session using it."@en;
                    rdfs:domain uiot:ServiceResource;
                    rdfs:label "resource used in"@en,
                               "risorsa usata in"@it;
                    rdfs:range uiot:UsageSession;
                    <http://www.w3.org/2002/07/owl#inverseOf> uiot:usesResource.
uiot:serialNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Indication of the serial number."@en,
                               "Indicazione del numero seriale."@it;
                  rdfs:domain uiot:ServiceResource;
                  rdfs:label "numero seriale"@it,
                             "serial number"@en;
                  rdfs:range xsd:string.
uiot:sessionEnabledBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Associa una Sessione di Utilizzo al Servizio che la abilita."@it,
                                   "Associates a Usage Session with the Service enabling it."@en;
                      rdfs:domain uiot:UsageSession;
                      rdfs:label "session enabled by"@en,
                                 "sessione abilitata da"@it;
                      rdfs:range <http://schema.org/Service>.
uiot:sessionPerformedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Associa una Sessione di Utilizzo all'Utente Privato del Servizio che la effettua."@it,
                                     "Associates a Usage Session with the Service Private User performing it."@en;
                        rdfs:domain uiot:UsageSession;
                        rdfs:label "session performed by"@en,
                                   "sessione effettuata da"@it;
                        rdfs:range uiot:ServicePrivateUser.
uiot:userEnabledBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Associa un Utente Privato del Servizio all'Utente Business che lo abilita."@it,
                                "Associates a Service Private User to the Service Business User enabling it."@en;
                   rdfs:domain uiot:ServicePrivateUser;
                   rdfs:label "user enabled by"@en,
                              "utente abilitato da"@it;
                   rdfs:range uiot:ServiceBusinessUser.
uiot:userOfService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Associa un Utente del Servizio al Servizio che utilizza."@it,
                                "Associates a Service User to the Service used."@en;
                   rdfs:domain uiot:ServiceUser;
                   rdfs:label "user of service"@en,
                              "utente del servizio"@it;
                   rdfs:range <http://schema.org/Service>.
uiot:usesResource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Associa una Sessione di Utilizzo alla Risorsa del Servizio utilizzata."@it,
                               "Associates a Usage Session with the Service Resource used in the session."@en;
                  rdfs:domain uiot:UsageSession;
                  rdfs:label "uses resource"@en,
                             "utilizza risorsa"@it;
                  rdfs:range uiot:ServiceResource.
