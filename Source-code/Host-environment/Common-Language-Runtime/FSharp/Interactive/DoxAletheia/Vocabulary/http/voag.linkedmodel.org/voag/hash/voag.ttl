@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix voag: <http://voag.linkedmodel.org/voag#>.
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#>.
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dc11:subject a owl:AnnotationProperty;
             rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
             rdfs:label "subject";
             rdfs:range xsd:string.
dc11:title a owl:AnnotationProperty;
           rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
           rdfs:label "title";
           rdfs:range xsd:string.
void:Dataset vaem:description "A set of RDF triples that are published, maintained or aggregated by a single provider.";
             a owl:Class;
             rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
             rdfs:label "VOID Dataset";
             rdfs:subClassOf voag:GovernedObject.
<http://voag.linkedmodel.org/schema/voag> dc11:author "Ralph Hodgson";
                                          dc11:subject "Licensing, Attribution and Governance";
                                          dc11:title "Vocabulary Of Attribution and Governance";
                                          voag:intent "Provides a schema for intellectual capital rights, attribution and governance. Uses the PROVO ontology for provenance.  Typical use of the ontology is to refer to its resources, as opposed to importing the ontology.";
                                          vaem:dateCreated "2011-01-31T10:00:00"^^xsd:dateTime;
                                          vaem:description """VOAG stands for \"Vocabulary Of Attribution and Governance\". The ontology is intended to specify licensing, attribution, provenance and governance of an ontology. VOAG captures many common license types and their restrictions. Where a license requires attribution, VOAG provides resources that allow the attribution should be made. Provenance is defined in terms of source and pedigree. A miminal model of governance is provided based on how issues, releases and changes are managed. VOAG does not import, but makes uses of some concepts from VOID (http://vocab.deri.ie/void), notably void:Dataset.""";
                                          vaem:hasCatalogEntry voag:VOAG-CatalogEntry;
                                          vaem:hasGraphRole vaem:SchemaGraph;
                                          vaem:lastUpdated "2012-11-01"^^xsd:date;
                                          vaem:name "VOAG";
                                          vaem:namespace "http://voag.linkedmodel.org/voag";
                                          vaem:namespacePrefix "voag";
                                          vaem:revision "1.0";
                                          vaem:url "http://voag.linkedmodel.org/1.0/owl/schema/voag"^^xsd:anyURI;
                                          vaem:usesNonImportedResource voag:TopQuadrantAttribution,
                                                                       dc11:title,
                                                                       voag:VOAG-CatalogEntry,
                                                                       dc11:subject,
                                                                       dc11:contributor,
                                                                       dc11:author,
                                                                       dc11:description;
                                          vaem:withAttributionTo voag:TopQuadrantAttribution;
                                          a owl:Ontology;
                                          rdfs:label "Vocabulary Of Attribution and Governance";
                                          owl:imports <http://www.w3.org/ns/20120724/prov>,
                                                      <http://www.linkedmodel.org/1.2/schema/vaem-xics>,
                                                      <http://www.linkedmodel.org/schema/vaem-xina>,
                                                      <http://rdfs.org/ns/void>,
                                                      <http://www.linkedmodel.org/schema/dtype>,
                                                      <http://www.linkedmodel.org/schema/vaem>;
                                          owl:versionIRI <http://voag.linkedmodel.org/schema/voag>.
voag:Accredidation a owl:Class;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Accredidation";
                   rdfs:subClassOf voag:Qualifier.
voag:AdministrativeEvent dc11:description "An event that is associated with the admistration aspect of governance. Typically these are curation events.";
                         a owl:Class;
                         rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                         rdfs:label "Administrative Event";
                         rdfs:subClassOf voag:Event.
voag:Annually dtype:value "annual";
              a voag:ChangeFrequency;
              rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
              rdfs:label "Annually".
voag:AppendChange a voag:ChangeType;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Append change".
voag:ApprovalEvent vaem:description """A \"Governance Event\".""";
                   a owl:Class;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Approval Event";
                   rdfs:subClassOf voag:Event;
                   owl:disjointWith voag:RejectionEvent.
voag:ApprovalProcess vaem:description """A \"Governance Process\".""";
                     a owl:Class;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Approval Process";
                     rdfs:subClassOf voag:GovernanceProcess.
voag:ApprovedIssue dtype:value "approved";
                   a voag:IssueStatus;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Approved Issue".
voag:AssignedRole a owl:Class;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Assigned role";
                  rdfs:subClassOf owl:Thing.
voag:Attribution dc11:description "An 'Attribution' specifies how credit should be given when citing the creators of a piece of work. Attribution must use the specified attribution text and optionally use logos that are provided in the attribution details below., with the names of points of contact.",
                                  "The name, url and other details of an attribution.";
                 a owl:Class;
                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                 rdfs:label "Attributed Source";
                 rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty vaem:name ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom xsd:string ; 
                                  owl:onProperty voag:pointOfContact ; 
                                  a owl:Restriction],
                                 [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty voag:hasLogo ; 
                                  a owl:Restriction],
                                 voag:Qualifier,
                                 [owl:allValuesFrom voag:AttributionLogo ; 
                                  owl:onProperty voag:hasLogo ; 
                                  a owl:Restriction],
                                 [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty voag:url ; 
                                  a owl:Restriction].
voag:AttributionLogo a owl:Class;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Attribution logo";
                     rdfs:subClassOf voag:Logo.
voag:BiMonthly dtype:value "bi-monthly";
               a voag:ChangeFrequency;
               rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
               rdfs:label "Bi monthly".
voag:BiQuarterly dtype:value "bi-quarterly";
                 a voag:ChangeFrequency;
                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                 rdfs:label "Bi quarterly".
voag:BiWeekly dtype:value "bi-weekly";
              a voag:ChangeFrequency;
              rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
              rdfs:label "Bi-Weekly".
voag:CC-SHAREALIKE_3PT0-US a voag:LicenseModel;
                           rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                           rdfs:label "Creative Commons Attribution-Share Alike 3.0 United States License".
voag:CCPH_CommercialUse vaem:description "Exercising rights for commercial purposes"@en-us;
                        a voag:CreativeCommonsProhibition;
                        rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                        rdfs:label "Creative Commons Commercial Use"@en-us.
voag:CCPH_HighIncomeNationUse vaem:description "Use in a non-developing country"@en-us;
                              a voag:CreativeCommonsProhibition;
                              rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                              rdfs:label "Creative Commons High Income Nation Use"@en-us,
                                         "High income nation use".
voag:CCP_DerivativeWorks vaem:description "Distribution of derivative works"@en-us;
                         a voag:CreativeCommonsPermission;
                         rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                         rdfs:label "Creative Commons Derivative Works"@en-us,
                                    "Derivative works".
voag:CCP_Distribution vaem:description "Creative Commons - distribution, public display, and publicly performance"@en-us;
                      a voag:CreativeCommonsPermission;
                      rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                      rdfs:label "Creative Commons Distribution"@en-us,
                                 "Distribution".
voag:CCP_Reproduction vaem:description "making multiple copies"@en-us;
                      a voag:CreativeCommonsPermission;
                      rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                      rdfs:label "Creative Commons Reproduction"@en-us,
                                 "Reproduction".
voag:CCP_Sharing vaem:description "permits commercial derivatives, but only non-commercial distribution"@en-us;
                 a voag:CreativeCommonsPermission;
                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                 rdfs:label "Creative Commons Sharing"@en-us,
                            "Sharing".
voag:CCR_Attribution vaem:description "Credit to be given to copyright holder and/or author"@en-us;
                     a voag:CreativeCommonsRequirement;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Creative Commons Attribution"@en-us.
voag:CCR_Copyleft vaem:description "Copyleft is a general method for making a program (or other work) free, and requiring all modified and extended versions of the program to be free as well. The simplest way to make a program free software is to put it in the public domain, uncopyrighted. This allows people to share the program and their improvements, if they are so minded. But it also allows uncooperative people to convert the program into proprietary software. They can make changes, many or few, and distribute the result as a proprietary product. People who receive the program in that modified form do not have the freedom that the original author gave them; the middleman has stripped it away.  In the GNU project, Copyleft says that anyone who redistributes the software, with or without changes, must pass along the freedom to further copy and change it. Copyleft guarantees that every user has freedom.",
                                   "combined works must be licensed under specified terms, similar to those on the original work"@en-us;
                  vaem:url "http://www.gnu.org/copyleft/copyleft.html"^^xsd:anyURI;
                  a voag:CreativeCommonsRequirement;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Creative Commons Copyleft"@en-us.
voag:CCR_LesserCopyleft vaem:description "derivative works must be licensed under specified terms, with at least the same conditions as the original work; combinations with the work may be licensed under different terms"@en-us;
                        a voag:CreativeCommonsRequirement;
                        rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                        rdfs:label "Creative Commons Lesser Copyleft"@en-us.
voag:CCR_Notice vaem:description "copyright and license notices be kept intact"@en-us;
                a voag:CreativeCommonsRequirement;
                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                rdfs:label "Creative Commons Notice"@en-us.
voag:CCR_ShareAlike vaem:description "derivative works be licensed under the same terms or compatible terms as the original work"@en-us;
                    a voag:CreativeCommonsRequirement;
                    rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                    rdfs:label "Creative Commons Share Alike"@en-us.
voag:CCR_SourceCode vaem:description "Source code (the preferred form for making modifications) must be provided when exercising some rights granted by the license."@en-us;
                    a voag:CreativeCommonsRequirement;
                    rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                    rdfs:label "Creative Commons Source Code"@en-us.
voag:CL_None dtype:code 0 ;
             dtype:order "1"^^xsd:int;
             dtype:value "none";
             a voag:ConfidentialityLevel;
             rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
             rdfs:label "None".
voag:CL_Restricted dtype:code 1 ;
                   dtype:order "2"^^xsd:int;
                   dtype:value "restricted";
                   vaem:description """During and before World War II, the U.S. had a category of classified information called restricted, which was below confidential. The U.S. no longer has a restricted classification, but many other nations and NATO do. The U.S. treats \"restricted\" information it receives from other governments as confidential. The U.S. does use the term restricted data in a completely different way to refer to nuclear secrets.""";
                   a voag:ConfidentialityLevel;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Restricted".
voag:CL_Secret dtype:code 5 ;
               dtype:order "6"^^xsd:int;
               dtype:value "secret";
               vaem:description """\"Secret\" shall be applied to information, the unauthorized disclosure of which reasonably could be expected to cause serious damage to the national security that the original classification authority is able to identify or describe [US Executive Order 12958].""";
               a voag:ConfidentialityLevel;
               rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
               rdfs:label "Secret".
voag:CL_SensitiveButUnclassified dtype:code 3 ;
                                 dtype:order "4"^^xsd:int;
                                 dtype:value "sbu";
                                 vaem:description "Sensitive but Unclassified (SBU) information should not be disclosed but is not national security information and cannot be classified according to Executive Order (EO)12958, as amended. These materials must be: properly marked, locked up when not under the supervision of an authorized person, and encrypted while in transit over a non-secure network. Some examples are: trade secrets, proprietary information, financial information, personnel and medical records, procurement-sensitive information, IT system security plans, contingency plans, audit logs (recordings of exceptions and other security-related events), vulnerability reports, incident reports and Personally Identifiable Information (PII).";
                                 a voag:ConfidentialityLevel;
                                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                                 rdfs:label "Sensitive but Unclassified".
voag:CL_TopSecret dtype:code 6 ;
                  dtype:order "7"^^xsd:int;
                  dtype:value "topsecret";
                  vaem:description """\"Top Secret\" shall be applied to information, the unauthorized disclosure of which reasonably could be expected to cause exceptionally grave damage to the national security that the original classification authority is able to identify or describe [US Executive Order 12958].""";
                  a voag:ConfidentialityLevel;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Top secret".
voag:CL_Unclassified dtype:code 2 ;
                     dtype:order "3"^^xsd:int;
                     dtype:value "unclassified";
                     vaem:description """Unclassified is not technically a \"classification\"; this is the default, and refers to information that can be released to individuals without a clearance (Level 0). Information that is unclassified is sometimes restricted in its dissemination as SBU or FOUO. For example, the \"law enforcement bulletins\" often reported by the U.S. media when United States Department of Homeland Security raises the U.S. terror threat level are usually classified as \"U//LES\" or \"Unclassified - Law Enforcement Sensitive.\" This information is only supposed to be released to Law Enforcement groups (Sheriff, Police, etc.) Because the information is unclassified, however, it is sometimes released to the public as well. Information which is unclassified, but which the government does not believe should be subject to Freedom of Information Act requests is often classified as U//FOUO - \"Unclassified - For Official Use Only\". In addition to FOUO information, information can be categorized according to its availability to be distributed (Distribution D may only be released to approved Department of Defense and Government Contractor personnel). Also, the statement of NOFORN (meaning No Foreign Nationals) is applied to any information which may not be released to any non-US Citizen. NOFORN and Distribution statements are often used in conjunction with classified information or alone on SBU information. Documents subject to export controls have a specific warning to that effect.""";
                     a voag:ConfidentialityLevel;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Unclassified".
voag:Catalog vaem:description "An index to a set of resources";
             a owl:Class;
             rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
             rdfs:label "Catalog";
             rdfs:subClassOf voag:GovernedObject,
                             [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                              owl:onProperty voag:hasLogo ; 
                              a owl:Restriction].
voag:ChangeFrequency a owl:Class;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Change frequency";
                     rdfs:subClassOf voag:EnumeratedValue;
                     owl:oneOf (voag:Never
                                voag:Daily
                                voag:Weekly
                                voag:BiWeekly
                                voag:Monthly
                                voag:BiMonthly
                                voag:Quarterly
                                voag:BiQuarterly
                                voag:Annually
                                voag:UncertainFrequency).
voag:ChangeManagementProcess dc11:description """A \"Governance Process\".""";
                             a owl:Class;
                             rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                             rdfs:label "Change Management Process";
                             rdfs:subClassOf voag:GovernanceProcess.
voag:ChangeType vaem:description "Change Type provides an indicator for how an artifact has or will change in the future. This indicator is important to understanding the stability of an ontology.";
                a owl:Class;
                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                rdfs:label "Change type";
                rdfs:subClassOf voag:EnumeratedValue.
voag:ClosedIssue dtype:value "closed";
                 a voag:IssueStatus;
                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                 rdfs:label "Closed".
voag:ConcurrenceEvent dc11:description "A Governance Event.";
                      a owl:Class;
                      rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                      rdfs:label "Concurrence event";
                      rdfs:subClassOf voag:Event;
                      owl:disjointWith voag:NonConcurrenceEvent.
voag:ConfidentialityLevel vaem:description "An enumerated codelist for values thath pertain to the security of a set of resources, or a resource. In 'lmc' an ontology can carry a property to denote its confidentiality.";
                          a owl:Class;
                          rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                          rdfs:label "Confidentiality level";
                          rdfs:subClassOf voag:EnumeratedValue.
voag:CreativeCommonsJurisdiction dc11:description "the legal jurisdiction of a license"@en-us;
                                 a owl:Class;
                                 rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                                 rdfs:label "Creative Commons Jurisdiction"@en-us,
                                            "Creative commons jurisdiction";
                                 rdfs:subClassOf owl:Thing.
voag:CreativeCommonsPermission dc11:description "An action that may or may not be allowed or desired"@en-us;
                               a owl:Class;
                               rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                               rdfs:label "Creative Commons Permission"@en-us;
                               rdfs:subClassOf voag:EnumeratedValue.
voag:CreativeCommonsProhibition dc11:description "something you may be asked not to do"@en-us;
                                a owl:Class;
                                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                                rdfs:label "Creative Commons Prohibition"@en-us;
                                rdfs:subClassOf voag:EnumeratedValue.
voag:CreativeCommonsRequirement dc11:description "an action that may or may not be requested of you"@en-us;
                                vaem:description "An action that may or may not be requested of you"@en-us;
                                a owl:Class;
                                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                                rdfs:label "Requirement"@en-us;
                                rdfs:subClassOf voag:EnumeratedValue.
voag:CreativeCommonsWork dc11:description "A potentially copyrightable work"@en-us;
                         a owl:Class;
                         rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                         rdfs:label "Creative Commons Work"@en-us,
                                    "Creative commons work";
                         rdfs:subClassOf owl:Thing,
                                         [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty voag:url ; 
                                          a owl:Restriction].
voag:DTYPE-CatalogEntry a voag:SchemaGraph;
                        rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>.
voag:Daily a voag:ChangeFrequency;
           rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
           rdfs:label "Daily".
voag:DeferredIssue dtype:value "deferred";
                   a voag:IssueStatus;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Deferred".
voag:DeletionEvent dc11:description """A \"Archival Event\".""";
                   a owl:Class;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Deletion Event";
                   rdfs:subClassOf voag:Event.
voag:DesignatedGovernanceRole dc11:description """A \"Assigned Role\" with the following instance(s): \"Assurer\", \"Project Management\", \"Resource & Process Policy\", \"Technical Definitions\", \"User\", \"Verifier\".""";
                              a owl:Class;
                              rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                              rdfs:label "Designated Governance Role";
                              rdfs:subClassOf voag:Event,
                                              [owl:allValuesFrom voag:GovernanceRole ; 
                                               owl:onProperty vaem:hasGraphRole ; 
                                               a owl:Restriction],
                                              [owl:cardinality "1"^^xsd:int ; 
                                               owl:onProperty voag:performedBy ; 
                                               a owl:Restriction].
voag:DisapprovedIssue a voag:IssueStatus;
                      rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                      rdfs:label "Disapproved Issue".
voag:Document a owl:Class;
              rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
              rdfs:label "Document";
              rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty vaem:dateCreated ; 
                               a owl:Restriction],
                              [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty vaem:name ; 
                               a owl:Restriction],
                              owl:Thing,
                              [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty vaem:lastUpdated ; 
                               a owl:Restriction],
                              [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty voag:title ; 
                               a owl:Restriction],
                              [owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                               owl:onProperty voag:url ; 
                               a owl:Restriction],
                              [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty vaem:description ; 
                               a owl:Restriction].
voag:DocumentationChange a voag:ChangeType;
                         rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                         rdfs:label "Documentation change".
voag:EarlyAdoption a voag:Maturity;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Early adoption".
voag:EnumeratedValue dc11:description "The base class in LMC for enumerated values";
                     a owl:Class;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Metadata Enumerated value";
                     rdfs:subClassOf dtype:EnumeratedValue.
voag:Event a owl:Class;
           rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
           rdfs:label "Event";
           rdfs:subClassOf [owl:maxCardinality "1"^^xsd:int ; 
                            owl:onProperty voag:endDate ; 
                            a owl:Restriction],
                           [owl:maxCardinality "1"^^xsd:int ; 
                            owl:onProperty voag:startDate ; 
                            a owl:Restriction],
                           [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty vaem:name ; 
                            a owl:Restriction],
                           [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty voag:id ; 
                            a owl:Restriction],
                           owl:Thing,
                           [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty vaem:description ; 
                            a owl:Restriction],
                           [owl:allValuesFrom voag:Party ; 
                            owl:onProperty voag:instigatedBy ; 
                            a owl:Restriction],
                           [owl:maxCardinality "1"^^xsd:int ; 
                            owl:onProperty voag:eventDate ; 
                            a owl:Restriction],
                           [owl:maxCardinality "1"^^xsd:int ; 
                            owl:onProperty voag:instigatedBy ; 
                            a owl:Restriction].
voag:Experimental a voag:Maturity;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Experimental".
voag:Figure vaem:description "An illustration of some kind.";
            a owl:Class;
            rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
            rdfs:label "Figure";
            rdfs:subClassOf voag:Image,
                            [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty voag:imageMap ; 
                             a owl:Restriction].
voag:GR_Authorizer dtype:value "authorizer";
                   a voag:GovernanceRole;
                   rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                   rdfs:label "Authorizer".
voag:GR_Steward dtype:value "steward";
                a voag:GovernanceRole;
                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                rdfs:label "Steward".
voag:GR_Submitter dtype:value "submitter";
                  a voag:GovernanceRole;
                  rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                  rdfs:label "Submitter".
voag:Governance dc11:description "Governance is mainly concerned with how an artifact is provisioned and managed over its lifecycle. Governance also concerns the status tracking and processes that need to exist on information objects and services for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction are obtained at each appropriate stage.";
                a owl:Class;
                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                rdfs:label "Governance";
                rdfs:subClassOf [owl:allValuesFrom voag:Governance ; 
                                 owl:onProperty voag:supercedes ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:int ; 
                                 owl:onProperty voag:hasProtocol ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:Document ; 
                                 owl:onProperty voag:hasNormativeDocument ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty voag:hasOwner ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:int ; 
                                 owl:onProperty voag:hasApprovalStatus ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty voag:hasConfidentiality ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:GovernanceEvent ; 
                                 owl:onProperty voag:hasGovernanceEvent ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:GovernanceProtocol ; 
                                 owl:onProperty voag:hasProtocol ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty voag:isITAR ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:ChangeType ; 
                                 owl:onProperty voag:hasAnticipatedChangeType ; 
                                 a owl:Restriction],
                                voag:Qualifier,
                                [owl:allValuesFrom voag:Party ; 
                                 owl:onProperty voag:hasOwner ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:Document ; 
                                 owl:onProperty voag:hasReferenceDocument ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:Document ; 
                                 owl:onProperty voag:hasApplicableDocument ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:ConfidentialityLevel ; 
                                 owl:onProperty voag:hasConfidentiality ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:ChangeFrequency ; 
                                 owl:onProperty voag:frequencyOfChange ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom voag:Issue ; 
                                 owl:onProperty voag:hasIssue ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty voag:isFOSS ; 
                                 a owl:Restriction].
voag:GovernanceEvent dc11:description """A \"Governance Event\".""";
                     a owl:Class;
                     rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                     rdfs:label "Governance Event";
                     rdfs:subClassOf voag:Event.
voag:GovernanceProcess dc11:description """A \"Process\".""";
                       a owl:Class;
                       rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                       rdfs:label "Governance Process";
                       rdfs:subClassOf voag:Process.
voag:GovernanceProtocol dc11:description "Governance is used  to mean the processes that need to exist for a successful initiaitve, mission, program, or project. Such governance needs to outline the relationships between all internal and external groups involved, describe the proper flow of information regarding to all stakeholders, ensure the appropriate review of issues encountered and ensure that required approvals and direction for a 'GovernedEntity' is obtained at each appropriate stage.";
                        a owl:Class;
                        rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                        rdfs:label "Governance Protocol";
                        rdfs:subClassOf [owl:allValuesFrom voag:IssueResolutionProcess ; 
                                         owl:onProperty voag:hasIssueResolutionProcess ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:StakeholderGroup ; 
                                         owl:onProperty voag:isInterestOf ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:Organization ; 
                                         owl:onProperty voag:isGovernedBy ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:ChangeManagementProcess ; 
                                         owl:onProperty voag:hasChangeManagementProcess ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:StakeholderGroup ; 
                                         owl:onProperty voag:reviewedBy ; 
                                         a owl:Restriction],
                                        [owl:onProperty voag:hasNormativeDocument ; 
                                         owl:someValuesFrom voag:Document ; 
                                         a owl:Restriction],
                                        [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty voag:hasIssueResolutionProcess ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:ApprovalProcess ; 
                                         owl:onProperty voag:hasApprovalProcess ; 
                                         a owl:Restriction],
                                        [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty voag:hasChangeManagementProcess ; 
                                         a owl:Restriction],
                                        [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty voag:isGovernedBy ; 
                                         a owl:Restriction],
                                        voag:Qualifier,
                                        [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty voag:hasApprovalProcess ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:StakeholderGroup ; 
                                         owl:onProperty voag:isApprovedBy ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom voag:StakeholderGroup ; 
                                         owl:onProperty voag:mayNeedConcurrenceFrom ; 
                                         a owl:Restriction],
                                        [owl:cardinality "3"^^xsd:int ; 
                                         owl:onProperty voag:hasProcess ; 
                                         a owl:Restriction],
                                        [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty voag:id ; 
                                         a owl:Restriction],
                                        [owl:onProperty voag:isGovernedBy ; 
                                         owl:someValuesFrom voag:StakeholderGroup ; 
                                         a owl:Restriction];
                        owl:equivalentClass [rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag> ; 
                                             owl:intersectionOf ([owl:onProperty voag:isGovernedBy ; 
                                                                 owl:someValuesFrom voag:StakeholderGroup ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty voag:hasProcess ; 
                                                                 owl:someValuesFrom voag:GovernanceProcess ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty voag:hasNormativeDocument ; 
                                                                 owl:someValuesFrom voag:Document ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
voag:GovernanceRole dc11:description """A \"Role\" with the following instance(s): \"authorizer\", \"steward\", \"submitter\".""";
                    a owl:Class;
                    rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                    rdfs:label "Governance Role";
                    rdfs:subClassOf voag:EnumeratedValue.
voag:GovernedObject vaem:description "An abstract class for all governed entities";
