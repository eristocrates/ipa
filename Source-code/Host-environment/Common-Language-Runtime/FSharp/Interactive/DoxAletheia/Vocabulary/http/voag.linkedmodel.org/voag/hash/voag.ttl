                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty vaem:lastUpdated ; 
                                     a owl:Restriction],
                                    [owl:allValuesFrom voag:Provenance ; 
                                     owl:onProperty voag:hasProvenance ; 
                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
