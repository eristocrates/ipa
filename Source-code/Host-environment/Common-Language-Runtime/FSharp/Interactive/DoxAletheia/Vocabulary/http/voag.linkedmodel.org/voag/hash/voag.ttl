voag:mayNeedConcurrenceFrom dc11:description "An object property that specifies that a party may need to give consent, in the form of agreement, either written or verbally to the approval of some govenance concern.";
                            a owl:ObjectProperty;
                            rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                            rdfs:label "may need concurrence from";
                            rdfs:subPropertyOf voag:isGovernedBy;
                            owl:inverseOf voag:givesConcurrenceFor.
