mobivoc:ParallelParking dcterms:created "2017-05-10"^^xsd:date;
                        dcterms:modified "2018-01-12"^^xsd:date;
                        a mobivoc:ArrangementPattern;
                        rdfs:comment "Bei der Längsaufstellung wird das Fahrzeug (gemäß § 12 StVO) parallel zur Fahrbahn geparkt. Diese Fahrzeugaufstellung ist die gängigste Aufstellungsart an Straßen."@de,
                                     "With parallel parking, vehicles are arranged in a line, with the front of one vehicle facing the back of an adjacent one. This is done parallel to a curb, when one is provided. Parallel parking is the most common mode of roadside parking for vehicles."@en;
                        rdfs:isDefinedBy mobivoc:;
                        rdfs:label "Parallel parking"@en,
                                   "Längsaufstellung"@de;
                        status:term_status "stable";
                        skos:altLabel "Parallelaufstellung"@de;
                        skos:prefLabel "Längsaufstellung"@de,
                                       "Parallel parking"@en.
