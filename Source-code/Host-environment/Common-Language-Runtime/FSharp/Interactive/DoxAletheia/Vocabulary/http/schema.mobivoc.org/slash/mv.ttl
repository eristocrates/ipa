mobivoc:Full a mobivoc:CivicStructureStatus;
             rdfs:comment "The parking facility is completely occupied.";
             rdfs:isDefinedBy mobivoc:;
             rdfs:label "Belegt"@de,
                        "Full"@en.
mobivoc:IEC_60309_16A_2_E mobivoc:ocmConnectionID "4";
                          a mobivoc:PlugType;
                          rdfs:comment """IEC 60309 (formerly IEC 309 and CEE 17, also published by CENELEC as EN 60309) is an international standard from the International Electrotechnical Commission (IEC) for \"plugs, socket-outlets and couplers for industrial purposes\". The blue P+N+E, 6h (180°) plug is a single phase connector. In particular this smallest (16 A) variant has become especially common in camping vehicles and sockets found in caravan parks and marinas throughout Europe.""";
                          rdfs:isDefinedBy mobivoc:;
                          rdfs:label "IEC_60309 16A 2+E"@en;
                          rdfs:seeAlso wikipedia:IEC_60309;
                          skos:altLabel "Blue Commando (2P+E)";
                          foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/c/c0/CEE_16A_230V_Wandsteckdose_Pinning.png/800px-CEE_16A_230V_Wandsteckdose_Pinning.png>.
mobivoc:IEC_60309_3-pin mobivoc:ocmConnectionID "16",
                                                "34";
                        a mobivoc:PlugType;
                        rdfs:comment """IEC 60309 (formerly IEC 309 and CEE 17, also published by CENELEC as EN 60309) is an international standard from the International Electrotechnical Commission (IEC) for \"plugs, socket-outlets and couplers for industrial purposes\". 3-Pin connector.""";
                        rdfs:isDefinedBy mobivoc:;
                        rdfs:label "IEC_60309 3-pin"@en;
                        rdfs:seeAlso wikipedia:IEC_60309.
mobivoc:IEC_60309_5-pin mobivoc:ocmConnectionID "17";
                        a mobivoc:PlugType;
                        rdfs:comment """IEC 60309 (formerly IEC 309 and CEE 17, also published by CENELEC as EN 60309) is an international standard from the International Electrotechnical Commission (IEC) for \"plugs, socket-outlets and couplers for industrial purposes\". 5-Pin connector.""";
                        rdfs:isDefinedBy mobivoc:;
                        rdfs:label "IEC_60309 5-pin"@en;
                        rdfs:seeAlso wikipedia:IEC_60309;
                        foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/CEE-Stecker.jpg/1280px-CEE-Stecker.jpg>.
mobivoc:IEC_62196_Type_3A mobivoc:ocmConnectionID "36";
                          a mobivoc:PlugType;
                          rdfs:comment "The type 3A is derived from the Scame charging connectors adding the IEC 62196 pins which is suited for single-phase charging – the connector builds on the experience with the Scame connector for charging of light vehicles (electric motorcycles and scooters).";
                          rdfs:isDefinedBy mobivoc:;
                          rdfs:label "SCAME Type 3A"@en;
                          rdfs:seeAlso <https://en.wikipedia.org/wiki/IEC_62196#Type_3_(EV_Plug_Alliance_connector),_Scame>;
                          skos:altLabel "IEC 62196-2 Type 3A".
mobivoc:IEC_62196_Type_3C mobivoc:ocmConnectionID "26";
                          a mobivoc:PlugType;
                          rdfs:comment "The type 3A is derived from the Scame charging connectors adding the IEC 62196 pins which is suited for single-phase charging – the connector builds on the experience with the Scame connector for charging of light vehicles (electric motorcycles and scooters). The additional type 3C adds additional 2 pins for three-phase charging for usage at fast charge stations. Based on its origin the connector is sometimes referred to as the Scame type 3 connector.";
                          rdfs:isDefinedBy mobivoc:;
                          rdfs:label "SCAME Type 3C"@en;
                          rdfs:seeAlso <https://en.wikipedia.org/wiki/IEC_62196#Type_3_(EV_Plug_Alliance_connector),_Scame>;
                          skos:altLabel "IEC 62196-2 Type 3C".
mobivoc:Inhabitants a mobivoc:UserGroup;
                    rdfs:comment "People living on the premises."@en;
                    rdfs:isDefinedBy mobivoc:;
                    rdfs:label "Inhabitants"@en,
                               "Anwohner"@de.
mobivoc:Mennekes_Type_2 mobivoc:ocmConnectionID "1036",
                                                "25";
                        a mobivoc:PlugType;
                        rdfs:comment "The IEC 62196 Type 2 connector (commonly referred to as Mennekes) is used for charging electric cars within Europe. The connector is circular in shape, with a flattened top edge and originally specified for charging battery electric vehicles at 3–120 kilowatts.";
                        rdfs:isDefinedBy mobivoc:;
                        rdfs:label "Mennekes (Type 2)"@en;
                        rdfs:seeAlso wikipedia:Type_2_connector;
                        skos:altLabel "IEC_62196 Type 2";
                        foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/f/f3/VDE-AR-E_2623-2-2-plug.jpg>.
mobivoc:Motorbike a schema:Vehicle;
                  rdfs:comment "A single-track, two-wheeled motor vehicle."@en;
                  rdfs:isDefinedBy mobivoc:;
                  rdfs:label "Motorbike"@en,
                             "Motorrad"@de;
                  skos:altLabel "Motorcycle"@en;
                  skos:prefLabel "Moto"@fr,
                                 "Motorbike"@en,
                                 "Motorrad"@de.
mobivoc:NEMA_14-30 mobivoc:ocmConnectionID "10";
                   a mobivoc:PlugType;
                   rdfs:comment "NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association. The NEMA 14 devices are four-wire grounding devices (hot-hot-neutral-ground) available in ratings from 15 to 60 A. The voltage rating is 250 V. Rated for 30A.";
                   rdfs:isDefinedBy mobivoc:;
                   rdfs:label "NEMA 14-30"@en;
                   rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_14>;
                   foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/d/d3/220sb.svg>.
mobivoc:NEMA_14-50 mobivoc:ocmConnectionID "11";
                   a mobivoc:PlugType;
                   rdfs:comment "NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association. The NEMA 14 devices are four-wire grounding devices (hot-hot-neutral-ground) available in ratings from 15 to 60 A. The voltage rating is 250 V. Rated for 60A.";
                   rdfs:isDefinedBy mobivoc:;
                   rdfs:label "NEMA 14-50"@en;
                   rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_14>;
                   foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/d/d3/220sb.svg>.
mobivoc:NEMA_5-15R mobivoc:ocmConnectionID "22";
                   a mobivoc:PlugType;
                   rdfs:comment """NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association. All NEMA 5 devices are three-wire grounding devices (hot-neutral-ground) rated for 125 V maximum.
   The 5-15R is by far the most common electrical receptacle in North America in buildings built since the mid-twentieth century. It is usually installed in a duplex configuration; two receptacles may share a common circuit or may each be wired separately, sometimes to a switch.""";
                   rdfs:isDefinedBy mobivoc:;
                   rdfs:label "NEMA 5-15R"@en;
                   rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_5>;
                   foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/0/0d/NEMA_simplified_pins.svg/765px-NEMA_simplified_pins.svg.png>.
mobivoc:NEMA_5-20R mobivoc:ocmConnectionID "9";
                   a mobivoc:PlugType;
                   rdfs:comment "NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association. All NEMA 5 devices are three-wire grounding devices (hot-neutral-ground) rated for 125 V maximum.";
                   rdfs:isDefinedBy mobivoc:;
                   rdfs:label "NEMA 5-20R"@en;
                   rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_5>;
                   foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/4/42/Electrical_outlet_with_label.jpg/1280px-Electrical_outlet_with_label.jpg>.
mobivoc:NEMA_6-15 mobivoc:ocmConnectionID "15";
                  a mobivoc:PlugType;
                  rdfs:comment """NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association.
All NEMA 6 devices are three-wire grounding devices (hot-hot-ground) used for 208 and 240 V circuits and rated for 250 V maximum. The 6-15 resembles the 5-15, but with collinear horizontal pins""";
                  rdfs:isDefinedBy mobivoc:;
                  rdfs:label "NEMA 6-15"@en;
                  rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_6>;
                  foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/8/86/Nema_6-15.svg/346px-Nema_6-15.svg.png>.
mobivoc:NEMA_6-20 mobivoc:ocmConnectionID "14";
                  a mobivoc:PlugType;
                  rdfs:comment """NEMA connectors are power plugs and receptacles used for AC mains electricity in North America and other countries that use the standards set by the US National Electrical Manufacturers Association.
All NEMA 6 devices are three-wire grounding devices (hot-hot-ground) used for 208 and 240 V circuits and rated for 250 V maximum. The 20 A plug has a blade rotated 90°.""";
                  rdfs:isDefinedBy mobivoc:;
                  rdfs:label "NEMA 6-20"@en;
                  rdfs:seeAlso <https://en.wikipedia.org/wiki/NEMA_connector#NEMA_6>;
                  foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/0/0d/NEMA_simplified_pins.svg/765px-NEMA_simplified_pins.svg.png>.
