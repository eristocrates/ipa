mobivoc: ccrel:license <http://creativecommons.org/licenses/by/4.0/>;
         dcterms:contributor <http://purl.org/net/clange>,
                             <http://sebastian.tramp.name/>,
                             <http://eis.iai.uni-bonn.de/NiklasPetersen>;
         dcterms:created "2014-08-05"^^xsd:date;
         dcterms:creator ecc:aweilandt,
                         ecc:mbruemmer;
         dcterms:modified "2018-01-12"^^xsd:date;
         dcterms:publisher ecc:eccenca-GmbH;
         vann:preferredNamespacePrefix "mv";
         vann:preferredNamespaceUri "http://schema.mobivoc.org/";
         void:vocabulary vann:,
                         foaf:;
         a owl:Ontology,
           voaf:Vocabulary;
         rdfs:comment "Our goal is to significantly improve the data mobility between all stakeholders by providing a standardized vocabulary using Semantic Web technologies and ontologies. For the open vocabulary covering various mobility aspects we use RDF (Resource Description Framework) - a recommended specification of the World Wide Web Consortium (W3C) and the so-called lingua franca for the integration of data and web. We invite everyone who is interested to join our MobiVoc initiative and to participate in the development of the Open Mobility Vocabulary.";
         rdfs:isDefinedBy mobivoc:;
         rdfs:label "MobiVoc: Open Mobility Vocabulary"@en;
         owl:versionInfo "v1.0.0".
mobivoc:AS_3112_Type_I mobivoc:ocmConnectionID "29";
                       a mobivoc:PlugType;
                       rdfs:comment "AS/NZS 3112 are the harmonised Australian and New Zealand standards for AC Plugs and Socket-Outlets.";
                       rdfs:isDefinedBy mobivoc:;
                       rdfs:label "AS 3112 Type I"@en;
                       rdfs:seeAlso <https://en.wikipedia.org/wiki/AS/NZS_3112>;
                       skos:altLabel "Type I",
                                     "Type I/AS 3112/CPCS-CCC";
                       foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Aust_AC_plug.jpg/800px-Aust_AC_plug.jpg>.
mobivoc:AccessCondition dcterms:created "2017-08-29"^^xsd:date;
                        dcterms:modified "2018-01-12"^^xsd:date;
                        a owl:Class;
                        rdfs:comment "A condition that has to be fullfilled to get access to a civic structure."@en;
                        rdfs:isDefinedBy mobivoc:;
                        rdfs:label "Access condition"@en,
                                   "Zugangsbedingung"@de;
                        status:term_status "stable".
mobivoc:Action dcterms:created "2017-06-23"^^xsd:date;
               dcterms:modified "2018-01-12"^^xsd:date;
               a owl:Class;
               rdfs:comment "Action that is done."@en;
               rdfs:isDefinedBy mobivoc:;
               rdfs:label "Aktion"@de,
                          "Action"@en;
               status:term_status "stable".
mobivoc:AllParkingFacilitiesFull a mobivoc:CivicStructureStatus;
                                 rdfs:comment "All parking facilities within a specified area are completely occupied."@en;
                                 rdfs:isDefinedBy mobivoc:;
                                 rdfs:label "All parking facilities full"@en,
                                            "Alle Parkmöglichkeiten belegt"@de.
mobivoc:Allow a mobivoc:Action;
              rdfs:comment "Allow to do an action."@en;
              rdfs:isDefinedBy mobivoc:;
              rdfs:label "Allow"@en,
                         "Erlauben"@de.
mobivoc:AngleParking dcterms:created "2017-05-31"^^xsd:date;
                     dcterms:modified "2018-01-12"^^xsd:date;
                     a mobivoc:ArrangementPattern;
                     rdfs:comment "Parking where the parking spaces are arranged at an acute angle to the direction of approach, allowing the driver to enter a space easily and later reverse back out."@en,
                                  "Bei der Schrägaufstellung wird das Fahrzeug mit einem Aufstellwinkel zwischen 50 und 90 gon (45° und ca. 81°) geparkt. Das Fahrzeug kann vorwärts in den Parkstand einfahren, muss zum Ausparken jedoch wieder rückwärts herausfahren. Diese Aufstellung wird oft bei Parkplätzen verwendet, da sie schmalere Fahrwege als die Senkrechtaufstellung und bessere Platzausnutzung als Parallelaufstellung ermöglicht."@de;
                     rdfs:isDefinedBy mobivoc:;
                     rdfs:label "Schrägaufstellung"@de,
                                "Angle parking"@en;
                     status:term_status "stable";
                     skos:altLabel "Echelon parking"@en-uk.
mobivoc:ArrangementPattern dcterms:created "2017-05-10"^^xsd:date;
                           dcterms:modified "2018-01-12"^^xsd:date;
                           a owl:Class,
                             rdfs:Class;
                           rdfs:comment "Art und Weise, wie ein Fahrzeug auf einer Parkfläche aufgestellt wird."@de,
                                        "Pattern how parking spaces are arranged in a parking facility or at roadside."@en;
                           rdfs:isDefinedBy mobivoc:;
                           rdfs:label "Arrangement pattern"@en,
                                      "Aufstellart"@de;
                           status:term_status "stable".
mobivoc:AutomatedParkingGarage dcterms:created "2017-04-13"^^xsd:date;
                               dcterms:modified "2018-01-12"^^xsd:date;
                               a owl:Class,
                                 rdfs:Class;
                               rdfs:comment "Parking garage with an automated parking system that automatically moves cars to the available parking space somewhere in the garage."@en;
                               rdfs:isDefinedBy mobivoc:;
                               rdfs:label "Automatisches Parkhaus"@de,
                                          "Automated parking garage"@en;
                               rdfs:subClassOf mobivoc:ParkingFacility;
                               status:term_status "stable".
mobivoc:BS1363 mobivoc:ocmConnectionID "3";
               a mobivoc:PlugType;
               rdfs:comment "13 A plugs socket-outlets adaptors and connection units is a British Standard which specifies the most common type of single-phase AC power plugs and sockets that are used in the United Kingdom.";
               rdfs:isDefinedBy mobivoc:;
               rdfs:label "BS1363"@en;
               rdfs:seeAlso <https://en.wikipedia.org/wiki/AC_power_plugs_and_sockets:_British_and_related_types#International_usage_of_Type_G>;
               skos:altLabel "Type G";
               foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/0/00/British_plug.jpg>.
mobivoc:Bicycle a schema:Vehicle;
                rdfs:comment "A human-or electric powered, pedal-driven, single-track vehicle, having two wheels attached to a frame, one behind the other."@en;
                rdfs:isDefinedBy mobivoc:;
                rdfs:label "Vélo"@fr,
                           "Bicycle"@en,
                           "Fahrrad"@de.
mobivoc:BicycleParkingStation dcterms:created "2017-05-10"^^xsd:date;
                              dcterms:modified "2018-01-12"^^xsd:date;
                              a owl:Class,
                                rdfs:Class;
                              rdfs:comment "Building or structure designed for use as a bicycle parking facility."@en;
                              rdfs:isDefinedBy mobivoc:;
                              rdfs:label "Fahrradparkstation"@de,
                                         "Bicycle parking station"@en;
                              rdfs:subClassOf mobivoc:ParkingFacility;
                              status:term_status "stable".
mobivoc:BikeAndRide a mobivoc:ParkingFacilityConnection;
                    rdfs:comment "Parking facilities for bicycles with connection to public transport.";
                    rdfs:isDefinedBy mobivoc:;
                    rdfs:label "Bike and Ride".
mobivoc:BusOrCoach a schema:Vehicle;
                   rdfs:comment "A bus is a road vehicle designed to carry passengers. Coaches are luxury busses, usually in service for long distance travel."@en;
                   rdfs:isDefinedBy mobivoc:;
                   rdfs:label "Coach"@en,
                              "Bus"@de.
mobivoc:CCS_Type2 mobivoc:ocmConnectionID "33";
                  a mobivoc:PlugType;
                  rdfs:comment "The Combined Charging System is a quick charging method for battery electric vehicles delivering high-voltage direct current via a special electrical connector derived from the  IEC Type 2 connector. As the plug is a combination of an AC connector with a DC option the resulting connector is also called Combo Coupler and the variant with Type 2 is abbreviated as Combo2.";
                  rdfs:isDefinedBy mobivoc:;
                  rdfs:label "CCS Type2"@en;
                  rdfs:seeAlso wikipedia:Combined_Charging_System;
                  skos:altLabel "Combo2";
                  foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/CCSCombo2.svg/1052px-CCSCombo2.svg.png>.
mobivoc:CEE_7-Pin mobivoc:ocmConnectionID "18";
                  a mobivoc:PlugType;
                  rdfs:comment "CEE 7-Pin 32A / 400V Socket.";
                  rdfs:isDefinedBy mobivoc:;
                  rdfs:label "CEE 7-Pin"@en.
mobivoc:CEE_7_16 mobivoc:ocmConnectionID "13";
                 a mobivoc:PlugType;
                 rdfs:comment "The CEE 7/16 standard sheet appears in Supplement 2 (June 1962) to the 1951 edition of CEE 7. The CEE 7/16 unearthed plug is used for low power Class II applications, it has two round 4 by 19 mm (0.157 by 0.748 in) pins, rated at 2.5 A. There are two variants.";
                 rdfs:isDefinedBy mobivoc:;
                 rdfs:label "CEE 7/16"@en;
                 rdfs:seeAlso <https://en.wikipedia.org/wiki/AC_power_plugs_and_sockets#CEE_7/16_plugs>;
                 skos:altLabel "Europlug";
                 foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/6/63/Euro-Flachstecker_2.jpg>.
mobivoc:CEE_7_4 mobivoc:ocmConnectionID "28";
                a mobivoc:PlugType;
                rdfs:comment "The CEE 7/3 socket and CEE 7/4 plug are commonly called Schuko. The socket (which is often, in error, also referred to as CEE 7/4) has a predominantly circular recess which is 17.5 mm (0.689 in) deep with two symmetrical round apertures and two earthing clips on the sides of the socket positioned to ensure that the earth is always engaged before live pin contact is made. The plug pins are 4.8 by 19 mm (0.189 by 0.748 in).";
                rdfs:isDefinedBy mobivoc:;
                rdfs:label "CEE 7/4"@en;
                rdfs:seeAlso <https://en.wikipedia.org/wiki/AC_power_plugs_and_sockets#CEE_7/5_socket_and_CEE_7/6_plug_(French;_Type_E)>;
                skos:altLabel "Schuko",
                              "Type F";
                foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/e/ef/Schuko_plug_and_socket.png>.
mobivoc:CEE_7_5 mobivoc:ocmConnectionID "23";
                a mobivoc:PlugType;
                rdfs:comment """The CEE 7/5 socket and CEE 7/6 plug are defined in French standard NF C 61-314 \"Plugs and socket-outlets for household and similar purposes\" (which also includes CEE 7/7, 7/16 and 7/17 plugs) The socket has a predominantly circular recess which is 15 mm (0.591 in) deep with two symmetrical round apertures and a round 4.8 mm (0.189 in) earth pin projecting from the socket such that the tip is 23 mm (0.906 in) beyond the live contacts, to ensure that the earth is always engaged before live pin contact is made. The earth pin is centred between the apertures, offset by 10 mm (0.394 in). The plug (which is often, in error, also referred to as CEE 7/5) has two round pins measuring 4.8 by 19 mm (0.189 by 0.748 in), spaced 19 mm (0.748 in) apart and with an aperture for the socket's projecting earth pin. This standard is also used in Belgium, Poland, the Czech Republic, Slovakia and some other countries.""";
                rdfs:isDefinedBy mobivoc:;
                rdfs:label "CEE 7/5"@en;
                rdfs:seeAlso <https://en.wikipedia.org/wiki/AC_power_plugs_and_sockets#CEE_7/5_socket_and_CEE_7/6_plug_(French;_Type_E)>;
                skos:altLabel "Type E";
                foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/thumb/b/b3/E_plug_and_socket.jpg/1920px-E_plug_and_socket.jpg>.
mobivoc:CHAdeMO mobivoc:ocmConnectionID "2";
                a mobivoc:PlugType;
                rdfs:comment "CHAdeMO is the trade name of a quick charging method for battery electric vehicles delivering up to 62.5 kW of direct current (500 V, 125 A[1]) via a special electrical connector.";
                rdfs:isDefinedBy mobivoc:;
                rdfs:label "CHAdeMO"@en;
                rdfs:seeAlso wikipedia:CHAdeMO;
                owl:sameAs resource:CHAdeMO;
                foaf:depiction <https://upload.wikimedia.org/wikipedia/commons/d/d3/CHAdeMO_Plug_VacavilleDavisStDC2.jpg>.
