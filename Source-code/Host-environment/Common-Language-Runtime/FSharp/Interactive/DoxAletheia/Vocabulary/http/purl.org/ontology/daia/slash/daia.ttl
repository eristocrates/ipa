@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix daia: <http://purl.org/ontology/daia/>.

<http://purl.org/dc/terms/Location> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/dc/terms/available> rdfs:type rdfs:Property;
                                     <http://www.w3.org/2008/05/skos#scopeNote> "Date that a resource became or will become available. Applications may derive this property from daia:expected and/or daia:timestamp"@en.
<http://purl.org/dc/terms/coverage> rdfs:type rdfs:Property.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                       rdfs:type rdfs:Property.
<http://purl.org/dc/terms/hasPart> rdfs:type rdfs:Property;
                                   <http://www.w3.org/2008/05/skos#scopeNote> "This property can be inferred from a daia:narrowerExemplar or daia:broaderExemplar property."@en.
<http://purl.org/dc/terms/identifier> rdfs:type rdfs:Property.
<http://purl.org/dc/terms/references> rdfs:type rdfs:Property.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/valid> rdfs:type rdfs:Property.
<http://purl.org/ontology/bibo/Document> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "A Document"@en;
                                         rdfs:label "Document"@en;
                                         rdfs:seeAlso <http://xmlns.com/foaf/0.1/primaryTopicOf>,
                                                      <http://purl.org/dc/terms/title>,
                                                      <http://purl.org/dc/terms/description>,
                                                      <http://xmlns.com/foaf/0.1/page>;
                                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/Document>;
                                         <http://www.w3.org/2008/05/skos#scopeNote> "Messages can be added with dct:description."@en,
                                                                                    "A link to a document about the document can be added with foaf:page and with foaf:primaryTopicOf."@en,
                                                                                    "A name or title can be expressed with dct:title"@en.
daia: <http://purl.org/dc/terms/description> "The Document Availability Information Ontology (DAIA) describes the current availability of documents in libraries and similar institutions. Availability can be expressed in terms of specific services."@en;
      <http://purl.org/dc/terms/title> "Document Availability Information Ontology (DAIA)";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      <http://www.w3.org/2002/07/owl#versionInfo> "Beta version 2011-12-15".
daia:Limitation a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Limitation is something that limits the the availability of an Item."@en;
                rdfs:label "Limitation"@en;
                rdfs:seeAlso <http://purl.org/dc/terms/description>,
                             <http://xmlns.com/foaf/0.1/primaryTopicOf>,
                             <http://xmlns.com/foaf/0.1/page>,
                             <http://purl.org/dc/terms/title>;
                <http://www.w3.org/2008/05/skos#scopeNote> "A link to a page with more information can be added with foaf:page and with foaf:primaryTopicOf"@en,
                                                           "A description of the limitation can be added with dct:description."@en.
daia:Response a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Respone contains information about document availability for a specific time and institution."@en;
              rdfs:label "Response"@en;
              rdfs:seeAlso <http://purl.org/dc/terms/description>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable";
              <http://www.w3.org/2008/05/skos#scopeNote> "rdfs:seeAlso is used to link to documents and institutions."@en,
                                                         "Messages can be added with dct:description."@en.
daia:Service a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Service is something that is provided by an Institution, typically related to an Item, for instance the service of loaning the Item."@en;
             rdfs:label "Service"@en;
             rdfs:seeAlso <http://purl.org/dc/terms/description>,
                          <http://purl.org/dc/terms/coverage>;
             rdfs:subClassOf <http://purl.org/dc/dcmitype/Service>;
             <http://www.w3.org/2008/05/skos#scopeNote> "Messages can be added with dct:description."@en,
                                                        "Do not mix types of services (like 'loaning'), which are subclasses of Service, and specific instances of services (like loaning a particular book)!"@en,
                                                        "The property dct:coverage may be used to refer to a scope of this service - but this is outside of the core purpose of DAIA"@en.
<http://purl.org/ontology/daia/Service/Interloan> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:comment "Use mediated by another institution."@en;
                                                  rdfs:label "interloan service"@en;
                                                  rdfs:subClassOf daia:Service.
<http://purl.org/ontology/daia/Service/Loan> a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "Use outside of the holding institution (by lending or online access)"@en;
                                             rdfs:label "loan service"@en;
                                             rdfs:subClassOf daia:Service.
<http://purl.org/ontology/daia/Service/Openaccess> a <http://www.w3.org/2002/07/owl#Class>;
                                                   rdfs:comment "can be accessed freely on the Web"@en;
                                                   rdfs:label "open access service"@en;
                                                   rdfs:subClassOf daia:Service;
                                                   <http://www.w3.org/2008/05/skos#scopeNote> "this does not imply free reuse, for instance distribution and and modification. A specific license should be used for details."@en.
<http://purl.org/ontology/daia/Service/Presentation> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "Use within the holding institution (in their rooms, in their intranet etc.)"@en;
                                                     rdfs:label "presentation service"@en;
                                                     rdfs:subClassOf daia:Service.
daia:Storage a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A place where instances of frbr:Item are stored."@en;
             rdfs:label "Storage"@en;
             rdfs:seeAlso <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
                          <http://xmlns.com/foaf/0.1/page>,
                          <http://xmlns.com/foaf/0.1/primaryTopicOf>,
                          <http://purl.org/dc/terms/title>,
                          <http://xmlns.com/foaf/0.1/name>;
             rdfs:subClassOf <http://www.w3.org/ns/org#Site>,
                             <http://purl.org/dc/terms/Location>;
             <http://www.w3.org/2008/05/skos#ScopeNote> "Most instances of this class are also dct:Location and geo:SpatialThing";
             <http://www.w3.org/2008/05/skos#scopeNote> "The name or title of this location can be expressed with foaf:name and dct:title"@en,
                                                        "A link to a page with more information about the storage can be added with foaf:page and foaf:primaryTopicOf. However there should be another property to express a link to a specific item at a specific storage."@en,
                                                        "Physical items can be related to storages with geo:location. Most non-physical items have no locations but access services."@en.
daia:availableFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relates an Item to a Service which the Item is available for. This property is disjoint with the unavailable property; however an Item can be available and unavailable for two different Services of the same class at the same time."@en;
                  rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
                  rdfs:label "available for"@en;
                  rdfs:range daia:Service;
                  <http://www.w3.org/2002/07/owl#propertyDisjointWith> daia:unavailableFor.
daia:availableOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates an available Service to the Item which this Service refers to"@en;
                 rdfs:domain daia:Service;
                 rdfs:label "available of"@en;
                 rdfs:range <http://purl.org/vocab/frbr/core#Item>;
                 <http://www.w3.org/2002/07/owl#inverseOf> daia:availableFor.
daia:broaderExemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relates a Document to an Item that contains an exemplar of the Document as part."@en,
                                  "Relates an Item to a Document which is partly exemplified by the Item."@en;
                     rdfs:domain <http://purl.org/ontology/bibo/Document>,
                                 <http://purl.org/vocab/frbr/core#Item>;
                     rdfs:label "broader exemplar of"@en,
                                "broader exemplar"@en;
                     rdfs:range <http://purl.org/ontology/bibo/Document>,
                                <http://purl.org/vocab/frbr/core#Item>;
                     rdfs:seeAlso <http://purl.org/dc/terms/hasPart>,
                                  daia:broaderExemplarOf,
                                  daia:broaderExemplar,
                                  daia:exemplar,
                                  daia:exemplarOf;
                     <http://www.w3.org/2002/07/owl#inverseOf> daia:broaderExemplar,
                                                               daia:broaderExemplarOf;
                     <http://www.w3.org/2008/05/skos#scopeNote> "{ ?i daia:broaderExemplarOf ?d } => { ?i dct:hasPart [ daia:exemplarOf ?d ] }",
                                                                "{ ?d daia:broaderExemplar ?i } => { ?i dct:hasPart [ daia:exemplarOf ?d ] }".
daia:collectedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates a Document to an Institution which helds an iten of the Document."@en;
                 rdfs:domain <http://purl.org/ontology/bibo/Document>;
                 rdfs:label "collected by"@en;
                 rdfs:range <http://xmlns.com/foaf/0.1/Organization>;
                 rdfs:seeAlso <http://purl.org/dc/dcmitype/Collection>;
                 <http://www.w3.org/2002/07/owl#inverseOf> daia:inCollection;
                 <http://www.w3.org/2008/05/skos#scopeNote> "This property implies the existence of a dcmitype:Collection and a cdtype:CatalogueOrIndex that need not to be modeled explicitly."@en.
daia:delay a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "A time period of estimated delay untill an available Service can be used. Applications should normalize all literal values not conforming to xsd:duration to 'unknown'"@en;
           rdfs:domain daia:Service;
           rdfs:label "delay"@en.
daia:exemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates a Document to an Item that is an exemplar of the Document. This property is similar to frbr:exemplar but does not refer to the class frbr:Manifestation."@en;
              rdfs:domain <http://purl.org/ontology/bibo/Document>;
              rdfs:label "has exemplar"@en;
              rdfs:range <http://purl.org/vocab/frbr/core#Item>;
              rdfs:seeAlso daia:broaderExemplar,
                           <http://purl.org/vocab/frbr/core#exemplarOf>,
                           daia:narrowerExemplar,
                           <http://purl.org/vocab/frbr/core#embodimentOf>;
              <http://www.w3.org/2002/07/owl#inverseOf> daia:exemplarOf.
daia:exemplarOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates an Item to the Document that is exemplified by the Item."@en;
                rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
                rdfs:label "is examplar of"@en;
                rdfs:range <http://purl.org/ontology/bibo/Document>;
                rdfs:seeAlso <http://purl.org/vocab/frbr/core#embodiment>,
                             daia:broaderExemplarOf,
                             <http://purl.org/vocab/frbr/core#exemplar>,
                             daia:narrowerExemplarOf;
                <http://www.w3.org/2002/07/owl#inverseOf> daia:exemplar.
daia:expected a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "If this property is given on an unavailable Service, it is assumed that the Service will be available at the specified time. Applications should normalize all literal values not conforming to xsd:date or xsd:dateTime to 'unknown'"@en;
              rdfs:domain daia:Service;
              rdfs:label "expected"@en;
              rdfs:seeAlso <http://purl.org/dc/terms/available>.
daia:heldBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relates an Item to an Institution that holds the Item."@en;
            rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
            rdfs:label "held by"@en;
            rdfs:range <http://xmlns.com/foaf/0.1/Organization>;
            rdfs:subPropertyOf daia:collectedBy;
            <http://www.w3.org/2002/07/owl#inverseOf> daia:holds.
daia:holds a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Relates an Institution to an Item which the Institution holds."@en;
           rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
           rdfs:label "holds"@en;
           rdfs:range <http://purl.org/vocab/frbr/core#Item>;
           rdfs:subPropertyOf daia:inCollection;
           <http://www.w3.org/2002/07/owl#inverseOf> daia:heldBy.
daia:inCollection a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relates an Institution to a Document which the Institution helds an item of."@en;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
                  rdfs:label "in collection"@en;
                  rdfs:range <http://purl.org/ontology/bibo/Document>;
                  rdfs:seeAlso <http://purl.org/dc/dcmitype/Collection>;
                  <http://www.w3.org/2002/07/owl#inverseOf> daia:collectedBy;
                  <http://www.w3.org/2008/05/skos#scopeNote> "This property implies the existence of a dcmitype:Collection and a cdtype:CatalogueOrIndex that need not to be modeled explicitly."@en.
daia:label a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "A call number, shelf mark or similar label of an item"@en;
           rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
           rdfs:label "label"@en;
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
daia:limitedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relates an Service to a Limitation."@en;
               rdfs:domain daia:Service;
               rdfs:label "limited by"@en;
               rdfs:range daia:Limitation;
               rdfs:seeAlso <http://purl.org/dc/terms/coverage>;
               <http://www.w3.org/2002/07/owl#inverseOf> daia:limits.
daia:limits a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relates a Limitation to a Service."@en;
            rdfs:domain daia:Limitation;
            rdfs:label "limits"@en;
            rdfs:range daia:Service.
daia:narrowerExemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relates an Item to a Document which is partly exemplified by the Item."@en,
                                   "Relates a Document to an Item that is an exemplar of a part of the Document."@en;
                      rdfs:domain <http://purl.org/vocab/frbr/core#Item>,
                                  <http://purl.org/ontology/bibo/Document>;
                      rdfs:label "narrower exemplar"@en,
                                 "narrower exemplar of"@en;
                      rdfs:range <http://purl.org/vocab/frbr/core#Item>,
                                 <http://purl.org/ontology/bibo/Document>;
                      rdfs:seeAlso daia:exemplarOf,
                                   <http://purl.org/dc/terms/hasPart>,
                                   daia:exemplar,
                                   daia:broaderExemplarOf,
                                   daia:broaderExemplar;
                      <http://www.w3.org/2002/07/owl#inverseOf> daia:narrowerExemplarOf,
                                                                daia:narrowerExemplar;
                      <http://www.w3.org/2008/05/skos#scopeNote> "{ ?i daia:narrowerExemplarOf ?d } => { ?i daia:exemplarOf [ dct:isPartOf ?d ] }",
                                                                 "{ ?d daia:narrowerExemplar ?i } => { ?d dct:hasPart [ daia:exemplar ?i ] }".
daia:perform a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "A link to perform, register or reserve a Service."@en;
             rdfs:domain daia:Service;
             rdfs:label "perform"@en;
             rdfs:range xsd:anyURI.
daia:providedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates a Service to an Institution that provides the Service."@en;
                rdfs:domain daia:Service;
                rdfs:label "provided by"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Organization>;
                <http://www.w3.org/2002/07/owl#inverseOf> daia:provides.
daia:provides a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates an Institution to a Service that is provided by the Institution."@en;
              rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
              rdfs:label "provides"@en;
              rdfs:range daia:Service;
              <http://www.w3.org/2002/07/owl#inverseOf> daia:providedBy.
daia:queue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The number number of waiting requests for this service. If this property is not given, the value zero may be assumed but applications may also distinguish zero and no value."@en;
           rdfs:domain daia:Service;
           rdfs:label "queue"@en;
           rdfs:range xsd:nonNegativeInteger.
daia:timestamp a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Date and time of a the validity of a Response"@en;
               rdfs:domain daia:Response;
               rdfs:label "timestamp"@en;
               rdfs:range xsd:dateTime;
               rdfs:seeAlso <http://purl.org/dc/terms/available>;
               rdfs:subPropertyOf <http://purl.org/dc/terms/valid>.
daia:unavailableFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates an Item to a Service which the Item is not available for. This property is disjoint with the available property; however an Item can be available and unavailable for two different Services of the same class at the same time."@en;
                    rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
                    rdfs:label "not available for"@en;
                    rdfs:range daia:Service.
daia:unavailableOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates a unavailable Service to the Item which this Service refers to"@en;
                   rdfs:domain daia:Service;
                   rdfs:label "available of"@en;
                   rdfs:range <http://purl.org/vocab/frbr/core#Item>;
                   <http://www.w3.org/2002/07/owl#inverseOf> daia:availableFor.
<http://purl.org/vocab/frbr/core#Item> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "Every Item is also a document (frbr:Item rdfs:subClassOf bibo:Document."@en,
                                                    "An Item is a single instance of a Document. Availability information is directly connected to single items."@en;
                                       rdfs:seeAlso <http://purl.org/dc/terms/description>;
                                       rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>,
                                                       <http://purl.org/ontology/bibo/Document>;
                                       <http://www.w3.org/2008/05/skos#scopeNote> "Messages can be added with dct:description."@en.
xsd:date a rdfs:Datatype.
xsd:dateTime a rdfs:Datatype.
xsd:duration a rdfs:Datatype.
xsd:nonNegativeInteger a rdfs:Datatype.
<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2003/01/geo/wgs84_pos#location> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:comment "The relation between something and the point, or other geometrical thing in space, where it is."@en;
                                                   rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
<http://www.w3.org/2003/06/sw-vocab-status/ns#moreinfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2008/05/skos#changeNote> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2008/05/skos#editorialNote> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2008/05/skos#historyNote> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2008/05/skos#scopeNote> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/ns/org#Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                        <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/Organization>.
<http://xmlns.com/foaf/0.1/Document> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/Organization> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "Used for any kind of organization such as a library or a company, both Institution and Department."@en;
                                         rdfs:seeAlso <http://xmlns.com/foaf/0.1/primaryTopicOf>,
                                                      <http://xmlns.com/foaf/0.1/page>,
                                                      <http://purl.org/dc/terms/title>;
                                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.w3.org/ns/org#Organization>;
                                         <http://www.w3.org/2008/05/skos#scopeNote> "A link to a page with more information can be added with foaf:page and with foaf:primaryTopicOf."@en,
                                                                                    "A name or title can be expressed with dct:title"@en.
<http://xmlns.com/foaf/0.1/page> a rdfs:Property.
<http://xmlns.com/foaf/0.1/primaryTopicOf> a rdfs:Property.
