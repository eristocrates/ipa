<http://eulersharp.sourceforge.net/2003/03swap/bioSKOSSchemes> dce:creator "Hans Cools, MD; Agfa Healthcare/Belgium"@en;
                                                               dce:description "Formal description of SKOS Schemes of biological terminologies/coding systems and their datatypes."@en;
                                                               dce:format "OWL Full"@en;
                                                               dce:publisher "Agfa Healthcare/Belgium"@en;
                                                               dce:title "Biological SKOS Schemes"@en;
                                                               a owl:Ontology;
                                                               rdfs:comment "SKOS: Simple Knowledge Organization System."@en.
bisko:uniProtTaxonomy a skos:ConceptScheme;
                      rdfs:comment "Taxonomy in UniProt (universal protein resource) of a consortium comprising the European Bioinformatics Institute (EBI), the Swiss Institute of Bioinformatics (SIB), and the Protein Information Resource (PIR). Formerly known as 'New EBI Web Taxonomy (NEWT)'."@en;
                      rdfs:isDefinedBy bisko:;
                      rdfs:label "UniProt taxonomy"@en.
bisko:uniProtTaxonomyDT a rdfs:Datatype;
                        rdfs:isDefinedBy bisko:;
                        rdfs:label "UniProt taxonomy datatype"@en.
