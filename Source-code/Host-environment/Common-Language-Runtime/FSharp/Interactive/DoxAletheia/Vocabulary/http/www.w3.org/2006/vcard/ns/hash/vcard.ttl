@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix vcard2006: <http://www.w3.org/2006/vcard/ns#>.

<http://www.w3.org/2006/vcard/ns> a owl:Ontology;
                                  rdfs:comment "Ontology for vCard based on RFC6350"@en;
                                  rdfs:label "Ontology for vCard"@en;
                                  owl:versionInfo "Final"@en.
vcard2006:Acquaintance a owl:Class;
                       rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                       rdfs:label "Acquaintance"@en;
                       rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Address a owl:Class;
                  rdfs:comment "To specify the components of the delivery address for the  object"@en;
                  rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                  rdfs:label "Address"@en;
                  owl:equivalentClass [owl:unionOf ([owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                        owl:onProperty vcard2006:country-name ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty vcard2006:country-name ; 
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class]
                                                    [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                        owl:onProperty vcard2006:locality ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty vcard2006:locality ; 
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class]
                                                    [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                        owl:onProperty vcard2006:postal-code ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty vcard2006:postal-code ; 
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class]
                                                    [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                        owl:onProperty vcard2006:region ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty vcard2006:region ; 
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class]
                                                    [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                        owl:onProperty vcard2006:street-address ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty vcard2006:street-address ; 
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class]) ; 
                                       a owl:Class].
vcard2006:Agent a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Agent"@en;
                rdfs:subClassOf vcard2006:RelatedType.
vcard2006:BBS a owl:Class;
              rdfs:comment "This class is deprecated"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "BBS"@en;
              rdfs:subClassOf vcard2006:TelephoneType;
              owl:deprecated true.
vcard2006:Car a owl:Class;
              rdfs:comment "This class is deprecated"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Car"@en;
              rdfs:subClassOf vcard2006:TelephoneType;
              owl:deprecated true.
vcard2006:Cell a owl:Class;
               rdfs:comment "Also called mobile telephone"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Cell"@en;
               rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Child a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Child"@en;
                rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Colleague a owl:Class;
                    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                    rdfs:label "Colleague"@en;
                    rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Contact a owl:Class;
                  rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                  rdfs:label "Contact"@en;
                  rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Coresident a owl:Class;
                     rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                     rdfs:label "Coresident"@en;
                     rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Coworker a owl:Class;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "Coworker"@en;
                   rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Crush a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Crush"@en;
                rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Date a owl:Class;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Date"@en;
               rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Dom a owl:Class;
              rdfs:comment "This class is deprecated"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Dom"@en;
              rdfs:subClassOf vcard2006:Type;
              owl:deprecated true.
vcard2006:Email a owl:Class;
                rdfs:comment "To specify the electronic mail address for communication with the object the vCard represents. Use the hasEmail object property."@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Email"@en;
                owl:deprecated true.
vcard2006:Emergency a owl:Class;
                    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                    rdfs:label "Emergency"@en;
                    rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Fax a owl:Class;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Fax"@en;
              rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Female a owl:Class;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Female"@en;
                 rdfs:subClassOf vcard2006:Gender.
vcard2006:Friend a owl:Class;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Friend"@en;
                 rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Gender a owl:Class;
                 rdfs:comment "Used for gender codes. The URI of the gender code must be used as the value for Gender."@en;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Gender"@en.
vcard2006:Group a owl:Class;
                rdfs:comment "Object representing a group of persons or entities.  A group object will usually contain hasMember properties to specify the members of the group."@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Group"@en;
                rdfs:subClassOf vcard2006:Kind;
                owl:disjointWith vcard2006:Organization,
                                 vcard2006:Location,
                                 vcard2006:Individual;
                owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom vcard2006:Kind ; 
                                                         owl:onProperty vcard2006:hasMember ; 
                                                         a owl:Restriction]
                                                         [owl:onProperty vcard2006:hasMember ; 
                                                         owl:onClass vcard2006:Kind ; 
                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class].
vcard2006:Home a owl:Class;
               rdfs:comment "This implies that the property is related to an individual's personal life"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Home"@en;
               rdfs:subClassOf vcard2006:Type.
vcard2006:ISDN a owl:Class;
               rdfs:comment "This class is deprecated"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "ISDN"@en;
               rdfs:subClassOf vcard2006:Type;
               owl:deprecated true.
vcard2006:Individual a owl:Class;
                     rdfs:comment "An object representing a single person or entity"@en;
                     rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                     rdfs:label "Individual"@en;
                     rdfs:subClassOf vcard2006:Kind;
                     owl:disjointWith vcard2006:Organization,
                                      vcard2006:Location.
vcard2006:Internet a owl:Class;
                   rdfs:comment "This class is deprecated"@en;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "Internet"@en;
                   rdfs:subClassOf vcard2006:Type;
                   owl:deprecated true.
vcard2006:Intl a owl:Class;
               rdfs:comment "This class is deprecated"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Intl"@en;
               rdfs:subClassOf vcard2006:Type;
               owl:deprecated true.
vcard2006:Kin a owl:Class;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Kin"@en;
              rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Kind a owl:Class;
               rdfs:comment "The parent class for all objects"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Kind"@en;
               owl:equivalentClass vcard2006:VCard,
                                   [owl:onProperty vcard2006:fn ; 
                                    owl:onDataRange xsd:string ; 
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction].
vcard2006:Label a owl:Class;
                rdfs:comment "This class is deprecated"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Label"@en;
                rdfs:subClassOf vcard2006:Type;
                owl:deprecated true.
vcard2006:Location a owl:Class;
                   rdfs:comment "An object representing a named geographical place"@en;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "Location"@en;
                   rdfs:subClassOf vcard2006:Kind;
                   owl:disjointWith vcard2006:Organization.
vcard2006:Male a owl:Class;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Male"@en;
               rdfs:subClassOf vcard2006:Gender.
vcard2006:Me a owl:Class;
             rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
             rdfs:label "Me"@en;
             rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Met a owl:Class;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Met"@en;
              rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Modem a owl:Class;
                rdfs:comment "This class is deprecated"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Modem"@en;
                rdfs:subClassOf vcard2006:TelephoneType;
                owl:deprecated true.
vcard2006:Msg a owl:Class;
              rdfs:comment "This class is deprecated"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Msg"@en;
              rdfs:subClassOf vcard2006:TelephoneType;
              owl:deprecated true.
vcard2006:Muse a owl:Class;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Muse"@en;
               rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Name a owl:Class;
               rdfs:comment "To specify the components of the name of the object"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Name"@en;
               owl:equivalentClass [owl:unionOf ([owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                     owl:onProperty vcard2006:additional-name ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty vcard2006:additional-name ; 
                                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class]
                                                 [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                     owl:onProperty vcard2006:family-name ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty vcard2006:family-name ; 
                                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class]
                                                 [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                     owl:onProperty vcard2006:given-name ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty vcard2006:given-name ; 
                                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class]
                                                 [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                     owl:onProperty vcard2006:honorific-prefix ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty vcard2006:honorific-prefix ; 
                                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class]
                                                 [owl:intersectionOf ([owl:someValuesFrom xsd:string ; 
                                                                     owl:onProperty vcard2006:honorific-suffix ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty vcard2006:honorific-suffix ; 
                                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class]) ; 
                                    a owl:Class].
vcard2006:Neighbor a owl:Class;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "Neighbor"@en;
                   rdfs:subClassOf vcard2006:RelatedType.
vcard2006:None a owl:Class;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "None"@en;
               rdfs:subClassOf vcard2006:Gender.
vcard2006:Organization a owl:Class;
                       rdfs:comment """An object representing an organization.  An organization is a single entity, and might represent a business or government, a department or division within a business or government, a club, an association, or the like.
"""@en;
                       rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                       rdfs:label "Organization"@en;
                       rdfs:subClassOf vcard2006:Kind.
vcard2006:Other a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Other"@en;
                rdfs:subClassOf vcard2006:Gender.
vcard2006:PCS a owl:Class;
              rdfs:comment "This class is deprecated"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "PCS"@en;
              rdfs:subClassOf vcard2006:TelephoneType;
              owl:deprecated true.
vcard2006:Pager a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Pager"@en;
                rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Parcel a owl:Class;
                 rdfs:comment "This class is deprecated"@en;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Parcel"@en;
                 rdfs:subClassOf vcard2006:Type;
                 owl:deprecated true.
vcard2006:Parent a owl:Class;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Parent"@en;
                 rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Postal a owl:Class;
                 rdfs:comment "This class is deprecated"@en;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Postal"@en;
                 rdfs:subClassOf vcard2006:Type;
                 owl:deprecated true.
vcard2006:Pref a owl:Class;
               rdfs:comment "This class is deprecated"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Pref"@en;
               rdfs:subClassOf vcard2006:Type;
               owl:deprecated true.
vcard2006:RelatedType a owl:Class;
                      rdfs:comment "Used for relation type codes. The URI of the relation type code must be used as the value for the Relation Type."@en;
                      rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                      rdfs:label "Relation Type"@en.
vcard2006:Sibling a owl:Class;
                  rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                  rdfs:label "Sibling"@en;
                  rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Spouse a owl:Class;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "Spouse"@en;
                 rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Sweetheart a owl:Class;
                     rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                     rdfs:label "Sweetheart"@en;
                     rdfs:subClassOf vcard2006:RelatedType.
vcard2006:Tel a owl:Class;
              rdfs:comment "This class is deprecated. Use the hasTelephone object property."@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "Tel"@en;
              owl:deprecated true.
vcard2006:TelephoneType a owl:Class;
                        rdfs:comment "Used for telephone type codes. The URI of the telephone type code must be used as the value for the Telephone Type."@en;
                        rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                        rdfs:label "Phone"@en.
vcard2006:Text a owl:Class;
               rdfs:comment "Also called sms telephone"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Text"@en;
               rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:TextPhone a owl:Class;
                    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                    rdfs:label "Text phone"@en;
                    rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Type a owl:Class;
               rdfs:comment "Used for type codes. The URI of the type code must be used as the value for Type."@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Type"@en.
vcard2006:Unknown a owl:Class;
                  rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                  rdfs:label "Unknown"@en;
                  rdfs:subClassOf vcard2006:Gender.
vcard2006:VCard a owl:Class;
                rdfs:comment "The vCard class is  equivalent to the new Kind class, which is the parent for the four explicit types of vCards (Individual, Organization, Location, Group)"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "VCard"@en;
                owl:equivalentClass vcard2006:Kind.
vcard2006:Video a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Video"@en;
                rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Voice a owl:Class;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "Voice"@en;
                rdfs:subClassOf vcard2006:TelephoneType.
vcard2006:Work a owl:Class;
               rdfs:comment "This implies that the property is related to an individual's work place"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "Work"@en;
               rdfs:subClassOf vcard2006:Type.
vcard2006:X400 a owl:Class;
               rdfs:comment "This class is deprecated"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "X400"@en;
               rdfs:subClassOf vcard2006:Type;
               owl:deprecated true.
vcard2006:additional-name a owl:DatatypeProperty;
                          rdfs:comment "The additional name associated with the object"@en;
                          rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                          rdfs:label "additional name"@en;
                          rdfs:range xsd:string.
vcard2006:adr a owl:ObjectProperty;
              rdfs:comment "This object property has been mapped"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "address"@en;
              owl:equivalentProperty vcard2006:hasAddress.
vcard2006:agent a owl:ObjectProperty;
                rdfs:comment "This object property has been deprecated"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "agent"@en;
                owl:deprecated true.
vcard2006:anniversary a owl:DatatypeProperty;
                      rdfs:comment "The date of marriage, or equivalent, of the object"@en;
                      rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                      rdfs:label "anniversary"@en;
                      rdfs:range [owl:unionOf (xsd:dateTime
                                               xsd:gYear) ; 
                                  a rdfs:Datatype].
vcard2006:bday a owl:DatatypeProperty;
               rdfs:comment "To specify the birth date of the object"@en;
               rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
               rdfs:label "birth date"@en;
               rdfs:range [owl:unionOf (xsd:dateTime
                                        xsd:dateTimeStamp
                                        xsd:gYear) ; 
                           a rdfs:Datatype].
vcard2006:category a owl:DatatypeProperty;
                   rdfs:comment "The category information about the object, also known as tags"@en;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "category"@en;
                   rdfs:range xsd:string.
vcard2006:class a owl:DatatypeProperty;
                rdfs:comment "This data property has been deprecated"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "class"@en;
                owl:deprecated true.
vcard2006:country-name a owl:DatatypeProperty;
                       rdfs:comment "The country name associated with the address of the object"@en;
                       rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                       rdfs:label "country name"@en;
                       rdfs:range xsd:string.
vcard2006:email a owl:ObjectProperty;
                rdfs:comment "This object property has been mapped"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "email"@en;
                owl:equivalentProperty vcard2006:hasEmail.
vcard2006:extended-address a owl:DatatypeProperty;
                           rdfs:comment "This data property has been deprecated"@en;
                           rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                           rdfs:label "extended address"@en;
                           owl:deprecated true.
vcard2006:family-name a owl:DatatypeProperty;
                      rdfs:comment "The family name associated with the object"@en;
                      rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                      rdfs:label "family name"@en;
                      rdfs:range xsd:string.
vcard2006:fn a owl:DatatypeProperty;
             rdfs:comment "The formatted text corresponding to the name of the object"@en;
             rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
             rdfs:label "formatted name"@en;
             rdfs:range xsd:string.
vcard2006:geo a owl:ObjectProperty;
              rdfs:comment "This object property has been mapped"@en;
              rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
              rdfs:label "geo"@en;
              owl:equivalentProperty vcard2006:hasGeo.
vcard2006:given-name a owl:DatatypeProperty;
                     rdfs:comment "The given name associated with the object"@en;
                     rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                     rdfs:label "given name"@en;
                     rdfs:range xsd:string.
vcard2006:hasAdditionalName a owl:ObjectProperty;
                            rdfs:comment "Used to support property parameters for the additional name data property"@en;
                            rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                            rdfs:label "has additional name"@en.
vcard2006:hasAddress a owl:ObjectProperty;
                     rdfs:comment "To specify the components of the delivery address for the object"@en;
                     rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                     rdfs:label "has address"@en;
                     rdfs:range vcard2006:Address.
vcard2006:hasCalendarBusy a owl:ObjectProperty;
                          rdfs:comment "To specify the busy time associated with the object. (Was called FBURL in RFC6350)"@en;
                          rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                          rdfs:label "has calendar busy"@en.
vcard2006:hasCalendarLink a owl:ObjectProperty;
                          rdfs:comment "To specify the calendar associated with the object. (Was called CALURI in RFC6350)"@en;
                          rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                          rdfs:label "has calendar link"@en.
vcard2006:hasCalendarRequest a owl:ObjectProperty;
                             rdfs:comment "To specify the calendar user address to which a scheduling request be sent for the object. (Was called CALADRURI in RFC6350)"@en;
                             rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                             rdfs:label "has calendar request"@en.
vcard2006:hasCategory a owl:ObjectProperty;
                      rdfs:comment "Used to support property parameters for the category data property"@en;
                      rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                      rdfs:label "has category"@en.
vcard2006:hasCountryName a owl:ObjectProperty;
                         rdfs:comment "Used to support property parameters for the country name data property"@en;
                         rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                         rdfs:label "has country name"@en.
vcard2006:hasEmail a owl:ObjectProperty;
                   rdfs:comment "To specify the electronic mail address for communication with the object"@en;
                   rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                   rdfs:label "has email"@en;
                   rdfs:range vcard2006:Email.
vcard2006:hasFN a owl:ObjectProperty;
                rdfs:comment "Used to support property parameters for the formatted name data property"@en;
                rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                rdfs:label "has formatted name"@en.
vcard2006:hasFamilyName a owl:ObjectProperty;
                        rdfs:comment "Used to support property parameters for the family name data property"@en;
                        rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                        rdfs:label "has family name"@en.
vcard2006:hasGender a owl:ObjectProperty;
                    rdfs:comment "To specify  the sex or gender identity of the object. URIs are recommended to enable interoperable sex and gender codes to be used."@en;
                    rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                    rdfs:label "has gender"@en.
vcard2006:hasGeo a owl:ObjectProperty;
                 rdfs:comment "To specify information related to the global positioning of the object. May also be used as a property parameter."@en;
                 rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
                 rdfs:label "has geo"@en.
vcard2006:hasGivenName a owl:ObjectProperty;
                       rdfs:comment "Used to support property parameters for the given name data property"@en;
                       rdfs:isDefinedBy <http://www.w3.org/2006/vcard/ns>;
