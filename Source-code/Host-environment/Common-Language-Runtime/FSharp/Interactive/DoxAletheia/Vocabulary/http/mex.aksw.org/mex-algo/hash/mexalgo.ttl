mexalgo:Supervised a owl:Class,
                     mexalgo:NamedIndividual;
                   rdfs:comment "Supervised learning assumes that trainning examples are classified (labeled by class labels)"@en;
                   rdfs:subClassOf mexalgo:LearningMethod.
mexalgo:SupervisedApproach a owl:Class;
                           owl:equivalentClass [owl:intersectionOf (mexalgo:Algorithm
                                                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                    owl:onProperty mexalgo:hasLearningMethod ; 
                                                                    owl:onClass mexalgo:Supervised ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class],
                                               [owl:intersectionOf (mexalgo:Algorithm
                                                                    [owl:unionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                 owl:onProperty mexalgo:hasLearningProblem ; 
                                                                                 owl:onClass mexalgo:Classification ; 
                                                                                 a owl:Restriction]
                                                                                 [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                 owl:onProperty mexalgo:hasLearningProblem ; 
                                                                                 owl:onClass mexalgo:Regression ; 
                                                                                 a owl:Restriction]) ; 
                                                                    a owl:Class]) ; 
                                                a owl:Class].
mexalgo:SupportVectorMachines a owl:Class,
                                mexalgo:NamedIndividual;
                              rdfs:comment """In machine learning, support vector machines (SVMs, also support vector networks) are supervised learning models with associated learning algorithms that analyze data and recognize patterns, used for classification and regression analysis. Given a set of training examples, each marked as belonging to one of two categories, an SVM training algorithm builds a model that assigns new examples into one category or the other, making it a non-probabilistic binary linear classifier. An SVM model is a representation of the examples as points in space, mapped so that the examples of the separate categories are divided by a clear gap that is as wide as possible. New examples are then mapped into that same space and predicted to belong to a category based on which side of the gap they fall on.

In addition to performing linear classification, SVMs can efficiently perform a non-linear classification using what is called the kernel trick, implicitly mapping their inputs into high-dimensional feature spaces."""@en;
                              rdfs:label "SVM"@en;
                              rdfs:subClassOf [owl:unionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty mexalgo:hasLearningProblem ; 
                                                            owl:onClass mexalgo:Classification ; 
                                                            a owl:Restriction]
                                                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty mexalgo:hasLearningProblem ; 
                                                            owl:onClass mexalgo:Regression ; 
                                                            a owl:Restriction]) ; 
                                               a owl:Class],
                                              [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty mexalgo:hasClass ; 
                                               owl:onClass mexalgo:SupportVectorNetworks ; 
                                               a owl:Restriction],
                                              [owl:unionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty mexalgo:hasLearningMethod ; 
                                                            owl:onClass mexalgo:SemiSupervised ; 
                                                            a owl:Restriction]
                                                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty mexalgo:hasLearningMethod ; 
                                                            owl:onClass mexalgo:Supervised ; 
                                                            a owl:Restriction]) ; 
                                               a owl:Class],
                                              mexalgo:NamedAlgorithm.
mexalgo:SupportVectorNetworks a owl:Class,
                                mexalgo:NamedIndividual;
                              rdfs:subClassOf mexalgo:AlgorithmClass.
