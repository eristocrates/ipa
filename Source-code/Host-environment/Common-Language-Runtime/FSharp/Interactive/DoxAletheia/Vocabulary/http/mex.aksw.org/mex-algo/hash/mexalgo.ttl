<http://mex.aksw.org/mex-algo> dc11:contributor "Sebastian Hellmann",
                                                "Jens Lehmann",
                                                "Maria Claudia Cavalcanti Reis",
                                                "Julio Cesar Duarte",
                                                "Diego Moussallem",
                                                "Markus Ackermann",
                                                "Ricardo Usbeck";
                               dc11:creator "Diego Esteves";
                               dc11:publisher "AKSW Research Group - Leipzig University"@en,
                                              "AKSW - Universidade de Leipzig"@pt;
                               dcterms:created "2014-02-02"^^xsd:date;
                               dcterms:modified "2014-04-05"^^xsd:date;
                               dcterms:title "MEX Algorithm Ontology (mex-algo)"@en;
                               a owl:Ontology;
                               rdfs:comment "MEX e um vocabulario modelado para facilitar a interoperabilidade entre resultados de experimentos de aprendizado de maquinas publicados na Web. A camada mex-algo representa informacaos de algoritmos existentes em um experimento de aprendizado de maquina."@pt,
                                            "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-algo layer represents the algorithm information existing into a basic machine learning experiment."@en;
                               rdfs:label "Vocabulario MEX (mex-algo)"@pt,
                                          "The MEX Vocabulary (mex-algo)"@en;
                               owl:imports doap:,
                                           rdfs:,
                                           nsprov:;
                               owl:versionInfo "1.0.0".
mexalgo:ADTree a owl:Class;
               rdfs:subClassOf [owl:someValuesFrom mexalgo:DecisionTrees ; 
                                owl:onProperty mexalgo:hasClass ; 
                                a owl:Restriction],
                               mexalgo:NamedAlgorithm.
mexalgo:AODE a mexalgo:NamedIndividual.
mexalgo:AQ a owl:Class;
           rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
