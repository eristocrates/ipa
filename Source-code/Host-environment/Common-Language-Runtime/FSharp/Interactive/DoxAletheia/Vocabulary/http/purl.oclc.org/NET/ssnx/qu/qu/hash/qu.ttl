@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix qu: <http://purl.oclc.org/NET/ssnx/qu/qu#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

_:B40f1d7b716c85bf866b9631cdda05bd4 a owl:AllDisjointClasses;
                                    owl:members (qu:QuantityKind
                                                 qu:QuantityKindFactor
                                                 qu:Scale
                                                 qu:ScaleValueDefinition
                                                 qu:SystemOfQuantities
                                                 qu:SystemOfUnits
                                                 qu:Unit
                                                 qu:UnitFactor).
_:Bcf3fae3f5ef9fa7cb9ed1892c27dabec a owl:AllDisjointClasses;
                                    owl:members (qu:QuantityKind
                                                 qu:QuantityKindFactor
                                                 qu:Scale
                                                 qu:ScaleValueDefinition
                                                 qu:SystemOfQuantities
                                                 qu:SystemOfUnits
                                                 qu:Unit
                                                 qu:UnitFactor).
ccrel:license a owl:AnnotationProperty.
<http://purl.oclc.org/NET/ssnx/qu/qu> dc11:creator "Roger Burkhart (John Deere, USA and QUDV working group of the SysML 1.2 Revision Task Force (RTF))",
                                                   "Hans Peter de Koning (ESA, Netherlands and QUDV working group of the SysML 1.2 Revision Task Force (RTF))",
                                                   "Laurent Lefort (CSIRO, Australia and W3C Semantic Sensor Network Incubator Group)",
                                                   "Nicolas Rouquette (NASA-JPL, USA and QUDV working group of the SysML 1.2 Revision Task Force (RTF))",
                                                   "Huascar Espinoza (CEA, France and QUDV working group of the SysML 1.2 Revision Task Force (RTF))";
                                      dc11:identifier "http://purl.oclc.org/NET/ssnx/qu/qu";
                                      dc11:rights "qu.owl  Copyright 2010 - 2011 CSIRO",
                                                  "sysml-qudv:qudv_owl  Copyright 2009 - 2011 The QUDV authors";
                                      dc11:title "Library for Quantity Kinds and Units: schema, based on QUDV model OMG SysML(TM), Version 1.2";
                                      dcterms:created "2009-08-26";
                                      dcterms:modified "2011-06-20";
                                      a owl:Ontology;
                                      rdfs:comment "In order to generalize its potential usage and alignment with other standardization efforts concerning quantities and units, the QU  ontology has been further developed as a complement to the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG). The Agriculture Meteorology example also includes an application of the QU schema to the UN/CEFACT Recommendation 20 code list. For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/ .",
                                                   "The QUDV copyright holders have agreed for the QU ontology to be published by the W3C Semantic Sensor Incubator Group but this does not constitute an endorsement or recommendation by the QUDV working group of the SysML 1.2 Revision Task Force. All other rights reserved.",
                                                   "This Model Library for Quantities, Units, Dimensions and Values (QUDV)  (Note: in the ontology, the SYSML-QUDV definitions are flagged with a rdfs:seeAlso annotation equal to http://www.omgsysml.org/qudv).",
                                                   "",
                                                   """This ontology is partially based on the SysML QUDV (Quantities, Units, Dimensions and Values) proposed by a working group of the SysML 1.2 Revision Task Force (RTF), working in close coordination with the OMG MARTE specification group. This model library is specified in a UML/SysML class/block diagram in the OMG SysML, Version 1.2 specification (http://www.omg.org/spec/SysML/1.2/). This model is described in OMG  SysML, Version 1.2 Appendix C.4 Model Library for Quantity Kinds and Units (http://ontolog.cim3.net/file/resource/reference/UoM_Ontology_Standard/available-UoM-references/QUDV-Annex-C4-C5--OMG-SysML-v1-2_Oct-2009.pdf).		
	
The QUDV model has also been represented in the form of an ontology using a formal ontology definition language. The resulting OWL ontology, called the QUDV ontology http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:qudv_owl has been published by members of the QUDV working group of the SysML 1.2 Revision Task Force (RTF). 

		OMG SysML is a trademark of OMG (see http://www.omg.org/spec/SysML/1.2/PDF/ for the conditions of use of the  OMG  SysML, Version 1.2  specification).""",
                                                   "Please report any errors to the Semantic Sensor Network Incubator Activity via the public W3C list public-xg-ssn@w3.org or alternatively, for enquiries about the QUDV model,  to the QUDV mailing list: http://www.omg.org/publicarchives/qudv/";
                                      rdfs:seeAlso "http://www.w3.org/2005/Incubator/ssn/".
qu:ConversionBasedUnit dc11:source "skos:exactMatch 'ConversionBasedUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                       a owl:Class;
                       rdfs:comment """A ConversionBasedUnit is an abstract classifier that is a Unit that represents a measurement unit that is defined with respect to
another reference unit through an explicit conversion relationship.""";
                       rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                       rdfs:label "ConversionBasedUnit";
                       rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
                       rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onClass qu:Unit ; 
                                        owl:onProperty qu:referenceUnit ; 
                                        a owl:Restriction],
                                       qu:Unit,
                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onClass qu:Unit ; 
                                        owl:onProperty qu:referenceUnit ; 
                                        a owl:Restriction].
qu:DerivedQuantityKind dc11:source "skos:exactMatch 'DerivedQuantityKind ' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                       a owl:Class;
                       rdfs:comment """A DerivedQuantityKind is a QuantityKind that represents a kind of quantity that is defined as a product of powers of one or
more other kinds of quantity. A DerivedQuantityKind may also be used to define a synonym kind of quantity for another kind
of quantity.
For example \"velocity\" can be specified as the product of \"length\" to the power one times \"time\" to the power minus one, and
subsequently \"speed\" can be specified as \"velocity\" to the power one.""";
                       rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                       rdfs:label "DerivedQuantityKind";
                       rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                       rdfs:subClassOf [owl:someValuesFrom qu:QuantityKindFactor ; 
                                        owl:onProperty qu:quantityKindFactor ; 
                                        a owl:Restriction],
                                       qu:QuantityKind,
                                       [owl:someValuesFrom qu:QuantityKindFactor ; 
                                        owl:onProperty qu:quantityKindFactor ; 
                                        a owl:Restriction].
qu:DerivedUnit dc11:source "skos:exactMatch 'DerivedUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
               a owl:Class;
               rdfs:comment """A DerivedUnit is a Unit that represents a measurement unit that is defined as a product of powers of one or more other
measurement units.
For example the measurement unit \"metre per second\" for \"velocity\" is specified as the product of \"metre\" to the power one
times \"second\" to the power minus one""";
               rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
               rdfs:label "DerivedUnit";
               rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
               rdfs:subClassOf [owl:someValuesFrom qu:UnitFactor ; 
                                owl:onProperty qu:unitFactor ; 
                                a owl:Restriction],
                               qu:Unit,
                               [owl:someValuesFrom qu:UnitFactor ; 
                                owl:onProperty qu:unitFactor ; 
                                a owl:Restriction].
qu:Dimension dc11:source "skos:exactMatch 'Dimension' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
             a owl:Class;
             rdfs:comment """A Dimension represents the [VIM] concept of 'quantity dimension' that is defined as 'expression of the dependence of a quantity on the base quantities of a system of quantities as a product of powers of factors corresponding to the base quantities, omitting any numerical factor.'

For example in the ISQ the quantity dimension of 'force' is denoted by dim F = Lï¿½Mï¿½T^2, where 'F' is the symbol for 'force', and 'L', 'M', 'T' are the symbols for the ISQ base quantities 'length', 'mass' and 'time' respectively.

The Dimension of any QuantityKind can be derived through the algorithm that is defined in C.5.3.20 with SystemOfQuantities. The actual Dimension for a given QuantityKind depends on the choice of baseQuantityKind specified in a SystemOfQuantities.""";
             rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
             rdfs:label "Dimension";
             rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
             rdfs:subClassOf [owl:intersectionOf ([owl:allValuesFrom qu:DimensionFactor ; 
                                                  owl:onProperty qu:dimensionFactor ; 
                                                  a owl:Restriction]
                                                  [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty qu:symbolicExpression ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class],
                             [owl:intersectionOf ([owl:allValuesFrom qu:DimensionFactor ; 
                                                  owl:onProperty qu:dimensionFactor ; 
                                                  a owl:Restriction]
                                                  [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty qu:symbolicExpression ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
qu:DimensionFactor dc11:source "skos:exactMatch 'DimensionFactor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                   a owl:Class;
                   rdfs:comment "A DimensionFactor represents a factor in the product of powers that defines a Dimension.";
                   rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                   rdfs:label "DimensionFactor";
                   rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
                   rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass qu:QuantityKind ; 
                                    owl:onProperty qu:baseDimension ; 
                                    a owl:Restriction],
                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass qu:QuantityKind ; 
                                    owl:onProperty qu:baseDimension ; 
                                    a owl:Restriction].
qu:GeneralConversionUnit dc11:source "skos:exactMatch 'GeneralConversionUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                         a owl:Class;
                         rdfs:comment """A GeneralConversionUnit is a ConversionBasedUnit that represents a measurement unit that is defined with respect to another
reference measurement unit through a conversion relationship expressed in some syntax through a general mathematical
expression.
The unit conversion relationship is defined by the following equation:
valueRU / valueCU = f(valueRU, valueCU)
where:
valueRU is the quantity value expressed in the referenceUnit, and,
valueCU is the quantity value expressed in the GeneralConversionUnit, and,
f(valueRU, valueCU) is a mathematical expression that includes valueRU and valueCU.""";
                         rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                         rdfs:label "GeneralConversionUnit";
                         rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
                         rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty qu:expression ; 
                                          a owl:Restriction],
                                         qu:ConversionBasedUnit,
                                         [owl:onDataRange xsd:string ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty qu:expression ; 
                                          a owl:Restriction].
qu:LinearConversionUnit dc11:source "skos:exactMatch 'LinearConversionUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                        a owl:Class;
                        rdfs:comment """A LinearConversionUnit is a ConversionBasedUnit that represents a measurement unit that is defined with respect to another
measurement reference unit through a linear conversion relationship with a conversion factor.
The unit conversion relationship is defined by the following equation:
valueRU = factor · valueCU,
where:
valueRU is the quantity value expressed in the referenceUnit, and,
valueCU is the quantity value expressed in the LinearConversionUnit.""";
                        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                        rdfs:label "LinearConversionUnit";
                        rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
                        rdfs:subClassOf [owl:onDataRange xsd:double ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty qu:conversionFactor ; 
                                         a owl:Restriction],
                                        qu:ConversionBasedUnit,
                                        [owl:onDataRange xsd:double ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty qu:conversionFactor ; 
                                         a owl:Restriction].
qu:Prefix dc11:source "skos:exactMatch 'Prefix' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
          a owl:Class;
          rdfs:comment """A Prefix represents a named multiple or submultiple multiplication factor used in the specification of a PrefixedUnit. A
SystemOfUnits may specify a set of prefixes.""";
          rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
          rdfs:label "Prefix";
          rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
          rdfs:subClassOf [owl:intersectionOf ([owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:name ; 
                                               a owl:Restriction]
                                               [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:symbol ; 
                                               a owl:Restriction]
                                               [owl:onDataRange xsd:double ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:unitMultipleFactor ; 
                                               a owl:Restriction]) ; 
                           a owl:Class],
                          [owl:intersectionOf ([owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:name ; 
                                               a owl:Restriction]
                                               [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:symbol ; 
                                               a owl:Restriction]
                                               [owl:onDataRange xsd:double ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty qu:unitMultipleFactor ; 
                                               a owl:Restriction]) ; 
                           a owl:Class].
qu:PrefixedUnit dc11:source "skos:exactMatch 'Prefix' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                a owl:Class;
                rdfs:comment """A Prefix represents a named multiple or submultiple multiplication factor used in the specification of a PrefixedUnit. A
SystemOfUnits may specify a set of prefixes.""";
                rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                rdfs:label "PrefixedUnit";
                rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
                rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass qu:Prefix ; 
                                 owl:onProperty qu:prefix ; 
                                 a owl:Restriction],
                                qu:ConversionBasedUnit,
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass qu:Prefix ; 
                                 owl:onProperty qu:prefix ; 
                                 a owl:Restriction].
qu:PropertyKind a owl:Class;
                rdfs:comment "A PropertyKind  is a meta-property which helps to characterise categories of properties e.g. scalar, vector";
                rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                rdfs:label "PropertyKind";
                rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:QuantityKind dc11:source "skos:exactMatch 'QuantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                a owl:Class;
                rdfs:comment """A QuantityKind is an abstract classifier that represents the [VIM] concept of \"kind of quantity\" that is defined as \"aspect
common to mutually comparable quantities.\" A QuantityKind represents the essence of a quantity without any numerical
value or unit. Quantities of the same kind within a given system of quantities have the same quantity dimension. However,
quantities of the same dimension are not necessarily of the same kind.""";
                rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                rdfs:label "QuantityKind";
                rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                rdfs:subClassOf [owl:intersectionOf ([owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onClass qu:Scale ; 
                                                     owl:onProperty qu:scale ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:name ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:symbol ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:definitionURI ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:description ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class],
                                [owl:intersectionOf ([owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onClass qu:Scale ; 
                                                     owl:onProperty qu:scale ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:name ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:symbol ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:definitionURI ; 
                                                     a owl:Restriction]
                                                     [owl:onDataRange xsd:string ; 
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty qu:description ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
qu:QuantityKindFactor dc11:source "skos:exactMatch 'QuantityKindFactor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:Class;
                      rdfs:comment "A QuantityKindFactor represents a factor in the product of powers that defines a DerivedQuantityKind.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "QuantityKindFactor";
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                      rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onClass qu:QuantityKind ; 
                                                           owl:onProperty qu:factorQuantityKind ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:double ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:exponent ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class],
                                      [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onClass qu:QuantityKind ; 
                                                           owl:onProperty qu:factorQuantityKind ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:double ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:exponent ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
qu:Scale dc11:source "skos:exactMatch 'Scale' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
         a owl:Class;
         rdfs:comment """A Scale represents the [VIM] concept of a \"measurement scale\" that is defined as an \"ordered set of quantity values of
quantities of a given kind of quantity used in ranking, according to magnitude, quantities of that kind.\" A Scale specifies one
or more fixed values that have a specific significance in the definition of the associating QuantityKind.
For example the \"thermodynamic temperature\" kind of quantity is defined by specifying the values of 0 and 273.16 kelvin as
the temperatures of absolute zero and the triple point of water respectively.
A Scale does not always need to specify a unit. For example the \"Rockwell C Hardness Scale\" or the \"Beaufort Wind Force
Scale\" are ordinal scales that do not have a particular associated unit. Similarly, subjective scales for a \"priority\" or \"risk\" kind
of quantity with e.g. value definitions 0 for \"low\", 1 for \"medium\" and 3 for \"high\" do not have a particular associated unit.""";
         rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
         rdfs:label "Scale";
         rdfs:seeAlso "http://www.omgsysml.org/qudv#Scale";
         rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom qu:ScaleValueDefinition ; 
                                              owl:onProperty qu:scaleValueDefinition ; 
                                              a owl:Restriction]
                                              [owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onClass qu:Unit ; 
                                              owl:onProperty qu:unit ; 
                                              a owl:Restriction]) ; 
                          a owl:Class],
                         [owl:intersectionOf ([owl:someValuesFrom qu:ScaleValueDefinition ; 
                                              owl:onProperty qu:scaleValueDefinition ; 
                                              a owl:Restriction]
                                              [owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onClass qu:Unit ; 
                                              owl:onProperty qu:unit ; 
                                              a owl:Restriction]) ; 
                          a owl:Class].
qu:ScaleValueDefinition dc11:source "skos:exactMatch 'ScaleValueDefinition' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                        a owl:Class;
                        rdfs:comment "A ScaleValueDefinition represents a specific value for a measurement scale.";
                        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                        rdfs:label "ScaleValueDefinition";
                        rdfs:seeAlso "http://www.omgsysml.org/qudv#Scale";
                        rdfs:subClassOf [owl:intersectionOf ([owl:onDataRange xsd:string ; 
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty qu:description ; 
                                                             a owl:Restriction]
                                                             [owl:onDataRange xsd:double ; 
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty qu:numericalValue ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class],
                                        [owl:intersectionOf ([owl:onDataRange xsd:string ; 
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty qu:description ; 
                                                             a owl:Restriction]
                                                             [owl:onDataRange xsd:double ; 
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty qu:numericalValue ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class].
qu:SimpleQuantityKind dc11:source "skos:exactMatch 'SimpleQuantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:Class;
                      rdfs:comment """A SimpleQuantityKind is a QuantityKind that represents a kind of quantity that does not depend on any other QuantityKind.
Typically a base quantity would be specified as a SimpleQuantityKind.""";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "SimpleQuantityKind";
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                      rdfs:subClassOf qu:QuantityKind.
qu:SimpleUnit dc11:source "skos:exactMatch 'SimpleUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
              a owl:Class;
              rdfs:comment """A SimpleUnit is a Unit that represents a measurement unit that does not depend on any other Unit. Typically a base unit would
be specified as a SimpleUnit.""";
              rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
              rdfs:label "SimpleUnit";
              rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
              rdfs:subClassOf qu:Unit.
qu:SpecializedQuantityKind dc11:source "skos:exactMatch 'SpecializedQuantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                           a owl:Class;
                           rdfs:comment """A SpecializedQuantityKind is a QuantityKind that represents a kind of quantity that is a specialization of another kind of
quantity.
For example, \"distance\", \"width\", \"depth\", \"radius\" and \"wavelength\" can all be specified as specializations of the \"length\"
SimpleQuantityKind.""";
                           rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                           rdfs:label "SpecializedQuantityKind";
                           rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                           rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass qu:QuantityKind ; 
                                            owl:onProperty qu:generalQuantityKind ; 
                                            a owl:Restriction],
                                           qu:QuantityKind,
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass qu:QuantityKind ; 
                                            owl:onProperty qu:generalQuantityKind ; 
                                            a owl:Restriction].
qu:SystemOfQuantities dc11:source "skos:exactMatch 'SystemOfQuantities' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:Class;
                      rdfs:comment """A SystemOfQuantities represents the [VIM] concept of 'system of quantities' that is defined as a 'set of quantities together with a set of non-contradictory equations relating those quantities'. It collects a list of QuantityKind that specifies the kinds of quantity that are known in the system.

The International System of Quantities (ISQ) is an example of a SystemOfQuantities, defined in ISO 31 and ISO/IEC 80000.""";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "SystemOfQuantities";
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
                      rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom qu:Dimension ; 
                                                           owl:onProperty qu:dimension ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom qu:QuantityKind ; 
                                                           owl:onProperty qu:quantityComponent ; 
                                                           a owl:Restriction]
                                                           [owl:allValuesFrom qu:QuantityKind ; 
                                                           owl:onProperty qu:baseQuantityKind ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:name ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:symbol ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:definitionURI ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:description ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class],
                                      [owl:intersectionOf ([owl:someValuesFrom qu:Dimension ; 
                                                           owl:onProperty qu:dimension ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom qu:QuantityKind ; 
                                                           owl:onProperty qu:quantityComponent ; 
                                                           a owl:Restriction]
                                                           [owl:allValuesFrom qu:QuantityKind ; 
                                                           owl:onProperty qu:baseQuantityKind ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:name ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:symbol ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:definitionURI ; 
                                                           a owl:Restriction]
                                                           [owl:onDataRange xsd:string ; 
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty qu:description ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
qu:SystemOfUnits dc11:source "skos:exactMatch 'SystemOfUnits' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                 a owl:Class;
                 rdfs:comment "A SystemOfUnits represents the [VIM] concept of 'system of units' that is defined as 'set of base units and derived units, together with their multiples and submultiples, defined in accordance with given rules, for a given system of quantities'. It collects a list of Unit that are known in the system. A SysML SystemOfUnits only optionally defines multiples and submultiples.";
                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                 rdfs:label "SystemOfUnits";
                 rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
                 rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom qu:Unit ; 
                                                      owl:onProperty qu:unitComponent ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:Unit ; 
                                                      owl:onProperty qu:baseUnit ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:Prefix ; 
                                                      owl:onProperty qu:prefix ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:SystemOfQuantities ; 
                                                      owl:onProperty qu:systemOfQuantities ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:name ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:symbol ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:definitionURI ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:description ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class],
                                 [owl:intersectionOf ([owl:someValuesFrom qu:Unit ; 
                                                      owl:onProperty qu:unitComponent ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:Unit ; 
                                                      owl:onProperty qu:baseUnit ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:Prefix ; 
                                                      owl:onProperty qu:prefix ; 
                                                      a owl:Restriction]
                                                      [owl:allValuesFrom qu:SystemOfQuantities ; 
                                                      owl:onProperty qu:systemOfQuantities ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:name ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:symbol ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:definitionURI ; 
                                                      a owl:Restriction]
                                                      [owl:onDataRange xsd:string ; 
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty qu:description ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
qu:Unit dc11:source "skos:exactMatch 'Unit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
        a owl:Class;
        rdfs:comment """A Unit is an abstract classifier that represents the [VIM] concept of \"measurement unit\" that is defined as \"real scalar quantity,
defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the
two quantities as a number.\"""";
        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
        rdfs:label "Unit";
        rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
        rdfs:subClassOf [owl:intersectionOf ([owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onClass qu:QuantityKind ; 
                                             owl:onProperty qu:quantityKind ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:name ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:symbol ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:definitionURI ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:description ; 
                                             a owl:Restriction]) ; 
                         a owl:Class],
                        [owl:intersectionOf ([owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onClass qu:QuantityKind ; 
                                             owl:onProperty qu:quantityKind ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:name ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:symbol ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:definitionURI ; 
                                             a owl:Restriction]
                                             [owl:onDataRange xsd:string ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty qu:description ; 
                                             a owl:Restriction]) ; 
                         a owl:Class].
qu:UnitFactor dc11:source "skos:exactMatch 'UnitFactor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
              a owl:Class;
              rdfs:comment "A UnitFactor represents a factor in the product of powers that defines a DerivedUnit.";
              rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
              rdfs:label "UnitFactor";
              rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
              rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onClass qu:Unit ; 
                                                   owl:onProperty qu:unit ; 
                                                   a owl:Restriction]
                                                   [owl:onDataRange xsd:double ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty qu:exponent ; 
                                                   a owl:Restriction]) ; 
                               a owl:Class],
                              [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onClass qu:Unit ; 
                                                   owl:onProperty qu:unit ; 
                                                   a owl:Restriction]
                                                   [owl:onDataRange xsd:double ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty qu:exponent ; 
                                                   a owl:Restriction]) ; 
                               a owl:Class].
qu:baseDimension dc11:source "skos:exactMatch 'baseDimension' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                 a owl:ObjectProperty;
                 rdfs:comment "A Reference to the QuantityKind that represents the base quantity dimension in the factor.";
                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                 rdfs:label "baseDimension";
                 rdfs:range qu:QuantityKind;
                 rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension".
qu:baseQuantityKind dc11:source "skos:exactMatch 'baseQuantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                    a owl:AsymmetricProperty,
                      owl:ObjectProperty;
                    rdfs:comment "Ordered set of QuantityKind that specifies the base quantities of the system of quantities. This is a subset of the complete quantityKind list. The base quantities define the basis for the quantity dimension of a kind of quantity.";
                    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                    rdfs:label "baseQuantityKind";
                    rdfs:range qu:QuantityKind;
                    rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
                    rdfs:subPropertyOf qu:quantityKind.
qu:baseUnit dc11:source "skos:exactMatch 'baseUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
            a owl:AsymmetricProperty,
              owl:ObjectProperty;
            rdfs:comment """Ordered set of Unit that specifies the base units of the system of units. A \"base unit\" is defined in [VIM] as a \"measurement unit that is adopted by convention for a base quantity,\" i.e. it is the (preferred) unit in which base quantities of the associated systemOfQuantities are expressed.""";
            rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
            rdfs:label "baseUnit";
            rdfs:range qu:Unit;
            rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension";
            rdfs:subPropertyOf qu:unit.
qu:code dc11:description "short symbolic name";
        dc11:source "skos:closeMatch 'code' [QUDT] http://qudt.org/";
        a owl:DatatypeProperty;
        rdfs:comment "A code is a string that uniquely identifies an individual.";
        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
        rdfs:label "code";
        rdfs:range xsd:string;
        rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:conversionFactor dc11:source "skos:exactMatch 'factor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                    a owl:DatatypeProperty;
                    rdfs:comment "Rational number that specifies the factor in the unit conversion relationship.";
                    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                    rdfs:label "conversionFactor";
                    rdfs:range xsd:double;
                    rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:conversionOffset dc11:source "skos:exactMatch 'offset' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                    a owl:DatatypeProperty;
                    rdfs:comment "Rational number that specifies the offset in the unit conversion relationship.";
                    rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                    rdfs:label "conversionOffset";
                    rdfs:range xsd:double;
                    rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:definitionURI dc11:description "URI that contains an authoritative definition of the referent thing";
                 dc11:source "skos:exactMatch 'definitionURI' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                 a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment "URI that references an external definition.";
                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                 rdfs:label "definitionURI";
                 rdfs:range xsd:string;
                 rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:description dc11:source "skos:exactMatch 'description' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
               a owl:DatatypeProperty;
               rdfs:comment "Textual description";
               rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
               rdfs:label "description";
               rdfs:range xsd:string;
               rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:dimension dc11:source "skos:exactMatch 'dimension' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
             a owl:ObjectProperty;
             rdfs:comment "Derived ordered set of Dimension. The actual dimension of a QuantityKind depends on the list of baseQuantityKind that are specified in an actual SystemOfQuantities, see the DerivedDimensions constraint.";
             rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
             rdfs:label "dimension";
             rdfs:range qu:Dimension;
             rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:dimensionFactor dc11:source "skos:exactMatch 'factor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                   a owl:AsymmetricProperty,
                     owl:ObjectProperty;
                   rdfs:comment "Rational number that specifies the factor in the dimension conversion relationship.";
                   rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                   rdfs:label "dimension factor";
                   rdfs:range qu:DimensionFactor;
                   rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension".
qu:exponent dc11:source "skos:exactMatch 'exponent' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
            a owl:DatatypeProperty;
            rdfs:comment "Rational number that specifies the exponent of the power to which the unit is raised.";
            rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
            rdfs:label "exponent";
            rdfs:range xsd:double;
            rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:expression dc11:source "skos:exactMatch 'expression' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
              a owl:DatatypeProperty;
              rdfs:comment "Specifies the unit conversion relationship in some expression syntax.";
              rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
              rdfs:label "conversionExpression";
              rdfs:range xsd:string;
              rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:factorQuantityKind dc11:source "skos:exactMatch 'quantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:AsymmetricProperty,
                        owl:ObjectProperty;
                      rdfs:comment "Specification of the associated QuantityKind.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "factorQuantityKind";
                      rdfs:range qu:QuantityKind;
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:generalQuantityKind dc11:source "skos:exactMatch 'generalization' [QUDT] http:qudt.org",
                                   "skos:exactMatch 'general' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                       a owl:IrreflexiveProperty,
                         owl:ObjectProperty;
                       rdfs:comment "A generalization relationship between two kinds of quantities.";
                       rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                       rdfs:label "generalQuantityKind";
                       rdfs:range qu:QuantityKind;
                       rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:name dc11:description "human-readable word or sequence of words by which a thing is known";
        dc11:source "skos:exactMatch 'name' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
        a owl:FunctionalProperty,
          owl:DatatypeProperty;
        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
        rdfs:label "name";
        rdfs:range xsd:string;
        rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:numericalValue dc11:source "skos:exactMatch 'value' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                  a owl:DatatypeProperty;
                  rdfs:comment "Specifies the numerical value.";
                  rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                  rdfs:label "numericalValue";
                  rdfs:range xsd:double;
                  rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:prefix dc11:source "skos:exactMatch 'prefix' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
          a owl:IrreflexiveProperty,
            owl:AsymmetricProperty,
            owl:ObjectProperty;
          rdfs:comment "Ordered set of Prefix that specifies the prefixes for multiples and submultiples of units in the system";
          rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
          rdfs:label "prefix";
          rdfs:range qu:Prefix;
          rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit".
qu:propertyType a owl:AsymmetricProperty,
                  owl:ObjectProperty;
                rdfs:comment "Specification of the associated ProeprtyType.";
                rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                rdfs:label "propertyType";
                rdfs:range qu:PropertyKind;
                rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:quantityComponent dc11:source "skos:exactMatch 'quantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                     a owl:AsymmetricProperty,
                       owl:ObjectProperty;
                     rdfs:comment "Quantities attached to a system.";
                     rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                     rdfs:label "quantityComponent";
                     rdfs:range qu:QuantityKind;
                     rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension".
qu:quantityKind dc11:source "skos:exactMatch 'quantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                a owl:AsymmetricProperty,
                  owl:ObjectProperty;
                rdfs:comment "Specification of the associated QuantityKind.";
                rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                rdfs:label "quantityKind";
                rdfs:range qu:QuantityKind;
                rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:quantityKindFactor dc11:source "skos:exactMatch 'factor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:AsymmetricProperty,
                        owl:ObjectProperty;
                      rdfs:comment "Rational number that specifies the factor in the quantity conversion relationship.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "quantity kind factor";
                      rdfs:range qu:QuantityKindFactor;
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity".
qu:referenceUnit dc11:source "skos:exactMatch 'referenceUnit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                 a owl:AsymmetricProperty,
                   owl:ObjectProperty;
                 rdfs:comment "Specifies the unit with respect to which the ConversionBasedUnit is defined.";
                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                 rdfs:label "referenceUnit";
                 rdfs:range qu:Unit;
                 rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit".
qu:scale dc11:source "skos:exactMatch 'scale' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
         a owl:IrreflexiveProperty,
           owl:AsymmetricProperty,
           owl:ObjectProperty;
         rdfs:comment "Specification of a Scale that is associated to the QuantityKind.";
         rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
         rdfs:label "scale";
         rdfs:range qu:Scale;
         rdfs:seeAlso "http://www.omgsysml.org/qudv#Scale".
qu:scaleValueDefinition dc11:source "skos:exactMatch 'valueDefinition' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                        a owl:IrreflexiveProperty,
                          owl:AsymmetricProperty,
                          owl:ObjectProperty;
                        rdfs:comment "Ordered set of ScaleValueDefinition that specifies the defined numerical value(s) and textual definition(s) for the measurement scale.";
                        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                        rdfs:label "scaleValueDefinition";
                        rdfs:range qu:ScaleValueDefinition;
                        rdfs:seeAlso "http://www.omgsysml.org/qudv#Scale".
qu:specificQuantityKind dc11:source "skos:exactMatch 'specific' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                        a owl:ObjectProperty,
                          owl:IrreflexiveProperty;
                        rdfs:comment "A specialization relationship between two kinds of quantities.";
                        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                        rdfs:label "specificQuantityKind";
                        rdfs:range qu:SpecializedQuantityKind,
                                   qu:QuantityKind;
                        rdfs:seeAlso "http://www.omgsysml.org/qudv#Quantity";
                        owl:inverseOf qu:generalQuantityKind.
qu:symbol dc11:description "short symbolic name";
          dc11:source "skos:exactMatch 'symbol' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
          a owl:DatatypeProperty;
          rdfs:comment "Short symbolic name.";
          rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
          rdfs:label "symbol";
          rdfs:range xsd:string;
          rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:symbolicExpression dc11:source "skos:exactMatch 'symbolicExpression' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:DatatypeProperty;
                      rdfs:comment "Symbolic expression of the quantity dimension's product of powers, in terms of symbols of the kinds of quantity that represent the base kinds of quantity and their exponents.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "symbolicExpression";
                      rdfs:range xsd:string;
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
qu:systemOfQuantities dc11:source "skos:exactMatch 'systemOfQuantities' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:ObjectProperty;
                      rdfs:comment "Reference to the SystemOfQuantities for which the units are specified.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "systemOfQuantities";
                      rdfs:range qu:SystemOfQuantities;
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension".
qu:unit dc11:source "skos:exactMatch 'quantityKind' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
        a owl:AsymmetricProperty,
          owl:ObjectProperty;
        rdfs:comment "Specification of the associated Unit.";
        rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
        rdfs:label "unit";
        rdfs:range qu:Unit;
        rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit".
qu:unitComponent dc11:source "skos:exactMatch 'unit' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                 a owl:AsymmetricProperty,
                   owl:ObjectProperty;
                 rdfs:comment "Ordered set of Unit that specifies the units that are known in the system.";
                 rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                 rdfs:label "unitComponent";
                 rdfs:range qu:Unit;
                 rdfs:seeAlso "http://www.omgsysml.org/qudv#Dimension".
qu:unitFactor dc11:source "skos:exactMatch 'factor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
              a owl:AsymmetricProperty,
                owl:ObjectProperty;
              rdfs:comment "Rational number that specifies the factor in the unit conversion relationship.";
              rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
              rdfs:label "unit factor";
              rdfs:range qu:UnitFactor;
              rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit".
qu:unitKind a owl:AsymmetricProperty,
              owl:ObjectProperty;
            rdfs:comment """Specification of the associated Unit \"Kind\".""";
            rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
            rdfs:label "unitKind";
            rdfs:range qu:Unit;
            rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit";
            owl:inverseOf qu:quantityKind.
qu:unitMultipleFactor dc11:source "skos:exactMatch 'factor' [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv";
                      a owl:FunctionalProperty,
                        owl:DatatypeProperty;
                      rdfs:comment "Specifies the multiple or submultiple multiplication factor.";
                      rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                      rdfs:label "unitMultipleFactor";
                      rdfs:range xsd:double;
                      rdfs:seeAlso "http://www.omgsysml.org/qudv#Data".
