@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix bio: <http://purl.org/vocab/bio/0.1/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix geonames: <http://www.geonames.org/ontology#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix eac-cpf: <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf/>.
@prefix loc: <http://id.loc.gov/>.

eac-cpf:biogHist a owl:DatatypeProperty;
                 rdfs:domain eac-cpf:entity;
                 rdfs:label "Biographical or Historical Note";
                 rdfs:range xsd:string.
eac-cpf:control a owl:ObjectProperty;
                rdfs:domain eac-cpf:entity;
                rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e1944>;
                rdfs:label "Control";
                rdfs:range eac-cpf:controlArea.
eac-cpf:controlArea a owl:Class;
                    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e1944>;
                    rdfs:label "control area";
                    rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceHistory ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:publicationStatus ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:source ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:conventionDeclaration ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:recordID ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:publicationStatus ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:localTypeDeclaration ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:localTypeDeclaration ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceStatus ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceAgency ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceAgency ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:conventionDeclaration ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:source ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceHistory ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:maintenanceStatus ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty eac-cpf:recordID ; 
                                     a owl:Restriction].
eac-cpf:conventionDeclaration a owl:DatatypeProperty;
                              rdfs:domain eac-cpf:entity;
                              rdfs:label "Convention Declaration";
                              rdfs:range xsd:string.
eac-cpf:corporateBody a owl:Class;
                      rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773>;
                      rdfs:label "corporate body";
                      rdfs:subClassOf eac-cpf:entity.
eac-cpf:cpfRelation a owl:ObjectProperty;
                    rdfs:domain eac-cpf:entity;
                    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2216>;
                    rdfs:label "Corporate Body, Person, or Family Relation";
                    rdfs:range eac-cpf:relation.
eac-cpf:cpfRelationType a owl:DatatypeProperty;
                        rdfs:domain eac-cpf:relation;
                        rdfs:label "Corporate Body, Person, or Family Relation Type";
                        rdfs:range xsd:string.
eac-cpf:description a owl:ObjectProperty;
                    rdfs:domain eac-cpf:entity;
                    rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2138>;
                    rdfs:label "Description";
                    rdfs:range eac-cpf:descriptionArea.
eac-cpf:descriptionArea a owl:Class;
                        rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2138>;
                        rdfs:label "description area";
                        rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:existDates ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:biogHist ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom eac-cpf:relation ; 
                                         owl:onProperty eac-cpf:cpfRelation ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:biogHist ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:nameEntry ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty bio:Birth ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty bio:Birth ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:nameEntry ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom eac-cpf:relation ; 
                                         owl:onProperty eac-cpf:resourceRelation ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom eac-cpf:relation ; 
                                         owl:onProperty eac-cpf:cpfRelation ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty bio:Death ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom eac-cpf:relation ; 
                                         owl:onProperty eac-cpf:resourceRelation ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty bio:Death ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom rdfs:Literal ; 
                                         owl:onProperty eac-cpf:existDates ; 
                                         a owl:Restriction].
eac-cpf:eac-cpf.rdf dc11:creator "Istituto per i beni artistici culturali e naturali della Regione Emilia-Romagna and Regesta.exe";
                    dcterms:isReferencedBy <http://archivi.ibc.regione.emilia-romagna.it/ontology/semanticEnvironment/index.html>;
                    a owl:Ontology;
                    owl:imports dc11:,
                                dcterms:;
                    owl:versionInfo 1.2;
                    skos:historyNote [dc11:creator "Silvia Mazzini" ; 
                                      dc11:date "2013-02-18" ; 
                                      rdf:value "Creata la Datatype Property eac-cpf:placeRole"],
                                     [dc11:creator "Silvia Mazzini" ; 
                                      dc11:date "2013-02-18" ; 
                                      rdf:value "Creata la Object Property eac-cpf:hasPlace"],
                                     [dc11:creator "Silvia Mazzini" ; 
                                      dc11:date "2013-02-18" ; 
                                      rdf:value "Creata la Datatype Property eac-cpf:placeRole"],
                                     [dc11:creator "Silvia Mazzini" ; 
                                      dc11:date "2013-02-18" ; 
                                      rdf:value "Creata la Object Property eac-cpf:hasPlace"].
eac-cpf:entity a owl:Class;
               rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773>;
               rdfs:label "entity".
eac-cpf:existDates a owl:DatatypeProperty;
                   rdfs:domain eac-cpf:entity;
                   rdfs:label "Dates of Existence";
                   rdfs:range xsd:string.
eac-cpf:family a owl:Class;
               rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773>;
               rdfs:label "family";
               rdfs:subClassOf eac-cpf:entity.
eac-cpf:function a owl:DatatypeProperty;
                 rdfs:domain eac-cpf:entity;
                 rdfs:label "Function";
                 rdfs:range xsd:string.
eac-cpf:generalContext a owl:DatatypeProperty;
                       rdfs:domain eac-cpf:entity;
                       rdfs:label "General Context";
                       rdfs:range xsd:string.
eac-cpf:hasMultipleIdentities a owl:ObjectProperty;
                              rdfs:domain eac-cpf:entity;
                              rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e4966>;
                              rdfs:label "Multiple Identities";
                              rdfs:range eac-cpf:entity.
eac-cpf:hasPlace a owl:ObjectProperty;
                 rdfs:domain eac-cpf:entity;
                 rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e5820>;
                 rdfs:label "Place";
                 rdfs:range eac-cpf:place;
                 owl:versionInfo "Questa proprietà è stata inserita nella versione del 18 febbraio 2013".
eac-cpf:language a owl:Class;
                 rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e3737>;
                 rdfs:label "language";
                 owl:Restriction [owl:Class <http://id.loc.gov/vocabulary/iso639-1> ; 
                                  a owl:allValuesFrom],
                                 [owl:Class <http://id.loc.gov/vocabulary/iso639-1> ; 
                                  a owl:allValuesFrom].
eac-cpf:languageDeclaration a owl:ObjectProperty;
                            rdfs:domain eac-cpf:entity;
                            rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e3791>;
                            rdfs:label "Language Declaration";
                            rdfs:range eac-cpf:language.
eac-cpf:languageUsed a owl:DatatypeProperty;
                     rdfs:domain eac-cpf:entity;
                     rdfs:label "Languages Used";
                     rdfs:range xsd:string.
eac-cpf:legalStatus a owl:DatatypeProperty;
                    rdfs:domain eac-cpf:corporateBody;
                    rdfs:label "Legal Status";
                    rdfs:range xsd:string.
eac-cpf:localControl a owl:DatatypeProperty;
                     rdfs:domain eac-cpf:entity;
                     rdfs:label "Local Control";
                     rdfs:range xsd:string.
eac-cpf:localTypeDeclaration a owl:DatatypeProperty;
                             rdfs:domain eac-cpf:entity;
                             rdfs:label "Local Type Declaration";
                             rdfs:range xsd:string.
eac-cpf:maintenanceAgency a owl:DatatypeProperty;
                          rdfs:domain eac-cpf:entity;
                          rdfs:label "Maintenance Agency";
                          rdfs:range xsd:string.
eac-cpf:maintenanceHistory a owl:DatatypeProperty;
                           rdfs:domain eac-cpf:entity;
                           rdfs:label "Maintenance History";
                           rdfs:range xsd:string.
eac-cpf:maintenanceStatus a owl:DatatypeProperty;
                          rdfs:domain eac-cpf:entity;
                          rdfs:label "Maintenance Status";
                          rdfs:range xsd:string.
eac-cpf:mandate a owl:DatatypeProperty;
                rdfs:domain eac-cpf:corporateBody;
                rdfs:label "Mandate";
                rdfs:range xsd:string.
eac-cpf:nameArea a owl:Class;
                 rdfs:isDefinedBy eac-cpf:dainserire;
                 rdfs:label "name area";
                 rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:givenName ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:page ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:name ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:givenName ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:depiction ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:name ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:page ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty foaf:depiction ; 
                                  a owl:Restriction].
eac-cpf:nameEntry a owl:ObjectProperty;
                  rdfs:domain eac-cpf:entity;
                  rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e5077>;
                  rdfs:label "Name Entry";
                  rdfs:range eac-cpf:nameArea.
eac-cpf:occupation a owl:DatatypeProperty;
                   rdfs:domain eac-cpf:entity;
                   rdfs:label "Occupation";
                   rdfs:range xsd:string.
eac-cpf:person a owl:Class;
               rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e2773>;
               rdfs:label "person";
               rdfs:subClassOf eac-cpf:entity.
eac-cpf:place a owl:Class;
              rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e5921>;
              rdfs:label "place";
              owl:equivalentClass geonames:Feature.
eac-cpf:placeRole a owl:DatatypeProperty;
                  rdfs:domain eac-cpf:place;
                  rdfs:label "Place Role";
                  rdfs:range xsd:string;
                  owl:versionInfo "Questa proprietà è stata inserita nella versione del 18 febbraio 2013".
eac-cpf:publicationStatus a owl:DatatypeProperty;
                          rdfs:domain eac-cpf:entity;
                          rdfs:label "Publication Status";
                          rdfs:range xsd:string.
eac-cpf:recordID a owl:DatatypeProperty;
                 rdfs:domain eac-cpf:entity;
                 rdfs:label "Record Identifier";
                 rdfs:range xsd:anyURI.
eac-cpf:relation a owl:Class;
                 rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e6439>;
                 rdfs:label "relation";
                 rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:date ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty eac-cpf:cpfRelationType ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:relation ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:description ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty eac-cpf:cpfRelationType ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:description ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:date ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty dc11:relation ; 
                                  a owl:Restriction].
eac-cpf:resourceRelation a owl:ObjectProperty;
                         rdfs:domain eac-cpf:entity;
                         rdfs:isDefinedBy <http://www3.iath.virginia.edu/eac/cpf/tagLibrary/cpfTagLibrary.html#d1e6491>;
                         rdfs:label "Resource Relation";
                         rdfs:range eac-cpf:relation.
eac-cpf:resourceRelationType a owl:DatatypeProperty;
                             rdfs:domain eac-cpf:relation;
                             rdfs:label "Resource Relation Type";
                             rdfs:range xsd:string.
eac-cpf:source a owl:DatatypeProperty;
               rdfs:domain eac-cpf:entity;
               rdfs:label "Source";
               rdfs:range xsd:string.
eac-cpf:structureOrGenealogy a owl:DatatypeProperty;
                             rdfs:domain eac-cpf:entity;
                             rdfs:label "Structure or Genealogy";
                             rdfs:range xsd:string.
