@base <http://purl.org/swan/2.0/discourse-elements/>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix swandiscourse-elements: <http://purl.org/swan/2.0/discourse-elements/>.

dct:contributor a owl:AnnotationProperty.
dct:creator a owl:AnnotationProperty.
dct:date a owl:AnnotationProperty.
dct:format a owl:AnnotationProperty.
dct:language a owl:AnnotationProperty.
dct:publisher a owl:AnnotationProperty.
dct:title a owl:AnnotationProperty.
swandiscourse-elements: dct:contributor "Paolo Ciccarese",
                                        "Marco Ocana",
                                        "Elizabeth Wu",
                                        "Tim Clark",
                                        "Gwen Wong",
                                        "June Kinoshita";
                        dct:creator <http://www.hcklab.org/foaf.rdf#me>;
                        dct:date "April 24, 2010";
                        dct:format "rdf/xml";
                        dct:language "en";
                        dct:publisher "Mindinformatics, Massachusetts General Hospital";
                        dct:title "Discourse relationships vocabulary"@en;
                        a owl:Ontology;
                        rdfs:label "Discourse elements vocabulary v. 3";
                        owl:versionInfo "3.0".
swandiscourse-elements:Claim a owl:Class;
                             rdfs:comment """A claim is a research statement that is 
    	accepted by the author/curator as reasonable. Unlike a hypothesis, its author/curator 
    	does not consider it provisional, but proven.""";
                             rdfs:label "swande: Claim";
                             rdfs:subClassOf swandiscourse-elements:ResearchStatement.
swandiscourse-elements:DiscourseElement a owl:Class;
                                        rdfs:label "swande: Discourse Element".
swandiscourse-elements:Hypothesis a owl:Class;
                                  rdfs:comment """A hypothesis is a statement proposing one or 
    	more ideas, which has a provisional nature""";
                                  rdfs:label "swande: Hypothesis";
                                  rdfs:subClassOf swandiscourse-elements:ResearchStatement.
swandiscourse-elements:Question a owl:Class;
                                rdfs:label "swande: Research Question";
                                rdfs:subClassOf swandiscourse-elements:DiscourseElement.
swandiscourse-elements:ResearchStatement a owl:Class;
                                         rdfs:label "swande: Research Statement";
                                         rdfs:subClassOf swandiscourse-elements:DiscourseElement.
