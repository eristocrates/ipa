@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix veo: <http://linkeddata.finki.ukim.mk/lod/ontology/veo#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix vso: <http://purl.org/vso/ns#>.
@prefix vvo: <http://purl.org/vvo/ns#>.
@prefix onto: <http://www.ontotext.com/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

veo: ccrel:license <https://creativecommons.org/licenses/by/3.0/>;
     dcterms:contributor <https://plus.google.com/+MilosJovanovik>;
     dcterms:creator <https://plus.google.com/+BojanNajdenov>;
     dcterms:description "An ontology for describing vehicles and their emissions.";
     dcterms:issued "2014-09-01";
     dcterms:modified "2016-08-28";
     dcterms:publisher <http://finki.ukim.mk/>;
     dcterms:rights "Copyright 2014, Bojan Najdenov";
     dcterms:title "Vehicle Emissions Ontology";
     vann:preferredNamespacePrefix "veo";
     vann:preferredNamespaceUri "http://linkeddata.finki.ukim.mk/lod/ontology/veo#";
     a owl:Ontology;
     rdfs:comment "An ontology for describing vehicles and their emissions.";
     owl:versionInfo "1.1".
veo:Train a owl:Class;
          rdfs:subClassOf vso:Vehicle.
veo:emissionsPerPassenger a owl:DatatypeProperty;
                          rdfs:domain vso:Vehicle;
                          rdfs:range rdfs:Literal.
veo:hasElectricEnergyConsumtion a owl:DatatypeProperty;
                                rdfs:comment "This property represents the electric energy consumption of a vehicle measured in Wh/km.";
                                rdfs:domain vvo:Automobile;
                                rdfs:range rdfs:Literal.
veo:hasEmissionsReduction a owl:DatatypeProperty;
                          rdfs:comment "This property represents emissions reduction measured in g/km that a vehicle has, through the implemented innovative technologies.";
                          rdfs:domain vvo:Automobile;
                          rdfs:range rdfs:Literal.
veo:hasEngineCapacity a owl:DatatypeProperty;
                      rdfs:comment "This property shows the capacity of the engine of a vehicle measured in cm3";
                      rdfs:domain vvo:Automobile;
                      rdfs:range rdfs:Literal.
veo:hasFuelMode a owl:DatatypeProperty;
                rdfs:comment "This property represents the fuel mode of a vehicle";
                rdfs:domain vvo:Automobile;
                rdfs:range rdfs:Literal.
veo:hasInnovativeTechnology a owl:DatatypeProperty;
                            rdfs:comment "This property represents an innovation technology that a vehicle has implemented.";
                            rdfs:domain vvo:Automobile;
                            rdfs:range rdfs:Literal.
veo:hasMSRegManufacturerName a owl:DatatypeProperty;
                             rdfs:comment "This property represents a manufacturer name as in the registry of Member States of the European Environment Agency.";
                             rdfs:domain vvo:Automobile;
                             rdfs:range rdfs:Literal.
veo:hasManufacturerHarmonisedName a owl:DatatypeProperty;
                                  rdfs:comment "This property represents a manufacturer harmonised name.";
                                  rdfs:domain vvo:Automobile;
                                  rdfs:range rdfs:Literal.
veo:hasManufacturerPooling a owl:DatatypeProperty;
                           rdfs:comment "This property represents a manufacturers pooling.";
                           rdfs:domain vvo:Automobile;
                           rdfs:range rdfs:Literal.
veo:hasOtherAxleWidth a owl:DatatypeProperty;
                      rdfs:comment "This property represents the width of the other steering axle of a vehicle measured in mm.";
                      rdfs:domain vvo:Automobile;
                      rdfs:range rdfs:Literal.
veo:hasSteeringAxleWidth a owl:DatatypeProperty;
                         rdfs:comment "This property represents the width of the steering axle of a vehicle measured in mm.";
                         rdfs:domain vvo:Automobile;
                         rdfs:range rdfs:Literal.
veo:hasTotalNewRegistrations a owl:DatatypeProperty;
                             rdfs:comment "This property represents the nubmer of total new registration of a vehicle.";
                             rdfs:domain vvo:Automobile;
                             rdfs:range rdfs:Literal.
veo:hasTypeApprovalNumber a owl:DatatypeProperty;
                          rdfs:comment "This property represents an internal type approval number.";
                          rdfs:domain vvo:Automobile;
                          rdfs:range rdfs:Literal.
veo:numberOfPassengers a owl:DatatypeProperty;
                       rdfs:domain vso:Vehicle;
                       rdfs:range xsd:int.
veo:type a owl:DatatypeProperty;
         rdfs:comment "This property represents an internal type of vehicle.";
         rdfs:domain vvo:Automobile;
         rdfs:range rdfs:Literal.
veo:variant a owl:DatatypeProperty;
            rdfs:comment "This property represents an internal variant code.";
            rdfs:domain vvo:Automobile;
            rdfs:range rdfs:Literal.
veo:vehicleTypeApprovedCategory a owl:DatatypeProperty;
                                rdfs:comment "This property represents a category of the approved vehicle type.";
                                rdfs:domain vvo:Automobile;
                                rdfs:range rdfs:Literal.
veo:version a owl:DatatypeProperty;
            rdfs:comment "This property represents an internal version code of a vehicle.";
            rdfs:domain vvo:Automobile;
            rdfs:range rdfs:Literal.
vso:BusOrCoach a owl:Class;
               rdfs:subClassOf vso:Vehicle.
vso:Vehicle a owl:Class.
vvo:Automobile a owl:Class;
               rdfs:subClassOf vso:Vehicle.
<http://www.ontotext.com/proton-ontology/AirplaneModel> a owl:Class;
                                                        rdfs:subClassOf vso:Vehicle.
