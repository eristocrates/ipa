@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix veo: <http://linkeddata.finki.ukim.mk/lod/ontology/veo#>.

veo: <http://creativecommons.org/ns#license> <https://creativecommons.org/licenses/by/3.0/>;
     <http://purl.org/dc/terms/contributor> <https://plus.google.com/+MilosJovanovik>;
     <http://purl.org/dc/terms/creator> <https://plus.google.com/+BojanNajdenov>;
     <http://purl.org/dc/terms/description> "An ontology for describing vehicles and their emissions.";
     <http://purl.org/dc/terms/issued> "2014-09-01";
     <http://purl.org/dc/terms/modified> "2016-08-28";
     <http://purl.org/dc/terms/publisher> <http://finki.ukim.mk/>;
     <http://purl.org/dc/terms/rights> "Copyright 2014, Bojan Najdenov";
     <http://purl.org/dc/terms/title> "Vehicle Emissions Ontology";
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "veo";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://linkeddata.finki.ukim.mk/lod/ontology/veo#";
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "An ontology for describing vehicles and their emissions.";
     <http://www.w3.org/2002/07/owl#versionInfo> "1.1".
veo:Train a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf <http://purl.org/vso/ns#Vehicle>.
veo:emissionsPerPassenger a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain <http://purl.org/vso/ns#Vehicle>;
                          rdfs:range rdfs:Literal.
veo:hasElectricEnergyConsumtion a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "This property represents the electric energy consumption of a vehicle measured in Wh/km.";
                                rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                                rdfs:range rdfs:Literal.
veo:hasEmissionsReduction a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "This property represents emissions reduction measured in g/km that a vehicle has, through the implemented innovative technologies.";
                          rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                          rdfs:range rdfs:Literal.
veo:hasEngineCapacity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "This property shows the capacity of the engine of a vehicle measured in cm3";
                      rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                      rdfs:range rdfs:Literal.
veo:hasFuelMode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "This property represents the fuel mode of a vehicle";
                rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                rdfs:range rdfs:Literal.
veo:hasInnovativeTechnology a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "This property represents an innovation technology that a vehicle has implemented.";
                            rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                            rdfs:range rdfs:Literal.
veo:hasMSRegManufacturerName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "This property represents a manufacturer name as in the registry of Member States of the European Environment Agency.";
                             rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                             rdfs:range rdfs:Literal.
veo:hasManufacturerHarmonisedName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                  rdfs:comment "This property represents a manufacturer harmonised name.";
                                  rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                                  rdfs:range rdfs:Literal.
veo:hasManufacturerPooling a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "This property represents a manufacturers pooling.";
                           rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                           rdfs:range rdfs:Literal.
veo:hasOtherAxleWidth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "This property represents the width of the other steering axle of a vehicle measured in mm.";
                      rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                      rdfs:range rdfs:Literal.
veo:hasSteeringAxleWidth a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "This property represents the width of the steering axle of a vehicle measured in mm.";
                         rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                         rdfs:range rdfs:Literal.
veo:hasTotalNewRegistrations a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "This property represents the nubmer of total new registration of a vehicle.";
                             rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                             rdfs:range rdfs:Literal.
veo:hasTypeApprovalNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "This property represents an internal type approval number.";
                          rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                          rdfs:range rdfs:Literal.
veo:numberOfPassengers a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain <http://purl.org/vso/ns#Vehicle>;
                       rdfs:range xsd:int.
veo:type a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "This property represents an internal type of vehicle.";
         rdfs:domain <http://purl.org/vvo/ns#Automobile>;
         rdfs:range rdfs:Literal.
veo:variant a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "This property represents an internal variant code.";
            rdfs:domain <http://purl.org/vvo/ns#Automobile>;
            rdfs:range rdfs:Literal.
veo:vehicleTypeApprovedCategory a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "This property represents a category of the approved vehicle type.";
                                rdfs:domain <http://purl.org/vvo/ns#Automobile>;
                                rdfs:range rdfs:Literal.
veo:version a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "This property represents an internal version code of a vehicle.";
            rdfs:domain <http://purl.org/vvo/ns#Automobile>;
            rdfs:range rdfs:Literal.
<http://purl.org/vso/ns#BusOrCoach> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:subClassOf <http://purl.org/vso/ns#Vehicle>.
<http://purl.org/vso/ns#Vehicle> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/vvo/ns#Automobile> a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:subClassOf <http://purl.org/vso/ns#Vehicle>.
<http://www.ontotext.com/proton-ontology/AirplaneModel> a <http://www.w3.org/2002/07/owl#Class>;
                                                        rdfs:subClassOf <http://purl.org/vso/ns#Vehicle>.
