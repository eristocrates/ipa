@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix media: <http://purl.org/media#>.

<http://payswarm.com/vocabs/media> <http://creativecommons.org/ns#attributionName> "Digital Bazaar, Inc."@en;
                                   <http://creativecommons.org/ns#attributionURL> <http://digitalbazaar.com/>;
                                   <http://www.w3.org/1999/xhtml/vocab#license> <http://creativecommons.org/licenses/publicdomain/>;
                                   <http://www.w3.org/1999/xhtml/vocab#stylesheet> <http://payswarm.com/css/vocabulary.css>.
<http://purl.org/commerce#costs> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment """A link to a
            method of paying for a full version of the media recording."""@en;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/commerce#payment> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:comment """A link to a
            method of paying for a full version of the media recording."""@en;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:comment """An entity that
            helped create the media recording."""@en;
                                       rdfs:range <http://xmlns.com/foaf/0.1/Person>,
                                                  <http://xmlns.com/foaf/0.1/Agent>,
                                                  <http://www.w3.org/2001/vcard-rdf/3.0>;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:comment """The primary
            creator or performer of the media recording."""@en;
                                   rdfs:range <http://xmlns.com/foaf/0.1/Person>,
                                              <http://xmlns.com/foaf/0.1/Agent>,
                                              <http://www.w3.org/2001/vcard-rdf/3.0>;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/date> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment """The date the
            media recording was published."""@en;
                                rdfs:range xsd:date;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:comment """The description
            associated with the media recording."""@en;
                                       rdfs:range rdf:XMLLiteral;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment """title of the
            media recording"""@en;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/dc/terms/type> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment """A genre that
            should be associated with the media recording."""@en;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/media> <http://purl.org/dc/terms/description> """The Media RDF vocabulary is not meant to be used by itself if you are marking up audio or video. If the media that you are marking up falls outside of audio/video, you should use the Media RDF Vocabulary if there is no other way to mark up the information. You may want to use the <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media/audio\" xml:lang=\"en\">Audio RDF Vocabulary</a> or <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media/video\" xml:lang=\"en\">Video RDF Vocabulary</a> if you are marking up audio or video."""^^rdf:XMLLiteral;
                        <http://purl.org/dc/terms/title> "The Media Vocabulary"@en;
                        a <http://www.w3.org/2002/07/owl#Ontology>.
media:Collection a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """A collection of
            one or more media recordings."""@en;
                 rdfs:label """<a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media#Collection\" xml:lang=\"en\">media:Collection</a>"""^^rdf:XMLLiteral;
                 rdfs:subClassOf <http://purl.org/dc/terms/Collection>,
                                 <http://purl.org/media/media#Recording>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:Recording a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A recording of an item of interest in any form."@en;
                rdfs:label """<a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://purl.org/media#Recording\" xml:lang=\"en\">media:Recording</a>"""^^rdf:XMLLiteral;
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:contains a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment """Relationship for
            linking singular media recordings to collections or media recordings. Also used to denote pieces of a media recording that constitute a larger media recording.."""@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:depiction a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment """An image summary
            of the media recording."""@en;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:download a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment """A link to a
            complete audio file representation of the media recording."""@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:duration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment """The length of the
            media recording encoded in ISO-8601 time duration format."""@en;
               rdfs:range xsd:duration;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:position a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment """The position of
            the media recording in an album, LP, playlist, top 10 list,
            podcast history or other ordered list of media recordings."""@en;
               rdfs:range xsd:integer;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
media:rating a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment """A standards-body
            rating such as PG-13, M, 18-SX, 15, AV15+, Explicit Lyrics, 
            etc."""@en;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
media:sample a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment """A link to a
            sample file or stream of the media recording."""@en;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
<http://purl.org/media/audio> <http://www.w3.org/2002/07/owl#imports> <http://purl.org/dc/terms/>,
                                                                      <http://www.w3.org/1999/xhtml/vocab#>.
<http://www.w3.org/1999/xhtml/vocab#license> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                             rdfs:comment """The license under
            which the media recording is distributed."""@en;
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en.
