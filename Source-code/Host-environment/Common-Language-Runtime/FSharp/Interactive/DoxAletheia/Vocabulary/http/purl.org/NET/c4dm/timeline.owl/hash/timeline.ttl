timeline:timeline a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment """
	Relates an interval or an instant to the timeline on which it is defined.

	The 29th of August, 2007 would be linked through this property to the universal timeline, whereas
	\"from 2s to 5s on this particular signal\" would be defined on the signal' timeline.

    """;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (timeline:Instant
                                                                        timeline:Interval) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:label "on timeline";
                  rdfs:range timeline:TimeLine;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
timeline:universaltimeline <http://purl.org/dc/elements/1.1/description> """The timeline one can addresss \"the 1st of July, 2007\"""";
                           <http://purl.org/dc/elements/1.1/title> "the universal time line";
                           a timeline:PhysicalTimeLine;
                           rdfs:comment "this is the `universal' time line -- can adress time intervals on it using date/dateTime -- UTC";
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
timeline:windowLength a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "window length, associated to a uniform windowing map";
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (timeline:UniformWindowingMap
                                                                            timeline:UniformSamplingWindowingMap) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "window length";
                      rdfs:range xsd:int;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
