@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix attack: <http://w3id.org/sepses/vocab/ref/attack#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix w3id: <https://w3id.org/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
<http://w3id.org/sepses/vocab/ref/attack> dc11:creator "Kabul Kurniawan";
                                          dc11:description """An ontology to represent MITRE ATT & CK.
This ontology is developed based on the MITRE ATT & CK  (https://attack.mitre.org/)"""@en;
                                          dc11:rights "http://creativecommons.org/licenses/by/4.0/";
                                          dc11:title "MITRE ATT&CK Ontology";
                                          vann:preferredNamespacePrefix "attack";
                                          a owl:Ontology;
                                          owl:versionIRI <https://w3id.org/sepses/vocab/ref/attack/2.0.0>.
attack:AdversaryGroup a owl:Class;
                      rdfs:label "AdversaryGroup";
                      rdfs:subClassOf owl:Thing.
attack:Asset a owl:Class;
             rdfs:label "Asset";
             rdfs:subClassOf owl:Thing.
attack:Campaign a owl:Class;
                rdfs:label "Campaign";
                rdfs:subClassOf owl:Thing.
attack:DataComponent a owl:Class;
                     rdfs:label "DataComponent";
                     rdfs:subClassOf owl:Thing.
attack:DataSource a owl:Class;
                  rdfs:label "DataSource";
                  rdfs:subClassOf owl:Thing.
attack:Malware a owl:Class;
               rdfs:label "Malware";
               rdfs:subClassOf attack:Software,
                               owl:Thing.
attack:Mitigation a owl:Class;
                  rdfs:label "Mitigation";
                  rdfs:subClassOf owl:Thing.
attack:Reference a owl:Class;
                 rdfs:label "Reference";
                 rdfs:subClassOf owl:Thing.
attack:Software a owl:Class;
                rdfs:label "Software";
                rdfs:subClassOf owl:Thing.
attack:SubTechnique a owl:Class;
                    rdfs:label "SubTechnique";
                    rdfs:subClassOf attack:Technique,
                                    owl:Thing.
attack:Tactic a owl:Class;
              rdfs:label "Tactic";
              rdfs:subClassOf owl:Thing.
attack:Technique a owl:Class;
                 rdfs:label "Technique";
                 rdfs:subClassOf owl:Thing.
attack:accomplishesTactic a owl:ObjectProperty;
                          rdfs:domain attack:Technique;
                          rdfs:label "accomplishesTactic";
                          rdfs:range attack:Tactic.
attack:aliases a owl:DatatypeProperty;
               rdfs:domain attack:AdversaryGroup;
               rdfs:label "aliases";
               rdfs:range xsd:string.
attack:associatedGroup a owl:ObjectProperty;
                       rdfs:domain attack:Technique;
                       rdfs:label "associatedGroup";
                       rdfs:range attack:AdversaryGroup.
attack:dataSource a owl:DatatypeProperty;
                  rdfs:domain attack:Technique;
                  rdfs:label "dataSource";
                  rdfs:range xsd:string.
attack:detection a owl:DatatypeProperty;
                 rdfs:domain attack:Technique;
                 rdfs:label "detection";
                 rdfs:range xsd:string.
attack:hasAdversaryGroup a owl:ObjectProperty;
                         rdfs:domain attack:Malware;
                         rdfs:label "hasAdversaryGroup";
                         rdfs:range attack:AdversaryGroup.
attack:hasCAPEC a owl:ObjectProperty;
                rdfs:domain attack:Technique;
                rdfs:label "hasCAPEC";
                rdfs:range <http://w3id.org/sepses/vocab/ref/capec#CAPEC>.
attack:hasMitigation a owl:ObjectProperty;
                     rdfs:domain attack:Technique;
                     rdfs:label "hasMitigation";
                     rdfs:range attack:Mitigation.
attack:hasReference a owl:ObjectProperty;
                    rdfs:domain attack:Technique;
                    rdfs:label "hasReference";
                    rdfs:range attack:Reference.
attack:hasSoftware a owl:ObjectProperty;
                   rdfs:domain attack:Technique;
                   rdfs:label "hasSoftware";
                   rdfs:range attack:Software.
attack:hasTechnique a owl:ObjectProperty;
                    rdfs:domain attack:Tactic;
                    rdfs:label "hasTechnique";
                    rdfs:range attack:Technique.
attack:implementsTechnique a owl:ObjectProperty;
                           rdfs:domain attack:Malware;
                           rdfs:label "implementsTechnique";
                           rdfs:range attack:Technique.
attack:isSubTechniqueOf a owl:ObjectProperty;
                        rdfs:domain attack:Technique;
                        rdfs:label "isSubTechniqueOf";
                        rdfs:range attack:Technique.
attack:isSubtechnique a owl:DatatypeProperty;
                      rdfs:domain attack:Technique;
                      rdfs:label "isSubtechnique";
                      rdfs:range xsd:boolean.
attack:permissionRequired a owl:DatatypeProperty;
                          rdfs:domain attack:Technique;
                          rdfs:label "permissionRequired";
                          rdfs:range xsd:string.
attack:platform a owl:DatatypeProperty;
                rdfs:domain attack:Technique;
                rdfs:label "platform";
                rdfs:range xsd:string.
attack:preventsTechnique a owl:ObjectProperty;
                         rdfs:domain attack:Mitigation;
                         rdfs:label "preventsTechnique";
                         rdfs:range attack:Technique.
attack:referenceDescription a owl:DatatypeProperty;
                            rdfs:domain attack:Reference;
                            rdfs:label "referenceDescription";
                            rdfs:range xsd:string.
attack:referenceId a owl:DatatypeProperty;
                   rdfs:domain attack:Reference;
                   rdfs:label "referenceId";
                   rdfs:range xsd:string.
attack:referenceName a owl:DatatypeProperty;
                     rdfs:domain attack:Reference;
                     rdfs:label "referenceName";
                     rdfs:range xsd:string.
attack:referenceUrl a owl:DatatypeProperty;
                    rdfs:domain attack:Reference;
                    rdfs:label "referenceUrl";
                    rdfs:range xsd:string.
attack:targetsAsset a owl:ObjectProperty;
                    rdfs:domain attack:Technique;
                    rdfs:label "targetsAsset";
                    rdfs:range attack:Asset.
attack:usesMalware a owl:ObjectProperty;
                   rdfs:domain attack:AdversaryGroup;
                   rdfs:label "usesMalware";
                   rdfs:range attack:Malware.
attack:usesSoftware a owl:ObjectProperty;
                    rdfs:domain attack:AdversaryGroup;
                    rdfs:label "usesSoftware";
                    rdfs:range attack:Software.
attack:usesTechnique a owl:ObjectProperty;
                     rdfs:domain attack:AdversaryGroup;
                     rdfs:label "usesTechnique";
                     rdfs:range attack:Technique.
<http://w3id.org/sepses/vocab/ref/capec#CAPEC> a owl:Class.
