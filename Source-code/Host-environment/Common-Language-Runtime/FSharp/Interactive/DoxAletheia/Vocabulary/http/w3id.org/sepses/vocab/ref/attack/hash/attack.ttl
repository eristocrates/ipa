@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix attack: <http://w3id.org/sepses/vocab/ref/attack#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/sepses/vocab/ref/attack> <http://purl.org/dc/elements/1.1/creator> "Kabul Kurniawan";
                                          <http://purl.org/dc/elements/1.1/description> """An ontology to represent MITRE ATT & CK.
This ontology is developed based on the MITRE ATT & CK  (https://attack.mitre.org/)"""@en;
                                          <http://purl.org/dc/elements/1.1/rights> "http://creativecommons.org/licenses/by/4.0/";
                                          <http://purl.org/dc/elements/1.1/title> "MITRE ATT&CK Ontology";
                                          <http://purl.org/vocab/vann/preferredNamespacePrefix> "attack";
                                          a <http://www.w3.org/2002/07/owl#Ontology>;
                                          <http://www.w3.org/2002/07/owl#versionIRI> <https://w3id.org/sepses/vocab/ref/attack/2.0.0>.
attack:AdversaryGroup a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "AdversaryGroup";
                      rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Asset a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Asset";
             rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Campaign a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Campaign";
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:DataComponent a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "DataComponent";
                     rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:DataSource a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "DataSource";
                  rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Malware a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Malware";
               rdfs:subClassOf attack:Software,
                               <http://www.w3.org/2002/07/owl#Thing>.
attack:Mitigation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Mitigation";
                  rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Reference a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Reference";
                 rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Software a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Software";
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:SubTechnique a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "SubTechnique";
                    rdfs:subClassOf attack:Technique,
                                    <http://www.w3.org/2002/07/owl#Thing>.
attack:Tactic a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Tactic";
              rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:Technique a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Technique";
                 rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
attack:accomplishesTactic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain attack:Technique;
                          rdfs:label "accomplishesTactic";
                          rdfs:range attack:Tactic.
attack:aliases a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain attack:AdversaryGroup;
               rdfs:label "aliases";
               rdfs:range xsd:string.
attack:associatedGroup a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain attack:Technique;
                       rdfs:label "associatedGroup";
                       rdfs:range attack:AdversaryGroup.
attack:dataSource a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain attack:Technique;
                  rdfs:label "dataSource";
                  rdfs:range xsd:string.
attack:detection a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain attack:Technique;
                 rdfs:label "detection";
                 rdfs:range xsd:string.
attack:hasAdversaryGroup a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain attack:Malware;
                         rdfs:label "hasAdversaryGroup";
                         rdfs:range attack:AdversaryGroup.
attack:hasCAPEC a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain attack:Technique;
                rdfs:label "hasCAPEC";
                rdfs:range <http://w3id.org/sepses/vocab/ref/capec#CAPEC>.
attack:hasMitigation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain attack:Technique;
                     rdfs:label "hasMitigation";
                     rdfs:range attack:Mitigation.
attack:hasReference a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain attack:Technique;
                    rdfs:label "hasReference";
                    rdfs:range attack:Reference.
attack:hasSoftware a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain attack:Technique;
                   rdfs:label "hasSoftware";
                   rdfs:range attack:Software.
attack:hasTechnique a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain attack:Tactic;
                    rdfs:label "hasTechnique";
                    rdfs:range attack:Technique.
attack:implementsTechnique a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain attack:Malware;
                           rdfs:label "implementsTechnique";
                           rdfs:range attack:Technique.
attack:isSubTechniqueOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain attack:Technique;
                        rdfs:label "isSubTechniqueOf";
                        rdfs:range attack:Technique.
attack:isSubtechnique a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain attack:Technique;
                      rdfs:label "isSubtechnique";
                      rdfs:range xsd:boolean.
attack:permissionRequired a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain attack:Technique;
                          rdfs:label "permissionRequired";
                          rdfs:range xsd:string.
attack:platform a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain attack:Technique;
                rdfs:label "platform";
                rdfs:range xsd:string.
attack:preventsTechnique a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain attack:Mitigation;
                         rdfs:label "preventsTechnique";
                         rdfs:range attack:Technique.
attack:referenceDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:domain attack:Reference;
                            rdfs:label "referenceDescription";
                            rdfs:range xsd:string.
attack:referenceId a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain attack:Reference;
                   rdfs:label "referenceId";
                   rdfs:range xsd:string.
attack:referenceName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain attack:Reference;
                     rdfs:label "referenceName";
                     rdfs:range xsd:string.
attack:referenceUrl a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain attack:Reference;
                    rdfs:label "referenceUrl";
                    rdfs:range xsd:string.
attack:targetsAsset a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain attack:Technique;
                    rdfs:label "targetsAsset";
                    rdfs:range attack:Asset.
attack:usesMalware a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain attack:AdversaryGroup;
                   rdfs:label "usesMalware";
                   rdfs:range attack:Malware.
attack:usesSoftware a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain attack:AdversaryGroup;
                    rdfs:label "usesSoftware";
                    rdfs:range attack:Software.
attack:usesTechnique a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain attack:AdversaryGroup;
                     rdfs:label "usesTechnique";
                     rdfs:range attack:Technique.
<http://w3id.org/sepses/vocab/ref/capec#CAPEC> a <http://www.w3.org/2002/07/owl#Class>.
