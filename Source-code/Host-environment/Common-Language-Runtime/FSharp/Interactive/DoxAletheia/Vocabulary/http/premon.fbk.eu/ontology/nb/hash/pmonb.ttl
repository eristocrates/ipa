@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pmonb: <http://premon.fbk.eu/ontology/nb#>.

<http://premon.fbk.eu/ontology/nb> <http://purl.org/dc/terms/creator> "Francesco Corcoglioniti",
                                                                      "Marco Rospocher <https://dkm.fbk.eu/rospocher>";
                                   <http://purl.org/dc/terms/description> <http://premon.fbk.eu/images/nb.svg>,
                                                                          """The NomBank module of the PreMOn ontology defines [pmonb:Roleset](http://premon.fbk.eu/ontology/nb#Roleset) and [pmonb:SemanticRole](http://premon.fbk.eu/ontology/nb#SemanticRole) as subclasses of [pmo:SemanticClass](http://premon.fbk.eu/ontology/core#SemanticClass) and [pmo:SemanticRole](http://premon.fbk.eu/ontology/core#SemanticRole), respectively.

Each [pmonb:SemanticRole](http://premon.fbk.eu/ontology/nb#SemanticRole) instance is related (via property [pmonb:argument](http://premon.fbk.eu/ontology/nb#argument)) to exactly one [pmonb:Argument](http://premon.fbk.eu/ontology/nb#Argument), which is defined as the disjoint union of two subclasses: 

* [pmonb:NumberedArgument](http://premon.fbk.eu/ontology/nb#NumberedArgument), containing the individuals corresponding to numbered argument (e.g., *Arg0*, *Arg1*); and, 
* [pmonb:Modifier](http://premon.fbk.eu/ontology/nb#Modifier), containing the individuals corresponding to modifiers (e.g., *ArgM-LOC*, *ArgM-TMP*).

We also define class [pmonb:Tag](http://premon.fbk.eu/ontology/nb#Tag) to capture (via property [pmonb:tag](http://premon.fbk.eu/ontology/nb#tag)) some specific annotations of markables (e.g., *PRD*, *REF*, *SUPPORT*) in the examples."""@en;
                                   <http://purl.org/dc/terms/issued> "2015-10-28"^^xsd:date;
                                   <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-sa/4.0/>;
                                   <http://purl.org/dc/terms/modified> "2017-05-01"^^xsd:date;
                                   <http://purl.org/dc/terms/publisher> "DKM, Fondazione Bruno Kessler <http://dkm.fbk.eu/>";
                                   <http://purl.org/dc/terms/rights> "This ontology is licensed under CC-BY-SA <http://creativecommons.org/licenses/by-sa/4.0/>"@en;
                                   <http://purl.org/dc/terms/title> "Predicate Model for Ontologies (PreMOn) - NomBank ontology module"@en;
                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "pmonb";
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://premon.fbk.eu/ontology/nb#";
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment "The NomBank module of the PreMOn ontology extends the core module for representing concepts specific to NomBank. The modelling is based on the [NomBank Specifications](http://nlp.cs.nyu.edu/meyers/nombank/nombank-specs-2007.pdf)."@en;
                                   rdfs:isDefinedBy <http://premon.fbk.eu/ontology/nb.ttl>;
                                   <http://www.w3.org/2002/07/owl#imports> <http://premon.fbk.eu/ontology/core>,
                                                                           <http://www.w3.org/ns/lemon/ontolex>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "2017a".
pmonb:Argument a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Argument (NB)"@en;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (pmonb:Modifier
                                                                                                         pmonb:NumberedArgument) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
pmonb:Modifier a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Modifier (NB)"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#oneOf> (pmonb:argm-cau
                                                                       pmonb:argm-tmp
                                                                       pmonb:argm-dis
                                                                       pmonb:argm-dir
                                                                       pmonb:argm-prd
                                                                       pmonb:argm-ext
                                                                       pmonb:argm-mnr
                                                                       pmonb:argm-loc
                                                                       pmonb:argm-neg
                                                                       pmonb:argm-pnc
                                                                       pmonb:argm-adv) ; 
                                a <http://www.w3.org/2002/07/owl#Class>],
                               pmonb:Argument;
               <http://www.w3.org/2002/07/owl#disjointWith> pmonb:NumberedArgument.
pmonb:NumberedArgument a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Numbered Argument (NB)"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#oneOf> (pmonb:arg5
                                                                               pmonb:arg4
                                                                               pmonb:arg3
                                                                               pmonb:arg2
                                                                               pmonb:arg1
                                                                               pmonb:arg0) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>],
                                       pmonb:Argument.
pmonb:Roleset a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Roleset (NB)"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://premon.fbk.eu/ontology/core#semRole> ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> pmonb:SemanticRole ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://premon.fbk.eu/ontology/core#SemanticClass>.
pmonb:SemanticRole a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Semantic Role (NB)"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> pmonb:Argument ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> pmonb:argument ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> <http://premon.fbk.eu/ontology/core#semRole>] ; 
                                    <http://www.w3.org/2002/07/owl#allValuesFrom> pmonb:Roleset ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://premon.fbk.eu/ontology/core#SemanticRole>.
pmonb:Tag a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Tag"@en.
pmonb:arg0 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:arg1 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:arg2 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:arg3 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:arg4 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:arg5 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             pmonb:NumberedArgument.
pmonb:argm-adv a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-cau a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-dir a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-dis a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-ext a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-loc a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-mnr a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-neg a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-pnc a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-prd a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argm-tmp a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 pmonb:Modifier.
pmonb:argument a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain pmonb:SemanticRole;
               rdfs:label "argument"@en;
               rdfs:range pmonb:Argument.
pmonb:core a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Set to true if the semantic role explicitly occurs in a frame file"@en;
           rdfs:domain pmonb:SemanticRole;
           rdfs:label "core"@en;
           rdfs:range xsd:boolean.
pmonb:tag a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:label "tag"@en;
          rdfs:range pmonb:Tag.
pmonb:tag-prd a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                pmonb:Tag.
pmonb:tag-ref a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                pmonb:Tag.
pmonb:tag-support a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                    pmonb:Tag.
