                           rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
geospecies:PhylumConcept a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                         rdfs:label "PhylumConcept";
