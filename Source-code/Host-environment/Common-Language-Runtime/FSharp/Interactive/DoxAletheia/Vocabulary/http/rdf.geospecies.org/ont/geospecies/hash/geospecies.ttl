                            rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                            rdfs:label "Sex Undetermined".
geospecies:Sex_unknowable a <http://www.w3.org/2002/07/owl#NamedIndividual>,
