               rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
               rdfs:label "Sex";
               rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
geospecies:Sex_female <http://purl.org/dc/elements/1.1/description> "Female (♀) is the sex of an organism, or a part of an organism, which produces mobile ova (egg cells).";
                      a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        geospecies:Sex,
                        <http://www.w3.org/2002/07/owl#Thing>;
                      rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                      rdfs:label "female".
geospecies:Sex_hermaphrodite <http://purl.org/dc/elements/1.1/description> "one organism having both male and female sexual characteristics and organs; at birth an unambiguous assignment of male or female cannot be made";
                             a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                               geospecies:Sex,
                               <http://www.w3.org/2002/07/owl#Thing>;
                             rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                             rdfs:label "hermaphrodite".
geospecies:Sex_male <http://purl.org/dc/elements/1.1/description> "Male (♂) refers to the sex of an organism, or part of an organism, which produces small mobile gametes, called spermatozoa.";
                    a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      geospecies:Sex,
                      <http://www.w3.org/2002/07/owl#Thing>;
                    rdfs:isDefinedBy <http://rdf.geospecies.org/ont/geospecies.owl>;
                    rdfs:label "male".
