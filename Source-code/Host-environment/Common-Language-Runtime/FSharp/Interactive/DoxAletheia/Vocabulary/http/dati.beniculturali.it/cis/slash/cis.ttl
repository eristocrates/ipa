                                cis:CreativeWork;
                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                            "stable"@en.
cis:Booking <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Booking is the following:

<pre>

booking:Mandatory
    a cis:Booking , cis:AccessCondition ;
    rdfs:label \"Mandatory Booking\"@en ;
    rdfs:label \"Prenotazione obbligatoria\"@it ;
    cis:name \"Mandatory Booking\"@en ;
    cis:name \"Prenotazione obbligatoria\"@it ;
    cis:description \"Per accedere al luogo della cultura o evento è necessaria la prenotazione\"@it ;
    cis:description \"Booking is mandatory in order to access to the CIS or the event\"@en ;
    cis:accessConditionFor event:Vincenzo_Gemito_al_Museo_di_Capodimonte .

event:Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:Event ;
    cis:isHostedBy site:Museo_di_Capodimonte ;
    rdfs:label \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    cis:name \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    rdfs:comment \"Apre al pubblico al Museo di Capodimonte la mostra ‘Vincenzo Gemito, dal salotto Minozzi 
    al Museo di Capodimonte’,
    organizzata dalla Soprintendenza speciale per il patrimonio storico\" ;
    cis:involves culturalheritageobject:Il_giocatore_di_carte ;
    cis:hasSubEvent event:VincenzoGemitoIlPescatorello ;
    cis:hasAccessCondition booking:Mandatory ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

</pre>"""@en,
                                                          """Un esempio di uso della classe cis:Booking è il seguente:

<pre>

booking:Mandatory
    a cis:Booking , cis:AccessCondition ;
    rdfs:label \"Mandatory Booking\"@en ;
    rdfs:label \"Prenotazione obbligatoria\"@it ;
    cis:name \"Mandatory Booking\"@en ;
    cis:name \"Prenotazione obbligatoria\"@it ;
    cis:description \"Per accedere al luogo della cultura o evento è necessaria la prenotazione\"@it ;
    cis:description \"Booking is mandatory in order to access to the CIS or the event\"@en ;
    cis:accessConditionFor event:Vincenzo_Gemito_al_Museo_di_Capodimonte .

event:Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:Event ;
    cis:isHostedBy site:Museo_di_Capodimonte ;
    rdfs:label \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    cis:name \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    rdfs:comment \"Apre al pubblico al Museo di Capodimonte la mostra ‘Vincenzo Gemito, dal salotto 
    'Minozzi al Museo di Capodimonte’,
    organizzata dalla Soprintendenza speciale per il patrimonio storico\" ;
    cis:involves culturalheritageobject:Il_giocatore_di_carte ;
    cis:hasSubEvent event:VincenzoGemitoIlPescatorello ;
    cis:hasAccessCondition booking:Mandatory ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

</pre>"""@it;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "It represents the  type of booking for the cultural institute or site or for the event. Examples can be: Mandatory, Optional, None (free access)."@en,
                         "Rappresenta la tipologia di prenotazione per l'istituto e luogo della cultura o per l'evento. Esempi possono essere: Obbligatoria, Facoltativa, Nessuna (ingresso libero)."@it;
            rdfs:label "Tipo prenotazione"@it,
                       "Type of Booking"@en;
            rdfs:subClassOf cis:AccessCondition,
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                             <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable"@en.
cis:CISType a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Questa classe rappresenta il tipo di istituto e luogo della cultura."@it,
                         "This class represents the type of cultural institute or site."@en;
            rdfs:isDefinedBy cis:;
            rdfs:label "Cultural Institute or Site Type"@en,
                       "Tipo di Istituto e Luogo della Cultura"@it;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                             <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                        "unstable"@en.
cis:Card <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Card is the following:

<pre>

card:Parco_archeologico_di_Liternum_Card
    a cis:Card ;
    rdfs:label \"Ingresso per due giorni al Parco archeologico di Liternum\"@it ; 
    rdfs:label \"Two-day access to Parco archeologico di Liternum\"@en ;
    cis:name \"Ingresso per due giorni al Parco archeologico di Liternum\"@it ; 
    cis:name \"Two-day access to the Parco archeologico di Liternum\"@en ;
    cis:hasValidity Parco_archeologico_di_Liternum_Card_Validity ;
    cis:forAccessTo cissite:Parco_archeologico_di_Liternum ;
    cis:description \"With this card a tourist can visit Parco archeologico di Liternum for 2 consecutive days\"@en ; 
    cis:description \"La card permette l'accesso al Parco archeologico di Liternum per 2 giorni consecutivi\"@it .

validity:Parco_archeologico_di_Liternum_Card_Validity
    a cis:Validity ;
    rdfs:label \"Two-day validity\"@en ;
    rdfs:label \"Validità per due giorni\"@it ;
    cis:hasDuration Parco_archeologico_di_Liternum_Card_Validity_Duration .
 
quantitativevalue:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\" ;
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit .

</pre>"""@en,
                                                       """Un esempio di utilizzo della classe cis:Card  è il seguente:

<pre>

card:Parco_archeologico_di_Liternum_Card
    a cis:Card ;
    rdfs:label \"Ingresso per due giorni al Parco archeologico di Liternum\"@it ; 
    rdfs:label \"Two-day access to Parco archeologico di Liternum\"@en ;
    cis:name \"Ingresso per due giorni al Parco archeologico di Liternum\"@it ; 
    cis:name \"Two-day access to the Parco archeologico di Liternum\"@en ;
    cis:hasValidity Parco_archeologico_di_Liternum_Card_Validity ;
    cis:forAccessTo cissite:Parco_archeologico_di_Liternum ;
    cis:description \"With this card a tourist can visit Parco archeologico di Liternum for 2 consecutive days\"@en ; 
    cis:description \"La card permette l'accesso al Parco archeologico di Liternum per 2 giorni consecutivi\"@it .

validity:Parco_archeologico_di_Liternum_Card_Validity
    a cis:Validity ;
    rdfs:label \"Two-day validity\"@en ;
    rdfs:label \"Validità per due giorni\"@it ;
    cis:hasDuration Parco_archeologico_di_Liternum_Card_Validity_Duration .
 
quantitativevalue:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\" ;
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit .

</pre>"""@it;
         a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "This class represents a card valid for the entrance to more than one Cultural Institute or Site. It is a subclass of Ticket."@en,
                      "Questa classe rappresenta una carta d'ingresso che dà diritto a più ingressi in più luoghi della cultura. E' sottoclasse di ticket."@it;
         rdfs:isDefinedBy cis:;
         rdfs:label "Card"@en,
                    "Carta d'ingresso"@it;
         rdfs:subClassOf cis:Ticket;
         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                     "stable"@en.
cis:Catalogue <http://purl.org/dc/elements/1.1/description> """A catalogue is always associated with an individual of the class 'CulturalInstituteOrSite' (CIS) by means of the object property hasCatalogue (with domain CulturalInstituteOrSite and range Catalogue).

The inverse property of hasCatalogue is isCatalogueOf and relates a catalogue to a CIS.

An example in turtle is the following:

<pre>
catalogue:Catalogo_Generale_(autore)
      a       cis:Catalogue ;
      rdfs:label \"Catalogo Generale (autore)\" ;
      cis:name \"Catalogo Generale (autore)\" ;
      cis:isCatalogueOf cissite:Biblioteca_nazionale_centrale ;
      cis:description \"Catalogo Generale per autore - online\"@it .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasCatalogue catalogue:Catalogo_Generale_(autore) .
</pre>"""@en,
                                                            <http://dati.beniculturali.it/cis/img/catalogue.png>,
                                                            """Un catalogo è sempre associato a un individuo della classe \"Istitute e luogo della cultura\" attraverso la proprietà ha catalogo (che ha dominio CulturaInstituteOrSite e codominio Catalogue).

La proprietà inversa di ha catalogo è \"è catalogo di\" e collega il catalogo all'istituto e luogo della cultura.

Un esempio in turtle è il seguente:

<pre>

catalogue:Catalogo_Generale_(autore)
      a       cis:Catalogue ;
      rdfs:label \"Catalogo Generale (autore)\" ;
      cis:name \"Catalogo Generale (autore)\" ;
      cis:isCatalogueOf cissite:Biblioteca_nazionale_centrale ;
      cis:description \"Catalogo Generale per autore - online\"@it .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasCatalogue catalogue:Catalogo_Generale_(autore) .

</pre>"""@it;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Concept used to represent the catalogue which describes the set of cultural heritage objects included in a Cultural Institute or Site"@en,
                           "Concetto utilizzato per rappresentare il catalogo che descrive l'insieme delle opere contenute in un istituto e luogo della cultura."@it;
              rdfs:isDefinedBy cis:;
              rdfs:label "Catalogue"@en,
                         "Catalogo"@it;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> cis:describes ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Collection ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                               <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> cis:isCatalogueOf ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> cis:CulturalInstituteOrSite ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> cis:hasWebSite ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable"@en.
cis:Cinema <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Cinema is the following:

<pre>

cissite:Cinema_Storico_Alberto_Sordi
    a cis:CulturalInstituteOrSite, cis:Cinema ;
    rdfs:label \"Cinema storico Alberto Sordi\" ;
    cis:institutionalName \"Cinema storico Alberto Sordi\" ;
    cis:ISILIdentifier \"IT-EX0003\" .

</pre>"""@en,
                                                         """Un esempio di utilizzo della classe cis:Cinema è il seguente:

<pre>

cissite:Cinema_Storico_Alberto_Sordi
    a cis:CulturalInstituteOrSite, cis:Cinema ;
    rdfs:label \"Cinema storico Alberto Sordi\" ;
    cis:institutionalName \"Cinema storico Alberto Sordi\" ;
    cis:ISILIdentifier \"IT-EX0003\" .

</pre>"""@it;
           a <http://www.w3.org/2002/07/owl#Class>,
             cis:CISType,
             <http://www.w3.org/2002/07/owl#NamedIndividual>;
           rdfs:comment "Questa classe rappresenta un istituto e luogo della cultura di tipo Cinema"@it,
                        "This class represents a cultural institute or site of type Cinema"@en;
           rdfs:isDefinedBy cis:;
           rdfs:label "Cinema"@en,
                      "Cinema"@it;
           rdfs:subClassOf cis:CulturalInstituteOrSite;
           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                            <http://www.w3.org/2002/07/owl#hasValue> cis:Cinema ; 
                                                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                       "non stabile"@it.
cis:ClericalAdministrativeArea <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:ClericalAdministrativeArea è il seguente

<pre>

caa:Diocesi_di_San_Marco_Argentano-Scalea
    a cis:ClericalAdministrativeArea ;
    rdfs:label \"Diocese of San Marco Argentano-Scalea\"@en ;
    rdfs:label \"Diocesi di San Marco Argentano-Scalea\"@it ;
    cis:toponym \"Diocesi di San Marco Argentano-Scalea\"@it ;
    cis:toponym \"Diocese of San Marco Argentano-Scalea\"@en ;
    cis:identifier \"SMA-CS\" .

</pre>"""@it,
                                                                             """An example of usage of the class cis:ClericalAdministrativeArea èil the following:

<pre>

caa:Diocesi_di_San_Marco_Argentano-Scalea
    a cis:ClericalAdministrativeArea ;
    rdfs:label \"Diocese of San Marco Argentano-Scalea\"@en ;
    rdfs:label \"Diocesi di San Marco Argentano-Scalea\"@it ;
    cis:toponym \"Diocesi di San Marco Argentano-Scalea\"@it ;
    cis:toponym \"Diocese of San Marco Argentano-Scalea\"@en ;
    cis:identifier \"SMA-CS\" .

</pre>"""@en;
                               a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Questa classe rappresenta un'area amministrativa territoriale ecclesiastica. Essa include le diocesi, parrocchie, ecc."@it,
                                            "This class represents the clerical administrative area. It can be used to represents Diocese, Parish, etc."@en;
                               rdfs:isDefinedBy cis:;
                               rdfs:label "Area amministrativa ecclesiastica"@it,
                                          "Clerical Administrative Area"@en;
                               rdfs:subClassOf cis:GeographicalFeature,
                                               [<http://www.w3.org/2002/07/owl#onProperty> cis:identifier ; 
                                                <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>];
                               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                           "stable"@en.
cis:Collection <http://purl.org/dc/elements/1.1/description> """Individuals of this class represent cultural heritage included in a Cultural Institute or Site.

A Cultural Institute or Site can be related to a collection by means of the object property hasCollection.

Additionally, a collection can be composed of items that, in turn, can be individuals of the class 'Collection' or the class 'Cultural Heritage Object'.

For example, this allows to assert that the Biblioteca Centrale di Roma has its own cultural heritage (e.g,, Patrimonio di Biblioteca Centrale di Roma). This cultural heritage is composed of different items, e.g., Archivio Capizucchi, Fondo Ceccarius, etc.

This can be modelled by using turtle in the following way:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasCollection collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma .

collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Collection ;
      rdfs:label \"Patrimonio di: Biblioteca nazionale centrale di Roma\" ;
      cis:hasMember collezioni:Archivio_Capizucchi, collezioni:Fondo_Ceccarius .


collezioni:Archivio_Capizucchi
      a       cis:Collection ;
      rdfs:label \"Archivio Capizucchi\" ;
      cis:isMemberOf collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:description \"materiale documentario relativo alla famiglia Capizucchi\"@it .


collezioni:Fondo_Ceccarius
      a       cis:Collection ;
      rdfs:label \"Fondo Ceccarius\" ;
      cis:isMemberOf collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:description \"volumi, opuscoli, articoli e fotografie della biblioteca di G. Ceccarelli\"@it .


</pre>"""@en,
                                                             """Individui di questa classe rappresentano il patrimonio culturale incluso in un Istituto e luogo della cultural.

Un Istituto e luogo della cultural è relazionato a una collezione attraverso la proprietà \"ha collezione\".

Inoltre, una collezione può essere composta da elementi che a loro volta possono essere individui della classe \"Collezione\" o della classe \"Oggetto culturale\".

L'esempio sotto riportato permette di asserire che la Biblioteca Centrale di Roma ha il proprio patrimonio (e..g, Patrimonio della Biblioteca Centrale di Roma). Questo patrimonio culturale è formato da diversi elementi, e.g., Archivio Cpizucchi, Fondo Ceccarius, ecc.

Nello specifico, questo può essere modellato in turtle come segue:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasCollection collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma .

collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Collection ;
      rdfs:label \"Patrimonio di: Biblioteca nazionale centrale di Roma\" ;
      cis:hasMember collezioni:Archivio_Capizucchi, collezioni:Fondo_Ceccarius .


collezioni:Archivio_Capizucchi
      a       cis:Collection ;
      rdfs:label \"Archivio Capizucchi\" ;
      cis:isMemberOf collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:description \"materiale documentario relativo alla famiglia Capizucchi\"@it .


collezioni:Fondo_Ceccarius
      a       cis:Collection ;
      rdfs:label \"Fondo Ceccarius\" ;
      cis:isMemberOf collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:description \"volumi, opuscoli, articoli e fotografie della biblioteca di G. Ceccarelli\"@it .


</pre>"""@it;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Rappresenta il patrimonio complessivo dell'Istituto e Luogo della Cultura o le singole collezioni di cui esso si compone."@it,
                            "It represents the cultural heritage included in a Cultural Institute or Site or single collections that compone the cultural heritage"@en;
               rdfs:isDefinedBy cis:;
               rdfs:label "Collection"@en,
                          "Collezione"@it;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:atTime ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> cis:TimeInterval ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> cis:hasMember ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cis:Collection
                                                                                                                        cis:CulturalHeritageObject) ; 
                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               cis:CulturalEntity,
                               [<http://www.w3.org/2002/07/owl#onProperty> cis:isDescribedBy ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Catalogue ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                           "stable"@en.
cis:ContactPoint <http://purl.org/dc/elements/1.1/description> """Gli individui delle classi Istituto e Luogo della Cultura, Evento e Sede possono avere dei punti di contatto, i.e., un numero di telefono, un indirizzo email, un fax, ecc. che sono utilizzati come riferimenti.

Inoltre, un pubto di contatto potrebbe essere dichiarato come operativo in alcune fasce orarie.

Queste informazioni sono modellate attraverso l'uso della proprietà ha punto di contatto il cui dominio può essere un Istituto e Luogo della Cultura, un Evento o una Sede e il suo range qualsiasi individuo della classe Punto di Contatto.

Per esempio, il fatto che la Biblioteca Nazionale Centrale di Roma ha un numero di telefono di riferimento, un numero di fax, un email come pure una PEC può essere descritto nel seguente modo in turtle:


<pre>

contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:ContactPoint ;
      rdfs:label \"Contatti di: Biblioteca nazionale centrale di Roma\"@it ;
      cis:available   openingHoursSpecification:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi ;
      cis:hasCertifiedEmail
              mailto:mbac-bnc-rm@mailcert.beniculturali.it ;
      cis:hasEmail mailto:bnc-rm@beniculturali.it ;
      cis:hasFax \"+39064457635  \" ;
      cis:hasTelephone \"+390649891\" .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma .

</pre>"""@it,
                                                               """Individuals of the classes CulturalInstituteOrSite, Event and Site may have a \"contact point\", i.e., a phone number, email address, fax, etc. that is used a reference contact.

Additionally, a cantact point might be also declared to be operative with respect to specific hopening hours.

This information is modelled into a knowledge base by using the object property hasContactPoint whose domain can be a CulturalInstituteOrSite, an Event or a Site, and its range is any indifvidual of the class ContactPoint.

For example, the fact that the Biblioteca Nazionale Centrale of Rome has  reference phone and fax number and a email as well as certified email contacts can be described in the following way by using turtle:

<pre>

contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:ContactPoint ;
      rdfs:label \"Contatti di: Biblioteca nazionale centrale di Roma\"@it ;
      cis:available   openingHoursSpecification:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi ;
      cis:hasCertifiedEmail
              mailto:mbac-bnc-rm@mailcert.beniculturali.it ;
      cis:hasEmail mailto:bnc-rm@beniculturali.it ;
      cis:hasFax \"+39064457635  \" ;
      cis:hasTelephone \"+390649891\" .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma .

</pre>"""@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "It represents a contact point which consists of phone numbers, e-mail addresses, web sites and their availability where applicable. We recommend the domain experts to specify better during the data production phase which type of contact point is in use (administrative contact point, tourist contact point, etc,)."@en,
                              "Rappresenta un punto di contatto (racchiude numeri di telefono, fax, indirizzi e-mail, siti web e relative disponibilità ove applicabili). Si raccomanda agli esperti di dominio di aver cura in fase di utilizzo di distinguere ulteriormente il tipo di punto di contatto (turistico, amministrativo, ecc)."@it;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "Punto di Contatto"@it,
                            "Contact Point"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:hasTelephone ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> cis:available ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> cis:OpeningHoursSpecification ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCertifiedEmail ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> cis:hasWebSite ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> cis:hasEmail ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> cis:hasFax ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                             "stable"@en.
cis:CreativeWork a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Concept used to represent all types of creative works such multimedia objects (audio, video, image files), bibliographic references, and different types of articles, that refer to and cite the Cultural Institute or Site"@en,
                              "Concetto utilizzato per rappresentare tutti quei materiali, multimediali (file audio, video), immagini), bibliografici, articoli di varia natura che si riferiscono e citano l'Istituto e Luogo della Cultura."@it;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "Creative Work"@en,
                            "Lavoro Creativo"@it;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:isAbout ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalEntity
                                                                                                                          cis:Event
                                                                                                                          cis:Site) ; 
                                                                                 a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it.
cis:CultReseachCenter <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:CultReseachCenter is the following:

<pre>

crc:Fondazione_Arnaldo_Pomodoro
    a cis:CultReseachCenter ;
    rdfs:label \"Fondazione Arnaldo Pomodoro\"@it ;
    rdfs:label \"Arnaldo Pomodoro Foundation\"@en ;
    cis:institutionalName \"Fondazione Arnaldo Pomodoro\"@it ;
    cis:institutionalName \"Arnaldo Pomodoro Foundation\"@en ;
    cis:ISILIdentifier \"IT-EX0005\" .

</pre>"""@en,
                                                                    """Un esempio di utilizzo della classe cis:CultReseachCenter è il seguente:

<pre>

crc:Fondazione_Arnaldo_Pomodoro
    a cis:CultReseachCenter ;
    rdfs:label \"Fondazione Arnaldo Pomodoro\"@it ;
    rdfs:label \"Arnaldo Pomodoro Foundation\"@en ;
    cis:institutionalName \"Fondazione Arnaldo Pomodoro\"@it ;
    cis:institutionalName \"Arnaldo Pomodoro Foundation\"@en ;
    cis:ISILIdentifier \"IT-EX0005\" .

</pre>"""@it;
                      a cis:CISType,
                        <http://www.w3.org/2002/07/owl#Class>,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>;
                      rdfs:comment "This class represents cultural institutions that form so-called cultural research and promotion centers."@en,
                                   "Questa classe rappresenta istituti culturali che costituiscono centri di ricerca e di promozione culturale."@it;
                      rdfs:isDefinedBy cis:;
                      rdfs:label "Cultural Reseach and Promotion Center"@en,
                                 "Centri di ricerca e promozione culturale"@it;
                      rdfs:subClassOf cis:CulturalInstituteOrSite;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                                       <http://www.w3.org/2002/07/owl#hasValue> cis:CultReseachCenter ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                                  "versione non definitiva"@it.
cis:CulturalEntity a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Class that provides a generalization of three classes; that is , cultural institute or site, collection and cultural heritage object. It does not correspond to a concept used typically in the cultural domain but it is used in order to model properties and property restrictions that are common to all the these three classes. The class will never be directly instanziated."@en,
                                "Classe che fornisce una generalizzazione per le tre classi di istituto e luogo della cultura,  collezione e oggetto culturale. Non corrisponde ad un concetto usato normalmente nel linguaggio del dominio, ma risponde all'esigenza di modellare proprietà e assiomi di property-restriction comuni ad ognuna di queste tre classi. La classe CulturalEntity non sarà mai istanziata direttamente"@it;
                   rdfs:isDefinedBy cis:;
                   rdfs:label "Cultural Entity"@en,
                              "Entità culturale"@it;
                   <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                               "stabile"@it.
cis:CulturalHeritageObject <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:CulturalHeritageObject iè il seguente:

<pre>

culturalheritageobject:Nascita_di_Venere
    a cis:CulturalHeritageObject ;
    rdfs:label \"Nascita di Venere\"@it ;;
    cis:name \"Nascita di Venere\"@it ;
    cis:isInSite site:Palazzo_degli_uffizi .

</pre>"""@it,
                                                                         """An example of usage of the class cis:CulturalHeritageObject is the following:

<pre>

culturalheritageobject:Nascita_di_Venere
    a cis:CulturalHeritageObject ;
    rdfs:label \"Nascita di Venere\"@it ;;
    cis:name \"Nascita di Venere\"@it ;
    cis:isInSite site:Palazzo_degli_uffizi .

</pre>"""@en;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "It represents a cultural asset (even intagible) of the cultural heritage."@en,
                                        "Rappresenta un bene, materiale o immateriale, del patrimonio culturale."@it;
                           rdfs:isDefinedBy cis:;
                           rdfs:label "Cultural Heritage Object"@en,
                                      "Oggetto Culturale"@it;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           cis:CulturalEntity,
                                           [<http://www.w3.org/2002/07/owl#onProperty> cis:isInSite ; 
                                            <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Site ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                       "stable"@en.
cis:CulturalInstituteOrSite <http://purl.org/dc/elements/1.1/description> <http://dati.beniculturali.it/cis/img/cis.png>,
                                                                          """An example of usage of the class 'Cultural Institute or Site' is the following:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      rdfs:comment \"\"\"La Biblioteca Nazionale Centrale di Roma fu inaugurata il 14 marzo 1876 in un'ala del 
      monumentale Palazzo cinquecentesco del Collegio Romano, sede dell'antica Bibliotheca Secreta o Major dei Gesuiti, 
      che costituì il nucleo originario della nuova istituzione, cui si aggiunsero i fondi manoscritti e a stampa di 69 
      biblioteche conventuali devolute al Regno d'Italia dopo la soppressione delle corporazioni religiose di Roma 
      nel 1873. 
	  Cento anni dopo la Biblioteca venne trasferita nella nuova sede, all'interno della zona archeologica del 
	  Castro Pretorio, fra la Città universitaria e la Stazione Termini, realizzata su progetto degli architetti Massimo
      Castellazzi, Tullio Dell'Anese e Annibale Vitellozzi.\"\"\"@it ;
      rdfs:label \"Biblioteca nazionale centrale\"@it ;
      cis:ISILIdentifier \"IT-RM0267\"^^xsd:string ;
      cis:description \"\"\"La Biblioteca Nazionale Centrale di Roma fu inaugurata il 14 marzo 1876 in un'ala del 
      monumentale Palazzo cinquecentesco del Collegio Romano, sede dell'antica Bibliotheca Secreta o Major dei Gesuiti, 
      che costituì il nucleo originario della nuova istituzione, cui si aggiunsero i fondi manoscritti e a stampa di 69 
      biblioteche conventuali devolute al Regno d'Italia dopo la soppressione delle corporazioni religiose di Roma 
      nel 1873. Cento anni dopo la Biblioteca venne trasferita nella nuova sede, all'interno della zona archeologica 
      del Castro Pretorio, fra la Città universitaria e la Stazione Termini, realizzata su progetto degli architetti 
      Massimo Castellazzi, Tullio Dell'Anese e Annibale Vitellozzi.\"\"\"@it ;
      cis:hasAccessCondition
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_mercoledi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_lunedi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_martedi> , <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_venerdi> ;
      cis:hasCatalogue <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28topografico%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28titoli%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28autore%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28sistematico%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28soggetto%29> ;
      cis:hasCollection collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasNameInTime nameInTime:Biblioteca_Nazionale_Centrale ;
      cis:hasSite site:Sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:institutionalName
              \"Biblioteca Nazionale Centrale\"@it ;
      cis:providesService service:Connessione_WI-FI , service:Visite_guidate , service:ala_per_la_didattica ;
      owl:sameAs   <http://it.dbpedia.org/resource/Biblioteca_Nazionale_Centrale_di_Roma> ;
      cis:institutionalName \"\"Biblioteca nazionale centrale\"@it .

</pre>"""@en,
                                                                          """Un esempio di utilizzo della classe \"Istituto e Luogo della Cultura\" è il seguente:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      rdfs:comment \"La Biblioteca Nazionale Centrale di Roma fu inaugurata il 14 marzo 1876 in un'ala del 
      monumentale Palazzo cinquecentesco del Collegio Romano, sede dell'antica Bibliotheca Secreta o Major dei Gesuiti, 
      che costituì il nucleo originario della nuova istituzione, cui si aggiunsero i fondi manoscritti e a stampa di 69 
      biblioteche conventuali devolute al Regno d'Italia dopo la soppressione delle corporazioni religiose di Roma 
      nel 1873. 
	  Cento anni dopo la Biblioteca venne trasferita nella nuova sede, all'interno della zona archeologica del 
	  Castro Pretorio, fra la Città universitaria e la Stazione Termini, realizzata su progetto degli architetti Massimo
      Castellazzi, Tullio Dell'Anese e Annibale Vitellozzi.\"\"\"@it ;
      rdfs:label \"Biblioteca nazionale centrale\"@it ;
      cis:ISILIdentifier \"IT-RM0267\"^^xsd:string ;
      cis:description \"\"La Biblioteca Nazionale Centrale di Roma fu inaugurata il 14 marzo 1876 in un'ala del 
      monumentale Palazzo cinquecentesco del Collegio Romano, sede dell'antica Bibliotheca Secreta o Major dei Gesuiti, 
      che costituì il nucleo originario della nuova istituzione, cui si aggiunsero i fondi manoscritti e a stampa di 69 
      biblioteche conventuali devolute al Regno d'Italia dopo la soppressione delle corporazioni religiose di Roma 
      nel 1873. Cento anni dopo la Biblioteca venne trasferita nella nuova sede, all'interno della zona archeologica 
      del Castro Pretorio, fra la Città universitaria e la Stazione Termini, realizzata su progetto degli architetti 
      Massimo Castellazzi, Tullio Dell'Anese e Annibale Vitellozzi.\"\"\"@it ;
      cis:hasAccessCondition
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_mercoledi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_lunedi> , 
              <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_martedi> , <http://dati.beniculturali.it/cis/resource/OpeningHoursSpecification/Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_venerdi> ;
      cis:hasCatalogue <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28topografico%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28titoli%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28autore%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_%28sistematico%29> , <http://dati.beniculturali.it/cis/resource/Catalogue/Catalogo_Generale_(soggetto)> ;
      cis:hasCollection collezioni:Patrimonio_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasNameInTime nameInTime:Biblioteca_Nazionale_Centrale ;
      cis:hasSite site:Sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:institutionalName
              \"Biblioteca Nazionale Centrale\"@it ;
      cis:providesService service:Connessione_WI-FI , service:Visite_guidate , service:ala_per_la_didattica ;
      owl:sameAs <http://it.dbpedia.org/resource/Biblioteca_Nazionale_Centrale_di_Roma> ;
       cis:institutionalName \"Biblioteca nazionale centrale\"@it .

</pre>"""@it;
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Sono istituti e luoghi della cultura i musei, le biblioteche e gli archivi, le aree e i parchi archeologici, i complessi monumentali. Gli istituti e luoghi e della cultura che appartengono a soggetti pubblici sono destinati alla pubblica fruizione ed espletano un servizio pubblico. Le strutture espositive e di consultazione nonché i luoghi della cultura che appartengono a soggetti privati e sono aperti al pubblico espletano un servizio privato di utilità sociale."@it,
                                         "The class Cultural Institute or Site represents museums, libraries, archive holders, archaeologic areas and parks, monumental areas. The cultural institutes of sites that are owned by public bodies are meant to offer public services. The cultural institutes or sites that are owned by private subjects, and are open to the public, offer a public and societal service."@en;
                            rdfs:isDefinedBy cis:;
                            rdfs:label "Istituto e Luogo Della Cultura"@it,
                                       "Cultural Institute or Site"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCollection ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Collection ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:isInvolvedInProject ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Project ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasAccessCondition ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:AccessCondition ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:isSubjectOf ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:CreativeWork ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:catalogue ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Catalogue ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> cis:institutionalName ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasNameInTime ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:NameInTime ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            cis:CulturalEntity,
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:isPartOf ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:CulturalInstituteOrSite ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasTicket ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Ticket ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:providesService ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Service ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:makesAvailableEquipment ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Equipment ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:RoleInTime ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> cis:isRelatedToRiT ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasContactPoint ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:ContactPoint ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:ISILIdentifier ; 
                                             <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:CISType ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasDiscipline ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:SubjectDiscipline ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Site ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> cis:hasSite ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>];
                            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                        "stable"@en.
cis:CulturalLandscapeAsset <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:CulturalLandscapeAsset is the following:

<pre>

cissite:Costiera_Amalfitana
 a cis:CulturalInstituteOrSite, cis:CulturalLandscapeAsset ; 
    rdfs:label \"Costiera Amalfitana\"@it ;
    cis:institutionalName \"Costiera Amalfitana\"@en ;
    cis:ISILIdentifier \"IT-EX0004\" .

</pre>"""@en,
                                                                         """Un esempio di utilizzo della classe cis:CulturalLandscapeAsset è il seguente:

<pre>

cissite:Costiera_Amalfitana
 a cis:CulturalInstituteOrSite, cis:CulturalLandscapeAsset ; 
    rdfs:label \"Costiera Amalfitana\"@it ;
    cis:institutionalName \"Costiera Amalfitana\"@en ;
    cis:ISILIdentifier \"IT-EX0004\" .

</pre>"""@it;
                           a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                             <http://www.w3.org/2002/07/owl#Class>,
                             cis:CISType;
                           rdfs:comment "This class represents a specific types of cultural institute or site, i.e., the cultural landscape asset."@en,
                                        "Questa classe rappresenta uno specifico tipo di istituto e luogo della cultura, i.e., il bene paessaggistico così come definito dall'art. 136 del Codice dei Beni Culturali."@it;
                           rdfs:isDefinedBy cis:;
                           rdfs:label "Bene Paesaggistico"@it,
                                      "Cultural Landscape Asset"@en;
                           rdfs:subClassOf cis:CulturalInstituteOrSite;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                                            <http://www.w3.org/2002/07/owl#hasValue> cis:CulturalLandscapeAsset ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                                       "unstable"@en.
cis:Currency <http://purl.org/dc/elements/1.1/description> """Individuals of the this class represent currency instances (e.g., Euro, US Dollar, Pound, Australian Dollar, etc.); they are always associated with individuals of the class 'Price Specification'.

This allows modelling Price Specification as a a quantified value, where the value is expressed as an integer and it is quantified in terms of a currency

An example is the following:

<pre>

priceSpecification:Under18>
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo under 18 \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue
              \"5\"^^xsd:float .

cis:Euro a cis:Currency ;
      rdfs:label \"Euro\"@en, \"Euro\"@it .

</pre>"""@en,
                                                           """Individui di questa classe rappresentano le istanze di valuta (e.g., euro, dollaro americano, sterlina, ecc) e sono sempre associati a individui della classe \"Prezzo\".

Questo consente di modellare il prezzo come un valore quantitativo, dove il valore è espresso come un intero e è quantificato in termini di valura.

Un esempio è il seguente:

<pre>

priceSpecification:Under18>
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo under 18 \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue
              \"5\"^^xsd:float .

cis:Euro a cis:Currency ;
      rdfs:label \"Euro\"@en, \"Euro\"@it .

</pre>"""@it;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Questa classe rappresenta la valuta per i biglietti di ingresso agli eventi o luoghi della cultura. Nel nostro dominio è associata alla descrizione del prezzo per i biglietti. Assume valori specifici (e.g., Euro)."@it,
                          "This class represents a currency. In our domain currency is typically associated with Price Specification for tickets, and assumes specific values (e.g., Euro)."@en;
             rdfs:isDefinedBy cis:;
             rdfs:label "Currency"@en,
                        "Valuta"@it;
             <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                         "stable"@en.
cis:Day a <http://www.w3.org/2002/07/owl#NamedIndividual>,
          cis:MeasurementUnit.
cis:DayOfWeek <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:DayOfTheWeek is the following:

<pre>

orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi
      a       cis:OpeningHoursSpecification ;
      rdfs:label \"Opening Hours of Biblioteca nazionale centrale di Roma - thursday\"@en , 
      \"Orari di apertura di Biblioteca nazionale centrale di Roma - giovedì\"@it ;
      cis:closes \"19:00:00\"^^xsd:time ;
      cis:hasAdmissionType addmissionType:Tipo_di_apertura_al_pubblico ;
      cis:hasDayOfWeek cis:Thursday ;
      cis:opens \"08:30:00\"^^xsd:time .

</pre>

For the complete example see the class cis:OpeningHoursSpecification"""@en,
                                                            <http://dati.beniculturali.it/cis/img/openingHoursSpecification.png>,
                                                            """Un esempio di utilizzo della classe cis:DayOfTheWeek è il seguente:

<pre>

orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi
      a       cis:OpeningHoursSpecification ;
      rdfs:label \"Opening Hours of Biblioteca nazionale centrale di Roma - thursday\"@en , 
      \"Orari di apertura di Biblioteca nazionale centrale di Roma - giovedì\"@it ;
      cis:closes \"19:00:00\"^^xsd:time ;
      cis:hasAdmissionType addmissionType:Tipo_di_apertura_al_pubblico ;
      cis:hasDayOfWeek cis:Thursday ;
      cis:opens \"08:30:00\"^^xsd:time .

</pre>

Per un esempio più completo si veda la classe cis:OpeningHoursSpecification"""@it;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents the set of all the days of the week."@en,
                           "Classe che rappresenta l'insieme dei giorni della settimana."@it;
              rdfs:isDefinedBy cis:;
              rdfs:label "Giorno della settimana "@it,
                         "Day of the Week"@en;
              <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                          "versione non definitiva"@it.
cis:Equipment <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Equipment is the following:

<pre>

equ:Photocopier 
    a cis:Equipment ;
    rdfs:label \"Photocopier\"@en ;
    rdfs:label \"Fotocopiatrice\"@it ;
    cis:name \"Photocopier\"@en ;
    cis:name \"Fotocopiatrice\"@it .

cissite:Biblioteca_nazionale_centrale cis:makesAvailableEquipment equ:Photocopier .

</pre>"""@en,
                                                            """Un esempio di utilizzo della classe cis:Equipment è il seguente:

<pre>

equ:Photocopier 
    a cis:Equipment ;
    rdfs:label \"Photocopier\"@en ;
    rdfs:label \"Fotocopiatrice\"@it ;
    cis:name \"Photocopier\"@en ;
    cis:name \"Fotocopiatrice\"@it .

cissite:Biblioteca_nazionale_centrale cis:makesAvailableEquipment equ:Photocopier .

</pre>"""@it;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Rappresenta l'attrezzatura resa disponibile dall'Istituto e luogo della cultura. Per esempio è un'attrezzatura un totem, ecc."@it,
                           "It represents the equipment made available by the Cultural Institute or Site. For instance, the equipment can be a totem, etc."@en;
              rdfs:isDefinedBy cis:;
              rdfs:label "Equipment"@en,
                         "Attrezzatura"@it;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                               <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable"@en.
cis:Euro a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           cis:Currency.
cis:Event <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:Event è il seguente:

<pre>

event:Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:Event;
    cis:isHostedBy site:Museo_di_Capodimonte;
    cis:name \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    rdfs:comment \"Apre al pubblico al Museo di Capodimonte la mostra ‘Vincenzo Gemito, dal salotto 
    Minozzi al Museo di Capodimonte’,
    organizzata dalla Soprintendenza speciale per il patrimonio storico\" ;
    cis:involves culturalheritageobject:Il_giocatore_di_carte ;
    cis:hasSubEvent event:Vincenzo_Gemito_Il_Pescatorello ;
    rdfs:label \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

event:Vincenzo_Gemito_Il_Pescatorello 
    a cis:Event ;
    cis:isHostedBy site:Museo_di_Capodimonte;
    rdfs:label \"Vincenzo Gemito, esposizione de Il Pescatorello\" ;
    cis:name \"Vincenzo Gemito, esposizione de Il Pescatorello&apos\" ;
    cis:involves culturalheritageobject:Il_Pescatorello ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte
    a cis:TimeInterval ;
    rdfs:label \"Intervallo di durata dell'evento 'Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte'\";
    cis:startDate \"2014-11-28T00:00:00\"^^xsd:dateTime;
    cis:endDate \"2015-07-16T00:00:00\"^^xsd:dateTime .

culturalheritageobject:Il_giocatore_di_carte
    a cis:CulturalHeritageObject ;
    rdfs:label \"Il giocatore di carte\" ;;
    cis:name \"l giocatore di carte\" ;
    cis:isInSite site:Museo_di_Capodimonte .

cultualheritageobject:Il_Pescatorello
    a cis:CulturalHeritageObject ;
    rdfs:label \"Il Pescatorello\" ;
    cis:name \"Il Pescatorello&quot\" ;
    cis:isInSite site:Museo_di_Capodimonte .

</pre>"""@it,
                                                        """An example of usage of the class cis:Event is the following:

<pre>

event:Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:Event;
    cis:isHostedBy site:Museo_di_Capodimonte;
    cis:name \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    rdfs:comment \"Apre al pubblico al Museo di Capodimonte la mostra ‘Vincenzo Gemito, dal salotto Minozzi 
    al Museo di Capodimonte’,
    organizzata dalla Soprintendenza speciale per il patrimonio storico\" ;
    cis:involves culturalheritageobject:Il_giocatore_di_carte ;
    cis:hasSubEvent event:Vincenzo_Gemito_Il_Pescatorello ;
    rdfs:label \"Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte\" ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

event:Vincenzo_Gemito_Il_Pescatorello 
    a cis:Event ;
    cis:isHostedBy site:Museo_di_Capodimonte;
    rdfs:label \"Vincenzo Gemito, esposizione de Il Pescatorello\" ;
    cis:name \"Vincenzo Gemito, esposizione de Il Pescatorello&apos\" ;
    cis:involves culturalheritageobject:Il_Pescatorello ;
    cis:takesPlaceDuring ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte .

ti:Durata_di_Vincenzo_Gemito_dal_salotto_Minozzi_al_Museo_di_Capodimonte
    a cis:TimeInterval ;
    rdfs:label \"Intervallo di durata dell'evento 'Vincenzo Gemito, dal salotto Minozzi al Museo di Capodimonte'\" ;
    cis:startDate \"2014-11-28T00:00:00\"^^xsd:dateTime;
    cis:endDate \"2015-07-16T00:00:00\"^^xsd:dateTime .

culturalheritageobject:Il_giocatore_di_carte
    a cis:CulturalHeritageObject ;
    rdfs:label \"Il giocatore di carte\" ;;
    cis:name \"l giocatore di carte\" ;
    cis:isInSite site:Museo_di_Capodimonte .

cultualheritageobject:Il_Pescatorello
    a cis:CulturalHeritageObject ;
    rdfs:label \"Il Pescatorello\" ;
    cis:name \"Il Pescatorello&quot\" ;
    cis:isInSite site:Museo_di_Capodimonte .

</pre>"""@en;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "it represents an event that typically is related to the cultural domain"@en,
                       "Rappresenta un evento culturale."@it;
          rdfs:isDefinedBy cis:;
          rdfs:label "Event"@en,
                     "Evento"@it;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Site ; 
                           <http://www.w3.org/2002/07/owl#onProperty> cis:isHostedBy ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> cis:hasSubEvent ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Event ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> cis:isSubEventOf ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Event ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:RoleInTime ; 
                           <http://www.w3.org/2002/07/owl#onProperty> cis:isRelatedToRiT ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> cis:hasTicket ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Ticket ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                           <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                      "stable"@en.
cis:Friday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             cis:DayOfWeek;
           rdfs:label "Friday"@en,
                      "Venerdì"@it.
cis:GeographicalFeature <http://purl.org/dc/elements/1.1/description> """Questa classe consente di descrivere un'area geografica. 

Le aree geografiche sono semrep associate a individui della classe Sede attraverso la proprietà ha locazione geografica (dominio Sede e codonimio Area Geografica).

Un area geografica è descritta dall'insieme di individui della classe geometria. Un individuo della classe geometria è descritto utilizzando le coordinate del sistema di riferimento come per esempio WGS84. E? univocamente identificata da latitudine e longitudine. Questo significa che un area geografica può essere un punto, una linea o un poligono. 

Per esempio, il seguente frammento di codice in turtle fornisce rappresenta un area geografica corrispondente alla sede della Biblioteca Centrale di Roma.

<pre>


site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      cis:hasGeographicalLocation
              geographicalArea:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:name \"Biblioteca nazionale centrale di Roma\"@it .

geographicalArea:Comune_di_Roma
      a       cis:GeographicalArea ;
      rdfs:label \"Comune di Roma\"@it ;
      cis:toponym \"Roma\" ;
      owl:sameAs      <http://spcdata.digitpa.gov.it/Comune/H501> , <http://datiopen.istat.it/odi/risorsa/territorio/comuni/Roma_58091> ;
      hasGeometry geometry:Comune_di_Roma .

geometry:Comune_di_Roma
      a       cis:Geometry ;
      geo:lat \"41.906784\" ;
      geo:long \"12.504962\" .
	
</pre>"""@it,
                                                                      <http://dati.beniculturali.it/cis/img/geographicalArea.png>,
                                                                      """This class allows describing a geographical area.
Geographical areas are always associated with individuals of the class 'Site' by means of the object property hasGeographicalLocation (domain Site and range 'Geographical Area').

A geographical area is described by a set of individuals of the class Geometry. A individual of the class Geometry is described by using a coordinate system related to Earth such as WGS84. It is univocally identified by lat/long. This means that a geographical area can be a point, a line or a polygon.

For example, the following snippet provides a turtle model that represents a Geographical Area corresponding to the Site of the Biblioteca Centrale di Roma.

<pre>


site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      cis:hasGeographicalLocation
              geographicalArea:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:name \"Biblioteca nazionale centrale di Roma\"@it .

geographicalArea:Comune_di_Roma
      a       cis:GeographicalArea ;
      rdfs:label \"Comune di Roma\"@it ;
      cis:toponym \"Roma\" ;
      owl:sameAs      <http://spcdata.digitpa.gov.it/Comune/H501> , <http://datiopen.istat.it/odi/risorsa/territorio/comuni/Roma_58091> ;
      hasGeometry geometry:Comune_di_Roma .

geometry:Comune_di_Roma
      a       cis:Geometry ;
      geo:lat \"41.906784\" ;
      geo:long \"12.504962\" .
	
</pre>"""@en;
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Rappresenta una caratteristica  geografica. Può essere usata per rappresentare un comune, o un'area che ricomprendere diverse aree ammistrative."@it,
                                     "It represents a geographical feature. It can be used to model a municipality or an area across different administrative areas."@en;
                        rdfs:isDefinedBy cis:;
                        rdfs:label "Area Geografica"@it,
                                   "Geographical Area"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> cis:toponym ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#onProperty> cis:hasGeometry ; 
                                         <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Geometry ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>];
                        <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                    "stabile"@it.
cis:Geometry <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Geometry is the following:
<pre>

geometry:Museo_di_Capodimonte_Geometry
      a       cis:Geometry ;
      rdfs:label \"Coordinate geografiche della sede di Museo di Capodimonte\"@it;
      cis:hasLat \"40.867424\" ;
      cis:geometryType \"Point\";
      cis:geoMethodology \"Satellite data georeferentiation\" ;
      cis:hasLong \"14.249192\".

</pre>

For a complete example refer to the class cis:GeographicalFeature"""@en,
                                                           """Un esempio di utilizzo della classe cis:Geomery è il seguente:
<pre>

geometry:Museo_di_Capodimonte_Geometry
      a       cis:Geometry ;
      rdfs:label \"Coordinate geografiche della sede di Museo di Capodimonte\"@it;
      cis:hasLat \"40.867424\" ;
      cis:geometryType \"Point\";
      cis:geoMethodology \"Satellite data georeferentiation\" ;
      cis:hasLong \"14.249192\".

</pre>

Per un esempio complete si veda la classe cis:GeographicalFeature"""@it;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "It represents a geometry which is typically described by using a coordinate system related to Earth such as WGS84. It is univocally identified by lat/long"@en,
                          "Rappresenta una geometria tipicamente descritto utilizzando un sistema di coordinate geografiche come per esempio WGS84. Univocamente identificato da Lat/Long"@it;
             rdfs:isDefinedBy cis:;
             rdfs:label "Geometria"@it,
                        "Geometry"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:geoMethodology ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#onProperty> cis:hasLat ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#onProperty> cis:hasLong ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:decimal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#onProperty> cis:geometryType ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                         "stabile"@it.
cis:GovernamentalAdministrativeArea <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:GovernamentalAdministrativeArea è il seguente:
<pre>

gaa:Lazio
    a cis:GovernamentalAdministrativeArea ;
    rdfs:\"Lazio\";;
    cis:toponym \"Lazio\";;
    cis:hasISTATCode \"12\" .

</pre>"""@it,
                                                                                  """An example of usage of the class cis:GovernamentalAdministrativeArea is the following:

<pre>

gaa:Lazio
    a cis:GovernamentalAdministrativeArea ;
    rdfs:label \"Lazio\" ;
    cis:toponym \"Lazio\" ;
    cis:hasISTATCode \"12\" .

</pre>"""@en;
                                    a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "This class represents an administrative geographical area that is typically managed by a public body. It can be a Region, a Municipality, a Province, a sub-municipality area, etc."@en,
                                                 "Questa classe rappresenta un'area amministrativa territoriale statale gestita tipicamente da un organismo pubblico. Essa può essere una Regione, una Provincia, un Comune, un area sub comunale, etc."@it;
                                    rdfs:isDefinedBy cis:;
                                    rdfs:label "Area Amministrativa statale"@it,
                                               "Governamental Administrative Area"@en;
                                    rdfs:subClassOf cis:GeographicalFeature,
                                                    [<http://www.w3.org/2002/07/owl#onProperty> cis:hasISTATCode ; 
                                                     <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                                "stable"@en.
cis:HolderOfArchive <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:HolderOfArchive è il seguente:

<pre>

cissite:Archivio_di_Stato_di_Oristano
    a cis:CulturalInstituteOrSite, cis:HolderOfArchive ;
    rdfs:label \"Archivio di Stato di Oristano\" ;
    cis:institutionalName \"Archivio di Stato di Oristano\" ;
    cis:ISILIdentifier \"IT-EX0006\" .

</pre>"""@it,
                                                                  """An example of usage of the class cis:HolderOfArchive is the following:

<pre>

cissite:Archivio_di_Stato_di_Oristano
    a cis:CulturalInstituteOrSite, cis:HolderOfArchive ;
    rdfs:label \"Archivio di Stato di Oristano\" ;
    cis:institutionalName \"Archivio di Stato di Oristano\" ;
    cis:ISILIdentifier \"IT-EX0006\" .

</pre>"""@en;
                    a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      cis:CISType,
                      <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "This class represents a specific tyep of cultural institute or site, i.e.,  Holder of Archive"@en,
                                 "Questa classe rappresenta una specifica tipologia di istituto e luogo della cultura, i.e., Archivio"@it;
                    rdfs:label "Holder of Archives"@en,
                               "Conservatore di archivi"@it;
                    rdfs:subClassOf cis:CulturalInstituteOrSite;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                                     <http://www.w3.org/2002/07/owl#hasValue> cis:HolderOfArchive ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                "stabile"@it.
cis:Hour a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           cis:MeasurementUnit.
cis:ISILIdentifier a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                     <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "This property is used to define the unique identifier of the cultural institute or site (i.e., the ISIL - International Standard Identifier for Libriaries and Related Organization - code). Subproperty of identifier."@en,
                                "Questa proprietà è utilizzata per rappresentare l'identificativo univoco dell'Istituto e luogo della cultura, i.e., il codice ISIL (International Standard identifier for Libraries and Related Organization). Sotto proprietà di identificativo."@it;
                   rdfs:domain cis:CulturalInstituteOrSite;
                   rdfs:isDefinedBy cis:;
                   rdfs:label "Identificativo ISIL"@it,
                              "ISIL identifier"@en;
                   rdfs:range rdfs:Literal;
                   rdfs:subPropertyOf cis:identifier;
                   <http://www.w3.org/2002/07/owl#versionInfo> "Stable"@en,
                                                               "Stabile"@it.
cis:ImageObject <http://purl.org/dc/elements/1.1/description> """Un esempio dell'utilizzo della classe cis:ImageObject è il seguente:

<pre>

image:Poster_Evento_Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:ImageObject , cis:CreativeWork ;
    rdfs:label \"Poster of the event 'Vincenzo Gemito al Museo di Capodimonte'\"@en;
    rdfs:label \"Poster dell'evento 'Vincenzo Gemito al Museo di Capodimonte'\"@it;     
    cis:url http://www.example.com/Image/Poster_Evento_Vincenzo_Gemito_al_Museo_di_Capodimonte.png ;     
    cis:isAbout event:Vincenzo_Gemito_al_Museo_di_Capodimonte .  

</pre>"""@it,
                                                              """An example of the usage of the class cis:ImageObject is the following:

<pre>

image:Poster_Evento_Vincenzo_Gemito_al_Museo_di_Capodimonte
    a cis:ImageObject , cis:CreativeWork ;
    rdfs:label \"Poster of the event 'Vincenzo Gemito al Museo di Capodimonte'\"@en;
    rdfs:label \"Poster dell'evento 'Vincenzo Gemito al Museo di Capodimonte'\"@it;     
    cis:url http://www.example.com/Image/Poster_Evento_Vincenzo_Gemito_al_Museo_di_Capodimonte.png ;     
    cis:isAbout event:Vincenzo_Gemito_al_Museo_di_Capodimonte .  

</pre>"""@en;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Concept used to represent an image file."@en,
                             "Concetto utilizzato per rappresentare un file immagine."@it;
                rdfs:isDefinedBy cis:;
                rdfs:label "Image Object"@en,
                           "Oggetto immagine"@it;
                rdfs:subClassOf cis:CreativeWork,
                                [<http://www.w3.org/2002/07/owl#onProperty> cis:url ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                            "stable"@en.
cis:Library a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              <http://www.w3.org/2002/07/owl#Class>,
              cis:CISType;
            rdfs:comment "It represents a specific type of Cultural Institute or Site; that is, Library"@en,
                         "Rappresenta uno specifico tipo di Istituto e Luogo della Cultura, ovvero Biblioteca."@it;
            rdfs:isDefinedBy cis:;
            rdfs:label "Library"@en,
                       "Biblioteca"@it;
            rdfs:subClassOf cis:CulturalInstituteOrSite;
            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                             <http://www.w3.org/2002/07/owl#hasValue> cis:Library ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable"@en.
cis:MeasurementUnit <http://purl.org/dc/elements/1.1/description> """Individuals of this class expresses a definite magnitude of physical quantities. 

For example it is possible to define a quantity for time (e.g., the second), space (e.g., the metre), or temperature (the celcius degree).

A measurement unit is always related to individuals of the class 'Quantitative Value' by means of the object property hasMeasurementUnit.

This allows representing as RDF assertions like 'the validity of the offer is of 7 days', e.g.,

<pre>

quantitativeValue:BaseOfferDuration
      a       cis:QuantitativeValue ;
      rdfs:label \"Durata di validità dell'offerta base della biblioteca nazionale centrale di Roma\"@it ;
      cis:hasMeasurementUnit
              cis:Day ;
      cis:hasValue \"7\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit

</pre>"""@en,
                                                                  """Individui di questa classe rappresentano un insieme definito di quantità fisiche.

Per esempio, è possibile definire una quantità per il tempo (e.g., il secondo), per lo spazio (e.g., metro) o per la temperatura (gradi celcius) 

Un'unità di misura è sempre collegata agli individui della classe \"Valore Quantitativo\" attraverso la proprietà \"ha unità di misura\".

Questo consente di rappresentare in RDF asserzioni come \" la validità dell'offerta è di 7 giorni\".

Per esempio:
 
<pre>

quantitativeValue:BaseOfferDuration
      a       cis:QuantitativeValue ;
      rdfs:label \"Durata di validità dell'offerta base della biblioteca nazionale centrale di Roma\"@it ;
      cis:hasMeasurementUnit
              cis:Day ;
      cis:hasValue \"7\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit

</pre>"""@it;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Classe che rappresenta un'unità di misura"@it,
                                 "Class that represents a measurement unit"@en;
                    rdfs:isDefinedBy cis:;
                    rdfs:label "Unità di misura"@it,
                               "Measurement Unit"@en;
                    <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                                "unstable"@en.
cis:Monday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             cis:DayOfWeek;
           rdfs:label "Monday "@en,
                      "Lunedì "@it.
cis:MonumentalArea <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:MonumentalArea is the following:

<pre>

cissite:COMPLESSO_MONUMENTALE_DI_VICOPISANO_ROCCA_DEL_BRUNELLESCHI_E_PALAZZO_PRETORIO
    a cis:CulturalInstituteOrSite, cis:MonumentalArea ;
    rdfs:label \"COMPLESSO MONUMENTALE DI VICOPISANO: ROCCA DEL BRUNELLESCHI E PALAZZO PRETORIO\" ;
    cis:institutionalName \"COMPLESSO MONUMENTALE DI VICOPISANO: ROCCA DEL BRUNELLESCHI E PALAZZO PRETORIOi\" ;
    cis:ISILIdentifier \"IT-EX0007\" .

</pre>"""@en,
                                                                 """Un esempio di utilizzo della classe cis:MonumentalArea è il seguente:

<pre>

cissite:COMPLESSO_MONUMENTALE_DI_VICOPISANO_ROCCA_DEL_BRUNELLESCHI_E_PALAZZO_PRETORIO
    a cis:CulturalInstituteOrSite, cis:MonumentalArea ;
    rdfs:label \"COMPLESSO MONUMENTALE DI VICOPISANO: ROCCA DEL BRUNELLESCHI E PALAZZO PRETORIO\" ;
    cis:institutionalName \"COMPLESSO MONUMENTALE DI VICOPISANO: ROCCA DEL BRUNELLESCHI E PALAZZO PRETORIOi\" ;
    cis:ISILIdentifier \"IT-EX0007\" .

</pre>"""@it;
                   a cis:CISType,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "It represents a specific type of Cultural Institute or Site; that is, Monumental Area"@en,
                                "Rappresenta uno specifico tipo di Istituto e Luogo della Cultura ovvero Complesso Monumentale."@it;
                   rdfs:isDefinedBy cis:;
                   rdfs:label "Complesso Monumentale"@it,
                              "Monumental Area or Complex"@en;
                   rdfs:subClassOf cis:CulturalInstituteOrSite;
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                                    <http://www.w3.org/2002/07/owl#hasValue> cis:MonumentalArea ; 
                                                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                               "stable"@en.
cis:Museum <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Museum is the following:

<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\"; ;
    cis:institutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" .

</pre>"""@en,
                                                         """Un esempio di utilizzo della classe cis:Museum è il seguente:

<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\"; ;
    cis:institutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" .

</pre>"""@it;
           a <http://www.w3.org/2002/07/owl#Class>,
             <http://www.w3.org/2002/07/owl#NamedIndividual>,
             cis:CISType;
           rdfs:comment "It represents a specific type of Cultural Institute or Site; that is, Museum"@en,
                        "Rappresenta uno specifico tipo di istituto e luogo della cultura ovvero museo."@it;
           rdfs:isDefinedBy cis:;
           rdfs:label "Museum"@en,
                      "Museo"@it;
           rdfs:subClassOf cis:CulturalInstituteOrSite;
           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                            <http://www.w3.org/2002/07/owl#hasValue> cis:Museum ; 
                                                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                       "stabile"@it.
cis:NameInTime <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:NameInTime is the following:

<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\" ;
    cis:institutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" ;
    cis:hasNameInTime nit:Museo_di_Capodimonte ;
    cis:hasSite site:Museo_di_Capodimonte .

nit:Museo_di_Capodimonte
    a cis:NameInTime ;
    rdfs:label \"Denominazione nel tempo 'Museo di Capodimonte'\"@it ;
    cis:institutionalName \"Museo di Capodimonte\"@it ;
    cis:altLabel \"Museo Nazionale di Capodimonte\"@it ;
    cis:isValidDuring ti:Intervallo_di_tempo_per_denominazione_nel_tempo_Museo_di_Capodimonte  .
	
ti:Intervallo_di_tempo_per_denominazione_nel_tempo_Museo_di_Capodimonte
    a cis:TimeInterval ;
    cis:startDate \"1957\" .

</pre>"""@en,
                                                             """Un esempio di utilizzo della classe cis:NameInTime è il seguente:

<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\" ;
    cis:institutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" ;
    cis:hasNameInTime nit:Museo_di_Capodimonte ;
    cis:hasSite site:Museo_di_Capodimonte .

nit:Museo_di_Capodimonte
    a cis:NameInTime ;
    rdfs:label \"Denominazione nel tempo 'Museo di Capodimonte'\"@it ;
    cis:institutionalName \"Museo di Capodimonte\"@it ;
    cis:altLabel \"Museo Nazionale di Capodimonte\"@it ;
    cis:isValidDuring ti:Intervallo_di_tempo_per_denominazione_nel_tempo_Museo_di_Capodimonte  .
	
ti:Intervallo_di_tempo_per_denominazione_nel_tempo_Museo_di_Capodimonte
    a cis:TimeInterval ;
    cis:startDate \"1957\" .

</pre>"""@it;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Permette di rappresentare una situazione relativa alla denominazione di un istituto e luogo della cultura che cambia nel tempo."@it,
                            "Permits to represent a situation in which a name of the Cultural Institute or Site change in time."@en;
               rdfs:isDefinedBy cis:;
               rdfs:label "Nome Nel Tempo"@it,
                          "Name in Time"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:TimeInterval ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:isValidDuring ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:institutionalName ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#onProperty> cis:altLabel ; 
                                <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                           "stable"@en.
cis:NewsArticle a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Concept used to represent a news article."@en,
                             "Concetto utilizzato per rappresentare un articolo"@it;
                rdfs:isDefinedBy cis:;
                rdfs:label "News Article"@en,
                           " Articolo"@it;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:url ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                cis:CreativeWork;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                            "stabile"@it.
cis:Offer <http://purl.org/dc/elements/1.1/description> """Any fare is expressed within the ontology by using instances of the class Offer.

It is possible to specify: 
 * the type of user to whom the offer is applicable  (cf. object property cis:hasEligibleUser);
 * the information about the price (cf. object property hasPriceSpecification);
 * the information about the temporal validity of the offer (cf. object property hasValidity);
 * the association with a ticket (cf. object property includes).

The following turtle example exemplifies the base offer of the Biblioteca Nazionale Centrale di Roma.

<pre>

offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer \"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification
              priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .

</pre>"""@en,
                                                        """Qualsiasi tariffa è rappresentata nell'ontologia attraverso istanze della classe \"Offerta\".

E' possibile specificare:
 * il tipo di utente al quale l'offerta è applicabile (con la proprietà has utente eligibile)
 * l'informazione sul prezzo (con la proprietà ha prezzo)
 * l'informazione sulla validità temporale dell'offerta (con la proprietà ha validità)
 + l'associazione con il biglietto (con la proprietà \"include\").

Il seguente codice turtle fornisce un esempio di offerta base per la Biblioteca Nazionale Centrale di Roma 

<pre>

offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer \"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification
              priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .

</pre>"""@it;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Concetto utilizzato per rappresentare  offerte (riduzioni per specifiche categorie di utenti o importo intero) relative ai biglietti d'ingresso per un istituto e luogo della cultura o per un evento."@it,
                       "It represents an offer (reduction  for specific types of users or base price) related to the entrance ticket for the Cultural Institute or Site or for the Event."@en;
          rdfs:isDefinedBy cis:;
          rdfs:label "Offerta"@it,
                     "Offer"@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Ticket ; 
                           <http://www.w3.org/2002/07/owl#onProperty> cis:includes ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#onProperty> cis:hasValidity ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Validity ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                      "stable"@en.
cis:OneDay a <http://www.w3.org/2002/07/owl#NamedIndividual>.
cis:OneWeek a <http://www.w3.org/2002/07/owl#NamedIndividual>.
cis:OpeningHoursSpecification <http://purl.org/dc/elements/1.1/description> """Individui di questa classe specificano particolari condizioni di accesso ai luoghi della cultura o eventi, i.e., gli orari di apertura dei luoghi o degli eventi.

Gli orari di apertura sono espressi in termini di 
 * orario apertura (con la proprietà \"apre\")
 * orario di chiusura (con la proprietà \"chiude\")
 * il giorno della settimana a cui l'orario di apertura si riferisce (con la proprietà ha giorno della settimana)
 * il tipo di apertura (settimanale, mensile, giornaliera, ecc) (con la proprietà ha tipo di apertura)

Un esempio in turle è il seguente:
<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasAccessCondition            orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi

orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi
      a       cis:OpeningHoursSpecification ;
      rdfs:label \"Opening Hours of Biblioteca nazionale centrale di Roma - thursday\"@en , 
      \"Orari di apertura di Biblioteca nazionale centrale di Roma - giovedì\"@it ;
      cis:closes \"19:00:00\"^^xsd:time ;
      cis:hasAdmissionType          addmissionType:Tipo_di_apertura_al_pubblico ;
      cis:hasDayOfWeek cis:Thursday ;
      cis:opens \"08:30:00\"^^xsd:time .

admissionType:Tipo_di_apertura_al_pubblico
      a       cis:AdmissionType ;
      cis:description \"daily\" .

</pre>"""@it,
                                                                            <http://dati.beniculturali.it/cis/img/openingHoursSpecification.png>,
                                                                            """Individuals of this class specify a particula access conditions, i.e., the opening hours of a 'Cultural Institute or Site' or an 'Event'.

Opening hours are represented in terms of:
   * opening time (cf. property opens);
   * closing time (cf. property closes);
   * the day of the week that the opening specification refers to (cf. property hasDayOfWeek);
   * the admission type, e.g. weekly, monthly, daily, etc (cf. property hasAdmmissionType).

An example in turtle is the following:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasAccessCondition            orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi

orari:Orari_di_apertura_di_Biblioteca_nazionale_centrale_di_Roma_giovedi
      a       cis:OpeningHoursSpecification ;
      rdfs:label \"Opening Hours of Biblioteca nazionale centrale di Roma - thursday\"@en , 
      \"Orari di apertura di Biblioteca nazionale centrale di Roma - giovedì\"@it ;
      cis:closes \"19:00:00\"^^xsd:time ;
      cis:hasAdmissionType          addmissionType:Tipo_di_apertura_al_pubblico ;
      cis:hasDayOfWeek cis:Thursday ;
      cis:opens \"08:30:00\"^^xsd:time .

admissionType:Tipo_di_apertura_al_pubblico
      a       cis:AdmissionType ;
      cis:description \"daily\" .

</pre>"""@en;
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Rappresenta gli orari di apertura"@it,
                                           "It represents the opening hours specification "@en;
                              rdfs:label "Opening Hours Specification"@en,
                                         "Orari di Apertura"@it;
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                               <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> cis:closes ; 
                                               <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:time ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> cis:opens ; 
                                               <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:time ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onProperty> cis:hasDayOfWeek ; 
                                               <http://www.w3.org/2002/07/owl#allValuesFrom> cis:DayOfWeek ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              cis:AccessCondition,
                                              [<http://www.w3.org/2002/07/owl#onProperty> cis:hasAdmissionType ; 
                                               <http://www.w3.org/2002/07/owl#allValuesFrom> cis:AdmissionType ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>];
                              <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                          "stabile"@it.
cis:PriceSpecification <http://purl.org/dc/elements/1.1/description> <http://dati.beniculturali.it/cis/img/priceSpecification.png>,
                                                                     """Un prezzo fornisce informazioni sul costo di un offerta necessaria per entrare in un luogo della cultura o accedere a un evento.

E' associata a una valuta (e.g., euro) e al valore della valuta (quantità, e.g., 5).

Il seguente esempio in turle mostra la specifica del prezzo per l'offerta base per entrare alla Biblioteca Nazionale Centrale di Roma

<pre>

priceSpecification:Under18
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo per i ragazzi sotto i 18 anni \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue
              \"5\"^^xsd:float .


offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer \"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification
              priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .


</pre>"""@it,
                                                                     """A price specification provides the information about the cost of an offer for entering a Cultural Institute or Site.

It is associated to a currency (e.g., Euro) and a currency value (i.e., a quantity, e.g., 5).

The following turtle provides an example about the price specification of the base offer for entering the Biblioteca Nazionale Centrale di Roma.

<pre>

priceSpecification:Under18
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo under 18 \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue
              \"5\"^^xsd:float .


offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer \"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification
              priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .


</pre>"""@en;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Rappresenta la specifica del prezzo del biglietto."@it,
                                    "It represents the price specification of the ticket"@en;
                       rdfs:isDefinedBy cis:;
                       rdfs:label "Prezzo"@it,
                                  "Price Specification"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> cis:hasCurrencyValue ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Currency ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> cis:hasCurrency ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>];
                       <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                   "stabile"@it.
cis:Project <http://purl.org/dc/elements/1.1/description> """Un esempio di uso della classe cis:Project è il seguente:
<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\" ;
    cis:InstitutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" ;
    cis:isInvolvedInProject project:ProgettoEsempio ;
    cis:hasSite site:Museo_di_Capodimonte .

project:ProgettoEsempio 
    a cis:Project;
    rdfs:label \"Example Project\"@en ;
    rdfs:label \"Progetto di Esempio\";@it;
    cis:name \"Example Project\";@en ;
    cis:name \"Progetto di Esempio\"@it;
    cis:hasWebSite http://www.example-project.com/ .

</pre>"""@it,
                                                          """An example of usage of the class cis:Project is the following:

<pre>

cissite:Museo_di_Capodimonte
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo di Capodimonte\" ;
    cis:InstitutionalName \"Museo di Capodimonte\" ;
    cis:ISILIdentifier \"IT-EX0008\" ;
    cis:isInvolvedInProject project:ProgettoEsempio ;
    cis:hasSite site:Museo_di_Capodimonte .

project:ProgettoEsempio 
    a cis:Project;
    rdfs:label \"Example Project\"@en ;
    rdfs:label \"Progetto di Esempio\";@it;
    cis:name \"Example Project\";@en ;
    cis:name \"Progetto di Esempio\"@it;
    cis:hasWebSite http://www.example-project.com/ .

</pre>"""@en;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "It represents a Project the Cultural Institute and Site can be involved in."@en,
                         "Rappresenta un progetto nel quale l'istitutto della Cultura può essere coinvolto."@it;
            rdfs:isDefinedBy cis:;
            rdfs:label "Progetto"@it,
                       "Project"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                             <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasWebSite ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                        "stabile"@it.
cis:QuantitativeValue <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:QuantitativeValue is the following:

<pre>

qv:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\";
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit .

</pre>"""@en,
                                                                    """Un esempio di utilizzo della classe cis:QuantitativeValue è il seguente:
<pre>

qv:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\";
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

cis:Day a cis:MeasurementUnit .

</pre>"""@it;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Class that represents a quantitative value."@en,
                                   "Classe che rappresenta un valore quantitativo"@it;
                      rdfs:isDefinedBy cis:;
                      rdfs:label "Quantitative Value"@en,
                                 "Valore quantitativo"@it;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:MeasurementUnit ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cis:hasMeasurementUnit ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:positiveInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cis:hasValue ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                                  "versione non definitiva"@it.
cis:QuantityOfAdmissions a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                           cis:MeasurementUnit.
cis:Role <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:Role è il seguente:

<pre>

role:Director
    a cis:Role ;
    rdfs:label \"Director\"@en ;
    rdfs:label \"Direttore\"@it ;
    cis:name \"Direttore\"@it ;
    cis:name \";Director\"@en .

</pre>"""@it,
                                                       """An example of usage of the class cis:Role is the following:

<pre>

role:Director
    a cis:Role ;
    rdfs:label \"Director\"@en ;
    rdfs:label \"Direttore\"@it ;
    cis:name \"Direttore\"@it ;
    cis:name \";Director\"@en .

</pre>"""@en;
         a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Rappresenta un ruolo. Esso può essere definito facendo riferimento a un vocabolario controlalto. Esempi di ruoli possono essere: ente genstore, ente competente per la tutela, proprietario, direttore, ecc."@it,
                      "It represents a role. It can be modelled using a controlled vocabulary. Examples of roles include: ManagingAuthority, AccountableAuthority, Owner, Director, etc."@en;
         rdfs:isDefinedBy cis:;
         rdfs:label "Ruolo"@it,
                    "Role"@en;
         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#onProperty> cis:isRoleIn ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> cis:RoleInTime ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>];
         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                     "stable"@en.
cis:RoleInTime <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:RoleInTime è il seguente:

<pre>

agent:Andrea_De_Pasquale
    a cis:Agent ;
    rdfs:label \"Andrea De Pasquale\"; ;
    cis:name \"Andrea De Pasquale\" ;
    cis:reportsTo agent:Soprintendenza ;
    cis:holdsRoleInTime roleInTime:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale .

roleInTime:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale
    a cis:RoleInTime ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale Centrale\"@en ;
    cis:atTime timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231 ;
    cis:roleFor cissite:Biblioteca_nazionale_centrale ;
    cis:withRole role:Director .

timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231
    a cis:TimeInterval ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale from 1-1-2013 through 31-12-2016\"@en ;
    cis:startDate  \"2013-01-01\"^^xsd:dateTime ;
    cis:endDate \"2016-12-31\"^^xsd:dateTime .

role:Director
    a cis:Role ;
    rdfs:label \"Director\"@en ;
    rdfs:label \"Direttore\"@it ;
    cis:name \"Direttore\"@it ;
    cis:name \";Director\"@en .

</pre>"""@it,
                                                             """An example of usage of the class cis:RoleInTime is the following:

<pre>

agent:Andrea_De_Pasquale
    a cis:Agent ;
    rdfs:label \"Andrea De Pasquale\"; ;
    cis:name \"Andrea De Pasquale\" ;
    cis:reportsTo agent:Soprintendenza ;
    cis:holdsRoleInTime roleInTime:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale .

roleInTime:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale
    a cis:RoleInTime ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale Centrale\"@en ;
    cis:atTime timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231 ;
    cis:roleFor cissite:Biblioteca_nazionale_centrale ;
    cis:withRole role:Director .

timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231
    a cis:TimeInterval ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale from 1-1-2013 through 31-12-2016\"@en ;
    cis:startDate  \"2013-01-01\"^^xsd:dateTime ;
    cis:endDate \"2016-12-31\"^^xsd:dateTime .

role:Director
    a cis:Role ;
    rdfs:label \"Director\"@en ;
    rdfs:label \"Direttore\"@it ;
    cis:name \"Direttore\"@it ;
    cis:name \";Director\"@en .

</pre>"""@en,
                                                             <http://dati.beniculturali.it/cis/img/roleInTime.png>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Concetto utilizzato per rappresentare una situazione relativa a un ruolo che evolve nel tempo. Nel caso specifico il ruolo è esercitato da un agente su un istituto e luogo della cultura."@it,
                            "Concept used to represent a situation in which a role can vary in time. In this specific domain, it is the role of an agent played on a Cultural Institute or Site."@en;
               rdfs:isDefinedBy cis:;
               rdfs:label "Ruolo Nel Tempo"@it,
                          "Role in Time"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Role ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:withRole ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                                                                         cis:Event) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:roleFor ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:isHeldBy ; 
                                <http://www.w3.org/2002/07/owl#onClass> cis:Agent ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:TimeInterval ; 
                                <http://www.w3.org/2002/07/owl#onProperty> cis:atTime ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                           "stabile"@it.
cis:Saturday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               cis:DayOfWeek;
             rdfs:label "Saturday"@en,
                        "Sabato"@it.
cis:Service <http://purl.org/dc/elements/1.1/description> """Un istituto della cultura può offrire una serie di servizi (e.g., Wi-Fi, accesso ai disabili, caffetteria, ecc.).

Questi servizi sono rappresentati da individui della classe \"Servizio\" e sono in relazione con l'istituto della cultural attraverso la proprietà \"fornisce servizio\".

Il seguente esempio mostra in turtle l'uso della classe servizio:

<pre>

service:Caffetteria
      a       cis:Service ;
      cis:name \"Caffetteria\" .


service:Connessione_WI-FI
      a       cis:Service ;
      cis:name \"Connessione WI-FI\" .


cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:providesService service:Caffetteria, service:Connessione_WI-FI.

</pre>"""@it,
                                                          """A Cultural Institute or Site (CIS) might offer a variety of services (e.g., Wi-Fi Handicapped access, cafeteria, etc.).

These services are represented as individuals of the class 'Service' and they are in relationship with a CIS by means of the object property providesService.

The following is an example expressed by using the turtle syntax:

<pre>

service:Caffetteria
      a       cis:Service ;
      cis:name \"Caffetteria\" .


service:Connessione_WI-FI
      a       cis:Service ;
      cis:name \"Connessione WI-FI\" .


cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:providesService service:Caffetteria, service:Connessione_WI-FI.

</pre>"""@en;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "It represents a service that is provided by the Cultural Institute or Site. For instance, a service can be: the presence of a restaurant internal to the Cultural Institute or Site, the uso of an educational room, the use of a free wifi connection"@en,
                         "Rappresenta un servizio offerto da un istituto e luogo della cultura. Per esempio, un servizio può essere: la presenza di un ristorante interno al luogo, l'uso una sala didattica, l'uso di una connessione wifi libera, ecc."@it;
            rdfs:isDefinedBy cis:;
            rdfs:label "Servizio"@it,
                       "Service"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                             <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:isProvidedBy ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:CulturalInstituteOrSite ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> cis:hasContactPoint ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> cis:ContactPoint ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable"@en.
cis:Site <http://purl.org/dc/elements/1.1/description> """Una sede è sempre associata agli individui della classe \"Istituto e Luogo della Cultura\" attraverso la proprietà ha sede.

Una sede è caratterizzata dalle seguenti proprietà:
 * ha indirizzo: consente di associare una sede con un individuo della classe indirizzo che fornisce la descrizione dell'indirizzo;
 * ha punto di contatto: consente di associare una sede con un individuo che identifica un punto di contatto;
 * ha locazione geografica: consente di associare la sede con la descrizione dell'area geografica 
* nome: una proprietà che consente di specificare il nome della sede
* è sede di: la proprietà inversa di ha sede

Il seguente esempio in turle mostra una sede associata a un istituto e luogo della cultura:

<pre>


site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      rdfs:label \"Sede Biblioteca nazionale centrale di Roma\"@it ;
      cis:hasAddress address:Indirizzo_della_sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasGeographicalLocation
              geographicalFeature:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:name \"Sede di: Biblioteca nazionale centrale di Roma\"@it .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasSite site:Sede_di_Biblioteca_nazionale_centrale_di_Roma .

</pre>"""@it,
                                                       """A site is always associated with an individual of the class 'Cultural Institute or Site' (CIS) by means of the object property hasSite.

A site is characterised by the following properties:

 * hasAddress that allows associating the site with an indidivdual of the class Address, this latter providing the description of the address;
 * hasContactPoint that associates the site with an individual identifying a contact point;
 * hasGeographicalLocation for relating the site to the description of its geographical features, that, in turn, is represented by means of an individual of the class 'Geographical Area';
 * name that is the datatype property for associating the site with a literal expressing a name;
 * isSiteOf that is the inverse property of hasSite.

The following is an example of a Site and its association with a CIS

<pre>


site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      rdfs:label \"Sede Biblioteca nazionale centrale di Roma\"@it ;
      cis:hasAddress address:Indirizzo_della_sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasGeographicalLocation
              geographicalFeature:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:name \"Sede di: Biblioteca nazionale centrale di Roma\"@it .

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasSite site:Sede_di_Biblioteca_nazionale_centrale_di_Roma .

</pre>"""@en;
         a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment """It represents a georeferenced physical site related to the Cultural Institute or Site. A Cultural Institute or Site can be located in more than one physical site. For instance, a Site can be \"Palazzo Venezia\" which is the site of the \"Museum of Palazzo Venezia\" and of \"Library of Archaelogy and Art History\"."""@en,
                      """Rappresenta un luogo fisico georeferenziato relativo all'Istituto e luogo della Cultura. Un Istituto e Luogo della Cultura può avere più di un luogo fisico associato. Nell'ambito dell'Istituto Centrale per il Catalogo e la Documentazione (ICC)D) tale concetto rappresenta il contenitore fisico. Per esempio, un luogo fisico può essere \"Palazzo Venezia\" dove ha sede il \"Museo Nazionale di Palazzo Venezia\" o la \"Biblioteca di Archeologia e Storia dell'Arte\"."""@it;
         rdfs:isDefinedBy cis:;
         rdfs:label "Site"@en,
                    "Sede"@it;
         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#onProperty> cis:hosts ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Event ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:CulturalInstituteOrSite ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:isSiteOf ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:Address ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:hasAddress ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#onProperty> cis:hasContactPoint ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> cis:ContactPoint ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:GeographicalFeature ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:hasGeographicalLocation ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#onProperty> cis:hasGeometry ; 
                          <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Geometry ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#someValuesFrom> cis:SiteDescription ; 
                          <http://www.w3.org/2002/07/owl#onProperty> cis:hasSiteDescription ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>];
         <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                     "stabile"@it.
cis:SiteDescription <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:SiteDescription is the following:
<pre>

site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      rdfs:label \"Sede Biblioteca nazionale centrale di Roma\"@it ;
      cis:hasAddress address:Indirizzo_della_sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasGeographicalLocation geographicalFeature:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:hasSiteDescription sd:Sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:name \"Sede di: Biblioteca nazionale centrale di Roma\"@it .

sd:Sede_di_Biblioteca_nazionale_centrale_di_Roma
    a cis:SiteDescription ;
    rdfs:label\"Description of the 'Sede di Biblioteca Nazionale Centrale di Roma'\"@en ;
    rdfs:label \"Descrizione della 'Sede di Biblioteca Nazionale Centrale di Roma'\"@it ;
    cis:description \"La libreria 1000 metri di scaffalature\"@it ; 
    cis:description \"The Library has 1000 meters of shelves\"@en ;
    cis:hasAttribute attribute:Shelving .

attribute:Shelving
    a cis:Attribute ;
    rdfs:label \"Shelving\"@en ;
    rdfs:label \"Scaffalature\";@it ;
    cis:name \"Shelving\"@en ;
    cis:name \"Scaffalature\"@it ;
    cis:description \"The linear dimension of a shelf unit (e.g. 3 meters)\"@en ;
    cis:description \";La dimensione di uno scaffale in metri lineari (es. 3 metri)\"@it .

</pre>"""@en,
                                                                  """Un esempio di utilizzo della classe cis:SiteDescription è il seguente:
<pre>

site:Sede_di_Biblioteca_nazionale_centrale_di_Roma
      a       cis:Site ;
      rdfs:label \"Sede Biblioteca nazionale centrale di Roma\"@it ;
      cis:hasAddress address:Indirizzo_della_sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasContactPoint contactPoint:Contatti_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:hasGeographicalLocation geographicalFeature:Comune_di_Roma ;
      cis:isSiteOf cissite:Biblioteca_nazionale_centrale ;
      cis:hasSiteDescription sd:Sede_di_Biblioteca_nazionale_centrale_di_Roma ;
      cis:name \"Sede di: Biblioteca nazionale centrale di Roma\"@it .

sd:Sede_di_Biblioteca_nazionale_centrale_di_Roma
    a cis:SiteDescription ;
    rdfs:label\"Description of the 'Sede di Biblioteca Nazionale Centrale di Roma'\"@en ;
    rdfs:label \"Descrizione della 'Sede di Biblioteca Nazionale Centrale di Roma'\"@it ;
    cis:description \"La libreria 1000 metri di scaffalature\"@it ; 
    cis:description \"The Library has 1000 meters of shelves\"@en ;
    cis:hasAttribute attribute:Shelving .

attribute:Shelving
    a cis:Attribute ;
    rdfs:label \"Shelving\"@en ;
    rdfs:label \"Scaffalature\";@it ;
    cis:name \"Shelving\"@en ;
    cis:name \"Scaffalature\"@it ;
    cis:description \"The linear dimension of a shelf unit (e.g. 3 meters)\"@en ;
    cis:description \";La dimensione di uno scaffale in metri lineari (es. 3 metri)\"@it .

</pre>"""@it;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Permette di rappresentare una descrizione della sede fisica dell'istituto e luogo della cultura (per esempio, la sede ha una metratura complessiva di XX mq suddivisa in metratura al pubblico e una scaffalatura complessiva di n. YYY)."@it,
                                 "Permits to represents a description of a site of the cultural institute or site (for instance, the site has a total space available XXX, and a shelving that consists of a set of XX X shelves, etc.)"@en;
                    rdfs:isDefinedBy cis:;
                    rdfs:label "Site Description"@en,
                               "Descrizione della sede"@it;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:hasAttribute ; 
                                     <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Attribute ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                     <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                "stable"@en.
cis:SubjectDiscipline <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:SubjectDiscipline è il seguente:
<pre>

cissite:Museo_archeologico_statale
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo archeologico statale\" ;
    cis:institutionalName\"Museo archeologico statale\" ;
    cis:ISILIdentifier \"T-EX0010\" ;
    cis:hasDiscipline sd:Archeologia ;
    cis:hasSite site:Museo_archeologico_statale .

sd:Archeologia
    a cis:SubjectDiscipline ;
    rdfs:label \"Archeologia\"@it ;
    rdfs:label \"Archaeology\"@en ;
    cis:name \"Archeologia\"@it ;
    cis:name \"Archaeology\"@en ;
    cis:description \"Archaeology, or archeology, is the study of human activity through the recovery and 
analysis of material culture\"@en ;
    cis:description \"L'archeologia è la scienza che studia le civiltà e le culture umane del passato e le loro relazioni 
con l'ambiente circostante, mediante la raccolta, la documentazione e l'analisi delle tracce materiali che hanno
lasciato architetture, manufatti, resti biologici e umani\"@it .

</pre>"""@it,
                                                                    """An example of usage of the class cis:SubjectDiscipline is the following:

<pre>

cissite:Museo_archeologico_statale
    a cis:CulturalInstituteOrSite, cis:Museum ;
    rdfs:label \"Museo archeologico statale\" ;
    cis:institutionalName\"Museo archeologico statale\" ;
    cis:ISILIdentifier \"T-EX0010\" ;
    cis:hasDiscipline sd:Archeologia ;
    cis:hasSite site:Museo_archeologico_statale .

sd:Archeologia
    a cis:SubjectDiscipline ;
    rdfs:label \"Archeologia\"@it ;
    rdfs:label \"Archaeology\"@en ;
    cis:name \"Archeologia\"@it ;
    cis:name \"Archaeology\"@en ;
    cis:description \"Archaeology, or archeology, is the study of human activity through the recovery and analysis 
of material culture\"@en ;
    cis:description \"L'archeologia è la scienza che studia le civiltà e le culture umane del passato e le loro relazioni 
con l'ambiente circostante, mediante la raccolta, la documentazione e l'analisi delle tracce materiali che hanno
lasciato architetture, manufatti, resti biologici e umani\"@it .

</pre>"""@en;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "It represents a a field of knowledge or human activity. This can be defined in a controlled vocabulary. Examples can be: Modern Art, Ancient History, Ethnografy, etc."@en,
                                   "Rappresenta un certo ambito della conoscenza o dell'attività umana. Tale ambito è preferibilmente modellato mediante un vocabolario controllato. Esempi: arte contemporanea, storia antica, etnografia, ecc."@it;
                      rdfs:isDefinedBy cis:;
                      rdfs:label "Categoria prevalente"@it,
                                 "Subject Discipline"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                                  "stabile"@it.
cis:Sunday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             cis:DayOfWeek;
           rdfs:label "Sunday"@en,
                      "Domenica"@it.
cis:TemporaryClosure <http://purl.org/dc/elements/1.1/description> """A temporary closure is a subclass of 'AccessCondition' whose individuals provide information about a temporary closure.
These individuals are described in terms of:
 * the closure date (cf. property hasDate);
 * the reason about the temporary closure (cf. property hasReason);
 * the type associated with the temporary closure (cf. property hasTemporaryClosureType).

An example in turtle is the following:

<pre>
cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasAccessCondition            orari:Chiusura_estiva_di_Biblioteca_nazionale_centrale_di_Roma

orari:Chiusura_estiva_di_Biblioteca_nazionale_centrale_di_Roma
      cis:hasDate \"2015-08-15\"^^xsd:dateTime ;
      cis:hasReason \"Chiusura estiva\" ;
</pre>"""@en,
                                                                   """La chiusura temporanea è una sottoclasse di Condizioni di accesso i cui individui forniscono informazioni sulla chiusura temporanea.

Gli individui sono descritti in termini di:
 * data di chiusura (con la proprietà ha data);
 * la motivazione per la chiusura (con la proprietà ha motivazione)
 * il tipo associato con la chiusura temporanea (con la proprietà ha tipo chiusura temporanea)

Un esempio è il seguente:
<pre>
cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      cis:hasAccessCondition            orari:Chiusura_estiva_di_Biblioteca_nazionale_centrale_di_Roma

orari:Chiusura_estiva_di_Biblioteca_nazionale_centrale_di_Roma
      cis:hasDate \"2015-08-15\"^^xsd:dateTime ;
      cis:hasReason \"Chiusura estiva\" ;
</pre>"""@it;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Rappresenta le informazioni sulla chiusura temporanea"@it,
                                  "It represents the information on the temporary closure "@en;
                     rdfs:label "Chiusura Temporanea"@it,
                                "Temporary Closure"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:hasDate ; 
                                      <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (xsd:date
                                                                                                                              xsd:dateTime) ; 
                                                                                     a rdfs:Datatype] ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                      <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     cis:AccessCondition,
                                     [<http://www.w3.org/2002/07/owl#onProperty> cis:hasReason ; 
                                      <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> cis:hasTemporaryClosureType ; 
                                      <http://www.w3.org/2002/07/owl#allValuesFrom> cis:TemporaryClosureType ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                 "stable".
cis:TemporaryClosureType <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:TemporaryClosureType is the following:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      rdfs:label \"Biblioteca nazionale centrale\"@it ;
      cis:ISILIdentifier \"IT-RM0267\" ;
      cis:hasAccessCondition tc:Biblioteca_nazionale_centrale_temporary_closure .

tc:Biblioteca_nazionale_centrale_temporary_closure 
    a cis:TemporaryClosure ;
    rdfs:label \"Chiusura temporanea della Biblioteca Nazionale Centrale di Roma per restauro\"@it ;
    rdfs:label \"Temporary closure of Biblioteca Nazionale Centrale di Roma for renovation\"@en ;
    cis:description \"Dal 19-01-2015 al 21-01-2015 la Biblioteca Nazionale centrale chiude per restauro\"@it ;
    cis:description \"From 2015-01-19 al 2015-01-21 Biblioteca Nazionale centrale is closed for renovation\"@en ;
    cis:hasReason \"Renovation\"@en;
    cis:hasReason \"Restauro\"@it ;
    cis:hasTemporaryClosureType tct:Renovation ;
    cis:hasDate \"2015-01-19\"^^xsd:date ;
    cis:hasDate \"2015-01-20\"^^xsd:date ;
    cis:hasDate \"2015-01-21\"^^xsd:date .

tct:Renovation
    a cis:TemporaryClosureType;
    rdfs:label \"Renovation\"@en;
    rdfs:label \"Restauro\"@it ;
    cis:name \"Renovation\"@en;
    cis:name \"Restauro\";@it ;
    cis:description\"Temporary Closure for Renovation\";@en ;
    cis:description \"Chiusura per Restauro\";@it .

</pre>"""@en,
                                                                       """Un esempio di utilizzo della classe cis:TemporaryClosureType è il seguente:

<pre>

cissite:Biblioteca_nazionale_centrale
      a       cis:Library , cis:CulturalInstituteOrSite ;
      rdfs:label \"Biblioteca nazionale centrale\"@it ;
      cis:ISILIdentifier \"IT-RM0267\" ;
      cis:hasAccessCondition tc:Biblioteca_nazionale_centrale_temporary_closure .

tc:Biblioteca_nazionale_centrale_temporary_closure 
    a cis:TemporaryClosure ;
    rdfs:label \"Chiusura temporanea della Biblioteca Nazionale Centrale di Roma per restauro\"@it ;
    rdfs:label \"Temporary closure of Biblioteca Nazionale Centrale di Roma for renovation\"@en ;
    cis:description \"Dal 19-01-2015 al 21-01-2015 la Biblioteca Nazionale centrale chiude per restauro\"@it ;
    cis:description \"From 2015-01-19 al 2015-01-21 Biblioteca Nazionale centrale is closed for renovation\"@en ;
    cis:hasReason \"Renovation\"@en;
    cis:hasReason \"Restauro\"@it ;
    cis:hasTemporaryClosureType tct:Renovation ;
    cis:hasDate \"2015-01-19\"^^xsd:date ;
    cis:hasDate \"2015-01-20\"^^xsd:date ;
    cis:hasDate \"2015-01-21\"^^xsd:date .

tct:Renovation
    a cis:TemporaryClosureType;
    rdfs:label \"Renovation\"@en;
    rdfs:label \"Restauro\"@it ;
    cis:name \"Renovation\"@en;
    cis:name \"Restauro\";@it ;
    cis:description\"Temporary Closure for Renovation\";@en ;
    cis:description \"Chiusura per Restauro\";@it .

</pre>"""@it;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Rappresenta il tipo di chiusura temporanea. Per esempio: per restauro, per inagibilità, ecc. "@it,
                                      "It represents the type of temporary. Examples can be: closed for renovation, unfit for use, etc. "@en;
                         rdfs:label "Tipo di Chiusura Temporanea"@it,
                                    "Type of Temporary Closure"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                                          <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                     "stable"@en.
cis:Theatre <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:Theatre è il seguente:

<pre>

cissite:Teatro_Olimpico
    a cis:CulturalInstituteOrSite, cis:Theatre ;
    rdfs:label \"Teatro Olimpico\" ;
    cis:name \"Teatro Olimpico\" ;
    cis:ISILIdentifier \"IT-EX0011\" .

</pre>"""@it,
                                                          """An example of usage of the class cis:Theatre is the following:

<pre>

cissite:Teatro_Olimpico
    a cis:CulturalInstituteOrSite, cis:Theatre ;
    rdfs:label \"Teatro Olimpico\" ;
    cis:name \"Teatro Olimpico\" ;
    cis:ISILIdentifier \"IT-EX0011\" .

</pre>"""@en;
            a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              cis:CISType,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a cultural institute or site of type Theatre"@en,
                         "Questa classe rappresenta un istituto e luogo della cultura di tipo Teatro"@it;
            rdfs:isDefinedBy cis:;
            rdfs:label "Teatro"@it,
                       "Theatre"@en;
            rdfs:subClassOf cis:CulturalInstituteOrSite;
            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> cis:hasCISType ; 
                                                             <http://www.w3.org/2002/07/owl#hasValue> cis:Theatre ; 
                                                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                        "unstable"@en.
cis:Thursday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               cis:DayOfWeek;
             rdfs:label "Thursday "@en,
                        "Giovedì "@it.
cis:Ticket <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:Ticket is the following:

<pre>

offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer\"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .

ticket:Biblioteca_nazionale_centrale_ticket_1 
     a cis:Ticket ;
     rdfs:label \"Biglietto per accedere a 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     rdfs:label \"Ticket for access to 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:name \"Biglietto base per accedere 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     cis:name\"Basic ticket for access to 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:description \"Biglietto che permette l'accesso per un giorno alla 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     cis:description \"One-day ticket for 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:hasValidity validity:Biblioteca_nazionale_centrale_ticket_1;
     cis:forAccessTo cissite:Biblioteca_nazionale_centrale .

validity:Biblioteca_nazionale_centrale_ticket_1
    a cis:Validity ;
    rdfs:label \"One day validity\"@en ;
    rdfs:label \"Validità per 1 giorno\"@it ;
    cis:hasDuration qv:Biblioteca_nazionale_centrale_ticket_1 .

qv:Biblioteca_nazionale_centrale_ticket_1
    a cis:QuantitativeValue ;
    rdfs:label \"1\";
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"1\"^^xsd:positiveInteger .

priceSpecification:Under18
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo per ragazzi sotto i 18 anni \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue \"5\"^^xsd:float .

userType:Under18 
   a cis:UserType ; 
   rdfs:label \"Under 18\" ; 
   cis:name \"Under 18\"; ;
   cis:description \"People under 18 years old\";@en;
   cis:description \"Persone con età inferiore ai 18 anni\"@it  .

</pre>"""@en,
                                                         """Un esempio dell'utilizzo della classe cis:Ticket è il seguente:

<pre>

offer:Biblioteca_Nazionale_Centrale_base_offer
      a       cis:Offer ;
      rdfs:label \"offerta base \"@it , \"base offer\"@en ;
      cis:hasEligibleUser userType:Under18 ;
      cis:hasPriceSpecification priceSpecification:Under18 ;
      cis:hasValidity validity:Biblioteca_nazionale_centrale_validity ;
      cis:includes ticket:Biblioteca_nazionale_centrale_ticket_1 .

ticket:Biblioteca_nazionale_centrale_ticket_1 
     a cis:Ticket ;
     rdfs:label \"Biglietto per accedere a 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     rdfs:label \"Ticket for access to 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:name \"Biglietto base per accedere 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     cis:name\"Basic ticket for access to 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:description \"Biglietto che permette l'accesso per un giorno alla 'Biblioteca Nazionale Centrale di Roma'\"@it ;
     cis:description \"One-day ticket for 'Biblioteca Nazionale Centrale di Roma'\"@en ;
     cis:hasValidity validity:Biblioteca_nazionale_centrale_ticket_1;
     cis:forAccessTo cissite:Biblioteca_nazionale_centrale .

validity:Biblioteca_nazionale_centrale_ticket_1
    a cis:Validity ;
    rdfs:label \"One day validity\"@en ;
    rdfs:label \"Validità per 1 giorno\"@it ;
    cis:hasDuration qv:Biblioteca_nazionale_centrale_ticket_1 .

qv:Biblioteca_nazionale_centrale_ticket_1
    a cis:QuantitativeValue ;
    rdfs:label \"1\";
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"1\"^^xsd:positiveInteger .

priceSpecification:Under18
      a       cis:PriceSpecification ;
      rdfs:label \"price specification under 18 \"@en , \"costo per ragazzi sotto i 18 anni \"@it ;
      cis:hasCurrency cis:Euro ;
      cis:hasCurrencyValue \"5\"^^xsd:float .

userType:Under18 
   a cis:UserType ; 
   rdfs:label \"Under 18\" ; 
   cis:name \"Under 18\"; ;
   cis:description \"People under 18 years old\";@en;
   cis:description \"Persone con età inferiore ai 18 anni\"@it  .

</pre>"""@it;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "It represents an entrance ticket for a Cultural Institute or Site, if required, and for an event"@en,
                        "Rappresenta il biglietto d'ingresso per l'Istitituto e Luogo della Cultura, qualora sia previsto, e per l'evento culturale."@it;
           rdfs:isDefinedBy cis:;
           rdfs:label "Biglietto"@it,
                      "Ticket"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:forAccessTo ; 
                            <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                                                                    cis:Event) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>] ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#onProperty> cis:hasValidity ; 
                            <http://www.w3.org/2002/07/owl#allValuesFrom> cis:Validity ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                            <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                            <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                       "stabile"@it.
cis:TimeInterval <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:TimeInterval è il seguente:

<pre>

timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231
    a cis:TimeInterval ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale from 2013-01-01 to 2016-12-31\"@en ;
    cis:startDate \"2013-01-01\"^^xsd:dateTime ;
    cis:endDate \"2016-12-31\"^^xsd:dateTime .

</pre>"""@it,
                                                               """An example of usage of the class cis:TimeInterval is the following:

<pre>

timeInteval:Andrea_De_Pasquale_DirectorOfBibliotecaNazionaleCentrale_20130101_20161231
    a cis:TimeInterval ;
    rdfs:label \"Andrea De Pasquale director of Biblioteca Nazionale from 2013-01-01 to 2016-12-31\"@en ;
    cis:startDate \"2013-01-01\"^^xsd:dateTime ;
    cis:endDate \"2016-12-31\"^^xsd:dateTime .

</pre>"""@en;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Rappresenta un intervallo temporale."@it,
                              "It represents a temporal interval"@en;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "Time Interval"@en,
                            "Intervallo di Tempo"@it;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:startDate ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:dateTime ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:dateTime ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> cis:endDate ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it.
cis:Tuesday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              cis:DayOfWeek;
            rdfs:label "Tuesday"@en,
                       "Martedì"@it.
cis:UserType <http://purl.org/dc/elements/1.1/description> """An example of usage of the class cis:UserType is the following:

<pre>
userType:Under18 
   a cis:UserType ; 
   rdfs:label \"Under 18\" ; 
   cis:name \"Under 18\"; ;
   cis:description \"People under 18 years old\";@en;
   cis:description \"Persone con età inferiore ai 18 anni\"@it  .

</pre>"""@en,
                                                           """Un esempio di utilizzo della classe cis:UserType è il seguente:

<pre>
userType:Under18 
   a cis:UserType ; 
   rdfs:label \"Under 18\" ; 
   cis:name \"Under 18\"; ;
   cis:description \"People under 18 years old\";@en;
   cis:description \"Persone con età inferiore ai 18 anni\"@it  .

</pre>"""@it;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """Rappresenta la tipologia di utenti relativa ai biglietti per accedere a un evento o a un istituto e luogo della cultura. Esempi includono:  \"maggiorenni over 25\", oppure \"over 65\", \"bambini\", ecc."""@it,
                          "It represents the identified type of users related to the tickets used to access an event or a Cultural Institute or Site. Examples include: people over 25 years old, people over 65 years old,  children, etc."@en;
             rdfs:isDefinedBy cis:;
             rdfs:label "User Type"@en,
                        "Tipo di utente"@it;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:name ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#onProperty> cis:description ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> rdfs:Literal ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                         "stabile"@it.
cis:Validity <http://purl.org/dc/elements/1.1/description> """Un esempio di utilizzo della classe cis:Validity è il seguente:

<pre>

validity:Parco_archeologico_di_Liternum_Card_Validity
    a cis:Validity ;
    rdfs:label \"Two-day validity\"@en ;
    rdfs:label \"Validità per due giorni\"@it ;
    cis:hasDuration Parco_archeologico_di_Liternum_Card_Validity_Duration .

qv:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\";;
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

</pre>"""@it,
                                                           """An example of usage of the class cis:Validity is the following:

<pre>

validity:Parco_archeologico_di_Liternum_Card_Validity
    a cis:Validity ;
    rdfs:label \"Two-day validity\"@en ;
    rdfs:label \"Validità per due giorni\"@it ;
    cis:hasDuration Parco_archeologico_di_Liternum_Card_Validity_Duration .

qv:Parco_archeologico_di_Liternum_Card_Validity_Duration
    a cis:QuantitativeValue ;
    rdfs:label \"2\";;
    cis:hasMeasurementUnit cis:Day ;
    cis:hasValue \"2\"^^xsd:positiveInteger .

</pre>"""@en;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Questa classe rappresenta la validità di biglietti e di offerte"@it,
                          "This class represents the validity for the ticket and offering."@en;
             rdfs:isDefinedBy cis:;
             rdfs:label "Validità"@it,
                        "Validity"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> cis:hasDuration ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (cis:QuantitativeValue
                                                                                                                      cis:TimeInterval) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "non stabile"@it,
                                                         "unstable"@en.
cis:VideoObject a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Concetto utilizzato per rappresentare materiali multimediali di tipo video."@it,
                             "Concept used to represent multimedia objects of type video."@en;
                rdfs:isDefinedBy cis:;
                rdfs:label "Oggetto video"@it,
                           "Video Object"@en;
                rdfs:subClassOf cis:CreativeWork,
                                [<http://www.w3.org/2002/07/owl#onProperty> cis:url ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> xsd:anyURI ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                            "stabile"@it.
cis:Wednesday a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                cis:DayOfWeek;
              rdfs:label "Wednesday"@en,
                         "Mercoledì"@it.
cis:Week a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           cis:MeasurementUnit.
cis:Year a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           cis:MeasurementUnit.
cis:accessConditionFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment """Inverse property of \"has access condition\""""@en,
                                    """Proprietà inversa di \"ha condizione di accesso\""""@it;
                       rdfs:domain cis:AccessCondition;
                       rdfs:isDefinedBy cis:;
                       rdfs:label "access condition for"@en,
                                  "condizione di accesso per"@it;
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                            cis:Event) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       <http://www.w3.org/2002/07/owl#inverseOf> cis:hasAccessCondition.
cis:addressID a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Proprietà utilizzata per rappresentare un identificatore univoco per ciascuna istanza di un indirizzo, Rappresenta un elemento cruciale delle specifiche INSPIRE. Sottoproprietà di identificativo."@it,
                           "Property used to represent the globally unique identifier for each instance of an address. A crucial part of the INSPIRE data specifications. Subproperty of identifier."@en;
              rdfs:domain cis:Address;
              rdfs:isDefinedBy cis:;
              rdfs:label "address identifier"@en,
                         "identificativo dell'indirizzo"@it;
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf cis:identifier;
              <http://www.w3.org/2002/07/owl#versionInfo> "unstable",
                                                          "versione ancora non definitiva"@it.
cis:adminUnitL1 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Property used to represent the uppermost administrative unit for the address of the site of the cultural institute or site, almost always a country."@en,
                             "Proprietà utilizzata per l'unità amministrativa di più alto livello dell'indirizzo della sede di un istituto e luogo della cultura."@it;
                rdfs:domain cis:Address;
                rdfs:isDefinedBy cis:;
                rdfs:label "unità amministrativa di livello 1"@it,
                           "administrative unit level 1"@en;
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                            "stable".
cis:adminUnitL2 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Proprietà utilizzata per rappresentare l'unità amministrativa di livello 2 dell'indirizzo della sede di un istituto e luogo della cultura, di solito uno stato, una contea o ogni altra area che tipicamente ricomprende diverse località."@it,
                             "Property used to represent the region of the address of the site of a cultural institute or site, usually a county, state or other such area that typically encompasses several localities."@en;
                rdfs:domain cis:Address;
                rdfs:isDefinedBy cis:;
                rdfs:label "administrative unit level 2"@en,
                           "unità amministrativa di livello 2"@it;
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                            "stabile"@it.
cis:altLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Proprietà utilizzata per associare la situazione name in time a una denominazione alternativa dell'istituto e luogo della cultura."@it,
                          "Property used to associate the situation name in time with the alternative name of the cultural institute or site"@en;
             rdfs:domain cis:NameInTime;
             rdfs:isDefinedBy cis:;
             rdfs:label "alternative label"@en,
                        "nome alternativo dell'istituto e luogo della cultura"@it;
             rdfs:range rdfs:Literal;
             rdfs:subPropertyOf cis:name;
             <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                         "stabile"@it.
cis:atTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Proprietà che consente di associare un ruolo nel tempo a un intervallo temporale. La stessa proprietà è utilizzata in maniera analoga per associare una collezione a un intervallo temporale."@it,
                        "Property used to associate the situation role in time with a temporal interval. The same property is used in a similar way to link a site or a collection to a temporal interval"@en;
           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:Collection
                                                                 cis:RoleInTime) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:isDefinedBy cis:;
           rdfs:label "at time"@en,
                      "al tempo"@it;
           rdfs:range cis:TimeInterval;
           <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                       "stabile"@it.
cis:available a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Proprietà utilizzata per associare  un punto di contatto a fasce orarie in cui il punto di contatto è disponibile."@it,
                           "Property used to associate a contact point with hours specification in which the contact point is available."@en;
              rdfs:domain cis:ContactPoint;
              rdfs:isDefinedBy cis:;
              rdfs:label "available"@en,
                         "disponibile"@it;
              rdfs:range cis:OpeningHoursSpecification;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable"@en.
cis:catalogue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Property used to associate the Cultural Institute or SIte with a catalogue of cultural collections included in the institute or site. The relatioships can be used to indicate that a Cultural Institute or Site has an its own catalogue or situations where a Cultural Institute or Site contributes to a union catalogue (this latter case is represented by libraries that can contribute to or participate in a union catalogue)."@en,
                           "Proprietà utilizzata per associare l'istituto e luogo della cultura a un  catalogo che descrive le opere in esso contenute. Tale relazione può essere utilizzata per indicare che un istituto e luogo della cultura ha un catalogo ma anche una situazione per cui un istituto e luogo della cultura partecipa a un catalogo (in quest'ultimo caso un esempio è rappresentato dalle biblioteche che possono partecipare a un catalogo collettivo)."@it;
              rdfs:domain cis:CulturalInstituteOrSite;
              rdfs:isDefinedBy cis:;
              rdfs:label "catalogue"@en,
                         "catalogo"@it;
              rdfs:range cis:Catalogue;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable".
cis:closes a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Questa proprietà è utilizzata per rappresentare l'orario di chiusura."@it,
                        "This property is used to represent the closing time"@en;
           rdfs:domain cis:OpeningHoursSpecification;
           rdfs:isDefinedBy cis:;
           rdfs:label "chiude "@it,
                      "closes "@en;
           rdfs:range xsd:time;
           <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                       "stabile"@it.
cis:describes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Property used to associate the catalogue with the cultural heritage objects of a cultural institute or site that the catalogue describes."@en,
                           "Proprietà che consente di associare il catalogo alle opere di un istituto e luogo della cultura che esso descrive."@it;
              rdfs:domain cis:Catalogue;
              rdfs:isDefinedBy cis:;
              rdfs:label "describes"@en,
                         "descrive"@it;
              rdfs:range cis:Collection;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable".
cis:description a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "This property is used to indicate a description of the cultural institute or site"@en,
                             "Questa proprietà è utilizzata per indicare una descrizione dell'istituto e luogo della cultura"@it;
                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:isDefinedBy cis:;
                rdfs:label "descrizione"@it,
                           "description"@en;
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                            "stable"@en.
cis:endDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "end Date of a Time Interval"@en,
                         "Data di fine di un intervallo temporale"@it;
            rdfs:domain cis:TimeInterval;
            rdfs:isDefinedBy cis:;
            rdfs:label "data di fine"@it,
                       "end Date"@en;
            rdfs:range xsd:dateTime;
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable"@en.
cis:forAccessTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Proprietà che consente di associare un biglietto a un evento o a un istituto e luogo della cultura."@it,
                             "Property used to associate a ticket with an event or a cultural institute or site"@en;
                rdfs:domain cis:Ticket;
                rdfs:isDefinedBy cis:;
                rdfs:label "for access to"@en,
                           "per l'accesso a"@it;
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                     cis:Event) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                            "stabile"@it.
cis:fullAddress a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Proprietà utilizzata per indicare l'indirizzo completo della sede di un istituto e luogo della cultura."@it,
                             "Property used to represent the full address of the site of a cultural institute or site."@en;
                rdfs:domain cis:Address;
                rdfs:isDefinedBy cis:;
                rdfs:label "full address"@en,
                           "indirizzo completo"@it;
                rdfs:range rdfs:Literal;
                <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                            "stable".
cis:geoMethodology a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment """Questa proprietà è utilizzata per rappresentare il metodo della georeferenziazione. Essa può essere i valori \"approssimata\" ed \"esatta\"."""@it,
                                "This property is used to represent the methodology used for the georeferentiation."@en;
                   rdfs:domain cis:Geometry;
                   rdfs:isDefinedBy cis:;
                   rdfs:label "georeferentiation methodology"@en,
                              "metodologia di georeferenziazione"@it;
                   rdfs:range rdfs:Literal;
                   <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                               "stabile"@it.
cis:geometryType a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Questa proprietà è utilizzata per identificare il tipo di geometria (punto, linea, o poligono) nella rappresentazione geospaziale."@it,
                              "This property is used to represent the geometry type (point, line, or polygon) in the geospatial representation."@en;
                 rdfs:domain cis:Geometry;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "tipo di geometria"@it,
                            "geometry type"@en;
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                             "stable"@en.
cis:hasAccessCondition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Proprietà utilizzata per associare l'istituto e luogo della cultura o l'evento con le condizioni di accesso."@it,
                                    "Property used to associate the Cultural Institute or Site or the Event with its access condition information"@en;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                             cis:Event) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy cis:;
                       rdfs:label "has access condition"@en,
                                  "ha condizioni di accesso"@it;
                       rdfs:range cis:AccessCondition;
                       <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                   "stable".
cis:hasAddress a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Proprietà che consente di associare un sito fisico a un indirizzo."@it,
                            "Property that permits to associate a site with an address"@en;
               rdfs:domain cis:Site;
               rdfs:isDefinedBy cis:;
               rdfs:label "ha indirizzo"@it,
                          "has address"@en;
               rdfs:range cis:Address;
               <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                           "stabile"@it.
cis:hasAdmissionType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Property used to associate the opening hours specification to the admission type"@en,
                                  "Proprietà che consente di associare gli orari di apertura al tipo di apertura."@it;
                     rdfs:domain cis:OpeningHoursSpecification;
                     rdfs:isDefinedBy cis:;
                     rdfs:label "has admission type"@en,
                                "ha tipo di apertura"@it;
                     rdfs:range cis:AdmissionType;
                     <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                 "stabile"@it.
cis:hasAttribute a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Proprietà che permette di associare una descrizione del sito dell'istituto e luogo della cultura a un attributo, inteso come caratteristica del sito (metratura, scaffalatura, etc)"@it,
                              "Property used to associate the description of the site of the cultural institute or site an attribute (e.g., total space, shelving, etc.)"@en;
                 rdfs:domain cis:SiteDescription;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "has attribute"@en,
                            "ha attribute"@it;
                 rdfs:range cis:Attribute;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                             "stable"@en.
cis:hasCISType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "La proprietà è utilizzata per collegare un istituto e luogo della cultura alla sua tipologia."@it,
                            "The property is used to link a cultural institure or site to its type."@en;
               rdfs:domain cis:CulturalInstituteOrSite;
               rdfs:label "has type"@en,
                          cis:,
                          "ha tipo"@it;
               rdfs:range cis:CISType;
               <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                           "unstable"@en.
cis:hasCertifiedEmail a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Proprietà utilizzata per associare un indirizzo PEC a un punto di contatto"@it,
                                   "Property used to associate a certified email address to a contact point"@en;
                      rdfs:domain cis:ContactPoint;
                      rdfs:isDefinedBy cis:;
                      rdfs:label "ha posta elettronica certificata (PEC)"@it,
                                 "has certified email"@en;
                      rdfs:range xsd:anyURI;
                      <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                  "stable".
cis:hasCollection a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Proprietà che permette di associare l'istituto e luogo della cultura all'insieme delle opere in esso contenute."@it,
                               "Property used to associate the Cultural Institute or Site with the set of cultural objects it contains."@en;
                  rdfs:domain cis:CulturalInstituteOrSite;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "ha collezione"@it,
                             "has collection"@en;
                  rdfs:range cis:Collection;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                              "stabile"@it.
cis:hasContactPoint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Property which links a cultural insttiute or site to its contact points. The same property is used to link in a similar way the event to its contact points and to link the site of the cultural institute or site with its contact points"@en,
                                 "Proprietà che collega un istituto e luogo della cultura ai propri punti di contatto. La stessa proprietà è utilizzata in maniera analoga per collegare il luogo fisico con i propri punti di contatto, ad anche per collegare un evento ai propri contatti"@it;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                          cis:Event
                                                                          cis:Service
                                                                          cis:Site) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:isDefinedBy cis:;
                    rdfs:label "has contact point"@en,
                               "ha punto di contatto"@it;
                    rdfs:range cis:ContactPoint;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                "stabile"@it.
cis:hasCurrency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property is used to connected the Price specification to Currency"@en,
                             "Questa proprietà collega la specifica del prezzo del ticket per un evento o istituto e luogo della cultura con la classe currency"@it;
                rdfs:domain cis:PriceSpecification;
                rdfs:isDefinedBy cis:;
                rdfs:label "has currency"@en,
                           "ha valuta"@it;
                rdfs:range cis:Currency;
                <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                            "versione non definitiva"@it.
cis:hasCurrencyValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Proprietà utilizzata per indicare il prezzo del biglietto."@it,
                                  "Property used to represent the price of the ticket."@en;
                     rdfs:domain cis:PriceSpecification;
                     rdfs:isDefinedBy cis:;
                     rdfs:label "ha prezzo"@it,
                                "has currency value"@en;
                     rdfs:range xsd:float;
                     <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                 "stable".
cis:hasDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "Property used to represent the date of the temporary closure."@en,
                         "Proprietà utilizzata per indicare una data della chiusura temporanea."@it;
            rdfs:domain cis:TemporaryClosure;
            rdfs:isDefinedBy cis:;
            rdfs:label "ha data"@it,
                       "has date"@en;
            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (xsd:date
                                                                 xsd:dateTime) ; 
                        a rdfs:Datatype];
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable".
cis:hasDayOfWeek a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This property is used to specify the opening hours and in particular the days of the week."@en,
                              "Questa proprietà è utilizzata per specificare gli orari di apertura e in particolare i giorni della settimana."@it;
                 rdfs:domain cis:OpeningHoursSpecification;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "ha giorno della settimana "@it,
                            "has day of week "@en;
                 rdfs:range cis:DayOfWeek;
                 <http://www.w3.org/2002/07/owl#inverseOf> cis:isDayOfWeekOf;
                 <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                             "unstable"@en.
cis:hasDiscipline a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Proprietà che permette di associare all&apos;istituto e luogo della cultura la categoria a cui esso è tipicamente associato (es. archeologia, etnografia e antropologia, arte, ...)."@it,
                               "Property used to associate the Cultural Institute or Site with its own field of knowledge"@en;
                  rdfs:domain cis:CulturalInstituteOrSite;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "ha categoria"@it,
                             "has discipline"@en;
                  rdfs:range cis:SubjectDiscipline;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                              "stable".
cis:hasDuration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Questa proprietà è utilizzata per specificare il periodo temporale di validità."@it,
                             "This property is used to specify the temporal duration of the validity."@en;
                rdfs:domain cis:Validity;
                rdfs:isDefinedBy cis:;
                rdfs:label "has duration"@en,
                           "ha durata"@it;
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:QuantitativeValue
                                                                     cis:TimeInterval) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                            "versione non definitiva"@it.
cis:hasEligibleUser a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Proprietà che consente di associare un'offerta per l'accesso a un evento o a un istituto e luogo della cultura a una tipologia di utente"@it,
                                 "Property used to associate the an offert for the access to an event or a cultural institute or site with the type of user"@en;
                    rdfs:domain cis:Offer;
                    rdfs:isDefinedBy cis:;
                    rdfs:label "ha utente eligibile"@it,
                               "has eligible User"@en;
                    rdfs:range cis:UserType;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                "stabile"@it.
cis:hasEmail a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Property used to specify email address for a contact point"@en,
                          "Proprietà utilizzata per specificare indirizzi email del punto di contatto"@it;
             rdfs:domain cis:ContactPoint;
             rdfs:isDefinedBy cis:;
             rdfs:label "ha email"@it,
                        "has email"@en;
             rdfs:range xsd:anyURI;
             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                         "stabile"@it.
cis:hasFax a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Proprietà utilizzata per rappresentare uno o più numeri di fax del punto di contatto"@it,
                        "Property used to represent one or more fax numbers for the contact point"@en;
           rdfs:domain cis:ContactPoint;
           rdfs:isDefinedBy cis:;
           rdfs:label "has fax"@en,
                      "ha fax"@it;
           rdfs:range xsd:anyURI;
           <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                       "stable"@en.
cis:hasGeographicalLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Property used to associate a site with a geographical area where the site is located."@en,
                                         "Proprietà che consente di associare una sede di un istituto e luogo della cultura a un'area geografica in cui si trova la sede."@it;
                            rdfs:domain cis:Site;
                            rdfs:isDefinedBy cis:;
                            rdfs:label "ha locazione geografica"@it,
                                       "has geographical location"@en;
                            rdfs:range cis:GeographicalFeature;
                            <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                        "stabile"@it.
cis:hasGeometry a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Proprietà utilizzata per associare un sito alle proprie coordinate geografiche."@it,
                             "Property used to associate a site with its own geographical coordinates"@en;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:GeographicalFeature
                                                                      cis:Site) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy cis:;
                rdfs:label "ha geometria"@it,
                           "has geometry"@en;
                rdfs:range cis:Geometry;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                            "stabile"@it.
cis:hasISTATCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment "This property is used to represent a specific code used in the Italian context for the governamental administrative areas."@en,
                              "Questa proprietà è utilizzata per rappresentare il codice ISTAT associato a un'area amministrativa statale."@it;
                 rdfs:domain cis:GovernamentalAdministrativeArea;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "has ISTAT code"@en,
                            "ha codice ISTAT"@it;
                 rdfs:range rdfs:Literal;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it.
cis:hasLat a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "Property used to associate a latitude with a Point"@en,
                        "Proprietà utilizzata per associare la latitudine a un punto"@it;
           rdfs:domain cis:Geometry;
           rdfs:isDefinedBy cis:;
           rdfs:label "ha latitudine"@it,
                      "has latitude"@en;
           rdfs:range xsd:decimal;
           <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                       "stabile"@it.
cis:hasLong a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "Proprietà utilizzata per associare la longitudine a un punto"@it,
                         "Property used to associate the longitude with a Point"@en;
            rdfs:domain cis:Geometry;
            rdfs:isDefinedBy cis:;
            rdfs:label "has longitude"@en,
                       "ha longitudine"@it;
            rdfs:range xsd:decimal;
            <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                        "stabile"@it.
cis:hasMeasurementUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Questa proprietà è utilizzata per rappresentare un'unità di misura."@it,
                                    "This property is used to represent a measurement unit."@en;
                       rdfs:domain cis:QuantitativeValue;
                       rdfs:isDefinedBy cis:;
                       rdfs:label "has measurement unit"@en,
                                  "ha unità di misura"@it;
                       rdfs:range cis:MeasurementUnit;
                       <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                                   "versione non definitiva"@it.
cis:hasMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Property that permits to specify the cultural heritage objects that form a specific collection or the entire cultural heritage included in a cultural institute or site"@en,
                           "Proprietà che consente di specificare le opere che formano una determinata collezione o l'intero patrimonio di un istituto e luogo della cultura"@it;
              rdfs:domain cis:Collection;
              rdfs:isDefinedBy cis:;
              rdfs:label "ha membro"@it,
                         "has member"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:Collection
                                                                   cis:CulturalHeritageObject) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
              <http://www.w3.org/2002/07/owl#inverseOf> cis:isMemberOf;
              <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                          "stabile"@it.
cis:hasNameInTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Property which associate a cultural institute or site or a site with the situation name in time"@en,
                               """Proprietà che associa un istituto o luogo della cultura o un sito alla situazione \"denominazione nel tempo\", ovvero una determinata denominazione valida in un determinato arco temporale"""@it;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                        cis:Site) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy cis:;
                  rdfs:label "ha nome nel tempo"@it,
                             "has name in time"@en;
                  rdfs:range cis:NameInTime;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                              "stable".
cis:hasPriceSpecification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Questa proprietà è utliizzata per collegare l'offerta per i biglietti a una specifica del prezzo."@it,
                                       "This property is used to link the offer for a ticket to its price specification."@en;
                          rdfs:domain cis:Offer;
                          rdfs:isDefinedBy cis:;
                          rdfs:label "ha specifica di prezzo "@it,
                                     "has price specification "@en;
                          rdfs:range cis:PriceSpecification;
                          <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                      "stable"@en.
cis:hasReason a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Property used to describe a reason for the temporary closure."@en,
                           "Proprietà utilizzata per descrivere una motivazione della chiusura temporanea."@it;
              rdfs:domain cis:TemporaryClosure;
              rdfs:isDefinedBy cis:;
              rdfs:label "ha motivazione"@it,
                         "has reason"@en;
              rdfs:range rdfs:Literal;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable".
cis:hasSite a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
              <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Property which links a cultural institute or site to its own physical site(s)."@en,
                         "Proprietà che collega un istituto e luogo della cultura al proprio o ai propri siti fisici."@it;
            rdfs:domain cis:CulturalInstituteOrSite;
            rdfs:isDefinedBy cis:;
            rdfs:label "ha contenitore fisico"@it,
                       "ha sede"@it,
                       "has site"@en;
            rdfs:range cis:Site;
            <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                        "stabile"@it.
cis:hasSiteDescription a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Proprietà che permette di associare una descrizione alla sede dell'istituto e luogo della cultura."@it,
                                    "Propery that permits to associate a site of a cultural institute or site with its description."@en;
                       rdfs:domain cis:Site;
                       rdfs:isDefinedBy cis:;
                       rdfs:label "ha descrizione della sede"@it,
                                  "has site description"@en;
                       rdfs:range cis:SiteDescription;
                       <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                   "stabile"@it.
cis:hasSubEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Property used to describe large events to which single sub events refer. For instance, a large event can be the first world war centenary to which single events celebrating the 100th anniversary refer"@en,
                             "Proprietà utilizzata per rappresentare grandi eventi che hanno singoli eventi che ad esso fanno riferimento. Ad esempio, un grande evento può essere il centenario della prima guerra mondiale a cui fanno riferimento una serie di eventi singoli."@it;
                rdfs:domain cis:Event;
                rdfs:isDefinedBy cis:;
                rdfs:label "has sub event"@en,
                           "ha sotto eventi"@it;
                rdfs:range cis:Event;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                            "stabile"@it.
cis:hasTelephone a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Property used to represent one or more telephone numbers for the contact point"@en,
                              "proprietà utilizzata per rappresentare uno o più numeri di telefono per il punto di contatto"@it;
                 rdfs:domain cis:ContactPoint;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "ha telefono"@it,
                            "has telephone"@en;
                 rdfs:range xsd:anyURI;
                 <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                             "stabile"@it.
cis:hasTemporaryClosureType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Property used to associate the temporary closure with its type"@en,
                                         "Proprietà che consente di associare una chiusura temporanea al suo tipo."@it;
                            rdfs:domain cis:TemporaryClosure;
                            rdfs:isDefinedBy cis:;
                            rdfs:label "ha tipo di chiusura temporanea"@it,
                                       "has temporary closure type"@en;
                            rdfs:range cis:TemporaryClosureType;
                            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                        "stable".
cis:hasTicket a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment """Inverse property of \"for access to\""""@en,
                           """proprietà inversa di \"per accedere a\""""@it;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                    cis:Event) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:isDefinedBy cis:;
              rdfs:label "has ticket"@en,
                         "ha biglietto"@it;
              rdfs:range cis:Ticket;
              <http://www.w3.org/2002/07/owl#inverseOf> cis:forAccessTo.
cis:hasValidity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Proprietà utilizzata per specificare una validità di un offerta o di un biglietto."@it,
                             "Property used to specify the validity of an offer or ticket."@en;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:Offer
                                                                      cis:Ticket) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy cis:;
                rdfs:label "has validity"@en,
                           "ha validità"@it;
                rdfs:range cis:Validity;
                <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                            "versione non definitiva"@it.
cis:hasValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Proprietà utilizzata per rappresentare un valore"@it,
                          "Property used to represent a value"@en;
             rdfs:domain cis:QuantitativeValue;
             rdfs:isDefinedBy cis:;
             rdfs:label "has value"@en,
                        "ha valore"@it;
             rdfs:range xsd:positiveInteger;
             <http://www.w3.org/2002/07/owl#versionInfo> "unstable"@en,
                                                         "non stabile"@it.
cis:hasWebSite a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Property used to represent a web site"@en,
                            "Proprietà utilizzata per rappresentare un sito web"@it;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:Catalogue
                                                                     cis:ContactPoint
                                                                     cis:Project) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:isDefinedBy cis:;
               rdfs:label "ha sito web"@it,
                          "has web site"@en;
               rdfs:range xsd:anyURI;
               <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                           "stabile"@it.
cis:holdsRoleInTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Property used to associate an agent with the situation role in time the agent can play"@en,
                                 """Proprietà utilizzata per associare un agente alla situazione \"ruolo nel tempo\", ovvero ad un determinato ruolo ricoperto dall'agente stesso in un deteminato arco temporale"""@it;
                    rdfs:domain cis:Agent;
                    rdfs:isDefinedBy cis:;
                    rdfs:label "holds role in time"@en,
                               "detiene un ruolo nel tempo"@it;
                    rdfs:range cis:RoleInTime;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                "stabile"@it.
cis:hosts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "Property used to associate a cultural institute or site to an event"@en,
                       "Proprietà usata per associare un istituto e luogo della cultura a un evento."@it;
          rdfs:domain cis:Site;
          rdfs:isDefinedBy cis:;
          rdfs:label "ospita"@it,
                     "hosts"@en;
          rdfs:range cis:Event;
          <http://www.w3.org/2002/07/owl#versionInfo> "versione ancora non definitiva"@it,
                                                      "unstable".
cis:identifier a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "This property represents an identifier for a Thing."@en,
                            "Questa proprietà rappresenta un identificativo per una cosa."@it;
               rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:isDefinedBy cis:;
               rdfs:label "identificativo"@it,
                          "identifier"@en;
               rdfs:range rdfs:Literal;
               <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                           "stabile"@it.
cis:includes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Property used to associate an offer with the relative ticket"@en,
                          "Proprietà utilizzata per associare un'offerta al relativo biglietto."@it;
             rdfs:domain cis:Offer;
             rdfs:isDefinedBy cis:;
             rdfs:label "includes"@en,
                        "include"@it;
             rdfs:range cis:Ticket;
             <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                         "stable".
cis:institutionalName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "This data property identifies  the institutional name of the Cultural Institute or Site."@en,
                                   "Questa proprietà identifica direttamente il nome istituzionale dell'Istituto e luogo della cultura"@it;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalInstituteOrSite
                                                                            cis:NameInTime) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:isDefinedBy cis:;
                      rdfs:label "Nome Istituzionale"@it,
                                 "Institutional Name";
                      rdfs:range rdfs:Literal;
                      rdfs:subPropertyOf cis:name;
                      <http://www.w3.org/2002/07/owl#versionInfo> "Stabile"@it,
                                                                  "Stable"@en.
cis:involves a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Proprietà di coinvolgimento che associa un evento a una generica entità culturale."@it,
                          "Involvment property that associates an event with a general cultural entity"@en;
             rdfs:domain cis:Event;
             rdfs:isDefinedBy cis:;
             rdfs:label "involves"@en,
                        "coinvolge"@it;
             rdfs:range cis:CulturalEntity;
             <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                         "stable".
cis:isAbout a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Proprietà che consente di associare un lavoro creativo a un'entità culturale. La stessa proprietà può essere utilizzata in maniera analoga per associare un lavoro creativo a un evento o a un sito."@it,
                         "Property used to associate a creative work with a cultural entity. The same property is used in a similar way to associate the creative work with an event or site"@en;
            rdfs:domain cis:CreativeWork;
            rdfs:isDefinedBy cis:;
            rdfs:label "tratta di"@it,
                       "is about"@en;
            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalEntity
                                                                 cis:Event
                                                                 cis:Site) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                        "stabile"@it.
cis:isCatalogueOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """Inverse property of \"has catalogue\"."""@en,
                               """Proprietà inversa di \"ha catalogo\"."""@it;
                  rdfs:domain cis:Catalogue;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "is catalogue of"@en,
                             "è catalogo di"@it;
                  rdfs:range cis:CulturalInstituteOrSite;
                  <http://www.w3.org/2002/07/owl#inverseOf> cis:catalogue;
                  <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                              "unstable"@en.
cis:isDayOfWeekOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """Proprietà inversa di \"ha giorno della settimana\"."""@it,
                               "Inverse property of has day of week."@en;
                  rdfs:domain cis:DayOfWeek;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "is day of week of "@en,
                             "è giorno della settimana di "@it;
                  rdfs:range cis:OpeningHoursSpecification;
                  <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                              "unstable"@en.
cis:isDescribedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """Inverse property of \"describes\""""@en,
                               """Proprietà inversa di \"descrive\""""@it;
                  rdfs:domain cis:Collection;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "is described by"@en,
                             "è descritto da"@it;
                  rdfs:range cis:Catalogue;
                  <http://www.w3.org/2002/07/owl#inverseOf> cis:describes.
cis:isHeldBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment """Inverse property of \"holds a role in time\""""@en,
                          """Proprietà inversa di \"ha un ruolo nel tempo\""""@it;
             rdfs:domain cis:RoleInTime;
             rdfs:isDefinedBy cis:;
             rdfs:label "is held by"@en,
                        "è svolto da"@it;
             rdfs:range cis:Agent;
             <http://www.w3.org/2002/07/owl#inverseOf> cis:holdsRoleInTime.
cis:isHostedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment """This property is the inverse of \"hosts\" and links the Event to the Site of the Cultural Institute or Site"""@en,
                            """Questa proprietà è l'inversa di \"ospita\" e collega un evento a una sede di un istituto e luogo della cultura"""@it;
               rdfs:domain cis:Event;
               rdfs:isDefinedBy cis:;
               rdfs:label "is hosted by"@en,
                          "è ospitato da"@it;
               rdfs:range cis:Site;
               <http://www.w3.org/2002/07/owl#inverseOf> cis:hosts;
               <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                           "unstable"@en.
cis:isInSite a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Proprietà che consente di associare  opere culturali al luogo fisico in cui sono conservate."@it,
                          "Property that permits to associate cultural heritage objects with the site(s) which conserve(s) them"@en;
             rdfs:domain cis:CulturalHeritageObject;
             rdfs:isDefinedBy cis:;
             rdfs:label "è nella sede"@it,
                        "is in site"@en;
             rdfs:range cis:Site;
             <http://www.w3.org/2002/07/owl#propertyChainAxiom> (cis:hasMember
                                                                 cis:isInSite);
             <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                         "stabile"@it.
cis:isInvolvedInProject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Proprietà utilizzata per rappresentare una relazione di coinvolgimento tra l'istituto e luogo della cultura e un progetto."@it,
                                     "Property used to represent an involvement relationship between a cultural institute or site and a project"@en;
                        rdfs:domain cis:CulturalInstituteOrSite;
                        rdfs:isDefinedBy cis:;
                        rdfs:label "è coinvolto in progetto"@it,
                                   "is involved in a project"@en;
                        rdfs:range cis:Project;
                        <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                    "stabile"@it.
cis:isMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Inverse property of hasMember."@en,
                            "Proprietà inversa di hasMember."@it;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:Collection
                                                                     cis:CulturalHeritageObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:isDefinedBy cis:;
               rdfs:label "è membro di "@it,
                          "is member of "@en;
               rdfs:range cis:Collection;
               <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                           "stabile"@it.
cis:isPartOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "This object property is meant to link a cultural institute or site with itself. This can be used to represent all those cases in which a institute or site can be part of another general institute or site. This property can be effectively used in the cases of Sections of the Central Archive."@en,
                          """Questa proprietà è utilizzata per connettere, con una relazione \"essere parte di\", un istituto e luogo della cultura a se stesso. In particolare, tale proprietà può essere efficacemente usata per rappresentare sezioni dell'Archivio di Stato (sezione dell'Archivio di Spoleto che è parte dell'Archivio di Stato)"""@it;
             rdfs:domain cis:CulturalInstituteOrSite;
             rdfs:isDefinedBy cis:;
             rdfs:label "è parte di"@it,
                        "is part of"@en;
             rdfs:range cis:CulturalInstituteOrSite;
             <http://www.w3.org/2002/07/owl#versionInfo> "non stabile"@it,
                                                         "unstable"@en.
cis:isProvidedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment """Inverse property of \"provides service\""""@en,
                              """Proprietà inversa di \"fornisce servizio\""""@it;
                 rdfs:domain cis:Service;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "is provided by"@en,
                            "è fornito da"@it;
                 rdfs:range cis:CulturalInstituteOrSite;
                 <http://www.w3.org/2002/07/owl#inverseOf> cis:providesService.
cis:isRelatedToRiT a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment """inverse property for \"roleFor\""""@en,
                                """proprietà inversa di \"ruolo per\""""@it;
                   rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalEntity
                                                                         cis:Event) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:isDefinedBy cis:;
                   rdfs:label "is related to role in time"@en,
                              "è relativo a ruolo nel tempo"@it;
                   rdfs:range cis:RoleInTime;
                   <http://www.w3.org/2002/07/owl#inverseOf> cis:roleFor.
cis:isRoleIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment """Inverse property of \"with role\""""@en,
                          """Proprietà inversa di \"con ruolo\""""@it;
             rdfs:domain cis:Role;
             rdfs:isDefinedBy cis:;
             rdfs:label "is role in"@en,
                        "è ruolo in"@it;
             rdfs:range cis:RoleInTime;
             <http://www.w3.org/2002/07/owl#inverseOf> cis:withRole.
cis:isSiteOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment """Inverse property of \"has Site\""""@en,
                          """Proprietà inversa di \"ha sede\"."""@it;
             rdfs:domain cis:Site;
             rdfs:isDefinedBy cis:;
             rdfs:label "è contenitore fisico di"@it,
                        "is site of"@en,
                        "è sede di"@it;
             rdfs:range cis:CulturalInstituteOrSite;
             <http://www.w3.org/2002/07/owl#inverseOf> cis:hasSite;
             <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                         "stabile"@it.
cis:isSubEventOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment """Inverse Property of \"has sub event\""""@en,
                              """Proprietà inversa di \"ha sotto eventi\""""@it;
                 rdfs:domain cis:Event;
                 rdfs:isDefinedBy cis:;
                 rdfs:label "is sub-event of"@en,
                            "è sotto evento di"@it;
                 rdfs:range cis:Event;
                 <http://www.w3.org/2002/07/owl#inverseOf> cis:hasSubEvent.
cis:isSubjectOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment """Inverse propery of \"is about\"."""@en,
                             """Proprietà inversa di \"tratta di\"."""@it;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalEntity
                                                                      cis:Event
                                                                      cis:Site) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy cis:;
                rdfs:label "is subject of"@en,
                           "è soggetto di"@it;
                rdfs:range cis:CreativeWork;
                <http://www.w3.org/2002/07/owl#inverseOf> cis:isAbout;
                <http://www.w3.org/2002/07/owl#versionInfo> "stable"@en,
                                                            "stabile"@it.
cis:isValidDuring a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Property used to associate the situation name in time with a temporal validity interval"@en,
                               """Proprietà usata per associare la situzione \"nome nel tempo\", ovvero una denominazione valida in un certo arco temporale, a un intervallo temporale di validità"""@it;
                  rdfs:domain cis:NameInTime;
                  rdfs:isDefinedBy cis:;
                  rdfs:label "is valid during"@en,
                             "è valido durante"@it;
                  rdfs:range cis:TimeInterval;
                  <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                              "stabile"@it.
cis:makesAvailableEquipment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Proprietà che consente di associare l'istituto e luogo della cultura alle attrezzature da esso possedute."@it,
                                         "Property that permits to associate the Cultural Institute or Site with its own equipment"@en;
                            rdfs:domain cis:CulturalInstituteOrSite;
                            rdfs:isDefinedBy cis:;
                            rdfs:label "makes available equipment"@en,
                                       "rende disponibile attrezzatura"@it;
                            rdfs:range cis:Equipment;
                            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                                        "stable".
cis:name a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "Property used to associate a name with an event and a project"@en,
                      "Proprietà utilizzata per associare un nome all'evento o al progetto"@it;
         rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
         rdfs:isDefinedBy cis:;
         rdfs:label "name"@en,
                    "nome"@it;
         rdfs:range rdfs:Literal;
         <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                     "stable".
cis:offers a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Property used to associate an agent with an offer for accessing an event or a cultural institute or site"@en,
                        "Proprietà che consente di associare un agente all'offerta per l'accesso a un evento o a un luogo della cultura."@it;
           rdfs:domain cis:Agent;
           rdfs:isDefinedBy cis:;
           rdfs:label "offers"@en,
                      "offre"@it;
           rdfs:range cis:Offer;
           <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                       "stable".
cis:opens a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "This property is used to represent the opening time"@en,
                       "Questa proprietà è utilizzata per rappresentare l'orario di apertura"@it;
          rdfs:domain cis:OpeningHoursSpecification;
          rdfs:isDefinedBy cis:;
          rdfs:label "apre "@it,
                     "opens "@en;
          rdfs:range xsd:time;
          <http://www.w3.org/2002/07/owl#versionInfo> "non stabile"@it,
                                                      "unstable"@en.
cis:postCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Property used to represent the post code of the address of the site of a cultural institute or site."@en,
                          "Proprietà utilizzata per rappresentare il codice postale."@it;
             rdfs:domain cis:Address;
             rdfs:isDefinedBy cis:;
             rdfs:label "codice postale"@it,
                        "post code"@en;
             rdfs:range rdfs:Literal;
             <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                         "stabile"@it.
cis:postName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "Property used to represent the key postal division of the address of the site of the cultural institute or site, usually the city. (INSPIRE's definition is 'One or more names created and maintained for postal purposes to identify a subdivision of addresses and postal delivery points.'). "@en,
                          "Proprietà utilizzata per rappresentare la divisione postale principale dell'indirizzo della sede dell'istituto e del luogo della cultura, di solito una città."@it;
             rdfs:domain cis:Address;
             rdfs:isDefinedBy cis:;
             rdfs:label "nome divisione postale"@it,
                        "post name"@en;
             rdfs:range rdfs:Literal;
             <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                         "stable".
cis:providesService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Property used to represent a supply service relationship between a cultural institute or site and a service."@en,
                                 "Proprietà utilizzata per rappresentare una relazione di fornitura di servizi da parte di un istituto e luogo della cultura."@it;
                    rdfs:domain cis:CulturalInstituteOrSite;
                    rdfs:isDefinedBy cis:;
                    rdfs:label "fornisce servizi"@it,
                               "provides Service"@en;
                    rdfs:range cis:Service;
                    <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                "stabile"@it.
cis:reportsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Questa proprietà consente di rappresentare una relazione di appartenenza di un agente a un altro agente. Per esempio la relazione può essere utilizzata per poter esprimere che un certo responsabile di un istituto e luogo della cultura agisce per conto di una specifica organizzazione."@it,
                           "This property permits to represent a general belonging relationship of an agent. For instance, the property can be used to represent the case in which an agent with Role responsible acts on the cultural Istitute or site on behalf of an Organization to which (s)he belongs."@en;
              rdfs:domain cis:Agent;
              rdfs:isDefinedBy cis:;
              rdfs:label "reports to"@en,
                         "riporta a"@it;
              rdfs:range cis:Agent;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable"@en.
cis:roleFor a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "Proprietà che consente di associare la situazione ruolo nel tempo esercitato da un agente al relativo istituto e luogo della cultura. La stessa proprietà è utilizzata in modo analogo per associare ruolo nel tempo all'evento."@it,
                         "Property used to associate the situation role in time played by an agent with the relative cultural institute or site. The same property is used in a similar way to associate role in time with an event"@en;
            rdfs:domain cis:RoleInTime;
            rdfs:isDefinedBy cis:;
            rdfs:label "role for"@en,
                       "ruolo per"@it;
            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (cis:CulturalEntity
                                                                 cis:Event) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable".
cis:startDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Data di inizio di un intervella temporale"@it,
                           "Srart date of a Time Interval"@en;
              rdfs:domain cis:TimeInterval;
              rdfs:isDefinedBy cis:;
              rdfs:label "start Date"@en,
                         "Data di inizio"@it;
              rdfs:range xsd:dateTime;
              <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                          "stable"@en.
cis:takesPlaceDuring a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Proprietà utilizzata per associare un evento a un intervallo temporale entro cui l'evento ha luogo."@it,
                                  "Property used to associate an event with a temporal interval within which the event takes place"@en;
                     rdfs:domain cis:Event;
                     rdfs:isDefinedBy cis:;
                     rdfs:label "takes place during"@en,
                                "si tiene durante"@it;
                     rdfs:range cis:TimeInterval;
                     <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                                 "stabile"@it.
cis:toponym a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "Proprietà che rappresenta il toponimo dell'area geografica."@it,
                         "This property represents the toponym of a geographical area."@en;
            rdfs:domain cis:GeographicalFeature;
            rdfs:label "toponimo"@it,
                       "toponym"@en;
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf cis:name;
            <http://www.w3.org/2002/07/owl#versionInfo> "stabile"@it,
                                                        "stable"@en.
cis:url a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:comment "Thi property represents an URL."@en,
                     "Questa proprietà rappresenta un URL"@it;
        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (cis:AudioObject
                                                              cis:ImageObject
                                                              cis:NewsArticle
                                                              cis:VideoObject) ; 
                     a <http://www.w3.org/2002/07/owl#Class>];
        rdfs:label cis:,
                   "url"@it,
                   "url"@en;
        rdfs:range xsd:anyURI;
        <http://www.w3.org/2002/07/owl#versionInfo> "versione non definitiva"@it,
                                                    "unstable"@en.
cis:withRole a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "Property used to associate the situation role in time with the role itself"@en,
                          "Proprietà che consente di associare la situazione ruolo nel tempo con il ruolo stesso."@it;
             rdfs:domain cis:RoleInTime;
             rdfs:isDefinedBy cis:;
             rdfs:label "con ruolo"@it,
                        "with Role"@en;
             rdfs:range cis:Role;
             <http://www.w3.org/2002/07/owl#versionInfo> "stable",
                                                         "stabile"@it.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
