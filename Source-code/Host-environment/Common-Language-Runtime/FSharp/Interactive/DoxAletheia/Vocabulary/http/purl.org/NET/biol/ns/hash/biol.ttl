biol:BotTaxonomy <http://purl.org/dc/terms/description> """A BotTaxonomy is a subclass of Taxonomy. It is not necessarily used to
describe a plant. Most of the time, it is more appropriate to use Taxonomy
instead."""@en;
                 a rdfs:Class;
                 <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_BotTaxonomy>;
                 rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_BotTaxonomy>;
                 rdfs:label "Botanical Taxonomy"@en;
                 rdfs:subClassOf biol:Taxonomy.
biol:Taxonomy <http://purl.org/dc/terms/description> """A taxonomy is a classification for something. An animal or plant <em xmlns=\"http://www.w3.org/1999/xhtml\">has</em> a taxonomy; an animal or plant <em xmlns=\"http://www.w3.org/1999/xhtml\">is not</em> a taxonomy. For those familiar with object-oriented programming, think of a taxonomy as being analogous to a class, not an object."""^^rdf:XMLLiteral;
              a rdfs:Class;
              <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_Taxonomy>;
              rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_Taxonomy>;
              rdfs:label "Taxonomy"@en;
              rdfs:subClassOf rdfs:Class.
biol:ZooTaxonomy <http://purl.org/dc/terms/description> """A ZooTaxonomy is a subclass of Taxonomy. It is not necessarily used to
describe an animal, but it indicates that certain ambiguous terms, such as
\"division\" should be interpreted the way zoologists use them. Most of the
time, it is more appropriate to use Taxonomy instead."""@en;
                 a rdfs:Class;
                 <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_ZooTaxonomy>;
                 rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_ZooTaxonomy>;
                 rdfs:label "Zoological Taxonomy"@en;
                 rdfs:subClassOf biol:Taxonomy.
biol:authority <http://purl.org/dc/terms/description> """The authority who classified this form of life. For example \"Linnaeus, 1758\"."""@en;
               a rdf:Property;
               <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_authority>;
               rdfs:domain biol:Taxonomy;
               rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_authority>;
               rdfs:label "authority"@en;
               rdfs:range rdfs:Literal.
biol:class <http://purl.org/dc/terms/description> """The third highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Mammalia</i>."""^^rdf:XMLLiteral;
           a rdf:Property;
           <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_class>;
           rdfs:domain biol:Taxonomy;
           rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_class>;
           rdfs:label "class"@en;
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf biol:rank.
biol:commonName <http://purl.org/dc/terms/description> """A non-scientific name. For example, \"Human\"."""@en;
                a rdf:Property;
                <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_commonName>;
                rdfs:domain biol:Taxonomy;
                rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_commonName>;
                rdfs:label "common name"@en;
                rdfs:range rdfs:Literal;
                rdfs:subPropertyOf rdfs:label.
biol:division <http://purl.org/dc/terms/description> """The second highest level of classification, as used by botanists. Note that
division may be used to describe any form of life — the use of division is
not meant to imply that the entity being described is a plant, merely that
botanical names of ranks are being used. Zoologists use the term \"division\"
to describe a rank between an \"infraclass\" and a \"cohort\". biol:division
should not be used for this purpose — use biol:rank instead."""@en;
              a rdf:Property;
              <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_division>;
              rdfs:domain biol:Taxonomy;
              rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_division>;
              rdfs:label "division"@en;
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf biol:secondLevelClassification.
biol:family <http://purl.org/dc/terms/description> """The fifth highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Hominidae</i>."""^^rdf:XMLLiteral;
            a rdf:Property;
            <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_family>;
            rdfs:domain biol:Taxonomy;
            rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_family>;
            rdfs:label "family"@en;
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf biol:rank.
biol:genus <http://purl.org/dc/terms/description> """The sixth highest level of classification. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Homo</i>."""^^rdf:XMLLiteral;
           a rdf:Property;
           <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_genus>;
           rdfs:domain biol:Taxonomy;
           rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_genus>;
           rdfs:label "genus"@en;
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf biol:rank.
biol:hasTaxonomy <http://purl.org/dc/terms/description> """This property provides a relationship between an entity (such as a <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"http://xmlns.com/foaf/spec/#term_Person\">foaf:Person</a>) and a taxonomy. Because biologists don't always agree on how to classify life, a single entity may have multiple taxonomies, each of which may be differentiated between using <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#term_authority\">biol:authority</a> or dc:date."""^^rdf:XMLLiteral;
                 a rdf:Property;
                 <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_hasTaxonomy>;
                 rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_hasTaxonomy>;
                 rdfs:label "taxonomy"@en;
                 rdfs:range biol:Taxonomy;
                 rdfs:subPropertyOf rdf:type.
biol:kingdom <http://purl.org/dc/terms/description> """The highest-level and least specific level of classification. Example kingdoms are <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Animalia</i> and <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Plantae</i>."""^^rdf:XMLLiteral;
             a rdf:Property;
             <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_kingdom>;
             rdfs:domain biol:Taxonomy;
             rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_kingdom>;
             rdfs:label "kingdom"@en;
             rdfs:range rdfs:Literal;
             rdfs:subPropertyOf biol:rank.
biol:morePrecise <http://purl.org/dc/terms/description> """Connects a taxonomy to a more precise taxonomy. For example, the taxonomy
\"Mammal\" might have a \"more precise\" property linking to \"Primate\"."""@en;
                 a rdf:Property;
                 <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_morePrecise>;
                 rdfs:domain biol:Taxonomy;
                 rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_morePrecise>;
                 rdfs:label "more precise"@en;
                 rdfs:range biol:Taxonomy;
                 rdfs:subPropertyOf [<http://www.w3.org/2002/07/owl#inverseOf> rdfs:subClassOf],
                                    [<http://www.w3.org/2002/07/owl#inverseOf> rdfs:subClassOf].
biol:name <http://purl.org/dc/terms/description> """A scientific name; a binomial or trinomial. For example, <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Homo sapiens</i>."""^^rdf:XMLLiteral;
          a rdf:Property;
          <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_name>;
          rdfs:domain biol:Taxonomy;
          rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_name>;
          rdfs:label "name"@en;
          rdfs:range rdfs:Literal.
biol:order <http://purl.org/dc/terms/description> """The fourth highest level of classification. For example \"Primates\"."""@en;
           a rdf:Property;
           <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_order>;
           rdfs:domain biol:Taxonomy;
           rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_order>;
           rdfs:label "order"@en;
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf biol:rank.
biol:phylum <http://purl.org/dc/terms/description> """The second highest level of classification, as used by zoologists. Note that
phylum may be used to describe any form of life — the use of phylum is not
meant to imply that the entity being described is an animal, merely that
zoological names of ranks are being used."""@en;
            a rdf:Property;
            <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_phylum>;
            rdfs:domain biol:Taxonomy;
            rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_phylum>;
            rdfs:label "phylum"@en;
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf biol:secondLevelClassification.
biol:rank <http://purl.org/dc/terms/description> "An unspecified classification. This should not normally be used."@en;
          a rdf:Property;
          <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_rank>;
          rdfs:domain biol:Taxonomy;
          rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_rank>;
          rdfs:label "rank"@en;
          rdfs:range rdfs:Literal;
          rdfs:subPropertyOf <urn:lsid:ubio.org:predicates:taxonomicGroup>.
biol:secondLevelClassification <http://purl.org/dc/terms/description> """The second highest level of classification. Zoologists call these <i xmlns=\"http://www.w3.org/1999/xhtml\">phyla</i> and botanists call them \"divisions\". In general, you should pick one of those terms and use it instead."""^^rdf:XMLLiteral;
                               a rdf:Property;
                               <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_secondLevelClassification>;
                               rdfs:domain biol:Taxonomy;
                               rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_secondLevelClassification>;
                               rdfs:label "second level classification"@en;
                               rdfs:range rdfs:Literal;
                               rdfs:subPropertyOf biol:rank.
biol:seeAlso <http://purl.org/dc/terms/description> "A link to another resource further describing this form of life."@en;
             a rdf:Property;
             <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_seeAlso>;
             rdfs:domain biol:Taxonomy;
             rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_seeAlso>;
             rdfs:label "see also"@en;
             rdfs:range rdfs:Resource;
             rdfs:subPropertyOf rdfs:seeAlso.
biol:species <http://purl.org/dc/terms/description> """The lowest level of classification supported by this vocabulary. For example <i xmlns=\"http://www.w3.org/1999/xhtml\" class=\"taxon\">Sapiens</i>. To include information more specific than species, use <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#term_rank\">biol:rank</a> or <a xmlns=\"http://www.w3.org/1999/xhtml\" href=\"#section_Abstract\">a more specialist vocabulary</a>."""^^rdf:XMLLiteral;
             a rdf:Property;
             <http://www.w3.org/1999/xhtml/vocab#bookmark> <http://purl.org/NET/biol/ns.html#term_species>;
             rdfs:domain biol:Taxonomy;
             rdfs:isDefinedBy <http://purl.org/NET/biol/ns.html#term_species>;
             rdfs:label "species"@en;
             rdfs:range rdfs:Literal;
             rdfs:subPropertyOf biol:rank.
rdf:type rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_type>.
rdfs:Class rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_class>.
rdfs:Literal rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_literal>.
rdfs:Resource rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_resource>.
rdfs:label rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_label>.
rdfs:seeAlso rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_seealso>.
rdfs:subClassOf rdfs:isDefinedBy <http://www.w3.org/TR/rdf-schema/#ch_subclassof>.
