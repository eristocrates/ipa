                    dcterms:title "Taxonomic rank"@en.
<http://microformats.org/wiki/species> dcterms:publisher "microformats.org"@en;
                                       dcterms:title "species"@en.
biol: dcterms:bibliographicCitation <http://microformats.org/wiki/species>,
                                    wiki:Taxonomic_rank;
      dcterms:conformsTo <http://www.w3.org/TR/rdfa-syntax>;
      dcterms:creator [biol:hasTaxonomy [biol:order "Primates"@en ; 
                                         biol:seeAlso <http://species.wikimedia.org/wiki/Homo_sapiens> ; 
                                         biol:name "Homo sapiens"@en ; 
                                         biol:authority "Linnaeus, 1758"@en ; 
                                         biol:species "Sapiens"@en ; 
                                         biol:family "Hominidae"@en ; 
                                         biol:class "Mammalia"@en ; 
                                         dcterms:date "2008-05-08"@en ; 
                                         biol:kingdom "Animalia"@en ; 
                                         biol:phylum "Chordata"@en ; 
                                         biol:genus "Homo"@en] ; 
                       foaf:page <http://tobyinkster.co.uk/> ; 
                       foaf:name "Toby Inkster"@en ; 
                       a foaf:Person],
                      [biol:hasTaxonomy [biol:phylum "Chordata"@en ; 
                                         biol:seeAlso <http://species.wikimedia.org/wiki/Homo_sapiens> ; 
                                         biol:species "Sapiens"@en ; 
                                         biol:genus "Homo"@en ; 
                                         biol:class "Mammalia"@en ; 
                                         biol:family "Hominidae"@en ; 
                                         dcterms:date "2008-05-08"@en ; 
                                         biol:order "Primates"@en ; 
                                         biol:name "Homo sapiens"@en ; 
                                         biol:kingdom "Animalia"@en ; 
                                         biol:authority "Linnaeus, 1758"@en] ; 
                       foaf:page <http://tobyinkster.co.uk/> ; 
                       foaf:name "Toby Inkster"@en ; 
                       a foaf:Person];
      dcterms:license <http://creativecommons.org/licenses/by-sa/2.0/uk/>;
      dcterms:modified "2008-10-06"@en;
      dcterms:title "Biological Taxonomy Vocabulary 0.2 (Core)"@en;
      a owl:Ontology;
