ical:DomainOf_rrule a owl:Class.
ical:List_of_Float a owl:Class.
ical:Valarm a owl:Class;
            rdfs:comment "Provide a grouping of component properties that define an alarm.";
            rdfs:label "VALARM";
            rdfs:subClassOf [owl:onProperty ical:attendee ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:action ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:duration ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:description ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:summary ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:repeat ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:attach ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction],
                            [owl:onProperty ical:trigger ; 
                             owl:minCardinality 0  ; 
                             a owl:Restriction].
ical:Value_CAL-ADDRESS a owl:Class.
ical:Value_DATE a owl:Class.
ical:Value_DATE-TIME a owl:Class.
ical:Value_DURATION a owl:Class.
ical:Value_PERIOD a owl:Class.
ical:Value_RECUR a owl:Class.
ical:Vevent a owl:Class;
