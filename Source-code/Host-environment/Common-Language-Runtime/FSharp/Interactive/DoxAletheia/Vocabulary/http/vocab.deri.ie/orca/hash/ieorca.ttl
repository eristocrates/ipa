@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ieorca: <http://vocab.deri.ie/orca#>.

<http://vocab.deri.ie/orca> <http://purl.org/dc/elements/1.1/creator> ieorca:Jodi%20Schneider,
                                                                      ieorca:ahogan;
                            <http://purl.org/dc/terms/created> "2012-07-19"^^xsd:date;
                            <http://purl.org/dc/terms/description> "orca, the Ontology of Reasoning, Certainty and Attribution, is an ontology for characterizing the certainty of information, how it is known, and its source";
                            <http://purl.org/dc/terms/modified> "2012-11-09"^^xsd:date;
                            <http://purl.org/dc/terms/partOf> <http://vocab.deri.ie/>;
                            <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                            <http://purl.org/dc/terms/title> "orca, the Ontology of Reasoning, Certainty and Attribution";
                            <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "orca";
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://vocab.deri.ie/orca#";
                            a <http://www.w3.org/ns/adms#SemanticAsset>,
                              <http://www.w3.org/2002/07/owl#Ontology>;
                            <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/orca.html>.
ieorca:AuthorExplicitly a ieorca:Source;
                        rdfs:comment "Indicates knowledge explicitly attributed to the author."@en;
                        rdfs:label "author, explicitly"@en.
ieorca:AuthorImplicitly a ieorca:Source;
                        rdfs:comment "Indicates knowledge implicitly attributed to the author."@en;
                        rdfs:label "author, implicitly"@en.
ieorca:Basis a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Indicates the basis of the knowledge";
             rdfs:label "Basis".
ieorca:ConfidenceLevel a rdfs:Class,
                         <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Indicates how certain the knowledge is";
                       rdfs:label "ConfidenceLevel".
ieorca:DERI a <http://purl.org/dc/terms/Agent>;
            <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/orca>;
            <http://xmlns.com/foaf/0.1/member> ieorca:Jodi%20Schneider;
            <http://xmlns.com/foaf/0.1/name> "DERI".
ieorca:Data a ieorca:Basis;
            rdfs:comment "Indicates knowledge known by data."@en;
            rdfs:label "data"@en.
ieorca:DoxasticKnowledge ieorca:directlyMoreCertainThan ieorca:DubitativeKnowledge;
                         a ieorca:ConfidenceLevel;
                         rdfs:comment "Indicates duoxastic knowledge: complete certainty, reflecting an accepted, known and/or proven fact."@en;
                         rdfs:label "doxastic knowledge: complete certainty, reflecting an accepted, known and/or proven fact"@en.
ieorca:DubitativeKnowledge ieorca:directlyLessCertainThan ieorca:DoxasticKnowledge;
                           ieorca:directlyMoreCertainThan ieorca:HypotheticalKnowledge;
                           a ieorca:ConfidenceLevel;
                           rdfs:comment "Indicates dubitative knowledge: higher likelihood but short of complete certainty."@en;
                           rdfs:label "dubitative knowledge: higher likelihood but short of complete certainty"@en.
ieorca:HypotheticalKnowledge ieorca:directlyLessCertainThan ieorca:DubitativeKnowledge;
                             ieorca:directlyMoreCertainThan ieorca:LackOfKnowledge;
                             a ieorca:ConfidenceLevel;
                             rdfs:comment "Indicates hypothetical knowledge: low certainty."@en;
                             rdfs:label "hypothetical knowledge: low certainty"@en.
ieorca:Jodi%20Schneider a <http://xmlns.com/foaf/0.1/Person>;
                        <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/orca>;
                        <http://xmlns.com/foaf/0.1/mbox> <mailto:jodi.schneider@deri.org>;
                        <http://xmlns.com/foaf/0.1/name> "Jodi Schneider".
ieorca:LackOfKnowledge ieorca:directlyLessCertainThan ieorca:HypotheticalKnowledge;
                       a ieorca:ConfidenceLevel;
                       rdfs:comment "Indicates lack of knowledge."@en;
                       rdfs:label "lack of knowledge"@en.
ieorca:NamedExternalSource a ieorca:Source;
                           rdfs:comment "Indicates knowledge attributed to a named external source (either explicitly or as a reference)."@en;
                           rdfs:label "named external source"@en.
ieorca:NamelessExternalSource a ieorca:Source;
                              rdfs:comment "Indicates knowledge attributed to a nameless external source."@en;
                              rdfs:label "nameless external source"@en.
ieorca:NoSource a ieorca:Source;
                rdfs:comment "Indicates knowledge not attributed to any source."@en;
                rdfs:label "no source"@en.
ieorca:Reasoning a ieorca:Basis;
                 rdfs:comment "Indicates knowledge known by reasoning."@en;
                 rdfs:label "reasoning"@en.
ieorca:Source a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Indicates the source of the knowledge";
              rdfs:label "Source".
ieorca:Unidentified a ieorca:Basis;
                    rdfs:comment "Indicates knowledge whose basis is unidentified."@en;
                    rdfs:label "unidentified"@en.
ieorca:ahogan a <http://xmlns.com/foaf/0.1/Person>;
              <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/orca>;
              <http://xmlns.com/foaf/0.1/name> "Aidan Hogan".
ieorca:directlyLessCertainThan a rdf:Property;
                               rdfs:label "directlyLessCertainThan";
                               rdfs:subPropertyOf ieorca:lessCertain.
ieorca:directlyMoreCertainThan a rdf:Property;
                               rdfs:label "directlyMoreCertainThan";
                               rdfs:subPropertyOf ieorca:moreCertain.
ieorca:hasBasis a rdf:Property;
                rdfs:comment "Indicates the basis of the knowledge.";
                rdfs:label "hasBasis";
                rdfs:range ieorca:Basis.
ieorca:hasConfidenceLevel a rdf:Property;
                          rdfs:comment "Indicates the confidence/certainty level of the knowledge.";
                          rdfs:label "hasConfidenceLevel";
                          rdfs:range ieorca:ConfidenceLevel.
ieorca:hasSource a rdf:Property;
                 rdfs:comment "Indicates the source of the knowledge.";
                 rdfs:label "hasSource";
                 rdfs:range ieorca:Source.
ieorca:lessCertain a rdf:Property;
                   rdfs:label "lessCertain".
ieorca:moreCertain a rdf:Property;
                   rdfs:label "moreCertain".
ieorca:rdf <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/orca>;
           a <http://www.w3.org/ns/adms#SemanticDistribution>;
           <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/orca.rdf";
           <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
ieorca:ttl <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/orca>;
           a <http://www.w3.org/ns/adms#SemanticDistribution>;
           <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/orca.ttl";
           <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
