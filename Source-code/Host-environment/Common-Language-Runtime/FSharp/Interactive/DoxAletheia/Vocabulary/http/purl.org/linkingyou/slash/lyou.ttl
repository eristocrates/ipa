@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lyou: <http://purl.org/linkingyou/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

lyou: dcterms:creator "Christopher Gutteridge",
                      "Nick Jackson",
                      "Joss Winn";
      dcterms:description "Vocabulary for describing common webpages provided by an organisation."@en-gb;
      dcterms:issued "2012-12-01"^^xsd:date;
      dcterms:publisher "University of Southampton";
      dcterms:source <http://lncn.eu/toolkit>;
      dcterms:title "Linking-you vocabulary"@en;
      a owl:Ontology.
lyou:about dcterms:subject lyou:core;
           a rdf:Property,
             owl:ObjectProperty;
           rdfs:domain foaf:Organization;
           rdfs:isDefinedBy lyou:;
           rdfs:label "about page"@en;
           rdfs:range foaf:Document.
lyou:about-executive dcterms:subject lyou:extended;
                     a rdf:Property,
                       owl:ObjectProperty;
                     rdfs:comment "Links a group or organisation to a page about the senior staff, be it Microsoft's senior staff or the committee members of a university club. This was not a linkingyou term."@en;
                     rdfs:domain foaf:Organization;
                     rdfs:isDefinedBy lyou:;
                     rdfs:label "executive page"@en;
                     rdfs:range foaf:Document.
lyou:about-leader dcterms:subject lyou:extended;
                  a rdf:Property,
                    owl:ObjectProperty;
                  rdfs:comment "Links a group or organisation to a page about the leader of that organisation. This is modified from the linkingyou 'vc' page to make it work for organistations where the leader is not a Vice Chancellor."@en;
                  rdfs:domain foaf:Organization;
                  rdfs:isDefinedBy lyou:;
                  rdfs:label "leader page"@en;
                  rdfs:range foaf:Document.
lyou:about-parents dcterms:subject lyou:education;
                   a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "information for parents page"@en;
                   rdfs:range foaf:Document.
lyou:about-sites dcterms:subject lyou:extended;
                 a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:comment "Links a group or organisation to a page about the sites or campuses of that organisation. Was about/campuses in linkingyou, but altered here to be less academic-only."@en;
                 rdfs:domain foaf:Organization;
                 rdfs:isDefinedBy lyou:;
                 rdfs:label "sites page"@en;
                 rdfs:range foaf:Document.
lyou:about-strategy dcterms:subject lyou:extended;
                    a rdf:Property,
                      owl:ObjectProperty;
                    rdfs:domain foaf:Organization;
                    rdfs:isDefinedBy lyou:;
                    rdfs:label "strategy page"@en;
                    rdfs:range foaf:Document.
lyou:academia rdfs:comment "This is used to identify which predicates are related to academia (other than education) so they can be listed separately in the documentation."@en;
              rdfs:label "Academia".
lyou:academic-depts dcterms:subject lyou:academia;
                    a rdf:Property,
                      owl:ObjectProperty;
                    rdfs:domain foaf:Organization;
                    rdfs:isDefinedBy lyou:;
                    rdfs:label "academic departments page"@en;
                    rdfs:range foaf:Document.
lyou:business dcterms:subject lyou:core;
              a rdf:Property,
                owl:ObjectProperty;
              rdfs:domain foaf:Organization;
              rdfs:isDefinedBy lyou:;
              rdfs:label "business page"@en;
              rdfs:range foaf:Document.
lyou:business-incubation dcterms:subject lyou:academia;
                         a rdf:Property,
                           owl:ObjectProperty;
                         rdfs:domain foaf:Organization;
                         rdfs:isDefinedBy lyou:;
                         rdfs:label "business incubation page"@en;
                         rdfs:range foaf:Document.
lyou:business-ktp dcterms:subject lyou:academia;
                  a rdf:Property,
                    owl:ObjectProperty;
                  rdfs:domain foaf:Organization;
                  rdfs:isDefinedBy lyou:;
                  rdfs:label "business knowlege transfer partnerships page"@en;
                  rdfs:range foaf:Document.
lyou:conference-facilities dcterms:subject lyou:academia;
                           a rdf:Property,
                             owl:ObjectProperty;
                           rdfs:domain foaf:Organization;
                           rdfs:isDefinedBy lyou:;
                           rdfs:label "conference facilities page"@en;
                           rdfs:range foaf:Document.
lyou:conferences dcterms:subject lyou:academia;
                 a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:domain foaf:Organization;
                 rdfs:isDefinedBy lyou:;
                 rdfs:label "conferences page"@en;
                 rdfs:range foaf:Document.
lyou:contact dcterms:subject lyou:core;
             a rdf:Property,
               owl:ObjectProperty;
             rdfs:domain foaf:Organization;
             rdfs:isDefinedBy lyou:;
             rdfs:label "contact page"@en;
             rdfs:range foaf:Document.
lyou:contact-staff dcterms:subject lyou:extended;
                   a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:comment "A page giving contact details for staff in the organisation. Generally this is a searchable phonebook."@en;
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "staff contact page"@en;
                   rdfs:range foaf:Document.
lyou:core rdfs:comment "This is used to identify which predicates represent a simple core of Linking You"@en;
          rdfs:label "Core".
lyou:courses dcterms:subject lyou:education;
             a rdf:Property,
               owl:ObjectProperty;
             rdfs:domain foaf:Organization;
             rdfs:isDefinedBy lyou:;
             rdfs:label "courses page"@en;
             rdfs:range foaf:Document.
lyou:depts dcterms:subject lyou:core;
           a rdf:Property,
             owl:ObjectProperty;
           rdfs:comment "Links a group or organisation to a document describing its parts. This is not a linkingyou term but was added as the existing terms were only applicable to academia."@en;
           rdfs:domain foaf:Organization;
           rdfs:isDefinedBy lyou:;
           rdfs:label "departments page"@en;
           rdfs:range foaf:Document.
lyou:education rdfs:comment "This is used to identify which predicates are related to education so they can be listed separately in the documentation."@en;
               rdfs:label "Education".
lyou:events dcterms:subject lyou:core;
            a rdf:Property,
              owl:ObjectProperty;
            rdfs:domain foaf:Organization;
            rdfs:isDefinedBy lyou:;
            rdfs:label "events page"@en;
            rdfs:range foaf:Document.
lyou:events-graduation dcterms:subject lyou:education;
                       a rdf:Property,
                         owl:ObjectProperty;
                       rdfs:domain foaf:Organization;
                       rdfs:isDefinedBy lyou:;
                       rdfs:label "graduation event page"@en;
                       rdfs:range foaf:Document.
lyou:extended rdfs:comment "Predicates only useful to UK organisations"@en,
                           "This is used to identify which predicates are outside the the core terms. Still useful but listed in a second section."@en;
              rdfs:label "UK",
                         "Extended Terms".
lyou:foundation dcterms:subject lyou:education;
                a rdf:Property,
                  owl:ObjectProperty;
                rdfs:domain foaf:Organization;
                rdfs:isDefinedBy lyou:;
                rdfs:label "foundation admissions page"@en;
                rdfs:range foaf:Document.
lyou:foundation-courses dcterms:subject lyou:education;
                        a rdf:Property,
                          owl:ObjectProperty;
                        rdfs:domain foaf:Organization;
                        rdfs:isDefinedBy lyou:;
                        rdfs:label "foundation courses page"@en;
                        rdfs:range foaf:Document.
lyou:foundation-courses-entry-requirements dcterms:subject lyou:education;
                                           a rdf:Property,
                                             owl:ObjectProperty;
                                           rdfs:domain foaf:Organization;
                                           rdfs:isDefinedBy lyou:;
                                           rdfs:label "foundation courses entry requirements page"@en;
                                           rdfs:range foaf:Document.
lyou:foundation-prospectus dcterms:subject lyou:education;
                           a rdf:Property,
                             owl:ObjectProperty;
                           rdfs:comment "Link a university, or other degree awarding organisation, to its foundation prospectus. This may be an HTML or PDF document."@en;
                           rdfs:domain foaf:Organization;
                           rdfs:isDefinedBy lyou:;
                           rdfs:label "foundation prospectus page"@en;
                           rdfs:range foaf:Document.
lyou:ict-support dcterms:subject lyou:extended;
                 a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:domain foaf:Organization;
                 rdfs:isDefinedBy lyou:;
                 rdfs:label "ICT support page"@en;
                 rdfs:range foaf:Document.
lyou:international-students dcterms:subject lyou:education;
                            a rdf:Property,
                              owl:ObjectProperty;
                            rdfs:domain foaf:Organization;
                            rdfs:isDefinedBy lyou:;
                            rdfs:label "information for international students page"@en;
                            rdfs:range foaf:Document.
lyou:jobs dcterms:subject lyou:core;
          a rdf:Property,
            owl:ObjectProperty;
          rdfs:domain foaf:Organization;
          rdfs:isDefinedBy lyou:;
          rdfs:label "jobs page"@en;
          rdfs:range foaf:Document.
lyou:legal dcterms:subject lyou:core;
           a rdf:Property,
             owl:ObjectProperty;
           rdfs:domain foaf:Organization;
           rdfs:isDefinedBy lyou:;
           rdfs:label "legal page"@en;
           rdfs:range foaf:Document.
lyou:legal-data-protection dcterms:subject lyou:extended;
                           a rdf:Property,
                             owl:ObjectProperty;
                           rdfs:domain foaf:Organization;
                           rdfs:isDefinedBy lyou:;
                           rdfs:label "data-protection statement page"@en;
                           rdfs:range foaf:Document.
lyou:legal-environment dcterms:subject lyou:extended;
                       a rdf:Property,
                         owl:ObjectProperty;
                       rdfs:domain foaf:Organization;
                       rdfs:isDefinedBy lyou:;
                       rdfs:label "environmental policy page"@en;
                       rdfs:range foaf:Document.
lyou:legal-equality dcterms:subject lyou:extended;
                    a rdf:Property,
                      owl:ObjectProperty;
                    rdfs:domain foaf:Organization;
                    rdfs:isDefinedBy lyou:;
                    rdfs:label "equality policy page"@en;
                    rdfs:range foaf:Document.
lyou:legal-ethics dcterms:subject lyou:academia;
                  a rdf:Property,
                    owl:ObjectProperty;
                  rdfs:comment "Many research organisations have a public ethics policy."@en;
                  rdfs:domain foaf:Organization;
                  rdfs:isDefinedBy lyou:;
                  rdfs:label "ethics policy"@en;
                  rdfs:range foaf:Document.
lyou:legal-foi dcterms:subject lyou:extended;
               a rdf:Property,
                 owl:ObjectProperty;
               rdfs:domain foaf:Organization;
               rdfs:isDefinedBy lyou:;
               rdfs:label "freedom-of-information policy page"@en;
               rdfs:range foaf:Document.
lyou:legal-ict dcterms:subject lyou:extended;
               a rdf:Property,
                 owl:ObjectProperty;
               rdfs:domain foaf:Organization;
               rdfs:isDefinedBy lyou:;
               rdfs:label "ICT policy page"@en;
               rdfs:range foaf:Document.
lyou:legal-policies dcterms:subject lyou:extended;
                    a rdf:Property,
                      owl:ObjectProperty;
                    rdfs:domain foaf:Organization;
                    rdfs:isDefinedBy lyou:;
                    rdfs:label "policies page"@en;
                    rdfs:range foaf:Document.
lyou:legal-regulations dcterms:subject lyou:extended;
                       a rdf:Property,
                         owl:ObjectProperty;
                       rdfs:domain foaf:Organization;
                       rdfs:isDefinedBy lyou:;
                       rdfs:label "regulations page"@en;
                       rdfs:range foaf:Document.
lyou:legal-website dcterms:subject lyou:extended;
                   a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "website legal information page"@en;
                   rdfs:range foaf:Document.
lyou:news dcterms:subject lyou:core;
          a rdf:Property,
            owl:ObjectProperty;
          rdfs:domain foaf:Organization;
          rdfs:isDefinedBy lyou:;
          rdfs:label "news page"@en;
          rdfs:range foaf:Document.
lyou:open-data dcterms:subject lyou:extended;
               a rdf:Property,
                 owl:ObjectProperty;
               rdfs:comment "Links a group or organisation to a page (or the homepage of a website) describing open data services from the organisation, eg. http://data.lincoln.ac.uk/"@en;
               rdfs:domain foaf:Organization;
               rdfs:isDefinedBy lyou:;
               rdfs:label "open data page"@en;
               rdfs:range foaf:Document.
lyou:opendays dcterms:subject lyou:education;
              a rdf:Property,
                owl:ObjectProperty;
              rdfs:domain foaf:Organization;
              rdfs:isDefinedBy lyou:;
              rdfs:label "open days page"@en;
              rdfs:range foaf:Document.
lyou:postgraduate dcterms:subject lyou:education;
                  a rdf:Property,
                    owl:ObjectProperty;
                  rdfs:comment "covering research and taught postgraduates"@en;
                  rdfs:domain foaf:Organization;
                  rdfs:isDefinedBy lyou:;
                  rdfs:label "general postgraduate admissions page"@en;
                  rdfs:range foaf:Document.
lyou:postgraduate-research dcterms:subject lyou:education;
                           a rdf:Property,
                             owl:ObjectProperty;
                           rdfs:domain foaf:Organization;
                           rdfs:isDefinedBy lyou:;
                           rdfs:label "research postgraduate admissions page"@en;
                           rdfs:range foaf:Document.
lyou:postgraduate-research-courses dcterms:subject lyou:education;
                                   a rdf:Property,
                                     owl:ObjectProperty;
                                   rdfs:domain foaf:Organization;
                                   rdfs:isDefinedBy lyou:;
                                   rdfs:label "research postgraduate courses (or programmes) page"@en;
                                   rdfs:range foaf:Document.
lyou:postgraduate-research-courses-entry-requirements dcterms:subject lyou:education;
                                                      a rdf:Property,
                                                        owl:ObjectProperty;
                                                      rdfs:domain foaf:Organization;
                                                      rdfs:isDefinedBy lyou:;
                                                      rdfs:label "research postgraduate entry requirements page"@en;
                                                      rdfs:range foaf:Document.
lyou:postgraduate-research-prospectus dcterms:subject lyou:education;
                                      a rdf:Property,
                                        owl:ObjectProperty;
                                      rdfs:comment "Link a university, or other degree awarding organisation, to its research postgraduate prospectus. This may be an HTML or PDF document."@en;
                                      rdfs:domain foaf:Organization;
                                      rdfs:isDefinedBy lyou:;
                                      rdfs:label "research postgraduate prospectus page"@en;
                                      rdfs:range foaf:Document.
lyou:postgraduate-taught dcterms:subject lyou:education;
                         a rdf:Property,
                           owl:ObjectProperty;
                         rdfs:domain foaf:Organization;
                         rdfs:isDefinedBy lyou:;
                         rdfs:label "taught postgraduate admissions page"@en;
                         rdfs:range foaf:Document.
lyou:postgraduate-taught-courses dcterms:subject lyou:education;
                                 a rdf:Property,
                                   owl:ObjectProperty;
                                 rdfs:domain foaf:Organization;
                                 rdfs:isDefinedBy lyou:;
                                 rdfs:label "taught postgraduate courses page"@en;
                                 rdfs:range foaf:Document.
lyou:postgraduate-taught-courses-entry-requirements dcterms:subject lyou:education;
                                                    a rdf:Property,
                                                      owl:ObjectProperty;
                                                    rdfs:domain foaf:Organization;
                                                    rdfs:isDefinedBy lyou:;
                                                    rdfs:label "taught postgraduate entry requirements page"@en;
                                                    rdfs:range foaf:Document.
lyou:postgraduate-taught-prospectus dcterms:subject lyou:education;
                                    a rdf:Property,
                                      owl:ObjectProperty;
                                    rdfs:comment "Link a university, or other degree awarding organisation, to its taught postgraduate prospectus. This may be an HTML or PDF document."@en;
                                    rdfs:domain foaf:Organization;
                                    rdfs:isDefinedBy lyou:;
                                    rdfs:label "taught postgraduate prospectus page"@en;
                                    rdfs:range foaf:Document.
lyou:press dcterms:subject lyou:core;
           a rdf:Property,
             owl:ObjectProperty;
           rdfs:comment "A page with information specifically aimed at journalists."@en;
           rdfs:domain foaf:Organization;
           rdfs:isDefinedBy lyou:;
           rdfs:label "press page"@en;
           rdfs:range foaf:Document.
lyou:press-facts dcterms:subject lyou:extended;
                 a rdf:Property,
                   owl:ObjectProperty;
                 rdfs:comment "A page aimed at the press with a list of useful facts about the organisation."@en;
                 rdfs:domain foaf:Organization;
                 rdfs:isDefinedBy lyou:;
                 rdfs:label "press facts page"@en;
                 rdfs:range foaf:Document.
lyou:public-lectures dcterms:subject lyou:academia;
                     a rdf:Property,
                       owl:ObjectProperty;
                     rdfs:domain foaf:Organization;
                     rdfs:isDefinedBy lyou:;
                     rdfs:label "public lectures page"@en;
                     rdfs:range foaf:Document.
lyou:research dcterms:subject lyou:academia;
              a rdf:Property,
                owl:ObjectProperty;
              rdfs:domain foaf:Organization;
              rdfs:isDefinedBy lyou:;
              rdfs:label "research page"@en;
              rdfs:range foaf:Document.
lyou:search dcterms:subject lyou:core;
            a rdf:Property,
              owl:ObjectProperty;
            rdfs:comment "Perhaps this should link to a string with a variable in to indicate how to construct a search?"@en;
            rdfs:domain foaf:Organization;
            rdfs:isDefinedBy lyou:;
            rdfs:label "search page"@en;
            rdfs:range foaf:Document.
lyou:space-accessibility dcterms:subject lyou:extended;
                         a rdf:Property,
                           owl:ObjectProperty;
                         rdfs:comment "Links a group or organisation to a document describing the aspects of the location and environment of this organisation. Generally this will be for the benefit of a visitor with a physical or mental disability. May also be used to link a spatial thing (such as a building, airport, campus, bus) to a description of its accessibility."@en;
                         rdfs:isDefinedBy lyou:;
                         rdfs:label "spatial acessibility"@en;
                         rdfs:range foaf:Document.
lyou:support-depts dcterms:subject lyou:academia;
                   a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "support departments page"@en;
                   rdfs:range foaf:Document.
lyou:uk-ico-publication-scheme dcterms:subject lyou:uk;
                               a rdf:Property,
                                 owl:ObjectProperty;
                               rdfs:comment "[Generally only for UK public sector] A link to the publication scheme for this organisation as described by the UK Information Commissioner's Office. See http://www.ico.org.uk/for_organisations/freedom_of_information/guide/publication_scheme for more information."@en;
                               rdfs:domain foaf:Organization;
                               rdfs:isDefinedBy lyou:;
                               rdfs:label "ICO publication scheme"@en;
                               rdfs:range foaf:Document.
lyou:undergraduate dcterms:subject lyou:education;
                   a rdf:Property,
                     owl:ObjectProperty;
                   rdfs:domain foaf:Organization;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "undergraduate admissions page"@en;
                   rdfs:range foaf:Document.
lyou:undergraduate-courses dcterms:subject lyou:education;
                           a rdf:Property,
                             owl:ObjectProperty;
                           rdfs:domain foaf:Organization;
                           rdfs:isDefinedBy lyou:;
                           rdfs:label "undergraduate courses page"@en;
                           rdfs:range foaf:Document.
lyou:undergraduate-courses-entry-requirements dcterms:subject lyou:education;
                                              a rdf:Property,
                                                owl:ObjectProperty;
                                              rdfs:domain foaf:Organization;
                                              rdfs:isDefinedBy lyou:;
                                              rdfs:label "undergraduate courses entry requirements page"@en;
                                              rdfs:range foaf:Document.
lyou:undergraduate-prospectus dcterms:subject lyou:education;
                              a rdf:Property,
                                owl:ObjectProperty;
                              rdfs:comment "Link a university, or other degree awarding organisation, to its undergraduate prospectus. This may be an HTML or PDF document."@en;
                              rdfs:domain foaf:Organization;
                              rdfs:isDefinedBy lyou:;
                              rdfs:label "undergraduate prospectus page"@en;
                              rdfs:range foaf:Document.
lyou:web-accessibility dcterms:subject lyou:extended;
                       a rdf:Property,
                         owl:ObjectProperty;
                       rdfs:comment "Links a group or organisation to a document which describes the accessibility policy of the organisation regarding websites and online resources. May also be used to link the homepage of a website to an accessibility document."@en;
                       rdfs:isDefinedBy lyou:;
                       rdfs:label "web accessibility"@en;
                       rdfs:range foaf:Document.
foaf:homepage dcterms:subject lyou:core;
              a rdf:Property,
                owl:ObjectProperty;
              rdfs:comment "FOAF already defines a perfectly good way to indicate a homepage."@en;
              rdfs:isDefinedBy foaf:;
              rdfs:label "homepage"@en;
              rdfs:range foaf:Document.
