lyou: <http://purl.org/dc/terms/creator> "Christopher Gutteridge",
                                         "Nick Jackson",
                                         "Joss Winn";
      <http://purl.org/dc/terms/description> "Vocabulary for describing common webpages provided by an organisation."@en-gb;
      <http://purl.org/dc/terms/issued> "2012-12-01"^^xsd:date;
      <http://purl.org/dc/terms/publisher> "University of Southampton";
      <http://purl.org/dc/terms/source> <http://lncn.eu/toolkit>;
      <http://purl.org/dc/terms/title> "Linking-you vocabulary"@en;
      a <http://www.w3.org/2002/07/owl#Ontology>.
lyou:about <http://purl.org/dc/terms/subject> lyou:core;
           a rdf:Property,
             <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
           rdfs:isDefinedBy lyou:;
           rdfs:label "about page"@en;
           rdfs:range <http://xmlns.com/foaf/0.1/Document>.
lyou:about-executive <http://purl.org/dc/terms/subject> lyou:extended;
                     a rdf:Property,
                       <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links a group or organisation to a page about the senior staff, be it Microsoft's senior staff or the committee members of a university club. This was not a linkingyou term."@en;
                     rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
                     rdfs:isDefinedBy lyou:;
                     rdfs:label "executive page"@en;
                     rdfs:range <http://xmlns.com/foaf/0.1/Document>.
lyou:about-leader <http://purl.org/dc/terms/subject> lyou:extended;
                  a rdf:Property,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Links a group or organisation to a page about the leader of that organisation. This is modified from the linkingyou 'vc' page to make it work for organistations where the leader is not a Vice Chancellor."@en;
                  rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
                  rdfs:isDefinedBy lyou:;
                  rdfs:label "leader page"@en;
                  rdfs:range <http://xmlns.com/foaf/0.1/Document>.
lyou:about-parents <http://purl.org/dc/terms/subject> lyou:education;
                   a rdf:Property,
                     <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
                   rdfs:isDefinedBy lyou:;
                   rdfs:label "information for parents page"@en;
                   rdfs:range <http://xmlns.com/foaf/0.1/Document>.
lyou:about-sites <http://purl.org/dc/terms/subject> lyou:extended;
                 a rdf:Property,
                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Links a group or organisation to a page about the sites or campuses of that organisation. Was about/campuses in linkingyou, but altered here to be less academic-only."@en;
                 rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
                 rdfs:isDefinedBy lyou:;
                 rdfs:label "sites page"@en;
                 rdfs:range <http://xmlns.com/foaf/0.1/Document>.
