@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix reegle: <http://reegle.info/schema#>.

<http://reegle.info/schema> <http://creativecommons.org/ns#license> <http://www.nationalarchives.gov.uk/doc/open-government-licence>;
                            <http://purl.org/dc/terms/description> "A vocabulary describing the clean energy data published on http://data.reegle.info."@en;
                            <http://purl.org/dc/terms/issued> "2011-12-20"^^xsd:date;
                            <http://purl.org/dc/terms/modified> "2012-11-16"^^xsd:date;
                            <http://purl.org/dc/terms/title> "Reegle RDF Schema"@en;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "reegle";
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://reegle.info/schema#";
                            a <http://purl.org/vocommons/voaf#Vocabulary>,
                              <http://www.w3.org/2002/07/owl#Ontology>;
                            rdfs:comment "Version 1.1: Added vocabulary metadata and missing labels for some properties."@en;
                            <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
reegle:CountryProfile a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "country profle"@en.
reegle:ProjectOutput a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "output summary of a renewable energy & energy efficiency project."@en;
                     rdfs:label "project output"@en.
reegle:Sector a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A sector in the field of renewable energy and energy efficiency."@en;
              rdfs:label "sector"@en.
reegle:Specialisation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "specialisation"@en.
reegle:Technology a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "technology"@en.
reegle:activeIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "defines the countries an organisation is active in"@en;
                rdfs:label "is active in"@en;
                rdfs:range <http://www.geonames.org/ontology#Feature>.
reegle:activities a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "activities of the organisation in the renewable energy & energy efficiency sector."@en;
                  rdfs:label "activities"@en;
                  rdfs:range rdfs:Literal.
reegle:capacityConcerns a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain reegle:CountryProfile;
                        rdfs:label "capacity concerns"@en;
                        rdfs:range rdfs:Literal.
reegle:competition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain reegle:CountryProfile;
                   rdfs:label "competition"@en;
                   rdfs:range rdfs:Literal.
reegle:degreeIndependence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain reegle:CountryProfile;
                          rdfs:label "degree of independence"@en;
                          rdfs:range rdfs:Literal.
reegle:desirability a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain reegle:ProjectOutput;
                    rdfs:label "desirability"@en;
                    rdfs:range rdfs:Literal.
reegle:energyDebates a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain reegle:CountryProfile;
                     rdfs:label "energy debates"@en;
                     rdfs:range rdfs:Literal.
reegle:energyEfficiency a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain reegle:CountryProfile;
                        rdfs:label "energy efficiency"@en;
                        rdfs:range rdfs:Literal.
reegle:energyEfficiencyIndustry a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:domain reegle:CountryProfile;
                                rdfs:label "energy efficiency industry"@en;
                                rdfs:range rdfs:Literal.
reegle:energyEfficiencyPublic a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain reegle:CountryProfile;
                              rdfs:label "energy efficiency public"@en;
                              rdfs:range rdfs:Literal.
reegle:energyEfficiencyResidantial a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:domain reegle:CountryProfile;
                                   rdfs:label "energy efficiency residential"@en;
                                   rdfs:range rdfs:Literal.
reegle:energyEfficiencyTransport a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain reegle:CountryProfile;
                                 rdfs:label "energy efficiency transport"@en;
                                 rdfs:range rdfs:Literal.
reegle:energyEfficiencyUtilities a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain reegle:CountryProfile;
                                 rdfs:label "energy efficiency utilities"@en;
                                 rdfs:range rdfs:Literal.
reegle:energyFramework a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:CountryProfile;
                       rdfs:label "energy framework"@en;
                       rdfs:range rdfs:Literal.
reegle:energyProcedure a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:CountryProfile;
                       rdfs:label "energy procedure"@en;
                       rdfs:range rdfs:Literal.
reegle:energyRegulationRole a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:domain reegle:CountryProfile;
                            rdfs:label "energy regulation role"@en;
                            rdfs:range rdfs:Literal.
reegle:energyRegulator a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:CountryProfile;
                       rdfs:label "energy regulator"@en;
                       rdfs:range rdfs:Literal.
reegle:energyStudies a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain reegle:CountryProfile;
                     rdfs:label "energy debates"@en;
                     rdfs:range rdfs:Literal.
reegle:extendNetwork a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain reegle:CountryProfile;
                     rdfs:label "extend network"@en;
                     rdfs:range rdfs:Literal.
reegle:funded a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain reegle:ProjectOutput;
              rdfs:label "funded"@en;
              rdfs:range rdfs:Literal.
reegle:governmentAgencies a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain reegle:CountryProfile;
                          rdfs:label "government agencies"@en;
                          rdfs:range rdfs:Literal.
reegle:governmentRole a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain reegle:CountryProfile;
                      rdfs:label "role of the government"@en;
                      rdfs:range rdfs:Literal.
reegle:mission a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "the declared mission of the organisation."@en;
               rdfs:label "mission"@en;
               rdfs:range rdfs:Literal.
reegle:organisationType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain reegle:ProjectOutput;
                        rdfs:label "organisation type"@en;
                        rdfs:range rdfs:Literal.
reegle:ownership a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain reegle:CountryProfile;
                 rdfs:label "ownership"@en;
                 rdfs:range rdfs:Literal.
reegle:profile a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "has country profile"@en;
               rdfs:range reegle:CountryProfile.
reegle:projectDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain reegle:ProjectOutput;
                          rdfs:label "project description"@en;
                          rdfs:range rdfs:Literal.
reegle:projectExpertise a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain reegle:ProjectOutput;
                        rdfs:label "project expertise"@en;
                        rdfs:range rdfs:Literal.
reegle:projectTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain reegle:ProjectOutput;
                    rdfs:label "project title"@en;
                    rdfs:range rdfs:Literal.
reegle:referenceNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:ProjectOutput;
                       rdfs:label """reference number\""""@en;
                       rdfs:range <http://www.w3.org/2001/XMLSchema-datatypes#int>.
reegle:references a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain reegle:CountryProfile;
                  rdfs:label """references\""""@en;
                  rdfs:range <http://www.w3.org/2001/XMLSchema-datatypes#int>.
reegle:regulatoryBarriers a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain reegle:CountryProfile;
                          rdfs:label "regulatory barriers"@en;
                          rdfs:range rdfs:Literal.
reegle:regulatoryFramework a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain reegle:CountryProfile;
                           rdfs:label "regulatory framework"@en;
                           rdfs:range rdfs:Literal.
reegle:regulatoryRoles a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:CountryProfile;
                       rdfs:label "regulatory roles"@en;
                       rdfs:range rdfs:Literal.
reegle:reliance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain reegle:CountryProfile;
                rdfs:label "reliance"@en;
                rdfs:range rdfs:Literal.
reegle:renewableEnergy a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain reegle:CountryProfile;
                       rdfs:label "renewable energy"@en;
                       rdfs:range rdfs:Literal.
reegle:sector a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The sector an organisation is active in."@en;
              rdfs:domain reegle:ProjectOutput;
              rdfs:label "sector"@en,
                         "in sector"@en;
              rdfs:range rdfs:Literal,
                         reegle:Sector.
reegle:sources a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain reegle:CountryProfile;
               rdfs:label "energy sources"@en;
               rdfs:range rdfs:Literal.
reegle:specialisation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain reegle:ProjectOutput;
                      rdfs:label "specialisation"@en;
                      rdfs:range reegle:Specialisation.
reegle:targetAudience a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain reegle:ProjectOutput;
                      rdfs:label "target audience"@en;
                      rdfs:range rdfs:Literal.
reegle:technology a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "the technologies that are related to a project"@en;
                  rdfs:domain reegle:ProjectOutput;
                  rdfs:label "technology"@en;
                  rdfs:range reegle:Technology.
