@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ludo-vc: <http://ns.inria.fr/ludo/v1/virtualcontext#>.

<http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control> a <http://xmlns.com/foaf/0.1/Organization>.
<http://ns.inria.fr/ludo/v1/virtualcontext> a <http://www.w3.org/2002/07/owl#Ontology>.
ludo-vc: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
         <http://purl.org/dc/elements/1.1/creator> <http://www.oscarrodriguez.me/>,
                                                   <https://plus.google.com/106595696646939943813>;
         <http://purl.org/dc/elements/1.1/description> "This vocabulary is a component of Ludo. It was created to describe and represent the virtual context of a game player in a serious game."@en;
         <http://purl.org/dc/elements/1.1/issued> "2016-02-01"^^xsd:date;
         <http://purl.org/dc/elements/1.1/modified> "2016-08-09"^^xsd:date;
         <http://purl.org/dc/elements/1.1/publisher> <http://dbpedia.org/resource/National_Institute_for_Research_in_Computer_Science_and_Control>;
         <http://purl.org/dc/elements/1.1/rights> "This ontology is distributed under a Creative Commons Attribution License - http://creativecommons.org/licenses/by/3.0 ."@en;
         <http://purl.org/dc/elements/1.1/title> "Ludo - Virtual Context"@en;
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "virtualcontext";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://ns.inria.fr/ludo/v1/virtualcontext#";
         a <http://www.w3.org/2002/07/owl#Ontology>;
         rdfs:comment "Given the increasing amount of structured data published on the Web, many possibilities are open for creating new types of games that use resources from the Web of Data. In particular, if we consider the subcategory of Serious Games in which the object of the game is to educate the user through the interactive discovery of real-life concepts (associated to Semantic Web resources), the inclusion of a semantic representation of the user profile and his contextual information becomes an important element to recommend the user more accurate concepts. Ludo is an ontology that allows the creation of Serious Games with those characteristics."@en;
         <http://www.w3.org/2002/07/owl#imports> <http://xmlns.com/foaf/0.1/>;
         <http://www.w3.org/2002/07/owl#versionInfo> 0.1.
ludo-vc:GameLevel a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Represents the current (latest) game level in which the player is in the serious game"@en;
                  rdfs:isDefinedBy ludo-vc:;
                  rdfs:label "Game level"@en;
                  rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:NearbyPlayer a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "It represents the realation of proximity between two players"@en;
                     rdfs:isDefinedBy ludo-vc:;
                     rdfs:label "Nearby Player"@en;
                     rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:POI a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Point of interest"@en;
            rdfs:isDefinedBy ludo-vc:;
            rdfs:label "POI"@en;
            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                            <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:VirtualActivity a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Represents the virtual activity that the player is performing inside the game. Such as learning, exploring."@en;
                        rdfs:isDefinedBy ludo-vc:;
                        rdfs:label "Virtual activity"@en;
                        rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:VirtualLocation a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Represents the relation between a real life location and a location inside the game"@en;
                        rdfs:isDefinedBy ludo-vc:;
                        rdfs:label "Virtual location"@en;
                        rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasCurrentGameLevel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "The current level of the game in which the Gameplayer is"@en;
                            rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                            rdfs:isDefinedBy ludo-vc:;
                            rdfs:label "Has current game level"@en;
                            rdfs:range ludo-vc:GameLevel;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasCurrentPOI a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Given the current virtual location of a GamePlayer, it defines the corresponding POI in real life"@en;
                      rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                      rdfs:isDefinedBy ludo-vc:;
                      rdfs:label "Has current POI"@en;
                      rdfs:range ludo-vc:POI;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasCurrentVirtualActivity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "The currrent VirtualAcitivity of a GamePlayer"@en;
                                  rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                                  rdfs:isDefinedBy ludo-vc:;
                                  rdfs:label "Has currrent VirtualAcitivity"@en;
                                  rdfs:range ludo-vc:VirtualActivity;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasDistance a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Nearby player distance"@en;
                    rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                    rdfs:isDefinedBy ludo-vc:;
                    rdfs:label "Has distance"@en;
                    rdfs:range ludo-vc:NearbyPlayer;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasGameLevelLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "The label of the game level"@en;
                          rdfs:domain ludo-vc:GameLevel;
                          rdfs:isDefinedBy ludo-vc:;
                          rdfs:label "Has game level label"@en;
                          rdfs:range xsd:string;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasGameLevelNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "The numeric label of the game level"@en;
                           rdfs:domain ludo-vc:GameLevel;
                           rdfs:isDefinedBy ludo-vc:;
                           rdfs:label "Has game level number"@en;
                           rdfs:range xsd:nonNegativeInteger;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasPOICategory a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "The category of the POI"@en;
                       rdfs:domain ludo-vc:POI;
                       rdfs:isDefinedBy ludo-vc:;
                       rdfs:label "Has POI category"@en;
                       rdfs:range xsd:string;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasPOILabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "A label with the name of the POI"@en;
                    rdfs:domain ludo-vc:POI;
                    rdfs:isDefinedBy ludo-vc:;
                    rdfs:label "Has POI label"@en;
                    rdfs:range xsd:string;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:hasVirtualActivityLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:comment "Virtual Activity"@en;
                                rdfs:domain ludo-vc:VirtualActivity;
                                rdfs:isDefinedBy ludo-vc:;
                                rdfs:label "Virtual Activity"@en;
                                rdfs:range xsd:string;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ludo-vc:nearbyPlayerDistance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Nearby Player Distance in meters"@en;
                             rdfs:domain ludo-vc:NearbyPlayer;
                             rdfs:isDefinedBy ludo-vc:;
                             rdfs:label "Nearby Player Distance"@en;
                             rdfs:range xsd:decimal;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<http://www.oscarrodriguez.me/> a <http://xmlns.com/foaf/0.1/Person>.
<https://plus.google.com/106595696646939943813> a <http://xmlns.com/foaf/0.1/Person>.
