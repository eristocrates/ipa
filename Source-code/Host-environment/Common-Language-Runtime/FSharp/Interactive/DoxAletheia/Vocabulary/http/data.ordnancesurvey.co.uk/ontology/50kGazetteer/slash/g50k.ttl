@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix osgb: <http://data.ordnancesurvey.co.uk/id/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix gazetteer: <http://data.ordnancesurvey.co.uk/ontology/50kGazetteer/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

gazetteer: dc11:creator "Ordnance Survey"^^rdf:PlainLiteral;
           dc11:description "An ontology describing the 50K Gazetteer.";
           dcterms:creator osgb:ordnancesurvey;
           dcterms:publisher osgb:ordnancesurvey;
           a owl:Ontology;
           rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/50KGazetteer.owl>.
