losp: dcterms:creator "Panevin Denis",
                      "Dmitriev Alexey";
      dcterms:description "Ontology Specialties describes all possible specialties (directions) in the RF, in which the UGNS they are composed, as well as information about their old codes / groups / names."@en,
                          """Онтология \"Специальности\" описывает все возможные специальности(направления) в РФ, в каких УГНС они состоят, а также информация об их старых кодах/группах/названиях."""@ru;
      dcterms:issued "2017-03-01"^^xsd:date;
      dcterms:modified "2017-03-08"^^xsd:date;
      dcterms:title "Открытые связанные специальности РФ"@ru,
                    "Linked open specialities RF"@en;
      a owl:Ontology;
      rdfs:comment """Онтология \"Специальности\" описывает все возможные специальности(направления) в РФ, в каких УГНС они состоят, а также информация об их старых кодах/группах/названиях.""",
                   """Онтология \"Специальности\" описывает все возможные специальности(направления) в РФ, в каких УГНС они состоят, а также информация об их старых кодах/группах/названиях."""@ru,
                   "Ontology Specialties describes all possible specialties (directions) in the RF, in which the UGNS they are composed, as well as information about their old codes / groups / names."@en;
      owl:versionInfo 1.0.
losp:LevelEducation a owl:Class;
                    rdfs:comment """УровеньПодготовки - подкласс класса \"РазделениеЗначений\" необходим для задания экземплярам одного из значений: Бакалавриат, Магистратура, Специалитет.""",
                                 "UrovenPodgotovki - subclass SplitValues, needs to define instances of one of the values: Undergraduate, Graduate, Speciality."@en,
                                 "УровеньПодготовки - подкласс класса SplitValues, необходим для задания экземплярам одного из значений: Бакалавриат, Магистратура, Специалитет."@ru;
                    rdfs:subClassOf losp:SplitValues.
losp:ScientificSpeciality a owl:Class;
                          rdfs:comment "Научная специальность входит в направление подготовки аспирантуры",
                                       "Scientific specialty included in the field of training of postgraduate study"@en,
                                       "Научная специальность входит в направление подготовки аспирантуры"@ru.
losp:Speciality a owl:Class;
                rdfs:comment "Специальность - это наименование конкретного вида профессиональной подготовки, которая завершается присвоением квалификации. Имеет код и название.",
                             "Profession - is the name of a specific type of training that is completed qualification. It has the code and name."@en,
                             "Специальность - это наименование конкретного вида профессиональной подготовки, которая завершается присвоением квалификации. Имеет код и название."@ru.
losp:SplitValues a owl:Class;
                 rdfs:comment """Разделение значений - вспомогательный класс для создания класса \"Уровень подготовки\".""",
                              """Splitting Values ​​- helper class for creating a class \"level of training\" (LevelEducation)."""@en,
                              """Разделение значений - вспомогательный класс для создания класса \"Уровень подготовки\" (LevelEducation)."""@ru.
losp:TheList a owl:Class;
             rdfs:comment "Перечень – именованная совокупность специальностей и УГСН, содержащие эти специальности. Перечень имеет название, дату введения и каким утвержден документом.",
                          "List - named set of specialties (Speciality) and UGSN (UGSN), containing these specialty. The list has the name, the date of administration, and how the document was approved."@en,
                          "Перечень – именованная совокупность специальностей (Speciality) и УГСН (UGSN), содержащие эти специальности. Перечень имеет название, дату введения и каким утвержден документом."@ru.
losp:UGSN a owl:Class;
          rdfs:comment "УГСН – Укрупненные группы специальностей и направлений подготовки объединяют совокупности специальностей и направлений подготовки, относящихся к какой-либо широкой предметной области. Имеет код и название.",
                       "UGSN - Enlarged group of specialties and areas of training are combined together specialties and areas of training related to a broad subject area. It has the code and name."@en,
                       "УГСН – Укрупненные группы специальностей и направлений подготовки объединяют совокупности специальностей и направлений подготовки, относящихся к какой-либо широкой предметной области. Имеет код и название."@ru.
losp:UGSNConsistsOf a owl:ObjectProperty;
                    rdfs:comment "свойство, показывающее, что у определенного УГСН есть составные части (специальности). Доменом является УГСН, диапазоном – специальность, а также оно является обратным свойству «входитВУГСН».",
                                 "The property that indicates that there is a certain UGSN components (Speciality). Domain is UGSN, range - Speciality, and it is the inverse of the property «isPartOfUGSN»."@en,
                                 "Свойство, показывающее, что у определенного UGSN есть составные части (Speciality). Доменом является UGSN, диапазоном – Speciality, а также оно является обратным свойству «isPartOfUGSN»."@ru;
                    rdfs:domain losp:UGSN;
                    rdfs:range losp:Speciality;
                    rdfs:subPropertyOf losp:consistsOf;
                    owl:inverseOf losp:isPartOfUGSN.
losp:approvedDocument a owl:DatatypeProperty;
                      rdfs:comment "показывает каким именно документом перечень был утвержден",
                                   "It shows how the document list (TheList) was approved"@en,
                                   "Показывает каким документом был утвержден перечень (TheList)"@ru;
                      rdfs:domain losp:TheList;
                      rdfs:range xsd:string.
losp:consistsOf a owl:ObjectProperty,
                  owl:TransitiveProperty;
                rdfs:comment """свойство, показывающее, что у определенный объекта есть составные части. Является транзитивным и обратным свойству \"входитВ\".""",
                             """Property indicating that a certain object is an integral part. It is transitive and inverse property \"partOf\"."""@en,
                             """Свойство, показывающее, что у определенный объекта есть составные части. Является транзитивным и обратным свойству \"partOf\"."""@ru;
                owl:inverseOf losp:partOf.
losp:dateOfIntroduction a owl:FunctionalProperty,
                          owl:DatatypeProperty;
                        rdfs:comment "указывает дату, когда был введен перечень",
                                     "Date of introduction of the list (TheList)"@en,
                                     "Дата введения перечня (TheList)"@ru;
                        rdfs:domain losp:TheList;
                        rdfs:range xsd:date.
losp:equalsTo a owl:ObjectProperty,
                owl:SymmetricProperty;
              rdfs:domain losp:Speciality;
              rdfs:range losp:Speciality;
              rdfs:subPropertyOf owl:topObjectProperty.
losp:hasCode a owl:FunctionalProperty,
               owl:DatatypeProperty;
             rdfs:comment "код может быть и у специальностей, и у перечней, поэтому домен не указан",
                          "Code identifier specialties (Speciality) and lists (TheList)"@en,
                          "Кодовый идентификатор специальностей (Speciality) и перечней (TheList)"@ru;
             rdfs:range xsd:string.
losp:hasLevelEducation a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:comment "показывает уровеь образования определенной специальности",
                                    "Shows the level of education (LevelEducation) a particular specialty (Speciality)"@en,
                                    "Показывает уровень образования (LevelEducation) определенной специальности (Speciality)"@ru;
                       rdfs:domain losp:Speciality;
                       rdfs:range losp:LevelEducation.
losp:isPartOfList a owl:ObjectProperty;
                  rdfs:comment "свойство, показывающее, что определенная УГСН входит в определенный перечень",
                               "Property indicating that a certain UGSN (UGSN) included in a certain list (TheList)"@en,
                               "Свойство, показывающее, что определенная УГСН (UGSN) входит в определенный перечень (TheList)"@ru;
                  rdfs:domain losp:UGSN;
                  rdfs:range losp:TheList;
                  rdfs:subPropertyOf losp:partOf;
                  owl:inverseOf losp:listConsistsOf.
losp:isPartOfSpeciality a owl:ObjectProperty;
                        rdfs:comment "свойство, показывающее, что научная специальность входит в направление аспирантуры",
                                     "Cвойство, показывающее, что научная специальность (ScientificSpeciality) входит в направление аспирантуры"@ru,
                                     "Properties of showing that scientific specialty (ScientificSpeciality) is included in the post-graduate course"@en;
                        rdfs:domain losp:ScientificSpeciality;
                        rdfs:range losp:Speciality;
                        rdfs:subPropertyOf losp:partOf;
                        owl:inverseOf losp:specialityConsistsOf.
losp:isPartOfUGSN a owl:ObjectProperty;
                  rdfs:comment "свойство, показывающее, что определенная специальность входит в определенную УГСН. Доменом является специальность, диапазоном – УГСН, а также оно является обратным свойству «УГСНСостоитИз».",
                               "Cвойство, показывающее, что определенная специальность (Speciality) входит в определенную УГСН (UGSN). Доменом является специальность (Speciality), диапазоном – УГСН (UGSN), а также оно является обратным свойству «UGSNConsistsOf»."@ru,
                               """Перевести
Properties of showing that a particular specialty (Speciality) included in certain UGSN (UGSN). Domain is a specialty (Speciality), range - UGSN (UGSN), and it is the inverse of the property «UGSNConsistsOf»."""@en;
                  rdfs:domain losp:Speciality;
                  rdfs:range losp:UGSN;
                  rdfs:subPropertyOf losp:partOf.
<http://sparql.sstu.ru:3030/speciality/level/1> a losp:LevelEducation,
                                                  owl:NamedIndividual;
                                                rdfs:label "бакалавриат",
                                                           "Бакалавриат".
<http://sparql.sstu.ru:3030/speciality/level/2> a losp:LevelEducation,
