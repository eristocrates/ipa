@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix duv: <http://www.w3.org/ns/duv#>.

<http://www.w3.org/ns/duv> <http://purl.org/dc/terms/created> "2015-12-17"^^xsd:date;
                           <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Eric G. Stephan"],
                                                              [<http://xmlns.com/foaf/0.1/name> "Sumit Purohit"],
                                                              [<http://xmlns.com/foaf/0.1/name> "Bernadette Farias Lóscio"];
                           <http://purl.org/dc/terms/description> "The Dataset Usage Vocabulary (DUV) is used to describe consumer experiences, citations, and feedback about datasets from the human perspective."@en;
                           <http://purl.org/dc/terms/modified> "2016-08-30"^^xsd:date;
                           <http://purl.org/dc/terms/publisher> <http://www.w3.org/data#W3C>;
                           <http://purl.org/dc/terms/title> "Dataset Usage Vocabulary";
                           <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "duv";
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.w3.org/ns/duv";
                           a <http://purl.org/vocommons/voaf#Vocabulary>;
                           rdfs:isDefinedBy <http://www.w3.org/TR/vocab-duv/>.
duv:RatingFeedback a <http://www.w3.org/2002/07/owl#Class>,
                     rdfs:Class;
                   rdfs:comment "Predefined criteria used to express a user opinion about a dataset or distribution using a discrete range of values."@en;
                   rdfs:label "Rating Feedback"@en;
                   rdfs:subclassOf duv:UserFeedback.
duv:Usage a <http://www.w3.org/2002/07/owl#Class>,
            rdfs:Class;
          rdfs:comment "A helpful description of actions that can be performed on a given dataset or distribution."@en;
          rdfs:label "Usage"@en.
duv:UsageTool a <http://www.w3.org/2002/07/owl#Class>,
                rdfs:Class;
              rdfs:comment "A synopsis describing the way a tool can use a dataset or distribution."@en;
              rdfs:label "UsageTool"@en.
duv:UserFeedback a <http://www.w3.org/2002/07/owl#Class>,
                   rdfs:Class;
                 rdfs:comment "User feedback on the dataset. Expresses whether the dataset was useful or not, for example."@en;
                 rdfs:label "User Feedback"@en.
duv:hasDistributor <http://purl.org/vocab/vann/usageNote> "dcat:Dataset (subject) duv:hasDistributor (predicate) foaf:Agent (object)"@en,
                                                          "dcat:Distribution (subject) duv:hasDistributor (predicate) foaf:Agent (object)"@en;
                   a rdf:Property;
                   rdfs:comment "The distributor is the organization that makes the dataset available for downloading and use."@en;
                   rdfs:label "has distributor"@en.
duv:hasFeedback <http://purl.org/vocab/vann/usageNote> "dcat:Dataset (subject) duv:hasFeedback (predicate) duv:UserFeedback (object)"@en,
                                                       "dcat:Distribution (subject) duv:hasFeedback (predicate) duv:UserFeedback (object)"@en;
                a rdf:Property;
                rdfs:comment "User feedback associated with Dataset or distribution"@en;
                rdfs:label "has dataset feedback"@en.
duv:hasRating a rdf:Property;
              rdfs:comment "Rating Feedback has rating opinion"@en;
              rdfs:label "has rating"@en.
duv:hasUsage a rdf:Property;
             rdfs:comment "Dataset/distribution usage guidance or instructions."@en;
             rdfs:label "has dataset/distribution usage"@en.
duv:hasUsageTool a rdf:Property;
                 rdfs:comment "Describes the tool that provides the Usage "@en;
                 rdfs:label "has usage tool"@en.
duv:refersTo a rdf:Property;
             rdfs:comment "Dataset associated with Usage. "@en;
             rdfs:label "refers to dataset"@en.
