@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gen: <http://purl.org/gen/0.1#>.

<http://any23.org/tmp/> <http://vocab.sindice.net/date> "2012-01-26T19:01:48+00:00";
                        <http://vocab.sindice.net/size> "272"^^xsd:int.
<http://purl.org/NET/c4dm/event.owl#Event> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment """
		An arbitrary classification of a space/time region, by a 
		cognitive agent. An event may have actively participating agents,
		passive factors, products, and a location in space/time.
		""";
                                           rdfs:isDefinedBy <http://purl.org/NET/c4dm/event.owl>;
                                           rdfs:label "Event".
gen: <http://purl.org/dc/terms/abstract> "A simple RDF vocabulary containing terms to facilitate the linking of genealogical data."@en;
     <http://purl.org/dc/terms/creator> "Josh Hansen"@en;
     <http://purl.org/dc/terms/date> "2012-01-26"^^xsd:date;
     <http://purl.org/dc/terms/issued> "2012-01-26"^^xsd:date;
     <http://purl.org/dc/terms/rights> "Copyright Â© 2012 FamilySearch"@en;
     <http://purl.org/dc/terms/title> "Gen---A Vocabulary for Linked Genealogical Data"@en;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "gen"@en;
     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/gen/0.1#"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>.
gen:Assertion a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf rdf:Statement.
gen:Family a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment """Though it is preferred to represent families by describing the relationships between its members
		(parent-child, husband-wife, etc.) this class can be used to represent a group of people who are
		considered to be a family unit."""@en;
           rdfs:label "Family"@en;
           rdfs:subClassOf <http://xmlns.com/foaf/0.1/Group>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:FamilyTree a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """This container class should be populated with individual people, families, or other records
		that constitute a single 'family tree'. It is intended to help users in management of their
		genealogical data."""@en;
               rdfs:label "Family Tree"@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:FoafName a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """A name class aiming for maximum compatibility with FOAF. Individuals in this class are intended
		to be described using foaf's name properties, namely foaf:name, foaf:givenName, and
		foaf:familyName."""@en;
             rdfs:label "FOAF Name"@en;
             rdfs:subClassOf gen:Name;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:GraveInscription a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A grave inscription, such as on a tomb or headstone."@en;
                     rdfs:label "Grave Inscription"@en;
                     rdfs:subClassOf gen:MonumentalInscription;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Microfiche a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "'A microfiche is a flat film 105 x 148 mm in size, that is ISO A6.' (Wikipedia:Microform)"@en;
               rdfs:label "Microfiche"@en;
               rdfs:subClassOf gen:Microform;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Microfilm a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A microfilm reel"@en;
              rdfs:label "Microfilm"@en;
              rdfs:subClassOf gen:Microform;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Microform a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """The general class of microform media, defined by Wikipedia as 'any forms, either films or paper,
		containing microreproductions of documents for transmission, storage, reading, and printing.'"""@en;
              rdfs:label "Microform"@en;
              rdfs:subClassOf <http://purl.org/ontology/bibo/Document>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:MonumentalInscription a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment """The general class of monumental inscriptions, defined by Wikipedia as 'an inscription, typically
		carved in stone, on a grave marker, cenotaph, memorial plaque, church monument or other memorial.'"""@en;
                          rdfs:label "Monumental Inscription"@en;
                          rdfs:subClassOf <http://purl.org/ontology/bibo/Document>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Name a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment """A personal name. Names are a class of their own to facilitate associating multiple names with
		the same individual, and to allow different types of names or ways of representing them."""@en;
         rdfs:label "Name"@en;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Place a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A geolocated position"@en;
          rdfs:label "Place"@en;
          rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:Time a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A moment in time or a span of time"@en;
         rdfs:label "Time"@en;
         rdfs:subClassOf <http://www.w3.org/2006/time#TemporalEntity>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:birth a rdf:Property;
          rdfs:comment "Specifies a person's birth event."@en;
          rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
          rdfs:label "birth"@en;
          rdfs:range <http://purl.org/vocab/bio/0.1/Birth>;
          rdfs:subPropertyOf gen:lifeEvent,
                             <http://purl.org/vocab/bio/0.1/event>;
          <http://www.w3.org/2002/07/owl#inverseOf> gen:newborn.
gen:birthFather a rdf:Property;
                rdfs:domain <http://purl.org/vocab/bio/0.1/Birth>;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                rdfs:subPropertyOf gen:birthParent.
gen:birthMother a rdf:Property;
                rdfs:domain <http://purl.org/vocab/bio/0.1/Birth>;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                rdfs:subPropertyOf gen:birthParent.
gen:birthParent a rdf:Property;
                rdfs:domain <http://purl.org/vocab/bio/0.1/Birth>;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                rdfs:subPropertyOf gen:participant,
                                   <http://purl.org/vocab/bio/0.1/parent>.
gen:child a rdf:Property;
          rdfs:comment "A child in a family."@en;
          rdfs:domain gen:Family;
          rdfs:label "child"@en;
          rdfs:range <http://xmlns.com/foaf/0.1/Person>;
          rdfs:subPropertyOf gen:familyMember.
gen:death a rdf:Property;
          rdfs:comment "Specifies a person's death event."@en;
          rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
          rdfs:label "death"@en;
          rdfs:range <http://purl.org/vocab/bio/0.1/Death>;
          rdfs:subPropertyOf gen:lifeEvent,
                             <http://purl.org/vocab/bio/0.1/death>.
gen:deceased a rdf:Property;
             rdfs:domain <http://purl.org/vocab/bio/0.1/Death>;
             rdfs:range <http://xmlns.com/foaf/0.1/Person>;
             rdfs:subPropertyOf gen:participant,
                                <http://purl.org/vocab/bio/0.1/principal>;
             <http://www.w3.org/2002/07/owl#inverseOf> gen:death.
gen:familyMember a rdf:Property;
                 rdfs:comment "Indicates a member of a Family";
                 rdfs:domain gen:Family;
                 rdfs:label "familyMember";
                 rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                 rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/member>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:father a rdf:Property;
           rdfs:comment "A father of a family."@en;
           rdfs:domain gen:Family;
           rdfs:label "father"@en;
           rdfs:range <http://xmlns.com/foaf/0.1/Person>;
           rdfs:subPropertyOf gen:parent.
gen:lifeEvent a rdf:Property;
              rdfs:comment "The lifeEvent property is a slight variation on bio:event in which the domain is foaf:Person rather than foaf:Agent, since genealogy is about people."@en;
              rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
              rdfs:label "lifeEvent"@en;
              rdfs:range <http://purl.org/vocab/bio/0.1/Event>;
              rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/event>;
              <http://www.w3.org/2002/07/owl#inverseOf> gen:participant.
gen:mother a rdf:Property;
           rdfs:comment "A mother of a family."@en;
           rdfs:domain gen:Family;
           rdfs:label "mother"@en;
           rdfs:range <http://xmlns.com/foaf/0.1/Person>;
           rdfs:subPropertyOf gen:parent.
gen:name a rdf:Property;
         rdfs:comment "A person's name."@en;
         rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
         rdfs:label "name"@en;
         rdfs:range gen:Name;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
gen:newborn a rdf:Property;
            rdfs:domain <http://purl.org/vocab/bio/0.1/Birth>;
            rdfs:range <http://xmlns.com/foaf/0.1/Person>;
            rdfs:subPropertyOf gen:participant,
                               <http://purl.org/vocab/bio/0.1/principal>;
            <http://www.w3.org/2002/07/owl#inverseOf> gen:birth.
gen:parent a rdf:Property;
           rdfs:comment "A parent in a family."@en;
           rdfs:domain gen:Family;
           rdfs:label "parent"@en;
           rdfs:range <http://xmlns.com/foaf/0.1/Person>;
           rdfs:subPropertyOf gen:familyMember.
gen:participant a rdf:Property;
                rdfs:comment "Adapts bio:agent by having a range of foaf:Person rather than foaf:Agent."@en;
                rdfs:domain <http://purl.org/vocab/bio/0.1/Event>;
                rdfs:label "participant"@en;
                rdfs:range <http://xmlns.com/foaf/0.1/Person>;
                rdfs:subPropertyOf <http://purl.org/vocab/bio/0.1/agent>;
                <http://www.w3.org/2002/07/owl#inverseOf> gen:lifeEvent.
gen:source a rdf:Property;
           rdfs:comment """A source justifying some assertion or claim of fact. The range is deliberately left as general as possible
		(owl:Thing) because of the unsettled state of bibliographic vocabularies. My recommendation is to use
		bibo:Document and its associated vocabulary, though frbr:Work seems reasonable, too. Surely there are
		many other options---hopefully a clear standard emerges in the future."""@en;
           rdfs:domain gen:Assertion;
           rdfs:label "Source"@en;
           rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
gen:spouse a rdf:Property;
           rdfs:domain <http://purl.org/vocab/bio/0.1/Marriage>;
           rdfs:range <http://xmlns.com/foaf/0.1/Person>;
           rdfs:subPropertyOf gen:participant,
                              <http://purl.org/vocab/bio/0.1/partner>.
gen:stepFather a rdf:Property;
               rdfs:comment "A step-father of a family."@en;
               rdfs:domain gen:Family;
               rdfs:label "stepFather"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>;
               rdfs:subPropertyOf gen:stepParent.
gen:stepMother a rdf:Property;
               rdfs:comment "A step-mother of a family."@en;
               rdfs:domain gen:Family;
               rdfs:label "stepMother"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>;
               rdfs:subPropertyOf gen:stepParent.
gen:stepParent a rdf:Property;
               rdfs:comment "A step-parent of a family."@en;
               rdfs:domain gen:Family;
               rdfs:label "stepParent"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Person>;
               rdfs:subPropertyOf gen:parent.
gen:subAssertion a rdf:Property;
                 rdfs:domain gen:Assertion;
                 rdfs:range gen:Assertion.
<http://purl.org/vocab/bio/0.1/Baptism> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "The ceremonial event held to admit a person to membership of a Christian church."@en;
                                        rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                        rdfs:label "Baptism"@en;
                                        rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Birth> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "The event of a person entering into life."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Birth"@en;
                                      rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Burial> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "The event of interring the remains of a person's body into the ground."@en;
                                       rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                       rdfs:label "Burial"@en;
                                       rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Death> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "The event of a person's life ending."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Death"@en;
                                      rdfs:subClassOf <http://purl.org/vocab/bio/0.1/IndividualEvent>.
<http://purl.org/vocab/bio/0.1/Divorce> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "The event of legally dissolving a marriage."@en;
                                        rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                        rdfs:label "Divorce"@en;
                                        rdfs:subClassOf <http://purl.org/vocab/bio/0.1/GroupEvent>.
<http://purl.org/vocab/bio/0.1/Event> a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "An event is an occurrence that brings about a change in the state of affairs for one or more people and/or other agents. Events are assumed to occur over a period of time and may not have precise start and end points."@en;
                                      rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                      rdfs:label "Event"@en.
<http://purl.org/vocab/bio/0.1/GroupEvent> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A type of event that is principally about one or more agents and their partnership. Other agents may be involved but the event is most significant for the partner agent."@en;
                                           rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                           rdfs:label "Group Event"@en;
                                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/vocab/bio/0.1/partner> ; 
                                                            <http://www.w3.org/2002/07/owl#minCardinality> "2"^^xsd:nonNegativeInteger ; 
                                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                                           <http://purl.org/vocab/bio/0.1/Event>.
<http://purl.org/vocab/bio/0.1/IndividualEvent> a <http://www.w3.org/2002/07/owl#Class>;
                                                rdfs:comment "A type of event that is principally about a single person, group or organization. Other agents may be involved but the event is most significant for the principal agent."@en;
                                                rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                                rdfs:label "Individual Event"@en;
                                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/vocab/bio/0.1/principal> ; 
                                                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                <http://purl.org/vocab/bio/0.1/Event>.
<http://purl.org/vocab/bio/0.1/Marriage> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "The event of creating uniting the participants into a new family unit, sometimes accompanied by a formal wedding ceremony. This is intended to cover a broad range of marriages including those given formal legal standing, common-law, or by convention. It is not restricted to marriages of two people of the opposite gender, but also includes polygamous and same-sex unions."@en;
                                         rdfs:isDefinedBy <http://purl.org/vocab/bio/0.1/>;
                                         rdfs:label "Marriage"@en;
                                         rdfs:subClassOf <http://purl.org/vocab/bio/0.1/GroupEvent>.
<http://xmlns.com/foaf/0.1/Person> a rdfs:Class,
                                     <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "A person.";
                                   rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                   rdfs:label "Person";
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<http://xmlns.com/foaf/0.1/familyName> a rdf:Property,
                                         <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:comment "The family name of some person.";
                                       rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                                       rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                       rdfs:label "familyName";
                                       rdfs:range rdfs:Literal.
<http://xmlns.com/foaf/0.1/givenName> a rdf:Property,
                                        <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:comment "The given name of some person.";
                                      rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                      rdfs:label "Given name".
<http://xmlns.com/foaf/0.1/name> a rdf:Property,
                                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "A name for some thing.";
                                 rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                 rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/>;
                                 rdfs:label "name";
                                 rdfs:range rdfs:Literal;
                                 rdfs:subPropertyOf rdfs:label.
