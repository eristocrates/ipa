                              rdfs:isDefinedBy gndo:;
                              rdfs:label "Adelstitel (Literal)"@de,
                                         "Title of nobility (Literal)"@en;
                              rdfs:seeAlso gndo:titleOfNobility;
                              rdfs:subPropertyOf foaf:title,
