                                                    gndo:PlaceOrGeographicName
                                                    gndo:SubjectHeading
                                                    gndo:Work) ; 
                                       a owl:Class];
                           rdfs:subPropertyOf gndo:narrowerTermGeneral;
                           owl:inverseOf gndo:broaderTermPartitive.
