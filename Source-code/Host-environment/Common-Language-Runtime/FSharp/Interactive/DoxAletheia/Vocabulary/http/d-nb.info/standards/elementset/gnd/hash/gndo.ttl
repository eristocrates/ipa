gndo:superPropertyOf a owl:TransitiveProperty,
                       rdf:Property;
                     rdfs:comment """P1 gnd:superPropertyOf P2 sagt aus, dass P2 eine Subproperty von P1
      ist. Die gndo:superPropertyOf-Property ist transitiv."""@de,
                                  """P1 gnd:superPropertyOf P2 states that P2 is a subproperty of P1. The
      gndo:superPropertyOf property is transitive."""@en;
                     rdfs:isDefinedBy gndo:;
                     rdfs:label "Super-Property von"@de,
                                "Super-property of"@en;
                     owl:inverseOf rdfs:subPropertyOf.
gndo:surname gndo:marc21equivalent "100 $a",
