@base <http://www.w3.org/2000/10/swap/pim/email>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://www.w3.org/2000/10/swap/pim/email#>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix email: <http://www.w3.org/2000/10/swap/pim/email#>.
@prefix log: <http://www.w3.org/2000/10/swap/log#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix r: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix ss: <http://www.w3.org/2000/10/swap/util/sniffSchema#>.
@prefix str: <http://www.w3.org/2000/10/swap/string#>.
@prefix swapemail: <http://www.w3.org/2000/10/swap/pim/email#>.

<http://www.w3.org/2000/10/swap/pim/email> rdfs:seeAlso <http://www.w3.org/2000/10/swap/util/sniffSchema.n3>,
                                                        <http://www.faqs.org/rfcs/rfc822.html>;
                                           owl:versionInfo "$Id: email.rdf,v 1.7 2005/01/03 19:25:13 connolly Exp $".
:Agent a owl:Class;
       rdfs:comment """\"AGENT (person,  system  or  process)\" -- RFC822 4.4.2""";
       rdfs:label "Agent".
:Mailbox a owl:Class;
         rdfs:label "Mailbox".
:Message a owl:Class;
         rdfs:label "Message".
:cc a rdf:Property;
    rdfs:domain :Message;
    rdfs:label "cc";
    rdfs:range :Agent.
:date a owl:FunctionalProperty;
      rdfs:comment "unmodified date header field value";
      rdfs:domain :Message;
      rdfs:label "date";
      ss:rangeIntersects rdfs:Literal.
:date_iso a owl:FunctionalProperty;
          rdfs:comment "date header field converted to YYYY-MM-DDTHH:MM:SSZ form";
          rdfs:label "date_iso";
          ss:rangeIntersects rdfs:Literal.
:from a rdf:Property;
      rdfs:domain :Message;
      rdfs:label "from";
      rdfs:range :Agent.
:mbox a owl:InverseFunctionalProperty;
      rdfs:domain :Agent;
      rdfs:label "mbox";
      rdfs:range :Mailbox.
:phrase a rdf:Property;
        rdfs:comment "note handling of non-ascii chars";
        rdfs:domain :Agent;
        rdfs:label "phrase";
        rdfs:range rdfs:Literal.
:received_iso a rdf:Property;
              rdfs:domain :Message;
              rdfs:label "received_iso";
              ss:rangeIntersects rdfs:Literal.
:recipients a rdf:Property;
            rdfs:comment "@@not in RFC822. artificial. explain/motivate?";
            rdfs:domain :Message;
            rdfs:label "recipients";
            ss:rangeIntersects rdfs:Literal.
:references a rdf:Property;
            rdfs:domain :Message;
            rdfs:label "references";
            rdfs:range :Message.
:senders a rdf:Property;
         rdfs:comment "@@not in RFC822. artificial. explain/motivate?";
         rdfs:domain :Message;
         rdfs:label "senders";
         ss:rangeIntersects rdfs:Literal.
:subject a owl:FunctionalProperty;
         rdfs:comment "domain message. note handling of non-ascii chars";
         rdfs:domain :Message;
         rdfs:label "subject";
         rdfs:range rdfs:Literal.
:to a rdf:Property;
    rdfs:domain :Message;
    rdfs:range :Agent;
    ss:label "to".
<mid:000001c2f845$eb8be140$9c0b77ca@xobjects> :date "Tue, 1 Apr 2003 17:50:00 +0800";
                                              :date_iso "2003-04-02T07:50:00Z";
                                              :from [:mbox <mailto:yzqu@seu.edu.cn> ; 
                                                     :phrase "Yuzhong Qu"];
                                              :received_iso "2003-04-01T17:56:46Z";
                                              :recipients """public-webont-comments@w3.org
""";
                                              :senders """yzqu@seu.edu.cn
""";
                                              :subject "typo error in (normative) appendix B of OWL Reference";
                                              :to [:mbox <mailto:public-webont-comments@w3.org>].
