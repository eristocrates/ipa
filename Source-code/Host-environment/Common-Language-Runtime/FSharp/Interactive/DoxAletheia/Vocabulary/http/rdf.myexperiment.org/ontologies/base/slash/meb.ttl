@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix meb: <http://rdf.myexperiment.org/ontologies/base/>.

<http://dbpedia.org/ontology/residence> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/format> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/language> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/Agent> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                   rdfs:range xsd:dateTime.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:range xsd:string.
<http://purl.org/dc/terms/hasVersion> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                      <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/dc/terms/isVersionOf>.
<http://purl.org/dc/terms/identifier> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                      rdfs:range xsd:string.
<http://purl.org/dc/terms/isVersionOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.org/dc/terms/hasVersion>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                    rdfs:range xsd:dateTime.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:range xsd:string.
<http://purl.org/dc/terms/type> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:range xsd:string.
meb: <http://purl.org/dc/elements/1.1/contributor> "David R Newman";
     <http://purl.org/dc/elements/1.1/creator> <http://id.ecs.soton.ac.uk/person/9421>;
     <http://purl.org/dc/elements/1.1/date> "2009-01-28"^^xsd:date;
     <http://purl.org/dc/elements/1.1/format> "rdf/xml";
     <http://purl.org/dc/elements/1.1/language> "en";
     <http://purl.org/dc/elements/1.1/publisher> <http://rdf.myexperiment.org/>;
     <http://purl.org/dc/elements/1.1/title> "The myExperiment Base Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "This provides the base elements required by myExperiment for content management, social networking and object annotation.";
     rdfs:label "myExperiment Base v1.0";
     <http://www.w3.org/2002/07/owl#imports> <http://rdf.myexperiment.org/ontologies/snarm/>;
     <http://www.w3.org/2002/07/owl#versionInfo> "$Date: 2013/03/26 $".
meb:Actor a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "An object that can perform an action";
          rdfs:isDefinedBy meb:;
          rdfs:label "Actor";
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/modified> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#name> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/created> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/name> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          <http://purl.org/dc/terms/Agent>;
          <http://www.w3.org/2002/07/owl#disjointWith> meb:Submission.
meb:Annotatable a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An object that can be annotated with Annotations";
                rdfs:isDefinedBy meb:;
                rdfs:label "Annotatable";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> meb:has-annotation ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                meb:Interface.
meb:Annotation a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An Annotation of a Annotatable object";
               rdfs:isDefinedBy meb:;
               rdfs:label "Annotation";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> meb:annotates ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               meb:Submission,
                               [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> meb:has-annotator ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#disjointWith> meb:Message,
                                                            meb:Announcement,
                                                            meb:Contribution,
                                                            meb:Request.
meb:Announcement a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A public Announcement";
                 rdfs:isDefinedBy meb:;
                 rdfs:label "Announcement";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> meb:text ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> meb:has-announcer ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/modified> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 meb:Submission;
                 <http://www.w3.org/2002/07/owl#disjointWith> meb:Annotation,
                                                              meb:Request,
                                                              meb:Contribution,
                                                              meb:Message.
meb:ContentType a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The type of content for an Upload";
                rdfs:isDefinedBy meb:;
                rdfs:label "ContentType";
                rdfs:subClassOf meb:Contribution.
meb:Contribution a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An object that is contributed by a User";
                 rdfs:isDefinedBy meb:;
                 rdfs:label "Contribution";
                 rdfs:subClassOf meb:Submission,
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#has_owner> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> meb:has-policy ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/modified> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#disjointWith> meb:Annotation,
                                                              meb:Message,
                                                              meb:Announcement,
                                                              meb:Request.
meb:Friendship a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A Friendship between two Users";
               rdfs:isDefinedBy meb:;
               rdfs:label "Friendship";
               rdfs:subClassOf meb:Request;
               <http://www.w3.org/2002/07/owl#disjointWith> meb:Invitation,
                                                            meb:Membership.
meb:FriendshipInvitation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A FriendshipInvitation to an external email address";
                         rdfs:isDefinedBy meb:;
                         rdfs:label "FriendshipInvitation";
                         rdfs:subClassOf meb:Invitation;
                         <http://www.w3.org/2002/07/owl#disjointWith> meb:MembershipInvitation.
meb:Group a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A Group of Users";
          rdfs:isDefinedBy meb:;
          rdfs:label "Group";
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          meb:Actor,
                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#has_owner> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                           <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#has_member> ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#disjointWith> meb:User;
          <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdfs.org/sioc/ns#UserGroup>.
meb:GroupAnnouncement a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An Announcement to a Group";
                      rdfs:isDefinedBy meb:;
                      rdfs:label "GroupAnnouncement";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> meb:announced-to ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> meb:public-announcement ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      meb:Announcement.
meb:Interface a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Superclass for all Interface classes";
              rdfs:isDefinedBy meb:;
              rdfs:label "Interface".
meb:Invitation a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A Request could be an external Invitation";
               rdfs:isDefinedBy meb:;
               rdfs:label "Invitation";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/mbox_sha1sum> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#has_owner> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               meb:Request;
               <http://www.w3.org/2002/07/owl#disjointWith> meb:Membership,
                                                            meb:Friendship.
meb:License a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A License under which an Upload is licensed under";
            rdfs:isDefinedBy meb:;
            rdfs:label "License";
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://web.resource.org/cc/prohibits> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://web.resource.org/cc/permits> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/identifier> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <http://web.resource.org/cc/License>,
                            [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://web.resource.org/cc/requires> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            meb:Contribution.
meb:Membership a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A Membership of a User to a Group";
               rdfs:isDefinedBy meb:;
               rdfs:label "Membership";
               rdfs:subClassOf meb:Request;
               <http://www.w3.org/2002/07/owl#disjointWith> meb:Invitation,
                                                            meb:Friendship.
meb:MembershipInvitation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A MembershipInvitation to an external email address";
                         rdfs:isDefinedBy meb:;
                         rdfs:label "MembershipInvitation";
                         rdfs:subClassOf meb:Invitation;
                         <http://www.w3.org/2002/07/owl#disjointWith> meb:FriendshipInvitation.
meb:Message a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A Message sent between two Users";
            rdfs:isDefinedBy meb:;
            rdfs:label "Message";
            rdfs:subClassOf meb:Submission,
                            [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> meb:text ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#disjointWith> meb:Annotation,
                                                         meb:Contribution,
                                                         meb:Request,
                                                         meb:Announcement.
meb:Request a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A Request can be made by an Actor to another Actor";
            rdfs:isDefinedBy meb:;
            rdfs:label "Request";
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> meb:accepted-at ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            meb:Submission,
                            [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> meb:has-accepter ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#has_owner> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> meb:has-requester ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#disjointWith> meb:Annotation,
                                                         meb:Announcement,
                                                         meb:Message,
                                                         meb:Contribution.
meb:Submission a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An object that has been submitted.  This might be a Contribution, Annotation, Request or an Attibution/Creditation of an Upload";
               rdfs:isDefinedBy meb:;
               rdfs:label "Submission";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/created> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               <http://www.w3.org/2002/07/owl#disjointWith> meb:Actor;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdfs.org/sioc/ns#Item>.
meb:Upload a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An object that can be contributed by a User that requires uploading";
           rdfs:isDefinedBy meb:;
           rdfs:label "Upload";
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/title> ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> <http://web.resource.org/cc/license> ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> meb:has-content-type ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> meb:content-url ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           meb:Contribution.
meb:User a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A User";
         rdfs:isDefinedBy meb:;
         rdfs:label "User";
         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> meb:username ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/mbox> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/homepage> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/mbox_sha1sum> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://dbpedia.org/ontology/residence> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/based_near> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#avatar> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         meb:Actor,
                         [<http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://rdfs.org/sioc/ns#member_of> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>];
         <http://www.w3.org/2002/07/owl#disjointWith> meb:Group;
         <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdfs.org/sioc/ns#UserAccount>.
meb:Version a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A Contribution may be a Version of another Contribution";
            rdfs:isDefinedBy meb:;
            rdfs:label "Version";
