                                                           rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                           rdfs:label "Geschäftsobjekt-Attribut (BOA)"@de,
                                                                      "Business Object Attribute (BOA)"@en.
<http://www.data-knowledge.org/dk/BusinessObjectDomain> dcterms:hasPart <http://www.data-knowledge.org/dk/BusinessObjectType>;
                                                        vann:example "Business partner: customer and vendor data"@en,
                                                                     "Geschäftspartner: Kunden- und Verkäuferdaten"@de;
                                                        a owl:NamedIndividual,
                                                          <http://www.data-knowledge.org/dk/DataConceptualization>,
                                                          owl:Class;
                                                        rdfs:comment "Clusters of coherent Business Object Types (BOTs), either from a subject matter or management point of view"@en,
                                                                     "Gruppierung kohärenter Geschäftsobjekttypen (BOTs), entweder aus Themen- oder Verwaltungssicht"@de;
                                                        rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                        rdfs:label "Geschäftsobjektdomäne (BOD)"@de,
                                                                   "Business Object Domain (BOD)"@en.
<http://www.data-knowledge.org/dk/BusinessObjectType> dcterms:hasPart <http://www.data-knowledge.org/dk/BusinessObjectTypeAttribute>;
                                                      dcterms:isPartOf <http://www.data-knowledge.org/dk/BusinessObjectDomain>;
                                                      vann:example "Customer, Employee, Bill of Material, Sales Region"@en,
                                                                   "Kunde, Angestellter, Materialliste, Vertriebsregion"@de;
                                                      a owl:NamedIndividual,
                                                        owl:Class,
                                                        <http://www.data-knowledge.org/dk/DataConceptualization>;
                                                      rdfs:comment "Konzeptuelle, unternehmensrelevante (Daten-) Einheit, welche eine kohärente Menge von Informationen über eine Gruppe realer oder virtueller Objekte darstellt"@de,
                                                                   "Conceptual (data) entity relevant to business that represents a coherent set of information about a group of real or virtual objects"@en;
                                                      rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                      rdfs:label "Geschäftsobjekttyp (BOT)"@de,
                                                                 "Business Object Type (BOT)"@en.
<http://www.data-knowledge.org/dk/BusinessObjectTypeAttribute> dcterms:isPartOf <http://www.data-knowledge.org/dk/BusinessObjectType>;
                                                               vann:example "Tax ID, Address"@en,
                                                                            "Steuer-ID, Adresse"@de;
                                                               a owl:Class,
                                                                 owl:NamedIndividual,
                                                                 <http://www.data-knowledge.org/dk/DataConceptualization>;
                                                               rdfs:comment "Konzeptuell elementare Informationseinheit als Teil eines Geschäftsobjekttyps (BOT)"@de,
                                                                            "Conceptually elementary piece of information as part of a Business Object Type (BOT)"@en;
                                                               rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                               rdfs:label "Business Object Type Attribute (BOTA)"@en,
                                                                          "Geschäftsobjekttyp-Attribut (BOTA)"@de.
<http://www.data-knowledge.org/dk/BusinessProcess> vann:example "Ordering, delivering, invoicing"@en,
                                                                "Bestellung, Auslieferung, Rechnungsstellung"@de;
                                                   a owl:Class;
                                                   rdfs:comment "Sequence of activities consuming or relying on data (data usage perspective)"@en,
                                                                "Abfolge von Tätigkeiten, die Daten konsumieren oder von ihnen abhängen (Datennutzungsperspektive)"@de;
                                                   rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                   rdfs:label "Geschäftsprozess"@de,
                                                              "Business Process"@en.
<http://www.data-knowledge.org/dk/BusinessRule> vann:example "Tax ID must be provided"@en,
                                                             "Steuer-ID muss vorhanden sein"@de;
                                                a owl:Class;
                                                rdfs:comment "Legt die Integrität eines einzelnen Geschäftsobjekts oder zwischen Geschäftsobjekten fest"@de,
                                                             "Defines the integrity of a single Business Object or across them"@en;
                                                rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                rdfs:label "Geschäftsregel"@de,
                                                           "Business Rule"@en;
                                                owl:equivalentClass dqv:QualityPolicy.
<http://www.data-knowledge.org/dk/BusinessRuleAssessment> vann:example "foo-at-bar.com ist keine gültige E-Mail-Adresse."@de,
                                                                       "foo-at-bar.com is not a valid email address."@en,
                                                                       "The sum of open purchases from customer X does not exceed his credit line."@en,
                                                                       "Die Summe der ausstehenden Bestellungen für Kunde X übersteigt seine Kreditlinie nicht."@de;
                                                          a owl:Class;
                                                          rdfs:comment "Repräsentiert die Auswertung einer bestimmten Geschäftsregel auf der Grundlage eines konkreten Datengutes"@de,
                                                                       "Represents the evaluation of a certain Business Rule on a specific Data Asset"@en;
                                                          rdfs:label "Geschäftsregelauswertung"@de,
                                                                     "Business Rule Assessment"@en.
<http://www.data-knowledge.org/dk/ChangeHistory> vann:example "Field 'age' added to customer"@en,
                                                              "Feld 'Alter' zu Kunde hinzugefügt"@de;
                                                 a owl:Class;
                                                 rdfs:comment "Informationen, welche es erlauben, die Entwicklung von Datendefinitionen, Prozessen, etc. nachzuverfolgen"@de,
                                                              "Information that allows to track the development of data definitions, processes, etc."@en;
                                                 rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                 rdfs:label "Änderungshistorie"@de,
                                                            "Change History"@en.
<http://www.data-knowledge.org/dk/ChangeRequest> vann:example "Feld 'Alter' zu Geschäftsobjekttyp 'Kunde' hinzufügen"@de,
                                                              "Add field 'age' to Business Object Type 'customer'"@en;
                                                 a owl:Class;
                                                 rdfs:comment "Detaillierte Beschreibung eines spezifischen Änderungsbedarfs, welcher sich aus Projekten oder dem operativen Ablauf ergibt"@de,
                                                              "Detailed description of a specific change requirement, resulting from projects or operations"@en;
                                                 rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                 rdfs:label "Änderungsanfrage"@de,
                                                            "Change Request"@en.
<http://www.data-knowledge.org/dk/Code> dcterms:isPartOf <http://www.data-knowledge.org/dk/CodeList>;
                                        vann:example "DE"@en,
                                                     "DE"@de;
                                        a owl:Class;
                                        rdfs:comment "Vordefinierter Wert eines Geschäftsobjektattributs (BOTA)"@de,
                                                     "Pre-defined value for a Business Object Type Attribute (BOTA)"@en;
                                        rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                        rdfs:label "Code"@en,
                                                   "Code"@de.
<http://www.data-knowledge.org/dk/CodeList> dcterms:hasPart <http://www.data-knowledge.org/dk/Code>;
                                            vann:example "Incoterms, country codes"@en,
                                                         "Incoterms, Ländercodes"@de;
                                            a owl:Class;
                                            rdfs:comment "Liste mit vordefinierten Werten (Code) für ein Geschäftsobjekt-Attribut (BOTA)"@de,
                                                         "List with pre-defined values (Codes) for a Business Object Type Attribute (BOTA)"@en;
                                            rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                            rdfs:label "Code-Liste"@de,
                                                       "Code List"@en.
<http://www.data-knowledge.org/dk/CodeMapping> dcterms:isPartOf <http://www.data-knowledge.org/dk/Mapping>;
                                               vann:example "Der Ländercode 'DEU' der Codeliste 'ISO 3166 Country Codes' wird zugeordnet zu Named Value 'ger' der Enumeration 'Länder des CRM Systems' und zu Named Value 'duitsland' der Enumeration 'Länder des niederländischen Abrechungssystems'"@de,
                                                            "Country Code 'DEU' from Code List 'ISO 3166 Country Codes' is mapped to Named Value 'ger' of Enumeration 'CRM system countries' and Named Value 'duitsland' of Enumeration 'Dutch Accounting System countries'"@en;
                                               a owl:Class;
                                               rdfs:comment "Konzeptuelle Zuordnung geschäftsbezogener Codes und Terminologie von Code-Listen zu benannten Werten von technischen Aufzählungen."@de,
                                                            "Conceptual mapping of business-related codes and terminology of Code Lists to named values of technical Enumerations."@en;
                                               rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                               rdfs:label "Code-Zuordnung"@de,
                                                          "Code Mapping"@en.
<http://www.data-knowledge.org/dk/DataAsset> dcterms:hasPart <http://www.data-knowledge.org/dk/DataObject>;
                                             vann:example "The production schedules of German sites along with the bill of materials of the produced goods."@en,
                                                          "Die gesamten Kundenstammdaten eines bestimmten CRM-Systems oder Teile davon."@de,
                                                          "The entirety of customer master data from a particular CRM system or parts thereof."@en,
                                                          "Die Produktionspläne der Werke in Deutschland mit den Stücklisten der produzierten Güter."@de;
                                             a aerdcat:DataSet,
                                               owl:NamedIndividual,
                                               owl:Class,
                                               odrl:Asset;
                                             rdfs:comment "Ein Datengut stellt eine Menge von Datenobjekten dar, die ein betriebliches oder geschäftliches Ziel unterstützen. Die enthaltenen Datenobjekte können vom dem selben oder unterschiedlichen Datenobjekttypen stammen."@de,
                                                          "A Data Asset represents a collection of Data Objects serving an organizational or a business goal. The contained Data Objects may be of the same or of different Data Object Types."@en;
                                             rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                             rdfs:label "Datengut"@de,
                                                        "Data Asset"@en.
<http://www.data-knowledge.org/dk/DataConceptualization> vann:example "Eine Geschäftsobjektdomäne 'Material', ein Geschäftsobjekttyp 'Indirektes Material', ein Geschäftsobjekttyp-Attribut 'Materialnummer'"@de,
                                                                      "A Business Object Domain 'Material', a Business Object Type 'Indirect material', a business Object Type attribute 'Material number'"@en;
                                                         a skos:Concept,
                                                           owl:NamedIndividual,
                                                           owl:Class;
                                                         rdfs:comment "Eine Daten-Konzeptualisierung repräsentiert ein fachliches Konzept, mit dem Daten spezifiziert oder strukturiert werden. Da es sich um eine abstrakte Super-Klasse handelt, sollten nur ihre Subklassen verwendet werden."@de,
                                                                      "A Data Conceptualization represents a business concept to specify and structure data. As this is an abstract superclass only its subclasses may be used."@en;
                                                         rdfs:label "Daten-Konzeptualisierung"@de,
                                                                    "Data Conceptualization"@en.
<http://www.data-knowledge.org/dk/DataFlow> vann:example "Datensatz2837 fließt vom zentralen Stammdatenspeicher zum ERP-System"@de,
                                                         "Dataset2837 flows from Central master data repository to ERP system"@en;
                                            a owl:Class;
                                            rdfs:comment "Zeigt die tatsächliche Verbindung und den Datenaustausch zwischen konkreten Applikationen an"@de,
                                                         "Indicates the actual connection and data exchange between particular applications"@en;
                                            rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                            rdfs:label "Datenfluss"@de,
                                                       "Data Flow"@en.
<http://www.data-knowledge.org/dk/DataLifecycle> vann:example "Lebenszyklus von Produktstammdaten, spiegelt die Lebenszyklusphasen / -stadien des Produktes wieder: Entwicklung, Produktion, Aftermarket, Produktauslauf"@de,
                                                              "Draft, active, inactive"@en,
                                                              "Entwurf, aktiv, inaktiv"@de,
                                                              "Life cycle of product master data reflecting the product's life cycles phases / states: Development, Production, After market, Phased out"@en;
                                                 a lifecycle:Lifecyle,
                                                   owl:NamedIndividual,
                                                   owl:Class;
                                                 rdfs:comment "Definiert den Lebenszyklus von Geschäftsobjekten, Datenobjekten und Datengütern. Ein Lebenszyklus wird durch eine Menge möglicher Lebenszyklusphasen (lifecycle:State) definiert. Die Lebenszyklusdefinition kann außerdem Einschränkungen der möglichen Übergange zwischen Lebenszyklusphasen spezifizieren (lifecycle:possibleTransition)."@de,
                                                              "Defines the life cycle of Business Objects, Data Objects and Data Assets. A life cycle is defined by a set of possible life cycle states (lifecycle:State). The life cycle definition may also specify constraints on the transitions between the life cycle states (lifecycle:possibleTransition)."@en;
                                                 rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                 rdfs:label "Data Lifecycle"@en,
                                                            "Datenlebenszyklus"@de.
<http://www.data-knowledge.org/dk/DataManagementProcess> vann:example "Erstellung von Kundenstammdaten"@de,
                                                                      "Creation of customer master data"@en;
                                                         a owl:Class;
                                                         rdfs:comment "Sequence of activities for data maintenance or data governance"@en,
                                                                      "Abfolge von Tätigkeiten für die Datenpflege oder die Daten-Governance"@de;
                                                         rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                         rdfs:label "Datenmanagementprozess"@de,
                                                                    "Data Management Process"@en.
<http://www.data-knowledge.org/dk/DataObject> dcterms:hasPart <http://www.data-knowledge.org/dk/DataObjectAttribute>;
                                              dcterms:isPartOf <http://www.data-knowledge.org/dk/DataAsset>;
                                              vann:example "Database record of 'Fluid Supply Ltd'"@en,
                                                           "Datenbankeintrag zu 'Fluid Supply Ltd'"@de;
                                              a owl:Class;
                                              rdfs:comment "Individuelle Instanz eines Datenobjekttyps (DOT), d.h. die technische Repräsentation eines Geschäftsobjekts (BO)"@de,
                                                           "Individual record of a Data Object Type (DOT), i.e. the technical representation of a Business Object (BO)"@en;
                                              rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                              rdfs:label "Data Object (DO)"@en,
                                                         "Datenobjekt (DO)"@de.
<http://www.data-knowledge.org/dk/DataObjectAttribute> dcterms:isPartOf <http://www.data-knowledge.org/dk/DataObject>;
                                                       vann:example "'DE-123456-789' being the value of database column 'stceg' of record 'Fluid Supply Ltd'"@en,
                                                                    "'DE-123456-789' als Wert der Datenbankspalte 'stceg' des Datenbankeintrags 'Fluid Supply Ltd'"@de;
                                                       a owl:Class;
                                                       rdfs:comment "Eine Informationseinheit, welche Bestandteil eines Datenobjekts (DO) ist, d.h. die technische Repräsentation eines Geschäftsobjektattributs (BOA)"@de,
                                                                    "A piece of information being a part of a Data Object (DO), i.e. the technical representation of a Business Object Attribute (BOA)"@en;
                                                       rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                       rdfs:label "Datenobjektattribut (DOA)"@de,
                                                                  "Data Object Attribute (DOA)"@en.
<http://www.data-knowledge.org/dk/DataObjectType> dcterms:hasPart <http://www.data-knowledge.org/dk/DataObjectTypeAttribute>;
                                                  dcterms:isPartOf <http://www.data-knowledge.org/dk/Application>;
                                                  vann:example "Datenbanktabelle 'kna1'"@de,
                                                               "Database table 'kna1'"@en;
                                                  a owl:Class;
                                                  rdfs:comment "Technical representation of a Business Object Type (BOT)"@en,
                                                               "Technische Repräsentation eines Geschäftsobjekttyps (BOT)"@de;
                                                  rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                  rdfs:label "Data Object Type (DOT)"@en,
                                                             "Datenobjekttyp (DOT)"@de.
<http://www.data-knowledge.org/dk/DataObjectTypeAttribute> dcterms:isPartOf <http://www.data-knowledge.org/dk/DataObjectType>;
                                                           vann:example "Datenbankspalte 'stceg'"@de,
                                                                        "Database column 'stceg'"@en;
                                                           a owl:Class;
                                                           rdfs:comment "Individuelles (atomares) Feld, um eine Informationseineit zu speichern"@de,
                                                                        "Individual (atomic) field to store a piece of information"@en;
                                                           rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                           rdfs:label "Datenobjekttypattribut (DOTA)"@de,
                                                                      "Data Object Type Attribute (DOTA)"@en.
<http://www.data-knowledge.org/dk/Enumeration> dcterms:hasPart <http://www.data-knowledge.org/dk/NamedValue>;
                                               vann:example "Incoterms, country codes"@en,
                                                            "Incoterms, Ländercodes"@de;
                                               a owl:Class;
