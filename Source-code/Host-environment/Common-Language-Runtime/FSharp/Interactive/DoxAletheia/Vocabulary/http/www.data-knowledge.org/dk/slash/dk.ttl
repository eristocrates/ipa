<http://www.data-knowledge.org/dk/> ccrel:license <http://creativecommons.org/licenses/by-nc-sa/3.0/>;
                                    dcterms:creator "Erik Thordsen",
                                                    "Agatha Dabrowski",
                                                    "Martin Böhmer";
                                    dcterms:description "Das Data-Knowledge-Vokabular erlaubt die verständliche Beschreibung von Datengütern und dem Datenmanagement in Unternehmen. Es deckt Bereiche der Geschäftsdatendefinition, des Datenqualitätsmanagement, der Daten-Governance, der technischen Infrastruktur und viele weitere Aspekte des Datenmanagements in Unternehmen ab. Das Vokabular repräsentiert eine Linked-Data-Implementierung des Datenwissen-Modells, welches ein Resultat umfassender angewandter Forschung ist."@de,
                                                        "The Data Knowledge Vocabulary allows for a comprehensive description of data assets and enterprise data management. It covers a business data dictionary, data quality management, data governance, the technical infrastructure and many other aspects of enterprise data management. The vocabulary represents a linked data implementation of the Data Knowledge Model which resulted from extensive applied research."@en;
                                    dcterms:issued "2017-11-10";
                                    dcterms:modified "2017-12-08";
                                    dcterms:publisher <http://de.dbpedia.org/resource/Fraunhofer-Gesellschaft>;
                                    dcterms:rights "Attribution-NonCommercial-ShareAlike 3.0 Unported (CC BY-NC-SA 3.0)";
                                    dcterms:title "The Data Knowledge Vocabulary"@en,
                                                  "Das Data-Knowledge-Vokabular"@de;
                                    vann:preferredNamespacePrefix "dk";
                                    vann:preferredNamespaceUri "http://www.data-knowledge.org/dk/";
                                    voaf:classNumber "37";
                                    voaf:propertyNumber "29";
                                    a owl:NamedIndividual,
                                      voaf:Vocabulary,
                                      owl:Ontology;
                                    rdfs:label "Das Data-Knowledge-Vokabular"@de,
                                               "The Data Knowledge Vocabulary"@en;
                                    rdfs:seeAlso dk:,
                                                 <http://www.data-knowledge.org/>;
                                    owl:priorVersion <http://www.data-knowledge.org/dk/1.0/>;
                                    owl:versionInfo "1.1".
<http://www.data-knowledge.org/dk/Application> dcterms:hasPart <http://www.data-knowledge.org/dk/ApplicationInterface>,
                                                               <http://www.data-knowledge.org/dk/DataObjectType>;
                                               vann:example "Enterprise Resource Planning System (ERP)"@en,
                                                            "Enterprise Resource Planning System (ERP)"@de;
                                               a owl:Class;
                                               rdfs:comment "An installed instance of an application that stores or processes data"@en,
                                                            "Eine installierte Instanz einer Anwendung, welche Daten speichert oder verarbeitet"@de;
                                               rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                               rdfs:label "Applikation"@de,
                                                          "Application"@en.
<http://www.data-knowledge.org/dk/ApplicationInterface> dcterms:isPartOf <http://www.data-knowledge.org/dk/Application>;
                                                        vann:example "ERP system's web-service"@en,
                                                                     "Der Web-Service des ERP-Systems"@de;
                                                        a owl:Class;
                                                        rdfs:comment "Technische Spezifikation einer Applikation, um Daten auszutauschen"@de,
                                                                     "Technical specification of an application to exchange data"@en;
                                                        rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                        rdfs:label "Applikationsschnittstelle"@de,
                                                                   "Application Interface"@en.
<http://www.data-knowledge.org/dk/ApplicationLifecycle> vann:example "test, production, deprecated"@en,
                                                                     "Test, produktiv, abgekündigt"@de;
                                                        a owl:NamedIndividual,
                                                          lifecycle:Lifecycle,
                                                          owl:Class;
                                                        rdfs:comment "Defines the life cycle of Applications. A life cycle is defined by a set of possible life cycle states (lifecycle:State). The life cycle definition may also specify constraints on the transitions between the life cycle states (lifecycle:possibleTransition)."@en,
                                                                     "Definiert den Lebenszyklus von Applikationen. Ein Lebenszyklus wird durch eine Menge von möglichen Lebenszyklusphasen (lifecycle:State) definiert. Die Lebenszyklusdefinition kann außerdem Einschränkungen der möglichen Übergange zwischen Lebenszyklusphasen spezifizieren (lifecycle:possibleTransition)."@de;
                                                        rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                        rdfs:label "Applikationslebenszyklus"@de,
                                                                   "Application Lifecycle"@en.
<http://www.data-knowledge.org/dk/AttributeMapping> dcterms:isPartOf <http://www.data-knowledge.org/dk/Mapping>;
                                                    vann:example "The Business Object Type Attribute 'Customer name' is mapped to Data Object Type Attribute 'cust_nm' in the CRM system and DOTA 'company_name' in the ERP system."@en,
                                                                 "Das Geschäftsobjekttyp-Attribut (BOTA) 'Kundenname' ist dem Datenobjekttyp-Attribut (DOTA) 'cust_nm' im CRM-System und dem DOTA 'company_name' im ERP-System zugeordnet."@de;
                                                    a owl:Class;
                                                    rdfs:comment "Konzeptuelle Zuordnung von Geschäftsdefinitionen zu technischen Repräsentationen von Attributen."@de,
                                                                 "Conceptual mapping of business definitions to technical representations for attributes."@en;
                                                    rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                    rdfs:label "Attribute Mapping"@en,
                                                               "Attribut-Zuordnung"@de.
<http://www.data-knowledge.org/dk/BusinessObject> dcterms:hasPart <http://www.data-knowledge.org/dk/BusinessObjectAttribute>;
                                                  vann:example "Supplier 'Fluid Supply Ltd'"@en,
                                                               "Lieferant 'Fluid Supply Ltd'"@de;
                                                  a owl:Class;
                                                  rdfs:comment "Spezifische, individuelle Instanz eines Geschäftsobjekttyps (BOT)"@de,
                                                               "Specific, individual instance of a Business Object Type (BOT)"@en;
                                                  rdfs:isDefinedBy <http://www.data-knowledge.org/dk/>;
                                                  rdfs:label "Geschäftsobjekt (BO)"@de,
                                                             "Business Object (BO)"@en.
<http://www.data-knowledge.org/dk/BusinessObjectAttribute> dcterms:isPartOf <http://www.data-knowledge.org/dk/BusinessObject>;
                                                           vann:example "Tax ID 'DE-123456-789'"@en,
                                                                        "Steuer-ID 'DE-123456-789'"@de;
                                                           a owl:Class;
                                                           rdfs:comment "Spezifische, individuelle Instanz eines Geschäftsobjekttyp-Attributs (BOTA)"@de,
