@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ruto: <http://rdfunit.aksw.org/ns/core#>.

ruto: <http://purl.org/dc/elements/1.1/creator> "Jens Lehmann"@en,
                                                "Sören Auer"@en,
                                                "Sebastian Hellmann"@en,
                                                "Dimitris Kontokostas"@en,
                                                "Patrick Westphal"@en,
                                                "Roland Cornelissen"@en;
      <http://purl.org/dc/elements/1.1/date> "2013-10-01"^^xsd:date;
      <http://purl.org/dc/elements/1.1/description> "The RDFUnit ontology describes concepts used in RDFUnit, a test driven data-debugging framework that can run automatically generated (based on a schema) and manually generated test cases against an endpoint."@en;
      <http://purl.org/dc/elements/1.1/issued> "2013-10-01"^^xsd:date;
      <http://purl.org/dc/elements/1.1/modified> "2014-01-10"^^xsd:date;
      <http://purl.org/dc/elements/1.1/rights> "This ontology is licensed under Apache 2.0 (http://www.apache.org/licenses/LICENSE-2.0) and CC-BY (http://creativecommons.org/licenses/by/3.0/)"@en;
      <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>,
                                         <http://www.apache.org/licenses/LICENSE-2.0>;
      <http://purl.org/dc/terms/title> "Test-Driven Data Debugging Ontology"@en;
      <http://purl.org/vocab/vann/changes> <https://github.com/AKSW/RDFUnit/commits/master/ns>;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "rut";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://rdfunit.aksw.org/ns/core#";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "The RDFUnit ontology describes concepts used in RDFUnit, a test driven data-debugging framework that can run automatically generated (based on a schema) and manually generated test cases against an endpoint."@en;
      rdfs:isDefinedBy <http://rdfunit.aksw.org/ns/core.ttl>;
      rdfs:label "Test-Driven Data Debugging Ontology"@en;
      rdfs:seeAlso <http://aksw.org/Projects/RDFUnit.html>;
      <http://www.w3.org/2002/07/owl#versionInfo> "0.3".
ruto:AggregatedTestCaseResult a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A class that holds the aggregated results of a single test execution"@en;
                              rdfs:label "AggregatedTestCaseResult"@en;
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> ruto:resultPrevalence ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> ruto:resultCount ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              ruto:StatusTestCaseResult.
ruto:Application a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   ruto:TestAppliesTo;
                 rdfs:comment "Application: When the tests are specific to an application only"@en;
                 rdfs:label "Application"@en.
ruto:AutoGenerated a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     ruto:TestGenerationType;
                   rdfs:comment "AutoGenerated: This test was created automatically"@en;
                   rdfs:label "AutoGenerated"@en.
ruto:Binding a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A binding between a pattern parameter and a value"@en;
             rdfs:label "Binding"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ruto:bindingValue ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ruto:parameter ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:Class a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             ruto:ParameterConstraint;
           rdfs:comment "The parameter is restricted to a Class."@en;
           rdfs:label "Class"@en.
ruto:Dataset a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               ruto:TestAppliesTo;
             rdfs:comment "Dataset: When the tests applies to a dataset only (i.e. a SPARQL Endpoint)"@en;
             rdfs:label "Dataset"@en.
ruto:EnrichedSchema a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      ruto:TestAppliesTo;
                    rdfs:comment "EnrichedSchema: When the tests applies to an ontology / vocabulary enriched with external (semi-)automatic approaches"@en;
                    rdfs:label "EnrichedSchema"@en.
ruto:ExtendedTestCaseResult a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "ExtendedTestCaseResult"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> <http://spinrdf.org/spin#violationRoot> ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            ruto:RLOGTestCaseResult,
                                            <http://spinrdf.org/spin#ConstraintViolation>.
ruto:ManualTestCase a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A test case where the SPARQL is defined manually"@en;
                    rdfs:label "ManualTestCase"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> ruto:sparqlPrevalence ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> ruto:sparqlWhere ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    ruto:TestCase.
ruto:ManuallyGenerated a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         ruto:TestGenerationType;
                       rdfs:comment "ManuallyGenerated: This test was created manually"@en;
                       rdfs:label "ManuallyGenerated"@en.
ruto:None a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            ruto:ParameterConstraint;
          rdfs:comment "The parameter can be anything, even a free variable (?var)"@en;
          rdfs:label "None"@en.
ruto:Operator a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                ruto:ParameterConstraint;
              rdfs:comment "The parameter can be an operator."@en;
              rdfs:label "Operator"@en.
ruto:Parameter a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Parameter"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> ruto:constraintPattern ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> ruto:parameterConstraint ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/identifier> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:ParameterConstraint a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "ParameterConstraint"@en.
ruto:Pattern a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Pattern"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ruto:parameter ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ruto:sparqlPrevalencePattern ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> ruto:sparqlWherePattern ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/identifier> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:PatternBasedTestCase a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A test case that is based on a Pattern"@en;
                          rdfs:label "PatternBasedTestCase"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> ruto:binding ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> ruto:basedOnPattern ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          ruto:TestCase.
ruto:Property a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                ruto:ParameterConstraint;
              rdfs:comment "The parameter is restricted to a property."@en;
              rdfs:label "Property"@en.
ruto:RLOGTestCaseResult a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "RLOGTestCaseResult"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#level> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#message> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#resource> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        ruto:TestCaseResult,
                                        <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Entry>.
ruto:Resource a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                ruto:ParameterConstraint;
              rdfs:comment "The pattern can be a resource."@en;
              rdfs:label "Resource"@en.
ruto:ResultAnnotation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Used to further annotate an ExtendedTestCaseResult."@en;
                      rdfs:label "ResultAnnotation"@en.
ruto:ResultStatus a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "TestCaseResult type"@en;
                  rdfs:label "ResultStatus"@en.
ruto:ResultStatusError a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                         ruto:ResultStatus;
                       rdfs:label "ResultStatusError"@en.
ruto:ResultStatusFail a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        ruto:ResultStatus;
                      rdfs:label "ResultStatusFail"@en.
ruto:ResultStatusSuccess a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                           ruto:ResultStatus;
                         rdfs:label "ResultStatusSuccess"@en.
ruto:ResultStatusTimeout a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                           ruto:ResultStatus;
                         rdfs:label "ResultStatusTimeout"@en.
ruto:Schema a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              ruto:TestAppliesTo;
            rdfs:label "Schema"@en.
ruto:StatusTestCaseResult a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A class that holds the status of a single test execution"@en;
                          rdfs:label "StatusTestCaseResult"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> ruto:resultStatus ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          ruto:TestCaseResult.
ruto:TestAppliesTo a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "TestAppliesTo"@en.
ruto:TestCase a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A superclass of TestCases. Defines properties all test cases can have but concrete implementation occurs on subclasses."@en;
              rdfs:label "TestCase"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> ruto:references ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> ruto:source ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> ruto:generated ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> ruto:appliesTo ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/description> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:TestCaseDependency a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "defines a dependency between two test cases"@en;
                        rdfs:label "TestCaseDependency"@en.
ruto:TestCaseResult a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A class that holds a single result of a test execution. Each test case links to the TestCase (rut:testCase) it was originated from and a TestExecution (prov:wasGeneratedBy)"@en;
                    rdfs:label "TestCaseResult"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> ruto:testCase ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasGeneratedBy> ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:TestExecution a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Holds the results of a TestSuite execution against a dataset"@en;
                   rdfs:label "TestExecution"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> ruto:source ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#endedAtTime> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#startedAtTime> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://www.w3.org/ns/prov#Activity>.
ruto:TestGenerationType a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "TestGenerationType"@en.
ruto:TestGenerator a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "TestGenerator"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> ruto:basedOnPattern ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> ruto:sparqlGenerator ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>].
ruto:TestSuite a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A list of test cases. Use prov:hadMember for test case listing"@en;
               rdfs:label "TestSuite"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#hadMember> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               <http://www.w3.org/ns/prov#Collection>.
ruto:annotationProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain ruto:ResultAnnotation;
                        rdfs:label "annotationProperty"@en;
                        rdfs:range rdf:Property.
ruto:annotationValue a rdf:Property;
                     rdfs:domain ruto:ResultAnnotation;
                     rdfs:label "annotationValue"@en.
ruto:appliesTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "applies to describes the ontology used for terms in the Test."@en;
               rdfs:domain ruto:TestCase;
               rdfs:label "appliesTo"@en;
               rdfs:range ruto:TestAppliesTo.
ruto:basedOnPattern a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "basedOnPattern contains the Data Quality Test Pattern that is instantiated in the described Test."@en;
                    rdfs:label "basedOnPattern"@en;
                    rdfs:range ruto:Pattern.
ruto:binding a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "defines a binding between a pattern parameter and a value"@en;
             rdfs:domain ruto:PatternBasedTestCase;
             rdfs:label "binding"@en;
             rdfs:range ruto:Binding.
ruto:bindingValue a rdf:Property;
                  rdfs:comment "the value of a Binding"@en;
                  rdfs:domain ruto:Binding;
                  rdfs:label "bindingValue"@en.
ruto:constraintPattern a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain ruto:Parameter;
                       rdfs:label "constraintPattern"@en;
                       rdfs:range xsd:string.
ruto:dependencyCondition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "the rut:ResultStatus of the dependencyFrom result condition that triggers this dependency"@en;
                         rdfs:domain ruto:TestCaseDependency;
                         rdfs:label "dependencyCondition"@en;
                         rdfs:range ruto:ResultStatus.
ruto:dependencyExecute a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "'true' executes the dependecnyTo TestCase while false does not"@en;
                       rdfs:domain ruto:TestCaseDependency;
                       rdfs:label "dependencyExecute"@en;
                       rdfs:range xsd:boolean.
ruto:dependencyFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "the test case we depends upon"@en;
                    rdfs:domain ruto:TestCaseDependency;
                    rdfs:label "dependencyFrom"@en;
                    rdfs:range ruto:TestCase.
ruto:dependencyTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "the test case that depends on another test case"@en;
                  rdfs:domain ruto:TestCaseDependency;
                  rdfs:label "dependencyTo"@en;
                  rdfs:range ruto:TestCase.
ruto:errorClassification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property is used to annotate an error with a classification. This classification is meant to be of higher level"@en;
                         rdfs:domain ruto:ExtendedTestCaseResult;
                         rdfs:label "errorClassification"@en;
                         rdfs:subPropertyOf <http://purl.org/dc/terms/subject>.
ruto:errorPropertyContext a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Here we attach properties from the resource to provide the error context (i.e. the death date when the error is in the birth date)."@en;
                          rdfs:domain ruto:ExtendedTestCaseResult;
                          rdfs:label "errorPropertyContext"@en;
                          rdfs:range rdf:Property.
ruto:errorSource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "With this property we point to the error source (if known beforehand)"@en;
                 rdfs:domain ruto:ExtendedTestCaseResult;
                 rdfs:label "errorSource"@en;
                 rdfs:subPropertyOf <http://purl.org/dc/terms/subject>.
ruto:errorType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "We denote the exact problem of the error"@en;
               rdfs:domain ruto:ExtendedTestCaseResult;
               rdfs:label "errorType"@en;
               rdfs:subPropertyOf <http://purl.org/dc/terms/subject>.
ruto:generated a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "generated specifies the way the test was constructed."@en;
               rdfs:domain ruto:TestCase;
               rdfs:label "generated"@en;
               rdfs:range ruto:TestGenerationType.
ruto:parameter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "links a Pattern with a list of pattern parameters"@en;
               rdfs:label "parameter"@en;
               rdfs:range ruto:Parameter.
ruto:parameterConstraint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain ruto:Parameter;
                         rdfs:label "parameterConstraint"@en;
                         rdfs:range ruto:ParameterConstraint.
ruto:references a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "references specifies the Classes and Properties involved in the described test case."@en;
                rdfs:domain ruto:TestCase;
                rdfs:label "references"@en.
ruto:resultAnnotation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:label "resultAnnotation"@en;
                      rdfs:range ruto:ResultAnnotation.
ruto:resultCount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The error results of a test execution. -1 means there was a timeout and -2 an error."@en;
                 rdfs:domain ruto:Result;
                 rdfs:label "resultCount"@en;
                 rdfs:range xsd:integer.
ruto:resultPrevalence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The prevalence result of a test execution. -1 means there was a timeout and -2 an error."@en;
                      rdfs:domain ruto:Result;
                      rdfs:label "resultPrevalence"@en;
                      rdfs:range xsd:integer.
ruto:resultStatus a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "holds the result type. One of Success, Fail, Timeout, Error"@en;
                  rdfs:label "resultStatus"@en;
                  rdfs:range ruto:ResultStatus.
ruto:source a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "source is a URI that points to a general Source, which can be a schema, a dataset or an application"@en;
            rdfs:label "source"@en.
ruto:sparqlGenerator a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "A SPARQL query used to instantiate test cases based on patterns"@en;
                     rdfs:domain ruto:TestGenerator;
                     rdfs:label "sparqlGenerator"@en;
                     rdfs:range xsd:string.
ruto:sparqlPrevalence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "A SPARQL query for prevalence"@en;
                      rdfs:domain ruto:ManualTestCase;
                      rdfs:label "sparqlPrevalence"@en;
                      rdfs:range xsd:string.
ruto:sparqlPrevalencePattern a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "A pattern sparql prevalence query, reuses the pattern parameters, maybe not all of them. The prevalence query may be empty"@en;
                             rdfs:domain ruto:Pattern;
                             rdfs:label "sparqlPrevalencePattern"@en;
                             rdfs:range xsd:string.
ruto:sparqlWhere a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment """The WHERE part of a SPARQL query. Must be enclosed in brackets {} and use the following variables: ?resource, ?message.
        ?resource is URI the constraint violation occurs in and ?message is a logging message."""@en;
                 rdfs:domain ruto:ManualTestCase;
                 rdfs:label "sparqlWhere"@en;
                 rdfs:range xsd:string.
ruto:sparqlWherePattern a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "The WHERE part of sparql pattern  query with placeholders (%%XYZ%%) for parameters"@en;
                        rdfs:domain ruto:Pattern;
                        rdfs:label "sparqlWherePattern"@en;
                        rdfs:range xsd:string.
ruto:testCase a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "points to a test case";
              rdfs:label "testCase"@en;
              rdfs:range ruto:TestCase.
ruto:testCaseLogLevel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "the rlog:Level this case is associated with."@en;
                      rdfs:domain ruto:TestCase;
                      rdfs:label "testCaseLogLevel"@en;
                      rdfs:range <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/rlog#Level>.
ruto:testSuite a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "links an ontology to TestSuite for validating data adhering to that ontology"@en;
               rdfs:domain <http://www.w3.org/2002/07/owl#Ontology>;
               rdfs:label "testSuite"@en;
               rdfs:range ruto:TestSuite.
ruto:testsError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Total tests that raised an error in a TestExecution"@en;
                rdfs:domain ruto:TestExecution;
                rdfs:label "testsError"@en;
                rdfs:range xsd:nonNegativeInteger.
ruto:testsFailed a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Total tests that failed in a TestExecution"@en;
                 rdfs:domain ruto:TestExecution;
                 rdfs:label "testsFailed"@en;
                 rdfs:range xsd:nonNegativeInteger.
ruto:testsRun a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Total tests run in a TestExecution"@en;
              rdfs:domain ruto:TestExecution;
              rdfs:label "testsRun"@en;
              rdfs:range xsd:nonNegativeInteger.
ruto:testsSucceeded a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Total tests that succedded in a TestExecution"@en;
                    rdfs:domain ruto:TestExecution;
                    rdfs:label "testsSucceeded"@en;
                    rdfs:range xsd:nonNegativeInteger.
ruto:testsTimeout a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Total tests that timeout in a TestExecution"@en;
                  rdfs:domain ruto:TestExecution;
                  rdfs:label "testsTimeout"@en;
                  rdfs:range xsd:nonNegativeInteger.
