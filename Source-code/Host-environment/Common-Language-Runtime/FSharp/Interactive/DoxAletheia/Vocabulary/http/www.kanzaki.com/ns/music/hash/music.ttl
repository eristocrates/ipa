               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "cis moll".
music:composer a owl:ObjectProperty;
               rdfs:comment "The subject musical work is composed by a person, a group, a software program etc.";
               rdfs:domain music:Oeuvre;
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Composer";
               rdfs:range foaf:Agent;
               rdfs:subPropertyOf music:description,
                                  dc11:creator.
music:composition a owl:ObjectProperty;
                  rdfs:comment "Describes the composition process of the subject. Composition period or completion date, place, revision etc. can be described as properties of the object composition process.";
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Composition";
                  rdfs:subPropertyOf music:description.
music:conductor a owl:ObjectProperty;
                rdfs:comment "The subject performance is coducted by the object (or the subject musical event has a conductor). See comment of #performer.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Conductor";
                rdfs:subPropertyOf music:performer.
music:conductorName a owl:DatatypeProperty;
                    rdfs:comment "The subject musical event has a conductor. Literal version of #conductor.";
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "Conductor Name";
                    rdfs:subPropertyOf music:performerName.
music:d-moll dcterms:alternative "D minor";
             dcterms:description wiki:D_minor;
             a music:Key;
             rdfs:comment "Minor key based on D, whose key signature has 1 flat.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "d moll".
music:derivedFrom ex:example [ex:code """
<m:Symphony rdf:about=\"http://purl.org/net/masterwork/beethoven/op.125\">
 <m:source>
  <m:Score rdf:about=\"urn:musicalsource:lvb/125/autograph\">
   <dc:title>Autograph score</dc:title>
  </m:Score>
 </m:source>
 <m:source>
  <m:Score rdf:about=\"urn:musicalsource:lvb/125/copystscore1\">
   <dc:title>A copyist's socore used as engraver's copy</dc:title>
   <m:derivedFrom rdf:resource=\"urn:musicalsource:lvb/125/autograph\"/>
  </m:Score>
 </m:source>
</m:Symphony>
""" ; 
                              a ex:Example];
                  a owl:ObjectProperty;
                  rdfs:comment "The subject is (was) derived from the object, e.g a copy score is derived from the composer manuscript (or, possibly, a CD recording is derived from a performance at a concert).";
                  rdfs:domain music:Musical_Representation;
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Derived From";
                  rdfs:range music:Musical_Representation;
                  rdfs:subPropertyOf dc11:source.
music:description a owl:ObjectProperty;
                  rdfs:comment "A description of the subject musical work. Super-property of some properties in this vocabulary, as well as description of a general descriptive resource such as time-line of composing process.";
                  rdfs:domain music:Musical_Work;
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Description";
                  rdfs:range owl:Thing.
music:dis-moll dcterms:alternative "D-Sharp minor";
               dcterms:description wiki:D_sharp_minor;
               a music:Key;
               rdfs:comment "Minor key based on D sharp, whose key signature has 6 sharps.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "dis moll".
music:e-moll dcterms:alternative "E minor";
             dcterms:description wiki:E_minor;
             a music:Key;
             rdfs:comment "Minor key based on E, whose key signature has 1 sharp.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "e moll".
music:es-moll dcterms:alternative "E-Flat minor";
              dcterms:description wiki:E_flat_minor;
              a music:Key;
              rdfs:comment "Minor key based on E flat, whose key signature has 6 flats.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "es moll".
music:event_description a owl:ObjectProperty;
                        rdfs:comment "A description of the subject musical event. Super-property of #program, #presents, #venue.";
                        rdfs:domain music:Musical_Event;
                        rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                        rdfs:label "Event Description";
                        rdfs:range owl:Thing.
music:f-moll dcterms:alternative "F minor";
             dcterms:description wiki:F_minor;
             a music:Key;
             rdfs:comment "Minor key based on F, whose key signature has 4 flats.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "f moll".
music:fis-moll dcterms:alternative "F-Sharp minor";
               dcterms:description wiki:F_sharp_minor;
               a music:Key;
               rdfs:comment "Minor key based on F sharp, whose key signature has 3 sharps.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "fis moll".
music:form a owl:DatatypeProperty;
           rdfs:comment "The subject musical work or its movement has a form, such as sonata, minuet, etc. Would be better defined as ObjectProperty.";
           rdfs:domain music:Musical_Work;
           rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
           rdfs:label "Form";
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf dc11:description.
music:g-moll dcterms:alternative "G minor";
             dcterms:description wiki:G_minor;
             a music:Key;
             rdfs:comment "Minor key based on G, whose key signature has 2 flats.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "g moll".
music:gis-moll dcterms:alternative "G-Sharp minor";
               dcterms:description wiki:G_sharp_minor;
               a music:Key;
               rdfs:comment "Minor key based on G sharp, whose key signature has 5 sharps.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "gis moll".
music:h-moll dcterms:alternative "B minor";
             dcterms:description wiki:B_minor;
             a music:Key;
             rdfs:comment "Minor key based on B, whose key signature has 2 sharps.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "h moll".
music:key a owl:ObjectProperty;
          rdfs:comment "The subject musical work or its movement has a key, such as C major, d minor, etc.";
          rdfs:domain music:Musical_Work;
          rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
          rdfs:label "Key";
          rdfs:range music:Key;
          rdfs:subPropertyOf music:description.
music:keyName a owl:DatatypeProperty;
              rdfs:comment "The subject musical work or its movement has a key. Textual version of #key.";
              rdfs:domain music:Musical_Work;
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Key Name";
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf dc11:description.
music:marks a owl:DatatypeProperty;
            rdfs:comment "The subject musical work or its movement has instruction mark(s) of tempo and/or expression";
            rdfs:domain music:Musical_Work;
            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
            rdfs:label "Marks";
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf dc11:description.
music:meter a owl:DatatypeProperty;
            rdfs:comment "The subject musical work or its movement has a time measure such as 3/4, 4/4, 6/8 etc";
            rdfs:domain music:Musical_Work;
            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
            rdfs:label "Meter";
            rdfs:range rdfs:Literal;
            rdfs:subPropertyOf dc11:description.
music:opus a owl:DatatypeProperty;
           rdfs:comment "The subject musical composition has an identifier assigned by a composer (e.g. 'op.131') or other editor (e.g. 'KV.551')";
           rdfs:domain music:Oeuvre;
           rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
           rdfs:label "Opus";
           rdfs:range rdfs:Literal;
           rdfs:subPropertyOf dc11:identifier.
music:performer ex:example [ex:code """
<!--Preferred description.-->
<m:Concert>
 <m:presents>
  <m:Performance>
   <m:conductor foaf:name=\"Sir Roger Norrington\"/>
   <m:performer foaf:name=\"R.S.O. Stuttgart\"/>
   <m:represents>
    <m:Symphony>
     <m:composer foaf:name=\"Brahms\"/>
     <dc:title>Symphony No.2 D major</dc:title>
    </m:Symphony>
   </m:represents>
  </m:Performance>
 </m:presents>
</m:Concert>
""" ; 
                            a ex:Example],
                           [ex:code """
<!--Possibly more intuitive description.-->
<m:Concert>
 <m:conductor foaf:name=\"Sir Roger Norrington\"/>
 <m:performer foaf:name=\"R.S.O. Stuttgart\"/>
 <m:program>
  <m:Symphony>
   <m:composer foaf:name=\"Brahms\"/>
   <dc:title>Symphony No.2 D major</dc:title>
  </m:Symphony>
 </m:program>
</m:Concert>

<!-- An application may infer that:
{X a m:Concert; m:performer Y; m:program Z.} =>
{X m:presents [a m:Performance; m:performer Y; m:represents Z] .}
-->
""" ; 
                            a ex:Example];
                a owl:ObjectProperty;
                rdfs:comment """The subject has a performer (an artist, a group, a machine etc.). The preferred domain of this property is #Performance, so as to model that \"a concert presents a performance (of a musical work) that is realized by this performer\". However, in natural language, we often say that \"a concert has performers who play these musical works\", i.e. the domain of 'performer' is #Musical_Event in this case, and it would be more intuitive model. Hence, the domain is leave unrestricted here for a moment. """;
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Performer";
                rdfs:range foaf:Agent.
music:performerName a owl:DatatypeProperty;
                    rdfs:comment "The subject musical event has a performer. Literal version of #performer.";
                    rdfs:domain music:Musical_Event;
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "PerformerName";
                    rdfs:range rdfs:Literal;
                    rdfs:subPropertyOf dc11:description.
music:performs a owl:ObjectProperty;
               rdfs:comment "The subject artist (or group, machine, etc) performs a musical work.";
               rdfs:domain foaf:Agent;
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Performs";
               rdfs:subPropertyOf music:artist_description;
               owl:inverseOf music:performer.
music:plays a owl:ObjectProperty;
            rdfs:comment "The subject artist (or group, machine, etc) plays an musical instrument. If :me :plays :Violin, then :me a :Violininst.";
            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
            rdfs:label "Plays";
            rdfs:range music:Musical_Instrument;
            rdfs:subPropertyOf music:artist_description.
music:premiere ex:example [ex:code """
<m:Symphony>
 <m:composer foaf:name=\"Shubert\"/>
 <dc:title>Symohony No.7 'Unfinished'</dc:title>
 <m:opus>D.759</m:opus>
 <dcterms:created>1822-01</dcterms:created>
 <m:premiere rdf:parseType=\"Resource\">
  <dc:date>1865-12-17</dc:date>
  <cal:location>Wien Musikfereinsall</cal:location>
 </m:premiere>
</m:Symphony>
""" ; 
                           a ex:Example];
               a owl:ObjectProperty;
               rdfs:comment "The subject musical work was first performed at an concert";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Premiere";
               rdfs:range music:Musical_Event;
               rdfs:subPropertyOf music:description.
music:presents a owl:ObjectProperty;
               rdfs:comment "The subject musical event presents a performance of a musical work. An experiment to have better model to describe musical work, its representation and an event to present the representation.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Presents";
               rdfs:range music:Performance;
               rdfs:subPropertyOf music:event_description.
music:program a owl:ObjectProperty;
              rdfs:comment "The subject musical event presents a musical work as its program";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Program";
              rdfs:range music:Oeuvre;
              rdfs:subPropertyOf music:event_description.
music:programLine a owl:DatatypeProperty;
                  rdfs:comment "The subject musical event presents a musical work as its program. Literal version of #program.";
                  rdfs:domain music:Musical_Event;
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Program Line";
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf dc11:description.
music:published ex:example [ex:code """
<m:Symphony>
 <m:composer foaf:name=\"Beethoven\"/>
 <dc:title>Symphony No.9</dc:title>
 <m:opus>Op.125</m:opus>
 <m:published>
  <m:Score>
   <dc:date>1826-08</dc:date>
   <dc:description>The first published edition</dc:description>
   <dc:publisher>Schott</dc:publisher>
  </m:Score>
 </m:published>
</m:Symphony>
""" ; 
                            a ex:Example];
                a owl:ObjectProperty;
                rdfs:comment "The subject musical work is published as a score or sheet music (still not sure what kind of class is appropriate as the range)";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "published";
                rdfs:range music:Written_Representation;
                rdfs:subPropertyOf music:description.
music:represents a owl:ObjectProperty;
                 rdfs:comment "The subject (performance, score, etc) is a representation of the object musical work. An experiment to have better model.";
                 rdfs:domain music:Musical_Representation;
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Represents";
                 rdfs:range music:Musical_Work.
music:sections a owl:ObjectProperty;
               rdfs:comment "The subject musical work has subsections such as movements. Current model recommends RDF Collection as the object.";
               rdfs:domain music:Oeuvre;
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Sections";
               rdfs:range owl:Thing;
               rdfs:subPropertyOf music:description.
music:soloist a owl:ObjectProperty;
              rdfs:comment "The subject performance is performed by this soloist (or the subject musical event has a soloist. See comment of #performer.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Soloist";
              rdfs:subPropertyOf music:performer.
music:source a owl:ObjectProperty;
             rdfs:comment "The subject musical work has a historical source, such as sketch, autograph score or published score.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Source";
             rdfs:range music:Written_Representation;
             rdfs:subPropertyOf music:description.
music:venue a owl:ObjectProperty;
            rdfs:comment "The subject musical event is presented at the object venue.";
            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
            rdfs:label "Venue";
            rdfs:range music:Venue;
            rdfs:subPropertyOf music:event_description.
<http://www.kanzaki.com/ns/music-rdfs.rdf> a owl:Ontology.
<http://www.kanzaki.com/works/2007/misc/music-vocab-sample2.png> a foaf:Image;
                                                                 rdfs:label "'circles and arrows' graphical representation of this example".
<http://www.kanzaki.com/works/2007/misc/music-vocab-sample3.png> a foaf:Image;
                                                                 rdfs:label "'circles and arrows' graphical representation of this example".
foaf:Agent a owl:Class.
