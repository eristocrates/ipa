_:Bcee09613dc2973f274afe644dc1982f0 ex:code """
<m:Concert>
 <dc:title>Tokyo Green Symphony Orchestra 12th Concert</dc:title>
 <dc:date>2003-11-02T14:00+09:00</dc:date>
 <m:conductorName>Yuri Nitta</m:conductorName>
