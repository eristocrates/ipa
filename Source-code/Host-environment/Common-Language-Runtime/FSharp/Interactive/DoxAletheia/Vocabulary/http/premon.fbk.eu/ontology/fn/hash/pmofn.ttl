                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "pmofn";
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://premon.fbk.eu/ontology/fn#";
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment "The FrameNet module of the PreMOn ontology extends the core module for representing concepts specific to FrameNet. The modelling is based on the [FrameNet II: Extended Theory and Practice](https://framenet2.icsi.berkeley.edu/docs/r1.5/book.pdf) book."@en;
                                   rdfs:isDefinedBy <http://premon.fbk.eu/ontology/fn.ttl>;
                                   <http://www.w3.org/2002/07/owl#imports> <http://premon.fbk.eu/ontology/core>,
                                                                           <http://www.w3.org/ns/lemon/ontolex>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "2017a".
pmofn:CoreFrameElement a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "Core Frame Element (FN)"@en;
                       rdfs:subClassOf pmofn:FrameElement.
pmofn:CoreUnexpressedFrameElement a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:label "Core-unexpressed Frame Element (FN)"@en;
                                  rdfs:subClassOf pmofn:FrameElement.
pmofn:ExtraThematicFrameElement a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:label "Extra-thematic Frame Element (FN)"@en;
                                rdfs:subClassOf pmofn:FrameElement.
pmofn:FECoreSet a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Frame Element Core Set"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://premon.fbk.eu/ontology/core#item> ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> pmofn:FrameElement ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> <http://premon.fbk.eu/ontology/core#item> ; 
                                 <http://www.w3.org/2002/07/owl#minCardinality> "2"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
pmofn:Frame a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Frame (FN)"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> <http://premon.fbk.eu/ontology/core#evokedConcept>] ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> pmofn:LexicalUnit ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#onProperty> <http://premon.fbk.eu/ontology/core#semRole> ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> pmofn:FrameElement ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <http://premon.fbk.eu/ontology/core#SemanticClass>.
pmofn:FrameElement a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Frame Element (FN)"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> [<http://www.w3.org/2002/07/owl#inverseOf> <http://premon.fbk.eu/ontology/core#semRole>] ; 
                                    <http://www.w3.org/2002/07/owl#allValuesFrom> pmofn:Frame ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://premon.fbk.eu/ontology/core#SemanticRole>;
                   <http://www.w3.org/2002/07/owl#disjointUnionOf> (pmofn:CoreFrameElement
                                                                    pmofn:CoreUnexpressedFrameElement
                                                                    pmofn:ExtraThematicFrameElement
                                                                    pmofn:PeripheralFrameElement).
pmofn:LUStatus a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Lexical Unit Status"@en.
pmofn:LexicalUnit a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "Lexical Unit"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://premon.fbk.eu/ontology/core#evokedConcept> ; 
                                   <http://www.w3.org/2002/07/owl#allValuesFrom> pmofn:Frame ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  <http://premon.fbk.eu/ontology/core#Conceptualization>.
pmofn:PeripheralFrameElement a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "Peripheral Frame Element (FN)"@en;
                             rdfs:subClassOf pmofn:FrameElement.
pmofn:SemType a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Semantic Type"@en.
pmofn:excludesFrameElement a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                             <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                           rdfs:domain pmofn:FrameElement;
                           rdfs:label "excludes frame element"@en;
                           rdfs:range pmofn:FrameElement;
                           rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>;
                           <http://www.w3.org/2002/07/owl#propertyDisjointWith> pmofn:requiresFrameElement.
pmofn:feCoreSet a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                rdfs:domain pmofn:Frame;
                rdfs:label "frame element core set"@en;
                rdfs:range pmofn:FECoreSet.
pmofn:frameRelation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain pmofn:Frame;
                    rdfs:label "frame relation"@en;
                    rdfs:range pmofn:Frame;
                    rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#classRel>.
pmofn:implicitIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain pmofn:FrameElement;
                 rdfs:label "implicit in"@en.
pmofn:incorporatedFrameElement a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                               rdfs:domain pmofn:LexicalUnit;
                               rdfs:label "incorporated frame element"@en;
                               rdfs:range pmofn:FrameElement.
pmofn:inheritsFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:label "inherits from"@en;
                   rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broader>,
                                      pmofn:frameRelation.
pmofn:inheritsFromFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain pmofn:FrameElement;
                      rdfs:label "frame element mapping (on inheritsFrom frame relation)"@en;
                      rdfs:range pmofn:FrameElement;
                      rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:isCausativeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:label "is causative of"@en;
                    rdfs:subPropertyOf pmofn:frameRelation.
pmofn:isCausativeOfFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain pmofn:FrameElement;
                       rdfs:label "frame element mapping (on isCausativeOf frame relation)"@en;
                       rdfs:range pmofn:FrameElement;
                       rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:isInchoativeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:label "is inchoative of"@en;
                     rdfs:subPropertyOf pmofn:frameRelation.
pmofn:isInchoativeOfFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain pmofn:FrameElement;
                        rdfs:label "frame element mapping (on isInchoativeOf frame relation)"@en;
                        rdfs:range pmofn:FrameElement;
                        rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:perspectiveOn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:label "perspective on"@en;
                    rdfs:subPropertyOf pmofn:frameRelation.
pmofn:perspectiveOnFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain pmofn:FrameElement;
                       rdfs:label "frame element mapping (on perspectiveOn frame relation)"@en;
                       rdfs:range pmofn:FrameElement;
                       rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:precedes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "precedes"@en;
               rdfs:subPropertyOf pmofn:frameRelation.
pmofn:precedesFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain pmofn:FrameElement;
                  rdfs:label "frame element mapping (on precedes frame relation)"@en;
                  rdfs:range pmofn:FrameElement;
                  rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:reFrameMapping a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:label "re-frame mapping"@en;
                     rdfs:subPropertyOf pmofn:frameRelation.
pmofn:reFrameMappingFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain pmofn:FrameElement;
                        rdfs:label "frame element mapping (on reFrameMapping frame relation)"@en;
                        rdfs:range pmofn:FrameElement;
                        rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:requiresFrameElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain pmofn:FrameElement;
                           rdfs:label "requires frame element"@en;
                           rdfs:range pmofn:FrameElement;
                           rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:seeAlso a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#SymmetricProperty>;
              rdfs:label "see also"@en;
              rdfs:subPropertyOf pmofn:frameRelation.
pmofn:seeAlsoFER a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                   <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                 rdfs:domain pmofn:FrameElement;
                 rdfs:label "frame element mapping (on seeAlso frame relation)"@en;
                 rdfs:range pmofn:FrameElement;
                 rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:semType a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (pmofn:Frame
                                                                    pmofn:FrameElement
                                                                    pmofn:LexicalUnit) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "semantic type"@en;
              rdfs:range pmofn:SemType.
pmofn:status a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:domain pmofn:LexicalUnit;
             rdfs:label "status"@en;
             rdfs:range pmofn:LUStatus.
pmofn:subTypeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain pmofn:SemType;
                rdfs:label "sub-type of"@en;
                rdfs:range pmofn:SemType;
                rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broader>.
pmofn:subframeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "sub-frame of"@en;
                 rdfs:subPropertyOf pmofn:frameRelation.
pmofn:subframeOfFER a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain pmofn:FrameElement;
                    rdfs:label "frame element mapping (on subframeOf frame relation)"@en;
                    rdfs:range pmofn:FrameElement;
                    rdfs:subPropertyOf <http://premon.fbk.eu/ontology/core#roleRel>.
pmofn:uses a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:label "uses"@en;
           rdfs:subPropertyOf pmofn:frameRelation.
