isbd: dc11:title "ISBD elements"@en;
      skos:note "This is a registration of classes and properties from International Standard Bibliographic Description (ISBD), consolidated edition, published by De Gruyter Saur in July 2011 (ISBN 978-3-11-026379-4)."@en;
      foaf:homepage <http://www.ifla.org/files/assets/cataloguing/isbd/isbd-cons_20110321.pdf>.
isbd:C2001 <http://metadataregistry.org/uri/profile/RegAp/name> "Resource"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy isbd:;
           rdfs:label "Resource"@en,
                      "Recurso"@es;
           skos:definition "Una entidad, tangible o intangible, que tiene contenido artístico y/o intelectual y que está concebida, producida y/o publicada como una unidad, formando la base de una descripción bibliográfica individual."@es,
                           "An entity, tangible or intangible, that comprises intellectual and/or artistic content and is conceived, produced and/or issued as a unit, forming the basis of a single bibliographic description."@en;
           skos:scopeNote "Includes text, music, still and moving images, graphics, maps, sound recordings and video recordings, electronic data or programs, including those issued serially."@en,
                          "Incluye texto, música, imágenes fijas y en movimiento, gráficos, mapas, grabaciones sonoras y videograbaciones, programas o datos electrónicos, incluyendo aquellos editados periódicamente."@es.
