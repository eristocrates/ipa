@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pni: <http://data.press.net/ontology/identifier/>.

pni: <http://purl.org/dc/terms/created> "2012-03-21"^^xsd:date;
     <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-nd/3.0/>;
     <http://purl.org/dc/terms/modified> "2012-03-21"^^xsd:date;
     <http://purl.org/dc/terms/title> "SNaP Identifier Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "The Identifier Ontology models non-RDF based Identifiers for resources. The enables us to maintain a mapping between RDF resources identifiers and their equivalent IDs in an alternate, non-RDF based domain."@en;
     <http://www.w3.org/2002/07/owl#versionInfo> "0.3.0";
     <http://xmlns.com/foaf/0.1/maker> <http://uk.linkedin.com/in/jarredmcginnis>,
                                       <http://www.linkedin.com/pub/matt-nathan/33/44a/68a>,
                                       <http://uk.linkedin.com/in/paulwilton>,
                                       <http://uk.linkedin.com/in/pauliharman>.
pni:Authority a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The Authority for an Identifier, for example the domain or namespace within which an ID is contained"@en;
              rdfs:isDefinedBy pni:;
              rdfs:label "The Authority for an Identifier"@en;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pni:Identifiable a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An instance that is Identifiable can have an Identifier associated with it."@en;
                 rdfs:isDefinedBy pni:;
                 rdfs:label "An Identifiable resource type"@en;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pni:Identifier a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An ID for a given resource. For example a literal ID from a legacy system"@en;
               rdfs:isDefinedBy pni:;
               rdfs:label "An Identifier for a resource"@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pni:authority a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Property defining the containing authority of an Identifier"@en;
              rdfs:domain pni:Identifier;
              rdfs:isDefinedBy pni:;
              rdfs:label "Indicates the ID Authority of an Identifier"@en;
              rdfs:range pni:Authority;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pni:hasIdentifier a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Associates an Identifier to an Identifiable thing"@en;
                  rdfs:domain pni:Identifiable;
                  rdfs:isDefinedBy pni:;
                  rdfs:label "Associates an Identifier to an Identifiable thing"@en;
                  rdfs:range pni:Identifier;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pni:value a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Property indicating the literal value of the Identifier"@en;
          rdfs:domain pni:Identifier;
          rdfs:isDefinedBy pni:;
          rdfs:label "the value of the Identifier"@en;
          rdfs:range rdfs:Literal;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
<http://uk.linkedin.com/in/jarredmcginnis> a <http://xmlns.com/foaf/0.1/Person>;
                                           <http://xmlns.com/foaf/0.1/name> "Jarred McGinnis".
<http://uk.linkedin.com/in/pauliharman> a <http://xmlns.com/foaf/0.1/Person>;
                                        <http://xmlns.com/foaf/0.1/name> "Paul Harman".
<http://uk.linkedin.com/in/paulwilton> a <http://xmlns.com/foaf/0.1/Person>;
                                       <http://xmlns.com/foaf/0.1/name> "Paul Wilton".
<http://www.linkedin.com/pub/matt-nathan/33/44a/68a> a <http://xmlns.com/foaf/0.1/Person>;
                                                     <http://xmlns.com/foaf/0.1/name> "Matt Nathan".
