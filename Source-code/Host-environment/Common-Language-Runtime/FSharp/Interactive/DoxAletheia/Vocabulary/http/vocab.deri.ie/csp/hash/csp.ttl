@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix csp: <http://vocab.deri.ie/csp#>.

<http://vocab.deri.ie/csp> <http://purl.org/dc/elements/1.1/creator> csp:fpservant,
                                                                     csp:fbadra,
                                                                     csp:alepas;
                           <http://purl.org/dc/terms/created> "2011-03-09"^^xsd:date;
                           <http://purl.org/dc/terms/description> "A vocabulary to represent Constraint Satisfaction Problems (CSPs) in which constraints are expressed by Boolean expressions on fluents.</b>";
                           <http://purl.org/dc/terms/modified> "2011-06-29"^^xsd:date;
                           <http://purl.org/dc/terms/partOf> <http://vocab.deri.ie/>;
                           <http://purl.org/dc/terms/publisher> "http://vocab.deri.ie/csp#DERI%2C%20NUI%20Galway";
                           <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                           <http://purl.org/dc/terms/title> "CSP - A vocabulary to represent Constraint Satisfaction Problems.";
                           <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "csp";
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://vocab.deri.ie/csp#";
                           a <http://www.w3.org/ns/adms#SemanticAsset>,
                             <http://www.w3.org/2002/07/owl#Ontology>;
                           <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/csp.html>.
csp:And a rdfs:Class,
          <http://www.w3.org/2002/07/owl#Class>;
        rdfs:comment "Models a conjunctive logical sub-expression AND (BoolExpr1 BoolExpr2 ... BoolExprn).";
        rdfs:label "And";
        rdfs:subClassOf csp:BoolExpr.
csp:BoolExpr a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Boolean expression.";
             rdfs:label "Boolean expression".
csp:DERI%2C%20NUI%20Galway a <http://purl.org/dc/terms/Agent>;
                           <http://xmlns.com/foaf/0.1/homepage> <http://deri.ie/>;
                           <http://xmlns.com/foaf/0.1/member> csp:alepas,
                                                              csp:fbadra;
                           <http://xmlns.com/foaf/0.1/name> "DERI, NUI Galway".
csp:Fluent a rdfs:Class,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A fluent is the association of a variable name and a subset of its domain of values.";
           rdfs:label "Fluent";
           rdfs:subClassOf csp:BoolExpr.
csp:Not a rdfs:Class,
          <http://www.w3.org/2002/07/owl#Class>;
        rdfs:comment "Models the negation of a logical sub-expression NOT(BoolExpr).";
        rdfs:label "Not";
        rdfs:subClassOf csp:BoolExpr;
        <http://www.w3.org/2002/07/owl#disjointWith> csp:And,
                                                     csp:Or.
csp:Or a rdfs:Class,
         <http://www.w3.org/2002/07/owl#Class>;
       rdfs:comment "Models a disjunctive logical sub-expression OR (BoolExpr1 BoolExpr2 ... BoolExprn).";
       rdfs:label "Or";
       rdfs:subClassOf csp:BoolExpr;
       <http://www.w3.org/2002/07/owl#disjointWith> csp:And,
                                                    csp:Not.
csp:Relation a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The list of all valid combinations of values of a set of variables.";
             rdfs:label "Relation".
csp:Renault a <http://purl.org/dc/terms/Agent>;
            <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/csp>;
            <http://xmlns.com/foaf/0.1/member> csp:fpservant;
            <http://xmlns.com/foaf/0.1/name> "Renault".
csp:Solution a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A solution of the constraint satisfaction problem.";
             rdfs:label "Solution".
csp:alepas a <http://xmlns.com/foaf/0.1/Person>;
           <http://xmlns.com/foaf/0.1/homepage> <http://apassant.net/>;
           <http://xmlns.com/foaf/0.1/name> "Alexandre Passant".
csp:and a rdf:Property;
        rdfs:comment "Links a logical conjunction operator to its arguments.";
        rdfs:domain csp:And;
        rdfs:label "and";
        rdfs:range csp:BoolExpr.
csp:fbadra a <http://xmlns.com/foaf/0.1/Person>;
           <http://xmlns.com/foaf/0.1/homepage> <http://fadi.lautre.net/>;
           <http://xmlns.com/foaf/0.1/name> "Fadi Badra".
csp:fpservant a <http://xmlns.com/foaf/0.1/Person>;
              <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/csp>;
              <http://xmlns.com/foaf/0.1/mbox> <mailto:francois-paul.servant@renault.com>;
              <http://xmlns.com/foaf/0.1/name> "François-Paul Servant".
csp:isSatisfiable a rdf:Property;
                  rdfs:comment "Boolean flag indicating for a relation if each supported combination of values must be satisfiable or not.";
                  rdfs:domain csp:Relation;
                  rdfs:label "is satisfiable".
csp:not a rdf:Property;
        rdfs:comment "Links a logical negation operator to its argument.";
        rdfs:domain csp:Not;
        rdfs:label "not";
        rdfs:range csp:BoolExpr.
csp:or a rdf:Property;
       rdfs:comment "Links a logical disjunction operator to its arguments.";
       rdfs:domain csp:Or;
       rdfs:label "or";
       rdfs:range csp:BoolExpr.
csp:rdf <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/csp>;
        a <http://www.w3.org/ns/adms#SemanticDistribution>;
        <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/csp.rdf";
        <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
csp:supports a rdf:Property;
             rdfs:comment "Specifies all supported value combinations in the relation. ";
             rdfs:domain csp:Relation;
             rdfs:label "supports";
             rdfs:range rdfs:Resource.
csp:ttl <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/csp>;
        a <http://www.w3.org/ns/adms#SemanticDistribution>;
        <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/csp.ttl";
        <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
csp:val a rdf:Property;
        rdfs:comment "A value associated with a fluent.";
        rdfs:domain csp:Fluent;
        rdfs:label "has value";
        rdfs:range rdfs:Resource.
csp:var a rdf:Property;
        rdfs:comment "The variable associated with a fluent.";
        rdfs:domain csp:Fluent;
        rdfs:label "has variable";
        rdfs:range rdfs:Resource.
csp:variable a rdf:Property;
             rdfs:comment "A variable can be seen as a function associating a value to an object, and is therefore modelled as an RDF property that points to one (or many) value(s).";
             rdfs:domain csp:Solution;
             rdfs:label "variable";
             rdfs:range rdfs:Resource.
