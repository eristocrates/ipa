@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix orges: <http://datos.gob.es/def/sector-publico/organizacion#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix esadm: <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

orges: dc11:contributor [foaf:name "José M. Subero" ; 
                         foaf:mbox "soyjosem@hotmail.com"],
                        [foaf:name "David Rey Jordán" ; 
                         foaf:mbox "dreyjor@admon.upo.es"],
                        [foaf:name "Antonio Ibáñez" ; 
                         foaf:mbox "IbaPasAn@jcyl.es"],
                        [foaf:name "Martín Álvarez" ; 
                         foaf:mbox "martin@w3.org"],
                        [foaf:name "María Jesús Fernández" ; 
                         foaf:mbox "mjferuiz@zaragoza.es"],
                        [foaf:name "Toño Velasco"],
                        [foaf:name "Imanol Argüeso" ; 
                         foaf:mbox "i-argueso@ej-gv.es"],
                        [foaf:name "José Manuel Crespo" ; 
                         foaf:mbox "josemanuel.crespo@fundacionctic.org"],
                        [foaf:name "Asuncion Gomez-Perez" ; 
                         foaf:mbox "asun@fi.upm.es"],
                        [foaf:name "Mª Dolores Hernández" ; 
                         foaf:mbox "mdolores.hernandez@seap.minhap.es"],
                        [foaf:name "Carlos Jimenez" ; 
                         foaf:mbox "c.jimenez@estratic.com"],
                        [foaf:name "Óscar Corcho" ; 
                         foaf:mbox "ocorcho@fi.upm.es"];
       dc11:creator "Red.es",
                    "Ministerio de Hacienda y Administraciones Públicas",
                    "Ministerio de Industria, Energía y Turismo";
       dc11:rights "Creative Commons 3.0 (BY-NC-SA)";
       dc11:title "Ontología sobre organizaciones públicas en España"@es;
       dcterms:date "2015-02-19";
       dcterms:hasFormat <http://datos.gob.es/def/sector-publico/organizacion.rdf>,
                         <http://datos.gob.es/def/sector-publico/organizacion.html>;
       dcterms:issued "2015-02-19";
       vann:preferredNamespacePrefix "orges";
       vann:preferredNamespaceUri "http://datos.gob.es/def/sector-publico/organizacion#";
       a owl:Ontology;
       rdfs:comment "Extensión de la ontología de Organizaciones para adecuarla al Directorio Común de entidades públicas en España."@es;
       owl:imports <http://www.w3.org/2004/02/skos/core>,
                   vann:,
                   <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio>,
                   org:;
       owl:versionIRI orges:1.0.0.
orges:EntidadDerechoPublico dcterms:issued "2015-19-02";
                            a owl:Class;
                            rdfs:comment """Organismo creado para satisfacer necesidades de interés general, excluidos los de carácter mercantil o industrial; que tenga personalidad jurídica; que su actividad se financie mayoritariamente con fondos públicos o que su gestión esté sometida al control público o bien que más de la mitad de los miembros de su órgano de administración, de dirección o vigilancia, sean nombrados por el sector público.
Morales, F. J. (2007). La Contratación del Sector Público. Recuperado el 17 de febrero de 2015, de https://books.google.es/books?id=RozAMdGDMDIC&pg=PA1&lpg=PA1&dq=la+contratación+del+sector+publico+f.+javier+escrihuela"""@es;
                            rdfs:label "Entidad de Derecho Público"@es;
                            rdfs:subClassOf orges:UnidadOrganicaNoRaiz,
                                            org:FormalOrganization.
orges:Oficina dcterms:issued "2015-19-02";
              a owl:Class;
              rdfs:comment "Oficina de registro, información o tramitación que las distintas Administraciones Públicas ponen a disposición del Ciudadano."@es;
              rdfs:label "Oficina"@es;
              rdfs:subClassOf org:OrganizationalUnit.
orges:UGEP dcterms:issued "2015-02-19";
           a owl:Class;
           rdfs:comment "Las UGEP son las unidades de rango inferior o independiente que queden excluidas del ámbito de una «org:FormalUnit."@es;
           rdfs:label "Unidad con función de Gestión Económica-Presupuestaria"@es;
           rdfs:subClassOf org:OrganizationalUnit.
orges:UnidadOrganicaNoRaiz dcterms:issued "2015-19-02";
                           a owl:Class;
                           rdfs:comment "Unidad Orgánica con un nivel jerárquico mayor a 1, que depende de una Unidad Orgánica Raíz."@es;
                           rdfs:label "Unidad Orgánica No Raíz"@es;
                           rdfs:subClassOf org:OrganizationalUnit.
orges:ambitoCompetencias dcterms:issued "2015-02-19";
                         a owl:ObjectProperty;
                         rdfs:comment "Ámbito territorial de ejercicio de competencias de una organización."@es;
                         rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                                   org:FormalOrganization) ; 
                                      a owl:Class];
                         rdfs:isDefinedBy orges:;
                         rdfs:label "Ámbito de Competencias"@es;
                         rdfs:range [owl:unionOf (esadm:Autonomia
                                                  esadm:EntidadSingular
                                                  esadm:Municipio
                                                  esadm:Pais
                                                  esadm:Provincia
                                                  [owl:unionOf ([owl:onProperty skos:inScheme ; 
                                                               owl:hasValue <http://datos.gob.es/kos/sector-publico/AmbitoTerritorialCompetencias> ; 
                                                               a owl:Restriction]
                                                               [owl:onProperty skos:inScheme ; 
                                                               owl:hasValue <http://datos.gob.es/kos/sector-publico/EntidadGeografica> ; 
                                                               a owl:Restriction]) ; 
                                                  a owl:Class]) ; 
                                     a owl:Class].
orges:diasInhabiles dcterms:issued "2015-02-19";
                    a owl:DatatypeProperty;
                    rdfs:comment """Designa los días inhábiles.
Los días inhábiles se tratan como una frase en lenguaje natural. Ejemplo: «Domingos y festivos de ámbito nacional, autonómico o local.»."""@es;
                    rdfs:domain orges:Oficina;
                    rdfs:isDefinedBy orges:;
                    rdfs:label "Días Inhábiles"@es;
                    rdfs:range rdfs:Literal.
orges:disposicionLegal dcterms:issued "2015-02-19";
                       a owl:DatatypeProperty;
                       rdfs:comment """Identificación de la Disposición Legal que regula las competencias de la organización.
Ejemplo: En el caso del BOE se haría referencia al RD de creación del Organismo como Agencia Estatal: «REAL DECRETO 1495/2007 por el que se crea la Agencia Estatal Boletín Oficial del Estado y se aprueba su estatuto»."""@es;
                       rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                                 org:FormalOrganization) ; 
                                    a owl:Class];
                       rdfs:isDefinedBy orges:;
                       rdfs:label "Disposición Legal"@es;
                       rdfs:range rdfs:Literal.
orges:estado dcterms:issued "2015-02-19";
             a owl:ObjectProperty;
             rdfs:comment "Estatus o situación jurídico/funcional de una organización."@es;
             rdfs:domain org:Organization;
             rdfs:isDefinedBy orges:;
             rdfs:label "Estado"@es;
             rdfs:range [owl:onProperty skos:inScheme ; 
                         owl:hasValue <http://datos.gob.es/kos/sector-publico/Estado> ; 
                         a owl:Restriction].
orges:horarioAtencion dcterms:issued "2015-02-19";
                      a owl:DatatypeProperty;
                      rdfs:comment """Define el horario de atención al ciudadano de la organización.
El horario de atención se trata como una frase en lenguaje natural. Ejemplo: «Horario: De lunes a viernes de 8:30 a 14:30h. y de 16:10 a 18:30h. Sábados de 9:10 a 13:30. Horario de verano: … »."""@es;
                      rdfs:domain orges:Oficina;
                      rdfs:isDefinedBy orges:;
                      rdfs:label "Horario de Atención"@es;
                      rdfs:range rdfs:Literal.
orges:identificadorExterno dcterms:issued "2015-02-19";
                           a owl:DatatypeProperty;
                           rdfs:comment "Código externo que designa una organización según la codificación propia de la fuente de provisión."@es;
                           rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                                     org:FormalOrganization) ; 
                                        a owl:Class];
                           rdfs:isDefinedBy orges:;
                           rdfs:label "IdentificadorExterno"@es;
                           rdfs:range rdfs:Literal;
                           rdfs:subPropertyOf dcterms:identifier.
orges:nivelAdministracion dcterms:issued "2015-02-19";
                          a owl:ObjectProperty;
                          rdfs:comment "Nivel territorial de administración al que pertenece la organización, según el artículo 2.1 de la Ley 30/1992."@es;
                          rdfs:domain org:Organization;
                          rdfs:isDefinedBy orges:;
                          rdfs:label "Nivel de Administración"@es;
                          rdfs:range [owl:onProperty skos:inScheme ; 
                                      owl:hasValue <http://datos.gob.es/kos/sector-publico/NivelAdministracion> ; 
                                      a owl:Restriction].
orges:nivelJerarquico dcterms:issued "2015-02-19";
                      a owl:DatatypeProperty;
                      rdfs:comment """Secuencial que identifica el nivel jerárquico relativo de la organización dentro de la entidad a la que pertenece.
Para la raíz de un nivel de administración, este campo deberá ser 0. Para la unidad principal (de máximo nivel) de cualquier Ministerio, Comunidad Autónoma o Entidad Local el campo tomará el valor 1. Más allá de esto, el número se irá incrementando según convenga."""@es;
                      rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                                org:FormalOrganization) ; 
                                   a owl:Class];
                      rdfs:isDefinedBy orges:;
                      rdfs:label "Nivel Jerárquico"@es;
                      rdfs:range xsd:integer.
orges:observacionBaja dcterms:issued "2015-02-19";
                      a owl:DatatypeProperty;
                      rdfs:comment "Observaciones relacionadas con la baja de la organización."@es;
                      rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                                org:FormalOrganization) ; 
                                   a owl:Class];
                      rdfs:isDefinedBy orges:;
                      rdfs:label "Observación de Baja"@es;
                      rdfs:range rdfs:Literal.
orges:otroContacto dcterms:issued "2015-02-19";
                   a owl:DatatypeProperty;
                   rdfs:comment "Cualquier dato de contacto adicional que no se encuentre definido en el DIR3."@es;
                   rdfs:isDefinedBy orges:;
                   rdfs:label "Otro Contacto"@es.
orges:servicio dcterms:issued "2015-02-19";
               a owl:ObjectProperty;
               rdfs:comment "Servicios que puede prestar una determinada oficina."@es;
               rdfs:domain orges:Oficina;
               rdfs:isDefinedBy orges:;
               rdfs:label "Servicio"@es;
               rdfs:range [owl:onProperty skos:inScheme ; 
                           owl:hasValue <http://datos.gob.es/kos/sector-publico/ServicioOficina> ; 
                           a owl:Restriction].
orges:tieneUORaiz dcterms:issued "2015-02-19";
                  a owl:ObjectProperty;
                  rdfs:comment "Organización, al nivel máximo de jerarquía de que depende otra organización."@es;
                  rdfs:domain [owl:unionOf (orges:UnidadOrganicaNoRaiz
                                            org:FormalOrganization) ; 
                               a owl:Class];
                  rdfs:isDefinedBy orges:;
                  rdfs:label "Tiene Unidad Orgánica Raíz"@es;
                  rdfs:range org:FormalOrganization.
