@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix limo: <http://purl.org/limo-ontology/limo#>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.

<http://purl.org/dc/terms#description> a rdf:Property;
                                       rdfs:comment "A small text to describe what the variable or model is about.";
                                       rdfs:domain limo:Model,
                                                   limo:Variable;
                                       rdfs:label "dct:description";
                                       rdfs:range rdfs:Literal.
<http://purl.org/dc/terms#issued> a rdf:Property;
                                  rdfs:comment "Defines the actual date that the model has been created.";
                                  rdfs:domain limo:Model;
                                  rdfs:label "dct:issued".
<http://purl.org/dc/terms#title> a rdf:Property;
                                 rdfs:comment "A name given to the variable or model.",
                                              "A name given to the model.";
                                 rdfs:domain limo:Variable,
                                             limo:Model;
                                 rdfs:label "dct:title";
                                 rdfs:range rdfs:Literal.
limo:File a owl:Class,
            rdfs:Class;
          rdfs:comment "Describes a file that can be imported in a particular platform such as R or SAS and execute the model. This could also be a PMML-XML file.";
          rdfs:label "limo:File".
limo:Information%20Systems%20Lab%20%28ISLab%29 a <http://purl.org/dc/terms#Agent>;
                                               <http://xmlns.com/foaf/0.1#homepage> <http://islab.uom.gr/>;
                                               <http://xmlns.com/foaf/0.1#member> limo:tambouris,
                                                                                  limo:kat,
                                                                                  limo:ekal,
                                                                                  limo:akarm;
                                               <http://xmlns.com/foaf/0.1#name> "Information Systems Lab (ISLab)".
limo:Method a owl:Class,
              rdfs:Class;
            rdfs:comment "Describes a statistical or data mining method used for creating a model. We assume that this class uses a set of predefined concepts such as linear regression, logistic regression, markov models, support vector machine, random forest, neural networks etc.";
            rdfs:label "limo:Method";
            rdfs:subClassOf skos:Concept.
limo:Model a owl:Class,
             rdfs:Class;
           rdfs:comment "The actual predictive model that is described by the vocabulary.";
           rdfs:label "limo:Model".
limo:Power a owl:Class,
             rdfs:Class;
           rdfs:comment "Describes the predictive power of a model.";
           rdfs:label "limo:Power".
limo:Variable a owl:Class,
                rdfs:Class;
              rdfs:comment "Represents the variables that are included in the predictive model.";
              rdfs:label "limo:Variable".
limo:accessURL a rdf:Property;
               rdfs:comment "The URL that the file can be accessed from.";
               rdfs:domain limo:File;
               rdfs:label "limo:accessURL".
limo:akarm a <http://xmlns.com/foaf/0.1#Person>;
           <http://xmlns.com/foaf/0.1#homepage> "";
           <http://xmlns.com/foaf/0.1#mbox> <mailto:akarm@uom.gr>;
           <http://xmlns.com/foaf/0.1#name> "Areti Karamanou".
limo:baseline a rdf:Property;
              rdfs:comment "Explicitly denotes that the predictive power of a model has been evaluated against the power of another model.";
              rdfs:domain limo:Model;
              rdfs:label "limo:baseline";
              rdfs:range limo:Model.
limo:creator a rdf:Property;
             rdfs:comment "The person or organization that actually builds the model.";
             rdfs:domain limo:Model;
             rdfs:label "dct:creator";
             rdfs:range foaf:Agent.
limo:data a rdf:Property;
          rdfs:comment "Connects a model to the dataset that contains the actual data that have been used for the development of the model.";
          rdfs:domain <http://purl.org/limo-ontology/limo/limo#Model>;
          rdfs:label "limo:data";
          rdfs:range qb:Dataset.
limo:ekal a <http://xmlns.com/foaf/0.1#Person>;
          <http://xmlns.com/foaf/0.1#homepage> "";
          <http://xmlns.com/foaf/0.1#mbox> <mailto:ekal@uom.gr>;
          <http://xmlns.com/foaf/0.1#name> "Evangelos Kalampokis".
limo:evaluationData a rdf:Property;
                    rdfs:comment "Connects a model to the dataset that represents its evaluation data.";
                    rdfs:label "limo:evaluationData";
                    rdfs:subPropertyOf limo:data.
limo:evaluationMethod a rdf:Property;
                      rdfs:comment "Is used to infer the predictive power of the model. The evaluation methods include out-of-sample evaluation with statistics such as Predicted Residual Sums of Squares, Root Mean Square Error or cross-validation techniques.",
                                   "mpla mpla";
                      rdfs:domain limo:Power;
                      rdfs:label "limo:evaluationMethod".
limo:file a rdf:Property;
          rdfs:comment "Connects a model with a relative file.";
          rdfs:domain limo:Model;
          rdfs:label "limo:file";
          rdfs:range limo:File.
limo:kat a <http://xmlns.com/foaf/0.1#Person>;
         <http://xmlns.com/foaf/0.1#homepage> "";
         <http://xmlns.com/foaf/0.1#mbox> <mailto:kat@uom.gr>;
         <http://xmlns.com/foaf/0.1#name> "Konstantinos Tarabanis".
limo:method a rdf:Property;
            rdfs:comment "Connects a model with its statistical or data mining method.";
            rdfs:domain limo:Model;
            rdfs:label "limo:method";
            rdfs:range limo:Method.
limo:modelType a rdf:Property;
               rdfs:comment "Describes the main categories of the model that can be developed, namely classification, regression, clustering and dimension reduction.";
               rdfs:domain limo:Model;
               rdfs:label "limo:modelType".
limo:outcome a rdf:Property;
             rdfs:comment "The actual value that the evaluation method produces.",
                          "";
             rdfs:domain limo:Power;
             rdfs:label "limo:outcome".
limo:power a rdf:Property;
           rdfs:comment "Connects a model to its predictive power.";
           rdfs:domain limo:Model;
           rdfs:label "limo:power";
           rdfs:range limo:Power.
limo:publishedIn a rdf:Property;
                 rdfs:comment "Connects a model with the bibliographic resource it is published.";
                 rdfs:domain limo:Model;
                 rdfs:label "limo:publishedIn";
                 rdfs:range <http://purl.org/dc/terms#BibliographicResource>.
limo:rawData a rdf:Property;
             rdfs:comment "Connects a model with it's dataset.";
             rdfs:domain limo:Model;
             rdfs:label "limo:rawData";
             rdfs:range <http://purl.org/dc/dcmitype#Dataset>.
limo:rdf <http://purl.org/dc/terms#FileFormat> "".
limo:spatial a rdf:Property;
             rdfs:comment "Dexcribes the spatial dimension of the model. The spatial dimension is derived from the actual data that has been employed.";
             rdfs:domain limo:Model;
             rdfs:label "limo:spatial";
             rdfs:range <http://purl.org/dc/terms#Location>.
limo:tambouris a <http://xmlns.com/foaf/0.1#Person>;
               <http://xmlns.com/foaf/0.1#homepage> "";
               <http://xmlns.com/foaf/0.1#mbox> <mailto:tambouris@uom.gr>;
               <http://xmlns.com/foaf/0.1#name> "Eythimios Tambouris".
limo:temporal a rdf:Property;
              rdfs:comment "Describes the time period that the model covers. The time period reflects the period that is described in the actual data that have been used for the development of the model.";
              rdfs:domain limo:Model;
              rdfs:label "limo:temporal";
              rdfs:range <http://purl.org/dc/terms#PeriodOfTime>.
limo:theme a rdf:Property;
           rdfs:comment "Connects a variable to its concept theme.";
           rdfs:domain limo:Variable;
           rdfs:label "limo:theme";
           rdfs:range skos:Concept.
limo:trainingData a rdf:Property;
                  rdfs:comment "Connects a model to a qb:DataSet that represents data that was used for the training of the model.";
                  rdfs:label "limo:trainingData";
                  rdfs:subPropertyOf limo:data.
limo:ttl <http://purl.org/dc/terms#FileFormat> "".
limo:usageType a rdf:Property;
               rdfs:comment "Denotes whether the variable is the response of the model or one of the predictors.";
               rdfs:domain limo:Variable;
               rdfs:label "limo:usageType".
limo:validationData a rdf:Property;
                    rdfs:comment "Connects a model to a qb:DataSet that represents data that was used for the validation of the model.";
                    rdfs:label "limo:validationData";
                    rdfs:subPropertyOf limo:data.
limo:variable a rdf:Property;
              rdfs:comment "Connects a model to one of its variables.";
              rdfs:domain limo:Model;
              rdfs:label "limo:variable";
              rdfs:range limo:Variable.
limo:variableType a rdf:Property;
                  rdfs:comment "Denotes whether the variable is continuous, categorical or ordinal.";
                  rdfs:domain limo:Variable;
                  rdfs:label "limo:variableType".
<http://purl.org/limo-ontology/limo/> <http://purl.org/dc/elements/1.1#creator> limo:akarm,
                                                                                limo:ekal,
                                                                                limo:kat,
                                                                                limo:tambouris;
                                      <http://purl.org/dc/terms#created> "2013-09-23"^^xsd:date;
                                      <http://purl.org/dc/terms#description> "This document introduces an RDF vocabulary that enables the publishing of descriptions of predictive models into the Linked Data Web and establishes links to other resources such as datasets, other models, academic articles and studies. This is an early draft. Feedback and discussion are welcomed.";
                                      <http://purl.org/dc/terms#modified> "2013-09-23"^^xsd:date;
                                      <http://purl.org/dc/terms#partOf> <http://195.251.218.39:8181/vocab>;
                                      <http://purl.org/dc/terms#publisher> "http://purl.org/limo-ontology/limo/limo#Information%20Systems%20Lab%20%28ISLab%29";
                                      <http://purl.org/dc/terms#status> <http://purl.org/adms/status/UnderDevelopment>;
                                      <http://purl.org/dc/terms#title> "Linked Statistical Models Vocabulary (limo)";
                                      <http://purl.org/dc/terms#type> <http://purl.org/adms/assettype/Ontology>;
                                      <http://purl.org/vocab/vann#preferredNamespacePrefix> "limo";
                                      <http://purl.org/vocab/vann#preferredNamespaceUri> "http://purl.org/limo-ontology/limo#";
                                      a owl:Ontology;
                                      <http://xmlns.com/foaf/0.1#homepage> <http://purl.org/limo-ontology/limo/limo.html>.
skos:Concept a rdfs:Class.
