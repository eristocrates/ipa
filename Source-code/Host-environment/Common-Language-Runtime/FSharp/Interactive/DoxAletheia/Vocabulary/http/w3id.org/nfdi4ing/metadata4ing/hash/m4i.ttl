                                      rdfs:domain <https://ptb.de/si/ExpandedUnc>;
                                      rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minInclusive 1.0]) ; 
                                                  <http://www.w3.org/2002/07/owl#onDatatype> xsd:decimal ; 
