                                            <http://www.w3.org/2004/02/skos/core#prefLabel> "hat Teilnehmer"@de,
                                                                                            "has participant"@en.
<http://purl.obolibrary.org/obo/RO_0002090> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
