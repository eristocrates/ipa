@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix osgeom: <http://data.ordnancesurvey.co.uk/ontology/geometry/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix admingeo: <http://data.ordnancesurvey.co.uk/ontology/admingeo/>.
@prefix spacerel: <http://data.ordnancesurvey.co.uk/ontology/spatialrelations/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

_:B09401efe9ede034863228804e1af3c9b a owl:AllDisjointClasses;
                                    owl:members (admingeo:GreaterLondonAuthorityAssemblyConstituency
                                                 admingeo:ScottishParliamentConstituency
                                                 admingeo:WelshAssemblyConstituency
                                                 admingeo:WestminsterConstituency).
_:B725e42cc616fa610878d094407a2b64b a owl:AllDisjointClasses;
                                    owl:members (admingeo:CivilParish
                                                 admingeo:Community
                                                 admingeo:County
                                                 admingeo:District
                                                 admingeo:GreaterLondonAuthority
                                                 admingeo:LondonBorough
                                                 admingeo:MetropolitanDistrict
                                                 admingeo:UnitaryAuthority).
_:B9850e870752c9774288a6ee8a4a76769 a owl:AllDisjointClasses;
                                    owl:members (admingeo:Constituency
                                                 admingeo:CountyElectoralDivision
                                                 admingeo:ScottishParliamentElectoralRegion
                                                 admingeo:UnitaryAuthorityElectoralDivision
                                                 admingeo:Ward
                                                 admingeo:WelshAssemblyElectoralRegion).
_:Be6f63f76fd8eb0fa011ef743d13b7fee a owl:AllDisjointClasses;
                                    owl:members (admingeo:DistrictWard
                                                 admingeo:LondonBoroughWard
                                                 admingeo:MetropolitanDistrictWard
                                                 admingeo:UnitaryAuthorityWard).
ccrel:license a owl:AnnotationProperty.
admingeo: dc11:creator "Ordnance Survey"@en;
          a owl:NamedIndividual,
            owl:Thing,
            owl:Ontology;
          rdfs:comment "An ontology describing the administrative and voting area geography of Great Britain"@en;
          rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
          rdfs:label "The administrative geography and civil voting area ontology"@en;
          owl:imports spacerel:,
                      osgeom:.
admingeo:Borough a owl:Class;
                 rdfs:comment "Borough"@en;
                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>.
admingeo:CivilAdministrativeArea a owl:Class;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "Civil Administrative Area";
                                 rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onClass admingeo:EuropeanRegion ; 
                                                  owl:onProperty admingeo:inEuropeanRegion ; 
                                                  a owl:Restriction],
                                                 [owl:someValuesFrom osgeom:AbstractGeometry ; 
                                                  owl:onProperty osgeom:extent ; 
                                                  a owl:Restriction],
                                                 owl:Thing;
                                 owl:disjointWith admingeo:CivilVotingArea.
admingeo:CivilParish a owl:Class;
                     rdfs:comment "Parishes are subdivisions of local authorities in many parts of England, and their councils are the most local level of government. Unlike electoral wards/divisions however, parishes are not found in all parts of England. The Welsh equivalents are communities. Note that the full term for administrative parishes is &apos;civil parishes&apos;, to distinguish them from the ecclesiastical parishes which are found in all parts of the UK."@en;
                     rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                     rdfs:label "Civil Parish"@en;
                     rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty skos:notation ; 
                                      a owl:Restriction],
                                     [owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onClass admingeo:County ; 
                                      owl:onProperty admingeo:inCounty ; 
                                      a owl:Restriction],
                                     [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onClass [owl:unionOf (admingeo:District
                                                                admingeo:MetropolitanDistrict
                                                                admingeo:UnitaryAuthority) ; 
                                                   a owl:Class] ; 
                                      owl:onProperty admingeo:inDistrict ; 
                                      a owl:Restriction],
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty admingeo:hasCensusCode ; 
                                      a owl:Restriction],
                                     admingeo:CivilAdministrativeArea,
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty admingeo:hasAreaCode ; 
                                      a owl:Restriction],
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty skos:prefLabel ; 
                                      a owl:Restriction],
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty admingeo:hasUnitID ; 
                                      a owl:Restriction].
admingeo:CivilVotingArea a owl:Class;
                         rdfs:label "Civil Voting Area";
                         rdfs:subClassOf [owl:someValuesFrom osgeom:AbstractGeometry ; 
                                          owl:onProperty osgeom:extent ; 
                                          a owl:Restriction],
                                         [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onClass admingeo:EuropeanRegion ; 
                                          owl:onProperty admingeo:inEuropeanRegion ; 
                                          a owl:Restriction].
admingeo:Community a owl:Class;
                   rdfs:comment "The Welsh equivalent of Civil Parish."@en;
                   rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                   rdfs:label "Community"@en;
                   rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty admingeo:hasCensusCode ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:string ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty admingeo:hasAreaCode ; 
                                    a owl:Restriction],
                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty skos:notation ; 
                                    a owl:Restriction],
                                   admingeo:CivilAdministrativeArea,
                                   [owl:onDataRange xsd:string ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty admingeo:hasUnitID ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:string ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty skos:prefLabel ; 
                                    a owl:Restriction],
                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass admingeo:UnitaryAuthority ; 
                                    owl:onProperty admingeo:inDistrict ; 
                                    a owl:Restriction].
admingeo:Constituency a owl:Class;
                      rdfs:comment "Constituencies are used to elect members to legislatures.";
                      rdfs:label "Constituency";
                      rdfs:subClassOf admingeo:CivilVotingArea.
admingeo:County a owl:Class;
                rdfs:comment "Counties were formerly administrative units across the whole UK. Due to various administrative restructurings however then the only administrative areas still referred to as counties are the non-metropolitan (shire) counties of England. The English metropolitan counties, although no longer administrative units, are also used for statistical purposes."@en;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                rdfs:label "County"@en;
                rdfs:subClassOf admingeo:CivilAdministrativeArea,
                                [owl:onDataRange xsd:string ; 
                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty skos:altLabel ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:string ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty skos:prefLabel ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:string ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty admingeo:hasAreaCode ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:string ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty admingeo:hasUnitID ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:string ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty admingeo:hasCensusCode ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty skos:notation ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom admingeo:District ; 
                                 owl:onProperty admingeo:district ; 
                                 a owl:Restriction].
admingeo:CountyElectoralDivision a owl:Class;
                                 rdfs:comment "Apart from the special cases of the Isles of Scilly and the Greater London Authority (GLA), the English county councils are the only type of local authority in the UK which does not use standard electoral wards/divisions for electing councillors. Instead they use their own larger units, which are confusingly also termed electoral divisions. These county electoral divisions must be confined within district boundaries, but need not be based on whole electoral wards. Like electoral wards/divisions, county electoral divisions are defined by the Boundary Committee for England (BCFE)."@en;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "County Electoral Division"@en;
                                 rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty admingeo:hasUnitID ; 
                                                  a owl:Restriction],
                                                 [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty admingeo:hasAreaCode ; 
                                                  a owl:Restriction],
                                                 [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty skos:prefLabel ; 
                                                  a owl:Restriction],
                                                 [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onClass admingeo:County ; 
                                                  owl:onProperty admingeo:inCounty ; 
                                                  a owl:Restriction],
                                                 admingeo:CivilVotingArea.
admingeo:District a owl:Class;
                  rdfs:comment "Districts are local administrative units and have at various times been used in all four countries of the UK. The only current references to districts however are found in metropolitan and non-metropolitan districts in England, and district council areas in Northern Ireland."@en;
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                  rdfs:label "District"@en;
                  rdfs:subClassOf admingeo:CivilAdministrativeArea,
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty admingeo:hasCensusCode ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty admingeo:hasUnitID ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty rdfs:label ; 
                                   a owl:Restriction],
                                  [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onClass admingeo:County ; 
                                   owl:onProperty admingeo:inCounty ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty skos:altLabel ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom admingeo:DistrictWard ; 
                                   owl:onProperty admingeo:ward ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty admingeo:hasAreaCode ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty skos:prefLabel ; 
                                   a owl:Restriction].
admingeo:DistrictWard a owl:Class;
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                      rdfs:label "District Ward"@en;
                      rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty skos:notation ; 
                                       a owl:Restriction],
                                      [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onClass admingeo:County ; 
                                       owl:onProperty admingeo:inCounty ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom admingeo:District ; 
                                       owl:onProperty admingeo:inDistrict ; 
                                       a owl:Restriction],
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty admingeo:hasCensusCode ; 
                                       a owl:Restriction],
                                      admingeo:Ward,
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty skos:prefLabel ; 
                                       a owl:Restriction],
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty admingeo:hasAreaCode ; 
                                       a owl:Restriction],
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty admingeo:hasUnitID ; 
                                       a owl:Restriction].
admingeo:EuropeanRegion a owl:Class;
                        rdfs:comment "European Regions correspond to Scotland, Wales and the nine Government Office Regions of England. The nine Government Office Regions (GORs) are the primary statistical subdivisions of England and also the areas in which the Government Offices for the Regions fulfil their role. Each GOR covers a number of local authorities.";
                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                        rdfs:label "European Region";
                        rdfs:subClassOf [owl:someValuesFrom admingeo:WestminsterConstituency ; 
                                         owl:onProperty admingeo:westminsterConstituency ; 
                                         a owl:Restriction],
                                        owl:Thing,
                                        [owl:someValuesFrom osgeom:AbstractGeometry ; 
                                         owl:onProperty osgeom:extent ; 
                                         a owl:Restriction],
                                        [owl:onDataRange xsd:string ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty admingeo:hasAreaCode ; 
                                         a owl:Restriction],
                                        [owl:onDataRange xsd:string ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty admingeo:hasUnitID ; 
                                         a owl:Restriction],
                                        [owl:onDataRange xsd:string ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty skos:prefLabel ; 
                                         a owl:Restriction].
admingeo:GreaterLondonAuthority a owl:Class;
                                rdfs:comment "The area covered by the Greater London Authority (GLA). The GLA is the body responsible for strategic citywide government for London, and consists of the Mayor of London and the London Assembly. The remit of the GLA covers the Greater London area."@en;
                                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                rdfs:label "Greater London Authority"@en;
                                rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty skos:prefLabel ; 
                                                 a owl:Restriction],
                                                [owl:someValuesFrom admingeo:LondonBorough ; 
                                                 owl:onProperty admingeo:district ; 
                                                 a owl:Restriction],
                                                admingeo:CivilAdministrativeArea,
                                                [owl:onDataRange xsd:string ; 
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty admingeo:hasAreaCode ; 
                                                 a owl:Restriction],
                                                [owl:someValuesFrom admingeo:GreaterLondonAuthorityAssemblyConstituency ; 
                                                 owl:onProperty admingeo:constituency ; 
                                                 a owl:Restriction],
                                                [owl:onDataRange xsd:string ; 
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty admingeo:hasUnitID ; 
                                                 a owl:Restriction],
                                                [owl:onDataRange xsd:string ; 
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty admingeo:hasCensusCode ; 
                                                 a owl:Restriction],
                                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty skos:notation ; 
                                                 a owl:Restriction],
                                                [owl:onDataRange xsd:string ; 
                                                 owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty skos:altLabel ; 
                                                 a owl:Restriction].
admingeo:GreaterLondonAuthorityAssemblyConstituency a owl:Class;
                                                    rdfs:comment "Greater London Authority (GLA) Assembly constituencies are used to elect members to the London Assembly, which is part of the GLA."@en;
                                                    rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                                    rdfs:label "Greater London Authority Assembly Constituency"@en;
                                                    rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty admingeo:hasUnitID ; 
                                                                     a owl:Restriction],
                                                                    [owl:onDataRange xsd:string ; 
                                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty admingeo:hasAreaCode ; 
                                                                     a owl:Restriction],
                                                                    [owl:onDataRange xsd:string ; 
                                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onProperty skos:prefLabel ; 
                                                                     a owl:Restriction],
                                                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                     owl:onClass admingeo:GreaterLondonAuthority ; 
                                                                     owl:onProperty admingeo:inRegion ; 
                                                                     a owl:Restriction],
                                                                    admingeo:Constituency.
admingeo:LondonBorough a owl:Class;
                       rdfs:comment "The London boroughs are the local government areas within Greater London. The borough councils are unitary administrations with a status similar to metropolitan districts, but will also be affected by any policies implemented by the Greater London Authority (GLA).";
                       rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                       rdfs:label "London Borough"@en;
                       rdfs:subClassOf [owl:someValuesFrom admingeo:LondonBoroughWard ; 
                                        owl:onProperty admingeo:ward ; 
                                        a owl:Restriction],
                                       admingeo:CivilAdministrativeArea,
                                       [owl:onDataRange xsd:string ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty admingeo:hasUnitID ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty admingeo:hasCensusCode ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty admingeo:hasAreaCode ; 
                                        a owl:Restriction],
                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onClass admingeo:GreaterLondonAuthority ; 
                                        owl:onProperty admingeo:inCounty ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty skos:altLabel ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty skos:prefLabel ; 
                                        a owl:Restriction],
                                       [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty skos:notation ; 
                                        a owl:Restriction].
admingeo:LondonBoroughWard a owl:Class;
                           rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                           rdfs:label "London Borough Ward"@en;
                           rdfs:subClassOf admingeo:Ward,
                                           [owl:onDataRange xsd:string ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty admingeo:hasAreaCode ; 
                                            a owl:Restriction],
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass admingeo:GreaterLondonAuthority ; 
                                            owl:onProperty admingeo:inCounty ; 
                                            a owl:Restriction],
                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty skos:notation ; 
                                            a owl:Restriction],
                                           [owl:onDataRange xsd:string ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty admingeo:hasCensusCode ; 
                                            a owl:Restriction],
                                           [owl:onDataRange xsd:string ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty admingeo:hasUnitID ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom admingeo:LondonBorough ; 
                                            owl:onProperty admingeo:inDistrict ; 
                                            a owl:Restriction],
                                           [owl:onDataRange xsd:string ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty skos:prefLabel ; 
                                            a owl:Restriction].
admingeo:MetropolitanDistrict a owl:Class;
                              rdfs:comment "Metropolitan districts are subdivisions of the 6 metropolitan county areas of England. Since the abolition of the metropolitan county councils in 1986 the metropolitan district councils have been unitary administrations."@en;
                              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                              rdfs:label "Metropolitan District"@en;
                              rdfs:subClassOf [owl:someValuesFrom admingeo:MetropolitanDistrictWard ; 
                                               owl:onProperty admingeo:ward ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasAreaCode ; 
                                               a owl:Restriction],
                                              admingeo:CivilAdministrativeArea,
                                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty skos:notation ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasCensusCode ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty skos:altLabel ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty skos:prefLabel ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasUnitID ; 
                                               a owl:Restriction].
admingeo:MetropolitanDistrictWard a owl:Class;
                                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                  rdfs:label "Metropolitan District Ward"@en;
                                  rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty skos:notation ; 
                                                   a owl:Restriction],
                                                  [owl:onDataRange xsd:string ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty admingeo:hasAreaCode ; 
                                                   a owl:Restriction],
                                                  [owl:onDataRange xsd:string ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty skos:prefLabel ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom admingeo:MetropolitanDistrict ; 
                                                   owl:onProperty admingeo:inDistrict ; 
                                                   a owl:Restriction],
                                                  [owl:onDataRange xsd:string ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty admingeo:hasUnitID ; 
                                                   a owl:Restriction],
                                                  admingeo:Ward,
                                                  [owl:onDataRange xsd:string ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty admingeo:hasCensusCode ; 
                                                   a owl:Restriction].
admingeo:ScottishParliamentConstituency a owl:Class;
                                        rdfs:comment "The Scottish parliamentary constituencies are used to elect members to the Scottish Parliament."@en;
                                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                        rdfs:label "Scottish Parliament Constituency"@en;
                                        rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty admingeo:hasUnitID ; 
                                                         a owl:Restriction],
                                                        [owl:onDataRange xsd:string ; 
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty admingeo:hasAreaCode ; 
                                                         a owl:Restriction],
                                                        [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onClass admingeo:ScottishParliamentElectoralRegion ; 
                                                         owl:onProperty admingeo:inRegion ; 
                                                         a owl:Restriction],
                                                        [owl:onDataRange xsd:string ; 
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty skos:prefLabel ; 
                                                         a owl:Restriction],
                                                        admingeo:Constituency.
admingeo:ScottishParliamentElectoralRegion a owl:Class;
                                           rdfs:comment "The Scottish parliamentary electoral regions are used for the proportional component of the elections to the Scottish Parliament. They are made up of groups of Scottish parliamentary constituencies."@en;
                                           rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                           rdfs:label "Scottish Parliament Electoral Region"@en;
                                           rdfs:subClassOf [owl:someValuesFrom admingeo:ScottishParliamentConstituency ; 
                                                            owl:onProperty admingeo:constituency ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty admingeo:hasUnitID ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty admingeo:hasAreaCode ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty skos:prefLabel ; 
                                                            a owl:Restriction],
                                                           admingeo:CivilVotingArea.
admingeo:UnitaryAuthority a owl:Class;
                          rdfs:comment "Unitary authorities (UAs) are areas with a single tier of local government (as opposed to the two-tier county:district structure)."@en;
                          rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                          rdfs:label "Unitary Authority";
                          rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (admingeo:UnitaryAuthorityElectoralDivision
                                                                            admingeo:UnitaryAuthorityWard) ; 
                                                               a owl:Class] ; 
                                           owl:onProperty admingeo:ward ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:string ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty admingeo:hasUnitID ; 
                                           a owl:Restriction],
                                          [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty skos:notation ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:string ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty skos:prefLabel ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:string ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty admingeo:hasCensusCode ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:string ; 
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty skos:altLabel ; 
                                           a owl:Restriction],
                                          admingeo:CivilAdministrativeArea,
                                          [owl:onDataRange xsd:string ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty admingeo:hasAreaCode ; 
                                           a owl:Restriction].
admingeo:UnitaryAuthorityElectoralDivision a owl:Class;
                                           rdfs:comment "Electoral wards/divisions are the base unit of UK administrative geography such that all higher units are built up from them. They are also used as a base unit for many other geographies such as parliamentary constituencies and Primary Care Trusts (PCTs). Electoral wards are found across Scotland, Northern Ireland and most of England, whereas the equivalents in Wales and the Isle of Wight are known as electoral divisions.";
                                           rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                           rdfs:label "Unitary Authority Electoral Division";
                                           rdfs:subClassOf admingeo:CivilVotingArea,
                                                           [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty skos:notation ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty admingeo:hasAreaCode ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty skos:prefLabel ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty admingeo:hasCensusCode ; 
                                                            a owl:Restriction],
                                                           [owl:onDataRange xsd:string ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty admingeo:hasUnitID ; 
                                                            a owl:Restriction].
admingeo:UnitaryAuthorityWard a owl:Class;
                              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                              rdfs:label "Unitary Authority Ward"@en;
                              rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasCensusCode ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasUnitID ; 
                                               a owl:Restriction],
                                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty skos:notation ; 
                                               a owl:Restriction],
                                              admingeo:Ward,
                                              [owl:allValuesFrom admingeo:UnitaryAuthority ; 
                                               owl:onProperty admingeo:inDistrict ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty admingeo:hasAreaCode ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:string ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty skos:prefLabel ; 
                                               a owl:Restriction].
admingeo:Ward a owl:Class;
              rdfs:comment "Electoral wards/divisions are the base unit of UK administrative geography such that all higher units are built up from them. They are also used as a base unit for many other geographies such as parliamentary constituencies and Primary Care Trusts (PCTs). Electoral wards are found across Scotland, Northern Ireland and most of England, whereas the equivalents in Wales and the Isle of Wight are known as electoral divisions."@en;
              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
              rdfs:label "Ward"@en;
              rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onClass [owl:unionOf (admingeo:District
                                                         admingeo:LondonBorough
                                                         admingeo:MetropolitanDistrict
                                                         admingeo:UnitaryAuthority) ; 
                                            a owl:Class] ; 
                               owl:onProperty admingeo:inDistrict ; 
                               a owl:Restriction],
                              admingeo:CivilVotingArea.
admingeo:WelshAssemblyConstituency a owl:Class;
                                   rdfs:comment "The  Welsh Assembly constituencies are used to elect members to the National Assembly for Wales (NAW)."@en;
                                   rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                   rdfs:label "Welsh Assembly Constituency"@en;
                                   rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty admingeo:hasAreaCode ; 
                                                    a owl:Restriction],
                                                   [owl:onDataRange xsd:string ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty admingeo:hasUnitID ; 
                                                    a owl:Restriction],
                                                   [owl:onDataRange xsd:string ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty skos:prefLabel ; 
                                                    a owl:Restriction],
                                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onClass admingeo:WelshAssemblyElectoralRegion ; 
                                                    owl:onProperty admingeo:inRegion ; 
                                                    a owl:Restriction],
                                                   admingeo:Constituency.
admingeo:WelshAssemblyElectoralRegion a owl:Class;
                                      rdfs:comment "The Welsh Assembly electoral regions are used for the proportional component of the elections to the National Assembly for Wales (NAW). They are made up of groups of Welsh Assembly constituencies."@en;
                                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                      rdfs:label "Welsh Assembly Electoral Region"@en;
                                      rdfs:subClassOf [owl:someValuesFrom admingeo:WelshAssemblyConstituency ; 
                                                       owl:onProperty admingeo:constituency ; 
                                                       a owl:Restriction],
                                                      [owl:onDataRange xsd:string ; 
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty admingeo:hasUnitID ; 
                                                       a owl:Restriction],
                                                      [owl:onDataRange xsd:string ; 
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty admingeo:hasAreaCode ; 
                                                       a owl:Restriction],
                                                      [owl:onDataRange xsd:string ; 
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty skos:prefLabel ; 
                                                       a owl:Restriction],
                                                      admingeo:CivilVotingArea.
admingeo:WestminsterConstituency a owl:Class;
                                 rdfs:comment "Westminster parliamentary constituencies are used to elect members to the UK Parliament in Westminster, London."@en;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "Westminster Constituency"@en;
                                 rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty admingeo:hasAreaCode ; 
                                                  a owl:Restriction],
                                                 [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty admingeo:hasUnitID ; 
                                                  a owl:Restriction],
                                                 [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty skos:prefLabel ; 
                                                  a owl:Restriction],
                                                 admingeo:Constituency.
admingeo:constituency a owl:ObjectProperty;
                      rdfs:comment "this relates European regions, Scottish Parliament Electoral Regions and Welsh Assembly Electoral Regions to their consistuencies.";
                      rdfs:domain [owl:unionOf (admingeo:GreaterLondonAuthority
                                                admingeo:ScottishParliamentElectoralRegion
                                                admingeo:WelshAssemblyElectoralRegion) ; 
                                   a owl:Class];
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                      rdfs:label "constituency";
                      rdfs:range [owl:unionOf (admingeo:GreaterLondonAuthorityAssemblyConstituency
                                               admingeo:ScottishParliamentConstituency
                                               admingeo:WelshAssemblyConstituency) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf spacerel:contains.
admingeo:county a owl:ObjectProperty;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                rdfs:range [owl:unionOf (admingeo:County
                                         admingeo:GreaterLondonAuthority) ; 
                            a owl:Class];
                rdfs:subPropertyOf spacerel:contains.
admingeo:district a owl:ObjectProperty;
                  rdfs:comment "this relates counties and european regions to the districts, unitary authorites, metropolitan districts and London boroughs they contain.";
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                  rdfs:label "district";
                  rdfs:range [owl:unionOf (admingeo:District
                                           admingeo:LondonBorough
                                           admingeo:MetropolitanDistrict
                                           admingeo:UnitaryAuthority) ; 
                              a owl:Class];
                  rdfs:subPropertyOf spacerel:contains;
                  owl:propertyChainAxiom (admingeo:county
                                          admingeo:district).
admingeo:gssCode a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment """Office for National Statistics (ONS) have reconfigured their GSS coding structure 
(providing a unique system of referencing for administrative units) to a new 9 character
alpha numeric format,replacing the current alpha numeric format (up to 6 characters).This
change has now been implemented in this October 2010 release of Boundary-Line. 

However,the new GSS Coding and Naming policy for some statistical geographies will be implemented 
on 1 January 2011. From this date, where new codes have been allocated they should be used in all
exchanges of statistics and published outputs that normally include codes.

The following types of unit are coded where they have been made available by ONS: 
Counties, Districts, Wards/Electoral Divisions, London Boroughs, Unitary Authorities, GLA's,
Parish/Communities, Euro Regions, Welsh Assembly Const and Electoral Regions, 
Scottish Parliamentary Const and Electoral Regions, Westminster Const.""";
                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                 rdfs:label "GSS".
admingeo:hasAreaCode a owl:FunctionalProperty,
                       owl:DatatypeProperty;
                     rdfs:comment "This code describing the area type";
                     rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                     rdfs:label "has area code".
admingeo:hasCensusCode a owl:FunctionalProperty,
                         owl:DatatypeProperty;
                       rdfs:comment "These code area unique system of referencing for administrative units. These codes are allocated by the Office of National Statistics (ONS) for England and Wales, and by the General Register Office for Scotland (GROS) for Scottish Areas.";
                       rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                       rdfs:label "has census code".
admingeo:hasOfficialName a owl:DatatypeProperty;
                         rdfs:label "has official name".
admingeo:hasUnitID a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:comment "A unique ID for the region";
                   rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                   rdfs:label "has unit ID".
admingeo:inCounty a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "this relates districts, parish, county electoral divisions and wards to their containing counties";
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                  rdfs:label "in county";
                  rdfs:range [owl:unionOf (admingeo:County
                                           admingeo:GreaterLondonAuthority) ; 
                              a owl:Class];
                  rdfs:subPropertyOf spacerel:within.
admingeo:inDistrict a owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:comment "this relates parishes, wards and unitary electoral divisions to their containing districts";
                    rdfs:domain [owl:unionOf (admingeo:CivilParish
                                              admingeo:Community
                                              admingeo:UnitaryAuthorityElectoralDivision
                                              admingeo:Ward) ; 
                                 a owl:Class];
                    rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                    rdfs:label "in district";
                    rdfs:range [owl:unionOf (admingeo:District
                                             admingeo:LondonBorough
                                             admingeo:MetropolitanDistrict
                                             admingeo:UnitaryAuthority) ; 
                                a owl:Class];
                    rdfs:subPropertyOf spacerel:within.
admingeo:inEuropeanRegion a owl:FunctionalProperty,
                            owl:ObjectProperty;
                          rdfs:comment "this relates various administrative and civil voting areas to their containing European region";
                          rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                          rdfs:label "in European region";
                          rdfs:range admingeo:EuropeanRegion;
                          rdfs:subPropertyOf spacerel:within.
admingeo:inRegion a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "this relates Greater London Authority Assembly Constituencies, Scottish Parliament Constituenices and Welsh AssemblyConstituencies to their containing regions.";
                  rdfs:domain [owl:unionOf (admingeo:GreaterLondonAuthorityAssemblyConstituency
                                            admingeo:ScottishParliamentConstituency
                                            admingeo:WelshAssemblyConstituency) ; 
                               a owl:Class];
                  rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                  rdfs:label "in region";
                  rdfs:range [owl:unionOf (admingeo:GreaterLondonAuthority
                                           admingeo:ScottishParliamentElectoralRegion
                                           admingeo:WelshAssemblyElectoralRegion) ; 
                              a owl:Class];
                  rdfs:subPropertyOf spacerel:within;
                  owl:inverseOf admingeo:constituency.
admingeo:parish a owl:ObjectProperty;
                rdfs:comment "this relates various administrative areas to the parishes they contain";
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                rdfs:label "parish";
                rdfs:range [owl:unionOf (admingeo:CivilParish
                                         admingeo:Community) ; 
                            a owl:Class];
                rdfs:subPropertyOf spacerel:contains.
admingeo:scottishParliamentElectoralRegion a owl:ObjectProperty;
                                           rdfs:domain admingeo:EuropeanRegion;
                                           rdfs:range admingeo:ScottishParliamentElectoralRegion;
                                           rdfs:subPropertyOf spacerel:contains.
admingeo:ward a owl:ObjectProperty;
              rdfs:comment "this relates an administrative regions to the wards and unitary electoral divisions contained within that region";
              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
              rdfs:label "ward";
              rdfs:range [owl:unionOf (admingeo:UnitaryAuthorityElectoralDivision
                                       admingeo:Ward) ; 
                          a owl:Class];
              rdfs:subPropertyOf spacerel:contains;
              owl:propertyChainAxiom (admingeo:district
                                      admingeo:ward).
admingeo:welshAssemblyElectoralRegion a owl:ObjectProperty;
                                      rdfs:domain admingeo:EuropeanRegion;
                                      rdfs:range admingeo:WelshAssemblyElectoralRegion;
                                      rdfs:subPropertyOf spacerel:contains.
admingeo:westminsterConstituency a owl:ObjectProperty;
                                 rdfs:comment "this relates European regions to the Westminster constituencies contains within those regions";
                                 rdfs:domain admingeo:EuropeanRegion;
                                 rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/admingeo.owl>;
                                 rdfs:label "westminster constituency";
                                 rdfs:range admingeo:WestminsterConstituency;
                                 rdfs:subPropertyOf spacerel:contains.
osgeom:AbstractGeometry a owl:Class.
osgeom:extent a owl:ObjectProperty.
spacerel:contains a owl:ObjectProperty.
spacerel:within a owl:ObjectProperty.
dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:publisher a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:DatatypeProperty,
             owl:AnnotationProperty.
owl:Thing a owl:Class.
skos:altLabel a owl:DatatypeProperty.
skos:notation a owl:DatatypeProperty.
skos:prefLabel a owl:DatatypeProperty.
