@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cochrane: <http://data.cochrane.org/ontologies/core/>.

cochrane: <http://purl.org/dc/elements/1.1/abstract> """The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare.
    It is used for the construction of the Cochrane Linked Data Vocabulary containing some 400k terms including Interventions (Drugs, Procedures etc), Populations (Age, Sex, Condition), and clinical Outcomes."""@en;
          <http://purl.org/dc/elements/1.1/creator> "Chris Mavergames",
                                                    "Paul Wilton",
                                                    "Julian Everett",
                                                    "Lorne Becker",
                                                    "Silver Oliver";
          <http://purl.org/dc/elements/1.1/publisher> "Cochrane";
          <http://purl.org/dc/terms/created> "2014-02-06"^^xsd:date;
          <http://purl.org/dc/terms/description> "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare."@en;
          <http://purl.org/dc/terms/modified> "2019-09-06"^^xsd:date;
          <http://purl.org/dc/terms/rights> "Copyright Cochrane 2020. Creative Commons License: CC BY-NC-ND : Attribution-NonCommercial-NoDerivs : https://creativecommons.org/licenses/by-nc-nd/4.0"@en;
          <http://purl.org/dc/terms/title> "Cochrane Core Vocabulary Ontology"@en;
          <http://purl.org/vocab/vann/preferredNamespacePrefix> "cc";
          <http://purl.org/vocab/vann/preferredNamespaceUri> "http://data.cochrane.org/ontologies/core/";
          <http://schema.org/image> "https://data.cochrane.org/ontologies/pico/PICO-ontology.png";
          a <http://www.w3.org/2002/07/owl#Ontology>;
          rdfs:comment "The Cochrane Core ontology describes the entities and concepts that exist in the domain of evidence based healthcare."@en;
          <http://www.w3.org/2002/07/owl#versionInfo> "2.0.1".
cochrane:Age a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Age of some defined population."@en;
             rdfs:isDefinedBy cochrane:;
             rdfs:label "Age"@en;
             rdfs:subClassOf cochrane:Concept.
cochrane:AggregationMethod a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "An Aggregation method used in defining an outcome."@en;
                           rdfs:isDefinedBy cochrane:;
                           rdfs:label "AggregationMethod"@en;
                           rdfs:subClassOf cochrane:Concept.
cochrane:AppliedIntervention a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Am applied intervention used to treat some condition"@en;
                             rdfs:isDefinedBy cochrane:;
                             rdfs:label "AppliedIntervention"@en;
                             rdfs:subClassOf cochrane:Concept.
cochrane:AssessmentScale a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An AssessmentScale that an outcome is measured against."@en;
                         rdfs:isDefinedBy cochrane:;
                         rdfs:label "AssessmentScale"@en;
                         rdfs:subClassOf cochrane:Concept.
cochrane:Concept a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A vocabulary concept"@en;
                 rdfs:isDefinedBy cochrane:;
                 rdfs:label "Concept"@en;
                 rdfs:subClassOf cochrane:Thing.
cochrane:ConceptScheme a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A scheme that a concept exists within"@en;
                       rdfs:isDefinedBy cochrane:;
                       rdfs:label "ConceptScheme"@en;
                       rdfs:subClassOf cochrane:Thing.
cochrane:Condition a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Condition of some defined population."@en;
                   rdfs:isDefinedBy cochrane:;
                   rdfs:label "Condition"@en;
                   rdfs:subClassOf cochrane:Concept.
cochrane:Device a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Device used as intervention"@en;
                rdfs:isDefinedBy cochrane:;
                rdfs:label "Device"@en;
                rdfs:subClassOf cochrane:Material.
cochrane:DeviceCategory a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A category or class of Device"@en;
                        rdfs:isDefinedBy cochrane:;
                        rdfs:label "DeviceCategory"@en;
                        rdfs:subClassOf cochrane:InterventionCategory.
cochrane:Drug a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Drug used as intervention"@en;
              rdfs:isDefinedBy cochrane:;
              rdfs:label "Drug"@en;
              rdfs:subClassOf cochrane:Material.
cochrane:DrugCategory a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A category or class of drug"@en;
                      rdfs:isDefinedBy cochrane:;
                      rdfs:label "DrugCategory"@en;
                      rdfs:subClassOf cochrane:InterventionCategory.
cochrane:InterventionCategory a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A category or class of applied intervention"@en;
                              rdfs:isDefinedBy cochrane:;
                              rdfs:label "InterventionCategory"@en;
                              rdfs:subClassOf cochrane:AppliedIntervention.
cochrane:InterventionClassification a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "The classification of an intervention."@en;
                                    rdfs:isDefinedBy cochrane:;
                                    rdfs:label "InterventionClassification"@en;
                                    rdfs:subClassOf cochrane:Concept.
cochrane:InterventionProvider a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Some agent that provides or delivers an intervention."@en;
                              rdfs:isDefinedBy cochrane:;
                              rdfs:label "InterventionProvider"@en;
                              rdfs:subClassOf cochrane:Concept.
cochrane:InterventionRationale a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The rationale for providing an intervention."@en;
                               rdfs:isDefinedBy cochrane:;
                               rdfs:label "InterventionRationale"@en;
                               rdfs:subClassOf cochrane:Concept.
cochrane:Material a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A material used as intervention"@en;
                  rdfs:isDefinedBy cochrane:;
                  rdfs:label "Material"@en;
                  rdfs:subClassOf cochrane:AppliedIntervention.
cochrane:ModeOfDelivery a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The mechanism by which an intervention is delivered."@en;
                        rdfs:isDefinedBy cochrane:;
                        rdfs:label "ModeOfDelivery"@en;
                        rdfs:subClassOf cochrane:Concept.
cochrane:OutcomeClassification a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The classification of an outcome."@en;
                               rdfs:isDefinedBy cochrane:;
                               rdfs:label "OutcomeClassification"@en;
                               rdfs:subClassOf cochrane:Concept.
cochrane:Procedure a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Procedure used as intervention"@en;
                   rdfs:isDefinedBy cochrane:;
                   rdfs:label "Procedure"@en;
                   rdfs:subClassOf cochrane:AppliedIntervention.
cochrane:ProcedureCategory a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A category or class of procedure"@en;
                           rdfs:isDefinedBy cochrane:;
                           rdfs:label "ProcedureCategory"@en;
                           rdfs:subClassOf cochrane:InterventionCategory.
cochrane:Setting a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The setting in which an intervention is delivered (eg clininc, hospital, at home)."@en;
                 rdfs:isDefinedBy cochrane:;
                 rdfs:label "Setting"@en;
                 rdfs:subClassOf cochrane:Concept.
cochrane:Sex a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Sex of some defined population."@en;
             rdfs:isDefinedBy cochrane:;
             rdfs:label "Sex"@en;
             rdfs:subClassOf cochrane:Concept.
cochrane:SpecificMetric a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A specific metric used in defining an outcome."@en;
                        rdfs:isDefinedBy cochrane:;
                        rdfs:label "SpecificMetric"@en;
                        rdfs:subClassOf cochrane:Concept.
cochrane:Thing a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A Thing"@en;
               rdfs:isDefinedBy cochrane:;
               rdfs:label "Thing"@en.
cochrane:Treatment a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Treatment some population is undergoing."@en;
                   rdfs:isDefinedBy cochrane:;
                   rdfs:label "Treatment"@en;
                   rdfs:subClassOf cochrane:Concept.
cochrane:alternateLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:alternateLabel "alternateLabel"@en;
                        rdfs:comment "The alternate label or synonym of something."@en;
                        rdfs:domain cochrane:Thing;
                        rdfs:isDefinedBy cochrane:;
                        rdfs:range rdf:langString.
cochrane:broaderConcept a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Relates a Concept to a broader one in the same concept scheme."@en;
                        rdfs:domain cochrane:Concept;
                        rdfs:isDefinedBy cochrane:;
                        rdfs:label "broaderConcept"@en;
                        rdfs:range cochrane:Concept.
cochrane:equivalentConcept a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Relates a Concept to an equivalent one."@en;
                           rdfs:domain cochrane:Concept;
                           rdfs:isDefinedBy cochrane:;
                           rdfs:label "equivalentConcept"@en;
                           rdfs:range cochrane:Concept.
cochrane:inCategory a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates an intervention to an intervention category."@en;
                    rdfs:domain cochrane:Concept;
                    rdfs:isDefinedBy cochrane:;
                    rdfs:label "inCategory"@en;
                    rdfs:range cochrane:AppliedIntervention;
                    rdfs:subPropertyOf cochrane:broaderConcept.
cochrane:inConceptScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Relates a Concept to its ConceptScheme"@en;
                         rdfs:domain cochrane:Concept;
                         rdfs:isDefinedBy cochrane:;
                         rdfs:label "inConceptScheme"@en;
                         rdfs:range cochrane:ConceptScheme.
cochrane:label a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "The label of something."@en;
               rdfs:domain cochrane:Thing;
               rdfs:isDefinedBy cochrane:;
               rdfs:label "label"@en;
               rdfs:range rdf:langString;
               rdfs:subPropertyOf rdfs:label.
cochrane:lastModifiedDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "The date/time a concept was last modified (workflow/provenance)."@en;
                          rdfs:domain cochrane:Concept;
                          rdfs:isDefinedBy cochrane:;
                          rdfs:label "lastModifiedDate"@en;
                          rdfs:range xsd:dateTime.
cochrane:longLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The long label of something."@en;
                   rdfs:domain cochrane:Thing;
                   rdfs:isDefinedBy cochrane:;
                   rdfs:longLabel "longLabel"@en;
                   rdfs:range rdf:langString.
cochrane:modifiedBy a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The agent that modified the concept (workflow/provenance)."@en;
                    rdfs:domain cochrane:Concept;
                    rdfs:isDefinedBy cochrane:;
                    rdfs:label "modifiedBy"@en;
                    rdfs:range xsd:string.
cochrane:narrowerConcept a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Relates a Concept to a narrower one in the same concept scheme."@en;
                         rdfs:domain cochrane:Concept;
                         rdfs:isDefinedBy cochrane:;
                         rdfs:label "narrowerConcept"@en;
                         rdfs:range cochrane:Concept.
cochrane:shortLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The short label of something."@en;
                    rdfs:domain cochrane:Thing;
                    rdfs:isDefinedBy cochrane:;
                    rdfs:range rdf:langString;
                    rdfs:shortLabel "shortLabel"@en.
<http://purl.org/dc/elements/1.1/abstract> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://schema.org/image> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:alternateLabel a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:longLabel a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:shortLabel a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
