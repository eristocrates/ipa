@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cart: <http://purl.org/net/cartCoord#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/language> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
cart: <http://purl.org/dc/elements/1.1/creator> "Diarmuid Ryan";
      <http://purl.org/dc/elements/1.1/description> "Ontology for representation of cartesian co-ordinates";
      <http://purl.org/dc/elements/1.1/language> "en";
      <http://purl.org/dc/elements/1.1/title> "cartCoordOnt";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "Date Created: 3/7/15. Last Modified: 3/7/15.",
                   """This work is licensed under a Creative Commons Attribution-ShareAlike 4.0 International License.
        				http://creativecommons.org/licenses/by-sa/4.0/""".
cart:Point a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
cart:Point_List a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
cart:hasPlacement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:label "has Point";
                  rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
cart:hasPoint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain cart:Point_List;
              rdfs:label "has Point";
              rdfs:range cart:Point.
cart:xcoord a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain cart:Point;
            rdfs:label "X Coordinate";
            rdfs:range xsd:double.
cart:ycoord a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain cart:Point;
            rdfs:label "Y Coordinate";
            rdfs:range xsd:double.
cart:zcoord a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain cart:Point;
            rdfs:label "Z Coordinate";
            rdfs:range xsd:double.
