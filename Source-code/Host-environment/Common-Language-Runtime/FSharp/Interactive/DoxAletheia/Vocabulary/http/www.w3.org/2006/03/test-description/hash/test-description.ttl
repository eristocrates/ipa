@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix test-description: <http://www.w3.org/2006/03/test-description#>.

<http://www.w3.org/1999/02/22-rdf-syntax-ns> rdfs:seeAlso <http://www.w3.org/TR/2005/NOTE-test-metadata-20050914/>.
test-description:ReviewStatus a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A particular stage in a review process";
                              rdfs:label "Status in a review process"@en.
test-description:SimpleReviewStatus a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:label "A status for a simple review process containing 6 possible stages"@en;
                                    rdfs:subClassOf test-description:ReviewStatus;
                                    <http://www.w3.org/2002/07/owl#oneOf> (test-description:unreviewed
                                                                           test-description:accepted
                                                                           test-description:assigned
                                                                           test-description:approved
                                                                           test-description:rejected
                                                                           test-description:onhold),
                                                                          (test-description:unreviewed
                                                                           test-description:accepted
                                                                           test-description:assigned
                                                                           test-description:approved
                                                                           test-description:rejected
                                                                           test-description:onhold).
test-description:SpecificationTestCase a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "A test case which relates to a requirement set in a specification";
                                       rdfs:label "A Test Case based on a specification"@en;
                                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> test-description:specificationReference ; 
                                                        <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       [<http://www.w3.org/2002/07/owl#onProperty> test-description:specificationReference ; 
                                                        <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       test-description:TestCase.
test-description:TestCase a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A set of test inputs, execution conditions, and expected results developed for a particular objective, such as to exercise a particular program path or to verify compliance with a specific requirement";
                          rdfs:label "A Test Case"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/rights> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/title> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:purpose ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/rights> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/contributor> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/description> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/title> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:purpose ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:reviewStatus ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/contributor> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/title> ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/description> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/elements/1.1/title> ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:reviewStatus ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:purpose ; 
                                           <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#onProperty> test-description:purpose ; 
                                           <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>].
test-description:accepted a test-description:ReviewStatus;
                          rdfs:comment "the item has gone through a first review, which shows it as valid for further processing";
                          rdfs:label "accepted"@en.
test-description:approved a test-description:ReviewStatus;
                          rdfs:comment "the item has gone through the review process and was approved";
                          rdfs:label "approved"@en.
test-description:assigned a test-description:ReviewStatus;
                          rdfs:comment "a more specific review of the item has been assigned to someone";
                          rdfs:label "assigned"@en.
test-description:expectedResults a rdf:Property;
                                 rdfs:comment "The results that a conformant implementation is expected to produce when this test is executed";
                                 rdfs:domain test-description:TestCase;
                                 rdfs:label "expected results"@en.
test-description:informationResourceInput a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:comment "Information Resource (e.g. a file) used as input for the test case"@en;
                                          rdfs:label "information resource as input"@en;
                                          rdfs:range <http://www.w3.org/2006/gen/ont#InformationResource>;
                                          rdfs:subPropertyOf test-description:input.
test-description:informationResourceResults a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                            rdfs:comment "Information Resource (e.g. a file) that contains the expected results for the test case";
                                            rdfs:label "information resource as expected results"@en;
                                            rdfs:range <http://www.w3.org/2006/gen/ont#InformationResource>;
                                            rdfs:subPropertyOf test-description:expectedResults.
test-description:input a rdf:Property;
                       rdfs:comment "Parameters or data that are needed for the test execution."@en;
                       rdfs:domain test-description:TestCase;
                       rdfs:label "input"@en.
test-description:onhold a test-description:ReviewStatus;
                        rdfs:comment "the item had already gone through the review process, but the results of the review need to be re-assessed due to new input";
                        rdfs:label "on hold".
test-description:preCondition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "a condition that must be met before the test is executed"@en;
                              rdfs:domain test-description:TestCase;
                              rdfs:label "precondition"@en;
                              rdfs:range rdfs:Literal.
test-description:purpose a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain test-description:TestCase;
                         rdfs:label "purpose"@en;
                         rdfs:range rdfs:Literal.
test-description:rejected a test-description:ReviewStatus;
                          rdfs:comment "the item has gone through the review process and was rejected";
                          rdfs:label "rejected"@en.
test-description:reviewStatus a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:label "status of review"@en;
                              rdfs:range test-description:ReviewStatus.
test-description:specificationReference a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                        rdfs:comment "a description or a link of what part of which specification lead to the creation of this test case"@en;
                                        rdfs:domain test-description:TestCase;
                                        rdfs:label "reference in specification"@en;
                                        rdfs:range rdfs:Literal.
test-description:unreviewed a test-description:ReviewStatus;
                            rdfs:comment "the item has been proposed, but hasn't been reviewed (e.g. for completeness) yet";
                            rdfs:label "unreviewed"@en.
