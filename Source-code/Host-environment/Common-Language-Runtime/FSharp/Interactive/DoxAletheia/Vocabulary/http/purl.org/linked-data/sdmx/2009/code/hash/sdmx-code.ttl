@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdmx: <http://purl.org/linked-data/sdmx#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sdmx-code: <http://purl.org/linked-data/sdmx/2009/code#>.

sdmx-code:Area a owl:Class,
                 rdfs:Class;
               rdfs:comment ": This code list provides code values for geographical areas, defined as areas included within the borders of a country, region, group of countries, etc."@en;
               rdfs:label "Code list for providing values to concepts such as 'Reference area' and/or 'Counterpart area' - codelist class"@en;
               rdfs:seeAlso sdmx-code:area;
               rdfs:subClassOf skos:Concept.
sdmx-code:ConfStatus a owl:Class,
                       rdfs:Class;
                     rdfs:comment "this code list provides coded information about the sensitivity and confidentiality status of the data."@en;
                     rdfs:label "code list for Confidentiality Status (CONF_STATUS) - codelist class"@en;
                     rdfs:seeAlso sdmx-code:confStatus;
                     rdfs:subClassOf skos:Concept.
sdmx-code:Currency a owl:Class,
                     rdfs:Class;
                   rdfs:comment "This code list provides code values for currencies."@en;
                   rdfs:label "code list for Currency (CURRENCY) - codelist class"@en;
                   rdfs:seeAlso sdmx-code:currency;
                   rdfs:subClassOf skos:Concept.
sdmx-code:Decimals a owl:Class,
                     rdfs:Class;
                   rdfs:comment "It provides a list of values showing the number of decimal digits used in the data."@en;
                   rdfs:label "Code list for Decimals (DECIMALS) - codelist class"@en;
                   rdfs:seeAlso sdmx-code:decimals;
                   rdfs:subClassOf skos:Concept.
sdmx-code:Freq a owl:Class,
                 rdfs:Class;
               rdfs:comment """It provides a list of values indicating the \"frequency\" of the data (e.g. monthly) and, thus, indirectly, also implying the type of \"time reference\" that could be used for identifying the data with respect time."""@en;
               rdfs:label "Code list for Frequency (FREQ) - codelist class"@en;
               rdfs:seeAlso sdmx-code:freq;
               rdfs:subClassOf skos:Concept.
sdmx-code:ObsStatus a owl:Class,
                      rdfs:Class;
                    rdfs:comment """This code list provides coded information about the \"status\" of an observation (with respect events such as the ones reflected in the codes composing the code list)."""@en;
                    rdfs:label "Observation status - codelist class"@en;
                    rdfs:seeAlso sdmx-code:obsStatus;
                    rdfs:subClassOf skos:Concept.
sdmx-code:Sex a owl:Class,
                rdfs:Class;
              rdfs:comment "This  code list provides the gender."@en;
              rdfs:label "Code list for Sex (SEX) - codelist class"@en;
              rdfs:seeAlso sdmx-code:sex;
              rdfs:subClassOf skos:Concept.
sdmx-code:TimeFormat a owl:Class,
                       rdfs:Class;
                     rdfs:comment "These codes (based on the ISO 8601 standard) indicate the type of time references used in the data. The numeric codes below (203, 102,...,702) are used only in the SDMX-EDI messages; and the alphanumeric codes (P1D...PT1M) only in the SDMX-ML messages."@en;
                     rdfs:label "Code list for the Time Format as written in the SDMX-EDI and SDMX-ML messages - codelist class"@en;
                     rdfs:seeAlso sdmx-code:timeFormat;
                     rdfs:subClassOf skos:Concept.
sdmx-code:UnitMult a owl:Class,
                     rdfs:Class;
                   rdfs:comment "it provides code values for indicating the magnitude in the units of measurements."@en;
                   rdfs:label "code list for the Unit Multiplier (UNIT_MULT) - codelist class"@en;
                   rdfs:seeAlso sdmx-code:unitMult;
                   rdfs:subClassOf skos:Concept.
sdmx-code:area a sdmx:CodeList,
                 skos:ConceptScheme;
               rdfs:label "Code list for providing values to concepts such as 'Reference area' and/or 'Counterpart area' - codelist scheme"@en;
               rdfs:seeAlso sdmx-code:Area;
               skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
               skos:notation "CL_AREA";
               skos:note ": This code list provides code values for geographical areas, defined as areas included within the borders of a country, region, group of countries, etc."@en;
               skos:prefLabel "Code list for providing values to concepts such as 'Reference area' and/or 'Counterpart area' - codelist scheme"@en.
sdmx-code:confStatus a sdmx:CodeList,
                       skos:ConceptScheme;
                     rdfs:label "code list for Confidentiality Status (CONF_STATUS) - codelist scheme"@en;
                     rdfs:seeAlso sdmx-code:ConfStatus;
                     skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
                     skos:hasTopConcept sdmx-code:confStatus-F,
                                        sdmx-code:confStatus-S,
                                        sdmx-code:confStatus-D,
                                        sdmx-code:confStatus-N,
                                        sdmx-code:confStatus-C;
                     skos:notation "CL_CONF_STATUS";
                     skos:note "this code list provides coded information about the sensitivity and confidentiality status of the data."@en;
                     skos:prefLabel "code list for Confidentiality Status (CONF_STATUS) - codelist scheme"@en.
sdmx-code:confStatus-C a sdmx-code:ConfStatus,
                         sdmx:Concept,
                         skos:Concept;
                       skos:definition """Confidential statistical information (primary confidentiality) due to identifiable respondents.  Measures also should be taken to prevent not only direct access, but also indirect deduction or calculation by other users and parties, probably by considering and treating additional observations as \"confidential\" (secondary confidentiality management)."""@en;
                       skos:inScheme sdmx-code:confStatus;
                       skos:notation "C";
                       skos:prefLabel "Confidential statistical information"@en;
                       skos:topConceptOf sdmx-code:confStatus.
sdmx-code:confStatus-D a sdmx-code:ConfStatus,
                         sdmx:Concept,
                         skos:Concept;
                       skos:definition """Used by the sender of the data to flag (beyond the confidential statistical information) one or more additional observations of the dataset so that the receiver knows that he/she should suppress these observations in subsequent stages of processing (especially, dissemination) in order to prevent third parties to indirectly deduct (e.g. through accounting identities or other formulas) the observations that are genuinely flagged with \"C\"."""@en;
                       skos:inScheme sdmx-code:confStatus;
                       skos:notation "D";
                       skos:prefLabel "Secondary confidentiality set by the sender, not for publication"@en;
                       skos:topConceptOf sdmx-code:confStatus.
sdmx-code:confStatus-F a sdmx-code:ConfStatus,
                         sdmx:Concept,
                         skos:Concept;
                       skos:definition """It is used for observations for observations for which there are no special sensitivity considerations and which can be freely shared. Please note:
In some institutional environments the term \"unclassified\" is used in a sense that still denotes implied restrictions in the circulation of information. If this is the case, this organisation may probably consider that \"free\" (value F) is not the appropriate corresponding tag for this kind of \"unclassified\" category and it may be that \"non-publishable / restricted\" (value N) may be more appropriate.
The focus of this code is not to describe and anticipate all potential permissible uses (e.g. permission to re-disseminate). Thus, the use of \"F\" does not allow safe assumptions with respect to the permission to \"re-disseminate\" (freely or at a price) the received or accessed information (e.g. on web or paper), especially on a massive and regular basis (legal and copyright constraints may apply). Usually, source organisations provide information and guidance on re-dissemination issues, either on their websites or on their paper publications."""@en;
                       skos:inScheme sdmx-code:confStatus;
                       skos:notation "F";
                       skos:prefLabel "Free"@en;
                       skos:topConceptOf sdmx-code:confStatus.
sdmx-code:confStatus-N a sdmx-code:ConfStatus,
                         sdmx:Concept,
                         skos:Concept;
                       skos:definition "Used to denote observations that are restricted for internal use only within organisations."@en;
                       skos:inScheme sdmx-code:confStatus;
                       skos:notation "N";
                       skos:prefLabel "Not for publication, restricted for internal use only"@en;
                       skos:topConceptOf sdmx-code:confStatus.
sdmx-code:confStatus-S a sdmx-code:ConfStatus,
                         sdmx:Concept,
                         skos:Concept;
                       skos:definition """If senders do not manage the secondary confidentiality in their data and/or there are also other countries' data involved (with the intention to eventually compile a regional-wide aggregate that is going to be published), the value \"S\" is used by the receiver to flag additional suppressed observations (within sender's data and/or within the datasets of other senders) in subsequent stages of processing (especially, dissemination) in order to prevent third parties to indirectly deduct the observations that were genuinely flagged with \"C\" by the sender."""@en;
                       skos:inScheme sdmx-code:confStatus;
                       skos:notation "S";
                       skos:prefLabel "Secondary confidentiality set and managed by the receiver, not for publication"@en;
                       skos:topConceptOf sdmx-code:confStatus.
sdmx-code:currency a sdmx:CodeList,
                     skos:ConceptScheme;
                   rdfs:label "code list for Currency (CURRENCY) - codelist scheme"@en;
                   rdfs:seeAlso sdmx-code:Currency;
                   skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
                   skos:notation "CL_CURRENCY";
                   skos:note "This code list provides code values for currencies."@en;
                   skos:prefLabel "code list for Currency (CURRENCY) - codelist scheme"@en.
sdmx-code:decimals a sdmx:CodeList,
                     skos:ConceptScheme;
                   rdfs:label "Code list for Decimals (DECIMALS) - codelist scheme"@en;
                   rdfs:seeAlso sdmx-code:Decimals;
                   skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
                   skos:hasTopConcept sdmx-code:decimals-5,
                                      sdmx-code:decimals-3,
                                      sdmx-code:decimals-8,
                                      sdmx-code:decimals-6,
                                      sdmx-code:decimals-1,
                                      sdmx-code:decimals-4,
                                      sdmx-code:decimals-2,
                                      sdmx-code:decimals-9,
                                      sdmx-code:decimals-0,
                                      sdmx-code:decimals-7;
                   skos:notation "CL_DECIMALS";
                   skos:note "It provides a list of values showing the number of decimal digits used in the data."@en;
                   skos:prefLabel "Code list for Decimals (DECIMALS) - codelist scheme"@en.
sdmx-code:decimals-0 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "0";
                     skos:prefLabel "Zero"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-1 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "1";
                     skos:prefLabel "One"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-2 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "2";
                     skos:prefLabel "Two"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-3 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "3";
                     skos:prefLabel "Three"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-4 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "4";
                     skos:prefLabel "Four"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-5 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "5";
                     skos:prefLabel "Five"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-6 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "6";
                     skos:prefLabel "Six"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-7 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "7";
                     skos:prefLabel "Seven"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-8 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "8";
                     skos:prefLabel "Eight"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:decimals-9 a sdmx-code:Decimals,
                       sdmx:Concept,
                       skos:Concept;
                     skos:inScheme sdmx-code:decimals;
                     skos:notation "9";
                     skos:prefLabel "Nine"@en;
                     skos:topConceptOf sdmx-code:decimals.
sdmx-code:freq a sdmx:CodeList,
                 skos:ConceptScheme;
               rdfs:label "Code list for Frequency (FREQ) - codelist scheme"@en;
               rdfs:seeAlso sdmx-code:Freq;
               skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
               skos:hasTopConcept sdmx-code:freq-D,
                                  sdmx-code:freq-W,
                                  sdmx-code:freq-M,
                                  sdmx-code:freq-Q,
                                  sdmx-code:freq-B,
                                  sdmx-code:freq-S,
                                  sdmx-code:freq-N,
                                  sdmx-code:freq-A;
               skos:notation "CL_FREQ";
               skos:note """It provides a list of values indicating the \"frequency\" of the data (e.g. monthly) and, thus, indirectly, also implying the type of \"time reference\" that could be used for identifying the data with respect time."""@en;
               skos:prefLabel "Code list for Frequency (FREQ) - codelist scheme"@en.
sdmx-code:freq-A a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:definition "It is typically used for annual data. This can also serve cases of multi-annual data (data that appear once every two, three or, possibly, five years).  Descriptive information on the multiannual characteristics (e.g. frequency of the series in practice and other methodological information can be provided at the dataflow level, as long as these characteristics are applicable for the entire dataflow)."@en;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "A";
                 skos:prefLabel "Annual"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-B a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:definition """Similar to \"daily\", however there are no observations for Saturday and Sunday (so, neither \"missing values\" nor \"numeric values\" should be provided for Saturday and Sunday). This treatment (\"business\") is one way to deal with such cases, but it is not the only option. Such a time series could alternatively be considered daily (\"D\"), thus, with missing values in the weekend."""@en;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "B";
                 skos:prefLabel "Daily - business week"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-D a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "D";
                 skos:prefLabel "Daily"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-M a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "M";
                 skos:prefLabel "Monthly"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-N a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:definition """While N denotes \"minutely\", usually, there may be no observations every minute (for several series the frequency is usually \"irregular\" within a day/days). And though observations may be sparse (not collected every minute), missing values do not need to be given for the minutes when no observations exist: in any case the time stamp determines when an observation is observed."""@en;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "N";
                 skos:prefLabel "Minutely"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-Q a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "Q";
                 skos:prefLabel "Quarterly"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-S a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "S";
                 skos:prefLabel "Half Yearly, semester"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:freq-W a sdmx-code:Freq,
                   sdmx:Concept,
                   skos:Concept;
                 skos:inScheme sdmx-code:freq;
                 skos:notation "W";
                 skos:prefLabel "Weekly"@en;
                 skos:topConceptOf sdmx-code:freq.
sdmx-code:obsStatus a skos:ConceptScheme,
                      sdmx:CodeList;
                    rdfs:label "Observation status - codelist scheme"@en;
                    rdfs:seeAlso sdmx-code:ObsStatus;
                    skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
                    skos:hasTopConcept sdmx-code:obsStatus-A,
                                       sdmx-code:obsStatus-M,
                                       sdmx-code:obsStatus-F,
                                       sdmx-code:obsStatus-I,
                                       sdmx-code:obsStatus-B,
                                       sdmx-code:obsStatus-E,
                                       sdmx-code:obsStatus-P,
                                       sdmx-code:obsStatus-S;
                    skos:notation "CL_OBS_STATUS";
                    skos:note """This code list provides coded information about the \"status\" of an observation (with respect events such as the ones reflected in the codes composing the code list)."""@en;
                    skos:prefLabel "Observation status - codelist scheme"@en.
sdmx-code:obsStatus-A a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition "Normal is the default value (if no value is provided) and is used when no special coded qualification is assumed. Usually, in this case, it can be assumed that the source agency assigns sufficient confidence to the provided observation and/or the value is not expected to be dramatically revised."@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "A";
                      skos:prefLabel "Normal"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-B a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition "Break observations are characterised as such when different content exist or a different methodology has been applied to this observation as compared with the preceding one (the one given for the previous period)."@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "B";
                      skos:prefLabel "Break"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-E a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition """Observation obtained through an estimation methodology (e.g. to produce back-casts) or based on the use of a limited amount of data or ad hoc sampling and through additional calculations (e.g. to produce a value at an early stage of the production stage while not all data are available). It may also be used in case of experimental data (e.g. in the context of a pilot ahead of a full scale production process) or in case of data of (anticipated/assessed) low quality. If needed, additional (uncoded) information can be provided through (free text) \"comments\" at the observation level or at a higher level."""@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "E";
                      skos:prefLabel "Estimated value"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-F a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "F";
                      skos:prefLabel "Forecast value"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-I a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition "Observation imputed by international organisations to replace or fill gaps in national data series, in line with the recommendations of the Committee for the Coordination of Statistical Activities (CCSA)."@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "I";
                      skos:prefLabel "Imputed value (CCSA definition)"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-M a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition "Data can be missing due to various reasons:  data do not exist, are insignificant (or not collected because they are below a certain threshold), are unreliable, are not relevant for the period, or other reason not elsewhere specified."@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "M";
                      skos:prefLabel "Missing value"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-P a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition """An observation is characterised as \"provisional\" when the source agency - while it bases its calculations on its standard production methodology - considers that the data, almost certainly, are expected to be revised."""@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "P";
                      skos:prefLabel "Provisional value"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:obsStatus-S a sdmx-code:ObsStatus,
                        sdmx:Concept,
                        skos:Concept;
                      skos:definition "A known strike that occurred in the corresponding period that may have affected the observation or caused a missing value."@en;
                      skos:inScheme sdmx-code:obsStatus;
                      skos:notation "S";
                      skos:prefLabel "Strike"@en;
                      skos:topConceptOf sdmx-code:obsStatus.
sdmx-code:sex a sdmx:CodeList,
                skos:ConceptScheme;
              rdfs:label "Code list for Sex (SEX) - codelist scheme"@en;
              rdfs:seeAlso sdmx-code:Sex;
              skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
              skos:hasTopConcept sdmx-code:sex-U,
                                 sdmx-code:sex-M,
                                 sdmx-code:sex-F,
                                 sdmx-code:sex-N,
                                 sdmx-code:sex-T;
              skos:notation "CL_SEX";
              skos:note "This  code list provides the gender."@en;
              skos:prefLabel "Code list for Sex (SEX) - codelist scheme"@en.
sdmx-code:sex-F a sdmx-code:Sex,
                  sdmx:Concept,
                  skos:Concept;
                skos:inScheme sdmx-code:sex;
                skos:notation "F";
                skos:prefLabel "Female"@en;
                skos:topConceptOf sdmx-code:sex.
sdmx-code:sex-M a sdmx-code:Sex,
                  sdmx:Concept,
                  skos:Concept;
                skos:inScheme sdmx-code:sex;
                skos:notation "M";
                skos:prefLabel "Male"@en;
                skos:topConceptOf sdmx-code:sex.
sdmx-code:sex-N a sdmx-code:Sex,
                  sdmx:Concept,
                  skos:Concept;
                skos:inScheme sdmx-code:sex;
                skos:notation "N";
                skos:prefLabel "Not applicable"@en;
                skos:topConceptOf sdmx-code:sex.
sdmx-code:sex-T a sdmx-code:Sex,
                  sdmx:Concept,
                  skos:Concept;
                skos:inScheme sdmx-code:sex;
                skos:notation "T";
                skos:prefLabel "Total"@en;
                skos:topConceptOf sdmx-code:sex.
sdmx-code:sex-U a sdmx-code:Sex,
                  sdmx:Concept,
                  skos:Concept;
                skos:inScheme sdmx-code:sex;
                skos:notation "U";
                skos:prefLabel "Not specified or unknown"@en;
                skos:topConceptOf sdmx-code:sex.
sdmx-code:timeFormat a skos:ConceptScheme,
                       sdmx:CodeList;
                     rdfs:label "Code list for the Time Format as written in the SDMX-EDI and SDMX-ML messages - codelist scheme"@en;
                     rdfs:seeAlso sdmx-code:TimeFormat;
                     skos:definition <http://sdmx.org/wp-content/uploads/2009/01/02_sdmx_cog_annex_2_cl_2009.pdf>;
                     skos:hasTopConcept sdmx-code:timeFormat-708,
                                        sdmx-code:timeFormat-604,
                                        sdmx-code:timeFormat-710,
                                        sdmx-code:timeFormat-102,
                                        sdmx-code:timeFormat-P3M,
                                        sdmx-code:timeFormat-719,
                                        sdmx-code:timeFormat-PT1M,
                                        sdmx-code:timeFormat-P6M,
                                        sdmx-code:timeFormat-610,
                                        sdmx-code:timeFormat-608,
                                        sdmx-code:timeFormat-602,
                                        sdmx-code:timeFormat-P1D,
                                        sdmx-code:timeFormat-716,
                                        sdmx-code:timeFormat-P1Y,
                                        sdmx-code:timeFormat-P1M,
                                        sdmx-code:timeFormat-616,
                                        sdmx-code:timeFormat-203,
                                        sdmx-code:timeFormat-704,
                                        sdmx-code:timeFormat-P7D,
                                        sdmx-code:timeFormat-711,
                                        sdmx-code:timeFormat-702;
                     skos:notation "CL_TIME_FORMAT";
                     skos:note "These codes (based on the ISO 8601 standard) indicate the type of time references used in the data. The numeric codes below (203, 102,...,702) are used only in the SDMX-EDI messages; and the alphanumeric codes (P1D...PT1M) only in the SDMX-ML messages."@en;
                     skos:prefLabel "Code list for the Time Format as written in the SDMX-EDI and SDMX-ML messages - codelist scheme"@en.
sdmx-code:timeFormat-102 a sdmx-code:TimeFormat,
                           sdmx:Concept,
                           skos:Concept;
                         skos:definition """(for daily and business series)
year/month/day"""@en;
                         skos:inScheme sdmx-code:timeFormat;
                         skos:notation "102";
                         skos:prefLabel "CCYYMMDD"@en;
                         skos:topConceptOf sdmx-code:timeFormat.
sdmx-code:timeFormat-203 a sdmx-code:TimeFormat,
                           sdmx:Concept,
                           skos:Concept;
                         skos:definition """(for series with freq. higher than daily)
year/month/day/hours/minutes"""@en;
                         skos:inScheme sdmx-code:timeFormat;
                         skos:notation "203";
                         skos:prefLabel "CCYYMMDDhhmm"@en;
                         skos:topConceptOf sdmx-code:timeFormat.
sdmx-code:timeFormat-602 a sdmx-code:TimeFormat,
