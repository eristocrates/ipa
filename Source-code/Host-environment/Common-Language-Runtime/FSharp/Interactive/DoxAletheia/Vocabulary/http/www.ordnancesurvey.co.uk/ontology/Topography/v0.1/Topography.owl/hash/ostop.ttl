@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ostop: <http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Definition> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Purpose> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Scope> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ordnancesurvey.co.uk/ontology/Topography/v0.1/Topography.owl> <http://purl.org/dc/elements/1.1/creator> "Glen Hart and Cathy Dolbear";
                                                                          <http://purl.org/dc/elements/1.1/date> "24/02/2008";
                                                                          <http://purl.org/dc/elements/1.1/publisher> "Ordnance Survey";
                                                                          <http://purl.org/dc/elements/1.1/rights> "Crown Copyright 2008";
                                                                          <http://purl.org/dc/elements/1.1/title> "Topography Ontology";
                                                                          <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Purpose> "The general purpose of a this ontology is to provide a library of high level concepts that are used by the other modules within the whole OS Topographic ontology.  The ontology also describes the relationships  and instances common to more than one module.";
                                                                          <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Scope> "General high level classifications of topographic features surveyed by Ordnance Survey.";
                                                                          a <http://www.w3.org/2002/07/owl#Ontology>;
                                                                          rdfs:comment "This ontology is still under construction";
                                                                          <http://www.w3.org/2002/07/owl#imports> <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl>,
                                                                                                                  <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl>;
                                                                          <http://www.w3.org/2002/07/owl#versionInfo> "V0.1".
ostop:EconomicActivity a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Secondary concept";
                       rdfs:subClassOf ostop:Purpose.
ostop:English_County a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "English County";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> ostop:england ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     ostop:Traditional_County.
ostop:Footprint a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Footprint";
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ostop:Holding a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label """\"Holding\"""";
              rdfs:subClassOf ostop:Purpose.
ostop:Industry <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> "Secondary concept";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Industry";
               rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ostop:Purpose <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> "Purpose is a secondary concept.";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Purpose";
              rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ostop:Storage a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Storage",
                         "Secondary concept";
              rdfs:subClassOf ostop:Purpose.
ostop:Structure a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Structure";
                rdfs:subClassOf ostop:TopographicObject.
ostop:Surface <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> "Surface is a secondary concept.";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Surface";
              rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ostop:TopographicObject a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "Topographic Object".
ostop:Traditional_County a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label """\"Traditional County\"""";
                         rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
ostop:Transport <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> "Secondary concept";
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label """\"Transport\"""";
                rdfs:subClassOf ostop:Purpose.
ostop:UK_Country a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "UK Country";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> ostop:uk ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> <http://www.ordnancesurvey.co.uk/ontology/MereologicalRelations/v0.2/MereologicalRelations.owl#isPartOf> ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 <http://www.w3.org/2002/07/owl#Thing>.
ostop:contains <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> """The relationship \"contains\" is the complement of \"is contained in\".""";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "contains";
               <http://www.w3.org/2002/07/owl#inverseOf> ostop:isContainedIn.
ostop:earths_surface a ostop:Surface.
ostop:enables <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Definition> "allows something to happen but not necessairly by design.";
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:label "enables".
ostop:england a ostop:UK_Country.
ostop:hasFootprint <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Definition> "Occupies a physical area of the terrain's surface.";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:label "has footprint";
                   rdfs:range ostop:Footprint.
ostop:hasName <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Definition> "Possesses a name.";
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:label "has name".
ostop:hasPurpose <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> """The relationship \"has purpose is\" a special type of the relationship \"enables\".""";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "has purpose";
                 rdfs:subPropertyOf ostop:enables.
ostop:isContainedIn <http://www.ordnancesurvey.co.uk/ontology/Rabbit/v1.0/Rabbit.owl#Rabbit> """The relationship \"is contained in\" is the inverse of \"contains\".""";
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:label "is contained in".
ostop:scotland a ostop:UK_Country.
ostop:somerset a ostop:English_County.
ostop:united_kingdom <http://www.w3.org/2002/07/owl#sameAs> ostop:uk.
ostop:wales a ostop:UK_Country.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
