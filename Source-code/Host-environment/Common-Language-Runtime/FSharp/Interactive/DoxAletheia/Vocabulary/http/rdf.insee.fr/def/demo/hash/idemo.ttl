@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix idemo: <http://rdf.insee.fr/def/demo#>.

<http://rdf.insee.fr/def/demo> <http://creativecommons.org/ns#license> <http://www.data.gouv.fr/Licence-Ouverte-Open-Licence>;
                               <http://purl.org/dc/elements/1.1/rights> "Copyright © 2013 INSEE";
                               <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Franck Cotton" ; 
                                                                   a <http://xmlns.com/foaf/0.1/Person>],
                                                                  [<http://xmlns.com/foaf/0.1/name> "Franck Cotton" ; 
                                                                   a <http://xmlns.com/foaf/0.1/Person>];
                               <http://purl.org/dc/terms/description> "Ontologie des classes et propriétés utilisées pour la démographie, notamment le recensement de la population"@fr;
                               <http://purl.org/dc/terms/issued> "2012-08-14";
                               <http://purl.org/dc/terms/modified> "2012-12-26";
                               <http://purl.org/dc/terms/publisher> <http://dbpedia.org/resource/INSEE>;
                               <http://purl.org/dc/terms/title> "Ontologie démographique de l'INSEE"@fr;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "idemo";
                               <http://purl.org/vocab/vann/preferredNamespaceUri> idemo:;
                               <http://purl.org/vocommons/voaf#classNumber> 1 ;
                               <http://purl.org/vocommons/voaf#propertyNumber> 5 ;
                               a <http://www.w3.org/2002/07/owl#Ontology>,
                                 <http://purl.org/vocommons/voaf#Vocabulary>;
                               <http://www.w3.org/2002/07/owl#versionInfo> "Version 0.3 - 2012-12-26".
idemo:PopulationLegale a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Population légale datée et déclinée en 'municipale', 'comptée à part' et 'totale'"@fr;
                       rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
                       rdfs:label "Population légale"@fr.
idemo:date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain idemo:PopulationLegale;
           rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
           rdfs:label "date de référence"@fr;
           rdfs:range xsd:date.
idemo:population a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain <http://rdf.insee.fr/def/geo#TerritoireFrancais>;
                 rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
                 rdfs:label "population"@fr;
                 rdfs:range idemo:PopulationLegale.
idemo:populationCompteeAPart a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain idemo:PopulationLegale;
                             rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
                             rdfs:label "population comptée à part"@fr;
                             rdfs:range xsd:nonNegativeInteger;
                             <http://www.w3.org/ns/adms#relatedWebPage> <http://insee.fr/fr/methodes/definitions/popul-comptee-a-part-rrp.htm>.
idemo:populationMunicipale a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain idemo:PopulationLegale;
                           rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
                           rdfs:label "population municipale"@fr;
                           rdfs:range xsd:nonNegativeInteger;
                           <http://www.w3.org/ns/adms#relatedWebPage> <http://insee.fr/fr/methodes/definitions/population-municipale-rrp.htm>.
idemo:populationTotale a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain idemo:PopulationLegale;
                       rdfs:isDefinedBy <http://rdf.insee.fr/def/demo>;
                       rdfs:label "population totale"@fr;
                       rdfs:range xsd:nonNegativeInteger;
                       <http://www.w3.org/ns/adms#relatedWebPage> <http://insee.fr/fr/methodes/definitions/population-totale-rrp.htm>.
<http://rdf.insee.fr/def/geo#TerritoireFrancais> a <http://www.w3.org/2002/07/owl#Class>.
