@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pne: <http://data.press.net/ontology/event/>.

pne: <http://purl.org/dc/terms/created> "2011-07-28"^^xsd:date;
     <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-nd/3.0/>;
     <http://purl.org/dc/terms/modified> "2012-04-20"^^xsd:date;
     <http://purl.org/dc/terms/title> "SNaP Event Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "The Event Ontology models news-worthy events and their relationship to news assets and stuff (simple entities) in the world."@en;
     <http://www.w3.org/2002/07/owl#versionInfo> "0.5.0";
     <http://xmlns.com/foaf/0.1/maker> <http://uk.linkedin.com/in/pauliharman>,
                                       <http://uk.linkedin.com/in/paulwilton>,
                                       <http://uk.linkedin.com/in/jarredmcginnis>.
pne:Event a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Generic Event Class, a subclass of event:Event. The Event class also subclasses pnt:Stuff as it is a Compound domain entity, this inheritance means news assets can be tagged with Events"@en;
          rdfs:isDefinedBy pne:;
          rdfs:label "Generic Event Class"@en;
          rdfs:subClassOf <http://data.press.net/ontology/stuff/Stuff>,
                          <http://purl.org/NET/c4dm/event.owl#Event>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pne:subEventOf a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:comment "Transitive Property defining a parent-child relationship between events. Event Y is a sub event of Event X"@en;
               rdfs:domain pne:Event;
               rdfs:isDefinedBy pne:;
               rdfs:label "Transitive Property defining a parent-child relationship between events"@en;
               rdfs:range pne:Event;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pne:summary a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "Property for expressing an event summary. Datatype is String"@en;
            rdfs:domain pne:Event;
            rdfs:isDefinedBy pne:;
            rdfs:label "An Event summary"@en;
            rdfs:range xsd:string;
            rdfs:subPropertyOf <http://data.press.net/ontology/stuff/comment>,
                               <http://purl.org/dc/terms/abstract>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pne:theme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "Property for expressing the theme of an event, its range is pns:Intangible"@en;
          rdfs:domain pne:Event;
          rdfs:isDefinedBy pne:;
          rdfs:label "Associates an Event with an intangible theme"@en;
          rdfs:range <http://data.press.net/ontology/stuff/Intangible>;
          rdfs:subPropertyOf <http://data.press.net/ontology/stuff/notablyAssociatedWith>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pne:title a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Property for expressing an event title. Datatype is String"@en;
          rdfs:domain pne:Event;
          rdfs:isDefinedBy pne:;
          rdfs:label "An Event title"@en;
          rdfs:range xsd:string;
          rdfs:subPropertyOf <http://data.press.net/ontology/stuff/label>,
                             <http://purl.org/dc/terms/title>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
<http://uk.linkedin.com/in/jarredmcginnis> a <http://xmlns.com/foaf/0.1/Person>;
                                           <http://xmlns.com/foaf/0.1/name> "Jarred McGinnis".
<http://uk.linkedin.com/in/pauliharman> a <http://xmlns.com/foaf/0.1/Person>;
                                        <http://xmlns.com/foaf/0.1/name> "Paul Harman".
<http://uk.linkedin.com/in/paulwilton> a <http://xmlns.com/foaf/0.1/Person>;
                                       <http://xmlns.com/foaf/0.1/name> "Paul Wilton".
