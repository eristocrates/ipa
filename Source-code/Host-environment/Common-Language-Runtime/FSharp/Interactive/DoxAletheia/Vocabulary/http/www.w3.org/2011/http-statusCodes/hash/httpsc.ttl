rfc:rfc2518.txt dct:identifier "http://www.ietf.org/rfc/rfc2518.txt";
                dct:title "HTTP Extensions for Distributed Authoring -- WEBDAV"@en.
rfc:rfc2616.txt dct:identifier "http://www.ietf.org/rfc/rfc2616.txt";
                dct:title "Hypertext Transfer Protocol -- HTTP/1.1"@en.
rfc:rfc2774.txt dct:identifier "http://www.ietf.org/rfc/rfc2774.txt";
                dct:title "An HTTP Extension Framework"@en.
