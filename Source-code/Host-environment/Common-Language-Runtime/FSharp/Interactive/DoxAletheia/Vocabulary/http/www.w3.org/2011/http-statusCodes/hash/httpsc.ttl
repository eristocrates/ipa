httpsc:StatusCode1xx a rdfs:Class;
                     rdfs:comment "A status code starting with 1"@en;
                     rdfs:label "Informational"@en.
httpsc:StatusCode2xx a rdfs:Class;
                     rdfs:comment "A status code starting with 2"@en;
                     rdfs:label "Successful"@en.
