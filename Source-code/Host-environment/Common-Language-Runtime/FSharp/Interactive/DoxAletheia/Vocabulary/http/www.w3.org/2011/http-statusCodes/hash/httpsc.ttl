                dct:title "Delta encoding in HTTP"@en.
rfc:rfc4918.txt dct:identifier "http://www.ietf.org/rfc/rfc4918.txt";
                dct:title "HTTP Extensions for Distributed Authoring - WebDAV"@en.
httpsc:Accepted dct:title "Accepted"@en;
                a http:StatusCode,
                  httpsc:StatusCode2xx;
                rdfs:isDefinedBy rfc:rfc2616.txt;
                http:statusCodeNumber "202".
