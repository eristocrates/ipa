@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix pbo: <http://purl.org/ontology/pbo/core#>.

pbo: <http://purl.org/dc/elements/1.1/creator> <http://foaf.me/zazi#me>,
                                               <http://kurtisrandom.com/foaf.rdf#kurtjx>;
     <http://purl.org/dc/elements/1.1/date> "2010-09-13T18:31:52+01:00"^^xsd:dateTime;
     <http://purl.org/dc/elements/1.1/description> """The Play Back Ontology specification provides basic concepts and properties 
for describing concepts that are related to the play back domain, e.g. an playlist, play back count and skip counter 
on/ for the Semantic Web. This document contains a RDF description of the Play Back Ontology."""@en;
     <http://purl.org/dc/elements/1.1/title> "The Play Back Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#imports> <http://purl.org/NET/c4dm/event.owl>,
                                             <http://purl.org/ontology/bibo/>,
                                             <http://purl.org/ontology/olo/core>,
                                             <http://purl.org/ontology/similarity/>,
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns>,
                                             <http://purl.org/vocab/frbr/core>,
                                             <http://purl.org/ontology/co/core>,
                                             <http://purl.org/dc/elements/1.1/>;
     <http://www.w3.org/2002/07/owl#versionInfo> 0.6.
pbo:FixedPlaylist a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """A (sub) playlist of a fixed length and a fixed order. This concept should be used to express static relations, 
e.g. \"those three music tracks must always be played in a row\"."""@en;
                  rdfs:isDefinedBy pbo:;
                  rdfs:label "Fixed Playlist"@en;
                  rdfs:subClassOf pbo:Playlist;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
pbo:MediaActionCounter a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A media action counter. Media actions are for example play back or skip events.";
                       rdfs:isDefinedBy pbo:;
                       rdfs:label "Media Action Counter"@en;
                       rdfs:subClassOf <http://purl.org/ontology/co/core#Counter>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
pbo:PlayBackCounter a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A play back counter, e.g. to count the playback of a media object.";
                    rdfs:isDefinedBy pbo:;
                    rdfs:label "Play Back Counter"@en;
                    rdfs:subClassOf pbo:MediaActionCounter;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
pbo:Playlist a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A playlist of specific media items, e.g. music tracks, videos or slides."@en;
             rdfs:isDefinedBy pbo:;
             rdfs:label "Playlist"@en;
             rdfs:subClassOf <http://purl.org/ontology/olo/core#OrderedList>,
                             <http://purl.org/ontology/bibo/Document>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
pbo:PlaylistSlot a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """A playlist slot. It could contain e.g. a music track, a video or a slide, and maybe related with some 
additional properties. However, it could maybe also included a \"sub\" playlist, e.g. to keep a fixed sequence of some tracks."""@en;
                 rdfs:isDefinedBy pbo:;
                 rdfs:label "Playlist Slot"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> pbo:playlist_item ; 
                                  <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 <http://purl.org/ontology/olo/core#Slot>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
pbo:SkipCounter a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A skip counter, e.g. to count skip events of a media object.";
                rdfs:isDefinedBy pbo:;
                rdfs:label "Skip Counter";
                rdfs:subClassOf pbo:MediaActionCounter;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
pbo:SkipEvent a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A specific skip event of something.";
              rdfs:isDefinedBy pbo:;
              rdfs:label "Skip Event";
              rdfs:subClassOf <http://purl.org/ontology/co/core#ScrobbleEvent>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pbo:media_object a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Associates a media object to its related counter."@en;
                 rdfs:domain pbo:MediaActionCounter;
                 rdfs:isDefinedBy pbo:;
                 rdfs:label "has media object"@en;
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                      <http://purl.org/vocab/frbr/core#Endeavour>) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:subPropertyOf <http://purl.org/ontology/co/core#object>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
pbo:media_scrobble_object a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "A media specific scrobble object, e.g. a music track or a video."@en;
                          rdfs:isDefinedBy pbo:;
                          rdfs:label "has media scrobble object"@en;
                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                               <http://purl.org/vocab/frbr/core#Endeavour>) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:subPropertyOf <http://purl.org/ontology/co/core#scrobble_object>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
pbo:playlist a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Associates a playlist to something."@en;
             rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
             rdfs:isDefinedBy pbo:;
             rdfs:label "has playlist"@en;
             rdfs:range pbo:Playlist;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
pbo:playlist_item a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """A specific playlist item, e.g. a music track, video or slides. The range types of this property must be 
based on bibo:Document or frbr:Endeavour (to keep it somehow media based)."""@en;
                  rdfs:domain pbo:PlaylistSlot;
                  rdfs:isDefinedBy pbo:;
                  rdfs:label "has playlist item"@en;
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                       <http://purl.org/vocab/frbr/core#Endeavour>) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf <http://purl.org/ontology/olo/core#item>;
                  <http://www.w3.org/2002/07/owl#inverseOf> [rdfs:label "is playlist item of"@en ; 
                                                             a <http://www.w3.org/2002/07/owl#ObjectProperty>];
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
pbo:playlist_slot a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "A specific slot in a playlist."@en;
                  rdfs:domain pbo:Playlist;
                  rdfs:label "has playlist slot"@en;
                  rdfs:range pbo:PlaylistSlot;
                  rdfs:subPropertyOf <http://purl.org/ontology/olo/core#slot>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
pbo:skip_time a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The moment, when someone skipped the media object, e.g. an instant of a timeline of an audio signal.";
              rdfs:domain pbo:SkipEvent;
              rdfs:isDefinedBy pbo:;
              rdfs:label "has skip time";
              rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#time>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
pbo:transition a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This relation directs to a description of a transition between two neighbouring playlist slots, e.g. two successive music tracks in a dj mix."@en;
               rdfs:domain pbo:PlaylistSlot;
               rdfs:isDefinedBy pbo:;
               rdfs:label "has transition"@en;
               rdfs:subPropertyOf <http://purl.org/ontology/similarity/association>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
