@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix odpart: <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#>.
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/participation.owl> cpa:coversRequirements "Which objects do participate in this event? Which events do this object participate in?";
                                                                 cpa:extractedFrom "http://ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                                 cpa:hasConsequences """It is possible to model whatever relation between objects and events. Using cardinality restrictions appropriately allows to limit the number of participants, e.g. 'life of' is a specialization of this pattern that requires a functional object property (cardinality 1. . .1).
This is a non-temporal version of the particpation relation. If we need a time-indexed relation, use http://ontologydesignpatterns.owl/cp/owl/timeindexedparticipation.owl""";
                                                                 cpa:hasIntent "To represent participation of an object in an event.";
                                                                 cpa:relatedCPs """Co-participation allows to model the relation between two objects that 
par ticipate in a same event (implicitly); n-ary participation allows to model par ticipation over different dimensions e.g., temporal, spatial, etc., as well as explicitly relate more than one object to the same event; object role, n-ary classiﬁcation are examples of CPs that can be composed with this CP.""",
                                                                                "Time indexed participation"^^rdf:PlainLiteral;
                                                                 cpa:scenarios "Aldo Gangemi participated in the premiere of La Dolce Vita.";
                                                                 a owl:Ontology;
                                                                 rdfs:comment """The basic participation pattern, without temporal indexing. 
It clones equivalent elements from DOLCE-UltraLite."""^^rdf:PlainLiteral;
                                                                 rdfs:label "participation"^^rdf:PlainLiteral;
                                                                 owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                                 owl:versionInfo """1.1
- Improved annotation
1.0 
- Created by Aldo Gangemi and Valentina Presutti""",
                                                                                 "1.1 added rdfs:isDefinedBy for all named entities".
odpart:Event a owl:Class;
             rdfs:comment "Any physical, social, or mental process, event, or state.";
             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/participation.owl>;
             rdfs:label "Event"@en;
             rdfs:subClassOf [owl:someValuesFrom odpart:Object ; 
                              owl:onProperty odpart:hasParticipant ; 
                              a owl:Restriction];
             owl:disjointWith odpart:Object.
odpart:Object a owl:Class;
              rdfs:comment "Any physical, social, or mental object, or substance";
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/participation.owl>;
              rdfs:label "Object"@en;
              rdfs:subClassOf [owl:someValuesFrom odpart:Event ; 
                               owl:onProperty odpart:isParticipantIn ; 
                               a owl:Restriction].
odpart:hasParticipant a owl:ObjectProperty;
                      rdfs:domain odpart:Event;
                      rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/participation.owl>;
                      rdfs:label "has participant"@en;
                      rdfs:range odpart:Object;
                      owl:inverseOf odpart:isParticipantIn.
odpart:isParticipantIn a owl:ObjectProperty;
                       rdfs:domain odpart:Object;
                       rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/participation.owl>;
                       rdfs:label "is participant in"@en;
                       rdfs:range odpart:Event.
cpa:coversRequirements a owl:AnnotationProperty.
cpa:extractedFrom a owl:AnnotationProperty.
cpa:hasConsequences a owl:AnnotationProperty.
cpa:hasIntent a owl:AnnotationProperty.
cpa:relatedCPs a owl:AnnotationProperty.
cpa:scenarios a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
