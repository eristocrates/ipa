@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dady: <http://purl.org/NET/dady#>.

dady:AtomUpdateSource a rdfs:Class,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "an update source offering updates as Atom feeds";
                      rdfs:subClassOf dady:UpdateSource.
dady:ChangeSetUpdateSource a rdfs:Class,
                             <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "an update source offering updates as Talis' Changesets";
                           rdfs:subClassOf dady:UpdateSource.
dady:HighFrequentUpdates a rdfs:Class,
                           <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "the dataset is updated high-frequently, i.e., once a day or more frequent";
                         rdfs:label "high-frequent updates";
                         rdfs:subClassOf dady:UpdateFrequency.
dady:IrregularUpdates a rdfs:Class,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "the dataset is updated in irregular, non-predictable time intervals";
                      rdfs:label "irregular updates";
                      rdfs:subClassOf dady:UpdateRegularity.
dady:LowFrequentUpdates a rdfs:Class,
                          <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "the dataset is updated low-frequently, i.e., once a year or less frequent";
                        rdfs:label "low-frequent updates";
                        rdfs:subClassOf dady:UpdateFrequency.
dady:MidFrequentUpdates a rdfs:Class,
                          <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "the dataset is updated mid-frequently, i.e., from once a week to a couple of months";
                        rdfs:label "mid-frequent updates";
                        rdfs:subClassOf dady:UpdateFrequency.
dady:NoUpdates a rdfs:Class,
                 <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "the dataset is never updated";
               rdfs:label "no updates";
               rdfs:subClassOf dady:UpdateFrequency.
dady:RegularUpdates a rdfs:Class,
                      <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "the dataset is updated in regular time intervals";
                    rdfs:label "regular updates";
                    rdfs:subClassOf dady:UpdateRegularity.
dady:TriplifyUpdateSource a rdfs:Class,
                            <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "an update source offering updates as Triplify's Updates";
                          rdfs:subClassOf dady:UpdateSource.
dady:UpdateDynamics a rdfs:Class,
                      <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "dataset update dynamics".
dady:UpdateFrequency a rdfs:Class,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "update frequency";
                     rdfs:subClassOf dady:UpdateDynamics.
dady:UpdateRegularity a rdfs:Class,
                        <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "update regularity";
                      rdfs:subClassOf dady:UpdateDynamics.
dady:UpdateSource a rdfs:Class,
                    <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "update source".
dady:dynamics a rdf:Property;
              rdfs:label "dataset has update dynamics";
              rdfs:range dady:UpdateDynamics.
dady:notification a rdf:Property;
                  rdfs:domain dady:UpdateSource;
                  rdfs:label "has update notification".
dady:update a rdf:Property;
            rdfs:domain dady:UpdateDynamics;
            rdfs:label "offers update source";
            rdfs:range dady:UpdateSource.
<http://vocab.deri.ie/dady> <http://purl.org/dc/elements/1.1/creator> <http://vocab.deri.ie/dady#Michael%20Hausenblas>;
                            <http://purl.org/dc/terms/created> "2010-01-27"^^xsd:date;
                            <http://purl.org/dc/terms/description> "A vocabulary that allows for coarse-grained descriptions of the data-source dynamics as well as the discovery of change notification mechanism(s).";
                            <http://purl.org/dc/terms/modified> "2010-01-27"^^xsd:date;
                            <http://purl.org/dc/terms/partOf> <http://vocab.deri.ie/>;
                            <http://purl.org/dc/terms/publisher> "http://vocab.deri.ie/dady#LiDRC";
                            <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                            <http://purl.org/dc/terms/title> "Dataset Dynamics (dady) vocabulary";
                            <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                            <http://purl.org/vocab/vann/preferredNamespacePrefix> "dady";
                            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/NET/dady#";
                            a <http://www.w3.org/2002/07/owl#Ontology>,
                              <http://www.w3.org/ns/adms#SemanticAsset>;
                            <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/dady.html>.
<http://vocab.deri.ie/dady#LiDRC> a <http://purl.org/dc/terms/Agent>;
                                  <http://xmlns.com/foaf/0.1/homepage> <http://linkeddata.deri.ie/>;
                                  <http://xmlns.com/foaf/0.1/member> <http://vocab.deri.ie/dady#Michael%20Hausenblas>;
                                  <http://xmlns.com/foaf/0.1/name> "LiDRC".
<http://vocab.deri.ie/dady#Michael%20Hausenblas> a <http://xmlns.com/foaf/0.1/Person>;
                                                 <http://xmlns.com/foaf/0.1/homepage> <http://sw-app.org/about.html>;
                                                 <http://xmlns.com/foaf/0.1/mbox> <mailto:michael.hausenblas@deri.org>;
                                                 <http://xmlns.com/foaf/0.1/name> "Michael Hausenblas".
<http://vocab.deri.ie/dady#rdf> <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/dady>;
                                a <http://www.w3.org/ns/adms#SemanticDistribution>;
                                <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/dady.rdf";
                                <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
<http://vocab.deri.ie/dady#ttl> <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/dady>;
                                a <http://www.w3.org/ns/adms#SemanticDistribution>;
                                <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/dady.ttl";
                                <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
