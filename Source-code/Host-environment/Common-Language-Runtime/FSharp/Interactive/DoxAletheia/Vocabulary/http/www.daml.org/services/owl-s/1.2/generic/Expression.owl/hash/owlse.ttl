@base <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix swrl: <http://www.w3.org/2003/11/swrl#>.
@prefix drs: <http://cs-www.cs.yale.edu/homes/dvm/daml/drsonto040520.owl#>.
@prefix : <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#>.
@prefix owlse: <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#>.

drs:Formula a owl:Class.
<http://www.daml.org/services/owl-s/1.2/generic/Expression.owl> a owl:Ontology;
                                                                rdfs:comment """
    Ontology elements for capturing conditions, effects
  """;
                                                                owl:versionInfo """
    $Id: Expression.owl,v 1.30 2006/01/04 07:54:55 martin Exp $
  """.
:AlwaysTrue a :Condition,
              [a owl:Restriction ; 
               owl:onProperty :expressionObject ; 
               owl:cardinality "0"],
              [a owl:Restriction ; 
               owl:onProperty :expressionData ; 
               owl:cardinality "0"];
            rdfs:comment """
    We add the 0 cardinality specs simply to ensure that no system can
    define those properties for this instance.
  """.
:Condition a owl:Class;
           rdfs:label "Condition";
           rdfs:subClassOf :Expression.
:DRS :refURI "http://cs-www.cs.yale.edu/homes/dvm/daml/drsonto040520.owl"^^xsd:anyURI;
     a :LogicLanguage.
:DRS-Condition a owl:Class;
               rdfs:subClassOf :DRS-Expression,
                               :Condition.
:DRS-Expression a owl:Class;
                rdfs:subClassOf :UnquotedExpression,
                                [a owl:Restriction ; 
                                 owl:onProperty :expressionLanguage ; 
                                 owl:hasValue :DRS],
                                [a owl:Restriction ; 
                                 owl:onProperty :expressionObject ; 
                                 owl:allValuesFrom drs:Formula].
:Expression a owl:Class;
            rdfs:subClassOf [a owl:Restriction ; 
                             owl:onProperty :expressionLanguage ; 
                             owl:cardinality "1"^^xsd:nonNegativeInteger].
:KIF :refURI "http://logic.stanford.edu/kif/kif.html"^^xsd:anyURI;
     a :LogicLanguage.
:KIF-Condition a owl:Class;
               rdfs:subClassOf :KIF-Expression,
                               :Condition.
:KIF-Expression a owl:Class;
                rdfs:subClassOf :QuotedExpression,
                                [a owl:Restriction ; 
                                 owl:onProperty :expressionLanguage ; 
                                 owl:hasValue :KIF].
:LogicLanguage a owl:Class;
               rdfs:comment """
    An instance of this class represents a particular logical formalism,
    such as KIF, SWRL, or DRS.  At present we allow for zero or more
    URIs to be specified, which normally are references to public document(s) 
    that define the formalism.  We anticipate a variety of other properties 
    will be added as the requirements become better understood.
  """.
:QuotedExpression a owl:Class;
                  rdfs:subClassOf :Expression,
                                  [a owl:Restriction ; 
                                   owl:onProperty :expressionData ; 
                                   owl:cardinality "1"^^xsd:nonNegativeInteger];
                  owl:disjointWith :UnquotedExpression.
:RDQL :refURI "http://www.w3.org/Submission/2004/SUBM-RDQL-20040109/"^^xsd:anyURI;
      a :LogicLanguage.
:RDQL-Condition a owl:Class;
                rdfs:subClassOf :RDQL-Expression,
                                :Condition.
:RDQL-Expression a owl:Class;
                 rdfs:subClassOf :QuotedExpression,
                                 [a owl:Restriction ; 
                                  owl:onProperty :expressionLanguage ; 
                                  owl:hasValue :RDQL].
:SPARQL :refURI "http://www.w3.org/TR/rdf-sparql-query/"^^xsd:anyURI;
        a :LogicLanguage.
:SPARQL-Condition a owl:Class;
                  rdfs:subClassOf :SPARQL-Expression,
                                  :Condition.
:SPARQL-Expression a owl:Class;
                   rdfs:subClassOf :QuotedExpression,
                                   [a owl:Restriction ; 
                                    owl:onProperty :expressionLanguage ; 
                                    owl:hasValue :SPARQL].
:SWRL :refURI "http://www.w3.org/2003/11/swrl"^^xsd:anyURI;
      a :LogicLanguage.
:SWRL-Condition a owl:Class;
                rdfs:subClassOf :SWRL-Expression,
                                :Condition.
:SWRL-Expression a owl:Class;
                 rdfs:subClassOf :UnquotedExpression,
                                 [a owl:Restriction ; 
                                  owl:onProperty :expressionLanguage ; 
                                  owl:hasValue :SWRL],
                                 [a owl:Restriction ; 
                                  owl:onProperty :expressionObject ; 
                                  owl:allValuesFrom swrl:AtomList].
:SWRL-FOL :refURI "http://www.w3.org/Submission/2005/01/"^^xsd:anyURI;
          a :LogicLanguage.
:SWRL-FOL-Condition a owl:Class;
                    rdfs:subClassOf :SWRL-FOL-Expression,
                                    :Condition.
:SWRL-FOL-Expression a owl:Class;
                     rdfs:subClassOf :QuotedExpression,
                                     [a owl:Restriction ; 
                                      owl:onProperty :expressionLanguage ; 
                                      owl:hasValue :SWRL-FOL].
:UnquotedExpression a owl:Class;
                    rdfs:subClassOf :Expression,
                                    [a owl:Restriction ; 
                                     owl:onProperty :expressionObject ; 
                                     owl:cardinality "1"^^xsd:nonNegativeInteger].
:VariableBinding a owl:Class;
                 rdfs:comment """
    This class is used to define a correspondence between a variable
    mentioned in an quoted expression and an OWL instance.  This is
    useful with expression languages in which the variables
    can't be identified using URIs.
  """;
                 rdfs:subClassOf [a owl:Restriction ; 
                                  owl:onProperty :theVariable ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger],
                                 [a owl:Restriction ; 
                                  owl:onProperty :theObject ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger].
:expressionBody a owl:DatatypeProperty;
                rdfs:comment "same as expressionData; for backwards compatibility";
                owl:equivalentProperty :expressionData.
:expressionData a owl:DatatypeProperty;
                rdfs:comment """
    This property is used to refer to an \"quoted\" (literal) expression body.
  """;
                rdfs:domain :QuotedExpression.
:expressionLanguage a owl:ObjectProperty;
                    rdfs:domain :Expression;
                    rdfs:range :LogicLanguage.
:expressionObject a owl:ObjectProperty;
                  rdfs:comment """
    This property is used to refer to an \"unquoted\" expression body.
  """;
                  rdfs:domain :UnquotedExpression.
:refURI a owl:DatatypeProperty;
        rdfs:domain :LogicLanguage;
        rdfs:range xsd:anyURI.
:theObject a owl:ObjectProperty;
           rdfs:comment """
    The range is not defined, and so the value of this property can
    be any OWL instance.
    When used to bind an OWL-S process precondition variable, however, 
    the value of this property must be an instance of process:Parameter.
  """;
           rdfs:domain :VariableBinding.
:theVariable a owl:DatatypeProperty;
             rdfs:comment """
    The value of this property is a substring of a QuotedExpression.
    The substring represents a variable in the language of the 
    QuotedExpression.  For example, if the QuotedExpression is in KIF, 
    the substring would be something like \"?a\".
  """;
             rdfs:domain :VariableBinding.
:variableBinding a owl:ObjectProperty;
                 rdfs:domain :QuotedExpression;
                 rdfs:range :VariableBinding.
swrl:AtomList a owl:Class.
