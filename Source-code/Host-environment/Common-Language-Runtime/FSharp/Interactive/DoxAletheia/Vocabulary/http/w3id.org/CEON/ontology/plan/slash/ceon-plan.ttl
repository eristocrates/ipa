@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ceon-plan: <http://w3id.org/CEON/ontology/plan/>.

ceon-plan: <http://purl.org/dc/terms/contributor> "Eva Blomqvist";
           <http://purl.org/dc/terms/created> "2025-06-19"^^xsd:date;
           <http://purl.org/dc/terms/creator> "Huanyu Li";
           <http://purl.org/dc/terms/description> "The Plan module of CEON (Circular Economy Ontology Network).";
           <http://purl.org/dc/terms/issued> "2025-06-30"^^xsd:date;
           <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/";
           <http://purl.org/dc/terms/publisher> "Onto-DESIDE";
           <http://purl.org/dc/terms/title> "Circular Economy Ontology Network (CEON) - Plan Module";
           <http://purl.org/vocab/vann/preferredNamespacePrefix> "ceon-plan";
           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/CEON/ontology/plan/";
           <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: T8-2.",
                                                                                                     "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: T8-2.";
           a <http://www.w3.org/2002/07/owl#Ontology>;
           rdfs:seeAlso <https://github.com/LiUSemWeb/CEON>;
           <http://www.w3.org/2002/07/owl#imports> <http://w3id.org/CEON/ontology/processODP/0.5/>;
           <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/CEON/ontology/plan/0.1/>;
           <http://www.w3.org/2002/07/owl#versionInfo> 0.1.
ceon-plan:Description a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment """A Description is a SocialObject that represents a conceptualization. 
For example, a Plan is a Description of some actions to be executed by agents in a certain way, with certain parameters etc. Descriptions 'define' or 'use' concepts, and can be 'satisfied' by situations.""";
                      rdfs:label "Description".
ceon-plan:Plan a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A Description having an explicit goal, to be achieved by executing the plan.";
               rdfs:label "Plan";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-plan:Plan ; 
                                <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/processODP/hasPart> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               ceon-plan:Description.
ceon-plan:PlanExecution a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Plan executions are situations that proactively satisfy a plan. Subplan executions are proper parts of the whole plan execution.";
                        rdfs:label "Plan Execution";
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-plan:Plan ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> ceon-plan:satisfiesPlan ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        <http://w3id.org/CEON/ontology/processODP/Situation>,
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/processODP/Process> ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/processODP/isSettingFor> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> ceon-plan:PlanExecution ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/processODP/hasPart> ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/processODP/Situation> ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> ceon-plan:followsExecution ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/processODP/Situation> ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> ceon-plan:precedesExecution ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> <http://w3id.org/CEON/ontology/processODP/TimeInterval> ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/processODP/duringTime> ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:dateTime ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> <http://w3id.org/CEON/ontology/processODP/occursAtTime> ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>].
ceon-plan:followsExecution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "The situation after the execution takes place, i.e. the state of affairs after the process event, such as the product being assembled, or the material being recycled.";
                           rdfs:domain ceon-plan:PlanExecution;
                           rdfs:label "follows execution";
                           rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/isSettingFor>.
ceon-plan:hasPlanExecution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "A plan can have specific executions.";
                           rdfs:domain ceon-plan:Plan;
                           rdfs:label "has plan exeution";
                           rdfs:range ceon-plan:PlanExecution;
                           rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
ceon-plan:occursAtTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Represents the time at which something takes place.";
                       rdfs:domain ceon-plan:PlanExecution;
                       rdfs:label "occurs at time";
                       rdfs:range xsd:dateTime.
ceon-plan:precedesExecution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "The situation before the process event takes place, i.e. the state of affairs before the execution, such as the state of the set of components before they are assembled into a product item, or the material state before being recycled.";
                            rdfs:domain ceon-plan:PlanExecution;
                            rdfs:label "precedes execution";
                            rdfs:subPropertyOf <http://w3id.org/CEON/ontology/processODP/isSettingFor>.
ceon-plan:satisfiesPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan.";
                        rdfs:domain <http://w3id.org/CEON/ontology/processODP/Situation>;
                        rdfs:label "satisfies plan";
                        rdfs:range ceon-plan:Description;
                        rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
<http://w3id.org/CEON/ontology/processODP/hasInput> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/processODP/hasOutput> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://w3id.org/CEON/ontology/processODP/occursAtTime> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
