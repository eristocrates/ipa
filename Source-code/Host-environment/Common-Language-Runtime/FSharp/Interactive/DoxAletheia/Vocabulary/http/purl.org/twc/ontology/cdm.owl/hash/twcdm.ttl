@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix twcdm: <http://purl.org/twc/ontology/cdm.owl#>.

twcdm: <http://purl.org/dc/terms/creator> <http://tw.rpi.edu/instances/TimLebo>;
       <http://purl.org/dc/terms/date> "2011-09-23";
       <http://purl.org/dc/terms/description> "";
       <http://purl.org/dc/terms/title> "Conceptual Depth and Momentum";
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "cdm";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/twc/ontology/cdm.owl#";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:comment "";
       rdfs:seeAlso <http://prefix.cc/cdm>,
                    <https://github.com/timrdf/csv2rdf4lod-automation/wiki>.
<http://purl.org/twc/ontology/conceptual_depth> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                                rdfs:comment "A measure of how universal/accepted/popular a URI is.";
                                                rdfs:label "Conceptual Depth";
                                                rdfs:range xsd:decimal;
                                                rdfs:seeAlso <http://purl.org/twc/vocab/conversion/conceptual_depth>.
<http://purl.org/twc/ontology/uri_length> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                          rdfs:comment "A naive measure of conceptual depth: the length of the URI.";
                                          rdfs:label "URI Length";
                                          rdfs:subPropertyOf <http://purl.org/twc/ontology/conceptual_depth>.
