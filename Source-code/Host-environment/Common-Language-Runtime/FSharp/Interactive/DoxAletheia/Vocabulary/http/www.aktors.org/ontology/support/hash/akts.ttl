@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix akts: <http://www.aktors.org/ontology/support#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:source a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
<http://www.aktors.org/ontology/support> dc11:creator "Enrico Motta (OCML version)",
                                                      "AKT Project",
                                                      "Nick Gibbins (OWL translation)";
                                         dc11:description """The AKT Reference Ontology has been designed to support the AKT-2 demonstrator (\"AKTive Portal\"), and subsequent activities. The ontology, designed by the AKT-2 group and codified by Enrico Motta, extends Version 1."""@en;
                                         dc11:source <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                         dc11:title "AKT Reference Ontology (Support Ontology)"@en;
                                         dcterms:created "2003-02-10";
                                         a owl:Ontology;
                                         rdfs:label "AKT Reference Ontology (Support Ontology)";
                                         rdfs:seeAlso <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                         owl:versionInfo "2.0".
akts:Calendar-Date a owl:Class;
                   rdfs:comment "A point in time";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                   rdfs:label "Calendar Date";
                   rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:day-of ; 
                                    a owl:Restriction],
                                   [owl:maxCardinality "0"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:hour-of ; 
                                    a owl:Restriction],
                                   akts:Time-Point,
                                   [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:year-of ; 
                                    a owl:Restriction],
                                   [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:month-of ; 
                                    a owl:Restriction],
                                   [owl:maxCardinality "0"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:minute-of ; 
                                    a owl:Restriction],
                                   [owl:maxCardinality "0"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty akts:second-of ; 
                                    a owl:Restriction].
akts:Day a owl:Class;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
         rdfs:label "Day";
         rdfs:subClassOf [owl:hasValue akts:twentyfour-hour-duration ; 
                          owl:onProperty akts:has-duration ; 
                          a owl:Restriction],
                         akts:Time-Interval.
akts:Duration a owl:Class;
              rdfs:comment "A measure of time, e.g., 5 hours";
              rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
              rdfs:label "Duration";
              rdfs:subClassOf [owl:allValuesFrom akts:Time-Measure ; 
                               owl:onProperty akts:has-unit-of-measure ; 
                               a owl:Restriction],
                              akts:Physical-Quantity.
akts:Intangible-Thing a owl:Class;
                      rdfs:comment "This comes from HPKB upper level. The collection of things that are not physical - are not made of, or encoded in, matter. Every Collection is an Intangible (even if its instances are tangible), and so are some Individuals. Caution: do not confuse `tangibility' with `perceivability' - humans can perceive light even though it's intangible - at least in a sense.";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                      rdfs:label "Intangible Thing";
                      rdfs:subClassOf akts:Thing.
akts:Month a owl:Class;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
           rdfs:label "Month";
           rdfs:subClassOf akts:Time-Interval.
akts:Physical-Quantity a owl:Class;
                       rdfs:comment "SUO: Physical Quantities are distinguished from Numbers by the fact that the former are associated with a dimension of measurement.";
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                       rdfs:label "Physical Quantity";
                       rdfs:subClassOf akts:Quantity.
akts:Quantity a owl:Class;
              rdfs:comment "From SUO: Any specification of how many or how much of something there is. Accordingly, there are two subclasses of Quantity: Number (how many) and Physical-Quantity (how much).";
              rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
              rdfs:label "Quantity";
              rdfs:subClassOf akts:Intangible-Thing.
akts:Tangible-Thing a owl:Class;
                    rdfs:comment "Something which is not intangible, something which is physical, made of matter. It does not matter whether things are real of imaginary.  Therefore we consider Mickey Mouse's car and a hippogriff as  tangible things";
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                    rdfs:label "Tangible Thing";
                    rdfs:subClassOf akts:Temporal-Thing;
                    owl:complementOf akts:Intangible-Thing.
akts:Temporal-Thing a owl:Class;
                    rdfs:comment "Like in Cyc, this is something which has a temporal extent.";
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                    rdfs:label "Temporal Thing";
                    rdfs:subClassOf akts:Thing.
akts:Thing a owl:Class;
           rdfs:comment "This is the top-level concept in the AKT reference ontology";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
           rdfs:label "Thing".
akts:Time-Interval a owl:Class;
                   rdfs:comment "An interval is defined by two time points or a duration. Classes of intervals, e.g., a day, can be defined by specifying only a duration.  A time interval has no gaps";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                   rdfs:label "Time Interval";
                   rdfs:subClassOf akts:Time-Position.
akts:Time-Measure a owl:Class;
                  rdfs:comment "The class of all unit of measures used to measure time, e.g., minute, second, hour, etc.";
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                  rdfs:label "Time Measure";
                  rdfs:subClassOf akts:Unit-Of-Measure.
akts:Time-Point a owl:Class;
                rdfs:comment "A point in time";
                rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                rdfs:label "Time Point";
                rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:hour-of ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:minute-of ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:year-of ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:second-of ; 
                                 a owl:Restriction],
                                akts:Time-Position,
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:day-of ; 
                                 a owl:Restriction],
                                [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akts:month-of ; 
                                 a owl:Restriction].
akts:Time-Position a owl:Class;
                   rdfs:comment "A time position is either a time interval or a time point. Any time position is relative to a time zone";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                   rdfs:label "Time Position";
                   rdfs:subClassOf akts:Intangible-Thing.
akts:Unit-Of-Measure a owl:Class;
                     rdfs:comment "Any kind of unit of measure, metre, dollar, kilogram, etc.";
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                     rdfs:label "Unit of Measure";
                     rdfs:subClassOf akts:Intangible-Thing.
akts:Week a owl:Class;
          rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
          rdfs:label "Week";
          rdfs:subClassOf [owl:hasValue akts:seven-day-duration ; 
                           owl:onProperty akts:has-duration ; 
                           a owl:Restriction],
                          akts:Time-Interval.
akts:Year a owl:Class;
          rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
          rdfs:label "Year";
          rdfs:subClassOf [owl:hasValue akts:twelve-month-duration ; 
                           owl:onProperty akts:has-duration ; 
                           a owl:Restriction],
                          akts:Time-Interval.
akts:begins-at-time-point a owl:ObjectProperty;
                          rdfs:domain akts:Time-Interval;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                          rdfs:label "begins at time point";
                          rdfs:range akts:Time-Point.
akts:day-of a owl:DatatypeProperty;
            rdfs:domain akts:Time-Point;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
            rdfs:label "day of";
            rdfs:range xsd:nonNegativeInteger.
akts:ends-at-time-point a owl:ObjectProperty;
                        rdfs:domain akts:Time-Interval;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                        rdfs:label "ends at time point";
                        rdfs:range akts:Time-Point.
akts:has-duration a owl:ObjectProperty;
                  rdfs:domain akts:Time-Interval;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                  rdfs:label "has duration";
                  rdfs:range akts:Duration.
akts:has-magnitude a owl:DatatypeProperty;
                   rdfs:domain akts:Physical-Quantity;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                   rdfs:label "has magnitude";
                   rdfs:range xsd:decimal.
akts:has-pretty-name a owl:DatatypeProperty;
                     rdfs:comment "A human readable name";
                     rdfs:domain akts:Thing;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                     rdfs:label "has pretty name";
                     rdfs:range xsd:string.
akts:has-time-interval a owl:ObjectProperty;
                       rdfs:domain akts:Temporal-Thing;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                       rdfs:label "has time interval";
                       rdfs:range akts:Time-Interval.
akts:has-unit-of-measure a owl:ObjectProperty;
                         rdfs:domain akts:Physical-Quantity;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                         rdfs:label "has unit of measure";
                         rdfs:range akts:Unit-Of-Measure.
akts:has-variant-name a owl:DatatypeProperty;
                      rdfs:comment "Other variants of the human readable name";
                      rdfs:domain akts:Thing;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                      rdfs:label "has variant name";
                      rdfs:range xsd:string.
akts:hour-of a owl:DatatypeProperty;
             rdfs:domain akts:Time-Point;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
             rdfs:label "hour of";
             rdfs:range xsd:nonNegativeInteger.
akts:in-timezone a owl:DatatypeProperty;
                 rdfs:domain akts:Time-Position;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                 rdfs:label "in timezone";
                 rdfs:range xsd:integer.
akts:minute-of a owl:DatatypeProperty;
               rdfs:domain akts:Time-Point;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
               rdfs:label "minute of";
               rdfs:range xsd:nonNegativeInteger.
akts:month-of a owl:DatatypeProperty;
              rdfs:domain akts:Time-Point;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
              rdfs:label "month of";
              rdfs:range xsd:nonNegativeInteger.
akts:second-of a owl:DatatypeProperty;
               rdfs:domain akts:Time-Point;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
               rdfs:label "second of";
               rdfs:range xsd:nonNegativeInteger.
akts:seven-day-duration akts:has-magnitude 7 ;
                        akts:has-unit-of-measure akts:time-measure-day;
                        a akts:Duration;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                        rdfs:label "7 day duration".
akts:thirty-day-duration akts:has-magnitude 30 ;
                         akts:has-unit-of-measure akts:time-measure-day;
                         a akts:Duration;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                         rdfs:label "30 day duration".
akts:thirtyone-day-duration akts:has-magnitude 31 ;
                            akts:has-unit-of-measure akts:time-measure-day;
                            a akts:Duration;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                            rdfs:label "31 day duration".
akts:time-measure-day a akts:Time-Measure;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                      rdfs:label "day".
akts:time-measure-hour a akts:Time-Measure;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                       rdfs:label "hour".
akts:time-measure-minute a akts:Time-Measure;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                         rdfs:label "minute".
akts:time-measure-month a akts:Time-Measure;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                        rdfs:label "month".
akts:time-measure-second a akts:Time-Measure;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                         rdfs:label "second".
akts:time-measure-year a akts:Time-Measure;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                       rdfs:label "year".
akts:twelve-month-duration akts:has-magnitude 12 ;
                           akts:has-unit-of-measure akts:time-measure-month;
                           a akts:Duration;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                           rdfs:label "12 month duration".
akts:twentyeight-day-duration akts:has-magnitude 28 ;
                              akts:has-unit-of-measure akts:time-measure-day;
                              a akts:Duration;
                              rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                              rdfs:label "28 day duration".
akts:twentyfour-hour-duration akts:has-magnitude 24 ;
                              akts:has-unit-of-measure akts:time-measure-hour;
                              a akts:Duration;
                              rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                              rdfs:label "24 hour duration".
akts:twentynine-day-duration akts:has-magnitude 29 ;
                             akts:has-unit-of-measure akts:time-measure-day;
                             a akts:Duration;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
                             rdfs:label "29 day duration".
akts:year-of a owl:DatatypeProperty;
             rdfs:domain akts:Time-Point;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/support>;
             rdfs:label "year of";
             rdfs:range xsd:nonNegativeInteger.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
rdfs:seeAlso a owl:AnnotationProperty.
