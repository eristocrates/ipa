@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix geofla: <http://data.ign.fr/def/geofla#>.

<http://data.ign.fr/def/geofla> <http://creativecommons.org/ns#license> <http://www.data.gouv.fr/Licence-Ouverte-Open-Licence>,
                                                                        <http://opendatacommons.org/licenses/by/>,
                                                                        <http://creativecommons.org/licenses/by/2.0/>;
                                <http://purl.org/dc/terms/contributor> <http://www.eurecom.fr/~troncy/>,
                                                                       <http://recherche.ign.fr/labos/cogit/cv.php?prenom=Bénédicte&nom=Bucher>,
                                                                       <http://data.semanticweb.org/person/bernard-vatant>;
                                <http://purl.org/dc/terms/creator> <http://recherche.ign.fr/labos/cogit/cv.php?prenom=Nathalie&nom=Abadie>,
                                                                   <http://www.eurecom.fr/~atemezin/>;
                                <http://purl.org/dc/terms/description> "Ontologie décrivant le découpage administratif de la France métropolitaine, des départements d'outre-mer, ou de la collectivité  départementale de Mayotte, représentée comme une hiérarchie de classes OWL"@fr;
                                <http://purl.org/dc/terms/issued> "2013-06-11"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2014-08-22"^^xsd:date;
                                <http://purl.org/dc/terms/publisher> <http://fr.dbpedia.org/resource/Institut_national_de_l%27information_géographique_et_forestière>;
                                <http://purl.org/dc/terms/rights> "Copyright 2014, IGN";
                                <http://purl.org/dc/terms/title> "Ontologie des unités administratives de l'IGN"@fr;
                                <http://purl.org/vocab/vann/preferredNamespacePrefix> "geofla";
                                <http://purl.org/vocab/vann/preferredNamespaceUri> geofla:;
                                a <http://www.w3.org/2002/07/owl#Ontology>,
                                  <http://purl.org/vocommons/voaf#Vocabulary>;
                                <http://www.w3.org/2002/07/owl#versionInfo> "Version 1.0 - 2014-08-22".
geofla:Arrondissement a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Cette classe contient l'ensemble des arrondissements (ce sont les arrondissements au sens INSEE, et non les arrondissements municipaux)."@fr;
                      rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
                      rdfs:label "Arrondissement"@en,
                                 "Arrondissement"@fr;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.geonames.org/ontology#featureCode> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> <http://www.geonames.org/ontology#A.ADM3> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      geofla:UniteAdministrative;
                      <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdf.insee.fr/def/geo#Arrondissement>.
geofla:Canton a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Les cantons contenus dans les différentes bases de données de l'IGN sont des cantons au sens INSEE du terme, appelés pseudo-cantons. Un pseudo-canton, quant à lui, est un regroupement d'une ou plusieurs communes entières."@fr;
              rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
              rdfs:label "Canton"@en,
                         "Canton"@fr;
              rdfs:subClassOf geofla:UniteAdministrative;
              <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdf.insee.fr/def/geo#CantonOuVille>.
geofla:Commune a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Cette classe contient l'ensemble des communes métropolitaines, des 5 départements d'outre-mer (Guadeloupe, Martinique, Guyane, La Réunion et Mayotte)."@fr;
               rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
               rdfs:label "Commune"@en,
                          "Commune"@fr;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.geonames.org/ontology#featureCode> ; 
                                <http://www.w3.org/2002/07/owl#hasValue> <http://www.geonames.org/ontology#A.ADM4> ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               geofla:UniteAdministrative;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdf.insee.fr/def/geo#Commune>.
geofla:Departement a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Cette classe contient l'ensemble des départements."@fr;
                   rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
                   rdfs:label "Département"@fr,
                              "Department"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.geonames.org/ontology#featureCode> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> <http://www.geonames.org/ontology#A.ADM2> ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   geofla:UniteAdministrative;
                   <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdf.insee.fr/def/geo#Departement>.
geofla:Region a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Cette classe contient l'ensemble des régions."@fr;
              rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
              rdfs:label "Region"@en,
                         "Région"@fr;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.geonames.org/ontology#featureCode> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> <http://www.geonames.org/ontology#A.ADM1> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              geofla:UniteAdministrative;
              <http://www.w3.org/2002/07/owl#equivalentClass> <http://rdf.insee.fr/def/geo#Region>.
geofla:TypeDeCommune a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Type de commune"@fr,
                                "Type of commune"@en;
                     rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
geofla:UniteAdministrative a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Objet géographique résultant du découpage administratif du territoire français."@fr;
                           rdfs:isDefinedBy <http://data.ign.fr/def/geofla>;
                           rdfs:label "Administrative subdivision"@en,
                                      "Unité administrative"@fr;
                           rdfs:subClassOf <http://data.ign.fr/def/topo#EntiteTopographique>.
geofla:arr a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Arrondissement auquel appartient l'unité administrative."@fr;
           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (geofla:Canton
                                                                 geofla:Commune) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:label "appartient à l'arrondisssement"@fr,
                      "belongs to arrondisssement"@en;
           rdfs:range geofla:Arrondissement.
geofla:cant a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Canton auquel appartient l'unité administrative."@fr;
            rdfs:domain geofla:Commune;
            rdfs:label "appartient au canton"@fr,
                       "belongs to canton"@en;
            rdfs:range geofla:Canton.
geofla:chefLieu a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Chef-lieu de l'unité administrative lorsqu'il existe (un canton ne possède pas toujours de chef-lieu. Cela arrive dans le cas de cantons situés à la périphérie d'une ville importante constituant à elle seule un canton non précisé.)"@fr;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (geofla:Canton
                                                                      geofla:Departement
                                                                      geofla:Arrondissement) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "chef-lieu de l'unité administrative"@fr,
                           "capital of the administrative subdivision"@en;
                rdfs:range geofla:Commune.
geofla:codeArr a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Code géographique de l'arrondissement (texte d'un caractère)."@fr;
               rdfs:domain geofla:Arrondissement;
               rdfs:label "geographic code of the arrondissement"@en,
                          "code géographique de l'arrondissement"@fr;
               rdfs:range xsd:string.
geofla:codeCant a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Il s'agit du code géographique permettant d'identifier le canton dans son département d'appartenance (texte de deux caractères)."@fr;
                rdfs:domain geofla:Canton;
                rdfs:label "code géographique du canton"@fr,
                           "geographic code of the canton"@en;
                rdfs:range xsd:string.
geofla:codeComm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Il s'agit du code géographique permettant d'identifier la commune dans son département d'appartenance (texte de trois caractères)."@fr;
                rdfs:domain geofla:Commune;
                rdfs:label "code géographique de la commune"@fr,
                           "geographic code of the commune"@en;
                rdfs:range xsd:string.
geofla:codeDpt a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Code géographique du département (texte de deux caractères)."@fr;
               rdfs:domain geofla:Departement;
               rdfs:label "code géographique du département"@fr,
                          "geographic code of the department"@en;
               rdfs:range xsd:string.
geofla:codeReg a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "Code géographique de la région (texte de deux caractères)."@fr;
               rdfs:domain geofla:Region;
               rdfs:label "code géographique de la région"@fr,
                          "geographic code of the region"@en;
               rdfs:range xsd:string.
geofla:dpt a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Département auquel appartient l'unité administrative"@fr;
           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (geofla:Canton
                                                                 geofla:Commune
                                                                 geofla:Arrondissement) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:label "appartient au département"@fr,
                      "belongs to department"@en;
           rdfs:range geofla:Departement.
geofla:numInsee a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Il s'agit d'un numéro de 5 caractères : le code du département suivi du code géographique de la commune. Pour les DOM, le 3ème caractère est commun au numéro de département et au numéro de commune."@fr;
                rdfs:domain geofla:Commune;
                rdfs:label "numéro insee de la commune"@fr,
                           "insee identifier of the commune"@en;
                rdfs:range xsd:string.
geofla:population a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Chiffre de population sans doubles comptes au dernier recensement, en milliers d'habitants, à une décimale. "@fr;
                  rdfs:domain geofla:Commune;
                  rdfs:label "population"@fr,
                             "population"@en;
                  rdfs:range xsd:double.
geofla:region a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Région à laquelle appartient l'unité administrative."@fr;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (geofla:Canton
                                                                    geofla:Commune
                                                                    geofla:Arrondissement
                                                                    geofla:Departement) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "appartient à la région"@fr,
                         "belongs to region"@en;
              rdfs:range geofla:Region.
geofla:siegeDuChefLieu a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Point qui représente la localisation du siège du chef-lieu de l'unité administrative."@fr;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (geofla:Canton
                                                                             geofla:Departement
                                                                             geofla:Arrondissement
                                                                             geofla:Commune) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:label "siège du chef-lieu"@fr,
                                  "head office of the capital"@en;
                       rdfs:range <http://data.ign.fr/def/geometrie#Point>.
geofla:statut a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain geofla:Commune;
              rdfs:label "statut"@fr,
                         "status"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                          <http://www.w3.org/2002/07/owl#hasValue> <http://data.ign.fr/codes/geonto/typedecommune/liste> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>].
geofla:superficieHa a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Superficie de la commune en hectares."@fr;
                    rdfs:domain geofla:Commune;
                    rdfs:label "superficie en hectares"@fr,
                               "area in hectares"@en;
                    rdfs:range xsd:integer.
geofla:zMoyen a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Altitude moyenne de la commune en mètres."@fr;
              rdfs:domain geofla:Commune,
                          geofla:ArrondissementMunicipal;
              rdfs:label "altitude moyenne"@fr,
                         "mean altitude"@en;
              rdfs:range xsd:integer.
<http://data.ign.fr/def/topo#EntiteTopographique> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:label "Entité topographique"@fr,
                                                             "Topographic entity"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/CapitaleDEtat> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "Commune principale d'un état, siège du gouvernement et de l'administration."@fr;
                                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "capitale d'état"@fr,
                                                                                                                 "state capital"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/ChefLieuDeCanton> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                    <http://www.w3.org/2004/02/skos/core#definition> "Chef-lieu d'un canton français."@fr;
                                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "chef-lieu de canton"@fr,
                                                                                                                    "township capital"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/CommuneSimple> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                 <http://www.w3.org/2004/02/skos/core#definition> "Commune sans rôle administratif particulier."@fr;
                                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "commune simple"@fr,
                                                                                                                 "simple commune"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/PrefectureDeDepartement> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                           <http://www.w3.org/2004/02/skos/core#definition> "Chef-lieu d'un département français."@fr;
                                                                           <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "prefecture"@en,
                                                                                                                           "préfecture de département"@fr.
<http://data.ign.fr/id/codes/geofla/typedecommune/PrefectureDeRegion> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                      <http://www.w3.org/2004/02/skos/core#definition> "Chef-lieu d'une région française."@fr;
                                                                      <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "préfecture de région"@fr,
                                                                                                                      "regional prefecture"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/SousPrefecture> a <http://www.w3.org/2004/02/skos/core#Concept>;
                                                                  <http://www.w3.org/2004/02/skos/core#definition> "Chef-lieu d'un arrondissement français."@fr;
                                                                  <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.ign.fr/id/codes/geofla/typedecommune/liste>;
                                                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "sous-préfecture"@fr,
                                                                                                                  "subprefecture"@en.
<http://data.ign.fr/id/codes/geofla/typedecommune/liste> a <http://www.w3.org/2004/02/skos/core#ConceptScheme>;
                                                         rdfs:comment "Liste des différents rôles pouvant être joués par une commune dans l'organisation administrative française, représentés comme une liste de concepts SKOS."@fr;
                                                         rdfs:label "type de commune"@fr,
                                                                    "type of commune"@en.
<http://data.semanticweb.org/person/bernard-vatant> a <http://xmlns.com/foaf/0.1/Person>.
<http://recherche.ign.fr/labos/cogit/cv.php?prenom=Bénédicte&nom=Bucher> a <http://xmlns.com/foaf/0.1/Person>.
<http://recherche.ign.fr/labos/cogit/cv.php?prenom=Nathalie&nom=Abadie> a <http://xmlns.com/foaf/0.1/Person>.
<http://www.eurecom.fr/~atemezin/> a <http://xmlns.com/foaf/0.1/Person>.
<http://www.eurecom.fr/~troncy/> a <http://xmlns.com/foaf/0.1/Person>.
