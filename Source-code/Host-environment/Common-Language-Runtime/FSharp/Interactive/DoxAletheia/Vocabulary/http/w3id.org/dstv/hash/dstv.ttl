@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dstv: <http://w3id.org/dstv#>.
@prefix ioc: <http://w3id.org/ioc#>.

_:B840feedf62584dd8ddf6407a8189e334 a owl:AllDisjointClasses;
                                    owl:members (dstv:Depth
                                                 dstv:Diameter
                                                 dstv:Distance
                                                 dstv:Vertex
                                                 dstv:VertexX
                                                 dstv:VertexY).
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
<http://schema.org/#value> a owl:DatatypeProperty;
                           rdfs:domain [owl:unionOf (dstv:MeasuredValues
                                                     dstv:PlannedValues
                                                     dstv:ToleranceValues) ; 
                                        a owl:Class];
                           rdfs:range rdfs:Literal.
dstv: dcterms:creator "Jyrki Oraskari, Individualized Production RWTH Aachen"@en,
                      "Timur Kurzu, Individualized Production RWTH Aachen"@en,
                      "Victoria Jung, Individualized Production RWTH Aachen"@en,
                      "Lukas Kirner, Individualized Production RWTH Aachen"@en;
      dcterms:description "dstv"@en;
      dcterms:issued "2023-02-28"@en;
      dcterms:title "DSTV:Steel Construction Ontology"@en;
      vann:preferredNamespacePrefix "dstv";
      vann:preferredNamespaceUri "http://w3id.org/dstv#";
      a owl:Ontology;
      owl:versionInfo "0.0.2".
dstv:AdjustmentProcess a owl:Class;
                       rdfs:subClassOf ioc:Process.
dstv:BottomReference a owl:Class;
                     rdfs:isDefinedBy dstv:;
                     rdfs:subClassOf dstv:DimensionalReference.
dstv:BottomView a owl:Class;
                rdfs:comment "b";
                rdfs:subClassOf dstv:ReferenceView.
dstv:Depth a owl:Class;
           rdfs:subClassOf dstv:FeatureValues.
dstv:DepthDeviation a owl:Class;
                    rdfs:isDefinedBy dstv:;
                    rdfs:subClassOf dstv:DeviationValues.
dstv:DepthTolerance a owl:Class;
                    rdfs:subClassOf dstv:ToleranceValues.
dstv:DeviationValues a owl:Class;
                     rdfs:isDefinedBy dstv:.
dstv:Diameter a owl:Class;
              rdfs:subClassOf dstv:FeatureValues.
dstv:DiameterDeviation a owl:Class;
                       rdfs:isDefinedBy dstv:;
                       rdfs:subClassOf dstv:DeviationValues.
dstv:DiameterTolerance a owl:Class;
                       rdfs:subClassOf dstv:ToleranceValues.
dstv:DimensionalReference a owl:Class;
                          rdfs:isDefinedBy dstv:.
dstv:Distance a owl:Class;
              rdfs:subClassOf dstv:FeatureValues.
dstv:DistanceSUM a owl:Class;
                 rdfs:subClassOf dstv:Distance.
dstv:DistanceSUMDeviation a owl:Class;
                          rdfs:isDefinedBy dstv:;
                          rdfs:subClassOf dstv:DeviationValues.
dstv:DistanceSUMTolerance a owl:Class;
                          rdfs:subClassOf dstv:ToleranceValues.
dstv:DistanceX a owl:Class;
               rdfs:subClassOf dstv:Distance.
dstv:DistanceXDeviation a owl:Class;
                        rdfs:isDefinedBy dstv:;
                        rdfs:subClassOf dstv:DeviationValues.
dstv:DistanceXTolerance a owl:Class;
                        rdfs:subClassOf dstv:ToleranceValues.
dstv:DistanceY a owl:Class;
               rdfs:subClassOf dstv:Distance.
dstv:DistanceYDeviation a owl:Class;
                        rdfs:isDefinedBy dstv:;
                        rdfs:subClassOf dstv:DeviationValues.
dstv:DistanceYTolerance a owl:Class;
                        rdfs:subClassOf dstv:ToleranceValues.
dstv:Drill a owl:Class;
           rdfs:subClassOf dstv:ProductionProcess.
dstv:DrillMeasurement a owl:Class;
                      rdfs:subClassOf dstv:MeasurementProcess.
dstv:Feature a owl:Class;
             rdfs:isDefinedBy dstv:.
dstv:FeatureValues a owl:Class.
dstv:FrontView a owl:Class;
               rdfs:comment "f";
               rdfs:subClassOf dstv:ReferenceView.
dstv:MeasuredDepth a owl:Class;
                   rdfs:subClassOf dstv:MeasuredValues.
dstv:MeasuredDiameter a owl:Class;
                      rdfs:subClassOf dstv:MeasuredValues.
dstv:MeasuredDistanceSUM a owl:Class;
                         rdfs:subClassOf dstv:MeasuredValues.
dstv:MeasuredDistanceX a owl:Class;
                       rdfs:subClassOf dstv:MeasuredValues.
dstv:MeasuredDistanceY a owl:Class;
                       rdfs:subClassOf dstv:MeasuredValues.
dstv:MeasuredValues a owl:Class.
dstv:MeasurementProcess a owl:Class;
                        rdfs:subClassOf ioc:Process.
dstv:PlannedDepth a owl:Class;
                  rdfs:subClassOf dstv:PlannedValues.
dstv:PlannedDiameter a owl:Class;
                     rdfs:subClassOf dstv:PlannedValues.
dstv:PlannedDistanceSUM a owl:Class;
                        rdfs:subClassOf dstv:PlannedValues.
dstv:PlannedDistanceX a owl:Class;
                      rdfs:subClassOf dstv:PlannedValues.
dstv:PlannedDistanceY a owl:Class;
                      rdfs:subClassOf dstv:PlannedValues.
dstv:PlannedValues a owl:Class.
dstv:ProductionProcess a owl:Class;
                       rdfs:subClassOf ioc:Process.
dstv:RearView a owl:Class;
              rdfs:comment "r";
              rdfs:subClassOf dstv:ReferenceView.
dstv:ReferenceView a owl:Class.
dstv:SymmetricalReference a owl:Class;
                          rdfs:isDefinedBy dstv:;
                          rdfs:subClassOf dstv:DimensionalReference.
dstv:ThroughHoleDrill a owl:Class;
                      rdfs:comment "The element hljob is an optional element of hl. It is created for each through hole of the corresponding reference plane.",
                                   "hljob";
                      rdfs:subClassOf [owl:onProperty dstv:hasMeasurement ; 
                                       owl:allValuesFrom dstv:ThroughHoleDrillMeasurement ; 
                                       a owl:Restriction],
                                      [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dstv:hasDiameter ; 
                                       owl:onClass dstv:Diameter ; 
                                       a owl:Restriction],
                                      dstv:Drill.
dstv:ThroughHoleDrillMeasurement a owl:Class;
                                 rdfs:subClassOf dstv:DrillMeasurement.
dstv:ToleranceBool a owl:Class.
dstv:ToleranceValues a owl:Class.
dstv:TopReference a owl:Class;
                  rdfs:isDefinedBy dstv:;
                  rdfs:subClassOf dstv:DimensionalReference.
dstv:TopView a owl:Class;
             rdfs:comment "t";
             rdfs:subClassOf dstv:ReferenceView.
dstv:TroughHole a owl:Class;
                rdfs:subClassOf dstv:Feature.
dstv:ValidationProcess a owl:Class;
                       rdfs:subClassOf ioc:Process.
dstv:Vertex a owl:Class;
            rdfs:subClassOf dstv:FeatureValues.
dstv:VertexX a owl:Class;
             rdfs:subClassOf dstv:FeatureValues.
dstv:VertexY a owl:Class;
             rdfs:subClassOf dstv:FeatureValues.
dstv:describedInIfcFeature a owl:ObjectProperty;
                           rdfs:domain dstv:TroughHole;
                           rdfs:range <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcVoidingFeature>.
dstv:hasDeviationValues a owl:ObjectProperty;
                        rdfs:domain dstv:FeatureValues;
                        rdfs:range dstv:DeviationValues.
dstv:hasDiameter a owl:ObjectProperty;
                 rdfs:domain [owl:unionOf (dstv:AdjustmentProcess
                                           dstv:ThroughHoleDrill
                                           dstv:ValidationProcess) ; 
                              a owl:Class];
                 rdfs:range dstv:Diameter;
                 rdfs:subPropertyOf dstv:hasFeature.
dstv:hasDiameterDeviation a owl:ObjectProperty;
                          rdfs:domain dstv:Diameter;
                          rdfs:range dstv:DiameterDeviation;
                          rdfs:subPropertyOf dstv:hasDeviationValues.
dstv:hasDiameterTolerance a owl:ObjectProperty;
                          rdfs:domain dstv:Diameter;
                          rdfs:range dstv:DiameterTolerance;
                          rdfs:subPropertyOf dstv:hasTolerances.
dstv:hasDimensionalReference a owl:ObjectProperty;
                             rdfs:domain dstv:Drill;
                             rdfs:range dstv:DimensionalReference.
dstv:hasFeature a owl:ObjectProperty;
                rdfs:domain [owl:unionOf (dstv:AdjustmentProcess
                                          dstv:MeasurementProcess
                                          dstv:ProductionProcess
                                          dstv:ValidationProcess
                                          ioc:Process) ; 
                             a owl:Class];
                rdfs:range dstv:FeatureValues.
dstv:hasMaxBound a owl:DatatypeProperty;
                 rdfs:domain dstv:ToleranceValues;
                 rdfs:range rdfs:Literal.
dstv:hasMeasuredDiameter a owl:ObjectProperty;
                         rdfs:domain dstv:Diameter;
                         rdfs:range dstv:MeasuredDiameter;
                         rdfs:subPropertyOf dstv:hasMeasuredValue.
dstv:hasMeasuredValue a owl:ObjectProperty;
                      rdfs:domain dstv:FeatureValues;
                      rdfs:range dstv:MeasuredValues.
dstv:hasMeasurement a owl:ObjectProperty;
                    rdfs:domain dstv:Drill;
                    rdfs:range dstv:MeasurementProcess.
dstv:hasMinBound a owl:DatatypeProperty;
                 rdfs:domain dstv:ToleranceValues;
                 rdfs:range rdfs:Literal.
dstv:hasPlannedDiameter a owl:ObjectProperty;
                        rdfs:domain dstv:Diameter;
                        rdfs:range dstv:PlannedDiameter;
                        rdfs:subPropertyOf dstv:hasPlannedValue.
dstv:hasPlannedValue a owl:ObjectProperty;
                     rdfs:domain dstv:FeatureValues;
                     rdfs:range dstv:PlannedValues.
dstv:hasReferenceView a owl:ObjectProperty;
                      rdfs:comment "dstvNC Level";
                      rdfs:domain dstv:Drill;
                      rdfs:range dstv:ReferenceView.
dstv:hasTolerances a owl:ObjectProperty;
                   rdfs:domain dstv:PlannedValues;
                   rdfs:range dstv:ToleranceValues.
dstv:hasVertex a owl:ObjectProperty;
               rdfs:domain [owl:unionOf (dstv:Drill
                                         dstv:DrillMeasurement) ; 
                            a owl:Class];
               rdfs:range dstv:Vertex;
               rdfs:subPropertyOf dstv:hasFeature.
dstv:hasVertexX a owl:ObjectProperty;
                rdfs:domain dstv:Vertex;
                rdfs:range dstv:VertexX.
dstv:hasVertexY a owl:ObjectProperty;
                rdfs:domain dstv:Vertex;
                rdfs:range dstv:VertexY.
dstv:inTolerance a owl:ObjectProperty;
                 rdfs:domain dstv:FeatureValues;
                 rdfs:range dstv:ToleranceBool.
ioc:Process a owl:Class.
ioc:hasFeatureValue a owl:ObjectProperty;
                    rdfs:domain dstv:Feature;
                    rdfs:range dstv:FeatureValues.
ioc:hasOutputElement a owl:ObjectProperty;
                     rdfs:domain dstv:ThroughHoleDrill;
                     rdfs:range dstv:TroughHole.
<https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#IfcVoidingFeature> a owl:Class.
