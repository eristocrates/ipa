<http://w3id.org/emmo-hpo/hpo> dcterms:abstract "The Hyperdimensional Polymer Ontology (HPO) is an ontology meant to capture the staggering diversity of polymeric materials and their applications."@en;
                               dcterms:bibliographicCitation "Work under review - not available yet";
                               dcterms:contributor <https://orcid.org/0000-0002-9668-6961>,
                                                   <https://orcid.org/0000-0002-5174-8508>,
                                                   <https://orcid.org/0000-0002-4181-2852>;
                               dcterms:created "2023-12-22";
                               dcterms:creator <https://orcid.org/0000-0002-9668-6961>,
                                               <https://orcid.org/0000-0002-4181-2852>,
                                               <https://orcid.org/0000-0002-5174-8508>;
                               dcterms:description "An ontology to capture the staggering diversity of polymeric materials and their applications."@en;
                               dcterms:issued "2024-04-12";
                               dcterms:license "https://creativecommons.org/licenses/by/4.0/legalcode";
                               dcterms:modified "2024-04-12";
                               dcterms:publisher "EMMC ASBL";
                               dcterms:source "";
                               dcterms:title "Hyperdimensional Polymer Ontology"@en;
                               bibo:doi "";
                               bibo:status "";
                               vann:preferredNamespacePrefix "hpo"@en;
                               vann:preferredNamespaceUri "http://w3id.org/emmo-hpo/hpo";
                               a owl:Ontology;
                               rdfs:comment """Contacts:
	Gerhard Goldbeck
	Goldbeck Consulting Ltd (UK)
	email: gerhard@goldbeck-consulting.com"""@en;
                               owl:backwardCompatibleWith "";
                               owl:imports <http://w3id.org/emmo-chameo/chameo>,
                                           <http://w3id.org/emmo/perspectives/physicalistic>;
                               owl:priorVersion "";
                               owl:versionIRI <http://w3id.org/emmo-hpo/1.0.0-beta1/hpo>;
                               owl:versionInfo "1.0.0";
                               foaf:logo "".
hpo:AdditionPolymer <http://w3id.org/emmo#elucidation> "A polymer obtained through an addition reaction, that is, a reaction involving the creation of a single bond between the atoms of different molecules which are involved in a double or triple bond."@en;
                    a owl:Class;
                    rdfs:comment "A polymer obtained through an addition reaction, that is, a reaction involving the creation of a single bond between the atoms of different molecules which are involved in a double or triple bond."@en;
                    rdfs:label "AdditionPolymer"@en;
                    rdfs:subClassOf <http://w3id.org/emmo#PolymericMaterial>;
                    skos:prefLabel "AdditionPolymer"@en.
hpo:Additive <http://w3id.org/emmo#elucidation> "A term used for a large number of specialist chemicals which are added to compounds to impart specific properties."@en;
             <http://w3id.org/emmo#example> "An additive can provide flame retardancy and UV resistance properties to a resin."@en;
             a owl:Class;
             rdfs:comment "A term used for a large number of specialist chemicals which are added to compounds to impart specific properties."@en;
             rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI;
             rdfs:label "Additive"@en;
             rdfs:subClassOf hpo:ResinIngredient;
             skos:prefLabel "Additive"@en.
hpo:Branched <http://w3id.org/emmo#elucidation> "A class of structures characterised by a branched skeleton."@en;
             a owl:Class;
             rdfs:comment "A class of structures characterised by a branched skeleton."@en;
             rdfs:label "Branched"@en;
             rdfs:subClassOf hpo:SkeletalFormula;
             skos:prefLabel "Branched"@en.
hpo:BranchedChainPolymer <http://w3id.org/emmo#elucidation> "A polymer whose molecular structure is characterised by a regular or irregular attachment of side chains to the main backbone chain. ."@en;
                         <http://w3id.org/emmo#example> "Glycogen, Star-polymers."@en;
                         a owl:Class;
                         rdfs:comment "A polymer whose molecular structure is characterised by a regular or irregular attachment of side chains to the main backbone chain. ."@en;
                         rdfs:label "BranchedChainPolymer"@en;
                         rdfs:subClassOf hpo:Branched,
                                         <http://w3id.org/emmo#PolymericMaterial>;
                         skos:prefLabel "BranchedChainPolymer"@en.
hpo:COMPEVODSCAnalysis <http://w3id.org/emmo#elucidation> "Experimental procedure for resin reactivity measurement."@en;
                       a owl:Class;
                       rdfs:comment "Experimental procedure for resin reactivity measurement."@en;
                       rdfs:label "COMPEVODSCAnalysis"@en;
                       rdfs:subClassOf <http://w3id.org/emmo#Measurement>;
                       skos:prefLabel "COMPEVODSCAnalysis"@en.
hpo:Catalyst <http://w3id.org/emmo#elucidation> "A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction."@en;
             a owl:Class;
             rdfs:comment "A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction."@en;
             rdfs:label "Catalyst"@en;
             rdfs:seeAlso "https://doi.org/10.1351/goldbook.C00876"@en;
             rdfs:subClassOf hpo:ResinIngredient;
             skos:prefLabel "Catalyst"@en.
hpo:CatalystCommercialName <http://w3id.org/emmo#elucidation> "Catalyst suppliers trade name for the purchased catalyst formulation."@en;
                           a owl:Class;
                           rdfs:comment "Catalyst suppliers trade name for the purchased catalyst formulation."@en;
                           rdfs:label "CatalystCommercialName"@en;
                           rdfs:subClassOf hpo:CatalystProperty;
                           skos:prefLabel "CatalystCommercialName"@en.
hpo:CatalystDensity <http://w3id.org/emmo#elucidation> "Mass density of the catalyst."@en;
                    a owl:Class;
                    rdfs:comment "Mass density of the catalyst."@en;
                    rdfs:label "CatalystDensity"@en;
                    rdfs:subClassOf <http://w3id.org/emmo#Density>,
                                    hpo:CatalystProperty;
                    skos:prefLabel "CatalystDensity"@en.
hpo:CatalystMolecularWeight <http://w3id.org/emmo#elucidation> "Average molecular weight of the catalyst molecular consituents."@en;
                            a owl:Class;
                            rdfs:comment "Average molecular weight of the catalyst molecular consituents."@en;
                            rdfs:label "CatalystMolecularWeight"@en;
                            rdfs:subClassOf hpo:CatalystProperty;
                            skos:prefLabel "CatalystMolecularWeight"@en.
hpo:CatalystProperty a owl:Class;
                     rdfs:comment "";
                     rdfs:label "CatalystProperty"@en;
                     rdfs:subClassOf [owl:allValuesFrom hpo:Catalyst ; 
                                      owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasProperty>] ; 
                                      a owl:Restriction],
                                     <http://w3id.org/emmo#Objective>;
                     skos:prefLabel "CatalystProperty"@en.
hpo:CatalystViscosity <http://w3id.org/emmo#elucidation> "Catalyst viscosity at 25°C."@en;
                      a owl:Class;
                      rdfs:comment "Catalyst viscosity at 25°C."@en;
                      rdfs:label "CatalystViscosity"@en;
                      rdfs:subClassOf <http://w3id.org/emmo#DynamicViscosity>,
                                      hpo:CatalystProperty;
                      skos:prefLabel "CatalystViscosity"@en.
hpo:CoPolymer <http://w3id.org/emmo#elucidation> "A polymer derived from the polymerisation of more than one species of monomer."@en;
              a owl:Class;
              rdfs:comment "A polymer derived from the polymerisation of more than one species of monomer."@en;
              rdfs:label "CoPolymer"@en;
              rdfs:subClassOf <http://w3id.org/emmo#TotalComposition>,
                              <http://w3id.org/emmo#PolymericMaterial>;
              skos:prefLabel "CoPolymer"@en.
hpo:ComponentManufacturing <http://w3id.org/emmo#elucidation> "The manufacturing of a component made of a composite material."@en;
                           a owl:Class;
                           rdfs:comment "The manufacturing of a component made of a composite material."@en;
                           rdfs:label "ComponentManufacturing"@en;
                           rdfs:subClassOf [owl:someValuesFrom hpo:Stacking ; 
                                            owl:onProperty <http://w3id.org/emmo#hasStage> ; 
                                            a owl:Restriction],
                                           [owl:someValuesFrom hpo:ShapingAndCuring ; 
                                            owl:onProperty <http://w3id.org/emmo#hasStage> ; 
                                            a owl:Restriction],
                                           [owl:someValuesFrom hpo:ComponentManufacturingLine ; 
                                            owl:onProperty <http://w3id.org/emmo#hasParticipant> ; 
                                            a owl:Restriction],
                                           <http://w3id.org/emmo#Manufacturing>;
                           skos:prefLabel "ComponentManufacturing"@en.
hpo:ComponentManufacturingLine <http://w3id.org/emmo#elucidation> "A manufacturing line processing a composite material into a component."@en;
                               a owl:Class;
                               rdfs:comment "A manufacturing line processing a composite material into a component."@en;
                               rdfs:label "ComponentManufacturingLine"@en;
                               rdfs:subClassOf [owl:someValuesFrom hpo:MouldReleaseLayer ; 
                                                owl:onProperty <http://w3id.org/emmo#hasConstituent> ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom hpo:CoverTool ; 
                                                owl:onProperty <http://w3id.org/emmo#hasConstituent> ; 
                                                a owl:Restriction],
                                               hpo:ManufacturingLine,
                                               [owl:someValuesFrom hpo:CoverReleaseLayer ; 
                                                owl:onProperty <http://w3id.org/emmo#hasConstituent> ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom hpo:MouldTool ; 
                                                owl:onProperty <http://w3id.org/emmo#hasConstituent> ; 
                                                a owl:Restriction];
                               skos:prefLabel "ComponentManufacturingLine"@en.
hpo:ComponentManufacturingProperty a owl:Class;
                                   rdfs:comment "";
                                   rdfs:label "ComponentManufacturingProperty"@en;
                                   rdfs:subClassOf [owl:allValuesFrom hpo:ComponentManufacturing ; 
                                                    owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasProperty>] ; 
                                                    a owl:Restriction],
                                                   <http://w3id.org/emmo#Objective>;
                                   skos:prefLabel "ComponentManufacturingProperty"@en.
hpo:Composite <http://w3id.org/emmo#elucidation> "A material made up of resin and reinforcement (usually fibre)."@en;
              a owl:Class;
              rdfs:comment "A material made up of resin and reinforcement (usually fibre)."@en;
              rdfs:isDefinedBy "https://compositesuk.co.uk/composite-materials/glossary-terms"^^xsd:anyURI;
              rdfs:label "Composite"@en;
              rdfs:subClassOf <http://w3id.org/emmo#ManufacturedMaterial>;
              skos:prefLabel "Composite"@en.
hpo:CompositeLaminate a owl:Class;
                      rdfs:comment "";
                      rdfs:label "CompositeLaminate"@en;
                      rdfs:subClassOf [owl:someValuesFrom hpo:StackedPrepreg ; 
                                       owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasNext>] ; 
                                       a owl:Restriction],
                                      <http://w3id.org/emmo#ManufacturedProduct>;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:intersectionOf (hpo:Composite
                                                               hpo:Laminate)];
                      skos:prefLabel "CompositeLaminate"@en.
hpo:CompositeLaminateBulkPorosity <http://w3id.org/emmo#elucidation> "After performing a cross-cut perpendicular to the specimen surface, based on a light microscopy image, the apparent surface area fraction occupied by pores is evaluated."@en;
                                  a owl:Class;
                                  rdfs:comment "After performing a cross-cut perpendicular to the specimen surface, based on a light microscopy image, the apparent surface area fraction occupied by pores is evaluated."@en;
                                  rdfs:label "CompositeLaminateBulkPorosity"@en;
                                  rdfs:subClassOf hpo:CompositeLaminateProperty;
                                  skos:prefLabel "CompositeLaminateBulkPorosity"@en.
hpo:CompositeLaminateProperty a owl:Class;
                              rdfs:comment "";
                              rdfs:label "CompositeLaminateProperty"@en;
                              rdfs:subClassOf [owl:allValuesFrom hpo:CompositeLaminate ; 
                                               owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasProperty>] ; 
                                               a owl:Restriction],
                                              <http://w3id.org/emmo#Objective>;
                              skos:prefLabel "CompositeLaminateProperty"@en.
hpo:CompositeLaminateSurfaceRegionPorosity <http://w3id.org/emmo#elucidation> "Based on a light microscopy image of the smoother surface (i.e. the one visible to a user) of the composite laminate, the apparent surface area fraction occupied by pores is evaluated."@en;
                                           a owl:Class;
                                           rdfs:comment "Based on a light microscopy image of the smoother surface (i.e. the one visible to a user) of the composite laminate, the apparent surface area fraction occupied by pores is evaluated."@en;
                                           rdfs:label "CompositeLaminateSurfaceRegionPorosity"@en;
                                           rdfs:subClassOf hpo:CompositeLaminateProperty;
                                           skos:prefLabel "CompositeLaminateSurfaceRegionPorosity"@en.
hpo:CompositeLaminateVisualSurfaceFinish <http://w3id.org/emmo#elucidation> "Using a (set of) specimen illumination settings, the appearance is compared with the appearance of a specified set of (reference) specimens."@en;
                                         a owl:Class;
                                         rdfs:comment "Using a (set of) specimen illumination settings, the appearance is compared with the appearance of a specified set of (reference) specimens."@en;
                                         rdfs:label "CompositeLaminateVisualSurfaceFinish"@en;
                                         rdfs:subClassOf hpo:CompositeLaminateProperty;
                                         skos:prefLabel "CompositeLaminateVisualSurfaceFinish"@en.
hpo:CondensationPolymer <http://w3id.org/emmo#elucidation> "A polymer obtained through a condensation reaction, that is, where two molecules form a chemical bond by eliminating a small molecule such as water."@en;
                        a owl:Class;
                        rdfs:comment "A polymer obtained through a condensation reaction, that is, where two molecules form a chemical bond by eliminating a small molecule such as water."@en;
                        rdfs:label "CondensationPolymer"@en;
                        rdfs:subClassOf <http://w3id.org/emmo#PolymericMaterial>;
                        skos:prefLabel "CondensationPolymer"@en.
hpo:CoverReleaseLayer <http://w3id.org/emmo#elucidation> "A release layer applied to a cover placed over the laminate."@en;
                      a owl:Class;
                      rdfs:comment "A release layer applied to a cover placed over the laminate."@en;
                      rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI;
                      rdfs:label "CoverReleaseLayer"@en;
                      rdfs:subClassOf hpo:ReleaseLayer;
                      skos:prefLabel "CoverReleaseLayer"@en.
hpo:CoverReleaseLayerIdentifier <http://w3id.org/emmo#elucidation> "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en;
                                a owl:Class;
                                rdfs:comment "Commercial name of the applied consumable (product), differentiating available product providers and product lots."@en;
                                rdfs:label "CoverReleaseLayerIdentifier"@en;
                                rdfs:subClassOf hpo:CoverReleaseLayerProperty;
                                skos:prefLabel "CoverReleaseLayerIdentifier"@en.
hpo:CoverReleaseLayerProperty a owl:Class;
                              rdfs:comment "";
                              rdfs:label "CoverReleaseLayerProperty"@en;
                              rdfs:subClassOf [owl:allValuesFrom hpo:CoverReleaseLayer ; 
                                               owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasProperty>] ; 
                                               a owl:Restriction],
                                              <http://w3id.org/emmo#Objective>;
                              skos:prefLabel "CoverReleaseLayerProperty"@en.
hpo:CoverTool <http://w3id.org/emmo#elucidation> "The mold, either one- or two-sided and either open or closed, in or upon which composite material is placed in order to make a part."@en;
              a owl:Class;
              rdfs:comment "The mold, either one- or two-sided and either open or closed, in or upon which composite material is placed in order to make a part."@en;
              rdfs:isDefinedBy "https://www.compositesworld.com/glossary"^^xsd:anyURI;
              rdfs:label "CoverTool"@en;
              rdfs:subClassOf <http://w3id.org/emmo#Tool>;
              skos:prefLabel "CoverTool"@en.
hpo:CoverToolHoleDistance <http://w3id.org/emmo#elucidation> "Average distance between holes."@en;
                          a owl:Class;
                          rdfs:comment "Average distance between holes."@en;
                          rdfs:label "CoverToolHoleDistance"@en;
                          rdfs:subClassOf hpo:CoverToolProperty;
                          skos:prefLabel "CoverToolHoleDistance"@en.
hpo:CoverToolLength <http://w3id.org/emmo#elucidation> "Length (contributing to the size of the tool)."@en;
                    a owl:Class;
                    rdfs:comment "Length (contributing to the size of the tool)."@en;
                    rdfs:label "CoverToolLength"@en;
                    rdfs:subClassOf <http://w3id.org/emmo#Length>,
                                    hpo:CoverToolProperty;
                    skos:prefLabel "CoverToolLength"@en.
hpo:CoverToolNumberOfHoles <http://w3id.org/emmo#elucidation> "Amount of holes."@en;
                           a owl:Class;
                           rdfs:comment "Amount of holes."@en;
                           rdfs:label "CoverToolNumberOfHoles"@en;
                           rdfs:subClassOf hpo:CoverToolProperty;
                           skos:prefLabel "CoverToolNumberOfHoles"@en.
hpo:CoverToolProperty a owl:Class;
                      rdfs:comment "";
                      rdfs:label "CoverToolProperty"@en;
                      rdfs:subClassOf [owl:allValuesFrom hpo:CoverTool ; 
                                       owl:onProperty [owl:inverseOf <http://w3id.org/emmo#hasProperty>] ; 
                                       a owl:Restriction],
                                      <http://w3id.org/emmo#Objective>;
                      skos:prefLabel "CoverToolProperty"@en.
hpo:CoverToolSizeOfHoles <http://w3id.org/emmo#elucidation> "Average diameter of holes."@en;
                         a owl:Class;
                         rdfs:comment "Average diameter of holes."@en;
                         rdfs:label "CoverToolSizeOfHoles"@en;
                         rdfs:subClassOf <http://w3id.org/emmo#Diameter>,
                                         hpo:CoverToolProperty;
                         skos:prefLabel "CoverToolSizeOfHoles"@en.
hpo:CoverToolWidth <http://w3id.org/emmo#elucidation> "Width (contributing to the size of the tool)."@en;
                   a owl:Class;
