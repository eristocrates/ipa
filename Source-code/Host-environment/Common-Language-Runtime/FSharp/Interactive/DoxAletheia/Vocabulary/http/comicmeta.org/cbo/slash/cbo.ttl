@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cbo: <http://comicmeta.org/cbo/>.

cbo: <http://purl.org/dc/elements/1.1/creator> <https://sean.petiya.com/#me>;
     <http://purl.org/dc/elements/1.1/description> "A metadata vocabulary for describing comic books and comic book collections.";
     <http://purl.org/dc/elements/1.1/modified> "2015-12-05"@en;
     <http://purl.org/dc/elements/1.1/rights> "Copyright © PD&C, LLC"@en;
     <http://purl.org/dc/elements/1.1/title> "Comic Book Ontology"@en;
     <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0>;
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "cbo";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://comicmeta.org/cbo/",
                                                        "http://comicmeta.org/cbo";
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#versionIRI> cbo:;
     <http://www.w3.org/2002/07/owl#versionInfo> "0.14.1".
cbo:Agent a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A person, organization, or intelligence in a comic universe."@en;
          rdfs:label "Agent";
          rdfs:subClassOf cbo:Thing;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Artwork a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Original comic artwork."@en;
            rdfs:label "Artwork"@en;
            rdfs:subClassOf <http://schema.org/IndividualProduct>,
                            cbo:Item;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Balloon a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A word balloon containing dialogue or thought."@en;
            rdfs:label "Balloon"@en;
            rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.balloon";
            rdfs:subClassOf cbo:Sequence;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Binding a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A binding method or material used to bind the pages of a comic."@en;
            rdfs:label "Binding"@en;
            rdfs:subClassOf cbo:Material;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Box a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:comment "A box that contains comic books."@en;
        rdfs:label "Box"@en;
        rdfs:subClassOf cbo:Container;
        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Building a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A building in a comic universe."@en;
             rdfs:label "Building"@en;
             rdfs:subClassOf cbo:Object;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
cbo:Caption a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A caption containing narration."@en;
            rdfs:label "Caption"@en;
            rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.caption";
            rdfs:subClassOf cbo:Sequence;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Character a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A comic character."@en;
              rdfs:label "Character"@en;
              rdfs:subClassOf cbo:Agent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Collection a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A collection of comic books and related resources."@en;
               rdfs:label "Collection"@en;
               rdfs:subClassOf <http://purl.org/dc/dcmitype/Collection>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Collector a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A comic book collector."@en;
              rdfs:label "Collector"@en;
              rdfs:subClassOf <http://schema.org/Person>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Comic a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A visual and literary work of sequential art."@en;
          rdfs:label "Comic"@en;
          rdfs:subClassOf <http://schema.org/CreativeWork>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
cbo:ComicAge a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A period of comic book history."@en;
             rdfs:label "Comic Age"@en;
             rdfs:subClassOf <http://schema.org/Intangible>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:ComicUniverse a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A comic universe."@en;
                  rdfs:label "Comic Universe"@en;
                  rdfs:subClassOf <http://schema.org/CreativeWork>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Condition a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A physical condition describing an object."@en;
              rdfs:label "Condition"@en;
              rdfs:subClassOf cbo:PhysicalAttribute;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Container a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An object containing comic books."@en;
              rdfs:label "Container"@en;
              rdfs:subClassOf <http://purl.org/dc/dcmitype/PhysicalObject>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Contributor a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An agent contributing to the creation of a comic work."@en;
                rdfs:label "Contributor"@en;
                rdfs:subClassOf <http://schema.org/Person>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Copy a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A copy of a comic issue."@en;
         rdfs:label "Copy"@en;
         rdfs:subClassOf <http://schema.org/IndividualProduct>,
                         cbo:Item,
                         cbo:Issue;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Costume a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A comic character's costume."@en;
            rdfs:label "Costume"@en;
            rdfs:subClassOf cbo:Object;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Creator a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An agent primarily responsible for the creation of a comic work."@en;
            rdfs:label "Creator"@en;
            rdfs:subClassOf <http://schema.org/Person>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Distributor a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An agent responsible for the distribution of a comic publication."@en;
                rdfs:label "Distributor";
                rdfs:subClassOf <http://schema.org/Organization>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Document a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A document composed of the pages in a comic publication."@en;
             rdfs:label "Document"@en;
             rdfs:subClassOf cbo:Comic;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Edition a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An edition of a comic issue."@en;
            rdfs:label "Edition"@en;
            rdfs:subClassOf <http://schema.org/Intangible>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Event a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "An event in a comic universe."@en;
          rdfs:label "Event"@en;
          rdfs:subClassOf cbo:Thing;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Format a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A format in which a comic is embodied."@en;
           rdfs:label "Format"@en;
           rdfs:subClassOf <http://schema.org/Intangible>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Frequency a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A frequency with which a comic is published."@en;
              rdfs:label "Frequency"@en;
              rdfs:subClassOf <http://schema.org/Intangible>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Genre a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A comics genre."@en;
          rdfs:label "Genre"@en;
          rdfs:subClassOf <http://schema.org/Intangible>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Grade a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A grade assigned to a comic item that represents a summary of its condition."@en;
          rdfs:label "Grade"@en;
          rdfs:subClassOf <http://schema.org/Intangible>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Guarantor a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An organization that guarantees the stated condition of a comic book."@en;
              rdfs:label "Guarantor"@en;
              rdfs:subClassOf <http://schema.org/Organization>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Imprint a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An imprint or tradename of a comic publisher."@en;
            rdfs:label "Imprint"@en;
            rdfs:subClassOf cbo:Publisher;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Issue a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "An issue of a comic publication."@en;
          rdfs:label "Issue"@en;
          rdfs:subClassOf <http://schema.org/PublicationIssue>,
                          <http://schema.org/Product>,
                          cbo:Publication;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Item a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A physical or digital item."@en;
         rdfs:label "Item";
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Library a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A physical or digital library containing a collection of comic resources."@en;
            rdfs:label "Library";
            rdfs:subClassOf <http://schema.org/Organization>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Location a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A location in a comic universe."@en;
             rdfs:label "Location"@en;
             rdfs:subClassOf cbo:Thing;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Material a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A material or medium of which an object is composed."@en;
             rdfs:label "Material";
             rdfs:subClassOf cbo:PhysicalAttribute;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Museum a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A physical or digital museum exhibiting a collection of comic resources."@en;
           rdfs:label "Museum"@en;
           rdfs:subClassOf <http://schema.org/Organization>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Object a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An object in a comic universe."@en;
           rdfs:label "Object"@en;
           rdfs:subClassOf cbo:Thing;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Page a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "One or more pages in a comic document."@en;
         rdfs:label "Page"@en;
         rdfs:subClassOf cbo:Document;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:PageType a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A type of page appearing in a comic document."@en;
             rdfs:label "Page Type"@en;
             rdfs:subClassOf <http://schema.org/Intangible>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Panel a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A visual frame containing part of a sequence."@en;
          rdfs:label "Panel"@en;
          rdfs:seeAlso "http://dcl.slis.indiana.edu/cbml/schema/cbml.html#TEI.panel";
          rdfs:subClassOf cbo:Sequence;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Paper a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A paper stock on which a comic is printed."@en;
          rdfs:label "Paper"@en;
          rdfs:subClassOf cbo:Material;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Pedigree a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An exceptional original owner collection of high quality, vintage comic books often containing copies that are considered exemplars of key issues."@en;
             rdfs:label "Pedigree"@en;
             rdfs:subClassOf cbo:Collection;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:PhysicalAttribute a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An physical attribute or property of an item."@en;
                      rdfs:label "Attribute"@en;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Planet a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A planetary body in a comic universe."@en;
           rdfs:label "Planet"@en;
           rdfs:subClassOf cbo:Location;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Plastic a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A plastic of which a supply item is composed."@en;
            rdfs:label "Plastic"@en;
            rdfs:subClassOf cbo:Material;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Publication a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A comics publication."@en;
                rdfs:label "Publication"@en;
                rdfs:subClassOf cbo:Comic;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Publisher a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An agent responsible for the publication of a comic."@en;
              rdfs:label "Publisher"@en;
              rdfs:subClassOf <http://schema.org/Organization>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Quality a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A distinctive quality belonging to an object."@en;
            rdfs:label "Quality";
            rdfs:subClassOf cbo:PhysicalAttribute;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Role a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A creative role in the production of a comic work."@en;
         rdfs:label "Role"@en;
         rdfs:subClassOf <http://schema.org/Intangible>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Sequence a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A visual sequence of juxtaposed panels and pictorial elements."@en;
             rdfs:label "Sequence"@en;
             rdfs:subClassOf cbo:Comic;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Series a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A comic publication containing one or more volumes and issues."@en;
           rdfs:label "Series"@en;
           rdfs:subClassOf <http://schema.org/Periodical>,
                           cbo:Publication;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:State a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A physical state describing an object."@en;
          rdfs:label "State"@en;
          rdfs:subClassOf cbo:PhysicalAttribute;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Story a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A comic story."@en;
          rdfs:label "Story"@en;
          rdfs:subClassOf cbo:Comic;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Team a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A group of comic characters."@en;
         rdfs:label "Team";
         rdfs:subClassOf cbo:Agent;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Thing a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A thing in a comic universe."@en;
          rdfs:label "Thing";
          rdfs:subClassOf cbo:ComicUniverse;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Vehicle a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A vehicle in a comic universe.";
            rdfs:label "Vehicle";
            rdfs:subClassOf cbo:Object;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:Volume a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A single issue or group of issues published in a comic series."@en;
           rdfs:label "Volume"@en;
           rdfs:subClassOf <http://schema.org/PublicationVolume>,
                           cbo:Publication;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:adaptation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Links a comic to an adaptation."@en;
               rdfs:domain cbo:Comic;
               rdfs:label "adaptation"@en;
               rdfs:range <http://schema.org/CreativeWork>;
               rdfs:subPropertyOf <http://purl.org/dc/terms/hasVersion>;
               <http://www.w3.org/2002/07/owl#inverseOf> cbo:adaptationOf;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:adaptationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Links a work to the comic work it is an adaptation of."@en;
                 rdfs:domain cbo:Comic;
                 rdfs:label "adaptation of"@en;
                 rdfs:range cbo:Comic;
                 rdfs:subPropertyOf <http://purl.org/dc/terms/isVersionOf>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:alternativeTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "An alternative title for any comic work."@en;
                     rdfs:domain cbo:Comic;
                     rdfs:label "alternative title"@en;
                     rdfs:range rdfs:Literal;
                     rdfs:subPropertyOf <http://purl.org/dc/terms/alternative>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:appearance a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Describes the appearance of a comic universe element within a comic work."@en;
               rdfs:domain cbo:Comic;
               rdfs:label "appearance"@en;
               rdfs:range cbo:Thing;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:artist a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Associates an artist with a comic work."@en;
           rdfs:domain cbo:Comic;
           rdfs:label "artist"@en;
           rdfs:range cbo:Contributor;
           rdfs:subPropertyOf cbo:contributor;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:artwork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Links a comic page to its original artwork."@en;
            rdfs:domain cbo:Page;
            rdfs:label "artwork"@en;
            rdfs:range cbo:Artwork;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:artworkOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Links orginal comic artwork to a page."@en;
              rdfs:domain cbo:Artwork;
              rdfs:label "artwork of"@en;
              rdfs:range cbo:Page;
              <http://www.w3.org/2002/07/owl#inverseOf> cbo:artwork;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:artworkType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Describes the artwork type of one or more pages of comic art."@en;
                rdfs:label "artwork type"@en;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:attribute a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Describes a physical attribute of a comic item."@en;
              rdfs:domain <http://purl.org/dc/dcmitype/PhysicalObject>;
              rdfs:label "attribute"@en;
              rdfs:range cbo:PhysicalAttribute;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:bagged <http://purl.org/dc/elements/1.1/description> "Having this property implies that the comic is bagged."@en;
           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Describes the bag in which a comic is contained."@en;
           rdfs:domain cbo:Copy;
           rdfs:label "bagged"@en;
           rdfs:range cbo:Material;
           rdfs:subPropertyOf cbo:attribute;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
cbo:balloon a <http://www.w3.org/2002/07/owl#ObjectProperty>;
