@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix identity: <http://www.identity.org/ontologies/identity.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

_:B4551082a6d30a7abc7bbc49cb2bde198 a owl:Axiom;
                                    rdfs:label "Day";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateYmd;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:gDay ; 
                                                         owl:onProperty identity:ymdDay ; 
                                                         a owl:Restriction].
_:B685a2a3bcdf0844a61b515a300aca545 a owl:AllDisjointClasses;
                                    owl:members (identity:FaceRecognition
                                                 identity:FingerprintRecognition
                                                 identity:IrisRecognition
                                                 identity:KeystokeDynamicRecognition
                                                 identity:VoiceRecognition).
_:B7b3e579d5bbce3bceed76e4adea9f0f8 a owl:Axiom;
                                    rdfs:label "Month";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateYmd;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:gMonth ; 
                                                         owl:onProperty identity:ymdMonth ; 
                                                         a owl:Restriction].
_:B9caaea1b0a2493d215f10c4fca8a74d0 a owl:Axiom;
                                    rdfs:label "Second";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateHms;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:time ; 
                                                         owl:onProperty identity:hmsSecond ; 
                                                         a owl:Restriction].
_:Bb833e70adfa931609826f391217a611f a owl:Axiom;
                                    rdfs:label "Month/Year";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateYmd;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:gMonthYear ; 
                                                         owl:onProperty identity:ymdMonthYear ; 
                                                         a owl:Restriction].
_:Bc736edc6fa72860d47efb3c162ba93b0 a owl:Axiom;
                                    rdfs:label "Year/Month";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateYmd;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:gYearMonth ; 
                                                         owl:onProperty identity:ymdYearMonth ; 
                                                         a owl:Restriction].
_:Bd7edadef0a9ac48ca8d2fef7d4c5fb64 a owl:Axiom;
                                    rdfs:label "Hour";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateHms;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:time ; 
                                                         owl:onProperty identity:hmsHour ; 
                                                         a owl:Restriction].
_:Be181f4f5652ca5863a940238142abaab a owl:Axiom;
                                    rdfs:label "Minute";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateHms;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:time ; 
                                                         owl:onProperty identity:hmsMinute ; 
                                                         a owl:Restriction].
_:Be628a4f9471c11132caecdc0a0a9cbfb a owl:Axiom;
                                    rdfs:label "Year";
                                    owl:annotatedProperty rdfs:subClassOf;
                                    owl:annotatedSource identity:DateYmd;
                                    owl:annotatedTarget [owl:someValuesFrom xsd:gYear ; 
                                                         owl:onProperty identity:ymdYear ; 
                                                         a owl:Restriction].
_:Bf02cedf1ef87799f04b2e4b00ca0ad3d a owl:AllDisjointClasses;
                                    owl:members (identity:AlarmClockProvider
                                                 identity:BrowserProvider
                                                 identity:CallLogProvider
                                                 identity:ContactsContractProvider
                                                 identity:LiveFoldersProvider
                                                 identity:MediaStoreProvider
                                                 identity:SearchRecentSuggestionsProvider
                                                 identity:SettingsProvider
                                                 identity:SyncStateContractProvider
                                                 identity:UserDictionaryProvider).
dc11:creator a owl:AnnotationProperty.
dc11:type a owl:AnnotationProperty.
<http://www.identity.org/ontologies/identity.owl> dc11:creator "Maroua Borsali";
                                                  a owl:Ontology;
                                                  rdfs:comment "Ontologie de l'identité numérique."@fr,
                                                               "Ontology of digital identity."@en;
                                                  owl:versionInfo "v.2.0 basée sur les spécifications de P3P recommandées par 3WC."@fr.
identity:Action a owl:Class;
                rdfs:label "Action";
                rdfs:subClassOf owl:Thing.
identity:Agent a owl:Class;
               rdfs:label "Agent";
               rdfs:subClassOf [owl:someValuesFrom identity:IdentityInformation ; 
                                owl:onProperty identity:hasIdentity ; 
                                a owl:Restriction],
                               [owl:someValuesFrom identity:Data ; 
                                owl:onProperty identity:hasData ; 
                                a owl:Restriction],
                               owl:Thing.
identity:AlarmClockProvider a owl:Class;
                            rdfs:subClassOf identity:ContentProvider.
identity:BiometricData a owl:Class;
                       rdfs:label "BiometricData";
                       rdfs:subClassOf [owl:someValuesFrom rdf:XMLLiteral ; 
                                        owl:onProperty identity:bimetricFile ; 
                                        a owl:Restriction],
                                       identity:Data.
identity:BrowserProvider a owl:Class;
                         rdfs:subClassOf identity:ContentProvider.
identity:Business a owl:Class;
                  rdfs:comment "Un business est une entité morale comme une organisation, une entreprise, une association ou une agence..."@fr,
                               "A business is a legal entity which is permitted to enter into a contract with another entity."@en;
                  rdfs:label "Business";
                  rdfs:subClassOf [owl:someValuesFrom identity:BusinessInformation ; 
                                   owl:onProperty identity:hasIdentity ; 
                                   a owl:Restriction],
                                  identity:Agent.
identity:BusinessInformation a owl:Class;
                             rdfs:comment "Identité associée uniquement à une personne morale."@fr;
                             rdfs:label "BusinessInformation";
                             rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                              owl:onProperty identity:businessName ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom identity:ContactInformation ; 
                                              owl:onProperty identity:hasContactInfo ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom xsd:anyType ; 
                                              owl:onProperty identity:logo ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom rdfs:Literal ; 
                                              owl:onProperty identity:businessUnit ; 
                                              a owl:Restriction],
                                             identity:IdentityInformation.
identity:CallLogProvider a owl:Class;
                         rdfs:subClassOf identity:ContentProvider.
identity:CellPhoneData a owl:Class;
                       rdfs:comment "Les données correspondant à l'appareil mobile."@fr;
                       rdfs:label "CellPhoneData";
                       rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                        owl:onProperty identity:imei ; 
                                        a owl:Restriction],
                                       [owl:someValuesFrom rdfs:Literal ; 
                                        owl:onProperty identity:cellID ; 
                                        a owl:Restriction],
                                       [owl:someValuesFrom rdfs:Literal ; 
                                        owl:onProperty identity:languageCode ; 
                                        a owl:Restriction],
                                       identity:Data.
identity:Certificate a owl:Class;
                     rdfs:comment "Il s'agit de l'élèment de l'identité qui permettera l'authentification de l'utilisateur, du fournisseur de service ainsi que l'émetteur de l'identité."@fr,
                                  "This structure is used to specify identity certificates."@en;
                     rdfs:label "User or Organization Identity Certificate";
                     rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                      owl:onProperty identity:key ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom rdfs:Literal ; 
                                      owl:onProperty identity:format ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom identity:Date ; 
                                      owl:onProperty identity:hasExpirationDate ; 
                                      a owl:Restriction],
                                     owl:Thing.
identity:ChatAccount a owl:Class;
                     rdfs:comment "Compte de discussion en ligne."@fr;
                     rdfs:label "ChatAccount";
                     rdfs:subClassOf identity:OnlineAccount.
identity:Condition a owl:Class;
                   rdfs:label "Condition";
                   rdfs:subClassOf owl:Thing.
identity:ContactInformation a owl:Class;
                            rdfs:comment "Les informations nécessaires pour contacter un agent."@fr,
                                         "Required information to contact an agent."@en;
                            rdfs:label "ContactInformation";
                            rdfs:subClassOf owl:Thing.
identity:ContactsContractProvider a owl:Class;
                                  rdfs:subClassOf identity:ContentProvider.
identity:ContentProvider a owl:Class;
                         rdfs:subClassOf identity:Data.
identity:Context a owl:Class;
                 rdfs:label "Context";
                 rdfs:subClassOf owl:Thing.
identity:Data a owl:Class;
              rdfs:label "Data";
              rdfs:subClassOf owl:Thing.
identity:Date a owl:Class;
              rdfs:comment "The date structure specifies a date. Date information can be used in different ways, depending on the context."@en;
              rdfs:label "Date";
              rdfs:subClassOf [owl:someValuesFrom xsd:time ; 
                               owl:onProperty identity:timeZone ; 
                               a owl:Restriction],
                              [owl:someValuesFrom xsd:time ; 
                               owl:onProperty identity:fractionSecond ; 
                               a owl:Restriction],
                              owl:Thing.
identity:DateHms a owl:Class;
                 rdfs:label "Date: Hour/Minute/Second";
                 rdfs:subClassOf [owl:someValuesFrom xsd:time ; 
                                  owl:onProperty identity:hmsHour ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:time ; 
                                  owl:onProperty identity:hmsMinute ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:time ; 
                                  owl:onProperty identity:hmsDate ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:time ; 
                                  owl:onProperty identity:hmsSecond ; 
                                  a owl:Restriction],
                                 identity:Date.
identity:DateYmd a owl:Class;
                 rdfs:label "Date: Year/Month/Day";
                 rdfs:subClassOf [owl:someValuesFrom xsd:gMonthYear ; 
                                  owl:onProperty identity:ymdMonthYear ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:gYearMonth ; 
                                  owl:onProperty identity:ymdYearMonth ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:gDay ; 
                                  owl:onProperty identity:ymdDay ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:gMonth ; 
                                  owl:onProperty identity:ymdMonth ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:date ; 
                                  owl:onProperty identity:dateYmd ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom xsd:gYear ; 
                                  owl:onProperty identity:ymdYear ; 
                                  a owl:Restriction],
                                 identity:Date.
identity:EcommerceAccount a owl:Class;
                          rdfs:comment "Compte d'achat en ligne. Il peut contenir des informations critiques comme les données bancaires."@fr;
                          rdfs:label "EcommerceAccount";
                          rdfs:subClassOf identity:OnlineAccount.
identity:EncryptAlgo a owl:Class;
                     rdfs:label "Algorithme de chiffrement."@fr,
                                "EncryptAlgo";
                     rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                      owl:onProperty identity:algo ; 
                                      a owl:Restriction],
                                     identity:Data.
identity:FaceRecognition a owl:Class;
                         rdfs:label "FaceRecognition";
                         rdfs:subClassOf identity:BiometricData.
identity:Fax dc11:type "Physical Contact Information"@en;
             a owl:Class;
             rdfs:label "Fax";
             rdfs:subClassOf identity:Telecommunication.
identity:FingerprintRecognition a owl:Class;
                                rdfs:label "FingerprintRecognition";
                                rdfs:subClassOf identity:BiometricData.
identity:ForbiddenAction a owl:Class;
                         rdfs:label "ForbiddenAction";
                         rdfs:subClassOf identity:Action.
identity:GamingAccount a owl:Class;
                       rdfs:comment "Compte pour des jeux en ligne (gratuit ou payant)."@fr;
                       rdfs:label "GamingAccount";
                       rdfs:subClassOf identity:OnlineAccount.
identity:Group a owl:Class;
               rdfs:comment "Un groupe des personnes qui constituent la liste des contacts d'un individu."@fr,
                            "A group of persons that figure in the contact list of an individual."@en;
               rdfs:label "Group";
               rdfs:subClassOf [owl:someValuesFrom identity:Person ; 
                                owl:onProperty identity:hasMember ; 
                                a owl:Restriction],
                               identity:Individual.
identity:History a owl:Class;
                 rdfs:label "History";
                 rdfs:subClassOf owl:Thing.
identity:IdentityInformation a owl:Class;
                             rdfs:comment "Les informations relatives à une identité numérique d'une personne physique ou morale."@fr,
                                          "Identity information of a legal or natural entity."@en;
                             rdfs:label "IdentityInformation";
                             rdfs:subClassOf [owl:someValuesFrom identity:Certificate ; 
                                              owl:onProperty identity:hasCertificate ; 
                                              a owl:Restriction],
                                             owl:Thing.
identity:Individual a owl:Class;
                    rdfs:comment "L'ensemble des personnes physiques."@fr,
                                 "Indivuals or natural entities."@en;
                    rdfs:label "Individual";
                    rdfs:subClassOf identity:Agent;
                    owl:equivalentClass [owl:someValuesFrom identity:IndividualInformation ; 
                                         owl:onProperty identity:hasIdentity ; 
                                         a owl:Restriction].
identity:IndividualInformation a owl:Class;
                               rdfs:comment "Identité associée uniquement à une personne physique."@fr;
                               rdfs:label "IndividualInformation";
                               rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                                owl:onProperty identity:jobTitle ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom identity:Name ; 
                                                owl:onProperty identity:hasName ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom rdfs:Literal ; 
                                                owl:onProperty identity:gender ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom identity:ContactInformation ; 
                                                owl:onProperty identity:hasHomeInfo ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom identity:Login ; 
                                                owl:onProperty identity:hasLogin ; 
                                                a owl:Restriction],
                                               [owl:someValuesFrom identity:Date ; 
                                                owl:onProperty identity:hasBirthDate ; 
                                                a owl:Restriction],
                                               identity:IdentityInformation,
                                               [owl:unionOf ([owl:someValuesFrom rdfs:Literal ; 
                                                             owl:onProperty identity:businessUnit ; 
                                                             a owl:Restriction]
                                                             [owl:someValuesFrom rdfs:Literal ; 
                                                             owl:onProperty identity:employer ; 
                                                             a owl:Restriction]) ; 
                                                a owl:Class].
identity:InvalidCertificate a owl:Class;
                            rdfs:label "InvalidCertificate";
                            rdfs:subClassOf identity:Certificate.
identity:IrisRecognition a owl:Class;
                         rdfs:label "IrisRecognition";
                         rdfs:subClassOf identity:BiometricData.
identity:Issuer a owl:Class;
                rdfs:comment "L'émetteur d'une identité numérique (opérateur téléphonique par exemple)."@fr,
                             "This legal entity is the issuer of an individual digital identity."@en;
                rdfs:label "Issuer";
                rdfs:subClassOf [owl:someValuesFrom identity:IdentityInformation ; 
                                 owl:onProperty identity:isIssuerOf ; 
                                 a owl:Restriction],
                                identity:Business.
identity:KeystokeDynamicRecognition a owl:Class;
                                    rdfs:label "KeystokeDynamicRecognition";
                                    rdfs:subClassOf identity:BiometricData.
identity:LiveFoldersProvider a owl:Class;
                             rdfs:subClassOf identity:ContentProvider.
identity:LocationData a owl:Class;
                      rdfs:comment "Les données de locations permettant de localiser le porteur de l'identité."@fr;
                      rdfs:label "LocationData";
                      rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty identity:wifi ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty identity:gps ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty identity:ip ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty identity:latitude ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom rdfs:Literal ; 
                                       owl:onProperty identity:longitude ; 
                                       a owl:Restriction],
                                      identity:Data.
identity:LogData a owl:Class;
                 rdfs:label "LogInformation",
                            "LogInfo",
                            "LogData";
                 rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty identity:ip ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom identity:Date ; 
                                  owl:onProperty identity:timestamp ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty identity:uri ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom rdfs:Literal ; 
                                  owl:onProperty identity:callLog ; 
                                  a owl:Restriction],
                                 identity:Data.
identity:Login dc11:type "Unique Identifiers"@en;
               a owl:Class;
               rdfs:comment "IDs ans Passwords for web services which require authentification."@en;
               rdfs:label "User's Login Information";
               rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                owl:onProperty identity:password ; 
                                a owl:Restriction],
                               [owl:someValuesFrom rdfs:Literal ; 
                                owl:onProperty identity:id ; 
                                a owl:Restriction],
                               owl:Thing.
identity:MediaStoreProvider a owl:Class;
                            rdfs:subClassOf identity:ContentProvider.
identity:MiscData a owl:Class;
                  rdfs:comment "Photos, videos, sms, documents, notes, call logs, cookies..."@fr;
                  rdfs:label "MiscData";
                  rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                   owl:onProperty identity:cookie ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom xsd:anyType ; 
                                   owl:onProperty identity:photo ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom xsd:anyType ; 
                                   owl:onProperty identity:video ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom xsd:anyType ; 
                                   owl:onProperty identity:document ; 
                                   a owl:Restriction],
                                  identity:Data.
identity:Mobile dc11:type "Physical Contact Information"@en;
                a owl:Class;
                rdfs:label "Mobile";
                rdfs:subClassOf identity:Telecommunication.
identity:Mode a owl:Class;
              rdfs:label "Mode";
              rdfs:subClassOf owl:Thing.
identity:Name dc11:type "Physical Contact Information, Demographic and Socieconomic Data"@en;
              a owl:Class;
              rdfs:comment "The person name specifies information about the naming of a person."@en;
              rdfs:label "User's Name";
              rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty identity:nickName ; 
                               a owl:Restriction],
                              owl:Thing,
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty identity:familyName ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty identity:givenName ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty identity:title ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty identity:middleName ; 
                               a owl:Restriction].
identity:Online dc11:type "Online Contact Information"@en;
                a owl:Class;
                rdfs:comment "Les adresses électroniques pour contacter un agent."@fr,
                             "Online information about an agent."@en;
                rdfs:label "Online";
                rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:email ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:uri ; 
                                 a owl:Restriction],
                                identity:ContactInformation.
identity:OnlineAccount a owl:Class;
                       rdfs:comment "Les comptes en ligne de l'utilisateur."@fr;
                       rdfs:label "OnlineAccount";
                       rdfs:subClassOf identity:Data.
identity:Pager dc11:type "Physical Contact Information"@en;
               a owl:Class;
               rdfs:label "Pager";
               rdfs:subClassOf identity:Telecommunication.
identity:PermittedAction a owl:Class;
                         rdfs:label "PermittedAction";
                         rdfs:subClassOf identity:Action.
identity:Person a owl:Class;
                rdfs:comment "Une personne est un individu qui possède une identité numérique et qui cherche à protéger sa vie privée."@fr,
                             "A person is an individual who has a social identity and a technical one."@en;
                rdfs:label "Person";
                rdfs:subClassOf [owl:someValuesFrom identity:Group ; 
                                 owl:onProperty identity:knows ; 
                                 a owl:Restriction],
                                identity:Individual.
identity:Policy a owl:Class;
                rdfs:label "Policy";
                rdfs:subClassOf owl:Thing.
identity:Postal dc11:type "Physical Contact Information, Demographic and Socioeconomic Data"@en;
                a owl:Class;
                rdfs:comment "Postal mailing address."@en;
                rdfs:label "Postal";
                rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:number ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom xsd:integer ; 
                                 owl:onProperty identity:postalCode ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:city ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:country ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:region ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:departmentName ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom rdfs:Literal ; 
                                 owl:onProperty identity:street ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom xsd:long ; 
                                 owl:onProperty identity:departmentCode ; 
                                 a owl:Restriction],
                                identity:ContactInformation.
identity:SearchRecentSuggestionsProvider a owl:Class;
                                         rdfs:subClassOf identity:ContentProvider.
identity:SecretData a owl:Class;
                    rdfs:label "SecretData";
                    rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                                     owl:onProperty identity:pin ; 
                                     a owl:Restriction],
                                    identity:Data.
identity:ServiceProvider a owl:Class;
                         rdfs:comment "Le fournisseur de services mobiles (application, jeu, site Web)"@fr,
                                      "Provider of mobile phone services."@en;
                         rdfs:label "ServiceProvider";
                         rdfs:subClassOf identity:Business.
identity:SettingsProvider a owl:Class;
                          rdfs:subClassOf identity:ContentProvider.
identity:SyncStateContractProvider a owl:Class;
                                   rdfs:subClassOf identity:ContentProvider.
identity:Telecommunication dc11:type "Physical Contact Information"@en;
                           a owl:Class;
                           rdfs:comment "Telecommunication information about an agnet."@en;
                           rdfs:label "Telecommunication";
                           rdfs:subClassOf [owl:someValuesFrom identity:TelephoneNumber ; 
                                            owl:onProperty identity:hasTelephoneNumber ; 
                                            a owl:Restriction],
                                           identity:ContactInformation.
identity:Telephone dc11:type "Physical Contact Information"@en;
                   a owl:Class;
                   rdfs:label "Telephone";
                   rdfs:subClassOf identity:Telecommunication.
identity:TelephoneNumber a owl:Class;
                         rdfs:comment "The characteristics of a telephone number."@en;
                         rdfs:label "TelephoneNumber";
                         rdfs:subClassOf [owl:someValuesFrom xsd:long ; 
                                          owl:onProperty identity:phoneNumber ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom xsd:long ; 
                                          owl:onProperty identity:phoneExtension ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom xsd:long ; 
                                          owl:onProperty identity:localCode ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom xsd:long ; 
                                          owl:onProperty identity:intCode ; 
                                          a owl:Restriction],
                                         owl:Thing.
identity:UID a owl:Class;
             rdfs:comment "L'identifiant unique d'une entité qui possède une identité (agent).";
             rdfs:label "UID";
             rdfs:subClassOf [owl:someValuesFrom xsd:ID ; 
                              owl:onProperty identity:uid ; 
                              a owl:Restriction],
                             owl:Thing.
identity:UserDictionaryProvider a owl:Class;
                                rdfs:subClassOf identity:ContentProvider.
identity:ValidCertificate a owl:Class;
                          rdfs:label "ValidCertificate";
                          rdfs:subClassOf identity:Certificate.
identity:VoiceRecognition a owl:Class;
                          rdfs:label "VoiceRecognition";
                          rdfs:subClassOf identity:BiometricData.
