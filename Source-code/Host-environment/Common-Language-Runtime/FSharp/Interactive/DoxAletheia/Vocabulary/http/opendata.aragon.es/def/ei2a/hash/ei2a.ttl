                                                           [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                            <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2006/vcard/ns#fn> ; 
