                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                    <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/phone> ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>].
<http://xmlns.com/foaf/0.1/Post> a <http://www.w3.org/2002/07/owl#Class>;
