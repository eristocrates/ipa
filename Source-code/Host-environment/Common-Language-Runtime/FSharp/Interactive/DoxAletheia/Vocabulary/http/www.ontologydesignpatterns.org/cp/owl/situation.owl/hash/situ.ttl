@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix situ: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/situation.owl> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "What is the context or situation of something? What are the things present in this context or situation?"^^rdf:PlainLiteral;
                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Aldo Gangemi"^^rdf:PlainLiteral;
                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """We can contextualize things that have something in common, or are associated: a same place, time, view, causal link, systemic dependence, etc.
We can also reify n-ary relations as situations."""^^rdf:PlainLiteral;
                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent contexts or situations, and the things that are contextualized."^^rdf:PlainLiteral;
                                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "The lecture was held in January 1921 by Bela Fleck, with some physicians in the audience making questions, in a very relaxed athmosphere."^^rdf:PlainLiteral;
                                                             a <http://www.w3.org/2002/07/owl#Ontology>;
                                                             rdfs:label "situation"^^rdf:PlainLiteral;
                                                             <http://www.w3.org/2002/07/owl#imports> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                             <http://www.w3.org/2002/07/owl#versionInfo> "Created by Aldo Gangemi and Valentina Presutti",
                                                                                                         "1.1 added rdfs:isDefinedBy for all named entities".
situ:Situation a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """A view on a set of entities. It can be seen as a 'relational context', reifying a relation.
For example, a PlanExecution is a context including some actions executed by agents according to certain parameters and expected tasks to be achieved from a Plan; a DiagnosedSituation is a context of observed entities that is interpreted on the basis of a Diagnosis, etc.
Situation is also able to represent reified n-ary relations, where isSettingFor is the top-level relation for all binary projections of the n-ary relation. If used in a transformation pattern for n-ary relations, the designer should take care of:
- creating only one situation for each instance of an n-ary relation, otherwise the 'identification constraint' (Calvanese et al., IJCAI 2001) could be violated
- adding an 'exact cardinality' restriction corresponding to the arity of the n-ary relation, otherwise the designer would actually represent a polymorphic relation.""";
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
               rdfs:label "Situation"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> situ:isSettingFor ; 
                                <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>].
situ:hasSetting a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A relation between entities and situations, e.g. 'this morning I've prepared my coffee with a new fantastic Arabica' (i.e.: (an amount of) a new fantastic Arabica hasSetting the preparation of my coffee this morning).";
                rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
                rdfs:label "has setting"@en;
                rdfs:range situ:Situation;
                <http://www.w3.org/2002/07/owl#inverseOf> situ:isSettingFor.
situ:isSettingFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain situ:Situation;
                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>;
                  rdfs:label "is setting for"@en;
                  rdfs:range <http://www.w3.org/2002/07/owl#Thing>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
