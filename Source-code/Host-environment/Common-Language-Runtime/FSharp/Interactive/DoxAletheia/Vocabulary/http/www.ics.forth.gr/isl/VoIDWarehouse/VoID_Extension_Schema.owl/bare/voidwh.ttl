@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix voidwh: <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

dcmitype: dc11:description "The Dublin Core Types namespace provides URIs for the entries of the DCMI Type Vocabulary. Entries are declared using RDF Schema language to support RDF applications. The Schema will be updated according to dc-usage decisions."@en-us;
          dc11:language "English"@en-us;
          dc11:publisher "The Dublin Core Metadata Initiative"@en-us;
          dc11:source <http://dublincore.org/documents/dcmi-type-vocabulary/>,
                      <http://dublincore.org/usage/terms/>;
          dc11:title "The DCMI Types namespace providing access to its content by means of an RDF Schema"@en-us;
          dcterms:isReferencedBy dcterms:;
          dcterms:issued "2000-07-11";
          dcterms:modified "2002-05-22";
          dcterms:requires dc11:,
                           <http://dublincore.org/documents/dcmi-type-vocabulary/>.
dcmitype:Collection dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Collection-001>;
                    dcterms:issued "2000-07-11";
                    a dcterms:DCMIType,
                      owl:NamedIndividual,
                      owl:Class;
                    rdfs:comment """A collection is an aggregation of items. The term 
		collection means that the resource is described as a 
		group; its parts may be separately described and navigated."""@en-us;
                    rdfs:isDefinedBy dcmitype:;
                    rdfs:label "Collection"@en-us.
dcmitype:Dataset dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                 dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Dataset-001>;
                 dcterms:issued "2000-07-11";
                 a dcterms:DCMIType,
                   owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment """A dataset is information encoded in a defined structure 
		(for example, lists, tables, and databases), intended to 
		be useful for direct machine processing."""@en-us;
                 rdfs:isDefinedBy dcmitype:;
                 rdfs:label "Dataset"@en-us.
dcmitype:Event dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
               dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Event-001>;
               dcterms:issued "2000-07-11";
               a dcterms:DCMIType,
                 owl:NamedIndividual,
                 owl:Class;
               rdfs:comment """An event is a non-persistent, time-based occurrence. 
		Metadata for an event provides descriptive
		information that is the basis for discovery of the
		purpose, location, duration, responsible agents, and
		links to related events and resources.  The resource
		of type event may not be retrievable if the described
		instantiation has expired or is yet to occur.
		Examples - exhibition, web-cast, conference,
		workshop, open-day, performance, battle, trial,
		wedding, tea-party, conflagration."""@en-us;
               rdfs:isDefinedBy dcmitype:;
               rdfs:label "Event"@en-us.
dcmitype:Image dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
               dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Image-002>;
               dcterms:issued "2000-07-11";
               a dcterms:DCMIType,
                 owl:NamedIndividual,
                 owl:Class;
               rdfs:comment """An image is a primarily symbolic visual representation 
		other than text. For example - images and photographs of 
		physical objects, paintings, prints, drawings, other 
		images and graphics, animations and moving pictures, 
		film, diagrams, maps, musical notation. Note that image 
		may include both electronic and physical representations."""@en-us;
               rdfs:isDefinedBy dcmitype:;
               rdfs:label "Image"@en-us.
dcmitype:InteractiveResource dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                             dcterms:hasVersion <http://dublincore.org/usage/terms/history/#InteractiveResource-001>;
                             dcterms:issued "2000-07-11";
                             a dcterms:DCMIType,
                               owl:NamedIndividual,
                               owl:Class;
                             rdfs:comment """An interactive resource is a resource which requires 
		interaction from the user to be understood, executed, 
		or experienced. For example - forms on web pages, applets, 
		multimedia learning objects, chat services, virtual 
		reality."""@en-us;
                             rdfs:isDefinedBy dcmitype:;
                             rdfs:label "Interactive Resource"@en-us.
dcmitype:MovingImage dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                     dcterms:hasVersion <http://dublincore.org/usage/terms/history/#MovingImage-001>;
                     dcterms:issued "2003-11-18";
                     a owl:NamedIndividual,
                       owl:Class,
                       dcterms:DCMIType;
                     rdfs:comment """A series of visual representations that,
        when shown in succession, impart an impression
        of motion.  Examples of moving images are:
        animations, movies, television programs,
        videos, zoetropes, or visual output from
        a simulation."""@en-us;
                     rdfs:isDefinedBy dcmitype:;
                     rdfs:label "Moving Image"@en-us;
                     rdfs:subClassOf dcmitype:Image.
dcmitype:PhysicalObject dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                        dcterms:hasVersion <http://dublincore.org/usage/terms/history/#PhysicalObject-001>;
                        dcterms:issued "2002-07-13";
                        a dcterms:DCMIType,
                          owl:NamedIndividual,
                          owl:Class;
                        rdfs:comment """An inanimate, three-dimensional object or substance.  
		For example -- a computer, the great pyramid, a 
		sculpture.  Note that digital representations 
		of, or surrogates for, these things should use Image, 
		Text or one of the other types."""@en-us;
                        rdfs:isDefinedBy dcmitype:;
                        rdfs:label "Physical Object"@en-us.
dcmitype:Service dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                 dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Service-001>;
                 dcterms:issued "2000-07-11";
                 a dcterms:DCMIType,
                   owl:NamedIndividual,
                   owl:Class;
                 rdfs:comment """A service is a system that provides one or more 
		functions of value to the end-user. Examples include: 
		a photocopying service, a banking service, an 
		authentication service, interlibrary loans, a Z39.50 
		or Web server."""@en-us;
                 rdfs:isDefinedBy dcmitype:;
                 rdfs:label "Service"@en-us.
dcmitype:Software dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                  dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Software-001>;
                  dcterms:issued "2000-07-11";
                  a dcterms:DCMIType,
                    owl:NamedIndividual,
                    owl:Class;
                  rdfs:comment """Software is a computer program in source or 
		compiled form which may be available for installation 
		non-transiently on another machine. For software which 
		exists only to create an interactive environment, use 
		interactive instead."""@en-us;
                  rdfs:isDefinedBy dcmitype:;
                  rdfs:label "Software"@en-us.
dcmitype:Sound dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
               dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Sound-001>;
               dcterms:issued "2000-07-11";
               a dcterms:DCMIType,
                 owl:NamedIndividual,
                 owl:Class;
               rdfs:comment """A sound is a resource whose content is primarily 
		intended to be rendered as audio. For example - a 
		music playback file format, an audio compact disc, 
		and recorded speech or sounds."""@en-us;
               rdfs:isDefinedBy dcmitype:;
               rdfs:label "Sound"@en-us.
dcmitype:StillImage dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                    dcterms:hasVersion <http://dublincore.org/usage/terms/history/#StillImage-001>;
                    dcterms:issued "2003-11-18";
                    a owl:Class,
                      owl:NamedIndividual,
                      dcterms:DCMIType;
                    rdfs:comment """A static visual representation. Examples of
        still images are: paintings, drawings, graphic designs,
        plans and maps."""@en-us;
                    rdfs:isDefinedBy dcmitype:;
                    rdfs:label "Still Image"@en-us;
                    rdfs:subClassOf dcmitype:Image.
dcmitype:Text dc11:type <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
              dcterms:hasVersion <http://dublincore.org/usage/terms/history/#Text-001>;
              dcterms:issued "2000-07-11";
              a dcterms:DCMIType,
                owl:NamedIndividual,
                owl:Class;
              rdfs:comment """A text is a resource whose content is primarily 
		words for reading. For example - books, letters, 
		dissertations, poems, newspapers, articles, 
		archives of mailing lists. Note that facsimiles 
		or images of texts are still of the genre text."""@en-us;
              rdfs:isDefinedBy dcmitype:;
              rdfs:label "Text"@en-us.
dc11:description a owl:AnnotationProperty.
dc11:language a owl:AnnotationProperty.
dc11:publisher a owl:AnnotationProperty.
dc11:source a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dc11:type a owl:AnnotationProperty.
dcterms:Agent a owl:Class.
dcterms:DCMIType dc11:description """The DCMI Type Vocabulary provides a general, cross-domain list of
	    approved terms that may be used as values for the Resource Type
	    element to identify the genre of a resource.""";
                 dcterms:issued "2000-07-11";
                 a dcterms:TypeScheme,
                   owl:NamedIndividual,
                   owl:Class.
dcterms:TypeScheme a owl:Class.
dcterms:hasVersion a owl:AnnotationProperty.
dcterms:isReferencedBy a owl:AnnotationProperty.
dcterms:issued a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:requires a owl:AnnotationProperty.
void:Dataset a owl:Class.
<http://users.ics.forth.gr/~fafalios/> a foaf:Person,
                                         owl:NamedIndividual.
<http://users.ics.forth.gr/~marketak/pages/aboutme.html> a foaf:Person,
                                                           owl:NamedIndividual.
<http://users.ics.forth.gr/~tzitzik/> a foaf:Person,
                                        owl:NamedIndividual.
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl> dcterms:contributor "Carlo Allocca",
                                                                                          <http://users.ics.forth.gr/~fafalios/>,
                                                                                          <http://users.ics.forth.gr/~tzitzik/>,
                                                                                          "Michalis Mountantonakis",
                                                                                          <http://users.ics.forth.gr/~marketak/pages/aboutme.html>,
                                                                                          "Christina Lantzaki",
                                                                                          "Nikos Minadakis";
                                                                      dcterms:creator <http://users.ics.forth.gr/~marketak/pages/aboutme.html>,
                                                                                      <http://users.ics.forth.gr/~fafalios/>,
                                                                                      "Christina Lantzaki",
                                                                                      <http://users.ics.forth.gr/~tzitzik/>,
                                                                                      "Nikos Minadakis",
                                                                                      "Carlo Allocca",
                                                                                      <http://users.ics.forth.gr/~mountant/>;
                                                                      dcterms:description "An extension of W3C VoID that is able to represent these metrics for expressing the Connectivity Metrics of a Semantic Warehouse.";
                                                                      dcterms:issued "2014-05-21"^^xsd:date;
                                                                      dcterms:license <http://creativecommons.org/licenses/by/3.0/>;
                                                                      dcterms:publisher <http://www.ics.forth.gr/isl>;
                                                                      dcterms:rights "Copyright © FORTH ICS";
                                                                      dcterms:title "Void Warehouse Ontology";
                                                                      a owl:Ontology;
                                                                      owl:versionInfo 1.0.
voidwh:Configuration a owl:Class;
                     rdfs:comment "Based on the fact that a measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal). The Configuration defines the polices with respect to a measurement is carried out. It defines polices about how to compare URIs and the configuration of an entity.";
                     rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                     rdfs:label "Configuration";
                     status:term_status "Stable".
voidwh:EntityConfiguration a owl:Class;
                           rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them.";
                           rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                           rdfs:label "Entity Configuration";
                           rdfs:subClassOf voidwh:Configuration;
                           status:term_status "Stable".
voidwh:Measurement a owl:Class;
                   rdfs:comment "The notion of Measurement is actually a specialization of dc:Event and therefore inherits the property date. A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal).";
                   rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                   rdfs:label "Measurement";
                   rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty voidwh:producesValue ; 
                                    a owl:Restriction],
                                   [owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass void:Dataset ; 
                                    owl:onProperty voidwh:over ; 
                                    a owl:Restriction],
                                   dcmitype:Event;
                   adms:status "Stable".
voidwh:Metrics a owl:Class;
               rdfs:comment "A metric is an individual with a URI and is defined by a resource (e.g. the DOI of the scientific paper that defined that metric).";
               rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
               rdfs:label "Metrics";
               status:term_status "stable".
voidwh:URIEquivalence a owl:Class;
                      rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them.";
                      rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                      rdfs:label "URI Equivalence";
                      rdfs:subClassOf voidwh:Configuration;
                      status:term_status "Stable".
voidwh:accordingTo a owl:ObjectProperty;
                   rdfs:comment "A measurement is carried out by an agent using a specific metric accordingTo one (or more) configurations over one (or more) datasets. Therefore, this property links an instance of measurement class with an instance of configuation class.";
                   rdfs:domain voidwh:Measurement;
                   rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                   rdfs:label "according To";
                   rdfs:range voidwh:Configuration;
                   status:term_status "Stable".
voidwh:averageDegreeIncrement a voidwh:Metrics,
                                owl:NamedIndividual.
voidwh:carriedOutBy a owl:ObjectProperty;
                    rdfs:comment """A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal).
Therefore, this property links an instance of measurement class with an instance of the Agent class.""";
                    rdfs:domain voidwh:Measurement;
                    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                    rdfs:range dcterms:Agent;
                    status:term_status "Stable".
voidwh:commonLiterals a voidwh:Metrics,
                        owl:NamedIndividual.
voidwh:commonLiteralsPercentage a voidwh:Metrics,
                                  owl:NamedIndividual.
voidwh:commonUris a voidwh:Metrics,
                    owl:NamedIndividual.
voidwh:commonUrisPercentage a voidwh:Metrics,
                              owl:NamedIndividual.
voidwh:complementarityFactor a voidwh:Metrics,
                               owl:NamedIndividual.
voidwh:entityMatching a voidwh:URIEquivalence,
                        owl:NamedIndividual.
voidwh:exactStringEquality a voidwh:URIEquivalence,
                             owl:NamedIndividual.
voidwh:over a owl:ObjectProperty;
            rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal). Therefore, this property links instances of Measurement class with instances of dataset class.";
            rdfs:domain voidwh:Measurement;
            rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
            rdfs:label "over";
            rdfs:range void:Dataset;
            status:term_status "Stable".
voidwh:producesValue a owl:DatatypeProperty;
                     rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets. Therefore, this property indicates the value produced by the measurement.";
                     rdfs:domain voidwh:Measurement;
                     rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                     rdfs:label "produces Value";
                     rdfs:range rdfs:Literal;
                     status:term_status "Stable".
voidwh:suffixCanonicalization a voidwh:URIEquivalence,
                                owl:NamedIndividual.
voidwh:uniqueTriples a voidwh:Metrics,
                       owl:NamedIndividual.
voidwh:uniqueTriplesPercentage a voidwh:Metrics,
                                 owl:NamedIndividual.
voidwh:usesMetrics a owl:ObjectProperty;
                   rdfs:comment "A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets. Therefore, this property links an instance of measurement class with an instance of metrics class.";
                   rdfs:domain voidwh:Measurement;
                   rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                   rdfs:label "uses Metrics";
                   rdfs:range voidwh:Metrics;
                   status:term_status "Stable".
voidwh:usesSPARQLquery a owl:DatatypeProperty;
                       rdfs:comment "This property specifies the entities of interest involved in a configuration by providing a SPARQL query that returns them.";
                       rdfs:domain voidwh:EntityConfiguration;
                       rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                       rdfs:label "uses SPARQL query";
                       rdfs:range rdfs:Literal;
                       status:term_status "Stable".
rdf:resource a owl:Class.
rdfs:isDefinedBy a owl:ObjectProperty;
                 rdfs:domain voidwh:Measurement,
                             voidwh:Configuration;
                 rdfs:range rdf:resource.
status:term_status a owl:AnnotationProperty.
adms:status a owl:AnnotationProperty.
foaf:Person a owl:Class.
