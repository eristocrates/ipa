                                           <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                           <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment """A collection is an aggregation of items. The term 
		collection means that the resource is described as a 
		group; its parts may be separately described and navigated."""@en-us;
                                         rdfs:isDefinedBy <http://purl.org/dc/dcmitype/>;
                                         rdfs:label "Collection"@en-us.
<http://purl.org/dc/dcmitype/Dataset> <http://purl.org/dc/elements/1.1/type> <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                                      <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#Dataset-001>;
                                      <http://purl.org/dc/terms/issued> "2000-07-11";
                                      a <http://purl.org/dc/terms/DCMIType>,
