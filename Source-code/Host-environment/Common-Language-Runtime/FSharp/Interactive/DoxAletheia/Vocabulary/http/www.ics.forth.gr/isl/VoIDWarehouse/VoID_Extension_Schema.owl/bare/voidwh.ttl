<http://purl.org/dc/dcmitype/Collection> <http://purl.org/dc/elements/1.1/type> <http://dublincore.org/usage/documents/principles/#vocabulary-term>;
                                         <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#Collection-001>;
                                         <http://purl.org/dc/terms/issued> "2000-07-11";
