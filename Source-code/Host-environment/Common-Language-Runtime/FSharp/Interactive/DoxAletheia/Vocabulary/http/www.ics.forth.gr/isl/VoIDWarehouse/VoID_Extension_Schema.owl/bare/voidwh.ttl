        <http://purl.org/dc/terms/description> "An extension of W3C VoID that is able to represent these metrics for expressing the Connectivity Metrics of a Semantic Warehouse.";
        <http://purl.org/dc/terms/issued> "2014-05-21"^^xsd:date;
        <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
        <http://purl.org/dc/terms/publisher> <http://www.ics.forth.gr/isl>;
        <http://purl.org/dc/terms/rights> "Copyright © FORTH ICS";
        <http://purl.org/dc/terms/title> "Void Warehouse Ontology";
        a <http://www.w3.org/2002/07/owl#Ontology>;
        <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                    rdfs:comment "Based on the fact that a measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal). The Configuration defines the polices with respect to a measurement is carried out. It defines polices about how to compare URIs and the configuration of an entity.";
                                                                                    rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                    rdfs:label "Configuration";
                                                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#EntityConfiguration> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                          rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them.";
                                                                                          rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                          rdfs:label "Entity Configuration";
                                                                                          rdfs:subClassOf <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration>;
                                                                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                  rdfs:comment "The notion of Measurement is actually a specialization of dc:Event and therefore inherits the property date. A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal).";
                                                                                  rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                  rdfs:label "Measurement";
                                                                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#producesValue> ; 
                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                                  [<http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                   <http://www.w3.org/2002/07/owl#onClass> <http://rdfs.org/ns/void#Dataset> ; 
                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#over> ; 
                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                                  <http://purl.org/dc/dcmitype/Event>;
                                                                                  <http://www.w3.org/ns/adms#status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics> a <http://www.w3.org/2002/07/owl#Class>;
                                                                              rdfs:comment "A metric is an individual with a URI and is defined by a resource (e.g. the DOI of the scientific paper that defined that metric).";
                                                                              rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                              rdfs:label "Metrics";
                                                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#URIEquivalence> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                     rdfs:comment "The notion of Configuration concerns issues that explain how the measurement was done. At this point, and for the requirements at hand, we need two subclasses: the first concerns the way URI equivalence is defined (see URIEquivalence class), while the second (the EntityConfiguration class) concerns how the entities of interest are defined. Regarding the latter the current modeling allows someone to specify the desired set of entities by providing a SPARQL query that returns them.";
                                                                                     rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                     rdfs:label "URI Equivalence";
                                                                                     rdfs:subClassOf <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration>;
                                                                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#accordingTo> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                  rdfs:comment "A measurement is carried out by an agent using a specific metric accordingTo one (or more) configurations over one (or more) datasets. Therefore, this property links an instance of measurement class with an instance of configuation class.";
                                                                                  rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement>;
                                                                                  rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                  rdfs:label "according To";
                                                                                  rdfs:range <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Configuration>;
                                                                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#averageDegreeIncrement> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
                                                                                               <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#carriedOutBy> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                   rdfs:comment """A measurement is carried out by an agent using a specific metric according to one (or more) configurations over one (or more) datasets (atomic or composite) and produces a value (i.e. literal).
Therefore, this property links an instance of measurement class with an instance of the Agent class.""";
                                                                                   rdfs:domain <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Measurement>;
                                                                                   rdfs:isDefinedBy "http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl";
                                                                                   rdfs:range <http://purl.org/dc/terms/Agent>;
                                                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Stable".
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonLiterals> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
                                                                                       <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#commonLiteralsPercentage> a <http://www.ics.forth.gr/isl/VoIDWarehouse/VoID_Extension_Schema.owl#Metrics>,
                                                                                                 <http://www.w3.org/2002/07/owl#NamedIndividual>.
