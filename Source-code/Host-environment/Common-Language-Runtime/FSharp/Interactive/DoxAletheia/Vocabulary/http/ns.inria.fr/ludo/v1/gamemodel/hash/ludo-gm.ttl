                                                                             ludo-gm:Presentation-basedStructure
                                                                             ludo-gm:Scenario-basedStructure
                                                                             ludo-gm:Training-basedStructure).
_:B34208e5bef5f06fbcbbda4afa6631057 a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (ludo-gm:DecidingCondition
                                                                             ludo-gm:Learn
                                                                             ludo-gm:Navigate).
_:B3addbd92ce4b56033e07518ecf134c6f a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (ludo-gm:GameDimension
                                                                             ludo-gm:GamePhysics
                                                                             ludo-gm:GameTempo).
_:B7a56fef6aa20cf326ed00d3f42268e5e a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (ludo-gm:Graphic
                                                                             ludo-gm:Sound
                                                                             ludo-gm:Video
                                                                             ludo-gm:hasText).
_:B88e233d6502e0020f3b9ba27a28dd4a9 a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (ludo-gm:Action
                                                                             ludo-gm:Appearance
                                                                             ludo-gm:Intelligence).
_:B8e4f65f5cc2af5e55c5efd13b6ee9dcd a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (ludo-gm:GameEvent
                                                                             ludo-gm:GameObject
                                                                             ludo-gm:GameObjective
                                                                             ludo-gm:GamePlayer
