            rdfs:label "has identifier for the work"@en;
            rdfs:subPropertyOf rdau:P60052;
            owl:sameAs rdaw:identifierForTheWork;
            skos:definition "Relates a work to a character string uniquely associated with a work, or with a surrogate for a work (e.g., an authority record)."@en;
            skos:scopeNote "The identifier serves to differentiate that work from other works."@en.
rdaw:P10003 <http://metadataregistry.org/uri/profile/RegAp/hasUnconstrained> rdau:P60054;
