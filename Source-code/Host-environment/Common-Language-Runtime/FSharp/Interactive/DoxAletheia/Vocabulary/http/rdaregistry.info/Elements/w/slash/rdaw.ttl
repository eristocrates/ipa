            <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
            <http://metadataregistry.org/uri/profile/rdakit/instructionNumber> "6.8";
            <http://metadataregistry.org/uri/profile/rdakit/toolkitDefinition> "A character string uniquely associated with a work, or with a surrogate for a work (e.g., an authority record)."@en;
            <http://metadataregistry.org/uri/profile/rdakit/toolkitLabel> "identifier for the work"@en;
            a rdf:Property;
            rdfs:domain rdac:C10001;
