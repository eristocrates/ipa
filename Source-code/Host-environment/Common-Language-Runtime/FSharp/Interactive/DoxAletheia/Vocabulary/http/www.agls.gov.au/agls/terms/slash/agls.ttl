agls:jurisdiction dcterms:description "Jurisdiction is a description of the territory over which a particular government exercises its authority or a particular business transacts its operations, to which the resource content is applicable."@en-au;
                  dcterms:issued "2002-04-18";
                  dcterms:modified "2007-12-19";
                  dcterms:type rdf:Property;
                  a rdf:Property;
                  rdfs:comment "The name of the political/administrative entity covered by the resource."@en-au;
                  rdfs:domain dcterms:Jurisdiction;
                  rdfs:isDefinedBy agls:;
                  rdfs:label "Jurisdiction"@en-au;
                  rdfs:subPropertyOf dcterms:coverage,
