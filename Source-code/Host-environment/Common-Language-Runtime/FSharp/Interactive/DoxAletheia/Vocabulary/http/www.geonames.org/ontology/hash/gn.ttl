swperson:bernard-vatant a foaf:Person;
                        foaf:name "Bernard Vatant";
                        foaf:page <http://blog.hubjects.com/>;
                        foaf:workplaceHomepage <http://www.mondeca.com/>.
resource:GeoNames marcrole:dtm geonames:Marc-Wick;
                  a foaf:Organization;
                  foaf:homepage <http://www.geonames.org/>;
                  foaf:name "GeoNames".
<http://www.geonames.org/ontology> ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
                                   dcterms:contributor "Roman Rachkov (bulgarian translation)",
                                                       "Valery Hronusov (russian translation)",
                                                       "Erik Bolstad (norwegian and swedish translations)";
                                   dcterms:creator swperson:bernard-vatant;
                                   dcterms:description "The Geonames ontologies provides elements of description for geographical features, in particular those defined in the geonames.org data base"@en;
                                   dcterms:issued "2006-10-14";
                                   dcterms:modified "2012-10-29";
                                   dcterms:publisher resource:GeoNames;
                                   dcterms:title "The Geonames ontology"@en;
                                   vann:preferredNamespacePrefix "gn";
                                   vann:preferredNamespaceUri "http://www.geonames.org/ontology#";
                                   a owl:Ontology;
                                   rdfs:comment """Modifications from version 3.01 :
            Added : gn:GeonamesFeature, subclass of gn:Feature.
            Added : explicit property gn:geonamesID, mandatory and unique for each gn:GeonamesFeature instance.
            Deleted : owl:FunctionalProperty declarations for properties attached to gn:Feature, replaced by local cardinality restrictions on gn:GeonamesFeature
            The gn:Feature class and attached properties can therefore be used in the open world for features not necessarily identified in the Geonames data base, or with partial descriptions.
            Modified : Equivalent classes and superclasses of geonames:Feature in other vocabularies.
            Added : new feature codes for historical features.
            Improved metadata."""@en;
                                   rdfs:isDefinedBy <http://www.geonames.org/ontology/ontology_v3.1.rdf>;
                                   owl:priorVersion <http://www.geonames.org/ontology/ontology_v3.0.1.rdf>;
                                   owl:versionInfo "Version 3.1 - 2012-10-29"@en;
                                   adms:relatedDocumentation <http://www.geonames.org/ontology/documentation.html>;
                                   foaf:homepage <http://www.geonames.org/ontology/documentation.html>.
geonames:A a geonames:Class;
           rdfs:comment "country, state, region ..."@en.
geonames:A.ADM1 a geonames:Code;
                skos:definition "первоначальное политико-административное  деление, например, деление США на штаты"@ru,
                                "a primary administrative division of a country, such as a state in the United States"@en;
                skos:inScheme geonames:A;
                skos:notation "A.ADM1";
                skos:prefLabel "политико-административное деление первого порядка"@ru,
                               "primær administrativ inndeling"@no,
                               "first-order administrative division"@en,
                               "första ordningens administrativ avdelning"@sv,
                               "първостепенна административна единица"@bg.
geonames:A.ADM1H a geonames:Code;
                 skos:historyNote "Added in v3.1"@en;
                 skos:inScheme geonames:A;
                 skos:notation "A.ADM1H";
                 skos:prefLabel "historical first-order administrative division"@en.
geonames:A.ADM2 a geonames:Code;
                skos:definition "дальнейшее деление политико-административного деления первого порядка"@ru,
                                "a subdivision of a first-order administrative division"@en;
                skos:inScheme geonames:A;
                skos:notation "A.ADM2";
                skos:prefLabel "второстепенна административна единица"@bg,
                               "second-order administrative division"@en,
                               "политико-административное деление второго порядка"@ru,
                               "sekundær administrativ inndeling"@no,
                               "andra ordningens administrativ avdelning"@sv.
geonames:A.ADM2H a geonames:Code;
                 skos:historyNote "Added in v3.1"@en;
                 skos:inScheme geonames:A;
                 skos:notation "A.ADM2H";
                 skos:prefLabel "historical second-order administrative division"@en.
geonames:A.ADM3 a geonames:Code;
                skos:definition "a subdivision of a second-order administrative division"@en,
                                "дальнейшее деление политико-административного деления второго порядка"@ru;
                skos:inScheme geonames:A;
                skos:notation "A.ADM3";
                skos:prefLabel "administrativ inndeling av tredje grad"@no,
                               "third-order administrative division"@en,
                               "tredje ordningens administrativ avdelning"@sv,
                               "третостепенна административна единица"@bg,
                               "политико-административное деление третьего порядка"@ru.
geonames:A.ADM3H a geonames:Code;
                 skos:historyNote "Added in v3.1"@en;
                 skos:inScheme geonames:A;
                 skos:notation "A.ADM3H";
                 skos:prefLabel "historical third-order administrative division"@en.
geonames:A.ADM4 a geonames:Code;
                skos:definition "a subdivision of a third-order administrative division"@en,
                                "дальнейшее деление политико-административного деления третьего порядка"@ru;
                skos:inScheme geonames:A;
                skos:notation "A.ADM4";
                skos:prefLabel "fourth-order administrative division"@en,
                               "политико-административное деление четвертого порядка"@ru,
                               "administrativ inndeling av fjerde grad"@no,
                               "fjärde ordningens administrativ avdelning"@sv,
                               "четвъртостепенна административна единица"@bg.
geonames:A.ADM4H a geonames:Code;
                 skos:historyNote "Added in v3.1"@en;
                 skos:inScheme geonames:A;
                 skos:notation "A.ADM4H";
                 skos:prefLabel "historical fourth-order administrative division"@en.
geonames:A.ADM5 a geonames:Code;
                skos:definition "a subdivision of a fourth-order administrative division"@en;
                skos:notation "A.ADM5";
                skos:prefLabel "fifth-order administrative division"@en.
geonames:A.ADMD a geonames:Code;
                skos:definition "an administrative division of a country, undifferentiated as to administrative level"@en,
                                "деление страны на административные единицы"@ru;
                skos:inScheme geonames:A;
                skos:notation "A.ADMD";
                skos:prefLabel "политико-административное  деление"@ru,
                               "административно делене"@bg,
                               "administrative division"@en,
                               "administrativ inndeling"@no,
                               "administrativ avdelning"@sv.
geonames:A.ADMH a geonames:Code;
                skos:historyNote "Added in v3.1"@en;
                skos:inScheme geonames:A;
                skos:notation "A.ADMH";
                skos:prefLabel "historical administrative division"@en.
geonames:A.LTER a geonames:Code;
                skos:definition "a tract of land leased to another country, usually for military installations"@en,
                                "арендованный правительством Великобритании у властей Китая участок земли, часть Гонконга"@ru;
                skos:inScheme geonames:A;
                skos:notation "A.LTER";
                skos:prefLabel "арендованный район/территория"@ru,
                               "leid landområde"@no,
                               "uthyrt område"@sv,
                               "територия под аренда"@bg,
                               "leased area"@en.
geonames:A.PCL a geonames:Code;
               skos:inScheme geonames:A;
               skos:notation "A.PCL";
               skos:prefLabel "политическое образование"@ru,
                              "политическо тяло"@bg,
                              "politisk enhet"@sv,
                              "politisk enhet"@no,
                              "political entity"@en.
geonames:A.PCLD a geonames:Code;
                skos:inScheme geonames:A;
                skos:notation "A.PCLD";
                skos:prefLabel "зависимое политическое образование"@ru,
                               "зависимо политическо тяло"@bg,
                               "dependent political entity"@en,
                               "beroende politisk enhet"@sv,
                               "avhengig politisk enhet"@no.
geonames:A.PCLF a geonames:Code;
                skos:inScheme geonames:A;
                skos:notation "A.PCLF";
                skos:prefLabel "свободно присоединившееся государство (свободное ассоциированное государство)"@ru,
                               "свободно асоциирана държава"@bg,
                               "fritt tilknyttet stat"@no,
                               "fritt associerad stat"@sv,
                               "freely associated state"@en.
geonames:A.PCLH a geonames:Code;
                skos:historyNote "Added in v3.1"@en;
                skos:inScheme geonames:A;
                skos:notation "A.PCLH";
                skos:prefLabel "historical political entity"@en.
geonames:A.PCLI a geonames:Code;
                skos:inScheme geonames:A;
                skos:notation "A.PCLI";
                skos:prefLabel "независимое политическое образование"@ru,
                               "независимо политическо образувание"@bg,
                               "uavhengig politisk enhet"@no,
                               "oberoende politisk enhet"@sv,
                               "independent political entity"@en.
geonames:A.PCLIX a geonames:Code;
                 skos:inScheme geonames:A;
                 skos:notation "A.PCLIX";
                 skos:prefLabel "част от независимо политическо образувание"@bg,
                                "участок независимого политического образования"@ru,
                                "section of independent political entity"@en,
                                "del av uavhengig politisk enhet"@no,
                                "del av oberoende politisk enhet"@sv.
geonames:A.PCLS a geonames:Code;
                skos:inScheme geonames:A;
                skos:notation "A.PCLS";
                skos:prefLabel "полу-независимо политическо образувание"@bg,
                               "наполовину зависимое политическое образование"@ru,
                               "semi-independent political entity"@en,
                               "delvis uavhengig politisk enhet"@no,
                               "delvis oberoende politisk enhet"@sv.
geonames:A.PPCLH a geonames:Code;
                 skos:historyNote "Added in v3.1"@en;
                 skos:inScheme geonames:P;
                 skos:notation "A.PPCLH";
                 skos:prefLabel "historical capital of a political entity"@en.
geonames:A.PPLH a geonames:Code;
                skos:historyNote "Added in v3.1"@en;
                skos:inScheme geonames:P;
                skos:notation "A.PPLH";
                skos:prefLabel "historical populated place"@en.
geonames:A.PRSH a geonames:Code;
                skos:definition "низший церковный округ в христианской церкви, центром которого является храм"@ru,
                                "an ecclesiastical district"@en;
                skos:inScheme geonames:A;
                skos:notation "A.PRSH";
                skos:prefLabel "parish"@en,
                               "церковный приход"@ru,
                               "sogn"@no,
                               "kommun"@sv,
                               "енория"@bg.
geonames:A.TERR a geonames:Code;
                skos:inScheme geonames:A;
                skos:notation "A.TERR";
                skos:prefLabel "территория (административная единица в США, Канаде и Австралии, не имеющая прав штата или провинции)"@ru,
                               "територия"@bg,
                               "territory"@en,
                               "territorium"@sv,
                               "territorium"@no.
geonames:A.ZN a geonames:Code;
              skos:inScheme geonames:A;
              skos:notation "A.ZN";
              skos:prefLabel "зона"@ru,
                             "зона"@bg,
                             "zone"@en,
                             "zon"@sv,
                             "sone"@no.
geonames:A.ZNB a geonames:Code;
               skos:definition "a zone recognized as a buffer between two nations in which military presence is minimal or absent"@en,
                               "область, официально признанная в качестве буфера между двумя нациями; военное присутствие минимально или вовсе отсутствует"@ru;
               skos:inScheme geonames:A;
               skos:notation "A.ZNB";
               skos:prefLabel "буферна зона"@bg,
                              "buffersone"@no,
                              "bufferzon"@sv,
                              "buffer zone"@en,
                              "буферная зона"@ru.
geonames:Class a owl:Class;
               rdfs:comment "A class of features."@en;
               rdfs:label "Class"@en;
               rdfs:subClassOf skos:ConceptScheme.
geonames:Code a owl:Class;
              rdfs:comment "A feature code."@en;
              rdfs:label "Code"@en;
              rdfs:subClassOf skos:Concept.
geonames:Feature a owl:Class;
                 rdfs:comment "A geographical feature"@en;
                 rdfs:label "Feature"@en;
                 rdfs:subClassOf wgspos:SpatialThing,
                                 schema:Place;
                 owl:equivalentClass spatial:Feature,
                                     geof:GeographicFeature;
                 skos:historyNote "Modified in version 3.1 : The cardinality constraints on feature code, feature class are relaxed on this class, and put on the specific subclass Geonames Feature. This class and attached properties can therefore be used for features not necessarily identified in the Geoanmes data base"@en.
geonames:GeonamesFeature a owl:Class;
                         rdfs:comment "A feature described in geonames database, uniquely defined by its geonames identifier"@en;
                         rdfs:label "Geonames Feature"@en;
                         rdfs:subClassOf [owl:onProperty wgspos:long ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:population ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:geonamesID ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:name ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:geonamesID ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:featureClass ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM1 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM3 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:countryCode ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:population ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:name ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty wgspos:lat ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:featureCode ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:countryCode ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         geonames:Feature,
                                         [owl:onProperty geonames:featureClass ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM2 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM4 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM4 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty wgspos:lat ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:featureCode ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM2 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM1 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty geonames:parentADM3 ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty wgspos:long ; 
                                          owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction];
                         skos:historyNote "Added in version 3.1"@en.
geonames:H a geonames:Class;
           rdfs:comment "stream, lake, ..."@en.
geonames:H.AIRS a geonames:Code;
                skos:definition "a place on a waterbody where floatplanes land and take off"@en,
                                "место на воде для взлета и посадки гидросамолета"@ru;
                skos:inScheme geonames:H;
                skos:notation "H.AIRS";
                skos:prefLabel "seaplane landing area"@en,
                               "landingsområde for sjøfly"@no,
                               "летище за хидроплани"@bg,
                               "посадочная полоса для гидросамолета"@ru,
                               "landningsplats för sjöflygplan"@sv.
geonames:H.ANCH a geonames:Code;
                skos:definition "an area where vessels may anchor"@en,
                                "место, где судна бросают якорь"@ru;
                skos:inScheme geonames:H;
                skos:notation "H.ANCH";
                skos:prefLabel "anchorage"@en,
                               "ankarplats"@sv,
                               "якорная стоянка"@ru,
                               "ankerplass"@no,
                               "пристанище"@bg.
geonames:H.BAY a geonames:Code;
               skos:definition "a coastal indentation between two capes or headlands, larger than a cove but smaller than a gulf"@en,
                               "изгиб берега  между двумя мысами, больше чем открытая гавань, но меньше чем залив"@ru;
               skos:inScheme geonames:H;
               skos:notation "H.BAY";
               skos:prefLabel "bukt"@no,
                              "vik, bukt"@sv,
                              "залив"@bg,
                              "бухта"@ru,
                              "bay"@en.
geonames:H.BAYS a geonames:Code;
                skos:definition "coastal indentations between two capes or headlands, larger than a cove but smaller than a gulf"@en,
                                "изгибы берега  между двумя мысами, больше чем открытая гавань, но меньше чем залив"@ru;
                skos:inScheme geonames:H;
                skos:notation "H.BAYS";
                skos:prefLabel "бухты"@ru,
                               "заливи"@bg,
                               "bays"@en,
                               "bukter"@no,
                               "vikar, bukter"@sv.
geonames:H.BGHT a geonames:Code;
                skos:definition "открытый участок воды; там, где происходит отступание береговой черты"@ru,
                                "an open body of water forming a slight recession in a coastline"@en;
                skos:inScheme geonames:H;
                skos:notation "H.BGHT";
                skos:prefLabel "bight(s)"@en,
                               "vik"@no,
                               "bukt(er)"@sv,
                               "ивица(и)"@bg,
                               "излучина (реки)"@ru.
geonames:H.BNK a geonames:Code;
               skos:definition "an elevation, typically located on a shelf, over which the depth of water is relatively shallow but sufficient for most surface navigation"@en,
                               "возвышенность, которая обычно располагается на мелководье; однако количества воды достаточно для надводного судоходства"@ru;
               skos:inScheme geonames:H;
               skos:notation "H.BNK";
               skos:prefLabel "нанос"@ru,
                              "бряг(ове)"@bg,
                              "strandssluttning, strandvall"@sv,
                              "bank(s)"@en,
                              "banker"@no.
geonames:H.BNKR a geonames:Code;
                skos:definition "косой берег реки, который удерживает поток воды в своих границах"@ru,
                                "a sloping margin of a stream channel which normally confines the stream to its channel on land"@en;
                skos:inScheme geonames:H;
                skos:notation "H.BNKR";
                skos:prefLabel "речной берег"@ru,
                               "бряг изложен на течение"@bg,
                               "stream bank"@en,
                               "flodstrand"@sv,
                               "elvebredd"@no.
geonames:H.BNKX a geonames:Code;
                skos:inScheme geonames:H;
                skos:notation "H.BNKX";
                skos:prefLabel "част от бряг"@bg,
                               "участок берега"@ru,
                               "section of bank"@en,
                               "del av flodstrand"@sv,
                               "del av bredd"@no.
geonames:H.BOG a geonames:Code;
               skos:definition "заболоченная территория, которая является благоприятной почвой для торфяного мха, осоки и других болотных растений"@ru,
                               "a wetland characterized by peat forming sphagnum moss, sedge, and other acid-water plants"@en;
               skos:inScheme geonames:H;
               skos:notation "H.BOG";
               skos:prefLabel "болото"@ru,
                              "bog(s)"@en,
                              "myr"@no,
                              "блато(а)"@bg,
                              "kärr, träsk"@sv.
geonames:H.CAPG a geonames:Code;
                skos:definition "a dome-shaped mass of glacial ice covering an area of  mountain summits or other high lands; smaller than an ice sheet"@en,
                                "куполообразная масса ледникового льда, покрывающая гонные вершины; по размеру меньше ледникового щита"@ru;
