                               "sandgrunner"@no,
                               "sandbankar"@sv.
geonames:U.SHVU a geonames:Code;
                skos:definition "a valley on the shelf, generally the shoreward extension of a canyon"@en,
                                "относительно мелководная подводная равнина, прилегающая к берегам материков и генетически составляющая часть материковой платформы"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.SHVU";
                skos:prefLabel "материковая отмель"@ru,
                               "dal gjennom kontinentalhyllen"@no,
                               "Шелфова долина"@bg,
                               "shelf valley"@sv,
                               "shelf valley"@en.
geonames:U.SILU a geonames:Code;
                skos:definition "the low part of a gap or saddle separating basins"@en,
                                "каменистое поперечное возвышение дна реки, нарушающее плавность её течения и затрудняющее судоходство"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.SILU";
                skos:prefLabel "порог"@ru,
                               "Интрузия"@bg,
                               "tröskel"@sv,
                               "sill"@en,
                               "terskel"@no.
geonames:U.SLPU a geonames:Code;
                skos:definition "the slope seaward from the shelf edge to the beginning of a continental rise or the point where there is a general reduction in slope"@en,
                                "покатая поверхность горы, холма и т.п.; склон"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.SLPU";
                skos:prefLabel "slope"@en,
                               "skråning"@no,
                               "откос"@ru,
                               "скат"@bg,
                               "sluttning"@sv.
geonames:U.SMSU a geonames:Code;
                skos:definition "изолированные поднятия морского дна с относительной высотой более 500 м и четко выраженной конической или куполообразной одной или несколькими вершинами и крутыми склонами"@ru,
                                "elevations rising generally more than 1,000 meters and of limited extent across the summit"@en;
                skos:inScheme geonames:U;
                skos:notation "U.SMSU";
                skos:prefLabel "подводные горы"@ru,
                               "undersjøiske fjell"@no,
                               "undervattensberg"@sv,
                               "Морски връх"@bg,
                               "seamounts"@en.
geonames:U.SMU a geonames:Code;
               skos:definition "an elevation rising generally more than 1,000 meters and of limited extent across the summit"@en,
                               "изолированное поднятие морского дна с относительной высотой более 500 м и четко выраженной конической или куполообразной одной или несколькими вершинами и крутыми склонами"@ru;
               skos:inScheme geonames:U;
               skos:notation "U.SMU";
               skos:prefLabel "undersjøisk fjell"@no,
                              "Морски върхове"@bg,
                              "seamount"@en,
                              "подводная гора"@ru,
                              "undervattensberg"@sv.
geonames:U.SPRU a geonames:Code;
                skos:definition "ряд гор, тянущихся в одном направлении, горная цепь"@ru,
                                "a subordinate elevation, ridge, or rise projecting outward from a larger feature"@en;
                skos:inScheme geonames:U;
                skos:notation "U.SPRU";
                skos:prefLabel "хребет"@bg,
                               "хребет"@ru,
                               "spur"@en,
                               "utlöpare"@sv,
                               "utspring"@no.
geonames:U.TERU a geonames:Code;
                skos:definition "горизонтальная или слегка наклонная площадка, образующая уступ на склоне местности, естественного происхождения или устроенная искусственно"@ru,
                                "a relatively flat horizontal or gently inclined surface, sometimes long and narrow, which is bounded by a steeper ascending slope on one side and by a steep descending slope on the opposite side"@en;
                skos:inScheme geonames:U;
                skos:notation "U.TERU";
                skos:prefLabel "тераса"@bg,
                               "terass"@sv,
                               "terrasse"@no,
                               "терраса"@ru,
                               "terrace"@en.
geonames:U.TMSU a geonames:Code;
                skos:definition "seamounts having a comparatively smooth, flat top"@en,
                                "плосковершинные подводные вулканические горы, встречающиеся одиночно или группами"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.TMSU";
                skos:prefLabel "гайоты"@ru,
                               "Плоски възвишения"@bg,
                               "undervattensberg"@sv,
                               "guyoter"@no,
                               "tablemounts (or guyots)"@en.
geonames:U.TMTU a geonames:Code;
                skos:definition "подводный плосковершинный вулкан"@ru,
                                "a seamount having a comparatively smooth, flat top"@en;
                skos:inScheme geonames:U;
                skos:notation "U.TMTU";
                skos:prefLabel "tablemount (or guyot)"@en,
                               "undervattensberg"@sv,
                               "гайот"@ru,
                               "guyot"@no,
                               "Плоско възвишение"@bg.
geonames:U.TNGU a geonames:Code;
                skos:definition "длинная узкая отмель, идущая от берега, или низменный узкий мыс"@ru,
                                "an elongate (tongue-like) extension of a flat sea floor into an adjacent higher feature"@en;
                skos:inScheme geonames:U;
                skos:notation "U.TNGU";
                skos:prefLabel "landtunge"@no,
                               "tongue"@en,
                               "коса"@ru,
                               "landtunga"@sv,
                               "нос"@bg.
geonames:U.TRGU a geonames:Code;
                skos:definition "a long depression of the sea floor characteristically flat bottomed and steep sided, and normally shallower than a trench"@en,
                                "углубление с пологими склонами  на дне океанов и морей"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.TRGU";
                skos:prefLabel "gjennomgang"@no,
                               "ränna"@sv,
                               "trough"@en,
                               "впадина на дне океана с пологими склонами"@ru,
                               "падина"@bg.
geonames:U.TRNU a geonames:Code;
                skos:definition "a long, narrow, characteristically very deep and asymmetrical depression of the sea floor, with relatively steep sides"@en,
                                "углубление с крутыми склонами на дне океанов и морей"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.TRNU";
                skos:prefLabel "renne"@no,
                               "просека"@bg,
                               "впадина на дне океана с крутыми склонами"@ru,
                               "trench"@en,
                               "dike"@sv.
geonames:U.VALU a geonames:Code;
                skos:definition "a relatively shallow, wide depression, the bottom of which usually has a continuous gradient"@en,
                                "овраг с пологими склонами"@ru;
                skos:inScheme geonames:U;
                skos:notation "U.VALU";
                skos:prefLabel "dal"@sv,
                               "dal"@no,
                               "valley"@en,
                               "лощина"@ru,
                               "долина"@bg.
geonames:U.VLSU a geonames:Code;
                skos:definition "овраги с пологими склонами"@ru,
                                "a relatively shallow, wide depression, the bottom of which usually has a continuous gradient"@en;
                skos:inScheme geonames:U;
                skos:notation "U.VLSU";
                skos:prefLabel "долини"@bg,
                               "dalar"@sv,
                               "valleys"@en,
                               "лощины"@ru,
                               "daler"@no.
geonames:V a geonames:Class;
           rdfs:comment "forest, heath, ..."@en.
geonames:V.BUSH a geonames:Code;
                skos:definition "a small clump of conspicuous bushes in an otherwise bare area"@en,
                                "заросли куста"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.BUSH";
                skos:prefLabel "busk"@no,
                               "кустарник"@ru,
                               "храст(и)"@bg,
                               "bush(es)"@en,
                               "djungel"@sv.
geonames:V.CULT a geonames:Code;
                skos:definition "an area under cultivation"@en,
                                "площадь, предназначенная для возделывания многих с.-х. культур"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.CULT";
                skos:prefLabel "cultivated area"@en,
                               "посевная площадь"@ru,
                               "uppodlat område"@sv,
                               "обработваеми площи"@bg,
                               "dyrket mark"@no.
geonames:V.FRST a geonames:Code;
                skos:definition "an area dominated by tree vegetation"@en,
                                "множество дикорастущих деревьев, расположенных на большом пространстве; пространство, обильно поросшее деревьями"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.FRST";
                skos:prefLabel "skog"@no,
                               "skog(ar)"@sv,
                               "лес"@ru,
                               "forest(s)"@en,
                               "гори"@bg.
geonames:V.FRSTF a geonames:Code;
                 skos:definition "a forest fossilized by geologic processes and now exposed at the earth's surface"@en,
                                 "значительное скопление древесных окаменелостей на небольшом участке"@ru;
                 skos:inScheme geonames:V;
                 skos:notation "V.FRSTF";
                 skos:prefLabel "fossilized forest"@en,
                                "fossil skog"@sv,
                                "forsteinet skog"@no,
                                "горски вкаменелости"@bg,
                                "окаменелый лес"@ru.
geonames:V.GRSLD a geonames:Code;
                 skos:definition "пространство земли, покрытое травянистой растительностью; сенокосное, пастбищное угодье"@ru,
                                 "an area dominated by grass vegetation"@en;
                 skos:inScheme geonames:V;
                 skos:notation "V.GRSLD";
                 skos:prefLabel "ливади"@bg,
                                "grassland"@en,
                                "луг"@ru,
                                "gresslette"@no,
                                "grässlätt"@sv.
geonames:V.GRVC a geonames:Code;
                skos:definition "большой участок земли, занятый кокосовыми деревьями"@ru,
                                "a planting of coconut trees"@en;
                skos:inScheme geonames:V;
                skos:notation "V.GRVC";
                skos:prefLabel "kokospalmelund"@no,
                               "kokoslund"@sv,
                               "coconut grove"@en,
                               "кокосови насаждения"@bg,
                               "плантация кокосовых деревьев"@ru.
geonames:V.GRVO a geonames:Code;
                skos:definition "большой участок земли, занятый оливковыми деревьями"@ru,
                                "a planting of olive trees"@en;
                skos:inScheme geonames:V;
                skos:notation "V.GRVO";
                skos:prefLabel "olivenlund"@no,
                               "olive grove"@en,
                               "плантация оливковых деревьев"@ru,
                               "маслинова плантация"@bg,
                               "olivlund"@sv.
geonames:V.GRVP a geonames:Code;
                skos:definition "a planting of palm trees"@en,
                                "небольшой лесной участок, состоящий из пальмовых деревьев"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.GRVP";
                skos:prefLabel "palmlund"@sv,
                               "palm grove"@en,
                               "палмова плантация"@bg,
                               "пальмовая роща"@ru,
                               "palmelund"@no.
geonames:V.GRVPN a geonames:Code;
                 skos:definition "небольшой лесной участок, состоящий из сосен"@ru,
                                 "a planting of pine trees"@en;
                 skos:inScheme geonames:V;
                 skos:notation "V.GRVPN";
                 skos:prefLabel "pine grove"@en,
                                "сосновая роща"@ru,
                                "furulund"@sv,
                                "furulund"@no,
                                "иглолистни насаждения"@bg.
geonames:V.HTH a geonames:Code;
               skos:definition "вересковые пустоши, тип растительности, представленный вечнозелёными кустарниками и кустарничками, преимущественно семейства вересковых, имеющих жёсткие узкие листья"@ru,
                               "an upland moor or sandy area dominated by low shrubby vegetation including heather"@en;
               skos:inScheme geonames:V;
               skos:notation "V.HTH";
               skos:prefLabel "верещатник"@ru,
                              "пустош"@bg,
                              "heath"@en,
                              "hei"@no,
                              "hed"@sv.
geonames:V.MDW a geonames:Code;
               skos:definition "небольшой луг, луг среди других угодий (лесных, пастбищных"@ru,
                               "a small, poorly drained area dominated by grassy vegetation"@en;
               skos:inScheme geonames:V;
               skos:notation "V.MDW";
               skos:prefLabel "ливада"@bg,
                              "äng"@sv,
                              "meadow"@en,
                              "eng"@no,
                              "луговина"@ru.
geonames:V.OCH a geonames:Code;
               skos:definition "a planting of fruit or nut trees"@en,
                               "участок земли, на котором выращивают фруктовые деревья"@ru;
               skos:inScheme geonames:V;
               skos:notation "V.OCH";
               skos:prefLabel "овощна градина(и)"@bg,
                              "orchard(s)"@en,
                              "frukthage"@no,
                              "фруктовый сад"@ru,
                              "fruktträdgård(ar)"@sv.
geonames:V.SCRB a geonames:Code;
                skos:definition "густо разросшийся кустарник, массив трав, деревьев и т. п."@ru,
                                "an area of low trees, bushes, and shrubs stunted by some environmental limitation"@en;
                skos:inScheme geonames:V;
                skos:notation "V.SCRB";
                skos:prefLabel "кустарниковая заросль"@ru,
                               "krattskog"@no,
                               "buskterräng"@sv,
                               "храсти"@bg,
                               "scrubland"@en.
geonames:V.TREE a geonames:Code;
                skos:definition "a conspicuous tree used as a landmark"@en,
                                "дерево (известное благодаря чему-л.), являющееся  достопримечательностью"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.TREE";
                skos:prefLabel "дървета"@bg,
                               "дерево"@ru,
                               "tree(s)"@en,
                               "träd"@sv,
                               "tre"@no.
geonames:V.TUND a geonames:Code;
                skos:definition "a marshy, treeless, high latitude plain, dominated by mosses, lichens, and low shrub vegetation under permafrost conditions"@en,
                                "тип растительности высоких широт Северного полушария Земли, характеризующийся развитием мохового и лишайникового покровов, наличием низкорослых кустарников и т.п.; природная зона с таким типом растительности"@ru;
                skos:inScheme geonames:V;
                skos:notation "V.TUND";
                skos:prefLabel "tundra"@sv,
                               "tundra"@no,
                               "tundra"@en,
                               "тундра"@bg,
                               "тундра"@ru.
geonames:V.VIN a geonames:Code;
               skos:definition "a planting of grapevines"@en,
                               "участок, засаженный виноградом; виноградная плантация"@ru;
               skos:inScheme geonames:V;
               skos:notation "V.VIN";
               skos:prefLabel "vingård"@no,
                              "vineyard"@en,
                              "виноградник"@ru,
                              "лозя"@bg,
                              "vingård"@sv.
geonames:V.VINS a geonames:Code;
                skos:definition "виноградные плантации"@ru,
                                "plantings of grapevines"@en;
                skos:inScheme geonames:V;
                skos:notation "V.VINS";
                skos:prefLabel "vingårdar"@sv,
                               "виноградники"@ru,
                               "vineyards"@en,
                               "лозя"@bg,
                               "vingårder"@no.
geonames:WikipediaArticle a owl:Class;
                          rdfs:comment "A Wikipedia article"@en;
                          rdfs:label "Wikipedia Article"@en;
                          rdfs:subClassOf foaf:Document.
geonames:alternateName a owl:DatatypeProperty;
                       rdfs:domain geonames:Feature;
                       rdfs:subPropertyOf skos:altLabel.
geonames:childrenFeatures a owl:ObjectProperty;
                          rdfs:comment "Links to an RDF document containing the descriptions of children features"@en;
                          rdfs:domain geonames:Feature;
                          rdfs:label "children features"@en;
                          rdfs:range geonames:RDFData.
geonames:colloquialName a owl:DatatypeProperty;
                        rdfs:label "colloquial name"@en;
                        rdfs:subPropertyOf geonames:alternateName.
geonames:countryCode a owl:DatatypeProperty;
                     rdfs:comment "The countryCode value for a Geoname Feature is equal to the countryCode value of the parentCountry value."@en,
                                  "A two letters country code in the ISO 3166 list"@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "ISO country code"@en.
geonames:featureClass a owl:ObjectProperty;
                      rdfs:comment "The main category of the feature, as defined in geonames taxonomy."@en;
                      rdfs:domain geonames:Feature;
                      rdfs:label "feature class"@en;
                      rdfs:range geonames:Class;
                      rdfs:subPropertyOf dcterms:type;
                      owl:propertyChainAxiom (geonames:featureCode
                                              skos:inScheme),
                                             (geonames:featureCode
                                              skos:inScheme).
geonames:featureCode a owl:ObjectProperty;
                     rdfs:comment "Type of the feature, as defined in geonames taxonomy."@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "feature code"@en;
                     rdfs:range geonames:Code;
                     rdfs:subPropertyOf dcterms:type.
geonames:geonamesID a owl:DatatypeProperty;
                    rdfs:label "geonames identifier"@en;
                    rdfs:subPropertyOf dcterms:identifier;
                    skos:historyNote "Added in version 3.1"@en.
geonames:historicalName a owl:DatatypeProperty;
                        rdfs:label "historical name"@en;
                        rdfs:subPropertyOf geonames:alternateName.
geonames:locatedIn a owl:ObjectProperty;
                   rdfs:comment "Indicates that the subject resource is located in the object feature"@en;
                   rdfs:label "located in"@en;
                   rdfs:range geonames:Feature.
geonames:locationMap a owl:ObjectProperty;
                     rdfs:comment "A geonames map centered on the feature."@en;
                     rdfs:domain geonames:Feature;
                     rdfs:label "map"@en;
                     rdfs:range geonames:Map.
geonames:name a owl:DatatypeProperty;
              rdfs:comment "The main international name of a feature. The value has no xml:lang tag."@en;
              rdfs:domain geonames:Feature;
              rdfs:label "name"@en.
geonames:nearby a owl:ObjectProperty;
                rdfs:comment "A feature close to the reference feature"@en;
                rdfs:domain geonames:Feature;
                rdfs:label "nearby"@en;
                rdfs:range geonames:Feature.
geonames:nearbyFeatures a owl:ObjectProperty;
                        rdfs:comment "Links to an RDF document containing the descriptions of nearby features"@en;
                        rdfs:domain geonames:Feature;
                        rdfs:label "nearby features"@en;
                        rdfs:range geonames:RDFData.
geonames:neighbour a owl:SymmetricProperty,
                     owl:ObjectProperty;
                   rdfs:comment "A feature sharing a common boarder with the reference feature"@en;
                   rdfs:domain geonames:Feature;
                   rdfs:label "neighbour"@en;
                   rdfs:range geonames:Feature.
geonames:neighbouringFeatures a owl:ObjectProperty;
                              rdfs:comment "Links to an RDF document containing the descriptions of neighbouring features. Applies when the feature has definite boarders."@en;
                              rdfs:domain geonames:Feature;
                              rdfs:label "neighbouring features"@en;
                              rdfs:range geonames:RDFData.
geonames:officialName a owl:DatatypeProperty;
                      rdfs:comment "A name in an official local language"@en;
                      rdfs:domain geonames:Feature;
                      rdfs:label "official name"@en;
                      rdfs:subPropertyOf skos:prefLabel.
geonames:parentADM1 a owl:ObjectProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 1 administrative parent"@en;
                    rdfs:range [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM1 ; 
                                a owl:Restriction],
                               [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM1 ; 
                                a owl:Restriction];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM2 a owl:ObjectProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 2 administrative parent"@en;
                    rdfs:range [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM2 ; 
                                a owl:Restriction],
                               [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM2 ; 
                                a owl:Restriction];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM3 a owl:ObjectProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 3 administrative parent"@en;
                    rdfs:range [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM3 ; 
                                a owl:Restriction],
                               [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM3 ; 
                                a owl:Restriction];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentADM4 a owl:ObjectProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "level 4 administrative parent"@en;
                    rdfs:range [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM4 ; 
                                a owl:Restriction],
                               [owl:onProperty geonames:featureCode ; 
                                owl:hasValue geonames:A.ADM4 ; 
                                a owl:Restriction];
                    rdfs:subPropertyOf geonames:parentFeature.
geonames:parentCountry a owl:ObjectProperty;
                       rdfs:domain geonames:Feature;
                       rdfs:label "parent country"@en;
                       rdfs:range [owl:onProperty geonames:featureCode ; 
                                   owl:hasValue geonames:A.PCLI ; 
                                   a owl:Restriction],
                                  [owl:onProperty geonames:featureCode ; 
                                   owl:hasValue geonames:A.PCLI ; 
                                   a owl:Restriction];
                       rdfs:subPropertyOf geonames:parentFeature.
geonames:parentFeature a owl:TransitiveProperty,
                         owl:ObjectProperty;
                       rdfs:comment "A feature parent of the current one, in either administrative or physical subdivision."@en;
                       rdfs:domain geonames:Feature;
                       rdfs:label "parent feature"@en;
                       rdfs:range geonames:Feature.
geonames:population a owl:DatatypeProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "population"@en;
                    rdfs:range xsd:integer.
geonames:postalCode a owl:DatatypeProperty;
                    rdfs:domain geonames:Feature;
                    rdfs:label "postal code"@en.
geonames:shortName a owl:DatatypeProperty;
                   rdfs:domain geonames:Feature;
                   rdfs:label "short name"@en;
                   rdfs:subPropertyOf geonames:alternateName.
geonames:wikipediaArticle a owl:ObjectProperty;
                          rdfs:comment "A Wikipedia article of which subject is the resource."@en;
                          rdfs:domain geonames:Feature;
                          rdfs:label "wikipedia article"@en;
                          rdfs:range geonames:WikipediaArticle.
skos:notation a owl:DatatypeProperty;
              rdfs:comment "Used to store the values of feature codes"@en;
              rdfs:label "notation"@en.
skos:prefLabel a owl:DatatypeProperty.
foaf:name a owl:DatatypeProperty.
