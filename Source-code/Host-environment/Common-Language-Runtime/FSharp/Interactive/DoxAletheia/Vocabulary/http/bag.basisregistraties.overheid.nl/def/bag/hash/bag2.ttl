@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix bag2: <http://bag.basisregistraties.overheid.nl/def/bag#>.

<http://bag.basisregistraties.overheid.nl/def/bag> a <http://www.w3.org/2002/07/owl#Ontology>;
                                                   rdfs:label "Basisregistraties adressen en gebouwen vocabulaire"@nl.
bag2:AdministratiefGebied <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/RegistratiefGebied>;
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Op basis van wet- of regelgeving afgebakend gebied dat als eenheid geldt van politiek/bestuurlijke verantwoordelijkheid of voor bedrijfsvoering."@nl;
                          rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                          rdfs:label "Administratief gebied"@nl;
                          rdfs:subClassOf bag2:OpenbareRuimte.
bag2:AdresseerbaarObject <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/AdresseerbaarObject>;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Een adresseerbaar object is een object waaraan adressen ingevolge de basisregistratie adressen kunnen worden toegekend: een verblijfsobject, standplaats of ligplaats."@nl;
                         rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                         rdfs:label "Adresseerbaar object"@nl;
                         rdfs:subClassOf bag2:BAG-object.
bag2:BAG-object <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Object>;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Een object is een woonplaats, openbare ruimte, nummeraanduiding, pand, verblijfsobject, standplaats of ligplaats"@nl;
                rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                rdfs:label "BAG-object"@nl.
bag2:Brondocument <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Brondocument>;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Een brondocument is een document waarin rechtsfeiten en andere voor de registraties relevante feiten zijn neergelegd."@nl;
                  rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                  rdfs:label "Brondocument"@nl;
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>.
bag2:Kunstwerk <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Kunstwerk>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Civiel-technisch werk voor de infrastructuur van wegen, water, spoorbanen, waterkeringen en/of leidingen en niet bedoeld voor permanent menselijk verblijf."@nl;
               rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
               rdfs:label "Kunstwerk"@nl;
               rdfs:subClassOf bag2:OpenbareRuimte.
bag2:LandschappelijkGebied <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/LandschappelijkGebied>;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Definitie ontbreekt"@nl;
                           rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                           rdfs:label "Landschappelijk gebied"@nl;
                           rdfs:subClassOf bag2:OpenbareRuimte.
bag2:Ligplaats <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Ligplaats>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Een ligplaats is een door het bevoegde gemeentelijke orgaan als zodanig aangewezen plaats in het water al dan niet aangevuld met een op de oever aanwezig terrein of een gedeelte daarvan, die bestemd is voor het permanent afmeren van een voor woon-, bedrijfsmatige of recreatieve doeleinden geschikt vaartuig"@nl;
               rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
               rdfs:label "Ligplaats"@nl;
               rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>,
                               bag2:AdresseerbaarObject.
bag2:Nummeraanduiding <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Nummeraanduiding>;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Een nummeraanduiding is een door het bevoegde gemeentelijke orgaan als zodanig toegekende aanduiding van een verblijfsobject, een standplaats of een ligplaats. Het is het samenstel van huisnummer, huisletter en huisnummertoevoeging."@nl;
                      rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                      rdfs:label "Nummeraanduiding"@nl;
                      rdfs:subClassOf bag2:BAG-object.
bag2:OpenbareRuimte <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/OpenbareRuimte>;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Een openbare ruimte is een door het bevoegde gemeentelijke orgaan als zodanig aangewezen en van een naam voorziene buitenruimte die binnen één woonplaats is gelegen."@nl;
                    rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                    rdfs:label "Openbare ruimte"@nl;
                    rdfs:subClassOf bag2:BAG-object.
bag2:Pand <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Pand>;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Een pand is een kleinste bij de totstandkoming functioneel en bouwkundig-constructief zelfstandige eenheid die direct en duurzaam met de aarde is verbonden en betreedbaar en afsluitbaar is"@nl;
          rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
          rdfs:label "Pand"@nl;
          rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>,
                          bag2:BAG-object.
bag2:Spoorbaan <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Spoorbaan>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Gebaand gedeelte voor het verkeer over rails."@nl;
               rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
               rdfs:label "Spoorbaan"@nl;
               rdfs:subClassOf bag2:OpenbareRuimte.
bag2:Standplaats <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Standplaats>;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Een standplaats is een door het bevoegde gemeentelijke orgaan als zodanig aangewezen terrein of gedeelte daarvan dat bestemd is voor het permanent plaatsen van een niet direct en niet duurzaam met de aarde verbonden en voor woon-, bedrijfsmatige, of recreatieve doeleinden geschikte ruimte"@nl;
                 rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                 rdfs:label "Standplaats"@nl;
                 rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>,
                                 bag2:AdresseerbaarObject.
bag2:Terrein <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Terrein>;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Door een fysiek voorkomen gekarakteriseerd zichtbaar begrensd stuk grond."@nl;
             rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
             rdfs:label "Terrein"@nl;
             rdfs:subClassOf bag2:OpenbareRuimte.
bag2:Verblijfsobject <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Verblijfsobject>;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Een verblijfsobject is een kleinste binnen één of meer panden gelegen en voor woon-, bedrijfsmatige, of recreatieve doeleinden geschikte eenheid van gebruik die ontsloten wordt via een eigen afsluitbare toegang vanaf de openbare weg, een erf of een gedeelde verkeersruimte, onderwerp kan zijn van goederenrechtelijke rechtshandelingen en in functioneel opzicht zelfstandig is"@nl;
                     rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                     rdfs:label "Verblijfsobject"@nl;
                     rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>,
                                     bag2:AdresseerbaarObject.
bag2:VerblijfsobjectBijeenkomstfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Bijeenkomstfunctie>;
                                       a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "Gebruiksfunctie voor het samenkomen van mensen voor kunst, cultuur, godsdienst, communicatie, kinderopvang, het verstrekken van consumpties voor het gebruik ter plaatse en het aanschouwen van sport."@nl;
                                       rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                       rdfs:label "Verblijfsobject met bijeenkomstfunctie"@nl;
                                       rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectCelfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Celfunctie>;
                               a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Gebruiksfunctie voor dwangverblijf van mensen."@nl;
                               rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                               rdfs:label "Verblijfsobject met celfunctie"@nl;
                               rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectGezondheidszorgfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Gezondheidszorgfunctie>;
                                           a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "Gebruiksfunctie voor medisch onderzoek, verpleging, verzorging of behandeling."@nl;
                                           rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                           rdfs:label "Verblijfsobject met gezondheidszorgfunctie"@nl;
                                           rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectIndustriefunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Industriefunctie>;
                                     a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "Gebruiksfunctie voor het bedrijfsmatig bewerken of opslaan van materialen en goederen, of voor agrarische doeleinden."@nl;
                                     rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                     rdfs:label "Verblijfsobject met industriefunctie"@nl;
                                     rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectKantoorfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Kantoorfunctie>;
                                   a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Gebruiksfunctie voor administratie."@nl;
                                   rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                   rdfs:label "Verblijfsobject met kantoorfunctie"@nl;
                                   rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectLogiesfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Logiesfunctie>;
                                  a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Gebruiksfunctie voor het bieden van recreatief verblijf of tijdelijk onderdak aan mensen."@nl;
                                  rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                  rdfs:label "Verblijfsobject met logiesfunctie"@nl;
                                  rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectOnderwijsfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Onderwijsfunctie>;
                                     a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "Gebruiksfunctie voor het geven van onderwijs."@nl;
                                     rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                     rdfs:label "Verblijfsobject met onderwijsfunctie"@nl;
                                     rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectOverigeGebruiksfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/OverigeGebruiksfunctie>;
                                           a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "Niet in dit lid benoemde gebruiksfunctie voor activiteiten waarbij het verblijven van mensen een ondergeschikte rol speelt."@nl;
                                           rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                           rdfs:label "Verblijfsobject met overige gebruiksfunctie"@nl;
                                           rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectSportfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Sportfunctie>;
                                 a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Gebruiksfunctie voor het beoefenen van sport."@nl;
                                 rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                 rdfs:label "Verblijfsobject met sportfunctie"@nl;
                                 rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectWinkelfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Winkelfunctie>;
                                  a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Gebruiksfunctie voor het verhandelen van materialen, goederen of diensten."@nl;
                                  rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                  rdfs:label "Verblijfsobject met winkelfunctie"@nl;
                                  rdfs:subClassOf bag2:Verblijfsobject.
bag2:VerblijfsobjectWoonfunctie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Woonfunctie>;
                                a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Gebruiksfunctie voor het wonen."@nl;
                                rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                rdfs:label "Verblijfsobject met woonfunctie"@nl;
                                rdfs:subClassOf bag2:Verblijfsobject.
bag2:Voorkomen <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Voorkomen>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Een voorkomen van een object is de combinatie van gegevens over een object dat geldig is in een bepaalde periode."@nl;
               rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
               rdfs:label "Voorkomen"@nl;
               rdfs:subClassOf <http://www.w3.org/ns/sparql-service-description#Graph>,
                               <http://www.w3.org/ns/prov#Entity>.
bag2:Water <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Water>;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Grondoppervlak in principe bedekt met water."@nl;
           rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
           rdfs:label "Water"@nl;
           rdfs:subClassOf bag2:OpenbareRuimte.
bag2:Weg <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Weg>;
         a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Gebaand gedeelte voor het wegverkeer en vliegverkeer te land."@nl;
         rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
         rdfs:label "Weg"@nl;
         rdfs:subClassOf bag2:OpenbareRuimte.
bag2:Woonplaats <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Woonplaats>;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Een woonplaats is een door het bevoegde gemeentelijke orgaan als zodanig aangewezen en van een naam voorzien gedeelte van het grondgebied van de gemeente"@nl;
                rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                rdfs:label "Woonplaats"@nl;
                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>,
                                bag2:BAG-object.
bag2:aanduidingCorrectie <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/AanduidingRecordCorrectie>;
                         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Een inactief voorkomen als gevolg van synchronisatie tussen bronhouder en de Landelijke Voorziening BAG."@nl;
                         rdfs:domain bag2:Voorkomen;
                         rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                         rdfs:label "aanduiding correctie"@nl.
bag2:aanduidingInactief <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/AanduidingRecordInactief>;
                        a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Voorkomens van objecten met een begindatum in de toekomst die zijn gemuteerd. Ze maken daarmee geen onderdeel meer uit van de levenscyclus."@nl;
                        rdfs:domain bag2:Voorkomen;
                        rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                        rdfs:label "aanduiding inactief"@nl.
bag2:beginGeldigheid <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Ingangsdatum>;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Een ingangsdatum is een niet-authentiek gegeven dat de begindatum aangeeft van een periode waarin een voorkomen een wijziging heeft ondergaan."@nl;
                     rdfs:domain bag2:Voorkomen;
                     rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                     rdfs:label "begin geldigheid"@nl.
bag2:bijbehorendeOpenbareRuimte <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/OpenbareRuimte_Nummeraanduiding>;
                                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Openbare ruimte van een nummeraanduiding is de openbare ruimte waaraan een adresseerbaar object is gelegen en aan welk object de nummeraanduiding is gerelateerd"@nl;
                                rdfs:domain bag2:Nummeraanduiding;
                                rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                                rdfs:label "bijbehorende openbare ruimte"@nl.
bag2:bijbehorendeWoonplaats <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Woonplaats_Nummeraanduiding>,
                                                               <http://bag.basisregistraties.overheid.nl/id/begrip/Woonplaats_OpenbareRuimte>;
                            a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "De woonplaats openbare ruimte is een unieke aanduiding van de woonplaats waarbinnen een openbare ruimte is gelegen."@nl,
                                         "Een woonplaats van een nummeraanduiding is de woonplaats waarbinnen het object waaraan de nummeraanduiding is toegekend gelegen is indien die woonplaats afwijkt van de woonplaats waarbinnen de openbare ruimte waaraan de nummeraanduiding is gerelateerd gelegen is."@nl;
                            rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                            rdfs:label "bijbehorende woonplaats"@nl.
bag2:bron <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Bronrelatering>;
          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "De relatie naar het brondocument dat ten grondslag ligt aan het voorkomen van een object."@nl;
          rdfs:domain bag2:Voorkomen;
          rdfs:label "bron"@nl;
          rdfs:range bag2:Brondocument;
          rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasDerivedFrom>.
bag2:documentdatum <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Documentdatum>;
                   a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "De datum waarop het brondocument is vastgesteld, op basis waarvan een opname, mutatie of een verwijdering van gegevens ten aanzien van een object heeft plaatsgevonden."@nl;
                   rdfs:domain bag2:Brondocument;
                   rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                   rdfs:label "documentdatum"@nl.
bag2:documentnummer <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Documentnummer>;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "De unieke aanduiding van de vindplaats van een document binnen een organisatie."@nl;
                    rdfs:domain bag2:Brondocument;
                    rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                    rdfs:label "documentnummer"@nl.
bag2:eindGeldigheid <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Einddatum>;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "De einddatum van de geldigheid van een bepaalde combinatie van gegevens."@nl;
                    rdfs:domain bag2:Voorkomen;
                    rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                    rdfs:label "eind geldigheid"@nl.
bag2:geconstateerd <http://purl.org/dc/terms/subject> <http://bag.basisregistraties.overheid.nl/id/begrip/Geconstateerd>;
                   a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Geconstateerd is een aanduiding waarmee kan worden aangegeven dat een object in de registratie is opgenomen als gevolg van een feitelijke constatering, zonder dat er op het moment van opname sprake was van een regulier brondocument voor deze opname."@nl;
                   rdfs:domain bag2:Voorkomen;
                   rdfs:isDefinedBy <http://bag.basisregistraties.overheid.nl/def/bag>;
                   rdfs:label "geconstateerd"@nl.
