<http://id.ecs.soton.ac.uk/person/1248> foaf:homepage <http://users.ecs.soton.ac.uk/cjg/>;
                                        foaf:name "Christopher Gutteridge".
uri4uri: dcterms:creator <http://id.ecs.soton.ac.uk/person/1248>;
         dcterms:description "This vocabulary describes the entities which may be derived from a URI and the relationships between them, such as Internet Domains, prototcols, file suffixes etc. It was initially issued as part of an April 1st gag, but has utility beyond the initial joke.";
         dcterms:issued "2013-04-01"^^xsd:date;
         dcterms:title "URI Vocabulary";
         a owl:Ontology.
uri4uri:Domain a rdfs:Class;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "Internet Domain".
uri4uri:Domain-Invalid a rdfs:Class;
                       rdfs:isDefinedBy uri4uri:;
                       rdfs:label "Invalid Internet Domain".
uri4uri:Domain-Valid a rdfs:Class;
                     rdfs:isDefinedBy uri4uri:;
                     rdfs:label "Valid Internet Domain".
uri4uri:DomainDatatype a rdfs:Datatype;
                       rdfs:isDefinedBy uri4uri:;
                       rdfs:label "Internet Domain Identifier".
uri4uri:Format a rdfs:Class;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "File Format".
uri4uri:FragmentURI a rdfs:Class;
                    rdfs:isDefinedBy uri4uri:;
                    rdfs:label "URI with Fragement Identifier".
uri4uri:HostPort a rdfs:Class;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "Host and Port".
uri4uri:IANAPage a rdf:Property;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "IANA page".
uri4uri:IANARef a rdf:Property;
                rdfs:isDefinedBy uri4uri:;
                rdfs:label "IANA reference".
uri4uri:Mimetype a rdfs:Class;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "Mimetype".
uri4uri:MimetypeDatatype a rdfs:Datatype;
                         rdfs:isDefinedBy uri4uri:;
                         rdfs:label "Mimetype Identifier".
uri4uri:Query a rdfs:Class;
              rdfs:isDefinedBy uri4uri:;
              rdfs:label "URI Query Part".
uri4uri:QueryKVP a rdfs:Class;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "URI Query Key-Value Pair".
uri4uri:QueryKey a rdfs:Class;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "URI Query Key".
uri4uri:QueryValue a rdfs:Class;
                   rdfs:isDefinedBy uri4uri:;
                   rdfs:label "URI Query Value".
uri4uri:Statement a rdfs:Class;
                  rdfs:isDefinedBy uri4uri:;
                  rdfs:label "Statement (reified)".
uri4uri:Suffix a rdfs:Class;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "Filename Suffix".
uri4uri:SuffixDatatype a rdfs:Datatype;
                       rdfs:isDefinedBy uri4uri:;
                       rdfs:label "Filename Suffix Identifier".
uri4uri:TopLevelDomain a rdfs:Class;
                       rdfs:isDefinedBy uri4uri:;
                       rdfs:label "Top-Level Domain".
uri4uri:TopLevelDomain-CountryCode a rdfs:Class;
                                   rdfs:isDefinedBy uri4uri:;
                                   rdfs:label "Country Top-Level Domain".
uri4uri:TopLevelDomain-Generic a rdfs:Class;
                               rdfs:isDefinedBy uri4uri:;
                               rdfs:label "Generic Top-Level Domain".
uri4uri:TopLevelDomain-GenericRestricted a rdfs:Class;
                                         rdfs:isDefinedBy uri4uri:;
                                         rdfs:label "Restricted Generic Top-Level Domain".
uri4uri:TopLevelDomain-Infrastructure a rdfs:Class;
                                      rdfs:isDefinedBy uri4uri:;
                                      rdfs:label "Infrastructure Top-Level Domain".
uri4uri:TopLevelDomain-Sponsored a rdfs:Class;
                                 rdfs:isDefinedBy uri4uri:;
                                 rdfs:label "Sponsored Top-Level Domain".
uri4uri:TopLevelDomain-Test a rdfs:Class;
                            rdfs:isDefinedBy uri4uri:;
                            rdfs:label "Test Top-Level Domain".
uri4uri:URI a rdfs:Class;
            rdfs:isDefinedBy uri4uri:;
            rdfs:label "URI".
uri4uri:URIDatatype a rdfs:Datatype;
                    rdfs:isDefinedBy uri4uri:;
                    rdfs:label "URI Identifier".
uri4uri:URIScheme a rdfs:Class;
                  rdfs:isDefinedBy uri4uri:;
                  rdfs:label "URI Scheme".
uri4uri:URISchemeDatatype a rdfs:Datatype;
                          rdfs:isDefinedBy uri4uri:;
                          rdfs:label "URI Scheme Identifier".
uri4uri:WhoisServer a rdfs:Class;
                    rdfs:isDefinedBy uri4uri:;
                    rdfs:label "Whois Server".
uri4uri:account a rdf:Property;
                rdfs:isDefinedBy uri4uri:;
                rdfs:label "account".
uri4uri:connectsTo a rdf:Property;
                   rdfs:isDefinedBy uri4uri:;
                   rdfs:label "connects to".
uri4uri:delegationRecordPage a rdf:Property;
                             rdfs:isDefinedBy uri4uri:;
                             rdfs:label "delegation record page".
uri4uri:filename a rdf:Property;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "filename".
uri4uri:fragment a rdf:Property;
                 rdfs:isDefinedBy uri4uri:;
                 rdfs:label "fragment".
uri4uri:fragmentOf a rdf:Property;
                   rdfs:isDefinedBy uri4uri:;
                   rdfs:label "fragment of".
uri4uri:hasWhoIsServer a rdf:Property;
                       rdfs:isDefinedBy uri4uri:;
                       rdfs:label "whois server".
uri4uri:host a rdf:Property;
             rdfs:isDefinedBy uri4uri:;
             rdfs:label "host".
uri4uri:identifiedBy a rdf:Property;
                     rdfs:isDefinedBy uri4uri:;
                     rdfs:label "identified by URI".
uri4uri:key a rdf:Property;
            rdfs:isDefinedBy uri4uri:;
            rdfs:label "key".
uri4uri:length a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "length".
uri4uri:md5 a rdf:Property;
            rdfs:isDefinedBy uri4uri:;
            rdfs:label "md5 hash".
uri4uri:noPortSpecified a skos:Concept;
                        rdfs:isDefinedBy uri4uri:;
                        rdfs:label "No Port Specified".
uri4uri:object a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "object".
uri4uri:pass a rdf:Property;
             rdfs:isDefinedBy uri4uri:;
             rdfs:label "password".
uri4uri:path a rdf:Property;
             rdfs:isDefinedBy uri4uri:;
             rdfs:label "path".
uri4uri:port a rdf:Property;
             rdfs:isDefinedBy uri4uri:;
             rdfs:label "port".
uri4uri:predicate a rdf:Property;
                  rdfs:isDefinedBy uri4uri:;
                  rdfs:label "predicate".
uri4uri:query a rdf:Property;
              rdfs:isDefinedBy uri4uri:;
              rdfs:label "query".
uri4uri:queryString a rdf:Property;
                    rdfs:isDefinedBy uri4uri:;
                    rdfs:label "query string".
uri4uri:scheme a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "URI scheme".
uri4uri:sponsor a rdf:Property;
                rdfs:isDefinedBy uri4uri:;
                rdfs:label "sponsor".
uri4uri:subDom a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "subdomain".
uri4uri:subject a rdf:Property;
                rdfs:isDefinedBy uri4uri:;
                rdfs:label "subject".
uri4uri:suffix a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "suffix".
uri4uri:trueAt a rdf:Property;
               rdfs:isDefinedBy uri4uri:;
               rdfs:label "trueAt".
uri4uri:usedForFormat a rdf:Property;
                      rdfs:isDefinedBy uri4uri:;
                      rdfs:label "used for format".
uri4uri:usedForSuffix a rdf:Property;
                      rdfs:isDefinedBy uri4uri:;
                      rdfs:label "used for suffix".
uri4uri:user a rdf:Property;
             rdfs:isDefinedBy uri4uri:;
             rdfs:label "user".
uri4uri:value a rdf:Property;
              rdfs:isDefinedBy uri4uri:;
              rdfs:label "value".
uri4uri:whoIsRecord a rdf:Property;
                    rdfs:isDefinedBy uri4uri:;
                    rdfs:label "whois record".
