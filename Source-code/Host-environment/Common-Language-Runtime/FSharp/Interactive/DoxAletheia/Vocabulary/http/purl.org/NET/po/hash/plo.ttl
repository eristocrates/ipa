@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix plo: <http://purl.org/net/po#>.
@prefix mo: <http://purl.org/ontology/mo/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

_:B32df8529a1fa0cc49414deb2bdd898b9 a owl:AllDisjointClasses;
                                    owl:members (plo:Playlist
                                                 plo:PlaylistEntry
                                                 plo:Song).
_:Ba63647659aa434b5b5d7404c4f4d6a63 a owl:AllDisjointClasses;
                                    owl:members (plo:Playlist
                                                 plo:PlaylistEntry
                                                 plo:Song).
dc11:title a owl:DatatypeProperty;
           rdfs:domain plo:Song;
           rdfs:range rdfs:Literal.
plo: dcterms:description "An ontology for describing playlists, playlist entries and songs.";
     dcterms:title "Playlist Ontology";
     vann:preferredNamespacePrefix "po";
     vann:preferredNamespaceUri "http://purl.org/net/po#";
     a voaf:Vocabulary,
       owl:Ontology.
plo:Playlist a owl:Class;
             rdfs:comment "A class for representing a playlist. One Playlist instance is connected to one or more PlaylistEntry instances. It contains the name of the playlist and the name of the radio station."@en;
             rdfs:label "Playlist"@en.
plo:PlaylistEntry a owl:Class;
                  rdfs:comment "A class for representing an entry from a playlist. One PlaylistEntry instance is connected to one Song instance and one Playlist instance. It contains information about the 'position' of the Song in the Playlist, for the specific 'week' of the 'year'. It also contains an URL of a 'photo' for the playlist entry."@en;
                  rdfs:label "Playlist Entry"@en;
                  rdfs:subClassOf [a owl:Restriction ; 
                                   owl:onProperty plo:playlistEntrySong ; 
                                   owl:onClass plo:Song ; 
                                   owl:qualifiedCardinality 1 ],
                                  [a owl:Restriction ; 
                                   owl:onProperty plo:partOfPlaylist ; 
                                   owl:onClass plo:Playlist ; 
                                   owl:qualifiedCardinality 1 ],
                                  [a owl:Restriction ; 
                                   owl:onProperty plo:playlistEntrySong ; 
                                   owl:onClass plo:Song ; 
                                   owl:qualifiedCardinality 1 ],
                                  [a owl:Restriction ; 
                                   owl:onProperty plo:partOfPlaylist ; 
                                   owl:onClass plo:Playlist ; 
                                   owl:qualifiedCardinality 1 ].
plo:Song a owl:Class;
         rdfs:comment "A class for representing a song. One Song instance is connected to one or more PlaylistEntry instances. It contains the name of the song and the name of the artist. It can also contain external links to mo:Track and/or mo:MusicArtist instances, for creating Linked Data."@en;
         rdfs:label "Song"@en.
plo:artistInfo a owl:ObjectProperty;
               rdfs:domain plo:Song;
               rdfs:range mo:MusicArtist.
plo:featuredInPlaylistEntry a owl:ObjectProperty;
                            rdfs:domain plo:Song;
                            rdfs:range plo:PlaylistEntry;
                            owl:inverseOf plo:playlistEntrySong.
plo:hasPlaylistEntry a owl:ObjectProperty;
                     rdfs:domain plo:Playlist;
                     rdfs:range plo:PlaylistEntry;
                     owl:inverseOf plo:partOfPlaylist.
plo:partOfPlaylist a owl:ObjectProperty;
                   rdfs:domain plo:PlaylistEntry;
                   rdfs:range plo:Playlist.
plo:photoURL a owl:DatatypeProperty;
             rdfs:domain plo:PlaylistEntry;
             rdfs:range rdfs:Literal.
plo:playlistEntrySong a owl:ObjectProperty;
                      rdfs:domain plo:PlaylistEntry;
                      rdfs:range plo:Song.
plo:playlistName a owl:DatatypeProperty;
                 rdfs:domain plo:Playlist;
                 rdfs:range rdfs:Literal.
plo:position a owl:DatatypeProperty;
             rdfs:domain plo:PlaylistEntry;
             rdfs:range xsd:nonNegativeInteger.
plo:songInfo a owl:ObjectProperty;
             rdfs:domain plo:Song;
             rdfs:range mo:Track.
plo:stationName a owl:DatatypeProperty;
                rdfs:domain plo:Playlist;
                rdfs:range rdfs:Literal.
plo:week a owl:DatatypeProperty;
         rdfs:domain plo:PlaylistEntry;
         rdfs:range xsd:nonNegativeInteger.
plo:year a owl:DatatypeProperty;
         rdfs:domain plo:PlaylistEntry;
         rdfs:range xsd:nonNegativeInteger.
mo:MusicArtist a owl:Class.
mo:Track a owl:Class.
foaf:name a owl:DatatypeProperty;
          rdfs:domain plo:Song;
          rdfs:range rdfs:Literal.
