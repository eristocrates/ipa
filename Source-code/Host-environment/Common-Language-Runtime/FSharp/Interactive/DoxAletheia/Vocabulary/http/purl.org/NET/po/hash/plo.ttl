@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix plo: <http://purl.org/net/po#>.

_:B32df8529a1fa0cc49414deb2bdd898b9 a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (plo:Playlist
                                                                             plo:PlaylistEntry
                                                                             plo:Song).
_:Ba63647659aa434b5b5d7404c4f4d6a63 a <http://www.w3.org/2002/07/owl#AllDisjointClasses>;
                                    <http://www.w3.org/2002/07/owl#members> (plo:Playlist
                                                                             plo:PlaylistEntry
                                                                             plo:Song).
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                        rdfs:domain plo:Song;
                                        rdfs:range rdfs:Literal.
plo: <http://purl.org/dc/terms/description> "An ontology for describing playlists, playlist entries and songs.";
     <http://purl.org/dc/terms/title> "Playlist Ontology";
     <http://purl.org/vocab/vann/preferredNamespacePrefix> "po";
     <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/net/po#";
     a <http://purl.org/vocommons/voaf#Vocabulary>,
       <http://www.w3.org/2002/07/owl#Ontology>.
plo:Playlist a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A class for representing a playlist. One Playlist instance is connected to one or more PlaylistEntry instances. It contains the name of the playlist and the name of the radio station."@en;
             rdfs:label "Playlist"@en.
plo:PlaylistEntry a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A class for representing an entry from a playlist. One PlaylistEntry instance is connected to one Song instance and one Playlist instance. It contains information about the 'position' of the Song in the Playlist, for the specific 'week' of the 'year'. It also contains an URL of a 'photo' for the playlist entry."@en;
                  rdfs:label "Playlist Entry"@en;
                  rdfs:subClassOf [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> plo:playlistEntrySong ; 
                                   <http://www.w3.org/2002/07/owl#onClass> plo:Song ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> 1 ],
                                  [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> plo:partOfPlaylist ; 
                                   <http://www.w3.org/2002/07/owl#onClass> plo:Playlist ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> 1 ],
                                  [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> plo:playlistEntrySong ; 
                                   <http://www.w3.org/2002/07/owl#onClass> plo:Song ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> 1 ],
                                  [a <http://www.w3.org/2002/07/owl#Restriction> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> plo:partOfPlaylist ; 
                                   <http://www.w3.org/2002/07/owl#onClass> plo:Playlist ; 
                                   <http://www.w3.org/2002/07/owl#qualifiedCardinality> 1 ].
plo:Song a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A class for representing a song. One Song instance is connected to one or more PlaylistEntry instances. It contains the name of the song and the name of the artist. It can also contain external links to mo:Track and/or mo:MusicArtist instances, for creating Linked Data."@en;
         rdfs:label "Song"@en.
plo:artistInfo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain plo:Song;
               rdfs:range <http://purl.org/ontology/mo/MusicArtist>.
plo:featuredInPlaylistEntry a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:domain plo:Song;
                            rdfs:range plo:PlaylistEntry;
                            <http://www.w3.org/2002/07/owl#inverseOf> plo:playlistEntrySong.
plo:hasPlaylistEntry a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain plo:Playlist;
                     rdfs:range plo:PlaylistEntry;
                     <http://www.w3.org/2002/07/owl#inverseOf> plo:partOfPlaylist.
plo:partOfPlaylist a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain plo:PlaylistEntry;
                   rdfs:range plo:Playlist.
plo:photoURL a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain plo:PlaylistEntry;
             rdfs:range rdfs:Literal.
plo:playlistEntrySong a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain plo:PlaylistEntry;
                      rdfs:range plo:Song.
plo:playlistName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain plo:Playlist;
                 rdfs:range rdfs:Literal.
plo:position a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain plo:PlaylistEntry;
             rdfs:range xsd:nonNegativeInteger.
plo:songInfo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain plo:Song;
             rdfs:range <http://purl.org/ontology/mo/Track>.
plo:stationName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain plo:Playlist;
                rdfs:range rdfs:Literal.
plo:week a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain plo:PlaylistEntry;
         rdfs:range xsd:nonNegativeInteger.
plo:year a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain plo:PlaylistEntry;
         rdfs:range xsd:nonNegativeInteger.
<http://purl.org/ontology/mo/MusicArtist> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/ontology/mo/Track> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/name> a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain plo:Song;
                                 rdfs:range rdfs:Literal.
