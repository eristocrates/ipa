<http://purl.org/dc/terms/contributor> <http://purl.org/dc/terms/description> "Examples of a Contributor include a person, an organization, or a service."@en-us;
                                       <http://purl.org/dc/terms/issued> "2013-12-03"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2013-12-03"^^xsd:date;
