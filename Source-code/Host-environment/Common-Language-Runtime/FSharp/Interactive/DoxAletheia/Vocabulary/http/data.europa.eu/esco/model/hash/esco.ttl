                                   a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                   rdfs:comment "Date of creation of the resource."@en;
                                   rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                   rdfs:label "Date Created"@en;
                                   rdfs:range xsd:dateTime.
<http://purl.org/dc/terms/creator> <http://purl.org/dc/terms/description> "Examples of a Creator include a person, an organization, or a service."@en-us;
                                   <http://purl.org/dc/terms/issued> "2013-12-03"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2013-12-03"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                   rdfs:comment "An entity primarily responsible for making the resource."@en-us;
