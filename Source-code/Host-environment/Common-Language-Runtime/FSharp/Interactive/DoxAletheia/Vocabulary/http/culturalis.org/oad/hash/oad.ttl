@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix oad: <http://lod.xdams.org/reload/oad/>.
@prefix san-lod: <http://dati.san.beniculturali.it/SAN/>.
@prefix loc: <http://id.loc.gov/>.
@prefix language: <http://id.loc.gov/vocabulary/iso639-1/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix geonames: <http://www.geonames.org/ontology#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://culturalis.org/cult/0.1/#Catalogue> a owl:Class.
<http://culturalis.org/eac-cpf#Entity> a owl:Class.
<http://culturalis.org/eac-cpf#Instance> a owl:Class.
<http://culturalis.org/oad#> ccrel:license <http://creativecommons.org/licenses/by/4.0/>;
                             dc11:creator "Istituto per i beni artistici culturali e naturali della Regione Emilia-Romagna",
                                          "Regesta.exe";
                             dc11:date "20180802";
                             dc11:description "An ontology for the description of archival data (OAD, “Ontology of Archival Description”) using the Web Ontology Language (OWL). This ontology represents the classes and properties needed to expose the archival resources as linked data.";
                             dc11:title "Ontology for archival description";
                             vann:preferredNamespacePrefix "oad";
                             vann:preferredNamespaceUri "http://culturalis.org/oad/";
                             a owl:Ontology,
                               voaf:Vocabulary,
                               owl:NamedIndividual;
                             rdfs:comment "Con questo aggiornamento è stata pubblicata l'estensione di OAD relativa all'integrazione con l'Archival Resource. Hanno preso parte alla elaborazione di questo aggiornamento IBC e regesta.exe"@it;
                             rdfs:label "Ontology for archival description";
                             owl:priorVersion <http://lod.xdams.org/reload/oad1.2>;
                             owl:versionInfo 1.3.
<http://culturalis.org/oad#AdministrativeBiographicalHistory> a owl:Class;
                                                              rdfs:comment "The class represents the administrative and biographical history."@en,
                                                                           "La classe rappresenta le informazioni relative alla storia istituzionale, amministrativa o biografica"@it;
                                                              rdfs:label "Administrative / Biographical history"@en,
                                                                         "Storia istituzionale/ amministrativa o biografia"@it;
                                                              owl:backwardCompatibleWith oad:administrativeBiographicalHistory.
<http://culturalis.org/oad#ArchivalResource> a owl:Class;
                                             rdfs:comment "oad:ArchivalResource is the class that represents the object of the description (i.e., a single document or a set of document)."@en,
                                                          "La classe Archival resource indica un corpus documentale oggetto di descrizione"@it;
                                             rdfs:label "Archival resource"@en,
                                                        "Risorsa archivistica"@it;
                                             owl:equivalentClass san-lod:complessoArchivistico;
                                             owl:versionInfo "Questa classe è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#Custody> a owl:Class.
<http://culturalis.org/oad#EadElement> a owl:Class;
                                       rdfs:comment "La classe è utilizzata per mappare le classi e le proprietà dell'ontologia OAD con gli elementi dello schema EAD"@it;
                                       rdfs:label "EAD Schema's element or attribute"@en,
                                                  "Elemento o attributo dello Schema EAD"@it;
                                       owl:backwardCompatibleWith oad:eadElement;
                                       owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#ExtentAndMedium> a owl:Class;
                                            rdfs:comment "The class represents the description about extent and medium."@en,
                                                         "La classe Extent and medium rappresenta la descrizione dell'estensione e del supporto"@it;
                                            rdfs:label "Extent and medium"@en,
                                                       "Consistenza e supporto"@it;
                                            owl:versionInfo "Questa classe è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#FindingAid> a owl:Class;
                                       rdfs:comment "The class represents a finding aid."@en,
                                                    "La classe rappresenta lo strumento di ricerca"@it;
                                       rdfs:label "Finding aid"@en,
                                                  "Strumento di ricerca"@it;
                                       rdfs:subClassOf <http://culturalis.org/cult/0.1/#Catalogue>;
                                       owl:backwardCompatibleWith oad:findingAid;
                                       owl:equivalentClass san-lod:strumento.
<http://culturalis.org/oad#Instance> a owl:Class;
                                     rdfs:comment "The class represents the descriptive entry of an archival resource"@en,
                                                  "La classe Archival instance rappresenta l'istanziazione dell'archival resource"@it;
                                     rdfs:label "Archival instance"@en,
                                                "Instanza archivistica"@it;
                                     owl:versionInfo "Questa classe è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#LevelOfDescription> a owl:Class;
                                               rdfs:comment "The class represents the archival description level"@en,
                                                            "La classe rappresenta il livello della descrizione archivistica"@it;
                                               rdfs:label "Level of description"@en,
                                                          "Livello di descrizione"@it;
                                               owl:backwardCompatibleWith oad:levelOfDescription.
<http://culturalis.org/oad#Place> a owl:Class;
                                  rdfs:comment "The class represents a physical place"@en,
                                               "La classe rappresenta un luogo"@it;
                                  rdfs:label "Place"@en,
                                             "Luogo"@it;
                                  rdfs:subClassOf geonames:Feature;
                                  owl:backwardCompatibleWith oad:place.
<http://culturalis.org/oad#Production> a owl:Class.
<http://culturalis.org/oad#PublicationNote> a owl:Class;
                                            rdfs:comment "The class represents a bibliography"@en,
                                                         "La classe rappresenta la bibliografia"@it;
                                            rdfs:label "Publication note"@en,
                                                       "Bibliografia"@it;
                                            owl:backwardCompatibleWith oad:publicationNote.
<http://culturalis.org/oad#UoD> a owl:Class;
                                rdfs:comment "La classe uod rappresenta la descrizione della risorsa archivistica"@it;
                                rdfs:label "Unit of description"@en,
                                           "Unità of descrizione"@it;
                                owl:backwardCompatibleWith oad:uod;
                                owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#accruals> a owl:DatatypeProperty;
                                     rdfs:comment "The property represents expected increase."@en,
                                                  "La proprietà rappresenta le informazioni relative agli incrementi previsti."@it;
                                     rdfs:domain <http://culturalis.org/oad#Instance>;
                                     rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.3.3_accruals>;
                                     rdfs:label "Accruals"@en,
                                                "Incrementi previsti"@it;
                                     rdfs:range xsd:string;
                                     owl:backwardCompatibleWith oad:accruals.
<http://culturalis.org/oad#appraisalDestructionAndSchedulingInformation> a owl:DatatypeProperty;
                                                                         rdfs:comment "The property represents appraisal, destruction and scheduling information"@en,
                                                                                      "La proprietà rappresenta le informazioni relative alle procedure, ai tempi e ai criteri di valutazione e scarto della risorsa archivistica descritta"@it;
                                                                         rdfs:domain <http://culturalis.org/oad#Instance>;
                                                                         rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.3.2_appraisal_destruction_and_scheduling_information>;
                                                                         rdfs:label "Appraisal, destruction and scheduling information"@en,
                                                                                    "Procedure, tempi e criteri di valutazione e scarto"@it;
                                                                         rdfs:range xsd:string;
                                                                         owl:backwardCompatibleWith oad:appraisalDestructionAndSchedulingInformation.
<http://culturalis.org/oad#archivalHistory> a owl:DatatypeProperty;
                                            rdfs:comment "The property represents information about the history of the instance"@en,
                                                         "La proprietà rappresenta le informazioni relative alla storia archivistica della risorsa archivistica descritta"@it;
                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.2.3_archival_history>;
                                            rdfs:label "Archival history"@en,
                                                       "Storia archivistica"@it;
                                            rdfs:range xsd:string;
                                            owl:backwardCompatibleWith oad:archivalHistory.
<http://culturalis.org/oad#archivistsNote> a owl:DatatypeProperty;
                                           rdfs:comment "La proprietà rappresenta le informazioni relative alle note dell'archivista della risorsa archivistica descritta"@it;
                                           rdfs:domain <http://culturalis.org/oad#Instance>;
                                           rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.7.1_archivist_s_note>;
                                           rdfs:label "Archivist's Note"@en,
                                                      "Nota dell'archivista"@it;
                                           rdfs:range xsd:string;
                                           owl:backwardCompatibleWith oad:archivistsNote;
                                           owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#conditionsGoverningAccess> a owl:DatatypeProperty;
                                                      rdfs:comment "The property represents condition governing access of the instance"@en,
                                                                   "La proprietà rappresenta le informazioni relative alle condizioni che regolano l'accesso della risorsa archivistica descritta"@it;
                                                      rdfs:domain <http://culturalis.org/oad#Instance>;
                                                      rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.4.1_conditions_governing_access>;
                                                      rdfs:label "Conditions governing access"@en,
                                                                 "Condizioni che regolano l’accesso"@it;
                                                      rdfs:range xsd:string;
                                                      owl:backwardCompatibleWith oad:conditionsGoverningAccess.
<http://culturalis.org/oad#conditionsGoverningReproduction> a owl:DatatypeProperty;
                                                            rdfs:comment "The property represents condition governing reproduction of the instance"@en,
                                                                         "La proprietà rappresenta le informazioni relative alle condizioni che regolano la riproduzione della risorsa archivistica descritta"@it;
                                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.4.2_conditions_governing_reproduction>;
                                                            rdfs:label "Conditions governing reproduction"@en,
                                                                       "Condizioni che regolano la riproduzione"@it;
                                                            rdfs:range xsd:string;
                                                            owl:backwardCompatibleWith oad:conditionsGoverningReproduction.
<http://culturalis.org/oad#contains> a owl:ObjectProperty;
                                     rdfs:comment "Inverse property of oad:isContainedIn"@en,
                                                  "Proprietà inversa di 'isContainedIn'."@it;
                                     rdfs:domain <http://culturalis.org/oad#FindingAid>;
                                     rdfs:label "Contains"@en,
                                                "Contiene"@it;
                                     rdfs:range [owl:unionOf (<http://culturalis.org/eac-cpf#Instance>
                                                              <http://culturalis.org/oad#Instance>) ; 
                                                 a owl:Class];
                                     owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#custody> dc11:description "Le classi production e custody sono state inserite per descrivere il rapporto tra una risorsa archivistica e una entità (CPF), volendo esplicitare anche le date di relazione verso un soggetto produttore o un conservatore, gestendo in questo modo ad esempio anche i cambi di custodia"@it;
                                    a owl:Class;
                                    rdfs:label "Custody"@en,
                                               "Conservazione"@it;
                                    owl:backwardCompatibleWith oad:custody;
                                    owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#date> a owl:DatatypeProperty;
                                 rdfs:comment "The property represents a date"@en,
                                              "La proprietà rappresenta le informazioni relative alla datazione della risorsa archivistica descritta"@it;
                                 rdfs:domain <http://culturalis.org/oad#Instance>;
                                 rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.1.3_dates>;
                                 rdfs:label "Date(s)"@en,
                                            "Data/e"@it;
                                 rdfs:range xsd:string;
                                 owl:backwardCompatibleWith oad:date.
<http://culturalis.org/oad#describes> a owl:FunctionalProperty,
                                        owl:ObjectProperty;
                                      rdfs:comment "La proprietà collega uno strumento di ricerca alla risorsa archivistica descritta"@it,
                                                   "This functional property links a finding aid to the archival resource described"@en;
                                      rdfs:domain <http://culturalis.org/oad#FindingAid>;
                                      rdfs:label "Descrive"@it,
                                                 "Describes"@en;
                                      rdfs:range <http://culturalis.org/oad#ArchivalResource>;
                                      owl:inverseOf <http://culturalis.org/oad#isDescribedBy>;
                                      owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#existenceAndLocationOfCopies> a owl:DatatypeProperty;
                                                         rdfs:comment "The property represents the existence and location of copies"@en,
                                                                      "La proprietà rappresenta le informazioni relative all'esistenza e alla localizzazione di copie della risorsa archivistica descritta"@it;
                                                         rdfs:domain <http://culturalis.org/oad#Instance>;
                                                         rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.5.2_existence_and_location_of_copies>;
                                                         rdfs:label "Existence and location of copies"@en,
                                                                    "Esistenza e localizzazione di copie"@it;
                                                         rdfs:range xsd:string;
                                                         owl:backwardCompatibleWith oad:existenceAndLocationOfCopies.
<http://culturalis.org/oad#existenceAndLocationOfOriginals> a owl:DatatypeProperty;
                                                            rdfs:comment "The property represents the existence and location of originals"@en,
                                                                         "La proprietà rappresenta le informazioni relative all'esistenza e alla localizzazione degli originali della risorsa archivistica descritta"@it;
                                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.5.1_existence_and_location_of_originals>;
                                                            rdfs:label "Existence and location of originals"@en,
                                                                       "Esistenza e localizzazione degli originali"@it;
                                                            rdfs:range xsd:string;
                                                            owl:backwardCompatibleWith oad:existenceAndLocationOfOriginals.
<http://culturalis.org/oad#extentAndMedium> dc11:description "Le informazioni sottoforma di stringa di testo sulla consistenza vengono descritte attraverso la proprietà dc:format";
                                            a owl:DatatypeProperty;
                                            rdfs:comment "La proprietà rappresenta le informazioni relative alla consistenza e al supporto della risorsa archivistica descritta"@it;
                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.1.5_extent_and_medium_of_the_unit_of_description>;
                                            rdfs:label "Extent and medium of the unit of description (quantity, bulk, or size)"@en,
                                                       "Consistenza e supporto dell'unità di descrizione"@it;
                                            rdfs:range xsd:string;
                                            owl:backwardCompatibleWith oad:extentAndMedium;
                                            owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasAccessPoint> a owl:ObjectProperty;
                                           rdfs:comment "The property represents an access point"@en,
                                                        "La proprietà rappresenta le informazioni relative alle chiavi di accesso"@it;
                                           rdfs:domain [owl:unionOf (<http://culturalis.org/eac-cpf#Entity>
                                                                     <http://culturalis.org/oad#Instance>) ; 
                                                        a owl:Class];
                                           rdfs:label "Has key access point"@en,
                                                      "Ha chiave di indice"@it;
                                           rdfs:range [owl:unionOf (<http://culturalis.org/eac-cpf#Entity>
                                                                    <http://culturalis.org/oad#Place>
                                                                    skos:Concept
                                                                    foaf:Organization
                                                                    foaf:Person) ; 
                                                       a owl:Class];
                                           owl:backwardCompatibleWith oad:has_accessPoint.
<http://culturalis.org/oad#hasAccessPointCorporateBody> a owl:ObjectProperty;
                                                        rdfs:subPropertyOf <http://culturalis.org/oad#hasAccessPoint>;
                                                        owl:backwardCompatibleWith oad:has_accessPointCorporateBody;
                                                        owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasAccessPointFamily> a owl:ObjectProperty;
                                                 rdfs:subPropertyOf <http://culturalis.org/oad#hasAccessPoint>;
                                                 owl:backwardCompatibleWith oad:has_accessPointFamily;
                                                 owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasAccessPointPerson> a owl:ObjectProperty;
                                                 rdfs:subPropertyOf <http://culturalis.org/oad#hasAccessPoint>;
                                                 owl:backwardCompatibleWith oad:has_accessPointPerson;
                                                 owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasAccessPointPlace> a owl:ObjectProperty;
                                                rdfs:subPropertyOf <http://culturalis.org/oad#hasAccessPoint>;
                                                owl:backwardCompatibleWith oad:has_accessPointPlace;
                                                owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasAdministrativeBiographicalHistory> a owl:ObjectProperty;
                                                                 rdfs:comment "The property links and instace to information about administrative and biographica history."@en,
                                                                              "La proprietà collega una scheda descrittiva alle informazioni relative alla storia amministrativa o biografica"@it;
                                                                 rdfs:domain <http://culturalis.org/oad#Instance>;
                                                                 rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.2.2_administrative_biographical_history>;
                                                                 rdfs:label "Has administrative / biographical history"@en,
                                                                            "Ha storia amministrativa / biografica"@it;
                                                                 rdfs:range <http://culturalis.org/oad#AdministrativeBiographicalHistory>;
                                                                 owl:backwardCompatibleWith oad:has_administrativeBiographicalHistory.
<http://culturalis.org/oad#hasCustody> a owl:ObjectProperty;
                                       rdfs:domain <http://culturalis.org/oad#Instance>;
                                       rdfs:label "Has Custody"@en,
                                                  "Conservato da"@it;
                                       rdfs:range <http://culturalis.org/oad#Custody>;
                                       owl:backwardCompatibleWith oad:has_custody;
                                       owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasEntity> a owl:ObjectProperty;
                                      rdfs:domain [owl:unionOf (<http://culturalis.org/oad#Custody>
                                                                <http://culturalis.org/oad#Production>) ; 
                                                   a owl:Class];
                                      rdfs:label "Has Entity"@en,
                                                 "Entità collegata"@it;
                                      rdfs:range <http://culturalis.org/eac-cpf#Entity>;
                                      owl:backwardCompatibleWith oad:has_entity;
                                      owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasEntry> a owl:ObjectProperty;
                                     rdfs:comment "Proprietà inversa di 'isEntryOf'."@it;
                                     rdfs:domain <http://culturalis.org/oad#ArchivalResource>;
                                     rdfs:label "Has entry"@en,
                                                "Ha scheda descrittiva"@it;
                                     rdfs:range <http://culturalis.org/oad#Instance>;
                                     owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#hasExtentAndMedium> a owl:ObjectProperty;
                                               rdfs:comment "The property links an instance to information about extent and medium"@en,
                                                            "La proprietà collega l'istanziazione di una risorsa archivistica alle informazioni relative all'estensione e al supporto"@it;
                                               rdfs:domain <http://culturalis.org/oad#Instance>;
                                               rdfs:label "Has extent and medium"@en,
                                                          "Ha estensione e supporto"@it;
                                               rdfs:range <http://culturalis.org/oad#ExtentAndMedium>;
                                               owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#hasExtentType> a owl:ObjectProperty;
                                          rdfs:comment "The property represents an extent type and it is related to a skos vocabulary"@en,
                                                       "La proprietà rappresenta le informazioni relative alla tipologia di estensione e punta ad un vocabolario skos"@it;
                                          rdfs:domain <http://culturalis.org/oad#ExtentAndMedium>;
                                          rdfs:label "Has extent type"@en,
                                                     "Ha tipo di estensione"@it;
                                          rdfs:range skos:Concept;
                                          owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#hasFilePlan> a owl:ObjectProperty;
                                        rdfs:comment "The property links an instance to a classification system"@en,
                                                     "La proprietà collega una archival instance ad un sistema di classificazione"@it;
                                        rdfs:domain <http://culturalis.org/oad#Instance>;
                                        rdfs:label "File Plan"@en,
                                                   "Sistema di classificazione"@it;
                                        rdfs:range skos:Concept;
                                        owl:backwardCompatibleWith oad:has_filePlan.
<http://culturalis.org/oad#hasFindingAid> a owl:ObjectProperty;
                                          rdfs:comment "La proprietà collega una archival instance allo strumento di ricerca che la contiene"@it;
                                          rdfs:domain <http://culturalis.org/oad#Instance>;
                                          rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.4.5_finding_aids>;
                                          rdfs:label "Has finding aid"@en,
                                                     "Ha strumento di ricerca"@it;
                                          rdfs:range <http://culturalis.org/oad#FindingAid>;
                                          owl:backwardCompatibleWith oad:has_findingAid;
                                          owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasLanguageScriptsOfMaterial> a owl:ObjectProperty;
                                                         rdfs:comment "The property links an instance to its language information"@en,
                                                                      "La proprietà collega una archival instance alle informazioni relative alla lingua"@it;
                                                         rdfs:domain <http://culturalis.org/oad#Instance>;
                                                         rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.4.3_language_scripts_of_material>;
                                                         rdfs:label "Has language/scripts of material"@en,
                                                                    "Ha lingua/scrittura della documentazione"@it;
                                                         rdfs:range language:iso639-1_Language;
                                                         owl:backwardCompatibleWith oad:has_languageScriptsOfMaterial.
<http://culturalis.org/oad#hasLevel> a owl:ObjectProperty;
                                     rdfs:comment "The property links an archival resource to its level of description"@en,
                                                  "La proprietà collega una unità di descrizione al livello di descrizione archivistica"@it;
                                     rdfs:domain <http://culturalis.org/oad#Instance>;
                                     rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.1.4_level_of_description>;
                                     rdfs:label "Has level of description"@en,
                                                "Ha livello di descrizione"@it;
                                     rdfs:range <http://culturalis.org/oad#LevelOfDescription>;
                                     owl:backwardCompatibleWith oad:has_level.
<http://culturalis.org/oad#hasNameOfCreator> a owl:ObjectProperty;
                                             rdfs:domain <http://culturalis.org/oad#Instance>;
                                             rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.2.1_name_of_creators>;
                                             rdfs:label "Name of creator(s)"@en,
                                                        "Nome del soggetto produttore"@it;
                                             rdfs:range <http://culturalis.org/eac-cpf#Entity>;
                                             owl:backwardCompatibleWith oad:has_nameOfCreator;
                                             owl:deprecated true.
<http://culturalis.org/oad#hasNextInSequence> a owl:ObjectProperty;
                                              rdfs:comment "The property links an instance to the following sibling"@en,
                                                           "La proprietà collega l'istanziazione di una risorsa archivistica alla sua successiva gerarchicamente"@it;
                                              rdfs:domain <http://culturalis.org/oad#Instance>;
                                              rdfs:label "Has next in sequence"@en,
                                                         "Ha successivo"@it;
                                              rdfs:range <http://culturalis.org/oad#Instance>;
                                              owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#hasProduction> a owl:ObjectProperty;
                                          rdfs:domain <http://culturalis.org/oad#Instance>;
                                          rdfs:label "Has Production"@en,
                                                     "Prodotto da"@it;
                                          rdfs:range <http://culturalis.org/oad#Production>;
                                          owl:backwardCompatibleWith oad:has_production;
                                          owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#hasPublicationNote> a owl:ObjectProperty;
                                               rdfs:comment "The property links an instance to its bibliography information"@en,
                                                            "La proprietà collega una scheda descrittiva alle informazioni relative alla pubblicazione"@it;
                                               rdfs:domain <http://culturalis.org/oad#Instance>;
                                               rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.5.4_publication_note>;
                                               rdfs:label "Has publication note"@en,
                                                          "Ha bibliografia"@it;
                                               rdfs:range <http://culturalis.org/oad#PublicationNote>;
                                               owl:backwardCompatibleWith oad:has_publicationNote.
<http://culturalis.org/oad#hasRelatedInstance> a owl:ObjectProperty;
                                               rdfs:comment "The property links two or more instances related"@en,
                                                            "La proprietà collega tra loro due o più istanze archivistiche"@it;
                                               rdfs:domain <http://culturalis.org/oad#Instance>;
                                               rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.5.3_related_units_of_description>;
                                               rdfs:label "Has related instance"@en,
                                                          "Ha scheda descrittiva collegata"@it;
                                               rdfs:range <http://culturalis.org/oad#Instance>;
                                               owl:backwardCompatibleWith oad:has_relatedUnitsOfDescription.
<http://culturalis.org/oad#hasRepository> a owl:ObjectProperty;
                                          rdfs:domain <http://culturalis.org/oad#Instance>;
                                          rdfs:label "Has repository"@en,
                                                     "Soggetto conservatore"@it;
                                          rdfs:range <http://culturalis.org/eac-cpf#Entity>;
                                          owl:backwardCompatibleWith oad:has_repository;
                                          owl:deprecated true.
<http://culturalis.org/oad#immediateSourceOfAcquisitionOrTransfer> a owl:DatatypeProperty;
                                                                   rdfs:comment "The property represents an immediate source of acquisition or transfer"@en,
                                                                                "La proprietà rappresenta le informazioni relative alla modalità di acquisizione o versamento della risorsa archivistica descritta"@it;
                                                                   rdfs:domain <http://culturalis.org/oad#Instance>;
                                                                   rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.2.4_immediate_source_of_acquisition_or_transfer>;
                                                                   rdfs:label "Immediate source of acquisition or transfer"@en,
                                                                              "Modalità di acquisizione o versamento"@it;
                                                                   rdfs:range xsd:string;
                                                                   owl:backwardCompatibleWith oad:immediateSourceOfAcquisitionOrTransfer.
<http://culturalis.org/oad#isContainedIn> a owl:ObjectProperty;
                                          rdfs:comment "The property represents the relationship between an instance and the finding aid in which it is contained"@en,
                                                       "La proprietà descrive la relazione tra l'istanziazione di una risorsa archivistica o di un'entity e lo strumento di ricerca in cui è contenuta"@it;
                                          rdfs:domain [owl:unionOf (<http://culturalis.org/eac-cpf#Instance>
                                                                    <http://culturalis.org/oad#Instance>) ; 
                                                       a owl:Class];
                                          rdfs:label "Is contained in"@en,
                                                     "È contenuta in"@it;
                                          rdfs:range <http://culturalis.org/oad#FindingAid>;
                                          owl:inverseOf <http://culturalis.org/oad#contains>;
                                          owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#isDescribedBy> a owl:ObjectProperty;
                                          rdfs:comment "Inverse property of oad:describes"@en,
                                                       "Proprietà inversa di 'describes'."@it;
                                          rdfs:domain <http://culturalis.org/oad#ArchivalResource>;
                                          rdfs:label "Is described by"@en,
                                                     "Descritta da"@it;
                                          rdfs:range <http://culturalis.org/oad#FindingAid>;
                                          owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#isEntryOf> a owl:ObjectProperty;
                                      rdfs:comment "The property links an instance to an archival resource"@en,
                                                   "La proprietà mette in relazione l'istanziazione di una risorsa archivistica alla risorsa archivistica oggetto della descrizione"@it;
                                      rdfs:domain <http://culturalis.org/oad#Instance>;
                                      rdfs:label "Is entry of"@en,
                                                 "È scheda descrittiva di"@it;
                                      rdfs:range <http://culturalis.org/oad#ArchivalResource>;
                                      owl:inverseOf <http://culturalis.org/oad#hasEntry>;
                                      owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#isProducedBy> a owl:ObjectProperty;
                                         rdfs:comment "The property links the archival resource described to the entity responsible for the production of the resource"@en,
                                                      "La proprietà collega la risorsa archivistica descritta alla entity responsabile della sua produzione"@it;
                                         rdfs:domain <http://culturalis.org/oad#ArchivalResource>;
                                         rdfs:label "Is produced by"@en,
                                                    "È prodotta da"@it;
                                         rdfs:range <http://culturalis.org/eac-cpf#Entity>;
                                         owl:versionInfo "Questa proprietà è stata aggiunta nella versione del 2 agosto 2018".
<http://culturalis.org/oad#note> a owl:DatatypeProperty;
                                 rdfs:comment "The property represents information that cannot be accommodated in any of the other properties."@en,
                                              "La proprietà rappresenta le informazioni relative alle note della risorsa archivistica descritta"@it;
                                 rdfs:domain <http://culturalis.org/oad#Instance>;
                                 rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.6.1_note>;
                                 rdfs:label "Note"@en,
                                            "Note"@it;
                                 rdfs:range xsd:string;
                                 owl:backwardCompatibleWith oad:note.
<http://culturalis.org/oad#otherlevel> a owl:DatatypeProperty;
                                       rdfs:comment "The property represents an otherlevel of description"@en,
                                                    "La proprietà rappresenta le informazioni relative ad un altro livello di descrizione della risorsa archivistica descritta"@it;
                                       rdfs:domain <http://culturalis.org/oad#Instance>;
                                       rdfs:label "Other Level of description"@en,
                                                  "Altro livello di descrizione"@it;
                                       rdfs:range xsd:string;
                                       owl:backwardCompatibleWith oad:otherlevel.
<http://culturalis.org/oad#physicalCharacteristicsAndTechnicalRequirements> a owl:DatatypeProperty;
                                                                            rdfs:comment "The property represents physical characteristics and technical requirements"@en,
                                                                                         "La proprietà rappresenta le informazioni relative alle caratteristiche materiali e ai requisiti tecnici della risorsa archivistica descritta"@it;
                                                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.4.4_physical_characteristics_and_technical_requirements>;
                                                                            rdfs:label "Physical characteristics and technical requirements"@en,
                                                                                       "Caratteristiche materiali e requisiti tecnici"@it;
                                                                            rdfs:range xsd:string;
                                                                            owl:backwardCompatibleWith oad:physicalCharacteristicsAndTechnicalRequirements.
<http://culturalis.org/oad#production> dc11:description "Le classi production e custody sono state inserite per descrivere il rapporto tra una risorsa archivistica e una entità (CPF), volendo esplicitare anche le date di relazione verso un soggetto produttore o un conservatore, gestendo in questo modo ad esempio anche i cambi di custodia"@it;
                                       a owl:Class;
                                       rdfs:label "Production"@en,
                                                  "Produzione"@it;
                                       owl:backwardCompatibleWith oad:production;
                                       owl:deprecated "true"^^xsd:booelan.
<http://culturalis.org/oad#referenceCode> a owl:DatatypeProperty;
                                          rdfs:comment "The property represents an identification code of the described resource"@en,
                                                       "La proprietà rappresenta le informazioni relative al codice identificativo riportato in una scheda descrittiva"@it;
                                          rdfs:domain <http://culturalis.org/oad#Instance>;
                                          rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.1.1_reference_codes>;
                                          rdfs:label "Reference code"@en,
                                                     "Segnatura o codice identificativo"@it;
                                          rdfs:range xsd:string;
                                          owl:backwardCompatibleWith oad:referenceCode.
<http://culturalis.org/oad#scopeAndContent> a owl:DatatypeProperty;
                                            rdfs:comment "The property represents the scope and the content of the described resource"@en,
                                                         "La proprietà rappresenta le informazioni relative ad ambiti e contenuto della risorsa archivistica descritta"@it;
                                            rdfs:domain <http://culturalis.org/oad#Instance>;
                                            rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.3.1_scope_and_content>;
                                            rdfs:label "Scope and content"@en,
                                                       "Ambiti e contenuto"@it;
                                            rdfs:range xsd:string;
                                            owl:backwardCompatibleWith oad:scopeAndContent.
<http://culturalis.org/oad#systemOfArrangement> a owl:DatatypeProperty;
                                                rdfs:comment "The property represents the internal structure, the order and/or the system of classification of the described resource"@en,
                                                             "La proprietà rappresenta le informazioni relative ai criteri di ordinamento della risorsa archivistica descritta"@it;
                                                rdfs:domain <http://culturalis.org/oad#Instance>;
                                                rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.3.4_system_of_arrangement>;
                                                rdfs:label "System of arrangement"@en,
                                                           "Criteri di ordinamento"@it;
                                                rdfs:range xsd:string;
                                                owl:backwardCompatibleWith oad:systemOfArrangement.
<http://culturalis.org/oad#title> a owl:DatatypeProperty;
                                  rdfs:comment "The property represents the name shown in a description"@en,
                                               "La proprietà rappresenta le informazioni relative alla denominazione riportata in una scheda descrittiva"@it;
                                  rdfs:domain <http://culturalis.org/oad#Instance>;
                                  rdfs:isDefinedBy <http://lod.xdams.org/reload/oad/isadOntology/isad_3.1.2_title>;
                                  rdfs:label "Title"@en,
                                             "Denominazione o titolo"@it;
                                  rdfs:range xsd:string;
                                  owl:backwardCompatibleWith oad:title.
<http://culturalis.org/oad#useEadElement> a owl:ObjectProperty;
                                          rdfs:comment "La proprietà collega una organizzazione all'elemento dello schema EAD utilizzato"@it;
                                          rdfs:domain foaf:Organization;
                                          rdfs:label "Use EAD element or attribute"@en,
                                                     "Utilizza l'elemento o attributo di EAD"@it;
                                          rdfs:range <http://culturalis.org/oad#EadElement>;
                                          owl:backwardCompatibleWith oad:use_eadElement;
                                          owl:deprecated "true"^^xsd:booelan.
