@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dnbt: <http://d-nb.info/standards/elementset/dnb#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dnb: <http://d-nb.info/gnd/>.
@prefix open: <http://open.vocab.org/terms/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dnbt: ccrel:license <http://creativecommons.org/publicdomain/zero/1.0/>;
      dc11:description """Das DNB RDF-Vokabular (dnbt:) ist eine Sammlung
		von Klassen, Properties und Datentypen, die im Rahmen des LinkedData-Dienstes
		der DNB verwendung finden. Es ist ein Komplement zur GND-Ontologie (gndo:), die 
		besonders für die Representation der Daten aus der Gemeinsamen Normdatei (GND)
		konstruiert wurde. Das DNB-Vokabular dagegen hat einen allgemeineren Scope.
		"""@de,
                       """The DNB RDF Vocabulary (dnbt:) is a collection of
		classes, properties and datatypes used within the DNB's linked data service.
		It complements the GND Ontology (gndo:) which is specifically geared towards
		authority data from the Integrated Authority File (GND), whereas this vocabulary
		is more general-purpose.
		"""@en;
      dc11:title "DNB Metadata Terms"@en,
                 "DNB Metadata Terms"@de;
      dcterms:available "2019-02-12"^^xsd:date;
      dcterms:creator dnbt:larsGSvensson;
      dcterms:issued "2016-05-12"^^xsd:date;
      dcterms:modified "2018-11-05T11:08:00+01:00"^^xsd:dateTime;
      dcterms:publisher <http://ld.zdb-services.de/resource/organisations/DE-101>;
      dcterms:rights "Copyright 2015-2018 Deutsche Nationalbibliothek";
      vann:preferredNamespacePrefix "dnbt";
      vann:preferredNamespaceUri "http://d-nb.info/standards/elementset/dnb#";
      a voaf:Vocabulary,
        owl:Ontology;
      owl:priorVersion <http://d-nb.info/standards/elementset/dnb_2018-10-16>;
      owl:versionIRI <http://d-nb.info/standards/elementset/dnb_20190212>;
      owl:versionInfo "1.3".
dnbt:AutomatedActivity a owl:Class,
                         rdfs:Class;
                       rdfs:comment """An automated activity is an activity performed by a machine with little or no human supervision.
        It can be implied that the agent an automated activity is attributed to is a software agent as in
		<#anAutomatedActivity> a dnbt:AutomatedActivity ;
			prov:wasAttributedTo :anAgent .
		:anAgent a prov:SoftwareAgent ."""@en,
                                    """Eine automatisierte Aktivität ist eine Aktivität, die von einer Maschine durchgeführt wird und nur wenig oder
            überhaupt nicht von Menschen überwacht wird. Es kann angenommen werden, dass der Agent, dem eine automatisierte
            Aktivität zugeordnet wird, ein Softwareagent ist, wie in
		<#anAutomatedActivity> a dnbt:AutomatedActivity ;
			prov:wasAttributedTo :anAgent .
		:anAgent a prov:SoftwareAgent ."""@de;
                       rdfs:isDefinedBy dnbt:;
                       rdfs:label "Automated activity"@en,
                                  "Automatisierte Aktivität"@de;
                       rdfs:subClassOf [owl:someValuesFrom nsprov:SoftwareAgent ; 
                                        owl:onProperty nsprov:wasAttributedTo ; 
                                        a owl:Restriction],
                                       nsprov:Activity.
dnbt:IntellectualActivity a owl:Class,
                            rdfs:Class;
                          rdfs:comment """An intellectual activity is an activity performed by humans with little or no machine support.
        It can be implied that the agent an intellectual activity is attributed to is a person agent as in
		<#anIntellectualActivity> a dnbt:IntellectualActivity ;
			prov:wasAttributedTo :anAgent .
		:anAgent a prov:Person ."""@en,
                                       """Eine intellektuelle Aktivität ist eine Aktivität, die von einem Menschen durchgeführt wird und nur wenig oder
            überhaupt nicht von Maschinen unterstützt wird. Es kann angenommen werden, dass der Agent, dem eine intellektuelle
            Aktivität zugeordnet wird, eine Person ist, wie in
		<#anIntellectualActivity> a dnbt:IntellectualActivity ;
			prov:wasAttributedTo :anAgent .
		:anAgent a prov:Person ."""@de;
                          rdfs:isDefinedBy dnbt:;
                          rdfs:label "Intellectual activity"@en,
                                     "Intellektuelle Aktivität"@de;
                          rdfs:subClassOf [owl:someValuesFrom nsprov:Person ; 
                                           owl:onProperty nsprov:wasAttributedTo ; 
                                           a owl:Restriction],
                                          nsprov:Activity.
dnbt:QualifiedLanguage a owl:Class,
                         rdfs:Class;
                       rdfs:comment """An instance of dnbt:QualifiedLanguage provides additional descriptions about 
		the binary dct:language relation from a publication to the language of that publication.
		For example <#publication> dnbt:hasQualifiedLanguage [
			a dnbt:QualifiedLanguage;
			prov:wasGeneratedBy <#aPieceOfSoftware> ;
			ex:confidenceValue 0.6^^xsd:decimal ;
			dnbt:qualifiesLanguage loc:ger ] ."""@en,
                                    """Eine Instanz von dnbt:QualifiedLanguage stellt zusätzliche Beschreibungen über
		die binäre Beziehung dct:language zwischen einer Publikation und ihrer Sprache bereit.
		Zum Beispiel <#publication> dnbt:hasQualifiedLanguage [
			a dnbt:QualifiedLanguage;
			prov:wasGeneratedBy <#aPieceOfSoftware> ;
			ex:confidenceValue 0.6^^xsd:decimal ;
			dnbt:qualifiesLanguage loc:ger ] ."""@de;
                       rdfs:isDefinedBy dnbt:;
                       rdfs:label "Qualified Language"@en,
                                  "Qualifizierte Sprache"@de;
                       nsprov:unqualifiedForm [rdfs:resource "http://purl.org/dc/terms/language"].
dnbt:QualifiedSubject a owl:Class,
                        rdfs:Class;
                      rdfs:comment """An instance of dnbt:QualifiedSubject provides additional descriptions about 
		the binary dct:subject relation from a publication to the subject(s) of that publication.
		For example <#publication> dnbt:hasQualifiedSubject [
			a dnbt:QualifiedSubject;
			prov:wasGeneratedBy <#aPieceOfSoftware> ;
			ex:confidenceValue 0.6^^xsd:decimal ;
			dnbt:qualifiesSubject gnd:12345-6 ] ."""@en,
                                   """Eine Instanz von dnbt:QualifiedSubject stellt zusätzliche Beschreibungen über
		die binäre Beziehung dct:subject zwischen einer Publikation und ihren Themen bereit.
		Zum Beispiel <#publication> dnbt:hasQualifiedSubject [
			a dnbt:QualifiedSubject;
			prov:wasGeneratedBy <#aPieceOfSoftware> ;
			ex:confidenceValue 0.6^^xsd:decimal ;
			dnbt:qualifiesSubject gnd:12345-6 ] ."""@de;
                      rdfs:isDefinedBy dnbt:;
                      rdfs:label "Qualified subject"@en,
                                 "Qualifiziertes Thema"@de;
                      nsprov:unqualifiedForm [rdfs:resource "http://purl.org/dc/terms/subject"].
dnbt:canonicalUri a owl:DatatypeProperty,
                    rdf:Property;
                  rdfs:comment "The URI that is the primary identifier for a resource and should be used to reference it."@en,
                               "Der URI, der eine Ressource primär identifiziert und zu ihrer Referenzierung verwendet werden sollte."@de;
                  rdfs:isDefinedBy dnbt:;
                  rdfs:label "Canonical URI"@en,
                             "Kanonischer URI"@de;
                  owl:equivalentProperty open:canonicalUri.
dnbt:dateCaptured a owl:DatatypeProperty,
                    rdf:Property;
                  rdfs:comment """The final modification date of the data 
               used to produce the resource. To update the resource, changes
            from this timestamp onwards need to be incorporated."""@en,
                               """Das letzte Änderungsdatum der Datengrundlage
			der Ressource. Um die Ressource zu aktualisieren, müssen Änderungen
            ab diesem Zeitstempel berücksichtigt werden."""@de;
                  rdfs:isDefinedBy dnbt:;
                  rdfs:label "Date captured"@en,
                             "Datum des Datenstandes "@de;
                  rdfs:range xsd:dateTime.
dnbt:ddc-subject-category a rdfs:Datatype;
                          rdfs:comment "Dieser Datentyp kennzeichnet eine Sachgruppe, die auf der Dewey-Dezimalklassifikation (DDC) beruht."@de,
                                       "This datatype denotes a subject category based on the Dewey Decimal Classification (DDC)."@en;
                          rdfs:isDefinedBy dnbt:;
                          rdfs:label "DDC Subject Category"@en,
                                     "DDC-Sachgruppe"@de;
                          rdfs:seeAlso <http://nbn-resolving.de/urn:nbn:de:101-2014050500>,
                                       <http://www.dnb.de/ddcsubjectcategories>,
                                       <http://www.dnb.de/ddcSachgruppen>;
                          owl:onDatatype xsd:string;
                          owl:withRestrictions ([xsd:pattern "[BKS]|[0-9]{3}(\\.[0-9]+)?"]).
dnbt:deprecatedUri a owl:DatatypeProperty,
                     rdf:Property;
                   rdfs:comment "A URI that is no longer recommended for referencing a resource."@en,
                                "Ein URI, der nicht mehr für die Referenzierung einer Ressource empfohlen wird."@de;
                   rdfs:isDefinedBy dnbt:;
                   rdfs:label "Deprecated URI"@en,
                              "Abgelöster URI"@de.
dnbt:hasQualifiedLanguage a owl:ObjectProperty,
                            rdf:Property;
                          rdfs:comment "Connects a publication with an instance of dnbt:QualifiedLanguage."@en,
                                       "Verbindet eine Publikation mit einer Instanz von dnbt:QualifiedLanguage."@de;
                          rdfs:isDefinedBy dnbt:;
                          rdfs:label "Has qualified language"@en,
                                     "Hat qualifizierte Sprache"@de.
dnbt:hasQualifiedSubject a owl:ObjectProperty,
                           rdf:Property;
                         rdfs:comment "Connects a publication with an instance of dnbt:QualifiedSubject."@en,
                                      "Verbindet eine Publikation mit einer Instanz von dnbt:QualifiedSubject."@de;
                         rdfs:isDefinedBy dnbt:;
                         rdfs:label "Has qualified subject"@en,
                                    "Hat qualifiziertes Thema"@de.
dnbt:isDescribedIn a owl:ObjectProperty,
                     rdf:Property;
                   rdfs:comment "An information resource that contains a description of the entity in the subject position."@en,
                                "Eine Informationsressource, die eine Beschreibung der Entität in der Subjektposition enthält."@de;
                   rdfs:isDefinedBy dnbt:;
                   rdfs:label "Is described in"@en,
                              "Wird beschrieben in"@de;
                   owl:propertyChainAxiom (dcterms:description
                                           dcterms:isPartOf).
dnbt:larsGSvensson a foaf:Person;
                   rdfs:label "Lars G. Svensson";
                   owl:sameAs dnb:124903959.
dnbt:literary-genre-notation a rdfs:Datatype;
                             rdfs:comment "This datatype denotes a notation from the DNB list of literary genres."@en,
                                          "Dieser Datentyp kennzeichnet eine Notation aus der Liste von literarischen Gattungen, gepflegt von der DNB"@de;
                             rdfs:isDefinedBy dnbt:;
                             rdfs:label "Literary Genre Notation"@en,
                                        "Notation aus der Liste der Literarischen Gattungsbegriffe"@de;
                             rdfs:seeAlso <http://library.ifla.org/id/eprint/184>;
                             owl:onDatatype xsd:string;
                             owl:withRestrictions ([xsd:pattern "[12][0-9]{2}"]).
dnbt:qualifiesLanguage a owl:ObjectProperty,
                         rdf:Property;
                       rdfs:comment "Connects an instance of dnbt:QualifiedLanguage with the language it qualifies."@en,
                                    "Verbindet eine Instanz von dnbt:QualifiedLanguage mit der Sprache, die sie qualifiziert."@de;
                       rdfs:isDefinedBy dnbt:;
                       rdfs:label "Qualifies language"@en,
                                  "Qualifiziert Sprache"@de.
dnbt:qualifiesSubject a owl:ObjectProperty,
                        rdf:Property;
                      rdfs:comment "Connects an instance of dnbt:QualifiedSubject with the subject it qualifies."@en,
                                   "Verbindet eine Instanz von dnbt:QualifiedSubject mit dem Thema, das sie qualifiziert."@de;
                      rdfs:isDefinedBy dnbt:;
                      rdfs:label "Qualifies subject"@en,
                                 "Qualifiziert Thema"@de.
dnbt:thema-classification-notation a rdfs:Datatype;
                                   rdfs:comment """This datatype denotes notation from the thema
		classification system. The thema classification is maintained by Editeur.org."""@en,
                                                """Dieser Datentyp kennzeichnet eine Notation aus der
		thema-Klassifikation. Diese Klassifikation wird gepflegt von Editeur.org."""@de;
                                   rdfs:isDefinedBy dnbt:;
                                   rdfs:label "Thema classification notation"@en,
                                              "Notation aus der Thema-Klassifikation"@de;
                                   rdfs:seeAlso <http://www.editeur.org/151/Thema/>;
                                   owl:onDatatype xsd:string;
                                   owl:withRestrictions ([xsd:pattern "([A-Z]{1,4}|[A-Z]{4}[1-9]{1,4})([1-6][A-Z]{1,8}(-[A-Z]{2}-[A-Z]{0,8})?)?"]).
dcterms:language a owl:ObjectProperty,
                   rdf:Property;
                 rdfs:isDefinedBy dcterms:;
                 owl:propertyChainAxiom (dnbt:hasQualifiedLanguage
                                         dnbt:qualifiesLanguage).
dcterms:subject a owl:ObjectProperty,
                  rdf:Property;
                rdfs:isDefinedBy dcterms:;
                owl:propertyChainAxiom (dnbt:hasQualifiedSubject
                                        dnbt:qualifiesSubject).
