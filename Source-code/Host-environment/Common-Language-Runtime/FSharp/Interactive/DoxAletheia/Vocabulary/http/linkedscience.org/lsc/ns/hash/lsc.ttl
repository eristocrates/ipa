@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lsc: <http://linkedscience.org/lsc/ns#>.

<http://carsten.io/> a <http://xmlns.com/foaf/0.1/Person>;
                     <http://xmlns.com/foaf/0.1/homepage> <http://carsten.io/>;
                     <http://xmlns.com/foaf/0.1/name> "Carsten Keßler"@en.
<http://kauppinen.net/tomi#me> a <http://xmlns.com/foaf/0.1/Person>;
                               <http://xmlns.com/foaf/0.1/homepage> <http://kauppinen.net/tomi>;
                               <http://xmlns.com/foaf/0.1/name> "Tomi Kauppinen"@en.
lsc: <http://purl.org/dc/terms/created> "2011-11-29T11:30:00Z"^^xsd:dateTime;
     <http://purl.org/dc/terms/creator> <http://kauppinen.net/tomi#me>;
     <http://purl.org/dc/terms/description> "LSC, the Linked Science Core Vocabulary, is a lightweight vocabulary providing terms to enable publishers and researchers to relate things in science to time, space, and themes. More precisely, LSC is designed for describing scientific resources including elements of research, their context, and for interconnecting them. We introduce LSC as an example of building blocks for Linked Science to communicate the linkage between scientific resources in a machine-understandable way. The “core” in the name refers to the fact that LSC only defines the basic terms for science. We argue that the success of Linked Science—or Linked Data in general—lies in interconnected, yet distributed vocabularies that minimize ontological commitments. More specific terms needed by different scientific communities can therefore be introduced as extensions of LSC. LSC is hosted at LinkedScience.org; please check also other available vocabularies at LinkedScience.org/vocabularies."@en;
     <http://purl.org/dc/terms/title> "Linked Science Core Vocabulary namespace"@en;
     <http://purl.org/net/provenance/ns#createdBy> [<http://purl.org/net/provenance/ns#performedAt> "2011-11-29T11:30:00Z"^^xsd:dateTime ; 
                                                    <http://purl.org/net/provenance/ns#performedBy> <http://kauppinen.net/tomi#me> ; 
                                                    a <http://purl.org/net/provenance/ns#DataCreation>],
                                                   [<http://purl.org/net/provenance/ns#performedAt> "2011-11-29T11:30:00Z"^^xsd:dateTime ; 
                                                    <http://purl.org/net/provenance/ns#performedBy> <http://kauppinen.net/tomi#me> ; 
                                                    a <http://purl.org/net/provenance/ns#DataCreation>];
     a <http://www.w3.org/2002/07/owl#Ontology>,
       <http://purl.org/net/provenance/ns#DataItem>.
lsc:Conclusion a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Conclusion is made by research."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Conclusion"@en.
lsc:Data a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Any kind of data."@en;
         rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
         rdfs:label "Data"@en.
lsc:Hypothesis a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Any kind of hypothesis."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Hypothesis"@en.
lsc:Prediction a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Prediction made by a hypothesis."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Prediction"@en.
lsc:Publication a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Any kind of publication eg. scientific paper, book, journal publication."@en;
                rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
                rdfs:label "Publication"@en;
                rdfs:subClassOf <http://purl.org/ontology/bibo/Document>.
lsc:Research a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Any kind of research."@en;
             rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
             rdfs:label "Research"@en.
lsc:Researcher a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A researcher that conducts research."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Researcher"@en;
               rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person>.
lsc:confirms a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A research confirms a hypothesis."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:confirms;
             rdfs:label "room"@en;
             rdfs:range lsc:Hypothesis.
lsc:dataProduced a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Describes the relation between a research and the data produced in it."@en;
                 rdfs:domain lsc:Research;
                 rdfs:isDefinedBy lsc:dataProduced;
                 rdfs:label "room"@en;
                 rdfs:range lsc:Data.
lsc:dataUsed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Describes the relation between a research and the data used to conduct it."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:dataUsed;
             rdfs:label "reportTemplate"@en;
             rdfs:range lsc:Data.
lsc:falsifies a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "A research falsifies a hypothesis."@en;
              rdfs:domain lsc:Research;
              rdfs:isDefinedBy lsc:falsifies;
              rdfs:label "room"@en;
              rdfs:range lsc:Hypothesis.
lsc:isAboutRegion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Abstract property to define the region a research refers to."@en;
                  rdfs:domain lsc:Research;
                  rdfs:isDefinedBy lsc:isAboutRegion;
                  rdfs:label "weeklyHours"@en;
                  rdfs:range <http://observedchange.com/tisc/ns#Region>;
                  rdfs:subPropertyOf <dct:coverage>.
lsc:isAboutTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Abstract property to relate a research to the time period it refers."@en;
                rdfs:domain lsc:Research;
                rdfs:isDefinedBy lsc:isAboutTime;
                rdfs:label "isAboutTime"@en;
                rdfs:range xsd:dateTime.
lsc:isSupprtedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Abstract property to express the relation between the hypothesis and the evidence of a research."@en;
                 rdfs:domain lsc:Hypothesis;
                 rdfs:isDefinedBy lsc:isSupportedBy;
                 rdfs:label "isSupportedBy"@en;
                 rdfs:range lsc:Research.
lsc:makes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "A hypothesis makes a prediction."@en;
          rdfs:domain lsc:Hypothesis;
          rdfs:isDefinedBy lsc:makes;
          rdfs:label "room"@en;
          rdfs:range lsc:Prediction.
lsc:methodUsed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "A method used in a research."@en;
               rdfs:domain lsc:Research;
               rdfs:isDefinedBy lsc:methodUsed;
               rdfs:label "room"@en;
               rdfs:range lsc:Method.
lsc:participatesIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A researcher participates in some research."@en;
                   rdfs:domain lsc:Researcher;
                   rdfs:isDefinedBy lsc:participatesIn;
                   rdfs:label "room"@en;
                   rdfs:range lsc:Research.
lsc:produces a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "A research produces a conclusion."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:produces;
             rdfs:label "room"@en;
             rdfs:range lsc:Conclusion.
lsc:reportedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Abstract property to relate a research to the publications it is reported in."@en;
               rdfs:domain lsc:Research;
               rdfs:isDefinedBy lsc:reportedIn;
               rdfs:label "reportedIn"@en;
               rdfs:range lsc:Publication.
lsc:reports a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Abstract property to report the research of a publication."@en;
            rdfs:domain lsc:Publication;
            rdfs:isDefinedBy lsc:reports;
            rdfs:label "grading"@en;
            rdfs:range lsc:Research.
lsc:tests a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "A research tests a hypothesis."@en;
          rdfs:domain lsc:Research;
          rdfs:isDefinedBy lsc:tests;
          rdfs:label "room"@en;
          rdfs:range lsc:Hypothesis.
lsc:timeAccepted a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Abstract property to relate a publication to the time it was accepted."@en;
                 rdfs:domain lsc:Publication;
                 rdfs:isDefinedBy lsc:timeAccepted;
                 rdfs:label "room"@en;
                 rdfs:range xsd:dateTime.
lsc:timeRevised a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Abstract property to relate a publication to the time it was revised."@en;
                rdfs:domain lsc:Publication;
                rdfs:isDefinedBy lsc:timeRevised;
                rdfs:label "room"@en;
                rdfs:range xsd:dateTime.
lsc:timeSubmitted a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Abstract property to relate a publication to the time it was submitted."@en;
                  rdfs:domain lsc:Publication;
                  rdfs:isDefinedBy lsc:timeSubmitted;
                  rdfs:label "room"@en;
                  rdfs:range xsd:dateTime.
<http://linkedscience.org/lsc/ns/> <http://purl.org/dc/terms/conformsTo> <http://www.w3.org/TR/rdfa-syntax>;
                                   <http://purl.org/dc/terms/description> "This documents specifies the classes and properties introduced by the Linked Science Core Vocabulary."@en;
                                   <http://purl.org/dc/terms/title> "Linked Science Core Vocabulary Specification"@en,
                                                                    "Linked Science Vocabulary Specification"@en;
                                   a <http://xmlns.com/foaf/0.1/Document>;
                                   <http://www.w3.org/1999/xhtml/vocab#license> <http://creativecommons.org/licenses/by/1.0/>;
                                   <http://www.w3.org/1999/xhtml/vocab#stylesheet> <http://linkedscience.org/teach/ns/main.css>;
                                   rdfs:label "Document that defines the Linked Science Core Vocabulary"@en;
                                   <http://xmlns.com/foaf/0.1/primaryTopic> lsc:.
<http://linkedscience.org/teach/ns#Method> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "A method used in a scientific research."@en;
                                           rdfs:isDefinedBy <http://linkedscience.org/teach/ns>;
                                           rdfs:label "Method"@en.
