@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lsc: <http://linkedscience.org/lsc/ns#>.
@prefix teach: <http://linkedscience.org/teach/ns#>.
@prefix tisc: <http://observedchange.com/tisc/ns#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix w3: <http://www.w3.org/>.
@prefix html: <http://www.w3.org/1999/xhtml/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix hartigprov: <http://purl.org/net/provenance/ns#>.
@prefix xhv: <http://www.w3.org/1999/xhtml/vocab#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://carsten.io/> a foaf:Person;
                     foaf:homepage <http://carsten.io/>;
                     foaf:name "Carsten Keßler"@en.
<http://kauppinen.net/tomi#me> a foaf:Person;
                               foaf:homepage <http://kauppinen.net/tomi>;
                               foaf:name "Tomi Kauppinen"@en.
lsc: dcterms:created "2011-11-29T11:30:00Z"^^xsd:dateTime;
     dcterms:creator <http://kauppinen.net/tomi#me>;
     dcterms:description "LSC, the Linked Science Core Vocabulary, is a lightweight vocabulary providing terms to enable publishers and researchers to relate things in science to time, space, and themes. More precisely, LSC is designed for describing scientific resources including elements of research, their context, and for interconnecting them. We introduce LSC as an example of building blocks for Linked Science to communicate the linkage between scientific resources in a machine-understandable way. The “core” in the name refers to the fact that LSC only defines the basic terms for science. We argue that the success of Linked Science—or Linked Data in general—lies in interconnected, yet distributed vocabularies that minimize ontological commitments. More specific terms needed by different scientific communities can therefore be introduced as extensions of LSC. LSC is hosted at LinkedScience.org; please check also other available vocabularies at LinkedScience.org/vocabularies."@en;
     dcterms:title "Linked Science Core Vocabulary namespace"@en;
     hartigprov:createdBy [hartigprov:performedAt "2011-11-29T11:30:00Z"^^xsd:dateTime ; 
                           hartigprov:performedBy <http://kauppinen.net/tomi#me> ; 
                           a hartigprov:DataCreation],
                          [hartigprov:performedAt "2011-11-29T11:30:00Z"^^xsd:dateTime ; 
                           hartigprov:performedBy <http://kauppinen.net/tomi#me> ; 
                           a hartigprov:DataCreation];
     a owl:Ontology,
       hartigprov:DataItem.
lsc:Conclusion a owl:Class;
               rdfs:comment "Conclusion is made by research."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Conclusion"@en.
lsc:Data a owl:Class;
         rdfs:comment "Any kind of data."@en;
         rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
         rdfs:label "Data"@en.
lsc:Hypothesis a owl:Class;
               rdfs:comment "Any kind of hypothesis."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Hypothesis"@en.
lsc:Prediction a owl:Class;
               rdfs:comment "Prediction made by a hypothesis."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Prediction"@en.
lsc:Publication a owl:Class;
                rdfs:comment "Any kind of publication eg. scientific paper, book, journal publication."@en;
                rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
                rdfs:label "Publication"@en;
                rdfs:subClassOf bibo:Document.
lsc:Research a owl:Class;
             rdfs:comment "Any kind of research."@en;
             rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
             rdfs:label "Research"@en.
lsc:Researcher a owl:Class;
               rdfs:comment "A researcher that conducts research."@en;
               rdfs:isDefinedBy <http://linkedscience.org/lsc/ns>;
               rdfs:label "Researcher"@en;
               rdfs:subClassOf foaf:Person.
lsc:confirms a owl:ObjectProperty;
             rdfs:comment "A research confirms a hypothesis."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:confirms;
             rdfs:label "room"@en;
             rdfs:range lsc:Hypothesis.
lsc:dataProduced a owl:ObjectProperty;
                 rdfs:comment "Describes the relation between a research and the data produced in it."@en;
                 rdfs:domain lsc:Research;
                 rdfs:isDefinedBy lsc:dataProduced;
                 rdfs:label "room"@en;
                 rdfs:range lsc:Data.
lsc:dataUsed a owl:ObjectProperty;
             rdfs:comment "Describes the relation between a research and the data used to conduct it."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:dataUsed;
             rdfs:label "reportTemplate"@en;
             rdfs:range lsc:Data.
lsc:falsifies a owl:ObjectProperty;
              rdfs:comment "A research falsifies a hypothesis."@en;
              rdfs:domain lsc:Research;
              rdfs:isDefinedBy lsc:falsifies;
              rdfs:label "room"@en;
              rdfs:range lsc:Hypothesis.
lsc:isAboutRegion a owl:ObjectProperty;
                  rdfs:comment "Abstract property to define the region a research refers to."@en;
                  rdfs:domain lsc:Research;
                  rdfs:isDefinedBy lsc:isAboutRegion;
                  rdfs:label "weeklyHours"@en;
                  rdfs:range tisc:Region;
                  rdfs:subPropertyOf <dct:coverage>.
lsc:isAboutTime a owl:ObjectProperty;
                rdfs:comment "Abstract property to relate a research to the time period it refers."@en;
                rdfs:domain lsc:Research;
                rdfs:isDefinedBy lsc:isAboutTime;
                rdfs:label "isAboutTime"@en;
                rdfs:range xsd:dateTime.
lsc:isSupprtedBy a owl:ObjectProperty;
                 rdfs:comment "Abstract property to express the relation between the hypothesis and the evidence of a research."@en;
                 rdfs:domain lsc:Hypothesis;
                 rdfs:isDefinedBy lsc:isSupportedBy;
                 rdfs:label "isSupportedBy"@en;
                 rdfs:range lsc:Research.
lsc:makes a owl:ObjectProperty;
          rdfs:comment "A hypothesis makes a prediction."@en;
          rdfs:domain lsc:Hypothesis;
          rdfs:isDefinedBy lsc:makes;
          rdfs:label "room"@en;
          rdfs:range lsc:Prediction.
lsc:methodUsed a owl:ObjectProperty;
               rdfs:comment "A method used in a research."@en;
               rdfs:domain lsc:Research;
               rdfs:isDefinedBy lsc:methodUsed;
               rdfs:label "room"@en;
               rdfs:range lsc:Method.
lsc:participatesIn a owl:ObjectProperty;
                   rdfs:comment "A researcher participates in some research."@en;
                   rdfs:domain lsc:Researcher;
                   rdfs:isDefinedBy lsc:participatesIn;
                   rdfs:label "room"@en;
                   rdfs:range lsc:Research.
lsc:produces a owl:ObjectProperty;
             rdfs:comment "A research produces a conclusion."@en;
             rdfs:domain lsc:Research;
             rdfs:isDefinedBy lsc:produces;
             rdfs:label "room"@en;
             rdfs:range lsc:Conclusion.
lsc:reportedIn a owl:ObjectProperty;
               rdfs:comment "Abstract property to relate a research to the publications it is reported in."@en;
               rdfs:domain lsc:Research;
               rdfs:isDefinedBy lsc:reportedIn;
               rdfs:label "reportedIn"@en;
               rdfs:range lsc:Publication.
lsc:reports a owl:ObjectProperty;
            rdfs:comment "Abstract property to report the research of a publication."@en;
            rdfs:domain lsc:Publication;
            rdfs:isDefinedBy lsc:reports;
            rdfs:label "grading"@en;
            rdfs:range lsc:Research.
lsc:tests a owl:ObjectProperty;
          rdfs:comment "A research tests a hypothesis."@en;
          rdfs:domain lsc:Research;
          rdfs:isDefinedBy lsc:tests;
          rdfs:label "room"@en;
          rdfs:range lsc:Hypothesis.
lsc:timeAccepted a owl:ObjectProperty;
                 rdfs:comment "Abstract property to relate a publication to the time it was accepted."@en;
                 rdfs:domain lsc:Publication;
                 rdfs:isDefinedBy lsc:timeAccepted;
                 rdfs:label "room"@en;
                 rdfs:range xsd:dateTime.
lsc:timeRevised a owl:ObjectProperty;
                rdfs:comment "Abstract property to relate a publication to the time it was revised."@en;
                rdfs:domain lsc:Publication;
                rdfs:isDefinedBy lsc:timeRevised;
                rdfs:label "room"@en;
                rdfs:range xsd:dateTime.
lsc:timeSubmitted a owl:ObjectProperty;
                  rdfs:comment "Abstract property to relate a publication to the time it was submitted."@en;
                  rdfs:domain lsc:Publication;
                  rdfs:isDefinedBy lsc:timeSubmitted;
                  rdfs:label "room"@en;
                  rdfs:range xsd:dateTime.
<http://linkedscience.org/lsc/ns/> dcterms:conformsTo <http://www.w3.org/TR/rdfa-syntax>;
                                   dcterms:description "This documents specifies the classes and properties introduced by the Linked Science Core Vocabulary."@en;
                                   dcterms:title "Linked Science Core Vocabulary Specification"@en,
                                                 "Linked Science Vocabulary Specification"@en;
                                   a foaf:Document;
                                   xhv:license <http://creativecommons.org/licenses/by/1.0/>;
                                   xhv:stylesheet <http://linkedscience.org/teach/ns/main.css>;
                                   rdfs:label "Document that defines the Linked Science Core Vocabulary"@en;
                                   foaf:primaryTopic lsc:.
teach:Method a owl:Class;
             rdfs:comment "A method used in a scientific research."@en;
             rdfs:isDefinedBy <http://linkedscience.org/teach/ns>;
             rdfs:label "Method"@en.
