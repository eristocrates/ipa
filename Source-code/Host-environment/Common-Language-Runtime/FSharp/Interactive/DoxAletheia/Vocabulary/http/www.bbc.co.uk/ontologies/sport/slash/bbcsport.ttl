                   <http://www.w3.org/2002/07/owl#inverseOf> bbcsport:hasRound.
bbcsport:isSessionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relates a session to a competition."@en-gb;
                     rdfs:domain bbcsport:Session;
                     rdfs:isDefinedBy <http://www.bbc.co.uk/ontologies/sport>;
                     rdfs:label "isSessionOf"@en-gb;
