                     <http://www.w3.org/2002/07/owl#inverseOf> bbcsport:hasSession.
bbcsport:isStageOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates a stage to a multi-stage competition."@en-gb;
                   rdfs:domain bbcsport:Competition;
                   rdfs:isDefinedBy <http://www.bbc.co.uk/ontologies/sport>;
                   rdfs:label "isStageOf"@en-gb;
