                rdfs:label "vertical CRS".
ext:verticalElement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain ext:Extent;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                    rdfs:label "vertical element";
                    rdfs:range ext:VerticalExtent.
ext:westBoundLongitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
