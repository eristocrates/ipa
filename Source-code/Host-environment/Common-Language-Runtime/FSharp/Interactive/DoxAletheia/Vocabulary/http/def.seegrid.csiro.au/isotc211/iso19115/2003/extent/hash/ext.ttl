@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gm: <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#>.
@prefix tm: <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#>.
@prefix ext: <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent> dc11:creator """Simon Jonathan David COX
CSIRO""";
                                                            dc11:date "2012-05-25T00:00:00"^^xsd:dateTime;
                                                            dc11:description " An OWL representation of parts of the Geographic Metadata model described in ISO 19115:2003 with Corrigendum 2006 - EX Package";
                                                            dc11:source """ISO 19115:2003
ISO 19115:2006 Corrigendum""";
                                                            dc11:title "OWL representation of ISO 19115 (Geographic Information - Metadata - Extent package)";
                                                            dcterms:created "2012-05-18T00:00:00"^^xsd:dateTime;
                                                            dcterms:hasPart ext:GeographicBoundingBox,
                                                                            ext:westBoundLongitude,
                                                                            ext:VerticalExtent,
                                                                            ext:northBoundLatitude,
                                                                            ext:eastBoundLongitude,
                                                                            ext:TemporalExtent,
                                                                            ext:GeographicDescription,
                                                                            ext:description,
                                                                            ext:extent,
                                                                            ext:GeographicExtent,
                                                                            ext:minumumValue,
                                                                            ext:geographicIdentifier,
                                                                            ext:extentTypeCode,
                                                                            ext:SpatialTemporalExtent,
                                                                            ext:spatialExtent,
                                                                            ext:temporalElement,
                                                                            ext:BoundingPolygon,
                                                                            ext:verticalCRS,
                                                                            ext:geographicElement,
                                                                            ext:southBoundLatitude,
                                                                            ext:maximumValue,
                                                                            ext:polygon,
                                                                            ext:verticalElement,
                                                                            ext:Extent;
                                                            dcterms:modified "2012-10-26T00:00:00"^^xsd:dateTime;
                                                            a owl:Ontology;
                                                            owl:imports <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>,
                                                                        <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic>,
                                                                        <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry>;
                                                            owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201210/ISOTC211/HM/extent.rdf>;
                                                            owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/extent.rdf>.
ext:BoundingPolygon a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                    rdfs:label "Bounding polygon";
                    rdfs:subClassOf [owl:onProperty ext:polygon ; 
                                     owl:allValuesFrom gm:Object ; 
                                     a owl:Restriction],
                                    [owl:onProperty ext:polygon ; 
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction],
                                    ext:GeographicExtent;
                    skos:notation "EX_BoundingPolygon"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:Extent a owl:Class;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
           rdfs:label "Extent";
           rdfs:subClassOf [owl:onProperty ext:temporalElement ; 
                            owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty ext:description ; 
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty ext:verticalElement ; 
                            owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty ext:geographicElement ; 
                            owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty ext:verticalElement ; 
                            owl:allValuesFrom ext:VerticalExtent ; 
                            a owl:Restriction],
                           [owl:onProperty ext:geographicElement ; 
                            owl:allValuesFrom ext:GeographicExtent ; 
                            a owl:Restriction],
                           [owl:onProperty ext:temporalElement ; 
                            owl:allValuesFrom ext:TemporalExtent ; 
                            a owl:Restriction];
           skos:notation "EX_Extent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:GeographicBoundingBox a owl:Class;
                          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                          rdfs:label "Geographic bounding box";
                          rdfs:subClassOf [owl:onProperty ext:eastBoundLongitude ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          [owl:onProperty ext:northBoundLatitude ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          [owl:onProperty ext:southBoundLatitude ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          [owl:onProperty ext:westBoundLongitude ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          ext:GeographicExtent;
                          skos:notation "EX_GeographicBoundingBox"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:GeographicDescription a owl:Class;
                          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                          rdfs:label "Geographic description"@en;
                          rdfs:subClassOf [owl:onProperty ext:geographicIdentifier ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          ext:GeographicExtent;
                          skos:notation "EX_GeographicDescription"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:GeographicExtent a owl:Class;
                     rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                     rdfs:label "Geographic extent";
                     rdfs:subClassOf [owl:onProperty ext:extentTypeCode ; 
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                      a owl:Restriction];
                     skos:notation "EX_GeographicExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:SpatialTemporalExtent a owl:Class;
                          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                          rdfs:label "Spatial and temporal extent";
                          rdfs:subClassOf [owl:onProperty ext:spatialExtent ; 
                                           owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          ext:TemporalExtent;
                          skos:notation "EX_SpatialTemporalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:TemporalExtent a owl:Class;
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                   rdfs:label "Temporal extent";
                   rdfs:subClassOf [owl:onProperty ext:extent ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction];
                   skos:notation "EX_TemporalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:VerticalExtent a owl:Class;
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                   rdfs:label "Vertical extent";
                   rdfs:subClassOf [owl:onProperty ext:maximumValue ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:onProperty ext:minumumValue ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:onProperty ext:verticalCRS ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction];
                   skos:notation "EX_VerticalExtent"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
ext:description a owl:DatatypeProperty;
                rdfs:domain ext:Extent;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                rdfs:label "description";
                rdfs:range xsd:string.
ext:eastBoundLongitude a owl:DatatypeProperty;
                       rdfs:domain ext:GeographicBoundingBox;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                       rdfs:label "east bound longitude";
                       rdfs:range xsd:decimal.
ext:extent a owl:ObjectProperty;
           rdfs:domain ext:TemporalExtent;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
           rdfs:label "extent";
           rdfs:range tm:Primitive.
ext:extentTypeCode a owl:DatatypeProperty;
                   rdfs:domain ext:GeographicExtent;
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                   rdfs:label "extent type code";
                   rdfs:range xsd:boolean.
ext:geographicElement a owl:ObjectProperty;
                      rdfs:domain ext:Extent;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                      rdfs:label "geographic element";
                      rdfs:range ext:GeographicExtent.
ext:geographicIdentifier a owl:ObjectProperty;
                         rdfs:domain ext:GeographicDescription;
                         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                         rdfs:label "geographic identifier".
ext:maximumValue a owl:DatatypeProperty;
                 rdfs:domain ext:VerticalExtent;
                 rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                 rdfs:label "maximum value";
                 rdfs:range xsd:double.
ext:minumumValue a owl:DatatypeProperty;
                 rdfs:domain ext:VerticalExtent;
                 rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                 rdfs:label "minumu value";
                 rdfs:range xsd:double.
ext:northBoundLatitude a owl:DatatypeProperty;
                       rdfs:domain ext:GeographicBoundingBox;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                       rdfs:label "north bound latitude";
                       rdfs:range xsd:decimal.
ext:polygon a owl:ObjectProperty;
            rdfs:domain ext:BoundingPolygon;
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
            rdfs:label "polygon";
            rdfs:range gm:Object.
ext:southBoundLatitude a owl:DatatypeProperty;
                       rdfs:domain ext:GeographicBoundingBox;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                       rdfs:label "south bound latitude";
                       rdfs:range xsd:decimal.
ext:spatialExtent a owl:ObjectProperty;
                  rdfs:domain ext:SpatialTemporalExtent;
                  rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                  rdfs:label "spatial extent";
                  rdfs:range ext:GeographicExtent.
ext:temporalElement a owl:ObjectProperty;
                    rdfs:domain ext:Extent;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                    rdfs:label "temporal element";
                    rdfs:range ext:TemporalExtent.
ext:verticalCRS a owl:ObjectProperty;
                rdfs:domain ext:VerticalExtent;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                rdfs:label "vertical CRS".
ext:verticalElement a owl:ObjectProperty;
                    rdfs:domain ext:Extent;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                    rdfs:label "vertical element";
                    rdfs:range ext:VerticalExtent.
ext:westBoundLongitude a owl:DatatypeProperty;
                       rdfs:domain ext:GeographicBoundingBox;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                       rdfs:label "west bound longitude";
                       rdfs:range xsd:decimal.
