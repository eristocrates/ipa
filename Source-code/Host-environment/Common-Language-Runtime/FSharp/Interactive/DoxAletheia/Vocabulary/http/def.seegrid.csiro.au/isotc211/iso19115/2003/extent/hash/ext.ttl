ext:description a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain ext:Extent;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                rdfs:label "description";
                rdfs:range xsd:string.
ext:eastBoundLongitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain ext:GeographicBoundingBox;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>;
                       rdfs:label "east bound longitude";
                       rdfs:range xsd:decimal.
ext:extent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
