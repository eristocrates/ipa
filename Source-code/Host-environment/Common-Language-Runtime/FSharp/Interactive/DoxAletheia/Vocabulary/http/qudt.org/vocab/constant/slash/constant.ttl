                              qudt:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI;
                              qudt:quantityValue constant:Value_BohrMagnetonInHzPerT;
                              a qudt:PhysicalConstant;
                              rdfs:isDefinedBy <http://qudt.org/3.1.10/vocab/constant>;
                              rdfs:label "Bohr magneton in Hz perT"@en;
                              skos:closeMatch <http://dbpedia.org/resource/Bohr_magneton>.
constant:BohrMagnetonInInverseMetersPerTesla qudt:hasQuantityKind quantitykind:MagneticReluctivity;
                                             qudt:informativeReference "http://physics.nist.gov/cuu/Constants/bibliography.html"^^xsd:anyURI;
