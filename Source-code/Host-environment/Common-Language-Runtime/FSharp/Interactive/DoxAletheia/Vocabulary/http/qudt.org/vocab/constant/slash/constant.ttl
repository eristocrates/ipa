                                  a qudt:PhysicalConstant;
                                  rdfs:isDefinedBy <http://qudt.org/3.1.10/vocab/constant>;
                                  rdfs:label "Compton wavelength over 2 pi"@en;
                                  skos:closeMatch <http://dbpedia.org/resource/Compton_wavelength>.
