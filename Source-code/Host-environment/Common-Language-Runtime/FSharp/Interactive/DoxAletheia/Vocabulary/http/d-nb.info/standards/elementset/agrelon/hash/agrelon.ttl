<https://d-nb.info/standards/elementset/agrelon#hasBiologicalParent> a owl:ObjectProperty,
                                                                       rdf:Property;
                                                                     rdfs:comment "A person (subject) was begotten/conceived by a person (object)."@en;
                                                                     rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
