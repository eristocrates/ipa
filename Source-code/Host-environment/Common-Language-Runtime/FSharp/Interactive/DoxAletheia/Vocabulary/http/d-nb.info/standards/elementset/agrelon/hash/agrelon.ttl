                                                              <https://d-nb.info/standards/elementset/agrelon#hasGndCode> "affi".
<https://d-nb.info/standards/elementset/agrelon#hasAuntUncle> a rdf:Property,
                                                                owl:ObjectProperty;
                                                              rdfs:comment "A person (subject) has an aunt or uncle (object)."@en;
                                                              rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
