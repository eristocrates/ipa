                                                              <https://d-nb.info/standards/elementset/agrelon#correspondsToInverse> <https://d-nb.info/standards/elementset/agrelon#HasNieceNephewAuntUncle>.
<https://d-nb.info/standards/elementset/agrelon#hasBeginDate> a owl:DatatypeProperty,
                                                                rdf:Property;
                                                              rdfs:comment "A metadata period or phase (subject) has a temporal start (date). The phase might e.g. concern a relationship between agents."@en;
