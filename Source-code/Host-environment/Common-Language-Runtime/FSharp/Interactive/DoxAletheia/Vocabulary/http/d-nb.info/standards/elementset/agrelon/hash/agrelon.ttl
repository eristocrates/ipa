                                                                         "hat Anfangsdatum"@de;
                                                              rdfs:subPropertyOf <https://d-nb.info/standards/elementset/gnd#associatedDate>;
                                                              status:term_status "stable".
<https://d-nb.info/standards/elementset/agrelon#hasBiologicalChild> a rdf:Property,
                                                                      owl:ObjectProperty;
                                                                    rdfs:comment "A person (subject) begot/conceived a person (object)."@en;
                                                                    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                                    rdfs:label "ha figlio(a) biologico(a)"@it,
