                                                           status:term_status "stable";
                                                           <https://d-nb.info/standards/elementset/agrelon#correspondsToInverse> <https://d-nb.info/standards/elementset/agrelon#IsHasPatron>.
<https://d-nb.info/standards/elementset/agrelon#hasPhysician> a rdf:Property,
                                                                owl:ObjectProperty;
                                                              rdfs:comment "A person or corporate body (subject) has as physician a person or corporate body (object)."@en;
                                                              rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                              rdfs:label "tiene médico"@es,
                                                                         "hat Arzt"@de,
                                                                         "has physician"@en,
                                                                         "ha medico"@it;
                                                              rdfs:subPropertyOf <https://d-nb.info/standards/elementset/agrelon#hasVitalLethalContact>;
                                                              status:term_status "stable";
                                                              <https://d-nb.info/standards/elementset/agrelon#correspondsToInverse> <https://d-nb.info/standards/elementset/agrelon#IsHasPhysician>.
<https://d-nb.info/standards/elementset/agrelon#hasProfessionalContact> a rdf:Property,
                                                                          owl:SymmetricProperty;
                                                                        rdfs:comment "A person or corporation (subject) has some business/profession/occupation related relation with a person or corporation (object)."@en;
                                                                        rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                                        rdfs:label "hat Berufskontakt"@de,
                                                                                   "ha contatto professionale"@it,
                                                                                   "tiene relación profesional"@es,
                                                                                   "has professional contact"@en;
                                                                        rdfs:subPropertyOf <https://d-nb.info/standards/elementset/agrelon#relatedAgent>;
