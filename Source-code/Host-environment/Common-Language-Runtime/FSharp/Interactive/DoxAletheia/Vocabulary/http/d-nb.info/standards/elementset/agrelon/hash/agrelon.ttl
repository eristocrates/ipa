<https://d-nb.info/standards/elementset/agrelon#larsGSvensson> a foaf:Person;
                                                               rdfs:label "Lars G. Svensson";
                                                               owl:sameAs <https://d-nb.info/gnd/124903959>.
<https://d-nb.info/standards/elementset/agrelon#metadataConfidence> a owl:DatatypeProperty,
                                                                      rdf:Property;
                                                                    rdfs:comment "A statement or fact (subject) has a value indicating the statement's confidence or trustworthiness."@en;
                                                                    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                                    rdfs:label "hat Konfidenzwert"@de,
                                                                               "has confidence value"@en,
                                                                               "valor de confianza"@es,
                                                                               "ha valore di fiducia"@it;
                                                                    status:term_status "stable".
<https://d-nb.info/standards/elementset/agrelon#metadataPeriod> a owl:ObjectProperty,
                                                                  rdf:Property;
                                                                rdfs:comment "An n−ary instance (subject) is valid/true in a period (object). The period should be manifested in a blank node, with data properties hasBeginDate or/and hasEndDate set."@en;
                                                                rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                                rdfs:label "hat Gültigkeitszeitraum"@de,
                                                                           "has validity period"@en,
                                                                           "tiene periodo de validez"@es,
                                                                           "ha tempo di validità"@it;
                                                                status:term_status "stable".
<https://d-nb.info/standards/elementset/agrelon#metadataProvenance> a owl:DatatypeProperty,
                                                                      rdf:Property;
                                                                    rdfs:comment "A statement or fact (subject) originates from a source."@en;
                                                                    rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                                    rdfs:label "hat Herkunft"@de,
                                                                               "has provenance"@en,
                                                                               "tiene origen"@es,
                                                                               "ha provenienza"@it;
                                                                    status:term_status "stable".
<https://d-nb.info/standards/elementset/agrelon#relatedAgent> a owl:ObjectProperty,
                                                                rdf:Property;
                                                              rdfs:comment "A person or corporation (subject) has some kind of relation with a person or corporation (object)."@en;
                                                              rdfs:isDefinedBy <https://d-nb.info/standards/elementset/agrelon#>;
                                                              rdfs:label "verknüpfter Agens"@de,
                                                                         "agente connesso"@it,
                                                                         "related Agent"@en,
                                                                         "agente relacionado"@es;
                                                              rdfs:subPropertyOf <https://d-nb.info/standards/elementset/gnd#relatedTerm>;
                                                              status:term_status "stable";
                                                              <https://d-nb.info/standards/elementset/agrelon#correspondsTo> <https://d-nb.info/standards/elementset/agrelon#RelatedAgent>.
