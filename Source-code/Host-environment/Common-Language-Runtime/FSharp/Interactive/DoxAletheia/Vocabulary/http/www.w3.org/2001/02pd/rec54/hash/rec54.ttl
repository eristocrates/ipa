@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rec54: <http://www.w3.org/2001/02pd/rec54#>.

rec54: <http://purl.org/dc/elements/1.1/description> """This is (the start of) an event-based model of the W3C process;
  e.g. RECdd is the class of Recommendation Director's Decisions;
	i.e. messages to w3c-ac-members announcing a new
	W3C Recommendation.""";
       <http://purl.org/dc/elements/1.1/title> "Model of the W3C Process";
       rdfs:comment "$Id: rec54.rdf,v 1.20 2014-06-12 11:03:50 denis Exp $";
       rdfs:seeAlso <http://www.w3.org/DesignIssues/PaperTrail>,
                    <http://www.w3.org/Consortium/Process/>,
                    <http://www.w3.org/2002/01/tr-automation/>,
                    <http://www.indecs.org/>,
                    <http://www.ilrt.bris.ac.uk/discovery/harmony/docs/abc/abc_draft.html>.
rec54:APreview rdfs:label "A.P. review";
               rdfs:subClassOf rec54:ACaction;
               rec54:cites rec54:OrgJoins,
                           rec54:ActivityProposal.
rec54:ActivityCreation rdfs:label "Activity Creation";
                       rdfs:subClassOf rec54:ACnotice;
                       rec54:cites rec54:APreview;
                       rec54:effect rec54:ActivityStatement.
rec54:ActivityProposal rdfs:label "Activity Proposal";
                       rdfs:subClassOf rec54:ACnotice.
rec54:ActivityStatement a rdfs:Class;
                        rdfs:label "Activity Statement".
rec54:CFI rdfs:label "CFI";
          rdfs:subClassOf rec54:ACnotice;
          rec54:cites rec54:CRreq,
                      rec54:CR;
          rec54:effect rec54:CR.
rec54:CFP rdfs:label "CFP";
          rdfs:subClassOf rec54:ACnotice;
          rec54:cites rec54:Charter,
                      rec54:ActivityStatement,
                      rec54:ActivityCreation;
          rec54:effect rec54:Charter.
rec54:CFR rdfs:label "Call for Review";
          rdfs:subClassOf rec54:ACnotice;
          rec54:cites rec54:PRreq,
                      rec54:PR;
          rec54:effect rec54:PR.
rec54:CR rdfs:label "Candidate Recommendation";
         rdfs:subClassOf rec54:TRPub;
         rec54:cites rec54:WD.
rec54:CRreq rdfs:label "CR req.";
            rdfs:subClassOf rec54:WGAction;
            rec54:cites rec54:LastCall.
rec54:Charter rdfs:label "charter".
rec54:ED rdfs:domain rec54:TRPub;
         rdfs:label "Editor's draft".
rec54:FirstEdition rdfs:label "first Edition of a Recommendation";
                   rdfs:subClassOf rec54:REC.
rec54:ImpEvidence rdfs:label "Impl. Evidence";
                  rdfs:subClassOf rec54:WGAction.
rec54:LCann rdfs:label "Last Call Ann.";
            rdfs:subClassOf rec54:WGAction;
            rec54:cites rec54:Charter;
            rec54:effect rec54:LastCall.
rec54:LastCall rdfs:label "a WD in Last Call",
                          "Last Call WD";
               rdfs:subClassOf rec54:WD;
               rec54:cites rec54:WD.
rec54:NOTE rdfs:label "W3C Note";
           rdfs:subClassOf rec54:TRPub.
rec54:OrgJoins rdfs:label "Org. Joins";
               rdfs:subClassOf rec54:ACaction.
rec54:PER rdfs:label "W3C Proposed Edited Recommendation";
          rdfs:subClassOf rec54:TRPub.
rec54:PR rdfs:label "W3C Proposed Reccommendation";
         rdfs:subClassOf rec54:TRPub;
         rec54:cites rec54:WD,
                     rec54:CR.
rec54:PRReview rdfs:label "PR review";
               rdfs:subClassOf rec54:ACaction;
               rec54:cites rec54:PR,
                           rec54:OrgJoins,
                           rec54:CFR.
rec54:PRreq rdfs:label "PR req.";
            rdfs:subClassOf rec54:WGAction;
            rec54:cites rec54:LastCall,
                        rec54:ImpEvidence.
rec54:REC rdfs:label "W3C Recommendation";
          rdfs:subClassOf rec54:TRPub;
          rec54:cites rec54:PR.
rec54:RECdd rdfs:label "Rec. dd";
            rdfs:subClassOf rec54:ACnotice;
            rec54:cites rec54:REC,
                        rec54:PRReview,
                        rec54:CFR;
            rec54:effect rec54:REC.
rec54:RSCND rdfs:label "W3C Rescinded Recommendation";
            rdfs:subClassOf rec54:TRPub.
rec54:Retired rdfs:label "WD not longer in development";
              rdfs:subClassOf rec54:WD.
rec54:Superseded rdfs:comment "Another work has superseded this one, which should not be considered as current any more.";
                 rdfs:label "supersed Work";
                 rdfs:subClassOf <http://www.w3.org/2000/10/swap/pim/doc#Work>.
rec54:TRPub rdfs:label "a W3C Technical Report";
            rdfs:seeAlso <http://www.w3.org/Consortium/Process/tr.html#Reports>;
            rdfs:subClassOf <http://www.w3.org/2000/10/swap/pim/doc#Work>.
rec54:WD rdfs:label "W3C Working Draft";
         rdfs:subClassOf rec54:TRPub;
         rec54:cites rec54:ActivityStatement.
rec54:WDreq rdfs:label "WD req.";
            rdfs:subClassOf rec54:WGAction;
            rec54:effect rec54:WD.
rec54:cites rdfs:domain <http://www.w3.org/2000/10/swap/pim/doc#Work>;
            rdfs:label "cites".
rec54:editor rdfs:label "editor";
             rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/contributor>.
rec54:effect rdfs:label "has an effect on".
rec54:formerShortname rdfs:label "former short name";
                      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/identifier>.
rec54:fromSubmission rdfs:domain rec54:NOTE;
                     rdfs:label "published per Member Submission request".
rec54:implementationFeedbackDue rdfs:domain rec54:CR;
                                rdfs:label "implementation feedback due".
rec54:lastCallFeedBackDue rdfs:domain rec54:LastCall;
                          rdfs:label "last call feedbackdue".
rec54:nomination rdfs:label "nomination";
                 rdfs:subClassOf rec54:ACaction;
                 rec54:cites rec54:OrgJoins,
                             rec54:Charter;
                 rec54:effect rec54:participation.
rec54:participation rdfs:label "participation";
                    rec54:effect rec54:WDreq.
rec54:patentRules rdfs:domain rec54:TRPub;
                  rdfs:label "governed by patent rules".
rec54:prReviewsDue rdfs:domain rec54:PR;
                   rdfs:label "proposed recommendation feedback due".
rec54:previousEdition rdfs:label "previous edition";
                      rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
rec54:replaces rdfs:comment "Specs that shouldn't be used anymore because a newer one is available";
               rdfs:domain <http://www.w3.org/2000/10/swap/pim/doc#Work>;
               rdfs:label "replaces".
rec54:supersedes rdfs:comment "this Work supersedes what was one in that Work";
                 rdfs:domain <http://www.w3.org/2000/10/swap/pim/doc#Work>;
                 rdfs:label "supersedes";
                 rdfs:range <http://www.w3.org/2000/10/swap/pim/doc#Work>;
                 rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
