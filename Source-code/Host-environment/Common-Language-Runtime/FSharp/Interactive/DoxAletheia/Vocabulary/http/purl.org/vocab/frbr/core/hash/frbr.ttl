                                                 <http://web.resource.org/cc/requires> <http://web.resource.org/cc/Notice>,
                                                                                       <http://web.resource.org/cc/Attribution>;
                                                 a <http://web.resource.org/cc/License>.
<http://iandavis.com/id/me> a foaf:Person;
                            foaf:name "Ian Davis".
dcmitype:Text a owl:Class.
dc11:contributor a owl:DatatypeProperty.
dc11:date a owl:DatatypeProperty.
dc11:format a owl:ObjectProperty.
dc11:identifier a owl:DatatypeProperty.
dc11:rights a owl:DatatypeProperty.
dc11:title a owl:DatatypeProperty.
dc11:type a owl:AnnotationProperty.
dcterms:IMT a owl:Class.
dcterms:hasFormat a owl:ObjectProperty.
dcterms:isVersionOf a owl:AnnotationProperty.
dcterms:replaces a owl:AnnotationProperty.
<http://purl.org/vocab/frbr/core> dc11:contributor <http://bruce.darcus.name/about#me>;
                                  dc11:creator [foaf:name "Richard Newman" ; 
                                                a foaf:Person],
                                               <http://iandavis.com/id/me>;
                                  dc11:date "2009-05-16";
                                  dc11:identifier "http://purl.org/vocab/frbr/frbr-core-20051014";
                                  dc11:rights "Copyright © 2005 Richard Newman and Ian Davis";
                                  dc11:title "Expression of Core FRBR Concepts in RDF"@en;
                                  dcterms:isVersionOf frbrcore:;
                                  dcterms:issued "2005-07-15";
                                  dcterms:replaces <http://purl.org/vocab/frbr/frbr-core-20050809>;
                                  vann:preferredNamespacePrefix "frbr";
                                  vann:preferredNamespaceUri "http://purl.org/vocab/frbr/core#";
                                  a owl:Ontology;
                                  rdfs:comment """
      This vocabulary is an expression in RDF of the concepts and relations described in the
      IFLA report on the Functional Requirements for Bibliographic Records (FRBR). 
    """@en,
                                               """
      This vocabulary is a work in progress, it includes RDF classes for the group 1, 2 and 3 entities
      described by the FRBR report and properties corresponding to the core relationships between
      those entities. It does not yet describe attributes of the entities. Where possible, appropriate 
      relationships with other vocabularies are included in order to place this vocabulary in the 
      context of existing RDF work.
    """@en;
                                  skos:changeNote [dc11:date "2009-05-16" ; 
                                                   dc11:creator <http://iandavis.com/id/me> ; 
                                                   rdfs:label "Various minor tidying tasks"@en];
                                  skos:example <file:///var/www/vocab.org/www/htdocs/frbr/frbr-example-film-20050809.html>;
                                  skos:historyNote [dc11:date "2005-10-14" ; 
                                                    dc11:creator <http://iandavis.com/id/me> ; 
                                                    rdfs:label "Added type hierarchy"@en].
frbrcore:ClassicalWork dcterms:issued "2005-10-14";
                       a owl:Class;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "classical work"@en;
                       rdfs:subClassOf frbrcore:Work.
frbrcore:Concept dcterms:issued "2005-07-15";
                 a owl:Class;
                 rdfs:comment "This class corresponds to the FRBR group three entity 'Concept'."@en;
                 rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                 rdfs:label "concept"@en;
                 rdfs:subClassOf frbrcore:Subject,
                                 skos:Concept;
                 owl:disjointWith frbrcore:Place,
                                  frbrcore:Object,
                                  frbrcore:Event;
                 skos:changeNote [dc11:date "2005-08-08" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Added comment"],
                                 [dc11:date "2005-08-09" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Extracted definition from existing comment"],
                                 [dc11:date "2005-08-08" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                 skos:definition "An abstract idea or notion."@en;
                 skos:historyNote [dc11:date "2005-08-08" ; 
                                   dc11:creator "Ian Davis" ; 
                                   rdf:value "Made subclass of skos:Concept"].
frbrcore:CorporateBody dcterms:issued "2005-07-15";
                       a owl:Class;
                       rdfs:comment "This class corresponds to the FRBR group two entity 'Corporate Body'."@en;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "corporate body"@en;
                       rdfs:subClassOf frbrcore:ResponsibleEntity;
                       owl:equivalentClass [owl:unionOf (foaf:Organization
                                                         foaf:Group) ; 
                                            rdfs:label "the union of all organizations and groups"@en ; 
                                            a owl:Class];
                       skos:changeNote [dc11:date "2005-08-08" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                                       [dc11:date "2005-08-08" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added comment"],
                                       [dc11:date "2005-08-09" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Extracted definition from existing comment"];
                       skos:definition "An organization or group of individuals and/or other organizations."@en.
frbrcore:Data dcterms:issued "2005-10-14";
              a owl:Class;
              rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
              rdfs:label "data"@en;
              rdfs:subClassOf frbrcore:Expression.
frbrcore:Endeavour dcterms:issued "2005-07-15";
                   a owl:Class;
                   rdfs:comment "This class represents any one of the FRBR group one entities."@en;
                   rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                   rdfs:label "endeavour"@en;
                   owl:disjointWith frbrcore:ResponsibleEntity,
                                    frbrcore:Subject;
                   owl:equivalentClass [owl:unionOf (frbrcore:Expression
                                                     frbrcore:Item
                                                     frbrcore:Manifestation
                                                     frbrcore:Work) ; 
                                        rdfs:label "the union of all expressions, items, manifestations and works"@en ; 
                                        a owl:Class];
                   skos:changeNote [dc11:date "2005-08-08" ; 
                                    dc11:creator "Ian Davis" ; 
                                    rdf:value "Added comment"],
                                   [dc11:date "2005-08-09" ; 
                                    dc11:creator "Ian Davis" ; 
                                    rdf:value "Extracted definition from existing comment"],
                                   [dc11:date "2005-08-08" ; 
                                    dc11:creator "Ian Davis" ; 
                                    rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                   skos:definition "Any of the products of artistic or creative endeavour."@en.
frbrcore:Event dcterms:issued "2005-07-15";
               a owl:Class;
               rdfs:comment "This class corresponds to the FRBR group three entity 'Event'."@en;
               rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
               rdfs:label "event"@en;
               rdfs:subClassOf frbrcore:Subject,
                               <http://www.isi.edu/~pan/damltime/time-entry.owl#Event>;
               owl:disjointWith frbrcore:Concept,
                                frbrcore:Object,
                                frbrcore:Place;
               skos:changeNote [dc11:date "2005-08-09" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Extracted definition from existing comment"],
                               [dc11:date "2005-08-08" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Added comment"];
               skos:definition "An action or occurrence."@en;
               skos:historyNote [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Made subclass of owltime:Event"].
frbrcore:Expression dcterms:issued "2005-07-15";
                    a owl:Class;
                    rdfs:comment "This class corresponds to the FRBR group one entity 'Expression'."@en;
                    rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                    rdfs:label "expression"@en;
                    rdfs:subClassOf frbrcore:Endeavour;
                    owl:disjointWith frbrcore:Manifestation,
                                     frbrcore:Work,
                                     frbrcore:Item;
                    skos:changeNote [dc11:date "2005-08-09" ; 
                                     dc11:creator "Ian Davis" ; 
                                     rdf:value "Extracted definition from existing comment"],
                                    [dc11:date "2005-08-08" ; 
                                     dc11:creator "Ian Davis" ; 
                                     rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                                    [dc11:date "2005-08-08" ; 
                                     dc11:creator "Ian Davis" ; 
                                     rdf:value "Added comment"];
                    skos:definition "A realization of a single work usually in a physical form."@en.
frbrcore:Image dcterms:issued "2005-10-14";
               a owl:Class;
               rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
               rdfs:label "image"@en;
               rdfs:subClassOf frbrcore:Expression.
frbrcore:Item dcterms:issued "2005-07-15";
              a owl:Class;
              rdfs:comment "This class corresponds to the FRBR group one entity 'Item'."@en;
              rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
              rdfs:label "item"@en;
              rdfs:subClassOf frbrcore:Endeavour;
              owl:disjointWith frbrcore:Manifestation,
                               frbrcore:Work,
                               frbrcore:Expression;
              skos:changeNote [dc11:date "2005-08-09" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Extracted definition from existing comment"],
                              [dc11:date "2005-08-08" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                              [dc11:date "2005-08-08" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Added comment"];
              skos:definition "An exemplar of a single manifestation."@en;
              skos:historyNote [dc11:date "2005-08-08" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Made subclass of geo:SpatialThing"],
                               [dc11:date "2005-08-10" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Removed subclass of geo:SpatialThing"].
frbrcore:LegalWork dcterms:issued "2005-10-14";
                   a owl:Class;
                   rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                   rdfs:label "legal work"@en;
                   rdfs:subClassOf frbrcore:Work.
frbrcore:LiteraryWork dcterms:issued "2005-10-14";
                      a owl:Class;
                      rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                      rdfs:label "literary work"@en;
                      rdfs:subClassOf frbrcore:Work.
frbrcore:Manifestation dcterms:issued "2005-07-15";
                       a owl:Class;
                       rdfs:comment "This class corresponds to the FRBR group one entity 'Manifestation'."@en;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "manifestation"@en;
                       rdfs:subClassOf frbrcore:Endeavour;
                       owl:disjointWith frbrcore:Work,
                                        frbrcore:Expression,
                                        frbrcore:Item;
                       skos:changeNote [dc11:date "2005-08-08" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                                       [dc11:date "2005-08-09" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Extracted definition from existing comment"],
                                       [dc11:date "2005-08-08" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added comment"];
                       skos:definition "The physical embodiment of one or more expressions."@en.
frbrcore:MovingImage dcterms:issued "2005-10-14";
                     a owl:Class;
                     rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                     rdfs:label "moving image"@en;
                     rdfs:subClassOf frbrcore:Expression.
frbrcore:Object dcterms:issued "2005-07-15";
                a owl:Class;
                rdfs:comment "This class corresponds to the FRBR group three entity 'Object'."@en;
                rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                rdfs:label "object"@en;
                rdfs:subClassOf wgspos:SpatialThing,
                                frbrcore:Subject;
                owl:disjointWith frbrcore:Place,
                                 frbrcore:Event,
                                 frbrcore:Concept;
                skos:changeNote [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Added comment"],
                                [dc11:date "2005-08-09" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Extracted definition from existing comment"],
                                [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                skos:definition "A tangible or material thing."@en;
                skos:historyNote [dc11:date "2005-08-08" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Made subclass of geo:SpatialThing"].
frbrcore:Performance dcterms:issued "2005-10-14";
                     a owl:Class;
                     rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                     rdfs:label "performance"@en;
                     rdfs:subClassOf frbrcore:Expression.
frbrcore:Person dcterms:issued "2005-08-08";
                a owl:Class;
                rdfs:comment "This class corresponds to the FRBR group two entity 'Person'."@en;
                rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                rdfs:label "person"@en;
                owl:disjointWith frbrcore:Subject,
                                 frbrcore:Endeavour;
                owl:equivalentClass foaf:Person;
                skos:changeNote [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Added comment"],
                                [dc11:date "2005-08-09" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Extracted definition from existing comment"],
                                [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                skos:definition "A living or dead individual."@en.
frbrcore:Place dcterms:issued "2005-07-15";
               a owl:Class;
               rdfs:comment "This class corresponds to the FRBR group three entity 'Place'."@en;
               rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
               rdfs:label "place"@en;
               rdfs:subClassOf wgspos:SpatialThing,
                               frbrcore:Subject;
               owl:disjointWith frbrcore:Concept,
                                frbrcore:Object,
                                frbrcore:Event;
               skos:changeNote [dc11:date "2005-08-08" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Added comment"],
                               [dc11:date "2005-08-08" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                               [dc11:date "2005-08-09" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Extracted definition from existing comment"];
               skos:definition "A location."@en;
               skos:historyNote [dc11:date "2005-08-08" ; 
                                 dc11:creator "Ian Davis" ; 
                                 rdf:value "Made subclass of geo:SpatialThing"].
frbrcore:ResponsibleEntity dcterms:issued "2005-07-15";
                           a owl:Class;
                           rdfs:comment "This class represents any of the FRBR group two entities."@en;
                           rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                           rdfs:label "responsible entity"@en;
                           owl:disjointWith frbrcore:Endeavour,
                                            frbrcore:Subject;
                           owl:equivalentClass [owl:unionOf (frbrcore:CorporateBody
                                                             foaf:Person) ; 
                                                rdfs:label "the union of all people and corporate bodies"@en ; 
                                                a owl:Class];
                           skos:changeNote [dc11:date "2005-08-09" ; 
                                            dc11:creator "Ian Davis" ; 
                                            rdf:value "Extracted definition from existing comment"],
                                           [dc11:date "2005-08-08" ; 
                                            dc11:creator "Ian Davis" ; 
                                            rdf:value "Added comment"],
                                           [dc11:date "2005-08-08" ; 
                                            dc11:creator "Ian Davis" ; 
                                            rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                           skos:definition "One responsible for the creation, production, distribution or maintenance of artistic or creative content."@en.
frbrcore:ScholarlyWork dcterms:issued "2005-10-14";
                       a owl:Class;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "scholarly work"@en;
                       rdfs:subClassOf frbrcore:Work.
frbrcore:Sound dcterms:issued "2005-10-14";
               a owl:Class;
               rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
               rdfs:label "sound"@en;
               rdfs:subClassOf frbrcore:Expression.
frbrcore:Subject dcterms:issued "2005-07-15";
                 a owl:Class;
                 rdfs:comment "This class represents any of the FRBR group three entities."@en;
                 rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                 rdfs:label "subject"@en;
                 owl:disjointWith frbrcore:Endeavour,
                                  frbrcore:ResponsibleEntity;
                 owl:equivalentClass [owl:unionOf (frbrcore:Event
                                                   frbrcore:Object
                                                   frbrcore:Place
                                                   frbrcore:Concept) ; 
                                      rdfs:label "the union of all events, objects, places and concepts"@en ; 
                                      a owl:Class];
                 skos:changeNote [dc11:date "2005-08-08" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Added comment"],
                                 [dc11:date "2005-08-09" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Extracted definition from existing comment"],
                                 [dc11:date "2005-08-08" ; 
                                  dc11:creator "Ian Davis" ; 
                                  rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                 skos:definition "Something that may serve as the subject of a work."@en.
frbrcore:Text dcterms:issued "2005-10-14";
              a owl:Class;
              rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
              rdfs:label "text"@en;
              rdfs:subClassOf frbrcore:Expression.
frbrcore:Work dcterms:issued "2005-07-15";
              a owl:Class;
              rdfs:comment "This class corresponds to the FRBR group one entity 'Work'."@en;
              rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
              rdfs:label "work"@en;
              rdfs:subClassOf frbrcore:Endeavour,
                              <http://xmlns.com/wordnet/1.6/Work~2>;
              owl:disjointWith frbrcore:Manifestation,
                               frbrcore:Expression,
                               frbrcore:Item;
              skos:changeNote [dc11:date "2005-08-09" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Extracted definition from existing comment"],
                              [dc11:date "2005-08-08" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                              [dc11:date "2005-08-08" ; 
                               dc11:creator "Ian Davis" ; 
                               rdf:value "Added comment"];
              skos:definition "An abstract notion of an artistic or intellectual creation."@en;
              skos:historyNote [dc11:date "2005-08-08" ; 
                                dc11:creator "Ian Davis" ; 
                                rdf:value "Made subclass of wordnet:Work~2"].
frbrcore:abridgement dcterms:issued "2005-07-15";
                     a owl:ObjectProperty;
                     rdfs:domain frbrcore:Expression;
                     rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                     rdfs:label "abridgement"@en;
                     rdfs:range frbrcore:Expression;
                     rdfs:subPropertyOf frbrcore:relatedEndeavour;
                     owl:inverseOf frbrcore:abridgementOf;
                     skos:changeNote [dc11:date "2005-08-09" ; 
                                      dc11:creator "Ian Davis" ; 
                                      rdf:value "Added definition"],
                                     [dc11:date "2005-08-08" ; 
                                      dc11:creator "Ian Davis" ; 
                                      rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                     skos:definition "An abridgment of an expression."@en;
                     skos:historyNote [dc11:date "2005-08-10" ; 
                                       dc11:creator "Ian Davis" ; 
                                       rdf:value "Added domain and range of Expression"].
frbrcore:abridgementOf dcterms:issued "2005-07-15";
                       a owl:ObjectProperty;
                       rdfs:domain frbrcore:Expression;
                       rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                       rdfs:label "abridgement of"@en;
                       rdfs:range frbrcore:Expression;
                       rdfs:subPropertyOf frbrcore:relatedEndeavour;
                       owl:inverseOf frbrcore:abridgement;
                       skos:changeNote [dc11:date "2005-08-08" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added isDefinedBy property referring to FRBR core namespace"],
                                       [dc11:date "2005-08-09" ; 
                                        dc11:creator "Ian Davis" ; 
                                        rdf:value "Added definition"];
                       skos:definition "An expression that is abridged."@en;
                       skos:historyNote [dc11:date "2005-08-10" ; 
                                         dc11:creator "Ian Davis" ; 
                                         rdf:value "Added domain and range of Expression"].
frbrcore:adaption dcterms:issued "2005-07-15";
                  a owl:ObjectProperty;
                  rdfs:domain [owl:unionOf (frbrcore:Work
                                            frbrcore:Expression) ; 
                               a owl:Class];
                  rdfs:isDefinedBy <http://purl.org/vocab/frbr/core>;
                  rdfs:label "adaption"@en;
                  rdfs:range [owl:unionOf (frbrcore:Work
                                           frbrcore:Expression) ; 
                              a owl:Class];
                  rdfs:subPropertyOf frbrcore:relatedEndeavour;
                  owl:inverseOf frbrcore:adaptionOf;
                  skos:changeNote [dc11:date "2005-08-09" ; 
                                   dc11:creator "Ian Davis" ; 
                                   rdf:value "Added definition"],
                                  [dc11:date "2005-08-08" ; 
                                   dc11:creator "Ian Davis" ; 
                                   rdf:value "Added isDefinedBy property referring to FRBR core namespace"];
                  skos:definition "An adaption of a work or expression."@en;
                  skos:historyNote [dc11:date "2005-08-10" ; 
                                    dc11:creator "Ian Davis" ; 
                                    rdf:value "Added domain and range of Work or Expression"].
frbrcore:adaptionOf dcterms:issued "2005-07-15";
                    a owl:ObjectProperty;
                    rdfs:domain [owl:unionOf (frbrcore:Work
