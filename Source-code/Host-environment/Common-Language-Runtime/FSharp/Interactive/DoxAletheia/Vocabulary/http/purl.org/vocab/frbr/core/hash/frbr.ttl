@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix wn: <http://xmlns.com/wordnet/1.6/>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix frbrcore: <http://purl.org/vocab/frbr/core#>.
@prefix wgspos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.

<file:///var/www/vocab.org/www/htdocs/frbr/> <http://web.resource.org/cc/license> <http://creativecommons.org/licenses/by/2.0/uk/>;
