@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix essglobal: <http://purl.org/essglobal/vocab/>.

essglobal: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
           <http://purl.org/dc/terms/contributor> <http://www.haverford.edu/>,
                                                  <http://www.eita.org.br/>,
                                                  <http://algoritmi.uminho.pt/>,
                                                  <http://www.iscap.ipp.pt/>;
           <http://purl.org/dc/terms/creator> <http://google.com/+MarianaCuradoMalta>;
           <http://purl.org/dc/terms/description> "Un vocabulaire pour l'Économie Sociale et Solidaire (ESS). Ce vocabulaire est conçu pour être combiné avec les schémas de métadonnées/vocabulaires/ontologies: dcterms, good relations, foaf, vcard et schema.org - qui est défini dans le profil d'application Dublin Core de l'ESS. Vocabulaire développé par le groupe ESSGlobal du Réseau Intercontinental de Promotion de l'Economie Sociale et Solidaire (RIPESS)."@fr,
                                                  "Un vocabulario para la Economia Social y Solidária (ESS). Este vocabulario es concebido para ser conjugado con los esquemas de metadados/vocabularios/ontologias: dcterms, good relations, foaf, vcard e schema.org - esto esta definido em el Perfil de Aplicación Dublin Core de la ESS. Vocabulario desarollado por el grupo ESSGlobal de la Red Intercontinental para la promoción de Economia Social y Solidaria (RIPESS)."@es,
                                                  "A vocabulary for the Social and Solidarity Economy (SSE). This vocabulary is designed to be used in combination with the metadata schemes/vocabularies/ontologies: dcterms, good relations, foaf, vcard and schema.org - this is defined in the Dublin Core Application Profile of the SSE. Developed by the ESSGlobal group of the Intercontinental Network for Promoting the Social and Solidarity Economy (RIPESS) Organisation."@en,
                                                  "Un vocabolario per descrivere le risorse dell'Economi Sociale e Solidale (ESS) mappate nel Sistema Informativo basato su Internet della comunità ESS. Questo vocabolario è stato sviluppato dal gruppo ESSglobal della Rete Intercontinentale per la Promozione dell'Economia Sociale e Solidale (RIPESS)."@it,
                                                  "Um vocabulário para a Economia Social e Solidária (ESS). Este vocabulário é concebido para ser combinado em conjunto com os esquemas de metadados/vocabulários/ontologias: dcterms, good relations, foaf, vcard and schema.org - isto está definido no Perfil de Aplicação Dublin Core da ESS. Vocabulário desenvolvido pelo grupo ESSGlobal da Rede Intercontinental para a Promoção da Economia Social e Solidária (RIPESS)."@pt;
           <http://purl.org/dc/terms/issued> "2014-07-16"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
           <http://purl.org/dc/terms/publisher> <http://www.ripess.org/>;
           <http://purl.org/dc/terms/title> "Vocabulaire ESSGlobal"@fr,
                                            "Vocabolario ESSGlobal"@it,
                                            "ESSGlobal Vocabulary"@en,
                                            "Vocabulário ESSGlobal"@pt,
                                            "Vocabulario ESSGlobal"@es;
           <http://purl.org/vocab/vann/preferredNamespacePrefix> "essglobal";
           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/essglobal/vocab/";
           a <http://purl.org/vocommons/voaf#Vocabulary>,
             <http://www.w3.org/2002/07/owl#Ontology>;
           <http://www.w3.org/2002/07/owl#versionInfo> 1.1.
essglobal:Activities <http://purl.org/dc/terms/description> "As atividades de esquema de vocabulário controlado"@pt,
                                                            "The activities vocabulary encoding scheme"@en;
                     <http://purl.org/dc/terms/issued> "2014-08-05"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                     rdfs:label "Actividades VES"@pt,
                                "Activities VES"@en;
                     rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#hasValue> <http://purl.org/essglobal/standard/activities> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
essglobal:Address <http://purl.org/dc/terms/description> "O endereço postal de uma Localização de venda, iniciativa de ESS ou rede.  "@pt,
                                                         "The physical address of the Location of Sale, SSe Initiative or Network. "@en;
                  <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                  a rdfs:Class;
                  rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                  rdfs:label "Endereço"@pt,
                             "Address"@en.
essglobal:Cost <http://purl.org/dc/terms/description> "O custo de um determinado produto ou serviço produzido por uma iniciativa da ESS, incluindo todos os custos. O preço terá este custo somado aos custos de entrega e as margens de venda como podem ser vistos na categoria opção-venda."@pt,
                                                      "The cost for a particular product or service produced by an SSE initiative or network, including all costs. The price will be this cost added to delivery costs and sales margin as can be seen in the sale-option class."@en;
               <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
               a rdfs:Class;
               rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
               rdfs:label "Custo"@pt,
                          "Cost"@en.
essglobal:CostComposition <http://purl.org/dc/terms/description> "Discriminação de todos os insumos (como impostos e matérias-primas) e custos de mão de obra que compõem o custo final do produto ou serviço. Um preço transparente é um pré-requisito para sistemas solidários de comércio justo. "@pt,
                                                                 "A breakdown of all inputs (as taxes and raw materials) and labour costs that make up the product or service's final cost. An open cost is a pre-requisite for solidarity fair trade systems. "@en;
                          <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                          <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                          a rdfs:Class;
                          rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                          rdfs:label "Composição de Custos"@pt,
                                     "Cost Composition"@en.
essglobal:Input <http://purl.org/dc/terms/description> "Um produto, serviço ou atividade usado para fazer o produto final ou o serviço. "@pt,
                                                       "A product, service, or activity that goes into making the final product or service. "@en;
                <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                a rdfs:Class;
                rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                rdfs:label "Insumo"@pt,
                           "Input"@en.
essglobal:Labour <http://purl.org/dc/terms/description> "Trabalho realizado para tarefas específicas relacionadas com o fornecimento de bens ou serviços oferecidos pela iniciativa da ESS. Em geral pode ser humano, animal ou trabalho de máquinas, mas em ESS global é apenas o trabalho humano."@pt,
                                                        "Work done for specific tasks related to the provision of goods or services offered by the SSE initiative. Generally it can be human, animal or machine labour, but in ESSglobal it's human labour only."@en;
                 <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                 a rdfs:Class;
                 rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                 rdfs:label "Trabalho"@pt,
                            "Labour"@en.
essglobal:LegalForm <http://purl.org/dc/terms/description> "A forma jurídica de esquema de vocabulário controlado"@pt,
                                                           "The legal form vocabulary encoding scheme"@en;
                    <http://purl.org/dc/terms/issued> "2014-08-05"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                    rdfs:label "Forma Jurídica VES"@pt,
                               "Legal Form VES"@en;
                    rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#hasValue> <http://purl.org/essglobal/standard/legal-form> ; 
                                                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>].
essglobal:LocationOfSale <http://purl.org/dc/terms/description> "Local onde são fornecidos os bens ou serviços de uma iniciativa da ESS. Podem ser lojas por conta própria, mas também lugares parceiros onde os produtos ou serviços estão disponíveis entre outros de outras iniciativas. "@pt,
                                                                "Place where the goods or services of an SSE initiative are provided. It can be self owned shops, but also partner places where the products or services are available among those from other initiatives. "@en;
                         <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                         a rdfs:Class;
                         rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                         rdfs:label "Local de Venda"@pt,
                                    "Location of Sale"@en;
                         rdfs:subClassOf <http://purl.org/goodrelations/v1#Location>.
essglobal:Network <http://purl.org/dc/terms/description> "Uma rede de indivíduos e/ou organizações que participam da ESS. "@pt,
                                                         "A network of individuals and/or organizations that participate in the SSE. "@en;
                  <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                  a rdfs:Class;
                  rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                  rdfs:label "Rede"@pt,
                             "Network"@en;
                  rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationColaboration>.
essglobal:OtherCosts <http://purl.org/dc/terms/description> "Outros custos que têm impacto no custo final de um produto ou serviço fornecido por uma iniciativa da ESS, com excepção de insumos ou mão de obra, como impostos,desaprovação de maquinaria, fundos, etc. Os custos de entrega não estão incluídos nestes custos: eles estão incluídos na categoria opções-venda. "@pt,
                                                            "Other costs which impact on the final cost of a product or service provided by an SSE initiative, other than input or labour, like taxes, deprecation of machinery, funds, etc. The delivery costs are not included in these costs: they are included in the sale-options class. "@en;
                     <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                     a rdfs:Class;
                     rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                     rdfs:label "Outros Custos"@pt,
                                "Other Costs"@en.
essglobal:ProductOrService <http://purl.org/dc/terms/description> "O bem oferecido por uma iniciativa da ESS. Podem ser bens materiais ou prestação de serviços. "@pt,
                                                                  "The good offered by an SSE initiative. It may be material goods or provision of services. "@en;
                           <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                           a rdfs:Class;
                           rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                           rdfs:label "Produto ou Serviço"@pt,
                                      "Product or Service"@en;
                           rdfs:subClassOf <http://purl.org/goodrelations/v1#ProductOrService>.
essglobal:Qualifiers <http://purl.org/dc/terms/description> "Os qualificadores de esquema de vocabulário controlado"@pt,
                                                            "The qualifiers vocabulary encoding scheme"@en;
                     <http://purl.org/dc/terms/issued> "2014-08-05"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                     rdfs:label "Qualificadores VES"@pt,
                                "Qualifiers VES"@en;
                     rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#hasValue> <http://purl.org/essglobal/standard/qualifiers> ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
essglobal:SSEInitiative <http://purl.org/dc/terms/description> "Uma organização, a prática, uma rede, ou outra iniciativa que seja reconhecida como pertencendo à economia social solidária.  "@pt,
                                                               "An organization, practice, network, or other initiative that is recognized as belonging within the social solidarity economy.  "@en;
                        <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                        a rdfs:Class;
                        rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                        rdfs:label "Iniciativa ESS"@pt,
                                   "SSE Initiative"@en;
                        rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationUnit>.
essglobal:SaleOption <http://purl.org/dc/terms/description> "Um Produto vendido a um determinado preço, sob características especificas, num determinado Local. "@pt,
                                                            "A Product sold at a certain price, under specific properties, in a certain Location. "@en;
                     <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                     a rdfs:Class;
                     rdfs:isDefinedBy "http://purl.org/essglobal/vocab/";
                     rdfs:label "Opção de Venda"@pt,
                                "Sale Option"@en.
essglobal:TypeOfLabour <http://purl.org/dc/terms/description> "O tipo de trabalho de esquema de vocabulário controlado"@pt,
                                                              "The type of labour vocabulary encoding scheme"@en;
                       <http://purl.org/dc/terms/issued> "2014-08-05"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                       rdfs:label "Tipo de Trabalho VES"@pt,
                                  "Type of Labour VES"@en;
                       rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>;
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#hasValue> <http://purl.org/essglobal/standard/type-of-labour> ; 
                                                                        <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                                        a <http://www.w3.org/2002/07/owl#Restriction>].
essglobal:costPerUnit <http://purl.org/dc/terms/description> "O custo de insumos por unidade."@pt,
                                                             "The cost per unit of input."@en;
                      <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                      <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain essglobal:Input;
                      rdfs:isDefinedBy essglobal:;
                      rdfs:label "Cost per Unit"@en,
                                 "Custo por Unidade"@pt;
                      rdfs:range rdfs:Literal.
essglobal:deliveryRangeDistance <http://purl.org/dc/terms/description> "O alcance da entrega do produto ou serviço, em quilómetros ou milhas."@pt,
                                                                       "Delivery range of product or service, in kilometers or miles."@en;
                                <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:domain essglobal:LocationOfSale;
                                rdfs:isDefinedBy essglobal:;
                                rdfs:label "Delivery Range (distance)"@en,
                                           "Alcance da Entrega (distância)"@pt;
                                rdfs:range rdfs:Literal.
essglobal:economicSector <http://purl.org/dc/terms/description> "Categorização do tipo de atividades exercidas por iniciativas da ESS, dependendo da sua natureza, das matérias-primas e da metodologia."@pt,
                                                                "A categorization of the type of activities carried on by SSE initiatives, depending of its nature, raw materials and methodology."@en;
                         <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain essglobal:SSEInitiative;
                         rdfs:isDefinedBy essglobal:;
                         rdfs:label "Setor Económico"@pt,
                                    "Economic Sector"@en;
                         rdfs:range essglobal:Activities.
essglobal:hasAddress <http://purl.org/dc/terms/description> "Object Property that links a Network, SSEInitiative or LocationOfSale to it's Address. "@en,
                                                            "Uma propriedade objecto que liga uma Network, SSEInitiative ou LocationOfSale ao seu endereço. "@pt;
                     <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:SSEInitiative
                                                                           essglobal:Network
                                                                           essglobal:LocationOfSale) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                     rdfs:isDefinedBy essglobal:;
                     rdfs:label "Tem um endereço"@pt,
                                "Has an address"@en;
                     rdfs:range essglobal:Address.
essglobal:hasCost <http://purl.org/dc/terms/description> "An object property that links the Product or Service to its cost."@en,
                                                         "Uma propriedade objecto que lida um produto ou serviço ao seu custo."@pt;
                  <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain essglobal:ProductOrService;
                  rdfs:isDefinedBy essglobal:;
                  rdfs:label "Has Cost"@en,
                             "Tem Custo"@pt;
                  rdfs:range essglobal:Cost.
essglobal:hasImpactOnCost <http://purl.org/dc/terms/description> "Does the input contribute to the monetary cost of the final product? Whereas many (perhaps most) inputs do contribute to the monetary price of the final product or service, some don't. For example, volunteer labour may contribute greatly to production without adding to the monetary cost of production.his property is of boolean type: Yes or No."@en,
                                                                 "O insumo contribui para o custo monetário do produto final? Considerando que muitos (talvez a maioria) insumos contribuem para o valor monetário do produto final ou serviço, outros não. Por exemplo, o trabalho voluntário pode contribuir muito para a produção sem aumentar o valor monetário do custo de produção.Esta propriedade é do tipo Booleano. Toma os valores 'Sim' ou 'Não'."@pt;
                          <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                          <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:Input
                                                                                essglobal:OtherCosts) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:isDefinedBy essglobal:;
                          rdfs:label "Tem impacto no custo"@pt,
                                     "Has impact on cost"@en;
                          rdfs:range xsd:boolean.
essglobal:hasInputCost <http://purl.org/dc/terms/description> "Propriedade objecto que liga uma composição de preço (CostComposition) a um input que pode ser um produto, serviço ou actividade, usado para fazer o produto final ou o serviço."@pt,
                                                              "Object property that links a CostComposition to input that can be a product, service, or activity that goes into making the final product or service."@en;
                       <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain essglobal:CostComposition;
                       rdfs:isDefinedBy essglobal:;
                       rdfs:label "Tem insumo"@pt,
                                  "Has input"@en;
                       rdfs:range essglobal:Input.
essglobal:hasLabourCost <http://purl.org/dc/terms/description> "Object Property to link the CostComposition to the Work done for specific tasks related to the provision of goods or services offered by the SSE initiative. Generally it can be human, animal or machine labour, but in ESSglobal it's human labour only."@en,
                                                               "Propriedade objecto que liga a Composição do Trabalho (CostComposition) ao trabalho realizado para tarefas específicas relacionadas com o fornecimento de bens ou serviços oferecidos pela iniciativa da ESS. Em geral pode ser humano, animal ou trabalho de máquinas, mas em ESS global é apenas o trabalho humano."@pt;
                        <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain essglobal:CostComposition;
                        rdfs:isDefinedBy essglobal:;
                        rdfs:label "Tem Trabalho"@pt,
                                   "Has Labour"@en;
                        rdfs:range essglobal:Labour.
essglobal:hasOtherCosts <http://purl.org/dc/terms/description> "Propriedade objecto que liga uma composição de preço (CostComposition) a outros custos (OtherCosts) que têm impacto no custo final de um produto ou serviço fornecido por uma iniciativa da ESS, com excepção de insumo ou mão de obra, como impostos,desaprovação de maquinaria, fundos, etc. Os custos de entrega não estão incluídos nestes custos: eles estão incluídos na categoria opções-venda."@pt,
                                                               "Object Property that links a CostComposition to other costs which impact on the final cost of a product or service provided by an SSE initiative, other than input or labour, like taxes, deprecation of machinery, funds, etc. The delivery costs are not included in these costs: they are included in the sale-options class."@en;
                        <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain essglobal:CostComposition;
                        rdfs:isDefinedBy essglobal:;
                        rdfs:label "Has Other Costs"@en,
                                   "Tem Outros Custos"@pt;
                        rdfs:range essglobal:OtherCosts.
essglobal:hasProductOrService <http://purl.org/dc/terms/description> "Object Property that links to the Network or SSE Initiative' products or services."@en,
                                                                     "Uma Rede ou Iniciativa da ESS produz produtos ou disponibiliza serviços."@pt;
                              <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:Network
                                                                                    essglobal:SSEInitiative) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>];
                              rdfs:isDefinedBy essglobal:;
                              rdfs:label "Tem Produto ou Serviço"@pt,
                                         "Has Product or Service"@en;
                              rdfs:range essglobal:ProductOrService;
                              <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/goodrelations/v1#offers>.
essglobal:hasSaleOption <http://purl.org/dc/terms/description> "An object property that links the Product or service to the place where the product or service is provided."@en,
                                                               "Uma propriedade objecto que liga o Produto ou serviço ao local onde o produto ou serviço é disponibilizado."@pt;
                        <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain essglobal:ProductOrService;
                        rdfs:isDefinedBy essglobal:;
                        rdfs:label "Tem uma Opção de Venda"@pt,
                                   "Has a Sale Option"@en;
                        rdfs:range essglobal:SaleOption.
essglobal:isAvailable <http://purl.org/dc/terms/description> "Uma propriedade que especifica se a Opção de Venda (o produto/serviço a um determinado preço, ao abrigo de definições especificas, num Local de Venda especifico) está disponível.Esta propriedade é um booleano, toma os valores: 'Sim' ou 'Não'."@pt,
                                                             "Property that specifies if the Sale Option (the product/service at a certain price, under specific properties, in a specific Sale Location) is available.THis property us a boolena: Yes or No."@en;
                      <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                      <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain essglobal:SaleOption;
                      rdfs:isDefinedBy essglobal:;
                      rdfs:label "Está disponível"@pt,
                                 "Is available"@en;
                      rdfs:range xsd:boolean.
essglobal:isAvailableAt <http://purl.org/dc/terms/description> "Object Property tha links a Product or Service that is sold at a certain location of sale under specific definitions."@en,
                                                               "Uma propriedade objecto que liga um Produto ou Serviço que é vendido num determinado local de venda (LocationOfSale)) sob definições especificas."@pt;
                        <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain essglobal:SaleOption;
                        rdfs:isDefinedBy essglobal:;
                        rdfs:label "Disponível Em"@pt,
                                   "Available At"@en;
                        rdfs:range essglobal:LocationOfSale;
                        <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/goodrelations/v1#availableAtOrFrom>.
essglobal:isComposedBy <http://purl.org/dc/terms/description> "Uma propriedade objecto que liga um custo à sua discriminação, com todos os insumos (como impostos e matérias-primas) e custos de mão de obra que compõem o custo final do produto ou serviço. Um preço transparente é um pré-requisito para sistemas solidários de comércio justo."@pt,
                                                              "An object property that links a Cost to the breakdown of all its inputs (as taxes and raw materials) and labour costs that make up the product or service's final cost. An open cost is a pre-requisite for solidarity fair trade systems."@en;
                       <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain essglobal:Cost;
                       rdfs:isDefinedBy essglobal:;
                       rdfs:label "Is Composed By"@en,
                                  "É Composto Por"@pt;
                       rdfs:range essglobal:CostComposition.
essglobal:isMain <http://purl.org/dc/terms/description> "Se o Local de Venda é a sede da iniciativa de ESS?Esta propriedade é do tipo Booleano. Toma os valores 'Sim' ou 'Não'."@pt,
                                                        "If the Location of Sale is the headquarter of the SSE initiative?This property is of boolean type: Yes or No."@en;
                 <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain essglobal:LocationOfSale;
                 rdfs:isDefinedBy essglobal:;
                 rdfs:label "Is Main"@en,
                            "É o Principal"@pt;
                 rdfs:range xsd:boolean.
essglobal:isSSE <http://purl.org/dc/terms/description> "If the Location of Sale is a place belonging to the SSE.This property is of boolean type: Yes or No."@en,
                                                       "Se o Local de Venda é um lugar pertencente à ESS.Esta propriedade é do tipo Booleano. Toma os valores 'Sim' ou 'Não'."@en;
                <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain essglobal:LocationOfSale;
                rdfs:isDefinedBy essglobal:;
                rdfs:label "É Iniciativa da ESS"@pt,
                           "Is SSE Initiative"@en;
                rdfs:range xsd:boolean.
essglobal:legalForm <http://purl.org/dc/terms/description> "A forma jurídica de uma Iniciativa ESS ou Rede. Para ser descrito."@pt,
                                                           "The legal form of a SSE Initiative or Network.To be described."@en;
                    <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:SSEInitiative
                                                                          essglobal:Network) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:isDefinedBy essglobal:;
                    rdfs:label "Legal Form"@en,
                               "Forma Jurídica"@pt;
                    rdfs:range essglobal:LegalForm.
essglobal:mission <http://purl.org/dc/terms/description> "A visão, os valores e princípios da iniciativa."@pt,
                                                         "The initiative's vision, values, and principles."@en;
                  <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:SSEInitiative
                                                                        essglobal:Network) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy essglobal:;
                  rdfs:label "Missão"@pt,
                             "Mission"@en;
                  rdfs:range rdfs:Literal.
essglobal:objective <http://purl.org/dc/terms/description> "Etapas acionáveis ​​e mensuráveis ​​que a Iniciativa ESS está a tomar para cumprir a sua missão. "@pt,
                                                           "Actionable and measurable steps the SSE Initiative is taking to carry out its mission. "@en;
                    <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:SSEInitiative
                                                                          essglobal:Network) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:isDefinedBy essglobal:;
                    rdfs:label "Objetivo"@pt,
                               "Objective"@en.
essglobal:qualifier <http://purl.org/dc/terms/description> "Aspect that differentiates the product or service of an SSE initiative which is related to the form of production, the actors involved, the use of only organic materials, etc. Examples are organic, permacultural, made with recycled raw materials, indigenous, made by women, etc."@en,
                                                           "Aspecto que diferencia o produto ou serviço de uma iniciativa ESS que está relacionado com a forma de produção, os atores envolvidos, o uso de apenas materiais orgânicos, etc. Exemplos são orgânicos, permacultura, feitos com matérias-primas recicladas, indígenas, feitos por mulheres, etc."@pt;
                    <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2014-08-05"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (essglobal:ProductOrService
                                                                          essglobal:Input) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:isDefinedBy essglobal:;
                    rdfs:label "Qualificador"@pt,
                               "Qualifier"@en;
                    rdfs:range essglobal:Qualifiers.
essglobal:quantityPerProductOrServiceUnit <http://purl.org/dc/terms/description> "The quantity of the input that goes into providing one unit of the final product or service. "@en,
                                                                                 "A quantidade de insumos que é utilizada para providenciar uma unidade do produto final ou serviço. "@pt;
                                          <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                                          <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                                          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                          rdfs:domain essglobal:Input;
                                          rdfs:isDefinedBy essglobal:;
                                          rdfs:label "Quantidade por Unidade de Produto ou Serviço"@pt,
                                                     "Quantity per Product or Service Unit"@en;
                                          rdfs:range rdfs:Literal.
essglobal:salesMarginPercentage <http://purl.org/dc/terms/description> "Margin (on sales) is the difference between selling price and cost. This difference is typically expressed either as a percentage of selling price or on a per-unit basis. This attribute is the percentage sales margin."@en,
                                                                       "Margem (em vendas) é a diferença entre o preço de venda e o custo. Esta diferença é normalmente expressa como uma percentagem do preço de venda ou com base por unidade. Este atributo é a percentagem da margem de vendas."@pt;
                                <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:domain essglobal:SaleOption;
                                rdfs:isDefinedBy essglobal:;
                                rdfs:label "Sales Margin (percentage)"@en,
                                           "Margem de Vendas (percentagem)"@pt;
                                rdfs:range rdfs:Literal.
essglobal:salesMarginValue <http://purl.org/dc/terms/description> "Margem (em vendas) é a diferença entre o preço de venda e o custo. Esta diferença é normalmente expressa como uma percentagem do preço de venda ou com base por unidade. O presente atributo é um valor absoluto para a margem de vendas em cada uma das unidades do produto ou serviço oferecido no local."@pt,
                                                                  "Margin (on sales) is the difference between selling price and cost. This difference is typically expressed either as a percentage of selling price or on a per-unit basis. The present attribute is an absolute value for sales margin on each unit of the product or service offered in the location."@en;
                           <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                           a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain essglobal:SaleOption;
                           rdfs:isDefinedBy essglobal:;
                           rdfs:label "Margem de Vendas (valor)"@pt,
                                      "Sales Margin (value)"@en;
                           rdfs:range rdfs:Literal.
essglobal:state <http://purl.org/dc/terms/description> "O Estado onde a Localização da Venda está situado."@pt,
                                                       "The State of the Address."@en;
                <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain essglobal:Address;
                rdfs:isDefinedBy essglobal:;
                rdfs:label "State"@en,
                           "Estado"@pt;
                rdfs:range rdfs:Literal.
essglobal:totalMen <http://purl.org/dc/terms/description> "O número de homens que trabalham na Iniciativa ESS."@pt,
                                                          "The number of men that work in the SSE Initiative."@en;
                   <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                   <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                   a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain essglobal:SSEInitiative;
                   rdfs:isDefinedBy essglobal:;
                   rdfs:label "Total of Men"@en,
                              "Total de Homens"@pt;
                   rdfs:range rdfs:Literal.
essglobal:totalOfMembers <http://purl.org/dc/terms/description> "O número total de associados que trabalham na Iniciativa ESS."@pt,
                                                                "The total number of members that work in the SSE Initiative."@en;
                         <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain essglobal:SSEInitiative;
                         rdfs:isDefinedBy essglobal:;
                         rdfs:label "Total of Members"@en,
                                    "Total de Associados"@pt;
                         rdfs:range rdfs:Literal.
essglobal:totalWomen <http://purl.org/dc/terms/description> "O número de mulheres que trabalham na Iniciativa ESS."@pt,
                                                            "The number of women that work in the SSE Initiative."@en;
                     <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain essglobal:SSEInitiative;
                     rdfs:isDefinedBy essglobal:;
                     rdfs:label "Total de Mulheres"@pt,
                                "Total of Women"@en;
                     rdfs:range rdfs:Literal.
essglobal:typeOfLabour <http://purl.org/dc/terms/description> "The human labour dedicated for providing goods or services can be of different types, depending on the established labour relations. For example, it might be associative (i.e., the worker is one of the collective owners of the SSE initiative), but it might also be subordinated work (an employee of the SSE initiative), volunteer work or externally hired work (like a freelancer or a partner initiative)."@en,
                                                              "O trabalho humano dedicado ao fornecimento de bens ou serviços pode ser de diferentes tipos, dependendo das relações de trabalho estabelecidas. Por exemplo, pode ser associativo (i.e., o trabalhador é um dos proprietários coletivos da iniciativa ESS), mas também pode ser trabalho subordinado (um empregado da iniciativa ESS), trabalho voluntário ou trabalho contratado externamente (como um freelancer ou uma iniciativa de parceria)."@pt;
                       <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain essglobal:Labour;
                       rdfs:isDefinedBy essglobal:;
                       rdfs:label "Tipo de Trabalho"@pt,
                                  "Type of Labour"@en;
                       rdfs:range essglobal:TypeOfLabour.
essglobal:unit <http://purl.org/dc/terms/description> "The unit that a product or service is measured in, in the Universal Unit System (e.g., kilograms, hours)"@en,
                                                      "A unidade em que um produto ou serviço é medido, no Sistema Universal de Unidades (e.g., quilogramas, horas)"@pt;
               <http://purl.org/dc/terms/issued> "2014-02-06"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2015-05-04"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain essglobal:Input;
               rdfs:isDefinedBy essglobal:;
               rdfs:label "Unit"@en,
                          "Unidade"@pt;
               rdfs:range rdfs:Literal.
