@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix nanopub: <http://www.nanopub.org/nschema#>.
@prefix trig: <http://www.w3.org/2004/03/trix/rdfg-1/>.

<http://www.nanopub.org/nschema> dc11:created "2012-10-26"^^xsd:date;
                                 dc11:description <http://www.nanopub.org/2013/WD-guidelines-20131215/>;
                                 dc11:modified "2013-10-23"^^xsd:date;
                                 a owl:Ontology;
                                 owl:priorVersion <http://www.nanopub.org/nschema-1.9>.
nanopub:Assertion rdfs:subClassOf trig:Graph.
nanopub:Nanopublication a owl:Class.
nanopub:Provenance rdfs:subClassOf trig:Graph.
nanopub:PublicationInfo rdfs:subClassOf trig:Graph.
nanopub:hasAssertion a owl:FunctionalProperty;
                     rdfs:domain nanopub:Nanopublication;
                     rdfs:range nanopub:Assertion.
nanopub:hasProvenance a owl:FunctionalProperty;
                      rdfs:domain nanopub:Nanopublication;
                      rdfs:range nanopub:Provenance.
nanopub:hasPublicationInfo a owl:FunctionalProperty;
                           rdfs:domain nanopub:Nanopublication;
                           rdfs:range nanopub:PublicationInfo.
