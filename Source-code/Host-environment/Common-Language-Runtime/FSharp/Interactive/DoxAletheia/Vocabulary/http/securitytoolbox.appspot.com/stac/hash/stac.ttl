@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix stac: <http://securitytoolbox.appspot.com/stac#>.

stac: <http://purl.org/dc/elements/1.1/creator> "Amelie Gyrard. Eurecom";
      <http://purl.org/dc/elements/1.1/description> "A vocabulary to describe main security and cryptographic concepts: attacks, security mechanisms, OSI model, security protocols, security tools in numerous technologies: Web applications, network management, Sensor networks, Cellular (2G, 3G, 4G) and Wireless (Wifi), etc. "@en;
      <http://purl.org/dc/elements/1.1/title> "The STAC Ontology (Security Toolbox : Attacks and Countermeasures)"@en;
      <http://purl.org/dc/terms/issued> "2013-04-30"^^xsd:date;
      <http://purl.org/dc/terms/modified> "2013-06-02"^^xsd:date;
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "stac";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://securitytoolbox.appspot.com/stac#";
      a <http://www.w3.org/2002/07/owl#Ontology>,
        <http://purl.org/vocommons/voaf#Vocabulary>;
      rdfs:comment ""@en;
      rdfs:seeAlso """This work has been inspired for the cryptographic concepts and security properties by \"Security in the Semantic Web using OWL\" [Denker et al. 2005]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"Construction d'une ontologie pour le domaine de la securite\" [Lekhchine et al. 2009]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"An ontology of Information Security\" [Herzog et al. 2007]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"Security Ontology for Annotating resources\" [Kim et al. 2005]""";
      <http://www.w3.org/2002/07/owl#versionInfo> 0.2;
      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "Work in progress".
stac:ABAC a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Permissions are associated with a set of rules expressed on measurable parameters and are granted to users who can prove compliance with these rules."@en;
          rdfs:label "Attribute Based Access control (ABAC)"@en;
          rdfs:subClassOf stac:AccessControlMethod.
stac:AccessControlMethod a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Access Control is the mechanism that allows owners of resources to define, manage and enforce access conditions applicable to each resource."@en;
                         rdfs:label "Access Control Method"@en;
                         rdfs:subClassOf stac:SecurityPropertyMethod.
stac:ActiveAttack <http://purl.org/dc/elements/1.1/description> "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Active attacks involve actions performed by adversaries to gain the control of the network."@en;
                  rdfs:label "Active Attack"@en;
                  rdfs:subClassOf stac:Attack.
stac:AnonymityMethod a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Anonymity protects user identity, making it hard to track the whereabouts of a certain user."@en;
                     rdfs:label "Anonymity Method"@en;
                     rdfs:subClassOf stac:SecurityPropertyMethod.
stac:AntiSpam a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment ""@en;
              rdfs:label "Anti Spam"@en;
              rdfs:subClassOf stac:WebSecurityMechanism.
stac:AntiSpyware a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment ""@en;
                 rdfs:label "Anti Spyware"@en;
                 rdfs:subClassOf stac:WebSecurityMechanism.
stac:Antivirus <http://purl.org/dc/elements/1.1/description> "See Paper: A study of information security for M2M and IoT [Jiang et al. 2010]"@en;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Anti-viruses softwares applications will reduce viruses and malware on M2M equipment."@en;
               rdfs:label "Antivirus"@en;
               rdfs:subClassOf stac:IntegrityMethod,
                               stac:NetworkManagementSecurityMechanism,
                               stac:M2MSecurityMechanism,
                               stac:WebSecurityMechanism.
stac:Architecture a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment ""@en;
                  rdfs:label "Architecture"@en.
stac:ArchitectureComponent a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment ""@en;
                           rdfs:label "Architecture component"@en.
stac:AsymmetricAlgorithm <http://purl.org/dc/terms/hasPart> stac:PublicKey,
                                                            <http://securitytoolbox.appspot.com/IndividualKey>,
                                                            stac:PrivateKey;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The keys used for encryption and decryption are different, allowing for easier key distribution."@en;
                         rdfs:label "Asymmetric algorithm"@en;
                         rdfs:seeAlso <http://semanticweb.org/images/5/53/OntologySecurity.owlAsymmetricAlgorithm>,
                                      <http://securitytoolbox.appspot.com/securityAlgorithms#AsymmetricAlgorithm>,
                                      <http://www.ida.liu.se/~iislab/projects/secont/Security.owlPublic-KeyEncryption>,
                                      <http://preciosa.informatik.hu-berlin.de/ontology/security.owlAsymmetric_cryptographic_algorithm>,
                                      <http://securitytoolbox.appspot.com/MASO#Cryptage-asymetrique>;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ExchangeKeyEasy ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> stac:hasFeature ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         stac:EncryptionAlgorithm,
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:HighEnergyConsuming ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> stac:hasFeature ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         stac:AuthenticationMethod.
stac:AsymmetricKey a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment ""@en;
                   rdfs:label "Asymmetric Key"@en.
stac:Attack a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment ""@en;
            rdfs:label "Attack"@en.
stac:AuthenticationMethod a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Authentication prevents unauthorized access to the network."@en;
                          rdfs:label "Authentication Method"@en;
                          rdfs:subClassOf stac:SecurityPropertyMethod.
stac:AuthenticationServer a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "It identifies the supplicant, checks its credentials, and define privileges and restrictions, and allows or denies it access to the network and services."@en;
                          rdfs:label "Authentication Server (AS)"@en;
                          rdfs:subClassOf stac:AuthenticationMethod.
stac:AvailabilityMethod a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Data availability ensures that the network is alive and that data are accessible."@en;
                        rdfs:label "Availability Method"@en;
                        rdfs:subClassOf stac:SecurityPropertyMethod.
stac:Badge a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment ""@en;
           rdfs:label "Badge"@en;
           rdfs:subClassOf stac:PhysicalAuthentication.
stac:Bank a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment ""@en;
          rdfs:label "Bank"@en;
          rdfs:subClassOf stac:DataProvenanceType.
stac:BlockCipher a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment ""@en;
                 rdfs:label "BlockCipher"@en;
                 rdfs:seeAlso <http://semanticweb.org/images/5/53/OntologySecurity.owlBlockCipherAlgorithm>,
                              <http://www.ida.liu.se/~iislab/projects/secont/Security.owlBlockCipher>;
                 rdfs:subClassOf stac:SymmetricAlgorithm.
stac:BluetoothAttack a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment ""@en;
                     rdfs:label "Bluetooth Attack"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:BluetoothSecurityMechanism ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     stac:Attack.
stac:BluetoothSecurityAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment ""@en;
                                rdfs:label "Bluetooth Security Algorithm"@en;
                                rdfs:subClassOf stac:BluetoothSecurityMechanism,
                                                stac:SecurityAlgorithm.
stac:BluetoothSecurityMechanism a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment ""@en;
                                rdfs:label "Bluetooth SecurityMechanism"@en;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:BluetoothTechnology ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                stac:SecurityMechanism.
stac:BluetoothTechnology a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A protocol for short-range (up to 100 meters) wireless networks."@en;
                         rdfs:label "Bluetooth Technology"@en;
                         rdfs:seeAlso <http://www.tele.pw.edu.pl/~sims-onto/ConnectivityType.owl#BluetoothConnectivity>,
                                      <http://ontology.ist-spice.org/mobile-ontology/1/0/service_context/0/service_context.owl#Bluetooth>;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:BluetoothAttack ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         stac:Technology.
stac:CA-RBAC a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "E.g. herat attack is a critical event. Criticaly is a context aware permission."@en;
             rdfs:label "Context Aware Role Based Access Control (CA-RBAC)"@en;
             rdfs:subClassOf stac:AccessControlMethod.
stac:Captcha a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment ""@en;
             rdfs:label "Captcha"@en;
             rdfs:subClassOf stac:WebSecurityMechanism.
stac:ChallengeResponse a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Challenge/Response is a mechanism where on entity in the network proves to another entity that it knows the password without revealing it."@en;
                       rdfs:label "Challenge Response"@en;
                       rdfs:subClassOf stac:AuthenticationMethod.
stac:ChecksumAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment ""@en;
                       rdfs:label "Checksum Algorithm"@en;
                       rdfs:subClassOf stac:IntegrityMethod.
stac:CloudAttack a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment ""@en;
                 rdfs:label "Cloud Attack"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:CloudSecurityMechanism ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 stac:WebAttack.
stac:CloudSecurityMechanism a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment ""@en;
                            rdfs:label "Cloud Security Mechanism"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:CloudTechnology ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            stac:WebSecurityMechanism.
stac:CloudTechnology a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment ""@en;
                     rdfs:label "Cloud Technology"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:CloudAttack ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     stac:WebTechnology.
stac:ConfidentialityMethod a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Confidentiality means that only destined user must be able to read data."@en;
                           rdfs:label "Confidentiality Method"@en;
                           rdfs:subClassOf stac:SecurityPropertyMethod.
stac:CounterValue a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Since the counter value is incremented after each message, the same message is encrypted differently each time."@en;
                  rdfs:label "Counter Value"@en;
                  rdfs:subClassOf stac:DataFreshnessMethod.
stac:CryptographicConcept a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment ""@en;
                          rdfs:label "CryptographicConcept"@en;
                          rdfs:subClassOf stac:SecurityMechanism.
stac:DAC a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Object owners can add access rights."@en;
         rdfs:label "Discretionary Access Control (DAC)"@en;
         rdfs:subClassOf stac:AccessControlMethod.
stac:DataFreshnessMethod a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Data freshness suggests that the data is recent, and it ensures that no old messages have been replayed."@en;
                         rdfs:label "Data Freshness Method"@en;
                         rdfs:subClassOf stac:SecurityPropertyMethod.
stac:DataProvenanceType a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment ""@en;
                        rdfs:label "DataProvenanceType"@en.
stac:DataTypeSensitive a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "DataTypeSensitive (low, medium or high sensitive). The data to secure."@en;
                       rdfs:label "DataTypeSensitive"@en.
stac:DatabaseAttack a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment ""@en;
                    rdfs:label "Database Attack"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:DatabaseSecurityMechanism ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    stac:WebAttack.
stac:DatabaseSecurityMechanism a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment ""@en;
                               rdfs:label "Database Security Mechanism"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:DatabaseTechnology ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               stac:WebSecurityMechanism.
stac:DatabaseTechnology a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment ""@en;
                        rdfs:label "Database Technology"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:DatabaseAttack ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        stac:WebTechnology.
stac:DigitalCertificate a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment ""@en;
                        rdfs:label "Digital Certificate"@en;
                        rdfs:subClassOf stac:AuthenticationMethod.
stac:DigitalSignature <http://purl.org/dc/terms/hasPart> stac:AsymmetricAlgorithm;
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The digital signature verifies that the contents of the electronic message have not been altered."@en;
                      rdfs:label "Digital Signature"@en;
                      rdfs:subClassOf stac:NonRepudiationMethod,
                                      stac:AuthenticationMethod,
                                      stac:IntegrityMethod,
                                      stac:CryptographicConcept.
stac:ECommerceAttack a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment ""@en;
                     rdfs:label "ECommerce Attack"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ECommerceSecurityMechanism ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     stac:WebAttack.
stac:ECommerceMechanism a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment ""@en;
                        rdfs:label "ECommerce Mechanism"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ECommerceTechnology ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        stac:WebSecurityMechanism.
stac:ECommerceTechnology a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment ""@en;
                         rdfs:label "ECommerce Technology"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ECommerceAttack ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         stac:WebTechnology.
stac:EDGEAttack a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment ""@en;
                rdfs:label "EDGE Attack"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EDGESecurityMechanism ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                stac:Attack.
stac:EDGESecurityMechanism a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment ""@en;
                           rdfs:label "EDGE SecurityMechanism"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EDGETechnology ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           stac:SecurityMechanism.
stac:EDGETechnology a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Enhanced Data Rates for GSM Evolution (EDGE) or 2.75G"@en;
                    rdfs:label "Enhanced Data Rates for GSM Evolution (EDGE) or 2.75G"@en;
                    rdfs:seeAlso <http://www.tele.pw.edu.pl/~sims-onto/ConnectivityType.owl#EDGE>;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EDGEAttack ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:UMTSTechnology ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> stac:isReplacedBy ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    stac:Technology.
stac:EncryptionAlgorithm a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Encryption algorithm ensures the confidentiality property."@en;
                         rdfs:label "Encryption Algorithm"@en;
                         rdfs:seeAlso <http://securitytoolbox.appspot.com/securityAlgorithms#EncryptionAlgorithm>;
                         rdfs:subClassOf stac:ConfidentialityMethod,
                                         stac:CryptographicConcept,
                                         stac:SecurityAlgorithm.
stac:EthernetAttack a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment ""@en;
                    rdfs:label "Ethernet Attack"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EthernetSecurityMechanism ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    stac:Attack.
stac:EthernetSecurityMechanism a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment ""@en;
                               rdfs:label "Ethernet SecurityMechanism"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EthernetTechnology ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               stac:SecurityMechanism.
stac:EthernetTechnology a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment ""@en;
                        rdfs:label "Ethernet"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:EthernetAttack ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> stac:hasVulnerability ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:HighCostDeployment ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> stac:hasFeature ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        stac:Technology.
stac:ExternalAttack <http://purl.org/dc/elements/1.1/description> "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment ""@en;
                    rdfs:label "External Attack"@en;
                    rdfs:subClassOf stac:ActiveAttack.
stac:Feature a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Features of security mechanisms. For example a sensor technology is low energy consuming, and the symmetric algorithm (a SecurityMechanism) is low energy consumming."@en;
             rdfs:label "Feature"@en.
stac:Firewall <http://purl.org/dc/elements/1.1/description> "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
              a stac:UMTSSecurityMechanism,
                stac:NetworkManagementSecurityMechanism,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment ""@en;
              rdfs:label "Firewall"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:WebTechnology ; 
                               <http://www.w3.org/2002/07/owl#onProperty> stac:protects ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ApplicationLayer ; 
                               <http://www.w3.org/2002/07/owl#onProperty> stac:protectsInLayer ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              stac:AccessControlMethod.
stac:Flooding <http://purl.org/dc/elements/1.1/description> "See Paper: Survey of Security and Privacy Issues of Internet of Things [Borgohain et al. 2015]"@en;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Floodings attacks generally are used to drain the memry resources by sensing the control signals."@en;
              rdfs:label "Flooding"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:TransportLayer ; 
                               <http://www.w3.org/2002/07/owl#onProperty> stac:occursInLayer ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:ClientPuzzle ; 
                               <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              stac:SensorAttack.
stac:FrameworkAttack a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment ""@en;
                     rdfs:label "Framework Attack"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> stac:FrameworkSecurityMechanism ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> stac:hasSecurityMechanism ; 
