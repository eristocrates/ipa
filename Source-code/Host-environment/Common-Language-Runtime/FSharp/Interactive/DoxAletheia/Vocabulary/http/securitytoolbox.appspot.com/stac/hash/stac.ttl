@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix maso: <http://securitytoolbox.appspot.com/MASO#>.
@prefix algo: <http://securitytoolbox.appspot.com/securityAlgorithms#>.
@prefix security: <http://securitytoolbox.appspot.com/securityMain#>.
@prefix stac: <http://securitytoolbox.appspot.com/stac#>.
@prefix ct: <http://www.tele.pw.edu.pl/~sims-onto/ConnectivityType.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

stac: dc11:creator "Amelie Gyrard. Eurecom";
      dc11:description "A vocabulary to describe main security and cryptographic concepts: attacks, security mechanisms, OSI model, security protocols, security tools in numerous technologies: Web applications, network management, Sensor networks, Cellular (2G, 3G, 4G) and Wireless (Wifi), etc. "@en;
      dc11:title "The STAC Ontology (Security Toolbox : Attacks and Countermeasures)"@en;
      dcterms:issued "2013-04-30"^^xsd:date;
      dcterms:modified "2013-06-02"^^xsd:date;
      vann:preferredNamespacePrefix "stac";
      vann:preferredNamespaceUri "http://securitytoolbox.appspot.com/stac#";
      a owl:Ontology,
        voaf:Vocabulary;
      rdfs:comment ""@en;
      rdfs:seeAlso """This work has been inspired for the cryptographic concepts and security properties by \"Security in the Semantic Web using OWL\" [Denker et al. 2005]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"Construction d'une ontologie pour le domaine de la securite\" [Lekhchine et al. 2009]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"An ontology of Information Security\" [Herzog et al. 2007]""",
                   """This work has been inspired for the cryptographic concepts and security properties by \"Security Ontology for Annotating resources\" [Kim et al. 2005]""";
      owl:versionInfo 0.2;
      status:term_status "Work in progress".
stac:ABAC a owl:Class;
          rdfs:comment "Permissions are associated with a set of rules expressed on measurable parameters and are granted to users who can prove compliance with these rules."@en;
          rdfs:label "Attribute Based Access control (ABAC)"@en;
          rdfs:subClassOf stac:AccessControlMethod.
stac:AccessControlMethod a owl:Class;
                         rdfs:comment "Access Control is the mechanism that allows owners of resources to define, manage and enforce access conditions applicable to each resource."@en;
                         rdfs:label "Access Control Method"@en;
                         rdfs:subClassOf stac:SecurityPropertyMethod.
stac:ActiveAttack dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
                  a owl:Class;
                  rdfs:comment "Active attacks involve actions performed by adversaries to gain the control of the network."@en;
                  rdfs:label "Active Attack"@en;
                  rdfs:subClassOf stac:Attack.
stac:AnonymityMethod a owl:Class;
                     rdfs:comment "Anonymity protects user identity, making it hard to track the whereabouts of a certain user."@en;
                     rdfs:label "Anonymity Method"@en;
                     rdfs:subClassOf stac:SecurityPropertyMethod.
stac:AntiSpam a owl:Class;
              rdfs:comment ""@en;
              rdfs:label "Anti Spam"@en;
              rdfs:subClassOf stac:WebSecurityMechanism.
stac:AntiSpyware a owl:Class;
                 rdfs:comment ""@en;
                 rdfs:label "Anti Spyware"@en;
                 rdfs:subClassOf stac:WebSecurityMechanism.
stac:Antivirus dc11:description "See Paper: A study of information security for M2M and IoT [Jiang et al. 2010]"@en;
               a owl:Class;
               rdfs:comment "Anti-viruses softwares applications will reduce viruses and malware on M2M equipment."@en;
               rdfs:label "Antivirus"@en;
               rdfs:subClassOf stac:IntegrityMethod,
                               stac:NetworkManagementSecurityMechanism,
                               stac:M2MSecurityMechanism,
                               stac:WebSecurityMechanism.
stac:Architecture a owl:Class;
                  rdfs:comment ""@en;
                  rdfs:label "Architecture"@en.
stac:ArchitectureComponent a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "Architecture component"@en.
stac:AsymmetricAlgorithm dcterms:hasPart stac:PublicKey,
                                         <http://securitytoolbox.appspot.com/IndividualKey>,
                                         stac:PrivateKey;
                         a owl:Class;
                         rdfs:comment "The keys used for encryption and decryption are different, allowing for easier key distribution."@en;
                         rdfs:label "Asymmetric algorithm"@en;
                         rdfs:seeAlso <http://semanticweb.org/images/5/53/OntologySecurity.owlAsymmetricAlgorithm>,
                                      algo:AsymmetricAlgorithm,
                                      <http://www.ida.liu.se/~iislab/projects/secont/Security.owlPublic-KeyEncryption>,
                                      <http://preciosa.informatik.hu-berlin.de/ontology/security.owlAsymmetric_cryptographic_algorithm>,
                                      maso:Cryptage-asymetrique;
                         rdfs:subClassOf [owl:someValuesFrom stac:ExchangeKeyEasy ; 
                                          owl:onProperty stac:hasFeature ; 
                                          a owl:Restriction],
                                         stac:EncryptionAlgorithm,
                                         [owl:someValuesFrom stac:HighEnergyConsuming ; 
                                          owl:onProperty stac:hasFeature ; 
                                          a owl:Restriction],
                                         stac:AuthenticationMethod.
stac:AsymmetricKey a owl:Class;
                   rdfs:comment ""@en;
                   rdfs:label "Asymmetric Key"@en.
stac:Attack a owl:Class;
            rdfs:comment ""@en;
            rdfs:label "Attack"@en.
stac:AuthenticationMethod a owl:Class;
                          rdfs:comment "Authentication prevents unauthorized access to the network."@en;
                          rdfs:label "Authentication Method"@en;
                          rdfs:subClassOf stac:SecurityPropertyMethod.
stac:AuthenticationServer a owl:Class;
                          rdfs:comment "It identifies the supplicant, checks its credentials, and define privileges and restrictions, and allows or denies it access to the network and services."@en;
                          rdfs:label "Authentication Server (AS)"@en;
                          rdfs:subClassOf stac:AuthenticationMethod.
stac:AvailabilityMethod a owl:Class;
                        rdfs:comment "Data availability ensures that the network is alive and that data are accessible."@en;
                        rdfs:label "Availability Method"@en;
                        rdfs:subClassOf stac:SecurityPropertyMethod.
stac:Badge a owl:Class;
           rdfs:comment ""@en;
           rdfs:label "Badge"@en;
           rdfs:subClassOf stac:PhysicalAuthentication.
stac:Bank a owl:Class;
          rdfs:comment ""@en;
          rdfs:label "Bank"@en;
          rdfs:subClassOf stac:DataProvenanceType.
stac:BlockCipher a owl:Class;
                 rdfs:comment ""@en;
                 rdfs:label "BlockCipher"@en;
                 rdfs:seeAlso <http://semanticweb.org/images/5/53/OntologySecurity.owlBlockCipherAlgorithm>,
                              <http://www.ida.liu.se/~iislab/projects/secont/Security.owlBlockCipher>;
                 rdfs:subClassOf stac:SymmetricAlgorithm.
stac:BluetoothAttack a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "Bluetooth Attack"@en;
                     rdfs:subClassOf [owl:someValuesFrom stac:BluetoothSecurityMechanism ; 
                                      owl:onProperty stac:hasSecurityMechanism ; 
                                      a owl:Restriction],
                                     stac:Attack.
stac:BluetoothSecurityAlgorithm a owl:Class;
                                rdfs:comment ""@en;
                                rdfs:label "Bluetooth Security Algorithm"@en;
                                rdfs:subClassOf stac:BluetoothSecurityMechanism,
                                                stac:SecurityAlgorithm.
stac:BluetoothSecurityMechanism a owl:Class;
                                rdfs:comment ""@en;
                                rdfs:label "Bluetooth SecurityMechanism"@en;
                                rdfs:subClassOf [owl:someValuesFrom stac:BluetoothTechnology ; 
                                                 owl:onProperty stac:protects ; 
                                                 a owl:Restriction],
                                                stac:SecurityMechanism.
stac:BluetoothTechnology a owl:Class;
                         rdfs:comment "A protocol for short-range (up to 100 meters) wireless networks."@en;
                         rdfs:label "Bluetooth Technology"@en;
                         rdfs:seeAlso ct:BluetoothConnectivity,
                                      <http://ontology.ist-spice.org/mobile-ontology/1/0/service_context/0/service_context.owl#Bluetooth>;
                         rdfs:subClassOf [owl:someValuesFrom stac:BluetoothAttack ; 
                                          owl:onProperty stac:hasVulnerability ; 
                                          a owl:Restriction],
                                         stac:Technology.
stac:CA-RBAC a owl:Class;
             rdfs:comment "E.g. herat attack is a critical event. Criticaly is a context aware permission."@en;
             rdfs:label "Context Aware Role Based Access Control (CA-RBAC)"@en;
             rdfs:subClassOf stac:AccessControlMethod.
stac:Captcha a owl:Class;
             rdfs:comment ""@en;
             rdfs:label "Captcha"@en;
             rdfs:subClassOf stac:WebSecurityMechanism.
stac:ChallengeResponse a owl:Class;
                       rdfs:comment "Challenge/Response is a mechanism where on entity in the network proves to another entity that it knows the password without revealing it."@en;
                       rdfs:label "Challenge Response"@en;
                       rdfs:subClassOf stac:AuthenticationMethod.
stac:ChecksumAlgorithm a owl:Class;
                       rdfs:comment ""@en;
                       rdfs:label "Checksum Algorithm"@en;
                       rdfs:subClassOf stac:IntegrityMethod.
stac:CloudAttack a owl:Class;
                 rdfs:comment ""@en;
                 rdfs:label "Cloud Attack"@en;
                 rdfs:subClassOf [owl:someValuesFrom stac:CloudSecurityMechanism ; 
                                  owl:onProperty stac:hasSecurityMechanism ; 
                                  a owl:Restriction],
                                 stac:WebAttack.
stac:CloudSecurityMechanism a owl:Class;
                            rdfs:comment ""@en;
                            rdfs:label "Cloud Security Mechanism"@en;
                            rdfs:subClassOf [owl:someValuesFrom stac:CloudTechnology ; 
                                             owl:onProperty stac:protects ; 
                                             a owl:Restriction],
                                            stac:WebSecurityMechanism.
stac:CloudTechnology a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "Cloud Technology"@en;
                     rdfs:subClassOf [owl:someValuesFrom stac:CloudAttack ; 
                                      owl:onProperty stac:hasVulnerability ; 
                                      a owl:Restriction],
                                     stac:WebTechnology.
stac:ConfidentialityMethod a owl:Class;
                           rdfs:comment "Confidentiality means that only destined user must be able to read data."@en;
                           rdfs:label "Confidentiality Method"@en;
                           rdfs:subClassOf stac:SecurityPropertyMethod.
stac:CounterValue a owl:Class;
                  rdfs:comment "Since the counter value is incremented after each message, the same message is encrypted differently each time."@en;
                  rdfs:label "Counter Value"@en;
                  rdfs:subClassOf stac:DataFreshnessMethod.
stac:CryptographicConcept a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "CryptographicConcept"@en;
                          rdfs:subClassOf stac:SecurityMechanism.
stac:DAC a owl:Class;
         rdfs:comment "Object owners can add access rights."@en;
         rdfs:label "Discretionary Access Control (DAC)"@en;
         rdfs:subClassOf stac:AccessControlMethod.
stac:DataFreshnessMethod a owl:Class;
                         rdfs:comment "Data freshness suggests that the data is recent, and it ensures that no old messages have been replayed."@en;
                         rdfs:label "Data Freshness Method"@en;
                         rdfs:subClassOf stac:SecurityPropertyMethod.
stac:DataProvenanceType a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "DataProvenanceType"@en.
stac:DataTypeSensitive a owl:Class;
                       rdfs:comment "DataTypeSensitive (low, medium or high sensitive). The data to secure."@en;
                       rdfs:label "DataTypeSensitive"@en.
stac:DatabaseAttack a owl:Class;
                    rdfs:comment ""@en;
                    rdfs:label "Database Attack"@en;
                    rdfs:subClassOf [owl:someValuesFrom stac:DatabaseSecurityMechanism ; 
                                     owl:onProperty stac:hasSecurityMechanism ; 
                                     a owl:Restriction],
                                    stac:WebAttack.
stac:DatabaseSecurityMechanism a owl:Class;
                               rdfs:comment ""@en;
                               rdfs:label "Database Security Mechanism"@en;
                               rdfs:subClassOf [owl:someValuesFrom stac:DatabaseTechnology ; 
                                                owl:onProperty stac:protects ; 
                                                a owl:Restriction],
                                               stac:WebSecurityMechanism.
stac:DatabaseTechnology a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "Database Technology"@en;
                        rdfs:subClassOf [owl:someValuesFrom stac:DatabaseAttack ; 
                                         owl:onProperty stac:hasVulnerability ; 
                                         a owl:Restriction],
                                        stac:WebTechnology.
stac:DigitalCertificate a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "Digital Certificate"@en;
                        rdfs:subClassOf stac:AuthenticationMethod.
stac:DigitalSignature dcterms:hasPart stac:AsymmetricAlgorithm;
                      a owl:Class;
                      rdfs:comment "The digital signature verifies that the contents of the electronic message have not been altered."@en;
                      rdfs:label "Digital Signature"@en;
                      rdfs:subClassOf stac:NonRepudiationMethod,
                                      stac:AuthenticationMethod,
                                      stac:IntegrityMethod,
                                      stac:CryptographicConcept.
stac:ECommerceAttack a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "ECommerce Attack"@en;
                     rdfs:subClassOf [owl:someValuesFrom stac:ECommerceSecurityMechanism ; 
                                      owl:onProperty stac:hasSecurityMechanism ; 
                                      a owl:Restriction],
                                     stac:WebAttack.
stac:ECommerceMechanism a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "ECommerce Mechanism"@en;
                        rdfs:subClassOf [owl:someValuesFrom stac:ECommerceTechnology ; 
                                         owl:onProperty stac:protects ; 
                                         a owl:Restriction],
                                        stac:WebSecurityMechanism.
stac:ECommerceTechnology a owl:Class;
                         rdfs:comment ""@en;
                         rdfs:label "ECommerce Technology"@en;
                         rdfs:subClassOf [owl:someValuesFrom stac:ECommerceAttack ; 
                                          owl:onProperty stac:hasVulnerability ; 
                                          a owl:Restriction],
                                         stac:WebTechnology.
stac:EDGEAttack a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "EDGE Attack"@en;
                rdfs:subClassOf [owl:someValuesFrom stac:EDGESecurityMechanism ; 
                                 owl:onProperty stac:hasSecurityMechanism ; 
                                 a owl:Restriction],
                                stac:Attack.
stac:EDGESecurityMechanism a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "EDGE SecurityMechanism"@en;
                           rdfs:subClassOf [owl:someValuesFrom stac:EDGETechnology ; 
                                            owl:onProperty stac:protects ; 
                                            a owl:Restriction],
                                           stac:SecurityMechanism.
stac:EDGETechnology a owl:Class;
                    rdfs:comment "Enhanced Data Rates for GSM Evolution (EDGE) or 2.75G"@en;
                    rdfs:label "Enhanced Data Rates for GSM Evolution (EDGE) or 2.75G"@en;
                    rdfs:seeAlso ct:EDGE;
                    rdfs:subClassOf [owl:someValuesFrom stac:EDGEAttack ; 
                                     owl:onProperty stac:hasVulnerability ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:UMTSTechnology ; 
                                     owl:onProperty stac:isReplacedBy ; 
                                     a owl:Restriction],
                                    stac:Technology.
stac:EncryptionAlgorithm a owl:Class;
                         rdfs:comment "Encryption algorithm ensures the confidentiality property."@en;
                         rdfs:label "Encryption Algorithm"@en;
                         rdfs:seeAlso algo:EncryptionAlgorithm;
                         rdfs:subClassOf stac:ConfidentialityMethod,
                                         stac:CryptographicConcept,
                                         stac:SecurityAlgorithm.
stac:EthernetAttack a owl:Class;
                    rdfs:comment ""@en;
                    rdfs:label "Ethernet Attack"@en;
                    rdfs:subClassOf [owl:someValuesFrom stac:EthernetSecurityMechanism ; 
                                     owl:onProperty stac:hasSecurityMechanism ; 
                                     a owl:Restriction],
                                    stac:Attack.
stac:EthernetSecurityMechanism a owl:Class;
                               rdfs:comment ""@en;
                               rdfs:label "Ethernet SecurityMechanism"@en;
                               rdfs:subClassOf [owl:someValuesFrom stac:EthernetTechnology ; 
                                                owl:onProperty stac:protects ; 
                                                a owl:Restriction],
                                               stac:SecurityMechanism.
stac:EthernetTechnology a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "Ethernet"@en;
                        rdfs:subClassOf [owl:someValuesFrom stac:EthernetAttack ; 
                                         owl:onProperty stac:hasVulnerability ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom stac:HighCostDeployment ; 
                                         owl:onProperty stac:hasFeature ; 
                                         a owl:Restriction],
                                        stac:Technology.
stac:ExternalAttack dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
                    a owl:Class;
                    rdfs:comment ""@en;
                    rdfs:label "External Attack"@en;
                    rdfs:subClassOf stac:ActiveAttack.
stac:Feature a owl:Class;
             rdfs:comment "Features of security mechanisms. For example a sensor technology is low energy consuming, and the symmetric algorithm (a SecurityMechanism) is low energy consumming."@en;
             rdfs:label "Feature"@en.
stac:Firewall dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
              a stac:UMTSSecurityMechanism,
                stac:NetworkManagementSecurityMechanism,
                owl:Class;
              rdfs:comment ""@en;
              rdfs:label "Firewall"@en;
              rdfs:subClassOf [owl:someValuesFrom stac:WebTechnology ; 
                               owl:onProperty stac:protects ; 
                               a owl:Restriction],
                              [owl:someValuesFrom stac:ApplicationLayer ; 
                               owl:onProperty stac:protectsInLayer ; 
                               a owl:Restriction],
                              stac:AccessControlMethod.
stac:Flooding dc11:description "See Paper: Survey of Security and Privacy Issues of Internet of Things [Borgohain et al. 2015]"@en;
              a owl:Class;
              rdfs:comment "Floodings attacks generally are used to drain the memry resources by sensing the control signals."@en;
              rdfs:label "Flooding"@en;
              rdfs:subClassOf [owl:someValuesFrom stac:TransportLayer ; 
                               owl:onProperty stac:occursInLayer ; 
                               a owl:Restriction],
                              [owl:someValuesFrom stac:ClientPuzzle ; 
                               owl:onProperty stac:hasSecurityMechanism ; 
                               a owl:Restriction],
                              stac:SensorAttack.
stac:FrameworkAttack a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "Framework Attack"@en;
                     rdfs:subClassOf [owl:someValuesFrom stac:FrameworkSecurityMechanism ; 
                                      owl:onProperty stac:hasSecurityMechanism ; 
                                      a owl:Restriction],
                                     stac:WebAttack.
stac:FrameworkSecurityMechanism a owl:Class;
                                rdfs:comment ""@en;
                                rdfs:label "Framework Security Mechanism"@en;
                                rdfs:subClassOf [owl:someValuesFrom stac:FrameworkTechnology ; 
                                                 owl:onProperty stac:protects ; 
                                                 a owl:Restriction],
                                                stac:WebSecurityMechanism.
stac:FrameworkTechnology a owl:Class;
                         rdfs:comment ""@en;
                         rdfs:label "Framework Technology"@en;
                         rdfs:subClassOf [owl:someValuesFrom stac:FrameworkAttack ; 
                                          owl:onProperty stac:hasVulnerability ; 
                                          a owl:Restriction],
                                         stac:WebTechnology.
stac:GPRSArchitecture a owl:Class;
                      rdfs:comment "The GPRS system are a much more expesed to intruders, because of its IP based backbone."@en;
                      rdfs:label "GPRS Architecture"@en;
                      rdfs:subClassOf stac:Architecture.
stac:GPRSArchitectureComponent a owl:Class;
                               rdfs:comment ""@en;
                               rdfs:label "GPRS Architecture component"@en;
                               rdfs:subClassOf stac:ArchitectureComponent.
stac:GPRSAttack a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "GPRS Attack"@en;
                rdfs:subClassOf [owl:someValuesFrom stac:GPRSSecurityMechanism ; 
                                 owl:onProperty stac:hasSecurityMechanism ; 
                                 a owl:Restriction],
                                stac:Attack.
stac:GPRSSecurityAlgorithm a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "GPRS Security Algorithm"@en;
                           rdfs:subClassOf stac:GPRSSecurityMechanism,
                                           stac:SecurityAlgorithm.
stac:GPRSSecurityMechanism a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "GPRS SecurityMechanism"@en;
                           rdfs:subClassOf [owl:someValuesFrom stac:GPRSTechnology ; 
                                            owl:onProperty stac:protects ; 
                                            a owl:Restriction],
                                           stac:SecurityMechanism.
stac:GPRSTechnology a owl:Class;
                    rdfs:comment "General Packet Radio Service (GPRS) or 2.5G"@en;
                    rdfs:label "General Packet Radio Service (GPRS) or 2.5G"@en;
                    rdfs:seeAlso ct:GPRS;
                    rdfs:subClassOf [owl:someValuesFrom stac:GPRSAttack ; 
                                     owl:onProperty stac:hasVulnerability ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:GPRSArchitecture ; 
                                     owl:onProperty stac:hasArchitecture ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:EDGETechnology ; 
                                     owl:onProperty stac:isReplacedBy ; 
                                     a owl:Restriction],
                                    stac:Technology.
stac:GSMArchitecture a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "GSM Architecture"@en;
                     rdfs:subClassOf stac:Architecture.
stac:GSMArchitectureComponent a owl:Class;
                              rdfs:comment ""@en;
                              rdfs:label "GSM Architecture component"@en;
                              rdfs:subClassOf stac:ArchitectureComponent.
stac:GSMAttack a owl:Class;
               rdfs:comment ""@en;
               rdfs:label "GSM Attack"@en;
               rdfs:subClassOf [owl:someValuesFrom stac:GSMSecurityMechanism ; 
                                owl:onProperty stac:hasSecurityMechanism ; 
                                a owl:Restriction],
                               stac:Attack.
stac:GSMKeyManagement a owl:Class;
                      rdfs:comment ""@en;
                      rdfs:label "GSM Key Management"@en;
                      rdfs:subClassOf stac:GSMSecurityMechanism,
                                      stac:KeyManagement.
stac:GSMSecurityAlgorithm a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "GSM Security Algorithm"@en;
                          rdfs:subClassOf stac:GSMSecurityMechanism,
                                          stac:SecurityAlgorithm.
stac:GSMSecurityMechanism a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "GSM SecurityMechanism"@en;
                          rdfs:subClassOf [owl:someValuesFrom stac:GSMTechnology ; 
                                           owl:onProperty stac:protects ; 
                                           a owl:Restriction],
                                          stac:SecurityMechanism.
stac:GSMSecurityProtocol a owl:Class;
                         rdfs:comment ""@en;
                         rdfs:label "GSM Security Protocol"@en;
                         rdfs:subClassOf stac:GSMSecurityMechanism,
                                         stac:Protocol.
stac:GSMTechnology a owl:Class;
                   rdfs:comment "Global System for Mobile Communication (GSM) or 2G"@en;
                   rdfs:label "Global System for Mobile Communication (GSM) or 2G"@en;
                   rdfs:seeAlso <http://ontology.ist-spice.org/mobile-ontology/1/0/service_context/0/service_context.owl#GSM>;
                   rdfs:subClassOf [owl:someValuesFrom stac:GSMAttack ; 
                                    owl:onProperty stac:hasVulnerability ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom stac:GSMArchitecture ; 
                                    owl:onProperty stac:hasArchitecture ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom stac:GPRSTechnology ; 
                                    owl:onProperty stac:isReplacedBy ; 
                                    a owl:Restriction],
                                   stac:Technology.
stac:HSPDAAttack a owl:Class;
                 rdfs:comment ""@en;
                 rdfs:label "HSPDA Attack"@en;
                 rdfs:subClassOf [owl:someValuesFrom stac:HSPDASecurityMechanism ; 
                                  owl:onProperty stac:hasSecurityMechanism ; 
                                  a owl:Restriction],
                                 stac:Attack.
stac:HSPDASecurityMechanism a owl:Class;
                            rdfs:comment ""@en;
                            rdfs:label "HSPDA SecurityMechanism"@en;
                            rdfs:subClassOf [owl:someValuesFrom stac:HSPDATechnology ; 
                                             owl:onProperty stac:protects ; 
                                             a owl:Restriction],
                                            stac:SecurityMechanism.
