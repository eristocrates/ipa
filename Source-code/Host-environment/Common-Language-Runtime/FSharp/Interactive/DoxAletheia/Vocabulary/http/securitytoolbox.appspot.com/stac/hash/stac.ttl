stac:hasArchitecture a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "A technology has a specific architecture."@en;
                     rdfs:domain stac:Technology;
                     rdfs:label "hasArchitecture"@en;
                     rdfs:range stac:Architecture.
stac:hasFeature a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A SecurityMechanism has specific features (secured, depreceted, low energy consuming). For example, an asymmetric algorithm is high energy consuming."@en;
                rdfs:domain stac:SecurityMechanism;
                rdfs:label "hasFeature"@en;
                rdfs:range stac:Feature;
                <http://www.w3.org/2002/07/owl#inverseOf> stac:isFeatureOf.
stac:hasModeOperation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment ""@en;
                      rdfs:domain stac:SymmetricAlgorithm;
                      rdfs:label "hasModeOperation"@en;
                      rdfs:range stac:ModeOperation.
stac:hasSecurityMechanism a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment ""@en;
                          rdfs:domain stac:Attack;
                          rdfs:label "hasSecurityMechanism"@en;
                          rdfs:range stac:SecurityMechanism;
                          <http://www.w3.org/2002/07/owl#inverseOf> stac:isSecurityMechanismOf.
stac:hasVulnerability a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "A technology can be vulnerable to some attacks."@en;
                      rdfs:domain stac:Technology;
                      rdfs:label "has vulnerability"@en;
                      rdfs:range stac:Attack;
                      <http://www.w3.org/2002/07/owl#inverseOf> stac:isVulnerabilityOf.
stac:isFeatureOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Features are related to security mechanisms. For example, an asymmetric algorithm is high energy consuming."@en;
                 rdfs:domain stac:Feature;
                 rdfs:label "isFeatureOf"@en;
                 rdfs:range stac:SecurityMechanism;
                 <http://www.w3.org/2002/07/owl#inverseOf> stac:hasFeature.
stac:isProtectedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment ""@en;
                   rdfs:domain stac:Technology;
                   rdfs:label "isProtectedBy"@en;
                   rdfs:range stac:SecurityMechanism;
                   <http://www.w3.org/2002/07/owl#inverseOf> stac:protects.
stac:isReplacedBy a <http://www.w3.org/2002/07/owl#ReflexiveProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "When a SecurityMechanism is not secured anymore, it is replaced by a more secure SecurityMechanism. This is also the case for technologies: a technology can be replaced by another one more recent. (E.G., 2G has been replaced by 3G)"@en;
                  rdfs:domain stac:SecurityMechanism;
                  rdfs:label "isReplacedBy"@en;
                  rdfs:range stac:SecurityMechanism.
stac:isSecurityMechanismOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment ""@en;
                           rdfs:domain stac:SecurityMechanism;
                           rdfs:label "isSecurityMechanismOf"@en;
                           rdfs:range stac:Attack;
                           <http://www.w3.org/2002/07/owl#inverseOf> stac:hasSecurityMechanism.
stac:isVulnerabilityOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Some attacks cannot be thwart in technologies. For example, the Denial of Service is difficult to thwart in different technologies."@en;
                       rdfs:domain stac:Attack;
                       rdfs:label "is Vulnerability Of"@en;
                       rdfs:range stac:Technology;
                       <http://www.w3.org/2002/07/owl#inverseOf> stac:hasVulnerability.
stac:occursInLayer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment ""@en;
                   rdfs:domain stac:Attack;
                   rdfs:label "occursInLayer"@en;
                   rdfs:range stac:OSIModelLayer.
stac:protects a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment ""@en;
              rdfs:domain stac:SecurityMechanism;
              rdfs:label "protects"@en;
              rdfs:range stac:Technology;
              <http://www.w3.org/2002/07/owl#inverseOf> stac:isProtectedBy.
stac:protectsInLayer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment ""@en;
                     rdfs:domain stac:SecurityMechanism;
                     rdfs:label "protectsInLayer"@en;
                     rdfs:range stac:OSIModelLayer.
stac:satisfies a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "A security mechanism (e.g., VPN) satisfies some security properties (e.g., authentication)"@en;
               rdfs:domain stac:SecurityMechanism;
               rdfs:label "satisfies"@en;
               rdfs:range stac:SecurityProperty.
stac:threatens a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "An attack (e.g., eavesdropping) threatens some security properties (e.g., confidentiality)"@en;
               rdfs:domain stac:Attack;
               rdfs:label "threatens"@en;
               rdfs:range stac:SecurityProperty.
