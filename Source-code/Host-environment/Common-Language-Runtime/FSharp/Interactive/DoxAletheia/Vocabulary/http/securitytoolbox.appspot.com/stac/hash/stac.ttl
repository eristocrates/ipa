             rdfs:label "Spyware"@en;
             rdfs:subClassOf stac:WebAttack.
stac:StreamCipher a owl:Class;
                  rdfs:comment ""@en;
                  rdfs:label "StreamCipher"@en;
                  rdfs:seeAlso <http://semanticweb.org/images/5/53/OntologySecurity.owlStreamCipherAlgorithm>,
                               <http://preciosa.informatik.hu-berlin.de/ontology/security.owlStreamCipherAlgorithm>,
                               <http://www.ida.liu.se/~iislab/projects/secont/Security.owlStreamCipher>;
                  rdfs:subClassOf stac:SymmetricAlgorithm.
stac:SymmetricAlgorithm a owl:Class;
                        rdfs:comment "The same secret key is used for encryption and decryption."@en;
                        rdfs:label "Symmetric algorithm"@en;
                        rdfs:seeAlso algo:SymmetricAlgorithm,
                                     <http://preciosa.informatik.hu-berlin.de/ontology/security.owlSymmetricAlgorithm>,
                                     <http://semanticweb.org/images/5/53/OntologySecurity.owlSymmetricAlgorithm>,
                                     maso:Cryptage-symetrique,
                                     <http://www.ida.liu.se/~iislab/projects/secont/Security.owlSymmetricAlgorithm>;
                        rdfs:subClassOf [owl:someValuesFrom stac:LowEnergyConsuming ; 
                                         owl:onProperty stac:hasFeature ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom stac:ExchangeKeyNotEasy ; 
                                         owl:onProperty stac:hasFeature ; 
                                         a owl:Restriction],
                                        stac:EncryptionAlgorithm.
stac:SymmetricKey a owl:Class;
                  rdfs:comment "Symmetric key: the same key is used for encryption and decryption."@en;
                  rdfs:label "Symmetric Key"@en.
stac:SymmetricSensorKey a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "SymmetricSensorKey"@en;
                        rdfs:subClassOf stac:SymmetricKey.
stac:SystemLogs a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "System Logs"@en;
                rdfs:subClassOf stac:NonRepudiationMethod.
stac:Technology a owl:Class;
                rdfs:comment "Technologies can be wireless (Wi-Fi, Wimax), cellular (2G, 3G, 4G), sensor  networks, web application, etc."@en;
                rdfs:label "Technology"@en;
                rdfs:subClassOf stac:Requirement.
stac:TemporaryIdentity a owl:Class;
                       rdfs:comment ""@en;
                       rdfs:label "Temporary Identity"@en;
                       rdfs:subClassOf stac:AnonymityMethod.
stac:Timestamp a owl:Class;
               rdfs:comment "In order to ensure the freshness of packet, a timestamp can be attached to the packet. A receiving node can compare the timestamp in the packet with its own time clock and determine whether the packet is valid or not."@en;
               rdfs:label "Timestamp"@en;
               rdfs:subClassOf stac:DataFreshnessMethod.
stac:Troyan dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
            a owl:Class;
            rdfs:comment "A Trojan horse is a malicious piece of software hidden in a program that performs normal tasks. Program that does something malicious (such as capturing passwords) when run by an unsuspecting user."@en;
            rdfs:label "Troyan"@en;
            rdfs:subClassOf [owl:someValuesFrom stac:WebAttack ; 
                             owl:onProperty stac:isVulnerabilityOf ; 
                             a owl:Restriction],
                            stac:Virus.
stac:UMTSArchitecture a owl:Class;
                      rdfs:comment ""@en;
                      rdfs:label "UMTS Architecture"@en;
                      rdfs:subClassOf stac:Architecture.
stac:UMTSArchitectureComponent a owl:Class;
                               rdfs:comment ""@en;
                               rdfs:label "UMTS Architecture component"@en;
                               rdfs:subClassOf stac:ArchitectureComponent.
stac:UMTSAttack a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "UMTS Attack"@en;
                rdfs:subClassOf [owl:someValuesFrom stac:UMTSSecurityMechanism ; 
                                 owl:onProperty stac:hasSecurityMechanism ; 
                                 a owl:Restriction],
                                stac:Attack.
stac:UMTSKeyManagement a owl:Class;
                       rdfs:comment ""@en;
                       rdfs:label "UMTS Key Management"@en;
                       rdfs:subClassOf stac:UMTSSecurityMechanism,
                                       stac:KeyManagement.
stac:UMTSSecurityAlgorithm a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "UMTS Security Algorithm"@en;
                           rdfs:subClassOf stac:UMTSSecurityMechanism,
                                           stac:SecurityAlgorithm.
stac:UMTSSecurityMechanism a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "UMTS SecurityMechanism"@en;
                           rdfs:subClassOf [owl:someValuesFrom stac:UMTSTechnology ; 
                                            owl:onProperty stac:protects ; 
                                            a owl:Restriction],
                                           stac:SecurityMechanism.
stac:UMTSSecurityProtocol a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "UMTS Security Protocol"@en;
                          rdfs:subClassOf stac:UMTSSecurityMechanism,
                                          stac:Protocol.
stac:UMTSTechnology a owl:Class;
                    rdfs:comment "Universal Mobile Telecommunications System (UMTS). Third Generation (3G)"@en;
                    rdfs:label "3G technology (UMTS:Universal Mobile Telecommunications System)"@en;
                    rdfs:seeAlso ct:UMTS,
                                 <http://ontology.ist-spice.org/mobile-ontology/1/0/service_context/0/service_context.owl#UMTS>;
                    rdfs:subClassOf [owl:someValuesFrom stac:UMTSAttack ; 
                                     owl:onProperty stac:hasVulnerability ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:UMTSArchitecture ; 
                                     owl:onProperty stac:hasArchitecture ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:HSPDATechnology ; 
                                     owl:onProperty stac:isReplacedBy ; 
                                     a owl:Restriction],
                                    stac:Technology.
stac:UwbAttack a owl:Class;
               rdfs:comment ""@en;
               rdfs:label "Uwb Attack"@en;
               rdfs:subClassOf [owl:someValuesFrom stac:UwbSecurityMechanism ; 
                                owl:onProperty stac:hasSecurityMechanism ; 
                                a owl:Restriction],
                               stac:Attack.
stac:UwbSecurityMechanism a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "Uwb SecurityMechanism"@en;
                          rdfs:subClassOf [owl:someValuesFrom stac:UwbTechnology ; 
                                           owl:onProperty stac:protects ; 
                                           a owl:Restriction],
                                          stac:SecurityMechanism.
stac:UwbTechnology a owl:Class;
                   rdfs:comment ""@en;
                   rdfs:label "Ultra Wideband (UWB) Technology"@en;
                   rdfs:subClassOf [owl:someValuesFrom stac:UwbAttack ; 
                                    owl:onProperty stac:hasVulnerability ; 
                                    a owl:Restriction],
                                   stac:Technology.
stac:Virus dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006], Paper: Survey of Security and Privacy Issues of Internet of Things [Borgohain et al. 2015]"@en;
           a owl:Class;
           rdfs:comment ""@en;
           rdfs:label "Virus"@en;
           rdfs:subClassOf stac:GPRSAttack,
                           stac:RfidAttack,
                           [owl:someValuesFrom stac:ApplicationLayer ; 
                            owl:onProperty stac:occursInLayer ; 
                            a owl:Restriction],
                           stac:WebAttack,
                           stac:NetworkManagementAttack,
                           [owl:someValuesFrom stac:Antivirus ; 
                            owl:onProperty stac:hasSecurityMechanism ; 
                            a owl:Restriction].
stac:WebAttack a owl:Class;
               rdfs:comment ""@en;
               rdfs:label "Web Attack"@en;
               rdfs:subClassOf [owl:someValuesFrom stac:ApplicationLayer ; 
                                owl:onProperty stac:occursInLayer ; 
                                a owl:Restriction],
                               [owl:someValuesFrom stac:WebSecurityMechanism ; 
                                owl:onProperty stac:hasSecurityMechanism ; 
                                a owl:Restriction],
                               stac:Attack.
stac:WebSecurityMechanism a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "Web Security Mechanism"@en;
                          rdfs:subClassOf [owl:someValuesFrom stac:ApplicationLayer ; 
                                           owl:onProperty stac:protectsInLayer ; 
                                           a owl:Restriction],
                                          [owl:someValuesFrom stac:WebTechnology ; 
                                           owl:onProperty stac:protects ; 
                                           a owl:Restriction],
                                          stac:SecurityMechanism.
stac:WebSecurityProtocol a owl:Class;
                         rdfs:comment ""@en;
                         rdfs:label "Web Security Protocol"@en;
                         rdfs:subClassOf stac:WebSecurityMechanism,
                                         stac:Protocol.
stac:WebService a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "Web Service"@en;
                rdfs:subClassOf [owl:someValuesFrom stac:WebServiceAttack ; 
                                 owl:onProperty stac:hasVulnerability ; 
                                 a owl:Restriction],
                                stac:WebTechnology.
stac:WebServiceAttack a owl:Class;
                      rdfs:comment ""@en;
                      rdfs:label "Web Service Attack"@en;
                      rdfs:subClassOf [owl:someValuesFrom stac:WebServiceSecurityMechanism ; 
                                       owl:onProperty stac:hasSecurityMechanism ; 
                                       a owl:Restriction],
                                      stac:WebAttack.
stac:WebServiceMechanism a owl:Class;
                         rdfs:comment ""@en;
                         rdfs:label "Web Service Mechanism"@en;
                         rdfs:subClassOf [owl:someValuesFrom stac:WebServiceTechnology ; 
                                          owl:onProperty stac:protects ; 
                                          a owl:Restriction],
                                         stac:WebSecurityMechanism.
stac:WebTechnology a owl:Class;
                   rdfs:comment ""@en;
                   rdfs:label "Web Technology"@en;
                   rdfs:subClassOf [owl:someValuesFrom stac:WebAttack ; 
                                    owl:onProperty stac:hasVulnerability ; 
                                    a owl:Restriction],
                                   stac:Technology.
stac:WifiArchitecture a owl:Class;
                      rdfs:comment ""@en;
                      rdfs:label "Wifi Architecture"@en;
                      rdfs:subClassOf stac:Architecture.
stac:WifiArchitectureComponent a owl:Class;
                               rdfs:comment ""@en;
                               rdfs:label "Wifi Architecture component"@en;
                               rdfs:subClassOf stac:ArchitectureComponent.
stac:WifiAttack a owl:Class;
                rdfs:comment ""@en;
                rdfs:label "Wifi Attack"@en;
                rdfs:subClassOf [owl:someValuesFrom stac:WifiSecurityMechanism ; 
                                 owl:onProperty stac:hasSecurityMechanism ; 
                                 a owl:Restriction],
                                stac:Attack.
stac:WifiAttackTool a owl:Class;
                    rdfs:comment ""@en;
                    rdfs:label "Wifi Attack Tool"@en;
                    rdfs:subClassOf stac:SecurityTool.
stac:WifiKeyManagement a owl:Class;
                       rdfs:comment ""@en;
                       rdfs:label "Wifi Key Management"@en;
                       rdfs:subClassOf stac:WifiSecurityMechanism,
                                       stac:KeyManagement.
stac:WifiSecurityMechanism a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "Wifi SecurityMechanism"@en;
                           rdfs:subClassOf [owl:someValuesFrom stac:WifiTechnology ; 
                                            owl:onProperty stac:protects ; 
                                            a owl:Restriction],
                                           stac:SecurityMechanism.
stac:WifiSecurityProtocol a owl:Class;
                          rdfs:comment ""@en;
                          rdfs:label "Wifi Security Protocol"@en;
                          rdfs:subClassOf stac:WifiSecurityMechanism,
                                          stac:Protocol.
stac:WifiTechnology a owl:Class;
                    rdfs:comment ""@en;
                    rdfs:label " Wi-Fi technology (Wireless-Fidelity)"@en;
                    rdfs:seeAlso ct:WiFiConnectivity;
                    rdfs:subClassOf [owl:someValuesFrom stac:WifiAttack ; 
                                     owl:onProperty stac:hasVulnerability ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:WifiArchitecture ; 
                                     owl:onProperty stac:hasArchitecture ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom stac:LowCostDeployment ; 
                                     owl:onProperty stac:hasFeature ; 
                                     a owl:Restriction],
                                    stac:Technology.
stac:WimaxArchitecture a owl:Class;
                       rdfs:comment ""@en;
                       rdfs:label "WiMAX Architecture"@en;
                       rdfs:subClassOf stac:Architecture.
stac:WimaxArchitectureComponent a owl:Class;
                                rdfs:comment ""@en;
                                rdfs:label "Wimax Architecture component"@en;
                                rdfs:subClassOf stac:ArchitectureComponent.
stac:WimaxAttack a owl:Class;
                 rdfs:comment ""@en;
                 rdfs:label "Wimax Attack"@en;
                 rdfs:subClassOf [owl:someValuesFrom stac:WimaxSecurityMechanism ; 
                                  owl:onProperty stac:hasSecurityMechanism ; 
                                  a owl:Restriction],
                                 stac:Attack.
stac:WimaxKeyManagement a owl:Class;
                        rdfs:comment ""@en;
                        rdfs:label "Wimax Key Management"@en;
                        rdfs:subClassOf stac:WimaxSecurityMechanism,
                                        stac:KeyManagement.
stac:WimaxSecurityMechanism a owl:Class;
                            rdfs:comment ""@en;
                            rdfs:label "Wimax SecurityMechanism"@en;
                            rdfs:subClassOf [owl:someValuesFrom stac:WimaxTechnology ; 
                                             owl:onProperty stac:protects ; 
                                             a owl:Restriction],
                                            stac:SecurityMechanism.
stac:WimaxSecurityProtocol a owl:Class;
                           rdfs:comment ""@en;
                           rdfs:label "Wimax Security Protocol"@en;
                           rdfs:subClassOf stac:WimaxSecurityMechanism,
                                           stac:Protocol.
stac:WimaxTechnology a owl:Class;
                     rdfs:comment ""@en;
                     rdfs:label "Wimax Technology"@en;
                     rdfs:seeAlso ct:WiMAXConnectivity;
                     rdfs:subClassOf [owl:someValuesFrom stac:WimaxAttack ; 
                                      owl:onProperty stac:hasVulnerability ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom stac:WimaxArchitecture ; 
                                      owl:onProperty stac:hasArchitecture ; 
                                      a owl:Restriction],
                                     stac:Technology.
stac:Worm dc11:description "See Paper: Malicious actions against the GPRS technology [Xenakis 2006]"@en;
          a owl:Class;
          rdfs:comment "Worms are self-propagating pieces of malicious software. They propagate from one computer/device to another via a network link."@en;
          rdfs:label "Worm"@en;
          rdfs:subClassOf [owl:someValuesFrom stac:ApplicationLayer ; 
                           owl:onProperty stac:occursInLayer ; 
                           a owl:Restriction],
                          stac:GPRSAttack,
                          stac:WebAttack.
stac:ZigbeeAttack a owl:Class;
                  rdfs:comment ""@en;
                  rdfs:label "Zigbee Attack"@en;
                  rdfs:subClassOf [owl:someValuesFrom stac:ZigbeeSecurityMechanism ; 
                                   owl:onProperty stac:hasSecurityMechanism ; 
                                   a owl:Restriction],
                                  stac:Attack.
stac:ZigbeeSecurityMechanism a owl:Class;
                             rdfs:comment ""@en;
                             rdfs:label "Zigbee SecurityMechanism"@en;
                             rdfs:subClassOf [owl:someValuesFrom stac:ZigbeeTechnology ; 
                                              owl:onProperty stac:protects ; 
                                              a owl:Restriction],
                                             stac:SecurityMechanism.
stac:ZigbeeTechnology a owl:Class;
                      rdfs:comment ""@en;
                      rdfs:label "Zigbee Technology"@en;
                      rdfs:subClassOf [owl:someValuesFrom stac:ZigbeeAttack ; 
                                       owl:onProperty stac:hasVulnerability ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom stac:Scalable ; 
                                       owl:onProperty stac:hasFeature ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom stac:LowEnergyConsuming ; 
                                       owl:onProperty stac:hasFeature ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom stac:LowCost ; 
                                       owl:onProperty stac:hasFeature ; 
                                       a owl:Restriction],
                                      stac:Technology.
stac:hasArchitecture a owl:ObjectProperty;
                     rdfs:comment "A technology has a specific architecture."@en;
                     rdfs:domain stac:Technology;
                     rdfs:label "hasArchitecture"@en;
                     rdfs:range stac:Architecture.
stac:hasFeature a owl:ObjectProperty;
                rdfs:comment "A SecurityMechanism has specific features (secured, depreceted, low energy consuming). For example, an asymmetric algorithm is high energy consuming."@en;
                rdfs:domain stac:SecurityMechanism;
                rdfs:label "hasFeature"@en;
                rdfs:range stac:Feature;
                owl:inverseOf stac:isFeatureOf.
stac:hasModeOperation a owl:ObjectProperty;
                      rdfs:comment ""@en;
                      rdfs:domain stac:SymmetricAlgorithm;
                      rdfs:label "hasModeOperation"@en;
                      rdfs:range stac:ModeOperation.
stac:hasSecurityMechanism a owl:ObjectProperty;
                          rdfs:comment ""@en;
                          rdfs:domain stac:Attack;
                          rdfs:label "hasSecurityMechanism"@en;
                          rdfs:range stac:SecurityMechanism;
                          owl:inverseOf stac:isSecurityMechanismOf.
stac:hasVulnerability a owl:ObjectProperty;
                      rdfs:comment "A technology can be vulnerable to some attacks."@en;
                      rdfs:domain stac:Technology;
                      rdfs:label "has vulnerability"@en;
                      rdfs:range stac:Attack;
                      owl:inverseOf stac:isVulnerabilityOf.
stac:isFeatureOf a owl:ObjectProperty;
                 rdfs:comment "Features are related to security mechanisms. For example, an asymmetric algorithm is high energy consuming."@en;
                 rdfs:domain stac:Feature;
                 rdfs:label "isFeatureOf"@en;
                 rdfs:range stac:SecurityMechanism;
                 owl:inverseOf stac:hasFeature.
stac:isProtectedBy a owl:ObjectProperty;
                   rdfs:comment ""@en;
                   rdfs:domain stac:Technology;
                   rdfs:label "isProtectedBy"@en;
                   rdfs:range stac:SecurityMechanism;
                   owl:inverseOf stac:protects.
stac:isReplacedBy a owl:ReflexiveProperty,
                    owl:ObjectProperty;
                  rdfs:comment "When a SecurityMechanism is not secured anymore, it is replaced by a more secure SecurityMechanism. This is also the case for technologies: a technology can be replaced by another one more recent. (E.G., 2G has been replaced by 3G)"@en;
                  rdfs:domain stac:SecurityMechanism;
                  rdfs:label "isReplacedBy"@en;
                  rdfs:range stac:SecurityMechanism.
stac:isSecurityMechanismOf a owl:ObjectProperty;
                           rdfs:comment ""@en;
                           rdfs:domain stac:SecurityMechanism;
                           rdfs:label "isSecurityMechanismOf"@en;
                           rdfs:range stac:Attack;
                           owl:inverseOf stac:hasSecurityMechanism.
stac:isVulnerabilityOf a owl:ObjectProperty;
                       rdfs:comment "Some attacks cannot be thwart in technologies. For example, the Denial of Service is difficult to thwart in different technologies."@en;
                       rdfs:domain stac:Attack;
                       rdfs:label "is Vulnerability Of"@en;
                       rdfs:range stac:Technology;
                       owl:inverseOf stac:hasVulnerability.
stac:occursInLayer a owl:ObjectProperty;
                   rdfs:comment ""@en;
                   rdfs:domain stac:Attack;
                   rdfs:label "occursInLayer"@en;
                   rdfs:range stac:OSIModelLayer.
stac:protects a owl:ObjectProperty;
              rdfs:comment ""@en;
              rdfs:domain stac:SecurityMechanism;
              rdfs:label "protects"@en;
              rdfs:range stac:Technology;
              owl:inverseOf stac:isProtectedBy.
stac:protectsInLayer a owl:ObjectProperty;
                     rdfs:comment ""@en;
                     rdfs:domain stac:SecurityMechanism;
                     rdfs:label "protectsInLayer"@en;
                     rdfs:range stac:OSIModelLayer.
stac:satisfies a owl:ObjectProperty;
               rdfs:comment "A security mechanism (e.g., VPN) satisfies some security properties (e.g., authentication)"@en;
               rdfs:domain stac:SecurityMechanism;
               rdfs:label "satisfies"@en;
               rdfs:range stac:SecurityProperty.
stac:threatens a owl:ObjectProperty;
               rdfs:comment "An attack (e.g., eavesdropping) threatens some security properties (e.g., confidentiality)"@en;
               rdfs:domain stac:Attack;
               rdfs:label "threatens"@en;
               rdfs:range stac:SecurityProperty.
