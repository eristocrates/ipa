@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gm: <http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry#>.

<http://def.seegrid.csiro.au/isotc211/iso19107/2003/geometry> <http://purl.org/dc/elements/1.1/creator> """Simon Jonathan David COX
CSIRO"""^^rdf:PlainLiteral;
                                                              <http://purl.org/dc/elements/1.1/description> "An OWL representation of part of the model for geometry and space from ISO 19107:2003 Geographic Information - Spatial Schema";
                                                              <http://purl.org/dc/elements/1.1/rights> "Copyright © 2012-2013 CSIRO";
                                                              <http://purl.org/dc/elements/1.1/source> "ISO 19107:2003"^^rdf:PlainLiteral;
                                                              <http://purl.org/dc/elements/1.1/title> "OWL representation of ISO 19107 (Geographic Information - Spatial Schema)";
                                                              <http://purl.org/dc/terms/created> "2010-10-27";
                                                              <http://purl.org/dc/terms/hasPart> gm:Curve,
                                                                                                 gm:Surface,
                                                                                                 gm:Object,
                                                                                                 gm:Position,
                                                                                                 gm:Primitive,
                                                                                                 gm:boundingBox,
                                                                                                 gm:Envelope,
                                                                                                 gm:Complex,
                                                                                                 gm:position,
                                                                                                 gm:Aggregate,
                                                                                                 gm:OrientablePrimitive,
                                                                                                 gm:upperCorner,
                                                                                                 gm:srs,
                                                                                                 gm:coordinates,
                                                                                                 gm:lowerCorner,
                                                                                                 gm:OrientableCurve,
                                                                                                 gm:Solid,
                                                                                                 gm:Point,
                                                                                                 gm:OrientableSurface;
                                                              <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
