@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix osgeom: <http://data.ordnancesurvey.co.uk/ontology/geometry/>.

osgeom: <http://purl.org/dc/elements/1.1/creator> "Ordnance Survey.";
        <http://purl.org/dc/terms/creator> <http://data.ordnancesurvey.co.uk/id/ordnancesurvey>;
        <http://purl.org/dc/terms/publisher> <http://data.ordnancesurvey.co.uk/id/ordnancesurvey>;
        a <http://www.w3.org/2002/07/owl#Ontology>;
        rdfs:comment "A ontology to describe abstract geometries.";
        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
        rdfs:label "Geometry Ontology".
osgeom:1kmGridSquare a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                     rdfs:label "1 km Grid Square".
osgeom:20kmGridSquare a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                      rdfs:label "20km Grid Square".
osgeom:AbstractGeometry a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A superclass of all geometry types such as points, lines and polygons. This is currently a place holder class and likely to change when some standard way of representing geometries in RDF is agreed.";
                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                        rdfs:label "Abstract Geometry";
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> rdf:XMLLiteral ; 
                                         <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> osgeom:asGML ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>].
osgeom:asGML a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "This property relates abstract geometry types to a GML (Geographic Markup Language) representation of that geometry. This GML representation is stored as an rdf:XMLLiteral.";
             rdfs:domain osgeom:AbstractGeometry;
             rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
             rdfs:label "as GML";
             rdfs:range rdf:XMLLiteral.
osgeom:extent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "This relates any object to is two-dimensional geometrical extent.";
              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
              rdfs:label "extent";
              rdfs:range osgeom:AbstractGeometry.
osgeom:hectares a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                rdfs:label "The area of a geometry in hectres.",
                           "hectres";
                rdfs:range xsd:double.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
