@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix osgb: <http://data.ordnancesurvey.co.uk/id/>.
@prefix osgeom: <http://data.ordnancesurvey.co.uk/ontology/geometry/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

osgeom: dc11:creator "Ordnance Survey.";
        dcterms:creator osgb:ordnancesurvey;
        dcterms:publisher osgb:ordnancesurvey;
        a owl:Ontology;
        rdfs:comment "A ontology to describe abstract geometries.";
        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
        rdfs:label "Geometry Ontology".
osgeom:1kmGridSquare a owl:Class;
                     rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                     rdfs:label "1 km Grid Square".
osgeom:20kmGridSquare a owl:Class;
                      rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                      rdfs:label "20km Grid Square".
osgeom:AbstractGeometry a owl:Class;
                        rdfs:comment "A superclass of all geometry types such as points, lines and polygons. This is currently a place holder class and likely to change when some standard way of representing geometries in RDF is agreed.";
                        rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                        rdfs:label "Abstract Geometry";
                        rdfs:subClassOf [owl:onDataRange rdf:XMLLiteral ; 
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty osgeom:asGML ; 
                                         a owl:Restriction].
osgeom:asGML a owl:DatatypeProperty;
             rdfs:comment "This property relates abstract geometry types to a GML (Geographic Markup Language) representation of that geometry. This GML representation is stored as an rdf:XMLLiteral.";
             rdfs:domain osgeom:AbstractGeometry;
             rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
             rdfs:label "as GML";
             rdfs:range rdf:XMLLiteral.
osgeom:extent a owl:ObjectProperty;
              rdfs:comment "This relates any object to is two-dimensional geometrical extent.";
              rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
              rdfs:label "extent";
              rdfs:range osgeom:AbstractGeometry.
osgeom:hectares a owl:FunctionalProperty,
                  owl:DatatypeProperty;
                rdfs:isDefinedBy <http://www.ordnancesurvey.co.uk/ontology/geometry.owl>;
                rdfs:label "The area of a geometry in hectres.",
                           "hectres";
                rdfs:range xsd:double.
dc11:creator a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
