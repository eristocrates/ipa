cff:top_of_dry_convection ssnx:hasProperty cfp:altitude_at_top_of_dry_convection;
                          a cff:Surface;
                          rdfs:label "top of dry convection".
cff:tropopause ssnx:hasProperty cfp:tropopause_net_downward_shortwave_flux,
                                cfp:tropopause_net_downward_longwave_flux,
                                cfp:tropopause_altitude,
                                cfp:tropopause_downwelling_longwave_flux,
                                cfp:tropopause_adjusted_shortwave_forcing,
                                cfp:tropopause_instantaneous_shortwave_forcing,
                                cfp:tropopause_instantaneous_radiative_forcing,
                                cfp:tropopause_upwelling_shortwave_flux,
                                cfp:tropopause_adjusted_longwave_forcing,
                                cfp:tropopause_instantaneous_longwave_forcing,
                                cfp:tropopause_adjusted_radiative_forcing;
               a cff:Surface;
               rdfs:label "tropopause".
cff:tropopause_air ssnx:hasProperty cfp:tropopause_air_pressure,
                                    cfp:tropopause_air_temperature;
                   a cff:SurfaceMedium;
                   rdfs:label "tropopause air".
cff:troposphere ssnx:hasProperty cfp:tendency_of_troposphere_moles_of_carbon_monoxide,
                                 cfp:tendency_of_troposphere_moles_of_hcc140a,
                                 cfp:tendency_of_troposphere_moles_of_hcfc22,
                                 cfp:tendency_of_troposphere_moles_of_methane,
                                 cfp:tendency_of_troposphere_moles_of_methyl_bromide,
                                 cfp:tendency_of_troposphere_moles_of_methyl_chloride,
                                 cfp:tendency_of_troposphere_moles_of_molecular_hydrogen;
                a cff:Layer;
                rdfs:label "troposphere".
cff:vegetation ssnx:hasProperty cfp:vegetation_area_fraction,
                                cfp:vegetation_carbon_content;
               a cff:Layer;
               rdfs:label "vegetation".
cff:water ssnx:hasProperty cfp:sound_intensity_in_water,
                           cfp:sound_pressure_in_water;
          a cff:Medium;
          rdfs:label "water".
cff:wind ssnx:hasProperty cfp:tendency_of_eastward_wind,
                          cfp:wind_from_direction,
                          cfp:eastward_wind,
                          cfp:tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag,
                          cfp:wind_speed_of_gust,
                          cfp:tendency_of_eastward_wind_due_to_gravity_wave_drag,
                          cfp:northward_wind,
                          cfp:tendency_of_eastward_wind_due_to_advection,
                          cfp:tendency_of_eastward_wind_due_to_convection,
                          cfp:tendency_of_northward_wind_due_to_convection,
                          cfp:tendency_of_wind_speed_due_to_gravity_wave_drag,
                          cfp:product_of_northward_wind_and_specific_humidity,
                          cfp:product_of_northward_wind_and_geopotential_height,
                          cfp:tendency_of_wind_speed_due_to_convection,
                          cfp:product_of_eastward_wind_and_geopotential_height,
                          cfp:tendency_of_eastward_wind_due_to_numerical_artefacts,
                          cfp:tendency_of_eastward_wind_due_to_orographic_gravity_wave_drag,
                          cfp:tendency_of_northward_wind,
                          cfp:geostrophic_northward_wind,
                          cfp:tendency_of_eastward_wind_due_to_eliassen_palm_flux_divergence,
                          cfp:tendency_of_northward_wind_due_to_advection,
                          cfp:product_of_eastward_wind_and_specific_humidity,
                          cfp:wind_speed,
                          cfp:tendency_of_eastward_wind_due_to_diffusion,
                          cfp:x_wind,
                          cfp:tendency_of_northward_wind_due_to_diffusion,
                          cfp:y_wind,
                          cfp:geostrophic_eastward_wind,
                          cfp:number_of_days_with_wind_speed_above_threshold,
                          cfp:wind_to_direction,
                          cfp:tendency_of_northward_wind_due_to_gravity_wave_drag;
         a cff:Wind;
         rdfs:label "wind".
