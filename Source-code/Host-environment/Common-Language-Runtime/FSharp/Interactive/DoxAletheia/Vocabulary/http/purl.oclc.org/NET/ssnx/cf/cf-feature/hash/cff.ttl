ccrel:license a owl:AnnotationProperty.
<http://purl.oclc.org/NET/ssnx/cf/cf-feature> dc11:creator "W3C Semantic Sensor Network Incubator Group";
                                              dc11:description "This is an ontology representation of the generic features defined by Climate and Forecast (CF) standard names vocabulary (http://cf-pcmdi.llnl.gov/documents/cf-standard-names/), maintained by the Program for Climate Model Diagnosis and Intercomparison (http://cf-pcmdi.llnl.gov/ ) which is intended for use with climate and forecast data, in the  atmosphere, surface and ocean domains. ";
                                              dc11:identifier "14";
                                              dc11:rights "Copyright 2010 - 2011 CSIRO.";
                                              dc11:title "Climate and Forecast (CF) features";
                                              dcterms:created "2010-10-05";
                                              dcterms:modified "2011-06-20";
                                              a owl:Ontology;
                                              rdfs:comment "Acknowledgements to all the contributors to the CF Standard Name Table http://cf-pcmdi.llnl.gov/documents/cf-standard-names/cf-standard-name-contributors",
                                                           "The links between the properties and to the Medium, Layer, and Surface classes are based on the work done by Jonathan Gregory on the definition of a grammar for CF, which is used here with his kind permission. For more information: Parsing CF standard names http://www.met.reading.ac.uk/~jonathan/CF_metadata/14.1/.";
                                              owl:imports <http://purl.oclc.org/NET/ssnx/qu/qu>,
                                                          <http://purl.oclc.org/NET/ssnx/ssn>,
                                                          <http://purl.oclc.org/NET/ssnx/cf/cf-property>,
                                                          <http://purl.oclc.org/NET/ssnx/qu/qu-rec20>.
cff:Humidity a owl:Class;
             rdfs:label "Humidity";
             rdfs:subClassOf ssnx:FeatureOfInterest.
cff:Layer a owl:Class;
          rdfs:label "Layer";
          rdfs:subClassOf ssnx:FeatureOfInterest.
cff:LayerMedium a owl:Class;
                rdfs:label "Layer Medium";
                rdfs:subClassOf ssnx:FeatureOfInterest.
cff:Medium a owl:Class;
           rdfs:label "Medium";
           rdfs:subClassOf ssnx:FeatureOfInterest.
cff:Precipitation a owl:Class;
                  rdfs:label "Precipitation";
                  rdfs:subClassOf ssnx:FeatureOfInterest.
cff:Surface a owl:Class;
            rdfs:label "Surface";
            rdfs:subClassOf ssnx:FeatureOfInterest.
cff:SurfaceLayer a owl:Class;
                 rdfs:label "Surface Layer";
                 rdfs:subClassOf ssnx:FeatureOfInterest.
cff:SurfaceMedium a owl:Class;
                  rdfs:label "Surface Medium";
                  rdfs:subClassOf ssnx:FeatureOfInterest.
cff:SurfaceMediumMedium a owl:Class;
                        rdfs:label "Surface Medium Medium";
                        rdfs:subClassOf ssnx:FeatureOfInterest.
cff:SurfaceSurface a owl:Class;
                   rdfs:label "Surface Surface";
                   rdfs:subClassOf ssnx:FeatureOfInterest.
cff:Wind a owl:Class;
         rdfs:label "Wind";
         rdfs:subClassOf ssnx:FeatureOfInterest.
