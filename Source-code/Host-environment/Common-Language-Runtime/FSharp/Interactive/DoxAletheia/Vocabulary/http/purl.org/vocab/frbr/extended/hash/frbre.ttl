                                    <http://www.w3.org/2002/07/owl#inverseOf> frbre:hasIndependentPartExpression.
frbre:isIndependentPartOfWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:domain <http://purl.org/vocab/frbr/core#Work>;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is independent part of work"@en;
                              rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                              rdfs:subPropertyOf frbre:isPartOfWork.
frbre:isPartOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain <http://purl.org/vocab/frbr/core#Expression>;
                         rdfs:isDefinedBy frbre:;
                         rdfs:label "is part of expression"@en;
                         rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                         <http://www.w3.org/2002/07/owl#inverseOf> frbre:hasPartExpression.
frbre:isPartOfItem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
                   rdfs:isDefinedBy frbre:;
                   rdfs:label "is part of item"@en;
