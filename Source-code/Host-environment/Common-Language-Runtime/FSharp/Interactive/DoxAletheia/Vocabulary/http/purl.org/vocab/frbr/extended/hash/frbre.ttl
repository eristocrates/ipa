frbre:AutonomousExpression a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "autonomous expression"@en;
                           rdfs:subClassOf <http://purl.org/vocab/frbr/core#Expression>;
                           <http://www.w3.org/2002/07/owl#disjointWith> frbre:ReferentialExpression;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.org/vocab/frbr/core#Expression>
                                                                                                                            [<http://www.w3.org/2002/07/owl#complementOf> frbre:ReferentialExpression ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>];
                           <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/elements/1.1/creator> "Ian Davis" ; 
                                                                              <http://purl.org/dc/elements/1.1/date> "2005-08-10" ; 
                                                                              rdf:value "Changed complementOf to refer to ReferentialExpression instead of ReferentialWork"].
frbre:AutonomousWork a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy frbre:;
                     rdfs:label "autonomous work"@en;
                     rdfs:subClassOf <http://purl.org/vocab/frbr/core#Work>;
                     <http://www.w3.org/2002/07/owl#disjointWith> frbre:ReferentialWork;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.org/vocab/frbr/core#Work>
                                                                                                                      [<http://www.w3.org/2002/07/owl#complementOf> frbre:ReferentialWork ; 
                                                                                                                      a <http://www.w3.org/2002/07/owl#Class>]) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
frbre:Expression a <http://www.w3.org/2002/07/owl#Class>.
frbre:ReferentialExpression a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A referential expression is one which has little meaning when not studied in conjunction with the expression it refers to."@en;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "referential expression"@en;
                            rdfs:subClassOf <http://purl.org/vocab/frbr/core#Expression>;
                            <http://www.w3.org/2002/07/owl#disjointWith> frbre:AutonomousExpression;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.org/vocab/frbr/core#Expression>
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/vocab/frbr/core#isReferentiallyRelatedToExpression> ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:int ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
frbre:ReferentialWork a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A referential work is one which has little meaning when not studied in conjunction with the work it refers to."@en;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "referential work"@en;
                      rdfs:subClassOf <http://purl.org/vocab/frbr/core#Work>;
                      <http://www.w3.org/2002/07/owl#disjointWith> frbre:AutonomousWork;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.org/vocab/frbr/core#Work>
                                                                                                                       [<http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/vocab/frbr/core#isReferentiallyRelatedToWork> ; 
                                                                                                                       <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:int ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                       a <http://www.w3.org/2002/07/owl#Class>].
frbre:Work a <http://www.w3.org/2002/07/owl#Class>.
frbre:complementsExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "complements expression"@en;
                            rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                            rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:complementsWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment """Referential: cadenza, libretto, choreography, ending for unfinished work, etc.
Autonomous: incidental music, musical setting for a text, pendant, etc."""@en;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "complements work"@en;
                      rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                      rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:hasDependentPartExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:domain <http://purl.org/vocab/frbr/core#Expression>;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "has dependent part expression"@en;
                                 rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                 rdfs:subPropertyOf frbre:hasPartExpression;
                                 <http://www.w3.org/2002/07/owl#inverseOf> frbre:isDependentPartOfExpression.
frbre:hasDependentPartWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain <http://purl.org/vocab/frbr/core#Work>;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "has dependent part work"@en;
                           rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                           rdfs:subPropertyOf frbre:hasPartWork.
