frbre:hasPartItem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain <http://purl.org/vocab/frbr/core#Item>;
                  rdfs:isDefinedBy frbre:;
                  rdfs:label "has part item"@en;
                  rdfs:range <http://purl.org/vocab/frbr/core#Item>;
                  <http://www.w3.org/2002/07/owl#inverseOf> frbre:isPartOfItem.
frbre:hasPartManifestation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain <http://purl.org/vocab/frbr/core#Manifestation>;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "has part manifestation"@en;
                           rdfs:range <http://purl.org/vocab/frbr/core#Manifestation>;
                           <http://www.w3.org/2002/07/owl#inverseOf> frbre:isPartOfManifestation.
frbre:hasPartWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain <http://purl.org/vocab/frbr/core#Work>;
                  rdfs:isDefinedBy frbre:;
                  rdfs:label "has part work"@en;
                  rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                  <http://www.w3.org/2002/07/owl#inverseOf> frbre:isPartOfWork.
frbre:isAReconfigurationOfItem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:isDefinedBy frbre:;
                               rdfs:label "is a reconfiguration of item"@en;
                               rdfs:range <http://purl.org/vocab/frbr/core#Item>;
                               rdfs:subPropertyOf frbre:isRelatedToItem.
frbre:isAReferentialSuccessorToExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:isDefinedBy frbre:;
                                          rdfs:label "is a referential successor to expression"@en;
                                          rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                          rdfs:subPropertyOf frbre:isASuccessorToExpression,
                                                             frbre:isReferentiallyRelatedToExpression.
frbre:isAReferentialSuccessorToWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:isDefinedBy frbre:;
                                    rdfs:label "is a referential successor to work"@en;
                                    rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                                    rdfs:subPropertyOf frbre:isReferentiallyRelatedToWork,
                                                       frbre:isASuccessorToWork.
frbre:isAReproductionOfItem a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "is a reproduction of item"@en;
                            rdfs:range <http://purl.org/vocab/frbr/core#Item>;
                            rdfs:subPropertyOf frbre:isRelatedToItem.
frbre:isAReproductionOfManifestation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:isDefinedBy frbre:;
                                     rdfs:label "is a reproduction of manifestation"@en;
                                     rdfs:range <http://purl.org/vocab/frbr/core#Endeavour>;
                                     rdfs:subPropertyOf frbre:isRelatedToManifestation.
frbre:isARevisionOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "Between expressions of the SAME WORK."@en;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is a revision of expression"@en;
                              rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                              rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isASuccessorToExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:isDefinedBy frbre:;
                               rdfs:label "is a successor to expression"@en;
                               rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                               rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:isASuccessorToWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment """Referential: sequel, etc.
Autonomous: sequel, succeeding work, etc."""@en;
                         rdfs:isDefinedBy frbre:;
                         rdfs:label "is a sucessor to work"@en;
                         rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                         rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:isASummaryOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:isDefinedBy frbre:;
                             rdfs:label "is a summary of expression"@en;
                             rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                             rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isASummaryOfWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment """Digest, abstract, etc.
The subject is not dependent on the object for meaning."""@en;
                       rdfs:isDefinedBy frbre:;
                       rdfs:label "is a summary of work"@en;
                       rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                       rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isATransformationOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:isDefinedBy frbre:;
                                    rdfs:label "is a transformation of expression"@en;
                                    rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                    rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isATransformationOfWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment """Dramatisation, novelisation, versification, screenplay, etc.
The subject is not dependent on the object for meaning."""@en;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is a transformation of work"@en;
                              rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                              rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isATranslationOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Between expressions of the SAME WORK."@en;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "is a translation of expression"@en;
                                 rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                 rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAbridgementOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Between expressions of the SAME WORK."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is an abridgement of expression"@en;
                                  rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                  rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAdaptationOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "is an adaptation of expression"@en;
                                 rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                 rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAdaptationOfWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment """Adaptation, paraphrase, free translation, variation (music), harmonisation (music), fantasy (music), etc.
The subject is not dependent on the object for meaning."""@en;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "is adaption of work"@en;
                           rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                           rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isAnAlternativeManifestationTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                     rdfs:comment "Alternate is an Americanism."@en;
                                     rdfs:isDefinedBy frbre:;
                                     rdfs:label "is an alternative manifestation to"@en;
                                     rdfs:range <http://purl.org/vocab/frbr/core#Endeavour>;
                                     rdfs:subPropertyOf frbre:isRelatedToManifestation.
frbre:isAnArrangementOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "Between expressions of the SAME WORK."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is an arrangement of expression"@en;
                                  rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                  rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnImitationOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:isDefinedBy frbre:;
                                rdfs:label "is an imitation of expression"@en;
                                rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnImitationOfWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment """Parody, imitation, travesty, etc.
The subject is not dependent on the object for meaning."""@en;
                          rdfs:isDefinedBy frbre:;
                          rdfs:label "is an imitation of work"@en;
                          rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                          <http://www.w3.org/2002/07/owl#inverseOf> frbre:isAutonomouslyRelatedToWork.
frbre:isAutonomouslyRelatedToExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                        rdfs:comment "A relation between two expressions which does not result in the subject becoming a referential expression (i.e. one which has little meaning without the object)."@en;
                                        rdfs:isDefinedBy frbre:;
                                        rdfs:label "is autonomously related to expression"@en;
                                        rdfs:range <http://purl.org/vocab/frbr/core#Expression>;
                                        rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:isAutonomouslyRelatedToWork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "The subject is not dependent on the object for meaning."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is autonomously related to work"@en;
                                  rdfs:range <http://purl.org/vocab/frbr/core#Work>;
                                  rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:isDependentPartOfExpression a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:domain <http://purl.org/vocab/frbr/core#Expression>;
                                  rdfs:isDefinedBy frbre:;
