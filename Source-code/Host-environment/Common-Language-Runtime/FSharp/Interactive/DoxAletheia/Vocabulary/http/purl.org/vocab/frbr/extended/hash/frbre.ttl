@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix frbre: <http://purl.org/vocab/frbr/extended#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix frbrcore: <http://purl.org/vocab/frbr/core#>.

<file:///var/www/vocab.org/www/htdocs/frbr/> dc11:type dcmitype:Text;
                                             <http://web.resource.org/cc/license> <http://creativecommons.org/licenses/by/2.0/uk/>;
                                             a <http://web.resource.org/cc/Work>.
<http://creativecommons.org/licenses/by/2.0/uk/> <http://web.resource.org/cc/permits> <http://web.resource.org/cc/DerivativeWorks>,
                                                                                      <http://web.resource.org/cc/Distribution>,
                                                                                      <http://web.resource.org/cc/Reproduction>;
                                                 <http://web.resource.org/cc/requires> <http://web.resource.org/cc/Attribution>,
                                                                                       <http://web.resource.org/cc/Notice>;
                                                 a <http://web.resource.org/cc/License>.
frbrcore:Expression a owl:Class;
                    owl:equivalentClass [owl:unionOf (frbre:ReferentialExpression
                                                      frbre:AutonomousExpression) ; 
                                         a owl:Class].
frbrcore:Work a owl:Class;
              owl:equivalentClass [owl:unionOf (frbre:ReferentialWork
                                                frbre:AutonomousWork) ; 
                                   a owl:Class].
<http://purl.org/vocab/frbr/extended> dc11:creator "Ian Davis <http://purl.org/NET/iand>",
                                                   "Richard Newman";
                                      dc11:date "2005-08-10";
                                      dc11:identifier "http://purl.org/vocab/frbr/frbr-extended-20050810";
                                      dc11:rights "Copyright © 2005 Richard Newman and Ian Davis";
                                      dc11:title "Expression of Extended FRBR Concepts in RDF"@en;
                                      dcterms:hasFormat <http://purl.org/vocab/frbr/frbr-extended-20050810.rdf>,
                                                        <http://purl.org/vocab/frbr/frbr-extended-20050810.html>;
                                      dcterms:isVersionOf frbre:;
                                      dcterms:issued "2005-07-29";
                                      dcterms:replaces <http://purl.org/vocab/frbr/frbr-extended-20050729>;
                                      vann:preferredNamespacePrefix "frbre";
                                      vann:preferredNamespaceUri "http://purl.org/vocab/frbr/extended#";
                                      a owl:Ontology;
                                      skos:changeNote [dc11:creator "Ian Davis" ; 
                                                       dc11:date "2005-08-10" ; 
                                                       rdf:value "Added isDefinedBy properties and updated documentation"].
frbre:AutonomousExpression a owl:Class;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "autonomous expression"@en;
                           rdfs:subClassOf frbrcore:Expression;
                           owl:disjointWith frbre:ReferentialExpression;
                           owl:equivalentClass [owl:intersectionOf (frbrcore:Expression
                                                                    [owl:complementOf frbre:ReferentialExpression ; 
                                                                    a owl:Class]) ; 
                                                a owl:Class];
                           skos:historyNote [dc11:creator "Ian Davis" ; 
                                             dc11:date "2005-08-10" ; 
                                             rdf:value "Changed complementOf to refer to ReferentialExpression instead of ReferentialWork"].
frbre:AutonomousWork a owl:Class;
                     rdfs:isDefinedBy frbre:;
                     rdfs:label "autonomous work"@en;
                     rdfs:subClassOf frbrcore:Work;
                     owl:disjointWith frbre:ReferentialWork;
                     owl:equivalentClass [owl:intersectionOf (frbrcore:Work
                                                              [owl:complementOf frbre:ReferentialWork ; 
                                                              a owl:Class]) ; 
                                          a owl:Class].
frbre:Expression a owl:Class.
frbre:ReferentialExpression a owl:Class;
                            rdfs:comment "A referential expression is one which has little meaning when not studied in conjunction with the expression it refers to."@en;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "referential expression"@en;
                            rdfs:subClassOf frbrcore:Expression;
                            owl:disjointWith frbre:AutonomousExpression;
                            owl:equivalentClass [owl:intersectionOf (frbrcore:Expression
                                                                     [owl:onProperty frbrcore:isReferentiallyRelatedToExpression ; 
                                                                     owl:minCardinality "1"^^xsd:int ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
frbre:ReferentialWork a owl:Class;
                      rdfs:comment "A referential work is one which has little meaning when not studied in conjunction with the work it refers to."@en;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "referential work"@en;
                      rdfs:subClassOf frbrcore:Work;
                      owl:disjointWith frbre:AutonomousWork;
                      owl:equivalentClass [owl:intersectionOf (frbrcore:Work
                                                               [owl:onProperty frbrcore:isReferentiallyRelatedToWork ; 
                                                               owl:minCardinality "1"^^xsd:int ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
frbre:Work a owl:Class.
frbre:complementsExpression a owl:ObjectProperty;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "complements expression"@en;
                            rdfs:range frbrcore:Expression;
                            rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:complementsWork a owl:ObjectProperty;
                      rdfs:comment """Referential: cadenza, libretto, choreography, ending for unfinished work, etc.
Autonomous: incidental music, musical setting for a text, pendant, etc."""@en;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "complements work"@en;
                      rdfs:range frbrcore:Work;
                      rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:hasDependentPartExpression a owl:ObjectProperty;
                                 rdfs:domain frbrcore:Expression;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "has dependent part expression"@en;
                                 rdfs:range frbrcore:Expression;
                                 rdfs:subPropertyOf frbre:hasPartExpression;
                                 owl:inverseOf frbre:isDependentPartOfExpression.
frbre:hasDependentPartWork a owl:ObjectProperty;
                           rdfs:domain frbrcore:Work;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "has dependent part work"@en;
                           rdfs:range frbrcore:Work;
                           rdfs:subPropertyOf frbre:hasPartWork.
frbre:hasIndependentPartExpression a owl:ObjectProperty;
                                   rdfs:domain frbrcore:Expression;
                                   rdfs:isDefinedBy frbre:;
                                   rdfs:label "has independent part expression"@en;
                                   rdfs:range frbrcore:Expression;
                                   rdfs:subPropertyOf frbre:hasPartExpression;
                                   owl:inverseOf frbre:isIndependentPartOfExpression.
frbre:hasIndependentPartWork a owl:ObjectProperty;
                             rdfs:domain frbrcore:Work;
                             rdfs:isDefinedBy frbre:;
                             rdfs:label "has independent part work"@en;
                             rdfs:range frbrcore:Work;
                             owl:inverseOf frbre:isIndependentPartOfWork.
frbre:hasPartExpression a owl:ObjectProperty;
                        rdfs:domain frbrcore:Expression;
                        rdfs:isDefinedBy frbre:;
                        rdfs:label "has part expression"@en;
                        rdfs:range frbrcore:Expression;
                        owl:inverseOf frbre:isPartOfExpression.
frbre:hasPartItem a owl:ObjectProperty;
                  rdfs:domain frbrcore:Item;
                  rdfs:isDefinedBy frbre:;
                  rdfs:label "has part item"@en;
                  rdfs:range frbrcore:Item;
                  owl:inverseOf frbre:isPartOfItem.
frbre:hasPartManifestation a owl:ObjectProperty;
                           rdfs:domain frbrcore:Manifestation;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "has part manifestation"@en;
                           rdfs:range frbrcore:Manifestation;
                           owl:inverseOf frbre:isPartOfManifestation.
frbre:hasPartWork a owl:ObjectProperty;
                  rdfs:domain frbrcore:Work;
                  rdfs:isDefinedBy frbre:;
                  rdfs:label "has part work"@en;
                  rdfs:range frbrcore:Work;
                  owl:inverseOf frbre:isPartOfWork.
frbre:isAReconfigurationOfItem a owl:ObjectProperty;
                               rdfs:isDefinedBy frbre:;
                               rdfs:label "is a reconfiguration of item"@en;
                               rdfs:range frbrcore:Item;
                               rdfs:subPropertyOf frbre:isRelatedToItem.
frbre:isAReferentialSuccessorToExpression a owl:ObjectProperty;
                                          rdfs:isDefinedBy frbre:;
                                          rdfs:label "is a referential successor to expression"@en;
                                          rdfs:range frbrcore:Expression;
                                          rdfs:subPropertyOf frbre:isASuccessorToExpression,
                                                             frbre:isReferentiallyRelatedToExpression.
frbre:isAReferentialSuccessorToWork a owl:ObjectProperty;
                                    rdfs:isDefinedBy frbre:;
                                    rdfs:label "is a referential successor to work"@en;
                                    rdfs:range frbrcore:Work;
                                    rdfs:subPropertyOf frbre:isReferentiallyRelatedToWork,
                                                       frbre:isASuccessorToWork.
frbre:isAReproductionOfItem a owl:ObjectProperty;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "is a reproduction of item"@en;
                            rdfs:range frbrcore:Item;
                            rdfs:subPropertyOf frbre:isRelatedToItem.
frbre:isAReproductionOfManifestation a owl:ObjectProperty;
                                     rdfs:isDefinedBy frbre:;
                                     rdfs:label "is a reproduction of manifestation"@en;
                                     rdfs:range frbrcore:Endeavour;
                                     rdfs:subPropertyOf frbre:isRelatedToManifestation.
frbre:isARevisionOfExpression a owl:ObjectProperty;
                              rdfs:comment "Between expressions of the SAME WORK."@en;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is a revision of expression"@en;
                              rdfs:range frbrcore:Expression;
                              rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isASuccessorToExpression a owl:ObjectProperty;
                               rdfs:isDefinedBy frbre:;
                               rdfs:label "is a successor to expression"@en;
                               rdfs:range frbrcore:Expression;
                               rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:isASuccessorToWork a owl:ObjectProperty;
                         rdfs:comment """Referential: sequel, etc.
Autonomous: sequel, succeeding work, etc."""@en;
                         rdfs:isDefinedBy frbre:;
                         rdfs:label "is a sucessor to work"@en;
                         rdfs:range frbrcore:Work;
                         rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:isASummaryOfExpression a owl:ObjectProperty;
                             rdfs:isDefinedBy frbre:;
                             rdfs:label "is a summary of expression"@en;
                             rdfs:range frbrcore:Expression;
                             rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isASummaryOfWork a owl:ObjectProperty;
                       rdfs:comment """Digest, abstract, etc.
The subject is not dependent on the object for meaning."""@en;
                       rdfs:isDefinedBy frbre:;
                       rdfs:label "is a summary of work"@en;
                       rdfs:range frbrcore:Work;
                       rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isATransformationOfExpression a owl:ObjectProperty;
                                    rdfs:isDefinedBy frbre:;
                                    rdfs:label "is a transformation of expression"@en;
                                    rdfs:range frbrcore:Expression;
                                    rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isATransformationOfWork a owl:ObjectProperty;
                              rdfs:comment """Dramatisation, novelisation, versification, screenplay, etc.
The subject is not dependent on the object for meaning."""@en;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is a transformation of work"@en;
                              rdfs:range frbrcore:Work;
                              rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isATranslationOfExpression a owl:ObjectProperty;
                                 rdfs:comment "Between expressions of the SAME WORK."@en;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "is a translation of expression"@en;
                                 rdfs:range frbrcore:Expression;
                                 rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAbridgementOfExpression a owl:ObjectProperty;
                                  rdfs:comment "Between expressions of the SAME WORK."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is an abridgement of expression"@en;
                                  rdfs:range frbrcore:Expression;
                                  rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAdaptationOfExpression a owl:ObjectProperty;
                                 rdfs:isDefinedBy frbre:;
                                 rdfs:label "is an adaptation of expression"@en;
                                 rdfs:range frbrcore:Expression;
                                 rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnAdaptationOfWork a owl:ObjectProperty;
                           rdfs:comment """Adaptation, paraphrase, free translation, variation (music), harmonisation (music), fantasy (music), etc.
The subject is not dependent on the object for meaning."""@en;
                           rdfs:isDefinedBy frbre:;
                           rdfs:label "is adaption of work"@en;
                           rdfs:range frbrcore:Work;
                           rdfs:subPropertyOf frbre:isAutonomouslyRelatedToWork.
frbre:isAnAlternativeManifestationTo a owl:ObjectProperty;
                                     rdfs:comment "Alternate is an Americanism."@en;
                                     rdfs:isDefinedBy frbre:;
                                     rdfs:label "is an alternative manifestation to"@en;
                                     rdfs:range frbrcore:Endeavour;
                                     rdfs:subPropertyOf frbre:isRelatedToManifestation.
frbre:isAnArrangementOfExpression a owl:ObjectProperty;
                                  rdfs:comment "Between expressions of the SAME WORK."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is an arrangement of expression"@en;
                                  rdfs:range frbrcore:Expression;
                                  rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnImitationOfExpression a owl:ObjectProperty;
                                rdfs:isDefinedBy frbre:;
                                rdfs:label "is an imitation of expression"@en;
                                rdfs:range frbrcore:Expression;
                                rdfs:subPropertyOf frbre:isAutonomouslyRelatedToExpression.
frbre:isAnImitationOfWork a owl:ObjectProperty;
                          rdfs:comment """Parody, imitation, travesty, etc.
The subject is not dependent on the object for meaning."""@en;
                          rdfs:isDefinedBy frbre:;
                          rdfs:label "is an imitation of work"@en;
                          rdfs:range frbrcore:Work;
                          owl:inverseOf frbre:isAutonomouslyRelatedToWork.
frbre:isAutonomouslyRelatedToExpression a owl:ObjectProperty;
                                        rdfs:comment "A relation between two expressions which does not result in the subject becoming a referential expression (i.e. one which has little meaning without the object)."@en;
                                        rdfs:isDefinedBy frbre:;
                                        rdfs:label "is autonomously related to expression"@en;
                                        rdfs:range frbrcore:Expression;
                                        rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:isAutonomouslyRelatedToWork a owl:ObjectProperty;
                                  rdfs:comment "The subject is not dependent on the object for meaning."@en;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is autonomously related to work"@en;
                                  rdfs:range frbrcore:Work;
                                  rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:isDependentPartOfExpression a owl:ObjectProperty;
                                  rdfs:domain frbrcore:Expression;
                                  rdfs:isDefinedBy frbre:;
                                  rdfs:label "is dependent part of expression"@en;
                                  rdfs:range frbrcore:Expression;
                                  rdfs:subPropertyOf frbre:isPartOfExpression;
                                  owl:inverseOf frbre:hasDependentPartExpression.
frbre:isDependentPartOfWork a owl:ObjectProperty;
                            rdfs:domain frbrcore:Work;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "is dependent part of work"@en;
                            rdfs:range frbrcore:Work;
                            rdfs:subPropertyOf frbre:isPartOfWork;
                            owl:inverseOf frbre:hasDependentPartWork.
frbre:isIndependentPartOfExpression a owl:ObjectProperty;
                                    rdfs:domain frbrcore:Expression;
                                    rdfs:isDefinedBy frbre:;
                                    rdfs:label "is independent part of expression"@en;
                                    rdfs:range frbrcore:Expression;
                                    rdfs:subPropertyOf frbre:isPartOfExpression;
                                    owl:inverseOf frbre:hasIndependentPartExpression.
frbre:isIndependentPartOfWork a owl:ObjectProperty;
                              rdfs:domain frbrcore:Work;
                              rdfs:isDefinedBy frbre:;
                              rdfs:label "is independent part of work"@en;
                              rdfs:range frbrcore:Work;
                              rdfs:subPropertyOf frbre:isPartOfWork.
frbre:isPartOfExpression a owl:ObjectProperty;
                         rdfs:domain frbrcore:Expression;
                         rdfs:isDefinedBy frbre:;
                         rdfs:label "is part of expression"@en;
                         rdfs:range frbrcore:Expression;
                         owl:inverseOf frbre:hasPartExpression.
frbre:isPartOfItem a owl:ObjectProperty;
                   rdfs:domain frbrcore:Item;
                   rdfs:isDefinedBy frbre:;
                   rdfs:label "is part of item"@en;
                   rdfs:range frbrcore:Item;
                   owl:inverseOf frbre:hasPartItem.
frbre:isPartOfManifestation a owl:ObjectProperty;
                            rdfs:domain frbrcore:Manifestation;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "is part of manifestation"@en;
                            rdfs:range frbrcore:Manifestation;
                            owl:inverseOf frbre:hasPartManifestation.
frbre:isPartOfWork a owl:ObjectProperty;
                   rdfs:domain frbrcore:Work;
                   rdfs:isDefinedBy frbre:;
                   rdfs:label "is part of work"@en;
                   rdfs:range frbrcore:Work.
frbre:isReferentiallyRelatedToExpression a owl:ObjectProperty;
                                         rdfs:comment "A relation between two expressions which results in the subject becoming a referential expression (i.e. one which has little meaning without the object)."@en;
                                         rdfs:domain frbrcore:Expression;
                                         rdfs:isDefinedBy frbre:;
                                         rdfs:label "is referentially related to expression"@en;
                                         rdfs:range frbrcore:Expression;
                                         rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:isReferentiallyRelatedToWork a owl:ObjectProperty;
                                   rdfs:domain [owl:unionOf (frbre:Work
                                                             frbre:Expression) ; 
                                                a owl:Class];
                                   rdfs:isDefinedBy frbre:;
                                   rdfs:label "is referentially related to work"@en;
                                   rdfs:range frbrcore:Work;
                                   rdfs:subPropertyOf frbre:isRelatedToWork.
frbre:isRelatedToExpression a owl:ObjectProperty;
                            rdfs:domain frbrcore:Expression;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "is related to expression"@en;
                            rdfs:range frbrcore:Expression;
                            rdfs:subPropertyOf frbrcore:relatedEndeavour.
frbre:isRelatedToItem a owl:ObjectProperty;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "is related to item"@en;
                      rdfs:range frbrcore:Item;
                      rdfs:subPropertyOf frbrcore:relatedEndeavour.
frbre:isRelatedToManifestation a owl:ObjectProperty;
                               rdfs:isDefinedBy frbre:;
                               rdfs:label "is related to manifestation"@en;
                               rdfs:range frbrcore:Manifestation;
                               rdfs:subPropertyOf frbrcore:relatedEndeavour.
frbre:isRelatedToWork a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (frbrcore:Work
                                                frbrcore:Expression) ; 
                                   a owl:Class];
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "is related to work"@en;
                      rdfs:range frbrcore:Work;
                      rdfs:subPropertyOf frbrcore:relatedEndeavour.
frbre:referentiallyComplementsExpression a owl:ObjectProperty;
                                         rdfs:isDefinedBy frbre:;
                                         rdfs:label "referentially complements expression"@en;
                                         rdfs:range frbrcore:Expression;
                                         rdfs:subPropertyOf frbre:isReferentiallyRelatedToExpression,
                                                            frbre:complementsExpression.
frbre:referentiallyComplementsWork a owl:ObjectProperty;
                                   rdfs:isDefinedBy frbre:;
                                   rdfs:label "referentially complements work"@en;
                                   rdfs:range frbrcore:Work;
                                   rdfs:subPropertyOf frbre:isReferentiallyRelatedToWork.
frbre:referentiallySupplementsExpression a owl:ObjectProperty;
                                         rdfs:isDefinedBy frbre:;
                                         rdfs:label "referentially supplements expression"@en;
                                         rdfs:range frbrcore:Expression;
                                         rdfs:subPropertyOf frbre:isReferentiallyRelatedToExpression,
                                                            frbre:supplementsExpression.
frbre:referentiallySupplementsWork a owl:ObjectProperty;
                                   rdfs:isDefinedBy frbre:;
                                   rdfs:label "referentially supplements work"@en;
                                   rdfs:range frbrcore:Work;
                                   rdfs:subPropertyOf frbre:isReferentiallyRelatedToWork,
                                                      frbre:supplementsWork.
frbre:supplementsExpression a owl:ObjectProperty;
                            rdfs:isDefinedBy frbre:;
                            rdfs:label "supplements expression"@en;
                            rdfs:range frbrcore:Expression;
                            rdfs:subPropertyOf frbre:isRelatedToExpression.
frbre:supplementsWork a owl:ObjectProperty;
                      rdfs:comment """Referential: index, concordance, teacher's guide, gloss, supplement, appendix, etc.
Autonomous: supplement, appendix, etc."""@en;
                      rdfs:isDefinedBy frbre:;
                      rdfs:label "supplements work"@en;
                      rdfs:range frbrcore:Work;
                      rdfs:subPropertyOf frbre:isRelatedToWork.
<http://purl.org/vocab/frbr/frbr-extended-20050810.html> dc11:format [rdfs:label "HTML"@en ; 
                                                                      rdf:value "text/html" ; 
                                                                      a dcterms:IMT].
<http://purl.org/vocab/frbr/frbr-extended-20050810.rdf> dc11:format [rdfs:label "RDF"@en ; 
                                                                     rdf:value "application/rdf+xml" ; 
                                                                     a dcterms:IMT].
<http://vocab.org/frbr/extended.html> dc11:format "text/html";
                                      a foaf:Document,
                                        dcmitype:Text;
                                      rdfs:label "HTML".
<http://vocab.org/frbr/extended.json> dc11:format "application/json";
                                      a foaf:Document,
                                        dcmitype:Text;
                                      rdfs:label "JSON".
<http://vocab.org/frbr/extended.rdf> dcterms:hasFormat <http://vocab.org/frbr/extended.turtle>,
                                                       <http://vocab.org/frbr/extended.json>,
                                                       <http://vocab.org/frbr/extended.html>;
                                     a dcmitype:Text,
                                       foaf:Document;
                                     foaf:primaryTopic <http://purl.org/vocab/frbr/extended>;
                                     foaf:topic <http://purl.org/vocab/frbr/extended>.
<http://vocab.org/frbr/extended.turtle> dc11:format "text/plain";
                                        a foaf:Document,
                                          dcmitype:Text;
                                        rdfs:label "Turtle".
