@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix moat: <http://moat-project.org/ns#>.

_:Bb5db7ae76c456de57e3019fadeed28b0 a <http://www.w3.org/2002/07/owl#Restriction>;
                                    rdfs:isDefinedBy moat:;
                                    <http://www.w3.org/2002/07/owl#maxCardinality> 1 ;
                                    <http://www.w3.org/2002/07/owl#onProperty> moat:tagMeaning.
<http://apassant.net/alex> a <http://xmlns.com/foaf/0.1/Person>.
moat: <http://purl.org/dc/elements/1.1/contributor> "Philippe Laublet";
      <http://purl.org/dc/elements/1.1/creator> "Alexandre Passant";
      <http://purl.org/dc/elements/1.1/title> "MOAT ontology"@en;
      <http://purl.org/dc/terms/issued> "2008-01-15";
      a <http://www.w3.org/2002/07/owl#Thing>,
        <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:comment "An ontology that let users define relationships between Tag objects and URIs of Semantic Web resources."@en;
      rdfs:label "An ontology for the MOAT project."@en;
      rdfs:seeAlso <http://moat-project.org/ontology>;
      <http://xmlns.com/foaf/0.1/maker> <http://apassant.net/alex>.
moat:AutomatedTagging a moat:TagType;
                      rdfs:isDefinedBy moat:.
moat:Meaning a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A reified object to define a potential meaning for a Tag. The meaning is a unique and explicitely defined Semantic Web resource and is related to the agent that defined it with foaf:maker"@en;
             rdfs:isDefinedBy moat:;
             rdfs:label "Tag Meaning";
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                              <http://www.w3.org/2002/07/owl#onProperty> <http://xmlns.com/foaf/0.1/maker> ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                              <http://www.w3.org/2002/07/owl#onProperty> moat:meaningURI ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>].
moat:Tag a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A Tag URI, that provides an unique identifier for a label attached to a resource"@en;
         rdfs:isDefinedBy moat:;
         rdfs:label "Tag URI";
         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                          <http://www.w3.org/2002/07/owl#onProperty> <http://www.holygoat.co.uk/owl/redwood/0.1/tags/name> ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         <http://www.holygoat.co.uk/owl/redwood/0.1/tags/Tag>.
moat:TagType a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy moat:.
moat:ValidatedTagging a moat:TagType;
                      rdfs:isDefinedBy moat:.
moat:hasMeaning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link between a Tag and a Meaning object in a global context"@en;
                rdfs:domain moat:Tag;
                rdfs:isDefinedBy moat:;
                rdfs:label "tag meaning object - global context";
                rdfs:range moat:Meaning.
moat:localMeaning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The URI used as a meaning for a local meaning of a Tag with MOAT"@en;
                  rdfs:domain moat:Tag;
                  rdfs:isDefinedBy moat:;
                  rdfs:label "local Meaning";
                  rdfs:range rdfs:Resource.
moat:meaningURI a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link between a reified Meaning object and the URI that defines a meaning"@en;
                rdfs:domain moat:Meaning;
                rdfs:isDefinedBy moat:;
                rdfs:label "tag meaning URI - global context";
                rdfs:range rdfs:Resource.
moat:tagMeaning a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link between a Tagging and a meaning (URI) of a tag in a given context (i.e. blog post)"@en;
                rdfs:domain <http://www.holygoat.co.uk/owl/redwood/0.1/tags/RestrictedTagging>;
                rdfs:isDefinedBy moat:;
                rdfs:label "tag meaning - tagging context";
                rdfs:range rdfs:Resource.
moat:tagType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "The type of the tagging, i.e. automatic or has been validated"@en;
             rdfs:domain <http://www.holygoat.co.uk/owl/redwood/0.1/tags/RestrictedTagging>;
             rdfs:isDefinedBy moat:;
             rdfs:label "tagging type";
             rdfs:range moat:TagType.
moat:taggedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The URI ised to 'tag' an item with MOAT"@en;
                rdfs:domain <http://rdfs.org/sioc/ns#Item>;
                rdfs:isDefinedBy moat:;
                rdfs:label "tagged with";
                rdfs:range rdfs:Resource.
<http://moat-project.org/ontology> rdfs:label "Human-redeable information about this ontology".
<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://www.holygoat.co.uk/owl/redwood/0.1/tags/RestrictedTagging> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.holygoat.co.uk/owl/redwood/0.1/tags/Tag> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.holygoat.co.uk/owl/redwood/0.1/tags/name> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
rdfs:Resource a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/Person> a <http://www.w3.org/2002/07/owl#Class>.
<http://xmlns.com/foaf/0.1/maker> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
