@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix basic: <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic> dc11:creator "Simon Jonathan David COX, CSIRO Australia";
                                                           dc11:description "An OWL representation of (some of) the basic types described in ISO 19103:2005, required as primitives in other ontologies based on ISO 19100 series standards.";
                                                           dc11:rights "Copyright © 2012-2013 CSIRO";
                                                           dc11:source "ISO 19103:2005";
                                                           dc11:title "OWL representation of ISO 19103 (Basic types package)";
                                                           dcterms:created "2011";
                                                           dcterms:hasPart basic:Mass,
                                                                           basic:Time,
                                                                           basic:Angle,
                                                                           basic:DateTime,
                                                                           basic:Boolean,
                                                                           basic:Date,
                                                                           basic:value,
                                                                           basic:Length,
                                                                           basic:Real,
                                                                           basic:Velocity,
                                                                           basic:LocalName,
                                                                           basic:dimension,
                                                                           basic:Measure,
                                                                           basic:CharacterString,
                                                                           basic:Vector,
                                                                           basic:Volume,
                                                                           basic:Integer,
                                                                           basic:Acceleration,
                                                                           basic:uom,
                                                                           basic:Weight,
                                                                           basic:Decimal,
                                                                           basic:Scale,
                                                                           basic:UnitOfMeasure,
                                                                           basic:Currency,
                                                                           basic:AngularVelocity,
                                                                           basic:measure,
                                                                           basic:Number,
                                                                           basic:Distance,
                                                                           basic:Area,
                                                                           basic:ordinates;
                                                           dcterms:license <http://creativecommons.org/licenses/by/3.0/>;
                                                           dcterms:modified "2013-11-14";
                                                           vann:preferredNamespacePrefix "basic";
                                                           vann:preferredNamespaceUri basic:;
                                                           a voaf:Vocabulary,
                                                             owl:Ontology;
                                                           rdfs:comment """An OWL representation of (some of) the basic types described in ISO 19103:2005, required as primitives in other ontologies based on ISO 19100 series standards. 

This vocabulary is provisional, pending finalization of ISO 19150-2.

The URI stem http://def.seegrid.csiro.au/isotc211/ is temporary. The vocabulary is expected to be ultimately published in the domain http://def.isotc211.org/""";
                                                           owl:imports dc11:;
                                                           owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/basic.rdf>;
                                                           owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201311/ISOTC211/HM/basic.rdf>.
basic:Acceleration a owl:Class;
                   rdfs:comment "Measure of rate of change of velocity";
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                   rdfs:label "Acceleration"@en;
                   rdfs:subClassOf basic:Measure.
basic:Angle a owl:Class;
            rdfs:comment "measure of arc length or rotation";
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
            rdfs:label "Angle";
            rdfs:subClassOf basic:Measure.
basic:AngularVelocity a owl:Class;
                      rdfs:comment "Measure of rate of change of angular position";
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                      rdfs:label "AngularVelocity";
                      rdfs:subClassOf basic:Measure.
basic:Area a owl:Class;
           rdfs:comment "Measure of 2-D extent";
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
           rdfs:label "Area";
           rdfs:subClassOf basic:Measure.
basic:Boolean a rdfs:Datatype;
              rdfs:comment "Truth value. Most valuable in the predicate calculus, where items are either True or False, unless they are ill formed.";
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
              rdfs:label "boolean";
              owl:equivalentClass xsd:boolean.
basic:CharacterString a rdfs:Datatype;
                      rdfs:comment "sequence of characters";
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                      rdfs:label "characterString";
                      owl:equivalentClass xsd:string.
basic:Currency a owl:Class;
               rdfs:comment "Measure of exchange value";
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
               rdfs:label "Currency";
               rdfs:subClassOf basic:Measure.
basic:Date a rdfs:Datatype;
           rdfs:comment "Temporal position expressed with precision of days";
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
           rdfs:label "date";
           owl:equivalentClass xsd:date.
basic:DateTime a rdfs:Datatype;
               rdfs:comment "Temporal position expressed as a time and date";
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
               rdfs:label "dateTime";
               owl:equivalentClass xsd:dateTime.
basic:Decimal a rdfs:Datatype;
              rdfs:comment """The usually finite representation of a decimal number. It differs from the common binary Real implementation in that it can represent 1/10 (one-tenth) without error, while binary real representation can only represent powers of 1/2 (one-half) exactly. Since many currencies are decimal, these representations are preferred in dealing with such moneys. This is also true for mile markers, which are often given in decimals.

Can be thought of as an integer part followed by a fractional part given in multiples of powers of 1/10 (tenths).""";
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
              rdfs:label "decimal";
              owl:equivalentClass xsd:decimal.
basic:Distance a owl:Class;
               rdfs:comment "Measure of spatial separation along some 1-D manifold";
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
               rdfs:label "Distance";
               rdfs:subClassOf basic:Length.
basic:Integer a rdfs:Datatype;
              rdfs:comment "An exact integer value, with no fractional part.";
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
              rdfs:label "integer";
              owl:equivalentClass xsd:integer.
basic:Length a owl:Class;
             rdfs:comment "Measure of 1-D extent";
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
             rdfs:label "Length";
             rdfs:subClassOf basic:Measure.
basic:LocalName a rdfs:Datatype;
                rdfs:comment "Name in some local context";
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                rdfs:label "localName";
                owl:equivalentClass xsd:NCName.
basic:Mass a owl:Class;
           rdfs:comment "Measure of amount of substance";
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
           rdfs:label "Mass";
           rdfs:subClassOf basic:Measure.
basic:Measure a owl:Class;
              rdfs:comment "Scaled number";
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
              rdfs:label "Mesure"@fr,
                         "Measure"@en;
              rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty basic:uom ; 
                               a owl:Restriction],
                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty basic:value ; 
                               a owl:Restriction],
                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty basic:value ; 
                               a owl:Restriction],
                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty basic:uom ; 
                               a owl:Restriction];
              owl:disjointWith basic:UnitOfMeasure.
basic:Number a rdfs:Datatype;
             rdfs:comment "The set of numbers",
                          "Note: integer is a specialization of decimal";
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
             rdfs:label "Number";
             owl:equivalentClass [owl:unionOf (xsd:double
                                               xsd:float
                                               xsd:decimal) ; 
                                  a rdfs:Datatype],
                                 [owl:unionOf (xsd:double
                                               xsd:float
                                               xsd:decimal) ; 
                                  a rdfs:Datatype].
basic:Real a rdfs:Datatype;
           rdfs:comment """The common binary Real finite implementation using base 2. Since such reals can approximate any measure where absolute accuracy is not possible, this form of numeric is most often used for measures. In cases were absolute accuracy is needed, such as currencies, then a decimal representation may be preferred (assuming the currency is decimal, such as the US dollar, British pound, etc.). Where there are no subunits possible, Integer numbers may be preferred.  

Can be thought of as an integer part followed by a fractional part given in multiples of powers of 1/2 (halves).""";
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
           rdfs:label "realNumber";
           owl:equivalentClass [owl:unionOf (xsd:double
                                             xsd:float) ; 
                                a rdfs:Datatype],
                               [owl:unionOf (xsd:double
                                             xsd:float) ; 
                                a rdfs:Datatype].
basic:Scale a owl:Class;
            rdfs:comment "Factor by which a representation should be magnified to match the geomstric size of the thing it represents.";
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
            rdfs:label "Scale";
            rdfs:subClassOf basic:Measure.
basic:Time a owl:Class;
           rdfs:comment "Measure of temporal extent";
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
           rdfs:label "Time";
           rdfs:subClassOf basic:Measure.
basic:UnitOfMeasure a owl:Class;
                    rdfs:comment "Scale for a number describing size or extent";
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                    rdfs:label "Unit of measure";
                    owl:disjointWith basic:Measure.
basic:Vector a owl:Class;
             rdfs:comment "A vector is a sequence of a fixed length of Numbers. Normally, the numbers represent some measures, and thus vectors are often used where records of Numbers would be more appropriate. In geometry for example, direct positions are given by undistinguished coordinate vectors, which can be interpreted through the use of coordinate reference systems.";
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
             rdfs:label "Vector";
             rdfs:subClassOf [owl:onProperty basic:ordinates ; 
                              owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                              a owl:Restriction],
                             [owl:onProperty basic:dimension ; 
                              owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                              a owl:Restriction],
                             [owl:onProperty basic:ordinates ; 
                              owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                              a owl:Restriction],
                             [owl:onProperty basic:dimension ; 
                              owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                              a owl:Restriction].
basic:Velocity a owl:Class;
               rdfs:comment "Measure of rate of change of position";
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
               rdfs:label "Velocity";
               rdfs:subClassOf basic:Measure.
basic:Volume a owl:Class;
             rdfs:comment "Measure of 3-D extent";
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
             rdfs:label "Volume";
             rdfs:subClassOf basic:Measure;
             skos:notation "Volume"^^basic:ISOClassName.
basic:Weight a owl:Class;
             rdfs:comment "Measure of force due to a mass in a specific gravitational field";
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
             rdfs:label "Weight";
             rdfs:subClassOf basic:Measure.
basic:dimension a owl:DatatypeProperty;
                rdfs:comment "Number of components in the vector";
                rdfs:domain basic:Vector;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                rdfs:label "dimension";
                rdfs:range xsd:positiveInteger.
basic:measure a owl:ObjectProperty;
              rdfs:comment "The value of this property is a scaled number";
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
              rdfs:label "measure";
              rdfs:range basic:Measure.
basic:ordinates a owl:DatatypeProperty;
                rdfs:comment "Numerical values of the vector components";
                rdfs:domain basic:Vector;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                rdfs:label "ordinates".
basic:uom a owl:ObjectProperty;
          rdfs:comment "The value of this property designates the units of measure or scale for the quantity";
          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
          rdfs:label "unit of measure";
          rdfs:range basic:UnitOfMeasure.
basic:value a owl:DatatypeProperty;
            rdfs:comment "The value of this property is a number";
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
            rdfs:label "value";
            rdfs:range basic:Number.
