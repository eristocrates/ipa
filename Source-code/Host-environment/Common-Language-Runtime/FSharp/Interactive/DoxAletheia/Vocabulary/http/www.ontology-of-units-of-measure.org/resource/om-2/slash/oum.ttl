                                                               oum:FahrenheitScale
                                                               oum:ReaumurScale
                                                               oum:KelvinScale
                                                               oum:RankineScale) ; 
                                                    a owl:Class] ; 
                                 a owl:Restriction],
                                [owl:onProperty oum:hasDimension ; 
                                 owl:hasValue oum:thermodynamicTemperature-Dimension ; 
                                 a owl:Restriction].
oum:TemperatureRate oum:commonlyHasUnit oum:degreeCelsiusPerHour,
                                        oum:degreeCelsiusPerMinute-Time,
