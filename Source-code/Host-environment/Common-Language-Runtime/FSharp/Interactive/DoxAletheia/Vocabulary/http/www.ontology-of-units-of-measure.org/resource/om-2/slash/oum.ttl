                                         owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                            owl:allValuesFrom oum:MagneticFluxDensityUnit ; 
                                                            a owl:Restriction] ; 
                                         a owl:Restriction].
oum:MagneticFluxDensityUnit a owl:Class;
                            rdfs:label "magnetic flux density unit"@en;
                            rdfs:subClassOf oum:Unit;
                            owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:gamma
                                                                         oum:gauss
                                                                         oum:stattesla
                                                                         oum:tesla
