oum:KinematicViscosity oum:commonlyHasUnit oum:stokes,
                                           oum:centistokes,
                                           oum:squareMetrePerSecond-Time;
                       oum:symbol "ν";
                       oum:unofficialLabel "viscosity";
                       a owl:Class;
                       rdfs:comment "Kinematic viscosity is the ratio of viscosity to density."@en;
                       rdfs:label "kinematische viscositeit"@nl,
                                  "kinematic viscosity"@en;
                       rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                                        owl:hasValue oum:kinematicViscosityOrThermalDiffusivity-Dimension ; 
                                        a owl:Restriction],
                                       oum:Quantity,
                                       [owl:onProperty oum:hasValue ; 
                                        owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                           owl:allValuesFrom oum:KinematicViscosityUnit ; 
                                                           a owl:Restriction] ; 
                                        a owl:Restriction].
oum:KinematicViscosityUnit a owl:Class;
                           rdfs:label "kinematic viscosity unit"@en;
                           rdfs:subClassOf oum:Unit;
                           owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:stokes
                                                                        oum:squareMetrePerSecond-Time) ; 
                                                             a owl:Class]
                                                             oum:PrefixedStokes) ; 
                                                a owl:Class].
oum:KineticEnergy oum:alternativeLabel "bewegingsenergie"@nl;
                  oum:alternativeSymbol "T",
                                        "K";
                  oum:commonlyHasUnit oum:decajoule,
                                      oum:calorie-20C,
                                      oum:newtonMetre,
