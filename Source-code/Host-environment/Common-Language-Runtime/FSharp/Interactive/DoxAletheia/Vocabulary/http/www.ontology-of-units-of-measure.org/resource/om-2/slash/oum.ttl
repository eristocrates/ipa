                           owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:gilbert) ; 
                                                             a owl:Class]
                                                             oum:PrefixedAmpere) ; 
                                                a owl:Class].
oum:Magnitude oum:commonlyHasUnit oum:millimagnitude,
                                  oum:micromagnitude,
                                  oum:one,
                                  oum:magnitude;
              oum:longcomment """The magnitude scale was originally created by Hipparchos of Nicea (160-127 BCE) and was measured by comparing the brightness between stars. Initially this was done inaccurately by eye but is currently done by using photoelectric photometers or even more recently by CCDs. Hipparchos divided the stars into six magnitude (brightness classes), the brightest stars being assigned to the first class and the faintest to the sixth class. By about the middle 1800s it became apparent that the traditional magnitude scale is close to a logarithmic scale with base 2.5. This is due to the fact that the response of the eye is nearly logarithmic. N.R. Pogson formalised the magnitude scale to closely match the traditional (visual) scale. It is now defined as:  
    <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\">
   		<msub><mi>m</mi><mn>1</mn></msub> <mo>-</mo> <msub><mi>m</mi><mn>2</mn>  </msub><mo>=</mo> 
   		<mn>-2.5</mn><mi>log</mi>
    	<mfrac linethickness=\"1\">
    		<mrow>
    			<msub><mi>f</mi><mn>1</mn></msub>
    		</mrow>
    		<mrow><msub><mi>f</mi><mn>2</mn></msub>
    		</mrow>
    	</mfrac>
    </math>
    where <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub><mi>m</mi><mn>1</mn></msub> <mo>-</mo> <msub><mi>m</mi><mn>2</mn>  </msub></math> is the magnitude difference between two objects, and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub><mi>f</mi><mn>1</mn></msub></math> and <math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"inline\"><msub><mi>f</mi><mn>2</mn></msub></math> are the luminous fluxes of the two objects. The magnitude of Vega (α Lyrae, HD 172167) is defined to be 0 in all wavelengths and passbands, although in practice this can only be an approximation. The zero point is now defined using multiple standard stars from the north polar sequence (non-variable stars within 2 degrees of the north celestial pole) or secondary standard stars from other parts of the sky. Please note that the scale is inverted, objects of magnitude 1 have a higher luminous flux than objects of magnitude 5. Stars of magnitude 6 are just visible to the naked eye under good observing conditions.
    The units of magnitude, also called magnitude, are usually not indicated except when indicating small magnitude differences when milli- or micromagnitudes are used."""^^rdf:XMLLiteral;
              oum:symbol "m";
              a owl:Class;
              rdfs:comment "Reverse logarithmic measure of the brightness of an object."@en;
              rdfs:label "magnitude"@en,
                         "magnitude"@nl;
              rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                               owl:hasValue oum:dimensionOne ; 
                               a owl:Restriction],
                              oum:Quantity,
                              [owl:onProperty oum:hasValue ; 
                               owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                  owl:allValuesFrom oum:MagnitudeUnit ; 
                                                  a owl:Restriction] ; 
                               a owl:Restriction];
              <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.wurvoc.org/bibliography/om-2/IntroAstronomicalPhotometry_chapter_2>,
                                                                  <http://www.wurvoc.org/bibliography/om-2/Astrophysical_Techniques_chapter3>.
oum:MagnitudeAtMaximumBrightness oum:commonlyHasUnit oum:one,
                                                     oum:magnitude;
                                 oum:symbol "m_max";
                                 a owl:Class;
                                 rdfs:comment "The magnitude at maximum brightness of a variable star."@en;
                                 rdfs:label "magnitude at maximum brightness"@en;
                                 rdfs:subClassOf oum:Magnitude.
oum:MagnitudeAtMinimumBrightness oum:commonlyHasUnit oum:one,
                                                     oum:magnitude;
                                 oum:symbol "m_min";
                                 a owl:Class;
                                 rdfs:comment "The magnitude at minimum brightness of a variable star."@en;
                                 rdfs:label "magnitude at minimum brightness"@en;
                                 rdfs:subClassOf oum:Magnitude.
oum:MagnitudeUnit a owl:Class;
                  rdfs:label "magnitude unit"@en;
                  rdfs:subClassOf oum:Unit;
                  owl:equivalentClass [owl:oneOf (oum:one
                                                  oum:magnitude
                                                  oum:millimagnitude
                                                  oum:micromagnitude) ; 
                                       a owl:Class].
oum:ManualFirmness oum:alternativeLabel "firmness_m"@en;
                   oum:commonlyHasUnit oum:_0-5;
                   a owl:Class;
                   rdfs:comment "Firmness manueel: code 0 - 5."@nl;
                   rdfs:label "manual firmness"@en,
                              "manuele stevigheid"@nl;
                   rdfs:subClassOf oum:Quantity.
oum:Mass oum:commonlyHasUnit oum:exagram,
                             oum:poundApothecaries,
                             oum:ounceAvoirdupois,
                             oum:unifiedAtomicMassUnit,
                             oum:ounceApothecaries,
                             oum:poundAvoirdupois,
                             oum:slug,
                             oum:petagram,
                             oum:hundredweight-US,
                             oum:carat-Mass,
                             oum:InternationalUnit,
                             oum:tonne,
                             oum:picogram,
                             oum:milligram,
                             oum:milligramRAE,
                             oum:gigagram,
                             oum:nanounifiedAtomicMassUnit,
                             oum:microgram,
                             oum:pennyweight-Troy,
                             oum:ton-Long,
                             oum:teragram,
                             oum:gram,
                             oum:decigram,
                             oum:megagram,
                             oum:nanogram,
                             oum:megatonne,
                             oum:grain,
                             oum:hundredweight-British,
                             oum:kilotonne,
                             oum:ton-Short,
                             oum:solarMass,
                             oum:decagram,
                             oum:kilogram,
                             oum:hectogram,
                             oum:attogram,
                             oum:femtogram,
                             oum:centigram,
                             oum:ton-ShortAssay;
         oum:symbol "m";
         oum:unofficialLabel "weight";
         a owl:Class;
         rdfs:comment "Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration."@en;
         rdfs:label "质量"@zh,
                    "massa"@nl,
                    "mass"@en;
         rdfs:subClassOf oum:Quantity,
                         [owl:onProperty oum:hasValue ; 
                          owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                             owl:allValuesFrom oum:MassUnit ; 
                                             a owl:Restriction] ; 
                          a owl:Restriction],
                         [owl:onProperty oum:hasDimension ; 
                          owl:hasValue oum:mass-Dimension ; 
                          a owl:Restriction].
oum:MassFlow oum:commonlyHasUnit oum:kilogramPerSecond-Time;
             a owl:Class;
             rdfs:comment "Mass flow is the movement of substances at equal rates or as a single body."@en;
             rdfs:label "mass flow"@en;
             rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                              owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                 owl:allValuesFrom oum:MassFlowUnit ; 
                                                 a owl:Restriction] ; 
                              a owl:Restriction],
                             [owl:onProperty oum:hasDimension ; 
                              owl:hasValue oum:massFlow-Dimension ; 
                              a owl:Restriction],
                             oum:Quantity.
oum:MassFlowUnit a owl:Class;
                 rdfs:label "mass flow unit"@en;
                 rdfs:subClassOf oum:Unit;
                 owl:equivalentClass [owl:oneOf (oum:gramPerday
                                                 oum:kilogramPerSecond-Time
                                                 oum:milligramPerday) ; 
                                      a owl:Class].
oum:MassFraction oum:alternativeLabel "concentration (w/w)"@en;
                 oum:commonlyHasUnit oum:milligramPerHectogram,
                                     oum:gramPerHectogram,
                                     oum:microgramPerHectogram,
                                     oum:partsPerMillion,
                                     oum:one,
                                     oum:percent,
                                     oum:kilogramPerKilogram,
                                     oum:gramPerKilogram,
                                     oum:milligramPerKilogram,
                                     oum:gramPerGram;
                 oum:symbol "w";
                 a owl:Class;
                 rdfs:label "mass fraction"@en,
                            "massafractie"@nl;
                 rdfs:subClassOf oum:Quantity,
                                 [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:MassFractionUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction],
                                 [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:dimensionOne ; 
                                  a owl:Restriction].
oum:MassFractionUnit a owl:Class;
                     rdfs:label "mass fraction unit"@en;
                     rdfs:subClassOf oum:Unit;
                     owl:equivalentClass [owl:oneOf (oum:one
                                                     oum:partsPerMillion
                                                     oum:percent
                                                     oum:gramPerGram
                                                     oum:gramPerKilogram
                                                     oum:gramPerHectogram
                                                     oum:kilogramPerKilogram
                                                     oum:milligramPerHectogram
                                                     oum:milligramPerKilogram
                                                     oum:microgramPerHectogram) ; 
                                          a owl:Class].
oum:MassUnit a owl:Class;
             rdfs:label "mass unit"@en;
             rdfs:subClassOf oum:Unit;
             owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:carat-Mass
                                                          oum:grain
                                                          oum:gram
                                                          oum:hundredweight-British
                                                          oum:hundredweight-US
                                                          oum:InternationalUnit
                                                          oum:milligramRAE
                                                          oum:ounceAvoirdupois
                                                          oum:ounceApothecaries
                                                          oum:pennyweight-Troy
                                                          oum:poundApothecaries
                                                          oum:poundAvoirdupois
                                                          oum:slug
                                                          oum:solarMass
                                                          oum:ton-ShortAssay
                                                          oum:ton-Long
                                                          oum:ton-Short
                                                          oum:tonne
                                                          oum:unifiedAtomicMassUnit) ; 
                                               a owl:Class]
                                               oum:PrefixedGram
                                               oum:PrefixedTonne
                                               oum:PrefixedUnifiedAtomicMassUnit) ; 
                                  a owl:Class].
oum:Measure a owl:Class;
            rdfs:comment """A measure combines a number to a unit of measure. For example, \"3 m\" is a measure."""@en;
            rdfs:label "measure"@en.
oum:Metallicity oum:commonlyHasUnit oum:one;
                a owl:Class;
                rdfs:comment "The log of the ratio between the ratios of the observed Fe and H quantities in a star and the same ratio in the Sun. This is a very important quantity that is often used in astronomy as an indicator of the age of a star."@en;
                rdfs:label "metallicity"@en;
                rdfs:subClassOf oum:QuantityOfDimensionOne.
oum:MetrePerPrefixedSecond-Time a owl:Class;
                                rdfs:label "metre per prefixed second (time)"@en;
                                rdfs:subClassOf oum:UnitDivision;
                                owl:equivalentClass [owl:intersectionOf ([owl:onProperty oum:hasNumerator ; 
                                                                         owl:hasValue oum:metre ; 
                                                                         a owl:Restriction]
                                                                         [owl:onProperty oum:hasNumerator ; 
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                         a owl:Restriction]
                                                                         [owl:onProperty oum:hasDenominator ; 
                                                                         owl:allValuesFrom oum:PrefixedSecond-Time ; 
                                                                         a owl:Restriction]
                                                                         [owl:onProperty oum:hasDenominator ; 
                                                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                         a owl:Restriction]) ; 
                                                     a owl:Class].
oum:MetrePerPrefixedSecond-TimeSquared a owl:Class;
                                       rdfs:label "metre per prefixed second (time) squared"@en;
                                       rdfs:subClassOf oum:UnitDivision;
                                       owl:equivalentClass [owl:intersectionOf ([owl:onProperty oum:hasNumerator ; 
                                                                                owl:hasValue oum:metre ; 
                                                                                a owl:Restriction]
                                                                                [owl:onProperty oum:hasNumerator ; 
                                                                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                a owl:Restriction]
                                                                                [owl:onProperty oum:hasDenominator ; 
                                                                                owl:allValuesFrom oum:PrefixedSecond-TimeSquared ; 
                                                                                a owl:Restriction]
                                                                                [owl:onProperty oum:hasDenominator ; 
                                                                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                                a owl:Restriction]) ; 
                                                            a owl:Class].
oum:MexicanPeso a oum:Unit,
                  oum:SingularUnit;
                rdfs:label "Mexican peso"@en,
                           "墨西哥比索"@zh.
oum:ModeratedStarchMassFraction oum:commonlyHasUnit oum:one,
                                                    oum:percent,
                                                    oum:gramPerGram;
                                a owl:Class;
                                rdfs:comment "The fraction of the mass of moderated starch in a phenomenon"@en;
                                rdfs:label "moderated starch mass fraction"@en;
                                rdfs:subClassOf oum:MassFraction.
oum:ModulusOfElasticity oum:alternativeLabel "Young's modulus"@en;
                        oum:alternativeSymbol "Y";
                        oum:commonlyHasUnit oum:megapascal,
                                            oum:exapascal,
                                            oum:centipascal,
                                            oum:nanopascal,
                                            oum:pascal,
                                            oum:millimetreOfMercury,
                                            oum:kilogramSecond-TimeToThePower-2ReciprocalMetre,
                                            oum:terapascal,
                                            oum:attopascal,
                                            oum:decipascal,
                                            oum:torr,
                                            oum:femtopascal,
                                            oum:petapascal,
                                            oum:hectopascal,
                                            oum:bar,
                                            oum:atmosphere-Standard,
                                            oum:micropascal,
                                            oum:decapascal,
                                            oum:kilopascal,
                                            oum:barye,
                                            oum:decibar,
                                            oum:atmosphere-Technical,
                                            oum:newtonPerSquareMetre,
                                            oum:picopascal,
                                            oum:microbar,
                                            oum:metreOfMercury,
                                            oum:millibar,
                                            oum:centimetreOfMercury,
                                            oum:gigapascal,
                                            oum:millipascal;
                        oum:symbol "E";
                        a owl:Class;
                        rdfs:label "modulus of elasticity"@en,
                                   "elasticiteitsmodulus"@nl;
                        rdfs:subClassOf oum:DynamicModulus.
oum:Molality oum:alternativeLabel "molality of solution"@en;
             oum:alternativeSymbol "m";
             oum:commonlyHasUnit oum:molePerKilogram;
             oum:symbol "b";
             a owl:Class;
             rdfs:comment "Molality is the number of moles of solute per kilogram of solvent."@en;
             rdfs:label "molality"@en,
                        "molaliteit"@nl;
             rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                              owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                 owl:allValuesFrom oum:MolalityUnit ; 
                                                 a owl:Restriction] ; 
                              a owl:Restriction],
                             oum:Quantity.
oum:MolalityUnit a owl:Class;
                 rdfs:label "molality unit"@en;
                 rdfs:subClassOf oum:Unit;
                 owl:equivalentClass [owl:oneOf (oum:molePerKilogram) ; 
                                      a owl:Class].
oum:MolarEnergy oum:commonlyHasUnit oum:joulePerMole;
                a owl:Class;
                rdfs:label "molar energy"@en,
                           "molaire energie"@nl;
                rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                 owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                    owl:allValuesFrom oum:MolarEnergyUnit ; 
                                                    a owl:Restriction] ; 
                                 a owl:Restriction],
                                [owl:onProperty oum:hasDimension ; 
                                 owl:hasValue oum:molarEnergy-Dimension ; 
                                 a owl:Restriction],
                                oum:Quantity.
oum:MolarEnergyUnit a owl:Class;
                    rdfs:label "molar energy unit"@en;
                    rdfs:subClassOf oum:Unit;
                    owl:equivalentClass [owl:oneOf (oum:joulePerMole) ; 
                                         a owl:Class].
oum:MolarEntropy oum:commonlyHasUnit oum:joulePerKelvinMole;
                 a owl:Class;
                 rdfs:label "molar entropy"@en,
                            "molaire entropie"@nl;
                 rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:MolarEntropyUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction],
                                 [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:molarEntropyOrMolarHeatCapacityOrGasConstant-Dimension ; 
                                  a owl:Restriction],
                                 oum:Quantity.
oum:MolarEntropyUnit a owl:Class;
                     rdfs:label "molar entropy unit"@en;
                     rdfs:subClassOf oum:Unit;
                     owl:equivalentClass [owl:oneOf (oum:joulePerKelvinMole) ; 
                                          a owl:Class].
oum:MolarHeatCapacity oum:commonlyHasUnit oum:joulePerKelvinMole;
                      a owl:Class;
                      rdfs:label "molar heat capacity"@en,
                                 "molaire warmtecapaciteit"@nl;
                      rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                       owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                          owl:allValuesFrom oum:MolarHeatCapacityUnit ; 
                                                          a owl:Restriction] ; 
                                       a owl:Restriction],
                                      [owl:onProperty oum:hasDimension ; 
                                       owl:hasValue oum:molarEntropyOrMolarHeatCapacityOrGasConstant-Dimension ; 
                                       a owl:Restriction],
                                      oum:Quantity.
oum:MolarHeatCapacityUnit a owl:Class;
                          rdfs:label "molar heat capacity unit"@en;
                          rdfs:subClassOf oum:Unit;
                          owl:equivalentClass [owl:oneOf (oum:joulePerKelvinMole) ; 
                                               a owl:Class].
oum:MolarMass oum:commonlyHasUnit oum:kilogramPerMole;
              oum:symbol "M";
              a owl:Class;
              rdfs:label "molar mass"@en,
                         "molaire massa"@nl;
              rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                               owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                  owl:allValuesFrom oum:MolarMassUnit ; 
                                                  a owl:Restriction] ; 
                               a owl:Restriction],
                              oum:Quantity.
oum:MolarMassUnit a owl:Class;
                  rdfs:label "molar mass unit"@en;
                  rdfs:subClassOf oum:Unit;
                  owl:equivalentClass [owl:oneOf (oum:kilogramPerMole) ; 
                                       a owl:Class].
oum:MolarVolume oum:commonlyHasUnit oum:cubicMetrePerMole,
                                    oum:litrePerMole;
                oum:symbol "V_m";
                a owl:Class;
                rdfs:label "molar volume"@en,
                           "molair volume"@nl;
                rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                 owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                    owl:allValuesFrom oum:MolarVolumeUnit ; 
                                                    a owl:Restriction] ; 
                                 a owl:Restriction],
                                oum:Quantity.
oum:MolarVolumeUnit a owl:Class;
                    rdfs:label "molar volume unit"@en;
                    rdfs:subClassOf oum:Unit;
                    owl:equivalentClass [owl:oneOf (oum:cubicMetrePerMole
                                                    oum:litrePerMole) ; 
                                         a owl:Class].
oum:MolePerPrefixedLitre a owl:Class;
                         rdfs:label "mole per prefixed litre"@en;
                         rdfs:subClassOf oum:UnitDivision;
                         owl:equivalentClass [owl:intersectionOf ([owl:onProperty oum:hasNumerator ; 
                                                                  owl:hasValue oum:mole ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasNumerator ; 
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasDenominator ; 
                                                                  owl:allValuesFrom oum:PrefixedLitre ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasDenominator ; 
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
oum:MolePerPrefixedMetre a owl:Class;
                         rdfs:label "mole per prefixed metre"@en;
                         rdfs:subClassOf oum:UnitDivision;
                         owl:equivalentClass [owl:intersectionOf ([owl:onProperty oum:hasNumerator ; 
                                                                  owl:hasValue oum:mole ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasNumerator ; 
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasDenominator ; 
                                                                  owl:allValuesFrom oum:PrefixedMetre ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty oum:hasDenominator ; 
                                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
oum:MomentOfForce oum:alternativeLabel "moment"@en;
                  oum:commonlyHasUnit oum:newtonMetre,
                                      oum:micronewtonMetre,
                                      oum:millinewtonMetre;
                  oum:symbol "M";
                  a owl:Class;
                  rdfs:comment "Moment of force is the effectiveness of a force to produce rotation about an axis measured by the product of the force and the perpendicular distance from the line of action of the force to the axis."@en;
                  rdfs:label "moment of force"@en;
                  rdfs:subClassOf oum:Quantity,
                                  [owl:onProperty oum:hasValue ; 
                                   owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                      owl:allValuesFrom oum:MomentOfForceUnit ; 
                                                      a owl:Restriction] ; 
                                   a owl:Restriction],
                                  [owl:onProperty oum:hasDimension ; 
                                   owl:hasValue oum:energy-Dimension ; 
                                   a owl:Restriction].
oum:MomentOfForceUnit a owl:Class;
                      rdfs:label "moment of force unit"@en;
                      rdfs:subClassOf oum:Unit;
                      owl:equivalentClass [owl:oneOf (oum:newtonMetre
                                                      oum:micronewtonMetre
                                                      oum:millinewtonMetre) ; 
                                           a owl:Class].
oum:MomentOfInertia oum:alternativeLabel "massatraagheidsmoment"@nl;
                    oum:alternativeSymbol "J";
                    oum:commonlyHasUnit oum:kilogramSquareMetre;
                    oum:symbol "I";
                    a owl:Class;
                    rdfs:comment "Moment of inertia is a measure of the effectiveness of mass in rotation."@en;
                    rdfs:label "traagheidsmoment"@nl,
                               "moment of inertia"@en;
                    rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                     owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                        owl:allValuesFrom oum:MomentOfInertiaUnit ; 
                                                        a owl:Restriction] ; 
                                     a owl:Restriction],
                                    oum:Quantity.
oum:MomentOfInertiaUnit a owl:Class;
                        rdfs:label "moment of inertia unit"@en;
                        rdfs:subClassOf oum:Unit;
                        owl:equivalentClass [owl:oneOf (oum:kilogramSquareMetre) ; 
                                             a owl:Class].
oum:Momentum oum:alternativeLabel "linear momentum"@en;
             oum:commonlyHasUnit oum:metreKilogramPerSecond-Time;
             oum:symbol "p";
             a owl:Class;
             rdfs:comment "Momentum is the product of mass and velocity of an object."@en;
             rdfs:label "momentum"@en,
                        "impuls"@nl;
             rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                              owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                 owl:allValuesFrom oum:MomentumUnit ; 
                                                 a owl:Restriction] ; 
                              a owl:Restriction],
                             oum:Quantity.
oum:MomentumUnit a owl:Class;
                 rdfs:label "momentum unit"@en;
                 rdfs:subClassOf oum:Unit;
                 owl:equivalentClass [owl:oneOf (oum:metreKilogramPerSecond-Time) ; 
                                      a owl:Class].
oum:MustardPowderMassFraction oum:commonlyHasUnit oum:one,
                                                  oum:percent,
                                                  oum:gramPerGram;
                              a owl:Class;
                              rdfs:comment "The fraction of the mass of mustard powder in a phenomenon"@en;
                              rdfs:label "mustard powder mass fraction"@en;
                              rdfs:subClassOf oum:MassFraction.
oum:NeckRingMass oum:commonlyHasUnit oum:gram,
                                     oum:kilogram,
                                     oum:tonne;
                 oum:unofficialLabel "neck ring weight";
                 a owl:Class;
                 rdfs:label "neck ring mass"@en;
                 rdfs:subClassOf oum:Mass.
oum:NewZealandDollar a oum:Unit,
                       oum:SingularUnit;
                     rdfs:label "New Zealand dollar"@en,
                                "新西兰美元"@zh.
oum:NoiseEquivalentPower oum:commonlyHasUnit oum:watt;
                         oum:symbol "NEP";
                         a owl:Class;
