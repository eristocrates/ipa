@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix oum: <http://www.ontology-of-units-of-measure.org/resource/om-2/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:identifier a owl:AnnotationProperty.
<http://www.iau.org/static/resolutions/IAU2012_English.pdf> dc11:creator <http://www.wurvoc.org/bibliography/om-2/IAUDiv1WG>;
                                                            dc11:date "2012";
                                                            dc11:publisher <http://www.wurvoc.org/bibliography/om-2/International_Astronomical_Union>;
                                                            dc11:title "IAU 2012";
                                                            bibo:uri "http://www.iau.org/static/resolutions/IAU2012_English.pdf";
                                                            a bibo:Standard.
oum: dc11:creator "Hajo Rijgersberg, Don Willems, Jan Top"@en;
     dc11:date "2020/06/06";
     dc11:identifier "http://www.ontology-of-units-of-measure.org/vocabularies/om-2/";
     dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
     a owl:Ontology;
     rdfs:comment "測定単位のオントロジー (Ontology of units of Measure; OM) は，科学技術にとって重要な概念及び関係をモデル化する。OMは，単位・量・測定・次元に特に焦点を当てている。"@ja,
                  "The Ontology of units of Measure (OM) 2.0 models concepts and relations important to scientific research. It has a strong focus on units, quantities, measurements, and dimensions."@en;
     rdfs:label "Ontology of units of Measure (OM)"@en,
                "測定単位のオントロジー (OM)"@ja;
     owl:versionInfo "2.0.22"@en;
     <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.openisbn.com/isbn/9789462280618/>;
     <http://www.wurvoc.org/vocabularies/WV/illustration> "http://www.wurvoc.org/images/vocabularies/om-illustration.jpg";
     <http://www.wurvoc.org/vocabularies/WV/logo> "http://www.wurvoc.org/images/vocabularies/om-logo.jpg".
oum:AFS oum:hasDimension oum:dimensionOne;
        a oum:Unit,
          oum:SingularUnit;
        rdfs:label "AFS"@en.
oum:Aberration oum:commonlyHasUnit oum:degree,
                                   oum:second-Angle,
                                   oum:millisecond-Angle,
                                   oum:microsecond-Angle;
               a owl:Class;
               rdfs:comment "The apparent angular displacement of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
               rdfs:label "aberration"@en;
               rdfs:subClassOf oum:AngularDisplacement;
               <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.wurvoc.org/bibliography/om-2/Glossary_Astronomical_Almanac>.
oum:AberrationInLatitude oum:commonlyHasUnit oum:second-Angle,
                                             oum:millisecond-Angle,
                                             oum:degree,
                                             oum:microsecond-Angle;
                         oum:symbol "Δβ";
                         a owl:Class;
                         rdfs:comment "The apparent angular displacement in ecliptical latitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
                         rdfs:label "aberration in latitude"@en;
                         rdfs:subClassOf oum:AngularDisplacement;
                         <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.wurvoc.org/bibliography/om-2/chapter23_Astronomical_Algorithms>.
oum:AberrationInLongitude oum:commonlyHasUnit oum:second-Anglee,
                                              oum:microsecond-Angle,
                                              oum:millisecond-Angle,
                                              oum:degree;
                          oum:symbol "Δλ";
                          a owl:Class;
                          rdfs:comment "The apparent angular displacement in ecliptical longitude of the observed position of a celestial object from its geometric position, caused by the finite velocity of light in combination with the motions of the observer and of the observed object."@en;
                          rdfs:label "aberration in longitude"@en;
                          rdfs:subClassOf oum:AngularDisplacement;
                          <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.wurvoc.org/bibliography/om-2/chapter23_Astronomical_Algorithms>.
oum:AbsoluteBolometricMagnitude oum:commonlyHasUnit oum:magnitude;
                                oum:symbol "M_bol";
                                a owl:Class;
                                rdfs:comment "The absolute magnitude (see absolute magnitude) of a star is a measure of its total energy emission per second, or luminosity, i.e., the bolometric magnitude from a standard distance (10 pc)."@en;
                                rdfs:label "absolute bolometric magnitude"@en;
                                rdfs:subClassOf oum:BolometricMagnitude.
oum:AbsoluteMagnitude oum:commonlyHasUnit oum:millimagnitude,
                                          oum:magnitude,
                                          oum:micromagnitude,
                                          oum:one;
                      oum:symbol "M";
                      a owl:Class;
                      rdfs:comment "Logarithmic measure of the brightness of an object as seen from a standard distance of 10 pc. Units usually not indicated (http://en.wikipedia.org/wiki/Magnitude_(astronomy)."@en;
                      rdfs:label "absolute magnitude"@en,
                                 "absolute magnitude"@nl;
                      rdfs:subClassOf oum:Magnitude.
oum:AbsorbedDose oum:alternativeLabel "total ionizing dose"@en;
                 oum:commonlyHasUnit oum:attogray,
                                     oum:joulePerKilogram,
                                     oum:gigagray,
                                     oum:gray,
                                     oum:nanogray,
                                     oum:petagray,
                                     oum:kilogray,
                                     oum:milligray,
                                     oum:decagray,
                                     oum:centigray,
                                     oum:hectogray,
                                     oum:microgray,
                                     oum:decigray,
                                     oum:picogray,
                                     oum:exagray,
                                     oum:rad,
                                     oum:femtogray,
                                     oum:megagray,
                                     oum:teragray;
                 a owl:Class;
                 rdfs:comment "Absorbed dose is the energy deposited in a medium by ionizing radiation. It is a derived quantity in the International System of Units. Absorbed dose is energy divided by mass."@en;
                 rdfs:label "absorbed dose"@en;
                 rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:specificEnergyOrAbsorbedDoseOrDoseEquivalent-Dimension ; 
                                  a owl:Restriction],
                                 [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:AbsorbedDoseUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction],
                                 oum:Quantity.
oum:AbsorbedDoseRate oum:commonlyHasUnit oum:grayPerSecond-Time;
                     a owl:Class;
                     rdfs:label "absorbed dose rate"@en;
                     rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                      owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                         owl:allValuesFrom oum:AbsorbedDoseRateUnit ; 
                                                         a owl:Restriction] ; 
                                      a owl:Restriction],
                                     [owl:onProperty oum:hasDimension ; 
                                      owl:hasValue oum:absorbedDoseRate-Dimension ; 
                                      a owl:Restriction],
                                     oum:Quantity.
oum:AbsorbedDoseRateUnit a owl:Class;
                         rdfs:label "absorbed dose rate unit"@en;
                         rdfs:subClassOf oum:Unit;
                         owl:equivalentClass [owl:oneOf (oum:grayPerSecond-Time) ; 
                                              a owl:Class].
oum:AbsorbedDoseUnit a owl:Class;
                     rdfs:label "absorbed dose unit"@en;
                     rdfs:subClassOf oum:Unit;
                     owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:gray
                                                                  oum:rad
                                                                  oum:joulePerKilogram
                                                                  oum:kilojoulePerHectogram) ; 
                                                       a owl:Class]
                                                       oum:PrefixedGray) ; 
                                          a owl:Class].
oum:Acceleration oum:alternativeLabel "acceleratie"@nl;
                 oum:commonlyHasUnit oum:metrePerMillisecond-TimeSquared,
                                     oum:metrePerDecisecond-TimeSquared,
                                     oum:metrePerGigasecond-TimeSquared,
                                     oum:metrePerPicosecond-TimeSquared,
                                     oum:metrePerExasecond-TimeSquared,
                                     oum:nanometrePerSecond-TimeSquared,
                                     oum:kilometrePerSecond-TimeSquared,
                                     oum:decametrePerSecond-TimeSquared,
                                     oum:picometrePerSecond-TimeSquared,
                                     oum:hectometrePerSecond-TimeSquared,
                                     oum:petametrePerSecond-TimeSquared,
                                     oum:metrePerNanosecond-TimeSquared,
                                     oum:metrePerDecasecond-TimeSquared,
                                     oum:millimetrePerSecond-TimeSquared,
                                     oum:terametrePerSecond-TimeSquared,
                                     oum:metrePerTerasecond-TimeSquared,
                                     oum:metrePerPetasecond-TimeSquared,
                                     oum:exametrePerSecond-TimeSquared,
                                     oum:metrePerSecond-TimeSquared,
                                     oum:metrePerMegasecond-TimeSquared,
                                     oum:megametrePerSecond-TimeSquared,
                                     oum:metrePerAttosecond-TimeSquared,
                                     oum:gal,
                                     oum:centimetrePerSecond-TimeSquared,
                                     oum:attometrePerSecond-TimeSquared,
                                     oum:decimetrePerSecond-TimeSquared,
                                     oum:gigametrePerSecond-TimeSquared,
                                     oum:metrePerCentisecond-TimeSquared,
                                     oum:metrePerKilosecond-TimeSquared,
                                     oum:metrePerFemtosecond-TimeSquared,
                                     oum:metrePerMicrosecond-TimeSquared,
                                     oum:femtometrePerSecond-TimeSquared,
                                     oum:micrometrePerSecond-TimeSquared,
                                     oum:metrePerHectosecond-TimeSquared;
                 oum:symbol "a";
                 a owl:Class;
                 rdfs:label "acceleration"@en,
                            "versnelling"@nl;
                 rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:acceleration-Dmension ; 
                                  a owl:Restriction],
                                 oum:Quantity,
                                 [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:AccelerationUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction].
oum:AccelerationUnit a owl:Class;
                     rdfs:label "acceleration unit"@en;
                     rdfs:subClassOf oum:Unit;
                     owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:gal
                                                                  oum:metrePerSecond-TimeSquared) ; 
                                                       a owl:Class]
                                                       oum:PrefixedMetrePerSecond-TimeSquared
                                                       oum:MetrePerPrefixedSecond-TimeSquared
                                                       oum:PrefixedMetrePerPrefixedSecond-TimeSquared) ; 
                                          a owl:Class].
oum:AceticAcidMassFraction oum:commonlyHasUnit oum:one,
                                               oum:percent,
                                               oum:gramPerGram;
                           a owl:Class;
                           rdfs:comment "The fraction of the mass of acetic acid in a phenomenon"@en;
                           rdfs:label "acetic acid mass fraction"@en;
                           rdfs:subClassOf oum:MassFraction.
oum:Acidity oum:symbol "pH";
            a owl:Class;
            rdfs:label "acidity"@en;
            rdfs:subClassOf oum:Quantity.
oum:AcousticFirmness oum:alternativeLabel "firmness_ac"@en;
                     oum:commonlyHasUnit oum:AFS;
                     a owl:Class;
                     rdfs:comment "Stevigheid gemeten met AWETA (acoustic firmness value). AFS value."@nl;
                     rdfs:label "acoustic firmness"@en,
                                "akoestische stevigheid"@nl;
                     rdfs:subClassOf oum:Quantity.
oum:Action oum:commonlyHasUnit oum:jouleSecond-Time,
                               oum:ergSecond-Time;
           a owl:Class;
           rdfs:label "action"@en,
                      "actie"@nl;
           rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                            owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                               owl:allValuesFrom oum:ActionUnit ; 
                                               a owl:Restriction] ; 
                            a owl:Restriction],
                           [owl:onProperty oum:hasDimension ; 
                            owl:hasValue oum:actionOrAngularMomentum-Dimension ; 
                            a owl:Restriction],
                           oum:Quantity.
oum:ActionUnit a owl:Class;
               rdfs:label "action unit"@en;
               rdfs:subClassOf oum:Unit;
               owl:equivalentClass [owl:oneOf (oum:ergSecond-Time
                                               oum:jouleSecond-Time) ; 
                                    a owl:Class].
oum:Activity oum:alternativeLabel "activity (of a radionuclide)"@en,
                                  "activity of a radionuclide"@en;
             oum:commonlyHasUnit oum:centibecquerel,
                                 oum:kilobecquerel,
                                 oum:femtobecquerel,
                                 oum:gigabecquerel,
                                 oum:decabecquerel,
                                 oum:becquerel,
                                 oum:nanobecquerel,
                                 oum:petabecquerel,
                                 oum:exabecquerel,
                                 oum:megabecquerel,
                                 oum:picobecquerel,
                                 oum:terabecquerel,
                                 oum:attobecquerel,
                                 oum:millibecquerel,
                                 oum:curie,
                                 oum:reciprocalSecond-Time,
                                 oum:decibecquerel,
                                 oum:hectobecquerel,
                                 oum:microbecquerel;
             oum:symbol "A";
             a owl:Class;
             rdfs:comment "Activity is the decay rate of a radioactive substance. It is a derived quantity in the International System of Units. Activity is 1 divided by time."@en;
             rdfs:label "activity"@en,
                        "activiteit"@nl;
             rdfs:subClassOf oum:Quantity,
                             [owl:onProperty oum:hasDimension ; 
                              owl:hasValue oum:frequency-Dimension ; 
                              a owl:Restriction],
                             [owl:onProperty oum:hasValue ; 
                              owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                 owl:allValuesFrom oum:ActivityUnit ; 
                                                 a owl:Restriction] ; 
                              a owl:Restriction].
oum:ActivityUnit a owl:Class;
                 rdfs:label "activity unit"@en;
                 rdfs:subClassOf oum:Unit;
                 owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:becquerel
                                                              oum:curie
                                                              oum:reciprocalSecond-Time) ; 
                                                   a owl:Class]
                                                   oum:PrefixedBecquerel) ; 
                                      a owl:Class].
oum:Admittance oum:symbol "Y";
               a owl:Class;
               rdfs:comment "Admittance is a measure of how easily a circuit or device will allow a current to flow. It is electric current divided by electric potential."@en;
               rdfs:label "admittance"@en;
               rdfs:subClassOf oum:Quantity.
oum:Albedo oum:commonlyHasUnit oum:one;
           oum:symbol "α";
           a owl:Class;
           rdfs:comment "Ratio between radiation falling onto an object and the radiation reflected or scattered back. Or the ratio between the illumination and observed brightness."@en;
           rdfs:label "albedo"@en,
                      "albedo"@nl;
           rdfs:subClassOf oum:QuantityOfDimensionOne.
oum:AlfvenNumber oum:commonlyHasUnit oum:one;
                 oum:symbol "Al";
                 a owl:Class;
                 rdfs:label "Alfvén number"@en;
                 rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:AlfvenNumberUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction],
                                 [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:dimensionOne ; 
                                  a owl:Restriction],
                                 oum:Quantity.
oum:AlfvenNumberUnit a owl:Class;
                     rdfs:label "Alfvén number unit"@en;
                     rdfs:subClassOf oum:Unit;
                     owl:equivalentClass [owl:oneOf (oum:one) ; 
                                          a owl:Class].
oum:Altitude oum:alternativeLabel "elevation"@en;
             oum:alternativeSymbol "Alt";
             oum:commonlyHasUnit oum:degree,
                                 oum:minute-Angle,
                                 oum:second-Angle;
             oum:symbol "h";
             a owl:Class;
             rdfs:comment "The angular distance of a celestial body above or below the horizon, measured along the great circle passing through the body and the zenith."@en;
             rdfs:label "altitude"@en;
             rdfs:subClassOf oum:Angle;
             <http://www.wurvoc.org/bibliography/om-2/reference> <http://www.wurvoc.org/bibliography/om-2/Glossary_Astronomical_Almanac>.
oum:AmbientDoseEquivalent oum:commonlyHasUnit oum:decisievert,
                                              oum:hectosievert,
                                              oum:kilosievert,
                                              oum:megasievert,
                                              oum:decasievert,
                                              oum:exasievert,
                                              oum:attosievert,
                                              oum:rem,
                                              oum:sievert,
                                              oum:terasievert,
                                              oum:picosievert,
                                              oum:centisievert,
                                              oum:gigasievert,
                                              oum:nanosievert,
                                              oum:microsievert,
                                              oum:millisievert,
                                              oum:petasievert,
                                              oum:femtosievert;
                          a owl:Class;
                          rdfs:label "ambient dose equivalent"@en;
                          rdfs:subClassOf oum:DoseEquivalent.
oum:AmountOfMoney oum:commonlyHasUnit oum:poundSterling,
                                      oum:TurkishLira,
                                      oum:HongKongDollar,
                                      oum:JapaneseYen,
                                      oum:megaeuro,
                                      oum:AustralianDollar,
                                      oum:SingaporeDollar,
                                      oum:NorwegianKrone,
                                      oum:ChineseYuan,
                                      oum:NewZealandDollar,
                                      oum:SouthKoreanWon,
                                      oum:UnitedStatesDollar,
                                      oum:CanadianDollar,
                                      oum:SwedishKrona,
                                      oum:SouthAfricanRand,
                                      oum:RussianRuble,
                                      oum:MexicanPeso,
                                      oum:BrazilianReal,
                                      oum:IndianRupee,
                                      oum:euro,
                                      oum:SwissFranc;
                  a owl:Class;
                  rdfs:label "amount of money"@en;
                  rdfs:subClassOf oum:Quantity,
                                  [owl:onProperty oum:hasValue ; 
                                   owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                      owl:allValuesFrom oum:AmountOfMoneyUnit ; 
                                                      a owl:Restriction] ; 
                                   a owl:Restriction].
oum:AmountOfMoneyUnit a owl:Class;
                      rdfs:label "amount of money unit"@en;
                      rdfs:subClassOf oum:Unit;
                      owl:equivalentClass [owl:oneOf (oum:UnitedStatesDollar
                                                      oum:euro
                                                      oum:JapaneseYen
                                                      oum:poundSterling
                                                      oum:AustralianDollar
                                                      oum:SwissFranc
                                                      oum:CanadianDollar
                                                      oum:MexicanPeso
                                                      oum:ChineseYuan
                                                      oum:NewZealandDollar
                                                      oum:SwedishKrona
                                                      oum:RussianRuble
                                                      oum:HongKongDollar
                                                      oum:NorwegianKrone
                                                      oum:SingaporeDollar
                                                      oum:TurkishLira
                                                      oum:SouthKoreanWon
                                                      oum:SouthAfricanRand
                                                      oum:BrazilianReal
                                                      oum:IndianRupee
                                                      oum:megaeuro) ; 
                                           a owl:Class].
oum:AmountOfSubstance oum:commonlyHasUnit oum:millimole,
                                          oum:teramole,
                                          oum:micromole,
                                          oum:decimole,
                                          oum:decamole,
                                          oum:mole,
                                          oum:petamole,
                                          oum:examole,
                                          oum:femtomole,
                                          oum:picomole,
                                          oum:gigamole,
                                          oum:centimole,
                                          oum:attomole,
                                          oum:megamole,
                                          oum:nanomole,
                                          oum:hectomole,
                                          oum:kilomole;
                      oum:symbol "n";
                      a owl:Class;
                      rdfs:comment "Amount of substance is the number of elementary entities such as atoms, molecules, electrons, particles, etc. present in a phenomenon. It is a base quantity in the International System of Units."@en;
                      rdfs:label "amount of substance"@en,
                                 "stofhoeveelheid"@nl;
                      rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                                       owl:hasValue oum:amountOfSubstance-Dimension ; 
                                       a owl:Restriction],
                                      [owl:onProperty oum:hasValue ; 
                                       owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                          owl:allValuesFrom oum:AmountOfSubstanceUnit ; 
                                                          a owl:Restriction] ; 
                                       a owl:Restriction],
                                      oum:Quantity.
oum:AmountOfSubstanceConcentration oum:alternativeLabel "molaire concentratie"@nl,
                                                        "molar concentration"@en;
                                   oum:commonlyHasUnit oum:molePerExalitre,
                                                       oum:megamolePerLitre,
                                                       oum:molePerAttolitre,
                                                       oum:molePerDecalitre,
                                                       oum:molePerMillilitre,
                                                       oum:molePerHectolitre,
                                                       oum:attomolePerLitre,
                                                       oum:molePerPetalitre,
                                                       oum:molePerNanolitre,
                                                       oum:molair,
                                                       oum:micromolePerLitre,
                                                       oum:molePerTeralitre,
                                                       oum:decimolePerLitre,
                                                       oum:molePerPicolitre,
                                                       oum:femtomolePerLitre,
                                                       oum:molePerCubicmetre,
                                                       oum:megamolair,
                                                       oum:nanomolair,
                                                       oum:attomolair,
                                                       oum:molePerKilolitre,
                                                       oum:micromolair,
                                                       oum:molePerFemtolitre,
                                                       oum:molePerCentilitre,
                                                       oum:millimolePerLitre,
                                                       oum:hectomolePerLitre,
                                                       oum:molePerLitre,
                                                       oum:teramolePerLitre,
                                                       oum:examolePerLitre,
                                                       oum:decamolePerLitre,
                                                       oum:molePerMicrolitre,
                                                       oum:nanomolePerLitre,
                                                       oum:centimolePerLitre,
                                                       oum:petamolePerLitre,
                                                       oum:picomolair,
                                                       oum:molePerDecilitre,
                                                       oum:kilomolePerLitre,
                                                       oum:picomolePerLitre,
                                                       oum:femtomolair,
                                                       oum:millimolair,
                                                       oum:molePerGigalitre,
                                                       oum:gigamolePerLitre,
                                                       oum:molePerMegalitre;
                                   oum:symbol "C";
                                   a owl:Class;
                                   rdfs:label "amount of substance concentration"@en;
                                   rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                                    owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                                       owl:allValuesFrom oum:AmountOfSubstanceConcentrationUnit ; 
                                                                       a owl:Restriction] ; 
                                                    a owl:Restriction],
                                                   oum:Quantity,
                                                   [owl:onProperty oum:hasDimension ; 
                                                    owl:hasValue oum:amountOfSubstanceConcentration-Dimension ; 
                                                    a owl:Restriction].
oum:AmountOfSubstanceConcentrationUnit a owl:Class;
                                       rdfs:label "amount of substance concentration unit"@en;
                                       rdfs:subClassOf oum:Unit;
                                       owl:equivalentClass [owl:unionOf ([owl:oneOf (oum:molair
                                                                                    oum:molePerCubicmetre
                                                                                    oum:molePerLitre) ; 
                                                                         a owl:Class]
                                                                         oum:PrefixedMolair
                                                                         oum:PrefixedMolePerLitre
