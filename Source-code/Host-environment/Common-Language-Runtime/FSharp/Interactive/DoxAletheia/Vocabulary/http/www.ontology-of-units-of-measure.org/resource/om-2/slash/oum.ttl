                                 a owl:Restriction],
                                [owl:onProperty oum:hasDimension ; 
                                 owl:hasValue oum:dimensionOne ; 
                                 a owl:Restriction],
                                oum:Quantity.
oum:LewisNumberUnit a owl:Class;
                    rdfs:label "Lewis number unit"@en;
                    rdfs:subClassOf oum:Unit;
