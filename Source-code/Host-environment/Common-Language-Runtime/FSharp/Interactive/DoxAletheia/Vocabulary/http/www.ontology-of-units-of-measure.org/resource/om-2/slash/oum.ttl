oum:MagneticField-Dimension oum:hasSIAmountOfSubstanceDimensionExponent 0 ;
                            oum:hasSIElectricCurrentDimensionExponent 1 ;
                            oum:hasSILengthDimensionExponent -1 ;
                            oum:hasSILuminousIntensityDimensionExponent 0 ;
                            oum:hasSIMassDimensionExponent 0 ;
                            oum:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                            oum:hasSITimeDimensionExponent 0 ;
                            a oum:Dimension;
                            rdfs:label "magnetic field dimension"@en.
oum:MagneticFieldUnit a owl:Class;
                      rdfs:label "magnetic field unit"@en;
                      rdfs:subClassOf oum:Unit;
                      owl:equivalentClass [owl:oneOf (oum:oersted
                                                      oum:amperePerMetre) ; 
                                           a owl:Class].
oum:MagneticFlux oum:commonlyHasUnit oum:deciweber,
                                     oum:statweber,
                                     oum:femtoweber,
                                     oum:unitPole,
                                     oum:kiloweber,
                                     oum:megaweber,
                                     oum:petaweber,
                                     oum:picoweber,
                                     oum:nanoweber,
                                     oum:attoweber,
                                     oum:decaweber,
                                     oum:weber,
                                     oum:milliweber,
                                     oum:gigaweber,
                                     oum:voltSecond-Time,
                                     oum:hectoweber,
                                     oum:microweber,
                                     oum:maxwell,
                                     oum:centiweber,
                                     oum:exaweber,
                                     oum:teraweber;
                 oum:symbol "Φ";
                 a owl:Class;
                 rdfs:comment "Magnetic flux through any area perpendicular to a magnetic field is the product of the area by the field strength."@en;
                 rdfs:label "magnetic flux"@en;
                 rdfs:subClassOf [owl:onProperty oum:hasDimension ; 
                                  owl:hasValue oum:magneticFlux-Dimension ; 
                                  a owl:Restriction],
                                 [owl:onProperty oum:hasValue ; 
                                  owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                     owl:allValuesFrom oum:MagneticFluxUnit ; 
                                                     a owl:Restriction] ; 
                                  a owl:Restriction],
                                 oum:Quantity.
oum:MagneticFluxDensity oum:alternativeLabel "magnetic field"@en,
                                             "magnetic induction"@en;
                        oum:commonlyHasUnit oum:attotesla,
                                            oum:picotesla,
                                            oum:gigatesla,
                                            oum:microtesla,
                                            oum:tesla,
                                            oum:gamma,
                                            oum:milligauss,
                                            oum:decitesla,
                                            oum:kilotesla,
