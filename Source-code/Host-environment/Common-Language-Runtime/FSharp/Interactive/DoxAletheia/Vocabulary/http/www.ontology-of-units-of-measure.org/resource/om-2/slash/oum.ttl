                                      oum:BritishThermalUnit-Mean,
                                      oum:decijoule,
                                      oum:calorie-Thermochemical,
                                      oum:hectojoule,
                                      oum:centijoule;
                  oum:symbol "E_k";
                  a owl:Class;
                  rdfs:comment "Kinetic energy is energy due to motion."@en;
                  rdfs:label "动能"@zh,
                             "kinetic energy"@en,
                             "kinetische energie"@nl;
                  rdfs:subClassOf oum:Energy.
oum:KnudsenNumber oum:commonlyHasUnit oum:one;
                  oum:symbol "Kn";
                  a owl:Class;
                  rdfs:comment "The Knudsen number is a dimensionless number defined as the ratio of the molecular mean free path length to a representative physical length scale."@en;
                  rdfs:label "Knudsen number"@en,
                             "getal van Knudsen"@nl;
                  rdfs:subClassOf [owl:onProperty oum:hasValue ; 
                                   owl:allValuesFrom [owl:onProperty oum:hasUnit ; 
                                                      owl:allValuesFrom oum:KnudsenNumberUnit ; 
                                                      a owl:Restriction] ; 
                                   a owl:Restriction],
                                  [owl:onProperty oum:hasDimension ; 
                                   owl:hasValue oum:dimensionOne ; 
                                   a owl:Restriction],
                                  oum:Quantity.
oum:KnudsenNumberUnit a owl:Class;
                      rdfs:label "Knudsen number unit"@en;
                      rdfs:subClassOf oum:Unit;
                      owl:equivalentClass [owl:oneOf (oum:one) ; 
                                           a owl:Class].
