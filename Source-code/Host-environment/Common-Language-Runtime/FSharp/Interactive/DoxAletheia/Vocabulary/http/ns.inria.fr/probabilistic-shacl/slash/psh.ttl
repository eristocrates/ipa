@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix psh: <http://ns.inria.fr/probabilistic-shacl/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.
@prefix shacl: <http://www.w3.org/ns/shacl#>.

psh: dcterms:contributor "Catherine Faron",
                         "Rémi Felin",
                         "Andrea G. B. Tettamanzi";
     dcterms:created "2023-03-16"^^xsd:date;
     dcterms:creator "Rémi Felin";
     dcterms:description "An OWL vocabulary to include and exploit probabilistic information in SHACL validation reports"@en;
     dcterms:publisher "Inria";
     dcterms:status <http://purl.org/adms/status/UnderDevelopment>;
     dcterms:title "Probabilistic SHACL Validation"@en;
     vann:preferredNamespacePrefix "psh";
     vann:preferredNamespaceUri "http://ns.inria.fr/probabilistic-shacl/";
     a owl:Ontology,
       voaf:Vocabulary;
     rdfs:comment "This vocabulary defines terms used to include and exploit probabilistic information in SHACL validation reports"@en;
     rdfs:label "Probabilistic SHACL Validation"@en;
     owl:versionInfo 1.0;
     status:term_status "stable";
     foaf:homepage "http://ns.inria.fr/probabilistic-shacl/psh.html".
psh:ValidationSummary a rdfs:Class;
                      rdfs:comment "The class of probabilistic validation summary"@en;
                      rdfs:isDefinedBy psh:;
                      rdfs:label "Validation summary"@en;
                      rdfs:subClassOf rdfs:Resource.
psh:focusShape a rdf:Property;
               rdfs:comment "The shape concerned by the results of the probabilistic validation"@en;
               rdfs:domain shacl:ValidationSummary;
               rdfs:isDefinedBy psh:;
               rdfs:label "focus shape"@en;
               rdfs:range shacl:Shape.
psh:generality a rdf:Property;
               rdfs:comment "Specifies the representativeness of the current shape"@en;
               rdfs:domain shacl:ValidationSummary;
               rdfs:isDefinedBy psh:;
               rdfs:label "generality"@en;
               rdfs:range xsd:double.
psh:likelihood a rdf:Property;
               rdfs:comment "Specifies the likelihood to observe the number of exceptions among the RDF triples tested (i.e. referenceCardinality)"@en;
               rdfs:domain shacl:ValidationSummary;
               rdfs:isDefinedBy psh:;
               rdfs:label "likelihood"@en;
               rdfs:range xsd:double.
psh:numConfirmation a rdf:Property;
                    rdfs:comment "Specifies the number of nodes that confirm the current shape"@en;
                    rdfs:domain shacl:ValidationSummary;
                    rdfs:isDefinedBy psh:;
                    rdfs:label "number of confirmation"@en;
                    rdfs:range xsd:integer.
psh:numViolation a rdf:Property;
                 rdfs:comment "Specifies the number of nodes that contradict the current shape"@en;
                 rdfs:domain shacl:ValidationSummary;
                 rdfs:isDefinedBy psh:;
                 rdfs:label "number of violation"@en;
                 rdfs:range xsd:integer.
psh:referenceCardinality a rdf:Property;
                         rdfs:comment "Specifies the number of RDF triples tested during the validation of the current shape"@en;
                         rdfs:domain shacl:ValidationSummary;
                         rdfs:isDefinedBy psh:;
                         rdfs:label "reference cardinality"@en;
                         rdfs:range xsd:integer.
psh:summary a rdf:Property;
            rdfs:comment "The probabilistic validation results contained in a validation report."@en;
            rdfs:domain shacl:ValidationReport;
            rdfs:isDefinedBy psh:;
            rdfs:label "summary"@en;
            rdfs:range psh:ValidationSummary.
