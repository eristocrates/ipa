@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix tis: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>.

<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
tis: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "At what time did a certain situation occur?,What situations occurred at a certain time?"^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> "Aldo Gangemi"^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> "TimeInterval"^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> """We can represent situations that have an explicit time parameter.
In principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern."""^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent time indexed situations."^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> """SELECT ?x ?e ?t
WHERE {
?x :forEntity ?e .
?x :atTime ?t }"""^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> "Situation"^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "Time indexed participation,TimeIndexedClassification"^^rdf:PlainLiteral;
     <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "Mustafa's address in 2005 was in Brussels"^^rdf:PlainLiteral;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:comment "A generic pattern usable for all situations that require a temporal indexing."^^rdf:PlainLiteral;
     <http://www.w3.org/2002/07/owl#imports> <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>,
                                             <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>,
                                             <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
     <http://www.w3.org/2002/07/owl#versionInfo> "1.1 added rdfs:isDefinedBy for all named entities",
                                                 """1.0
- Revised, and added annotations for ODP publishing
0.1
- Created by Aldo Gangemi""".
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                             rdfs:comment "A Situation that is explicitly indexed at some time for at least one entity.";
                                                                                             rdfs:isDefinedBy tis:;
                                                                                             rdfs:label "Time indexed situation"@en;
                                                                                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> ; 
                                                                                                              <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> ; 
                                                                                                              <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                                             <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation>.
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                               rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation>;
                                                                               rdfs:isDefinedBy tis:;
                                                                               rdfs:label "at time"@en;
                                                                               rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval>;
                                                                               rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor>.
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                  rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation>;
                                                                                  rdfs:isDefinedBy tis:;
                                                                                  rdfs:label "for entity"@en;
                                                                                  rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                                                                                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor>.
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#hasTimeIndexedSetting> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                              rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                                                                                              rdfs:isDefinedBy tis:;
                                                                                              rdfs:label "has time indexed setting"@en;
                                                                                              rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation>;
                                                                                              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting>;
                                                                                              <http://www.w3.org/2002/07/owl#inverseOf> <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#forEntity>.
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#isTimeIndexFor> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                       rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval>;
                                                                                       rdfs:isDefinedBy tis:;
                                                                                       rdfs:label "is time index for"@en;
                                                                                       rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#TimeIndexedSituation>;
                                                                                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting>;
                                                                                       <http://www.w3.org/2002/07/owl#inverseOf> <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#atTime>.
<http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#TimeInterval> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasAuthor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasComponent> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasUnitTest> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#isSpecializationOf> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
