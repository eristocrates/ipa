@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix tis: <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl#>.
@prefix ti: <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl#>.
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix situ: <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#>.

situ:Situation a owl:Class.
situ:hasSetting a owl:ObjectProperty.
situ:isSettingFor a owl:ObjectProperty.
<http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl> cpa:coversRequirements "At what time did a certain situation occur?,What situations occurred at a certain time?"^^rdf:PlainLiteral;
                                                                        cpa:hasAuthor "Aldo Gangemi"^^rdf:PlainLiteral;
                                                                        cpa:hasComponent "TimeInterval"^^rdf:PlainLiteral;
                                                                        cpa:hasConsequences """We can represent situations that have an explicit time parameter.
In principle, this can be done already with the Situation pattern, but this provides a handy composition with the TimeInterval pattern."""^^rdf:PlainLiteral;
                                                                        cpa:hasIntent "To represent time indexed situations."^^rdf:PlainLiteral;
                                                                        cpa:hasUnitTest """SELECT ?x ?e ?t
WHERE {
?x :forEntity ?e .
?x :atTime ?t }"""^^rdf:PlainLiteral;
                                                                        cpa:isSpecializationOf "Situation"^^rdf:PlainLiteral;
                                                                        cpa:relatedCPs "Time indexed participation,TimeIndexedClassification"^^rdf:PlainLiteral;
                                                                        cpa:scenarios "Mustafa's address in 2005 was in Brussels"^^rdf:PlainLiteral;
                                                                        a owl:Ontology;
                                                                        rdfs:comment "A generic pattern usable for all situations that require a temporal indexing."^^rdf:PlainLiteral;
                                                                        owl:imports <http://www.ontologydesignpatterns.org/cp/owl/timeinterval.owl>,
                                                                                    <http://www.ontologydesignpatterns.org/cp/owl/situation.owl>,
                                                                                    <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                                        owl:versionInfo "1.1 added rdfs:isDefinedBy for all named entities",
                                                                                        """1.0
- Revised, and added annotations for ODP publishing
0.1
- Created by Aldo Gangemi""".
tis:TimeIndexedSituation a owl:Class;
                         rdfs:comment "A Situation that is explicitly indexed at some time for at least one entity.";
                         rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                         rdfs:label "Time indexed situation"@en;
                         rdfs:subClassOf [owl:onProperty tis:atTime ; 
                                          owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty tis:forEntity ; 
                                          owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         situ:Situation.
tis:atTime a owl:ObjectProperty;
           rdfs:domain tis:TimeIndexedSituation;
           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
           rdfs:label "at time"@en;
           rdfs:range ti:TimeInterval;
           rdfs:subPropertyOf situ:isSettingFor.
tis:forEntity a owl:ObjectProperty;
              rdfs:domain tis:TimeIndexedSituation;
              rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
              rdfs:label "for entity"@en;
              rdfs:range owl:Thing;
              rdfs:subPropertyOf situ:isSettingFor.
tis:hasTimeIndexedSetting a owl:ObjectProperty;
                          rdfs:domain owl:Thing;
                          rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                          rdfs:label "has time indexed setting"@en;
                          rdfs:range tis:TimeIndexedSituation;
                          rdfs:subPropertyOf situ:hasSetting;
                          owl:inverseOf tis:forEntity.
tis:isTimeIndexFor a owl:ObjectProperty;
                   rdfs:domain ti:TimeInterval;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/timeindexedsituation.owl>;
                   rdfs:label "is time index for"@en;
                   rdfs:range tis:TimeIndexedSituation;
                   rdfs:subPropertyOf situ:hasSetting;
                   owl:inverseOf tis:atTime.
ti:TimeInterval a owl:Class.
cpa:coversRequirements a owl:AnnotationProperty.
cpa:hasAuthor a owl:AnnotationProperty.
cpa:hasComponent a owl:AnnotationProperty.
cpa:hasConsequences a owl:AnnotationProperty.
cpa:hasIntent a owl:AnnotationProperty.
cpa:hasUnitTest a owl:AnnotationProperty.
cpa:isSpecializationOf a owl:AnnotationProperty.
cpa:relatedCPs a owl:AnnotationProperty.
cpa:scenarios a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:Thing a owl:Class.
owl:versionInfo a owl:AnnotationProperty.
