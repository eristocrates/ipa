juso.kr:0.1 <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/>;
            <http://purl.org/dc/terms/creator> <http://jayg.me/>;
            <http://purl.org/dc/terms/description> """
    South Korea Extension to Juso Ontology is a Web vocabulary that extends
    <a href=\"http://rdfs.co/juso/\">Juso Ontology</a> to descrbe geographical
    addresses and features in South Korea.
    """@en;
            <http://purl.org/dc/terms/hasFormat> <http://rdfs.co/juso/kr/0.1/html>,
                                                 <http://rdfs.co/juso/kr/0.1/rdf>,
                                                 <http://rdfs.co/juso/kr/0.1/ttl>;
            <http://purl.org/dc/terms/identifier> "http://rdfs.co/juso/kr/0.1";
            <http://purl.org/dc/terms/isVersionOf> juso.kr:;
            <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-07+09:00"^^xsd:date;
            <http://purl.org/dc/terms/publisher> <http://listinc.kr/id/listinc>;
            <http://purl.org/dc/terms/rights> "Copyright © 2015 LiST Inc. Some Rights Reserved.";
            <http://purl.org/dc/terms/title> "South Korea Extension to Juso Ontology"@en,
                                             "대한민국 주소 온톨로지"@ko;
            <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
            <http://purl.org/vocab/vann/example> [rdfs:label "LiST Inc."@ko ; 
                                                  rdfs:comment """
    <pre><code>_:YangyongBldg a juso.kr:Building ;
  juso:name \"Yangyong Building\"@en , \"양용빌딩\"@ko ;
  juso:geometry &lt;http://geohash.org/wydjrzg6ece9&gt; ;
  juso.kr:administrative_building_number \"1156011700101210017028596\" .

_:LiSTInc a juso:SpatialThing , foaf:Organization ;
  juso:name \"LiST Inc.\"@en , \"주식회사 리스트\"@ko ;
  juso:within _:YangyongBldg ;
  juso:historical_address [
    a juso.kr:EastAsianAddress ;
    juso:full_address
      \"대한민국 서울특별시 영등포구 당산동 121-17 양용빌딩 9층 150-040\"@ko ,
      \"9th Floor, Yangyong Building, 121-17, Dangsan-dong, Yeongdeungpo-gu, Seoul, 150-040, South Korea\"@en ;
    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;
    juso.kr:si_do &lt;http://sws.geonames.org/1835847/&gt; ;
    juso.kr:si_gun_gu &lt;http://sws.geonames.org/1832536/&gt; ;
    juso.kr:eup_myeon_dong &lt;http://sws.geonames.org/8692617/&gt; ;
    juso.kr:beonji \"121\" ;
    juso.kr:ho \"17\" ;
    juso:locator _:YangyongBldg ;
    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;
    juso:postal_code [
      a juso.kr:PostalCode1988 ;
      rdf:value \"150-040\"
    ]
  ] ;
  juso:address [
    a juso.kr:RoadNameAddress ;
    juso:full_address
      \"대한민국 서울특별시 영등포구 버드나루로19길 3 (당산동) 양용빌딩 9층 07229\"@ko ,
      \"9th Floor, Yangyong Building, 3, Beodeunaru-ro 19-gil, Yeongdeungpo-gu, Seoul, 07229, South Korea\"@en ;
    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;
    juso.kr:si_do &lt;http://sws.geonames.org/1835847/&gt; ;
    juso.kr:si_gun_gu &lt;http://sws.geonames.org/1832536/&gt; ;
    juso.kr:eup_myeon_dong &lt;http://sws.geonames.org/8692617/&gt; ;
    juso:thoroughfare [
      a juso.kr:Road ;
      juso:name \"Beodeunaru-ro 19-gil\"@en , \"버드나루로19길\"@ko ;
      juso:parent &lt;http://sws.geonames.org/8692617/&gt;
      juso.kr:road_name_number \"4154419\" ;
      juso.kr:parent_road [
        a juso.kr:Street ;
        juso:name \"Beodeunaru-ro\"@en , \"버드나루로\"@ko ;
        juso:parent &lt;http://sws.geonames.org/8692617/&gt;
        juso.kr:road_name_number \"3118010\" ;
      ]
    ] ;
    juso.kr:building_number \"3\" ;
    juso:locator _:YangyongBldg ;
    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;
    juso:postal_code [
      a juso.kr:PostalCode2015 ;
      rdf:value \"07229\"
    ] ;
    juso.kr:landform &lt;http://dbpedia.org/resource/Land_lot&gt; ;
    juso.kr:floor &lt;http://dbpedia.org/resource/Storey&gt; ;
    juso.kr:eup_myeon_dong_serial_number \"1\"
  ] .

&lt;http://sws.geonames.org/1832536/&gt; a juso.kr:AutonomousDistrict ;
  juso.kr:si_gun_gu_code \"11560\" .

&lt;http://sws.geonames.org/8692617/&gt; a juso.kr:LegalStatusNeighborhood ;
  juso.kr:legal_status_neighborhood_code \"1156011700\" ;
  juso.kr:eup_myeon_dong_code \"117\" .</code></pre>
    """^^rdf:HTML];
            <http://purl.org/vocab/vann/preferredNamespacePrefix> "juso.kr";
            <http://purl.org/vocab/vann/preferredNamespaceUri> "http://rdfs.co/juso/kr/";
            <http://purl.org/vocab/vann/termGroup> juso.kr:AddressGroup,
                                                   juso.kr:AdministrativeDivisionGroup;
            a <http://creativecommons.org/ns#Work>,
              <http://www.w3.org/2002/07/owl#Ontology>,
              <http://purl.org/vocommons/voaf#Vocabulary>,
              <http://www.w3.org/ns/adms#SemanticAsset>;
            rdfs:comment """
    <div>
      The master version of this vocabulary is maintained in <a
      href=\"https://github.com/listinc/juso-ontology/tree/master/kr\">the GitHub
      repository</a> so others can contribute edits and improvements.
    </div>
    """^^rdf:HTML,
                         """
    Most of the descriptions given here are from Wikipedia or from the related
    ontologies and vocabularies.
    """@en;
            rdfs:seeAlso <https://github.com/listinc/juso-ontology/tree/master/kr>;
            <http://www.w3.org/2002/07/owl#versionInfo> "0.1";
            <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/terms/date> "2015-10-07+09:00"^^xsd:date ; 
                                                              <http://purl.org/dc/terms/creator> <http://jayg.me/> ; 
                                                              rdf:value """
      Fixed the wrong use of rdf:XMLLiteral
      """@en];
            <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/UnderDevelopment>.
<http://rdfs.co/juso/kr/0.1/html> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                     rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ; 
                                                                     rdfs:label "HTML"@en ; 
                                                                     rdf:value "text/html" ; 
                                                                     a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/juso/kr/0.1/rdf> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                    rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ; 
                                                                    rdfs:label "RDF/XML"@en ; 
                                                                    rdf:value "application/rdf+xml" ; 
                                                                    a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/juso/kr/0.1/ttl> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                    rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ; 
                                                                    rdfs:label "Turtle"@en ; 
                                                                    rdf:value "text/turtle" ; 
                                                                    a <http://purl.org/dc/terms/MediaType>].
juso.kr:AddressGroup rdf:_1 juso.kr:EastAsianAddress;
                     rdf:_10 juso.kr:Street;
                     rdf:_11 juso.kr:Road;
                     rdf:_12 juso.kr:road_name_number;
                     rdf:_13 juso.kr:parent_road;
                     rdf:_14 juso.kr:Building;
                     rdf:_15 juso.kr:administrative_building_number;
                     rdf:_16 juso.kr:MultiFamilyResidentialBuilding;
                     rdf:_17 juso.kr:PostalCode1970;
                     rdf:_18 juso.kr:PostalCode1988;
                     rdf:_19 juso.kr:PostalCode2015;
                     rdf:_2 juso.kr:RoadNameAddress;
                     rdf:_20 juso.kr:landform;
                     rdf:_21 juso.kr:floor;
                     rdf:_22 juso.kr:building_number;
                     rdf:_23 juso.kr:building_extra_number;
                     rdf:_24 juso.kr:eup_myeon_dong_serial_number;
                     rdf:_3 juso.kr:si_do;
                     rdf:_4 juso.kr:si_gun_gu;
                     rdf:_5 juso.kr:eup_myeon_dong;
                     rdf:_6 juso.kr:ri;
                     rdf:_7 juso.kr:beonji;
                     rdf:_8 juso.kr:ho;
                     rdf:_9 juso.kr:Boulevard;
                     a rdf:Bag;
                     rdfs:comment """
     These classes and properties are used to describe addresses in South Korea.
     """@en;
                     rdfs:label "Address Terms"@en.
juso.kr:AdministrativeCity <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment """
    Since Jeju was given more autonomy, cities in Jeju could not be defined by
    the Local Autonomy Law so this new class of city was created for Jeju.
    """@en;
                           rdfs:isDefinedBy juso.kr:;
                           rdfs:seeAlso <https://en.wikipedia.org/wiki/Cities_of_South_Korea>,
                                        <https://ko.wikipedia.org/wiki/행정시>;
                           rdfs:subClassOf <http://rdfs.co/juso/SecondLevelAdministrativeDivision>,
                                           <http://rdfs.co/juso/City>;
                           <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:City;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                           <http://www.w3.org/2004/02/skos/core#definition> """
    행정시(行政市)는 대한민국의 행정 구역 중 하나로, 지방자치법 시행 이후 기초자치단체인 자치시로
    전환되면서 사실상 행정시의 기능은 완전히 사라졌다가 특별자치도 제도의 도입으로 제주특별자치도가
    2006년 7월 1일 출범하면서 행정시가 다시 나타났다.
    """@ko,
                                                                            """
    An Administrative city is a type of municipal city that are created in 1
    July 2006 after the 2005 referendum in Jeju and the province was given
    extensive administrative powers that had previously been reserved for the
    central government.
    """@en;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "행정시"@ko,
                                                                           "Administrative City"@en.
juso.kr:AdministrativeDivisionGroup rdf:_1 juso.kr:RegionalLocalGovernment;
                                    rdf:_10 juso.kr:AdministrativeCity;
                                    rdf:_11 juso.kr:County;
                                    rdf:_12 juso.kr:AutonomousDistrict;
                                    rdf:_13 juso.kr:NonAutonomousDistrict;
                                    rdf:_14 juso.kr:si_gun_gu_code;
                                    rdf:_15 juso.kr:Town;
                                    rdf:_16 juso.kr:Township;
                                    rdf:_17 juso.kr:LegalStatusNeighborhood;
                                    rdf:_18 juso.kr:legal_status_neighborhood_code;
                                    rdf:_19 juso.kr:AdministrativeNeighborhood;
                                    rdf:_2 juso.kr:Province;
                                    rdf:_20 juso.kr:administrative_neighborhood_code;
                                    rdf:_21 juso.kr:eup_myeon_dong_code;
                                    rdf:_22 juso.kr:LegalStatusVillage;
                                    rdf:_23 juso.kr:AdministrativeVillage;
                                    rdf:_3 juso.kr:SpecialAutonomousProvince;
                                    rdf:_4 juso.kr:SpecialCity;
                                    rdf:_5 juso.kr:MetropolitanCity;
                                    rdf:_6 juso.kr:MetropolitanAutonomousCity;
                                    rdf:_7 juso.kr:BasicLocalGovernment;
                                    rdf:_8 juso.kr:City;
                                    rdf:_9 juso.kr:SpecificCity;
                                    a rdf:Bag;
                                    rdfs:comment """
    These classes and properties are used to describe administrative divisions
    in South Korea.    
    """@en;
                                    rdfs:label "행정 구역 용어"@ko,
                                               "Administrative Division Terms"@en.
juso.kr:AdministrativeNeighborhood <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment """
    In some cases, a single legal-status neighborhood is divided into several
    administrative neighborhoods. In such cases, each administrative dong has
    its own office and staff.
    """@en;
                                   rdfs:isDefinedBy juso.kr:;
                                   rdfs:seeAlso <https://ko.wikipedia.org/wiki/동_(행정_구역)>,
                                                <https://en.wikipedia.org/wiki/Dong_(administrative_division)>;
                                   rdfs:subClassOf <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>,
                                                   <http://rdfs.co/juso/Neighborhood>;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                   <http://www.w3.org/2004/02/skos/core#definition> """
    An administrative neighborhood is the smallest level of urban government to
    have its own office and staff in South Korea.
    """@en,
                                                                                    """
    행정동(行政洞)은 대한민국의 행정 구역의 하나로 구 또는 시의 하부 행정 구역이다.
    """@ko;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Administrative Neighborhood"@en,
                                                                                   "행정동"@ko.
juso.kr:AdministrativeVillage <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment """
    A legal-status village can be subdivided into one or more administrative
    villages.
    """@en;
                              rdfs:isDefinedBy juso.kr:;
                              rdfs:seeAlso <https://en.wikipedia.org/wiki/Ri_(administrative_division)>,
                                           <https://ko.wikipedia.org/wiki/리_(행정_구역)>;
                              rdfs:subClassOf <http://rdfs.co/juso/Village>,
                                              <http://rdfs.co/juso/FourthLevelAdministrativeDivision>;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                              <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국의 리(里)는 읍(邑)·면(面)의 하부 행정 구역이며, 행정리(行政里)는 인구와 생활권을 고려하여
    법정리에 1개 또는 여러 개로 설치한 행정 구역이다.
    """@ko,
                                                                               """
    A administrative village is an administrative unit in South Korea.
    """@en;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "행정리"@ko,
                                                                              "Administrative Village"@en.
juso.kr:AutonomousDistrict <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy juso.kr:;
                           rdfs:seeAlso <https://en.wikipedia.org/wiki/Gu_(administrative_division)>,
                                        <https://ko.wikipedia.org/wiki/구_(행정_구역)>;
                           rdfs:subClassOf <http://rdfs.co/juso/District>,
                                           juso.kr:BasicLocalGovernment;
                           <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:NonAutonomousDistrict;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                           <http://www.w3.org/2004/02/skos/core#definition> """
    An autonomous district of special and metropolitan cities is a municipal
    entity similar to a city with its own mayor along with its own
    legislative council.
    """@en,
                                                                            """
    자치구(自治區)는 특별시, 광역시의 하위 행정 구역으로서 시, 군과 동급인 기초자치단체이다.
    """@ko;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Autonomous District"@en,
                                                                           "자치구"@ko.
juso.kr:BasicLocalGovernment <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                             a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment """
    Non-autonomous districts of municipal cities and administrative cities in
    Jeju are not basic local governments.
    """@en;
                             rdfs:isDefinedBy juso.kr:;
                             rdfs:seeAlso <https://ko.wikipedia.org/wiki/기초지방자치단체>,
                                          <https://en.wikipedia.org/wiki/Administrative_divisions_of_South_Korea>;
                             rdfs:subClassOf <http://rdfs.co/juso/SecondLevelAdministrativeDivision>;
                             <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:RegionalLocalGovernment;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                             <http://www.w3.org/2004/02/skos/core#altLabel> "Municipality"@en,
                                                                            "Lower-level Local Autonomy"@en,
                                                                            "Municipal Government"@en;
                             <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국의 기초지방자치단체(基礎地方自治團體)는 지방자치단체에서 광역지방자치단체의 하부의
    조직으로서 광역지방자치단체보다 좁은 지역을 관할하는 지방 행정 조직이다.
    """@ko,
                                                                              """
    Basic local governments are the municipal-level administrative division
    within South Korea.
    """@en;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "기초지방자치단체"@ko,
                                                                             "Basic Local Government"@en.
juso.kr:Boulevard <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy juso.kr:;
                  rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
                  rdfs:subClassOf <http://rdfs.co/juso/Street>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    도로명주소에서 대로(大路)는 폭이 40m 이상이거나 왕복 8차선 이상의 도로를 의미한다.
    """@ko,
                                                                   """
    In the Road Name Address system, the word boulevard (daero) is used to
    describe two-way roads that have more than 40m width or 8 lanes.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Boulevard"@en,
                                                                  "대로"@ko.
juso.kr:Building <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy juso.kr:;
                 rdfs:seeAlso <https://en.wikipedia.org/wiki/Building>,
                              <https://ko.wikipedia.org/wiki/건축물>;
                 rdfs:subClassOf <http://rdfs.co/juso/Feature>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "건축물"@ko,
                                                                "구축물"@ko;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    일반적으로 건물(建物)이란 일정 기간 동안 그 형상이 필요하기 때문에, 혹은 그것이 제공하는 공간이
    필요하기 때문에, 인간이 지은 지면에 고정되는 구조물을 뜻한다.
    """@ko,
                                                                  """
    A building is a man-made structure with a roof and walls standing more or
    less permanently in one place, such as a house or factory.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Building"@en,
                                                                 "건물"@ko.
juso.kr:City <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    Cities are ranked on the same level as county and autonomous district.
  """@en;
             rdfs:isDefinedBy juso.kr:;
             rdfs:seeAlso <https://ko.wikipedia.org/wiki/시_(행정_구역)>,
                          <https://en.wikipedia.org/wiki/Cities_of_South_Korea>;
             rdfs:subClassOf <http://rdfs.co/juso/City>,
                             juso.kr:BasicLocalGovernment;
             <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:AdministrativeCity;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    A city is a municipal administrative unit in South Korea.
    """@en,
                                                              """
    시(市)는 대한민국 행정 구역의 하나로 행정시와 달리 기초지방자치단체에 해당한다.
    """@ko;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "시"@ko,
                                                             "City"@en.
juso.kr:County <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
    In South Korea, a county has a population of less than 150,000 (more than
    that would make it a city), is less densely populated than a district, and
    is more rural in character than either of the other 2 divisions.
    """@en;
               rdfs:isDefinedBy juso.kr:;
               rdfs:seeAlso <https://ko.wikipedia.org/wiki/군_(행정_구역)>,
                            <https://en.wikipedia.org/wiki/Gun_(administrative_division)>;
               rdfs:subClassOf <http://rdfs.co/juso/County>,
                               juso.kr:BasicLocalGovernment;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    A county is an administrative unit in South Korea similar.
    """@en,
                                                                """
    군(郡)은 행정 구역의 하나로, 대한민국의 군은 도 및 광역시의 하부 행정 구역이자 기초지방자치단체이다.
    """@ko;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "군"@ko,
                                                               "County"@en.
juso.kr:EastAsianAddress <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy juso.kr:;
                         rdfs:seeAlso <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>,
                                      <https://ko.wikipedia.org/wiki/대한민국의_주소>;
                         rdfs:subClassOf <http://rdfs.co/juso/Address>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                         <http://www.w3.org/2004/02/skos/core#definition> """
    기존 대한민국에서 사용되던 지번 주소 체계는 토지 구획을 정리한 지번을 구분자로 이용하는 주소 체계로
    아직 널리 사용되고 있으나 2014년 1월 1일부터 도로명주소로 대체되어 공식적으로 폐지되었다.
    """@ko,
                                                                          """
    The previous addressing system used in South Korea was the the East Asian
    system, which is also used in Japan and North Korea (but not within the
      Chinese-speaking world), but although still commonly used, is no longer
    officially recognized since December 31, 2013.
    """@en;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "East Asian Address"@en,
                                                                         "지번 주소"@ko.
juso.kr:LegalStatusNeighborhood <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:isDefinedBy juso.kr:;
                                rdfs:seeAlso <https://en.wikipedia.org/wiki/Dong_(administrative_division)>,
                                             <https://ko.wikipedia.org/wiki/법정동>;
                                rdfs:subClassOf <http://rdfs.co/juso/Neighborhood>,
                                                <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                <http://www.w3.org/2004/02/skos/core#definition> """
    법정동(法定洞)은 대한민국 법정 구역으로, 법률(관습법)로 지정된 일정한 명칭과 영역을 지닌
    구역이다.
    """@ko,
                                                                                 """
    A legal-status neighborhood is a submunicipal level administrative unit of
    a city and of those cities which are not divided into districts throughout
    Korea.
    """@en;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "법정동"@ko,
                                                                                "Legal-status Neighborhood"@en.
juso.kr:LegalStatusVillage <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                           <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy juso.kr:;
                           rdfs:seeAlso <https://ko.wikipedia.org/wiki/리_(행정_구역)>,
                                        <https://en.wikipedia.org/wiki/Ri_(administrative_division)>;
                           rdfs:subClassOf <http://rdfs.co/juso/FourthLevelAdministrativeDivision>,
                                           <http://rdfs.co/juso/Village>;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                           <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국의 리(里)는 읍(邑)·면(面)의 하부 행정 구역이며, 법정리(法定里)는 법령으로 정하여진 리로
    지번의 기준이 된다.
    """@ko,
                                                                            """
    A legal-status village is an administrative unit in South Korea.
    """@en;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "법정리"@ko,
                                                                           "Legal-status Village"@en.
juso.kr:MetropolitanAutonomousCity <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment """
    The only metropolitan autonomous city in South Korea called Sejong opened 2
    July 2012.
    """@en;
                                   rdfs:isDefinedBy juso.kr:;
                                   rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
                                                <https://ko.wikipedia.org/wiki/특별자치시>;
                                   rdfs:subClassOf juso.kr:RegionalLocalGovernment,
                                                   <http://rdfs.co/juso/City>;
                                   <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:MetropolitanCity,
                                                                                juso.kr:SpecialCity;
                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                   <http://www.w3.org/2004/02/skos/core#definition> """
    특별자치시(特別自治市)는 대한민국의 행정 구역이다.
    """@ko,
                                                                                    """
    In early 2007, the South Korean government created a special administrative
    district from parts of South Chungcheong and North Chungcheong provinces,
    near Daejeon, to relocate nine ministries and four national agencies from
    Seoul.
    """@en;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Metropolitan Autonomous City"@en,
                                                                                   "특별자치시"@ko.
juso.kr:MetropolitanCity <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """
    They were called \"directly-administered city\" before 1995. These cities
    have equal status to the provinces.
    """@en;
                         rdfs:isDefinedBy juso.kr:;
                         rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
                                      <https://ko.wikipedia.org/wiki/광역시>;
                         rdfs:subClassOf juso.kr:RegionalLocalGovernment,
                                         <http://rdfs.co/juso/City>;
                         <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:SpecialCity,
                                                                      juso.kr:MetropolitanAutonomousCity;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                         <http://www.w3.org/2004/02/skos/core#definition> """
    Metropolitan cities are the highest-ranked administrative divisions in
    South Korea.
    """@en,
                                                                          """
    광역시(廣域市)는 대한민국의 행정 구역이다.
    """@ko;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Metropolitan City"@en,
                                                                         "광역시"@ko.
juso.kr:MultiFamilyResidentialBuilding <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                       a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:isDefinedBy juso.kr:;
                                       rdfs:seeAlso <https://ko.wikipedia.org/wiki/공동_주택>,
                                                    <https://en.wikipedia.org/wiki/Multi-family_residential>;
                                       rdfs:subClassOf juso.kr:Building;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                       <http://www.w3.org/2004/02/skos/core#altLabel> "Multi-dwelling Unit Building"@en,
                                                                                      "MDU Building"@en;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
    A multifamily residential building is a building that contain multiple
    separate housing units for residential inhabitants.
    """@en,
                                                                                        """
    공동 주택(共同住宅)은 하나의 건물 내에 서로 독립적인 여러 세대가 공동으로 거주하는 주거의
    형태이다.
    """@ko;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "공동 주택"@ko,
                                                                                       "Multi-family Residential Building"@en.
juso.kr:NonAutonomousDistrict <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:isDefinedBy juso.kr:;
                              rdfs:seeAlso <https://ko.wikipedia.org/wiki/구_(행정_구역)>,
                                           <https://en.wikipedia.org/wiki/Gu_(administrative_division)>;
                              rdfs:subClassOf <http://rdfs.co/juso/SecondLevelAdministrativeDivision>,
                                              <http://rdfs.co/juso/District>;
                              <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:AutonomousDistrict;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "행정구"@ko,
                                                                             "Administrative District"@en;
                              <http://www.w3.org/2004/02/skos/core#definition> """
    자치구가 아닌 일반구(一般區)는 인구 50만 명 이상인 시(기초자치단체)의 하위 행정 구역이다.
    """@ko,
                                                                               """
    Cities with over 500,000 people are allowed to have non-autonomous
    districts (notable exceptions to this rule are the cities of Gimhae,
    Hwaseong, and Namyangju).
    """@en;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "일반구"@ko,
                                                                              "Non-autonomous District"@en.
juso.kr:PostalCode1970 <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy juso.kr:;
                       rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_postal_codes>,
                                    <https://ko.wikipedia.org/wiki/대한민국의_우편번호>;
                       rdfs:subClassOf <http://rdfs.co/juso/PostalCode>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    The first 5-digit postal code system in South Korea that was rolled out on
    July 1, 1970, and used until January 31, 1988.
    """@en,
                                                                        """
    1970년 7월 1일에 도입되어 1988년 1월 31일까지 사용된 대한민국 최초의 5자리 우편번호.
    """@ko;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Postal Code (1970 - 1988)"@en,
                                                                       "우편번호(1970 ~ 1988)"@ko.
juso.kr:PostalCode1988 <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy juso.kr:;
                       rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_우편번호>,
                                    <https://en.wikipedia.org/wiki/List_of_postal_codes>;
                       rdfs:subClassOf <http://rdfs.co/juso/PostalCode>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    The 6-digit postal code system in South Korea that was rolled out on
    February 1, 1988, and used until July 31, 2015.
    """@en,
                                                                        """
    1988년 2월 1일에 도입되어 2015년 7월 31일까지 사용된 대한민국의 6자리 우편번호.
    """@ko;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "우편번호(1988 ~ 2015)"@ko,
                                                                       "Postal Code (1988 - 2015)"@en.
juso.kr:PostalCode2015 <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy juso.kr:;
                       rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_우편번호>,
                                    <https://en.wikipedia.org/wiki/List_of_postal_codes_in_South_Korea>;
                       rdfs:subClassOf <http://rdfs.co/juso/PostalCode>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    2015년 8월 1일에 도입된 도로명주소 체계 기반 5자리 대한민국 우편번호.
    """@ko,
                                                                        """
    The 5-digit postal code system based on the road name address system in
    South Korea, which has been rolled out on August 1, 2015.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Postal Code (1988 - 2015)"@en,
                                                                       "우편번호(1988 ~ 2015)"@ko.
juso.kr:Province <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy juso.kr:;
                 rdfs:seeAlso <https://ko.wikipedia.org/wiki/도_(행정_구역)>,
                              <https://en.wikipedia.org/wiki/Provinces_of_South_Korea>;
                 rdfs:subClassOf <http://rdfs.co/juso/Province>,
                                 juso.kr:RegionalLocalGovernment;
                 <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:SpecialAutonomousProvince;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "일반도"@ko;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    도(道)는 대한민국의 행정 구역 이름으로 특별자치도와 구분된다.
    """@ko,
                                                                  """
    A province are the highest-ranked administrative divisions in South Korea.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Province"@en,
                                                                 "도"@ko.
juso.kr:RegionalLocalGovernment <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:isDefinedBy juso.kr:;
                                rdfs:seeAlso <https://ko.wikipedia.org/wiki/광역자치단체>,
                                             <https://en.wikipedia.org/wiki/Administrative_divisions_of_South_Korea>;
                                rdfs:subClassOf <http://rdfs.co/juso/FirstLevelAdministrativeDivision>;
                                <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:BasicLocalGovernment;
                                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                <http://www.w3.org/2004/02/skos/core#altLabel> "Metropolitan Government"@en,
                                                                               "Upper-level Local Autonomy"@en;
                                <http://www.w3.org/2004/02/skos/core#definition> """
    Regional local governments are the highest-ranked administrative division
    within South Korea.
    """@en,
                                                                                 """
    대한민국의 광역지방자치단체(廣域地方自治團體)는 지방자치단체 중 기초지방자치단체에 비해 넓은 구역과
    많은 주민을 관할하는 기초지방자치단체 상위의 행정 구역이다.
    """@ko;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "광역지방자치단체"@ko,
                                                                                "Regional Local Government"@en.
juso.kr:Road <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy juso.kr:;
             rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
             rdfs:subClassOf <http://rdfs.co/juso/Street>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    도로명주소에서 길은 폭이 12m 미만이거나 2차로 미만인 도로를 의미한다.
    """@ko,
                                                              """
    In the Road Name Address system, the word road (gil) is used to describe
    roads that have less than 12m width or 2 lanes.
    width or 2 lanes.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Road"@en,
                                                             "길"@ko.
juso.kr:RoadNameAddress <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy juso.kr:;
                        rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>,
                                     <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>;
                        rdfs:subClassOf <http://rdfs.co/juso/Address>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국의 도로명주소란 부여된 도로명, 기초번호, 건물번호, 상세주소에 의하여 건물의 주소를 표기하는
    방식으로 2014년부터 사용되고 있다.
    """@ko,
                                                                         """
    The Road Name Address system, rolled out on January 1, 2014, uses street
    names and house numbers, and is similar to the systems used by the United
    States, Canada, and Europe.
    """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "도로명주소"@ko,
                                                                        "Road Name Address"@en.
juso.kr:SpecialAutonomousProvince <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                  a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment """
    Jeju is the only special autonomous province in South Korea.
    """@en;
                                  rdfs:isDefinedBy juso.kr:;
                                  rdfs:seeAlso <https://en.wikipedia.org/wiki/Provinces_of_South_Korea>,
                                               <https://ko.wikipedia.org/wiki/특별자치도>;
                                  rdfs:subClassOf juso.kr:RegionalLocalGovernment,
                                                  <http://rdfs.co/juso/Province>;
                                  <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:Province;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                  <http://www.w3.org/2004/02/skos/core#altLabel> "Special Self-governing Province"@en;
                                  <http://www.w3.org/2004/02/skos/core#definition> """
    A special autonomous province is a province with more autonomy over its
    economy and more powers are given to the provincial government.
    """@en,
                                                                                   """
    특별자치도(特別自治道)는 대한민국의 행정 구역으로, 일반 도(道)와 기능적으로 거의 동일하지만,
    관련 법률에 의거해 고도의 자치권이 보장된다.
    """@ko;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Special Autonomous Province"@en,
                                                                                  "특별자치도"@ko.
juso.kr:SpecialCity <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy juso.kr:;
                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Special_cities_of_South_Korea>,
                                 <https://ko.wikipedia.org/wiki/특별시>;
                    rdfs:subClassOf <http://rdfs.co/juso/City>,
                                    juso.kr:RegionalLocalGovernment;
                    <http://www.w3.org/2002/07/owl#disjointWith> juso.kr:MetropolitanCity,
                                                                 juso.kr:MetropolitanAutonomousCity;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    특별시(特別市)는 대한민국의 행정 구역으로 서울특별시가 유일하다.
    """@ko,
                                                                     """
    Seoul was designated a \"special free city\" separate from Gyeonggi Province
    on August 15, 1946; it became a \"special city\" on August 15, 1949.
    """@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Special City"@en,
                                                                    "특별시"@ko.
juso.kr:SpecificCity <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
    Specific city are given powers to subdivide themselves into non-autonomous
    districts but, not all Specific city are subdivided into non-autonomous
    districts.
  """@en;
                     rdfs:isDefinedBy juso.kr:;
                     rdfs:seeAlso <https://en.wikipedia.org/wiki/Cities_of_South_Korea>,
                                  <https://ko.wikipedia.org/wiki/특정시>;
                     rdfs:subClassOf juso.kr:City;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    특정시(特定市)는 대한민국의 광역자치단체인 도에 소속된 기초자치단체 중 지방자치법 제175조에 따라
    도지사의 권한 일부가 시장에게 위임된 시를 비공식적으로 일컫는 명칭으로 지방자치법에서는 이를 인구
    50만 이상 대도시라고 규정하고 있다.
    """@ko,
                                                                      """
    A Specific city is a municipal city that has a population greater than
    500,000 and has been designated as such by an order of the National
    Government under Article 175 of the Local Autonomy Law.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Specific City"@en,
                                                                     "특정시"@ko.
juso.kr:Street <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy juso.kr:;
               rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
               rdfs:subClassOf <http://rdfs.co/juso/Street>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    In the Road Name Address system, the word street (ro) is used to
    describe two-way roads that are narrower than roads but have more than 12m
    width or 2 lanes.
    """@en,
                                                                """
    도로명주소에서 로(路)는 대로보다 작지만 폭이 12m 이상이거나 왕복 2차선 이상의 도로를
    의미한다.
    """@ko;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Street"@en,
                                                               "로"@ko.
juso.kr:Town <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
    Along with \"township\", a town is one of the divisions of a county, and of
    some cities with a population of less than 500,000. Towns are subdivided
    into villages.
    """@en;
             rdfs:isDefinedBy juso.kr:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Eup_(administrative_division)>,
                          <https://ko.wikipedia.org/wiki/읍>;
             rdfs:subClassOf <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>,
                             <http://rdfs.co/juso/Town>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국의 읍(邑)은 시·군·구의 하부 행정 구역이다.
    """@ko,
                                                              """
    A town is an administrative unit in South Korea.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "읍"@ko,
                                                             "Town"@en.
juso.kr:Township <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """
    Along with town, township is of a county and some cities of fewer than
    500,000 population. Townships have smaller populations than towns and
    represent the rural areas of a county or city. Townships are subdivided
    into villages.
    """@en;
                 rdfs:isDefinedBy juso.kr:;
                 rdfs:seeAlso <https://en.wikipedia.org/wiki/Myeon_(administrative_division)>,
                              <https://ko.wikipedia.org/wiki/면_(행정_구역)>;
                 rdfs:subClassOf <http://rdfs.co/juso/Township>,
                                 <http://rdfs.co/juso/ThirdLevelAdministrativeDivision>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    면(面)은 대한민국의 자치시·군 또는 행정시의 하부 행정 구역 이름이다.
    """@ko,
                                                                  """
    A township is an administrative unit in South Korea.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Township"@en,
                                                                 "면"@ko.
juso.kr:administrative_building_number <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:domain juso.kr:Building;
                                       rdfs:isDefinedBy juso.kr:;
                                       rdfs:range xsd:string;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
    Each building is given a number for administration.
    """@en,
                                                                                        """
    건물은 관리 번호를 부여 받는다.
    """@ko;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "건물 관리 번호"@ko,
                                                                                       "administrative building number"@en.
juso.kr:administrative_neighborhood_code <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                         rdfs:domain juso.kr:AdministrativeNeighborhood;
                                         rdfs:isDefinedBy juso.kr:;
                                         rdfs:range xsd:string;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
    행정동에 부여된 행정 표준 코드.
    """@ko,
                                                                                          """
    The unique administrative code for the administrative neighborhood.
    """@en;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "administrative neighborhood code"@en,
                                                                                         "행정동코드"@ko.
juso.kr:beonji <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
               <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain juso.kr:EastAsianAddress;
               rdfs:isDefinedBy juso.kr:;
               rdfs:range xsd:string;
               rdfs:seeAlso <https://ko.wikipedia.org/wiki/지번_(토지)>;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
               <http://www.w3.org/2004/02/skos/core#definition> """
    Each neighborhood is divided into city blocks (beonji), which can range
    from several dozen to several thousand per neighborhood.
    """@en,
                                                                """
    번지(番地)는 토지를 구획할 때 어떤 특정한 토지에 붙이는 번호를 의미하는 지번이다.
    """@ko;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "beonji"@en,
                                                               "번지"@ko.
juso.kr:building_extra_number <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                              a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain juso.kr:RoadNameAddress;
                              rdfs:isDefinedBy juso.kr:;
                              rdfs:range xsd:string;
                              rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>,
                                           <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>;
                              rdfs:subPropertyOf <http://rdfs.co/juso/thoroughfare_address>;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                              <http://www.w3.org/2004/02/skos/core#altLabel> "건물 부 번"@ko;
                              <http://www.w3.org/2004/02/skos/core#definition> """
    건물 번호는 본 번과 부 번으로 구성되는데, 한 건물이 두 개의 도로와 인접해 있을 경우, 보다 넓은
    도로로 건물 번호를 부여하고, 한 구간 내 여러 건물이 위치하고 있을 경우 -1, -2, -3처럼 부
    번을 부여하여 본 번을 부여받은 건물과 구별한다.
    """@ko,
                                                                               """
    Buildings on a street or alley that is too small or too short to receive
    a name of its own share the same building number, followed by a hyphen,
    followed by a unique extra number afterwards.
    """@en;
                              <http://www.w3.org/2004/02/skos/core#prefLabel> "건물 부 번호"@ko,
                                                                              "building extra number"@en.
juso.kr:building_number <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain juso.kr:RoadNameAddress;
                        rdfs:isDefinedBy juso.kr:;
                        rdfs:range xsd:string;
                        rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>,
                                     <https://en.wikipedia.org/wiki/Addresses_in_South_Korea>;
                        rdfs:subPropertyOf <http://rdfs.co/juso/thoroughfare_address>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "building main number"@en,
                                                                       "건물 본 번호"@ko,
                                                                       "건물 본 번"@ko;
                        <http://www.w3.org/2004/02/skos/core#definition> """
    Buildings are numbered along a street with even numbers on one side and odd
    numbers on the other, as in most European countries.
    """@en,
                                                                         """
    건물 번호는 건물마다 부여된 번호로 건물번호 도로의 시작점으로부터 왼편에는 홀수를, 오른편에는 짝수를
    대로(Boulevard) 및 로(Street)의 경우 매20미터마다, 길(Road)의 경우 매10미터마다 2씩
    증가시키면서 부여한다.
    """@ko;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "building number"@en,
                                                                        "건물 번호"@ko.
juso.kr:eup_myeon_dong <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:EastAsianAddress
                                                                             juso.kr:RoadNameAddress) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy juso.kr:;
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:Town
                                                                            juso.kr:Township
                                                                            juso.kr:LegalStatusNeighborhood
                                                                            juso.kr:AdministrativeNeighborhood) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:subPropertyOf <http://rdfs.co/juso/third_level_administrative_division>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    The third-level administrative division of the address in South Korea,
    one of the four types of submunicipal-level divisions: towns (eup),
    townships (myeon), legal-status neighborhoods (beopjeongdong), and
    administrative neighborhoods (haengjeongdong).
    """@en,
                                                                        """
    대한민국 주소의 읍면동급 행정 구역으로 읍, 면, 법정동, 행정동 중 하나에 해당한다.
    """@ko;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "읍/면/동"@ko,
                                                                       "town, township, or neighborhood"@en.
juso.kr:eup_myeon_dong_code <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                            a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:Town
                                                                                  juso.kr:Township
                                                                                  juso.kr:LegalStatusNeighborhood
                                                                                  juso.kr:AdministrativeNeighborhood) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:isDefinedBy juso.kr:;
                            rdfs:range xsd:string;
                            rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                            <http://www.w3.org/2004/02/skos/core#definition> """
    Each of towns (eup), townships (myeon), or neighborhoods (dong) is given a
    3-number code.
    """@en,
                                                                             """
    읍, 면, 동은 3자리 코드를 부여 받는다.
    """@ko;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "code for town, township, neighborhood"@en,
                                                                            "읍면동 코드"@ko.
juso.kr:eup_myeon_dong_serial_number <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                     <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                     rdfs:domain juso.kr:RoadNameAddress;
                                     rdfs:isDefinedBy juso.kr:;
                                     rdfs:range xsd:string;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                     <http://www.w3.org/2004/02/skos/core#definition> """
    A serial number for town, township, or neighborhood to distinguish
    addresses that share the same code for city, county, or district, and
    the same road name number.
    """@en,
                                                                                      """
    시군구 코드와 도로명 번호가 중복되는 주소를 구분하기 위한 읍면동 일련 번호.
    """@ko;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "serial number for town, township, or neighborhood"@en,
                                                                                     "읍면동 일련 번호"@ko.
juso.kr:floor <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain juso.kr:RoadNameAddress;
              rdfs:isDefinedBy juso.kr:;
              rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> (<http://dbpedia.org/resource/Storey>
                                                                 <http://dbpedia.org/resource/Basement>
                                                                 <http://dbpedia.org/resource/Sky>) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    주소가 가리키는 곳이 지상인지, 지하인지, 공중인지 여부.
    """@ko,
                                                               """
    Whether the address locates a place on the ground, under the ground, or in
    the air.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "층 구분"@ko,
                                                              "floor"@en.
juso.kr:ho <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment """
    Usually, the words \"번지\" and \"호\" are not included in the written address;
    instead, only their numbers, separated by a hyphen, are written.
    """@en;
           rdfs:domain juso.kr:EastAsianAddress;
           rdfs:isDefinedBy juso.kr:;
           rdfs:range xsd:string;
           rdfs:seeAlso <https://en.wikipedia.org/wiki/House_numbering>,
                        <https://ko.wikipedia.org/wiki/지번_(토지)>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    호(戶)는 건물에 부여된 각 번지 내 건물 번호이다.
    """@ko,
                                                            """
    The building itself is given a house number (ho) within the city block.
    """@en;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "호"@ko,
                                                           "ho"@en.
juso.kr:landform <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain juso.kr:RoadNameAddress;
                 rdfs:isDefinedBy juso.kr:;
                 rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> (<http://dbpedia.org/resource/Land_lot>
                                                                    <http://dbpedia.org/resource/Mountain>) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    주소 필지의 산 여부.
    """@ko,
                                                                  """
    Whether the address locates a land lot or a mountain.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "landform"@en,
                                                                 "필지 구분"@ko.
juso.kr:legal_status_neighborhood_code <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                       rdfs:domain juso.kr:LegalStatusNeighborhood;
                                       rdfs:isDefinedBy juso.kr:;
                                       rdfs:range xsd:string;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
    The unique administrative code for the legal-status neighborhood.
    """@en,
                                                                                        """
    법정동에 부여된 행정 표준 코드.
    """@ko;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "법정동코드"@ko,
                                                                                       "legal-status neighborhood code"@en.
juso.kr:parent_road <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:Boulevard
                                                                          juso.kr:Street
                                                                          juso.kr:Road) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:isDefinedBy juso.kr:;
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:Boulevard
                                                                         juso.kr:Street
                                                                         juso.kr:Road) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature>;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    A boulevard, street, or road that is a direct parent of the current one.
    """@en,
                                                                     """
    이 도로의 상위에 있는 대로, 로, 길.
    """@ko;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "상위 도로"@ko,
                                                                    "parent boulevard, street, or road"@en.
juso.kr:ri <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
           <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:EastAsianAddress
                                                                 juso.kr:RoadNameAddress) ; 
                        a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:isDefinedBy juso.kr:;
           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:LegalStatusVillage
                                                                juso.kr:AdministrativeVillage) ; 
                       a <http://www.w3.org/2002/07/owl#Class>];
           rdfs:subPropertyOf <http://rdfs.co/juso/fourth_level_administrative_division>;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
           <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국 주소의 리통급 행정 구역 중 현재는 거의 사용되지 않는 통을 제외한 법정리 또는 행정리에
    해당한다.
    """@ko,
                                                            """
    A legal-status village (beopjeongri) or administrative village
    (haengjeongri) for the fourth-level administrative division of the address
    in South Korea.
    """@en;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "리"@ko,
                                                           "village"@en.
juso.kr:road_name_number <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                         a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:Boulevard
                                                                               juso.kr:Street
                                                                               juso.kr:Road) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                         rdfs:isDefinedBy juso.kr:;
                         rdfs:range xsd:string;
                         rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                         <http://www.w3.org/2004/02/skos/core#definition> """
    Each of boulevards, streets, or roads is given a 7-number code.
    """@en,
                                                                          """
    대로, 로, 길은 7자리 코드를 부여 받는다.
    """@ko;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "road name number"@en,
                                                                         "도로명 번호"@ko.
juso.kr:si_do <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:EastAsianAddress
                                                                    juso.kr:RoadNameAddress) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:isDefinedBy juso.kr:;
              rdfs:range juso.kr:RegionalLocalGovernment;
              rdfs:subPropertyOf <http://rdfs.co/juso/first_level_administrative_division>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국 주소의 시도급 행정 구역으로 1개의 특별시, 6개의 광역시, 8개의 도, 1개의 특별자치시,
    1개의 특별자치도 중 하나에 해당한다.
    """@ko,
                                                               """
    The top tier of administrative division of the address in South Korea,
    one of the five types of provincial-level divisions: provinces (do),
    special autonomous provinces (teukbyeol-jachido), special cities
    (teukbyeolsi), metropolitan cities (gwangyeoksi) and metropolitan
    autonomous cities (teukbyeol-jachisi).
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "시/도"@ko,
                                                              "city or province"@en.
juso.kr:si_gun_gu <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:EastAsianAddress
                                                                        juso.kr:RoadNameAddress) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy juso.kr:;
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:BasicLocalGovernment
                                                                       juso.kr:NonAutonomousDistrict) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf <http://rdfs.co/juso/second_level_administrative_division>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    대한민국 주소의 시군구급 행정 구역으로 시, 특정시, 행정시, 군, 자치구, 일반구 중 하나에
    해당한다.
    """@ko,
                                                                   """
    The second-level administrative division of the address in South Korea,
    one of the six types of municipal-level divisions: cities (si), specific
    cities (teukjeongsi), administrative cities (haengjeongsi), county (gun),
    autonomous districts (jachigu), and non-autonomous districts (ilbangu).
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "city, county, or district"@en,
                                                                  "시/군/구"@ko.
juso.kr:si_gun_gu_code <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (juso.kr:BasicLocalGovernment
                                                                             juso.kr:NonAutonomousDistrict) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy juso.kr:;
                       rdfs:range xsd:string;
                       rdfs:seeAlso <https://ko.wikipedia.org/wiki/대한민국의_주소>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    시, 군, 구는 5자리 코드를 부여받는다.
    """@ko,
                                                                        """
    Each of cities (si), counties (gun), or districts (gu) is given a 5-number
    code.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "시군구 코드"@ko,
                                                                       "code for city, county, or district"@en.
