@base <http://www.daml.org/services/owl-s/1.2/Profile.owl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix service: <http://www.daml.org/services/owl-s/1.2/Service.owl#>.
@prefix process: <http://www.daml.org/services/owl-s/1.2/Process.owl#>.
@prefix : <http://www.daml.org/services/owl-s/1.2/Profile.owl#>.
@prefix owls: <http://www.daml.org/services/owl-s/1.2/Service.owl#>.
@prefix owlse: <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#>.
@prefix owls_Expression: <http://www.daml.org/services/owl-s/1.2/generic/Expression.owl#>.
@prefix owls_Process: <http://www.daml.org/services/owl-s/1.2/Process.owl#>.
@prefix owls_Profile: <http://www.daml.org/services/owl-s/1.2/Profile.owl#>.
@prefix owls_Service: <http://www.daml.org/services/owl-s/1.2/Service.owl#>.
@prefix w3: <http://www.w3.org/>.

<http://www.daml.org/services/owl-s/1.2/Process.owl> a owl:Ontology.
<http://www.daml.org/services/owl-s/1.2/Profile.owl> a owl:Ontology;
                                                     rdfs:comment """
      OWL ontology for Advertisements (i.e. Profiles).
      This file belongs to the OWL-S Release.
      Initial version created by Terry Payne (trp@ecs.soton.ac.uk).
      Modified by Massimo Paolucci (paolucci@cs.cmu.edu)
      Modified by David Martin and other members of the OWL-S Coalition.

    """;
                                                     rdfs:seeAlso <http://www.daml.org/services/owl-s/1.2/ProfileAdditionalParameters.owl>,
                                                                  <http://www.daml.org/services/owl-s/1.2/ProfileDeprecatedElements.owl>,
                                                                  <http://www.daml.org/services/owl-s/1.2/ActorDefault.owl>;
                                                     owl:imports <http://www.daml.org/services/owl-s/1.2/Service.owl>,
                                                                 <http://www.daml.org/services/owl-s/1.2/Process.owl>;
                                                     owl:versionInfo """
      $Id: Profile.owl,v 1.52 2004/11/28 16:29:55 martin Exp $
    """.
:Profile a owl:Class;
         rdfs:comment """
      Definition of Profile
    """,
                      """
    A profile can have only one name
    """,
                      """
    A profile can have only one text description
    """;
         rdfs:label "Profile";
         rdfs:subClassOf service:ServiceProfile,
                         [a owl:Restriction ; 
                          owl:onProperty :serviceName ; 
                          owl:cardinality "1"^^xsd:nonNegativeInteger],
                         [a owl:Restriction ; 
                          owl:onProperty :textDescription ; 
                          owl:cardinality "1"^^xsd:nonNegativeInteger].
:ServiceCategory a owl:Class;
                 rdfs:comment """
    a ServiceCategory is restricted to refer to only onename
    """,
                              """
    a ServiceCategory is restricted to refer to only one taxonomy
    """;
                 rdfs:subClassOf [a owl:Restriction ; 
                                  owl:onProperty :categoryName ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger],
                                 [a owl:Restriction ; 
                                  owl:onProperty :taxonomy ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger],
                                 [a owl:Restriction ; 
                                  owl:onProperty :value ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger],
                                 [a owl:Restriction ; 
                                  owl:onProperty :code ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger].
:ServiceParameter a owl:Class;
                  rdfs:comment """
    A ServiceParameter should have at most 1 name (more precisely only
      one serviceParameterName)
    """,
                               """
    a Parameter is restricted to refer to only one concept in some
    ontology
    """;
                  rdfs:subClassOf [a owl:Restriction ; 
                                   owl:onProperty :serviceParameterName ; 
                                   owl:cardinality "1"^^xsd:nonNegativeInteger],
                                  [a owl:Restriction ; 
                                   owl:onProperty :sParameter ; 
                                   owl:cardinality "1"^^xsd:nonNegativeInteger].
:categoryName a owl:DatatypeProperty;
              rdfs:domain :ServiceCategory.
:code a owl:DatatypeProperty;
      rdfs:domain :ServiceCategory.
:contactInformation a owl:ObjectProperty;
                    rdfs:domain :Profile.
:hasInput a owl:ObjectProperty;
          rdfs:range process:Input;
          rdfs:subPropertyOf :hasParameter.
:hasOutput a owl:ObjectProperty;
           rdfs:range process:Output;
           rdfs:subPropertyOf :hasParameter.
:hasParameter a owl:ObjectProperty;
              rdfs:domain :Profile;
              rdfs:range process:Parameter.
:hasPrecondition a owl:ObjectProperty;
                 rdfs:domain :Profile;
                 rdfs:range owlse:Condition.
:hasResult a owl:ObjectProperty;
           rdfs:domain :Profile;
           rdfs:range process:Result.
:has_process a owl:ObjectProperty,
               owl:FunctionalProperty;
             rdfs:domain :Profile;
             rdfs:range process:Process.
:sParameter a owl:ObjectProperty;
            rdfs:domain :ServiceParameter;
            rdfs:range owl:Thing.
:serviceCategory a owl:ObjectProperty;
                 rdfs:domain :Profile;
                 rdfs:range :ServiceCategory.
:serviceClassification a owl:DatatypeProperty;
                       rdfs:domain :Profile;
                       rdfs:range xsd:anyURI.
:serviceName a owl:DatatypeProperty;
             rdfs:domain :Profile.
:serviceParameter a owl:ObjectProperty;
                  rdfs:domain :Profile;
                  rdfs:range :ServiceParameter.
:serviceParameterName a owl:DatatypeProperty;
                      rdfs:domain :ServiceParameter.
:serviceProduct a owl:DatatypeProperty;
                rdfs:domain :Profile;
                rdfs:range xsd:anyURI.
:taxonomy a owl:DatatypeProperty;
          rdfs:domain :ServiceCategory.
:textDescription a owl:DatatypeProperty;
                 rdfs:domain :Profile.
:value a owl:DatatypeProperty;
       rdfs:domain :ServiceCategory.
<http://www.daml.org/services/owl-s/1.2/Service.owl> a owl:Ontology.
