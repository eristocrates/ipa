<http://mex.aksw.org/mex-core> dc11:publisher "AKSW Grupo de Pesquisa - Universidade de Leipzig"@pt,
                                              "AKSW Research Group - Leipzig University"@en;
                               dcterms:contributor aksw:JensLehmann.html,
                                                   aksw:DiegoMoussallem.html;
                               dcterms:created "2014-02-02"^^xsd:date;
                               dcterms:creator aksw:DiegoEsteves.html;
                               dcterms:modified "2016-05-01"^^xsd:date;
                               dcterms:title "MEX Core (mex-core) is an ontology with the goal of describing the core process for machine learning problems (MEX Platform)"@en;
                               rdf:about "http://mex.aksw.org/mex-doc-core#";
                               a owl:Ontology;
                               rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-core layer represents the core information gathered from a basic machine learning experiment design."@en,
                                            "MEX e um vocabulario modelado para facilitar a interoperabilidade entre resultados de experimentos de aprendizado de maquinas publicados na Web. A camada mex-core representa a principal informacao obtida de um experimento de aprendizado de maquina."@pt;
                               rdfs:label "Vocabulario MEX (mex-core)"@pt,
                                          "The MEX Vocabulary (mex-core)"@en;
                               owl:imports rdfs:,
                                           <http://www.w3.org/ns/prov-o#>,
                                           doap:;
                               owl:versionInfo "1.0.2".
mexcore:AdaptativeWebSites a owl:Class;
                           rdfs:subClassOf mexcore:Context.
mexcore:AffectiveComputing a owl:Class;
                           rdfs:subClassOf mexcore:Context.
mexcore:ApplicationContext a owl:Class;
                           rdfs:comment "describes the context of the experiment, such as NLP, Stock Market Forecast, BioInformatics, Text-Retrieval AND contact informations/publication"@en;
                           rdfs:subClassOf <http://www.w3.org/ns/prov-o#Person>,
                                           <http://www.w3.org/ns/prov-o#Organization>,
                                           <http://www.w3.org/ns/prov-o#Agent>,
                                           mexcore:DomainConceptSpace.
mexcore:Bioinformatics a owl:Class;
                       rdfs:subClassOf mexcore:Context.
mexcore:Bootstrapping a owl:Class;
                      rdfs:subClassOf mexcore:SamplingMethod.
mexcore:BrainMachineInterfaces a owl:Class;
                               rdfs:subClassOf mexcore:Context.
mexcore:Cheminformatics a owl:Class;
