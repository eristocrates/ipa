                                mexcore:DomainConceptSpace.
mexcore:CrossValidation a owl:Class;
                        rdfs:subClassOf mexcore:SamplingMethod.
mexcore:Dataset dc11:description "Class that provides a structured dataset"@en;
                a owl:Class;
                rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity>,
                                mexcore:DomainConceptSpace.
