@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix oc: <http://contextus.net/ontology/ontomedia/core/expression#>.
@prefix being: <http://contextus.net/ontology/ontomedia/ext/common/being#>.
@prefix trait: <http://contextus.net/ontology/ontomedia/ext/common/trait#>.
@prefix akt: <http://www.aktors.org/ontology/portal#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

oc:Abstract-Item a owl:Class.
oc:Entity a owl:Class.
oc:Event a owl:Class.
oc:Physical-Item a owl:Class.
oc:Timeline a owl:Class.
being:Character a owl:Class.
being:Group a owl:Class.
being:Profession a owl:Class.
trait: dc11:creator "Mischa M Tuffield (mailto:mmt04r@ecs.soton.ac.uk)",
                    "K Faith Lawrence (mailto:kf03r@ecs.soton.ac.uk)",
                    "Michael O. Jewell (mailto:moj@ecs.soton.ac.uk)";
       dc11:description "OntoMedia (Ontology for Media) has been designed to describe the traits of entities."@en;
       dc11:title "OntoMedia Trait"@en;
       dcterms:created "2005-05-11";
       a owl:Ontology;
       rdfs:label "OntoMedia Trait Representation";
       owl:versionInfo "0.2".
trait:Abstract-Component a owl:Class;
                         rdfs:comment "This class represents a component part of an abstract item";
                         rdfs:label "Abstract Component";
                         rdfs:subClassOf trait:Value.
trait:Abstract-Obstacle a owl:Class;
                        rdfs:comment "This class represents an abstract problem or obstacle";
                        rdfs:label "Abstract Obstacle";
                        rdfs:subClassOf trait:Trait,
                                        trait:Being-Trait.
trait:Adult a owl:Class;
            rdfs:comment "This class represents the adult stage of life of an entity";
            rdfs:label "Adult";
            rdfs:subClassOf trait:Stage-Of-Life.
trait:Age a owl:Class;
          rdfs:comment "This class represents the age of an Entity";
          rdfs:label "Age";
          rdfs:subClassOf trait:Trait,
                          trait:Being-Trait.
trait:Alive a owl:Class;
            rdfs:comment "This class describes an Entity which is alive";
            rdfs:label "Living";
            rdfs:subClassOf trait:State-Of-Being;
            owl:disjointWith trait:Dead,
                             trait:Undead,
                             trait:Unprovable,
                             trait:Inanimate,
                             trait:Unknown.
trait:Altered a owl:Class;
              rdfs:comment "This class describes an Entity whose consciousness is not in its normal state";
              rdfs:label "Altered Consciousness";
              rdfs:subClassOf trait:State-Of-Consciousness.
trait:Asleep a owl:Class;
             rdfs:comment "This class describes an Entity which is asleep";
             rdfs:label "Asleep";
             rdfs:subClassOf trait:State-Of-Consciousness;
             owl:disjointWith [owl:unionOf (trait:Conscious
                                            trait:Unresponsive
                                            trait:Instinctual) ; 
                               a owl:Class].
trait:Behavioural-Sex a owl:Class;
                      rdfs:comment "This class represents the behavioural or psychological sex of an entity";
                      rdfs:label "Behavioural Sex";
                      rdfs:subClassOf trait:Sex.
trait:Being-Trait a owl:Class;
                  rdfs:comment "This class represents the characteristics that describe a Character Entity";
                  rdfs:label "Character Trait";
                  rdfs:subClassOf trait:Trait.
trait:Build a owl:Class;
            rdfs:comment "This class represents a physical build type";
            rdfs:label "Build";
            rdfs:subClassOf trait:Description.
trait:Child a owl:Class;
            rdfs:comment "This class represents the child stage of life of an entity";
            rdfs:label "Child";
            rdfs:subClassOf trait:Young.
trait:Colour a owl:Class;
             rdfs:comment "This class represents colours";
             rdfs:label "Colour";
             rdfs:subClassOf trait:Description.
trait:Conscious a owl:Class;
                rdfs:comment "This class describes an Entity which is conscious";
                rdfs:label "Conscious";
                rdfs:subClassOf trait:State-Of-Consciousness;
                owl:disjointWith [owl:unionOf (trait:Unresponsive
                                               trait:Asleep
                                               trait:Instinctual) ; 
                                  a owl:Class].
trait:Corporeal a owl:Class;
                rdfs:comment "This class describes an Entity which is corporeal";
                rdfs:label "Corporeal";
                rdfs:subClassOf trait:State-Of-Form;
                owl:disjointWith trait:Incorporeal.
trait:Dead a owl:Class;
           rdfs:comment "This class describes an Entity which is dead";
           rdfs:label "Dead";
           rdfs:subClassOf trait:State-Of-Being;
           owl:disjointWith [owl:unionOf (trait:Unknown
                                          trait:NonExistent
                                          trait:Alive
                                          trait:Undead
                                          trait:Inanimate) ; 
                             a owl:Class].
trait:Description a owl:Class;
                  rdfs:comment "This class represents the physical description of an Entity";
                  rdfs:label "Description";
                  rdfs:subClassOf trait:Trait,
                                  trait:Being-Trait.
trait:Dimension a owl:Class;
                rdfs:comment "This class represents a dimension";
                rdfs:label "Dimension";
                rdfs:subClassOf trait:Description.
trait:Distinguishing-Mark a owl:Class;
                          rdfs:comment "This class represents a distinguishing mark";
                          rdfs:label "Distinguishing Mark";
                          rdfs:subClassOf trait:Description.
trait:Ecstatic a owl:Class;
               rdfs:comment "This class describes an Entity whose consciousness is ecstatic";
               rdfs:label "Ecstatic Consciousness";
               rdfs:subClassOf trait:State-Of-Consciousness.
trait:Employment a owl:Class;
                 rdfs:comment "This class represents the employment or other type of job undertaken by an Entity";
                 rdfs:label "Employment";
                 rdfs:subClassOf trait:Trait,
                                 trait:Being-Trait.
trait:Ethnicity a owl:Class;
                rdfs:comment "This class represents the ethnicity of an Entity";
                rdfs:label "Ethnicity";
                rdfs:subClassOf trait:Trait,
                                trait:Being-Trait.
trait:Faith a owl:Class;
            rdfs:comment "This class represents the religious or spiritual preference or preferences of a Character Entity";
            rdfs:label "Faith";
            rdfs:subClassOf trait:Being-Trait.
trait:Female a owl:Class;
             rdfs:comment "This class represents the female gender";
             rdfs:label "Female";
             rdfs:subClassOf trait:Gender.
trait:Gas a owl:Class;
          rdfs:comment "This class describes an Entity which is a gas";
          rdfs:label "Gas";
          rdfs:subClassOf trait:Incorporeal.
trait:Gender a owl:Class;
             rdfs:comment "This class represents the gender of an Entity";
             rdfs:label "Gender";
             rdfs:subClassOf trait:Being-Trait;
             owl:equivalentClass akt:Gender.
trait:Genetic-Sex a owl:Class;
                  rdfs:comment "This class represents the genetic or chromosomal sex of an entity";
                  rdfs:label "Genetic Sex";
                  rdfs:subClassOf trait:Sex.
trait:Gonadal-Sex a owl:Class;
                  rdfs:comment "This class represents the gonadal (reproductive system) sex of an entity";
                  rdfs:label "Gonadal Sex";
                  rdfs:subClassOf trait:Sex.
trait:Inanimate a owl:Class;
                rdfs:comment "This class describes an Entity which exists but is not, never was or never can be alive";
                rdfs:label "Inanimate";
                rdfs:subClassOf trait:State-Of-Being;
                owl:disjointWith [owl:unionOf (trait:Dead
                                               trait:Undead
                                               trait:NonExistent
                                               trait:Alive
                                               trait:Unprovable
                                               trait:Unknown) ; 
                                  a owl:Class].
trait:Incorporeal a owl:Class;
                  rdfs:comment "This class describes an Entity which is incorporeal";
                  rdfs:label "Incorporeal";
                  rdfs:subClassOf trait:State-Of-Form;
                  owl:disjointWith trait:Corporeal.
trait:Instinctual a owl:Class;
                  rdfs:comment "This class describes an Entity that is working at a totally instinctual/subconscious level";
                  rdfs:label "Instinctual/Subconscious";
                  rdfs:subClassOf trait:State-Of-Consciousness;
                  owl:disjointWith trait:Conscious,
                                   trait:Unresponsive.
trait:Kink a owl:Class;
           rdfs:comment "This class represents the sexual kinks or fetishes of a Character Entity. This is distinct from and in addition to a Character Entities' sexuality.";
           rdfs:label "Kink";
           rdfs:subClassOf trait:Being-Trait.
trait:Knowledge a owl:Class;
                rdfs:comment "This class represents things known by an Entity";
                rdfs:label "Knowledge";
                rdfs:subClassOf trait:Trait,
                                trait:Being-Trait.
trait:Link a owl:Class;
           rdfs:comment "This class represents links between this and other Entities";
           rdfs:label "Link";
           rdfs:subClassOf trait:Trait,
                           trait:Being-Trait.
trait:Liquid a owl:Class;
             rdfs:comment "This class describes an Entity which is a liquid";
             rdfs:label "Liquid";
             rdfs:subClassOf trait:Corporeal.
trait:Male a owl:Class;
           rdfs:comment "This class represents the male gender";
           rdfs:label "Male";
           rdfs:subClassOf trait:Gender.
trait:Material a owl:Class;
               rdfs:comment "This class represents a type of material";
               rdfs:label "Material";
               rdfs:subClassOf trait:Description.
trait:Motivation a owl:Class;
                 rdfs:comment "This class represents the motivation of an Entity";
                 rdfs:label "Motivation";
                 rdfs:subClassOf trait:Trait,
                                 trait:Being-Trait.
trait:Name a owl:Class;
           rdfs:comment "This class represents the name or equivilent designation of an Entity";
           rdfs:label "Name";
           rdfs:subClassOf trait:Trait,
                           trait:Being-Trait.
trait:Neuter a owl:Class;
             rdfs:comment "This class represents the neuter gender";
             rdfs:label "Neuter";
             rdfs:subClassOf trait:Gender.
trait:Non-Existent a owl:Class;
                   rdfs:comment "This class describes an Entity which does not exist";
                   rdfs:label "Non-Existent";
                   rdfs:subClassOf trait:State-Of-Being;
                   owl:disjointWith trait:Unknown,
                                    trait:Unprovable,
                                    trait:Undead,
                                    trait:Inanimate,
                                    trait:Alive,
                                    trait:Dead.
trait:NonExistent a owl:Class.
trait:Old a owl:Class;
          rdfs:comment "This class represents the old stage of life of an entity";
          rdfs:label "Old";
          rdfs:subClassOf trait:Stage-Of-Life.
trait:Ordering a owl:Class;
               rdfs:comment "This class represents an ordering of Entities";
               rdfs:label "Ordering";
               rdfs:subClassOf trait:Trait,
                               trait:Being-Trait.
trait:Other a owl:Class;
            rdfs:comment "This class represents other genders";
            rdfs:label "Other";
            rdfs:subClassOf trait:Gender.
trait:Phenotypic-Sex a owl:Class;
                     rdfs:comment "This class represents the phenotypic (body type/attributes) sex of an entity";
                     rdfs:label "Phenotypic Sex";
                     rdfs:subClassOf trait:Sex.
trait:Physical-Obstacle a owl:Class;
                        rdfs:comment "This class represents a physical problem or obstacle";
                        rdfs:label "Physical Obstacle";
                        rdfs:subClassOf oc:Physical-Item.
trait:Sex a owl:Class;
          rdfs:comment "This class represents the sex of a Entity";
          rdfs:label "Sex";
          rdfs:subClassOf trait:Being-Trait,
                          trait:Trait.
trait:Sexuality a owl:Class;
                rdfs:comment "This class represents the sexual preference or preferences of a Character Entity";
                rdfs:label "Sexuality";
                rdfs:subClassOf trait:Being-Trait.
trait:Solid a owl:Class;
            rdfs:comment "This class describes an Entity which is a solid";
            rdfs:label "Solid";
            rdfs:subClassOf trait:Corporeal.
trait:Species a owl:Class;
              rdfs:comment "This class represents the species of an Entity";
              rdfs:label "Species";
              rdfs:subClassOf trait:Trait,
                              trait:Being-Trait.
trait:Stage-Of-Life a owl:Class;
                    rdfs:comment "This class represents the stage of life of an Entity";
                    rdfs:label "Stage of Life";
                    rdfs:subClassOf trait:Trait,
                                    trait:Being-Trait.
trait:State-Of-Being a owl:Class;
                     rdfs:comment "This class represents the state of being of an Entity";
                     rdfs:label "State of Being";
                     rdfs:subClassOf trait:Trait,
                                     trait:Being-Trait.
trait:State-Of-Consciousness a owl:Class;
                             rdfs:comment "This class represents the state of consciousness of an Entity";
                             rdfs:label "State of Consciousness";
                             rdfs:subClassOf trait:Trait,
                                             trait:Being-Trait.
trait:State-Of-Form a owl:Class;
                    rdfs:comment "This class represents the state of form of an Entity";
                    rdfs:label "State of Form";
                    rdfs:subClassOf trait:Trait,
                                    trait:Being-Trait.
trait:Style a owl:Class;
            rdfs:comment "This class represents a style type";
            rdfs:label "Style";
            rdfs:subClassOf trait:Description.
trait:Teenager a owl:Class;
               rdfs:comment "This class represents the teenage stage of life of an entity";
               rdfs:label "Teenage";
               rdfs:subClassOf trait:Young.
trait:To-None a owl:Class;
              rdfs:comment "This class represents having  a Character Entity with no sexual preference or preferences to other Entities";
              rdfs:label "To No Gender/Asexual";
              rdfs:subClassOf trait:Sexuality;
              owl:disjointWith trait:To-Other-Gender,
                               trait:To-Same-Gender.
trait:To-Other-Gender a owl:Class;
                      rdfs:comment "This class represents the sexual preference or preferences of a Character Entity to other Entities which have a different gender trait. This might not be exclusive.";
                      rdfs:label "To Other Gender";
                      rdfs:subClassOf trait:Sexuality.
trait:To-Same-Gender a owl:Class;
                     rdfs:comment "This class represents the sexual preference or preferences of a Character Entity to other Entities which share the same gender trait. This might not be exclusive.";
                     rdfs:label "To Same Gender";
                     rdfs:subClassOf trait:Sexuality.
trait:Trait a owl:Class;
            rdfs:comment "This class represents the characteristics that describe an Entity";
            rdfs:label "Trait";
            rdfs:subClassOf oc:Abstract-Item.
trait:Type a owl:Class;
           rdfs:comment "This class represents a type";
           rdfs:label "Type";
           rdfs:subClassOf trait:Description.
trait:Unconscious a owl:Class;
                  rdfs:comment "This class describes an Entity which is unconscious";
                  rdfs:label "Unconscious";
                  rdfs:subClassOf trait:State-Of-Consciousness;
                  owl:disjointWith [owl:unionOf (trait:Conscious
                                                 trait:Unresponsive
                                                 trait:Asleep
                                                 trait:Instinctual) ; 
                                    a owl:Class].
trait:Undead a owl:Class;
             rdfs:comment "This class describes an Entity which is undead";
             rdfs:label "Undead";
             rdfs:subClassOf trait:State-Of-Being;
             owl:disjointWith [owl:unionOf (trait:Unprovable
                                            trait:NonExistent
                                            trait:Unknown
                                            trait:Dead
                                            trait:Alive
                                            trait:Inanimate) ; 
                               a owl:Class].
trait:Unknown a owl:Class;
              rdfs:comment "This class describes an Entity those state of existance is not unknown but is theoretically provable";
              rdfs:label "Unknown";
              rdfs:subClassOf trait:State-Of-Being;
              owl:disjointWith trait:Dead,
                               [owl:unionOf (trait:Alive
                                             trait:NonExistent
                                             trait:Unprovable
                                             trait:Undead
                                             trait:Inanimate) ; 
                                a owl:Class].
trait:Unprovable a owl:Class;
                 rdfs:comment "This class describes an Entity those state of existance cannot be proved";
                 rdfs:label "Unprovable";
                 rdfs:subClassOf trait:State-Of-Being;
                 owl:disjointWith [owl:unionOf (trait:Unknown
                                                trait:NonExistent
                                                trait:Dead
                                                trait:Undead
                                                trait:Inanimate
                                                trait:Alive) ; 
                                   a owl:Class].
trait:Unresponsive a owl:Class;
                   rdfs:comment "This class describes an Entity which is totally unresponsive to external stimuli i.e. coma";
                   rdfs:label "Unresponsive";
                   rdfs:subClassOf trait:State-Of-Consciousness;
                   owl:disjointWith trait:Conscious,
                                    trait:Instinctual.
trait:Value a owl:Class;
            rdfs:comment "This class represents the value of an Entity";
            rdfs:label "Value";
            rdfs:subClassOf trait:Trait.
trait:Virgin a owl:Class;
             rdfs:comment "This class represents the pre-sexually active stage of life of an entity";
             rdfs:label "Virgin";
             rdfs:subClassOf trait:Stage-Of-Life.
trait:Void a owl:Class;
           rdfs:comment "This class describes an Entity which is a void";
           rdfs:label "Void";
           rdfs:subClassOf trait:Incorporeal.
trait:Young a owl:Class;
            rdfs:comment "This class represents the young stage of life of an entity";
            rdfs:label "Young";
            rdfs:subClassOf trait:Stage-Of-Life.
trait:Young-Adult a owl:Class;
                  rdfs:comment "This class represents the young adult stage of life of an entity";
                  rdfs:label "Young Adult";
                  rdfs:subClassOf trait:Young.
trait:believes a owl:ObjectProperty;
               rdfs:comment "This property specifies the religion the entity has faith in.";
               rdfs:domain trait:Faith;
               rdfs:label "Believes";
               rdfs:range <http://contextus.net/ontology/ontomedia/ext/detail/know#Religion>.
trait:has-age a owl:FunctionalProperty;
              rdfs:comment "This property specifies the age of the entity";
              rdfs:domain trait:Age;
              rdfs:label "Age";
              rdfs:range trait:Value.
trait:has-birthday a owl:FunctionalProperty;
                   rdfs:comment "This property specifies the date of birth or creation of the entity";
                   rdfs:domain trait:Age;
                   rdfs:label "Birthday";
                   rdfs:range <http://contextus.net/ontology/ontomedia/owl/misc/date#Date>.
trait:has-bond a owl:ObjectProperty;
               rdfs:comment "This property specifies a bond which a character has";
               rdfs:domain trait:Link;
               rdfs:label "Has Bond";
               rdfs:range being:Bond.
trait:has-description a owl:ObjectProperty;
                      rdfs:comment "This property specifies a description of the entity";
                      rdfs:domain trait:Description;
                      rdfs:label "Has Description";
                      rdfs:range [owl:unionOf (rdfs:Literal
                                               trait:Description) ; 
                                  a owl:Class].
trait:has-dimension a owl:FunctionalProperty;
                    rdfs:comment "This property specifies the dimension";
                    rdfs:domain trait:Dimension;
                    rdfs:label "Dimension";
                    rdfs:range [owl:oneOf ("X"
                                           "Y"
                                           "Z"
                                           "length"
                                           "width"
                                           "height"
                                           "weight"
                                           "mass") ; 
                                a owl:DataRange].
trait:has-feature a owl:ObjectProperty;
                  rdfs:comment "This property specifies a physical feature of the entity";
                  rdfs:domain trait:Description;
                  rdfs:label "Has Feature";
                  rdfs:range oc:Physical-Item;
                  rdfs:subPropertyOf trait:has-description.
trait:has-locspec-description a owl:FunctionalProperty;
                              rdfs:comment "This property specifies the units for the dimension";
                              rdfs:domain trait:Dimension;
                              rdfs:label "Unit";
                              rdfs:range <http://contextus.net/ontology/ontomedia/core/media#spc>.
trait:has-motivation a owl:ObjectProperty;
                     rdfs:comment "This property specifies an event whose occurrence is desired";
                     rdfs:domain trait:Motivation;
                     rdfs:label "Has Motivation";
                     rdfs:range oc:Event.
trait:has-motivation-to-avoid a owl:ObjectProperty;
                              rdfs:comment "This property specifies an event whose occurrence is not wanted";
                              rdfs:domain trait:Motivation;
                              rdfs:label "Has Motivation";
                              rdfs:range oc:Event.
trait:has-name a owl:ObjectProperty;
               rdfs:comment "This property specifies the full name of the entity";
               rdfs:domain trait:Name;
               rdfs:label "Given Name";
               rdfs:range <http://ontomedia.ecs.soton.ac.uk/ontologies/misc/name#Name-Ordering>.
trait:has-observed-profession a owl:ObjectProperty;
                              rdfs:comment "This property specifies a profession which belongs to an Entity and is known outside the Context in which the Entity exists but not by other Entities within the Context i.e the audience knows";
                              rdfs:domain trait:Employment;
                              rdfs:label "Has Observed Profession";
                              rdfs:range being:Profession.
trait:has-observed-trait a owl:ObjectProperty;
                         rdfs:comment "This property specifies a trait which belongs to an Entity and is known outside the Context in which the Entity exists but not by other Entities within the Context i.e the audience knows";
                         rdfs:domain oc:Entity;
                         rdfs:label "Has Observed Trait";
                         rdfs:range trait:Trait.
trait:has-order a owl:ObjectProperty;
                rdfs:comment "This property specifies the order that the linked components go in";
                rdfs:domain trait:Ordering;
                rdfs:label "Has Order";
                rdfs:range rdf:Seq.
trait:has-priority a owl:FunctionalProperty;
                   rdfs:comment "Priority of motivation";
                   rdfs:domain trait:Motivation;
                   rdfs:range [owl:oneOf ("high"
                                          "medium"
                                          "low"
                                          "longterm") ; 
                               a owl:DataRange].
trait:has-profession a owl:ObjectProperty;
                     rdfs:comment "This property specifies the profession of an Entity";
                     rdfs:domain trait:Employment;
                     rdfs:label "Has Profession";
                     rdfs:range being:Profession.
trait:has-projected-profession a owl:ObjectProperty;
                               rdfs:comment "This property specifies a profession which is projected by Entity to other Entities";
                               rdfs:domain trait:Employment;
                               rdfs:label "Has Projected Profession";
                               rdfs:range being:Profession.
trait:has-projected-trait a owl:ObjectProperty;
                          rdfs:comment "This property specifies a trait which is projected by Entity to other Entities";
                          rdfs:domain oc:Entity;
                          rdfs:label "Has Projected Trait";
                          rdfs:range trait:Trait.
trait:has-sex-chromosomes a owl:ObjectProperty;
                          rdfs:comment "This property specifies the sex chromosomes of an entity";
                          rdfs:domain trait:Genetic-Sex;
                          rdfs:label "Has Sex Chromosomes";
                          rdfs:range rdfs:Literal.
trait:has-trait a owl:ObjectProperty;
                rdfs:comment "This property specifies a general trait which belongs to an Entity";
                rdfs:domain oc:Entity;
                rdfs:label "Has Trait";
                rdfs:range trait:Trait.
trait:has-unit a owl:FunctionalProperty;
               rdfs:comment "This property specifies the units for the dimension or value";
               rdfs:domain [owl:unionOf (trait:Value
                                         trait:Dimension) ; 
                            a owl:Class];
               rdfs:label "Unit";
               rdfs:range [owl:unionOf (<http://contextus.net/ontology/ontomedia/owl/misc/date#Date-Component>
                                        rdfs:Literal) ; 
                           a owl:Class].
trait:has-value a owl:ObjectProperty;
                rdfs:comment "This property specifies a value of the property or entity";
                rdfs:domain trait:Value;
                rdfs:label "Has Value";
                rdfs:range rdfs:Literal.
trait:identified-with a owl:ObjectProperty;
                      rdfs:comment "This property specifies the gender that a particular sex classification or attribute is identified with";
                      rdfs:domain trait:Sex;
                      rdfs:label "Identified With";
                      rdfs:range trait:Gender.
trait:knows a owl:ObjectProperty;
            rdfs:comment "This property specifies something known by the character";
            rdfs:domain trait:Knowledge;
            rdfs:label "Knows";
            rdfs:range [owl:unionOf (oc:Abstract-Item
                                     being:Character
                                     <http://contextus.net/ontology/ontomedia/misc/locspec#Space>
                                     oc:Timeline
                                     oc:Event) ; 
                        a owl:Class].
trait:likes a owl:ObjectProperty;
            rdfs:comment "This property specifies the 'likes' of the Character. Has domain of To-Other-Gender but not To-Same-Gender because same gender implies a match whereas since there are three genders 'other' gender gives you a choice of possibles.";
            rdfs:domain [owl:unionOf (trait:To-Other-Gender
                                      trait:Kink) ; 
                         a owl:Class];
            rdfs:label "Likes";
            rdfs:range [owl:unionOf (oc:Entity
                                     oc:Event) ; 
                        a owl:Class].
trait:mark-gained a owl:ObjectProperty;
                  rdfs:comment "This property specifies the event at which the distinguishing mark of the entity was gained";
                  rdfs:domain trait:Distinguishing-Mark;
                  rdfs:label "Mark Gained";
                  rdfs:range oc:Event.
trait:mark-location a owl:ObjectProperty;
                    rdfs:comment "This property specifies the location of a distinguishing mark";
                    rdfs:domain trait:Distinguishing-Mark;
                    rdfs:label "Mark Location";
                    rdfs:range [owl:unionOf (oc:Physical-Item
                                             <http://contextus.net/ontology/ontomedia/misc/locspec#Space>) ; 
                                a owl:Class];
                    owl:inverseOf trait:has-marking.
trait:mark-location-type a owl:ObjectProperty;
                         rdfs:comment "This property specifies the location of a distinguishing mark";
                         rdfs:domain trait:Distinguishing-Mark;
                         rdfs:label "Mark Location";
                         rdfs:range [owl:unionOf (oc:Physical-Item
                                                  <http://contextus.net/ontology/ontomedia/misc/locspec#Space>) ; 
                                     a owl:Class].
trait:not-projected-at a owl:ObjectProperty;
                       rdfs:comment "This property specifies the Entity or Entities at which the related trait is not projected at";
                       rdfs:domain [owl:unionOf (trait:Trait
                                                 being:Profession) ; 
                                    a owl:Class];
                       rdfs:label "Not Projected At";
                       rdfs:range oc:Entity.
trait:order_of_magnitude a owl:ObjectProperty;
                         rdfs:comment "This property specifies the order of magnitude of the value. Useful list: http://chemistry.berkeley.edu/links/weights/powers.html";
                         rdfs:domain trait:Value;
                         rdfs:label "Order of Magnitude";
                         rdfs:range rdfs:Literal.
trait:projected-at a owl:ObjectProperty;
                   rdfs:comment "This property specifies the Entity or Entities at which the related trait is projected at";
                   rdfs:domain [owl:unionOf (trait:Trait
                                             being:Profession) ; 
                                a owl:Class];
                   rdfs:label "Projected At";
                   rdfs:range oc:Entity.
trait:requires a owl:ObjectProperty;
               rdfs:comment "This property specifies a fetish of the Character";
               rdfs:domain trait:Kink;
               rdfs:label "Requires";
               rdfs:range [owl:unionOf (oc:Entity
                                        oc:Event) ; 
                           a owl:Class].
trait:responsible-for a owl:ObjectProperty;
                      rdfs:comment "This property specifies the entities for which the Entity is responsible for";
                      rdfs:domain trait:Employment;
                      rdfs:label "Responsible For";
                      rdfs:range [owl:unionOf (being:Group
                                               being:Character
                                               being:Profession
                                               trait:Employment) ; 
                                  a owl:Class].
trait:responsible-for-type a owl:ObjectProperty;
                           rdfs:comment "This property specifies the types of entities for which the Entity is responsible for";
                           rdfs:domain trait:Employment;
                           rdfs:label "Responsible For Type";
                           rdfs:range [owl:unionOf (being:Group
                                                    being:Character
                                                    being:Profession
                                                    trait:Employment) ; 
                                       a owl:Class].
<http://contextus.net/ontology/ontomedia/misc/locspec#Space> a owl:Class.
<http://contextus.net/ontology/ontomedia/owl/misc/date#Date-Component> a owl:Class.
rdfs:Literal a owl:Class.
