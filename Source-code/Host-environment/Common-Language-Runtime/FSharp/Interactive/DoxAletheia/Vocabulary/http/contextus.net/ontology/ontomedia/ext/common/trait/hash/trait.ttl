@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix trait: <http://contextus.net/ontology/ontomedia/ext/common/trait#>.

<http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Entity> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Event> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Physical-Item> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Timeline> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/ext/common/being#Character> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/ext/common/being#Group> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/ext/common/being#Profession> a <http://www.w3.org/2002/07/owl#Class>.
trait: <http://purl.org/dc/elements/1.1/creator> "Mischa M Tuffield (mailto:mmt04r@ecs.soton.ac.uk)",
                                                 "K Faith Lawrence (mailto:kf03r@ecs.soton.ac.uk)",
                                                 "Michael O. Jewell (mailto:moj@ecs.soton.ac.uk)";
       <http://purl.org/dc/elements/1.1/description> "OntoMedia (Ontology for Media) has been designed to describe the traits of entities."@en;
       <http://purl.org/dc/elements/1.1/title> "OntoMedia Trait"@en;
       <http://purl.org/dc/terms/created> "2005-05-11";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "OntoMedia Trait Representation";
       <http://www.w3.org/2002/07/owl#versionInfo> "0.2".
trait:Abstract-Component a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "This class represents a component part of an abstract item";
                         rdfs:label "Abstract Component";
                         rdfs:subClassOf trait:Value.
trait:Abstract-Obstacle a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "This class represents an abstract problem or obstacle";
                        rdfs:label "Abstract Obstacle";
                        rdfs:subClassOf trait:Trait,
                                        trait:Being-Trait.
trait:Adult a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the adult stage of life of an entity";
            rdfs:label "Adult";
            rdfs:subClassOf trait:Stage-Of-Life.
trait:Age a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents the age of an Entity";
          rdfs:label "Age";
          rdfs:subClassOf trait:Trait,
                          trait:Being-Trait.
trait:Alive a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class describes an Entity which is alive";
            rdfs:label "Living";
            rdfs:subClassOf trait:State-Of-Being;
            <http://www.w3.org/2002/07/owl#disjointWith> trait:Dead,
                                                         trait:Undead,
                                                         trait:Unprovable,
                                                         trait:Inanimate,
                                                         trait:Unknown.
trait:Altered a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class describes an Entity whose consciousness is not in its normal state";
              rdfs:label "Altered Consciousness";
              rdfs:subClassOf trait:State-Of-Consciousness.
trait:Asleep a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class describes an Entity which is asleep";
             rdfs:label "Asleep";
             rdfs:subClassOf trait:State-Of-Consciousness;
             <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Conscious
                                                                                                    trait:Unresponsive
                                                                                                    trait:Instinctual) ; 
                                                           a <http://www.w3.org/2002/07/owl#Class>].
trait:Behavioural-Sex a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This class represents the behavioural or psychological sex of an entity";
                      rdfs:label "Behavioural Sex";
                      rdfs:subClassOf trait:Sex.
trait:Being-Trait a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents the characteristics that describe a Character Entity";
                  rdfs:label "Character Trait";
                  rdfs:subClassOf trait:Trait.
trait:Build a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a physical build type";
            rdfs:label "Build";
            rdfs:subClassOf trait:Description.
trait:Child a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the child stage of life of an entity";
            rdfs:label "Child";
            rdfs:subClassOf trait:Young.
trait:Colour a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents colours";
             rdfs:label "Colour";
             rdfs:subClassOf trait:Description.
trait:Conscious a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class describes an Entity which is conscious";
                rdfs:label "Conscious";
                rdfs:subClassOf trait:State-Of-Consciousness;
                <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Unresponsive
                                                                                                       trait:Asleep
                                                                                                       trait:Instinctual) ; 
                                                              a <http://www.w3.org/2002/07/owl#Class>].
trait:Corporeal a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class describes an Entity which is corporeal";
                rdfs:label "Corporeal";
                rdfs:subClassOf trait:State-Of-Form;
                <http://www.w3.org/2002/07/owl#disjointWith> trait:Incorporeal.
trait:Dead a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class describes an Entity which is dead";
           rdfs:label "Dead";
           rdfs:subClassOf trait:State-Of-Being;
           <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Unknown
                                                                                                  trait:NonExistent
                                                                                                  trait:Alive
                                                                                                  trait:Undead
                                                                                                  trait:Inanimate) ; 
                                                         a <http://www.w3.org/2002/07/owl#Class>].
trait:Description a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents the physical description of an Entity";
                  rdfs:label "Description";
                  rdfs:subClassOf trait:Trait,
                                  trait:Being-Trait.
trait:Dimension a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents a dimension";
                rdfs:label "Dimension";
                rdfs:subClassOf trait:Description.
trait:Distinguishing-Mark a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "This class represents a distinguishing mark";
                          rdfs:label "Distinguishing Mark";
                          rdfs:subClassOf trait:Description.
trait:Ecstatic a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class describes an Entity whose consciousness is ecstatic";
               rdfs:label "Ecstatic Consciousness";
               rdfs:subClassOf trait:State-Of-Consciousness.
trait:Employment a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents the employment or other type of job undertaken by an Entity";
                 rdfs:label "Employment";
                 rdfs:subClassOf trait:Trait,
                                 trait:Being-Trait.
trait:Ethnicity a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents the ethnicity of an Entity";
                rdfs:label "Ethnicity";
                rdfs:subClassOf trait:Trait,
                                trait:Being-Trait.
trait:Faith a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the religious or spiritual preference or preferences of a Character Entity";
            rdfs:label "Faith";
            rdfs:subClassOf trait:Being-Trait.
trait:Female a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents the female gender";
             rdfs:label "Female";
             rdfs:subClassOf trait:Gender.
trait:Gas a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class describes an Entity which is a gas";
          rdfs:label "Gas";
          rdfs:subClassOf trait:Incorporeal.
trait:Gender a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents the gender of an Entity";
             rdfs:label "Gender";
             rdfs:subClassOf trait:Being-Trait;
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.aktors.org/ontology/portal#Gender>.
trait:Genetic-Sex a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents the genetic or chromosomal sex of an entity";
                  rdfs:label "Genetic Sex";
                  rdfs:subClassOf trait:Sex.
trait:Gonadal-Sex a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents the gonadal (reproductive system) sex of an entity";
                  rdfs:label "Gonadal Sex";
                  rdfs:subClassOf trait:Sex.
trait:Inanimate a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class describes an Entity which exists but is not, never was or never can be alive";
                rdfs:label "Inanimate";
                rdfs:subClassOf trait:State-Of-Being;
                <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Dead
                                                                                                       trait:Undead
                                                                                                       trait:NonExistent
                                                                                                       trait:Alive
                                                                                                       trait:Unprovable
                                                                                                       trait:Unknown) ; 
                                                              a <http://www.w3.org/2002/07/owl#Class>].
trait:Incorporeal a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class describes an Entity which is incorporeal";
                  rdfs:label "Incorporeal";
                  rdfs:subClassOf trait:State-Of-Form;
                  <http://www.w3.org/2002/07/owl#disjointWith> trait:Corporeal.
trait:Instinctual a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class describes an Entity that is working at a totally instinctual/subconscious level";
                  rdfs:label "Instinctual/Subconscious";
                  rdfs:subClassOf trait:State-Of-Consciousness;
                  <http://www.w3.org/2002/07/owl#disjointWith> trait:Conscious,
                                                               trait:Unresponsive.
trait:Kink a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents the sexual kinks or fetishes of a Character Entity. This is distinct from and in addition to a Character Entities' sexuality.";
           rdfs:label "Kink";
           rdfs:subClassOf trait:Being-Trait.
trait:Knowledge a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents things known by an Entity";
                rdfs:label "Knowledge";
                rdfs:subClassOf trait:Trait,
                                trait:Being-Trait.
trait:Link a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents links between this and other Entities";
           rdfs:label "Link";
           rdfs:subClassOf trait:Trait,
                           trait:Being-Trait.
trait:Liquid a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class describes an Entity which is a liquid";
             rdfs:label "Liquid";
             rdfs:subClassOf trait:Corporeal.
trait:Male a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents the male gender";
           rdfs:label "Male";
           rdfs:subClassOf trait:Gender.
trait:Material a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class represents a type of material";
               rdfs:label "Material";
               rdfs:subClassOf trait:Description.
trait:Motivation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents the motivation of an Entity";
                 rdfs:label "Motivation";
                 rdfs:subClassOf trait:Trait,
                                 trait:Being-Trait.
trait:Name a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents the name or equivilent designation of an Entity";
           rdfs:label "Name";
           rdfs:subClassOf trait:Trait,
                           trait:Being-Trait.
trait:Neuter a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents the neuter gender";
             rdfs:label "Neuter";
             rdfs:subClassOf trait:Gender.
trait:Non-Existent a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class describes an Entity which does not exist";
                   rdfs:label "Non-Existent";
                   rdfs:subClassOf trait:State-Of-Being;
                   <http://www.w3.org/2002/07/owl#disjointWith> trait:Unknown,
                                                                trait:Unprovable,
                                                                trait:Undead,
                                                                trait:Inanimate,
                                                                trait:Alive,
                                                                trait:Dead.
trait:NonExistent a <http://www.w3.org/2002/07/owl#Class>.
trait:Old a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents the old stage of life of an entity";
          rdfs:label "Old";
          rdfs:subClassOf trait:Stage-Of-Life.
trait:Ordering a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class represents an ordering of Entities";
               rdfs:label "Ordering";
               rdfs:subClassOf trait:Trait,
                               trait:Being-Trait.
trait:Other a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents other genders";
            rdfs:label "Other";
            rdfs:subClassOf trait:Gender.
trait:Phenotypic-Sex a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This class represents the phenotypic (body type/attributes) sex of an entity";
                     rdfs:label "Phenotypic Sex";
                     rdfs:subClassOf trait:Sex.
trait:Physical-Obstacle a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "This class represents a physical problem or obstacle";
                        rdfs:label "Physical Obstacle";
                        rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Physical-Item>.
trait:Sex a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This class represents the sex of a Entity";
          rdfs:label "Sex";
          rdfs:subClassOf trait:Being-Trait,
                          trait:Trait.
trait:Sexuality a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents the sexual preference or preferences of a Character Entity";
                rdfs:label "Sexuality";
                rdfs:subClassOf trait:Being-Trait.
trait:Solid a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class describes an Entity which is a solid";
            rdfs:label "Solid";
            rdfs:subClassOf trait:Corporeal.
trait:Species a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents the species of an Entity";
              rdfs:label "Species";
              rdfs:subClassOf trait:Trait,
                              trait:Being-Trait.
trait:Stage-Of-Life a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "This class represents the stage of life of an Entity";
                    rdfs:label "Stage of Life";
                    rdfs:subClassOf trait:Trait,
                                    trait:Being-Trait.
trait:State-Of-Being a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This class represents the state of being of an Entity";
                     rdfs:label "State of Being";
                     rdfs:subClassOf trait:Trait,
                                     trait:Being-Trait.
trait:State-Of-Consciousness a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "This class represents the state of consciousness of an Entity";
                             rdfs:label "State of Consciousness";
                             rdfs:subClassOf trait:Trait,
                                             trait:Being-Trait.
trait:State-Of-Form a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "This class represents the state of form of an Entity";
                    rdfs:label "State of Form";
                    rdfs:subClassOf trait:Trait,
                                    trait:Being-Trait.
trait:Style a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a style type";
            rdfs:label "Style";
            rdfs:subClassOf trait:Description.
trait:Teenager a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class represents the teenage stage of life of an entity";
               rdfs:label "Teenage";
               rdfs:subClassOf trait:Young.
trait:To-None a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents having  a Character Entity with no sexual preference or preferences to other Entities";
              rdfs:label "To No Gender/Asexual";
              rdfs:subClassOf trait:Sexuality;
              <http://www.w3.org/2002/07/owl#disjointWith> trait:To-Other-Gender,
                                                           trait:To-Same-Gender.
trait:To-Other-Gender a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This class represents the sexual preference or preferences of a Character Entity to other Entities which have a different gender trait. This might not be exclusive.";
                      rdfs:label "To Other Gender";
                      rdfs:subClassOf trait:Sexuality.
trait:To-Same-Gender a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This class represents the sexual preference or preferences of a Character Entity to other Entities which share the same gender trait. This might not be exclusive.";
                     rdfs:label "To Same Gender";
                     rdfs:subClassOf trait:Sexuality.
trait:Trait a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the characteristics that describe an Entity";
            rdfs:label "Trait";
            rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
trait:Type a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents a type";
           rdfs:label "Type";
           rdfs:subClassOf trait:Description.
trait:Unconscious a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class describes an Entity which is unconscious";
                  rdfs:label "Unconscious";
                  rdfs:subClassOf trait:State-Of-Consciousness;
                  <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Conscious
                                                                                                         trait:Unresponsive
                                                                                                         trait:Asleep
                                                                                                         trait:Instinctual) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>].
trait:Undead a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class describes an Entity which is undead";
             rdfs:label "Undead";
             rdfs:subClassOf trait:State-Of-Being;
             <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Unprovable
                                                                                                    trait:NonExistent
                                                                                                    trait:Unknown
                                                                                                    trait:Dead
                                                                                                    trait:Alive
                                                                                                    trait:Inanimate) ; 
                                                           a <http://www.w3.org/2002/07/owl#Class>].
trait:Unknown a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class describes an Entity those state of existance is not unknown but is theoretically provable";
              rdfs:label "Unknown";
              rdfs:subClassOf trait:State-Of-Being;
              <http://www.w3.org/2002/07/owl#disjointWith> trait:Dead,
                                                           [<http://www.w3.org/2002/07/owl#unionOf> (trait:Alive
                                                                                                     trait:NonExistent
                                                                                                     trait:Unprovable
                                                                                                     trait:Undead
                                                                                                     trait:Inanimate) ; 
                                                            a <http://www.w3.org/2002/07/owl#Class>].
trait:Unprovable a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class describes an Entity those state of existance cannot be proved";
                 rdfs:label "Unprovable";
                 rdfs:subClassOf trait:State-Of-Being;
                 <http://www.w3.org/2002/07/owl#disjointWith> [<http://www.w3.org/2002/07/owl#unionOf> (trait:Unknown
                                                                                                        trait:NonExistent
                                                                                                        trait:Dead
                                                                                                        trait:Undead
                                                                                                        trait:Inanimate
                                                                                                        trait:Alive) ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>].
trait:Unresponsive a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class describes an Entity which is totally unresponsive to external stimuli i.e. coma";
                   rdfs:label "Unresponsive";
                   rdfs:subClassOf trait:State-Of-Consciousness;
                   <http://www.w3.org/2002/07/owl#disjointWith> trait:Conscious,
                                                                trait:Instinctual.
trait:Value a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the value of an Entity";
            rdfs:label "Value";
            rdfs:subClassOf trait:Trait.
trait:Virgin a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents the pre-sexually active stage of life of an entity";
             rdfs:label "Virgin";
             rdfs:subClassOf trait:Stage-Of-Life.
trait:Void a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class describes an Entity which is a void";
           rdfs:label "Void";
           rdfs:subClassOf trait:Incorporeal.
trait:Young a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents the young stage of life of an entity";
            rdfs:label "Young";
            rdfs:subClassOf trait:Stage-Of-Life.
trait:Young-Adult a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents the young adult stage of life of an entity";
                  rdfs:label "Young Adult";
                  rdfs:subClassOf trait:Young.
trait:believes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property specifies the religion the entity has faith in.";
               rdfs:domain trait:Faith;
               rdfs:label "Believes";
               rdfs:range <http://contextus.net/ontology/ontomedia/ext/detail/know#Religion>.
trait:has-age a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "This property specifies the age of the entity";
              rdfs:domain trait:Age;
              rdfs:label "Age";
              rdfs:range trait:Value.
trait:has-birthday a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "This property specifies the date of birth or creation of the entity";
                   rdfs:domain trait:Age;
                   rdfs:label "Birthday";
                   rdfs:range <http://contextus.net/ontology/ontomedia/owl/misc/date#Date>.
trait:has-bond a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property specifies a bond which a character has";
               rdfs:domain trait:Link;
               rdfs:label "Has Bond";
               rdfs:range <http://contextus.net/ontology/ontomedia/ext/common/being#Bond>.
trait:has-description a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property specifies a description of the entity";
                      rdfs:domain trait:Description;
                      rdfs:label "Has Description";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (rdfs:Literal
                                                                           trait:Description) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
trait:has-dimension a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "This property specifies the dimension";
                    rdfs:domain trait:Dimension;
                    rdfs:label "Dimension";
                    rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("X"
                                                                       "Y"
                                                                       "Z"
                                                                       "length"
                                                                       "width"
                                                                       "height"
                                                                       "weight"
                                                                       "mass") ; 
                                a <http://www.w3.org/2002/07/owl#DataRange>].
trait:has-feature a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "This property specifies a physical feature of the entity";
                  rdfs:domain trait:Description;
                  rdfs:label "Has Feature";
                  rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Physical-Item>;
                  rdfs:subPropertyOf trait:has-description.
trait:has-locspec-description a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                              rdfs:comment "This property specifies the units for the dimension";
                              rdfs:domain trait:Dimension;
                              rdfs:label "Unit";
                              rdfs:range <http://contextus.net/ontology/ontomedia/core/media#spc>.
trait:has-motivation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "This property specifies an event whose occurrence is desired";
                     rdfs:domain trait:Motivation;
                     rdfs:label "Has Motivation";
                     rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
trait:has-motivation-to-avoid a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "This property specifies an event whose occurrence is not wanted";
                              rdfs:domain trait:Motivation;
                              rdfs:label "Has Motivation";
                              rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
trait:has-name a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property specifies the full name of the entity";
               rdfs:domain trait:Name;
               rdfs:label "Given Name";
               rdfs:range <http://ontomedia.ecs.soton.ac.uk/ontologies/misc/name#Name-Ordering>.
trait:has-observed-profession a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "This property specifies a profession which belongs to an Entity and is known outside the Context in which the Entity exists but not by other Entities within the Context i.e the audience knows";
                              rdfs:domain trait:Employment;
                              rdfs:label "Has Observed Profession";
                              rdfs:range <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>.
trait:has-observed-trait a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property specifies a trait which belongs to an Entity and is known outside the Context in which the Entity exists but not by other Entities within the Context i.e the audience knows";
                         rdfs:domain <http://contextus.net/ontology/ontomedia/core/expression#Entity>;
                         rdfs:label "Has Observed Trait";
                         rdfs:range trait:Trait.
trait:has-order a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property specifies the order that the linked components go in";
                rdfs:domain trait:Ordering;
                rdfs:label "Has Order";
                rdfs:range rdf:Seq.
trait:has-priority a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "Priority of motivation";
                   rdfs:domain trait:Motivation;
                   rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("high"
                                                                      "medium"
                                                                      "low"
                                                                      "longterm") ; 
                               a <http://www.w3.org/2002/07/owl#DataRange>].
trait:has-profession a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "This property specifies the profession of an Entity";
                     rdfs:domain trait:Employment;
                     rdfs:label "Has Profession";
                     rdfs:range <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>.
trait:has-projected-profession a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "This property specifies a profession which is projected by Entity to other Entities";
                               rdfs:domain trait:Employment;
                               rdfs:label "Has Projected Profession";
                               rdfs:range <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>.
trait:has-projected-trait a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "This property specifies a trait which is projected by Entity to other Entities";
                          rdfs:domain <http://contextus.net/ontology/ontomedia/core/expression#Entity>;
                          rdfs:label "Has Projected Trait";
                          rdfs:range trait:Trait.
trait:has-sex-chromosomes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "This property specifies the sex chromosomes of an entity";
                          rdfs:domain trait:Genetic-Sex;
                          rdfs:label "Has Sex Chromosomes";
                          rdfs:range rdfs:Literal.
trait:has-trait a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property specifies a general trait which belongs to an Entity";
                rdfs:domain <http://contextus.net/ontology/ontomedia/core/expression#Entity>;
                rdfs:label "Has Trait";
                rdfs:range trait:Trait.
trait:has-unit a <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "This property specifies the units for the dimension or value";
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (trait:Value
                                                                     trait:Dimension) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "Unit";
               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/owl/misc/date#Date-Component>
                                                                    rdfs:Literal) ; 
                           a <http://www.w3.org/2002/07/owl#Class>].
trait:has-value a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property specifies a value of the property or entity";
                rdfs:domain trait:Value;
                rdfs:label "Has Value";
                rdfs:range rdfs:Literal.
trait:identified-with a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property specifies the gender that a particular sex classification or attribute is identified with";
                      rdfs:domain trait:Sex;
                      rdfs:label "Identified With";
                      rdfs:range trait:Gender.
trait:knows a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "This property specifies something known by the character";
            rdfs:domain trait:Knowledge;
            rdfs:label "Knows";
            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>
                                                                 <http://contextus.net/ontology/ontomedia/ext/common/being#Character>
                                                                 <http://contextus.net/ontology/ontomedia/misc/locspec#Space>
                                                                 <http://contextus.net/ontology/ontomedia/core/expression#Timeline>
                                                                 <http://contextus.net/ontology/ontomedia/core/expression#Event>) ; 
                        a <http://www.w3.org/2002/07/owl#Class>].
trait:likes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "This property specifies the 'likes' of the Character. Has domain of To-Other-Gender but not To-Same-Gender because same gender implies a match whereas since there are three genders 'other' gender gives you a choice of possibles.";
            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (trait:To-Other-Gender
                                                                  trait:Kink) ; 
                         a <http://www.w3.org/2002/07/owl#Class>];
            rdfs:label "Likes";
            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Entity>
                                                                 <http://contextus.net/ontology/ontomedia/core/expression#Event>) ; 
                        a <http://www.w3.org/2002/07/owl#Class>].
trait:mark-gained a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "This property specifies the event at which the distinguishing mark of the entity was gained";
                  rdfs:domain trait:Distinguishing-Mark;
                  rdfs:label "Mark Gained";
                  rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
trait:mark-location a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property specifies the location of a distinguishing mark";
                    rdfs:domain trait:Distinguishing-Mark;
                    rdfs:label "Mark Location";
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Physical-Item>
                                                                         <http://contextus.net/ontology/ontomedia/misc/locspec#Space>) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                    <http://www.w3.org/2002/07/owl#inverseOf> trait:has-marking.
trait:mark-location-type a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property specifies the location of a distinguishing mark";
                         rdfs:domain trait:Distinguishing-Mark;
                         rdfs:label "Mark Location";
                         rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Physical-Item>
                                                                              <http://contextus.net/ontology/ontomedia/misc/locspec#Space>) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>].
trait:not-projected-at a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "This property specifies the Entity or Entities at which the related trait is not projected at";
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (trait:Trait
                                                                             <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:label "Not Projected At";
                       rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Entity>.
trait:order_of_magnitude a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property specifies the order of magnitude of the value. Useful list: http://chemistry.berkeley.edu/links/weights/powers.html";
                         rdfs:domain trait:Value;
                         rdfs:label "Order of Magnitude";
                         rdfs:range rdfs:Literal.
trait:projected-at a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "This property specifies the Entity or Entities at which the related trait is projected at";
                   rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (trait:Trait
                                                                         <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:label "Projected At";
                   rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Entity>.
trait:requires a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property specifies a fetish of the Character";
               rdfs:domain trait:Kink;
               rdfs:label "Requires";
               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Entity>
                                                                    <http://contextus.net/ontology/ontomedia/core/expression#Event>) ; 
                           a <http://www.w3.org/2002/07/owl#Class>].
trait:responsible-for a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property specifies the entities for which the Entity is responsible for";
                      rdfs:domain trait:Employment;
                      rdfs:label "Responsible For";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/ext/common/being#Group>
                                                                           <http://contextus.net/ontology/ontomedia/ext/common/being#Character>
                                                                           <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>
                                                                           trait:Employment) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>].
trait:responsible-for-type a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "This property specifies the types of entities for which the Entity is responsible for";
                           rdfs:domain trait:Employment;
                           rdfs:label "Responsible For Type";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/ext/common/being#Group>
                                                                                <http://contextus.net/ontology/ontomedia/ext/common/being#Character>
                                                                                <http://contextus.net/ontology/ontomedia/ext/common/being#Profession>
                                                                                trait:Employment) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>].
<http://contextus.net/ontology/ontomedia/misc/locspec#Space> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/owl/misc/date#Date-Component> a <http://www.w3.org/2002/07/owl#Class>.
rdfs:Literal a <http://www.w3.org/2002/07/owl#Class>.
