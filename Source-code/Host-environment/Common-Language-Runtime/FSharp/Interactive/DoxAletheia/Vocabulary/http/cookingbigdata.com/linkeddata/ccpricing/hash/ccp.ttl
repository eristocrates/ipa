@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cci: <http://cookingbigdata.com/linkeddata/ccinstances#>.
@prefix ccp: <http://cookingbigdata.com/linkeddata/ccpricing#>.
@prefix ccr: <http://cookingbigdata.com/linkeddata/ccregions#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

ccp: dcterms:created "2018-03-06"^^xsd:date;
     dcterms:creator ccp:manuelparra;
     dcterms:description "Simple and direct pricing ontology for Cloud Computing Services. This ontology allows to define model of prices used in large cloud computing providers such as Amazon, Azure, etc., including options for regions, type of instances, prices specification, etc. "@en;
     dcterms:issued "2018-04-20"^^xsd:date;
     dcterms:modified "2018-04-03"^^xsd:date;
     dcterms:publisher ccp:cookingbigdata;
     dcterms:rights "Copyright © 2018 Manuel Parra-Royón";
     dcterms:title "Vocabulary for prices options in Cloud Computing Services"@en;
     a owl:Ontology;
     rdfs:label "Pricing Plan for Cloud Computing Services"@en;
     owl:versionInfo 1.0.
ccp:PriceCompound dcterms:description "."@en;
                  a owl:Class,
                    rdfs:Class;
                  rdfs:comment "Compound"@en;
                  rdfs:isDefinedBy ccp:;
                  rdfs:label "Compound"@en.
ccp:PricingPlan dcterms:description "."@en;
                a owl:Class,
                  rdfs:Class;
                rdfs:comment "PricingPlan"@en;
                rdfs:isDefinedBy ccp:;
                rdfs:label "Prcing Plan"@en.
ccp:cookingbigdata a foaf:Organization;
                   rdfs:seeAlso <http://cookingbigdata.com/about>;
                   foaf:homepage <http://cookingbigdata.com/>;
                   foaf:name "CookingBigData".
ccp:hasPrice a rdf:Property;
             rdfs:comment ""@en;
             rdfs:domain ccp:PriceCompound;
             rdfs:isDefinedBy ccp:;
             rdfs:label "Component price"@en;
             rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:hasPriceCompound a rdf:Property;
                     rdfs:comment ""@en;
                     rdfs:domain ccp:PricingPlan;
                     rdfs:isDefinedBy ccp:;
                     rdfs:label "has Component price"@en;
                     rdfs:range ccp:PriceCompound.
ccp:hasPricingPlan a rdf:Property;
                   rdfs:comment "Has pricing plans"@en;
                   rdfs:domain ccp:ServicePricing;
                   rdfs:isDefinedBy ccp:;
                   rdfs:label "Has pricing"@en;
                   rdfs:range ccp:PricingPlan.
ccp:instance a rdf:Property;
             rdfs:comment "Instance"@en;
             rdfs:domain ccp:PriceCompound;
             rdfs:isDefinedBy ccp:;
             rdfs:label "Instance"@en;
             rdfs:range cci:instance.
ccp:manuelparra a foaf:Person;
                rdfs:seeAlso <https://twitter.com/manugrapevine>;
                foaf:homepage <https://twitter.com/manugrapevine>;
                foaf:mbox "manuparra@gmail.com";
                foaf:name "Manuel Parra-Royon".
ccp:plan_name a rdf:Property;
              rdfs:comment "Example Free"@en;
              rdfs:domain ccp:PricingPlan;
              rdfs:isDefinedBy ccp:;
              rdfs:label "Plan Name"@en;
              rdfs:range xsd:string.
ccp:region a rdf:Property;
           rdfs:comment "Region"@en;
           rdfs:domain ccp:PriceCompound;
           rdfs:isDefinedBy ccp:;
           rdfs:label "Region"@en;
           rdfs:range ccr:region.
ccp:withMaxCompound a rdf:Property;
                    rdfs:comment ""@en;
                    rdfs:domain ccp:PriceCompound;
                    rdfs:isDefinedBy ccp:;
                    rdfs:label "Max compound"@en;
                    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMaxPrice a rdf:Property;
                 rdfs:comment ""@en;
                 rdfs:domain ccp:PricingPlan;
                 rdfs:isDefinedBy ccp:;
                 rdfs:label "Max price"@en;
                 rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMinCompound a rdf:Property;
                    rdfs:comment ""@en;
                    rdfs:domain ccp:PriceCompound;
                    rdfs:isDefinedBy ccp:;
                    rdfs:label "Min compound"@en;
                    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMinPrice a rdf:Property;
                 rdfs:comment ""@en;
                 rdfs:domain ccp:PricingPlan;
                 rdfs:isDefinedBy ccp:;
                 rdfs:label "Min price"@en;
                 rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
