@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ccp: <http://cookingbigdata.com/linkeddata/ccpricing#>.

ccp: <http://purl.org/dc/terms/created> "2018-03-06"^^xsd:date;
     <http://purl.org/dc/terms/creator> ccp:manuelparra;
     <http://purl.org/dc/terms/description> "Simple and direct pricing ontology for Cloud Computing Services. This ontology allows to define model of prices used in large cloud computing providers such as Amazon, Azure, etc., including options for regions, type of instances, prices specification, etc. "@en;
     <http://purl.org/dc/terms/issued> "2018-04-20"^^xsd:date;
     <http://purl.org/dc/terms/modified> "2018-04-03"^^xsd:date;
     <http://purl.org/dc/terms/publisher> ccp:cookingbigdata;
     <http://purl.org/dc/terms/rights> "Copyright © 2018 Manuel Parra-Royón";
     <http://purl.org/dc/terms/title> "Vocabulary for prices options in Cloud Computing Services"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:label "Pricing Plan for Cloud Computing Services"@en;
     <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
ccp:PriceCompound <http://purl.org/dc/terms/description> "."@en;
                  a <http://www.w3.org/2002/07/owl#Class>,
                    rdfs:Class;
                  rdfs:comment "Compound"@en;
                  rdfs:isDefinedBy ccp:;
                  rdfs:label "Compound"@en.
ccp:PricingPlan <http://purl.org/dc/terms/description> "."@en;
                a <http://www.w3.org/2002/07/owl#Class>,
                  rdfs:Class;
                rdfs:comment "PricingPlan"@en;
                rdfs:isDefinedBy ccp:;
                rdfs:label "Prcing Plan"@en.
ccp:cookingbigdata a <http://xmlns.com/foaf/0.1/Organization>;
                   rdfs:seeAlso <http://cookingbigdata.com/about>;
                   <http://xmlns.com/foaf/0.1/homepage> <http://cookingbigdata.com/>;
                   <http://xmlns.com/foaf/0.1/name> "CookingBigData".
ccp:hasPrice a rdf:Property;
             rdfs:comment ""@en;
             rdfs:domain ccp:PriceCompound;
             rdfs:isDefinedBy ccp:;
             rdfs:label "Component price"@en;
             rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:hasPriceCompound a rdf:Property;
                     rdfs:comment ""@en;
                     rdfs:domain ccp:PricingPlan;
                     rdfs:isDefinedBy ccp:;
                     rdfs:label "has Component price"@en;
                     rdfs:range ccp:PriceCompound.
ccp:hasPricingPlan a rdf:Property;
                   rdfs:comment "Has pricing plans"@en;
                   rdfs:domain ccp:ServicePricing;
                   rdfs:isDefinedBy ccp:;
                   rdfs:label "Has pricing"@en;
                   rdfs:range ccp:PricingPlan.
ccp:instance a rdf:Property;
             rdfs:comment "Instance"@en;
             rdfs:domain ccp:PriceCompound;
             rdfs:isDefinedBy ccp:;
             rdfs:label "Instance"@en;
             rdfs:range <http://cookingbigdata.com/linkeddata/ccinstances#instance>.
ccp:manuelparra a <http://xmlns.com/foaf/0.1/Person>;
                rdfs:seeAlso <https://twitter.com/manugrapevine>;
                <http://xmlns.com/foaf/0.1/homepage> <https://twitter.com/manugrapevine>;
                <http://xmlns.com/foaf/0.1/mbox> "manuparra@gmail.com";
                <http://xmlns.com/foaf/0.1/name> "Manuel Parra-Royon".
ccp:plan_name a rdf:Property;
              rdfs:comment "Example Free"@en;
              rdfs:domain ccp:PricingPlan;
              rdfs:isDefinedBy ccp:;
              rdfs:label "Plan Name"@en;
              rdfs:range xsd:string.
ccp:region a rdf:Property;
           rdfs:comment "Region"@en;
           rdfs:domain ccp:PriceCompound;
           rdfs:isDefinedBy ccp:;
           rdfs:label "Region"@en;
           rdfs:range <http://cookingbigdata.com/linkeddata/ccregions#region>.
ccp:withMaxCompound a rdf:Property;
                    rdfs:comment ""@en;
                    rdfs:domain ccp:PriceCompound;
                    rdfs:isDefinedBy ccp:;
                    rdfs:label "Max compound"@en;
                    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMaxPrice a rdf:Property;
                 rdfs:comment ""@en;
                 rdfs:domain ccp:PricingPlan;
                 rdfs:isDefinedBy ccp:;
                 rdfs:label "Max price"@en;
                 rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMinCompound a rdf:Property;
                    rdfs:comment ""@en;
                    rdfs:domain ccp:PriceCompound;
                    rdfs:isDefinedBy ccp:;
                    rdfs:label "Min compound"@en;
                    rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
ccp:withMinPrice a rdf:Property;
                 rdfs:comment ""@en;
                 rdfs:domain ccp:PricingPlan;
                 rdfs:isDefinedBy ccp:;
                 rdfs:label "Min price"@en;
                 rdfs:range <http://purl.org/goodrelations/v1PriceSpecification>.
