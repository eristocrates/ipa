                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:isSubjectOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:isDefinedBy nlon:;
                 rdfs:label "is subject of"@en;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:issuingBodyNote a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "발행처주기에 관한 사항을 기술한다."@ko;
                     rdfs:domain <http://purl.org/ontology/bibo/Collection>;
                     rdfs:isDefinedBy nlon:;
                     rdfs:label "발행처주기"@ko,
