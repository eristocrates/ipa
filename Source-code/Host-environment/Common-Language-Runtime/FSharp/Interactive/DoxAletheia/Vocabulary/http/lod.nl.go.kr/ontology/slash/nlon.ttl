nlon:University a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy nlon:;
                rdfs:label "대학"@ko,
                           "University"@en;
                rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:abbreviatedTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "색인작성이나 식별을 목적으로 축약된 해당자료의 표제를 기술한다. 등록표제(222 필드)에 기초하여 ISSN 센터가 부여하는 축약표제를 말한다. 기타 축약 표제는 목록작성기관에서 제공한다. 여기에는 초록 및 색인 작성도 포함된다. 약어 표제는 이 필드를 제공하는 기관에 의해 작성될 수 있으며 잡지기사에서 채택될 수도 있다."@ko;
                      rdfs:domain <http://purl.org/ontology/bibo/Collection>;
                      rdfs:isDefinedBy nlon:;
                      rdfs:label "축약표제"@ko,
                                 "abbreviated title"@en;
                      rdfs:range xsd:string;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:antecedentSource a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:isDefinedBy nlon:;
                      rdfs:label "원시자료의 정보원"@ko,
                                 "antecedent source"@en;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:audienceNote a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment """당자료가 특수한 이용자층을 고려하여 간행된 경우, 그 이용대상자를 기술한다.
이용 대상자에 대한 코드정보는 008/22(이용대상자 수준)에 기술하고, 접근제한에 관한 주기는 506(이용제한주기) 필드에 기술한다. 
(주의: 전자자료나 시각 자료 레코드에서 읽기 수준과 흥미 연령 및 흥미 수준 정보가 521 필드에 기술될 경우, 008/22 필드는 관심 연령 수준이나 학년에 기준을 둔 관심 수준 정보를 기초로 부호화한다.) 접근 제한을 포함하는 주기는 506(이용제한주기) 필드에 기술한다."""@ko;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                        <http://purl.org/ontology/bibo/Collection>) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy nlon:;
                  rdfs:label "이용대상자 주기"@ko,
                             "audience note"@en;
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf <http://purl.org/dc/terms/description>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:authenticationCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                              <http://purl.org/ontology/bibo/Collection>) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:isDefinedBy nlon:;
                        rdfs:label "검증부호"@ko,
                                   "authentication code"@en;
                        rdfs:range rdfs:Literal;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:awardedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "학위수여대학과 대학원을 기술한다."@ko;
                 rdfs:domain <http://purl.org/ontology/bibo/Thesis>;
                 rdfs:isDefinedBy nlon:;
                 rdfs:label "awarded from"@en,
                            "학위수여 기관"@ko;
                 rdfs:range <http://xmlns.com/foaf/0.1/Organization>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:awardsNote a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "수상내역을 기술한다."@ko;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                      <http://purl.org/ontology/bibo/Collection>) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy nlon:;
                rdfs:label "수상 주기"@ko,
