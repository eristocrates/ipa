nlon:uci a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "한국형 URN 식별 체계";
         rdfs:isDefinedBy nlon:;
         rdfs:label "Universal Content Identifier"@en,
                    "국가디지털콘텐츠식별체계"@ko;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:uniformTitleOfSeries a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "이 필드는 총서의 부출표목이 서명일 경우를 나타낸다. 830 필드는 보통 총서와 관련된 필드 490 필드의 총서사항이나 500 필드의 일반주기로 판단될 수 있다. 복제물의 경우 533(복제주기) 필드의 ▾f(복제 총서사항)에 기술된 것을 근거로 기술할 수 있다."@ko;
                          rdfs:isDefinedBy nlon:;
                          rdfs:label "통일표제"@ko,
                                     "uniform title of series"@en;
                          rdfs:range xsd:string;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:useAndReproductionNote a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "이용과 복제에 관한 사항을 기술한다. 이 사항은 법적인 효력을 가지고 있거나 공식적인 제한규정을 의미하는 것이다."@ko;
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                                                  <http://purl.org/ontology/bibo/Collection>) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:isDefinedBy nlon:;
                            rdfs:label "이용과 복제 제한에 관한 주기"@ko,
                                       "use and reproduction note"@en;
                            rdfs:range rdfs:Literal;
                            rdfs:subPropertyOf <http://purl.org/dc/terms/description>;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:volumeOfNLK a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "국립중앙도서관 청구기호상의 권·연차기호를 기술한다. 권·연차가 연속된 경우에는 처음 권·연차와 마지막 권·연차를 붙임표( - )로 연결한다. 단, 현재 계속 간행중인 경우에는 처음 권·연차 뒤에 붙임표( - )까지만 입력한다"@ko;
                 rdfs:domain <http://purl.org/ontology/bibo/Document>;
                 rdfs:isDefinedBy nlon:;
                 rdfs:label "volume of NLK"@en,
                            "국립중앙도서관 청구기호 권연차기호"@ko;
                 rdfs:range rdfs:Literal;
                 rdfs:subPropertyOf <http://purl.org/ontology/bibo/volume>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
nlon:volumeOfSeries a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "총서에 주어진 권차 또는 차례를 나타내는 명칭을 기술한다."@ko;
                    rdfs:domain <http://purl.org/ontology/bibo/Collection>;
