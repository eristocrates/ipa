                               rdfs:isDefinedBy nlon:;
                               rdfs:label "국립중앙도서관 청구기호 분류기호"@ko,
                                          "National Library of Korea Call Number - Classification Number"@en;
                               rdfs:range rdfs:Literal;
                               rdfs:subPropertyOf nlon:classificationNumber;
                               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
