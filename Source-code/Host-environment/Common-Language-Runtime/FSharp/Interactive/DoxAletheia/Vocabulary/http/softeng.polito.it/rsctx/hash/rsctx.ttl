           rsctx:Hour.
rsctx:23 a <http://www.w3.org/2002/07/owl#NamedIndividual>,
           rsctx:Hour.
rsctx:AdministrativeRegion a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A  specific type of subnational entity in a number of countries, e.g. Belgium, Italy, France."@en;
                           rdfs:label "Administrative Region"@en;
                           rdfs:subClassOf rsctx:Region.
rsctx:Afternoon a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:PartOfDay;
                rdfs:comment "The time of the day between noon and evening. The mapping with respect the hours is possible but not defined because it may vary with the location and the habits."@en;
                rdfs:label "Afternoon"@en.
rsctx:AnchorPoint a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """It is a key  location,  such  as  our  home  and  work  place,  that  we
consider as \"anchor\" in our understanding of the geographic environment
where we live. In general, an anchor-point is a frequently visited location or a location where one spends a lot of time."""@en;
                  rdfs:label "Anchor Point"@en;
                  rdfs:subClassOf rsctx:SymbolicLocation;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:WorkPlace
                                                                                                          rsctx:Home) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Bike a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:TransportationMean;
           rdfs:label "Bicycle"@en,
                      "Bike"@en.
rsctx:Boss a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "The user is with his boss. This may be a more formal situation that being with just the colleagues."@en;
           rdfs:label "Boss"@en,
                      "Chief"@en,
                      "Manager"@en,
                      "Superior"@en,
                      "Supervisor"@en;
           rdfs:subClassOf rsctx:Companion.
rsctx:BusinessPartner a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The user is with a business partner, e.g. a business partner can be a customer or a member of another organizations with which the user is collaborating or a supplier."@en;
                      rdfs:label "Business Partner"@en;
                      rdfs:subClassOf rsctx:Companion.
rsctx:CalendarSeason a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """Season which is generally recognized in temperate and subpolar regions, include summer, spring, winter and fall (or autumn).

WARNING This class has just the purpose to organize the seasons. It SHOULD NOT have instances."""@en;
                     rdfs:label "Calendar Season"@en;
                     rdfs:subClassOf rsctx:Season;
                     <http://www.w3.org/2002/07/owl#disjointWith> rsctx:TropicalSeason;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:Spring
                                                                                                             rsctx:Fall
                                                                                                             rsctx:Summer
                                                                                                             rsctx:Winter) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Calm a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:TrafficLevel;
           rdfs:label "Calm"@en.
rsctx:Car a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            rsctx:TransportationMean;
          rdfs:label "Car"@en.
rsctx:Chaotic a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:TrafficLevel;
              rdfs:label "Chaotic"@en.
rsctx:Child a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The user is with children, not necessarily his family: for example may be a teacher or a baby sitter."@en;
            rdfs:label "Child"@en,
                       "Kid"@en;
            rdfs:subClassOf rsctx:Companion.
rsctx:Cold a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Temperature;
           rdfs:label "Cold"@en.
rsctx:Colleague a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The user is with one or more colleagues."@en;
                rdfs:label "Colleague"@en;
                rdfs:subClassOf rsctx:Companion.
rsctx:Companion a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """Companion class indicates which kind of company the user as at the moment. For example, it may be with family, friends or colleagues.

WARNING Its subclasses not as individual, because the individual could be a person (e.g. Bob or Alice), and it is an istance also of one of companion sublasses to indicate which in kind of companion the individual is for the user in the current context (e.g. is family or colleagues or friend)."""@en;
                rdfs:label "Companion"@en.
rsctx:CompanionHome a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment """The home of a companion of the user, such as a freind's home or a colleague's home.

WARNING This piece of information can be hard to obtained (unless explicitly asked to the user). It is a class and not an individual because the individual is the specific house (e.g. my friend Bob's house)."""@en;
                    rdfs:label "Comapanion's Home"@en;
                    rdfs:subClassOf rsctx:SymbolicLocation.
rsctx:Cool a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Temperature;
           rdfs:label "Cool"@en.
rsctx:DayOfWeek a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class indicates the day of the week (such as Monday, Tuesday, etc.)."@en;
                rdfs:label "Day Of Week"@en;
                rdfs:subClassOf rsctx:TimeInterval,
                                <http://www.w3.org/2006/time#DayOfWeek>.
rsctx:Dominance a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf <http://ns.inria.fr/emoca#Component>.
rsctx:DrySeason a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:Season;
                rdfs:label "Dry Season"@en.
rsctx:EmotionalState a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """The state of a person's emotions (especially with regard to pleasure or dejection).

WARNING The possible values are represented as individuals while in the GUMO ontology are classes."""@en;
                     rdfs:label "Emotional State"@en;
                     rdfs:subClassOf <http://ns.inria.fr/emoca#Emotion>;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:hope
                                                                                                             rsctx:confusion
                                                                                                             rsctx:satisfaction
                                                                                                             rsctx:pride
                                                                                                             rsctx:anxiety
                                                                                                             rsctx:relief
                                                                                                             rsctx:joy
                                                                                                             rsctx:excitement
                                                                                                             rsctx:dread
                                                                                                             rsctx:sadness
                                                                                                             rsctx:anger
                                                                                                             rsctx:disgust
                                                                                                             rsctx:shame
                                                                                                             rsctx:hate
                                                                                                             rsctx:happiness
                                                                                                             rsctx:fear
                                                                                                             rsctx:boredom
                                                                                                             rsctx:love
                                                                                                             rsctx:worry) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>],
                                                                     <http://gumo.org/2.0/#EmotionalState.700014>.
rsctx:Evening a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:PartOfDay;
              rdfs:comment "The period of time near the end of the day, from the end of afternoon (usually from 6 PM) to nighttime. The mapping with respect the hours is possible but not defined becaus it may vary with the location and the habits."@en;
              rdfs:label "Evening"@en.
rsctx:Fall a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Season;
           rdfs:label "Autumn"@en,
                      "Fall"@en.
rsctx:Family a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The user is with his family, not necessarely with children. For instance, this may includes being just with the sister or brother or the parents."@en;
             rdfs:label "Family"@en;
             rdfs:subClassOf rsctx:Companion.
rsctx:Fitness a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "It is a value partition which represents the health of the body, it can be seen as a summary of physiological state, since it is possible to map fitness values with physiological indicators ranges (e.g. ill if temperature greater than a certain threshold), although this is up to the designer which is using the ontology."@en;
              rdfs:label "Fitness"@en;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:good
                                                                                                      rsctx:great
                                                                                                      rsctx:exahust
                                                                                                      rsctx:ill
                                                                                                      rsctx:sleepy
                                                                                                      rsctx:weak
                                                                                                      rsctx:inFit
                                                                                                      rsctx:tired
                                                                                                      rsctx:injured) ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Freezing a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 rsctx:Temperature;
               rdfs:label "Freezing"@en.
rsctx:Friend a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The user is with one or more friends."@en;
             rdfs:label "Friend"@en;
             rdfs:subClassOf rsctx:Companion.
rsctx:GeographicalRegion a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """A physical or historical region. Such as the Iberian peninsula or the Northwest European Atlantic Protestant Region (i.e. the European \"source regions\" in early American colonization efforts)."""@en;
                         rdfs:label "Geographical Region"@en;
                         rdfs:subClassOf rsctx:Region.
rsctx:Home a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:AnchorPoint;
           rdfs:label "Home"@en.
rsctx:Hot a <http://www.w3.org/2002/07/owl#NamedIndividual>,
            rsctx:Temperature;
          rdfs:label "Hot"@en.
rsctx:Hour a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "The hours of a day."@en;
           rdfs:label "Hour"@en;
           rdfs:subClassOf rsctx:TimeInterval;
           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:18
                                                                                                   rsctx:19
                                                                                                   rsctx:14
                                                                                                   rsctx:15
                                                                                                   rsctx:16
                                                                                                   rsctx:17
                                                                                                   rsctx:10
                                                                                                   rsctx:11
                                                                                                   rsctx:12
                                                                                                   rsctx:13
                                                                                                   rsctx:07
                                                                                                   rsctx:08
                                                                                                   rsctx:09
                                                                                                   rsctx:20
                                                                                                   rsctx:03
                                                                                                   rsctx:04
                                                                                                   rsctx:05
                                                                                                   rsctx:06
                                                                                                   rsctx:21
                                                                                                   rsctx:00
                                                                                                   rsctx:22
                                                                                                   rsctx:01
                                                                                                   rsctx:23
                                                                                                   rsctx:02) ; 
                                                            a <http://www.w3.org/2002/07/owl#Class>].
rsctx:LightLevel a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represent the current level of light. It is intended some symbolic level such as dark, sunlight, etc."@en;
                 rdfs:label "Light Level"@en.
rsctx:MentalState a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """A mental condition in which the qualities of a state are relatively constant even though the state itself may be dynamic, such as depression, cognitive load, nervousness.

WARNING The possible values are represented as individuals while in the GUMO ontology are classes."""@en;
                  rdfs:label "Mental State"@en;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:trauma
                                                                                                          rsctx:timePressure
                                                                                                          rsctx:hypnosis
                                                                                                          rsctx:cognitiveLoad
                                                                                                          rsctx:irritation
                                                                                                          rsctx:nervousness
                                                                                                          rsctx:trance
                                                                                                          rsctx:psychopathy
                                                                                                          rsctx:depression) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>],
                                                                  <http://gumo.org/2.0/#MentalState.700017>.
rsctx:Mild a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Temperature;
           rdfs:label "Mild"@en.
rsctx:MildSeason a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   rsctx:Season;
                 rdfs:label "Cool season"@en,
                            "Mild Season"@en.
rsctx:Moderate a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 rsctx:TrafficLevel;
               rdfs:label "Moderate"@en.
rsctx:Morning a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:PartOfDay;
              rdfs:comment "The period of time between midnight and noon or, more commonly, the interval between sunrise and noon."@en;
              rdfs:label "Morning"@en.
rsctx:Motion a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class indicates if the user is moving and how, e.g. if he is walking or running."@en;
             rdfs:label "Motion";
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://gumo.org/2.0/#Motion.700018>.
rsctx:Night a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              rsctx:PartOfDay;
            rdfs:comment "The period of time between the sunset and the sunrise when the Sun is below the horizon.The mapping with respect the hours is possible but not defined becaus it may vary with the location and the habits."@en;
            rdfs:label "Night"@en.
rsctx:NoTrasportationMean a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                            rsctx:TransportationMean;
                          rdfs:label "No transportation mean"@en.
rsctx:Nobody a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The user is alone."@en;
             rdfs:label "Nobody"@en;
             rdfs:subClassOf rsctx:Companion.
rsctx:NoiseLevel a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents the current level of noise. It is intended a symbolic level such as very noisy, silent, etc."@en;
                 rdfs:label "Noise Level"@en.
rsctx:PartOfDay a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents the time intervals in which a day can be divided in."@en;
                rdfs:label "Part of Day"@en;
                rdfs:subClassOf rsctx:TimeInterval;
                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:Night
                                                                                                        rsctx:Evening
                                                                                                        rsctx:Afternoon
                                                                                                        rsctx:Morning) ; 
                                                                 a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Partner a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The user is with her/his boyfriend/girlfriend or husband/wife."@en;
              rdfs:label "Partner"@en;
              rdfs:subClassOf rsctx:Companion.
rsctx:PhysiologicalState a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """The state of the body or bodily functions.

WARNING The subclasses of PhysiologicalState in GUMO ontology  are represented as datatype properties."""@en;
                         rdfs:label "Physiological State"@en;
                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://gumo.org/2.0/#PhysiologicalState.700016>.
rsctx:Pleasant a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 rsctx:Temperature;
               rdfs:label "Pleasant"@en.
rsctx:Pleasure a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf <http://ns.inria.fr/emoca#Component>.
rsctx:PublicPlace a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """A public place such as a cinema or a theatre.

WARNING It is a class and not an individual because the individual can be a specific cinema or theatre (e.g. La Scala theatre in Milan)."""@en;
                  rdfs:label "Public Place"@en;
                  rdfs:subClassOf rsctx:SymbolicLocation.
rsctx:PublicTransport a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                        rsctx:TransportationMean;
                      rdfs:label "Public Transport"@en.
rsctx:Purpose a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Purpose"@en,
                           "The description of a situation that is desired by an Agent, and usually associated to a plan that describes how to actually achieve it. In the context of this ontology, it indicates the purpose of the item to be recommended. E.g. the user may be interested in receiving recommendation of movies for educating about a specific topic (for instance in the case of a teacher, which wants to show a movie in class) or for having fun (see a movie with some friends in the night)."@en;
              <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Goal>.
rsctx:Region a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """A political or geographical region.

WARNING dbpedia-owl represents regions too but it refer to broader sense of region which include any area which is possible to distinguish in geography. In this sense any other geographical unit defined in this ontology (such as country, province, etc.) is a region, while we intend only to represent geographical regions or specific administrative area named regions in some countries (e.g. Italy, France, Belgium)."""@en;
             rdfs:label "Region"@en.
rsctx:Season a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A season is a division of the year marked by changes in weather."@en;
             rdfs:seeAlso "https://en.wikipedia.org/wiki/Season";
             rdfs:subClassOf rsctx:TimeInterval.
rsctx:Spring a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               rsctx:Season;
             rdfs:label "Spring"@en.
rsctx:Summer a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               rsctx:Season;
             rdfs:label "Summer"@en.
rsctx:SymbolicLocation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment """In general, it represents an abstract ideas of where an object is (e.g. next to a mailbox). In the context of the ontology, it can be an anchor point (i.e. a frequently visited location) or a public place or the anchor point of another user.

WARNING Other kind of symbolic location such as bankomat, mailbox, or a train approaching Dublin are not considered."""@en;
                       rdfs:label "Symbolic Location"@en.
rsctx:Taxi a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:TransportationMean;
           rdfs:label "Taxi"@en.
rsctx:Temperature a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """It represents the exterior temperature by means of a symbolic value, such as warm or cool.

TODO Map the individuals with temperature ranges?"""@en;
                  rdfs:label "Temperature"@en;
                  rdfs:subClassOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherPhenomenon>;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:Hot
                                                                                                          rsctx:Warm
                                                                                                          rsctx:Freezing
                                                                                                          rsctx:VeryCold
                                                                                                          rsctx:Mild
                                                                                                          rsctx:Cool
                                                                                                          rsctx:Cold
                                                                                                          rsctx:Pleasant
                                                                                                          rsctx:VeryWarm) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Time a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Time is an instant, i.e. a timestamp. Then it can be characterized by some TimeIntervals which it belongs to, such as winter, Monday and morning."@en;
           rdfs:label "Time"@en;
           rdfs:subClassOf <http://www.w3.org/2006/time#Instant>.
rsctx:TimeInterval a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A period of time between two instants."@en;
                   rdfs:label "Time Interval"@en;
                   rdfs:subClassOf <http://www.w3.org/2006/time#ProperInterval>.
rsctx:TrafficLevel a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class represents the current traffic situation."@en;
                   rdfs:label "Traffic Level"@en;
                   <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:Moderate
                                                                                                           rsctx:Chaotic
                                                                                                           rsctx:Calm) ; 
                                                                    a <http://www.w3.org/2002/07/owl#Class>].
rsctx:TransportationMean a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "It represents the transportation mean the user is using or is going to use (e.g. to reach a restaurant or to visit a city), such as car, bike, public transport or none (he is going on foot)."@en;
                         rdfs:label "Transportation Mean"@en;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:Car
                                                                                                                 rsctx:Bike
                                                                                                                 rsctx:PublicTransport
                                                                                                                 rsctx:Taxi
                                                                                                                 rsctx:NoTrasportationMean) ; 
                                                                          a <http://www.w3.org/2002/07/owl#Class>].
rsctx:TropicalSeason a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """Season which occur in hot regions. It includes the rainy (or wet, or monsoon) season and the dry season, In some tropical areas, a cool or mild season is also present.

WARNING This class has just the purpose to organize the seasons. It SHOULD NOT have instances."""@en;
                     rdfs:label "Tropical season"@en;
                     rdfs:subClassOf rsctx:Season;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (rsctx:MildSeason
                                                                                                             rsctx:WetSeason
                                                                                                             rsctx:DrySeason) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
rsctx:VeryCold a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 rsctx:Temperature;
               rdfs:label "Very Cold"@en.
rsctx:VeryWarm a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                 rsctx:Temperature;
               rdfs:label "Very Warm"@en.
rsctx:Warm a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Temperature;
           rdfs:label "Warm"@en.
rsctx:WeekEnd a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class indicates the days which made up the weekend (typically not working)."@en;
              rdfs:label "Weekend"@en;
              rdfs:subClassOf rsctx:DayOfWeek;
              <http://www.w3.org/2002/07/owl#disjointWith> rsctx:Weekday;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (<http://www.w3.org/2006/time#Sunday>
                                                                                                      <http://www.w3.org/2006/time#Saturday>) ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>].
rsctx:Weekday a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class includes the day of the week which are typically working (if is not holiday). Days from Monday to Friday are weekdays."@en;
              rdfs:label "Weekday"@en;
              rdfs:subClassOf rsctx:DayOfWeek;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (<http://www.w3.org/2006/time#Monday>
                                                                                                      <http://www.w3.org/2006/time#Wednesday>
                                                                                                      <http://www.w3.org/2006/time#Thursday>
                                                                                                      <http://www.w3.org/2006/time#Friday>
                                                                                                      <http://www.w3.org/2006/time#Tuesday>) ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>].
rsctx:WetSeason a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:Season;
                rdfs:label "Monsoon Season"@en,
                           "Rainy Season"@en,
                           "Wet Season"@en.
rsctx:Winter a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               rsctx:Season;
             rdfs:label "Winter"@en.
rsctx:WorkPlace a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:AnchorPoint;
                rdfs:label "Work Place"@en.
rsctx:ZIPCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "It indicates the ZIP code of a Location."@en;
              rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
              rdfs:label "ZIP code"@en,
                         "postal code"@en;
              rdfs:range xsd:string.
rsctx:activity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment """This property indicates the activity of a user.

WARNING Useful only if need domain and ranges, otherwise it is enough to use ao:activity."""@en;
               rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
               rdfs:label "activity"@en;
               rdfs:range <http://ns.inria.fr/prissma/v2#Activity>;
               rdfs:subPropertyOf <http://purl.org/ontology/ao/core#activity>.
rsctx:address a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "It indicates the address of a location"@en;
              rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
              rdfs:label "address"@en;
              rdfs:range xsd:string.
rsctx:anger a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              rsctx:EmotionalState;
            rdfs:label "anger"@en.
rsctx:anxiety a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:EmotionalState;
              rdfs:label "anxiety"@en.
rsctx:availableTime a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "It indicates how much time the user can spend (e.g. to visit a city or to go for lunch in lunch brek at work)."@en;
                    rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
                    rdfs:label "available time"@en;
                    rdfs:range rsctx:TimeInterval.
rsctx:bloodPressure a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "This property indicates the blood pressure (in mmHg) of a PhysiologicalState"@en;
                    rdfs:domain rsctx:PhysiologicalState;
                    rdfs:label "blood preassure"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minExclusive 0 ]) ; 
                                <http://www.w3.org/2002/07/owl#onDatatype> xsd:int ; 
                                a rdfs:Datatype].
rsctx:bodyTemperature a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "This property indicates the temperature (in degree Celsius) of a PhysiologicalState."@en;
                      rdfs:domain rsctx:PhysiologicalState;
                      rdfs:label "body temperature"@en;
                      rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minExclusive 0 ]) ; 
                                  <http://www.w3.org/2002/07/owl#onDatatype> xsd:decimal ; 
                                  a rdfs:Datatype].
rsctx:boredom a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:EmotionalState;
              rdfs:label "boredom"@en.
rsctx:budget a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "It indicates how much the user want or can spend (for example for a travel or a purchase or to go for a dinner in a restaurant)."@en;
             rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
             rdfs:label "budget"@en;
             rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minExclusive 0 ]) ; 
                         <http://www.w3.org/2002/07/owl#onDatatype> xsd:decimal ; 
                         a rdfs:Datatype].
rsctx:bulding a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "It indicates the building associated to a location."@en;
              rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
              rdfs:label "building"@en;
              rdfs:range <http://vocab.deri.ie/rooms#Building>.
rsctx:city a <http://www.w3.org/2002/07/owl#ObjectProperty>,
             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
           rdfs:comment "It indicates the city of a Location."@en;
           rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
           rdfs:label "city"@en;
           rdfs:range <http://rdfs.co/juso/City>.
rsctx:cognitiveLoad a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                      rsctx:MentalState;
                    rdfs:label "cognitive load"@en.
rsctx:companion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property indicates who is the current companion of the user, e.g. a friend a family member or a colleague."@en;
                rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
                rdfs:label "companion"@en;
                rdfs:range rsctx:Companion.
rsctx:confusion a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:EmotionalState;
                rdfs:label "confusion"@en.
rsctx:country a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "It indicates the country of a Location."@en;
              rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
              rdfs:label "country"@en;
              rdfs:range <http://rdfs.co/juso/Country>.
rsctx:county a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "It indicates the county of a Location."@en;
             rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
             rdfs:label "county"@en;
             rdfs:range <http://rdfs.co/juso/County>.
rsctx:dayOfWeek a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "This property indicates the day of week of a Time."@en;
                rdfs:domain rsctx:Time;
                rdfs:label "day of week"@en;
                rdfs:range rsctx:DayOfWeek.
rsctx:depression a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   rsctx:MentalState;
                 rdfs:label "depression"@en.
rsctx:desk a <http://www.w3.org/2002/07/owl#ObjectProperty>,
             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
           rdfs:comment "It indicates the Desk of a Location."@en;
           rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
           rdfs:label "desk"@en;
           rdfs:range <http://vocab.deri.ie/rooms#Desk>.
rsctx:device a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment """The property associates a Device to a Context.

WARNING It is useful only if we need the property being functional, otherwise prissma:device should be used."""@en;
             rdfs:domain <http://ns.inria.fr/prissma/v2#Context>;
             rdfs:label "device"@en;
             rdfs:range <http://ns.inria.fr/prissma/v2#Device>;
             rdfs:subPropertyOf <http://ns.inria.fr/prissma/v2#device>.
rsctx:disgust a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:EmotionalState;
              rdfs:label "disgust"@en.
rsctx:district a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "It indicates the District of a Location."@en;
               rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
               rdfs:label "district"@en;
               rdfs:range <http://rdfs.co/juso/District>.
rsctx:dread a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              rsctx:EmotionalState;
            rdfs:label "dread"@en.
rsctx:environment a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment """The property associates an Environment to a Context.

WARNING It is useful only if we need the property being functional, otherwise prissma:device should be used."""@en;
                  rdfs:domain <http://ns.inria.fr/prissma/v2#Context>;
                  rdfs:label "environment"@en;
                  rdfs:range <http://ns.inria.fr/prissma/v2#Environment>;
                  rdfs:subPropertyOf <http://ns.inria.fr/prissma/v2#environment>.
rsctx:exahust a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                rsctx:Fitness;
              rdfs:label "exhaust"@en.
rsctx:excitement a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                   rsctx:EmotionalState;
                 rdfs:label "excitement"@en.
rsctx:exteriorTemperature a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                            <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                          rdfs:comment "It indicates the exterior temperature in degree Celsius."@en;
                          rdfs:domain <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherState>;
                          rdfs:label "exterior temperature"@en;
                          rdfs:range xsd:decimal.
rsctx:fatigue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "This property indicates the fatigue of a PhysiologicalState. It is represented as string because there are scales such as Samm-Perelli seven point scale and karolinska sleepiness scale with some numbers associated to a string. "@en;
              rdfs:domain rsctx:PhysiologicalState;
              rdfs:label "fatigue"@en;
              rdfs:range xsd:string.
rsctx:fear a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:EmotionalState;
           rdfs:label "fear"@en.
rsctx:federatedState a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment "It indicates the FederatedState of a Location."@en;
                     rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
                     rdfs:label "federated state"@en;
                     rdfs:range <http://rdfs.co/juso/FederatedState>.
rsctx:fifthLevelAdministrativeDivision a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                       rdfs:comment "It indicates the Fifth Level Administrative DIvision of a Location."@en;
                                       rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
                                       rdfs:label "fifth level administrative division"@en;
                                       rdfs:range <http://rdfs.co/juso/FifthLevelAdministrativeDivision>.
rsctx:firstLevelAdministrativeDivision a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                         <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                       rdfs:comment "It indicates the first level administrative division of a Location."@en;
                                       rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
                                       rdfs:label "first level administrative division"@en;
                                       rdfs:range <http://rdfs.co/juso/FirstLevelAdministrativeDivision>.
rsctx:floor a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "It indicates the Floor of a Location."@en;
            rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
            rdfs:label "floor"@en;
            rdfs:range <http://vocab.deri.ie/rooms#Floor>.
rsctx:floorSection a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "It indicates the FloorSection of a Location."@en;
                   rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
                   rdfs:label "floor section"@en;
                   rdfs:range <http://vocab.deri.ie/rooms#FloorSection>.
rsctx:fourthLevelAdministrativeDivision a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                        rdfs:comment "It indicates the fourth level administrative division of a Location."@en;
                                        rdfs:domain <http://ns.inria.fr/prissma/v2#POI>;
                                        rdfs:label "fourth level administrative division"@en;
                                        rdfs:range <http://rdfs.co/juso/FourthLevelAdministrativeDivision>.
rsctx:good a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:Fitness;
           rdfs:label "good"@en.
rsctx:great a <http://www.w3.org/2002/07/owl#NamedIndividual>,
              rsctx:Fitness;
            rdfs:label "great"@en.
rsctx:happiness a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                  rsctx:EmotionalState;
                rdfs:label "happiness"@en.
rsctx:hasEmotionalState a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property indicates the emotional state of a user."@en;
                        rdfs:domain <http://ns.inria.fr/prissma/v2#User>;
                        rdfs:label "has emotional state"@en;
                        rdfs:range rsctx:EmotionalState.
rsctx:hasFitness a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                   <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                 rdfs:comment "This property indicates the fitness of a user."@en;
                 rdfs:domain <http://ns.inria.fr/prissma/v2#User>;
                 rdfs:label "has fitness"@en;
                 rdfs:range rsctx:Fitness.
rsctx:hasMentalState a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "This property indicates the mental state of a user."@en;
                     rdfs:domain <http://ns.inria.fr/prissma/v2#User>;
                     rdfs:label "has mental state"@en;
                     rdfs:range rsctx:MentalState.
rsctx:hasMotion a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment """This property indicates the motion of a user.

WARNING Useful only if need domain and ranges, otherwise it is enough to use ao:activity."""@en;
                rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
                rdfs:label "has motion"@en;
                rdfs:range rsctx:Motion;
                rdfs:subPropertyOf <http://ns.inria.fr/prissma/v2#string>.
rsctx:hasPhysiologicalState a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                            rdfs:comment "This property indicates the phsysiological state of a user."@en;
                            rdfs:domain <http://ns.inria.fr/prissma/v2#User>;
                            rdfs:label "has physiological state"@en;
                            rdfs:range rsctx:PhysiologicalState.
rsctx:hasPurpose a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment """This property indicates the purpose of a user.

WARNING schema:purpose has different domain (three possible classes) and different ranges (2 possible classes). Although one range is Thing, which would enable to consider this porperty as subproperty of schema.org we should add a class in domain, while for the scopes of this ontology only Environment as domain is proper. """@en;
                 rdfs:domain <http://ns.inria.fr/prissma/v2#Environment>;
                 rdfs:label "has purpose"@en;
                 rdfs:range rsctx:Purpose;
                 rdfs:seeAlso "http://dbpedia.org/ontology/purpose",
                              "https://schema.org/purpose";
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
rsctx:hasTemperature a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:comment """This property indicates a symbolic value for the temperature (such as warm, cold, etc.).

WARNING Although there was already a temperature class and a temperature property (hw:hasExteriorTemperature) in the WeatherOntology, temperature class has been redefined with values more general and not referred to the house (such as below room temperature). Thus this property has the redefined temperature class as a range."""@en;
                     rdfs:domain <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#WeatherState>;
                     rdfs:label "has temperature"@en;
                     rdfs:range rsctx:Temperature;
                     rdfs:subPropertyOf <https://www.auto.tuwien.ac.at/downloads/thinkhome/ontology/WeatherOntology.owl#hasWeatherPhenomenon>.
rsctx:hate a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:EmotionalState;
           rdfs:label "hate"@en.
rsctx:heartbeat a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                rdfs:comment "This property indicates the heartbeat of a PhysiologicalState"@en;
                rdfs:domain rsctx:PhysiologicalState;
                rdfs:label "heartbeat"@en;
                rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:minExclusive 0 ]) ; 
                            <http://www.w3.org/2002/07/owl#onDatatype> xsd:int ; 
                            a rdfs:Datatype];
                rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
rsctx:holiday a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "This property indicates if a Time is holiday or a working day."@en;
              rdfs:domain rsctx:Time;
              rdfs:label "is holiday"@en;
              rdfs:range xsd:boolean.
rsctx:hope a <http://www.w3.org/2002/07/owl#NamedIndividual>,
             rsctx:EmotionalState;
           rdfs:label "hope"@en.
rsctx:hour a <http://www.w3.org/2002/07/owl#ObjectProperty>,
             <http://www.w3.org/2002/07/owl#FunctionalProperty>;
           rdfs:comment "This property indicates the hour which a Time is included."@en;
           rdfs:domain rsctx:Time;
           rdfs:label "hour"@en;
