@base <http://www.w3.org/2000/10/swap/pim/travelFig>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix r: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dia: <http://www.lysator.liu.se/~alla/dia/>.
@prefix owl: <http://www.w3.org/2002/07/owl@@#>.
@prefix swaptravelFig: <http://www.w3.org/2000/10/swap/pim/travelFig#>.

swaptravelFig:O0 a rdfs:Class;
                 rdfs:label "Flight";
                 rdfs:subClassOf swaptravelFig:O3.
swaptravelFig:O1 a rdfs:Class;
                 rdfs:label "Economy";
                 rdfs:subClassOf swaptravelFig:O0.
swaptravelFig:O10 a rdf:Property;
                  rdfs:domain swaptravelFig:O3;
                  rdfs:label "toLocation";
                  rdfs:range swaptravelFig:O5.
swaptravelFig:O11 a rdfs:Class;
                  rdfs:label "TemporalThing".
swaptravelFig:O13 a rdf:Property;
                  rdfs:domain swaptravelFig:O0;
                  rdfs:label "arrivalTime";
                  rdfs:range swaptravelFig:O14.
swaptravelFig:O14 a rdfs:Class;
                  rdfs:label "TimeString";
                  rdfs:subClassOf swaptravelFig:O18.
swaptravelFig:O15 a rdfs:Class;
                  rdfs:label "AirlineCompany";
                  rdfs:subClassOf swaptravelFig:O21.
swaptravelFig:O16 a rdf:Property;
                  rdfs:domain swaptravelFig:O0;
                  rdfs:label "carrier";
                  rdfs:range swaptravelFig:O15.
swaptravelFig:O17 a rdf:Property;
                  rdfs:domain swaptravelFig:O0;
                  rdfs:label "departureTime";
                  rdfs:range swaptravelFig:O14.
swaptravelFig:O18 a rdfs:Class;
                  rdfs:label "Literal".
swaptravelFig:O20 a rdf:Property;
                  rdfs:domain swaptravelFig:O21;
                  rdfs:label "nameOfAgent";
                  rdfs:range swaptravelFig:O18.
swaptravelFig:O21 a rdfs:Class;
                  rdfs:label "Agent".
swaptravelFig:O23 a rdfs:Class;
                  rdfs:label "Airport-Physical";
                  rdfs:subClassOf swaptravelFig:O5.
swaptravelFig:O25 a rdfs:Class;
                  rdfs:label "Event".
swaptravelFig:O26 a rdf:Property;
                  rdfs:domain swaptravelFig:O25;
                  rdfs:label "subEvents";
                  rdfs:range swaptravelFig:O25.
swaptravelFig:O28 a rdf:Property;
                  rdfs:domain swaptravelFig:O7;
                  rdfs:label "dt:date";
                  rdfs:range swaptravelFig:O18.
swaptravelFig:O29 a rdf:Property;
                  rdfs:domain swaptravelFig:O0;
                  rdfs:label "flightNumber";
                  rdfs:range swaptravelFig:O18.
swaptravelFig:O3 a rdfs:Class;
                 rdfs:label "Translocation";
                 rdfs:subClassOf swaptravelFig:O11,
                                 swaptravelFig:O25.
swaptravelFig:O5 a rdfs:Class;
                 rdfs:label "PartiallyTangible".
swaptravelFig:O6 a rdf:Property;
                 rdfs:domain swaptravelFig:O3;
                 rdfs:label "fromLocation";
                 rdfs:range swaptravelFig:O5.
swaptravelFig:O7 a rdfs:Class;
                 rdfs:label "Date";
                 owl:hasAtLeastOne swaptravelFig:O28.
swaptravelFig:O8 a rdf:Property;
                 rdfs:domain swaptravelFig:O11;
                 rdfs:label "startingDate";
                 rdfs:range swaptravelFig:O7.
swaptravelFig:O9 a rdf:Property;
                 rdfs:domain swaptravelFig:O11;
                 rdfs:label "endingDate";
                 rdfs:range swaptravelFig:O7.
