                    rdfs:domain arp:ImagePoint;
                    rdfs:label "is observation of"@en;
                    rdfs:range arp:Photograph.
arp:isPhotographOf a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:domain arp:Photograph;
                   rdfs:label "is photograph of"@en;
                   rdfs:range arp:PhotoManager.
arp:isValid a owl:DatatypeProperty;
            rdfs:domain arp:IIdentifiedObject;
            rdfs:label "is valide"@en;
            rdfs:range xsd:boolean.
arp:percentOfMeasured a owl:DatatypeProperty;
                      rdfs:domain arp:Amphorae;
                      rdfs:label "percent of measured"@en;
                      rdfs:range xsd:double.
owl:Thing rdfs:comment "";
          rdfs:label "thing"@en.
