@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix arp: <http://www.arpenteur.org/ontology/Arpenteur.owl#>.

<http://www.arpenteur.org/ontology/Arpenteur.owl> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                                  <http://purl.org/dc/elements/1.1/#contributor> [<http://xmlns.com/foaf/0.1/#name> "Mauro SACCONE" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/mauro.saccone@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>],
                                                                                                 [<http://xmlns.com/foaf/0.1/#name> "Mohamed BEN ELLEFI" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/benellefi@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>],
                                                                                                 [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#creator> [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                              <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                              a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#description> """
	 Arpenteur ontology is dedicated to photogrammetry, archeology and oceanology communities 
	 in order to perform tasks such as image processing, photogrammetry and modelling.
    """;
                                                  <http://purl.org/dc/elements/1.1/#publisher> [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                                <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                                a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#rights> "Copyright © 2015 Pierre DRAP";
                                                  <http://purl.org/dc/elements/1.1/#title> "Arpenteur Ontology";
                                                  a <http://purl.org/vocommons/voaf#Vocabulary>,
                                                    <http://www.w3.org/2002/07/owl#Ontology>;
                                                  rdfs:comment "v. 0.0.5: Cancelling all FunctionalProperties ",
                                                               "v. 0.0.9: Introduction to redCoral ",
                                                               "v. 0.0.1: general ontology dedicated to photogrammetric survey and measured object",
                                                               "v. 0.0.4: Starting using time from CRM for stratigraphy ",
                                                               "v. 0.0.6: Now Element coming from Architecture have a link toward a stratigraphic Unit ",
                                                               "v. 0.0.3: Adding PetraData Class to manage several Siti ",
                                                               "v. 0.0.2: Now unified ontology for photogrammetry and measured items ",
                                                               "v. 0.0.8: All link with E54 relation from CRM CIDOC are commented ",
                                                               "v. 0.0.7: Adding Stratigraphic relation between two ElementoStratigrafico. Before this version these relation was done with ID ",
                                                               "v. 0.0.10: Changing BoundingBoxParallel to BoundingBox ",
                                                               "v. 0.0.5: Adding ashlar Bloc to stratigraphy ",
                                                               """v. 0.0.13: Adding \"rdfs:label\" to all the resources in the ontology""";
                                                  <http://www.w3.org/2002/07/owl#imports> <http://www.arpenteur.org/ontology/nadlShip-1.6.owl>,
                                                                                          <http://erlangen-crm.org/current/>,
                                                                                          <http://www.arpenteur.org/ontology/ArpenteurBuiltInLibrary.owl>;
                                                  <http://www.w3.org/2002/07/owl#versionInfo> "v. 0.0.3    2016/03/21",
                                                                                              "v. 0.0.5    2016/07/12",
                                                                                              "v. 0.0.4    2016/07/08",
                                                                                              "v. 0.0.2    2016/03/14",
                                                                                              "v. 0.0.13    2018/01/15",
                                                                                              "v. 0.0.6    2017/03/19",
                                                                                              "v. 0.0.11   2017/07/19",
                                                                                              "v. 0.0.9    2017/04/22",
                                                                                              "v. 0.0.12   2017/08/02",
                                                                                              "v. 0.0.10   2017/04/23",
                                                                                              "v. 0.0.1    2015/05/12",
                                                                                              "v. 0.0.8    2017/04/04",
                                                                                              "v. 0.0.7    2017/04/03".
arp:Alcyonacea a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "alcyonacea"@en;
               rdfs:subClassOf arp:Zoology.
arp:Amphorae a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "amphorae"@en;
             rdfs:subClassOf arp:RecipientTransport.
arp:Archaeology a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "archaeology"@en;
                rdfs:subClassOf arp:Measurable.
arp:Architecture a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Architecture"@en;
                 rdfs:subClassOf arp:Archaeology.
arp:AreaFunzionale a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Functional Area"@en,
                              "Area Funzionale"@it;
                   rdfs:subClassOf arp:UnitaArcheologica.
arp:Artifact a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "artifact"@en;
             rdfs:subClassOf <http://erlangen-crm.org/current/E24_Physical_Man-Made_Thing>,
                             arp:Archaeology.
arp:Attivita a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Attivita"@it,
                        "Activities"@it;
             rdfs:subClassOf arp:ElementoStratigrafico.
arp:Bloc a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "block"@en;
         rdfs:subClassOf arp:ElementDeParement.
arp:BoundingBox a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "bounding box"@en;
                rdfs:subClassOf arp:MathematicalObject.
arp:Brique a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "brick"@en;
           rdfs:subClassOf arp:ElementDeParement.
arp:BundleModel a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "bundle model"@en;
                rdfs:subClassOf arp:Model.
arp:Camera a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "camera"@en;
           rdfs:subClassOf arp:Photogrammetry.
arp:CameraManager a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "camera manager"@en;
                  rdfs:subClassOf arp:GenericManager.
arp:Cassettone a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "cassettone"@it,
                          "ceiling box"@en,
                          "caisson du plafond"@fr;
               rdfs:subClassOf arp:ElementDeCouverture.
arp:ComplessoArchitettonico a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:label "Architectural Complex"@en,
                                       "complesso architettonico"@it;
                            rdfs:subClassOf arp:ElementoStratigrafico.
arp:ConstraintManager a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "constraint manager"@en;
                      rdfs:subClassOf arp:GenericManager.
arp:ControlPoint a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "control point"@en;
                 rdfs:subClassOf arp:IPoint3D.
arp:Coralliidae a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "coralliidae"@en;
                rdfs:subClassOf arp:Alcyonacea.
arp:CoralliumRubrum a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "corallium rubrum"@en;
                    rdfs:subClassOf arp:Coralliidae.
arp:CorpoDiFabbrica a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "corpo di fabbrica"@it,
                               "factory body"@en;
                    rdfs:subClassOf arp:ElementoStratigrafico.
arp:DigitalCamera a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "digital camera"@en;
                  rdfs:subClassOf arp:Camera;
                  <http://www.w3.org/2002/07/owl#disjointWith> arp:FilmBasedCamera.
arp:Dolia a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "dolia (dolium)"@en;
          rdfs:subClassOf arp:RecipientTransport.
arp:ElementDeCouverture a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "cover element"@en;
                        rdfs:subClassOf arp:Architecture.
arp:ElementDeParement a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "element of parement"@en;
                      rdfs:subClassOf arp:Architecture.
arp:ElementoStratigrafico a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:label "elemento stratigrafico"@it,
                                     "stratigraphic element"@en;
                          rdfs:subClassOf arp:UnitaArcheologica.
arp:FilmBasedCamera a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "film based camera"@en;
                    rdfs:subClassOf arp:Camera.
arp:GenericManager a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "generic manager"@en;
                   rdfs:subClassOf arp:IIdentifiedObject.
arp:Geometry a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "geometry"@en;
             rdfs:subClassOf arp:IIdentifiedObject.
arp:GrindingStone a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "grinding stone"@en;
                  rdfs:subClassOf arp:StoneTool.
arp:IColoredPoint a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "interface colored point"@en;
                  rdfs:subClassOf arp:Photogrammetry.
arp:IFixedPoint a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "interface fixed point"@en;
                rdfs:subClassOf arp:IPoint3D.
arp:IIdentifiedObject a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "interface identified object"@en;
                      rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
arp:IPoint a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "interface point"@en;
           rdfs:subClassOf arp:IColoredPoint.
arp:IPoint2D a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "interface point 2D"@en;
             rdfs:subClassOf arp:IPoint.
arp:IPoint3D a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "interface point 3D"@en;
             rdfs:subClassOf arp:IPoint2D.
arp:ImagePoint a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "image point"@en;
               rdfs:subClassOf arp:IPoint2D.
arp:ImagePointManager a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "image point manager"@en;
                      rdfs:subClassOf arp:Point2DManager.
arp:MathematicalObject a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "mathematica object"@en;
                       rdfs:subClassOf arp:IIdentifiedObject.
arp:Matrix a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "matrix"@en;
           rdfs:subClassOf arp:MathematicalObject.
arp:Measurable a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "measurable"@en;
               rdfs:subClassOf arp:SpatialObject.
arp:MeasuredPointManager a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "measured point manager"@en;
                         rdfs:subClassOf arp:Point3DManager.
arp:Model a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This is a photogrammetric model. It contains a set of oriented photograph and a set of 3D points which are at least visible on two oriented photographs.";
          rdfs:label "photogrammetric model"@en;
          rdfs:subClassOf arp:Photogrammetry.
arp:NauticalArchaeology a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "nautical archaeology"@en;
                        rdfs:subClassOf arp:Archaeology.
arp:Ollae a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Olla (e)"@en;
          rdfs:subClassOf arp:RecipientTransport.
arp:PetraData a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "petra data"@en;
              rdfs:subClassOf arp:UnitaArcheologica.
arp:PhotoManager a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "photo manager"@en;
                 rdfs:subClassOf arp:GenericManager.
arp:Photogrammetry a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "photogrammetry"@en;
                   rdfs:subClassOf arp:IIdentifiedObject.
arp:Photograph a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "photograph"@en;
               rdfs:subClassOf arp:Photogrammetry.
arp:Point2DManager a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "point 2D manager"@en;
                   rdfs:subClassOf arp:PointManager.
arp:Point3DManager a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "point 3D manager"@en;
                   rdfs:subClassOf arp:PointManager.
arp:PointManager a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "point manager"@en;
                 rdfs:subClassOf arp:GenericManager.
arp:Point_3D a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "point 3D"@en;
             rdfs:subClassOf arp:IPoint3D,
                             arp:IColoredPoint.
arp:Prospetto a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "prospetto"@it,
                         "prospectus"@en;
              rdfs:subClassOf arp:ElementoStratigrafico.
arp:ProspettoGenerale a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "prospetto generale"@it,
                                 "general prospectus"@en;
                      rdfs:subClassOf arp:Prospetto;
                      <http://www.w3.org/2002/07/owl#disjointWith> arp:ProspettoParticolare.
arp:ProspettoParticolare a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "prospetto particolare"@it,
                                    "particular prospectus"@en;
                         rdfs:subClassOf arp:Prospetto.
arp:RadialDecenteringDistortion a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:label "radial decentring distortion"@en;
                                rdfs:subClassOf arp:MathematicalObject.
arp:RecipientTransport a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "transport recipient"@en;
                       rdfs:subClassOf arp:Artifact.
arp:RotationMatrix a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "rotation matrix"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> arp:hasRotationMatrix ; 
                                    <http://www.w3.org/2002/07/owl#onClass> arp:Transformation3D ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   arp:Matrix.
arp:SitiList a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "siti list"@it,
                        "city list"@en;
             rdfs:subClassOf arp:UnitaArcheologica.
arp:Sito a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:label "sito"@it,
                    "city"@en;
         rdfs:subClassOf arp:UnitaArcheologica.
arp:SpatialLocalization a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "spatial localization"@en;
                        rdfs:subClassOf arp:IIdentifiedObject.
arp:SpatialObject a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "spatial object"@en;
                  rdfs:subClassOf arp:SpatialLocalization,
                                  <http://erlangen-crm.org/current/E18_Physical_Thing>.
arp:StoneTool a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "stone tool"@en;
              rdfs:subClassOf arp:Artifact.
arp:Subergorgia a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:label "Subergorgia"@en;
                rdfs:subClassOf arp:Alcyonacea.
arp:Transformation3D a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "transformation 3D"@en;
                     rdfs:subClassOf arp:Geometry.
arp:TriangleManager a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "triangle manager"@en;
                    rdfs:subClassOf arp:GenericManager.
arp:Tuile a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "tuile"@fr,
                     "tile"@en;
          rdfs:subClassOf arp:ElementDeCouverture.
arp:TuileRonde a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "tuile ronde"@fr,
                          "round tile"@en;
               rdfs:subClassOf arp:Tuile.
arp:UnitaArcheologica a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "unita archeologica"@it,
                                 "archaeological unit"@en;
                      rdfs:subClassOf arp:Archaeology.
arp:UnitaFunzionale a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "unita funzionale"@it,
                               "functional unit"@en;
                    rdfs:subClassOf arp:CorpoDiFabbrica.
arp:UnitaStratigrafica a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "unita stratigrafica"@it,
                                  "stratigrafical unit"@en;
                       rdfs:subClassOf arp:ElementoStratigrafico.
arp:UnitaStratigraficaMurale a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "unita stratigrafica murale"@it,
                                        "mural stratigrafical unit"@en;
                             rdfs:subClassOf arp:UnitaStratigrafica.
arp:UnitaTopografica a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "unita topografica"@it,
                                "mural stratigrafical unit"@en;
                     rdfs:subClassOf arp:UnitaArcheologica.
arp:Zoology a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "zoology"@en;
            rdfs:subClassOf arp:Measurable.
arp:belongToUSM a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain arp:Bloc;
                rdfs:label "belong to a mural stratigraphic unit"@en;
                rdfs:range xsd:integer.
arp:hasASetOf3DPoint a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                       <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                     rdfs:domain arp:Point3DManager;
                     rdfs:label "has a set of 3D points"@en;
                     rdfs:range arp:IPoint3D.
arp:hasASetOf3DPointWithObs a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                              <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                            rdfs:domain arp:MeasuredPointManager;
                            rdfs:label "has a set of 3D point with observations"@en;
                            rdfs:range arp:Point_3D.
arp:hasASetOfCA a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                rdfs:domain arp:Sito;
                rdfs:label "has a set of architectural complexes"@en;
                rdfs:range arp:ComplessoArchitettonico.
arp:hasASetOfCF a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                rdfs:domain arp:ComplessoArchitettonico;
                rdfs:label "has a set of factory bodies"@en;
                rdfs:range arp:CorpoDiFabbrica.
arp:hasASetOfCamera a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#AsymmetricProperty>;
                    rdfs:domain arp:CameraManager;
                    rdfs:label "has a set of camera"@en;
                    rdfs:range arp:Camera.
arp:hasASetOfObservation a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                           <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                           <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                         rdfs:domain arp:ImagePointManager;
                         rdfs:label "has a set of observations"@en;
                         rdfs:range arp:ImagePoint;
                         rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
arp:hasASetOfPP a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                rdfs:domain arp:CorpoDiFabbrica;
                rdfs:label "has a set of particular prospectuses"@en;
                rdfs:range arp:ProspettoParticolare.
arp:hasASetOfSiti a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                    <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                  rdfs:domain arp:PetraData;
                  rdfs:label "has a set of city"@en;
                  rdfs:range arp:ManagerCA.
arp:hasASetOfSito a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                    <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                  rdfs:domain arp:SitiList;
                  rdfs:label "has a set of cities"@en;
                  rdfs:range arp:Sito.
arp:hasASetOfUS a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                rdfs:domain arp:CorpoDiFabbrica,
                            arp:Prospetto,
                            arp:UnitaTopografica;
                rdfs:label "has a set of stratigrafic units"@en;
                rdfs:range arp:UnitaStratigrafica.
arp:hasASetOfUT a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                rdfs:domain arp:Sito;
                rdfs:label "has a set of topographic units"@en;
                rdfs:range arp:UnitaTopografica.
arp:hasBellyDiameter a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain arp:Amphorae;
                     rdfs:label "has belly diameter"@en;
                     rdfs:range xsd:double.
arp:hasBoundingBox a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                     <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
