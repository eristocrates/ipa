@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ecrm: <http://erlangen-crm.org/current/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix arp: <http://www.arpenteur.org/ontology/Arpenteur.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://www.arpenteur.org/ontology/Arpenteur.owl> ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
                                                  <http://purl.org/dc/elements/1.1/#contributor> [<http://xmlns.com/foaf/0.1/#name> "Mauro SACCONE" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/mauro.saccone@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>],
                                                                                                 [<http://xmlns.com/foaf/0.1/#name> "Mohamed BEN ELLEFI" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/benellefi@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>],
                                                                                                 [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                                  <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                                  a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#creator> [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                              <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                              a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#description> """
	 Arpenteur ontology is dedicated to photogrammetry, archeology and oceanology communities 
	 in order to perform tasks such as image processing, photogrammetry and modelling.
    """;
                                                  <http://purl.org/dc/elements/1.1/#publisher> [<http://xmlns.com/foaf/0.1/#name> "Pierre DRAP" ; 
                                                                                                <http://xmlns.com/foaf/0.1/#mbox> <http://www.arpenteur.org/ontology/Pierre.Drap@gmail.com> ; 
                                                                                                a <http://xmlns.com/foaf/0.1/#Person>];
                                                  <http://purl.org/dc/elements/1.1/#rights> "Copyright © 2015 Pierre DRAP";
                                                  <http://purl.org/dc/elements/1.1/#title> "Arpenteur Ontology";
                                                  a voaf:Vocabulary,
                                                    owl:Ontology;
                                                  rdfs:comment "v. 0.0.5: Cancelling all FunctionalProperties ",
                                                               "v. 0.0.9: Introduction to redCoral ",
                                                               "v. 0.0.1: general ontology dedicated to photogrammetric survey and measured object",
                                                               "v. 0.0.4: Starting using time from CRM for stratigraphy ",
                                                               "v. 0.0.6: Now Element coming from Architecture have a link toward a stratigraphic Unit ",
                                                               "v. 0.0.3: Adding PetraData Class to manage several Siti ",
                                                               "v. 0.0.2: Now unified ontology for photogrammetry and measured items ",
                                                               "v. 0.0.8: All link with E54 relation from CRM CIDOC are commented ",
                                                               "v. 0.0.7: Adding Stratigraphic relation between two ElementoStratigrafico. Before this version these relation was done with ID ",
                                                               "v. 0.0.10: Changing BoundingBoxParallel to BoundingBox ",
                                                               "v. 0.0.5: Adding ashlar Bloc to stratigraphy ",
                                                               """v. 0.0.13: Adding \"rdfs:label\" to all the resources in the ontology""";
                                                  owl:imports <http://www.arpenteur.org/ontology/nadlShip-1.6.owl>,
                                                              ecrm:,
                                                              <http://www.arpenteur.org/ontology/ArpenteurBuiltInLibrary.owl>;
                                                  owl:versionInfo "v. 0.0.3    2016/03/21",
                                                                  "v. 0.0.5    2016/07/12",
                                                                  "v. 0.0.4    2016/07/08",
                                                                  "v. 0.0.2    2016/03/14",
                                                                  "v. 0.0.13    2018/01/15",
                                                                  "v. 0.0.6    2017/03/19",
                                                                  "v. 0.0.11   2017/07/19",
                                                                  "v. 0.0.9    2017/04/22",
                                                                  "v. 0.0.12   2017/08/02",
                                                                  "v. 0.0.10   2017/04/23",
                                                                  "v. 0.0.1    2015/05/12",
                                                                  "v. 0.0.8    2017/04/04",
                                                                  "v. 0.0.7    2017/04/03".
arp:Alcyonacea a owl:Class;
               rdfs:label "alcyonacea"@en;
               rdfs:subClassOf arp:Zoology.
arp:Amphorae a owl:Class;
             rdfs:label "amphorae"@en;
             rdfs:subClassOf arp:RecipientTransport.
arp:Archaeology a owl:Class;
                rdfs:label "archaeology"@en;
                rdfs:subClassOf arp:Measurable.
arp:Architecture a owl:Class;
                 rdfs:label "Architecture"@en;
                 rdfs:subClassOf arp:Archaeology.
arp:AreaFunzionale a owl:Class;
                   rdfs:label "Functional Area"@en,
                              "Area Funzionale"@it;
                   rdfs:subClassOf arp:UnitaArcheologica.
arp:Artifact a owl:Class;
             rdfs:label "artifact"@en;
             rdfs:subClassOf ecrm:E24_Physical_Man-Made_Thing,
                             arp:Archaeology.
arp:Attivita a owl:Class;
             rdfs:label "Attivita"@it,
                        "Activities"@it;
             rdfs:subClassOf arp:ElementoStratigrafico.
arp:Bloc a owl:Class;
         rdfs:label "block"@en;
         rdfs:subClassOf arp:ElementDeParement.
arp:BoundingBox a owl:Class;
                rdfs:label "bounding box"@en;
                rdfs:subClassOf arp:MathematicalObject.
arp:Brique a owl:Class;
           rdfs:label "brick"@en;
           rdfs:subClassOf arp:ElementDeParement.
arp:BundleModel a owl:Class;
                rdfs:label "bundle model"@en;
                rdfs:subClassOf arp:Model.
arp:Camera a owl:Class;
           rdfs:label "camera"@en;
           rdfs:subClassOf arp:Photogrammetry.
arp:CameraManager a owl:Class;
                  rdfs:label "camera manager"@en;
                  rdfs:subClassOf arp:GenericManager.
arp:Cassettone a owl:Class;
               rdfs:label "cassettone"@it,
                          "ceiling box"@en,
                          "caisson du plafond"@fr;
               rdfs:subClassOf arp:ElementDeCouverture.
arp:ComplessoArchitettonico a owl:Class;
                            rdfs:label "Architectural Complex"@en,
                                       "complesso architettonico"@it;
                            rdfs:subClassOf arp:ElementoStratigrafico.
arp:ConstraintManager a owl:Class;
                      rdfs:label "constraint manager"@en;
                      rdfs:subClassOf arp:GenericManager.
arp:ControlPoint a owl:Class;
                 rdfs:label "control point"@en;
                 rdfs:subClassOf arp:IPoint3D.
arp:Coralliidae a owl:Class;
                rdfs:label "coralliidae"@en;
                rdfs:subClassOf arp:Alcyonacea.
arp:CoralliumRubrum a owl:Class;
                    rdfs:label "corallium rubrum"@en;
                    rdfs:subClassOf arp:Coralliidae.
arp:CorpoDiFabbrica a owl:Class;
                    rdfs:label "corpo di fabbrica"@it,
                               "factory body"@en;
                    rdfs:subClassOf arp:ElementoStratigrafico.
arp:DigitalCamera a owl:Class;
                  rdfs:label "digital camera"@en;
                  rdfs:subClassOf arp:Camera;
                  owl:disjointWith arp:FilmBasedCamera.
arp:Dolia a owl:Class;
          rdfs:label "dolia (dolium)"@en;
          rdfs:subClassOf arp:RecipientTransport.
arp:ElementDeCouverture a owl:Class;
                        rdfs:label "cover element"@en;
                        rdfs:subClassOf arp:Architecture.
arp:ElementDeParement a owl:Class;
                      rdfs:label "element of parement"@en;
                      rdfs:subClassOf arp:Architecture.
arp:ElementoStratigrafico a owl:Class;
                          rdfs:label "elemento stratigrafico"@it,
                                     "stratigraphic element"@en;
                          rdfs:subClassOf arp:UnitaArcheologica.
arp:FilmBasedCamera a owl:Class;
                    rdfs:label "film based camera"@en;
                    rdfs:subClassOf arp:Camera.
arp:GenericManager a owl:Class;
                   rdfs:label "generic manager"@en;
                   rdfs:subClassOf arp:IIdentifiedObject.
arp:Geometry a owl:Class;
             rdfs:label "geometry"@en;
             rdfs:subClassOf arp:IIdentifiedObject.
arp:GrindingStone a owl:Class;
                  rdfs:label "grinding stone"@en;
                  rdfs:subClassOf arp:StoneTool.
arp:IColoredPoint a owl:Class;
                  rdfs:label "interface colored point"@en;
                  rdfs:subClassOf arp:Photogrammetry.
arp:IFixedPoint a owl:Class;
                rdfs:label "interface fixed point"@en;
                rdfs:subClassOf arp:IPoint3D.
arp:IIdentifiedObject a owl:Class;
                      rdfs:label "interface identified object"@en;
                      rdfs:subClassOf owl:Thing.
arp:IPoint a owl:Class;
           rdfs:label "interface point"@en;
           rdfs:subClassOf arp:IColoredPoint.
arp:IPoint2D a owl:Class;
             rdfs:label "interface point 2D"@en;
             rdfs:subClassOf arp:IPoint.
arp:IPoint3D a owl:Class;
             rdfs:label "interface point 3D"@en;
             rdfs:subClassOf arp:IPoint2D.
arp:ImagePoint a owl:Class;
               rdfs:label "image point"@en;
               rdfs:subClassOf arp:IPoint2D.
arp:ImagePointManager a owl:Class;
                      rdfs:label "image point manager"@en;
                      rdfs:subClassOf arp:Point2DManager.
arp:MathematicalObject a owl:Class;
                       rdfs:label "mathematica object"@en;
                       rdfs:subClassOf arp:IIdentifiedObject.
arp:Matrix a owl:Class;
           rdfs:label "matrix"@en;
           rdfs:subClassOf arp:MathematicalObject.
arp:Measurable a owl:Class;
               rdfs:label "measurable"@en;
               rdfs:subClassOf arp:SpatialObject.
arp:MeasuredPointManager a owl:Class;
                         rdfs:label "measured point manager"@en;
                         rdfs:subClassOf arp:Point3DManager.
arp:Model a owl:Class;
          rdfs:comment "This is a photogrammetric model. It contains a set of oriented photograph and a set of 3D points which are at least visible on two oriented photographs.";
          rdfs:label "photogrammetric model"@en;
          rdfs:subClassOf arp:Photogrammetry.
arp:NauticalArchaeology a owl:Class;
                        rdfs:label "nautical archaeology"@en;
                        rdfs:subClassOf arp:Archaeology.
arp:Ollae a owl:Class;
          rdfs:label "Olla (e)"@en;
          rdfs:subClassOf arp:RecipientTransport.
arp:PetraData a owl:Class;
              rdfs:label "petra data"@en;
              rdfs:subClassOf arp:UnitaArcheologica.
arp:PhotoManager a owl:Class;
                 rdfs:label "photo manager"@en;
                 rdfs:subClassOf arp:GenericManager.
arp:Photogrammetry a owl:Class;
                   rdfs:label "photogrammetry"@en;
                   rdfs:subClassOf arp:IIdentifiedObject.
arp:Photograph a owl:Class;
               rdfs:label "photograph"@en;
               rdfs:subClassOf arp:Photogrammetry.
arp:Point2DManager a owl:Class;
                   rdfs:label "point 2D manager"@en;
                   rdfs:subClassOf arp:PointManager.
arp:Point3DManager a owl:Class;
                   rdfs:label "point 3D manager"@en;
                   rdfs:subClassOf arp:PointManager.
arp:PointManager a owl:Class;
                 rdfs:label "point manager"@en;
                 rdfs:subClassOf arp:GenericManager.
arp:Point_3D a owl:Class;
             rdfs:label "point 3D"@en;
             rdfs:subClassOf arp:IPoint3D,
                             arp:IColoredPoint.
arp:Prospetto a owl:Class;
              rdfs:label "prospetto"@it,
                         "prospectus"@en;
              rdfs:subClassOf arp:ElementoStratigrafico.
arp:ProspettoGenerale a owl:Class;
                      rdfs:label "prospetto generale"@it,
                                 "general prospectus"@en;
                      rdfs:subClassOf arp:Prospetto;
                      owl:disjointWith arp:ProspettoParticolare.
arp:ProspettoParticolare a owl:Class;
                         rdfs:label "prospetto particolare"@it,
                                    "particular prospectus"@en;
                         rdfs:subClassOf arp:Prospetto.
arp:RadialDecenteringDistortion a owl:Class;
                                rdfs:label "radial decentring distortion"@en;
                                rdfs:subClassOf arp:MathematicalObject.
arp:RecipientTransport a owl:Class;
                       rdfs:label "transport recipient"@en;
                       rdfs:subClassOf arp:Artifact.
arp:RotationMatrix a owl:Class;
                   rdfs:label "rotation matrix"@en;
                   rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty arp:hasRotationMatrix ; 
                                    owl:onClass arp:Transformation3D ; 
                                    a owl:Restriction],
                                   arp:Matrix.
arp:SitiList a owl:Class;
             rdfs:label "siti list"@it,
                        "city list"@en;
             rdfs:subClassOf arp:UnitaArcheologica.
arp:Sito a owl:Class;
         rdfs:label "sito"@it,
                    "city"@en;
         rdfs:subClassOf arp:UnitaArcheologica.
arp:SpatialLocalization a owl:Class;
                        rdfs:label "spatial localization"@en;
                        rdfs:subClassOf arp:IIdentifiedObject.
arp:SpatialObject a owl:Class;
                  rdfs:label "spatial object"@en;
                  rdfs:subClassOf arp:SpatialLocalization,
                                  ecrm:E18_Physical_Thing.
arp:StoneTool a owl:Class;
              rdfs:label "stone tool"@en;
              rdfs:subClassOf arp:Artifact.
arp:Subergorgia a owl:Class;
                rdfs:label "Subergorgia"@en;
                rdfs:subClassOf arp:Alcyonacea.
arp:Transformation3D a owl:Class;
                     rdfs:label "transformation 3D"@en;
                     rdfs:subClassOf arp:Geometry.
arp:TriangleManager a owl:Class;
                    rdfs:label "triangle manager"@en;
                    rdfs:subClassOf arp:GenericManager.
arp:Tuile a owl:Class;
          rdfs:label "tuile"@fr,
                     "tile"@en;
          rdfs:subClassOf arp:ElementDeCouverture.
arp:TuileRonde a owl:Class;
               rdfs:label "tuile ronde"@fr,
                          "round tile"@en;
               rdfs:subClassOf arp:Tuile.
arp:UnitaArcheologica a owl:Class;
                      rdfs:label "unita archeologica"@it,
                                 "archaeological unit"@en;
                      rdfs:subClassOf arp:Archaeology.
arp:UnitaFunzionale a owl:Class;
                    rdfs:label "unita funzionale"@it,
                               "functional unit"@en;
                    rdfs:subClassOf arp:CorpoDiFabbrica.
arp:UnitaStratigrafica a owl:Class;
                       rdfs:label "unita stratigrafica"@it,
                                  "stratigrafical unit"@en;
                       rdfs:subClassOf arp:ElementoStratigrafico.
arp:UnitaStratigraficaMurale a owl:Class;
                             rdfs:label "unita stratigrafica murale"@it,
                                        "mural stratigrafical unit"@en;
                             rdfs:subClassOf arp:UnitaStratigrafica.
arp:UnitaTopografica a owl:Class;
                     rdfs:label "unita topografica"@it,
                                "mural stratigrafical unit"@en;
                     rdfs:subClassOf arp:UnitaArcheologica.
arp:Zoology a owl:Class;
            rdfs:label "zoology"@en;
            rdfs:subClassOf arp:Measurable.
arp:belongToUSM a owl:DatatypeProperty;
                rdfs:domain arp:Bloc;
                rdfs:label "belong to a mural stratigraphic unit"@en;
                rdfs:range xsd:integer.
arp:hasASetOf3DPoint a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:domain arp:Point3DManager;
                     rdfs:label "has a set of 3D points"@en;
                     rdfs:range arp:IPoint3D.
arp:hasASetOf3DPointWithObs a owl:ObjectProperty,
                              owl:AsymmetricProperty,
                              owl:IrreflexiveProperty;
                            rdfs:domain arp:MeasuredPointManager;
                            rdfs:label "has a set of 3D point with observations"@en;
                            rdfs:range arp:Point_3D.
arp:hasASetOfCA a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain arp:Sito;
                rdfs:label "has a set of architectural complexes"@en;
                rdfs:range arp:ComplessoArchitettonico.
arp:hasASetOfCF a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain arp:ComplessoArchitettonico;
                rdfs:label "has a set of factory bodies"@en;
                rdfs:range arp:CorpoDiFabbrica.
arp:hasASetOfCamera a owl:ObjectProperty,
                      owl:AsymmetricProperty;
                    rdfs:domain arp:CameraManager;
                    rdfs:label "has a set of camera"@en;
                    rdfs:range arp:Camera.
arp:hasASetOfObservation a owl:ObjectProperty,
                           owl:AsymmetricProperty,
                           owl:IrreflexiveProperty;
                         rdfs:domain arp:ImagePointManager;
                         rdfs:label "has a set of observations"@en;
                         rdfs:range arp:ImagePoint;
                         rdfs:subPropertyOf owl:topObjectProperty.
arp:hasASetOfPP a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain arp:CorpoDiFabbrica;
                rdfs:label "has a set of particular prospectuses"@en;
                rdfs:range arp:ProspettoParticolare.
arp:hasASetOfSiti a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:domain arp:PetraData;
                  rdfs:label "has a set of city"@en;
                  rdfs:range arp:ManagerCA.
arp:hasASetOfSito a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:domain arp:SitiList;
                  rdfs:label "has a set of cities"@en;
                  rdfs:range arp:Sito.
arp:hasASetOfUS a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain arp:CorpoDiFabbrica,
                            arp:Prospetto,
                            arp:UnitaTopografica;
                rdfs:label "has a set of stratigrafic units"@en;
                rdfs:range arp:UnitaStratigrafica.
arp:hasASetOfUT a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain arp:Sito;
                rdfs:label "has a set of topographic units"@en;
                rdfs:range arp:UnitaTopografica.
arp:hasBellyDiameter a owl:DatatypeProperty;
                     rdfs:domain arp:Amphorae;
                     rdfs:label "has belly diameter"@en;
                     rdfs:range xsd:double.
arp:hasBoundingBox a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:domain arp:SpatialObject;
                   rdfs:label "has bounding box"@en;
                   rdfs:range arp:BoundingBox.
arp:hasCA a owl:ObjectProperty,
            owl:AsymmetricProperty,
            owl:IrreflexiveProperty;
          rdfs:domain arp:CorpoDiFabbrica;
          rdfs:label "has architectural complex"@en;
          rdfs:range arp:ComplessoArchitettonico.
arp:hasCF a owl:ObjectProperty,
            owl:AsymmetricProperty;
          rdfs:domain arp:UnitaFunzionale;
          rdfs:label "has factory body"@en;
          rdfs:range arp:CorpoDiFabbrica.
arp:hasCamera a owl:ObjectProperty,
                owl:AsymmetricProperty,
                owl:IrreflexiveProperty;
              rdfs:domain arp:Photograph;
              rdfs:label "has camera"@en;
              rdfs:range arp:Camera.
arp:hasCameraManager a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:domain arp:Model;
                     rdfs:label "has a camera manager"@en;
                     rdfs:range arp:CameraManager.
arp:hasCenter a owl:ObjectProperty,
                owl:AsymmetricProperty,
                owl:IrreflexiveProperty;
              rdfs:domain arp:UnitaStratigrafica;
              rdfs:label "has center"@en;
              rdfs:range arp:IPoint3D.
arp:hasCoef_K1 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has radial distortion coefficient K1"@en;
               rdfs:range xsd:double.
arp:hasCoef_K2 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has radial distortion coefficient K2"@en;
               rdfs:range xsd:double.
arp:hasCoef_K3 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has radial distortion coefficient K3"@en;
               rdfs:range xsd:double.
arp:hasCoef_K4 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has radial distortion coefficient K4"@en;
               rdfs:range xsd:double.
arp:hasCoef_P1 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has decentring distortion coefficient P1"@en;
               rdfs:range xsd:double.
arp:hasCoef_P2 a owl:DatatypeProperty;
               rdfs:domain arp:RadialDecenteringDistortion;
               rdfs:label "has decentring distortion coefficient P2"@en;
               rdfs:range xsd:double.
arp:hasColor_B a owl:DatatypeProperty;
               rdfs:domain arp:IColoredPoint;
               rdfs:label "has color B"@en;
               rdfs:range xsd:integer.
arp:hasColor_G a owl:DatatypeProperty;
               rdfs:domain arp:IColoredPoint;
               rdfs:label "has color G"@en;
               rdfs:range xsd:integer.
arp:hasColor_R a owl:DatatypeProperty;
               rdfs:domain arp:IColoredPoint;
               rdfs:label "has color R"@en;
               rdfs:range xsd:integer.
arp:hasComment a owl:DatatypeProperty;
               rdfs:comment "manual evaluation of the Percent of necrosed part in a colony";
               rdfs:domain arp:CoralliumRubrum;
               rdfs:label "has comment"@en;
               rdfs:range xsd:string.
arp:hasCorrelationCoef a owl:DatatypeProperty;
                       rdfs:domain arp:ImagePoint;
                       rdfs:label "has correlation coefficient"@en;
                       rdfs:range xsd:double.
arp:hasData a owl:DatatypeProperty;
            rdfs:domain arp:UnitaArcheologica;
            rdfs:label "has data"@en;
            rdfs:range xsd:string.
arp:hasDefinition a owl:DatatypeProperty;
                  rdfs:domain arp:UnitaArcheologica;
                  rdfs:label "has definition"@en;
                  rdfs:range xsd:string.
arp:hasDescription a owl:DatatypeProperty;
                   rdfs:domain arp:UnitaArcheologica;
                   rdfs:label "has description"@en;
                   rdfs:range xsd:string.
arp:hasDiameter a owl:DatatypeProperty;
                rdfs:comment "Should be max Diameter";
                rdfs:domain arp:RecipientTransport;
                rdfs:label "has diameter"@en;
                rdfs:range xsd:double.
arp:hasDiameterNeck a owl:DatatypeProperty;
                    rdfs:domain arp:Amphorae;
                    rdfs:label "has diameter neck"@en;
                    rdfs:range xsd:double.
arp:hasDiameterSupport a owl:DatatypeProperty;
                       rdfs:domain arp:Amphorae;
                       rdfs:label "has diameter support"@en;
                       rdfs:range xsd:double.
arp:hasDirettore a owl:DatatypeProperty;
