@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rec: <http://purl.org/ontology/rec/core#>.

rec: <http://purl.org/dc/elements/1.1/creator> <http://foaf.me/zazi#me>;
     <http://purl.org/dc/elements/1.1/date> "2010-08-02T09:31:52+01:00"^^xsd:dateTime;
     <http://purl.org/dc/elements/1.1/description> """The Recommendation Ontology specification provides basic concepts and properties 
for describing recommendations on/ for the Semantic Web. This document contains a RDF description of the Recommendation Ontology."""@en;
     <http://purl.org/dc/elements/1.1/title> "The Recommendation Ontology"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     <http://www.w3.org/2002/07/owl#imports> <http://purl.org/ontology/ao/core>,
                                             <http://purl.org/dc/elements/1.1/>,
                                             <http://purl.org/dc/terms/>,
                                             <http://purl.org/ontology/olo/core#>,
                                             <http://purl.org/ontology/similarity/>,
                                             <http://xmlns.com/foaf/0.1/>,
                                             <http://www.w3.org/2003/06/sw-vocab-status/ns>;
     <http://www.w3.org/2002/07/owl#versionInfo> 0.3.
rec:RankedRecommendation a <http://www.w3.org/2002/07/owl#Class>,
                           rdfs:Class;
                         rdfs:comment "A ranked recommendation that includes an ordered list of recommendations."@en;
                         rdfs:isDefinedBy rec:;
                         rdfs:label "Ranked Recommendation"@en;
                         rdfs:subClassOf rec:Recommendation,
                                         <http://purl.org/ontology/olo/core#OrderedList>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
rec:Recommendation a rdfs:Class,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A recommendation of something for someone or a specific audience by a recommender."@en;
                   rdfs:isDefinedBy rec:;
                   rdfs:label "Recommendation"@en;
                   rdfs:subClassOf <http://purl.org/ontology/ao/core#LikeableAssociation>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:for a <http://www.w3.org/2002/07/owl#ObjectProperty>,
          rdf:Property;
        rdfs:comment "Relates a recommendation to someone or something."@en;
        rdfs:domain rec:Recommendation;
        rdfs:isDefinedBy rec:;
        rdfs:label "for"@en;
        rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
        <http://www.w3.org/2002/07/owl#inverseOf> rec:recommendation;
        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:ranked_recommendation_object a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                   rdf:Property;
                                 rdfs:comment "A ranked recommendation object in a ranked recommendation"@en;
                                 rdfs:domain rec:RankedRecommendation;
                                 rdfs:isDefinedBy rec:;
                                 rdfs:label "ranked recommendation object"@en;
                                 rdfs:subPropertyOf rec:recommendation_object,
                                                    <http://purl.org/ontology/olo/core#slot>;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
rec:recommendation a rdf:Property,
                     <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A recommendation for someone or something."@en;
                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                   rdfs:isDefinedBy rec:;
                   rdfs:label "has recommendation"@en;
                   rdfs:range rec:Recommendation;
                   rdfs:subPropertyOf <http://purl.org/ontology/similarity/association>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:recommendation_audience a rdf:Property;
                            rdfs:comment "An audience for a specific recommendation."@en;
                            rdfs:domain rec:Recommendation;
                            rdfs:isDefinedBy rec:;
                            rdfs:label "has recommendation audience"@en;
                            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/dc/terms/AgentClass>
                                                                                 <http://xmlns.com/foaf/0.1/Group>) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:recommendation_object a rdf:Property,
                            <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "A recommendation object that is part of a specific recommendation."@en;
                          rdfs:domain rec:Recommendation;
                          rdfs:isDefinedBy rec:;
                          rdfs:label "has recommendation object"@en;
                          rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                          rdfs:subPropertyOf <http://purl.org/ontology/similarity/object>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:recommended_in a rdf:Property,
                     <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A thing, which is recommended in a recommendation."@en;
                   rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
                   rdfs:isDefinedBy rec:;
                   rdfs:label "recommended in"@en;
                   rdfs:range rec:Recommendation;
                   <http://www.w3.org/2002/07/owl#inverseOf> rec:recommendation_object;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:recommender a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "An agent, which provided/calculated this recommendation."@en;
                rdfs:domain rec:Recommendation;
                rdfs:isDefinedBy rec:;
                rdfs:label "has recommender"@en;
                rdfs:subPropertyOf <http://purl.org/dc/terms/creator>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
rec:recommends a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 rdf:Property;
               rdfs:comment "An agent recommends a recommendation to someone or a recommendation audience."@en;
               rdfs:domain <http://purl.org/dc/terms/Agent>;
               rdfs:isDefinedBy rec:;
               rdfs:label "recommends"@en;
               rdfs:range rec:Recommendation;
               <http://www.w3.org/2002/07/owl#inverseOf> rec:recommender;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
