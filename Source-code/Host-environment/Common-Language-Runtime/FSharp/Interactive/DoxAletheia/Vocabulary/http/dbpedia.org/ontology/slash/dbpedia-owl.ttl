dbpedia-owl: ccrel:license <http://www.gnu.org/copyleft/fdl.html>,
                           <http://creativecommons.org/licenses/by-sa/3.0/>;
             dcterms:creator "DBpedia Maintainers and Contributors";
             dcterms:description "The DBpedia ontology provides the classes and properties used in the DBpedia data set."@en;
             dcterms:issued "2008-11-17T12:00Z";
             dcterms:modified "2016-05-21T19:13Z";
             dcterms:publisher "DBpedia Maintainers";
             dcterms:source <http://mappings.dbpedia.org/>;
             dcterms:title "The DBpedia Ontology"@en;
             vann:preferredNamespacePrefix "dbo";
             vann:preferredNamespaceUri "http://dbpedia.org/ontology/";
             a owl:Ontology,
               voaf:Vocabulary;
             rdfs:comment """This ontology is generated from the manually created specifications in the DBpedia Mappings
              Wiki. Each release of this ontology corresponds to a new release of the DBpedia data set which
              contains instance data extracted from the different language versions of Wikipedia. For
              information regarding changes in this ontology, please refer to the DBpedia Mappings Wiki."""@en;
             owl:versionInfo "4.2-SNAPSHOT"@en;
             foaf:homepage pop:Ontology.
dbpedia-owl:Abbey a owl:Class;
                  rdfs:comment "Una abadia és un monestir cristià governat per un abat o abadessa, que és el pare o mare espiritual de la comunitat, i que s'elegeix per un determinat nombre d'anys o per tota la vida."@ca,
                               "klasztor katolicki, na którego czele stoi opat, wraz z należącymi do niego posiadłościami ziemskimi."@pl,
                               "Un'abbazia (detta anche abazia o badia a seconda se diretta da un abate o una badessa), è un particolare tipo di monastero, che per il diritto canonico è un ente autonomo."@it,
                               "Unha abadía é un mosteiro ou convento cristián, baixo o goberno dun abade ou abadesa, independente da xurisdición ordinaria dos bispos, que serve de pai ou nai espiritual da comunidade."@gl,
                               "An abbey is a Catholic monastery or convent, under the authority of an Abbot or an Abbess, who serves as the spiritual father or mother of the community."@en,
                               "Une abbaye est un monastère ou un couvent catholique placé sous la direction d'un abbé, lequel sert de père spirituel à la communauté religieuse"@fr,
                               "Αβαείο είναι ένα καθολικό ανδρικό ή γυναικείο μοναστήριο, που διοικείται από έναν ηγούμενο ή ηγουμένη και αποτελεί τον πνευματικό πατέρα ή μητέρα της κοινότητας."@el;
                  rdfs:label "mainistir"@ga,
                             "수도원"@ko,
                             "abadia"@ca,
                             "abadia"@pt,
                             "abbaye"@fr,
                             "αβαείο"@el,
                             "abbazia"@it,
                             "abadía"@es,
                             "abadía"@gl,
                             "abbey"@en,
                             "修道院"@ja,
                             "修道院"@zh,
                             "abdij"@nl,
                             "Abtei"@de,
                             "opactwo"@pl;
                  rdfs:subClassOf dbpedia-owl:ReligiousBuilding;
                  owl:equivalentClass wikidata:Q160742,
                                      dbpedia-owl:Monastery;
                  nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:Abbey>.
dbpedia-owl:AcademicConference a owl:Class;
                               rdfs:label "conférence scientifique"@fr,
                                          "academic conference"@en,
                                          "навуковая канферэнцыя"@be,
                                          "konferencja naukowa"@pl,
                                          "congresso scientifico"@it,
                                          "学術会議"@ja,
                                          "wetenschappelijke conferentie"@nl,
                                          "научная конференция"@ru,
                                          "wissenschaftliche Konferenz"@de;
                               rdfs:subClassOf dbpedia-owl:SocietalEvent;
                               nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AcademicConference>.
dbpedia-owl:AcademicJournal a owl:Class;
                            rdfs:comment "An academic journal is a mostly peer-reviewed periodical in which scholarship relating to a particular academic discipline is published. Academic journals serve as forums for the introduction and presentation for scrutiny of new research, and the critique of existing research. Content typically takes the form of articles presenting original research, review articles, and book reviews."@en,
                                         "Unha revista académica é unha publicación periódica revisada por expertos na que se publican artigos dunha disciplina académica."@gl,
                                         "Czasopismo naukowe – rodzaj czasopisma, w którym są drukowane publikacje naukowe podlegające recenzji naukowej. Współcześnie szacuje się, że na świecie jest wydawanych ponad 54 tys. czasopism naukowych, w których pojawia się ponad milion artykułów rocznie."@pl,
                                         "Wissenschaftliche Fachzeitschriften sind regelmäßig verlegte Fachzeitschriften über Spezialthemen aus den verschiedensten wissenschaftlichen Disziplinen. Sie stellen neue Methoden, Techniken und aktuelle Trends aus den Wissenschaften dar."@de,
                                         "Ένα ακαδημαϊκό περιοδικό είναι ως επί το πλείστον περιοδικό για κριτικές οι οποίες σχετίζονται με έναν συγκεκριμένο ακαδημαϊκό τομέα. Τα ακαδημαϊκά περιοδικά χρησιμεύουν ως φόρουμ για την εισαγωγή και παρουσίαση του ελέγχου των νέων ερευνών και της κριτικής της υπάρχουσας έρευνας. Το περιεχόμενο έχει συνήθως την μορφή άρθρων παρουσίασης νέας έρευνας, ανασκόπησης υπάρχων άρθρων και κριτικές βιβλίων."@el;
                            rdfs:label "academic journal"@en,
                                       "ακαδημαϊκό περιοδικό"@el,
                                       "学術雑誌"@ja,
                                       "wetenschappelijk tijdschrift"@nl,
                                       "iris acadúil"@ga,
                                       "revista académica"@gl,
                                       "학술지"@ko,
                                       "czasopismo naukowe"@pl,
                                       "giornale accademico"@it,
                                       "Wissenschaftliche Fachzeitschrift"@de,
                                       "journal académique"@fr,
                                       "學術期刊"@zh;
                            rdfs:subClassOf dbpedia-owl:PeriodicalLiterature;
                            owl:equivalentClass wikidata:Q737498;
                            nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AcademicJournal>.
dbpedia-owl:AcademicSubject a owl:Class;
                            rdfs:comment "Unha disciplina académica é unha rama do coñecemento que unha comunidade de especialistas desenvolve con metodoloxías de investigación."@gl,
                                         "Genres of art, e.g. Mathematics, History, Philosophy, Medicine"@en;
                            rdfs:label "sujet académique"@fr,
                                       "akademisches Fach"@de,
                                       "academische hoofdstudierichting"@nl,
                                       "academic subject"@en,
                                       "dyscyplina naukowa"@pl,
                                       "disciplina académica"@gl;
                            rdfs:subClassOf dbpedia-owl:TopicalConcept;
                            owl:equivalentClass wikidata:Q11862829;
                            nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:AcademicSubject>.
