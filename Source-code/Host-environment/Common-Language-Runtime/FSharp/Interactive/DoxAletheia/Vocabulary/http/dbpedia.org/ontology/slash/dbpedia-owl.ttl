                                        "emittente"@it;
                             rdfs:subClassOf dbpedia-owl:Broadcaster;
                             owl:equivalentClass wikidata:Q141683;
                             nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyClass:BroadcastNetwork>.
dbpedia-owl:Broadcaster a owl:Class;
                        rdfs:comment "A broadcaster is an organisation responsible for the production of radio or television programs and/or their transmission. (http://en.wikipedia.org/wiki/Broadcaster - 28/03/2011)"@en,
