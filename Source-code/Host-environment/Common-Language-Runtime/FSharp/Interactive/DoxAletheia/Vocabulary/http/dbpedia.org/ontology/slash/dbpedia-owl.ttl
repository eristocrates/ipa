dbpedia-owl:elementGroup a owl:DatatypeProperty,
                           rdf:Property;
                         rdfs:comment "Un grup d'elements equival a una columna de la taula periòdica."@ca,
                                      "grupa jest pionową kolumną w układzie okresowym pierwiastków chemicznych."@pl,
                                      "последовательность атомов по возрастанию заряда ядра, обладающих однотипным электронным строением."@ru,
                                      "Unter einer Gruppe des Periodensystems versteht man in der Chemie jede Spalte des Periodensystems."@de,
                                      "Séard atá i gceist le grúpa sa choimhthéacs seo ná colún ceartingearach i dtábla peiriadach na ndúl ceimiceach."@ga,
                                      "In chemistry, a group (also known as a family) is a column of elements in the periodic table of the chemical elements."@en;
                         rdfs:domain dbpedia-owl:ChemicalElement;
                         rdfs:label "grupa układu okresowego"@pl,
                                    "grup de la taula periòdica"@ca,
                                    "grúpa an tábla pheiriadaigh"@ga,
                                    "группа периодической системы"@ru,
                                    "element group"@en,
                                    "Gruppe des Periodensystems"@de;
                         rdfs:range xsd:nonNegativeInteger;
                         nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:elementGroup>.
dbpedia-owl:elementPeriod a rdf:Property,
                            owl:DatatypeProperty;
                          rdfs:comment "In the periodic table of the elements, elements are arranged in a series of rows (or periods) so that those with similar properties appear in a column."@en,
                                       "Unter einer Periode des Periodensystems versteht man in der Chemie jede Zeile des Periodensystems der Elemente."@de,
                                       "En la taula periòdica dels elements, un període és una filera de la taula"@ca,
                                       "строка периодической системы химических элементов, последовательность атомов по возрастанию заряда ядра и заполнению электронами внешней электронной оболочки."@ru;
                          rdfs:domain dbpedia-owl:ChemicalElement;
                          rdfs:label "element period"@en,
                                     "període de la taula periòdica"@ca,
                                     "Periode des Periodensystems"@de,
                                     "okres układu okresowego"@pl,
                                     "peiriad an tábla pheiriadaigh"@ga,
                                     "период периодической таблицы"@ru;
                          rdfs:range xsd:nonNegativeInteger;
                          nsprov:wasDerivedFrom <http://mappings.dbpedia.org/index.php/OntologyProperty:elementPeriod>.
