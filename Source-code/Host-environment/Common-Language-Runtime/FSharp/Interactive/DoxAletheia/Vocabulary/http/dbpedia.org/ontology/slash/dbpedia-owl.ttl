dbpedia-owl:AdultActor a owl:Class;
                       rdfs:comment "A pornographic actor or actress or a porn star is a person who performs sex acts in film, normally characterised as a pornographic film."@en,
                                    "Un actor ou unha actriz porno ou pornográfico/a, é un actor ou actriz de cine porno que actúa en películas de temática pornográfica..&lt;ref&gt;https://gl.wikipedia.org/wiki/Actor_pornogr%C3%A1fico&lt;/ref&gt;"@gl;
                       rdfs:label "色情演員"@zh,
                                  "ator adulto"@pt,
                                  "성인 배우"@ko,
                                  "pornografisch acteur"@nl,
                                  "actor porno"@es,
                                  "actor porno"@gl,
                                  "pornographischer Schauspieler"@de,
                                  "acteur porno/acteur adulte"@fr,
