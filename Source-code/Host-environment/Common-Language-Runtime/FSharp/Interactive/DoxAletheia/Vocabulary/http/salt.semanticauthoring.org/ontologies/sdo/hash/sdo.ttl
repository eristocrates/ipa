@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sdo: <http://salt.semanticauthoring.org/ontologies/sdo#>.

sdo:Figure a rdfs:Class;
           rdfs:label "Figure";
           rdfs:subClassOf rdfs:Resource.
sdo:Paragraph a rdfs:Class;
              rdfs:label "Paragraph";
              rdfs:subClassOf rdfs:Resource.
sdo:Publication a rdfs:Class;
                rdfs:label "Publication";
                rdfs:subClassOf rdfs:Resource.
sdo:Revision a rdfs:Class;
             rdfs:label "Revision";
             rdfs:subClassOf rdfs:Resource.
sdo:Section a rdfs:Class;
            rdfs:label "Section";
            rdfs:subClassOf rdfs:Resource.
sdo:Sentence a rdfs:Class;
             rdfs:label "Sentence";
             rdfs:subClassOf rdfs:Resource.
sdo:Table a rdfs:Class;
          rdfs:label "Table";
          rdfs:subClassOf rdfs:Resource.
sdo:TextChunk a rdfs:Class;
              rdfs:label "TextChunk";
              rdfs:subClassOf rdfs:Resource.
sdo:hasAnnotation a rdf:Property;
                  rdfs:domain sdo:TextChunk,
                              sdo:Sentence,
                              sdo:Section,
                              sdo:Paragraph;
                  rdfs:label "hasAnnotation";
                  rdfs:range <http://salt.semanticauthoring.org/ontologies/sao#Annotation>.
sdo:hasCaption a rdf:Property;
               rdfs:domain sdo:Table,
                           sdo:Figure;
               rdfs:label "hasCaption";
               rdfs:range rdfs:Literal.
sdo:hasEndPointer a rdf:Property;
                  rdfs:domain sdo:Revision,
                              sdo:Sentence,
                              sdo:Paragraph,
                              sdo:TextChunk;
                  rdfs:label "hasEndPointer";
                  rdfs:range rdfs:Literal.
sdo:hasFigure a rdf:Property;
              rdfs:domain sdo:Section;
              rdfs:label "hasFigure";
              rdfs:range sdo:Figure.
sdo:hasOrderNumber a rdf:Property;
                   rdfs:domain sdo:Sentence,
                               sdo:Paragraph,
                               sdo:Section;
                   rdfs:label "hasOrderNumber";
                   rdfs:range rdfs:Literal.
sdo:hasParagraph a rdf:Property;
                 rdfs:domain sdo:Section;
                 rdfs:label "hasParagraph";
                 rdfs:range sdo:Paragraph.
sdo:hasRevision a rdf:Property;
                rdfs:domain sdo:TextChunk,
                            sdo:Paragraph,
                            sdo:Sentence;
                rdfs:label "hasRevision";
                rdfs:range sdo:Revision.
sdo:hasSALTVersion a rdf:Property;
                   rdfs:domain sdo:Publication;
                   rdfs:label "hasSALTVersion";
                   rdfs:range rdfs:Literal.
sdo:hasSection a rdf:Property;
               rdfs:domain <http://salt.semanticauthoring.org/ontologies/Publication>;
               rdfs:label "hasSection";
               rdfs:range sdo:Section.
sdo:hasSectionTitle a rdf:Property;
                    rdfs:domain sdo:Section;
                    rdfs:label "hasSectionTitle";
                    rdfs:range rdfs:Literal.
sdo:hasSentence a rdf:Property;
                rdfs:domain sdo:Paragraph;
                rdfs:label "hasSentence";
                rdfs:range sdo:Sentence.
sdo:hasStartPointer a rdf:Property;
                    rdfs:domain sdo:Revision,
                                sdo:Sentence,
                                sdo:Paragraph,
                                sdo:TextChunk;
                    rdfs:label "hasStartPointer";
                    rdfs:range rdfs:Literal.
sdo:hasSubSection a rdf:Property;
                  rdfs:domain sdo:Section;
                  rdfs:label "hasSubSection";
                  rdfs:range sdo:Section.
sdo:hasTable a rdf:Property;
             rdfs:domain sdo:Section;
             rdfs:label "hasTable";
             rdfs:range sdo:Table.
sdo:hasTextChunk a rdf:Property;
                 rdfs:domain sdo:Paragraph,
                             sdo:Sentence;
                 rdfs:label "hasTextChunk";
                 rdfs:range sdo:TextChunk.
