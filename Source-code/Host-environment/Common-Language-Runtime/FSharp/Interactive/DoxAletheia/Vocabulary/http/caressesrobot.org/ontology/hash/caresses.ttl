@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix caresses: <http://caressesrobot.org/ontology#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

_:B13765e15d25529e6b063dfe84251d6d4 a owl:AllDisjointClasses;
                                    owl:members (caresses:AmusementPlace
                                                 caresses:EatingPlace
                                                 caresses:LivingPlace
                                                 caresses:ShoppingPlace
                                                 caresses:SleepingPlace).
_:Bb7a7db85ac40d11604aa12c6bfdf546f a owl:AllDisjointClasses;
                                    owl:members (caresses:Family
                                                 caresses:Friend
                                                 caresses:Relative).
_:Bc91a2492a97ca6b2762189062abd88fd a owl:AllDisjointClasses;
                                    owl:members (caresses:Appliance
                                                 caresses:Decoration
