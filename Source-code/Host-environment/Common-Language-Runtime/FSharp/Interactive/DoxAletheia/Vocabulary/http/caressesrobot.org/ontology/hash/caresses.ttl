                 status:term_status "stable"@en.
caresses:hasLikeliness a owl:DatatypeProperty;
                       rdfs:comment """Likeliness value for conversation topics. It corresponds to a reasonable estimate, to the best of available knowledge, of the a posteriori probability of the assertion. 
- In the Culture-Specific Layer, Likeliness values are used to specify how appropriate each instance is for the each culture, and guide the robot’s behaviour. 
- In the Person-Specific Layer, the likeliness corresponds to the evidence of the assertion collected through interaction with the user."""^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral>;
                       rdfs:domain caresses:Topic;
                       rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                       rdfs:label "hasLikeliness"@en;
                       rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty>;
                       status:term_status "stable"@en.
caresses:hasLine a owl:DatatypeProperty;
                 rdfs:comment "Line account of the user's contact"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral>;
                 rdfs:domain caresses:Person;
                 rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                 rdfs:label "hasLine"@en;
                 rdfs:subPropertyOf <http://w3.org/2002/07/owl#topDataProperty>;
                 status:term_status "stable"@en.
caresses:hasLocation a owl:ObjectProperty;
                     rdfs:comment "ObjectProperty used for let the robot talk about places that are relevant for the user"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral>;
