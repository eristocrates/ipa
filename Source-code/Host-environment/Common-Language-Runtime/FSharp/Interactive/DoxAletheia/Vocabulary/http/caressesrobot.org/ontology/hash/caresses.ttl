caresses:hasLife a owl:ObjectProperty;
                 rdfs:comment "ObjectProperty used for let the robot talk about the user's life"^^<http://w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral>;
                 rdfs:domain caresses:Topic;
