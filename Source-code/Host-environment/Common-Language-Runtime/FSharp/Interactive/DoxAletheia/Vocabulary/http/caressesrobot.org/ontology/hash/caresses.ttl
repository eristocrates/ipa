                                 a owl:Restriction],
                                [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty caresses:hasLine ; 
                                 a owl:Restriction],
                                [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty caresses:hasEmail ; 
