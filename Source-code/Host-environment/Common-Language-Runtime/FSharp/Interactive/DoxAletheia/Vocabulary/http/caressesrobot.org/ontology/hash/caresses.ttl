caresses:Quality a owl:Class;
                 rdfs:comment "Basic entities to perceive or measure: shapes, colors, sizes, sounds, smells,..."@en;
                 rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                 rdfs:label "Quality"@en;
                 rdfs:subClassOf caresses:Topic;
                 status:term_status "stable"@en.
caresses:Relative a owl:Class;
                  rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                  rdfs:label "Relative"@en;
                  rdfs:subClassOf caresses:Person;
                  status:term_status "stable"@en.
caresses:RelativeLocation a owl:Class;
                          rdfs:comment "The position of something expressed in relative terms (e.g. Close, Far, VeryFar, ... )"@en;
                          rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                          rdfs:label "RelativeLocation"@en;
                          rdfs:subClassOf caresses:Location;
                          status:term_status "stable"@en.
caresses:Religion a owl:Class;
                  rdfs:comment """Individuals of this class may be filled with Individuals of the class FoodNorm for the ObjectProperty hasNorm; thus, known the user's religion, the robot would probably investigate aspects related to possible alimentary restrictions

Individuals of this class may be filled with Individuals of the class ReligiousCulturalEvent for the ObjectProperty hasEvent; thus, known the user's religion, the robot would probably talk about related religious festivities."""@en;
                  rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                  rdfs:label "Religion"@en;
                  rdfs:subClassOf [owl:someValuesFrom caresses:FoodNorm ; 
                                   owl:onProperty caresses:hasNorm ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom caresses:ReligiousCulturalEvent ; 
                                   owl:onProperty caresses:hasEvent ; 
                                   a owl:Restriction],
                                  caresses:BeliefSystem;
                  status:term_status "stable"@en.
caresses:ReligiousCulturalEvent a owl:Class;
                                rdfs:comment "Any event related to religious celebrations"@en;
                                rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                                rdfs:label "ReligiousCulturalEvent"@en;
                                rdfs:subClassOf caresses:YearlyEvent;
                                status:term_status "stable"@en.
caresses:Robot a owl:Class;
               rdfs:comment "The user's robot . An instance of the class Robot may be connected with instances of the class Goal, in order to encode all goals that may be achieved by the robot"@en;
               rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
               rdfs:label "Robot"@en;
               rdfs:subClassOf [owl:someValuesFrom caresses:Goal ; 
                                owl:onProperty caresses:hasGoal ; 
                                a owl:Restriction],
                               caresses:Object;
               status:term_status "stable"@en.
caresses:Room a owl:Class;
              rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
              rdfs:label "Room"@en;
              rdfs:subClassOf [owl:someValuesFrom caresses:Object ; 
                               owl:onProperty caresses:hasIn ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:HouseObject ; 
                               owl:onProperty caresses:hasIn ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Room ; 
                               owl:onProperty caresses:hasAdjacent ; 
                               a owl:Restriction],
                              caresses:Location;
              status:term_status "stable"@en.
caresses:Season a owl:Class;
                rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                rdfs:label "Season"@en;
                rdfs:subClassOf caresses:Time;
                status:term_status "stable"@en.
caresses:ShoppingPlace a owl:Class;
                       rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                       rdfs:label "ShoppingPlace"@en;
                       rdfs:subClassOf [owl:someValuesFrom caresses:Location ; 
                                        owl:onProperty caresses:hasLocation ; 
                                        a owl:Restriction],
                                       caresses:PhysicalEnvironment;
                       status:term_status "stable"@en.
caresses:Singer a owl:Class;
                rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                rdfs:label "Singer"@en;
                rdfs:subClassOf caresses:PublicPerson;
                status:term_status "stable"@en.
caresses:SleepingPlace a owl:Class;
                       rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                       rdfs:label "SleepingPlace"@en;
                       rdfs:subClassOf [owl:someValuesFrom caresses:Room ; 
                                        owl:onProperty caresses:hasRoom ; 
                                        a owl:Restriction],
                                       caresses:PhysicalEnvironment;
                       status:term_status "stable"@en.
caresses:SmartDevice a owl:Class;
                     rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                     rdfs:label "SmartDevice"@en;
                     rdfs:subClassOf [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty caresses:hasOperations ; 
                                      a owl:Restriction],
                                     [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty caresses:hasType ; 
                                      a owl:Restriction],
                                     [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty caresses:hasStatus ; 
                                      a owl:Restriction],
                                     [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty caresses:hasAs-sensor ; 
                                      a owl:Restriction],
                                     caresses:HouseObject,
                                     [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty caresses:hasLocations ; 
                                      a owl:Restriction];
                     status:term_status "stable"@en.
caresses:SocialEnvironment a owl:Class;
                           rdfs:comment "Social relationships that influence the user's life (friends, family, ...)"@en;
                           rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                           rdfs:label "SocialEnvironment"@en;
                           rdfs:subClassOf caresses:Topic;
                           status:term_status "stable"@en.
caresses:SocialEvent a owl:Class;
                     rdfs:comment "Any occasion/event that involves social interaction."@en;
                     rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                     rdfs:label "SocialEvent"@en;
                     rdfs:subClassOf [owl:someValuesFrom caresses:Relative ; 
                                      owl:onProperty caresses:hasRelative ; 
                                      a owl:Restriction],
                                     caresses:YearlyEvent,
                                     caresses:Event;
                     status:term_status "stable"@en.
caresses:Song a owl:Class;
              rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
              rdfs:label "Song"@en;
              rdfs:subClassOf [owl:someValuesFrom caresses:Singer ; 
                               owl:onProperty caresses:hasPerson ; 
                               a owl:Restriction],
                              caresses:ArtObject;
              status:term_status "stable"@en.
caresses:Speed a owl:Class;
               rdfs:comment "Voice speed for all actions involving verbal interaction"@en;
               rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
               rdfs:label "Speed"@en;
               rdfs:subClassOf caresses:Parameter;
               status:term_status "stable"@en.
caresses:Sport a owl:Class;
               rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
               rdfs:label "Sport"@en;
               rdfs:subClassOf [owl:someValuesFrom caresses:SportsPlayer ; 
                                owl:onProperty caresses:hasSportsPlayer ; 
                                a owl:Restriction],
                               caresses:TopicOneCanHavePreferenceAbout,
                               caresses:Object;
               status:term_status "stable"@en.
caresses:SportsPlayer a owl:Class;
                      rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                      rdfs:label "SportsPlayer"@en;
                      rdfs:subClassOf caresses:TopicOneCanHavePreferenceAbout,
                                      caresses:PublicPerson;
                      status:term_status "stable"@en.
caresses:TVChannel a owl:Class;
                   rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                   rdfs:label "TVChannel"@en;
                   rdfs:subClassOf [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty caresses:hasUrl-root ; 
                                    a owl:Restriction],
                                   [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty caresses:hasUrl-article ; 
                                    a owl:Restriction],
                                   caresses:Object;
                   status:term_status "stable"@en.
caresses:Time a owl:Class;
              rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
              rdfs:label "Time"@en;
              rdfs:subClassOf caresses:Topic;
              status:term_status "stable"@en.
caresses:TimeFormat a owl:Class;
                    rdfs:comment "12 hr or 24hr"@en;
                    rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                    rdfs:label "TimeFormat"@en;
                    rdfs:subClassOf caresses:Parameter;
                    status:term_status "stable"@en.
caresses:Topic a owl:Class;
               rdfs:comment """Conversation topics that may be explored by the robot.

Conversation topics are defined by a set of DataProperties:
- hasLikeliness (it reflects the probability that the user will have a positive attitude towards that topic, given his cultural identity (if the instance belong to the Culture-Specific ABox), or given the evidence collected through the interaction with the user (if the instance belong to the Person-Specific ABox).
- hasQuestion (encoded sentences used by the robot to ask the general user's feeback about the topic)
- hasQuestionContextual (encoded sentences used by the robot to ask the user's feedback related to the specific context)
- hasQuestionGoal (encoded sentences used by the robot to ask the user about activities to be performed)
- has PositiveSentence (encoded sentences used by the robot when a positive feedback is received)
- has PositiveAndWait (encoded sentences used by the robot when a positive feedback is received. With these sentences, the robot invites the user to freely talk about a conversation topic)
- hasNegativeSentence (encoded sentences used by the robot when a negative feedback is received)
- hasKeyword1 & hasKeyword2 (keywords that may trigger a conversation topic)

Culture-specific instances of subclasses of Topic may be filled with Person-specific instances for the hasSpecific ObjectProperty"""@en;
               rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
               rdfs:label "Topic"@en;
               rdfs:subClassOf [owl:someValuesFrom <http://w3.org/2001/XMLSchema#decimal> ; 
                                owl:onProperty caresses:hasLikeliness ; 
                                a owl:Restriction],
                               [owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ; 
                                owl:onProperty caresses:hasKeyword1 ; 
                                a owl:Restriction],
                               [owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ; 
                                owl:onProperty caresses:hasKeyword2 ; 
                                a owl:Restriction],
                               [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty caresses:hasFull ; 
                                a owl:Restriction],
                               [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty caresses:hasValue ; 
                                a owl:Restriction],
                               [owl:someValuesFrom <http://w3.org/2001/XMLSchema#string> ; 
                                owl:onProperty caresses:hasName ; 
                                a owl:Restriction],
                               [owl:someValuesFrom caresses:Topic ; 
                                owl:onProperty caresses:hasSpecific ; 
                                a owl:Restriction],
                               caresses:Entity;
               status:term_status "stable"@en.
caresses:TopicAboutOnesLife a owl:Class;
                            rdfs:comment "Relevant facts for the user's past and present life (chilldhood, education, heritage, work, ...)"@en;
                            rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                            rdfs:label "TopicAboutOnesLife"@en;
                            rdfs:subClassOf caresses:Topic;
                            status:term_status "stable"@en.
caresses:TopicOneCanHavePreferenceAbout a owl:Class;
                                        rdfs:comment """All things that may be expressed in terms of \"preference\" (e.g. what is your favourite ... ?)"""@en;
                                        rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                                        rdfs:label "TopicOneCanHavePreferenceAbout"@en;
                                        rdfs:subClassOf caresses:Topic;
                                        status:term_status "stable"@en.
caresses:Town a owl:Class;
              rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
              rdfs:label "Town"@en;
              rdfs:subClassOf [owl:onClass caresses:Country ; 
                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty caresses:hasCountry ; 
                               a owl:Restriction],
                              caresses:Location;
              status:term_status "stable"@en.
caresses:User a owl:Class;
              rdfs:comment "Person to which the user-specific information of the Ontology refers"@en;
              rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
              rdfs:label "User"@en;
              rdfs:subClassOf [owl:someValuesFrom caresses:Game ; 
                               owl:onProperty caresses:hasGame ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:PhysicalEnvironment ; 
                               owl:onProperty caresses:hasPhysicalEnvironment ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Food ; 
                               owl:onProperty caresses:hasFood ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Event ; 
                               owl:onProperty caresses:hasEvent ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Addressing ; 
                               owl:onProperty caresses:hasAddressing ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Object ; 
                               owl:onProperty caresses:hasObject ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Norm ; 
                               owl:onProperty caresses:hasNorm ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:FeelingBad ; 
                               owl:onProperty caresses:hasFeeling ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Religion ; 
                               owl:onProperty caresses:hasReligion ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:PhysicalAndMentalCondition ; 
                               owl:onProperty caresses:hasPhysicalAndMentalState ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Manner ; 
                               owl:onProperty caresses:hasManner ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Clothing ; 
                               owl:onProperty caresses:hasCloth ; 
                               a owl:Restriction],
                              caresses:Topic,
                              [owl:someValuesFrom caresses:Habit ; 
                               owl:onProperty caresses:hasHabit ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Music ; 
                               owl:onProperty caresses:hasMusic ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:FeelingWell ; 
                               owl:onProperty caresses:hasFeeling ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:BeliefSystem ; 
                               owl:onProperty caresses:hasBeliefAndValue ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:TopicAboutOnesLife ; 
                               owl:onProperty caresses:hasLife ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:SocialEnvironment ; 
                               owl:onProperty caresses:hasSocialEnvironment ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:HavingHealthProblems ; 
                               owl:onProperty caresses:hasHealthProblem ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:PhysicalAndMentalCondition ; 
                               owl:onProperty caresses:hasHealth ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:Robot ; 
                               owl:onProperty caresses:hasRobot ; 
                               a owl:Restriction],
                              [owl:someValuesFrom caresses:TopicOneCanHavePreferenceAbout ; 
                               owl:onProperty caresses:hasObject ; 
                               a owl:Restriction];
              status:term_status "stable"@en.
caresses:Volume a owl:Class;
                rdfs:comment "Voice volume for all actions involving verbal interaction"@en;
                rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                rdfs:label "Volume"@en;
                rdfs:subClassOf caresses:Parameter;
                status:term_status "stable"@en.
caresses:WaitingTime a owl:Class;
                     rdfs:comment "Waiting Time parameter for the AcceptRequest Action"@en;
