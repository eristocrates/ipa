                                   a owl:Restriction],
                                  [owl:onClass caresses:Goal ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty caresses:hasGoal ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom caresses:Action ; 
                                   owl:onProperty caresses:hasAction ; 
                                   a owl:Restriction],
                                  caresses:Topic;
                  status:term_status "stable"@en.
caresses:Parameter a owl:Class;
                   rdfs:comment "Parameters associated to actions"@en;
                   rdfs:isDefinedBy <http://caressesrobot.org/ontology>;
                   rdfs:label "Parameter"@en;
