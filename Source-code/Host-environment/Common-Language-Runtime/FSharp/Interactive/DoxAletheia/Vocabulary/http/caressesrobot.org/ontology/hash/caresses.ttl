                 rdfs:label "Message"@en;
                 rdfs:subClassOf [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty caresses:hasMessage ; 
                                  a owl:Restriction],
                                 [owl:onDataRange <http://w3.org/2001/XMLSchema#string> ; 
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty caresses:hasCompulsory-recipient ; 
                                  a owl:Restriction],
                                 caresses:Parameter;
                 status:term_status "stable"@en.
caresses:Movie a owl:Class;
