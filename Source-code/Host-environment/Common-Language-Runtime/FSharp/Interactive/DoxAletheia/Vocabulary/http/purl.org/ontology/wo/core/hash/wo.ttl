@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix wo: <http://purl.org/ontology/wo/core#>.

wo: <http://purl.org/dc/elements/1.1/creator> <http://foaf.me/zazi#me>;
    <http://purl.org/dc/elements/1.1/date> "2010-09-14T11:40:52+01:00"^^xsd:dateTime;
    <http://purl.org/dc/elements/1.1/description> "A vocabulary for describing weightings and their referenced scales."@en;
    <http://purl.org/dc/elements/1.1/title> "Weighting Ontology"@en;
    <http://purl.org/vocab/vann/preferredNamespacePrefix> "wo";
    <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/ontology/wo/core#";
    a <http://www.w3.org/2002/07/owl#Ontology>;
    <http://www.w3.org/2002/07/owl#imports> <http://purl.org/NET/scovo>,
                                            <http://www.w3.org/2003/06/sw-vocab-status/ns>,
                                            <http://purl.org/stuff/rev>,
                                            <http://purl.org/NET/c4dm/event.owl>,
                                            <http://purl.org/vocab/vann/>,
                                            <http://purl.org/dc/elements/1.1/>;
    <http://www.w3.org/2002/07/owl#versionInfo> 0.1.
wo:Scale a <http://www.w3.org/2002/07/owl#Class>,
           rdfs:Class;
         rdfs:comment "A concept for describing scales for weights."@en;
         rdfs:isDefinedBy wo:;
         rdfs:label "Scale"@en;
         rdfs:subClassOf <http://purl.org/NET/scovo#Dimension>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:Weight a <http://www.w3.org/2002/07/owl#Class>,
            rdfs:Class;
          rdfs:comment "A weight class to enable timestamped (etc.) weights."@en;
          rdfs:isDefinedBy wo:;
          rdfs:label "Weight"@en;
          rdfs:subClassOf <http://purl.org/NET/scovo#Item>;
          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> wo:weight_value ; 
                                                           <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
wo:max_weight a rdf:Property,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "A maximum weight of a scale."@en;
              rdfs:domain wo:Scale;
              rdfs:isDefinedBy wo:;
              rdfs:label "has max weight"@en;
              rdfs:range xsd:decimal;
              rdfs:subPropertyOf <http://purl.org/stuff/rev#maxRating>,
                                 <http://purl.org/NET/scovo#max>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:min_weight a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                <http://www.w3.org/2002/07/owl#FunctionalProperty>;
              rdfs:comment "A minimum weight of a scale."@en;
              rdfs:domain wo:Scale;
              rdfs:isDefinedBy wo:;
              rdfs:label "has min weight"@en;
              rdfs:range xsd:decimal;
              rdfs:subPropertyOf <http://purl.org/stuff/rev#minRating>,
                                 <http://purl.org/NET/scovo#min>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:scale a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
           rdf:Property,
           <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:comment "A scale for the weighting of some relation."@en;
         rdfs:domain wo:Weight;
         rdfs:isDefinedBy wo:;
         rdfs:label "has scale"@en;
         rdfs:range wo:Scale;
         rdfs:subPropertyOf <http://purl.org/NET/scovo#dimension>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:step_size a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               rdf:Property,
               <http://www.w3.org/2002/07/owl#FunctionalProperty>;
             rdfs:comment "A predefined step size for weight of a specific scale."@en;
             rdfs:domain wo:Scale;
             rdfs:isDefinedBy wo:;
             rdfs:label "has step size"@en;
             rdfs:range xsd:decimal;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:weight a rdf:Property,
            <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "The weight on some relation, e.g. a interest in a topic, or of an interest that is valid for a specific period of time or was raised up in a specific period of time."@en;
          rdfs:domain <http://www.w3.org/2002/07/owl#Thing>;
          rdfs:isDefinedBy wo:;
          rdfs:label "has weight"@en;
          rdfs:range wo:Weight;
          rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#factor>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en.
wo:weight_value a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment "The specific value of a weight."@en;
                rdfs:domain wo:Weight;
                rdfs:isDefinedBy wo:;
                rdfs:label "has weight value"@en;
                rdfs:range xsd:decimal;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en.
