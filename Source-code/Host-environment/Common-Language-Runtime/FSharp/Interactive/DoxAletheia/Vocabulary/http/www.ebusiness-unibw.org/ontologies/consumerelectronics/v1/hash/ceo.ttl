                                                    rdfs:label "Computer display resolution 800x600 60 72 75 85Hz"@en,
                                                               "Computerbildschirmauflösung 800x600 60 72 75 85Hz"@de.
ceo:Connectivity ceo:belongsToModule "TV"@en;
