                    rdfs:label "Common interface"@en,
                               "Common interface"@de.
ceo:CompactFlash ceo:belongsToModule "MP3Player, DigitalCamera, Camcorder"@en;
                 a ceo:StorageMedia;
                 rdfs:comment """CompactFlash (CF) is a mass storage device format used in portable electronic devices. For storage, CompactFlash typically uses flash memory in a standardized enclosure.

(This description is partly based on or reuses content from the Wikipedia article \"CompactFlash\" (http://en.wikipedia.org/wiki/CompactFlash) and is licensed under the GNU Free Documentation License (http://www.gnu.org/copyleft/fdl.html).)"""@en;
                 rdfs:label "CompactFlash"@de,
                            "CompactFlash"@en.
ceo:CompatibleOperatingSystems ceo:belongsToModule "MP3Player, Printer, DigitalCamera, Camcorder"@en;
