ceo:hasDepth ceo:belongsToModule "MP3Player, TV, Printer, DigitalCamera, Camcorder"@en;
             a owl:ObjectProperty;
             rdfs:comment """Defines the distance from side to side, measuring across the object at right angles to the width (Common unit of measurement centimetre, CMT).

