ceo:Audio2.5mm ceo:belongsToModule "MP3Player"@en;
               a ceo:AudioInterfaceType;
               rdfs:comment "Audio interface type of a specific diameter."@en;
               rdfs:label "Audio 2.5mm"@en,
                          "Audio 2.5mm"@de.
ceo:Audio3.5mm ceo:belongsToModule "MP3Player"@en;
