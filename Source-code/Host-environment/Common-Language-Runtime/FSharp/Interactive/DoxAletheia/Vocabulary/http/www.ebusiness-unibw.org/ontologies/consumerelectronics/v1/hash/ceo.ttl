ceo:hasProcessorClockSpeed ceo:belongsToModule "Printer"@en;
                           a owl:ObjectProperty;
                           rdfs:comment "Defines the frequency of the clock in any synchronous circuit (common unit of measurement: hertz, HTZ)."@en;
