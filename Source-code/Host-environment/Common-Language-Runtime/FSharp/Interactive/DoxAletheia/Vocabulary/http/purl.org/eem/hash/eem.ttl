<http://purl.org/eem> dc11:creator "Monika Solanki";
                      dc11:title "The EPCIS Event Model";
                      dcterms:created "16/07/2013";
                      a owl:Ontology;
                      rdfs:seeAlso "http://www.gs1.org/gsmp/kc/epcglobal/epcis/epcis_1_0_1-standard-20070921.pdf";
                      owl:imports <http://www.w3.org/2006/vcard/ns>,
                                  <http://purl.oclc.org/NET/ssnx/ssn>,
                                  <http://purl.org/cbv#>,
                                  <http://purl.org/goodrelations/v1>,
                                  <http://purl.org/co>;
                      owl:versionInfo "1.1".
eem:ADD a owl:NamedIndividual,
          eem:Action;
        rdfs:comment "The entity in question has been created or added to".
eem:Action a owl:Class;
           rdfs:comment "The Action type says how an event relates to the lifecycle of the entity being described.".
eem:AggregationEvent a owl:Class;
                     rdfs:comment """Represents an event that happened to one or more entities denoted by EPCs that are phys
ically aggregated together (physically constrained to be in the same place at the same time, as when cases are aggregated to a pallet). """;
                     rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom eem:Action ; 
                                                          owl:onProperty eem:action ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom eem:SetofEPCs ; 
                                                          owl:onProperty eem:associatedWithEPCList ; 
                                                          a owl:Restriction]
                                                          [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty eem:aggregationID ; 
                                                          owl:onDataRange xsd:string ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class],
                                     eem:EPCISEvent.
eem:AggregationID a owl:Class;
                  rdfs:comment "A concept represent the aggregation identifier of a packagaing unit";
                  rdfs:subClassOf eem:EPC.
eem:BusinessLocation a owl:Class;
                     rdfs:subClassOf gr:Location.
eem:DELETE a owl:NamedIndividual,
             eem:Action;
           rdfs:comment """The entity in question has been removed from or destroyed
altogether. """.
eem:DestinationLocation a owl:Class;
                        rdfs:comment "Added in version 1.1";
                        rdfs:subClassOf gr:Location.
eem:EPC a owl:Class;
        rdfs:comment """A class for encapsulating the EPC for a physical thing through the datatype property
hasEPCValue. """;
        rdfs:label "Electronic Product Code";
        rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom gr:Individual ; 
                                             owl:onProperty eem:associatedWithItem ; 
                                             a owl:Restriction]
                                             [owl:onProperty eem:associatedWithItem ; 
                                             owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                             a owl:Restriction]) ; 
                         a owl:Class].
eem:EPCClass a owl:Class;
             rdfs:comment "A class-level identifier for the class to which the specified quantity of objects belongs.";
             rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#Collection> ; 
                                                  owl:onProperty eem:associatedWithItem ; 
                                                  a owl:Restriction]
                                                  [owl:onProperty eem:associatedWithItem ; 
                                                  owl:allValuesFrom <http://www.loa-cnr.it/ontologies/DUL.owl#Collection> ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
eem:EPCISEvent a owl:Class;
               rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty eem:eventOccurredAt ; 
                                owl:onDataRange xsd:dateTime ; 
                                a owl:Restriction],
                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty eem:eventTimeZoneOffset ; 
                                owl:onDataRange xsd:dateTime ; 
                                a owl:Restriction],
                               [owl:onProperty eem:eventRecordedAt ; 
                                owl:onDataRange xsd:dateTime ; 
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction].
eem:EPCReader a owl:Class;
              rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty eem:logicalReaderID ; 
                                                   owl:onDataRange xsd:anyURI ; 
                                                   a owl:Restriction]
                                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty eem:physicalReaderID ; 
                                                   owl:onDataRange xsd:anyURI ; 
                                                   a owl:Restriction]) ; 
                               a owl:Class],
                              ssnx:SensingDevice.
eem:InputQuantityList a owl:Class;
                      rdfs:comment "Added in version 1.1";
                      rdfs:subClassOf [owl:someValuesFrom eem:QuantityElement ; 
                                       owl:onProperty coll:element ; 
                                       a owl:Restriction],
                                      coll:Bag.
eem:OBSERVE a owl:NamedIndividual,
              eem:Action;
            rdfs:comment "The entity in question has not been changed: it has neither been created, added to, destroyed, or removed from.".
eem:ObjectEvent a owl:Class;
                rdfs:comment """An ObjectEvent captures information about an event pertaining to one or more
physical objects identified by EPCs. """;
                rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom eem:Action ; 
                                                     owl:onProperty eem:action ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom eem:SetofEPCs ; 
                                                     owl:onProperty eem:associatedWithEPCList ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class],
                                eem:EPCISEvent.
eem:OutputQuantityList a owl:Class;
                       rdfs:comment "Added in version 1.1";
                       rdfs:subClassOf [owl:someValuesFrom eem:QuantityElement ; 
                                        owl:onProperty coll:element ; 
                                        a owl:Restriction],
                                       coll:Bag.
eem:QuantityElement a owl:Class;
                    rdfs:comment "Added in version 1.1";
                    rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty eem:hasEPCClass ; 
                                                         owl:onDataRange xsd:anyURI ; 
                                                         a owl:Restriction]
                                                         [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty eem:quantity ; 
                                                         owl:onDataRange xsd:integer ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class],
                                    coll:Item.
eem:QuantityEvent a owl:Class;
                  rdfs:comment """represents an event concerned with a specific
quantity of entities sharing a common EPC class""";
                  rdfs:subClassOf [owl:intersectionOf ([owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty eem:hasEPCClass ; 
                                                       owl:onDataRange xsd:anyURI ; 
                                                       a owl:Restriction]
                                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty eem:quantity ; 
                                                       owl:onDataRange xsd:integer ; 
                                                       a owl:Restriction]) ; 
                                   a owl:Class],
                                  eem:EPCISEvent.
eem:ReadPointLocation a owl:Class;
                      rdfs:subClassOf gr:Location.
eem:SetOfEvents a owl:Class;
                rdfs:subClassOf [owl:onProperty coll:element ; 
                                 owl:allValuesFrom eem:EPCISEvent ; 
                                 a owl:Restriction],
                                coll:Set.
eem:SetOfTransactions a owl:Class;
                      rdfs:subClassOf [owl:onProperty coll:element ; 
                                       owl:allValuesFrom eem:Transaction ; 
                                       a owl:Restriction],
                                      coll:Set.
eem:SetofEPCs a owl:Class;
              rdfs:subClassOf [owl:onProperty coll:element ; 
                               owl:allValuesFrom eem:EPC ; 
                               a owl:Restriction],
                              coll:Set.
eem:SourceLocation a owl:Class;
                   rdfs:comment "Added in version 1.1";
                   rdfs:subClassOf gr:Location.
eem:Transaction a owl:Class;
                rdfs:subClassOf [owl:intersectionOf ([owl:onProperty eem:hasTransactionType ; 
                                                     owl:onClass <http://purl.org/cbv#TransactionType> ; 
                                                     owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction]
                                                     [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty eem:transactionID ; 
                                                     owl:onDataRange xsd:anyURI ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
eem:TransactionEvent a owl:Class;
                     rdfs:comment """represents an event in which one or more entities 
denoted by EPCs become associated
or disassociated with one or more
identified business transactions. """;
                     rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom eem:Action ; 
                                                          owl:onProperty eem:action ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom eem:SetofEPCs ; 
                                                          owl:onProperty eem:associatedWithEPCList ; 
                                                          a owl:Restriction]
                                                          [owl:someValuesFrom eem:SetOfTransactions ; 
                                                          owl:onProperty eem:associatedWithTransactionList ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class],
                                     eem:EPCISEvent.
eem:TransformationEvent a owl:Class;
                        rdfs:comment """Added in version 1.1. Represents an event in which input
objects are fully or partially consumed and output objects are produced, such that any of the input objects may have contributed to all of the output objects.""";
                        rdfs:subClassOf [owl:unionOf ([owl:intersectionOf (eem:EPCISEvent
                                                                          [owl:unionOf ([owl:unionOf ([owl:onProperty eem:associatedWithInputEPCList ; 
                                                                                                    owl:allValuesFrom eem:SetofEPCs ; 
                                                                                                    a owl:Restriction]
                                                                                                    [owl:onProperty eem:hasInputQuantityList ; 
                                                                                                    owl:allValuesFrom eem:InputQuantityList ; 
                                                                                                    a owl:Restriction]) ; 
                                                                                       a owl:Class]
                                                                                       [owl:unionOf ([owl:onProperty eem:associatedWithOutputEPCList ; 
                                                                                                    owl:allValuesFrom eem:SetofEPCs ; 
                                                                                                    a owl:Restriction]
                                                                                                    [owl:onProperty eem:hasOutputQuantityList ; 
                                                                                                    owl:allValuesFrom eem:OutputQuantityList ; 
                                                                                                    a owl:Restriction]) ; 
                                                                                       a owl:Class]) ; 
                                                                          a owl:Class]
                                                                          [owl:someValuesFrom eem:TransformationEvent ; 
                                                                          owl:onProperty eem:associatedWithTransformationEvent ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class]
                                                      [owl:intersectionOf (eem:EPCISEvent
                                                                          [owl:unionOf ([owl:someValuesFrom eem:SetofEPCs ; 
                                                                                       owl:onProperty eem:associatedWithInputEPCList ; 
                                                                                       a owl:Restriction]
                                                                                       [owl:someValuesFrom eem:InputQuantityList ; 
                                                                                       owl:onProperty eem:hasInputQuantityList ; 
                                                                                       a owl:Restriction]) ; 
                                                                          a owl:Class]
                                                                          [owl:unionOf ([owl:someValuesFrom eem:SetofEPCs ; 
                                                                                       owl:onProperty eem:associatedWithOutputEPCList ; 
                                                                                       a owl:Restriction]
                                                                                       [owl:someValuesFrom eem:OutputQuantityList ; 
                                                                                       owl:onProperty eem:hasOutputQuantityList ; 
                                                                                       a owl:Restriction]) ; 
                                                                          a owl:Class]) ; 
                                                      a owl:Class]) ; 
                                         a owl:Class].
eem:action a owl:ObjectProperty;
           rdfs:range eem:Action.
eem:aggregationID a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:range xsd:string.
eem:associatedEPCAndTransaction a owl:ObjectProperty.
eem:associatedWithAggregationID a owl:DatatypeProperty;
                                rdfs:domain eem:SetofEPCs;
                                rdfs:range xsd:anyURI,
                                           xsd:string.
eem:associatedWithEPC a owl:ObjectProperty;
                      rdfs:comment "A product is associated with an EPC";
                      rdfs:domain schema:Product;
                      rdfs:range eem:EPC;
                      rdfs:subPropertyOf owl:topObjectProperty.
eem:associatedWithEPCList a owl:ObjectProperty,
                            owl:FunctionalProperty;
                          rdfs:range eem:SetofEPCs.
eem:associatedWithInputEPCList a owl:ObjectProperty,
                                 owl:FunctionalProperty;
                               rdfs:subPropertyOf eem:associatedWithEPCList.
eem:associatedWithItem a owl:ObjectProperty;
                       rdfs:domain eem:EPC;
                       rdfs:range schema:Product.
eem:associatedWithOutputEPCList a owl:ObjectProperty,
                                  owl:FunctionalProperty;
                                rdfs:subPropertyOf eem:associatedWithEPCList.
eem:associatedWithTransactionList a owl:ObjectProperty,
                                    owl:FunctionalProperty;
                                  rdfs:domain eem:TransactionEvent;
                                  rdfs:range eem:SetOfTransactions.
eem:associatedWithTransformationEvent a owl:ObjectProperty,
                                        owl:SymmetricProperty,
                                        owl:TransitiveProperty.
eem:commissioned a owl:ObjectProperty.
eem:decommissioned a owl:ObjectProperty;
                   rdfs:comment "The EPC(s) named in the event have been decommissioned as part of this event; that is, the EPC(s) do not exist subsequent to the event and should not be observed again".
eem:directlyFollowsEvent a owl:ObjectProperty,
                           owl:FunctionalProperty;
                         rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#directlyFollows>;
                         owl:inverseOf eem:directlyPrecedesEvent.
eem:directlyPrecedesEvent a owl:ObjectProperty,
                            owl:FunctionalProperty;
                          rdfs:domain eem:EPCISEvent;
                          rdfs:range eem:EPCISEvent;
                          rdfs:subPropertyOf <http://www.loa-cnr.it/ontologies/DUL.owl#directlyPrecedes>.
eem:disassociatedWithAggregationID a owl:DatatypeProperty;
                                   rdfs:domain eem:SetofEPCs;
                                   rdfs:range xsd:anyURI,
                                              xsd:string;
                                   rdfs:subPropertyOf owl:topDataProperty.
eem:eventOccurredAt a owl:DatatypeProperty,
                      owl:FunctionalProperty;
                    rdfs:domain eem:EPCISEvent;
                    rdfs:range xsd:dateTime.
eem:eventRecordedAt a owl:DatatypeProperty,
                      owl:FunctionalProperty;
                    rdfs:domain eem:EPCISEvent;
                    rdfs:range xsd:dateTime.
eem:eventTimeZoneOffset a owl:DatatypeProperty,
                          owl:FunctionalProperty;
                        rdfs:domain eem:EPCISEvent;
                        rdfs:range xsd:dateTime.
eem:hasBusinessLocation a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:range eem:BusinessLocation.
eem:hasBusinessStepType a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:domain eem:EPCISEvent;
                        rdfs:range <http://purl.org/cbv#BusinessStep>.
eem:hasChildAddress a owl:ObjectProperty;
                    rdfs:range vcard2006:Address.
eem:hasClassLevelMasterData a owl:ObjectProperty,
                              owl:FunctionalProperty;
                            rdfs:domain eem:EPC.
eem:hasDispositionType a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:range <http://purl.org/cbv#Disposition>.
eem:hasEPCClass a owl:DatatypeProperty,
                  owl:FunctionalProperty;
                rdfs:domain eem:QuantityEvent;
                rdfs:range xsd:anyURI.
eem:hasEPCID a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:domain eem:EPC;
             rdfs:range xsd:anyURI,
                        xsd:string.
eem:hasInputQuantityList a owl:ObjectProperty.
eem:hasOutputQuantityList a owl:ObjectProperty.
eem:hasReadPointLocation a owl:ObjectProperty,
                           owl:FunctionalProperty;
                         rdfs:range eem:ReadPointLocation.
eem:hasTransactionReference a owl:ObjectProperty.
eem:hasTransactionType a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:domain eem:Transaction;
                       rdfs:range <http://purl.org/cbv#TransactionType>.
eem:locationType a owl:ObjectProperty;
                 rdfs:domain eem:BusinessLocation,
                             eem:ReadPointLocation.
eem:logicalReaderID a owl:DatatypeProperty;
                    rdfs:domain eem:EPCReader.
eem:physicalReaderID a owl:DatatypeProperty;
                     rdfs:domain eem:EPCReader.
eem:quantity a owl:DatatypeProperty,
               owl:FunctionalProperty;
             rdfs:domain eem:QuantityEvent;
             rdfs:range xsd:integer.
eem:recordedByReader a owl:ObjectProperty;
                     rdfs:domain eem:EPCISEvent;
                     rdfs:range eem:EPCReader.
eem:transactionID a owl:DatatypeProperty,
                    owl:FunctionalProperty.
wgspos:lat a owl:DatatypeProperty.
wgspos:long a owl:DatatypeProperty.
vcard2006:long a owl:DatatypeProperty.
<urn:swrl#adr1> a swrl:Variable.
<urn:swrl#adr2> a swrl:Variable.
<urn:swrl#e> a swrl:Variable.
<urn:swrl#e1> a swrl:Variable.
<urn:swrl#e2> a swrl:Variable.
<urn:swrl#id> a swrl:Variable.
<urn:swrl#lat> a swrl:Variable.
<urn:swrl#list> a swrl:Variable.
<urn:swrl#lng> a swrl:Variable.
<urn:swrl#loc1> a swrl:Variable.
<urn:swrl#loc2> a swrl:Variable.
<urn:swrl#pdm> a swrl:Variable.
<urn:swrl#set> a swrl:Variable.
<urn:swrl#transaction> a swrl:Variable.
