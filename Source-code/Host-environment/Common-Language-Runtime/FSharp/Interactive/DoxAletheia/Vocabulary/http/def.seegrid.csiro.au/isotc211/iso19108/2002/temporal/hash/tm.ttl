@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix basic: <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic#>.
@prefix tm: <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal#>.
@prefix ext: <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal> dc11:creator "Simon J D COX - CSIRO";
                                                              dc11:description "An OWL representation of part of the model for Temporal objects and reference systems from ISO 19108:2002 Geographic Information - Temporal Schema";
                                                              dc11:source "ISO 19108:2002";
                                                              dc11:title "OWL representation of ISO 19108 (Geographic Information - Temporal Schema)";
                                                              dcterms:created "2011-01-01T00:00:00"^^xsd:dateTime;
                                                              dcterms:hasPart tm:GeometricPrimitive,
                                                                              tm:complex,
                                                                              tm:ClockTime,
                                                                              tm:OrdinalReferenceSystem,
                                                                              tm:frame,
                                                                              tm:end,
                                                                              tm:value,
                                                                              tm:geometry,
                                                                              tm:ordinalValue,
                                                                              tm:DateAndTime,
                                                                              tm:Clock,
                                                                              tm:begunBy,
                                                                              tm:Object,
                                                                              tm:TopologicalPrimitive,
                                                                              tm:topology,
                                                                              tm:OrdinalPosition,
                                                                              tm:Instant,
                                                                              tm:Node,
                                                                              tm:time,
                                                                              tm:temporalPosition,
                                                                              tm:ReferenceSystem,
                                                                              tm:member,
                                                                              tm:primitive,
                                                                              tm:Period,
                                                                              tm:dateTimePosition,
                                                                              tm:endedBy,
                                                                              tm:CalDate,
                                                                              tm:Edge,
                                                                              tm:date,
                                                                              tm:Calendar,
                                                                              tm:name,
                                                                              tm:domainOfValidity,
                                                                              tm:system,
                                                                              tm:previousEdge,
                                                                              tm:nextEdge,
                                                                              tm:group,
                                                                              tm:OrdinalEra,
                                                                              tm:Coordinate,
                                                                              tm:Primitive,
                                                                              tm:begin,
                                                                              tm:CoordinateSystem,
                                                                              tm:Complex,
                                                                              tm:TopologicalComplex,
                                                                              tm:TemporalPosition,
                                                                              tm:component;
                                                              dcterms:license <http://creativecommons.org/licenses/by/3.0/>;
                                                              dcterms:modified "2013-11-13T00:00:00"^^xsd:dateTime;
                                                              vann:preferredNamespacePrefix "tm";
                                                              vann:preferredNamespaceUri tm:;
                                                              a owl:Ontology;
                                                              rdfs:comment """An OWL representation of part of the model for Temporal objects and reference systems from ISO 19108:2002 Geographic Information - Temporal Schema

This vocabulary is provisional, pending finalization of ISO 19150-2.

The URI stem http://def.seegrid.csiro.au/isotc211/ is temporary. The vocabulary is expected to be ultimately published in the domain http://def.isotc211.org/""";
                                                              owl:imports <http://def.seegrid.csiro.au/isotc211/iso19115/2003/extent>,
                                                                          <http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic>,
                                                                          <http://def.seegrid.csiro.au/isotc211/iso19103/2005/basic>;
                                                              owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/temporal.rdf>;
                                                              owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201311/ISOTC211/HM/temporal.rdf>;
                                                              skos:historyNote "2013-02-19 Converted qualified cardinality restrictions to cardinality/only pairs of restrictions".
tm:CalDate a owl:Class;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "Calendar date";
           rdfs:subClassOf [owl:onProperty tm:value ; 
                            owl:allValuesFrom xsd:date ; 
                            a owl:Restriction],
                           [owl:onProperty tm:frame ; 
                            owl:allValuesFrom tm:Calendar ; 
                            a owl:Restriction],
                           tm:TemporalPosition;
           skos:notation "TM_CalDate"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Calendar a owl:Class;
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
            rdfs:label "Calendar";
            rdfs:subClassOf tm:ReferenceSystem;
            skos:notation "TM_Calendar"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Clock a owl:Class;
         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
         rdfs:label "Clock";
         rdfs:subClassOf tm:ReferenceSystem;
         skos:notation "TM_Clock"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:ClockTime a owl:Class;
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
             rdfs:label "Clock time";
             rdfs:subClassOf [owl:onProperty tm:value ; 
                              owl:allValuesFrom xsd:time ; 
                              a owl:Restriction],
                             [owl:onProperty tm:frame ; 
                              owl:allValuesFrom tm:Clock ; 
                              a owl:Restriction],
                             tm:TemporalPosition;
             skos:notation "TM_ClockTime"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Complex a owl:Class;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "Temporal Complex";
           rdfs:subClassOf [owl:onProperty tm:primitive ; 
                            owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           tm:Object;
           skos:notation "TM_Complex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Coordinate a owl:Class;
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
              rdfs:label "Temporal Coordinate";
              rdfs:subClassOf [owl:onProperty tm:frame ; 
                               owl:allValuesFrom tm:CoordinateSystem ; 
                               a owl:Restriction],
                              [owl:onProperty tm:value ; 
                               owl:allValuesFrom basic:Number ; 
                               a owl:Restriction],
                              tm:TemporalPosition;
              skos:notation "TM_Coordinate"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:CoordinateSystem a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "Temporal Coordinate System";
                    rdfs:subClassOf tm:ReferenceSystem;
                    skos:notation "TM_CoordinateSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:DateAndTime a owl:Class;
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
               rdfs:label "Date and time";
               rdfs:subClassOf [owl:onProperty tm:time ; 
                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction],
                               [owl:onProperty tm:date ; 
                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction];
               skos:notation "TM_DateAndTime"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Edge a owl:Class;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
        rdfs:label "Temporal Edge";
        rdfs:subClassOf [owl:onProperty tm:begin ; 
                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:geometry ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:end ; 
                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:end ; 
                         owl:allValuesFrom tm:Node ; 
                         a owl:Restriction],
                        tm:TopologicalPrimitive,
                        [owl:onProperty tm:begin ; 
                         owl:allValuesFrom tm:Node ; 
                         a owl:Restriction],
                        [owl:onProperty tm:geometry ; 
                         owl:allValuesFrom tm:Period ; 
                         a owl:Restriction];
        skos:notation "TM_Edge"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:GeometricComplex a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "Temporal geometric complex";
                    rdfs:subClassOf [owl:onProperty tm:primitive ; 
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction],
                                    [owl:onProperty tm:primitive ; 
                                     owl:allValuesFrom tm:GeometricPrimitive ; 
                                     a owl:Restriction],
                                    tm:Complex;
                    skos:notation "TM_GeometricComplex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:GeometricPrimitive a owl:Class;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                      rdfs:label "Temporal Geometric Primitive";
                      rdfs:subClassOf tm:Primitive;
                      skos:notation "TM_GeometricPrimitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Instant a owl:Class;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "Temporal Instant";
           rdfs:subClassOf [owl:onProperty tm:topology ; 
                            owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty tm:topology ; 
                            owl:allValuesFrom tm:Node ; 
                            a owl:Restriction],
                           [owl:onProperty tm:endedBy ; 
                            owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           [owl:onProperty tm:begunBy ; 
                            owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                            a owl:Restriction],
                           tm:GeometricPrimitive,
                           [owl:unionOf ([owl:onProperty tm:dateTimePosition ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction]
                                         [owl:onProperty tm:temporalPosition ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction]) ; 
                            a owl:Class];
           skos:notation "TM_Instant"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Node a owl:Class;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
        rdfs:label "Temporal Node";
        rdfs:subClassOf [owl:onProperty tm:previousEdge ; 
                         owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:nextEdge ; 
                         owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:geometry ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty tm:geometry ; 
                         owl:allValuesFrom tm:Instant ; 
                         a owl:Restriction],
                        tm:TopologicalPrimitive;
        skos:notation "TM_Node"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Object a owl:Class;
          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
          rdfs:label "Temporal Object";
          rdfs:subClassOf owl:Thing;
          skos:notation "TM_Object"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:OrdinalEra a owl:Class;
              rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
              rdfs:label "Temporal ordinal era";
              rdfs:subClassOf [owl:onProperty tm:group ; 
                               owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction];
              skos:notation "TM_OrdinalEra"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:OrdinalPosition a owl:Class;
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                   rdfs:label "Temporal ordinal position";
                   rdfs:subClassOf [owl:onProperty tm:frame ; 
                                    owl:allValuesFrom tm:OrdinalReferenceSystem ; 
                                    a owl:Restriction],
                                   [owl:onProperty tm:ordinalValue ; 
                                    owl:allValuesFrom tm:OrdinalEra ; 
                                    a owl:Restriction],
                                   tm:TemporalPosition;
                   skos:notation "TM_OrdinalPosition"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:OrdinalReferenceSystem a owl:Class;
                          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                          rdfs:label "Temporal Ordinal Reference System";
                          rdfs:subClassOf tm:ReferenceSystem;
                          skos:notation "TM_OrdinalReferenceSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Period a owl:Class;
          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
          rdfs:label "Temporal Period";
          rdfs:subClassOf [owl:onProperty tm:end ; 
                           owl:allValuesFrom tm:Instant ; 
                           a owl:Restriction],
                          [owl:onProperty tm:topology ; 
                           owl:allValuesFrom tm:Edge ; 
                           a owl:Restriction],
                          [owl:onProperty tm:end ; 
                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                           a owl:Restriction],
                          [owl:onProperty tm:begin ; 
                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                           a owl:Restriction],
                          tm:GeometricPrimitive,
                          [owl:onProperty tm:begin ; 
                           owl:allValuesFrom tm:Instant ; 
                           a owl:Restriction],
                          [owl:onProperty tm:topology ; 
                           owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                           a owl:Restriction];
          skos:notation "TM_Period"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:Primitive a owl:Class;
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
             rdfs:label "Temporal Primitive";
             rdfs:subClassOf tm:Object;
             skos:notation "TM_Primitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:ReferenceSystem a owl:Class;
                   rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                   rdfs:label "Temporal Reference System";
                   rdfs:subClassOf [owl:onProperty tm:domainOfValidity ; 
                                    owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:onProperty tm:name ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:onProperty tm:domainOfValidity ; 
                                    owl:allValuesFrom ext:Extent ; 
                                    a owl:Restriction];
                   skos:notation "TM_ReferenceSystem"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:TemporalPosition a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "Temporal position";
                    rdfs:subClassOf [owl:onProperty tm:frame ; 
                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                     a owl:Restriction],
                                    [owl:unionOf ([owl:onProperty tm:value ; 
                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                  a owl:Restriction]
                                                  [owl:onProperty tm:ordinalValue ; 
                                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                  a owl:Restriction]) ; 
                                     a owl:Class];
                    skos:notation "TM_TemporalPosition"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:TopologicalComplex a owl:Class;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                      rdfs:label "Temporal topologic complex";
                      rdfs:subClassOf [owl:onProperty tm:primitive ; 
                                       owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty tm:primitive ; 
                                       owl:allValuesFrom tm:TopologicalPrimitive ; 
                                       a owl:Restriction],
                                      tm:Complex;
                      skos:notation "TM_TopologicalComplex"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:TopologicalPrimitive a owl:Class;
                        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                        rdfs:label "Temporal Topological Primitive";
                        rdfs:subClassOf [owl:onProperty tm:complex ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        [owl:onProperty tm:complex ; 
                                         owl:allValuesFrom tm:TopologicalComplex ; 
                                         a owl:Restriction],
                                        tm:Primitive;
                        skos:notation "TM_TopologicalPrimitive"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
tm:begin a owl:ObjectProperty;
         rdfs:comment "The value of this property defines the beginning of a time period";
         rdfs:domain [owl:unionOf (tm:Period
                                   tm:Edge) ; 
                      a owl:Class];
         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
         rdfs:label "beginning instant or node";
         rdfs:range [owl:unionOf (tm:Instant
                                  tm:Node) ; 
                     a owl:Class];
         owl:inverseOf tm:begunBy.
tm:begunBy a owl:ObjectProperty;
           rdfs:domain [owl:unionOf (tm:Instant
                                     tm:Node) ; 
                        a owl:Class];
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "begun by";
           rdfs:range [owl:unionOf (tm:Period
                                    tm:Edge) ; 
                       a owl:Class];
           owl:inverseOf tm:begin.
tm:complex a owl:ObjectProperty;
           rdfs:domain tm:Primitive;
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "complex";
           rdfs:range tm:Complex;
           owl:inverseOf tm:primitive.
tm:component a owl:ObjectProperty;
             rdfs:domain tm:OrdinalReferenceSystem;
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
             rdfs:label "component era";
             rdfs:range tm:OrdinalEra;
             rdfs:subPropertyOf skos:hasTopConcept;
             owl:inverseOf tm:system.
tm:date a owl:ObjectProperty;
        rdfs:domain tm:DateAndTime;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
        rdfs:label "calendar date";
        rdfs:range tm:CalDate.
tm:dateTimePosition a owl:DatatypeProperty;
                    rdfs:comment "The value of this property is a time encoded as an xsd:dateTime";
                    rdfs:domain tm:Instant;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "date or dateTime position";
                    rdfs:range [owl:unionOf (basic:Date
                                             basic:DateTime) ; 
                                a rdfs:Datatype].
tm:domainOfValidity a owl:ObjectProperty;
                    rdfs:domain tm:ReferenceSystem;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "domain of validity";
                    rdfs:range ext:Extent.
tm:end a owl:ObjectProperty;
       rdfs:comment "The value of this property defines the end of a time period";
       rdfs:domain [owl:unionOf (tm:Period
                                 tm:Edge) ; 
                    a owl:Class];
       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
       rdfs:label "ending instant or node";
       rdfs:range [owl:unionOf (tm:Instant
                                tm:Node) ; 
                   a owl:Class];
       owl:inverseOf tm:endedBy.
tm:endedBy a owl:ObjectProperty;
           rdfs:domain [owl:unionOf (tm:Instant
                                     tm:Node) ; 
                        a owl:Class];
           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
           rdfs:label "ended by";
           rdfs:range [owl:unionOf (tm:Period
                                    tm:Edge) ; 
                       a owl:Class];
           owl:inverseOf tm:end.
tm:frame a owl:ObjectProperty;
         rdfs:comment "The value of this property indicates the temporal reference system for a time position";
         rdfs:domain tm:TemporalPosition;
         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
         rdfs:label "temporal reference system or frame";
         rdfs:range tm:ReferenceSystem.
tm:geometry a owl:ObjectProperty;
            rdfs:domain tm:TopologicalPrimitive;
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
            rdfs:label "temporal geometry";
            rdfs:range tm:GeometricPrimitive;
            owl:inverseOf tm:topology.
tm:group a owl:ObjectProperty;
         rdfs:domain tm:OrdinalEra;
         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
         rdfs:label "parent era";
         rdfs:range tm:OrdinalEra;
         owl:inverseOf tm:member.
tm:member a owl:ObjectProperty;
          rdfs:domain tm:OrdinalEra;
          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
          rdfs:label "member era";
          rdfs:range tm:OrdinalEra;
          owl:inverseOf tm:group.
tm:name a owl:ObjectProperty;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
        rdfs:label "name".
tm:nextEdge a owl:ObjectProperty;
            rdfs:domain tm:Node;
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
            rdfs:label "next edge";
            rdfs:range tm:Edge;
            rdfs:subPropertyOf tm:begunBy.
tm:ordinalValue a owl:ObjectProperty;
                rdfs:domain tm:OrdinalPosition;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                rdfs:label "ordinal time position";
                rdfs:range tm:OrdinalEra.
tm:previousEdge a owl:ObjectProperty;
                rdfs:domain tm:Node;
                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                rdfs:label "previous edge";
                rdfs:range tm:Edge;
                rdfs:subPropertyOf tm:endedBy.
tm:primitive a owl:ObjectProperty;
             rdfs:domain tm:Complex;
             rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
             rdfs:label "primitive member";
             rdfs:range tm:Primitive;
             owl:inverseOf tm:complex.
tm:system a owl:ObjectProperty,
            owl:FunctionalProperty;
          rdfs:domain tm:OrdinalEra;
          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
          rdfs:label "parent reference system";
          rdfs:range tm:OrdinalReferenceSystem;
          owl:inverseOf tm:component.
tm:temporalPosition a owl:ObjectProperty;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
                    rdfs:label "temporal position";
                    rdfs:range tm:TemporalPosition.
tm:time a owl:ObjectProperty;
        rdfs:domain tm:DateAndTime;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
        rdfs:label "clock time";
        rdfs:range tm:ClockTime.
tm:topology a owl:ObjectProperty;
            rdfs:domain tm:GeometricPrimitive;
            rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
            rdfs:label "temporal topology";
            rdfs:range tm:TopologicalPrimitive;
            owl:inverseOf tm:geometry.
tm:value a owl:DatatypeProperty;
         rdfs:domain tm:TemporalPosition;
         rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19108/2002/temporal>;
         rdfs:label "temporal position value";
         rdfs:subPropertyOf rdf:value.
