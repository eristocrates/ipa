                a kanzaki:Key;
                rdfs:comment "Major key based on D flat, whose key signature has 5 flats.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Des dur".
kanzaki:Director a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An artist who directs a musical group";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Director";
                 rdfs:subClassOf kanzaki:Artist.
kanzaki:E-dur <http://purl.org/dc/terms/alternative> "E major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/E_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on E, whose key signature has 4 sharps.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "E dur".
kanzaki:EnglishHorn a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A double-reed woodwind instrument, larger member of the oboe family.";
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "English Horn";
                    rdfs:subClassOf kanzaki:Oboe.
kanzaki:EnglishHornPlayer a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "An English Horn player";
                          rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                          rdfs:label "English Horn player";
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:EnglishHorn ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          kanzaki:Oboist.
kanzaki:Ensemble a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A musical group which perfroms in relatively small size, particularly chamber music";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Ensemble";
                 rdfs:subClassOf kanzaki:MusicalGroup.
kanzaki:Es-dur <http://purl.org/dc/terms/alternative> "E-Flat major";
               <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/E_flat_major>;
               a kanzaki:Key;
               rdfs:comment "Major key based on E flat, whose key signature has 3 flats.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Es dur".
kanzaki:F-dur <http://purl.org/dc/terms/alternative> "F major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/F_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on F, whose key signature has 1 flat.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "F dur".
kanzaki:Fis-dur <http://purl.org/dc/terms/alternative> "F-Sharp major";
                <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/F_sharp_major>;
                a kanzaki:Key;
                rdfs:comment "Major key based on F sharp, whose key signature has 6 sharps.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Fis dur".
kanzaki:Flute a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A high-pitched woodwind instrument; a slender tube closed at one end with finger holes on one end and an opening near the closed end across which the breath is blown";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Flute";
              rdfs:subClassOf kanzaki:Woodwind_Instrument.
kanzaki:Flutist a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Flute player";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Flutist";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Flute ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kanzaki:Player.
kanzaki:G-dur <http://purl.org/dc/terms/alternative> "G major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/G_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on G, whose key signature has 1 sharp.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "G dur".
kanzaki:Ges-dur <http://purl.org/dc/terms/alternative> "G-Flat major";
