                a kanzaki:Key;
                rdfs:comment "Major key based on G flat, whose key signature has 6 flats.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Ges dur".
kanzaki:Guitar a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A musical instrument having a large flat-backed sound box, a long fretted neck, and usually six strings, played by strumming or plucking.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Guitar";
               rdfs:subClassOf kanzaki:String_Instrument.
kanzaki:Guitarist a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A Guitar player";
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Guitarist";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Guitar ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  kanzaki:Player.
kanzaki:H-dur <http://purl.org/dc/terms/alternative> "B major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/B_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on B, whose key signature has 5 sharps.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "H dur".
kanzaki:Harp a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An instrument with usually 46 or 47 strings that are played by plucking with the fingers.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Harp";
             rdfs:subClassOf kanzaki:String_Instrument.
kanzaki:Harpist a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Harp player";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Harpist";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Harp ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kanzaki:Player.
kanzaki:Harpsichord a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A keyboard instrument whose strings are plucked by means of quills or plectrums. Cembalo.";
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "Harpsichord";
                    rdfs:subClassOf kanzaki:Keyboard_Instrument.
kanzaki:Horn a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A brass instrument with a long narrow tube that is coiled in a circle before ending in a flaring bell, usually being equipped with valves. A French Horn.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Horn";
             rdfs:subClassOf kanzaki:Brass_Instrument.
kanzaki:Hornist a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Horn player";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Hornist";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Horn ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kanzaki:Player.
kanzaki:Key a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A key of a musical work (e.g. C-dur, b-moll)";
            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
            rdfs:label "Key".
kanzaki:Keyboard_Instrument a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A musical instrument that has a set of keys that consist of scale.";
                            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                            rdfs:label "Keyboard Instrument";
                            rdfs:subClassOf kanzaki:Musical_Instrument.
kanzaki:Mandolin a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A pear-shaped small stringed instrument descended from the lute, played with a pick.";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Mandolin";
                 rdfs:subClassOf kanzaki:String_Instrument.
kanzaki:MezzoSoprano a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A Mezzo Soprano singer";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Mezzo Soprano";
                     rdfs:subClassOf kanzaki:Singer.
kanzaki:Movement a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A subsection of a musical work. Typically a movement of a symphony, but also a piece of suit, etc.";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Movement";
                 rdfs:subClassOf kanzaki:Musical_Work.
kanzaki:MusicDirector a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The person who leads a musical group";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Music Director";
                      rdfs:subClassOf kanzaki:Director,
                                      kanzaki:Musician.
kanzaki:MusicalGroup a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A group that performs art works";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Musical Group";
                     rdfs:subClassOf kanzaki:Artist.
kanzaki:Musical_Event a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An event of musical performance by players or singers, including theatrical staging. Typically the event has date and location. Note this is different from Performance, which is a 'representation' of a musical work realized at a musical event or recording, etc.";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Musical Event".
kanzaki:Musical_Instrument a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "An instrument to play music";
                           rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                           rdfs:label "Musical Instrument".
kanzaki:Musical_Representation a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Representation of a musical work, such as a score, sheet music, perfornamce, recoding, etc.";
                               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                               rdfs:label "Musical Representation".
kanzaki:Musical_Work a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A musical work in any form, e.g. a composition, its movement, phrase, theme etc.";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Musical Work".
kanzaki:Musician a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An artist who performs, composes or conducts music";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Musician";
                 rdfs:subClassOf kanzaki:Artist.
kanzaki:Oboe a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A woodwind instrument with a conical bore and a double-reed mouthpiece.";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Oboe";
             rdfs:subClassOf kanzaki:Woodwind_Instrument.
kanzaki:Oboist a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An Oboe player";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Oboist";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Oboe ; 
                                <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               kanzaki:Player.
kanzaki:Oeuvre a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A (complete) musical work by a composer.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Oeuvre";
               rdfs:subClassOf kanzaki:Musical_Work.
kanzaki:Opera a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A musical work with drama, song, chorus and orchestral music. Note 'Opera_Event' in this vocabulary describes the performance of an opera.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Opera (Work)";
              rdfs:subClassOf kanzaki:Oeuvre.
kanzaki:OperaCompany a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A musical group that performs opera works.";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Opera Company";
                     rdfs:subClassOf kanzaki:MusicalGroup.
kanzaki:Opera_Event a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An event of opera performance (not an opera as a musical work, which is defined here as 'Opera')";
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "Opera Event";
                    rdfs:subClassOf kanzaki:Musical_Event.
kanzaki:Opera_Performance a <http://www.w3.org/2002/07/owl#DeprecatedClass>,
                            <http://www.w3.org/2002/07/owl#Class>;
                          <http://www.w3.org/2002/07/owl#equivalentClass> kanzaki:Opera_Event.
kanzaki:Oratorio a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A large musical composition for orchestra, vocal soloists and chorus";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Oratorio";
                 rdfs:subClassOf kanzaki:Choral_Music.
kanzaki:Orchestra a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A musical group which perfroms large scale symphonic works";
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Orchestra";
                  rdfs:subClassOf kanzaki:MusicalGroup.
kanzaki:Orchestral_Work a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A composition for orchestra (and a soloist or soloists, optionally with chorus)";
                        rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                        rdfs:label "Orchestral Work";
                        rdfs:subClassOf kanzaki:Oeuvre.
kanzaki:Overture a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An orchestral music composed for the opening of an opera or oratorio, often played as an independend work in concerts";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Overture";
                 rdfs:subClassOf kanzaki:Orchestral_Work.
kanzaki:Part a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A music for a particular instrument or voice taken from a full score (Note: in this ontology, Part is not a division of an orchestra).";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Part";
             rdfs:subClassOf kanzaki:Written_Representation.
kanzaki:Percussion a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A musical instrument that produces sound by striking the body.";
                   rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                   rdfs:label "Percussion";
                   rdfs:subClassOf kanzaki:Musical_Instrument.
kanzaki:Percussionist a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A Percussion player";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Percussionist";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Percussion ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      kanzaki:Player.
kanzaki:Performance a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Representation of a musical work in the form of performace, e.g. playing instruments, singing etc. Note a concert is a Musical_Event where a Performance is presented.";
                    rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                    rdfs:label "Peroformance";
                    rdfs:subClassOf kanzaki:Musical_Representation.
kanzaki:Pianist a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Piano player";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Pianist";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Piano ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kanzaki:Player.
kanzaki:Piano a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A musical instrument with a manual keyboard actuating hammers that strike wire strings. A pianoforte.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Pian";
              rdfs:subClassOf kanzaki:Keyboard_Instrument.
kanzaki:Piccolo a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A piccolo flute, smaller member of the flute family.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Piccolo";
                rdfs:subClassOf kanzaki:Flute.
kanzaki:PiccoloPlayer a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A Piccolo flute player";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Piccolo player";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Piccolo ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      kanzaki:Flutist.
kanzaki:Player a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "An artist who performs a musical instrument";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Player";
               rdfs:subClassOf kanzaki:Musician.
kanzaki:Recital a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An event of musical performance especially by soloists";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Recital";
                rdfs:subClassOf kanzaki:Musical_Event.
