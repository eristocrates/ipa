<http://www.kanzaki.com/ns/music> <http://purl.org/net/ns/ontology-annot#created> "2003-07-04";
                                  <http://purl.org/net/ns/ontology-annot#creator> [<http://xmlns.com/foaf/0.1/name> "神崎正英"@ja ; 
                                                                                   <http://xmlns.com/foaf/0.1/homepage> <http://www.kanzaki.com/> ; 
                                                                                   rdfs:seeAlso <http://www.kanzaki.com/info/webwho.rdf> ; 
                                                                                   a <http://xmlns.com/foaf/0.1/Person>];
                                  <http://purl.org/net/ns/ontology-annot#modified> "2007-10-31";
                                  a <http://www.w3.org/2002/07/owl#Ontology>;
                                  rdfs:comment "A vocabulary, or music ontology, to describe classical music and performances. Classes (categories) for musical works, events, instruments and performers, as well as related properties are defined. Make sure to distinguish musical works (e.g. Opera) from performance events (Opera_Event), or works (String_Quartette) from performer (StringQuartetEnsemble in this vocab), whose natural language terms are used interchangeblly. The present version experiments more precise model to describe a musical work, its representations (performances, scores, etc) and a musical event to present a representation (a concert). Includes 30 keys as individuals.",
                                               "音楽作品、楽器、演奏情報を記述するためのボキャブラリ。Opera_Event（演奏）とOpera（作品）や、String_Quartette（作品）とStringQuartetEnsemble（団体）のように、日常語では両方の意味に使われるクラスの区別に注意。このバージョンでは、音楽作品、その表現（演奏、楽譜など）とイベント（演奏会）をより精密にモデリングするべく実験中。"@ja;
                                  rdfs:label "Music Vocabulary";
                                  <http://www.w3.org/2002/07/owl#imports> <http://www.kanzaki.com/ns/dliser.rdf>;
                                  <http://www.w3.org/2002/07/owl#versionInfo> "Version 0.9.6 - OWL DL version. Some stable, some experimental. Changed terms: Opera_Performance to Opera_Event, Ballet_Performance to Ballet_Event.".
kanzaki:A-dur <http://purl.org/dc/terms/alternative> "A major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/A_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on A, whose key signature has 3 sharps.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "A dur".
kanzaki:Alto a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An Alto singer";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Alto";
             rdfs:subClassOf kanzaki:Singer.
kanzaki:Artist a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A person or group (or any agent) who creates or performs art works";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Artist";
               rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent>.
kanzaki:As-dur <http://purl.org/dc/terms/alternative> "A-Flat major";
               <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/A_flat_major>;
               a kanzaki:Key;
               rdfs:comment "Major key based on A flat, whose key signature has 4 flats.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "As dur".
kanzaki:B-dur <http://purl.org/dc/terms/alternative> "B-Flat major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/B_flat_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on B flat, whose key signature has 2 flats.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "B dur".
kanzaki:Ballet a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A musical work for a dance form featuring a staged presentation of group or solo dancing. Note 'Ballet_Event' in this vocabulary describes the performance of a ballet.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Ballet (Work)";
               rdfs:subClassOf kanzaki:Oeuvre.
kanzaki:BalletCompany a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A musical group that performs ballet works.";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Ballet Company";
                      rdfs:subClassOf kanzaki:MusicalGroup.
kanzaki:Ballet_Event a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """An event of ballet performance
  """;
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Ballet Event";
                     rdfs:subClassOf kanzaki:Musical_Event.
kanzaki:Ballet_Performance a <http://www.w3.org/2002/07/owl#DeprecatedClass>,
                             <http://www.w3.org/2002/07/owl#Class>;
                           <http://www.w3.org/2002/07/owl#equivalentClass> kanzaki:Ballet_Event.
kanzaki:Baritone a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A Baritone singer";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Baritone";
                 rdfs:subClassOf kanzaki:Singer.
kanzaki:Bass a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Bass singer";
             rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
             rdfs:label "Bass";
             rdfs:subClassOf kanzaki:Singer.
kanzaki:BassClarinet a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A larger member of the clarinet family, usually in key B-flat.";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Bass Clarinet";
                     rdfs:subClassOf kanzaki:Clarinet.
kanzaki:BassClarinettist a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A Bass Clarinet player";
                         rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                         rdfs:label "Bass_Clarinettist";
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:BassClarinet ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         kanzaki:Clarinettist.
kanzaki:BassetHorn a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A larger member of the clarinet family, typically in lower F, and has darker and less brilliant timbre.";
                   rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                   rdfs:label "Basset Horn";
                   rdfs:subClassOf kanzaki:Clarinet.
kanzaki:Bassoon a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A low-pitched woodwind instrument with a double reed, having a long wooden body attached to a U-shaped lateral tube that leads to the mouthpiece. A Fagotto.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Bassoon";
                rdfs:subClassOf kanzaki:Woodwind_Instrument.
kanzaki:Bassoonist a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Fagotto player";
                   rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                   rdfs:label "Bassoonist";
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Bassoon ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   kanzaki:Player.
kanzaki:Brass_Instrument a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A wind musical instrument, that consists of a brass tube  blown by means of a cup-shaped or funnel-shaped mouthpiece.";
                         rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                         rdfs:label "Brass Instrument";
                         rdfs:subClassOf kanzaki:Musical_Instrument.
kanzaki:C-dur <http://purl.org/dc/terms/alternative> "C major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/C_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on C, whose key signature has no sharp or flat.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "C dur".
kanzaki:Cantata a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A vocal composition accompanied by instruments and generally containing more than one movement.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Cantata";
                rdfs:subClassOf kanzaki:Choral_Music.
kanzaki:Celesta a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A musical instrument with a keyboard and metal plates struck by hammers that produce bell-like tones.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Celesta";
                rdfs:subClassOf kanzaki:Keyboard_Instrument.
kanzaki:CelestaPlayer a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A Celesta player";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "CelestaPlayer";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Celesta ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      kanzaki:Player.
kanzaki:Cellist a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Cello player";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Cellist";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Cello ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                kanzaki:Player.
kanzaki:Cello a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A stringed instrument of the violin family, with bass to tenor tone. Usually played in sitting position.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "Cello";
              rdfs:subClassOf kanzaki:String_Instrument.
kanzaki:Ces-dur <http://purl.org/dc/terms/alternative> "C-Flat major";
                <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/C_flat_major>;
                a kanzaki:Key;
                rdfs:comment "Major key based on C flat, whose key signature has 7 flats.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Ces dur".
kanzaki:Chamber_Music a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A genre of music composed for performance by small ensemble";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Chamber Music";
                      rdfs:subClassOf kanzaki:Oeuvre.
kanzaki:Choral_Music a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A genre of music composed for performance by a chorus or choir";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Choral Music";
                     rdfs:subClassOf kanzaki:Oeuvre.
kanzaki:Choreographer a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "someone who creates new dances, or directs an opera";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Choreographer";
                      rdfs:subClassOf kanzaki:Director.
kanzaki:Chorus a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A musical group of singers.";
               rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
               rdfs:label "Chorus";
               rdfs:subClassOf kanzaki:MusicalGroup.
kanzaki:Cis-dur <http://purl.org/dc/terms/alternative> "C-Sharp major";
                <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/C_sharp_major>;
                a kanzaki:Key;
                rdfs:comment "Major key based on C sharp, whose key signature has 7 sharps.";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Cis dur".
kanzaki:Clarinet a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A woodwind instrument having a straight cylindrical tube with a flaring bell and a single-reed mouthpiece.";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Clarinet";
                 rdfs:subClassOf kanzaki:Woodwind_Instrument.
kanzaki:Clarinettist a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A Clarinet player";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Clarinettist";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Clarinet ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     kanzaki:Player.
kanzaki:Composer a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A person (or any agent) who composed art works";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Composer";
                 rdfs:subClassOf kanzaki:Artist.
kanzaki:Concert a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An event of musical performance by players or singers not involving theatrical staging";
                rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                rdfs:label "Concert";
                rdfs:subClassOf kanzaki:Musical_Event.
kanzaki:Concerto a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A composition for orchestra and a soloist";
                 rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                 rdfs:label "Concerto";
                 rdfs:subClassOf kanzaki:Orchestral_Work.
kanzaki:Conductor a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A Conductor";
                  rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                  rdfs:label "Conductor";
                  rdfs:subClassOf kanzaki:Director,
                                  kanzaki:Musician.
kanzaki:Contrabass a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The largest member of string insrtument, usually with four or five strings.";
                   rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                   rdfs:label "Contrabass";
                   rdfs:subClassOf kanzaki:String_Instrument.
kanzaki:Contrabassist a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A Contrabass player";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Contrabassist";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Contrabass ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      kanzaki:Player.
kanzaki:Contrafagotto a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A larger mebmer of the basoon family, producing the lowest tone in the woodwind section.";
                      rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                      rdfs:label "Contrafagotto";
                      rdfs:subClassOf kanzaki:Bassoon.
kanzaki:ContrafagottoPlayer a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A Contrafagotto player";
                            rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                            rdfs:label "ContrafagottoPlayer";
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> kanzaki:Contrafagotto ; 
                                             <http://www.w3.org/2002/07/owl#onProperty> kanzaki:plays ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>],
                                            kanzaki:Bassoonist.
kanzaki:Countertenor a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A Countertenor singer";
                     rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
                     rdfs:label "Countertenor";
                     rdfs:subClassOf kanzaki:Singer.
kanzaki:D-dur <http://purl.org/dc/terms/alternative> "D major";
              <http://purl.org/dc/terms/description> <http://en.wikipedia.org/wiki/D_major>;
              a kanzaki:Key;
              rdfs:comment "Major key based on D, whose key signature has 2 sharps.";
              rdfs:isDefinedBy <http://www.kanzaki.com/ns/music>;
              rdfs:label "D dur".
kanzaki:Des-dur <http://purl.org/dc/terms/alternative> "D-Flat major";
