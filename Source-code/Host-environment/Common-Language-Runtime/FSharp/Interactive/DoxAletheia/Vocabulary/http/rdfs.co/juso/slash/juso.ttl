@prefix juso: <http://rdfs.co/juso/>.

<http://jayg.me/> a <http://xmlns.com/foaf/0.1/Person>;
                  <http://www.w3.org/2002/07/owl#sameAs> <http://listinc.kr/id/member/jgkim>;
                  <http://www.w3.org/ns/org#memberOf> <http://listinc.kr/id/listinc>;
                  <http://xmlns.com/foaf/0.1/homepage> <http://jayg.org/>;
