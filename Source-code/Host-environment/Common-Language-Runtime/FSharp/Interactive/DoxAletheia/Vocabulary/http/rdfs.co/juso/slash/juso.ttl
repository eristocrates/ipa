                               <http://xmlns.com/foaf/0.1/member> <http://listinc.kr/id/member/jgkim>;
                               <http://xmlns.com/foaf/0.1/name> "LiST Inc."@en,
                                                                "주식회사 리스트"@ko.
<http://ontology.eil.utoronto.ca/icontact.owl#hasPostalCode> <http://www.w3.org/2002/07/owl#propertyChainAxiom> (juso:postal_code
                                                                                                                 rdf:value).
<http://ontology.eil.utoronto.ca/icontact.owl#hasState> rdfs:subPropertyOf juso:first_level_administrative_division.
<http://ontology.eil.utoronto.ca/icontact.owl#hasStreetNumber> rdfs:subPropertyOf juso:thoroughfare_address.
<http://purl.org/dc/terms/Location> rdfs:subClassOf juso:SpatialThing.
juso:0.1 <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/>;
         <http://purl.org/dc/terms/creator> <http://jayg.me/>;
         <http://purl.org/dc/terms/description> """
    Juso Ontology is a Web vocabulary for describing geographical addresses and
    features.
    """@en;
         <http://purl.org/dc/terms/hasFormat> <http://rdfs.co/juso/0.1/rdf>,
                                              <http://rdfs.co/juso/0.1/ttl>,
                                              <http://rdfs.co/juso/0.1/html>;
         <http://purl.org/dc/terms/identifier> "http://rdfs.co/juso/0.1";
         <http://purl.org/dc/terms/isVersionOf> juso:;
         <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
         <http://purl.org/dc/terms/publisher> <http://listinc.kr/id/listinc>;
         <http://purl.org/dc/terms/rights> "Copyright © 2015 LiST Inc. Some Rights Reserved.";
         <http://purl.org/dc/terms/title> "주소 온톨로지"@ko,
                                          "Juso Ontology"@en;
         <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
         <http://purl.org/vocab/vann/example> [rdfs:label "LiST Inc."@en ; 
                                               rdfs:comment """
    <pre><code>_:YangyongBldg a juso:Feature ;
  juso:name \"Yangyong Building\"@en , \"양용빌딩\"@ko ;
  juso:geometry &lt;http://geohash.org/wydjrzg6ece9&gt; .

_:LiSTInc a juso:SpatialThing , foaf:Organization ;
  juso:name \"LiST Inc.\"@en , \"주식회사 리스트\"@ko ;
  juso:within _:YangyongBldg ;
  juso:historical_address [
    a juso:Address ;
    juso:full_address
      \"대한민국 서울특별시 영등포구 당산동 121-17 양용빌딩 9층 150-040\"@ko ,
      \"9th Floor, Yangyong Building, 121-17, Dangsan-dong, Yeongdeungpo-gu, Seoul, 150-040, South Korea\"@en ;
    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;
    juso:first_level_administrative_division &lt;http://sws.geonames.org/1835847/&gt; ;
    juso:second_level_administrative_division &lt;http://sws.geonames.org/1832536/&gt; ;
    juso:third_level_administrative_division &lt;http://sws.geonames.org/8692617/&gt; ;
    juso:locator _:YangyongBldg ;
    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;
    juso:postal_code [
      a juso:PostalCode ;
      rdf:value \"150-040\"
    ]
  ] ;
  juso:address [
    a juso:Address ;
    juso:full_address
      \"대한민국 서울특별시 영등포구 버드나루로19길 3 (당산동) 양용빌딩 9층 07229\"@ko ,
      \"9th Floor, Yangyong Building, 3, Beodeunaru-ro 19-gil, Yeongdeungpo-gu, Seoul, 07229, South Korea\"@en ;
    juso:country &lt;http://sws.geonames.org/1835841/&gt; ;
    juso:first_level_administrative_division &lt;http://sws.geonames.org/1835847/&gt; ;
    juso:second_level_administrative_division &lt;http://sws.geonames.org/1832536/&gt; ;
    juso:third_level_administrative_division &lt;http://sws.geonames.org/8692617/&gt; ;
    juso:thoroughfare [
      a juso:Street ;
      juso:name \"Beodeunaru-ro 19-gil\"@en , \"버드나루로19길\"@ko ;
      juso:parent &lt;http://sws.geonames.org/8692617/&gt;
    ] ;
    juso:thoroughfare_address \"3\" ;
    juso:locator _:YangyongBldg ;
    juso:locator_address \"9층\"@ko , \"9th Floor\"@en ;
    juso:postal_code [
      a juso:PostalCode ;
      rdf:value \"07229\"
    ]
  ] .</code></pre>
    """^^rdf:XMLLiteral];
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "juso";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://rdfs.co/juso/";
         <http://purl.org/vocab/vann/termGroup> juso:PoliticalDivisionGroup,
                                                juso:CoreGroup,
                                                juso:AddressGroup;
         a <http://purl.org/vocommons/voaf#Vocabulary>,
           <http://www.w3.org/2002/07/owl#Ontology>,
           <http://creativecommons.org/ns#Work>,
           <http://www.w3.org/ns/adms#SemanticAsset>;
         rdfs:comment """
    Most of the descriptions given here are from Wikipedia or from the related
    ontologies and vocabularies.
    """@en,
                      """
    <div>
      The master version of this vocabulary is maintained in <a
      href=\"https://github.com/listinc/juso-ontology\">the GitHub repository</a>
      so others can contribute edits and improvements.
    </div>
    """,
                      """
    There is an extension to this ontology with some country-specific terms for
    <a href=\"http://rdfs.co/juso/kr/\">South Korea</a>.
    """@ko;
         rdfs:seeAlso <https://github.com/listinc/juso-ontology>;
         <http://www.w3.org/2002/07/owl#versionInfo> "0.1";
         <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/UnderDevelopment>.
<http://rdfs.co/juso/0.1/html> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                  rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/html> ; 
                                                                  rdfs:label "HTML"@en ; 
                                                                  rdf:value "text/html" ; 
                                                                  a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/juso/0.1/rdf> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                 rdfs:seeAlso <http://www.iana.org/assignments/media-types/application/rdf+xml> ; 
                                                                 rdfs:label "RDF/XML"@en ; 
                                                                 rdf:value "application/rdf+xml" ; 
                                                                 a <http://purl.org/dc/terms/MediaType>].
<http://rdfs.co/juso/0.1/ttl> <http://purl.org/dc/terms/format> [<http://purl.org/dc/dcam/memberOf> <http://purl.org/dc/terms/IMT> ; 
                                                                 rdfs:seeAlso <http://www.iana.org/assignments/media-types/text/turtle> ; 
                                                                 rdfs:label "Turtle"@en ; 
                                                                 rdf:value "text/turtle" ; 
                                                                 a <http://purl.org/dc/terms/MediaType>].
juso:Address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy juso:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Address_(geography)>;
             <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/ns/locn#Address>,
                                                    <http://ontology.eil.utoronto.ca/icontact.owl#Address>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Geographical Address"@en,
                                                            "Postal Address"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    An address is a collection of information, presented in a mostly fixed
    format, used for describing the location of a building, apartment, or other
    structure or a plot of land, generally using political boundaries and
    street names as references, along with other identifiers such as house or
    apartment numbers. Some addresses also contain special codes to aid routing
    of mail and packages, such as a ZIP code or post code.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Address"@en,
                                                             "주소"@ko.
juso:AddressGroup rdf:_1 juso:full_address;
                  rdf:_10 juso:thoroughfare;
                  rdf:_11 juso:thoroughfare_address;
                  rdf:_12 juso:locator;
                  rdf:_13 juso:locator_address;
                  rdf:_14 juso:po_box;
                  rdf:_15 juso:PostalCode;
                  rdf:_16 juso:postal_code;
                  rdf:_2 juso:country;
                  rdf:_3 juso:first_level_administrative_division;
                  rdf:_4 juso:second_level_administrative_division;
                  rdf:_5 juso:third_level_administrative_division;
                  rdf:_6 juso:fourth_level_administrative_division;
                  rdf:_7 juso:fifth_level_administrative_division;
                  rdf:_8 juso:Thoroughfare;
                  rdf:_9 juso:Street;
                  a rdf:Bag;
                  rdfs:comment """
    These classes and properties are used to describe addresses.
    """@en;
                  rdfs:label "Address Terms"@en.
juso:AdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:isDefinedBy juso:;
                            rdfs:seeAlso <https://en.wikipedia.org/wiki/Administrative_division>,
                                         <http://www.geonames.org/ontology#A.ADMD>;
                            rdfs:subClassOf juso:PoliticalDivision;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                            <http://www.w3.org/2004/02/skos/core#altLabel> "Administrative Entity"@en,
                                                                           "Subnational Entity"@en,
                                                                           "Geopolitical Division"@en,
                                                                           "Country Subdivision"@en,
                                                                           "Administrative Unit"@en;
                            <http://www.w3.org/2004/02/skos/core#definition> """
    An administrative division is a portion of a country or other region
    delineated for the purpose of administration. Administrative divisions are
    each granted a certain degree of autonomy and are usually required to
    manage themselves through their own local governments.
    """@en;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Administrative Division"@en.
juso:CapitalDistrict <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy juso:;
                     rdfs:seeAlso <https://en.wikipedia.org/wiki/Capital_districts_and_territories>;
                     rdfs:subClassOf juso:AdministrativeDivision;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Capital Territory"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    A capital district or capital territory is normally a specially designated
    administrative division where a country's seat of government is located.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Capital District"@en.
juso:City <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy juso:;
          rdfs:seeAlso <https://en.wikipedia.org/wiki/City>;
          rdfs:subClassOf juso:AdministrativeDivision,
                          <http://schema.org/City>;
          <http://www.w3.org/2002/07/owl#sameAs> <http://dbpedia.org/ontology/City>,
                                                 <http://linkedgeodata.org/ontology/City>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    A city is a large and permanent human settlement. Although there is no
    agreement on how a city is distinguished from a town in general English
    language meanings, many cities have a particular administrative, legal, or
    historical status based on local law.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "市"@ja,
                                                          "City"@en,
                                                          "시"@ko.
juso:ConsolidatedCityCounty <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                            a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:isDefinedBy juso:;
                            rdfs:seeAlso <https://en.wikipedia.org/wiki/Consolidated_city-county>;
                            rdfs:subClassOf juso:County,
                                            juso:City;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                            <http://www.w3.org/2004/02/skos/core#definition> """
    A consolidated city-county is a city and county that have been merged into
    one unified jurisdiction. As such it is simultaneously a city, which is a
    municipal corporation, and a county, which is an administrative division of
    a state. It has the powers and responsibilities of both types of entities.
    """@en;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Consolidated City-county"@en.
juso:CoreGroup rdf:_1 juso:SpatialThing;
               rdf:_10 juso:address;
               rdf:_11 juso:historical_address;
               rdf:_2 juso:Feature;
               rdf:_3 juso:Geometry;
               rdf:_4 juso:Address;
               rdf:_5 juso:name;
               rdf:_6 juso:within;
               rdf:_7 juso:endonym;
               rdf:_8 juso:exonym;
               rdf:_9 juso:geometry;
               a rdf:Bag;
               rdfs:comment """
    These classes and properties form the core of Juso Ontology. They describe
    fundamental characteristics of geography in relatively broad terms.
    """@en;
               rdfs:label "Core Terms"@en.
juso:Country <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy juso:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Country>;
             rdfs:subClassOf juso:PoliticalDivision;
             <http://www.w3.org/2002/07/owl#sameAs> <http://linkedgeodata.org/ontology/Country>,
                                                    <http://schema.org/Country>,
                                                    <http://dbpedia.org/ontology/Country>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "国家"@ja,
                                                            "국가"@ko;
             <http://www.w3.org/2004/02/skos/core#definition> """
    A country is a region that is identified as a distinct entity in political
    geography. A country may be an independent sovereign state or one that is
    occupied by another state, as a non-sovereign or formerly sovereign
    political division, or a geographic region associated with sets of
    previously independent or differently associated people with distinct
    political characteristics.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "国"@ja,
                                                             "나라"@ko,
                                                             "Country"@en.
juso:County <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy juso:;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/County>;
            rdfs:subClassOf juso:AdministrativeDivision;
            <http://www.w3.org/2002/07/owl#sameAs> <http://linkedgeodata.org/ontology/County>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Cnty."@en-us,
                                                           "Co."@en-gb;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A county is a geographical region of a country used for administrative or
    other purposes, in certain modern nations.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "군"@ko,
                                                            "County"@en.
juso:District <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy juso:;
              rdfs:seeAlso <https://en.wikipedia.org/wiki/District>;
              rdfs:subClassOf juso:AdministrativeDivision;
              <http://www.w3.org/2002/07/owl#sameAs> <http://dbpedia.org/ontology/District>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    A district is a type of administrative division that, in some countries, is
    managed by local government. Across the world, areas known as \"districts\"
    vary greatly in size, spanning entire regions or counties, several
    municipalities, subdivisions of municipalities, school district, or
    political district.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "District"@en,
                                                              "구"@ko.
juso:Feature <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy juso:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Geographical_feature>;
             rdfs:subClassOf juso:SpatialThing,
                             <http://www.opengis.net/ont/geosparql#Feature>;
             <http://www.w3.org/2002/07/owl#disjointWith> juso:Geometry;
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.geonames.org/ontology#Feature>;
             <http://www.w3.org/2002/07/owl#sameAs> <http://geovocab.org/spatial#Feature>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Feature"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    Geographical features are man-made or naturally-created features associated
    with a location relative to the Earth.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Geographical Feature"@en.
juso:FederatedState <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                    <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy juso:;
                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Federated_state>;
                    rdfs:subClassOf <http://schema.org/State>,
                                    <http://linkedgeodata.org/ontology/State>,
                                    <http://dbpedia.org/ontology/State>,
                                    juso:AdministrativeDivision;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "주"@ko,
                                                                   "State"@en;
                    <http://www.w3.org/2004/02/skos/core#definition> """
    A federated state is a territorial and constitutional community forming
    part of a federal union (federation) such as the United States and
    Australia.
    """@en;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Federated State"@en,
                                                                    "연방주"@ko.
juso:FifthLevelAdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                      a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:isDefinedBy juso:;
                                      rdfs:seeAlso <http://www.geonames.org/ontology#A.ADM5>;
                                      rdfs:subClassOf juso:AdministrativeDivision;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "Fifth Administrative Level"@en,
                                                                                     "Fifth-order Administrative Division"@en;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
    A subdivision of a fourth-level administrative division.
    """@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Fifth-level Administrative Division"@en.
juso:FirstLevelAdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                      a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:isDefinedBy juso:;
                                      rdfs:seeAlso <http://www.geonames.org/ontology#A.ADM1>;
                                      rdfs:subClassOf juso:AdministrativeDivision;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "First-order Administrative Division"@en,
                                                                                     "First Administrative Level"@en;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
    A primary administrative division of a country, such as a state in the
    United States.
    """@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "First-level Administrative Division"@en.
juso:FourthLevelAdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                       a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:isDefinedBy juso:;
                                       rdfs:seeAlso <http://www.geonames.org/ontology#A.ADM4>;
                                       rdfs:subClassOf juso:AdministrativeDivision;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                       <http://www.w3.org/2004/02/skos/core#altLabel> "Fourth Administrative Level"@en,
                                                                                      "Fourth-order Administrative Division"@en;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
    A subdivision of a third-level administrative division.
    """@en;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Fourth-level Administrative Division"@en.
juso:Geometry <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy juso:;
              rdfs:seeAlso <https://en.wikipedia.org/wiki/Geometry>;
              rdfs:subClassOf juso:SpatialThing;
              <http://www.w3.org/2002/07/owl#disjointWith> juso:Feature;
              <http://www.w3.org/2002/07/owl#sameAs> <http://www.opengis.net/ont/geosparql#Geometry>,
                                                     <http://www.w3.org/ns/locn#Geometry>,
                                                     <http://geovocab.org/geometry#Geometry>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    Geometry provides \"the means for the quantitative description, by means of
    coordinates and mathematical functions, of the spatial characteristics of
    features, including dimension, position, size, shape, and orientation\", as
    defined in ISO 19107.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "기하"@ko,
                                                              "Geometry"@en.
juso:Hamlet <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy juso:;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Hamlet_(place)>;
            rdfs:subClassOf juso:AdministrativeDivision;
            <http://www.w3.org/2002/07/owl#sameAs> <http://linkedgeodata.org/ontology/Hamlet>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A hamlet is a type of settlement. The definition of hamlet varies by
    country. It usually refers to a small settlement, with a small population
    that is usually under 100, in a rural area, or a component of a larger
    settlement or municipality. Hamlets are typically unincorporated
    communities.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Hamlet"@en.
juso:Municipality <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy juso:;
                  rdfs:seeAlso <https://en.wikipedia.org/wiki/Municipality>;
                  rdfs:subClassOf juso:AdministrativeDivision;
                  <http://www.w3.org/2002/07/owl#sameAs> <http://dbpedia.org/ontology/Municipality>,
                                                         <http://linkedgeodata.org/ontology/Municipality>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    A municipality is usually an urban administrative division having corporate
    status and usually powers of self-government or jurisdiction.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Municipality"@en.
juso:Neighborhood <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy juso:;
                  rdfs:seeAlso <https://en.wikipedia.org/wiki/Neighbourhood>;
                  rdfs:subClassOf juso:AdministrativeDivision;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    A neighborhood, or neighbourhood, is a geographically localised community
    within a larger city, town, suburb or rural area.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Neighborhood"@en-us,
                                                                  "Neighbourhood"@en-gb,
                                                                  "동"@ko.
juso:Parish <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy juso:;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Parish_(administrative_division)>;
            rdfs:subClassOf juso:AdministrativeDivision;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Civil Parish"@en-gb;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A parish is an administrative division used by several countries. In parts
    of the British Isles it is known as a civil parish to distinguish it from
    the ecclesiastical parish.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Parish"@en.
juso:PoliticalDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy juso:;
                       rdfs:seeAlso <https://en.wikipedia.org/wiki/Political_division>;
                       rdfs:subClassOf juso:Feature;
                       <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/AdministrativeArea>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                       <http://www.w3.org/2004/02/skos/core#definition> """
    A political division is a geographic region accepted to be in the
    jurisdiction of a particular governmental entity. The particular government
    entity varies as each organizes its operations by further divisions
    (subdivisions of the state) to further its tasks and satisfy its
    responsibilities.
    """@en;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Political Division"@en.
juso:PoliticalDivisionGroup rdf:_1 juso:PoliticalDivision;
                            rdf:_10 juso:Province;
                            rdf:_11 juso:County;
                            rdf:_12 juso:Parish;
                            rdf:_13 juso:Borough;
                            rdf:_14 juso:CapitalDistrict;
                            rdf:_15 juso:City;
                            rdf:_16 juso:ConsolidatedCityCounty;
                            rdf:_17 juso:Municipality;
                            rdf:_18 juso:District;
                            rdf:_19 juso:Town;
                            rdf:_2 juso:Country;
                            rdf:_20 juso:Township;
                            rdf:_21 juso:Neighborhood;
                            rdf:_22 juso:Village;
                            rdf:_23 juso:Hamlet;
                            rdf:_24 juso:political_division;
                            rdf:_25 juso:parent;
                            rdf:_3 juso:AdministrativeDivision;
                            rdf:_4 juso:FirstLevelAdministrativeDivision;
                            rdf:_5 juso:SecondLevelAdministrativeDivision;
                            rdf:_6 juso:ThirdLevelAdministrativeDivision;
                            rdf:_7 juso:FourthLevelAdministrativeDivision;
                            rdf:_8 juso:FifthLevelAdministrativeDivision;
                            rdf:_9 juso:FederatedState;
                            a rdf:Bag;
                            rdfs:comment """
    These classes and properties are used to describe political and
    administrative divisions.
    """@en;
                            rdfs:label "Political Division Terms"@en.
juso:PostalCode <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy juso:;
                rdfs:seeAlso <https://en.wikipedia.org/wiki/Postal_code>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Postcode"@en,
                                                               "ZIP Code"@en,
                                                               "Post Code"@en,
                                                               "PIN Code"@en,
                                                               "Eircode"@en;
                <http://www.w3.org/2004/02/skos/core#definition> """
    A postal code is a series of letters and/or digits, sometimes including
    spaces or punctuation, included in a postal address for the purpose of
    sorting mail.
    """@en;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Postal Code"@en,
                                                                "우편번호"@ko.
juso:Province <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy juso:;
              rdfs:seeAlso <https://en.wikipedia.org/wiki/Province>;
              rdfs:subClassOf <http://schema.org/State>,
                              juso:AdministrativeDivision;
              <http://www.w3.org/2002/07/owl#sameAs> <http://dbpedia.org/ontology/Province>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    A province is almost always an administrative division, within a country or
    state.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Province"@en,
                                                              "도"@ko.
juso:SecondLevelAdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                       <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                       a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:isDefinedBy juso:;
                                       rdfs:seeAlso <http://www.geonames.org/ontology#A.ADM2>;
                                       rdfs:subClassOf juso:AdministrativeDivision;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                       <http://www.w3.org/2004/02/skos/core#altLabel> "Second Administrative Level"@en,
                                                                                      "Second-order Administrative Division"@en;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
    A subdivision of a first-level administrative division.
    """@en;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Second-level Administrative Division"@en.
juso:SpatialThing <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy juso:;
                  <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>,
                                                         <http://www.opengis.net/ont/geosparql#SpatialObject>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Spatial Object"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    Anything that has a spatial representation, i.e. size, shape, or position.
    e.g. people, places, objects, as well as abstract areas like cubes.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Spatial Thing"@en.
juso:Street <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy juso:;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Street>,
                         <http://www.geonames.org/ontology#R.ST>;
            rdfs:subClassOf juso:Thoroughfare;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A street is a public thoroughfare (usually paved) in a built environment.
    Practically all public streets in Western countries and the majority
    elsewhere (though not in Japan) are given a street or road name or at least
    a number to identify them and any addresses located along the streets.
    Alleys in some places do not have names.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Street"@en.
juso:ThirdLevelAdministrativeDivision <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                      <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                      a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:isDefinedBy juso:;
                                      rdfs:seeAlso <http://www.geonames.org/ontology#A.ADM3>;
                                      rdfs:subClassOf juso:AdministrativeDivision;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "Third Administrative Level"@en,
                                                                                     "Third-order Administrative Division"@en;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
    A subdivision of a second-level administrative division.
    """@en;
                                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Third-level Administrative Division"@en.
juso:Thoroughfare <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy juso:;
                  rdfs:seeAlso <https://en.wikipedia.org/wiki/Thoroughfare>;
                  rdfs:subClassOf juso:Feature;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    A passage or way through from one location to another, which is usually
    used a component of an address. A thoroughfare is not necessarily a road,
    it might be a waterway or some other feature.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Thoroughfare"@en.
juso:Town <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy juso:;
          rdfs:seeAlso <https://en.wikipedia.org/wiki/Town>;
          rdfs:subClassOf juso:AdministrativeDivision;
          <http://www.w3.org/2002/07/owl#sameAs> <http://linkedgeodata.org/ontology/Town>,
                                                 <http://dbpedia.org/ontology/Town>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    A town is a human settlement larger than a village but smaller than a city.
    The size definition for what constitutes a \"town\" varies considerably in
    different parts of the world.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "읍"@ko,
                                                          "Town"@en.
juso:Township <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy juso:;
              rdfs:seeAlso <https://en.wikipedia.org/wiki/Township>;
              rdfs:subClassOf juso:AdministrativeDivision;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    The word township is used to refer to different kinds of settlements in
    different countries.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Township"@en,
                                                              "면"@ko.
juso:Village <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy juso:;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Village>;
             rdfs:subClassOf juso:AdministrativeDivision;
             <http://www.w3.org/2002/07/owl#sameAs> <http://linkedgeodata.org/ontology/Village>,
                                                    <http://dbpedia.org/ontology/Village>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    A village is a clustered human settlement or community, larger than a
    hamlet but smaller than a town, with a population ranging from a few
    hundred to a few thousand.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Village"@en,
                                                             "리"@ko.
juso:address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain juso:SpatialThing;
             rdfs:isDefinedBy juso:;
             rdfs:range juso:Address;
             rdfs:subPropertyOf <http://ontology.eil.utoronto.ca/icontact.owl#address>,
                                <http://www.w3.org/ns/locn#address>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    This property associates anything with its address.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "address"@en.
juso:country <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain juso:Address;
             rdfs:isDefinedBy juso:;
             rdfs:range juso:Country;
             <http://www.w3.org/2002/07/owl#sameAs> <http://ontology.eil.utoronto.ca/icontact.owl#hasCountry>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    The uppermost politial division for the address, almost always a country.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "country"@en.
juso:endonym <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain juso:Feature;
             rdfs:isDefinedBy juso:;
             rdfs:range xsd:string;
             rdfs:seeAlso <https://en.wikipedia.org/wiki/Exonym_and_endonym>;
             rdfs:subPropertyOf <http://www.geonames.org/ontology#officialName>,
                                juso:name,
                                <http://www.w3.org/2004/02/skos/core#prefLabel>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    The endonym is a name given by members of a particular ethnolinguistic
    group to its homeland or a specific place within it.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "endonym"@en.
juso:exonym <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain juso:Feature;
            rdfs:isDefinedBy juso:;
            rdfs:range xsd:string;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Exonym_and_endonym>;
            rdfs:subPropertyOf <http://www.geonames.org/ontology#alternateName>,
                               <http://www.w3.org/2004/02/skos/core#altLabel>,
                               juso:name;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    The exonym is an external name for a geographical place: a common name used
    only outside the place in question, usually for historical reasons.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "exonym"@en.
juso:fifth_level_administrative_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:domain juso:Address;
                                         rdfs:isDefinedBy juso:;
                                         rdfs:range juso:FifthLevelAdministrativeDivision;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
    The fifth-level administrative division of the address, if any.
    """@en;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "fifth-level administrative division"@en.
juso:first_level_administrative_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:domain juso:Address;
                                         rdfs:isDefinedBy juso:;
                                         rdfs:range juso:FirstLevelAdministrativeDivision;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
    The first-level administrative division (region) of the address, usually a
    county, state or other such area that typically encompasses several
    localities.
    """@en;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "first-level administrative division"@en.
juso:fourth_level_administrative_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:domain juso:Address;
                                          rdfs:isDefinedBy juso:;
                                          rdfs:range juso:FourthLevelAdministrativeDivision;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                          <http://www.w3.org/2004/02/skos/core#definition> """
    The fourth-level administrative division of the address, if any.
    """@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "fourth-level administrative division"@en.
juso:full_address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain juso:Address;
                  rdfs:isDefinedBy juso:;
                  rdfs:range xsd:string;
                  <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/ns/locn#fullAddress>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    The complete address written as a string, with or without formatting.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "full address"@en.
juso:geometry <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
              <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain juso:Feature;
              rdfs:isDefinedBy juso:;
              rdfs:range juso:Geometry;
              rdfs:subPropertyOf <http://geovocab.org/geometry#geometry>,
                                 <http://www.w3.org/ns/locn#geometry>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
              <http://www.w3.org/2004/02/skos/core#definition> """
    This property associates any feature with the corresponding geometry.
    """@en;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "geometry"@en.
juso:historical_address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain juso:SpatialThing;
                        rdfs:isDefinedBy juso:;
                        rdfs:range juso:Address;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> """
    This property associates anything with one of its historical address.
    """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "historical address"@en.
juso:locator <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain juso:Address;
             rdfs:isDefinedBy juso:;
             rdfs:range juso:Feature;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
             <http://www.w3.org/2004/02/skos/core#definition> """
    The real world entity identified by the address. The locator could be the
    property or complex, of the building or part of the building, of it could
    be a room inside a building.
    """@en;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "locator"@en.
juso:locator_address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain juso:Address;
                     rdfs:isDefinedBy juso:;
                     rdfs:range xsd:string;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    This property is used to describe a number or a sequence of characters that
    uniquely identifies the exact locator within the relevant scope(s), that is
    described by juso:locator.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "locator address"@en.
juso:name <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:domain juso:SpatialThing;
          rdfs:isDefinedBy juso:;
          rdfs:range xsd:string;
          rdfs:subPropertyOf <http://schema.org/name>,
                             <http://purl.org/dc/terms/title>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
          <http://www.w3.org/2004/02/skos/core#definition> """
    This property indicates the name of the spatial thing.
    """@en;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "이름"@ko,
                                                          "name"@en.
juso:parent <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain juso:Feature;
            rdfs:isDefinedBy juso:;
            rdfs:range juso:PoliticalDivision;
            rdfs:subPropertyOf <http://www.geonames.org/ontology#parentFeature>,
                               juso:political_division;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A politial or administrative division that is a direct parent of the
    current feature.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "parent politial division"@en.
juso:political_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                        <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                        a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                        rdfs:domain juso:Feature;
                        rdfs:isDefinedBy juso:;
                        rdfs:range juso:PoliticalDivision;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                        <http://www.w3.org/2004/02/skos/core#definition> """
    A politial or administrative division that contain the current feature.
    """@en;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "political division"@en.
juso:post_office_box <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                     <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain juso:Address;
                     rdfs:isDefinedBy juso:;
                     rdfs:range xsd:string;
                     <http://www.w3.org/2002/07/owl#sameAs> <http://www.w3.org/ns/locn#poBox>,
                                                            <http://schema.org/postOfficeBoxNumber>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                     <http://www.w3.org/2004/02/skos/core#definition> """
    This property describes the post office box number for PO box addresses.
    A post-office box or post office box (commonly referred to as a PO box or a
    postal box) is a uniquely addressable lockable box located on the premises
    of a post office station.
    """@en;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "post office box"@en.
juso:postal_code <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                 <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain juso:Address;
                 rdfs:isDefinedBy juso:;
                 rdfs:range juso:PostalCode;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                 <http://www.w3.org/2004/02/skos/core#definition> """
    This property associates any address with its postal code.
    """@en;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "postal code"@en.
juso:second_level_administrative_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                          rdfs:domain juso:Address;
                                          rdfs:isDefinedBy juso:;
                                          rdfs:range juso:SecondLevelAdministrativeDivision;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                          <http://www.w3.org/2004/02/skos/core#definition> """
    The second-level administrative division (locality) of the address, usually
    a city.
    """@en;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "second-level administrative division"@en.
juso:third_level_administrative_division <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                                         <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                         rdfs:domain juso:Address;
                                         rdfs:isDefinedBy juso:;
                                         rdfs:range juso:ThirdLevelAdministrativeDivision;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
    The third-level administrative division of the address, if any.
    """@en;
                                         <http://www.w3.org/2004/02/skos/core#prefLabel> "third-level administrative division"@en.
juso:thoroughfare <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                  <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain juso:Address;
                  rdfs:isDefinedBy juso:;
                  rdfs:range juso:Thoroughfare;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                  <http://www.w3.org/2004/02/skos/core#definition> """
    An address component that represents the name of a passage or way through
    from one location to another. A thoroughfare is not necessarily a road, it
    might be a waterway or some other feature.
    """@en;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "thoroughfare"@en.
juso:thoroughfare_address <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
                          <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
                          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain juso:Address;
                          rdfs:isDefinedBy juso:;
                          rdfs:range xsd:string;
                          rdfs:seeAlso <https://en.wikipedia.org/wiki/House_numbering>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable"@en;
                          <http://www.w3.org/2004/02/skos/core#definition> """
    This property is used to describe a unique number given to each building
    (residential or not) or vacant lot with a mailbox in a street or other
    thoroughfares.
    """@en;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "thoroughfare address"@en.
juso:within <http://purl.org/dc/terms/issued> "2015-10-02+09:00"^^xsd:date;
            <http://purl.org/dc/terms/modified> "2015-10-02+09:00"^^xsd:date;
            a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
            rdfs:domain juso:SpatialThing;
            rdfs:isDefinedBy juso:;
            rdfs:range juso:SpatialThing;
            rdfs:subPropertyOf <http://www.w3.org/ns/locn#location>,
                               <http://www.w3.org/2003/01/geo/wgs84_pos#location>;
            <http://www.w3.org/2002/07/owl#inverseOf> <http://www.opengis.net/ont/geosparql#sfContains>,
                                                      <http://geovocab.org/spatial#Pi>;
            <http://www.w3.org/2002/07/owl#sameAs> <http://www.opengis.net/ont/geosparql#sfWithin>,
                                                   <http://geovocab.org/spatial#P>;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing"@en;
            <http://www.w3.org/2004/02/skos/core#definition> """
    A spatial thing that contains the current one within the borders of its own
    region.
    """@en;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "within"@en.
<http://schema.org/GeoCoordinates> rdfs:subClassOf juso:Geometry.
<http://schema.org/GeoShape> rdfs:subClassOf juso:Geometry.
<http://schema.org/Place> rdfs:subClassOf juso:SpatialThing.
<http://schema.org/PostalAddress> rdfs:subClassOf juso:Address.
<http://schema.org/address> rdfs:subPropertyOf juso:address.
<http://schema.org/containedIn> rdfs:subPropertyOf juso:within.
<http://schema.org/geo> rdfs:subPropertyOf juso:geometry.
<http://schema.org/postalCode> <http://www.w3.org/2002/07/owl#propertyChainAxiom> (juso:postal_code
                                                                                   rdf:value).
<http://www.opengis.net/ont/geosparql#hasGeometry> rdfs:subPropertyOf juso:geometry.
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> rdfs:subClassOf juso:Geometry.
<http://www.w3.org/2006/vcard/ns#Address> rdfs:subClassOf juso:Address.
<http://www.w3.org/2006/vcard/ns#postal-code> <http://www.w3.org/2002/07/owl#propertyChainAxiom> (juso:postal_code
                                                                                                  rdf:value).
<http://www.w3.org/ns/locn#postCode> <http://www.w3.org/2002/07/owl#propertyChainAxiom> (juso:postal_code
                                                                                         rdf:value).
