                  <http://xmlns.com/foaf/0.1/name> "James G. Kim"@en,
                                                   "김보람"@ko.
<http://linkedgeodata.org/ontology/Place> rdfs:subClassOf juso:SpatialThing.
<http://listinc.kr/id/listinc> a <http://xmlns.com/foaf/0.1/Organization>,
                                 <http://www.w3.org/ns/org#Organization>;
                               <http://xmlns.com/foaf/0.1/homepage> <http://li-st.com/>,
