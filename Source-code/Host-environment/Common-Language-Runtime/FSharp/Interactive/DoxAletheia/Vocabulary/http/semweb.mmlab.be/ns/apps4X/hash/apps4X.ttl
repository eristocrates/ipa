@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix apps4X: <http://semweb.mmlab.be/ns/apps4X#>.

<http://semweb.mmlab.be/ns/apps4X> <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Pieter Colpaert" ; 
                                                                       <http://xmlns.com/foaf/0.1/mbox> "Pieter.Colpaert@UGent.be"],
                                                                      [<http://xmlns.com/foaf/0.1/name> "Ghislain Atemezing"],
                                                                      [<http://xmlns.com/foaf/0.1/name> "Anastasia Dimou" ; 
                                                                       <http://xmlns.com/foaf/0.1/mbox> "Anastasia.Dimou@UGent.be"];
                                   <http://purl.org/dc/terms/description> "apps4X is an RDF vocabulary defined to facilitate the description of Open-Data-based Co-creation events."@en;
                                   <http://purl.org/dc/terms/issued> "2013-05-10"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2014-06-16"^^xsd:date;
                                   <http://purl.org/dc/terms/title> "The vocabulary for Co-creation Events based on Open Data"@en;
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment "apps4X is an RDF vocabulary defined to facilitate the description of Open-Data-based Co-creation events."@en.
apps4X:Award a <http://www.w3.org/2002/07/owl#Class>,
               rdfs:Class;
             rdfs:comment "the award offered by the jury to a certain App Concept"@en;
             rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
             rdfs:label "Award"@en.
apps4X:CocreationEvent a <http://www.w3.org/2002/07/owl#Class>,
                         rdfs:Class;
                       rdfs:comment "A co-creation event is a competition, a contest, a challenge etc. It's a subproperty as it is an event but with a certain scope"@en;
                       rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                       rdfs:label "Co-creation event"@en;
                       rdfs:subClassOf <http://schema.org/Event>,
                                       <http://linkedevents.org/ontology/Event>.
apps4X:Jury a <http://www.w3.org/2002/07/owl#Class>,
              rdfs:Class;
            rdfs:comment "A jury evaluating the submissions to a co-creation event."@en;
            rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
            rdfs:label "Jury"@en.
apps4X:Submission a <http://www.w3.org/2002/07/owl#Class>,
                    rdfs:Class;
                  rdfs:comment "An App Concept idea as it was submitted to a certain competition."@en;
                  rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                  rdfs:label "Submission"@en.
apps4X:award a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:comment "one or more awards offered at this co-creation event"@en;
             rdfs:domain apps4X:Jury,
                         apps4X:CocreationEvent;
             rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
             rdfs:label "award offered"@en;
             rdfs:range apps4X:Award.
apps4X:awardCeremony a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       rdf:Property;
                     rdfs:comment "The award ceremony"@en;
                     rdfs:domain apps4X:Award;
                     rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                     rdfs:label "award's ceremnoy"@en;
                     rdfs:range <http://schema.org/Event>,
                                <http://linkedevents.org/ontology/Event>.
apps4X:consistsOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    rdf:Property;
                  rdfs:comment "A submission consists of "@en;
                  rdfs:domain apps4X:Submission;
                  rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                  rdfs:label "consists of"@en;
                  rdfs:range <http://semweb.mmlab.be/ns/odapps#Application>,
                             <http://semweb.mmlab.be/ns/odapps#AppConcept>.
apps4X:edition a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 rdf:Datatype;
               rdfs:comment "The event edition. "@en;
               rdfs:domain apps4X:CocreationEvent;
               rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
               rdfs:label "edition"@en;
               rdfs:range xsd:int.
apps4X:juryMember a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    rdf:Property;
                  rdfs:comment "A jury consists of "@en;
                  rdfs:domain apps4X:Jury;
                  rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                  rdfs:label "Jury Member"@en;
                  rdfs:range <http://xmlns.com/foaf/0.1/Agent>.
apps4X:juryRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property;
                rdfs:comment "The rate given by the jury"@en;
                rdfs:domain apps4X:Submission;
                rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                rdfs:label "Jury's rate"@en;
                rdfs:range xsd:float.
apps4X:nominated a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                   rdf:Property;
                 rdfs:comment "An App Concept is nominated for the award."@en;
                 rdfs:domain apps4X:Submission;
                 rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                 rdfs:label "nominated for"@en;
                 rdfs:range apps4X:Award.
apps4X:organizer a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                   rdfs:Property;
                 rdfs:comment "the event's organizer"@en;
                 rdfs:domain apps4X:CocreationEvent;
                 rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                 rdfs:label "organizer"@en;
                 rdfs:range <http://xmlns.com/foaf/0.1/Agent>.
apps4X:prize a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
               rdf:Property;
             rdfs:comment "The actual prize offered."@en;
             rdfs:domain apps4X:Award;
             rdfs:label "prize"@en;
             rdfs:range xsd:string.
apps4X:registration a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                      rdf:Propert;
                    rdfs:comment "a link to the registration for the event"@en;
                    rdfs:domain apps4X:CocreationEvent;
                    rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                    rdfs:label "url to the registration"@en;
                    rdfs:range xsd:anyURI;
                    rdfs:subPropertyOf <http://schema.org/url>.
apps4X:shortTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    rdf:Property;
                  rdfs:comment "the event's short title and/or its abbreviation"@en;
                  rdfs:domain apps4X:CocreationEvent;
                  rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                  rdfs:label "short title"@en;
                  rdfs:range xsd:string.
apps4X:size a <http://www.w3.org/2002/07/owl#ObjectProperty>,
              rdf:Property;
            rdfs:comment "The event's size in regard to its thematic area and/or locality. "@en;
            rdfs:domain apps4X:CocreationEvent;
            rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
            rdfs:label "the size of the event"@en.
apps4X:sponsor a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 rdfs:Property;
               rdfs:comment " the event's sponsor "@en;
               rdfs:domain apps4X:CocreationEvent;
               rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
               rdfs:label "sponsor"@en;
               rdfs:range <http://xmlns.com/foaf/0.1/Agent>.
apps4X:theme a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:comment "The App Concept can be within a certain theme."@en;
             rdfs:domain <http://semweb.mmlab.be/ns/odapps#Application>,
                         <http://semweb.mmlab.be/ns/odapps#AppConcept>,
                         apps4X:CocreationEvent;
             rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
             rdfs:label "theme"@en;
             rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
apps4X:usersRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                   rdf:Property;
                 rdfs:comment "The rate given by the users"@en;
                 rdfs:domain apps4X:Submission;
                 rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                 rdfs:label "Users' rate"@en;
                 rdfs:range xsd:float.
apps4X:wonAward a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  rdf:Property;
                rdfs:comment "links to the award that this App Concept won"@en;
                rdfs:domain apps4X:Submission;
                rdfs:isDefinedBy <http://semweb.mmlab.be/ns/apps4X>;
                rdfs:label "won award"@en;
                rdfs:range apps4X:Award.
