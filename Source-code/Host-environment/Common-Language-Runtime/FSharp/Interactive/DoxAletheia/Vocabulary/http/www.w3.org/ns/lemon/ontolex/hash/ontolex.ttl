                                    "lexikaal zin"@nl;
                         rdfs:range ontolex:LexicalSense;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ontolex:morphologicalPattern a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "The 'morphological pattern' property indicates the morphological class of a word."@en,
                                          "Свойство 'морфологическая модель' обозначает морфологический класс слова."@ru;
                             rdfs:domain ontolex:LexicalEntry;
                             rdfs:isDefinedBy <http://www.w3.org/ns/lemon/ontolex>;
