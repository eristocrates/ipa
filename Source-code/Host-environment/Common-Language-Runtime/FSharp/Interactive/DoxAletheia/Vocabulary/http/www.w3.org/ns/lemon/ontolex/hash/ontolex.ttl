                               "reprezentare fonetică"@ro,
                               "phonetic representation"@en,
                               "фонетическое представление"@ru,
                               "fonetiese voorstelling"@af,
                               "representación fonética"@es,
                               "rappresentazione fonetica"@it,
                               "fonetische voorstelling"@nl;
                    rdfs:range rdf:langString;
                    rdfs:subPropertyOf ontolex:representation;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ontolex:reference a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:comment "Свойство 'референция' соотносит лексический смысл с предикатом в онтологии, который уточняет значение денотата (соответствующей словарной единицы)."@ru,
                               "The 'reference' property relates a lexical sense to an ontological predicate that represents the denotation of the corresponding lexical entry. "@en;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (ontolex:LexicalSense
                                                                        <http://www.w3.org/ns/lemon/synsem#OntoMap>) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy <http://www.w3.org/ns/lemon/ontolex>;
                  rdfs:label "referință"@ro,
