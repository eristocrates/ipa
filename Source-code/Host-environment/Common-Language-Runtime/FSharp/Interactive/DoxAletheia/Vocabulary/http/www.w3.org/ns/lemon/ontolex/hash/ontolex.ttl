                         "употребление"@ru;
              rdfs:range rdfs:Resource;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ontolex:writtenRep a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Свойство 'письменное представление' обозначает письменное представление формы."@ru,
