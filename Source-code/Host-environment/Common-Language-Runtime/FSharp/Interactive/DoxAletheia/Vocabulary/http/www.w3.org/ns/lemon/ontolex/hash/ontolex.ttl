                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ontolex:representation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "The 'representation' property indicates a string by which the form is represented according to some orthography. "@en,
                                    "Свойство 'представление' обозначает некую последовательность, с помощью которой форма может быть представлена средствами орфографии."@ru;
                       rdfs:domain ontolex:Form;
                       rdfs:isDefinedBy <http://www.w3.org/ns/lemon/ontolex>;
                       rdfs:label "représentation"@fr,
