@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix aksw: <http://aksw.org/>.
@prefix mexperf: <http://mex.aksw.org/mex-perf#>.
@prefix doap: <http://usefulinc.com/ns/doap#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://mex.aksw.org/mex-perf> dc11:publisher "AKSW Grupo de Pesquisa - Universidade de Leipzig"@pt,
                                              "AKSW Research Group - Leipzig University"@en;
                               dcterms:contributor aksw:JensLehmann.html,
                                                   aksw:DiegoMoussallem.html;
                               dcterms:created "2014-02-02"^^xsd:date;
                               dcterms:creator aksw:DiegoEsteves.html;
                               dcterms:modified "2016-05-01"^^xsd:date;
                               dcterms:title "MEX Performance (mex-perf) is an ontology with the goal of describing performance values for machine learning problems (MEX Platform)"@en;
                               rdf:about "http://mex.aksw.org/mex-doc-perf#";
                               a owl:Ontology;
                               rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-perf layer is the 3rd level of the MEX for representing the machine learning algorithm's performances."@en,
                                            "MEX e um vocabulario modelado para facilitar a interoperabilidade entre resultados de experimentos de aprendizado de maquinas publicados na Web. A camada mex-perf e o 3o. nivel na abordagem MEX para representar performances de algoritmos de aprendizado de maquinas"@pt;
                               rdfs:label "The MEX Vocabulary (mex-perf)"@en,
                                          "Vocabulario MEX (mex-perf)"@pt;
                               owl:imports <http://www.w3.org/ns/prov-o#>,
                                           rdfs:,
                                           doap:;
                               owl:versionInfo "1.0.2".
mexperf:ClassificationMeasure a owl:Class;
                              rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:ClusteringMeasure a owl:Class;
                          rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:ExamplePerformanceMeasure a owl:Class;
                                  rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity>.
mexperf:ExamplePerformanceMeasureCollection a owl:Class;
                                            rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection>.
mexperf:ExecutionPerformance a owl:Class;
                             rdfs:subClassOf <http://www.w3.org/ns/prov-o#Activity>.
mexperf:L1norm a owl:DatatypeProperty;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:L2norm a owl:DatatypeProperty;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:Linfnorm a owl:DatatypeProperty;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:PerformanceMeasure a owl:Class;
                           rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity>.
mexperf:RegressionMeasure a owl:Class;
                          rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:StatisticalMeasure a owl:Class;
                           rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:UserDefinedMeasure a owl:Class;
                           rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:UserDefinedMeasureCollection a owl:Class;
                                     rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection>.
mexperf:accuracy a owl:DatatypeProperty;
                 rdfs:domain mexperf:ClassificationMeasure;
                 rdfs:range xsd:double.
mexperf:bonferroniDunn a owl:DatatypeProperty;
                       rdfs:domain mexperf:StatisticalMeasure;
                       rdfs:range xsd:double.
mexperf:chebyschevDistance a owl:DatatypeProperty;
                           rdfs:domain mexperf:ClusteringMeasure;
                           rdfs:range xsd:double.
mexperf:chiSquare a owl:DatatypeProperty;
                  rdfs:domain mexperf:StatisticalMeasure;
                  rdfs:range xsd:double.
mexperf:correlationCoefficient a owl:DatatypeProperty;
                               rdfs:domain mexperf:RegressionMeasure;
                               rdfs:range xsd:double.
mexperf:cosine a owl:DatatypeProperty;
               rdfs:domain mexperf:ClusteringMeasure;
               rdfs:range xsd:double.
mexperf:costParameter a owl:DatatypeProperty.
mexperf:error a owl:DatatypeProperty;
              rdfs:domain mexperf:StatisticalMeasure,
                          mexperf:RegressionMeasure,
                          mexperf:ClusteringMeasure,
                          mexperf:ClassificationMeasure;
              rdfs:range xsd:double.
mexperf:euclideanDistance a owl:DatatypeProperty;
                          rdfs:domain mexperf:ClusteringMeasure;
                          rdfs:range xsd:double.
mexperf:f1Measure dc11:description "F-measure or F-score or F1 score";
                  a owl:DatatypeProperty;
                  rdfs:domain mexperf:ClassificationMeasure;
                  rdfs:range xsd:double.
mexperf:falseNegative a owl:DatatypeProperty;
                      rdfs:domain mexperf:ClassificationMeasure;
                      rdfs:range xsd:integer.
mexperf:falseNegativeRate a owl:DatatypeProperty;
                          rdfs:domain mexperf:ClassificationMeasure;
                          rdfs:range xsd:double.
mexperf:falsePositive a owl:DatatypeProperty;
                      rdfs:domain mexperf:ClassificationMeasure;
                      rdfs:range xsd:integer.
mexperf:falsePositiveRate a owl:DatatypeProperty;
                          rdfs:domain mexperf:ClassificationMeasure;
                          rdfs:range xsd:double.
mexperf:folds a owl:DatatypeProperty;
              rdfs:range xsd:int.
mexperf:formula a owl:DatatypeProperty;
                rdfs:domain mexperf:UserDefinedMeasure;
                rdfs:range xsd:string.
mexperf:friedman a owl:DatatypeProperty;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:genSimilarityCoefficient a owl:DatatypeProperty;
                                 rdfs:domain mexperf:ClusteringMeasure;
                                 rdfs:range xsd:double.
mexperf:hammingDistance a owl:DatatypeProperty;
                        rdfs:domain mexperf:ClusteringMeasure;
                        rdfs:range xsd:double.
mexperf:kappaStatistics a owl:DatatypeProperty;
                        rdfs:domain mexperf:StatisticalMeasure;
                        rdfs:range xsd:double.
mexperf:kernel a owl:DatatypeProperty;
               rdfs:range xsd:string.
mexperf:kolmogorovSmirnov a owl:DatatypeProperty;
                          rdfs:domain mexperf:StatisticalMeasure;
                          rdfs:range xsd:double.
mexperf:manhattanDistance a owl:DatatypeProperty;
                          rdfs:domain mexperf:ClusteringMeasure;
                          rdfs:range xsd:double.
mexperf:mean a owl:DatatypeProperty;
             rdfs:domain mexperf:StatisticalMeasure;
             rdfs:range xsd:double.
mexperf:meanAbsoluteDeviation a owl:DatatypeProperty;
                              rdfs:domain mexperf:RegressionMeasure;
                              rdfs:range xsd:double.
mexperf:meanSquaredError a owl:DatatypeProperty;
                         rdfs:domain mexperf:RegressionMeasure;
                         rdfs:range xsd:double.
mexperf:median a owl:DatatypeProperty;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:medianAbsoluteDeviation a owl:DatatypeProperty;
                                rdfs:domain mexperf:RegressionMeasure;
                                rdfs:range xsd:double.
mexperf:mode a owl:DatatypeProperty;
             rdfs:domain mexperf:StatisticalMeasure;
             rdfs:range xsd:double.
mexperf:nemenyi a owl:DatatypeProperty;
                rdfs:domain mexperf:StatisticalMeasure;
                rdfs:range xsd:double.
mexperf:pearsonCorrelation a owl:DatatypeProperty;
                           rdfs:domain mexperf:StatisticalMeasure;
                           rdfs:range xsd:double.
mexperf:pmi a owl:DatatypeProperty;
            rdfs:domain mexperf:StatisticalMeasure;
            rdfs:label "Pointwise mutual information"@en;
            rdfs:range xsd:double.
mexperf:precision a owl:DatatypeProperty;
                  rdfs:domain mexperf:ClassificationMeasure;
                  rdfs:range xsd:double.
mexperf:predictedValue a owl:DatatypeProperty;
                       rdfs:domain mexperf:ExamplePerformanceMeasure;
                       rdfs:range xsd:string.
mexperf:realValue a owl:DatatypeProperty;
                  rdfs:domain mexperf:ExamplePerformanceMeasure;
                  rdfs:range xsd:string.
mexperf:recall a owl:DatatypeProperty;
               rdfs:domain mexperf:ClassificationMeasure;
               rdfs:range xsd:double.
mexperf:relativeAbsoluteError a owl:DatatypeProperty;
                              rdfs:domain mexperf:RegressionMeasure;
                              rdfs:range xsd:double.
mexperf:residual a owl:DatatypeProperty;
                 rdfs:domain mexperf:RegressionMeasure;
                 rdfs:range xsd:double.
mexperf:roc a owl:DatatypeProperty;
            rdfs:domain mexperf:ClassificationMeasure;
            rdfs:range xsd:double.
mexperf:rootMeanSquaredError a owl:DatatypeProperty;
                             rdfs:domain mexperf:RegressionMeasure;
                             rdfs:range xsd:double.
mexperf:rootRelativeSquaredError a owl:DatatypeProperty;
                                 rdfs:domain mexperf:RegressionMeasure;
                                 rdfs:range xsd:double.
mexperf:sensitivity a owl:DatatypeProperty;
                    rdfs:domain mexperf:ClassificationMeasure;
                    rdfs:range xsd:double.
mexperf:specificity a owl:DatatypeProperty;
                    rdfs:domain mexperf:ClassificationMeasure;
                    rdfs:range xsd:double.
mexperf:spmi a owl:DatatypeProperty;
             rdfs:domain mexperf:StatisticalMeasure.
mexperf:standardDeviation a owl:DatatypeProperty;
                          rdfs:domain mexperf:StatisticalMeasure;
                          rdfs:range xsd:double.
mexperf:totalError a owl:DatatypeProperty;
                   rdfs:domain mexperf:RegressionMeasure;
                   rdfs:range xsd:double.
mexperf:trueNegative a owl:DatatypeProperty;
                     rdfs:domain mexperf:ClassificationMeasure;
                     rdfs:range xsd:integer.
mexperf:trueNegativeRate a owl:DatatypeProperty;
                         rdfs:domain mexperf:ClassificationMeasure;
                         rdfs:range xsd:double.
mexperf:truePositive a owl:DatatypeProperty;
                     rdfs:domain mexperf:ClassificationMeasure;
                     rdfs:range xsd:integer.
mexperf:truePositiveRate a owl:DatatypeProperty;
                         rdfs:domain mexperf:ClassificationMeasure;
                         rdfs:range xsd:double.
mexperf:variance a owl:DatatypeProperty;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:wilcoxon a owl:DatatypeProperty;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
<http://www.w3.org/ns/prov-o#Activity> a owl:Class.
<http://www.w3.org/ns/prov-o#Collection> a owl:Class.
<http://www.w3.org/ns/prov-o#Entity> a owl:Class.
