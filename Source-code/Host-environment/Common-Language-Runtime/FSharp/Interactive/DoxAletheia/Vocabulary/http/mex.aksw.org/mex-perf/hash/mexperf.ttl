@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix mexperf: <http://mex.aksw.org/mex-perf#>.

<http://mex.aksw.org/mex-perf> <http://purl.org/dc/elements/1.1/publisher> "AKSW Grupo de Pesquisa - Universidade de Leipzig"@pt,
                                                                           "AKSW Research Group - Leipzig University"@en;
                               <http://purl.org/dc/terms/contributor> <http://aksw.org/JensLehmann.html>,
                                                                      <http://aksw.org/DiegoMoussallem.html>;
                               <http://purl.org/dc/terms/created> "2014-02-02"^^xsd:date;
                               <http://purl.org/dc/terms/creator> <http://aksw.org/DiegoEsteves.html>;
                               <http://purl.org/dc/terms/modified> "2016-05-01"^^xsd:date;
                               <http://purl.org/dc/terms/title> "MEX Performance (mex-perf) is an ontology with the goal of describing performance values for machine learning problems (MEX Platform)"@en;
                               rdf:about "http://mex.aksw.org/mex-doc-perf#";
                               a <http://www.w3.org/2002/07/owl#Ontology>;
                               rdfs:comment "MEX is an RDF vocabulary designed to facilitate interoperability between published machine learning experiments results on the Web. The mex-perf layer is the 3rd level of the MEX for representing the machine learning algorithm's performances."@en,
                                            "MEX e um vocabulario modelado para facilitar a interoperabilidade entre resultados de experimentos de aprendizado de maquinas publicados na Web. A camada mex-perf e o 3o. nivel na abordagem MEX para representar performances de algoritmos de aprendizado de maquinas"@pt;
                               rdfs:label "The MEX Vocabulary (mex-perf)"@en,
                                          "Vocabulario MEX (mex-perf)"@pt;
                               <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/prov-o#>,
                                                                       rdfs:,
                                                                       <http://usefulinc.com/ns/doap#>;
                               <http://www.w3.org/2002/07/owl#versionInfo> "1.0.2".
mexperf:ClassificationMeasure a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:ClusteringMeasure a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:ExamplePerformanceMeasure a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity>.
mexperf:ExamplePerformanceMeasureCollection a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection>.
mexperf:ExecutionPerformance a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:subClassOf <http://www.w3.org/ns/prov-o#Activity>.
mexperf:L1norm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:L2norm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:Linfnorm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:PerformanceMeasure a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf <http://www.w3.org/ns/prov-o#Entity>.
mexperf:RegressionMeasure a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:StatisticalMeasure a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:UserDefinedMeasure a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:subClassOf mexperf:PerformanceMeasure.
mexperf:UserDefinedMeasureCollection a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:subClassOf <http://www.w3.org/ns/prov-o#Collection>.
mexperf:accuracy a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:ClassificationMeasure;
                 rdfs:range xsd:double.
mexperf:bonferroniDunn a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain mexperf:StatisticalMeasure;
                       rdfs:range xsd:double.
mexperf:chebyschevDistance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain mexperf:ClusteringMeasure;
                           rdfs:range xsd:double.
mexperf:chiSquare a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain mexperf:StatisticalMeasure;
                  rdfs:range xsd:double.
mexperf:correlationCoefficient a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                               rdfs:domain mexperf:RegressionMeasure;
                               rdfs:range xsd:double.
mexperf:cosine a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain mexperf:ClusteringMeasure;
               rdfs:range xsd:double.
mexperf:costParameter a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
mexperf:error a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain mexperf:StatisticalMeasure,
                          mexperf:RegressionMeasure,
                          mexperf:ClusteringMeasure,
                          mexperf:ClassificationMeasure;
              rdfs:range xsd:double.
mexperf:euclideanDistance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:ClusteringMeasure;
                          rdfs:range xsd:double.
mexperf:f1Measure <http://purl.org/dc/elements/1.1/description> "F-measure or F-score or F1 score";
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain mexperf:ClassificationMeasure;
                  rdfs:range xsd:double.
mexperf:falseNegative a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain mexperf:ClassificationMeasure;
                      rdfs:range xsd:integer.
mexperf:falseNegativeRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:ClassificationMeasure;
                          rdfs:range xsd:double.
mexperf:falsePositive a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain mexperf:ClassificationMeasure;
                      rdfs:range xsd:integer.
mexperf:falsePositiveRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:ClassificationMeasure;
                          rdfs:range xsd:double.
mexperf:folds a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:range xsd:int.
mexperf:formula a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain mexperf:UserDefinedMeasure;
                rdfs:range xsd:string.
mexperf:friedman a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:genSimilarityCoefficient a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain mexperf:ClusteringMeasure;
                                 rdfs:range xsd:double.
mexperf:hammingDistance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain mexperf:ClusteringMeasure;
                        rdfs:range xsd:double.
mexperf:kappaStatistics a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain mexperf:StatisticalMeasure;
                        rdfs:range xsd:double.
mexperf:kernel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:range xsd:string.
mexperf:kolmogorovSmirnov a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:StatisticalMeasure;
                          rdfs:range xsd:double.
mexperf:manhattanDistance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:ClusteringMeasure;
                          rdfs:range xsd:double.
mexperf:mean a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain mexperf:StatisticalMeasure;
             rdfs:range xsd:double.
mexperf:meanAbsoluteDeviation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain mexperf:RegressionMeasure;
                              rdfs:range xsd:double.
mexperf:meanSquaredError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain mexperf:RegressionMeasure;
                         rdfs:range xsd:double.
mexperf:median a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain mexperf:StatisticalMeasure;
               rdfs:range xsd:double.
mexperf:medianAbsoluteDeviation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                rdfs:domain mexperf:RegressionMeasure;
                                rdfs:range xsd:double.
mexperf:mode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain mexperf:StatisticalMeasure;
             rdfs:range xsd:double.
mexperf:nemenyi a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain mexperf:StatisticalMeasure;
                rdfs:range xsd:double.
mexperf:pearsonCorrelation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain mexperf:StatisticalMeasure;
                           rdfs:range xsd:double.
mexperf:pmi a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain mexperf:StatisticalMeasure;
            rdfs:label "Pointwise mutual information"@en;
            rdfs:range xsd:double.
mexperf:precision a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain mexperf:ClassificationMeasure;
                  rdfs:range xsd:double.
mexperf:predictedValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain mexperf:ExamplePerformanceMeasure;
                       rdfs:range xsd:string.
mexperf:realValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain mexperf:ExamplePerformanceMeasure;
                  rdfs:range xsd:string.
mexperf:recall a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain mexperf:ClassificationMeasure;
               rdfs:range xsd:double.
mexperf:relativeAbsoluteError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:domain mexperf:RegressionMeasure;
                              rdfs:range xsd:double.
mexperf:residual a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:RegressionMeasure;
                 rdfs:range xsd:double.
mexperf:roc a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain mexperf:ClassificationMeasure;
            rdfs:range xsd:double.
mexperf:rootMeanSquaredError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain mexperf:RegressionMeasure;
                             rdfs:range xsd:double.
mexperf:rootRelativeSquaredError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain mexperf:RegressionMeasure;
                                 rdfs:range xsd:double.
mexperf:sensitivity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain mexperf:ClassificationMeasure;
                    rdfs:range xsd:double.
mexperf:specificity a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:domain mexperf:ClassificationMeasure;
                    rdfs:range xsd:double.
mexperf:spmi a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain mexperf:StatisticalMeasure.
mexperf:standardDeviation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain mexperf:StatisticalMeasure;
                          rdfs:range xsd:double.
mexperf:totalError a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:domain mexperf:RegressionMeasure;
                   rdfs:range xsd:double.
mexperf:trueNegative a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain mexperf:ClassificationMeasure;
                     rdfs:range xsd:integer.
mexperf:trueNegativeRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain mexperf:ClassificationMeasure;
                         rdfs:range xsd:double.
mexperf:truePositive a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain mexperf:ClassificationMeasure;
                     rdfs:range xsd:integer.
mexperf:truePositiveRate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:domain mexperf:ClassificationMeasure;
                         rdfs:range xsd:double.
mexperf:variance a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
mexperf:wilcoxon a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:domain mexperf:StatisticalMeasure;
                 rdfs:range xsd:double.
<http://www.w3.org/ns/prov-o#Activity> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov-o#Collection> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/ns/prov-o#Entity> a <http://www.w3.org/2002/07/owl#Class>.
