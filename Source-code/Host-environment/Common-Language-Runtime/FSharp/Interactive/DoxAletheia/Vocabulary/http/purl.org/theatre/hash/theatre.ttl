@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix theatre: <http://purl.org/theatre#>.

theatre: <http://purl.org/dc/elements/1.1/creator> <http://lukeblaney.co.uk/#me>;
         a <http://www.w3.org/2002/07/owl#Ontology>;
         rdfs:comment "A vocabulary for theatrical data.  It defines concepts such as shows, productions, seasons etc.";
         <http://www.w3.org/2002/07/owl#priorVersion> <http://bedlamtheatre.co.uk/schema#>.
theatre:AccessibilityProvision a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "A Provision which makes an ev:Event more accessible";
                               rdfs:label "AccessibilityProvision".
theatre:Meeting a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An event which involves discussion/planning, often with a formal tone.";
                rdfs:label "Meeting";
                rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>.
theatre:PerformableProject a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A Project which intends to evoke a response from an Audience.";
                           rdfs:label "PerformableProject";
                           rdfs:subClassOf <http://xmlns.com/foaf/0.1/Project>;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:Portrayal a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A Position which involes portraying a Character.";
                  rdfs:label "Portrayal";
                  rdfs:subClassOf theatre:Position.
theatre:Position a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A set of responibilities.";
                 rdfs:label "Position".
theatre:PressNight a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A performance which reviewers are encouraged to attend.";
                   rdfs:label "PressNight";
                   rdfs:subClassOf <http://purl.org/ontology/mo/Performance>.
theatre:Production a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The realisation of a theatrical work.";
                   rdfs:label "Production";
                   rdfs:subClassOf <http://purl.org/vocab/frbr/core#Expression>.
theatre:ProductionCompany a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "An Organisation which puts on Productions.";
                          rdfs:label "ProductionCompany";
                          rdfs:subClassOf <http://xmlns.com/foaf/0.1/Organization>.
theatre:Rehearsal a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An event which involves preparatory work for a Performance.";
                  rdfs:label "Rehearsal";
                  rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>.
theatre:RehearsalReading a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An unpolished performance in which the cast read from scripts.";
                         rdfs:label "RehearsalReading";
                         rdfs:subClassOf <http://purl.org/ontology/mo/Performance>.
theatre:Rehersal a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An event which involves preparatory work for a Performance.";
                 rdfs:label "Rehersal";
                 rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:RehersalReading a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An unpolished performance in which the cast read from scripts.";
                        rdfs:label "RehersalReading";
                        rdfs:subClassOf <http://purl.org/ontology/mo/Performance>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:Season a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "A collection of Productions and/or Performances";
               rdfs:label "Season".
theatre:Show a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The writing/devising which may enable a Production.";
             rdfs:label "Show";
             rdfs:subClassOf <http://purl.org/vocab/frbr/core#Work>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:Venue a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Nestable Spatial Thing used for Theatrical Events.";
              rdfs:label "Venue";
              rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>.
theatre:Voice a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The voice classification for a Singer or singing part.";
              rdfs:label "Voice";
              rdfs:subClassOf <http://purl.org/ontology/mo/Instrument>.
theatre:Workshop a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An event which involves participation, mainly with an educational focus.";
                 rdfs:label "Workshop";
                 rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event>.
theatre:accessibility_provision a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Associates an Accessibility Provision with an Event";
                                rdfs:domain <http://purl.org/NET/c4dm/event.owl#Event>;
                                rdfs:label "accessibility_provision";
                                rdfs:range theatre:AccessibilityProvision.
theatre:agent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Associates a Role with an Agent.";
              rdfs:domain <http://purl.org/vocab/participation/schema#Role>;
              rdfs:label "agent";
              rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
              <http://www.w3.org/2002/07/owl#sameAs> <http://purl.org/vocab/participation/schema#holder>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:audience_restriction a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "A restriction on who can attend a particular performance";
                             rdfs:domain theatre:Performance;
                             rdfs:label "audience_restriction";
                             rdfs:range xsd:string.
theatre:based_on a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Indicates a Work that another Work was based on .";
                 rdfs:domain <http://purl.org/vocab/frbr/core#Work>;
                 rdfs:label "based_on";
                 rdfs:range <http://purl.org/vocab/frbr/core#Work>.
theatre:credit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Associates a Project with a Role.";
               rdfs:label "credit";
               rdfs:range <http://purl.org/vocab/participation/schema#Role>;
               <http://www.w3.org/2002/07/owl#inverseOf> theatre:project;
               <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:domain]
                                                        [a rdfs:domain]
                                                        [a rdfs:domain]
                                                        [a rdfs:domain]);
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
theatre:event a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Associates a Project with an Event.";
              rdfs:domain <http://xmlns.com/foaf/0.1/Project>;
              rdfs:label "event";
              rdfs:range <http://purl.org/NET/c4dm/event.owl#Event>.
theatre:genre a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Associates a Genre with a Work.";
              rdfs:domain <http://purl.org/vocab/frbr/core#Work>;
              rdfs:label "genre";
              rdfs:range <http://purl.org/ontology/mo/Genre>.
theatre:manifestation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Associates a Performableproject with a Production.";
                      rdfs:domain theatre:Performableproject;
                      rdfs:label "manifestation";
                      rdfs:range theatre:Production;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:parent_season a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Associates a season with its commissioning season.";
                      rdfs:domain theatre:Season;
                      rdfs:label "parent_season";
                      rdfs:range theatre:Season;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:parent_venue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Associates a Venue with its containing Venue.";
                     rdfs:domain theatre:Venue;
                     rdfs:label "parent_venue";
                     rdfs:range theatre:Venue.
theatre:part_of_season a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                       rdfs:comment "Indicates that something is part of a season";
                       rdfs:label "part_of_season";
                       rdfs:range theatre:Season;
                       <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:domain]
                                                                [a rdfs:domain]
                                                                [a rdfs:domain]).
theatre:performance a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Associates a Production with a Performance.";
                    rdfs:domain theatre:Production;
                    rdfs:label "performance";
                    rdfs:range theatre:Performance;
                    rdfs:subPropertyOf theatre:event;
                    <http://www.w3.org/2002/07/owl#inverseOf> theatre:performance_of.
theatre:performance_of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Associates a Production with a Performance.";
                       rdfs:domain theatre:Performance;
                       rdfs:label "performance_of";
                       rdfs:range theatre:Production;
                       <http://www.w3.org/2002/07/owl#inverseOf> theatre:performance.
theatre:portrays a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Associates a Portrayal with a Character.";
                 rdfs:domain theatre:Portrayal;
                 rdfs:label "portrays";
                 rdfs:range <http://purl.org/ontomedia/ext/common/being#Character>.
theatre:position a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Associates a Role with a Position.";
                 rdfs:domain <http://purl.org/vocab/participation/schema#Role>;
                 rdfs:label "position";
                 rdfs:range theatre:Position.
theatre:premiere a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Indicates the first performance of a Show or Production in a particular area.";
                 rdfs:label "premiere";
                 rdfs:range <http://purl.org/ontology/mo/Performance>;
                 <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:domain]);
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
theatre:primary_season a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Associates a production with its commissioning season.";
                       rdfs:domain theatre:Production;
                       rdfs:label "primary_season";
                       rdfs:range theatre:Season;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:production a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Associates a Season with a Production.";
                   rdfs:domain theatre:Season;
                   rdfs:label "production";
                   rdfs:range theatre:Production;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "archaic".
theatre:production_of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Indicates that a Production is an expression of a given work or production.";
                      rdfs:domain theatre:Production;
                      rdfs:label "production_of";
                      <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:range]
                                                               [a rdfs:range]).
theatre:project a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Associates a Role with a Project.";
                rdfs:domain <http://purl.org/vocab/participation/schema#Role>;
                rdfs:label "project";
                <http://www.w3.org/2002/07/owl#inverseOf> theatre:credit;
                <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:range]
                                                         [a rdfs:range]
                                                         [a rdfs:range]
                                                         [a rdfs:range]).
theatre:put_on_by a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The Company which puts on a Production";
                  rdfs:domain theatre:Production;
                  rdfs:label "put_on_by";
                  rdfs:range theatre:ProductionCompany.
theatre:recorded_for a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "A performance recorded for either Simulcast or later broadcast.";
                     rdfs:domain <http://purl.org/ontology/mo/Performance>;
                     rdfs:label "recorded_for";
                     rdfs:range <http://purl.org/ontology/po/Broadcast>.
theatre:scored_voice a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Indicates the voice classification that a particular Operatic character has been written for.";
                     rdfs:domain <http://purl.org/ontomedia/ext/common/being#Character>;
                     rdfs:label "scored_voice";
                     rdfs:range theatre:Voice.
theatre:sponsor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The Person or Organisation who sponsors a given production or performance";
                rdfs:label "sponsor";
                rdfs:range <http://xmlns.com/foaf/0.1/Agent>;
                <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:domain]
                                                         [a rdfs:domain]).
theatre:time_of_day a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "A human readable indication of when in the day a performance occurs";
                    rdfs:domain theatre:Performance;
                    rdfs:label "time_of_day";
                    rdfs:range xsd:string.
theatre:venue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Associates an Event with the Venue it is held in.";
              rdfs:domain theatre:Event;
              rdfs:label "venue";
              rdfs:range theatre:Venue;
              rdfs:subPropertyOf <http://purl.org/NET/c4dm/event.owl#place>.
theatre:worldPremiere a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Indicates the first performance of a Show or Production on a particular planet.";
                      rdfs:label "worldPremiere";
                      rdfs:range <http://purl.org/ontology/mo/Performance>;
                      rdfs:subPropertyOf theatre:premiere;
                      <http://www.w3.org/2002/07/owl#unionOf> ([a rdfs:domain]);
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
<http://purl.org/vocab/participation/schema#Role> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:comment "The occupation of a Position by an Agent for a particular Project.";
                                                  rdfs:label "Role".
