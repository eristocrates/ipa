                            rdfs:range xsd:dateTime;
                            status:term_status "deprecated".
swc:hasPart a owl:ObjectProperty;
            rdfs:comment """
			<p>
				A generic property to model part-of relationships. In SWC this property is used to relate a <a href=\"#Proceedings\">proceedings document</a> to the papers and articles contained in it.
			</p>
			
		""";
            rdfs:domain owl:Thing;
            rdfs:label "has part";
            rdfs:range owl:Thing;
            status:term_status "testing".
swc:hasProgramme a owl:ObjectProperty;
                 rdfs:comment """
			<p>
				Relates an event such as a conference to its <a href=\"#Programme\">Programme</a>. 
			</p>
			
		""";
                 rdfs:domain swc:OrganisedEvent;
                 rdfs:label "has programme";
                 rdfs:range swc:Programme;
                 status:term_status "testing".
swc:hasRelatedArtefact a owl:ObjectProperty;
                       rdfs:comment """
			<p>
				Relates an <a href=\"#AcademicEvent\">event</a> such as a conference, workshop, etc. to a physical <a href=\"#Artefact\">artefact</a>.
			</p>
			
		""";
                       rdfs:domain swc:AcademicEvent;
                       rdfs:label "has related artefact";
                       rdfs:range swc:Artefact;
                       status:term_status "testing".
swc:hasRelatedDocument a owl:ObjectProperty;
                       rdfs:comment """
			<p>
				Relates an <a href=\"#AcademicEvent\">event</a> such as a conference, workshop, etc. to a <a href=\"#ArgumentativeDocument\">document</a>.
			</p>
			
		""";
                       rdfs:domain swc:AcademicEvent;
                       rdfs:label "has related document";
                       rdfs:range swc:ArgumentativeDocument;
                       owl:inverseOf swc:relatedToEvent;
                       status:term_status "testing".
swc:hasRole a owl:ObjectProperty;
            rdfs:comment """
			<p>
				Part of the <a href=\"#Role\">role</a> modelling machinery of SWC. This property relates an event (e.g. a conference) to a role at the event (e.g. a conference chair).
			</p>
			
		""";
            rdfs:domain swc:AcademicEvent;
            rdfs:label "has role";
            rdfs:range swc:Role;
            owl:inverseOf swc:isRoleAt;
            status:term_status "testing".
swc:hasSponsorship a owl:DeprecatedProperty;
                   rdfs:comment """
