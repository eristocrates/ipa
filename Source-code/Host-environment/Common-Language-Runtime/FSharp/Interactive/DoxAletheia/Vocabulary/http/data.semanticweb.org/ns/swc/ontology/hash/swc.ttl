<http://data.semanticweb.org/ns/swc/ontology> <http://data.semanticweb.org/ns/misc#licenseDoc> swc:license_doc;
                                              dcterms:created "2007/05/31";
                                              dcterms:creator swperson:sean-bechhofer,
                                                              <http://kantenwerk.org/metadata/foaf.rdf#me>,
                                                              <http://tomheath.com/id/me>;
                                              dcterms:hasVersion <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf>,
                                                                 <http://data.semanticweb.org/ns/swc/swc_2009-02-27.rdf>;
                                              dcterms:license <http://creativecommons.org/licenses/by/3.0/>;
                                              dcterms:modified "$Date: 2009-05-11 17:50:14 +0100 (Mon, 11 May 2009) $";
                                              dcterms:title "Semantic Web Conference Ontology";
                                              sioc:earlier_version <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf>;
                                              doap:revision """
			$Revision: 895 $ - <i>Slim Version</i>
			""";
                                              <http://www.cs.vu.nl/~mcaklein/onto/swrc_ext/2005/05#authorList> [rdf:_3 <http://tomheath.com/id/me> ; 
                                                                                                                rdf:_2 swperson:sean-bechhofer ; 
                                                                                                                rdf:_1 <http://kantenwerk.org/metadata/foaf.rdf#me>];
                                              a owl:Ontology;
                                              rdfs:label "Semantic Web Conference Ontology";
                                              owl:imports <http://data.semanticweb.org/ns/swc/swrc-topics>,
                                                          <http://data.semanticweb.org/ns/swc/swrc>;
                                              status:userdocs (swc:01_introduction
                                                               swc:02_describing_papers
                                                               swc:03_roles);
                                              foaf:logo <http://data.semanticweb.org/images/bones_256.png>;
                                              foaf:maker swperson:sean-bechhofer,
                                                         <http://kantenwerk.org/metadata/foaf.rdf#me>,
                                                         <http://tomheath.com/id/me>.
swc:01_introduction rdfs:comment """
			<p>
				The Semantic Web Conference ontology (SWC) is an ontology for describing academic conferences. 
				It was initially designed to support the European Semantic Web Conference,
				ESWC2007, and later extended for both the following conferences in the ESWC series,
				as well as in the ISWC series.
				Historically, the SWC ontology also draws heavily on ontologies developed for
				ESWC2006 and ISWC2006.
			</p>
			<p>
				SWC is mainly a convention of how to use classes and properties from other ontologies, most prominently 
				<a href=\"http://xmlns.com/foaf/0.1\">FOAF</a> (for people) and <a href=\"http://ontoware.org/projects/swrc/\">SWRC</a> 
				(their BibTeX elements, for the papers). We are also throwing in some <a href=\"http://sioc-project.org/\">SIOC</a>, 
				<a href=\"http://dublincore.org/documents/dc-rdf/index.shtml\">Dublin Core</a> and 
				<a href=\"http://www.w3.org/TR/rdfcal/\">iCal/RDF Calendar</a>. Our own 
				<a href=\"http://data.semanticweb.org/ns/swc/ontology\">swc namespace</a> provides the glue for all this, as well as 
				specialised classes for things that have to do with conferences.
			</p>
			<p>
				This version of SWC has been slimmed down significantly (hence the revision name). A total of 59 classes and 19 properties have been deprecated (deprecated terms can be found at the bottom of this document). This was mostly done with the intention to remove the countless sub-classes of generic classes such as <a href=\"#Chair\">Chair</a> or <a href=\"#SessionEvent\">SessionEvent</a>, which were deemed to be too specific for a general-purpose conference ontology such as SWC. Elsewhere, classes and properties which had never been used and seemed to fall under the heading of \"over-engineering\" were removed. Finally, all CfP related terms were removed. Instead, we suggest to use a dedicated ontology such as the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.
			</p>
			
		""";
                    rdfs:label "Introduction".
swc:02_describing_papers rdfs:comment """
			<p>For the basic use case of describing papers, the figure below shows how the main kinds of resources are connected: the paper itself, the authors and their affiliations, and the talk where the paper was presented.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20070921-ISWC+ASWC2007PublicationGraph.pdf\"><img src=\"documentation/20070921-ISWC+ASWC2007PublicationGraph.png\" /></a>
			</div>
			<p>
				The next figure shows in more detail the kinds of things that can be said about each of the four main entities surrounding a paper.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20071002-Properties.pdf\"><img src=\"documentation/20071002-Properties.png\" /></a>
			</div>
			
		""";
                         rdfs:label "Describing Papers".
swc:03_roles rdfs:comment """
			<p>
				One of the basic design choices in SWC is to use role modelling for describing the different functions at a conference, such as chairs, reviewers, etc. For any particular role at a given conference, the <code>swc:Role</code> class or a sub-class will be instantiated. This role instance stands in relation to a person (who plays the role) and an event. The figure below gives an example showing how to model the role of the metadata chair (or \"dog food tsar\") at ISWC+ASWC2007, which was held by Knud Möller (together with Tom Heath, not shown in the figure).
			</p>
			<p>
				Note that the metadata chair role is not modelled with its own dedicated class (although it could have been). Instead, an instance of the generic <a href=\"#Chair\">Chair</a> class is used and labelled accordingly.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20090510-Roles_new.pdf\"><img src=\"documentation/20090510-Roles_new.png\" /></a>
			</div>
			
		""";
             rdfs:label "Roles".
swc:AcademicEvent dcterms:subject swc:AcademicEvent;
                  a owl:Class;
                  rdfs:comment """
			
			<p>Academic events are e.g. conferences and conference-like events, and all the sub-events of those which are about the topic or theme of the conference, such as talks or panels.</p>
			
		""";
                  rdfs:label "Academic Event";
                  rdfs:subClassOf swc:OrganisedEvent;
                  status:term_status "testing".
swc:AccommodationPlace dcterms:subject resource:Place;
                       a owl:Class;
                       rdfs:comment """
			
			<p>
				A hotel, hostel, BnB or similar. 
			</p>
			
		""";
                       rdfs:label "Accommodation Place";
                       rdfs:subClassOf wgspos:SpatialThing;
                       status:term_status "testing".
swc:AdditionalReviewer dcterms:subject resource:Role;
                       a owl:DeprecatedClass;
                       rdfs:label "Additional Reviewer";
                       rdfs:subClassOf swc:Role;
                       status:term_status "deprecated".
swc:Administrator dcterms:subject resource:Role;
                  a owl:DeprecatedClass;
                  rdfs:label "Administrator";
                  rdfs:subClassOf swc:Role;
                  status:term_status "deprecated".
swc:ArgumentativeDocument dcterms:subject resource:Document;
                          a owl:Class;
                          rdfs:comment """
			<p>An argumentative document is a document which uses analytical reasoning and evidence in order to argue for a point of view. Typical examples are scientific papers or political pamphlets. Negative examples are novels or plays (even though a novel might also try to sway the reader to a certain point of view).</p>
			<p>According to <a href=\"http://en.wikipedia.org/wiki/Text_types\">Text Types</a>, an argumentative document is based \"on the evaluation and the subsequent subjective judgement in answer to a problem. It refers to the reasons advanced for or against a matter\".</p>
			
		""";
                          rdfs:label "Argumentative Document";
                          rdfs:seeAlso wiki:Text_types;
                          rdfs:subClassOf foaf:Document;
                          status:term_status "testing".
swc:Artefact dcterms:subject resource:Document;
             a owl:Class;
             rdfs:comment """
			<p><emph>Artefact</emph> here means a document which can have a physical manifestation, like a paper or the proceedings of a conference.</p>
			
		""";
             rdfs:label "Artefact";
             rdfs:subClassOf wn:Document;
             status:term_status "testing".
swc:BreakEvent dcterms:subject resource:Event;
               a owl:Class;
               rdfs:comment """
			
			<p>
				Any kind of break at the super-event, such as a coffee break.
			</p>
			
		""";
               rdfs:label "Break Event";
               rdfs:subClassOf swc:NonAcademicEvent;
               status:term_status "testing".
swc:Call dcterms:subject resource:Call;
         a owl:DeprecatedClass;
         rdfs:comment """
			<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>
			<p>A <emph>call</emph> is a public announcement, asking for contribution of some kind to events such as conferences or workshops, or to a publication such as a journal or book.</p>
			
		""";
         rdfs:label "Call";
         rdfs:subClassOf wn:Announcement;
         status:term_status "deprecated".
swc:CallForDemos dcterms:subject resource:Call;
                 a owl:DeprecatedClass;
                 rdfs:comment """
			<p>A call for demonstrations of software at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research questions addressed by the software and outlining the content of the demonstration.</p>
			
		""";
                 rdfs:label "Call for Demos";
                 rdfs:subClassOf swc:Call;
                 status:term_status "deprecated".
swc:CallForPapers dcterms:subject resource:Call;
                  a owl:DeprecatedClass;
                  rdfs:comment """
			<p>A <emph>call for papers</emph> or <emph>CfP</emph> encourages authors to submit papers for peer-review for a conference or workshop, or a journal or book.</p>
			
		""";
                  rdfs:label "Call for Papers";
                  rdfs:subClassOf swc:Call;
                  status:term_status "deprecated".
swc:CallForParticipation dcterms:subject resource:Call;
                         a owl:DeprecatedClass;
                         rdfs:comment """
			<p>This kind of call usually calls for potential delegates to attend an event such as a conference or a workshop.</p>
			
		""";
                         rdfs:label "Call for Participation";
                         rdfs:subClassOf swc:Call;
                         status:term_status "deprecated".
swc:CallForPosters dcterms:subject resource:Call;
                   a owl:DeprecatedClass;
                   rdfs:comment """
			<p>A call for scientific posters at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research presented on the poster.</p>
			
		""";
                   rdfs:label "Call for Posters";
                   rdfs:subClassOf swc:Call;
                   status:term_status "deprecated".
swc:CallForProposals dcterms:subject resource:Call;
                     a owl:DeprecatedClass;
                     rdfs:comment """
			<p>A call which asks for contributions in the form of e.g. workshop or tutorial proposals.</p>
			
		""";
                     rdfs:label "Call for Proposals";
                     rdfs:subClassOf swc:Call;
                     status:term_status "deprecated".
swc:Chair dcterms:subject resource:Role;
          a owl:Class;
          rdfs:comment """
			<p>
				A sub-class of Role for various kinds of chair functions. Examples are the main chair of a conference, the tutorials chair, the proceedings chair, etc. Instead of introducing a large amount of sub-classes of Chair, we suggest to model all the different chair functions as instances of Chair with appropriate labels.
			</p>
			
		""";
          rdfs:label "Chair";
          rdfs:subClassOf swc:Role;
          status:term_status "testing".
swc:CoffeeBreak dcterms:subject resource:Event;
                a owl:DeprecatedClass;
                rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
                rdfs:label "Coffee Break";
                rdfs:subClassOf swc:BreakEvent;
                status:term_status "deprecated".
swc:CommunalPlace dcterms:subject resource:Place;
                  a owl:Class;
                  rdfs:comment """
			
			<p>
				A location at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere), which is not a meeting room. 
			</p>
			
		""";
                  rdfs:label "Communal Place";
                  rdfs:subClassOf wgspos:SpatialThing;
                  status:term_status "testing".
swc:ConferenceChair dcterms:subject resource:Chairman;
                    a owl:DeprecatedClass;
                    rdfs:label "Conference Chair";
                    rdfs:subClassOf swc:Role;
                    status:term_status "deprecated".
swc:ConferenceClosingEvent dcterms:subject resource:Event;
                           a owl:DeprecatedClass;
                           rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                           rdfs:label "Closing Event";
                           rdfs:subClassOf swc:NonAcademicEvent;
                           status:term_status "deprecated".
swc:ConferenceDinner dcterms:subject resource:Event;
                     a owl:DeprecatedClass;
                     rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.
			
		""";
                     rdfs:label "Conference Dinner";
                     rdfs:subClassOf swc:MealEvent,
                                     swc:SocialEvent;
                     status:term_status "deprecated".
swc:ConferenceEvent dcterms:subject swc:AcademicEvent;
                    a owl:Class;
                    rdfs:comment """
			
			<p>
				A scientific conference.
			</p>
			<p>
				TODO: Maybe this should be opened up - why only scientific conferences?
			</p>
			
		""";
                    rdfs:label "Conference Event";
                    rdfs:subClassOf swc:AcademicEvent;
                    status:term_status "testing".
swc:ConferenceOpeningEvent dcterms:subject resource:Event;
                           a owl:DeprecatedClass;
                           rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                           rdfs:label "Opening Event";
                           rdfs:subClassOf swc:NonAcademicEvent;
                           status:term_status "deprecated".
swc:ConferenceVenuePlace dcterms:subject resource:Place;
                         a owl:Class;
                         rdfs:comment """
			
			<p>
				The location of a conference or conference-like event. Ideally, this would be more specific than just the city. Instead it should  be the hotel, convention centre, university or similar place where the event is held.
			</p>
			
		""";
                         rdfs:label "Conference Venue Place";
                         rdfs:subClassOf wgspos:SpatialThing;
                         status:term_status "testing".
swc:Delegate dcterms:subject resource:Role;
             a owl:Class;
             rdfs:comment """
			<p>
				A delegate is someone who attends a conference or conference-like event.
			</p>
			
		""";
             rdfs:label "Delegate";
             rdfs:subClassOf swc:Role;
             status:term_status "testing".
swc:DemoPresentation dcterms:subject swc:AcademicEvent;
                     a owl:DeprecatedClass;
                     rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                     rdfs:label "Demo Presentation";
                     rdfs:subClassOf swc:TalkEvent;
                     status:term_status "deprecated".
swc:DemoSession dcterms:subject swc:AcademicEvent;
                a owl:DeprecatedClass;
                rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.
			
		""";
                rdfs:label "Demo Session";
                rdfs:subClassOf swc:SessionEvent;
                status:term_status "deprecated".
swc:DemosChair dcterms:subject resource:Chairman;
               a owl:DeprecatedClass;
               rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
               rdfs:label "Demos Chair";
               rdfs:subClassOf swc:Role;
               status:term_status "deprecated".
swc:DogfoodTsar dcterms:subject resource:Chairman;
                a owl:DeprecatedClass;
                rdfs:comment """A role that is only relevant in relation to the topic of the conference e.g. Semantic 
			Web Technologies Coordinator at a Semantic Web Conference.
		""";
                rdfs:label "Dogfood Tsar";
                rdfs:subClassOf swc:Role;
                status:term_status "deprecated".
swc:DrinkingPlace dcterms:subject resource:Place;
                  a owl:DeprecatedClass;
                  rdfs:comment """
			<p>Deprecated to reduce inflation of terms.</p>
			
		""";
                  rdfs:label "Drinking Place";
                  rdfs:subClassOf swc:Place;
                  status:term_status "deprecated".
swc:EatingPlace dcterms:subject resource:Place;
                a owl:DeprecatedClass;
                rdfs:comment """
			<p>Deprecated to reduce inflation of terms.</p>
			
		""";
                rdfs:label "Eating Place";
                rdfs:subClassOf swc:Place;
                status:term_status "deprecated".
swc:Excursion dcterms:subject resource:Event;
              a owl:DeprecatedClass;
              rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.
			
		""";
              rdfs:label "Excursion";
              rdfs:subClassOf swc:SocialEvent;
              status:term_status "deprecated".
swc:ExhibitionChair dcterms:subject resource:Chairman;
                    a owl:DeprecatedClass;
                    rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                    rdfs:label "Exhibition Chair";
                    rdfs:subClassOf swc:Role;
                    status:term_status "deprecated".
swc:FreeTimeBreak dcterms:subject resource:Event;
                  a owl:DeprecatedClass;
                  rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
                  rdfs:label "Free Time Break";
                  rdfs:subClassOf swc:BreakEvent;
                  status:term_status "deprecated".
swc:IndustrialTalk dcterms:subject swc:AcademicEvent;
                   a owl:DeprecatedClass;
                   rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                   rdfs:label "Industrial Talk";
                   rdfs:subClassOf swc:TalkEvent;
                   status:term_status "deprecated".
swc:IndustrialTrack dcterms:subject swc:AcademicEvent;
                    a owl:DeprecatedClass;
                    rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TrackEvent\">TrackEvent</a>.
			
		""";
                    rdfs:label "Industrial Track";
                    rdfs:subClassOf swc:TrackEvent;
                    status:term_status "deprecated".
swc:IndustryChair dcterms:subject resource:Chairman;
                  a owl:DeprecatedClass;
                  rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                  rdfs:label "Industry Chair or In-Use Chair";
                  rdfs:subClassOf swc:Role;
                  status:term_status "deprecated".
swc:InvitedPaper dcterms:subject resource:Document;
                 a owl:DeprecatedClass;
                 rdfs:comment """
			<p>As opposed to a peer-reviewed paper. This class has been deprecated in order to reduce the inflation of classes.</p>
			
		""";
                 rdfs:label "Invited Paper";
                 rdfs:subClassOf swrc:InProceedings;
                 status:term_status "deprecated".
swc:KeynoteTalk dcterms:subject swc:AcademicEvent;
                a owl:DeprecatedClass;
                rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                rdfs:label "Keynote Talk";
                rdfs:subClassOf swc:TalkEvent;
                status:term_status "deprecated".
swc:LocalOrganiser dcterms:subject resource:Role;
                   a owl:DeprecatedClass;
                   rdfs:label "Local Organiser";
                   rdfs:subClassOf swc:Role;
                   status:term_status "deprecated".
swc:MealBreak dcterms:subject resource:Event;
              a owl:DeprecatedClass;
              rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
              rdfs:label "Meal Break";
              rdfs:subClassOf swc:BreakEvent;
              status:term_status "deprecated".
swc:MealEvent dcterms:subject resource:Event;
              a owl:Class;
              rdfs:comment """
			
			<p>
				A lunch, dinner or similar event at a conference or conference-like event.
			</p>
			
		""";
              rdfs:label "Meal Event";
              rdfs:subClassOf swc:NonAcademicEvent;
              status:term_status "testing".
swc:MeetingRoomPlace dcterms:subject resource:Place;
                     a owl:Class;
                     rdfs:comment """
			
			<p>
				A particular room at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere). E.g., the room where a particular <a href=\"#SessionEvent\">SessionEvent</a> takes place. 
			</p>
			
		""";
                     rdfs:label "Meeting Room Place";
                     rdfs:subClassOf wgspos:SpatialThing;
                     status:term_status "testing".
swc:NonAcademicEvent dcterms:subject resource:Event;
                     a owl:Class;
                     rdfs:comment """
			
			<p>
				In the context of SWC, a non-academic event is any kind or <a href=\"#OrganisedEvent\">organised event</a> which does not concern the topic or theme of the conference as such. Examples are breaks, dinners, parties, etc.
			</p>
			
		""";
                     rdfs:label "Non-academic Event";
                     rdfs:subClassOf swc:OrganisedEvent;
                     status:term_status "testing".
swc:OrganisedEvent dcterms:subject resource:Event;
                   a owl:Class;
                   rdfs:comment """
			
			<p>An event in time and space which is planned and organised, as opposed to something which 'just happens', such as a car accident or sunset.</p>
			
		""";
                   rdfs:label "Organised Event";
                   rdfs:subClassOf ical:Vevent,
                                   wn:Event-1;
                   status:term_status "testing".
swc:OrganisingCommitteeMember dcterms:subject resource:Role;
                              a owl:DeprecatedClass;
                              rdfs:label "Organising Committee Member";
                              rdfs:subClassOf swc:Role;
                              status:term_status "deprecated".
swc:PanelEvent dcterms:subject swc:AcademicEvent;
               a owl:Class;
               rdfs:comment """
			
			<p>A panel discussion at a conference or conference-like event, usually involving several speakers.</p>
			
		""";
               rdfs:label "Panel Event";
               rdfs:subClassOf swc:AcademicEvent;
               status:term_status "testing".
swc:Paper dcterms:subject resource:Document;
          a owl:Class;
          rdfs:comment """
			<p>A scientific/scholarly paper, e.g., an article in a scientific journal, or a paper at a conference or workshop. A paper could also be unpublished formally, as long as it has the form of a scientific paper (introduction, conclusion, related work, etc.).</p>
			
		""";
          rdfs:label "Paper";
          rdfs:subClassOf swc:Artefact,
                          swc:ArgumentativeDocument;
          status:term_status "testing".
swc:PaperPresentation dcterms:subject swc:AcademicEvent;
                      a owl:DeprecatedClass;
                      rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                      rdfs:label "Paper Presentation";
                      rdfs:subClassOf swc:TalkEvent;
                      status:term_status "deprecated".
swc:PaperSession dcterms:subject swc:AcademicEvent;
                 a owl:DeprecatedClass;
                 rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.
			
		""";
                 rdfs:label "Paper Session";
                 rdfs:subClassOf swc:SessionEvent;
                 status:term_status "deprecated".
swc:PhDSymposiumChair dcterms:subject resource:Chairman;
                      a owl:DeprecatedClass;
