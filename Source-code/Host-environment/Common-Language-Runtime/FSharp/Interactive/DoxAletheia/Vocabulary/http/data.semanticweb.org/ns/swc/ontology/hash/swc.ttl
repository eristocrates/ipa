                   rdfs:domain swc:OrganisedEvent;
                   rdfs:label "has sponsorship";
                   rdfs:range swc:Sponsorship;
                   status:term_status "deprecated".
swc:hasSubmissionDeadline a owl:DeprecatedProperty;
