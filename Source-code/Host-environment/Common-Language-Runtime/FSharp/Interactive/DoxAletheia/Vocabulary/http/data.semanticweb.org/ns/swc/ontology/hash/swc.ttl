				open Web standard that can be freely used by anyone.
			</p>
			
		""";
                rdfs:label "License Statement".
swc:memberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment """
			<p>FOAF does not define an inverse of <code>foaf:member</code>, so SWC does it.</p>
			
		""";
             rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
             rdfs:label "member of";
             rdfs:range <http://xmlns.com/foaf/0.1/Group>;
             <http://www.w3.org/2002/07/owl#inverseOf> <http://xmlns.com/foaf/0.1/member>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:plansToAttend a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """
			<p>
				A person might plan to attend a talk or session at a conference or similar event. This property could be used to prepare a delegate's conference experience with respect to who they want to meet, etc.
			</p>
			
		""";
                  rdfs:domain <http://xmlns.com/foaf/0.1/Person>;
                  rdfs:label "plans to attend";
                  rdfs:range swc:OrganisedEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:relatedToEvent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment """
			<p>
				Relates a <a href=\"#ArgumentativeDocument\">document</a> to an <a href=\"#AcademicEvent\">event</a> such as a conference, workshop, etc.
			</p>
			
		""";
                   rdfs:domain swc:Artefact,
                               swc:ArgumentativeDocument;
                   rdfs:label "related to event",
                              "related to Event";
                   rdfs:range swc:AcademicEvent;
                   <http://www.w3.org/2002/07/owl#inverseOf> swc:hasRelatedDocument;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:uuid a <http://www.w3.org/2002/07/owl#DeprecatedProperty>;
         rdfs:label "uuid";
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
