@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix swc: <http://data.semanticweb.org/ns/swc/ontology#>.

<http://data.semanticweb.org/ns/swc/ontology> <http://data.semanticweb.org/ns/misc#licenseDoc> swc:license_doc;
                                              <http://purl.org/dc/terms/created> "2007/05/31";
                                              <http://purl.org/dc/terms/creator> <http://data.semanticweb.org/person/sean-bechhofer>,
                                                                                 <http://kantenwerk.org/metadata/foaf.rdf#me>,
                                                                                 <http://tomheath.com/id/me>;
                                              <http://purl.org/dc/terms/hasVersion> <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf>,
                                                                                    <http://data.semanticweb.org/ns/swc/swc_2009-02-27.rdf>;
                                              <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>;
                                              <http://purl.org/dc/terms/modified> "$Date: 2009-05-11 17:50:14 +0100 (Mon, 11 May 2009) $";
                                              <http://purl.org/dc/terms/title> "Semantic Web Conference Ontology";
                                              <http://rdfs.org/sioc/ns#earlier_version> <http://data.semanticweb.org/ns/swc/swc_2009-03-02.rdf>;
                                              <http://usefulinc.com/ns/doap#revision> """
			$Revision: 895 $ - <i>Slim Version</i>
			""";
                                              <http://www.cs.vu.nl/~mcaklein/onto/swrc_ext/2005/05#authorList> [rdf:_3 <http://tomheath.com/id/me> ; 
                                                                                                                rdf:_2 <http://data.semanticweb.org/person/sean-bechhofer> ; 
                                                                                                                rdf:_1 <http://kantenwerk.org/metadata/foaf.rdf#me>];
                                              a <http://www.w3.org/2002/07/owl#Ontology>;
                                              rdfs:label "Semantic Web Conference Ontology";
                                              <http://www.w3.org/2002/07/owl#imports> <http://data.semanticweb.org/ns/swc/swrc-topics>,
                                                                                      <http://data.semanticweb.org/ns/swc/swrc>;
                                              <http://www.w3.org/2003/06/sw-vocab-status/ns#userdocs> (swc:01_introduction
                                                                                                       swc:02_describing_papers
                                                                                                       swc:03_roles);
                                              <http://xmlns.com/foaf/0.1/logo> <http://data.semanticweb.org/images/bones_256.png>;
                                              <http://xmlns.com/foaf/0.1/maker> <http://data.semanticweb.org/person/sean-bechhofer>,
                                                                                <http://kantenwerk.org/metadata/foaf.rdf#me>,
                                                                                <http://tomheath.com/id/me>.
swc:01_introduction rdfs:comment """
			<p>
				The Semantic Web Conference ontology (SWC) is an ontology for describing academic conferences. 
				It was initially designed to support the European Semantic Web Conference,
				ESWC2007, and later extended for both the following conferences in the ESWC series,
				as well as in the ISWC series.
				Historically, the SWC ontology also draws heavily on ontologies developed for
				ESWC2006 and ISWC2006.
			</p>
			<p>
				SWC is mainly a convention of how to use classes and properties from other ontologies, most prominently 
				<a href=\"http://xmlns.com/foaf/0.1\">FOAF</a> (for people) and <a href=\"http://ontoware.org/projects/swrc/\">SWRC</a> 
				(their BibTeX elements, for the papers). We are also throwing in some <a href=\"http://sioc-project.org/\">SIOC</a>, 
				<a href=\"http://dublincore.org/documents/dc-rdf/index.shtml\">Dublin Core</a> and 
				<a href=\"http://www.w3.org/TR/rdfcal/\">iCal/RDF Calendar</a>. Our own 
				<a href=\"http://data.semanticweb.org/ns/swc/ontology\">swc namespace</a> provides the glue for all this, as well as 
				specialised classes for things that have to do with conferences.
			</p>
			<p>
				This version of SWC has been slimmed down significantly (hence the revision name). A total of 59 classes and 19 properties have been deprecated (deprecated terms can be found at the bottom of this document). This was mostly done with the intention to remove the countless sub-classes of generic classes such as <a href=\"#Chair\">Chair</a> or <a href=\"#SessionEvent\">SessionEvent</a>, which were deemed to be too specific for a general-purpose conference ontology such as SWC. Elsewhere, classes and properties which had never been used and seemed to fall under the heading of \"over-engineering\" were removed. Finally, all CfP related terms were removed. Instead, we suggest to use a dedicated ontology such as the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.
			</p>
			
		""";
                    rdfs:label "Introduction".
swc:02_describing_papers rdfs:comment """
			<p>For the basic use case of describing papers, the figure below shows how the main kinds of resources are connected: the paper itself, the authors and their affiliations, and the talk where the paper was presented.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20070921-ISWC+ASWC2007PublicationGraph.pdf\"><img src=\"documentation/20070921-ISWC+ASWC2007PublicationGraph.png\" /></a>
			</div>
			<p>
				The next figure shows in more detail the kinds of things that can be said about each of the four main entities surrounding a paper.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20071002-Properties.pdf\"><img src=\"documentation/20071002-Properties.png\" /></a>
			</div>
			
		""";
                         rdfs:label "Describing Papers".
swc:03_roles rdfs:comment """
			<p>
				One of the basic design choices in SWC is to use role modelling for describing the different functions at a conference, such as chairs, reviewers, etc. For any particular role at a given conference, the <code>swc:Role</code> class or a sub-class will be instantiated. This role instance stands in relation to a person (who plays the role) and an event. The figure below gives an example showing how to model the role of the metadata chair (or \"dog food tsar\") at ISWC+ASWC2007, which was held by Knud Möller (together with Tom Heath, not shown in the figure).
			</p>
			<p>
				Note that the metadata chair role is not modelled with its own dedicated class (although it could have been). Instead, an instance of the generic <a href=\"#Chair\">Chair</a> class is used and labelled accordingly.
			</p>
			<div align=\"center\">
				<a href=\"documentation/20090510-Roles_new.pdf\"><img src=\"documentation/20090510-Roles_new.png\" /></a>
			</div>
			
		""";
             rdfs:label "Roles".
swc:AcademicEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """
			
			<p>Academic events are e.g. conferences and conference-like events, and all the sub-events of those which are about the topic or theme of the conference, such as talks or panels.</p>
			
		""";
                  rdfs:label "Academic Event";
                  rdfs:subClassOf swc:OrganisedEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:AccommodationPlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment """
			
			<p>
				A hotel, hostel, BnB or similar. 
			</p>
			
		""";
                       rdfs:label "Accommodation Place";
                       rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:AdditionalReviewer <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
                       a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                       rdfs:label "Additional Reviewer";
                       rdfs:subClassOf swc:Role;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Administrator <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:label "Administrator";
                  rdfs:subClassOf swc:Role;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ArgumentativeDocument <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment """
			<p>An argumentative document is a document which uses analytical reasoning and evidence in order to argue for a point of view. Typical examples are scientific papers or political pamphlets. Negative examples are novels or plays (even though a novel might also try to sway the reader to a certain point of view).</p>
			<p>According to <a href=\"http://en.wikipedia.org/wiki/Text_types\">Text Types</a>, an argumentative document is based \"on the evaluation and the subsequent subjective judgement in answer to a problem. It refers to the reasons advanced for or against a matter\".</p>
			
		""";
                          rdfs:label "Argumentative Document";
                          rdfs:seeAlso <http://en.wikipedia.org/wiki/Text_types>;
                          rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>;
                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Artefact <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
			<p><emph>Artefact</emph> here means a document which can have a physical manifestation, like a paper or the proceedings of a conference.</p>
			
		""";
             rdfs:label "Artefact";
             rdfs:subClassOf <http://xmlns.com/wordnet/1.6/Document>;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:BreakEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
			
			<p>
				Any kind of break at the super-event, such as a coffee break.
			</p>
			
		""";
               rdfs:label "Break Event";
               rdfs:subClassOf swc:NonAcademicEvent;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Call <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
         a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
         rdfs:comment """
			<p>The call classes have been deprecated in SWC. Instead, we suggest to use the <a href=\"http://sw.deri.org/2005/08/conf/cfp\">CfP ontology</a>.</p>
			<p>A <emph>call</emph> is a public announcement, asking for contribution of some kind to events such as conferences or workshops, or to a publication such as a journal or book.</p>
			
		""";
         rdfs:label "Call";
         rdfs:subClassOf <http://xmlns.com/wordnet/1.6/Announcement>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CallForDemos <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
                 a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                 rdfs:comment """
			<p>A call for demonstrations of software at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research questions addressed by the software and outlining the content of the demonstration.</p>
			
		""";
                 rdfs:label "Call for Demos";
                 rdfs:subClassOf swc:Call;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CallForPapers <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			<p>A <emph>call for papers</emph> or <emph>CfP</emph> encourages authors to submit papers for peer-review for a conference or workshop, or a journal or book.</p>
			
		""";
                  rdfs:label "Call for Papers";
                  rdfs:subClassOf swc:Call;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CallForParticipation <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
                         a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                         rdfs:comment """
			<p>This kind of call usually calls for potential delegates to attend an event such as a conference or a workshop.</p>
			
		""";
                         rdfs:label "Call for Participation";
                         rdfs:subClassOf swc:Call;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CallForPosters <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
                   a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                   rdfs:comment """
			<p>A call for scientific posters at a conference or workshop. Submissions are usually in the form of extended abstracts (~2 page) discussing the research presented on the poster.</p>
			
		""";
                   rdfs:label "Call for Posters";
                   rdfs:subClassOf swc:Call;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CallForProposals <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Call>;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:comment """
			<p>A call which asks for contributions in the form of e.g. workshop or tutorial proposals.</p>
			
		""";
                     rdfs:label "Call for Proposals";
                     rdfs:subClassOf swc:Call;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Chair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment """
			<p>
				A sub-class of Role for various kinds of chair functions. Examples are the main chair of a conference, the tutorials chair, the proceedings chair, etc. Instead of introducing a large amount of sub-classes of Chair, we suggest to model all the different chair functions as instances of Chair with appropriate labels.
			</p>
			
		""";
          rdfs:label "Chair";
          rdfs:subClassOf swc:Role;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:CoffeeBreak <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
                rdfs:label "Coffee Break";
                rdfs:subClassOf swc:BreakEvent;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:CommunalPlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """
			
			<p>
				A location at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere), which is not a meeting room. 
			</p>
			
		""";
                  rdfs:label "Communal Place";
                  rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:ConferenceChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                    a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                    rdfs:label "Conference Chair";
                    rdfs:subClassOf swc:Role;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ConferenceClosingEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                           a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                           rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                           rdfs:label "Closing Event";
                           rdfs:subClassOf swc:NonAcademicEvent;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ConferenceDinner <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.
			
		""";
                     rdfs:label "Conference Dinner";
                     rdfs:subClassOf swc:MealEvent,
                                     swc:SocialEvent;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ConferenceEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment """
			
			<p>
				A scientific conference.
			</p>
			<p>
				TODO: Maybe this should be opened up - why only scientific conferences?
			</p>
			
		""";
                    rdfs:label "Conference Event";
                    rdfs:subClassOf swc:AcademicEvent;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:ConferenceOpeningEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                           a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                           rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                           rdfs:label "Opening Event";
                           rdfs:subClassOf swc:NonAcademicEvent;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ConferenceVenuePlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """
			
			<p>
				The location of a conference or conference-like event. Ideally, this would be more specific than just the city. Instead it should  be the hotel, convention centre, university or similar place where the event is held.
			</p>
			
		""";
                         rdfs:label "Conference Venue Place";
                         rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Delegate <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
			<p>
				A delegate is someone who attends a conference or conference-like event.
			</p>
			
		""";
             rdfs:label "Delegate";
             rdfs:subClassOf swc:Role;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:DemoPresentation <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                     rdfs:label "Demo Presentation";
                     rdfs:subClassOf swc:TalkEvent;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:DemoSession <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.
			
		""";
                rdfs:label "Demo Session";
                rdfs:subClassOf swc:SessionEvent;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:DemosChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
               a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
               rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
               rdfs:label "Demos Chair";
               rdfs:subClassOf swc:Role;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:DogfoodTsar <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """A role that is only relevant in relation to the topic of the conference e.g. Semantic 
			Web Technologies Coordinator at a Semantic Web Conference.
		""";
                rdfs:label "Dogfood Tsar";
                rdfs:subClassOf swc:Role;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:DrinkingPlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			<p>Deprecated to reduce inflation of terms.</p>
			
		""";
                  rdfs:label "Drinking Place";
                  rdfs:subClassOf swc:Place;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:EatingPlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """
			<p>Deprecated to reduce inflation of terms.</p>
			
		""";
                rdfs:label "Eating Place";
                rdfs:subClassOf swc:Place;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Excursion <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
              a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
              rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.
			
		""";
              rdfs:label "Excursion";
              rdfs:subClassOf swc:SocialEvent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ExhibitionChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                    a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                    rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                    rdfs:label "Exhibition Chair";
                    rdfs:subClassOf swc:Role;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:FreeTimeBreak <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
                  rdfs:label "Free Time Break";
                  rdfs:subClassOf swc:BreakEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:IndustrialTalk <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                   a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                   rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                   rdfs:label "Industrial Talk";
                   rdfs:subClassOf swc:TalkEvent;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:IndustrialTrack <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                    a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                    rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TrackEvent\">TrackEvent</a>.
			
		""";
                    rdfs:label "Industrial Track";
                    rdfs:subClassOf swc:TrackEvent;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:IndustryChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                  rdfs:label "Industry Chair or In-Use Chair";
                  rdfs:subClassOf swc:Role;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:InvitedPaper <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
                 a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                 rdfs:comment """
			<p>As opposed to a peer-reviewed paper. This class has been deprecated in order to reduce the inflation of classes.</p>
			
		""";
                 rdfs:label "Invited Paper";
                 rdfs:subClassOf <http://swrc.ontoware.org/ontology#InProceedings>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:KeynoteTalk <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                rdfs:label "Keynote Talk";
                rdfs:subClassOf swc:TalkEvent;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:LocalOrganiser <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
                   a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                   rdfs:label "Local Organiser";
                   rdfs:subClassOf swc:Role;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:MealBreak <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
              a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
              rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#BreakEvent\">BreakEvent</a>.
			
		""";
              rdfs:label "Meal Break";
              rdfs:subClassOf swc:BreakEvent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:MealEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
			
			<p>
				A lunch, dinner or similar event at a conference or conference-like event.
			</p>
			
		""";
              rdfs:label "Meal Event";
              rdfs:subClassOf swc:NonAcademicEvent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:MeetingRoomPlace <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
			
			<p>
				A particular room at the <a href=\"#ConferenceVenuePlace\">conference venue</a> (or elsewhere). E.g., the room where a particular <a href=\"#SessionEvent\">SessionEvent</a> takes place. 
			</p>
			
		""";
                     rdfs:label "Meeting Room Place";
                     rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:NonAcademicEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment """
			
			<p>
				In the context of SWC, a non-academic event is any kind or <a href=\"#OrganisedEvent\">organised event</a> which does not concern the topic or theme of the conference as such. Examples are breaks, dinners, parties, etc.
			</p>
			
		""";
                     rdfs:label "Non-academic Event";
                     rdfs:subClassOf swc:OrganisedEvent;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:OrganisedEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """
			
			<p>An event in time and space which is planned and organised, as opposed to something which 'just happens', such as a car accident or sunset.</p>
			
		""";
                   rdfs:label "Organised Event";
                   rdfs:subClassOf <http://www.w3.org/2002/12/cal/ical#Vevent>,
                                   <http://xmlns.com/wordnet/1.6/Event-1>;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:OrganisingCommitteeMember <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
                              a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                              rdfs:label "Organising Committee Member";
                              rdfs:subClassOf swc:Role;
                              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:PanelEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
			
			<p>A panel discussion at a conference or conference-like event, usually involving several speakers.</p>
			
		""";
               rdfs:label "Panel Event";
               rdfs:subClassOf swc:AcademicEvent;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Paper <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment """
			<p>A scientific/scholarly paper, e.g., an article in a scientific journal, or a paper at a conference or workshop. A paper could also be unpublished formally, as long as it has the form of a scientific paper (introduction, conclusion, related work, etc.).</p>
			
		""";
          rdfs:label "Paper";
          rdfs:subClassOf swc:Artefact,
                          swc:ArgumentativeDocument;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:PaperPresentation <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                      a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                      rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                      rdfs:label "Paper Presentation";
                      rdfs:subClassOf swc:TalkEvent;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:PaperSession <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                 a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                 rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.
			
		""";
                 rdfs:label "Paper Session";
                 rdfs:subClassOf swc:SessionEvent;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:PhDSymposiumChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                      a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                      rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                      rdfs:label "PhD Symposium or Doctoral Consortium Chair";
                      rdfs:subClassOf swc:Role;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Place <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Place>;
          a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
          rdfs:comment """
			
			<p>
				Deprecated: no real need to have an internal super-class for locations, we can just use the <a href=\"&geo;SpatialThing\">SpatialThing</a>.
			</p>
			
		""";
          rdfs:label "Place";
          rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing>;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Poster <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment """
			<p>A scientific poster at a conference or workshop.</p>
			
		""";
           rdfs:label "Poster";
           rdfs:subClassOf swc:Artefact,
                           swc:ArgumentativeDocument;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:PosterPresentation <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                       a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                       rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TalkEvent\">TalkEvent</a>.
			
		""";
                       rdfs:label "Poster Presentation";
                       rdfs:subClassOf swc:TalkEvent;
                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:PosterSession <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#SessionEvent\">SessionEvent</a>.
			
		""";
                  rdfs:label "Poster Session";
                  rdfs:subClassOf swc:SessionEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:PostersChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                 a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                 rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                 rdfs:label "Posters Chair";
                 rdfs:subClassOf swc:Role;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Presenter <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
			<p>
				A presenter is someone who presents matter in front of an audience. Examples of events to which this role applies are paper presentations, tutorials, or talks. A keynote speaker could also be modelled as an instance of this class.
			</p>
			
		""";
              rdfs:label "Presenter";
              rdfs:subClassOf swc:Role;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:PrintedProceedingsChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                            a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                            rdfs:label "(Printed) Proceedings Chair";
                            rdfs:subClassOf swc:Role;
                            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Proceedings <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """
			<p>The proceedings of a conference or workshop, which contain the papers presented there.</p>
			
		""";
                rdfs:label "Proceedings";
                rdfs:subClassOf swc:Artefact,
                                <http://xmlns.com/foaf/0.1/Document>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Programme <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
			<p>A document containing the programme of an event such as a conference or workshop. Typically, the programme would list the times and dates for the individual sub-events, e.g., talks, dinners, panel discussions, etc.</p>
			
		""";
              rdfs:label "Programme";
              rdfs:subClassOf swc:Artefact,
                              <http://xmlns.com/foaf/0.1/Document>;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:ProgrammeChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                   a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                   rdfs:label "Programme Chair";
                   rdfs:subClassOf swc:Role;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ProgrammeCommitteeMember <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
                             a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment """
			<p>
				This role is played by the members of the programme committee of a conference or conference-like event. We found this role to be so significant that it justifies to be represented by its own class.
			</p>
			
		""";
                             rdfs:label "Programme Committee Member";
                             rdfs:subClassOf swc:Role;
                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:PublicityChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                   a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                   rdfs:label "Publicity Chair";
                   rdfs:subClassOf swc:Role;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Reception <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
              a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
              rdfs:comment """
			
			Deprecating this - we can just use <a href=\"#SocialEvent\">SocialEvent</a>.
			
		""";
              rdfs:label "Reception";
              rdfs:subClassOf swc:SocialEvent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:ResearchTrack <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                  a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                  rdfs:comment """
			
			Deprecating this - we can just as well use <a href=\"#TrackEvent\">TrackEvent</a>.
			
		""";
                  rdfs:label "Research Track";
                  rdfs:subClassOf swc:TrackEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Reviewer <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
             a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
             rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#ProgrammeCommitteeMember\">ProgrammeCommitteeMember</a> instead.
			</p>
			
		""";
             rdfs:label "Reviewer";
             rdfs:subClassOf swc:Role;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Role <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
         a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment """
			<p>
				Role is the super-class of all the different roles performed at a conference or workshop. Examples are the various conference chairs, the delegates, presenters, PC members, etc. The intended use of this class is that an instance of Role will be related to the event at which it is performed, and to the person which performs it.
			</p>
			<p>
				Since the set of roles is slightly different for each event, and since it would therefore be impossible to provide sub-classes for all needs and circumstances, the SWC ontology only contains a very basic set of Role classes. Rather than diversifying the set of Role classes to cater for all needs, users should instead instantiate the small set of different Role classes and cover the roles at a specific event in this way. E.g., instead of sub-classing the Chair role with MainChair, WorkshopChair, TutorialChair, etc., the different kinds of chairs should simply be instances of the generic Chair class and be labelled appropriately.
			</p>
			
		""";
         rdfs:label "Role";
         rdfs:subClassOf <http://xmlns.com/wordnet/1.6/Role-1>;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:SWChallengeChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:comment """
			<p>
				Deprecating this, just use <a href=\"#TrackChair\">TrackChair</a> instead.
			</p>
			
		""";
                     rdfs:label "Semantic Web Challenge Chair";
                     rdfs:subClassOf swc:Role;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SessionChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                 a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                 rdfs:label "Session Chair";
                 rdfs:subClassOf swc:Role;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SessionEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """
			
			<p>
				A session dedicated to a specific topic at a conference. This could be a session with talks, or also a poster session, a demo session, or any other kind of session.
			</p>
			
		""";
                 rdfs:label "Session Event";
                 rdfs:subClassOf swc:AcademicEvent;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:SlideSet <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """
			<p>A set of slides used for a presentation of e.g. a paper at a conference.</p>
			
		""";
             rdfs:label "Slide Set";
             rdfs:subClassOf swc:Artefact,
                             swc:ArgumentativeDocument;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:SocialEvent <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Event>;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment """
			
			<p>
				Examples for social events are parties or excursions.
			</p>
			
		""";
                rdfs:label "Social Event";
                rdfs:subClassOf swc:NonAcademicEvent;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Sponsorship a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                rdfs:comment """
			<p>Deprecated because it has never been used and in order to reduce the inflation of ontology terms.</p>
			
		""";
                rdfs:label "Sponsorship";
                rdfs:subClassOf <http://xmlns.com/wordnet/1.6/Sponsorship>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SponsorshipChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:label "Sponsorship Chair";
                     rdfs:subClassOf swc:Role;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SubmissionsChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
                     a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                     rdfs:label "Submissions Chair";
                     rdfs:subClassOf swc:Role;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SystemDemonstration <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
                        a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                        rdfs:comment """
			<p>A type of paper which accompanies the demonstration of software, also known as an extended abstract or demo description. This class has been deprecated in order to reduce the inflation of classes; it is too specific for CS conferences.</p>
			
		""";
                        rdfs:label "System Demonstration";
                        rdfs:subClassOf swc:Paper;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:SystemDescription <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Document>;
                      a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
                      rdfs:comment """
			<p>
				A type of paper which is mainly describes the properties, implementation or architecture of an system (such as a software system).
			</p>
			<p>
				Deprecating this: it's too specific for, not generic enough to apply for most conferences.
			
		""";
                      rdfs:label "System Description";
                      rdfs:subClassOf swc:Paper;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:TalkEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """
			
			<p>
				A speaker giving a talk. This could be the presentation of a paper, but also keynote speech or any other kind of talk.
			</p>
			
		""";
              rdfs:label "Talk Event";
              rdfs:subClassOf swc:AcademicEvent;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:TrackChair <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Chairman>;
               a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
               rdfs:comment """
			<p>
				The chair of a particular track of a conference, responsible for all submissions and actions regarding this track.
			</p>
			
		""";
               rdfs:label "Track Chair";
               rdfs:subClassOf swc:Role;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:TrackEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment """
			
			<p>
				A track groups all those sessions or events at a conference or workshop that belong to a common, overall theme. Depending on the conference, tracks can be quite generic, such as \"Research\" or \"Industrial\", but can also be more specific, such as \"Semantic Web\" or \"Numismatics\". SWC does not define any specific tracks, since conferences often differ so much with respect to how they structure their tracks, that it would be pointless to try and find a set of tracks that would suit all conferences.
			</p>
			<p>Sub-classes of TrackEvent which were defined in previous versions of the SWC ontology are now deprecated.</p>
			
		""";
               rdfs:label "Track Event";
               rdfs:subClassOf swc:AcademicEvent;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
swc:Treasurer <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
              a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
              rdfs:label "Treasurer";
              rdfs:subClassOf swc:Role;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:Tutor <http://purl.org/dc/terms/subject> <http://dbpedia.org/resource/Role>;
          a <http://www.w3.org/2002/07/owl#DeprecatedClass>;
          rdfs:label "Tutor";
          rdfs:subClassOf swc:Role;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "deprecated".
swc:TutorialEvent <http://purl.org/dc/terms/subject> swc:AcademicEvent;
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment """
			
			<p>
				A tutorial is a special session at a conference or workshop, somewhat like a long lecture on a specific topic.
			</p>
			
		""";
                  rdfs:label "Tutorial Event";
                  rdfs:subClassOf swc:AcademicEvent;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing".
