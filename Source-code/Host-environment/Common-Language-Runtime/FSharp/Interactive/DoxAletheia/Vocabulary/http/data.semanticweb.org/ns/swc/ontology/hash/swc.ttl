		""";
             rdfs:label "Slide Set";
             rdfs:subClassOf swc:Artefact,
                             swc:ArgumentativeDocument;
             status:term_status "testing".
swc:SocialEvent dcterms:subject resource:Event;
                a owl:Class;
                rdfs:comment """
			
