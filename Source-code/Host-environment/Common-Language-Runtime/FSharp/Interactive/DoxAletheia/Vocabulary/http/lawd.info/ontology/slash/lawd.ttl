@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lawd: <http://lawd.info/ontology/>.

<http://erlangen-crm.org/current/E21_Person> <http://www.w3.org/2002/07/owl#equivalentClass> lawd:Person.
<http://erlangen-crm.org/current/E27_Site> <http://www.w3.org/2002/07/owl#equivalentClass> lawd:Place.
<http://erlangen-crm.org/current/E33_Linguistic_Object> <http://www.w3.org/2002/07/owl#equivalentClass> lawd:WrittenWork.
<http://geovocab.org/spatial#Feature> a <http://www.w3.org/2002/07/owl#Class>;
                                      <http://www.w3.org/2002/07/owl#equivalentClass> lawd:Place.
lawd: <http://creativecommons.org/ns#license> <http://creativecommons.org/license/by/3.0/>;
      <http://purl.org/dc/terms/description> "The goal of LAWD is to fill in the cracks between the data used and published by projects with a focus on the ancient world and the standard Linked Data vocablary schemes, like Dublin Core, the Open Annotation Collaboration, and CIDOC-CRM.";
      <http://purl.org/dc/terms/issued> "2013-03-28";
      <http://purl.org/dc/terms/modified> "2014-09-03";
      <http://purl.org/dc/terms/rights> "Copyright © 2013 Hugh A. Cayless";
      <http://purl.org/dc/terms/title> "Linking Ancient World Data Ontology";
      <http://purl.org/vocab/vann/preferredNamespacePrefix> "lawd";
      <http://purl.org/vocab/vann/preferredNamespaceUri> "http://lawd.info/ontology/";
      a <http://www.w3.org/2002/07/owl#Ontology>,
        <http://purl.org/vocommons/voaf#Vocabulary>;
      <http://www.w3.org/2002/07/owl#imports> <http://purl.org/ontology/olo/core#>,
                                              <http://erlangen-crm.org/current/>,
                                              <http://www.w3.org/2004/02/skos/core>,
                                              <http://www.w3.org/ns/oa#>;
      <http://www.w3.org/2002/07/owl#versionIRI> <http://lawd.info/ontology/1.0/>.
lawd:Agent a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An Agent is an abstract entity which has agency or is considered capable of acting in some way. Current subclasses include Deities and Persons."@en.
lawd:AssembledWork a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """A Written Work that collects together more than one Written Work.
      Manuscripts are often AssembledWorks."""@en;
                   rdfs:subClassOf lawd:WrittenWork.
lawd:Attestation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An Attestation models a piece of evidence for something in a text (e.g. the mention of a person in a document). Typically it is the conjunction of a Citation and an entity like a name or person."@en;
                 rdfs:subClassOf lawd:EvidentiaryItem.
lawd:Citation a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Citation models a bibliographic reference as a resource."@en.
lawd:CollationItem a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "(Experimental) Part of a collation of witnesses to a text.".
lawd:ConceptualWork a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment """A Conceptual Work groups together one or more Written Works which
      have the same intellectual source. E.g. The Iliad, as opposed to a particular manuscript witness or edition of the Iliad."""@en.
lawd:Deity a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Any divine Agent.";
           rdfs:subClassOf lawd:Agent.
lawd:Edition a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """A published (whether officially or not) Written Work that relies on
      one or more Written Works as sources"""@en;
             rdfs:subClassOf lawd:WrittenWork.
lawd:EditorialComment a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf lawd:CollationItem.
lawd:EvidentiaryItem a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Superclass for types of evidence that support assertions."@en.
lawd:Hand a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment """A portion of a Written Work in a distinct hand. Written Works may
      consist of one or more hands."""@en;
          rdfs:subClassOf lawd:WrittenWork.
lawd:MythologicalCreature a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Class for non-human, non-divine Agents, e.g. Polyphemus or Medusa.";
                          rdfs:subClassOf lawd:Agent.
lawd:Name a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A name is a resource providing a name for some thing. It may be specialized with subclasses like PersonalName or PlaceName"@en.
lawd:Person a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Any person, whether historical, mythological, or fictional";
            rdfs:subClassOf lawd:Agent.
lawd:PersonalName a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A name belonging to a lawd:Person"@en;
                  rdfs:subClassOf lawd:Name.
lawd:Place a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Any conceivable place, such as a town, a mountain, or the site of a building."@en.
lawd:PlaceName a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The name of a lawd:Place"@en;
               rdfs:subClassOf lawd:Name.
lawd:Reading a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "(Experimental) The superclass for members of the readingScheme concept scheme. A Reading is a word, phrase, or larger chunk of text from a witness (or any observation of variance concerning the text, such as an omission or interpolation)."@en;
             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
lawd:Reference a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf lawd:CollationItem.
lawd:Sigla a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment """An ordered collection that maps Written Works used as sources for an
      Edition to symbols used to represent them in the context of that Edition."""@en;
           rdfs:subClassOf <http://purl.org/ontology/olo/core#OrderedList>.
lawd:Siglum a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment """A Siglum represents a witness (a Written Work of some kind) and
      associates it with a symbol used to represent that work in the context of an
      Edition."""@en;
            rdfs:subClassOf lawd:Citation.
lawd:Translation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A Written Work that translates one or more other Written Works that embody the same Conceptual Work."@en;
                 rdfs:subClassOf lawd:WrittenWork.
lawd:WrittenWork a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A written work, whether extant or not. May be considered to embody a Conceptual Work."@en.
lawd:abbreviation a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment """A label representing an abbreviated form of a name or title, e.g. of
      an author or work. E.g. Homer -> Hom.; Odyssey -> Od.;"""@en.
lawd:addition a lawd:Reading,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              <http://www.w3.org/2004/02/skos/core#broader> lawd:variant;
              <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:agreement a lawd:Reading,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:collation a <http://www.w3.org/ns/oa#Motivation>,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>;
               rdfs:comment """a Motivation that represents the addition of a critical apparatus
      comment upon a text"""@en;
               <http://www.w3.org/2004/02/skos/core#broader> <http://www.w3.org/ns/oa#commenting>.
lawd:conjecture a lawd:Reading,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:conjunctOf a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Indicates that a piece of evidence (any subclass of lawd:EvidentiaryItem) is joined to another—for example because they co-occur."@en;
                rdfs:domain lawd:EvidentiaryItem;
                rdfs:range lawd:EvidentiaryItem.
lawd:correction a lawd:Reading,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>;
                <http://www.w3.org/2004/02/skos/core#broader> lawd:intervention;
                <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:deletion a lawd:Reading,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              <http://www.w3.org/2004/02/skos/core#broader> lawd:intervention;
              <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:embodies a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The relationship between a Written Work and the abstract Conceptual Work it embodies. For example, the OCT text of Homer's Iliad's relationship to the idea of Homer's Iliad."@en;
              rdfs:domain lawd:WrittenWork;
              rdfs:range lawd:ConceptualWork.
lawd:foundAt a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "The place where an artifact was discovered."@en;
             rdfs:range lawd:Place;
             rdfs:subPropertyOf lawd:where.
lawd:hasAttestation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Indicates a lawd:Attestation providing evidence for a name, etc."@en;
                    rdfs:range lawd:Attestation.
lawd:hasCitation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Indicates a Citation that contains the source for a lawd:Attestation"@en;
                 rdfs:domain lawd:Attestation;
                 rdfs:range lawd:Citation.
lawd:hasName a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Indicates that (e.g.) a Person or Place has a lawd:Name that is the range of the property."@en;
             rdfs:range lawd:Name.
lawd:interpolation a lawd:Reading,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
                   <http://www.w3.org/2004/02/skos/core#broader> lawd:variant;
                   <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:intervention a lawd:Reading,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>;
                  <http://www.w3.org/2004/02/skos/core#broader> lawd:variant;
                  <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:omission a lawd:Reading,
                <http://www.w3.org/2002/07/owl#NamedIndividual>;
              <http://www.w3.org/2004/02/skos/core#broader> lawd:variant;
              <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:origin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "The place where an artifact originated."@en;
            rdfs:range lawd:Place;
            rdfs:subPropertyOf lawd:where.
lawd:primaryForm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Indicates the primary form of a lawd:Name"@en;
                 rdfs:domain lawd:Name.
lawd:readingScheme a <http://www.w3.org/2002/07/owl#NamedIndividual>;
                   rdfs:comment "(Experimental) The SKOS scheme for classifying types of lawd:Reading."@en.
lawd:readingType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:range lawd:Reading.
lawd:representedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain lawd:WrittenWork;
                   rdfs:range lawd:Citation.
lawd:represents a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment """Describes the relationship between a Citation or Siglum and the
      Written Work it indicates."""@en;
                rdfs:domain lawd:Citation;
                rdfs:range lawd:WrittenWork;
                <http://www.w3.org/2002/07/owl#inverseOf> lawd:representedBy.
lawd:responsibleAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment """Connects a work of any type to the person, group, or insitution
      responsible for the creation of the work."""@en;
                      rdfs:range [<http://www.w3.org/2002/07/owl#someValuesFrom> lawd:Agent ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> lawd:responsibleAgent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> lawd:Agent ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> lawd:responsibleAgent ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#inverseOf> lawd:responsibleFor.
lawd:responsibleFor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment """Connects any kind of author or creator to the work he/she/it is
      responsible for creating. The author may be anonymous or fictional."""@en;
                    rdfs:domain [<http://www.w3.org/2002/07/owl#someValuesFrom> lawd:Agent ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> lawd:responsibleFor ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> lawd:Agent ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> lawd:responsibleFor ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
lawd:transposition a lawd:Reading,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
                   <http://www.w3.org/2004/02/skos/core#broader> lawd:variant;
                   <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:uncertainReading a lawd:Reading,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>;
                      <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:variant a lawd:Reading,
               <http://www.w3.org/2002/07/owl#NamedIndividual>;
             <http://www.w3.org/2004/02/skos/core#inScheme> lawd:readingScheme.
lawd:variantForm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "Indicates a variant form of a lawd:Name"@en;
                 rdfs:domain lawd:Name;
                 rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topDataProperty>.
lawd:where a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "Generic location relation."@en;
           rdfs:range lawd:Place.
lawd:witness a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "(Experimental) Connects an item in a collation to the witness it derives from."@en;
             rdfs:domain lawd:CollationItem;
             rdfs:range lawd:Siglum.
