@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix time: <http://www.w3.org/2006/time#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix timeline: <http://purl.org/NET/c4dm/timeline.owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

<http://moustaki.org/foaf.rdf#moustaki> a foaf:Person.
<http://purl.org/NET/c4dm/timeline.owl> a owl:Thing,
                                          owl:Ontology;
                                        rdfs:comment """
    	Extends owl-time ontology (http://www.w3.org/2006/time) with  
	support for several timelines, acting as a backbone to adress 
	time interval/instants. 

	Mainly designed with a multimedia use-case in mind.

	Copyright (c) Yves Raimond, Samer Abdallah, Centre for Digital Music, Queen Mary, University of London
	""";
                                        rdfs:label "The Timeline ontology";
                                        owl:imports <http://www.w3.org/2006/time>,
                                                    <http://www.w3.org/2006/time-entry>;
                                        foaf:maker <http://moustaki.org/foaf.rdf#moustaki>.
timeline:AbstractInstant a owl:Class;
                         rdfs:comment "An instant defined on an abstract timeline";
                         rdfs:label "abstract instant";
                         rdfs:subClassOf timeline:Instant;
                         owl:equivalentClass [owl:onProperty timeline:timeline ; 
                                              owl:someValuesFrom timeline:AbstractTimeLine ; 
                                              a owl:Restriction];
                         status:term_status "stable".
timeline:AbstractInterval a owl:Class;
                          rdfs:comment """
	An interval defined on an abstract time-line.
    """;
                          rdfs:label "abstract interval";
                          rdfs:subClassOf timeline:Interval;
                          owl:equivalentClass [owl:onProperty timeline:timeline ; 
                                               owl:someValuesFrom timeline:AbstractTimeLine ; 
                                               a owl:Restriction];
                          status:term_status "stable".
timeline:AbstractTimeLine a owl:Class;
                          rdfs:comment """
    	Abstract time lines may be used as a backbone for Score, Works, ... 
	This allows for TimeLine maps to relate works to a given 
	performance (this part was played at this time).""";
                          rdfs:label "abstract timeline";
                          rdfs:subClassOf timeline:TimeLine;
                          status:term_status "stable".
timeline:ContinuousTimeLine a owl:Class;
                            rdfs:comment "A continuous timeline, like the universal one, or the one backing an analog signal";
                            rdfs:label "continuous timeline";
                            rdfs:subClassOf timeline:TimeLine;
                            owl:disjointWith timeline:DiscreteTimeLine;
                            owl:equivalentClass [owl:unionOf (timeline:PhysicalTimeLine
                                                              timeline:RelativeTimeLine) ; 
                                                 a owl:Class];
                            status:term_status "stable".
timeline:DiscreteInstant a owl:Class;
                         rdfs:comment "An instant defined on a discrete timeline";
                         rdfs:label "discrete instant";
                         rdfs:subClassOf [owl:cardinality "1"^^xsd:int ; 
                                          owl:onProperty timeline:atInt ; 
                                          a owl:Restriction];
                         owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                                                  owl:onProperty timeline:timeline ; 
                                                                  a owl:Restriction]
                                                                  timeline:Instant) ; 
                                              a owl:Class];
                         status:term_status "stable".
timeline:DiscreteInterval a owl:Class;
                          rdfs:comment "An interval defined on a discrete timeline, like the one backing a digital signal";
                          rdfs:label "discrete interval";
                          rdfs:subClassOf [owl:unionOf ([owl:intersectionOf ([owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty time:hasBeginning ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty time:hasEnd ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]
                                                        [owl:intersectionOf ([owl:onProperty timeline:beginsAtInt ; 
                                                                            owl:cardinality "1"^^xsd:int ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty timeline:endsAtInt ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]
                                                        [owl:intersectionOf ([owl:onProperty timeline:beginsAtInt ; 
                                                                            owl:cardinality "1"^^xsd:int ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty timeline:durationInt ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]) ; 
                                           a owl:Class];
                          owl:equivalentClass [owl:intersectionOf ([owl:onProperty timeline:timeline ; 
                                                                   owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                                                   a owl:Restriction]
                                                                   timeline:Interval) ; 
                                               a owl:Class];
                          status:term_status "stable".
timeline:DiscreteTimeLine a owl:Class;
                          rdfs:comment "A discrete time line (like the time line backing a digital signal";
                          rdfs:label "discrete time line";
                          rdfs:subClassOf timeline:TimeLine;
                          owl:disjointWith timeline:ContinuousTimeLine;
                          status:term_status "stable".
timeline:Instant a owl:Class;
                 rdfs:comment "An instant (same as in OWL-Time)";
                 rdfs:label "instant";
                 owl:equivalentClass time:Instant;
                 status:term_status "stable".
timeline:Interval a owl:Class;
                  rdfs:comment "An interval (same as in OWL-Time). Allen's relationships are defined in OWL-Time.";
                  rdfs:label "interval";
                  owl:equivalentClass time:ProperInterval;
                  status:term_status "stable".
timeline:OriginMap a owl:Class;
                   rdfs:comment "A timeline map linking a physical timeline to a relative one (originating at some point on the physical timeline)";
                   rdfs:label "origin map";
                   rdfs:subClassOf timeline:TimeLineMap,
                                   [owl:onProperty timeline:domainTimeLine ; 
                                    owl:someValuesFrom timeline:PhysicalTimeLine ; 
                                    a owl:Restriction],
                                   [owl:onProperty timeline:rangeTimeLine ; 
                                    owl:someValuesFrom timeline:RelativeTimeLine ; 
                                    a owl:Restriction];
                   status:term_status "stable".
timeline:PhysicalTimeLine a owl:Class;
                          rdfs:comment """A \"physical\" time-line (the universal time line (UTC)) is an instance of this class. Other time zones consists in instances of this class as well, with a \"shifting\" time line map relating them to the universal time line map.""";
                          rdfs:label "physical timeline";
                          rdfs:subClassOf timeline:ContinuousTimeLine;
                          owl:disjointWith timeline:RelativeTimeLine;
                          status:term_status "stable".
timeline:RelativeInstant a owl:Class;
                         rdfs:comment "An instant defined on a relative timeline";
                         rdfs:label "relative instant";
                         rdfs:subClassOf [owl:onProperty timeline:atDuration ; 
                                          owl:cardinality "1"^^xsd:int ; 
                                          a owl:Restriction];
                         owl:equivalentClass [owl:intersectionOf ([owl:onProperty timeline:timeline ; 
                                                                  owl:someValuesFrom timeline:RelativeTimeLine ; 
                                                                  a owl:Restriction]
                                                                  timeline:Instant) ; 
                                              a owl:Class];
                         status:term_status "stable".
timeline:RelativeInterval a owl:Class;
                          rdfs:comment "an interval defined on a relative timeline";
                          rdfs:label "relative interval";
                          rdfs:subClassOf [owl:unionOf ([owl:intersectionOf ([owl:onProperty time:hasBeginning ; 
                                                                            owl:cardinality "1"^^xsd:int ; 
                                                                            a owl:Restriction]
                                                                            [owl:onProperty time:hasEnd ; 
                                                                            owl:cardinality "1"^^xsd:int ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]
                                                        [owl:intersectionOf ([owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty timeline:beginsAtDuration ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty timeline:durationXSD ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]
                                                        [owl:intersectionOf ([owl:onProperty timeline:beginsAtDuration ; 
                                                                            owl:cardinality "1"^^xsd:int ; 
                                                                            a owl:Restriction]
                                                                            [owl:cardinality "1"^^xsd:int ; 
                                                                            owl:onProperty timeline:endsAtDuration ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class]) ; 
                                           a owl:Class];
                          owl:equivalentClass [owl:intersectionOf ([owl:onProperty timeline:timeline ; 
                                                                   owl:someValuesFrom timeline:RelativeTimeLine ; 
                                                                   a owl:Restriction]
                                                                   timeline:Interval) ; 
                                               a owl:Class];
                          status:term_status "stable".
timeline:RelativeTimeLine a owl:Class;
                          rdfs:comment "Semi infinite time line...canonical coordinate system --> adressed through xsd:duration since the instant 0.";
                          rdfs:label "relative timeline";
                          rdfs:subClassOf timeline:ContinuousTimeLine;
                          owl:disjointWith timeline:PhysicalTimeLine;
                          status:term_status "stable".
timeline:ShiftMap a owl:Class;
                  rdfs:comment "a map just shifting one timeline to another";
                  rdfs:label "shift map";
                  rdfs:subClassOf timeline:TimeLineMap;
                  status:term_status "stable".
timeline:TimeLine a owl:Class;
                  rdfs:comment """Represents a linear and coherent piece of time -- can be either abstract (such as the one behind a score) or concrete (such as the universal time line).
Two timelines can be mapped using timeline maps.""";
                  rdfs:label "timeline";
                  status:term_status "stable".
timeline:TimeLineMap a owl:Class;
                     rdfs:comment "Allows to map two time lines together";
                     rdfs:label "timeline map";
                     status:term_status "stable".
timeline:UTInstant a owl:Class;
                   rdfs:comment "This concept expresses that an instant defined on the universal timeline must be associated to a dateTime value";
                   rdfs:label "instant on the universal timeline";
                   rdfs:subClassOf [owl:onProperty timeline:atDateTime ; 
                                    owl:cardinality "1"^^xsd:int ; 
                                    a owl:Restriction];
                   owl:equivalentClass [owl:intersectionOf ([owl:onProperty timeline:timeline ; 
                                                            owl:hasValue timeline:universaltimeline ; 
                                                            a owl:Restriction]
                                                            timeline:Instant) ; 
                                        a owl:Class];
                   status:term_status "stable".
timeline:UTInterval a owl:Class;
                    rdfs:comment "an interval defined on the universal time line";
                    rdfs:label "universal timeline interval";
                    rdfs:subClassOf [owl:unionOf ([owl:cardinality "1"^^xsd:int ; 
                                                  owl:onProperty timeline:atYear ; 
                                                  a owl:Restriction]
                                                  [owl:cardinality "1"^^xsd:int ; 
                                                  owl:onProperty timeline:atYearMonth ; 
                                                  a owl:Restriction]
                                                  [owl:onProperty timeline:atDate ; 
                                                  owl:cardinality "1"^^xsd:int ; 
                                                  a owl:Restriction]
                                                  [owl:intersectionOf ([owl:cardinality "1"^^xsd:int ; 
                                                                      owl:onProperty timeline:beginsAtDateTime ; 
                                                                      a owl:Restriction]
                                                                      [owl:onProperty timeline:durationXSD ; 
                                                                      owl:cardinality "1"^^xsd:int ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class]
                                                  [owl:intersectionOf ([owl:onProperty time:hasBeginning ; 
                                                                      owl:cardinality "1"^^xsd:int ; 
                                                                      a owl:Restriction]
                                                                      [owl:onProperty time:hasEnd ; 
                                                                      owl:cardinality "1"^^xsd:int ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class]
                                                  [owl:intersectionOf ([owl:cardinality "1"^^xsd:int ; 
                                                                      owl:onProperty timeline:beginsAtDateTime ; 
                                                                      a owl:Restriction]
                                                                      [owl:cardinality "1"^^xsd:int ; 
                                                                      owl:onProperty timeline:endsAtDateTime ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class]) ; 
                                     a owl:Class];
                    owl:equivalentClass [owl:intersectionOf ([owl:hasValue timeline:universaltimeline ; 
                                                             owl:onProperty timeline:timeline ; 
                                                             a owl:Restriction]
                                                             timeline:Interval) ; 
                                         a owl:Class];
                    status:term_status "stable".
timeline:UniformSamplingMap a owl:Class;
                            rdfs:comment "Describe the relation between a continuous time-line and its sampled equivalent";
                            rdfs:label "uniform sampling map";
                            rdfs:subClassOf [owl:onProperty timeline:sampleRate ; 
                                             owl:cardinality "1"^^xsd:int ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                             owl:onProperty timeline:rangeTimeLine ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom timeline:RelativeTimeLine ; 
                                             owl:onProperty timeline:domainTimeLine ; 
                                             a owl:Restriction],
                                            timeline:TimeLineMap;
                            owl:disjointWith timeline:UniformWindowingMap,
                                             timeline:UniformSamplingWindowingMap;
                            status:term_status "stable".
timeline:UniformSamplingWindowingMap a owl:Class;
                                     rdfs:comment "Describes the relation between a continuous time-line, and a time-line that corresponds to its sampled and windowed equivalent";
                                     rdfs:label "Uniform sampling and windowing map";
                                     rdfs:subClassOf [owl:onProperty timeline:windowLength ; 
                                                      owl:cardinality "1"^^xsd:int ; 
                                                      a owl:Restriction],
                                                     [owl:onProperty timeline:sampleRate ; 
                                                      owl:cardinality "1"^^xsd:int ; 
                                                      a owl:Restriction],
                                                     [owl:onProperty timeline:rangeTimeLine ; 
                                                      owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                                      a owl:Restriction],
                                                     [owl:onProperty timeline:hopSize ; 
                                                      owl:cardinality "1"^^xsd:int ; 
                                                      a owl:Restriction],
                                                     timeline:TimeLineMap,
                                                     [owl:someValuesFrom timeline:ContinuousTimeLine ; 
                                                      owl:onProperty timeline:domainTimeLine ; 
                                                      a owl:Restriction];
                                     owl:disjointWith timeline:UniformSamplingMap,
                                                      timeline:UniformWindowingMap;
                                     status:term_status "stable".
timeline:UniformWindowingMap a owl:Class;
                             rdfs:comment "Describes the relation between a discrete time line and its windowed equivalent";
                             rdfs:label "uniform windowing map";
                             rdfs:subClassOf [owl:onProperty timeline:windowLength ; 
                                              owl:cardinality "1"^^xsd:int ; 
                                              a owl:Restriction],
                                             [owl:onProperty timeline:rangeTimeLine ; 
                                              owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom timeline:DiscreteTimeLine ; 
                                              owl:onProperty timeline:domainTimeLine ; 
                                              a owl:Restriction],
                                             timeline:TimeLineMap,
                                             [owl:onProperty timeline:hopSize ; 
                                              owl:cardinality "1"^^xsd:int ; 
                                              a owl:Restriction];
                             owl:disjointWith timeline:UniformSamplingWindowingMap,
                                              timeline:UniformSamplingMap;
                             status:term_status "stable".
timeline:after a owl:ObjectProperty;
               owl:equivalentProperty time:intervalAfter.
timeline:at a owl:DatatypeProperty,
              owl:FunctionalProperty;
            rdfs:comment "refers to a point or an interval on the time line, through an explicit datatype";
            rdfs:domain [owl:unionOf (timeline:Interval
                                      timeline:Instant) ; 
                         a owl:Class];
            rdfs:label "at";
            status:term_status "stable".
timeline:atDate a owl:DatatypeProperty;
                rdfs:comment "A subproperty of :at, allowing to address a date (beginning of it for an instant, all of it for an interval)";
                rdfs:label "at (date)";
                rdfs:range xsd:date;
                rdfs:subPropertyOf timeline:at;
                status:term_status "stable".
timeline:atDateTime a owl:DatatypeProperty;
                    rdfs:comment "This property links an instant defined on the universal time line to an XSD date/time value";
                    rdfs:label "at date/time";
                    rdfs:range xsd:dateTime;
                    rdfs:subPropertyOf timeline:at;
                    status:term_status "stable".
timeline:atDuration a owl:DatatypeProperty;
                    rdfs:comment "A property enabling to adress a time point P through the duration of the interval [0,P] on a continuous timeline";
                    rdfs:label "at (duration)";
                    rdfs:range xsd:duration;
                    rdfs:subPropertyOf timeline:at;
                    status:term_status "stable".
timeline:atInt a owl:DatatypeProperty;
               rdfs:comment "A subproperty of :at, having as a specific range xsd:int";
               rdfs:label "at (integer)";
               rdfs:range xsd:int;
               rdfs:subPropertyOf timeline:at;
               status:term_status "stable".
timeline:atReal a owl:DatatypeProperty;
                rdfs:comment "subproperty of :at, having xsd:float as a range";
                rdfs:label "at (real)";
                rdfs:range xsd:float;
                rdfs:subPropertyOf timeline:at;
                status:term_status "stable".
timeline:atYear a owl:DatatypeProperty;
                rdfs:comment "A subproperty of :at, allowing to address a year (beginning of it for an instant, all of it for an interval)";
                rdfs:label "at (year)";
                rdfs:range xsd:gYear;
                rdfs:subPropertyOf timeline:at;
                status:term_status "stable".
timeline:atYearMonth a owl:DatatypeProperty;
                     rdfs:comment "A subproperty of :at, allowing to address a year/month (beginning of it for an instant, all of it for an interval)";
                     rdfs:label "at (year/month)";
                     rdfs:range xsd:gYearMonth;
                     rdfs:subPropertyOf timeline:at;
                     status:term_status "stable".
timeline:before a owl:ObjectProperty;
                owl:equivalentProperty time:intervalBefore.
timeline:beginsAt a owl:DatatypeProperty;
                  owl:equivalentProperty timeline:start.
timeline:beginsAtDateTime a owl:DatatypeProperty;
                          rdfs:comment "A subproperty of :beginsAt, allowing to address the beginning of an interval as a date/time";
                          rdfs:label "begins at (date/time)";
                          rdfs:range xsd:dateTime;
                          rdfs:subPropertyOf timeline:start;
                          status:term_status "stable".
timeline:beginsAtDuration a owl:DatatypeProperty;
                          rdfs:comment "A property enabling to adress a start time point P of an interval [P,E] through the duration of the interval [0,P] on a continuous timeline";
                          rdfs:label "begins at (xsd:duration)";
                          rdfs:range xsd:duration;
                          rdfs:subPropertyOf timeline:start;
                          status:term_status "stable".
timeline:beginsAtInt a owl:DatatypeProperty;
                     rdfs:comment "A subproperty of :beginsAt, having xsd:int as a range";
                     rdfs:label "begins at (integer)";
                     rdfs:range xsd:int;
                     rdfs:subPropertyOf timeline:start;
                     status:term_status "stable".
timeline:contains a owl:ObjectProperty;
                  owl:equivalentProperty time:intervalContains.
timeline:delay a owl:DatatypeProperty,
                 owl:FunctionalProperty;
               rdfs:comment "associate a shift map to a particular delay";
               rdfs:domain timeline:ShiftMap;
               rdfs:label "delay";
               status:term_status "stable".
timeline:domainTimeLine a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:comment "associates a timeline map to its domain timeline";
                        rdfs:domain timeline:TimeLineMap;
                        rdfs:label "domain timeline";
                        rdfs:range timeline:TimeLine;
                        status:term_status "stable".
timeline:duration a owl:DatatypeProperty;
                  rdfs:comment "the duration of a time interval";
                  rdfs:domain timeline:Interval;
                  rdfs:label "duration";
                  status:term_status "stable".
timeline:durationInt a owl:DatatypeProperty;
                     rdfs:comment "A subproperty of :duration, having xsd:int as a range";
                     rdfs:label "duration (integer)";
                     rdfs:range xsd:int;
                     rdfs:subPropertyOf timeline:duration;
                     status:term_status "stable".
timeline:durationXSD a owl:DatatypeProperty;
                     rdfs:comment "A subproperty of :duration, having xsd:duration as a range";
                     rdfs:label "duration (xsd:duration)";
                     rdfs:range xsd:duration;
                     rdfs:subPropertyOf timeline:duration;
                     status:term_status "stable".
timeline:during a owl:ObjectProperty;
                owl:equivalentProperty time:intervalDuring.
timeline:end a owl:DatatypeProperty;
             rdfs:comment "refers to the end of a time interval, through an explicit datatype. time:hasEnd can be used as well, if you want to associate the end of the interval to an explicit time point resource";
             rdfs:domain timeline:Interval;
             rdfs:label "ends at";
             status:term_status "stable".
timeline:endsAt a owl:DatatypeProperty;
                owl:equivalentProperty timeline:end.
timeline:endsAtDateTime a owl:DatatypeProperty;
                        rdfs:comment "A subproperty of :endsAt, allowing to address the end of an interval as a date/time";
                        rdfs:label "ends at (date/time)";
                        rdfs:range xsd:dateTime;
                        rdfs:subPropertyOf timeline:end;
                        status:term_status "stable".
timeline:endsAtDuration a owl:DatatypeProperty;
                        rdfs:comment "A property enabling to adress an end time point P of an interval [S,P] through the duration of the interval [0,P] on a continuous timeline";
                        rdfs:label "ends at (xsd:duration)";
                        rdfs:range xsd:duration;
                        rdfs:subPropertyOf timeline:end;
                        status:term_status "stable".
timeline:endsAtInt a owl:DatatypeProperty;
                   rdfs:comment "A subproperty of :endsAt, having xsd:int as a range";
                   rdfs:label "ends at (integer)";
                   rdfs:range xsd:int;
                   rdfs:subPropertyOf timeline:end;
                   status:term_status "stable".
timeline:equals a owl:ObjectProperty;
                owl:equivalentProperty time:intervalEquals.
timeline:finishedBy a owl:ObjectProperty;
                    owl:equivalentProperty time:intervalFinishedBy.
timeline:finishes a owl:ObjectProperty;
                  owl:equivalentProperty time:intervalFinishes.
timeline:hopSize a owl:DatatypeProperty,
                   owl:FunctionalProperty;
                 rdfs:comment "hop size, associated to a uniform windowing map";
                 rdfs:domain [owl:unionOf (timeline:UniformWindowingMap
                                           timeline:UniformSamplingWindowingMap) ; 
                              a owl:Class];
                 rdfs:label "hop size";
                 rdfs:range xsd:int;
                 status:term_status "stable".
timeline:meets a owl:ObjectProperty;
               owl:equivalentProperty time:intervalMeets.
timeline:metBy a owl:ObjectProperty;
               owl:equivalentProperty time:intervalMetBy.
timeline:onTimeLine a owl:ObjectProperty;
                    owl:equivalentProperty timeline:timeline.
timeline:origin a owl:DatatypeProperty,
                  owl:FunctionalProperty;
                rdfs:comment "associate an origin map to its origin on the domain physical timeline";
                rdfs:domain timeline:OriginMap;
                rdfs:label "origin";
                rdfs:range xsd:dateTime;
                status:term_status "stable".
timeline:overlappedBy a owl:ObjectProperty;
                      owl:equivalentProperty time:intervalOverlappedBy.
timeline:overlaps a owl:ObjectProperty;
                  owl:equivalentProperty time:intervalOverlaps.
timeline:rangeTimeLine a owl:ObjectProperty,
                         owl:FunctionalProperty;
                       rdfs:comment "associates a timeline map to its range timeline";
                       rdfs:domain timeline:TimeLineMap;
                       rdfs:label "range timeline";
                       rdfs:range timeline:TimeLine;
                       status:term_status "stable".
timeline:sampleRate a owl:DatatypeProperty,
                      owl:FunctionalProperty;
                    rdfs:comment "associates a sample rate value to a uniform sampling map";
                    rdfs:domain [owl:unionOf (timeline:UniformSamplingMap
                                              timeline:UniformSamplingWindowingMap) ; 
                                 a owl:Class];
                    rdfs:label "sample rate";
                    rdfs:range xsd:int;
                    status:term_status "stable".
timeline:start a owl:DatatypeProperty;
               rdfs:comment "refers to the beginning of a time interval, through an explicit datatype. time:hasBeginning can be used as well, if you want to associate the beginning of the interval to an explicit time point resource";
               rdfs:domain timeline:Interval;
               rdfs:label "begins at";
               status:term_status "stable".
timeline:startedBy a owl:ObjectProperty;
                   owl:equivalentProperty time:intervalStartedBy.
timeline:starts a owl:ObjectProperty;
                owl:equivalentProperty time:intervalStarts.
timeline:timeline a owl:ObjectProperty,
                    owl:FunctionalProperty;
                  rdfs:comment """
	Relates an interval or an instant to the timeline on which it is defined.

	The 29th of August, 2007 would be linked through this property to the universal timeline, whereas
	\"from 2s to 5s on this particular signal\" would be defined on the signal' timeline.

    """;
                  rdfs:domain [owl:unionOf (timeline:Instant
                                            timeline:Interval) ; 
                               a owl:Class];
                  rdfs:label "on timeline";
                  rdfs:range timeline:TimeLine;
                  status:term_status "stable".
timeline:universaltimeline dc11:description """The timeline one can addresss \"the 1st of July, 2007\"""";
                           dc11:title "the universal time line";
                           a timeline:PhysicalTimeLine;
                           rdfs:comment "this is the `universal' time line -- can adress time intervals on it using date/dateTime -- UTC";
                           status:term_status "stable".
timeline:windowLength a owl:DatatypeProperty,
                        owl:FunctionalProperty;
                      rdfs:comment "window length, associated to a uniform windowing map";
                      rdfs:domain [owl:unionOf (timeline:UniformWindowingMap
                                                timeline:UniformSamplingWindowingMap) ; 
                                   a owl:Class];
                      rdfs:label "window length";
                      rdfs:range xsd:int;
                      status:term_status "stable".
dc11:description a owl:DatatypeProperty.
dc11:title a owl:DatatypeProperty.
status:term_status a owl:AnnotationProperty.
foaf:Person a owl:Class.
foaf:maker a owl:ObjectProperty.
