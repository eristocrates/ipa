@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix iao: <http://purl.obolibrary.org/obo/IAO_>.
@prefix cmo: <http://purl.org/twc/ontologies/cmo.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix pobo: <http://purl.obolibrary.org/obo/>.

iao:0000030 a owl:Class.
iao:0000136 a owl:ObjectProperty.
<http://purl.org/twc/ontologies/cmo.owl> a owl:Ontology;
                                         owl:imports <http://www.w3.org/TR/skos-reference/skos-owl1-dl.rdf>,
                                                     pobo:iao.owl.
cmo:Quality a owl:Class;
            rdfs:comment "The conceputal representation of anything that is a property (a thing that is inherent in an entity, like eye color) or an attribute (a thing that has been assigned, or attributed, to an entity, like name or identification number).";
            rdfs:label "Quality";
            rdfs:subClassOf skos:Concept.
cmo:Relation a owl:Class;
             rdfs:comment "A concept representing the relationship between two independent entities.";
             rdfs:label "Relation";
             rdfs:subClassOf skos:Concept.
cmo:Type a owl:Class;
         rdfs:comment "An abstract or general idea inferred or derived from specific instances, representing a set of those instances.";
         rdfs:label "Type";
         rdfs:subClassOf skos:Concept.
cmo:Universal a owl:Class;
              rdfs:comment """Entities that describe the objects, processes, qualities, states, 
etc. in reality (for example on the side of the patient); (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)""";
              rdfs:label "Universal";
              rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
              rdfs:subClassOf [owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                               owl:onClass skos:Concept ; 
                               owl:onProperty cmo:representedBy ; 
                               a owl:Restriction],
                              <http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant>.
cmo:UniversalClass a owl:Class;
                   rdfs:comment """Universal (natural) sets of objects, processes, qualities, states, 
etc. in reality (for example on the side of the patient); (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)""";
                   rdfs:label "Universal Class";
                   rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
                   rdfs:subClassOf [owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                    owl:onClass cmo:Type ; 
                                    owl:onProperty cmo:representedBy ; 
                                    a owl:Restriction],
                                   cmo:Universal.
cmo:UniversalQuality a owl:Class;
                     rdfs:label "Universal Quality";
                     rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>,
                                  "Qualities in reality. (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)";
                     rdfs:subClassOf [owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                      owl:onClass cmo:Quality ; 
                                      owl:onProperty cmo:representedBy ; 
                                      a owl:Restriction],
                                     cmo:Universal.
cmo:UniversalRelation a owl:Class;
                      rdfs:comment "Relationships in reality. (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)";
                      rdfs:label "Universal Relation";
                      rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
                      rdfs:subClassOf [owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                       owl:onClass cmo:Relation ; 
                                       owl:onProperty cmo:representedBy ; 
                                       a owl:Restriction],
                                      cmo:Universal.
cmo:hasPrimaryConcept a owl:ObjectProperty;
                      rdfs:label "has primary concept";
                      rdfs:subPropertyOf skos:broadMatch.
cmo:hasQualifier a owl:ObjectProperty;
                 rdfs:label "has qualifying concept";
                 rdfs:subPropertyOf skos:broadMatch.
cmo:hasQuality a owl:ObjectProperty;
               rdfs:comment "A conceptual type can have qualities that describe it.";
               rdfs:domain cmo:Type;
               rdfs:label "has quality";
               rdfs:range cmo:Quality;
               rdfs:subPropertyOf skos:relatedMatch.
cmo:hasRole a owl:ObjectProperty;
            rdfs:domain cmo:Relation;
            rdfs:label "has role";
            rdfs:range cmo:Type;
            rdfs:subPropertyOf skos:relatedMatch.
cmo:hasRoleIn a owl:ObjectProperty;
              rdfs:domain cmo:Type;
              rdfs:label "has role in relation";
              rdfs:range cmo:Relation;
              rdfs:subPropertyOf skos:relatedMatch;
              owl:inverseOf cmo:hasRole.
cmo:hasSourceRole a owl:ObjectProperty;
                  rdfs:domain cmo:Relation;
                  rdfs:label "has source role";
                  rdfs:range cmo:Type;
                  rdfs:subPropertyOf cmo:hasRole.
cmo:hasSourceRoleIn a owl:ObjectProperty;
                    rdfs:domain cmo:Type;
                    rdfs:label "has source role in relation";
                    rdfs:range cmo:Relation;
                    rdfs:subPropertyOf cmo:hasRoleIn;
                    owl:inverseOf cmo:hasSourceRole.
cmo:hasTargetRole a owl:ObjectProperty;
                  rdfs:domain cmo:Relation;
                  rdfs:label "has target role";
                  rdfs:range cmo:Type;
                  rdfs:subPropertyOf cmo:hasRole.
cmo:hasTargetRoleIn a owl:ObjectProperty;
                    rdfs:domain cmo:Type;
                    rdfs:label "has target role in relation";
                    rdfs:range cmo:Relation;
                    rdfs:subPropertyOf cmo:hasRoleIn;
                    owl:inverseOf cmo:hasTargetRole.
<http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf> a owl:Thing.
cmo:qualityOf a owl:ObjectProperty;
              rdfs:domain cmo:Quality;
              rdfs:label "is quality of";
              rdfs:range cmo:Type;
              rdfs:subPropertyOf skos:relatedMatch;
              owl:inverseOf cmo:hasQuality.
cmo:representedBy a owl:ObjectProperty;
                  rdfs:comment "Things in the real world can be represented by concepts. This is a link between the concepts and the things those concepts represent. Things, including sets of things, are represented by concepts.";
                  rdfs:domain <http://www.ifomis.org/bfo/1.1#Entity>;
                  rdfs:label "represented by";
                  rdfs:range skos:Concept.
cmo:represents a owl:ObjectProperty;
               rdfs:comment "Things in the real world can be represented by concepts. This is a link from the concepts and the things those concepts represent. Concepts represent things.";
               rdfs:domain skos:Concept;
               rdfs:label "represents";
               rdfs:range <http://www.ifomis.org/bfo/1.1#Entity>;
               rdfs:subPropertyOf iao:0000136;
               owl:inverseOf cmo:representedBy.
cmo:representsUniversal a owl:IrreflexiveProperty,
                          owl:ObjectProperty;
                        rdfs:comment "Concepts represent universals in the world.";
                        rdfs:label "represents universal";
                        rdfs:range cmo:Universal;
                        rdfs:subPropertyOf cmo:represents.
cmo:valuesCanBe a owl:ObjectProperty;
                rdfs:domain cmo:Quality;
                rdfs:label "values can be";
                rdfs:range skos:Concept;
                rdfs:subPropertyOf skos:relatedMatch.
<http://www.ifomis.org/bfo/1.1#Entity> a owl:Class.
<http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant> a owl:Class.
owl:Thing a owl:Class.
skos:Concept a owl:Class;
             rdfs:subClassOf iao:0000030.
skos:broadMatch a owl:ObjectProperty.
skos:broader a owl:ObjectProperty.
skos:broaderTransitive a owl:ObjectProperty;
                       owl:propertyChainAxiom (skos:exactMatch
                                               skos:broader).
skos:exactMatch a owl:ObjectProperty.
skos:relatedMatch a owl:ObjectProperty.
