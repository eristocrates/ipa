@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cmo: <http://purl.org/twc/ontologies/cmo.owl#>.

<http://purl.obolibrary.org/obo/IAO_0000030> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.obolibrary.org/obo/IAO_0000136> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://purl.org/twc/ontologies/cmo.owl> a <http://www.w3.org/2002/07/owl#Ontology>;
                                         <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/TR/skos-reference/skos-owl1-dl.rdf>,
                                                                                 <http://purl.obolibrary.org/obo/iao.owl>.
cmo:Quality a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The conceputal representation of anything that is a property (a thing that is inherent in an entity, like eye color) or an attribute (a thing that has been assigned, or attributed, to an entity, like name or identification number).";
            rdfs:label "Quality";
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
cmo:Relation a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A concept representing the relationship between two independent entities.";
             rdfs:label "Relation";
             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
cmo:Type a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "An abstract or general idea inferred or derived from specific instances, representing a set of those instances.";
         rdfs:label "Type";
         rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
cmo:Universal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """Entities that describe the objects, processes, qualities, states, 
etc. in reality (for example on the side of the patient); (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)""";
              rdfs:label "Universal";
              rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2004/02/skos/core#Concept> ; 
                               <http://www.w3.org/2002/07/owl#onProperty> cmo:representedBy ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant>.
cmo:UniversalClass a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment """Universal (natural) sets of objects, processes, qualities, states, 
etc. in reality (for example on the side of the patient); (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)""";
                   rdfs:label "Universal Class";
                   rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                    <http://www.w3.org/2002/07/owl#onClass> cmo:Type ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> cmo:representedBy ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   cmo:Universal.
cmo:UniversalQuality a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "Universal Quality";
                     rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>,
                                  "Qualities in reality. (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                      <http://www.w3.org/2002/07/owl#onClass> cmo:Quality ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> cmo:representedBy ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     cmo:Universal.
cmo:UniversalRelation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Relationships in reality. (from http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf)";
                      rdfs:label "Universal Relation";
                      rdfs:seeAlso <http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf>;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minQualifiedCardinality> "0"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onClass> cmo:Relation ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> cmo:representedBy ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      cmo:Universal.
cmo:hasPrimaryConcept a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:label "has primary concept";
                      rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broadMatch>.
cmo:hasQualifier a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "has qualifying concept";
                 rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#broadMatch>.
cmo:hasQuality a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "A conceptual type can have qualities that describe it.";
               rdfs:domain cmo:Type;
               rdfs:label "has quality";
               rdfs:range cmo:Quality;
               rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#relatedMatch>.
cmo:hasRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain cmo:Relation;
            rdfs:label "has role";
            rdfs:range cmo:Type;
            rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#relatedMatch>.
cmo:hasRoleIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain cmo:Type;
              rdfs:label "has role in relation";
              rdfs:range cmo:Relation;
              rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#relatedMatch>;
              <http://www.w3.org/2002/07/owl#inverseOf> cmo:hasRole.
cmo:hasSourceRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain cmo:Relation;
                  rdfs:label "has source role";
                  rdfs:range cmo:Type;
                  rdfs:subPropertyOf cmo:hasRole.
cmo:hasSourceRoleIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain cmo:Type;
                    rdfs:label "has source role in relation";
                    rdfs:range cmo:Relation;
                    rdfs:subPropertyOf cmo:hasRoleIn;
                    <http://www.w3.org/2002/07/owl#inverseOf> cmo:hasSourceRole.
cmo:hasTargetRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain cmo:Relation;
                  rdfs:label "has target role";
                  rdfs:range cmo:Type;
                  rdfs:subPropertyOf cmo:hasRole.
cmo:hasTargetRoleIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain cmo:Type;
                    rdfs:label "has target role in relation";
                    rdfs:range cmo:Relation;
                    rdfs:subPropertyOf cmo:hasRoleIn;
                    <http://www.w3.org/2002/07/owl#inverseOf> cmo:hasTargetRole.
<http://purl.org/twc/ontologies/cmo.owl#http://ontology.buffalo.edu/bfo/Terminology_for_Ontologies.pdf> a <http://www.w3.org/2002/07/owl#Thing>.
cmo:qualityOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain cmo:Quality;
              rdfs:label "is quality of";
              rdfs:range cmo:Type;
              rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#relatedMatch>;
              <http://www.w3.org/2002/07/owl#inverseOf> cmo:hasQuality.
cmo:representedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Things in the real world can be represented by concepts. This is a link between the concepts and the things those concepts represent. Things, including sets of things, are represented by concepts.";
                  rdfs:domain <http://www.ifomis.org/bfo/1.1#Entity>;
                  rdfs:label "represented by";
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
cmo:represents a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Things in the real world can be represented by concepts. This is a link from the concepts and the things those concepts represent. Concepts represent things.";
               rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
               rdfs:label "represents";
               rdfs:range <http://www.ifomis.org/bfo/1.1#Entity>;
               rdfs:subPropertyOf <http://purl.obolibrary.org/obo/IAO_0000136>;
               <http://www.w3.org/2002/07/owl#inverseOf> cmo:representedBy.
cmo:representsUniversal a <http://www.w3.org/2002/07/owl#IrreflexiveProperty>,
                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Concepts represent universals in the world.";
                        rdfs:label "represents universal";
                        rdfs:range cmo:Universal;
                        rdfs:subPropertyOf cmo:represents.
cmo:valuesCanBe a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain cmo:Quality;
                rdfs:label "values can be";
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#relatedMatch>.
<http://www.ifomis.org/bfo/1.1#Entity> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ifomis.org/bfo/1.1/snap#IndependentContinuant> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2004/02/skos/core#Concept> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030>.
<http://www.w3.org/2004/02/skos/core#broadMatch> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2004/02/skos/core#broader> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2004/02/skos/core#broaderTransitive> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (<http://www.w3.org/2004/02/skos/core#exactMatch>
                                                                                                            <http://www.w3.org/2004/02/skos/core#broader>).
<http://www.w3.org/2004/02/skos/core#exactMatch> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2004/02/skos/core#relatedMatch> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
