                  holy:ManufacturingOrganization;
                rdfs:comment "EvoBus GmbH is a German bus and coach manufacturer headquartered in Stuttgart, Germany and a wholly owned subsidiary of . Its products go to market under the brands Setra or Mercedes-Benz."@en;
                rdfs:label "EvoBus"@en;
                skos:altLabel "EvoBus GmbH"@en;
