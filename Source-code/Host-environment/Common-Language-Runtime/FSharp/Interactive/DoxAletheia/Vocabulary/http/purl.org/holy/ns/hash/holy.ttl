              rdfs:label "Zimbabwe"@en.
holy:applicationSoldIn a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:IrreflexiveProperty;
                       rdfs:domain holy:Application;
                       rdfs:label "application sold in"@en;
                       rdfs:range holy:GeographicMarket;
                       owl:inverseOf holy:hasApplication;
                       skos:altLabel "available in"@en;
                       skos:definition "Defines in which geographic market an application is sold or available for use."@en.
holy:hasApplication a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain holy:GeographicMarket;
                    rdfs:label "has Application"@en;
                    rdfs:range holy:Application;
                    skos:definition "Relates to the geographic location of applications in the market."@en.
holy:hasIndicator a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:comment "In the hydrogen ontology, all major classes (organization, project, application, geographical market and product) are linked to the class indicator."@en;
                  rdfs:domain [owl:unionOf (holy:Application
                                            holy:GeographicMarket
                                            holy:Product
                                            schema:Project
                                            org:Organization) ; 
                               a owl:Class];
                  rdfs:label "has Indicator"@en;
                  rdfs:range holy:Indicator;
                  skos:definition "Refers to indicators which are related to a certain class."@en.
holy:hasOrganization a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:domain holy:GeographicMarket;
                     rdfs:label "has Organization"@en;
                     rdfs:range org:Organization;
                     owl:inverseOf holy:participatesIn;
                     owl:propertyChainAxiom ([owl:inverseOf dbpedia-owl:continent]
                                             holy:hasOrganization);
                     skos:definition "Indicates a direkt link from a geographic location to an organization. It shows where a organization is located."@en.
holy:hasProduct a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain holy:GeographicMarket;
                rdfs:label "has Product"@en;
                rdfs:range holy:Product;
                owl:inverseOf holy:productSoldIn;
                skos:definition "Indicates a direkt link from a geographic location to a product. It shows where a product is located."@en.
holy:hasProject a owl:ObjectProperty,
                  owl:AsymmetricProperty,
                  owl:IrreflexiveProperty;
                rdfs:domain holy:GeographicMarket;
                rdfs:label "has Project"@en;
                rdfs:range schema:Project;
                skos:definition "Relates to the geographic location of projects in the market."@en.
holy:isProducedBy a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:comment "The inverse of holy:producesProduct"@en;
                  rdfs:domain holy:Product;
                  rdfs:label "is produced by"@en;
                  rdfs:range org:Organization;
                  owl:inverseOf holy:producesProduct;
                  skos:definition "Indicates which products are manufactured by a given organization."@en.
holy:isProvidedBy a owl:ObjectProperty,
                    owl:AsymmetricProperty,
                    owl:IrreflexiveProperty;
                  rdfs:comment "The inverse of holy:providesApplication"@en;
                  rdfs:domain holy:Application;
                  rdfs:label "is provided by"@en;
                  rdfs:range org:Organization;
                  owl:inverseOf holy:providesApplication;
                  skos:definition "Indicates which applications are related to an organization in terms of manufacturing, operating, licensing, leasing..."@en.
holy:isUsedIn a owl:IrreflexiveProperty,
                owl:AsymmetricProperty,
                owl:ObjectProperty;
              rdfs:comment "Inverse of holy:usesProduct and holy:usesTechnology"@en;
              rdfs:domain holy:Product;
              rdfs:label "is used in"@en;
              rdfs:range holy:Application;
              rdfs:subPropertyOf owl:topObjectProperty;
              owl:inverseOf holy:usesTechnology,
                            holy:usesSource,
                            holy:usesProduct;
              skos:definition "Defines for which purpose a product is used in."@en.
holy:participatesIn a owl:ObjectProperty,
                      owl:AsymmetricProperty,
                      owl:IrreflexiveProperty;
                    rdfs:domain org:Organization;
                    rdfs:label "participates in"@en;
                    rdfs:range holy:GeographicMarket;
                    skos:definition "Defines that an organization participates with presence in a certain geographic market."@en.
holy:producesProduct a owl:ObjectProperty,
                       owl:AsymmetricProperty,
                       owl:IrreflexiveProperty;
                     rdfs:domain org:Organization;
                     rdfs:label "produces Product"@en;
                     rdfs:range holy:Product;
                     skos:definition "Indicates which organization manufactures a given product."@en.
holy:productSoldIn a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:comment "The inverse of holy:hasProduct"@en;
                   rdfs:domain holy:Product;
                   rdfs:label "product sold in"@en;
                   rdfs:range holy:GeographicMarket;
                   skos:definition "Defines in which geographic market a product is sold or available for use."@en.
holy:providesApplication a owl:ObjectProperty,
                           owl:AsymmetricProperty,
                           owl:IrreflexiveProperty;
                         rdfs:comment "The inverse of holy:isProvidedBy"@en;
                         rdfs:domain org:Organization;
                         rdfs:label "provides Application"@en;
                         rdfs:range holy:Application;
                         skos:definition "Indicates which organizations are directly providing applications (the end-usage) to the market either by manufacturing the application or operating, licensing, leasing... it."@en.
holy:relatesToApplication a owl:ObjectProperty,
                            owl:AsymmetricProperty,
                            owl:IrreflexiveProperty;
                          rdfs:domain schema:Project;
                          rdfs:label "relates to Application"@en;
                          rdfs:range holy:Application;
                          skos:definition "Defines that a certain project is in terms of outcome related to an application."@en.
holy:relatesToProduct a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:IrreflexiveProperty;
                      rdfs:domain schema:Project;
                      rdfs:label "relates to Product"@en;
                      rdfs:range holy:Product;
                      skos:definition "Defines that a certain project is in terms of its outcome related to a product."@en.
holy:usesProduct a owl:ObjectProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "Inverse of holy:isUsedIn - Disjoint with holy:usesTechnology"@en;
                 rdfs:domain holy:Application;
                 rdfs:label "uses Product"@en;
                 rdfs:range holy:Product;
                 rdfs:subPropertyOf holy:usesSource;
                 skos:definition "Defines the product used in a particular application"@en.
holy:usesSource a owl:ObjectProperty,
                  owl:IrreflexiveProperty;
                rdfs:comment "Main Property for holy:usesProduct and holy:usesTechnology."@en;
                rdfs:domain holy:Application;
                rdfs:label "uses Source"@en;
                rdfs:range holy:Product.
holy:usesTechnology a owl:ObjectProperty,
                      owl:IrreflexiveProperty;
                    rdfs:comment "Inverse of holy:isUsedIn - Disjoint with holy:usesApplication"@en;
                    rdfs:domain holy:Application;
                    rdfs:label "uses Technology"@en;
                    rdfs:range holy:Product;
                    rdfs:subPropertyOf holy:usesSource;
                    skos:definition "Defines the technology used in a particular application."@en.
bibo:doi a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceURI a owl:AnnotationProperty.
schema:Continent dcterms:references schema:;
                 a owl:Class;
                 rdfs:label "Continent"@en;
                 rdfs:subClassOf [owl:onProperty dbpedia-owl:continent ; 
                                  owl:allValuesFrom schema:Continent ; 
                                  a owl:Restriction],
                                 holy:GeographicMarket;
                 skos:definition "One of the seven large land masses on the earth's surface, surrounded, or mainly surrounded, by sea and usually consisting of various countries."@en.
schema:Country dcterms:references schema:;
               a owl:Class;
               rdfs:label "Country"@en;
               rdfs:subClassOf holy:GeographicMarket;
               skos:definition "An area of land that has its own government, army, etc."@en.
schema:Project dcterms:references <https://www.referenceforbusiness.com/management/Pr-Sa/Project-Management.html>,
                                  <http://www.maxwideman.com/guests/typology/projects.htm>,
                                  schema:,
                                  <https://dictionary.cambridge.org/dictionary/english/project>;
               a owl:Class;
               rdfs:comment "A project can be defined as a piece of planned work consisting of interrelated activities which intends to fulfill a particular purpose within a certain period of time. A project can fulfill several purposes such as in the area of research (research projects), projects dedicated to product development, infrastructure-related projects and more."@en;
               rdfs:label "Project"@en;
               skos:altLabel "Project"@en;
               skos:definition "An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim."@en;
               skos:hiddenLabel "Venture"@en;
               <https://wordnet-rdf.princeton.edu/ontology#hyponym> "Hydrogen Project"@en,
                                                                    "Partnered Project"@en,
                                                                    "Alliance Project"@en.
schema:ResearchProject dcterms:references <http://dx.doi.org/10.13140/RG.2.1.1432.6245>,
                                          "https://dbpedia.org/ontology/ResearchProject"@en,
                                          schema:,
                                          <http://www.maxwideman.com/guests/typology/projects.htm>,
                                          "https://schema.org/ResearchProject"@en;
                       a owl:Class;
                       rdfs:comment "The Schema.org defintion of Research Project is 'A Research Project'"@en;
                       rdfs:label "Research Project"@en;
                       rdfs:subClassOf holy:PurposeBasedProject;
                       skos:altLabel "Experimental Project"@en,
                                     "R&D Project"@en,
                                     "Research Project"@en,
                                     "Research and Advanced Development Project"@en;
                       skos:definition "A scientific investigation, usually using scientific methods, to achieve defined objectives."@en;
                       <https://wordnet-rdf.princeton.edu/ontology#hyponym> "Meta Project"@en,
                                                                            "Quantitative Project"@en,
                                                                            "Qualitative Project"@en.
schema:affiliation a owl:AnnotationProperty.
m4i:endOfProject dcterms:references m4i:;
                 a owl:DatatypeProperty;
                 rdfs:domain schema:Project;
                 rdfs:label "project end date"@en;
                 rdfs:range xsd:date;
                 skos:definition "end date of a project"@en.
m4i:inProject dcterms:references m4i:;
              a owl:AsymmetricProperty,
                owl:ObjectProperty,
                owl:IrreflexiveProperty;
              rdfs:comment "An object property comming from the Metadata4Ing ontology for describing the generation of research data, projects and scientific projects. The ontology was released recently on the 22.02.2022 and could be useful for future expansion of the hydrogen ontology."@en,
                           "The inverse of m4i:projectParticipant"@en;
              rdfs:domain org:Organization;
              rdfs:label "associated to project"@en;
              rdfs:range schema:Project;
              rdfs:subPropertyOf owl:topObjectProperty;
              owl:inverseOf m4i:projectParticipant;
              skos:altLabel "responsible for"@en,
                            "sponsor of project"@en;
              skos:definition "A property that connects a person or an organization with a project."@en.
m4i:projectParticipant dcterms:references m4i:;
                       a owl:AsymmetricProperty,
                         owl:IrreflexiveProperty,
                         owl:ObjectProperty;
                       rdfs:comment "An object property comming from the Metadata4Ing ontology for describing the generation of research data, projects and scientific projects. The ontology was released recently on the 22.02.2022 and could be useful for future expansion of the hydrogen ontology."@en,
                                    "The inverse of m4i:associatesToProject"@en;
                       rdfs:domain schema:Project;
                       rdfs:label "project participant"@en;
                       rdfs:range org:Organization;
                       skos:altLabel "project partner"@en;
                       skos:definition "A property that connects a project with a person or an organisation."@en.
m4i:startOfProject dcterms:references m4i:;
                   a owl:DatatypeProperty;
                   rdfs:domain schema:Project;
                   rdfs:label "project start date"@en;
                   rdfs:range xsd:date;
                   skos:definition "start date of a project"@en.
rdf:PlainLiteral a rdfs:Datatype.
rdfs:comment a owl:AnnotationProperty;
             skos:definition "Used for listing additional information for the user."@en.
rdfs:label a owl:AnnotationProperty;
           skos:definition "Name of a class, object property or instance."@en.
rdfs:seeAlso a owl:AnnotationProperty.
xsd:date a rdfs:Datatype.
xsd:gYear a rdfs:Datatype.
xsd:string a rdfs:Datatype.
owl:Thing a owl:Class;
          rdfs:comment "The ontology is dedicated to store information of the hydrogen fuel cell domain. Since all sub-classes are providing detailed information to the general subject, 'owl:Thing' can be seen here as the Hydrogen Fuel Cell Domain."@en;
          skos:altLabel "Hydrogen Fuel Cell Domain"@en.
owl:sameAs a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
skos:Concept a owl:Class;
             rdfs:comment "skos:concept is required for establishing a relationship for the object property rov:orgActivity."@en;
             rdfs:label "Concept"@en;
             skos:definition "A SKOS concept can be viewed as an idea or notion; a unit of thought. However, what constitutes a unit of thought is subjective, and this definition is meant to be suggestive, rather than restrictive."@en.
skos:altLabel a owl:AnnotationProperty.
skos:definition a owl:AnnotationProperty;
                skos:definition "Definition of a class."@en.
skos:example a owl:AnnotationProperty;
             skos:definition "Example of an instance within a class. Used for pipeline extraction."@en.
skos:hiddenLabel a owl:AnnotationProperty.
org:FormalOrganization dcterms:references org:;
                       a owl:Class;
                       rdfs:label "Formal Organization"@en;
                       rdfs:subClassOf org:Organization;
                       skos:definition "An organization which is recognized in the world at large, in particular in legal jurisdictions, with associated rights and responsibilities. Examples include a corporation, charity, government or church."@en.
org:Organization dcterms:references org:;
                 a owl:Class;
                 rdfs:label "Organization"@en;
                 skos:altLabel "Organisation"@en,
                               "Organization"@en,
                               "Company"@en;
                 skos:definition "Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an agent. Organizations are often decomposable into hierarchical structures."@en;
                 <https://wordnet-rdf.princeton.edu/ontology#hyponym> "Institute"@en,
                                                                      "Institution"@en,
                                                                      "NGO"@en,
                                                                      "Enterprise"@en.
org:classification dcterms:references org:;
                   a owl:ObjectProperty,
                     owl:IrreflexiveProperty,
                     owl:AsymmetricProperty;
                   rdfs:comment "Main property of rov:orgActivity"@en;
                   rdfs:domain org:Organization;
                   rdfs:label "classification"@en;
                   rdfs:range skos:Concept;
                   rdfs:subPropertyOf owl:topObjectProperty;
                   skos:definition "Indicates a classification for this Organization within some classification scheme."@en.
org:hasPrimarySite dcterms:references org:;
                   a owl:FunctionalProperty,
                     owl:IrreflexiveProperty,
                     owl:AsymmetricProperty,
                     owl:ObjectProperty;
                   rdfs:domain org:Organization;
                   rdfs:label "primary Site"@en;
                   rdfs:range holy:GeographicMarket;
                   rdfs:subPropertyOf org:hasSite;
                   skos:definition "Indicates a primary site for the Organization, this is the default means by which an Organization can be contacted and is not necessarily the formal headquarters."@en.
org:hasSite dcterms:references org:;
            a owl:ObjectProperty,
              owl:AsymmetricProperty,
              owl:IrreflexiveProperty;
            rdfs:domain org:Organization;
            rdfs:label "has site"@en;
            rdfs:range holy:GeographicMarket;
            owl:inverseOf org:siteOf;
            skos:definition "Indicates a site at which the Organization has some presence even if only indirect (e.g. virtual office or a professional service which is acting as the registered address for a company)."@en.
org:hasSubOrganization dcterms:references org:;
                       a owl:TransitiveProperty,
                         owl:AsymmetricProperty,
                         owl:ObjectProperty,
                         owl:IrreflexiveProperty;
                       rdfs:domain org:Organization;
                       rdfs:label "has SubOrganization"@en;
                       rdfs:range org:Organization;
                       owl:inverseOf org:subOrganizationOf;
                       skos:definition "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an organization which is a sub-part or child of this organization."@en.
org:linkedTo dcterms:references org:;
             a owl:ObjectProperty,
               owl:SymmetricProperty;
             rdfs:comment "In the current stage of the Hydrogen Domain Ontology it is used to indicate mainly business relationships outside of the project scope."@en;
             rdfs:domain org:Organization;
             rdfs:label "linked to"@en;
             rdfs:range org:Organization;
             skos:definition "Indicates an arbitrary relationship between two organizations."@en.
org:siteOf dcterms:references <http://www.w3.org/ns/org>;
           a owl:ObjectProperty;
           rdfs:domain holy:GeographicMarket;
           rdfs:label "site of"@en;
           rdfs:range org:Organization;
           rdfs:subPropertyOf owl:topObjectProperty;
           skos:definition "Indicates an Organization which has some presence at the given site. This is the inverse of `org:hasSite`."@en.
org:subOrganizationOf dcterms:references org:;
                      a owl:ObjectProperty,
                        owl:AsymmetricProperty,
                        owl:TransitiveProperty;
                      rdfs:domain org:Organization;
                      rdfs:label "sub-Organization of"@en;
                      rdfs:range org:Organization;
                      rdfs:subPropertyOf owl:topObjectProperty;
                      skos:definition "Represents hierarchical containment of Organizations or OrganizationalUnits; indicates an Organization which contains this Organization."@en.
regorg:RegisteredOrganization dcterms:references regorg:,
                                                 <https://ec.europa.eu/eurostat/documents/3859598/5902521/KS-RA-07-015-EN.PDF>;
                              a owl:Class;
                              rdfs:comment "Inspired by the usage of the Registered Organization Vocabulary in the euBusinessGraph Ontology including links to The Organization Ontology."@en;
                              rdfs:label "Registered Organization"@en;
                              rdfs:subClassOf org:FormalOrganization;
                              skos:altLabel "Registered Organization"@en;
                              skos:definition "A registered company or other group of people that work together in a certain economic field with the purpose to compete in a certain market. The economic field of activity is defined by statistical standardization numbers such as primarily EC NACE 2, ISIC and SIC."@en.
regorg:orgActivity dcterms:references org:;
                   a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:IrreflexiveProperty;
                   rdfs:comment "Relates to the economic activity of an organization based on international classification standards such as NACE (EU) ISIC4 (US) or the UK SIC codes."@en;
                   rdfs:domain regorg:RegisteredOrganization;
                   rdfs:label "company activity"@en;
                   rdfs:range skos:Concept;
                   rdfs:subPropertyOf org:classification;
                   skos:definition "The activity of an organization should be recorded using a controlled vocabulary. Several such vocabularies exist, many of which map to the UN's ISIC codes [ ISIC4 ]. Where a particular controlled vocabulary is in use within a given context, such as SIC codes in the UK, it is acceptable to use these, however, the preferred choice for European interoperability is NACE [ NACE ]. As with company type and status, activity codes should be expressed as SKOS Concept Schemes."@en.
regorg:orgStatus dcterms:references regorg:;
                 a owl:ObjectProperty,
                   owl:AsymmetricProperty,
                   owl:IrreflexiveProperty;
                 rdfs:comment "rov:orgStatus provides a first attempt -used in the Registered Organization Vocabulary- to identify the status of an organization."@en;
                 rdfs:domain org:Organization;
                 rdfs:label "company status"@en;
                 rdfs:range skos:Concept;
                 skos:definition """Extracting the status of an organization presents the same issues as its type. The terms 'insolvent', 'bankrupt' and 'in receivership,' for example, are likely to mean slightly different things with different legal implications in different jurisdictions.

Taking advice from XBRL Europe as a starting point, however, the term 'Normal Activity' does appear to have cross-border usefulness and this should be used in preference to terms like 'trading' or 'operating.'

Best Practice for recording various other status levels is to use the relevant jurisdiction's terms and to encode these in a SKOS Concept Scheme."""@en.
regorg:orgType dcterms:references regorg:;
               a owl:ObjectProperty,
                 owl:AsymmetricProperty,
                 owl:IrreflexiveProperty;
               rdfs:domain org:Organization;
               rdfs:label "company type"@en;
               rdfs:range skos:Concept;
               skos:definition """This property records the type of company. Familiar types are SA, PLC, LLC, GmbH etc. At the time of publication, there is no agreed set of company types that crosses borders. The term 'SA' is used in Poland and France for example although they mean slightly different things. The UK's LLP and Greece's EPE provide further example of close, but not exact, matches.

That said, each jurisdiction will have a limited set of recognized company types and these should be expressed in a consistent manner in a SKOS Concept Scheme."""@en.
foaf:depiction a owl:AnnotationProperty.
foaf:homepage a owl:AnnotationProperty.
foaf:name a owl:AnnotationProperty.
<https://creativecommons.org/ns#license> a owl:AnnotationProperty.
modp:acronym a owl:AnnotationProperty.
modp:competencyQuestion a owl:AnnotationProperty.
modp:hasSyntax a owl:AnnotationProperty.
<https://wordnet-rdf.princeton.edu/ontology#hyponym> a owl:AnnotationProperty.
