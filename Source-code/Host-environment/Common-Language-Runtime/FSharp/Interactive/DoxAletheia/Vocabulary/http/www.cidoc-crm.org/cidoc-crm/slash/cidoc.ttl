                      rdfs:range cidoc:E53_Place;
                      rdfs:subPropertyOf cidoc:P1i_identifies.
cidoc:P88_consists_of a rdf:Property;
                      rdfs:comment """This property identifies an E53 Place that forms part of another Place.
It supports the notion that a Place can be subdivided into one or more constituent parts. It implies both spatial and contextual containment relationships between the two Places.
"""@en;
                      rdfs:domain cidoc:E53_Place;
                      rdfs:label "besteht aus"@de,
                                 "αποτελείται από"@el,
                                 "consists of"@en,
                                 "est en"@fr,
                                 "сделан из"@ru,
                                 "consiste de"@pt;
                      rdfs:range cidoc:E53_Place.
cidoc:P88i_forms_part_of a rdf:Property;
                         rdfs:domain cidoc:E53_Place;
                         rdfs:label "fait partie de"@fr,
                                    "формирует часть"@ru,
                                    "forms part of"@en,
                                    "bildet Teil von"@de,
                                    "είναι τμήμα του"@el,
                                    "faz parte de"@pt;
                         rdfs:range cidoc:E53_Place.
cidoc:P89_falls_within a rdf:Property;
                       rdfs:comment """This property identifies the instances of E53 Places that fall within the area covered by another Place.
It addresses spatial containment only, and no ‘whole-part’ relationship between the two places is implied.
"""@en;
                       rdfs:domain cidoc:E53_Place;
                       rdfs:label "περιέχεται σε"@el,
                                  "está contido em"@pt,
                                  "содержится в"@ru,
                                  "fällt in"@de,
                                  "falls within"@en,
                                  "s’insère dans"@fr;
                       rdfs:range cidoc:E53_Place.
cidoc:P89i_contains a rdf:Property;
                    rdfs:domain cidoc:E53_Place;
                    rdfs:label "inclut"@fr,
                               "содержит"@ru,
                               "περιέχει"@el,
                               "enthält"@de,
                               "contains"@en,
                               "contém"@pt;
                    rdfs:range cidoc:E53_Place.
cidoc:P8_took_place_on_or_within a rdf:Property;
                                 rdfs:comment """This property describes the location of an instance of E4 Period with respect to an E19 Physical Object.
P8 took place on or within (witnessed) is a short-cut of a path defining a E53 Place with respect to the geometry of an object. cf. E46 Section Definition.
This property is in effect a special case of P7 took place at. It describes a period that can be located with respect to the space defined by an E19 Physical Object such as a ship or a building. The precise geographical location of the object during the period in question may be unknown or unimportant. 
For example, the French and German armistice of 22 June 1940 was signed in the same railway carriage as the armistice of 11 November 1918.
"""@en;
                                 rdfs:domain cidoc:E4_Period;
                                 rdfs:label "took place on or within"@en,
                                            "a eu lieu sur ou dans"@fr,
                                            "fand statt auf oder innerhalb von "@de,
                                            "ocorreu em ou dentro"@pt,
                                            "имел место на или в"@ru,
                                            "έλαβε χώρα σε ή εντός"@el;
                                 rdfs:range cidoc:E19_Physical_Object.
cidoc:P8i_witnessed a rdf:Property;
                    rdfs:domain cidoc:E19_Physical_Object;
                    rdfs:label "являлся местом для"@ru,
                               "bezeugte"@de,
                               "witnessed"@en,
                               "a été témoin de"@fr,
                               "υπήρξε τόπος του"@el,
                               "testemunhou"@pt;
                    rdfs:range cidoc:E4_Period.
cidoc:P90_has_value a rdf:Property;
                    rdfs:comment "This property allows an E54 Dimension to be approximated by an E60 Number primitive."@en;
                    rdfs:domain cidoc:E54_Dimension;
                    rdfs:label "a la valeur"@fr,
                               "имеет значение"@ru,
                               "hat Wert"@de,
                               "tem valor"@pt,
                               "has value"@en,
                               "έχει τιμή"@el;
                    rdfs:range rdfs:Literal.
cidoc:P91_has_unit a rdf:Property;
                   rdfs:comment "This property shows the type of unit an E54 Dimension was expressed in."@en;
                   rdfs:domain cidoc:E54_Dimension;
                   rdfs:label "имеет единицу"@ru,
                              "hat Einheit"@de,
                              "έχει μονάδα μέτρησης"@el,
                              "tem unidade"@pt,
                              "has unit"@en,
                              "a pour unité"@fr;
                   rdfs:range cidoc:E58_Measurement_Unit.
cidoc:P91i_is_unit_of a rdf:Property;
                      rdfs:domain cidoc:E58_Measurement_Unit;
                      rdfs:label "является единицей для"@ru,
                                 "est l'unité de"@fr,
                                 "ist Einheit von"@de,
                                 "αποτελεί μονάδα μέτρησης του/της"@el,
                                 "is unit of"@en,
                                 "é unidade de"@pt;
                      rdfs:range cidoc:E54_Dimension.
cidoc:P92_brought_into_existence a rdf:Property;
                                 rdfs:comment """This property allows an E63 Beginning of Existence event to be linked to the E77 Persistent Item brought into existence by it.
It allows a “start” to be attached to any Persistent Item being documented i.e. E70 Thing, E72 Legal Object, E39 Actor, E41 Appellation, E51 Contact Point and E55 Type"""@en;
                                 rdfs:domain cidoc:E63_Beginning_of_Existence;
                                 rdfs:label "a fait exister"@fr,
                                            "brachte in Existenz"@de,
                                            "trouxe à existência"@pt,
                                            "создал"@ru,
                                            "brought into existence"@en,
                                            "γέννησε"@el;
                                 rdfs:range cidoc:E77_Persistent_Item;
                                 rdfs:subPropertyOf cidoc:P12_occurred_in_the_presence_of.
cidoc:P92i_was_brought_into_existence_by a rdf:Property;
                                         rdfs:domain cidoc:E77_Persistent_Item;
                                         rdfs:label "was brought into existence by"@en,
                                                    "γεννήθηκε από"@el,
                                                    "a commencé à exister du fait de"@fr,
                                                    "был создан посредством"@ru,
                                                    "passou a existir por"@pt,
                                                    "wurde in Existenz gebracht durch"@de;
                                         rdfs:range cidoc:E63_Beginning_of_Existence;
                                         rdfs:subPropertyOf cidoc:P12i_was_present_at.
cidoc:P93_took_out_of_existence a rdf:Property;
                                rdfs:comment """This property allows an E64 End of Existence event to be linked to the E77 Persistent Item taken out of existence by it.
In the case of immaterial things, the E64 End of Existence is considered to take place with the destruction of the last physical carrier.
This allows an “end” to be attached to any Persistent Item being documented i.e. E70 Thing, E72 Legal Object, E39 Actor, E41 Appellation, E51 Contact Point and E55 Type. For many Persistent Items we know the maximum life-span and can infer, that they must have ended to exist. We assume in that case an End of Existence, which may be as unnoticeable as forgetting the secret knowledge by the last representative of some indigenous nation.
"""@en;
                                rdfs:domain cidoc:E64_End_of_Existence;
                                rdfs:label "a fait cesser d’exister"@fr,
                                           "cessou a existência de"@pt,
                                           "положил конец существованию"@ru,
                                           "took out of existence"@en,
                                           "beendete die Existenz von"@de,
                                           "αναίρεσε"@el;
                                rdfs:range cidoc:E77_Persistent_Item;
                                rdfs:subPropertyOf cidoc:P12_occurred_in_the_presence_of.
cidoc:P93i_was_taken_out_of_existence_by a rdf:Property;
                                         rdfs:domain cidoc:E77_Persistent_Item;
                                         rdfs:label "прекратил существование посредством"@ru,
                                                    "a cessé d’exister du fait de"@fr,
                                                    "was taken out of existence by"@en,
                                                    "αναιρέθηκε από"@el,
                                                    "deixou de existir"@pt,
                                                    "wurde seiner Existenz beraubt durch"@de;
                                         rdfs:range cidoc:E64_End_of_Existence;
                                         rdfs:subPropertyOf cidoc:P12i_was_present_at.
cidoc:P94_has_created a rdf:Property;
                      rdfs:comment """This property allows a conceptual E65 Creation to be linked to the E28 Conceptual Object created by it. 
It represents the act of conceiving the intellectual content of the E28 Conceptual Object. It does not represent the act of creating the first physical carrier of the E28 Conceptual Object. As an example, this is the composition of a poem, not its commitment to paper.
"""@en;
                      rdfs:domain cidoc:E65_Creation;
                      rdfs:label "criou"@pt,
                                 "has created"@en,
                                 "a créé"@fr,
                                 "hat erschaffen"@de,
                                 "создал"@ru,
                                 "δημιούργησε"@el;
                      rdfs:range cidoc:E28_Conceptual_Object;
                      rdfs:subPropertyOf cidoc:P92_brought_into_existence.
cidoc:P94i_was_created_by a rdf:Property;
                          rdfs:domain cidoc:E28_Conceptual_Object;
                          rdfs:label "foi criado por"@pt,
                                     "wurde erschaffen durch"@de,
                                     "δημιουργήθηκε από"@el,
                                     "a été créé par"@fr,
                                     "was created by"@en,
                                     "был создан посредством"@ru;
                          rdfs:range cidoc:E65_Creation;
                          rdfs:subPropertyOf cidoc:P92i_was_brought_into_existence_by.
cidoc:P95_has_formed a rdf:Property;
                     rdfs:comment "This property links the founding or E66 Formation for an E74 Group with the Group itself."@en;
                     rdfs:domain cidoc:E66_Formation;
                     rdfs:label "a fondé"@fr,
                                "formou"@pt,
                                "has formed"@en,
                                "сформировал"@ru,
                                "σχημάτισε"@el,
                                "hat gebildet"@de;
                     rdfs:range cidoc:E74_Group;
                     rdfs:subPropertyOf cidoc:P92_brought_into_existence.
cidoc:P95i_was_formed_by a rdf:Property;
                         rdfs:domain cidoc:E74_Group;
                         rdfs:label "was formed by"@en,
                                    "a été fondé par"@fr,
                                    "foi formado por"@pt,
                                    "σχηματίστηκε από"@el,
                                    "была сформирована посредством"@ru,
                                    "wurde gebildet von"@de;
                         rdfs:range cidoc:E66_Formation;
                         rdfs:subPropertyOf cidoc:P92i_was_brought_into_existence_by.
cidoc:P96_by_mother a rdf:Property;
                    rdfs:comment """This property links an E67 Birth event to an E21 Person as a participant in the role of birth-giving mother.

Note that biological fathers are not necessarily participants in the Birth (see P97 from father (was father for)). The Person being born is linked to the Birth with the property P98 brought into life (was born). This is not intended for use with general natural history material, only people. There is no explicit method for modelling conception and gestation except by using extensions. This is a sub-property of P11 had participant (participated in).
"""@en;
                    rdfs:domain cidoc:E67_Birth;
                    rdfs:label "de mère"@fr,
                               "είχε μητέρα"@el,
                               "посредством матери"@ru,
                               "pela mãe"@pt,
                               "durch Mutter"@de,
                               "by mother"@en;
                    rdfs:range cidoc:E21_Person;
                    rdfs:subPropertyOf cidoc:P11_had_participant.
cidoc:P96i_gave_birth a rdf:Property;
                      rdfs:domain cidoc:E21_Person;
                      rdfs:label "gave birth"@en,
                                 "a donné naissance à"@fr,
                                 "дал рождение"@ru,
                                 "gebar"@de,
                                 "ήταν μητέρα του/της"@el,
                                 "deu nascimento"@pt;
                      rdfs:range cidoc:E67_Birth;
                      rdfs:subPropertyOf cidoc:P11i_participated_in.
cidoc:P97_from_father a rdf:Property;
                      rdfs:comment """This property links an E67 Birth event to an E21 Person in the role of biological father.
Note that biological fathers are not seen as necessary participants in the Birth, whereas birth-giving mothers are (see P96 by mother (gave birth)). The Person being born is linked to the Birth with the property P98 brought into life (was born).
This is not intended for use with general natural history material, only people. There is no explicit method for modelling conception and gestation except by using extensions. 
A Birth event is normally (but not always) associated with one biological father.
"""@en;
                      rdfs:domain cidoc:E67_Birth;
                      rdfs:label "είχε πατέρα"@el,
                                 "gab Vaterschaft"@de,
                                 "от отца"@ru,
                                 "from father"@en,
                                 "de père"@fr,
                                 "pelo pai"@pt;
                      rdfs:range cidoc:E21_Person.
cidoc:P97i_was_father_for a rdf:Property;
                          rdfs:domain cidoc:E21_Person;
                          rdfs:label "was father for"@en,
                                     "ήταν πατέρας του/της"@el,
                                     "a été père dans"@fr,
                                     "war Vater für"@de,
                                     "был отцом для"@ru,
                                     "foi pai para"@pt;
                          rdfs:range cidoc:E67_Birth.
cidoc:P98_brought_into_life a rdf:Property;
                            rdfs:comment """This property links an E67Birth event to an E21 Person in the role of offspring.
Twins, triplets etc. are brought into life by the same Birth event. This is not intended for use with general Natural History material, only people. There is no explicit method for modelling conception and gestation except by using extensions.
"""@en;
                            rdfs:domain cidoc:E67_Birth;
                            rdfs:label "brachte zur Welt"@de,
                                       "a donné vie à"@fr,
                                       "породил"@ru,
                                       "έφερε στη ζωή"@el,
                                       "brought into life"@en,
                                       "trouxe à vida"@pt;
                            rdfs:range cidoc:E21_Person;
                            rdfs:subPropertyOf cidoc:P92_brought_into_existence.
cidoc:P98i_was_born a rdf:Property;
                    rdfs:domain cidoc:E21_Person;
                    rdfs:label "был рожден"@ru,
                               "was born"@en,
                               "wurde geboren durch"@de,
                               "veio à vida pelo"@pt,
                               "est né"@fr,
                               "γεννήθηκε"@el;
                    rdfs:range cidoc:E67_Birth;
                    rdfs:subPropertyOf cidoc:P92i_was_brought_into_existence_by.
cidoc:P99_dissolved a rdf:Property;
                    rdfs:comment "This property links the disbanding or E68 Dissolution of an E74 Group to the Group itself."@en;
                    rdfs:domain cidoc:E68_Dissolution;
                    rdfs:label "löste auf"@de,
                               "dissolved"@en,
                               "распустил"@ru,
                               "διέλυσε"@el,
                               "a dissous"@fr,
                               "dissolveu"@pt;
                    rdfs:range cidoc:E74_Group;
                    rdfs:subPropertyOf cidoc:P93_took_out_of_existence,
                                       cidoc:P11_had_participant.
cidoc:P99i_was_dissolved_by a rdf:Property;
                            rdfs:domain cidoc:E74_Group;
                            rdfs:label "foi dissolvido por"@pt,
                                       "a été dissous par"@fr,
                                       "wurde aufgelöst durch"@de,
                                       "был распущен посредством"@ru,
                                       "was dissolved by"@en,
                                       "διαλύθηκε από"@el;
                            rdfs:range cidoc:E68_Dissolution;
                            rdfs:subPropertyOf cidoc:P11i_participated_in,
                                               cidoc:P93i_was_taken_out_of_existence_by.
cidoc:P9_consists_of a rdf:Property;
                     rdfs:comment """This property describes the decomposition of an instance of E4 Period into discrete, subsidiary periods.
The sub-periods into which the period is decomposed form a logical whole - although the entire picture may not be completely known - and the sub-periods are constitutive of the general period.
"""@en;
                     rdfs:domain cidoc:E4_Period;
                     rdfs:label "setzt sich zusammen aus"@de,
                                "consiste de"@pt,
                                "αποτελείται από"@el,
                                "consists of"@en,
                                "состоит из"@ru,
                                "consiste en"@fr;
                     rdfs:range cidoc:E4_Period.
cidoc:P9i_forms_part_of a rdf:Property;
                        rdfs:domain cidoc:E4_Period;
                        rdfs:label "αποτελεί μέρος του/της"@el,
                                   "формирует часть"@ru,
                                   "bildet Teil von"@de,
                                   "fait partie de"@fr,
                                   "forms part of"@en,
                                   "faz parte de"@pt;
                        rdfs:range cidoc:E4_Period.
