cidoc:P87i_identifies a rdf:Property;
                      rdfs:domain cidoc:E44_Place_Appellation;
                      rdfs:label "идентифицирует"@ru,
                                 "bezeichnet"@de,
                                 "identifies"@en,
                                 "identifica"@pt,
                                 "identifie"@fr,
