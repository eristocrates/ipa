                                              "was minimum duration of"@en,
                                              "war Mindestdauer von"@de,
                                              "foi a duração mínima de"@pt;
                                   rdfs:range cidoc:E52_Time-Span.
cidoc:P84_had_at_most_duration a rdf:Property;
                               rdfs:comment """This property describes the maximum length of time covered by an E52 Time-Span. 
It allows an E52 Time-Span to be associated with an E54 Dimension representing it’s maximum duration (i.e. it’s outer boundary) independent from the actual beginning and end.
"""@en;
                               rdfs:domain cidoc:E52_Time-Span;
                               rdfs:label "hatte Höchstdauer"@de,
                                          "had at most duration"@en,
                                          "είχε μέγιστη διάρκεια"@el,
                                          "имеет длительность меньше чем"@ru,
                                          "durou no máximo"@pt,
                                          "a duré au plus"@fr;
                               rdfs:range cidoc:E54_Dimension.
cidoc:P84i_was_maximum_duration_of a rdf:Property;
                                   rdfs:domain cidoc:E54_Dimension;
                                   rdfs:label "был максимальной длительностью для"@ru,
                                              "war längste Dauer von"@de,
                                              "was maximum duration of"@en,
                                              "είναι μέγιστη διάρκεια του/της"@el,
                                              "a été la durée maximum de"@fr,
                                              "foi a duração máxima de"@pt;
                                   rdfs:range cidoc:E52_Time-Span.
cidoc:P86_falls_within a rdf:Property;
                       rdfs:comment """This property describes the inclusion relationship between two instances of E52 Time-Span.
This property supports the notion that a Time-Span’s temporal extent falls within the temporal extent of another Time-Span. It addresses temporal containment only, and no contextual link between the two instances of Time-Span is implied.
"""@en;
                       rdfs:domain cidoc:E52_Time-Span;
                       rdfs:label "s’insère dans"@fr,
                                  "falls within"@en,
                                  "está contido em"@pt,
                                  "περιέχεται σε"@el,
                                  "fällt in"@de,
                                  "содержится в"@ru;
                       rdfs:range cidoc:E52_Time-Span.
cidoc:P86i_contains a rdf:Property;
                    rdfs:domain cidoc:E52_Time-Span;
                    rdfs:label "inclut"@fr,
                               "enthält"@de,
