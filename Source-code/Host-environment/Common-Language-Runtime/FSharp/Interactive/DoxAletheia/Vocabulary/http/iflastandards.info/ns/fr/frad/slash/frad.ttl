@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix frad: <http://iflastandards.info/ns/fr/frad/>.
@prefix frbrer: <http://iflastandards.info/ns/fr/frbr/frbrer/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.

frad: dc11:title "FRAD model"@en;
      skos:note "This is the element set of native RDF classes and properties described in the Functional Requirements for Authority Data model. The model also uses elements previously described in the Functional Requirements for Bibliographic Records (FRBR) entity-relationship model. "@en;
      foaf:homepage <http://www.ifla.org/files/assets/cataloguing/frad/frad_2013.pdf>.
frad:C1001 <http://metadataregistry.org/uri/profile/RegAp/name> "ControlledAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:comment "Description is modified from: Guidelines for authority records and references / revised by the Working Group on GARE Revision. Second edition.  München : K.G. Saur, 2001."@en;
           rdfs:isDefinedBy frad:;
           rdfs:label "Controlled Access Point"@en;
           skos:definition "A name, term, code, etc., under which a bibliographic or authority record or reference will be found."@en;
           skos:scopeNote "Includes access points designated as authorized (or preferred) forms of names (i.e., authorized access points) as well as those designated as variant forms of name (i.e., variant access points). Includes access points based on personal, family, and corporate names. Includes access points based on titles (i.e., names) for works, expressions, manifestations, and items. Includes access points consisting of a combination of two access points, as in the case of a creator/title access point for a work which consists of an authorized access point for the name of the creator combined with an authorized access point for the name (i.e., the title) of the work. Includes access points based on names and terms for events, objects, concepts, and places. Includes access points based on identifiers, such as standard numbers, classification indicia. Elements added to the name per se (e.g., dates) form an integral part of the controlled access point."@en.
frad:C1002 <http://metadataregistry.org/uri/profile/RegAp/name> "Family"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Family"@en,
                      "Familia"@es;
           rdfs:subClassOf frad:C1010;
           skos:definition "Two or more persons related by birth, marriage, adoption, civil union, or similar legal status, or who otherwise present themselves as a family."@en;
           skos:scopeNote """Includes royal families, dynasties, houses of nobility, etc. Includes patriarchies and matriarchies. Includes groups of individuals sharing a common ancestral lineage. Includes family units (parents, children, grandchildren, etc.). Includes the successive holders of a title in a house of nobility, viewed collectively (e.g., Dukes of Norfolk).
"""@en.
frad:C1003 <http://metadataregistry.org/uri/profile/RegAp/name> "CorporateBody"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:comment "Description is modified from that in Functional requirements for bibliographic records : final report, by the IFLA Study Group on the Functional Requirements for Bibliographic Records, published by K.G. Saur, 1998."@en;
           rdfs:isDefinedBy frad:;
           rdfs:label "Corporate Body"@en;
           rdfs:subClassOf frad:C1010;
           skos:definition "An organization or group of persons and/or organizations identified by a particular name acting as a unit."@en;
           skos:scopeNote """Includes occasional groups and groups that are constituted as meetings, conferences, congresses, expeditions, exhibitions, festivals, fairs, etc. Includes musical performing groups, groups of visual artists, and dance companies producing collective work. Includes organizations that act as territorial authorities, exercising or claiming to exercise government functions over a certain territory, such as a federation, a state, a region, a local municipality. Includes organizations and groups that are defunct as well as those that continue to operate. Includes fictitious organizations or groups of persons.
"""@en.
frad:C1006 <http://metadataregistry.org/uri/profile/RegAp/name> "Name"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Name"@en,
                      "Nombre"@es;
           skos:definition "A character, word, or group of words and/or characters by which an entity is known."@en;
           skos:scopeNote "Includes names by which persons, families, and corporate bodies are known. Includes titles by which works, expressions, and manifestations are known. Includes names and terms by which concepts, objects, events, and places are known. Includes real names, pseudonyms, religious names, initials, and separate letters, numerals, or symbols. Includes forenames (or given names), matronymics, patronymics, family names (or surnames), dynastic names, etc. Includes given names of sovereigns, popes, etc., with associated roman numerals. Includes names of families, clans, dynasties, houses of nobility, etc. Includes names representing the successive holders of a title in houses of nobility, etc., viewed collectively (e.g., Dukes of Norfolk). Includes names used by a corporate body at various periods in its history. Includes names of associations, institutions, business firms, not-for-profit enterprises, etc. Includes names of governments, government agencies, projects, programmes, government officials, delegations, legislative bodies, armed forces, etc. Includes names of religious bodies, local churches, etc., religious councils, religious officials, provinces, dioceses, synods, etc., papal diplomatic missions, etc. Includes names of conferences, congresses, meetings, etc. Includes names of exhibitions, athletic contests, expeditions, fairs, festivals, etc. Includes names of subordinate and related bodies. Includes numbers that form an integral part of the name of a corporate body or event. Includes trade names. Includes titles of content, parts of content, compilations of content, etc. Includes titles by which a work has become known. Includes the title proper of the original manifestation of a work. Includes titles by which a work is identified in reference sources. Includes titles under which a work has been published. Includes titles by which manifestations of an expression have become known. Includes the title proper of the original manifestation of an expression. Includes titles by which manifestations of an expression are identified in reference sources. Includes titles under which manifestations of an expression have been published. Includes the title proper of the original edition of a manifestation. Includes titles by which a manifestation is identified in reference sources. Includes variant titles appearing on or in a manifestation. Includes names and terms for events, objects, concepts, and places."@en.
frad:C1007 <http://metadataregistry.org/uri/profile/RegAp/name> "Rules"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Rules"@en,
                      "Reglas"@es;
           skos:definition "A set of instructions relating to the formulation and/or recording of controlled access points (authorized forms, variant forms or references, etc.)."@en;
           skos:scopeNote "Includes cataloguing rules and interpretations of those rules. Includes coding conventions."@en.
frad:C1008 <http://metadataregistry.org/uri/profile/RegAp/name> "Agency"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Agency"@en,
                      "Agencia"@es;
           skos:definition "An organization responsible for creating or modifying a controlled access point. The agency is responsible for application and interpretation of the rules it creates and/or uses. The agency may also be responsible for the creation and maintenance of identifiers within its domain."@en;
           skos:scopeNote "Includes libraries, national bibliographic agencies, bibliographic utilities, consortia, museums, archives, rights management organizations, etc."@en.
frad:C1009 <http://metadataregistry.org/uri/profile/RegAp/name> "Identifier"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Identifier"@en,
                      "Identificador"@es;
           skos:definition "A number, code, word, phrase, logo, device, etc., that is associated with an entity, and serves to differentiate that entity from other entities within the domain in which the identifier is assigned. An identifier can consist of an identifier string (i.e., a sequence of numeric and/or alphabetic characters assigned to an entity to serve as a unique identifier within the domain to which the identifier is assigned) and a prefix and/or suffix (a character or set of characters (numeric and/or alphabetic) appearing before or after an identifier string)."@en;
           skos:scopeNote """Includes identifiers such as social insurance numbers assigned by a government authority. Includes personal identifiers assigned by other registration authorities. Includes business registration numbers, registration numbers for charitable organizations, etc., assigned by a government authority. Includes corporate body identifiers assigned by other registration authorities (e.g., ISBN publisher’s prefix). 
Includes standard identifiers assigned by registration authorities identifying content (e.g., ISRC, ISWC, ISAN). Includes standard identifiers assigned by registration authorities identifying manifestations (e.g., ISBN, ISSN). Includes thematic index numbers assigned to a musical work by the publisher, or a musicologist. Includes catalogue raisonné numbers. Includes identifiers for items assigned by repositories (e.g., shelf number). Includes classification numbers referencing specific entities (e.g., a classification number assigned to a particular painting). Includes registered trademarks."""@en.
frad:C1010 <http://metadataregistry.org/uri/profile/RegAp/hasSubClass> frad:C1002,
                                                                       frad:C1003;
           <http://metadataregistry.org/uri/profile/RegAp/name> "BibliographicEntity"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Bibliographic Entity"@en;
           skos:definition "An entity which reflects intellectual constructs or concepts that are integral to the rules used to create library catalogues."@en;
           skos:scopeNote "What is perceived as a specific instance of a particular entity type may vary from one set of rules to another."@en.
frad:C1011 <http://metadataregistry.org/uri/profile/RegAp/name> "NameOfACorporateBody"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Name of a Corporate Body"@en;
           skos:definition "A name which is the appellation of a corporate body."@en.
frad:C1012 <http://metadataregistry.org/uri/profile/RegAp/name> "NameOfAPerson"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Name of a Person"@en;
           skos:definition "A name which is the appellation of a person."@en.
frad:C1013 <http://metadataregistry.org/uri/profile/RegAp/name> "NameOfAFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Name of a Family"@en;
           skos:definition "A name which is the appellation of a family."@en.
frad:C1014 <http://metadataregistry.org/uri/profile/RegAp/name> "NameOfAWork"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a owl:Class;
           rdfs:isDefinedBy frad:;
           rdfs:label "Name of a Work"@en;
           skos:definition "A name which is the appellation of a work."@en.
frad:P2001 <http://metadataregistry.org/uri/profile/RegAp/name> "areAppliedBy"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1007;
           rdfs:isDefinedBy frad:;
           rdfs:label "son aplicadas por"@es,
                      "are applied by"@en;
           rdfs:range frad:C1008;
           owl:inverseOf frad:P2002;
           owl:propertyDisjointWith frad:P3020,
                                    frad:P3019;
           skos:definition "Relates rules to an agency that applies them when creating or modifying a controlled access point."@en.
frad:P2002 <http://metadataregistry.org/uri/profile/RegAp/name> "applies"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1008;
           rdfs:isDefinedBy frad:;
           rdfs:label "applies"@en,
                      "aplica"@es;
           rdfs:range frad:C1007;
           owl:inverseOf frad:P2001;
           skos:definition "Relates an agency to rules that it applies when creating or modifying a controlled access point."@en.
frad:P2003 <http://metadataregistry.org/uri/profile/RegAp/name> "isGovernedBy"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "is governed by"@en,
                      "es regulado por"@es;
           rdfs:range frad:C1007;
           owl:inverseOf frad:P2004;
           skos:definition "Relates a controlled access point to the rules that govern it."@en.
frad:P2004 <http://metadataregistry.org/uri/profile/RegAp/name> "govern"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1007;
           rdfs:isDefinedBy frad:;
           rdfs:label "govern"@en,
                      "regula"@es;
           rdfs:range frad:C1001;
           owl:inverseOf frad:P2003;
           owl:propertyDisjointWith frad:P3020,
                                    frad:P3019;
           skos:definition "Relates rules to a controlled access point that they govern."@en.
frad:P2005 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatedBy"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "es creado por"@es,
                      "is created by"@en;
           rdfs:range frad:C1008;
           owl:inverseOf frad:P2006;
           skos:definition "Relates a controlled access point to the agency that creates it."@en.
frad:P2006 <http://metadataregistry.org/uri/profile/RegAp/name> "creates"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1008;
           rdfs:isDefinedBy frad:;
           rdfs:label "creates"@en,
                      "crea"@es;
           rdfs:range frad:C1001;
           owl:inverseOf frad:P2005;
           skos:definition "Relates an agency to a controlled access point that is created by the agency."@en.
frad:P2007 <http://metadataregistry.org/uri/profile/RegAp/name> "isModifiedBy"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "es modificado por"@es,
                      "is modified by"@en;
           rdfs:range frad:C1008;
           owl:inverseOf frad:P2008;
           skos:definition "Relates a controlled access point to the agency that modifies it."@en.
frad:P2008 <http://metadataregistry.org/uri/profile/RegAp/name> "modifies"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1008;
           rdfs:isDefinedBy frad:;
           rdfs:label "modifies"@en,
                      "modifica"@es;
           rdfs:range frad:C1001;
           owl:inverseOf frad:P2007;
           skos:definition "Relates an agency to a controlled access point that is modified by the agency."@en.
frad:P2009 <http://metadataregistry.org/uri/profile/RegAp/name> "isBasisNameFor"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1006;
           rdfs:isDefinedBy frad:;
           rdfs:label "is basis (name) for"@en;
           rdfs:range frad:C1001;
           owl:inverseOf frad:P2010;
           skos:definition "Relates a name to a controlled access point for which it is the basis."@en.
frad:P2010 <http://metadataregistry.org/uri/profile/RegAp/name> "isBasedOnName"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "is based on (name)"@en;
           rdfs:range frad:C1006;
           owl:inverseOf frad:P2009;
           skos:definition "Relates a controlled access point to a name on which it is based."@en.
frad:P2011 <http://metadataregistry.org/uri/profile/RegAp/name> "isBasisIdentifierFor"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1009;
           rdfs:isDefinedBy frad:;
           rdfs:label "is basis (identifier) for"@en;
           rdfs:range frad:C1001;
           owl:inverseOf frad:P2012;
           owl:propertyDisjointWith frad:P3021;
           skos:definition "Relates an identifier to a controlled access point for which it is the basis."@en.
frad:P2012 <http://metadataregistry.org/uri/profile/RegAp/name> "isBasedOnIdentifier"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "is based on (identifier)"@en,
                      "está basado en (identificador)"@es;
           rdfs:range frad:C1009;
           owl:inverseOf frad:P2011;
           skos:definition "Relates a controlled access point to an identifier on which it is based. "@en.
frad:P2013 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAppellation"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1010;
           rdfs:isDefinedBy frad:;
           rdfs:label "has appellation"@en;
           rdfs:range frad:C1006;
           owl:inverseOf frad:P2014;
           skos:definition "Relates a bibliographic entity to a name."@en.
frad:P2014 <http://metadataregistry.org/uri/profile/RegAp/name> "isAppellationOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1006;
           rdfs:isDefinedBy frad:;
           rdfs:label "is appellation of"@en;
           rdfs:range frad:C1010;
           owl:inverseOf frad:P2013;
           skos:definition "Relates a name to a bibliographic entity."@en.
frad:P2015 <http://metadataregistry.org/uri/profile/RegAp/name> "isAssigned"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1010;
           rdfs:isDefinedBy frad:;
           rdfs:label "is assigned"@en;
           rdfs:range frad:C1009;
           owl:inverseOf frad:P2016;
           skos:definition "Relates a bibliographic entity to an identifier assigned to the entity."@en.
frad:P2016 <http://metadataregistry.org/uri/profile/RegAp/name> "isAssignedTo"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1009;
           rdfs:isDefinedBy frad:;
           rdfs:label "is assigned to"@en;
           rdfs:range frad:C1010;
           owl:inverseOf frad:P2015;
           owl:propertyDisjointWith frad:P3021;
           skos:definition "Relates an identifier to a bibliographic entity to which it is assigned."@en.
frad:P2017 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDerivative"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene derivada"@es,
                      "has derivative"@en;
           rdfs:range frbrer:C1001;
           owl:inverseOf frad:P2018;
           skos:definition "Relates a work to another work which is an adaptation or modification of the prior work."@en;
           skos:scopeNote "Includes relationships between an original work and a broad range of modifications from the original, including variations or versions of that work, such as editions, revisions, translations, summaries, abstracts, and digests. Includes new works that are adaptations or modifications that become new works but are based on an earlier work (improvisations, etc.); new works that are changes of genre (transformations, dramatizations, novelizations, etc.); and, new works based on the style or thematic content of other works (free translations, paraphrases, imitations, parodies, etc.)."@en.
frad:P2018 <http://metadataregistry.org/uri/profile/RegAp/name> "isDerivativeOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "is derivative of"@en,
                      "es derivativa de"@es;
           rdfs:range frbrer:C1001;
           owl:inverseOf frad:P2017;
           skos:definition "Relates a work to another work of which it is an adaptation or modification."@en;
           skos:scopeNote "Includes relationships between an original work and a broad range of modifications from the original, including variations or versions of that work, such as editions, revisions, translations, summaries, abstracts, and digests. Includes new works that are adaptations or modifications that become new works but are based on an earlier work (improvisations, etc.); new works that are changes of genre (transformations, dramatizations, novelizations, etc.); and, new works based on the style or thematic content of other works (free translations, paraphrases, imitations, parodies, etc.)."@en.
frad:P2019 <http://metadataregistry.org/uri/profile/RegAp/name> "hasEquivalenceManifestationRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1003;
           rdfs:isDefinedBy frad:;
           rdfs:label "has equivalence (manifestation) relationship"@en;
           rdfs:range frbrer:C1003;
           skos:definition "Relates a manifestation to another manifestation that embodies the same intellectual or artistic content (work or work-expression)."@en.
frad:P2020 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatedByFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "es creada por (familia)"@es,
                      "is created by (family)"@en;
           rdfs:range frad:C1002;
           rdfs:subPropertyOf frad:P2028;
           skos:definition "Relates a work to a family which is responsible for the creation of the intellectual or artistic content of the work."@en.
frad:P2021 <http://metadataregistry.org/uri/profile/RegAp/name> "isCreatorFamilyOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "is creator (family) of"@en,
                      "es creadora (familia) de"@es;
           rdfs:range frbrer:C1001;
           skos:definition "Relates a family to a work of which it is responsible for the creation of the intellectual or artistic content."@en.
frad:P2022 <http://metadataregistry.org/uri/profile/RegAp/name> "isOwnedByFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1004;
           rdfs:isDefinedBy frad:;
           rdfs:label "is owned by (family)"@en,
                      "es poseida por (familia)"@es;
           rdfs:range frad:C1002;
           skos:definition "Relates an item to a family that is the owner or custodian of the item."@en.
frad:P2023 <http://metadataregistry.org/uri/profile/RegAp/name> "isOwnerFamilyOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "is owner (family) of"@en,
                      "es propietaria (familia) de"@es;
           rdfs:range frbrer:C1004;
           skos:definition "Relates a family to an item of which it is the owner or custodian."@en.
frad:P2024 <http://metadataregistry.org/uri/profile/RegAp/name> "isProducedByFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1003;
           rdfs:isDefinedBy frad:;
           rdfs:label "is produced by (family)"@en,
                      "es producida por (familia)"@es;
           rdfs:range frad:C1002;
           skos:definition "Relates a manifestation to a family that is responsible for publishing, distributing, fabricating or manufacturing the manifestation."@en.
frad:P2025 <http://metadataregistry.org/uri/profile/RegAp/name> "isProducerFamilyOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "is producer (family) of"@en,
                      "es productora (familia) de"@es;
           rdfs:range frbrer:C1003;
           skos:definition "Relates a family to a manifestation of which it is responsible for publishing, distributing, fabricating or manufacturing."@en.
frad:P2026 <http://metadataregistry.org/uri/profile/RegAp/name> "isRealizedByFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "is realized by (family)"@en,
                      "es realizada por (familia)"@es;
           rdfs:range frad:C1002;
           skos:definition "Relates an expression to a family that is responsible for the specifics of the intellectual or artistic realization or execution of the expression."@en.
frad:P2027 <http://metadataregistry.org/uri/profile/RegAp/name> "isRealizerFamilyOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "is realizer (family) of"@en,
                      "es realizadora (familia) de"@es;
           rdfs:range frbrer:C1002;
           skos:definition "Relates a family to an expression of which it is responsible for the specifics of the intellectual or artistic realization or execution."@en.
frad:P2028 <http://metadataregistry.org/uri/profile/RegAp/hasSubproperty> frad:P2020;
           <http://metadataregistry.org/uri/profile/RegAp/name> "isAssociatedWith"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:isDefinedBy frad:;
           rdfs:label "is associated with"@en;
           skos:definition "Relates a person, a family, or a corporate body to a work, expression, manifestation, or item."@en.
frad:P2029 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSequentialRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has sequential relationship"@en;
           rdfs:range frbrer:C1001;
           skos:definition "Relates a work to another work of different content that is a successor or a predecessor of that work,"@en;
           skos:scopeNote "E.g. a sequel, a serial or series that has changed title. Excludes derivative works that modify the content of an earlier work."@en.
frad:P2030 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAccompanyingRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has accompanying relationship"@en;
           rdfs:range frbrer:C1001;
           skos:definition "Relates a work to another work that is a supplement to that work (i.e., a work that is intended to be used in conjunction with or to augment the related work, such as a teacher’s guide or incidental music to a play; or intended to complement or be a companion to another work, such as a set of maps to a video travelogue, a computer disk to accompany a textbook, a set of coloured plates to accompany a text, the equal parts of a kit)."@en.
frad:P2031 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSharedCharacteristicWorkRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has shared characteristic (work) relationship"@en,
                      "tiene relación de característica compartida (obra)"@es;
           rdfs:range frbrer:C1001;
           skos:definition "Relates two works that have some characteristic in common."@en;
           skos:scopeNote "Excludes specific characteristics represented by other properties."@en.
frad:P2032 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSharedCharacteristicExpressionRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene relación de característica compartida (expresión)"@es,
                      "has shared characteristic (expression) relationship"@en;
           rdfs:range frbrer:C1002;
           skos:definition "Relates two expressions that have some characteristic in common. "@en;
           skos:scopeNote "Excludes specific characteristics represented by other properties."@en.
frad:P2033 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSharedCharacteristicManifestationRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1003;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene relación de característica compartida (manifestación)"@es,
                      "has shared characteristic (manifestation) relationship"@en;
           rdfs:range frbrer:C1003;
           skos:definition "Relates two manifestations that have some characteristic in common."@en;
           skos:scopeNote "Excludes specific characteristics represented by other properties. "@en.
frad:P2034 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSharedCharacteristicItemRelationship "@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1004;
           rdfs:isDefinedBy frad:;
           rdfs:label "has shared characteristic (item) relationship"@en,
                      "tiene relación de característica compartida (ejemplar)"@es;
           rdfs:range frbrer:C1004;
           skos:definition "Relates two items that have some characteristic in common."@en;
           skos:scopeNote "Excludes specific characteristics represented by other properties."@en.
frad:P2035 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDescriptiveWork"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:isDefinedBy frad:;
           rdfs:label "has descriptive work"@en,
                      "tiene obra descriptiva"@es;
           rdfs:range frbrer:C1001;
           skos:definition "Relates a target work or expression or manifestation or item and a new work that refers to that target as its subject."@en;
           skos:scopeNote "Includes criticism, commentary, review, casebook, etc., and the object of that analysis (that is, the target work, expression, or manifestation)."@en.
frad:P2036 <http://metadataregistry.org/uri/profile/RegAp/name> "isDescriptiveWorkOf"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "is descriptive work of"@en;
           skos:definition "Relates a new work to a target work or expression or manifestation or item that it refers to as its subject."@en;
           skos:scopeNote "Includes criticism, commentary, review, casebook, etc., and the object of that analysis (that is, the target work, expression, or manifestation). "@en.
frad:P2037 <http://metadataregistry.org/uri/profile/RegAp/name> "hasEquivalenceItemRelationship"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frbrer:C1004;
           rdfs:isDefinedBy frad:;
           rdfs:label "has equivalence (item) relationship"@en;
           rdfs:range frbrer:C1004;
           skos:definition "Relates an item to another item that exemplifies the same intellectual or artistic content (work or work-expression)."@en.
frad:P3001 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTypeOfFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "has type of family"@en;
           owl:propertyDisjointWith frad:P3002,
                                    frad:P3003,
                                    frad:P3004,
                                    frad:P3005;
           skos:definition "Relates a family to a categorization or generic descriptor for the type of family."@en;
           skos:scopeNote "Includes categorizations, such as clan, dynasty, family unit, patriarchy, matriarchy, etc."@en.
frad:P3002 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDatesOfFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "has dates of family"@en;
           owl:propertyDisjointWith frad:P3005,
                                    frad:P3001,
                                    frad:P3004,
                                    frad:P3003;
           skos:definition "Relates a family to dates associated with the family."@en.
frad:P3003 <http://metadataregistry.org/uri/profile/RegAp/name> "hasPlacesAssociatedWithFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "has places associated with family"@en;
           owl:propertyDisjointWith frad:P3005,
                                    frad:P3002,
                                    frad:P3001,
                                    frad:P3004;
           skos:definition "Relates a family to information pertaining to places where the family resides or resided or had some connection."@en.
frad:P3004 <http://metadataregistry.org/uri/profile/RegAp/name> "hasFieldOfActivityFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "has field of activity (family)"@en,
                      "tiene campo de actividad (familia)"@es;
           owl:propertyDisjointWith frad:P3005,
                                    frad:P3002,
                                    frad:P3001,
                                    frad:P3003;
           skos:definition "Relates a family to afield of endeavour, area of expertise, etc., in which the family is engaged or was engaged."@en.
frad:P3005 <http://metadataregistry.org/uri/profile/RegAp/name> "hasHistoryOfFamily"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1002;
           rdfs:isDefinedBy frad:;
           rdfs:label "has history of family"@en;
           owl:propertyDisjointWith frad:P3003,
                                    frad:P3001,
                                    frad:P3002,
                                    frad:P3004;
           skos:definition "Relates a family to information pertaining to the history of the family."@en.
frad:P3006 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTypeOfControlledAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has type of controlled access point"@en;
           owl:propertyDisjointWith frad:P3007,
                                    frad:P3017,
                                    frad:P3009,
                                    frad:P4018,
                                    frad:P3008;
           skos:definition "Relates a controlled access point to a categorization or generic descriptor for the controlled access point."@en;
           skos:scopeNote "Includes terms and/or codes designating the type of access point (e.g., personal name access point, family name access point, corporate name access point, meeting name access point, territorial name access point, title access point, collective title access point or access points consisting of a combination of names, such as creator/title access points)."@en.
frad:P3007 <http://metadataregistry.org/uri/profile/RegAp/name> "hasStatusOfControlledAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has status of controlled access point"@en;
           owl:propertyDisjointWith frad:P3017,
                                    frad:P3006,
                                    frad:P3009,
                                    frad:P4018,
                                    frad:P3008;
           skos:definition "Relates a controlled access point to an indication of the level of establishment of the authorized access point for the entity (e.g., provisional)."@en.
frad:P3008 <http://metadataregistry.org/uri/profile/RegAp/name> "hasDesignatedUsageOfControlledAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has designated usage of controlled access point"@en;
           owl:propertyDisjointWith frad:P3007,
                                    frad:P3017,
                                    frad:P3006,
                                    frad:P3009,
                                    frad:P4018;
           skos:definition "Relates a controlled access point to an indication of whether the rules under which the controlled access point was constructed designate it as an authorized (or preferred) form (i.e., authorized access point) or as a variant (or non-preferred) form (i.e., variant access points)."@en.
frad:P3009 <http://metadataregistry.org/uri/profile/RegAp/name> "hasUndifferentiatedAccessPoint "@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene punto de acceso no diferenciado"@es,
                      "has undifferentiated access point "@en;
           owl:propertyDisjointWith frad:P3017,
                                    frad:P4018,
                                    frad:P3007,
                                    frad:P3008,
                                    frad:P3006;
           skos:definition "Relates a controlled access point to an indication that the controlled access point for the authorized form of name (i.e., authorized access point) is insufficiently precise to differentiate between two or more entities identified by the same name."@en.
frad:P3010 <http://metadataregistry.org/uri/profile/RegAp/name> "hasLanguageOfBaseAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has language of base access point"@en;
           skos:definition "Relates a controlled access point to the language in which the base access point is recorded."@en.
frad:P3011 <http://metadataregistry.org/uri/profile/RegAp/name> "hasLanguageOfCataloguing"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has language of cataloguing"@en,
                      "tiene lengua de catalogación"@es;
           skos:definition "Relates a controlled access point to the language in which additions to the base access point are recorded."@en.
frad:P3012 <http://metadataregistry.org/uri/profile/RegAp/name> "hasScriptOfBaseAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has script of base access point"@en;
           skos:definition "Relates a controlled access point to the form of graphic characters in which the data in the base access point are recorded."@en.
frad:P3013 <http://metadataregistry.org/uri/profile/RegAp/name> "hasScriptOfCataloguing"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has script of cataloguing"@en;
           skos:definition "Relates a controlled access point to the form of graphic characters in which any additions to the base access point are recorded."@en.
frad:P3014 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTransliterationSchemeOfBaseAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has transliteration scheme of base access point"@en;
           skos:definition "Relates a controlled access point to an indication of the scheme used in transliterating the base access point."@en.
frad:P3015 <http://metadataregistry.org/uri/profile/RegAp/name> "hasTransliterationSchemeOfCataloguing"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has transliteration scheme of cataloguing"@en;
           skos:definition "Relates a controlled access point to an indication of the scheme used in transliterating any additions to the base access point."@en.
frad:P3016 <http://metadataregistry.org/uri/profile/RegAp/name> "hasSourceOfControlledAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has source of controlled access point"@en;
           skos:definition "Relates a controlled access point to the publication or reference source used in establishing the form of name or title on which the controlled access point is based."@en;
           skos:scopeNote "Includes the title, publisher, date, etc., of the resource for which the controlled access point was originally created. Includes the title, edition, etc., of the reference source(s) used to establish the conventional name or title."@en.
frad:P3017 <http://metadataregistry.org/uri/profile/RegAp/name> "hasBaseAccessPoint"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "has base access point"@en;
           owl:propertyDisjointWith frad:P3007,
                                    frad:P3006,
                                    frad:P3009,
                                    frad:P4018,
                                    frad:P3008;
           skos:definition "Relates a controlled access point to all elements in a controlled access point that are integral to the name or identifier that forms the basis for the access point."@en;
           skos:scopeNote "Includes the name element in a controlled access point beginning with the name of a person, family, or corporate body. Includes the phrase element in a controlled access point beginning with a phrase associated with a person that is used in lieu of a name as such when the name of the person is unknown (e.g., A Physician, Author of Early Impressions). Includes the name element for a subordinate or related body in a controlled access point beginning with the name of a superior body. Includes the name element for a government agency, official, legislative body, court, etc., in a controlled access point beginning with the name for the territorial authority. Includes the name element for a religious council, official, province, synod, etc., in a controlled access point beginning with the name for the religious body. Includes the title element in a controlled access point for a work. Includes a term designating form at the beginning of the title element of a controlled access point for a musical work or expression (e.g., Symphony, Concerto). Includes conventional and collective titles at the beginning of the title element of a controlled access point for a work or expression (e.g., Treaties, Laws, Works, Selections, Piano music). Includes the additional  element(s) in a collective title controlled access point (i.e., a subsequent term or terms used to subdivide the collective uniform title)"@en.
frad:P3018 <http://metadataregistry.org/uri/profile/RegAp/name> "hasAddition"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:comment """Sometimes referred to as a \"qualifier\"."""@en;
           rdfs:domain frad:C1001;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene adición"@es,
                      "has addition"@en;
           skos:definition "Relates a controlled access point to a name, title, date, place, number, or other designation added to the base access point."@en;
           skos:scopeNote "Includes the fuller form of name added to the base access point. Includes the title of nobility, title of royalty, or ecclesiastical title added to the base access point. Includes dates added to the base access point. Includes the place name associated with a corporate body added to the base access point. Includes a number associated with a corporate body or a musical work added to the base access point. Includes a title of an adaptation or version of a work added to the base access point. Includes the name and/or number of a section or part of a work added to the base access point. Includes a term designating the form of a work added to the base access point. Includes a term designating language of expression added to the base access point. Includes a term designating the key in which a musical work was originally composed added to the base access point. Includes a term designating the medium of performance for which a musical work was originally conceived added to the base access point. Includes other designations associated with persons and corporate bodies added to the base access point."@en.
frad:P3019 <http://metadataregistry.org/uri/profile/RegAp/name> "hasCitationForRules"@en;
           <http://metadataregistry.org/uri/profile/RegAp/status> <http://metadataregistry.org/uri/RegStatus/1001>;
           a rdf:Property;
           rdfs:domain frad:C1007;
           rdfs:isDefinedBy frad:;
           rdfs:label "tiene cita de reglas"@es,
                      "has citation for rules"@en;
           owl:propertyDisjointWith frad:P2001,
                                    frad:P3020,
                                    frad:P2004;
           skos:definition "Relates rules to a citation for the cataloguing code, set of rules, instructions, etc."@en;
           skos:scopeNote "Includes the title of the rules, etc., and, as necessary, the name of the body responsible for the rules, the edition designation, date, etc."@en.
frad:P3020 <http://metadataregistry.org/uri/profile/RegAp/name> "hasRulesIdentifier"@en;
