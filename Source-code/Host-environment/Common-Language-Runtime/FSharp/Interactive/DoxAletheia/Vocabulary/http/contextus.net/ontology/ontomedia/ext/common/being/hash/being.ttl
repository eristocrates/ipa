@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix being: <http://contextus.net/ontology/ontomedia/ext/common/being#>.

<http://contextus.net/ontology/ontomedia/core/expression#Collection> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Context> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Event> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Item> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/expression#Physical-Item> a <http://www.w3.org/2002/07/owl#Class>.
<http://contextus.net/ontology/ontomedia/core/space#Space> a <http://www.w3.org/2002/07/owl#Class>.
being: <http://purl.org/dc/elements/1.1/creator> "K Faith Lawrence (mailto:kf03r@ecs.soton.ac.uk)",
                                                 "Michael O. Jewell (mailto:moj@ecs.soton.ac.uk)",
                                                 "Mischa M Tuffield (mailto:mmt04r@ecs.soton.ac.uk)";
       <http://purl.org/dc/elements/1.1/description> "OntoMedia (Ontology for Media) has been designed to describe the interactions occurring in multimedia."@en;
       <http://purl.org/dc/elements/1.1/title> "OntoMedia Being Representation"@en;
       <http://purl.org/dc/terms/created> "2005-05-11";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "OntoMedia Being Representation";
       <http://www.w3.org/2002/07/owl#imports> <http://xmlns.com/foaf/0.1/>;
       <http://www.w3.org/2002/07/owl#versionInfo> "0.25".
being:Adopted a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents an adopted bond that exists between beings or groups of beings";
              rdfs:label "Adopted Family Bond";
              rdfs:subClassOf being:Family.
being:Alliance a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "This class represents an alliance that exists between beings or groups of beings";
               rdfs:label "Alliance";
               rdfs:subClassOf being:Bond.
being:Being a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents an Entity with a personality";
            rdfs:label "Being";
            rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Entity>;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/#Person>.
being:Blood a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a blood bond that exists between beings or groups of beings";
            rdfs:label "Blood Family Bond";
            rdfs:subClassOf being:Family.
being:Bond a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents a bond that exists between beings or groups of beings";
           rdfs:label "Bond";
           rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Bonded-Group a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class represents a bonded group";
                   rdfs:label "Bonded Group";
                   rdfs:subClassOf being:Community.
being:Character a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents an fictionalised contruction of an entity with a personality";
                rdfs:label "Character";
                rdfs:subClassOf being:Being.
being:Community a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents a community";
                rdfs:label "Community";
                rdfs:subClassOf being:Group.
being:Company a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This class represents a company";
              rdfs:label "Company";
              rdfs:subClassOf being:Organisation.
being:Deal a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents a deal that exists between beings or groups of beings";
           rdfs:label "Deal";
           rdfs:subClassOf being:Bond.
being:Emotional-Crisis a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "This class represents a emotional crisis";
                       rdfs:label "Emotional Crisis";
                       rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Enmity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents an emnity that exists between beings or groups of beings";
             rdfs:label "Enmity";
             rdfs:subClassOf being:Bond.
being:Family a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents a family bond that exists between beings or groups of beings";
             rdfs:label "Family Bond";
             rdfs:subClassOf being:Bond.
being:Foster a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents a foster bond that exists between beings or groups of beings";
             rdfs:label "Foster Family Bond";
             rdfs:subClassOf being:Family.
being:Friendship a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents an friendship that exists between beings or groups of beings";
                 rdfs:label "Friendship";
                 rdfs:subClassOf being:Alliance.
being:Government a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents a governing group";
                 rdfs:label "Government";
                 rdfs:subClassOf being:Organisation.
being:Group a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "This class represents a group of beings";
            rdfs:label "Group";
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (being:Being
                                                                                                                     being:Group) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>] ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://contextus.net/ontology/ontomedia/core/expression#contains> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (being:Being
                                                                                                                     being:Group) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>] ; 
                             <http://www.w3.org/2002/07/owl#onProperty> <http://contextus.net/ontology/ontomedia/core/expression#contains> ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            <http://contextus.net/ontology/ontomedia/core/expression#Collection>;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/#Group>.
being:Household a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "This class represents a household";
                rdfs:label "Household";
                rdfs:subClassOf being:Community.
being:Mental-Illness a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "This class represents a mental illness";
                     rdfs:label "Mental Illness";
                     rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Organisation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "This class represents an organisation";
                   rdfs:label "Organisation";
                   rdfs:subClassOf being:Group;
                   <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/#Organization>.
being:Partnership a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents a partnership";
                  rdfs:label "Partnership";
                  rdfs:subClassOf being:Bonded-Group.
being:Physical-Illness a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "This class represents a physical illness";
                       rdfs:label "Physical Illness";
                       rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Physical-Injury a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "This class represents a physical injury";
                      rdfs:label "Physical Injury";
                      rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Pledge a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "This class represents a promise that exists between beings or groups of beings";
             rdfs:label "Pledge";
             rdfs:subClassOf being:Bond.
being:Possession a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents a the bond between two entities where one claims ownership of the other";
                 rdfs:label "Possession";
                 rdfs:subClassOf being:Bond.
being:Profession a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "This class represents a profession";
                 rdfs:label "Profession";
                 rdfs:subClassOf <http://contextus.net/ontology/ontomedia/core/expression#Abstract-Item>.
being:Proto-Being a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This class represents something that may develop into a being for cases where the being/item divide isn't clear";
                  rdfs:label "Proto-Being";
                  rdfs:subClassOf being:Being.
being:Step a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "This class represents a step bond that exists between beings or groups of beings";
           rdfs:label "Step Family Bond";
           rdfs:subClassOf being:Family.
being:carries-title a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property specifies a title which can be used by any members of the group";
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Profession
                                                                          being:Group) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                [<http://www.w3.org/2002/07/owl#unionOf> (being:Profession
                                                                          being:Group) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:label "Carries Title";
                    rdfs:range <http://contextus.net/ontology/ontomedia/ext/common/trait#Name>.
being:carries-uniform a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property specifies a uniform which is worn by any members of the group";
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Profession
                                                                            being:Group) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>],
                                  [<http://www.w3.org/2002/07/owl#unionOf> (being:Profession
                                                                            being:Group) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "Carries Uniform";
                      rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Physical-Item>.
being:cured a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "This property specifies a cure event";
            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Injury
                                                                  being:Physical-Illness
                                                                  being:Mental-Illness) ; 
                         a <http://www.w3.org/2002/07/owl#Class>],
                        [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Injury
                                                                  being:Physical-Illness
                                                                  being:Mental-Illness) ; 
                         a <http://www.w3.org/2002/07/owl#Class>];
            rdfs:label "Cured";
            rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
being:deal-conditions a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "This property specifies the conditions of the deal";
                      rdfs:domain being:Deal;
                      rdfs:label "Deal Conditions";
                      rdfs:range being:Pledge.
being:dealbroker a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This property specifies the broker of the deal";
                 rdfs:domain being:Deal;
                 rdfs:label "Deal Broker";
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                      being:Being) ; 
                             a <http://www.w3.org/2002/07/owl#Class>],
                            [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                      being:Being) ; 
                             a <http://www.w3.org/2002/07/owl#Class>].
being:dealmaker a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property specifies the broker of the deal";
                rdfs:domain being:Deal;
                rdfs:label "Deal Broker";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                     being:Being) ; 
                            a <http://www.w3.org/2002/07/owl#Class>],
                           [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                     being:Being) ; 
                            a <http://www.w3.org/2002/07/owl#Class>].
being:diagnosed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property specifies a diagnosis event";
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Injury
                                                                      being:Physical-Illness
                                                                      being:Emotional-Crisis
                                                                      being:Mental-Illness) ; 
                             a <http://www.w3.org/2002/07/owl#Class>],
                            [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Injury
                                                                      being:Physical-Illness
                                                                      being:Emotional-Crisis
                                                                      being:Mental-Illness) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "Diagnosed";
                rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
being:entered-remission a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property specifies an entering remission event";
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Illness
                                                                              being:Mental-Illness) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>],
                                    [<http://www.w3.org/2002/07/owl#unionOf> (being:Physical-Illness
                                                                              being:Mental-Illness) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:label "Entered Remission";
                        rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
being:governed-by a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "This property specifies a class of items of which the group or collection is made";
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                        <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                               a <http://www.w3.org/2002/07/owl#Class>],
                              [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                        <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:label "Governed By";
                  rdfs:range being:Government;
                  <http://www.w3.org/2002/07/owl#inverseOf> being:governs.
being:governs a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "This property specifies a class of items of which the group or collection is made";
              rdfs:domain being:Government;
              rdfs:label "Governs";
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                   <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                          a <http://www.w3.org/2002/07/owl#Class>],
                         [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                   <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
              <http://www.w3.org/2002/07/owl#inverseOf> being:governed-by.
being:has-crisis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "This property specifies the emotional crisis of a being";
                 rdfs:domain being:Being;
                 rdfs:label "Has Crisis";
                 rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>;
                 rdfs:subPropertyOf being:has-emotional-health.
being:has-emotional-health a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "This property specifies the emotional well-being of a being";
                           rdfs:domain being:Being;
                           rdfs:label "Emotional Health";
                           rdfs:range being:Emotional-Crisis.
being:has-loco-parentis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "This property specifies that the specified being acting in loco parentis of the being";
                        rdfs:domain being:Family;
                        rdfs:label "Has Loco Parentis";
                        rdfs:range being:Being;
                        rdfs:subPropertyOf being:is-relation-of;
                        <http://www.w3.org/2002/07/owl#inverseOf> being:in-loco-parentis.
being:has-mental-disorder a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "This property specifies the emotional well-being of a being";
                          rdfs:domain being:Being;
                          rdfs:label "Mental Health";
                          rdfs:range being:Mental-Illness.
being:has-number-of-parts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "This property specifies the number of parts contained by the collection";
                          rdfs:domain <http://contextus.net/ontology/ontomedia/core/expression#Collection>;
                          rdfs:label "Has Number Of Parts";
                          rdfs:range rdfs:Literal.
being:has-physical-illness a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "This property specifies the emotional well-being of a being";
                           rdfs:domain being:Being;
                           rdfs:label "Physical Illness";
                           rdfs:range being:Physical-Illness.
being:has-physical-injury a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "This property specifies the emotional well-being of a being";
                          rdfs:domain being:Being;
                          rdfs:label "Physical Injury";
                          rdfs:range being:Physical-Injury.
being:have-bonded-to a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "This property represents a pledge that the entity has a bond with the named entity";
                     rdfs:domain being:Pledge;
                     rdfs:label "Have Bonded To";
                     rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                          <http://contextus.net/ontology/ontomedia/ext/detail/know#Culture>
                                                                          being:Profession
                                                                          being:Being) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                          <http://contextus.net/ontology/ontomedia/ext/detail/know#Culture>
                                                                          being:Profession
                                                                          being:Being) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>].
being:have-done a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "This property represents a pledge that the entity has done the named thing";
                rdfs:domain being:Pledge;
                rdfs:label "Have Done";
                rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
being:have-not-bonded-to a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "This property represents a pledge that the entity does not have a bond with the named entity";
                         rdfs:domain being:Pledge;
                         rdfs:label "Have Not Bonded To";
                         rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                              <http://contextus.net/ontology/ontomedia/ext/detail/know#Culture>
                                                                              being:Profession
                                                                              being:Being) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>],
                                    [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                              <http://contextus.net/ontology/ontomedia/ext/detail/know#Culture>
                                                                              being:Profession
                                                                              being:Being) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>].
being:have-not-done a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "This property represents a pledge that the entity has not done the named thing";
                    rdfs:domain being:Pledge;
                    rdfs:label "Have Not Done";
                    rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Event>.
being:in-loco-parentis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "This property specifies that the being is acting in loco parentis of the specified being";
                       rdfs:domain being:Family;
                       rdfs:label "In Loco Parentis";
                       rdfs:range being:Being;
                       rdfs:subPropertyOf being:is-relation-of;
                       <http://www.w3.org/2002/07/owl#inverseOf> being:has-loco-parentis.
being:is-a a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:comment "This property represents a pledge that the entity is the named thing";
           rdfs:domain being:Pledge;
           rdfs:label "Is A";
           rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Entity>.
being:is-child-of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "This property specifies that the being is the child of the specified being";
                  rdfs:domain being:Family;
                  rdfs:label "Is Child Of";
                  rdfs:range being:Being;
                  rdfs:subPropertyOf being:is-relation-of;
                  <http://www.w3.org/2002/07/owl#inverseOf> being:is-parent-of.
being:is-not-a a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "This property represents a pledge that the entity is not the named thing";
               rdfs:domain being:Pledge;
               rdfs:label "Is Not A";
               rdfs:range <http://contextus.net/ontology/ontomedia/core/expression#Entity>.
being:is-parent-of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "This property specifies that the being is the parent of the specified being";
                   rdfs:domain being:Family;
                   rdfs:label "Is Parent Of";
                   rdfs:range being:Being;
                   rdfs:subPropertyOf being:is-relation-of;
                   <http://www.w3.org/2002/07/owl#inverseOf> being:is-child-of.
being:is-relation-of a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "This property specifies that the Being is the child of the specified Being";
                     rdfs:domain being:Family;
                     rdfs:label "Is Relation Of";
                     rdfs:range being:Being;
                     <http://www.w3.org/2002/07/owl#inverseOf> being:is-relation-of.
being:of-type a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "This property specifies a class of items of which the group or collection is made";
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                    <http://contextus.net/ontology/ontomedia/core/expression#Collection>) ; 
                           a <http://www.w3.org/2002/07/owl#Class>],
                          [<http://www.w3.org/2002/07/owl#unionOf> (being:Group
                                                                    <http://contextus.net/ontology/ontomedia/core/expression#Collection>) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "Of Type";
              rdfs:range [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Item>
                                                                                                                  being:Being
                                                                                                                  <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                                                                         a <http://www.w3.org/2002/07/owl#Class>] ; 
                          <http://www.w3.org/2002/07/owl#onProperty> rdf:hasParent ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (<http://contextus.net/ontology/ontomedia/core/expression#Item>
                                                                                                                  being:Being
                                                                                                                  <http://contextus.net/ontology/ontomedia/core/space#Space>) ; 
                                                                         a <http://www.w3.org/2002/07/owl#Class>] ; 
