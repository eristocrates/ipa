@base <http://www.w3.org/2004/06/rei#>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix : <http://www.w3.org/2000/01/rdf-schema#>.
@prefix s: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix w3: <http://www.w3.org/>.
@prefix rei: <http://www.w3.org/2004/06/rei#>.

rei:BNode rdfs:label "blank node";
          rdfs:subClassOf rei:Term.
rei:Formula rdfs:comment """A formula is identified by an unordered set of statements,
	with a sets of existentially and universally quantified symbols.
	For example, 
		[ :forAll  ( [:uri \"ex:#x\"] [:uri \"ex:#y\"]);
		  :forSome ( [:uri \"ex:#a\"] [:uri \"ex:#b\"]);
		  :statements ( :s1 :s2 :s3 )
		]
	is equivalent to e.g. in loose math
		forall x,y,x there exists a,b,c such that s1 and s2 and s3
	That is, the universals are always outside the existentials.
	Two formulae are the equal if the contents
	of their forAll, forSome, and statements lists are the same
	irrespective of order.
	Two formulae are equivalent if there is a 1:1 mapping between
	variable names of one and variable names in the other
	which used as subsitution bindings on one gives a formula
	equal to the other.
	""";
            rdfs:label "Formula";
            rdfs:subClassOf rei:Term.
rei:Literal rdfs:comment """Literals are identified by their string value, their
	datatype (or absence thereof) and their language code
	(or absencethereof). As we are modeling RDF in RDF,
	we can just use a literal the value of a literal.
	""";
            rdfs:label "Literal";
            rdfs:subClassOf rei:RDFTerm.
rei:RDFGraph rdfs:comment """A formula which meets the constaints of being
	an RDF Graph as per the RDF spec. No universally qualified variables,
	no nested formulae, no literals as subject, etc.""";
             rdfs:subClassOf rei:Formula.
rei:RDFTerm rdfs:subClassOf rei:Term.
rei:Statement a rdfs:Class;
              rdfs:comment """A statement is the unit of information.
	It expresses a binary relation.
	Its significance is determined by the realtion,
	generally referred to as its predicate.
	""";
              rdfs:label "Statement".
rei:Symbol rdfs:label "RDF symbol, identified by a URI";
           rdfs:subClassOf rei:RDFTerm.
rei:Term a rdfs:Class;
         rdfs:label "term".
rei:existentials a rdf:Property;
                 rdfs:domain rei:Formula;
                 rdfs:label "for all";
                 rdfs:range rdfs:Class.
rei:objURI a rdf:Property;
           rdfs:comment "Shorhand for object!uri";
           rdfs:domain rei:Statement;
           rdfs:label "object URI";
           rdfs:range rei:String.
rei:objValue a rdf:Property;
             rdfs:comment "Shorhand for object!Literal";
             rdfs:domain rei:Statement;
             rdfs:label "object value";
             rdfs:range rei:String.
rei:object a rdf:Property;
           rdfs:domain rei:Statement;
           rdfs:label "object";
           rdfs:range rei:Term.
rei:predURI a rdf:Property;
            rdfs:comment "Shorhand for predicate!uri";
            rdfs:domain rei:Statement;
            rdfs:label "predicate URI";
            rdfs:range rei:String.
rei:predValue a rdf:Property;
              rdfs:comment "Shorhand for predicate!Literal. Not RDF 1.0.";
              rdfs:domain rei:Statement;
              rdfs:label "predicate value";
              rdfs:range rei:String.
rei:predicate a rdf:Property;
              rdfs:domain rei:Statement;
              rdfs:label "predicate";
              rdfs:range rei:Term.
rei:statements a rdf:Property;
               rdfs:comment """The order of the statements is irrelevant.
	They are given as a rdf:List because rdf:Lists exist,
	and we want a closed set.
	""";
               rdfs:domain rei:Formula;
               rdfs:label "statements";
               rdfs:range rdfs:Class.
rei:subjURI a rdf:Property;
            rdfs:comment "Shorhand for subject!uri";
            rdfs:domain rei:Statement;
            rdfs:label "subject URI";
            rdfs:range rei:String.
rei:subjValue a rdf:Property;
              rdfs:comment "Shorhand for subject!Literal. Not in RDF 1.0";
              rdfs:domain rei:Statement;
              rdfs:label "subject value";
              rdfs:range rei:String.
rei:subject a rdf:Property;
            rdfs:domain rei:Statement;
            rdfs:label "subject";
            rdfs:range rei:Term.
rei:universals a rdf:Property;
               rdfs:domain rei:Formula;
               rdfs:label "for all";
               rdfs:range rdfs:Class.
rei:uri a rdf:Property;
        rdfs:comment """The URI of the symbol is all that is needed to identify it.
	This is the name string.""";
        rdfs:label "symbol URI, not arbitray".
rei:value a rdf:Property;
          rdfs:comment """The value of a literal.

	Value is the relation between a node (which happens to be a literal, list etc,..) and the value it takes.""";
          rdfs:domain rei:iteral;
          rdfs:label "Value".
