@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix algo: <http://securitytoolbox.appspot.com/securityAlgorithms#>.
@prefix security: <http://securitytoolbox.appspot.com/securityMain#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

security: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
          dc11:contributor <mailto:gyrard@eurecom.fr>;
          dc11:creator <mailto:kim@itd.nrl.navy.mil>,
                       <mailto:luo@itd.nrl.navy.mil>,
                       <mailto:mkang@itd.nrl.navy.mil>;
          dc11:description "An ontology to describe various cryptographic algorithms"@en;
          dc11:title "Security Main"@en;
          dcterms:issued "2005-08-31"^^xsd:date;
          dcterms:modified "2015-03-27"^^xsd:date;
          dcterms:source <http://www.dtic.mil/cgi-bin/GetTRDoc?AD=ADA437938>;
          vann:preferredNamespacePrefix "algo";
          vann:preferredNamespaceUri "http://securitytoolbox.appspot.com/securityMain#";
          a owl:Ontology,
            voaf:Vocabulary;
          rdfs:comment "A security ontology to annotate resources with security-related information";
          owl:versionInfo 0.2;
          status:term_status "Finished";
          skos:historyNote "Ontology extracted from the paper Security Ontology for Annotating Resources. [Kim et al. 2005] (See APPENDIX D. OWL Representations of the NRL Security Ontology) Security ontology to faciliate web service description and discovery."@en.
security:Anonymity a security:SecurityObjective;
                   rdfs:comment """
(Secondary Objective) Provides anonymity
""".
security:ApplicationMechanism a owl:Class;
                              rdfs:label "Application Mechanism"@en;
                              rdfs:subClassOf security:SecurityMechanism.
security:AuthenticationProtocol a owl:Class;
                                rdfs:label "Authentication Protocol"@en;
                                rdfs:subClassOf [owl:hasValue security:UserAuthentication ; 
                                                 owl:onProperty security:supportsSecurityObjectives ; 
                                                 a owl:Restriction],
                                                security:SecurityProtocol.
security:Authorization a security:SecurityObjective;
                       rdfs:comment """
Only authorized entities are allowed to access resources in an authorized
manner.
(Aka Access Control). If desired, user may create instance of AccessControl as
well.
""".
security:Availability a security:SecurityObjective;
                      rdfs:comment """
Provides guarantee that resource is available to authorized users at any
authorized time.
""".
security:BLP a security:MilitaryPolicy;
             rdfs:comment """
Bell La-Padula
""".
security:ChineseWall a security:CommercialPolicy.
security:ClarkWilson a security:CommercialPolicy.
security:CommercialPolicy a owl:Class;
                          rdfs:label "Commercial Policy"@en;
                          rdfs:subClassOf security:SecurityPolicy.
security:Confidentiality a security:SecurityObjective;
                         rdfs:comment """
Protects against information being disclosed or revealed to unauthorized
parties.
""".
security:CovertChannelPrevention a security:SecurityObjective;
                                 rdfs:comment """
(Secondary Objective) Prevent or limit the existance of covert channels
""".
security:EncryptionProtocol a owl:Class;
                            rdfs:label "Encryption Protocol"@en;
                            rdfs:subClassOf [owl:hasValue security:Confidentiality ; 
                                             owl:onProperty security:supportsSecurityObjectives ; 
                                             a owl:Restriction],
                                            security:SecurityProtocol.
security:HostMechanism a owl:Class;
                       rdfs:label "Host Mechanism"@en;
                       rdfs:subClassOf security:SecurityMechanism.
security:HostTrust a security:SecurityObjective;
                   rdfs:comment """
(Secondary Objective) How to trust host or platform. Is relevant to Common
criteria, etc.
""".
security:IPSec security:supportsSecurityObjectives security:Confidentiality,
                                                   security:Integrity,
                                                   security:MessageAuthentication;
               a security:NetworkSecurityProtocol.
security:Kerberos a security:AuthenticationProtocol.
security:KeyManagement a security:SecurityObjective;
                       rdfs:comment """
(SecondaryObjective) Securely manages keys for legitimate users.
""".
security:KeyManagementProtocol a owl:Class;
                               rdfs:label "Key Management Protocol"@en;
                               rdfs:subClassOf [owl:hasValue security:KeyManagement ; 
                                                owl:onProperty security:supportsSecurityObjectives ; 
                                                a owl:Restriction],
                                               security:SecurityProtocol.
security:LoginProtocol a security:AuthenticationProtocol.
security:MLSPump security:supportsSecurityObjectives security:CovertChannelPrevention;
                 a security:NetworkMechanism.
security:MessageAuthentication a security:SecurityObjective;
                               rdfs:comment """
Provides guarantee that message came from whoever claimed to have sent it.
""".
security:MessageIntegrity a security:SecurityObjective;
                          rdfs:comment """
Data integrity or Message integrity; data cannot be changed, deleted,
modified, etc by unauthorized parties.
""".
security:MilitaryPolicy a owl:Class;
                        rdfs:label "Military Policy"@en;
                        rdfs:subClassOf security:SecurityPolicy.
security:NetworkMechanism a owl:Class;
                          rdfs:label "Network Mechanism"@en;
                          rdfs:subClassOf security:SecurityMechanism.
security:NetworkSecurityProtocol a owl:Class;
                                 rdfs:label "Network Security Protocol"@en;
                                 rdfs:subClassOf security:SecurityProtocol.
security:OnionRouter security:supportsSecurityObjectives security:Confidentiality,
                                                         security:Anonymity;
                     a security:NetworkMechanism.
security:RBAC a security:SecurityPolicy;
              rdfs:comment """
Role-based Access Control
""".
security:ReplayPrevention a security:SecurityObjective;
                          rdfs:comment """
(Secondary Objective) Protect against replay attacks
""".
security:SAML a security:AuthenticationProtocol.
security:SSH security:supportsSecurityObjectives security:MessageAuthentication,
                                                 security:UserAuthentication,
                                                 security:Confidentiality,
                                                 security:Integrity;
             a security:NetworkSecurityProtocol.
security:SSL security:supportsSecurityObjectives security:UserAuthentication,
                                                 security:Confidentiality;
             a security:NetworkSecurityProtocol;
             owl:sameAs security:TLS.
security:Safehost security:supportsSecurityObjectives security:HostTrust;
                  a security:HostMechanism.
security:SecurityConcept a owl:Class;
                         rdfs:label "Security Concept"@en.
security:SecurityMechanism a owl:Class;
                           rdfs:label "Security Mechanism"@en;
                           rdfs:subClassOf security:SecurityConcept.
security:SecurityObjective a owl:Class;
                           rdfs:label "Security Objective"@en.
security:SecurityPolicy a owl:Class;
                        rdfs:label "Security Policy"@en;
                        rdfs:subClassOf [owl:hasValue <http://securitytoolbox.appspot.com/Authorization> ; 
                                         owl:onProperty <http://securitytoolbox.appspot.com/supportsSecurityObjectives> ; 
                                         a owl:Restriction],
                                        security:SecurityConcept.
security:SecurityProtocol a owl:Class;
                          rdfs:label "Security Protocol"@en;
                          rdfs:subClassOf security:SecurityConcept.
security:Separation a security:SecurityObjective;
                    rdfs:comment """
(Secondary Objective)
""".
security:ServiceMechanism a owl:Class;
                          rdfs:label "Service Mechanism"@en;
                          rdfs:subClassOf security:SecurityMechanism.
security:SignatureProtocol a owl:Class;
                           rdfs:label "Signature Protocol"@en;
                           rdfs:subClassOf [owl:hasValue security:MessageAuthentication ; 
                                            owl:onProperty security:supportsSecurityObjectives ; 
                                            a owl:Restriction],
                                           security:SecurityProtocol.
security:SoapFirewall security:supportsSecurityObjectives security:Authorization;
                      a security:ServiceMechanism.
security:TLS security:supportsSecurityObjectives security:Confidentiality,
                                                 security:UserAuthentication;
             a security:NetworkSecurityProtocol;
             owl:sameAs security:SSL.
security:TrafficHiding a security:SecurityObjective;
                       rdfs:comment """
(Secondary Objective) Pad traffic with bogus data to hide traffic patterns
""".
security:Trust a security:SecurityObjective;
               rdfs:comment """
(Secondary Objective) How to trust entity. Trust not only of identification,
but statements, claims, etc.
""".
security:UserAuthentication a security:SecurityObjective;
                            rdfs:comment """
Provides assurance of the identity of a person or entity.
""".
security:VMM security:supportsSecurityObjectives security:HostTrust;
             a security:HostMechanism.
security:VPN security:supportsSecurityObjectives security:Separation,
                                                 security:Confidentiality;
             a security:NetworkMechanism.
security:XKMS a security:KeyManagementProtocol.
security:XML-dsig a security:SignatureProtocol.
security:XML-enc a security:EncryptionProtocol.
security:hasAlgorithm a owl:ObjectProperty;
                      rdfs:domain security:SecurityProtocol;
                      rdfs:label "hasAlgorithm"@en;
                      rdfs:range algo:Algorithm.
security:hasAssurance a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (security:SecurityProtocol
                                                security:SecurityMechanism) ; 
                                   a owl:Class];
                      rdfs:label "hasAssurance"@en;
                      rdfs:range <http://www.kim.com/NRLOntologyFiles/securityAssurance.owl#Assurance>.
security:hasEncryptionAlgorithm a owl:ObjectProperty;
                                rdfs:label "hasEncryptionAlgorithm"@en;
                                rdfs:range algo:EncryptionAlgorithm;
                                rdfs:subPropertyOf security:hasAlgorithm.
security:hasSignatureAlgorithm a owl:ObjectProperty;
                               rdfs:label "hasSignatureAlgorithm"@en;
                               rdfs:range algo:SignatureAlgorithm;
                               rdfs:subPropertyOf security:hasAlgorithm.
security:reqCredential a owl:ObjectProperty;
                       rdfs:domain security:SecurityProtocol;
                       rdfs:label "reqCredential"@en;
                       rdfs:range <http://www.kim.com/NRLOntologyFiles/credentials.owl#Credential>.
security:supportsSecurityObjectives a owl:ObjectProperty;
                                    rdfs:comment """
Any SecurityConcept can support one or more of the Security Objectives defined
in the SecurityObjective class
""";
                                    rdfs:domain security:SecurityConcept;
                                    rdfs:label "supports Security Objectives"@en;
                                    rdfs:range security:SecurityObjective.
<mailto:gyrard@eurecom.fr> a foaf:Person;
                           foaf:name "Amelie Gyrard".
<mailto:kim@itd.nrl.navy.mil> a foaf:Person;
                              foaf:name "Anya Kim".
<mailto:luo@itd.nrl.navy.mil> a foaf:Person;
                              foaf:name "Jim Luo".
<mailto:mkang@itd.nrl.navy.mil> a foaf:Person;
                                foaf:name "Myong Kang".
