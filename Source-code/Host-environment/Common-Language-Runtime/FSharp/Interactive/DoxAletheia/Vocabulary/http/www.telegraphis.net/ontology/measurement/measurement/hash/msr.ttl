@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix msr: <http://www.telegraphis.net/ontology/measurement/measurement#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix scovo: <http://purl.org/NET/scovo#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.

_:B7ba90535f655310a8683cf379cf7c288 a owl:Restriction;
                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger;
                                    owl:onProperty msr:units.
dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
msr: dc11:creator <http://www.pipian.com/people/pipian/card#me>;
     dc11:description "The Measurement Ontology is an ontology in which measurements may be rendered."@en;
     dc11:title "Measurement Ontology";
     a owl:Ontology.
msr:Area msr:equivalentUnitClass msr:AreaUnit;
         a msr:Quantity;
         rdfs:label "Area"@en.
msr:AreaMeasurement a owl:Class;
                    rdfs:label "Area Measurement"@en;
                    rdfs:subClassOf [owl:onProperty msr:unit ; 
                                     owl:hasValue [a msr:AreaUnit] ; 
                                     a owl:Restriction],
                                    [owl:onProperty msr:measuredQuantity ; 
                                     owl:hasValue msr:Area ; 
                                     a owl:Restriction],
                                    msr:Measurement.
msr:AreaUnit msr:equivalentQuantity msr:Area;
             a msr:UnitClass;
             rdfs:label "Area Unit"@en;
             rdfs:subClassOf msr:Unit.
msr:Km2 a msr:AreaUnit;
        rdfs:label "square kilometers"@en.
msr:Measurement a owl:Class;
                rdfs:description "A measurement is a statistic that measures a quantity that may or may not have units."@en;
                rdfs:label "Measurement"@en;
                rdfs:subClassOf [owl:onProperty msr:quantityMeasured ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction],
                                scovo:Item.
msr:Quantity a owl:Class;
             rdfs:description "A quantity is a quantifiable quality of an object."@en;
             rdfs:label "Quantity"@en;
             rdfs:subClassOf scovo:Dimension;
             owl:disjointWith msr:UnitClass,
                              msr:Unit.
msr:Unit a owl:Class;
         rdfs:description "A unit is a particular quantity against which another quantity may be compared.  Hence, a unit is dimensionful and provides a ratio by which a quantity may be measured."@en;
         rdfs:label "Unit"@en;
         rdfs:subClassOf scovo:Dimension;
         owl:disjointWith msr:UnitClass,
                          msr:Quantity.
msr:UnitClass a owl:Class,
                owl:Restriction;
              rdfs:description "A unit class is a subset of units, with no particular restriction on its contents (i.e. it may be a set of units measuring orthogonal quantities, making a UnitSystem, or a set of units measuring the same quantity)."@en;
              rdfs:label "Unit Class"@en;
              rdfs:subClassOf owl:Class;
              owl:disjointWith msr:Unit,
                               msr:Quantity;
              owl:hasValue msr:Unit;
              owl:onProperty rdfs:subClassOf.
msr:UnitSystem a owl:Class;
               rdfs:description "A unit system is a class of units for which no two elements in the class measure the same dimension (i.e. all dimensions are orthogonal to each other, or measure dimensions derived from a set of orthogonal dimensions with units derived from the units that measure those orthogonal dimensions specified in the system."@en;
               rdfs:label "Unit System"@en;
               rdfs:subClassOf msr:UnitClass.
msr:area a owl:ObjectProperty;
         rdfs:label "area"@en;
         rdfs:range msr:AreaMeasurement.
msr:equivalentQuantity a owl:ObjectProperty,
                         owl:InverseFunctionalProperty;
                       rdfs:description "An equivalent quantity of a unit class is the quantity measured by all units in the unit class."@en;
                       rdfs:domain msr:UnitClass;
                       rdfs:label "equivalent quantity"@en;
                       rdfs:range msr:Quantity;
                       owl:inverseOf msr:unitClass.
msr:equivalentUnitClass a owl:ObjectProperty,
                          owl:FunctionalProperty;
                        rdfs:description "An equivalent unit class of a quantity is the unit class corresponding to units that measure the quantity."@en;
                        rdfs:domain msr:Quantity;
                        rdfs:label "equivalent unit class"@en;
                        rdfs:range msr:UnitClass;
                        owl:inverseOf msr:quantityMeasured.
msr:quantityMeasured a owl:ObjectProperty,
                       owl:FunctionalProperty;
                     rdfs:description "The quantity measured for a measurement."@en;
                     rdfs:domain msr:Measurement;
                     rdfs:label "measured quantity"@en;
                     rdfs:range msr:Quantity;
                     rdfs:subPropertyOf scovo:dimension.
msr:unit a owl:ObjectProperty,
           owl:FunctionalProperty;
         rdfs:description "The unit a measurement is made in."@en;
         rdfs:domain msr:Measurement;
         rdfs:label "unit"@en;
         rdfs:range msr:Unit;
         rdfs:subPropertyOf scovo:dimension.
