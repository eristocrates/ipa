@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix msr: <http://www.telegraphis.net/ontology/measurement/measurement#>.

_:B7ba90535f655310a8683cf379cf7c288 a <http://www.w3.org/2002/07/owl#Restriction>;
                                    <http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger;
                                    <http://www.w3.org/2002/07/owl#onProperty> msr:units.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
msr: <http://purl.org/dc/elements/1.1/creator> <http://www.pipian.com/people/pipian/card#me>;
     <http://purl.org/dc/elements/1.1/description> "The Measurement Ontology is an ontology in which measurements may be rendered."@en;
     <http://purl.org/dc/elements/1.1/title> "Measurement Ontology";
     a <http://www.w3.org/2002/07/owl#Ontology>.
msr:Area msr:equivalentUnitClass msr:AreaUnit;
         a msr:Quantity;
         rdfs:label "Area"@en.
msr:AreaMeasurement a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "Area Measurement"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> msr:unit ; 
                                     <http://www.w3.org/2002/07/owl#hasValue> [a msr:AreaUnit] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#onProperty> msr:measuredQuantity ; 
                                     <http://www.w3.org/2002/07/owl#hasValue> msr:Area ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    msr:Measurement.
msr:AreaUnit msr:equivalentQuantity msr:Area;
             a msr:UnitClass;
             rdfs:label "Area Unit"@en;
             rdfs:subClassOf msr:Unit.
msr:Km2 a msr:AreaUnit;
        rdfs:label "square kilometers"@en.
msr:Measurement a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:description "A measurement is a statistic that measures a quantity that may or may not have units."@en;
                rdfs:label "Measurement"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> msr:quantityMeasured ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                <http://purl.org/NET/scovo#Item>.
msr:Quantity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:description "A quantity is a quantifiable quality of an object."@en;
             rdfs:label "Quantity"@en;
             rdfs:subClassOf <http://purl.org/NET/scovo#Dimension>;
             <http://www.w3.org/2002/07/owl#disjointWith> msr:UnitClass,
                                                          msr:Unit.
msr:Unit a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:description "A unit is a particular quantity against which another quantity may be compared.  Hence, a unit is dimensionful and provides a ratio by which a quantity may be measured."@en;
         rdfs:label "Unit"@en;
         rdfs:subClassOf <http://purl.org/NET/scovo#Dimension>;
         <http://www.w3.org/2002/07/owl#disjointWith> msr:UnitClass,
                                                      msr:Quantity.
msr:UnitClass a <http://www.w3.org/2002/07/owl#Class>,
                <http://www.w3.org/2002/07/owl#Restriction>;
              rdfs:description "A unit class is a subset of units, with no particular restriction on its contents (i.e. it may be a set of units measuring orthogonal quantities, making a UnitSystem, or a set of units measuring the same quantity)."@en;
              rdfs:label "Unit Class"@en;
              rdfs:subClassOf <http://www.w3.org/2002/07/owl#Class>;
              <http://www.w3.org/2002/07/owl#disjointWith> msr:Unit,
                                                           msr:Quantity;
              <http://www.w3.org/2002/07/owl#hasValue> msr:Unit;
              <http://www.w3.org/2002/07/owl#onProperty> rdfs:subClassOf.
msr:UnitSystem a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:description "A unit system is a class of units for which no two elements in the class measure the same dimension (i.e. all dimensions are orthogonal to each other, or measure dimensions derived from a set of orthogonal dimensions with units derived from the units that measure those orthogonal dimensions specified in the system."@en;
               rdfs:label "Unit System"@en;
               rdfs:subClassOf msr:UnitClass.
msr:area a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:label "area"@en;
         rdfs:range msr:AreaMeasurement.
msr:equivalentQuantity a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>;
                       rdfs:description "An equivalent quantity of a unit class is the quantity measured by all units in the unit class."@en;
                       rdfs:domain msr:UnitClass;
                       rdfs:label "equivalent quantity"@en;
                       rdfs:range msr:Quantity;
                       <http://www.w3.org/2002/07/owl#inverseOf> msr:unitClass.
msr:equivalentUnitClass a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                        rdfs:description "An equivalent unit class of a quantity is the unit class corresponding to units that measure the quantity."@en;
                        rdfs:domain msr:Quantity;
                        rdfs:label "equivalent unit class"@en;
                        rdfs:range msr:UnitClass;
                        <http://www.w3.org/2002/07/owl#inverseOf> msr:quantityMeasured.
msr:quantityMeasured a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                     rdfs:description "The quantity measured for a measurement."@en;
                     rdfs:domain msr:Measurement;
                     rdfs:label "measured quantity"@en;
                     rdfs:range msr:Quantity;
                     rdfs:subPropertyOf <http://purl.org/NET/scovo#dimension>.
msr:unit a <http://www.w3.org/2002/07/owl#ObjectProperty>,
           <http://www.w3.org/2002/07/owl#FunctionalProperty>;
         rdfs:description "The unit a measurement is made in."@en;
         rdfs:domain msr:Measurement;
         rdfs:label "unit"@en;
         rdfs:range msr:Unit;
         rdfs:subPropertyOf <http://purl.org/NET/scovo#dimension>.
