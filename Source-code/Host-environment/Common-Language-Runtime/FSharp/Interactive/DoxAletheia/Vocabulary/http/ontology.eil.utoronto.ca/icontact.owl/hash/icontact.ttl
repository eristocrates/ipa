                   rdfs:label "has Street"@en;
                   rdfs:subPropertyOf icontact:addressDataProperty.
icontact:hasStreetDirection a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:domain icontact:Address;
