                            rdfs:range icontact:StreetDirection;
                            rdfs:subPropertyOf icontact:addressProperty.
icontact:hasStreetNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:label "has Street Number"@en;
                         rdfs:subPropertyOf icontact:addressDataProperty.
icontact:hasStreetType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain icontact:Address;
                       rdfs:label "has Street Type"@en;
                       rdfs:range icontact:StreetType;
                       rdfs:subPropertyOf icontact:addressProperty.
icontact:hasTelephone a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:label "has Telephone"@en;
                      rdfs:subPropertyOf icontact:contactProperty.
icontact:hasUnitNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:label "has Unit Number"@en;
