                    rdfs:label "has Web Site"@en;
                    rdfs:range xsd:string;
                    rdfs:subPropertyOf icontact:hasContactDataProperty.
icontact:hasWorkEmail a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:label "has Work Email"@en;
                      rdfs:subPropertyOf icontact:emailDataProperty.
icontact:iContactThing a <http://www.w3.org/2002/07/owl#Class>.
