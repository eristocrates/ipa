@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix chord: <http://purl.org/ontology/chord/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix planet: <http://dbpedia.org/>.
@prefix resource: <http://dbpedia.org/resource/>.
@prefix event: <http://purl.org/NET/c4dm/event.owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

chord: dc11:date "2007-09-11";
       dc11:description """FIXME
		""";
       dc11:title "The Chord Ontology";
       a owl:Ontology;
       owl:versionInfo "Revision: 0.1";
       foaf:maker <http://chrissutton.org/me>.
chord:Chord a rdfs:Class,
              owl:Class;
            rdfs:comment "Two or more notes played together.";
            rdfs:isDefinedBy chord:;
            rdfs:label "Chord".
chord:ChordEvent a rdfs:Class,
                   owl:Class;
                 rdfs:comment "A chord being played.";
                 rdfs:isDefinedBy chord:;
                 rdfs:label "ChordEvent";
                 rdfs:subClassOf event:Event.
chord:Interval a rdfs:Class,
                 owl:Class;
               rdfs:comment "An interval above the root of a chord.";
               rdfs:isDefinedBy chord:;
               rdfs:label "Interval".
chord:Modifier a rdfs:Class,
                 owl:Class;
               rdfs:comment "A modifier applied to a note to change its pitch.";
               rdfs:isDefinedBy chord:;
               rdfs:label "Modifier".
chord:Natural a rdfs:Class,
                owl:Class;
              rdfs:comment "One of the seven natural notes of the Western music system.";
              rdfs:isDefinedBy chord:;
              rdfs:label "Natural";
              rdfs:subClassOf chord:Note.
chord:Note a rdfs:Class,
             owl:Class;
           rdfs:comment "FIXME";
           rdfs:isDefinedBy chord:;
           rdfs:label "Note".
chord:ScaleInterval a rdfs:Class,
                      owl:Class;
                    rdfs:comment "An interval in the root scale, made up of the degree of the scale and optional modifier.";
                    rdfs:isDefinedBy chord:;
                    rdfs:label "ScaleInterval";
                    rdfs:subClassOf chord:Interval.
chord:SemitoneInterval a rdfs:Class,
                         owl:Class;
                       rdfs:comment "A semitone interval.";
                       rdfs:isDefinedBy chord:;
                       rdfs:label "SemitoneInterval";
                       rdfs:subClassOf chord:Interval.
chord:aug chord:interval [chord:degree "1" ; 
                          a chord:ScaleInterval],
                         [chord:degree "3" ; 
                          a chord:ScaleInterval],
                         [chord:modifier chord:sharp ; 
                          chord:degree "5" ; 
                          a chord:ScaleInterval];
          a chord:Chord;
          rdfs:comment "An augmented chord.";
          rdfs:isDefinedBy chord:;
          rdfs:label "aug";
          rdfs:seeAlso resource:Augmented_chord.
chord:base_chord a rdf:Property;
                 rdfs:comment """The chord on which this one is based. 
			For example, a C7 chord might have chord:Cmaj as its base chord.""";
                 rdfs:domain chord:Chord;
                 rdfs:isDefinedBy chord:;
                 rdfs:label "base_chord";
                 rdfs:range chord:Chord.
chord:bass a rdf:Property;
           rdfs:comment "The bass note of the chord (indicates the inversion).";
           rdfs:domain chord:Chord;
           rdfs:isDefinedBy chord:;
           rdfs:label "bass";
           rdfs:range chord:Interval.
chord:chord a rdf:Property;
            rdfs:comment "The chord associated with a chord event.";
            rdfs:domain chord:ChordEvent;
            rdfs:isDefinedBy chord:;
            rdfs:label "chord";
            rdfs:range chord:Chord.
chord:degree a rdf:Property;
             rdfs:comment "The degree of an interval based on the root of a chord.";
             rdfs:domain chord:ScaleInterval;
             rdfs:isDefinedBy chord:;
             rdfs:label "degree";
             rdfs:range xsd:integer.
chord:dim chord:interval [chord:degree "1" ; 
                          a chord:ScaleInterval],
                         [chord:modifier chord:flat ; 
                          chord:degree "3" ; 
                          a chord:ScaleInterval],
                         [chord:modifier chord:flat ; 
                          chord:degree "5" ; 
                          a chord:ScaleInterval];
          a chord:Chord;
          rdfs:comment "A diminished chord.";
          rdfs:isDefinedBy chord:;
          rdfs:label "dim";
          rdfs:seeAlso resource:Diminished_chord.
chord:dim7 chord:interval [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "3" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:doubleflat ; 
                           chord:degree "7" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A diminished seventh chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "dim7".
chord:doubleflat a chord:Modifier;
                 rdfs:isDefinedBy chord:;
                 rdfs:label "double flat".
chord:doublesharp a chord:Modifier;
                  rdfs:isDefinedBy chord:;
                  rdfs:label "double sharp".
chord:flat a chord:Modifier;
           rdfs:isDefinedBy chord:;
           rdfs:label "flat".
chord:hdim7 chord:interval [chord:degree "1" ; 
                            a chord:ScaleInterval],
                           [chord:modifier chord:flat ; 
                            chord:degree "3" ; 
                            a chord:ScaleInterval],
                           [chord:modifier chord:flat ; 
                            chord:degree "5" ; 
                            a chord:ScaleInterval],
                           [chord:modifier chord:flat ; 
                            chord:degree "7" ; 
                            a chord:ScaleInterval];
            a chord:Chord;
            rdfs:comment "A half-diminished seventh chord.";
            rdfs:isDefinedBy chord:;
            rdfs:label "hdim7".
chord:interval a rdf:Property;
               rdfs:comment "An interval from the root which is part of the chord.";
               rdfs:domain chord:Chord;
               rdfs:isDefinedBy chord:;
               rdfs:label "interval";
               rdfs:range chord:Interval.
chord:maj chord:interval [chord:degree "1" ; 
                          a chord:ScaleInterval],
                         [chord:degree "3" ; 
                          a chord:ScaleInterval],
                         [chord:degree "5" ; 
                          a chord:ScaleInterval];
          a chord:Chord;
          rdfs:comment "A major chord.";
          rdfs:isDefinedBy chord:;
          rdfs:label "maj";
          rdfs:seeAlso resource:Major_chord.
chord:maj6 chord:interval [chord:degree "3" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:degree "6" ; 
                           a chord:ScaleInterval],
                          [chord:degree "1" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A major sixth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "maj6";
           rdfs:seeAlso resource:Sixth_chord,
                        resource:Major_chord.
chord:maj7 chord:interval [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:degree "3" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:degree "7" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A major seventh chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "maj7";
           rdfs:seeAlso resource:Major_seventh_chord.
chord:maj9 chord:interval [chord:degree "7" ; 
                           a chord:ScaleInterval],
                          [chord:degree "9" ; 
                           a chord:ScaleInterval],
                          [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:degree "3" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A major ninth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "maj9";
           rdfs:seeAlso resource:Major_chord.
chord:min chord:interval [chord:degree "1" ; 
                          a chord:ScaleInterval],
                         [chord:modifier chord:flat ; 
                          chord:degree "3" ; 
                          a chord:ScaleInterval],
                         [chord:degree "5" ; 
                          a chord:ScaleInterval];
          a chord:Chord;
          rdfs:comment "A minor chord.";
          rdfs:isDefinedBy chord:;
          rdfs:label "min";
          rdfs:seeAlso resource:Minor_chord.
chord:min6 chord:interval [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:degree "6" ; 
                           a chord:ScaleInterval],
                          [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "3" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A minor sixth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "min6";
           rdfs:seeAlso resource:Sixth_chord,
                        resource:Minor_chord.
chord:min7 chord:interval [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "3" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "7" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A minor seventh chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "min7";
           rdfs:seeAlso resource:Minor_seventh_chord.
chord:min9 chord:interval [chord:modifier chord:flat ; 
                           chord:degree "7" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval],
                          [chord:degree "9" ; 
                           a chord:ScaleInterval],
                          [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:modifier chord:flat ; 
                           chord:degree "3" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A minor ninth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "min9";
           rdfs:seeAlso resource:Minor_chord.
chord:minmaj7 chord:interval [chord:degree "1" ; 
                              a chord:ScaleInterval],
                             [chord:modifier chord:flat ; 
                              chord:degree "3" ; 
                              a chord:ScaleInterval],
                             [chord:degree "5" ; 
                              a chord:ScaleInterval],
                             [chord:degree "7" ; 
                              a chord:ScaleInterval];
              a chord:Chord;
              rdfs:comment "A minor (major 7th) chord.";
              rdfs:isDefinedBy chord:;
              rdfs:label "minmaj7";
              rdfs:seeAlso resource:Minor_major_seventh_chord.
chord:modifier a rdf:Property;
               rdfs:comment "A modification to a note's pitch.";
               rdfs:domain [owl:unionOf (chord:Note
                                         chord:ScaleInterval) ; 
                            a owl:Class];
               rdfs:isDefinedBy chord:;
               rdfs:label "modifier";
               rdfs:range chord:Modifier.
chord:natural a rdf:Property;
              rdfs:comment "The natural from which this note is derived.";
              rdfs:domain chord:Note;
              rdfs:isDefinedBy chord:;
              rdfs:label "natural";
              rdfs:range chord:Natural.
chord:ninth chord:interval [chord:degree "1" ; 
                            a chord:ScaleInterval],
                           [chord:degree "3" ; 
                            a chord:ScaleInterval],
                           [chord:degree "5" ; 
                            a chord:ScaleInterval],
                           [chord:modifier chord:flat ; 
                            chord:degree "7" ; 
                            a chord:ScaleInterval],
                           [chord:degree "9" ; 
                            a chord:ScaleInterval];
            a chord:Chord;
            rdfs:comment "A ninth chord.";
            rdfs:isDefinedBy chord:;
            rdfs:label "9".
chord:noChord a chord:Chord;
              rdfs:comment "Indicates that no chord is played.";
              rdfs:isDefinedBy chord:;
              rdfs:label "noChord".
<http://purl.org/ontology/chord/note/A> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "A".
<http://purl.org/ontology/chord/note/Ab> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/A>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Ab".
<http://purl.org/ontology/chord/note/As> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/A>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "A#".
<http://purl.org/ontology/chord/note/B> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "B".
<http://purl.org/ontology/chord/note/Bb> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/B>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Bb".
<http://purl.org/ontology/chord/note/Bs> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/B>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "B#".
<http://purl.org/ontology/chord/note/C> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "C".
<http://purl.org/ontology/chord/note/Cb> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/C>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Cb".
<http://purl.org/ontology/chord/note/Cs> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/C>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "C#".
<http://purl.org/ontology/chord/note/D> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "D".
<http://purl.org/ontology/chord/note/Db> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/D>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Db".
<http://purl.org/ontology/chord/note/Ds> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/D>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "D#".
<http://purl.org/ontology/chord/note/E> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "E".
<http://purl.org/ontology/chord/note/Eb> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/E>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Eb".
<http://purl.org/ontology/chord/note/Es> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/E>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "E#".
<http://purl.org/ontology/chord/note/F> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "F".
<http://purl.org/ontology/chord/note/Fb> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/F>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Fb".
<http://purl.org/ontology/chord/note/Fs> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/F>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "F#".
<http://purl.org/ontology/chord/note/G> a chord:Natural;
                                        rdfs:isDefinedBy chord:;
                                        rdfs:label "G".
<http://purl.org/ontology/chord/note/Gb> chord:modifier chord:flat;
                                         chord:natural <http://purl.org/ontology/chord/note/G>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "Gb".
<http://purl.org/ontology/chord/note/Gs> chord:modifier chord:sharp;
                                         chord:natural <http://purl.org/ontology/chord/note/G>;
                                         a chord:Note;
                                         rdfs:isDefinedBy chord:;
                                         rdfs:label "G#".
chord:root a rdf:Property;
           rdfs:comment "The root note of the chord.";
           rdfs:domain chord:Chord;
           rdfs:isDefinedBy chord:;
           rdfs:label "root";
           rdfs:range chord:Note.
chord:semitone_interval a rdf:Property;
                        rdfs:comment "An interval measured in semitones.";
                        rdfs:domain chord:SemitoneInterval;
                        rdfs:isDefinedBy chord:;
                        rdfs:label "semitone_interval";
                        rdfs:range xsd:integer.
chord:seventh chord:interval [chord:degree "1" ; 
                              a chord:ScaleInterval],
                             [chord:degree "3" ; 
                              a chord:ScaleInterval],
                             [chord:degree "5" ; 
                              a chord:ScaleInterval],
                             [chord:modifier chord:flat ; 
                              chord:degree "7" ; 
                              a chord:ScaleInterval];
              a chord:Chord;
              rdfs:comment "A seventh chord.";
              rdfs:isDefinedBy chord:;
              rdfs:label "7";
              rdfs:seeAlso resource:Seventh_chord.
chord:sharp a chord:Modifier;
            rdfs:isDefinedBy chord:;
            rdfs:label "sharp".
chord:sus2 chord:interval [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:degree "2" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A suspended fourth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "sus2";
           rdfs:seeAlso resource:Suspended_chord.
chord:sus4 chord:interval [chord:degree "1" ; 
                           a chord:ScaleInterval],
                          [chord:degree "4" ; 
                           a chord:ScaleInterval],
                          [chord:degree "5" ; 
                           a chord:ScaleInterval];
           a chord:Chord;
           rdfs:comment "A suspended fourth chord.";
           rdfs:isDefinedBy chord:;
           rdfs:label "sus4";
           rdfs:seeAlso resource:Suspended_chord.
chord:without_interval a rdf:Property;
                       rdfs:comment "A degree of the scale expected in the chord but not actually present here.";
                       rdfs:domain chord:Chord;
                       rdfs:isDefinedBy chord:;
                       rdfs:label "without_interval";
                       rdfs:range chord:ScaleInterval.
