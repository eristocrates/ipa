                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:sourceCountry ; 
                                 a owl:Restriction],
                                dtx_srti:CommonClasses.
dtx_srti:SourceTypeEnum a owl:Class;
                        rdfs:comment "Information about the technology used for measuring the data or the method used for obtaining qualitative descriptions relating to this version of the information."@en;
                        rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                        owl:equivalentClass [owl:oneOf (dtx_srti:automobileClubPatrol
                                                        dtx_srti:cameraObservation
