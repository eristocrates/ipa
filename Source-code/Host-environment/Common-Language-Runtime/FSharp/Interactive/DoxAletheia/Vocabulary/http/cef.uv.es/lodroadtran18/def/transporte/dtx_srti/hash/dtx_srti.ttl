                 rdfs:comment "Gallery."@en.
dtx_srti:gantry a dtx_srti:SubjectTypeOfWorksEnum,
                  owl:NamedIndividual;
                rdfs:comment "Gantry over or above the roadway."@en.
dtx_srti:gardeningOrFlowerShow a dtx_srti:PublicEventTypeEnum,
                                 owl:NamedIndividual;
                               rdfs:comment "Gardening and/or flower show or event which could disrupt traffic."@en.
dtx_srti:gasLeak a dtx_srti:InfrastructureDamageTypeEnum,
                   owl:NamedIndividual;
                 rdfs:comment "Traffic may be disrupted due to an explosion hazard from gas escaping in or near the roadway."@en.
dtx_srti:gasMainWork a dtx_srti:SubjectTypeOfWorksEnum,
                       owl:NamedIndividual;
                     rdfs:comment "Gas mains."@en.
dtx_srti:generalMessageToRoadUsers a owl:DatatypeProperty;
                                   rdfs:comment "General message that is issued by the network/road operator which is applicable to drivers and sometimes passengers, e.g. details about an amber alert (missing or abducted child alert)."@en;
                                   rdfs:domain dtx_srti:GeneralInstructionOrMessageToRoadUsers;
                                   rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString>.
dtx_srti:geoSparqlDataProperties a owl:DatatypeProperty;
                                 rdfs:comment "For organizational purposes"@en;
                                 rdfs:subPropertyOf dtx_srti:importedDataProperties.
dtx_srti:geoSparqlObjectProperties a owl:ObjectProperty;
                                   rdfs:comment "Only for organizational purposes. GeoSparql object properties"@en;
                                   rdfs:subPropertyOf dtx_srti:importedObjectProperties.
dtx_srti:geo_WGS84 a owl:DatatypeProperty;
                   rdfs:comment "For organizational purposes. Properties of the WGS84 Geo Positioning by World Wide Web Consortium (W3C). A vocabulary for representing latitude, longitude and altitude information in the WGS84 geodetic reference datum. WGS stands for the World Geodetic Survey."@en;
                   rdfs:subPropertyOf dtx_srti:importedDataProperties.
dtx_srti:geo_core a owl:DatatypeProperty;
                  rdfs:comment "For organizational purposes. Properties of the ontology for the representation of Geographical Objects https://datos.ign.es/def/geo_core"@en;
                  rdfs:subPropertyOf dtx_srti:importedDataProperties.
dtx_srti:geographicalEntity a dtx_srti:SubdivisionTypeEnum,
                              owl:NamedIndividual;
                            rdfs:comment "Geographical entity"@en.
dtx_srti:gmlAreaName a owl:DatatypeProperty;
                     rdfs:comment "Name of the multi-polygon area"@en;
                     rdfs:domain dtx_srti:GmlMultiPolygon;
                     rdfs:range <http://datex2.eu/schema/3/Common/3_1#MultilingualString>.
dtx_srti:gmlPosList a owl:DatatypeProperty;
                    rdfs:comment "List of coordinate Tuples define the geometry of this GmlLineString. There must be at least 2 Tuples of coordinates."@en;
                    rdfs:domain dtx_srti:GmlLineString;
                    rdfs:range <http://datex2.eu/schema/3/Common/3_1#GmlPosList>.
dtx_srti:golfTournament a dtx_srti:PublicEventTypeEnum,
                          owl:NamedIndividual;
                        rdfs:comment "Golf tournament event that could disrupt traffic."@en.
dtx_srti:governorate a dtx_srti:SubdivisionTypeEnum,
                       owl:NamedIndividual;
                     rdfs:comment "Governorate"@en.
dtx_srti:gravityRelatedHeight a dtx_srti:HeightTypeEnum,
                                owl:NamedIndividual;
                              rdfs:comment "Height type corresponding a value measured along direction of gravity above the reference geoid i.e. equipotential surface of the Earth's gravity field which globally approximates mean sea level."@en.
dtx_srti:hail a dtx_srti:PoorEnvironmentTypeEnum,
                owl:NamedIndividual;
              rdfs:comment "Small balls of ice and compacted snow."@en.
dtx_srti:hardShoulder a dtx_srti:LaneEnum,
                        owl:NamedIndividual;
                      rdfs:comment "On the hard shoulder."@en.
dtx_srti:hardShoulderRunningInOperation a dtx_srti:RoadOrCarriagewayOrLaneManagementTypeEnum,
                                          owl:NamedIndividual;
                                        rdfs:comment "The hard shoulder is open as an operational lane."@en.
dtx_srti:harmonicAverageOfSamplesInATimePeriod a dtx_srti:ComputationMethodEnum,
                                                 owl:NamedIndividual;
                                               rdfs:comment "Harmonic average of sample values in a time period."@en.
dtx_srti:hasAbnormalTrafficType a owl:ObjectProperty;
                                rdfs:comment "A characterization of the nature of abnormal traffic flow, i.e. specifically relating to the nature of the traffic movement, implying a level of service."@en;
                                rdfs:domain dtx_srti:AbnormalTraffic;
                                rdfs:range dtx_srti:AbnormalTrafficTypeEnum;
                                rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasAccidentType a owl:ObjectProperty;
                         rdfs:comment "A characterization of the nature of the accident."@en;
                         rdfs:domain dtx_srti:Accident;
                         rdfs:range dtx_srti:AccidentTypeEnum.
dtx_srti:hasAdministrativeAreaOfLinearSection a owl:ObjectProperty;
                                              rdfs:comment "Identification of the road administration area which contains the specified linear section."@en;
                                              rdfs:domain dtx_srti:LinearWithinLinearElement;
                                              rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit>.
dtx_srti:hasAdministrativeAreaOfPoint a owl:ObjectProperty;
                                      rdfs:comment "Identification of the road administration area which contains the specified point."@en;
                                      rdfs:domain dtx_srti:PointAlongLinearElement;
                                      rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit>.
dtx_srti:hasAlertCAffectedDirection a owl:ObjectProperty;
                                    rdfs:comment "The direction(s) of traffic flow to which the situation, traffic data or information is related."@en;
                                    rdfs:domain dtx_srti:AlertCDirection;
                                    rdfs:range dtx_srti:LinearDirectionEnum.
dtx_srti:hasAlertCArea a owl:ObjectProperty;
                       rdfs:comment "ALERT-C Area"@en;
                       rdfs:domain dtx_srti:AreaLocation;
                       rdfs:range dtx_srti:AlertCArea.
dtx_srti:hasAlertCDirection a owl:ObjectProperty;
                            rdfs:comment "The direction of traffic flow along the road to which the information relates."@en,
                                         "ALERT-C direction"@en;
                            rdfs:domain [owl:unionOf (dtx_srti:AlertCLinearByCode
                                                      dtx_srti:AlertCMethod2Linear
                                                      dtx_srti:AlertCMethod2Point
                                                      dtx_srti:AlertCMethod4Linear
                                                      dtx_srti:AlertCMethod4Point) ; 
                                         a owl:Class];
                            rdfs:range dtx_srti:AlertCDirection.
dtx_srti:hasAlertCDirectionCoded a owl:ObjectProperty;
                                 rdfs:comment "Direction of navigation with respect to secondary to primary location (RDS direction)"@en;
                                 rdfs:domain dtx_srti:AlertCDirection;
                                 rdfs:range dtx_srti:AlertCDirectionEnum.
dtx_srti:hasAlertCLinear a owl:ObjectProperty;
                         rdfs:comment "The linear location expressed using AlertC. Multiple instances of AlertCLinear shall represent the same real-world geographic feature."@en;
                         rdfs:domain dtx_srti:SingleRoadLinearLocation;
                         rdfs:range dtx_srti:AlertCLinear.
dtx_srti:hasAlertCLocation a owl:ObjectProperty;
                           rdfs:comment "Identification of a specific point, linear or area location in an ALERT-C location table."@en,
                                        "ALERT-C location"@en;
                           rdfs:domain [owl:unionOf (dtx_srti:AlertCArea
                                                     dtx_srti:AlertCMethod2PrimaryPointLocation
                                                     dtx_srti:AlertCMethod2SecondaryPointLocation
                                                     dtx_srti:AlertCMethod4PrimaryPointLocation
                                                     dtx_srti:AlertCMethod4SecondaryPointLocation) ; 
                                        a owl:Class];
                           rdfs:range dtx_srti:AlertCLocation.
dtx_srti:hasAlertCMethod2PrimaryPointLocation a owl:ObjectProperty;
                                              rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en,
                                                           "ALERT-C method2 primary point location"@en;
                                              rdfs:domain [owl:unionOf (dtx_srti:AlertCMethod2Linear
                                                                        dtx_srti:AlertCMethod2Point) ; 
                                                           a owl:Class];
                                              rdfs:range dtx_srti:AlertCMethod2PrimaryPointLocation.
dtx_srti:hasAlertCMethod2SecondaryPointLocation a owl:ObjectProperty;
                                                rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en,
                                                             "ALERT-C method2 secondary point location"@en;
                                                rdfs:domain dtx_srti:AlertCMethod2Linear;
                                                rdfs:range dtx_srti:AlertCMethod2SecondaryPointLocation.
dtx_srti:hasAlertCMethod4PrimaryPointLocation a owl:ObjectProperty;
                                              rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table plus a non-negative offset distance."@en,
                                                           "ALERT-C method4 primary point location"@en;
                                              rdfs:domain [owl:unionOf (dtx_srti:AlertCMethod4Linear
                                                                        dtx_srti:AlertCMethod4Point) ; 
                                                           a owl:Class];
                                              rdfs:range dtx_srti:AlertCMethod4PrimaryPointLocation.
dtx_srti:hasAlertCMethod4SecondaryPointLocation a owl:ObjectProperty;
                                                rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined Alert-C location table plus a non-negative offset distance."@en,
                                                             "ALERT-C method4 secondary point location"@en;
                                                rdfs:domain dtx_srti:AlertCMethod4Linear;
                                                rdfs:range dtx_srti:AlertCMethod4SecondaryPointLocation.
dtx_srti:hasAlertCPoint a owl:ObjectProperty;
                        rdfs:comment "The point location expressed using AlertC. Multiple instances of AlertCPoint shall represent the same real-world geographic feature.They should represent the same point using different location tables."@en,
                                     "PointLocation is associated to AlertCPoint with cardinality 0..*"@en,
                                     "ALERT-C point"@en,
                                     "A single point on the road network defined by reference to a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en;
                        rdfs:domain dtx_srti:PointLocation;
                        rdfs:range dtx_srti:AlertCPoint.
dtx_srti:hasAltitudeAccuracyCodedValue a owl:ObjectProperty;
                                       rdfs:comment "Absolute accuracy of reported value of a geographical point for a confidence level expressed by a coded scale."@en;
                                       rdfs:domain dtx_srti:AltitudeConfidence;
                                       rdfs:range dtx_srti:AltitudeAccuracyEnum.
dtx_srti:hasAltitudeConfidence a owl:ObjectProperty;
                               rdfs:comment "Evaluation of the altitude confidence assessed according to ETSI ISO 102894-2"@en;
                               rdfs:domain dtx_srti:HeightCoordinate;
                               rdfs:range dtx_srti:AltitudeConfidence.
dtx_srti:hasAnimalPresenceTypeEnum a owl:ObjectProperty;
                                   rdfs:comment "Indicates the nature of animals present on or near the roadway."@en;
                                   rdfs:domain dtx_srti:AnimalPresenceObstruction;
                                   rdfs:range dtx_srti:AnimalPresenceTypeEmum.
dtx_srti:hasAreaPlacesEnum a owl:ObjectProperty;
                           rdfs:comment "Places, in generic terms, at which the corresponding information applies."@en;
                           rdfs:domain dtx_srti:AreaLocation;
                           rdfs:range dtx_srti:AreaPlacesEnum.
dtx_srti:hasCarriageway a owl:ObjectProperty;
                        rdfs:comment "Supplementary positional information which details carriageway and lane locations. Several instances may exist where the element being described extends over more than one carriageway."@en;
                        rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                        rdfs:range dtx_srti:Carriageway.
dtx_srti:hasCarriagewayEnum a owl:ObjectProperty;
                            rdfs:comment "Indicates the section of carriageway to which the location relates."@en;
                            rdfs:domain dtx_srti:Carriageway;
                            rdfs:range dtx_srti:CarriagewayEnum.
dtx_srti:hasCentrePoint a owl:ObjectProperty;
                        rdfs:comment "Centre point of a circular geometric area."@en;
                        rdfs:domain dtx_srti:TpegGeometricArea;
                        rdfs:range dtx_srti:PointCoordinates.
dtx_srti:hasComputationMethodEnum a owl:ObjectProperty;
                                  rdfs:comment "Method of computation which has been used to compute this data value."@en;
                                  rdfs:domain dtx_srti:DataValue;
                                  rdfs:range dtx_srti:ComputationMethodEnum.
dtx_srti:hasConfidentiality a owl:ObjectProperty;
                            rdfs:comment "The extent to which the related information may be circulated, according to the recipient type. Recipients must comply with this confidentiality statement."@en;
                            rdfs:domain dtx_srti:HeaderInformation;
                            rdfs:range dtx_srti:ConfidentialityValueEnum;
                            rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasConstructionWorkType a owl:ObjectProperty;
                                 rdfs:comment "The type of construction work being performed."@en;
                                 rdfs:domain dtx_srti:ConstructionWorks;
                                 rdfs:range dtx_srti:ConstructionWorkTypeEnum.
dtx_srti:hasCountrySubdivision a owl:ObjectProperty;
                               rdfs:comment "The ISO 3166-2 subdivision code for the named area."@en;
                               rdfs:domain dtx_srti:IsoNamedArea;
                               rdfs:range <http://www.omg.org/spec/LCC/Countries/CountryRepresentation#CountrySubdivision>.
dtx_srti:hasDelays a owl:ObjectProperty;
                   rdfs:comment "The details of the delays being caused by the situation element defined in the situation record. It is recommended to only use one of the optional attributes to avoid confusion."@en;
                   rdfs:domain dtx_srti:Impact;
                   rdfs:range dtx_srti:Delays.
dtx_srti:hasDirectionPurpose a owl:ObjectProperty;
                             rdfs:comment "Identifies the main purpose of the road at the location"@en;
                             rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                             rdfs:range dtx_srti:DirectionPurposeEnum.
dtx_srti:hasDistanceAlongLinearElement a owl:ObjectProperty;
                                       rdfs:comment "Distance of a point along a linear element either measured from the start node or a defined referent on that linear element, where the start node is relative to the element definition rather than the direction of traffic flow."@en;
                                       rdfs:domain dtx_srti:PointAlongLinearElement;
                                       rdfs:range dtx_srti:DistanceAlongLinearElement.
dtx_srti:hasDistanceAlongLinearElementFrom a owl:ObjectProperty;
                                           rdfs:comment "A point on the linear element that defines the start node of the linear section."@en;
                                           rdfs:domain dtx_srti:LinearWithinLinearElement;
                                           rdfs:range dtx_srti:DistanceAlongLinearElement.
dtx_srti:hasDistanceAlongLinearElementTo a owl:ObjectProperty;
                                         rdfs:comment "A point on the linear element that defines the end node of the linear section."@en;
                                         rdfs:domain dtx_srti:LinearWithinLinearElement;
                                         rdfs:range dtx_srti:DistanceAlongLinearElement.
dtx_srti:hasDisturbanceActivityTypeEnum a owl:ObjectProperty;
                                        rdfs:comment "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en;
                                        rdfs:domain dtx_srti:DisturbanceActivity;
                                        rdfs:range dtx_srti:DisturbanceActivityTypeEnum;
                                        rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasDrivingConditionTypeEnum a owl:ObjectProperty;
                                     rdfs:comment "Types of the perceived driving conditions."@en;
                                     rdfs:domain dtx_srti:Conditions;
                                     rdfs:range dtx_srti:DrivingConditionTypeEnum.
dtx_srti:hasEnvironmentalObstructionTypeEnum a owl:ObjectProperty;
                                             rdfs:comment "Characterization of an obstruction on the road resulting from an environmental cause."@en;
                                             rdfs:domain dtx_srti:EnvironmentalObstruction;
                                             rdfs:range dtx_srti:EnvironmentalObstructionTypeEnum.
dtx_srti:hasGeneralInstructionOrMessageToRoadUsersType a owl:ObjectProperty;
                                                       rdfs:comment "General instruction that is issued by the network/road operator which is applicable to drivers and sometimes passengers.";
                                                       rdfs:domain dtx_srti:GeneralInstructionOrMessageToRoadUsers;
                                                       rdfs:range dtx_srti:GeneralInstructionOrMessageToRoadUsersTypeEnum.
dtx_srti:hasGeneralNetworkManagementType a owl:ObjectProperty;
                                         rdfs:comment "The type of traffic management action instigated by the network/road operator.";
                                         rdfs:domain dtx_srti:GeneralNetworkManagement;
                                         rdfs:range dtx_srti:GeneralNetworkManagementTypeEnum.
dtx_srti:hasGeographicDescriptor a owl:ObjectProperty;
                                 rdfs:comment "Descriptor which identifies a geographic characteristic to help identify the specific location"@en;
                                 rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                                 rdfs:range dtx_srti:GeographicCharacteristicEnum.
dtx_srti:hasGmlExteriorLinearRing a owl:ObjectProperty;
                                  rdfs:comment "A boundary of a polygonal surface consisting of a ring i.e. in the normal 2D case, a closed polygonal line distinguished as exterior. Such a polygonal line has at least 4 pairs of coordinates"@en;
                                  rdfs:domain dtx_srti:GmlPolygon;
                                  rdfs:range dtx_srti:GmlLinearRing.
dtx_srti:hasGmlInteriorLinearRing a owl:ObjectProperty;
                                  rdfs:comment "A boundary of internal patches of a polygonal surface consisting of a ring feature"@en;
                                  rdfs:domain dtx_srti:GmlPolygon;
                                  rdfs:range dtx_srti:GmlLinearRing.
dtx_srti:hasGmlLineString a owl:ObjectProperty;
                          rdfs:comment """Line string based on GML (EN ISO 19136) definition: a curve defined by a series of two or more coordinate tuples. Unlike GML may be self-intersecting. If srsName attribute is not present, posList is assumed to use \"ETRS89-LatLonh\" reference system."""@en;
                          rdfs:domain [owl:unionOf (dtx_srti:LinearElementByLineString
                                                    dtx_srti:LinearLocation) ; 
                                       a owl:Class];
                          rdfs:range dtx_srti:GmlLineString.
dtx_srti:hasGmlMultiPolygon a owl:ObjectProperty;
                            rdfs:comment "An area defined by a set of polygons acording to GML (EN ISO 19136)."@en;
                            rdfs:domain dtx_srti:AreaLocation;
                            rdfs:range dtx_srti:GmlMultiPolygon.
dtx_srti:hasGmlPolygon a owl:ObjectProperty;
                       rdfs:comment "Planar surface defined by 1 exterior boundary and 0 or more interior boundaries"@en;
                       rdfs:domain dtx_srti:GmlMultiPolygon;
                       rdfs:range dtx_srti:GmlPolygon.
dtx_srti:hasHeaderInformation a owl:ObjectProperty;
                              rdfs:comment "Management information relating to the data contained within a publication."@en;
                              rdfs:domain dtx_srti:Situation;
                              rdfs:range dtx_srti:HeaderInformation.
dtx_srti:hasHeightCoordinate a owl:ObjectProperty;
                             rdfs:comment "Third coordinate for points defined geodetically"@en;
                             rdfs:domain dtx_srti:PointCoordinates;
                             rdfs:range dtx_srti:HeightCoordinate.
dtx_srti:hasHeightGradeOfLinearSection a owl:ObjectProperty;
                                       rdfs:comment """Identification of whether the linear section that is part of the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."""@en;
                                       rdfs:domain dtx_srti:LinearWithinLinearElement;
                                       rdfs:range dtx_srti:HeightGradeEnum.
dtx_srti:hasHeightGradeOfPoint a owl:ObjectProperty;
                               rdfs:comment """Identification of whether the point on the linear element is at, above or below the normal elevation of a linear element of that type (e.g. road or road section) at that location, typically used to indicate \"grade\" separation."""@en;
                               rdfs:domain dtx_srti:PointAlongLinearElement;
                               rdfs:range dtx_srti:HeightGradeEnum.
dtx_srti:hasHeightTypeEnum a owl:ObjectProperty;
                           rdfs:comment "Type of measured height.When it is omitted it is supposed to be the ellipsoidal height."@en;
                           rdfs:domain dtx_srti:HeightCoordinate;
                           rdfs:range dtx_srti:HeightTypeEnum.
dtx_srti:hasHorizontalPositionAccuracy a owl:ObjectProperty;
                                       rdfs:comment "Defines the horizontal position accuracy according EN 16803-1"@en;
                                       rdfs:domain dtx_srti:PointCoordinates;
                                       rdfs:range dtx_srti:PositionAccuracy.
dtx_srti:hasImpact a owl:ObjectProperty;
                   rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions."@en;
                   rdfs:domain dtx_srti:SituationRecord;
                   rdfs:range dtx_srti:Impact;
                   rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasImpactOnOppositeDirection a owl:ObjectProperty;
                                      rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions, but on opposite direction."@en;
                                      rdfs:domain dtx_srti:SituationRecord;
                                      rdfs:range dtx_srti:Impact.
dtx_srti:hasInformationStatus a owl:ObjectProperty;
                              rdfs:comment "The status of the related information (real, test, exercise ....)."@en;
                              rdfs:domain dtx_srti:HeaderInformation;
                              rdfs:range dtx_srti:InformationStatusEnum.
dtx_srti:hasInfrastructureDamageType a owl:ObjectProperty;
                                     rdfs:comment "Types of infrastructure damage which may have an effect on the road network."@en;
                                     rdfs:domain dtx_srti:InfrastructureDamageObstruction;
                                     rdfs:range dtx_srti:InfrastructureDamageTypeEnum.
dtx_srti:hasInfrastructureDescriptor a owl:ObjectProperty;
                                     rdfs:comment "Descriptor which identifies infrastructure to help identify the specific location."@en;
                                     rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                                     rdfs:range dtx_srti:InfrastructureDescriptorEnum.
dtx_srti:hasLane a owl:ObjectProperty;
                 rdfs:comment "Indicates a specific lane or group of lanes."@en;
                 rdfs:domain dtx_srti:Carriageway;
                 rdfs:range dtx_srti:Lane.
dtx_srti:hasLaneEnum a owl:ObjectProperty;
                     rdfs:comment "Indicates the specific lane to which the location relates."@en;
                     rdfs:domain dtx_srti:Lane;
                     rdfs:range dtx_srti:LaneEnum.
dtx_srti:hasLinearElement a owl:ObjectProperty;
                          rdfs:comment "Specifies a linear element along a single linear object, consistent with EN ISO 19148 definitions."@en;
                          rdfs:domain [owl:unionOf (dtx_srti:LinearWithinLinearElement
                                                    dtx_srti:PointAlongLinearElement) ; 
                                       a owl:Class];
                          rdfs:range dtx_srti:LinearElement.
dtx_srti:hasLinearElementNature a owl:ObjectProperty;
                                rdfs:comment "An indication of the nature of the linear element."@en;
                                rdfs:domain dtx_srti:LinearElement;
                                rdfs:range dtx_srti:LinearElementNatureEnum.
dtx_srti:hasLinearWithinLinearElement a owl:ObjectProperty;
                                      rdfs:comment "Specifies a linear section along a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with ISO 19148 definitions."@en;
                                      rdfs:domain dtx_srti:SingleRoadLinearLocation;
                                      rdfs:range dtx_srti:LinearWithinLinearElement.
dtx_srti:hasLocationCodeForLinearLocation a owl:ObjectProperty;
                                          rdfs:comment "Specific location. Unique code within the ALERT-C location table which identifies the specific point, linear or area location.Unique code within the ALERT-C location table which identifies the specific point, linear or area location."@en;
                                          rdfs:domain dtx_srti:AlertCLinearByCode;
                                          rdfs:range dtx_srti:AlertCLocation.
dtx_srti:hasLocationContainedInItinerary a owl:ObjectProperty;
                                         rdfs:comment "A location contained in an itinerary (i.e. an ordered set of locations defining a route or itinerary)."@en;
                                         rdfs:domain dtx_srti:ItineraryByIndexedLocations;
                                         rdfs:range dtx_srti:Location.
dtx_srti:hasLocationReference a owl:ObjectProperty;
                              rdfs:comment "Has a location reference"@en;
                              rdfs:domain dtx_srti:SituationRecord;
                              rdfs:range dtx_srti:LocationReference;
                              owl:inverseOf dtx_srti:isLocationReferenceOf.
dtx_srti:hasMaintenanceVehicleActions a owl:ObjectProperty;
                                      rdfs:comment "The actions of the maintenance vehicles associated with the roadworks activities."@en;
                                      rdfs:domain dtx_srti:MaintenanceVehicles;
                                      rdfs:range dtx_srti:MaintenanceVehicleActionsEnum.
dtx_srti:hasMaintenanceVehicles a owl:ObjectProperty;
                                rdfs:comment "Details of the maintenance vehicles involved in the roadworks activity."@en;
                                rdfs:domain dtx_srti:RoadWorks;
                                rdfs:range dtx_srti:MaintenanceVehicles.
dtx_srti:hasMobility a owl:ObjectProperty;
                     rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en;
                     rdfs:range dtx_srti:Mobility;
                     rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasMobilityOfActivity a owl:ObjectProperty;
                               rdfs:comment "Specifies the mobility of activity"@en;
                               rdfs:domain dtx_srti:Activity;
                               rdfs:subPropertyOf dtx_srti:hasMobility.
dtx_srti:hasMobilityOfObstruction a owl:ObjectProperty;
                                  rdfs:comment "Specifies the mobility of a obstruction"@en;
                                  rdfs:domain dtx_srti:Obstruction;
                                  rdfs:subPropertyOf dtx_srti:hasMobility.
dtx_srti:hasMobilityType a owl:ObjectProperty;
                         rdfs:comment "Types of mobility relating to a situation element defined by a SituationReord."@en;
                         rdfs:domain dtx_srti:Mobility;
                         rdfs:range dtx_srti:MobilityTypeEnum.
dtx_srti:hasNamedArea a owl:ObjectProperty;
                      rdfs:comment "An area defined by a name and/or in terms of known boundaries, such as country or county boundaries or allocated control area of particular authority. The attributes do not form a union; instead, the smallest intersection forms the resulting area."@en;
                      rdfs:domain [owl:unionOf (dtx_srti:AreaLocation
                                                dtx_srti:SupplementaryPositionalDescription) ; 
                                   a owl:Class];
                      rdfs:range dtx_srti:NamedArea.
dtx_srti:hasNamedAreaTypeEnum a owl:ObjectProperty;
                              rdfs:comment "The type of the area."@en;
                              rdfs:domain dtx_srti:NamedArea;
                              rdfs:range dtx_srti:NamedAreaTypeEnum.
dtx_srti:hasNonWeatherRelatedRoadConditionTypeEnum a owl:ObjectProperty;
                                                   rdfs:comment "The type of road conditions which are not related to the weather."@en;
                                                   rdfs:domain dtx_srti:NonWeatherRelatedRoadConditions;
                                                   rdfs:range dtx_srti:NonWeatherRelatedRoadConditionTypeEnum.
dtx_srti:hasNutsCodeTypeEnum a owl:ObjectProperty;
                             rdfs:comment "The NUTS code type for the named area."@en;
                             rdfs:domain dtx_srti:NutsNamedArea;
                             rdfs:range dtx_srti:NutsCodeTypeEnum.
dtx_srti:hasObstructionTypeEnum a owl:ObjectProperty;
                                rdfs:comment "Characterization of the type of general obstruction."@en;
                                rdfs:domain dtx_srti:GeneralObstruction;
                                rdfs:range dtx_srti:ObstructionTypeEnum.
dtx_srti:hasOffsetDistance a owl:ObjectProperty;
                           rdfs:comment "The non-negative offset distance from the ALERT-C referenced point to the actual point."@en;
                           rdfs:domain [owl:unionOf (dtx_srti:AlertCMethod4PrimaryPointLocation
                                                     dtx_srti:AlertCMethod4SecondaryPointLocation) ; 
                                        a owl:Class];
                           rdfs:range dtx_srti:OffsetDistance.
dtx_srti:hasOpenlrAreaLocationReference a owl:ObjectProperty;
                                        rdfs:comment "A two-dimensional part of the surface of the earth which is bounded by a closed curve. An area location may cover parts of the road network but does not necessarily need to. It is represented according to the OpenLR standard for Area Locations"@en;
                                        rdfs:domain dtx_srti:AreaLocation;
                                        rdfs:range dtx_srti:OpenlrAreaLocationReference.
dtx_srti:hasOpenlrCoordinates a owl:ObjectProperty;
                              rdfs:comment "Corresponding coordinates of an OpenLR point defined by its only coordinates."@en;
                              rdfs:domain [owl:unionOf (dtx_srti:OpenlrGeoCoordinate
                                                        dtx_srti:OpenlrPoiWithAccessPoint) ; 
                                           a owl:Class];
                              rdfs:range dtx_srti:PointCoordinates.
dtx_srti:hasOpenlrFirstDirection a owl:ObjectProperty;
                                 rdfs:comment "First OpenLR reference in first/main direction."@en;
                                 rdfs:domain dtx_srti:OpenlrLinear;
                                 rdfs:range dtx_srti:OpenlrLineLocationReference.
dtx_srti:hasOpenlrFormOfWayEnum a owl:ObjectProperty;
                                rdfs:comment "A classification based on the importance of the role that the Road Element (or Ferry Connection) performs in the connectivity of the total road network. (EN ISO 14825 § 7.2.88)"@en;
                                rdfs:domain dtx_srti:OpenlrLineAttributes;
                                rdfs:range dtx_srti:OpenlrFormOfWayEnum.
dtx_srti:hasOpenlrGeoCoordinate a owl:ObjectProperty;
                                rdfs:comment "A geo-coordinate pair is a position in a map defined by its longitude and latitude coordinate values."@en;
                                rdfs:domain dtx_srti:OpenlrCircleLocationReference;
                                rdfs:range dtx_srti:OpenlrGeoCoordinate.
dtx_srti:hasOpenlrLastLocationReferencePoint a owl:ObjectProperty;
                                             rdfs:comment "Allows defining the last point of the OpenLR path"@en;
                                             rdfs:domain [owl:unionOf (dtx_srti:OpenlrBasePointLocation
                                                                       dtx_srti:OpenlrClosedLineLocationReference
                                                                       dtx_srti:OpenlrLineLocationReference) ; 
                                                          a owl:Class];
                                             rdfs:range dtx_srti:OpenlrLastLocationReferencePoint.
dtx_srti:hasOpenlrLineAttributes a owl:ObjectProperty;
                                 rdfs:comment "Properties of the line towards the topologically adjacent OpenLR location referencing point, on the shortest path to that point."@en;
                                 rdfs:domain dtx_srti:OpenlrBaseReferencePoint;
                                 rdfs:range dtx_srti:OpenlrLineAttributes.
dtx_srti:hasOpenlrLinear a owl:ObjectProperty;
                         rdfs:comment "OpenLR line location reference"@en;
                         rdfs:domain dtx_srti:LinearLocation;
                         rdfs:range dtx_srti:OpenlrLinear.
dtx_srti:hasOpenlrLocationReferencePoint a owl:ObjectProperty;
                                         rdfs:comment "Allows defining the first point of the OpenLR path"@en;
                                         rdfs:domain [owl:unionOf (dtx_srti:OpenlrBasePointLocation
                                                                   dtx_srti:OpenlrClosedLineLocationReference
                                                                   dtx_srti:OpenlrLineLocationReference) ; 
                                                      a owl:Class];
                                         rdfs:range dtx_srti:OpenlrLocationReferencePoint.
dtx_srti:hasOpenlrLowerLeft a owl:ObjectProperty;
                            rdfs:comment "The lower left corner of the rectangle."@en;
                            rdfs:domain dtx_srti:OpenlrRectangle;
                            rdfs:range dtx_srti:PointCoordinates.
dtx_srti:hasOpenlrLowestFrcToNextLRPoint a owl:ObjectProperty;
                                         rdfs:comment "The lowest FRC to the next point indicates the lowest functional road class used in the location reference path to the next LR-point."@en;
                                         rdfs:domain [owl:unionOf (dtx_srti:OpenlrLineAttributes
                                                                   dtx_srti:OpenlrPathAttributes) ; 
                                                      a owl:Class];
                                         rdfs:range dtx_srti:OpenlrFunctionalRoadClassEnum.
dtx_srti:hasOpenlrOffsets a owl:ObjectProperty;
                          rdfs:comment "Allows for adding offsets to the line location path defined by nodes when the starting (respectively ending) point does not coincide with a node."@en;
                          rdfs:domain [owl:unionOf (dtx_srti:OpenlrBasePointLocation
                                                    dtx_srti:OpenlrLinear) ; 
                                       a owl:Class];
                          rdfs:range dtx_srti:OpenlrOffsets.
dtx_srti:hasOpenlrOppositeDirection a owl:ObjectProperty;
                                    rdfs:comment "If both direction, this is the reference in the opposite direction against firstDirection."@en;
                                    rdfs:domain dtx_srti:OpenlrLinear;
                                    rdfs:range dtx_srti:OpenlrLineLocationReference.
dtx_srti:hasOpenlrOrientation a owl:ObjectProperty;
                              rdfs:comment "Orientation of the driving direction in relation with the direction of the underlying linear"@en;
                              rdfs:domain dtx_srti:OpenlrBasePointLocation;
                              rdfs:range dtx_srti:OpenlrOrientationEnum.
dtx_srti:hasOpenlrPathAttributes a owl:ObjectProperty;
                                 rdfs:comment "Properties of the path from the associated location reference point to the next location reference point, which are specified to assist correct identification of the point in an external map data source."@en;
                                 rdfs:domain dtx_srti:OpenlrLocationReferencePoint;
                                 rdfs:range dtx_srti:OpenlrPathAttributes.
dtx_srti:hasOpenlrPointLocationReference a owl:ObjectProperty;
                                         rdfs:comment "PointLocation is associated to OpenlrPointLocationReference with cardinality 0..1"@en;
                                         rdfs:domain dtx_srti:PointLocation;
                                         rdfs:range dtx_srti:OpenlrPointLocationReference.
dtx_srti:hasOpenlrPolygonCorners a owl:ObjectProperty;
                                 rdfs:comment "A geodetic coordinate Tuple that defines the vertices of the underlying geometrical polygon."@en;
                                 rdfs:domain dtx_srti:OpenlrPolygonLocationReference;
                                 rdfs:range dtx_srti:OpenlrPolygonCorners.
dtx_srti:hasOpenlrRectangle a owl:ObjectProperty;
                            rdfs:comment "Area delimited by a rectangle defined by the geodetic co-ordinates of the two ends of its diagonal from south-west to north-east (the rectangle having two sides that are parallel to lines of latitude)"@en;
                            rdfs:domain dtx_srti:OpenlrRectangleLocationReference;
                            rdfs:range dtx_srti:OpenlrRectangle;
                            rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasOpenlrSideOfRoad a owl:ObjectProperty;
                             rdfs:comment "Provides the of road where the corresponding point lies."@en;
                             rdfs:domain dtx_srti:OpenlrBasePointLocation;
                             rdfs:range dtx_srti:OpenlrSideOfRoadEnum.
dtx_srti:hasOpenlrUpperRight a owl:ObjectProperty;
                             rdfs:comment "The upper right corner of the rectangle."@en;
                             rdfs:domain dtx_srti:OpenlrRectangle;
                             rdfs:range dtx_srti:PointCoordinates.
dtx_srti:hasOverallEndTime a owl:AnnotationProperty.
dtx_srti:hasOverallStartTime a owl:AnnotationProperty.
dtx_srti:hasPointAlongLinearElement a owl:ObjectProperty;
                                    rdfs:comment "PointLocation is associated to PointAlongLinearElement with cardinality 0..*"@en;
                                    rdfs:domain dtx_srti:PointLocation;
                                    rdfs:range dtx_srti:PointAlongLinearElement.
dtx_srti:hasPointByCoordinates a owl:ObjectProperty;
                               rdfs:comment "PointLocation is associated to PointByCoordinates with cardinality 0..1"@en;
                               rdfs:domain dtx_srti:PointLocation;
                               rdfs:range dtx_srti:PointByCoordinates.
dtx_srti:hasPointCoordinates a owl:ObjectProperty;
                             rdfs:comment "Coordinates that may be used by clients for visual display on user interfaces."@en;
                             rdfs:domain [owl:unionOf (dtx_srti:Location
                                                       dtx_srti:OpenlrBaseReferencePoint
                                                       dtx_srti:OpenlrPolygonCorners
                                                       dtx_srti:OpenlrRectangle
                                                       dtx_srti:PointByCoordinates
                                                       dtx_srti:Referent
                                                       dtx_srti:TpegJunction
                                                       dtx_srti:TpegNonJunctionPoint) ; 
                                          a owl:Class];
                             rdfs:range dtx_srti:PointCoordinates.
dtx_srti:hasPoorEnvironmentTypeEnum a owl:ObjectProperty;
                                    rdfs:comment "Any environmental conditions which may be affecting the driving conditions on the road."@en;
                                    rdfs:domain dtx_srti:PoorEnvironmentConditions;
                                    rdfs:range dtx_srti:PoorEnvironmentTypeEnum.
dtx_srti:hasPositionConfidenceCodedErrorEnum a owl:ObjectProperty;
                                             rdfs:comment "Error code in case the altitude confidence is out of range or cannot be determined"@en;
                                             rdfs:domain dtx_srti:AltitudeConfidence;
                                             rdfs:range dtx_srti:PositionConfidenceCodedErrorEnum.
dtx_srti:hasPositionConfidenceEllipse a owl:ObjectProperty;
                                      rdfs:comment "Confidence ellipse position defined in a shape of ellipse with a predefined confidence level (e.g. 95 %). The centre of the ellipse shape corresponds to the reference position point for which the position accuracy is evaluated."@en;
                                      rdfs:domain dtx_srti:PointCoordinates;
                                      rdfs:range dtx_srti:PositionConfidenceEllipse.
dtx_srti:hasPositionOnCarriageway a owl:ObjectProperty;
                                  rdfs:comment "Relative position across carriageway"@en;
                                  rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                                  rdfs:range dtx_srti:RelativePositionOnCarriagewayEnum.
dtx_srti:hasProbabilityOfOccurrence a owl:ObjectProperty;
                                    rdfs:comment "An assessment of the degree of likelihood that the reported event will occur."@en;
                                    rdfs:domain dtx_srti:SituationRecord;
                                    rdfs:range dtx_srti:ProbabilityOfOccurrenceEnum.
dtx_srti:hasPublicEventType a owl:ObjectProperty;
                            rdfs:comment "Specifies types of public events."@en;
                            rdfs:domain dtx_srti:PublicEvent;
                            rdfs:range dtx_srti:PublicEventTypeEnum.
dtx_srti:hasReferent a owl:ObjectProperty;
                     rdfs:comment "Specifies a referent on a linear object that has a known location such as a node, a reference marker (e.g. a marker-post), an intersection etc."@en;
                     rdfs:domain dtx_srti:DistanceFromLinearElementReferent;
                     rdfs:range dtx_srti:Referent.
dtx_srti:hasReferentEndPointLinearElement a owl:ObjectProperty;
                                          rdfs:comment "The referent at a known location on the linear object which defines the end of the linear element."@en;
                                          rdfs:domain dtx_srti:LinearElementByPoints;
                                          rdfs:range dtx_srti:Referent;
                                          rdfs:subPropertyOf dtx_srti:hasReferent.
dtx_srti:hasReferentFrom a owl:ObjectProperty;
                         rdfs:comment """A known location along the linear element from which the distanceAlong is measured, termed the \"fromReferent\" in EN ISO 19148."""@en;
                         rdfs:domain dtx_srti:DistanceFromLinearElementReferent;
                         rdfs:range dtx_srti:Referent;
                         rdfs:subPropertyOf dtx_srti:hasReferent.
dtx_srti:hasReferentIntermediatePointLinearElement a owl:ObjectProperty;
                                                   rdfs:comment "A referent at a known location on the linear object which is neither the start or end of the linear element."@en;
                                                   rdfs:domain dtx_srti:LinearElementByPoints;
                                                   rdfs:range dtx_srti:Referent;
                                                   rdfs:subPropertyOf dtx_srti:hasReferent.
dtx_srti:hasReferentStartPointLinearElement a owl:ObjectProperty;
                                            rdfs:comment "The referent at a known location on the linear object which defines the start of the linear element."@en;
                                            rdfs:domain dtx_srti:LinearElementByPoints;
                                            rdfs:range dtx_srti:Referent;
                                            rdfs:subPropertyOf dtx_srti:hasReferent.
dtx_srti:hasReferentTowards a owl:ObjectProperty;
                            rdfs:comment """A known location along the linear element towards which the distanceAlong is measured, termed the \"towardsReferent\" in EN ISO 19148."""@en;
                            rdfs:domain dtx_srti:DistanceFromLinearElementReferent;
                            rdfs:range dtx_srti:Referent;
                            rdfs:subPropertyOf dtx_srti:hasReferent.
dtx_srti:hasReferentTypeEnum a owl:ObjectProperty;
                             rdfs:comment "The type of the referent."@en;
                             rdfs:domain dtx_srti:Referent;
                             rdfs:range dtx_srti:ReferentTypeEnum.
dtx_srti:hasRelativeTrafficFlowEnum a owl:ObjectProperty;
                                    rdfs:comment "Assessment of the traffic flow conditions relative to normally expected conditions at this date/time."@en;
                                    rdfs:domain dtx_srti:AbnormalTraffic;
                                    rdfs:range dtx_srti:RelativeTrafficFlowEnum.
dtx_srti:hasReroutingManagementType a owl:ObjectProperty;
                                    rdfs:comment "Management actions relating to rerouting."@en;
                                    rdfs:domain dtx_srti:ReroutingManagement;
                                    rdfs:range dtx_srti:ReroutingManagementTypeEnum.
dtx_srti:hasRoadInformation a owl:ObjectProperty;
                            rdfs:comment "Information on a set of one or more roads. The location could correspond to a part of the road identified, the whole stretch of road identified, or a combination of multiple road sections."@en;
                            rdfs:domain dtx_srti:SupplementaryPositionalDescription;
                            rdfs:range dtx_srti:RoadInformation.
dtx_srti:hasRoadMaintenanceType a owl:ObjectProperty;
                                rdfs:comment "The type of road maintenance or installation work at the specified location."@en;
                                rdfs:domain dtx_srti:MaintenanceWorks;
                                rdfs:range dtx_srti:RoadMaintenanceTypeEnum.
dtx_srti:hasRoadNumber a owl:ObjectProperty;
                       rdfs:comment "Identifier/number of the road. The road number designated by the road authority"@en;
                       rdfs:domain [owl:unionOf (dtx_srti:LinearElement
                                                 dtx_srti:RoadInformation) ; 
                                    a owl:Class];
                       rdfs:range <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber>.
dtx_srti:hasRoadOrCarriagewayOrLaneManagementType a owl:ObjectProperty;
                                                  rdfs:comment "Management actions relating to road, carriageway or lane usage."@en;
                                                  rdfs:domain dtx_srti:RoadOrCarriagewayOrLaneManagement;
                                                  rdfs:range dtx_srti:RoadOrCarriagewayOrLaneManagementTypeEnum.
dtx_srti:hasRoadsideAssistenceTypeEnum a owl:ObjectProperty;
                                       rdfs:comment "Indicates the nature of the road side assistance that will be, is or has been provided."@en;
                                       rdfs:domain dtx_srti:RoadsideAssistance.
dtx_srti:hasRoadworksDuration a owl:ObjectProperty;
                              rdfs:comment "Indicates in general terms the expected duration of the roadworks."@en;
                              rdfs:domain dtx_srti:RoadWorks;
                              rdfs:range dtx_srti:RoadworksDurationEnum.
dtx_srti:hasRoadworksScaleEnum a owl:ObjectProperty;
                               rdfs:comment "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en;
                               rdfs:domain dtx_srti:RoadWorks;
                               rdfs:range dtx_srti:RoadworksScaleEnum.
dtx_srti:hasSecondarySupplementaryDescription a owl:ObjectProperty;
                                              rdfs:comment "Supplementary description that applies to the secondary end of the linear location. Use when properties change along the Linear. For a one-way linear the secondary end should be the destination end."@en;
                                              rdfs:domain dtx_srti:LinearLocation;
                                              rdfs:range dtx_srti:SupplementaryPositionalDescription.
dtx_srti:hasSemiMajorAxisLengthCodedError a owl:ObjectProperty;
                                          rdfs:comment "Provides a coded error in case the semi-major axis length is not defined"@en;
                                          rdfs:domain dtx_srti:PositionConfidenceEllipse;
                                          rdfs:range dtx_srti:PositionConfidenceCodedErrorEnum.
dtx_srti:hasSemiMinorAxisLengthCodedError a owl:ObjectProperty;
                                          rdfs:comment "Provides a coded error in case the semi-minor axis length is not defined"@en;
                                          rdfs:domain dtx_srti:PositionConfidenceEllipse;
                                          rdfs:range dtx_srti:PositionConfidenceCodedErrorEnum.
dtx_srti:hasSeverityEnum a owl:ObjectProperty;
                         rdfs:comment "Levels of severity of a situation as whole assessed by the impact that the situation may have on traffic flow as perceived by the supplier."@en;
                         rdfs:domain dtx_srti:SituationRecord;
                         rdfs:range dtx_srti:SeverityEnum.
dtx_srti:hasSituation a owl:ObjectProperty;
                      rdfs:comment "traffic/travel situations."@en;
                      rdfs:domain dtx_srti:SituationPublication;
                      rdfs:range dtx_srti:Situation.
dtx_srti:hasSituationRecord a owl:ObjectProperty;
                            rdfs:comment "Details of the Situation"@en;
                            rdfs:domain dtx_srti:Situation;
                            rdfs:range dtx_srti:SituationRecord.
dtx_srti:hasSource a owl:ObjectProperty;
                   rdfs:range dtx_srti:Source;
                   rdfs:subPropertyOf owl:topObjectProperty.
dtx_srti:hasSpeedManagementType a owl:ObjectProperty;
                                rdfs:comment "Type of speed management action instigated by operator."@en;
                                rdfs:domain dtx_srti:SpeedManagement;
                                rdfs:range dtx_srti:SpeedManagementTypeEnum.
dtx_srti:hasSubdivisionTypeEnum a owl:ObjectProperty;
                                rdfs:comment "The ISO 3166-2 subdivison type for the named area."@en;
                                rdfs:domain dtx_srti:IsoNamedArea;
                                rdfs:range dtx_srti:SubdivisionTypeEnum.
dtx_srti:hasSubject a owl:ObjectProperty;
                    rdfs:range dtx_srti:Subjects.
dtx_srti:hasSubjectTypeOfWorks a owl:ObjectProperty;
                               rdfs:comment "The subject type of the roadworks (i.e. on what the construction or maintenance work is being performed).";
                               rdfs:domain dtx_srti:Subjects;
                               rdfs:range dtx_srti:SubjectTypeOfWorksEnum.
dtx_srti:hasSupplementaryPositionalDescription a owl:ObjectProperty;
                                               rdfs:comment "A collection of supplementary positional information which improves the precision of the location."@en;
                                               rdfs:domain dtx_srti:NetworkLocation;
                                               rdfs:range dtx_srti:SupplementaryPositionalDescription.
dtx_srti:hasTpegAreaDescriptor a owl:ObjectProperty;
                               rdfs:comment "Name of area."@en;
                               rdfs:domain [owl:unionOf (dtx_srti:TpegGeometricArea
                                                         dtx_srti:TpegNamedOnlyArea) ; 
                                            a owl:Class];
                               rdfs:range dtx_srti:TpegAreaDescriptor.
dtx_srti:hasTpegAreaLocation a owl:ObjectProperty;
                             rdfs:comment "A geographic or geometric area defined by a TPEG-Loc structure which may include height information for additional geospatial discrimination."@en;
                             rdfs:domain dtx_srti:AreaLocation;
                             rdfs:range dtx_srti:TpegAreaLocation.
dtx_srti:hasTpegFramedPoint a owl:ObjectProperty;
                            rdfs:comment "A single non-junction point on the road network which is framed between two other specified points on the road network."@en;
                            rdfs:domain dtx_srti:TpegFramedPoint;
                            rdfs:range dtx_srti:TpegNonJunctionPoint.
dtx_srti:hasTpegHeight a owl:ObjectProperty;
                       rdfs:comment "Height information which provides additional discrimination for the applicable area."@en;
                       rdfs:domain dtx_srti:TpegAreaLocation;
                       rdfs:range dtx_srti:TpegHeight.
dtx_srti:hasTpegIlcPointDescriptor a owl:ObjectProperty;
                                   rdfs:comment "A descriptor for describing a junction by identifying the intersecting roads at a road junction."@en;
                                   rdfs:domain dtx_srti:TpegJunction;
                                   rdfs:range dtx_srti:TpegIlcPointDescriptor.
dtx_srti:hasTpegJunctionPointDescriptor a owl:ObjectProperty;
                                        rdfs:comment "A name which identifies a junction point on the road network"@en;
                                        rdfs:domain dtx_srti:TpegJunction;
                                        rdfs:range dtx_srti:TpegJunctionPointDescriptor.
dtx_srti:hasTpegLinearLocation a owl:ObjectProperty;
                               rdfs:comment "A linear section along a single road defined between two points on the same road by a TPEG-Loc structure."@en;
                               rdfs:domain dtx_srti:SingleRoadLinearLocation;
                               rdfs:range dtx_srti:TpegLinearLocation.
dtx_srti:hasTpegOtherPointDescriptor a owl:ObjectProperty;
                                     rdfs:comment "A descriptive name which helps to identify the non-junction point. At least one descriptor must identify the road on which the point is located, i.e. must be of type 'linkName' or 'localLinkName'."@en;
                                     rdfs:domain [owl:unionOf (dtx_srti:TpegJunction
                                                               dtx_srti:TpegNonJunctionPoint) ; 
                                                  a owl:Class];
                                     rdfs:range dtx_srti:TpegOtherPointDescriptor.
dtx_srti:hasTpegPoint a owl:ObjectProperty;
                      rdfs:comment "A single point defined by a coordinate set and TPEG descriptors."@en;
                      rdfs:domain dtx_srti:TpegSimplePoint;
                      rdfs:range dtx_srti:TpegPoint.
dtx_srti:hasTpegPointFrom a owl:ObjectProperty;
                          rdfs:comment "The location at the up stream end of the linear section of road."@en;
                          rdfs:domain [owl:unionOf (dtx_srti:TpegFramedPoint
                                                    dtx_srti:TpegLinearLocation) ; 
                                       a owl:Class];
                          rdfs:range dtx_srti:TpegPoint.
dtx_srti:hasTpegPointLocation a owl:ObjectProperty;
                              rdfs:comment "PointLocation is associated to TpegPointLocation with cardinality 0..1"@en;
                              rdfs:domain dtx_srti:PointLocation;
                              rdfs:range dtx_srti:TpegPointLocation.
dtx_srti:hasTpegPointTo a owl:ObjectProperty;
                        rdfs:comment "The location at the down stream end of the linear section of road."@en;
                        rdfs:domain [owl:unionOf (dtx_srti:TpegFramedPoint
