                                                         dcterms:creator """Julian Gutierrez Moret (https://www.uv.es/uvweb/universidad/es/ficha-persona-1285950309813.html?p2=gumoju) 

J. Javier Samper Zapater (https://www.uv.es/uvweb/college/en/profile-1285950309813.html?p2=jjsamper&idA=true) 

IRTIC - (Instituto de Robótica y Tecnologías de la Información y la Comunicación)"""@en;
                                                         dcterms:description """An RDF/OWL vocabulary to represent SRTI DATEX II profile (according the Commission  Delegated Regulation (EU) No 886/2013) within the European  LOD-RoadTran18 action  \"Supporting the cross-border use of Road Traffic Data with Linked Open Data based on DATEX II (LOD-RoadTran18)\" (Agreement No: INEA/CEF/ICT/A2018/1803421, Action No: 2018-EU-IA-0088). The  vocabulary is used for mapping between DATEX II and LOD formats."""@en;
                                                         dcterms:license "https://creativecommons.org/licenses/by/4.0/";
                                                         dcterms:publisher "IRTIC - (Instituto de Robótica y Tecnologías de la Información y la Comunicación)"@es;
                                                         dcterms:title "LOD SRTI DATEX II"@en;
                                                         vann:preferredNamespacePrefix "dtx_srti"@en;
                                                         vann:preferredNamespaceUri "http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti#"@en;
                                                         a owl:Ontology;
                                                         rdfs:seeAlso "http://cef.uv.es/lodroadtran18/"@en;
                                                         owl:imports <http://www.opengis.net/ont/geosparql>,
                                                                     time:2016,
                                                                     <https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf>;
                                                         owl:versionInfo "1.0"@en;
                                                         skos:changeNote """2022-02-01. Extended the ontology with non-SRTI elements and adition of the comments:

	- Related with a SituationRecord: Severity, Source & Impact 
	- New items for old SRTI Enumerations and new non-SRTI Enumerations 
	- Added Mobility"""@en,
                                                                         """2022-07-29. Use of  LCC Country Representation  alpha2code and LCC Language Representation  alpha2code according to Datex specification.
It allows the instantiation of Spain and the Czech Republic would be reusing the individuals from ISO3166-1-CountryCodes and  ISO639-1-LanguageCodes respectively."""@en.
dtx_srti:AbnormalTraffic a owl:Class;
                         rdfs:comment "A traffic condition which is not normal."@en;
                         rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:numberOfVehiclesWaiting ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:queueLength ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TrafficTrendTypeEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTrafficTrendTypeEnum ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TrafficFlowCharateristicsEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTrafficFlowCharacteristicsEnum ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:RelativeTrafficFlowEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasRelativeTrafficFlowEnum ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:AbnormalTrafficTypeEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasAbnormalTrafficType ; 
                                          a owl:Restriction],
                                         dtx_srti:TrafficElement.
dtx_srti:AbnormalTrafficTypeEnum a owl:Class;
                                 rdfs:comment "Descriptive terms for abnormal traffic conditions specifically relating to the nature of the traffic movement, implying levels of service."@en;
                                 rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:heavyTraffic
                                                                 dtx_srti:other
                                                                 dtx_srti:queuingTraffic
                                                                 dtx_srti:slowTraffic
                                                                 dtx_srti:stationaryTraffic
                                                                 dtx_srti:unspecifiedAbnormalTraffic) ; 
                                                      a owl:Class].
dtx_srti:Accident a owl:Class;
                  rdfs:comment "Accidents are events where one or more vehicles are involved in collisions or in leaving the roadway. These include collisions between vehicles or with other road users or obstacles."@en;
                  rdfs:subClassOf [owl:someValuesFrom dtx_srti:AccidentTypeEnum ; 
                                   owl:onProperty dtx_srti:hasAccidentType ; 
                                   a owl:Restriction],
                                  dtx_srti:TrafficElement;
                  owl:disjointWith dtx_srti:Obstruction,
                                   dtx_srti:Conditions.
dtx_srti:AccidentCauseEnum a owl:Class;
                           rdfs:comment "Collection of descriptive terms for causes of accidents."@en;
                           rdfs:subClassOf dtx_srti:SituationEnumerations;
                           owl:equivalentClass [owl:oneOf (dtx_srti:avoidanceOfObstacles
                                                           dtx_srti:driverDistraction
                                                           dtx_srti:driverDrugAbuse
                                                           dtx_srti:driverIllness
                                                           dtx_srti:exceedingSpeedsLimits
                                                           dtx_srti:excessAlcohol
                                                           dtx_srti:excessiveDriverTiredness
                                                           dtx_srti:impermissibleManoeuvre
                                                           dtx_srti:limitedVisibility
                                                           dtx_srti:notKeepingASafeDistance
                                                           dtx_srti:onTheWrongSideOfTheRoad
                                                           dtx_srti:other
                                                           dtx_srti:pedestrianInRoad
                                                           dtx_srti:poorLaneAdherence
                                                           dtx_srti:poorMergeEntryOrExitJudgement
                                                           dtx_srti:poorRoadSurfaceCondition
                                                           dtx_srti:poorSurfaceAdherence
                                                           dtx_srti:undisclosed
                                                           dtx_srti:unknown
                                                           dtx_srti:vehicleFailure) ; 
                                                a owl:Class].
dtx_srti:AccidentTypeEnum a owl:Class;
                          rdfs:comment "Collection of descriptive terms for types of accidents."@en;
                          rdfs:subClassOf dtx_srti:SituationEnumerations;
                          owl:equivalentClass [owl:oneOf (dtx_srti:accident
                                                          dtx_srti:accidentInvolvingHazardousMaterials
                                                          dtx_srti:accidentInvolvingHeavyLorries
                                                          dtx_srti:collision
                                                          dtx_srti:multipleVehicleAccident) ; 
                                               a owl:Class].
dtx_srti:Activity a owl:Class;
                  rdfs:comment "A collection of information relating to human activities external to the traffic stream or roadway which could disrupt traffic."@en;
                  rdfs:subClassOf [owl:onClass dtx_srti:Mobility ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasMobilityOfActivity ; 
                                   a owl:Restriction],
                                  dtx_srti:TrafficElement.
dtx_srti:AlertC a owl:Class;
                rdfs:comment "Alert C location"@en;
                rdfs:subClassOf dtx_srti:LocationObjects.
dtx_srti:AlertCArea a owl:Class;
                    rdfs:comment "An area defined by reference to a predefined ALERT-C location table."@en;
                    rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:alertCLocationTableVersion ; 
                                     a owl:Restriction],
                                    [owl:onDataRange xsd:string ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:alertCLocationTableNumber ; 
                                     a owl:Restriction],
                                    [owl:onDataRange xsd:string ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:alertCLocationCountryCode ; 
                                     a owl:Restriction],
                                    [owl:onClass dtx_srti:AlertCLocation ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:hasAlertCLocation ; 
                                     a owl:Restriction],
                                    dtx_srti:AlertC.
dtx_srti:AlertCDirection a owl:Class;
                         rdfs:comment "The direction of traffic flow along the road to which the information relates."@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:AlertCDirectionEnum ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasAlertCDirectionCoded ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:LinearDirectionEnum ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasAlertCAffectedDirection ; 
                                          a owl:Restriction],
                                         dtx_srti:AlertC;
                         owl:disjointWith dtx_srti:AlertCLocation.
dtx_srti:AlertCDirectionEnum a owl:Class;
                             rdfs:comment "Direction used to reach the primary location from the secondary location in ALERT-C location table, as defined in CEN ISO 14819-1"@en;
                             rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                             owl:equivalentClass [owl:oneOf (dtx_srti:both
                                                             dtx_srti:negative
                                                             dtx_srti:positive) ; 
                                                  a owl:Class].
dtx_srti:AlertCLinear a owl:Class;
                      rdfs:comment "A linear section along a road defined between two points on the road by reference to a pre-defined ALERT-C location table. When there are multiple instances of AlertCLinear they should represent the same location using different location tables.";
                      rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:alertCLocationTableVersion ; 
                                       a owl:Restriction],
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:alertCLocationTableNumber ; 
                                       a owl:Restriction],
                                      [owl:onDataRange xsd:string ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:alertCLocationCountryCode ; 
                                       a owl:Restriction],
                                      dtx_srti:AlertC.
dtx_srti:AlertCLinearByCode a owl:Class;
                            rdfs:comment "A linear section along a road defined by reference to a linear section in a pre-defined ALERT-C location table.";
                            rdfs:subClassOf [owl:onClass dtx_srti:AlertCLocation ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasLocationCodeForLinearLocation ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:AlertCDirection ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAlertCDirection ; 
                                             a owl:Restriction],
                                            dtx_srti:AlertCLinear.
dtx_srti:AlertCLocation a owl:Class;
                        rdfs:comment "Identification of a specific point, linear or area location in an ALERT-C location table."@en;
                        rdfs:subClassOf dtx_srti:AlertC.
dtx_srti:AlertCMethod2Linear a owl:Class;
                             rdfs:comment "A linear section along a road between two points, primary and secondary, which are pre-defined in an ALERT-C location table. Direction is FROM the secondary point TO the primary point, i.e. the primary point is downstream of the secondary point.";
                             rdfs:subClassOf [owl:onClass dtx_srti:AlertCMethod2SecondaryPointLocation ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCMethod2SecondaryPointLocation ; 
                                              a owl:Restriction],
                                             [owl:onClass dtx_srti:AlertCMethod2PrimaryPointLocation ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCMethod2PrimaryPointLocation ; 
                                              a owl:Restriction],
                                             [owl:onClass dtx_srti:AlertCDirection ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCDirection ; 
                                              a owl:Restriction],
                                             dtx_srti:AlertCLinear.
dtx_srti:AlertCMethod2Point a owl:Class;
                            rdfs:comment "A single point on the road network defined by reference to a point in a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:AlertCMethod2PrimaryPointLocation ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAlertCMethod2PrimaryPointLocation ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:AlertCDirection ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAlertCDirection ; 
                                             a owl:Restriction],
                                            dtx_srti:AlertCPoint.
dtx_srti:AlertCMethod2PrimaryPointLocation a owl:Class;
                                           rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en;
                                           rdfs:subClassOf [owl:onClass dtx_srti:AlertCLocation ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasAlertCLocation ; 
                                                            a owl:Restriction],
                                                           dtx_srti:AlertC.
dtx_srti:AlertCMethod2SecondaryPointLocation a owl:Class;
                                             rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table."@en;
                                             rdfs:subClassOf [owl:onClass dtx_srti:AlertCLocation ; 
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty dtx_srti:hasAlertCLocation ; 
                                                              a owl:Restriction],
                                                             dtx_srti:AlertC.
dtx_srti:AlertCMethod4Linear a owl:Class;
                             rdfs:comment "A linear section along a road between two points, primary and secondary, which are pre-defined ALERT-C locations plus offset distance. Direction is FROM the secondary point TO the primary point, i.e. the primary point is downstream of the secondary point.";
                             rdfs:subClassOf [owl:onClass dtx_srti:AlertCMethod4SecondaryPointLocation ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCMethod4SecondaryPointLocation ; 
                                              a owl:Restriction],
                                             [owl:onClass dtx_srti:AlertCMethod4PrimaryPointLocation ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCMethod4PrimaryPointLocation ; 
                                              a owl:Restriction],
                                             [owl:onClass dtx_srti:AlertCDirection ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasAlertCDirection ; 
                                              a owl:Restriction],
                                             dtx_srti:AlertCLinear.
dtx_srti:AlertCMethod4Point a owl:Class;
                            rdfs:comment "A single point on the road network defined by reference to a point in a pre-defined ALERT-C location table plus an offset distance and which has an associated direction of traffic flow."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:AlertCMethod4PrimaryPointLocation ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAlertCMethod4PrimaryPointLocation ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:AlertCDirection ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAlertCDirection ; 
                                             a owl:Restriction],
                                            dtx_srti:AlertCPoint.
dtx_srti:AlertCMethod4PrimaryPointLocation a owl:Class;
                                           rdfs:comment "The point (called Primary point) which is either a single point or at the downstream end of a linear road section. The point is specified by a reference to a point in a pre-defined ALERT-C location table plus a non-negative offset distance."@en;
                                           rdfs:subClassOf [owl:onClass dtx_srti:OffsetDistance ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasOffsetDistance ; 
                                                            a owl:Restriction],
                                                           [owl:onClass dtx_srti:AlertCLocation ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasAlertCLocation ; 
                                                            a owl:Restriction],
                                                           dtx_srti:AlertC.
dtx_srti:AlertCMethod4SecondaryPointLocation a owl:Class;
                                             rdfs:comment "The point (called Secondary point) which is at the upstream end of a linear road section. The point is specified by a reference to a point in a pre-defined Alert-C location table plus a non-negative offset distance."@en;
                                             rdfs:subClassOf [owl:onClass dtx_srti:OffsetDistance ; 
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty dtx_srti:hasOffsetDistance ; 
                                                              a owl:Restriction],
                                                             [owl:onClass dtx_srti:AlertCLocation ; 
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                              owl:onProperty dtx_srti:hasAlertCLocation ; 
                                                              a owl:Restriction],
                                                             dtx_srti:AlertC.
dtx_srti:AlertCPoint a owl:Class;
                     rdfs:comment "A single point on the road network defined by reference to a pre-defined ALERT-C location table and which has an associated direction of traffic flow."@en;
                     rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:alertCLocationTableVersion ; 
                                      a owl:Restriction],
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:alertCLocationTableNumber ; 
                                      a owl:Restriction],
                                     [owl:onDataRange xsd:string ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:alertCLocationCountryCode ; 
                                      a owl:Restriction],
                                     dtx_srti:AlertC;
                     owl:disjointWith dtx_srti:TpegPoint.
dtx_srti:AltitudeAccuracyEnum a owl:Class;
                              rdfs:comment "Coded level of vertical accuracy"@en;
                              rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                              owl:equivalentClass [owl:oneOf (dtx_srti:equalToOrLessThan100Metres
                                                              dtx_srti:equalToOrLessThan10Centimetres
                                                              dtx_srti:equalToOrLessThan10Metres
                                                              dtx_srti:equalToOrLessThan1Centimetre
                                                              dtx_srti:equalToOrLessThan1Metre
                                                              dtx_srti:equalToOrLessThan200Metres
                                                              dtx_srti:equalToOrLessThan20Centimetres
                                                              dtx_srti:equalToOrLessThan20Metres
                                                              dtx_srti:equalToOrLessThan2Centimetres
                                                              dtx_srti:equalToOrLessThan2Metres
                                                              dtx_srti:equalToOrLessThan50Centimetres
                                                              dtx_srti:equalToOrLessThan50Metres
                                                              dtx_srti:equalToOrLessThan5Centimetres
                                                              dtx_srti:equalToOrLessThan5Metres) ; 
                                                   a owl:Class].
dtx_srti:AltitudeConfidence a owl:Class;
                            rdfs:comment "Evaluation of the altitude confidence assessed according to ETSI ISO 102894-2";
                            rdfs:subClassOf [owl:onClass dtx_srti:PositionConfidenceCodedErrorEnum ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasPositionConfidenceCodedErrorEnum ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:AltitudeAccuracyEnum ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasAltitudeAccuracyCodedValue ; 
                                             a owl:Restriction],
                                            dtx_srti:HeightCoordinateAssociationFrom.
dtx_srti:AngleInDegreesValue a owl:Class;
                             rdfs:comment "A measured or  value of Angles. An integer number representing an angle in whole degrees between 0 and 359."@en;
                             rdfs:subClassOf [owl:someValuesFrom xsd:nonNegativeInteger ; 
                                              owl:onProperty <http://qudt.org/schema/qudt#numericValue> ; 
                                              a owl:Restriction],
                                             [owl:hasValue unit:DEG ; 
                                              owl:onProperty <http://qudt.org/schema/qudt#unit> ; 
                                              a owl:Restriction],
                                             <http://qudt.org/schema/qudt#QuantityValue>.
dtx_srti:AnimalPresenceObstruction a owl:Class;
                                   rdfs:comment "An obstruction on the road resulting from the presence of animals."@en;
                                   rdfs:subClassOf [owl:onClass dtx_srti:AnimalPresenceTypeEmum ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasAnimalPresenceTypeEnum ; 
                                                    a owl:Restriction],
                                                   dtx_srti:Obstruction;
                                   owl:disjointWith dtx_srti:VehicleObstruction,
                                                    dtx_srti:GeneralObstruction,
                                                    dtx_srti:EnvironmentalObstruction.
dtx_srti:AnimalPresenceTypeEmum a owl:Class;
                                rdfs:comment "Types of animal presence."@en;
                                rdfs:subClassOf dtx_srti:SituationEnumerations;
                                owl:equivalentClass [owl:oneOf (dtx_srti:animalsOnTheRoad
                                                                dtx_srti:herdOfAnimalsOnTheRoad
                                                                dtx_srti:largeAnimalsOnTheRoad) ; 
                                                     a owl:Class].
dtx_srti:AreaLocation a owl:Class;
                      rdfs:comment """Location representing a geographic or geometric defined area which may be qualified by height information to provide additional geospatial discrimination (e.g. for snow in an area but only above a certain altitude). Associations:
0..*	AlertCArea
0..1	TpegAreaLocation
0..1	NamedArea
0..1	GmlMultiPolygon
0..1	OpenlrAreaLocationReference"""@en;
                      rdfs:subClassOf [owl:onClass dtx_srti:TpegAreaLocation ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasTpegAreaLocation ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:OpenlrAreaLocationReference ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasOpenlrAreaLocationReference ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:NamedArea ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasNamedArea ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:GmlMultiPolygon ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasGmlMultiPolygon ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:AreaPlacesEnum ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasAreaPlacesEnum ; 
                                       a owl:Restriction],
                                      dtx_srti:Location.
dtx_srti:AreaPlacesEnum a owl:Class;
                        rdfs:comment "Type of area place(s)"@en;
                        rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                        owl:equivalentClass [owl:oneOf (dtx_srti:atBorders
                                                        dtx_srti:atHighAltitudes
                                                        dtx_srti:inBuiltUpAreas
                                                        dtx_srti:inForestedAreas
                                                        dtx_srti:inGalleries
                                                        dtx_srti:inLowLyingAreas
                                                        dtx_srti:inRuralAreas
                                                        dtx_srti:inShadedAreas
                                                        dtx_srti:inTheInnerCityAreas
                                                        dtx_srti:inTunnels
                                                        dtx_srti:onBridges
                                                        dtx_srti:onDownhillSections
                                                        dtx_srti:onElevatedSections
                                                        dtx_srti:onEnteringOrLeavingTunnels
                                                        dtx_srti:onFlyovers
                                                        dtx_srti:onPasses
                                                        dtx_srti:onUndergroundSections
                                                        dtx_srti:onUnderpasses) ; 
                                             a owl:Class].
dtx_srti:Carriageway a owl:Class;
                     rdfs:comment "Supplementary positional information which details carriageway and lane locations. Several instances may exist where the element being described extends over more than one carriageway."@en;
                     rdfs:subClassOf [owl:onDataRange xsd:int ; 
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:originalNumberOfLanes ; 
                                      a owl:Restriction],
                                     [owl:onClass dtx_srti:NamedArea ; 
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:hasNamedArea ; 
                                      a owl:Restriction],
                                     [owl:onClass dtx_srti:CarriagewayEnum ; 
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:hasCarriagewayEnum ; 
                                      a owl:Restriction],
                                     dtx_srti:SupplementaryPositionalPack.
dtx_srti:CarriagewayEnum a owl:Class;
                         rdfs:comment "List of descriptors identifying specific carriageway details."@en;
                         rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                         owl:equivalentClass [owl:oneOf (dtx_srti:connectingCarriageway
                                                         dtx_srti:cycleTrack
                                                         dtx_srti:entrySlipRoad
                                                         dtx_srti:exitSlipRoad
                                                         dtx_srti:flyover
                                                         dtx_srti:footpath
                                                         dtx_srti:leftHandFeederRoad
                                                         dtx_srti:leftHandParallelCarriageway
                                                         dtx_srti:mainCarriageway
                                                         dtx_srti:oppositeCarriageway
                                                         dtx_srti:parallelCarriageway
                                                         dtx_srti:rightHandFeederRoad
                                                         dtx_srti:rightHandParallelCarriageway
                                                         dtx_srti:roundabout
                                                         dtx_srti:serviceRoad
                                                         dtx_srti:slipRoads
                                                         dtx_srti:underpass
                                                         dtx_srti:unspecifiedCarriageway) ; 
                                              a owl:Class].
dtx_srti:CauseTypeEnum a owl:Class;
                       rdfs:comment "Types of causes of situations which are not managed or are off network."@en;
                       rdfs:subClassOf dtx_srti:SituationEnumerations;
                       owl:equivalentClass [owl:oneOf (dtx_srti:accidentCause
                                                       dtx_srti:congestion
                                                       dtx_srti:equipmentFailure
                                                       dtx_srti:infrastructureFailure
                                                       dtx_srti:obstruction
                                                       dtx_srti:poorWeather
                                                       dtx_srti:problemsAtBorderPost
                                                       dtx_srti:problemsAtCustomPost
                                                       dtx_srti:problemsOnLocalRoads
                                                       dtx_srti:roadsideEvent
                                                       dtx_srti:securityIncident
                                                       dtx_srti:terrorism
                                                       dtx_srti:vandalism) ; 
                                            a owl:Class].
dtx_srti:CommonClasses a owl:Class;
                       rdfs:comment "Common classes"@en.
dtx_srti:ComputationMethodEnum a owl:Class;
                               rdfs:comment "Types of computational methods used in deriving data values for data sets."@en;
                               rdfs:subClassOf dtx_srti:PayLoadEnumerations;
                               owl:equivalentClass [owl:oneOf (dtx_srti:arithmeticAverageOfSamplesBasedOnAFixedNumberOfSamples
                                                               dtx_srti:arithmeticAverageOfSamplesInATimePeriod
                                                               dtx_srti:harmonicAverageOfSamplesInATimePeriod
                                                               dtx_srti:medianOfSamplesInATimePeriod
                                                               dtx_srti:movingAverageOfSamples) ; 
                                                    a owl:Class].
dtx_srti:Conditions a owl:Class;
                    rdfs:comment "Any conditions which have the potential to degrade normal driving conditions.";
                    rdfs:subClassOf [owl:onClass dtx_srti:DrivingConditionTypeEnum ; 
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:hasDrivingConditionTypeEnum ; 
                                     a owl:Restriction],
                                    dtx_srti:TrafficElement;
                    owl:disjointWith dtx_srti:Obstruction.
dtx_srti:ConfidentialityValueEnum a owl:Class;
                                  rdfs:comment "<<enumeration>> Values of confidentiality."@en;
                                  rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                  owl:equivalentClass [owl:oneOf (dtx_srti:internalUse
                                                                  dtx_srti:noRestriction
                                                                  dtx_srti:restrictedToAuthorities
                                                                  dtx_srti:restrictedToAuthoritiesAndTrafficOperators
                                                                  dtx_srti:restrictedToAuthoritiesTrafficOperatorsAndPublishers
                                                                  dtx_srti:restrictedToAuthoritiesTrafficOperatorsAndVms) ; 
                                                       a owl:Class].
dtx_srti:ConstructionWorkTypeEnum a owl:Class;
                                  rdfs:comment "Types of works relating to construction."@en;
                                  rdfs:subClassOf dtx_srti:SituationEnumerations;
                                  owl:equivalentClass [owl:oneOf (dtx_srti:blastingWork
                                                                  dtx_srti:constructionWork) ; 
                                                       a owl:Class].
dtx_srti:ConstructionWorks a owl:Class;
                           rdfs:comment "Roadworks involving the construction of new infrastructure."@en;
                           rdfs:subClassOf [owl:onClass dtx_srti:ConstructionWorkTypeEnum ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:hasConstructionWorkType ; 
                                            a owl:Restriction],
                                           dtx_srti:RoadWorks.
dtx_srti:DataValue a owl:Class;
                   rdfs:comment "A data value of something that can be measured or calculated. Any provided meta-data values specified in the attributes override any specified generic characteristics such as defined for a specific measurement in the MeasurementSiteTable."@en;
                   rdfs:subClassOf dtx_srti:CommonClasses,
                                   [owl:onDataRange xsd:nonNegativeInteger ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:numberOfInputValuesUsed ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:string ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:reasonForDataError ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:nonNegativeInteger ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:numberOfIncompleteInputs ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:float ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:standardDeviation ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:boolean ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:dataError ; 
                                    a owl:Restriction],
                                   [owl:onDataRange qudt:floatPercentage ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:supplierCalculatedDataQuality ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:ComputationMethodEnum ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasComputationMethodEnum ; 
                                    a owl:Restriction],
                                   [owl:onDataRange qudt:floatPercentage ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:accuracy ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:float ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:smoothingFactor ; 
                                    a owl:Restriction].
dtx_srti:DelayBandEnum a owl:Class;
                       rdfs:comment """The time band within which the additional travel time due to adverse travel conditions of any kind falls, when compared to \"normal conditions\"."""@en;
                       rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                       owl:equivalentClass [owl:oneOf (dtx_srti:betweenOneHourAndThreeHours
                                                       dtx_srti:betweenTenMinutesAndThirtyMinutes
                                                       dtx_srti:betweenThirtyMinutesAndOneHour
                                                       dtx_srti:betweenThreeHoursAndSixHours
                                                       dtx_srti:longerThanSixHours
                                                       dtx_srti:negligible
                                                       dtx_srti:upToTenMinutes) ; 
                                            a owl:Class].
dtx_srti:Delays a owl:Class;
                rdfs:comment "The details of the delays being caused by the situation element defined in the situation record. It is recommended to only use one of the optional attributes to avoid confusion."@en;
                rdfs:subClassOf [owl:onDataRange xsd:decimal ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:delayTimeValue ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:DelaysTypeEnum ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:delaysType ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:DelayBandEnum ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:delayBand ; 
                                 a owl:Restriction],
                                dtx_srti:CommonClasses.
dtx_srti:DelaysTypeEnum a owl:Class;
                        rdfs:comment "Coarse classification of the delay."@en;
                        rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                        owl:equivalentClass [owl:oneOf (dtx_srti:delays
                                                        dtx_srti:delaysOfUncertainDuration
                                                        dtx_srti:longDelays
                                                        dtx_srti:veryLongDelays) ; 
                                             a owl:Class].
dtx_srti:DirectionEnum a owl:Class;
                       rdfs:comment "List of directions of travel."@en;
                       rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                       owl:equivalentClass [owl:oneOf (dtx_srti:aligned
                                                       dtx_srti:allDirections
                                                       dtx_srti:anticlockwise
                                                       dtx_srti:bothWays
                                                       dtx_srti:clockwise
                                                       dtx_srti:eastBound
                                                       dtx_srti:inboundTowardsTown
                                                       dtx_srti:innerRing
                                                       dtx_srti:northBound
                                                       dtx_srti:northEastBound
                                                       dtx_srti:northWestBound
                                                       dtx_srti:opposite
                                                       dtx_srti:other
                                                       dtx_srti:outboundFromTown
                                                       dtx_srti:outerRing
                                                       dtx_srti:southBound
                                                       dtx_srti:southEastBound
                                                       dtx_srti:southWestBound
                                                       dtx_srti:unknown
                                                       dtx_srti:westBound) ; 
                                            a owl:Class].
dtx_srti:DirectionPurposeEnum a owl:Class;
                              rdfs:comment "Main purpose of a direction of a road"@en;
                              rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                              owl:equivalentClass [owl:oneOf (dtx_srti:inbound
                                                              dtx_srti:outbound) ; 
                                                   a owl:Class].
dtx_srti:DistanceAlongLinearElement a owl:Class;
                                    rdfs:comment "Distance of a point along a linear element either measured from the start node or a defined referent on that linear element, where the start node is relative to the element definition rather than the direction of traffic flow."@en;
                                    rdfs:subClassOf dtx_srti:LinearReferencing.
dtx_srti:DistanceFromLinearElementReferent a owl:Class;
                                           rdfs:comment """Distance of a point along a linear element measured from a \"from referent\" on the linear element, in the sense relative to the linear element definition rather than the direction of traffic flow or optionally towards a \"towards referent\"."""@en;
                                           rdfs:subClassOf [owl:onClass dtx_srti:Referent ; 
                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasReferentTowards ; 
                                                            a owl:Restriction],
                                                           [owl:onClass dtx_srti:Referent ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasReferentFrom ; 
                                                            a owl:Restriction],
                                                           [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:distanceAlong ; 
                                                            a owl:Restriction],
                                                           dtx_srti:DistanceAlongLinearElement.
dtx_srti:DistanceFromLinearElementStart a owl:Class;
                                        rdfs:comment "Distance of a point along a linear element measured from the start node of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en;
                                        rdfs:subClassOf dtx_srti:DistanceAlongLinearElement.
dtx_srti:DisturbanceActivity a owl:Class;
                             rdfs:comment "Deliberate human action of either a public disorder nature or of a situation alert type which could disrupt traffic."@en;
                             rdfs:subClassOf dtx_srti:Activity.
dtx_srti:DisturbanceActivityTypeEnum a owl:Class;
                                     rdfs:comment "Types of disturbance activities."@en;
                                     rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                     owl:equivalentClass [owl:oneOf (dtx_srti:crowd
                                                                     dtx_srti:demonstration
                                                                     dtx_srti:evacuation
                                                                     dtx_srti:other) ; 
                                                          a owl:Class].
dtx_srti:DrivingConditionTypeEnum a owl:Class;
                                  rdfs:comment "Types of the perceived driving conditions."@en;
                                  rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                  owl:equivalentClass [owl:oneOf (dtx_srti:hazardous
                                                                  dtx_srti:impossible
                                                                  dtx_srti:normal
                                                                  dtx_srti:other
                                                                  dtx_srti:passableWithCare
                                                                  dtx_srti:unknown
                                                                  dtx_srti:veryHazardous
                                                                  dtx_srti:winterConditions) ; 
                                                       a owl:Class].
dtx_srti:Enums a owl:Class;
               rdfs:comment "Data Dictionary.This clause contains the definitions of all enumerations which are used."@en.
dtx_srti:EnvironmentalObstruction a owl:Class;
                                  rdfs:comment "An obstruction on the road resulting from an environmental cause."@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:EnvironmentalObstructionTypeEnum ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:hasEnvironmentalObstructionTypeEnum ; 
                                                   a owl:Restriction],
                                                  dtx_srti:Obstruction;
                                  owl:disjointWith dtx_srti:VehicleObstruction,
                                                   dtx_srti:GeneralObstruction.
dtx_srti:EnvironmentalObstructionTypeEnum a owl:Class;
                                          rdfs:comment "Types of environmental obstructions."@en;
                                          rdfs:subClassOf dtx_srti:SituationEnumerations;
                                          owl:equivalentClass [owl:oneOf (dtx_srti:avalanches
                                                                          dtx_srti:fallenTrees
                                                                          dtx_srti:flooding
                                                                          dtx_srti:landslips
                                                                          dtx_srti:rockfalls
                                                                          dtx_srti:subsidence) ; 
                                                               a owl:Class].
dtx_srti:GeneralInstructionOrMessageToRoadUsers a owl:Class;
                                                rdfs:comment "General instruction and/or message that is issued by the network/road operator which is applicable to drivers and sometimes passengers."@en;
                                                rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                 owl:onProperty dtx_srti:generalMessageToRoadUsers ; 
                                                                 a owl:Restriction],
                                                                [owl:someValuesFrom dtx_srti:GeneralInstructionOrMessageToRoadUsersTypeEnum ; 
                                                                 owl:onProperty dtx_srti:hasGeneralInstructionOrMessageToRoadUsersType ; 
                                                                 a owl:Restriction],
                                                                dtx_srti:NetworkManagement.
dtx_srti:GeneralInstructionOrMessageToRoadUsersTypeEnum a owl:Class;
                                                        rdfs:comment "General instructions that may be issued to road users (specifically drivers and sometimes passengers) by an operator or operational system in support of network management activities or emergency situations."@en;
                                                        rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                                        owl:equivalentClass [owl:oneOf (dtx_srti:allowEmergencyVehiclesToPass
                                                                                        dtx_srti:approachWithCare
                                                                                        dtx_srti:avoidTheArea
                                                                                        dtx_srti:closeAllWindowsTurnOffHeaterAndVents
                                                                                        dtx_srti:crossJunctionWithCare
                                                                                        dtx_srti:doNotAllowUnnecessaryGaps
                                                                                        dtx_srti:doNotLeaveYourVehicle
                                                                                        dtx_srti:doNotThrowOutAnyBurningObjects
                                                                                        dtx_srti:doNotUseNavigationSystems
                                                                                        dtx_srti:driveCarefully
                                                                                        dtx_srti:driveWithExtremeCaution
                                                                                        dtx_srti:flashYourLights
                                                                                        dtx_srti:followTheVehicleInFrontSmoothly
                                                                                        dtx_srti:inEmergencyWaitForPatrolService
                                                                                        dtx_srti:increaseNormalFollowingDistance
                                                                                        dtx_srti:keepYourDistance
                                                                                        dtx_srti:leaveYourVehicleProceedToNextSafePlace
                                                                                        dtx_srti:noNakedFlames
                                                                                        dtx_srti:noOvertaking
                                                                                        dtx_srti:noSmoking
                                                                                        dtx_srti:noStopping
                                                                                        dtx_srti:noUturns
                                                                                        dtx_srti:observeAmberAlert
                                                                                        dtx_srti:observeSignals
                                                                                        dtx_srti:observeSigns
                                                                                        dtx_srti:onlyTravelIfAbsolutelyNecessary
                                                                                        dtx_srti:other
                                                                                        dtx_srti:overtakeWithCare
                                                                                        dtx_srti:pullOverToTheEdgeOfTheRoadway
                                                                                        dtx_srti:stopAtNextSafePlace
                                                                                        dtx_srti:stopAtNextServiceArea
                                                                                        dtx_srti:switchOffEngine
                                                                                        dtx_srti:switchOffMobilePhonesAndTwoWayRadios
                                                                                        dtx_srti:testYourBrakes
                                                                                        dtx_srti:useBusService
                                                                                        dtx_srti:useFogLights
                                                                                        dtx_srti:useHazardWarningLights
                                                                                        dtx_srti:useHeadlights
                                                                                        dtx_srti:useRailService
                                                                                        dtx_srti:useTramService
                                                                                        dtx_srti:useUndergroundService
                                                                                        dtx_srti:waitForEscortVehicle) ; 
                                                                             a owl:Class].
dtx_srti:GeneralNetworkManagement a owl:Class;
                                  rdfs:comment """Network management action which is applicable to the road network and its users. \"trafficManuallyDirectedBy\" is only valid if \"hasGeneralNetworkManagementTypeEnum\" is set to \"trafficBeingManuallyDirected\"."""@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:PersonCategoryEnum ; 
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:trafficManuallyDirectedBy ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom dtx_srti:GeneralNetworkManagementTypeEnum ; 
                                                   owl:onProperty dtx_srti:hasGeneralNetworkManagementType ; 
                                                   a owl:Restriction],
                                                  dtx_srti:NetworkManagement.
dtx_srti:GeneralNetworkManagementTypeEnum a owl:Class;
                                          rdfs:comment "Types of network management actions."@en;
                                          rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                          owl:equivalentClass [owl:oneOf (dtx_srti:bridgeSwingInOperation
                                                                          dtx_srti:convoyService
                                                                          dtx_srti:obstacleSignalling
                                                                          dtx_srti:other
                                                                          dtx_srti:rampMeteringInOperation
                                                                          dtx_srti:temporaryTrafficLights
                                                                          dtx_srti:tollGatesOpen
                                                                          dtx_srti:trafficBeingManuallyDirected
                                                                          dtx_srti:trafficHeld) ; 
                                                               a owl:Class].
dtx_srti:GeneralObstruction a owl:Class;
                            rdfs:comment "Any stationary or moving obstacle of a physical nature, other than of an animal, vehicle, environmental, or damaged equipment nature."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:ObstructionTypeEnum ; 
                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasObstructionTypeEnum ; 
                                             a owl:Restriction],
                                            dtx_srti:Obstruction;
                            owl:disjointWith dtx_srti:VehicleObstruction.
dtx_srti:GeoSparqlClasses a owl:Class;
                          rdfs:comment "The OGC GeoSPARQL standard supports representing and querying geospatial data on the Semantic Web. GeoSPARQL defines a vocabulary for representing geospatial data in RDF, and it defines an extension to the SPARQL query language for processing geospatial data."@en;
                          rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:Geo_WGS84 a owl:Class;
                   rdfs:comment "Geo WGS84 vocabulary"@en;
                   rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:GeographicCharacteristicEnum a owl:Class;
                                      rdfs:comment "Descriptor to help to identify a specific location."@en;
                                      rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                                      owl:equivalentClass [owl:oneOf (dtx_srti:aroundABendInRoad
                                                                      dtx_srti:onBorder
                                                                      dtx_srti:onPass
                                                                      dtx_srti:overCrestOfHill) ; 
                                                           a owl:Class].
dtx_srti:Gml a owl:Class;
             rdfs:comment "GML location"@en;
             rdfs:subClassOf dtx_srti:LocationObjects.
dtx_srti:GmlLineString a owl:Class;
                       rdfs:comment """Line string based on GML (EN ISO 19136) definition: a curve defined by a series of two or more coordinate tuples. Unlike GML may be self-intersecting. If srsName attribute is not present, posList is assumed to use \"ETRS89-LatLonh\" reference system."""@en;
                       rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:srsName ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:nonNegativeInteger ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:srsDimension ; 
                                        a owl:Restriction],
                                       [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#GmlPosList> ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:gmlPosList ; 
                                        a owl:Restriction],
                                       dtx_srti:Gml.
dtx_srti:GmlLinearRing a owl:Class;
                       rdfs:comment "Closed line string not self-intersecting (i.e. having as last point the first point)"@en;
                       rdfs:subClassOf dtx_srti:GmlLineString.
dtx_srti:GmlMultiPolygon a owl:Class;
                         rdfs:comment "An area defined by a set of polygons acording to GML (EN ISO 19136)."@en;
                         rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:gmlAreaName ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom dtx_srti:GmlPolygon ; 
                                          owl:onProperty dtx_srti:hasGmlPolygon ; 
                                          a owl:Restriction],
                                         dtx_srti:Gml.
dtx_srti:GmlPolygon a owl:Class;
                    rdfs:comment "Planar surface defined by 1 exterior boundary and 0 or more interior boundaries"@en;
                    rdfs:subClassOf [owl:onClass dtx_srti:GmlLinearRing ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:hasGmlExteriorLinearRing ; 
                                     a owl:Restriction],
                                    dtx_srti:Gml.
dtx_srti:HeaderInformation a owl:Class;
                           rdfs:comment "Management information relating to the data contained within a publication.";
                           rdfs:subClassOf [owl:onClass dtx_srti:InformationStatusEnum ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:hasInformationStatus ; 
                                            a owl:Restriction],
                                           [owl:someValuesFrom dtx_srti:ConfidentialityValueEnum ; 
                                            owl:onProperty dtx_srti:hasConfidentiality ; 
                                            a owl:Restriction],
                                           dtx_srti:CommonClasses.
dtx_srti:HeightCoordinate a owl:Class;
                          rdfs:comment "Third coordinate for points defined geodetically";
                          rdfs:subClassOf [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:heightValue ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:PositionAccuracy ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasVerticalPositionAccuracy ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:HeightTypeEnum ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasHeightTypeEnum ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:AltitudeConfidence ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasAltitudeConfidence ; 
                                           a owl:Restriction],
                                          dtx_srti:PointCoordinatesAssociationsFrom.
dtx_srti:HeightCoordinateAssociationFrom a owl:Class;
                                         rdfs:comment "Third coordinate for points defined geodetically"@en;
                                         rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:HeightGradeEnum a owl:Class;
                         rdfs:comment "List of height or vertical gradings of road sections."@en;
                         rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                         owl:equivalentClass [owl:oneOf (dtx_srti:aboveGrade
                                                         dtx_srti:atGrade
                                                         dtx_srti:belowGrade) ; 
                                              a owl:Class].
dtx_srti:HeightTypeEnum a owl:Class;
                        rdfs:comment "Coded value for type of height"@en;
                        rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                        owl:equivalentClass [owl:oneOf (dtx_srti:ellipsoidalHeight
                                                        dtx_srti:gravityRelatedHeight
                                                        dtx_srti:relativeHeight) ; 
                                             a owl:Class].
dtx_srti:Impact a owl:Class;
                rdfs:comment "An assessment of the impact that an event or operator action defined by the situation record has on the driving conditions."@en;
                rdfs:subClassOf [owl:onDataRange xsd:nonNegativeInteger ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:numberOfOperationalLanes ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:nonNegativeInteger ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:numberOfLanesRestricted ; 
                                 a owl:Restriction],
                                [owl:onDataRange qudt:floatPercentage ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:capacityRemaining ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:residualRoadWidth ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:residualLaneWidth ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:Delays ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:hasDelays ; 
                                 a owl:Restriction],
                                dtx_srti:CommonClasses.
dtx_srti:ImportedClasses a owl:Class;
                         rdfs:comment "Only for organizational purposes"@en.
dtx_srti:InformationDeliveryServicesEnum a owl:Class;
                                         rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                         owl:equivalentClass [owl:oneOf (dtx_srti:anyGeneralDeliveryService
                                                                         dtx_srti:safetyServices
                                                                         dtx_srti:vms) ; 
                                                              a owl:Class].
dtx_srti:InformationStatusEnum a owl:Class;
                               rdfs:comment "Status of the related information (i.e. real, test or exercise)."@en;
                               rdfs:subClassOf dtx_srti:PayLoadEnumerations;
                               owl:equivalentClass [owl:oneOf (dtx_srti:real
                                                               dtx_srti:securityExercise
                                                               dtx_srti:technicalExercise
                                                               dtx_srti:test) ; 
                                                    a owl:Class].
dtx_srti:InfrastructureDamageObstruction a owl:Class;
                                         rdfs:comment "An obstruction on the road caused by one Infrastructure Damage"@en;
                                         rdfs:subClassOf [owl:someValuesFrom dtx_srti:InfrastructureDamageTypeEnum ; 
                                                          owl:onProperty dtx_srti:hasInfrastructureDamageType ; 
                                                          a owl:Restriction],
                                                         dtx_srti:Obstruction.
dtx_srti:InfrastructureDamageTypeEnum a owl:Class;
                                      rdfs:comment "Types of infrastructure damage which may have an effect on the road network."@en;
                                      rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                      owl:equivalentClass [owl:oneOf (dtx_srti:burstPipe
                                                                      dtx_srti:burstWaterMain
                                                                      dtx_srti:collapsedSewer
                                                                      dtx_srti:damagedBridge
                                                                      dtx_srti:damagedCrashBarrier
                                                                      dtx_srti:damagedFlyover
                                                                      dtx_srti:damagedGallery
                                                                      dtx_srti:damagedGantry
                                                                      dtx_srti:damagedRoadSurface
                                                                      dtx_srti:damagedTunnel
                                                                      dtx_srti:damagedViaduct
                                                                      dtx_srti:fallenPowerCables
                                                                      dtx_srti:gasLeak
                                                                      dtx_srti:other
                                                                      dtx_srti:weakBridge) ; 
                                                           a owl:Class].
dtx_srti:InfrastructureDescriptorEnum a owl:Class;
                                      rdfs:comment "Descriptor identifying infrastructure to help to identify a specific location."@en;
                                      rdfs:subClassOf dtx_srti:LocationReferencingEnumerations.
dtx_srti:InternationalIdentifier a owl:Class;
                                 rdfs:comment "An identifier/name whose range is specific to the particular country.";
                                 rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:nationalIdentifier ; 
                                                  a owl:Restriction],
                                                 [owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:country ; 
                                                  a owl:Restriction],
                                                 dtx_srti:CommonClasses.
dtx_srti:IsoNamedArea a owl:Class;
                      rdfs:comment """Iso named area	The ISO 3166-2 representation for the named area."""@en;
                      rdfs:subClassOf [owl:onClass dtx_srti:SubdivisionTypeEnum ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasSubdivisionTypeEnum ; 
                                       a owl:Restriction],
                                      [owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentation#CountrySubdivision> ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasCountrySubdivision ; 
                                       a owl:Restriction],
                                      dtx_srti:NamedArea.
dtx_srti:Itinerary a owl:Class;
                   rdfs:comment "Multiple (i.e. more than one) physically separate locations arranged as an ordered set that defines an itinerary or route. In SRTI is not included ItineraryByReference"@en;
                   rdfs:subClassOf dtx_srti:LocationReference.
dtx_srti:ItineraryByIndexedLocations a owl:Class;
                                     rdfs:comment """Multiple physically separate locations arranged as an ordered set that defines an itinerary or route. The index qualifier indicates the order.
Association: 1..1 Location"""@en;
                                     rdfs:subClassOf [owl:onClass dtx_srti:Location ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:hasLocationContainedInItinerary ; 
                                                      a owl:Restriction],
                                                     dtx_srti:Itinerary.
dtx_srti:LCC_CountryRepresentation a owl:Class;
                                   rdfs:comment """Country Representation ontology provides a reference model to support the first two parts of ISO 3166, along with the other coding systems:
 - ISO 3166-1 (Country codes) establishes codes that represent the current names of countries, dependencies, and other areas of particular geopolitical interest, on the basis of lists of country names obtained from the United Nations.
 - ISO 3166-2 (Country subdivision code) establishes a code that represents the names of the principal administrative divisions, or similar areas, of the countries, etc. included in the ISO 3166-1.
 - ISO 3166-3 (Code for formerly used names of countries) establishes a code that represents non-current country names, i.e., the country names deleted from ISO 3166 since its first publication in 1974."""@en;
                                   rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:Lane a owl:Class;
              rdfs:comment "Indicates a specific lane or group of lanes."@en;
              rdfs:subClassOf [owl:onDataRange xsd:integer ; 
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty dtx_srti:laneNumber ; 
                               a owl:Restriction],
                              [owl:onClass dtx_srti:LaneEnum ; 
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty dtx_srti:hasLaneEnum ; 
                               a owl:Restriction],
                              dtx_srti:SupplementaryPositionalPack.
dtx_srti:LaneEnum a owl:Class;
                  rdfs:comment "List of descriptors identifying specific lanes."@en;
                  rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                  owl:equivalentClass [owl:oneOf (dtx_srti:allLanesCompleteCarriageway
                                                  dtx_srti:busLane
                                                  dtx_srti:busStop
                                                  dtx_srti:carPoolLane
                                                  dtx_srti:centralReservation
                                                  dtx_srti:crawlerLane
                                                  dtx_srti:cycleLane
                                                  dtx_srti:emergencyLane
                                                  dtx_srti:escapeLane
                                                  dtx_srti:expressLane
                                                  dtx_srti:hardShoulder
                                                  dtx_srti:heavyVehicleLane
                                                  dtx_srti:layBy
                                                  dtx_srti:leftHandTurningLane
                                                  dtx_srti:leftLane
                                                  dtx_srti:localTrafficLane
                                                  dtx_srti:middleLane
                                                  dtx_srti:overtakingLane
                                                  dtx_srti:rightHandTurningLane
                                                  dtx_srti:rightLane
                                                  dtx_srti:rushHourLane
                                                  dtx_srti:setDownArea
                                                  dtx_srti:slowVehicleLane
                                                  dtx_srti:throughTrafficLane
                                                  dtx_srti:tidalFlowLane
                                                  dtx_srti:turningLane
                                                  dtx_srti:verge) ; 
                                       a owl:Class].
dtx_srti:LinearDirectionEnum a owl:Class;
                             rdfs:comment "Directions of traffic flow relative to the direction in which the linear element is defined."@en;
                             rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                             owl:equivalentClass [owl:oneOf (dtx_srti:aligned
                                                             dtx_srti:both
                                                             dtx_srti:opposite
                                                             dtx_srti:unknown) ; 
                                                  a owl:Class].
dtx_srti:LinearElement a owl:Class;
                       rdfs:comment "A linear element along a single linear object, consistent with EN ISO 19148 definitions."@en;
                       rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:roadName ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:linearElementReferenceModelVersion ; 
                                        a owl:Restriction],
                                       [owl:onDataRange xsd:string ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:linearElementReferenceModel ; 
                                        a owl:Restriction],
                                       [owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasRoadNumber ; 
                                        a owl:Restriction],
                                       [owl:onClass dtx_srti:LinearElementNatureEnum ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasLinearElementNature ; 
                                        a owl:Restriction],
                                       dtx_srti:LinearReferencing.
dtx_srti:LinearElementByCode a owl:Class;
                             rdfs:comment "A linear element along a single linear object defined by its identifier or code in a road network reference model (specified in LinearElement class) which segments the road network according to specific business rules."@en;
                             rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:linearElementIdentifier ; 
                                              a owl:Restriction],
                                             dtx_srti:LinearElement.
dtx_srti:LinearElementByLineString a owl:Class;
                                   rdfs:comment "A linear element defined by a line string (class GmlLineString)."@en;
                                   rdfs:subClassOf [owl:onClass dtx_srti:GmlLineString ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasGmlLineString ; 
                                                    a owl:Restriction],
                                                   dtx_srti:LinearElement.
dtx_srti:LinearElementByPoints a owl:Class;
                               rdfs:comment "A linear element along a single linear object defined by its start and end points."@en;
                               owl:equivalentClass [a owl:Class ; 
                                                    owl:intersectionOf (dtx_srti:LinearElement
                                                                        [owl:onClass dtx_srti:Referent ; 
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        owl:onProperty dtx_srti:hasReferentEndPointLinearElement ; 
                                                                        a owl:Restriction]
                                                                        [owl:onClass dtx_srti:Referent ; 
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        owl:onProperty dtx_srti:hasReferentIntermediatePointLinearElement ; 
                                                                        a owl:Restriction]
                                                                        [owl:onClass dtx_srti:Referent ; 
                                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                        owl:onProperty dtx_srti:hasReferentStartPointLinearElement ; 
                                                                        a owl:Restriction])].
dtx_srti:LinearElementNatureEnum a owl:Class;
                                 rdfs:comment "List of indicative natures of linear elements."@en;
                                 rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:other
                                                                 dtx_srti:road
                                                                 dtx_srti:roadSection
                                                                 dtx_srti:slipRoad) ; 
                                                      a owl:Class].
dtx_srti:LinearLocation a owl:Class;
                        rdfs:comment """Location representing a linear section with optional directionality defined between two points. Any LinearLocation must have an instance of at least one of these classes. If using multiple instances, producers must take care to ensure they represent the same location.
Associations:
0..1	OpenlrLinear
0..1	GmlLineString
0..1	SupplementaryPositionalDescription"""@en;
                        rdfs:subClassOf [owl:onClass dtx_srti:SupplementaryPositionalDescription ; 
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:hasSecondarySupplementaryDescription ; 
                                         a owl:Restriction],
                                        [owl:onClass dtx_srti:OpenlrLinear ; 
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:hasOpenlrLinear ; 
                                         a owl:Restriction],
                                        [owl:onClass dtx_srti:GmlLineString ; 
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:hasGmlLineString ; 
                                         a owl:Restriction],
                                        dtx_srti:NetworkLocation.
dtx_srti:LinearReferencing a owl:Class;
                           rdfs:comment "Only for organizational purposes.Package LinearReferencing"@en;
                           rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:LinearWithinLinearElement a owl:Class;
                                   rdfs:comment "A linear section along a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with ISO 19148 definitions."@en;
                                   rdfs:subClassOf [owl:onClass dtx_srti:DirectionEnum ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:directionOnLinearSection ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:LinearElement ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasLinearElement ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:DistanceAlongLinearElement ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasDistanceAlongLinearElementTo ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:DistanceAlongLinearElement ; 
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasDistanceAlongLinearElementFrom ; 
                                                    a owl:Restriction],
                                                   dtx_srti:LinearReferencing,
                                                   [owl:onClass dtx_srti:HeightGradeEnum ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasHeightGradeOfLinearSection ; 
                                                    a owl:Restriction],
                                                   [owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasAdministrativeAreaOfLinearSection ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:LinearDirectionEnum ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:directionRelativeOnLinearSection ; 
                                                    a owl:Restriction].
dtx_srti:Location dcterms:replaces "groupOfLocations"@en;
                  a owl:Class;
                  rdfs:comment "The specification of a location either on a network (as a point or a linear location) or as an area. This may be provided in one or more referencing systems. Association: 0..1PointCoordinates. In SRTI is not included LocationByReference."@en;
                  rdfs:label "Location"@en;
                  rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasPointCoordinates ; 
                                   a owl:Restriction],
                                  dtx_srti:LocationReference.
dtx_srti:LocationObjects a owl:Class;
                         rdfs:comment "Only for organizational purposes"@en;
                         rdfs:subClassOf dtx_srti:PayLoadPublishing.
dtx_srti:LocationReference a owl:Class;
                           rdfs:comment "Represents one or more physically separate locations. Multiple locations may be related, as in an itinerary or route, or may be unrelated. One LocationReference should not use multiple Location objects to represent the same physical location. In SRTI is not included LocationGroup"@en;
                           rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:LocationReferencing a owl:Class;
                             rdfs:comment "Only for organizational purposes.".
dtx_srti:LocationReferencingEnumerations a owl:Class;
                                         rdfs:comment "Only for organizational purposes"@en;
                                         rdfs:subClassOf dtx_srti:Enums.
dtx_srti:MaintenanceVehicleActionsEnum a owl:Class;
                                       rdfs:comment "Types of maintenance vehicle actions associated with roadworks."@en;
                                       rdfs:subClassOf dtx_srti:SituationEnumerations;
                                       owl:equivalentClass [owl:oneOf (dtx_srti:maintenanceVehiclesMergingIntoTrafficFlow
                                                                       dtx_srti:saltAndGritSpreading
                                                                       dtx_srti:slowMoving
                                                                       dtx_srti:snowClearing
                                                                       dtx_srti:stoppingToServiceEquipments) ; 
                                                            a owl:Class].
dtx_srti:MaintenanceVehicles a owl:Class;
                             rdfs:comment "Details of the maintenance vehicles involved in the roadworks activity."@en;
                             rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ; 
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:numberOfMaintenanceVehicles ; 
                                              a owl:Restriction],
                                             dtx_srti:PayLoadPublishing.
dtx_srti:MaintenanceWorks a owl:Class;
                          rdfs:comment "Roadworks involving the maintenance or installation of infrastructure."@en;
                          rdfs:subClassOf [owl:onClass dtx_srti:RoadMaintenanceTypeEnum ; 
                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasRoadMaintenanceType ; 
                                           a owl:Restriction],
                                          dtx_srti:RoadWorks.
dtx_srti:MetresAsFloatValue a owl:Class;
                            rdfs:comment "A measure of distance defined in metres in a floating point format."@en;
                            rdfs:subClassOf [owl:someValuesFrom xsd:float ; 
                                             owl:onProperty <http://qudt.org/schema/qudt#numericValue> ; 
                                             a owl:Restriction],
                                            [owl:hasValue unit:M ; 
                                             owl:onProperty <http://qudt.org/schema/qudt#unit> ; 
                                             a owl:Restriction],
                                            <http://qudt.org/schema/qudt#QuantityValue>.
dtx_srti:MetresAsNonNegativeIntegerValue a owl:Class;
                                         rdfs:comment "A measure of distance defined in metres in a non negative integer format."@en;
                                         rdfs:subClassOf [owl:someValuesFrom xsd:nonNegativeInteger ; 
                                                          owl:onProperty <http://qudt.org/schema/qudt#numericValue> ; 
                                                          a owl:Restriction],
                                                         [owl:hasValue unit:M ; 
                                                          owl:onProperty <http://qudt.org/schema/qudt#unit> ; 
                                                          a owl:Restriction],
                                                         <http://qudt.org/schema/qudt#QuantityValue>.
dtx_srti:Mobility a owl:Class;
                  rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en;
                  rdfs:subClassOf [owl:onClass dtx_srti:SpeedValue ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:speed ; 
                                   a owl:Restriction],
                                  [owl:onClass dtx_srti:MobilityTypeEnum ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasMobilityType ; 
                                   a owl:Restriction],
                                  dtx_srti:CommonClasses.
dtx_srti:MobilityTypeEnum a owl:Class;
                          rdfs:comment "An indication of whether the associated instance of a SituationRecord is mobile (e.g. a march or parade moving along a road) or stationary."@en;
                          rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                          owl:equivalentClass [owl:oneOf (dtx_srti:mobile
                                                          dtx_srti:stationary
                                                          dtx_srti:unknown) ; 
                                               a owl:Class].
dtx_srti:NamedArea a owl:Class;
                   rdfs:comment "An area defined by a name and/or in terms of known boundaries, such as country or county boundaries or allocated control area of particular authority. The attributes do not form a union; instead, the smallest intersection forms the resulting area."@en;
                   rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:areaNameProperty ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:NamedAreaTypeEnum ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasNamedAreaTypeEnum ; 
                                    a owl:Restriction],
                                   [owl:onClass <http://www.omg.org/spec/LCC/Countries/CountryRepresentationi#Alpha2Code> ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:country ; 
                                    a owl:Restriction],
                                   dtx_srti:LocationReferencing,
                                   dtx_srti:CommonClasses.
dtx_srti:NamedAreaTypeEnum a owl:Class;
                           rdfs:comment "Types of areas."@en;
                           rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                           owl:equivalentClass [owl:oneOf (dtx_srti:accidentInvolvingRadioactiveMaterial
                                                           dtx_srti:applicationRegion
                                                           dtx_srti:carParkArea
                                                           dtx_srti:carpoolArea
                                                           dtx_srti:continent
                                                           dtx_srti:country
                                                           dtx_srti:countryGroup
                                                           dtx_srti:fuzzyArea
                                                           dtx_srti:industrialArea
                                                           dtx_srti:lake
                                                           dtx_srti:meteorologicalArea
                                                           dtx_srti:metropolitanArea
                                                           dtx_srti:municipality
                                                           dtx_srti:order1AdministrativeArea
                                                           dtx_srti:order2AdministrativeArea
                                                           dtx_srti:order3AdministrativeArea
                                                           dtx_srti:order4AdministrativeArea
                                                           dtx_srti:order5AdministrativeArea
                                                           dtx_srti:parkAndRideSite
                                                           dtx_srti:policeForceControlArea
                                                           dtx_srti:roadOperatorControlArea
                                                           dtx_srti:ruralCounty
                                                           dtx_srti:sea
                                                           dtx_srti:touristArea
                                                           dtx_srti:trafficArea
                                                           dtx_srti:urbanCounty
                                                           dtx_srti:waterArea) ; 
                                                a owl:Class].
dtx_srti:NetworkLocation a owl:Class;
                         rdfs:comment "The specification of a location on a network (as a point or a linear location).Association: 0..1 SupplementaryPositionalDescription"@en,
                                      ""@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:SupplementaryPositionalDescription ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasSupplementaryPositionalDescription ; 
                                          a owl:Restriction],
                                         dtx_srti:Location.
dtx_srti:NetworkManagement a owl:Class;
                           rdfs:comment "Restrictions on road usage, whether by legal order or by operational decisions. It includes road and lane closures, weight and dimensional limits, banned turns, contraflows and alternate traffic operations."@en;
                           rdfs:subClassOf dtx_srti:OperatorAction.
dtx_srti:Non-SRTI_Enum a owl:Class;
                       rdfs:comment "Collects the added non-SRTI enumerations. Only for organizational purposes"@en;
                       rdfs:subClassOf dtx_srti:Enums.
dtx_srti:NonWeatherRelatedRoadConditionTypeEnum a owl:Class;
                                                rdfs:comment "Types of road surface conditions which are not related to the weather."@en;
                                                rdfs:subClassOf dtx_srti:SituationEnumerations;
                                                owl:equivalentClass [owl:oneOf (dtx_srti:leavesOnRoad
                                                                                dtx_srti:looseChippings
                                                                                dtx_srti:looseSandOnRoad
                                                                                dtx_srti:mudOnRoad
                                                                                dtx_srti:oilOnRoad
                                                                                dtx_srti:other
                                                                                dtx_srti:petrolOnRoad
                                                                                dtx_srti:roadSurfaceInPoorCondition
                                                                                dtx_srti:slipperyRoad) ; 
                                                                     a owl:Class].
dtx_srti:NonWeatherRelatedRoadConditions a owl:Class;
                                         rdfs:comment "Road surface conditions that are not related to the weather but which may affect driving conditions."@en;
                                         rdfs:subClassOf [owl:someValuesFrom dtx_srti:NonWeatherRelatedRoadConditionTypeEnum ; 
                                                          owl:onProperty dtx_srti:hasNonWeatherRelatedRoadConditionTypeEnum ; 
                                                          a owl:Restriction],
                                                         [owl:complementOf dtx_srti:WeatherRelatedRoadConditions ; 
                                                          a owl:Class],
                                                         dtx_srti:RoadSurfaceConditions;
                                         owl:disjointWith dtx_srti:WeatherRelatedRoadConditions.
dtx_srti:NutsCodeTypeEnum a owl:Class;
                          rdfs:comment "Types of NUTS codes (Nomenclature of territorial units for statistics) including LAU codes (Local Administrative Units)."@en;
                          rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                          owl:equivalentClass [owl:oneOf (dtx_srti:lau1Code
                                                          dtx_srti:lau2Code
                                                          dtx_srti:nuts1Code
                                                          dtx_srti:nuts2Code
                                                          dtx_srti:nuts3Code) ; 
                                               a owl:Class].
dtx_srti:NutsNamedArea a owl:Class;
                       rdfs:comment "The NUTS-Code representation for the named area (Nomenclature of territorial units for statistics) or its LAU code representation (Local Administrative Unit)."@en;
                       rdfs:subClassOf [owl:onClass nutscode: ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:nutsCode ; 
                                        a owl:Restriction],
                                       [owl:onClass dtx_srti:NutsCodeTypeEnum ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasNutsCodeTypeEnum ; 
                                        a owl:Restriction],
                                       dtx_srti:NamedArea;
                       owl:equivalentClass <https://ec.europa.eu/eurostat/ramon/ontologies/geographic.rdf#Region>.
dtx_srti:Obstruction a owl:Class;
                     rdfs:comment "Any stationary or moving obstacle of a physical nature (e.g. obstacles or vehicles from an earlier accident, shed loads on carriageway, rock fall, abnormal or dangerous loads, or animals etc.) which could disrupt or endanger traffic."@en;
                     rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ; 
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:numberOfObstructions ; 
                                      a owl:Restriction],
                                     [owl:onClass dtx_srti:Mobility ; 
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:hasMobilityOfObstruction ; 
                                      a owl:Restriction],
                                     dtx_srti:TrafficElement.
dtx_srti:ObstructionTypeEnum a owl:Class;
                             rdfs:comment "Types of obstructions on the roadway."@en;
                             rdfs:subClassOf dtx_srti:SituationEnumerations;
                             owl:equivalentClass [owl:oneOf (dtx_srti:airCrash
                                                             dtx_srti:childrenOnRoadway
                                                             dtx_srti:clearanceWork
                                                             dtx_srti:cyclistsOnRoadway
                                                             dtx_srti:incident
                                                             dtx_srti:objectOnTheRoad
                                                             dtx_srti:other
                                                             dtx_srti:peopleOnRoadway
                                                             dtx_srti:railCrash
                                                             dtx_srti:rescueAndRecoveryWork
                                                             dtx_srti:shedLoad
                                                             dtx_srti:spillageOnTheRoad
                                                             dtx_srti:unprotectedAccidentArea) ; 
                                                  a owl:Class].
dtx_srti:OffsetDistance a owl:Class;
                        rdfs:comment "The non-negative offset distance from the ALERT-C referenced point to the actual point."@en;
                        rdfs:subClassOf [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:offsetDistance ; 
                                         a owl:Restriction],
                                        dtx_srti:LocationReferencing.
dtx_srti:OpenLR a owl:Class;
                rdfs:comment "OpenLR location"@en;
                rdfs:subClassOf dtx_srti:LocationObjects.
dtx_srti:OpenlrAreaLocationReference a owl:Class;
                                     rdfs:comment "A two-dimensional part of the surface of the earth which is bounded by a closed curve. An area location may cover parts of the road network but does not necessarily need to. It is represented according to the OpenLR standard for Area Locations"@en;
                                     rdfs:subClassOf dtx_srti:OpenLR.
dtx_srti:OpenlrBasePointLocation a owl:Class;
                                 rdfs:comment "Holds common data that are used both in OpenlrPointAccessPoint and OpenlrPointAlongLine."@en;
                                 rdfs:subClassOf [owl:onClass dtx_srti:OpenlrOffsets ; 
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasOpenlrOffsets ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:OpenlrSideOfRoadEnum ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasOpenlrSideOfRoad ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:OpenlrOrientationEnum ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasOpenlrOrientation ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:OpenlrLocationReferencePoint ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasOpenlrLocationReferencePoint ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:OpenlrLastLocationReferencePoint ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasOpenlrLastLocationReferencePoint ; 
                                                  a owl:Restriction],
                                                 dtx_srti:OpenlrPointLocationReference.
dtx_srti:OpenlrBaseReferencePoint a owl:Class;
                                  rdfs:comment "Base class used to hold data about a reference point."@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:OpenlrLineAttributes ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:hasOpenlrLineAttributes ; 
                                                   a owl:Restriction],
                                                  dtx_srti:OpenLR.
dtx_srti:OpenlrCircleLocationReference a owl:Class;
                                       rdfs:comment "The OpenLR method of area definition by providing a center position and a radius"@en;
                                       rdfs:subClassOf [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                        owl:onProperty dtx_srti:openlrRadius ; 
                                                        a owl:Restriction],
                                                       [owl:onClass dtx_srti:OpenlrGeoCoordinate ; 
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                        owl:onProperty dtx_srti:hasOpenlrGeoCoordinate ; 
                                                        a owl:Restriction],
                                                       dtx_srti:OpenlrAreaLocationReference.
dtx_srti:OpenlrClosedLineLocationReference a owl:Class;
                                           rdfs:comment """The OpenLR method of area definition by providing a closed path (i.e. a circuit) in the road network.
The boundary always consists of road segments"""@en;
                                           rdfs:subClassOf [owl:onClass dtx_srti:OpenlrLastLocationReferencePoint ; 
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasOpenlrLastLocationReferencePoint ; 
                                                            a owl:Restriction],
                                                           [owl:onClass dtx_srti:OpenlrLocationReferencePoint ; 
                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:hasOpenlrLocationReferencePoint ; 
                                                            a owl:Restriction],
                                                           dtx_srti:OpenlrAreaLocationReference.
dtx_srti:OpenlrEnumerations a owl:Class;
                            rdfs:comment "Only for organizational purposes"@en;
                            rdfs:subClassOf dtx_srti:Enums.
dtx_srti:OpenlrFormOfWayEnum a owl:Class;
                             rdfs:comment "Enumeration of form of way"@en;
                             rdfs:subClassOf dtx_srti:OpenlrEnumerations;
                             owl:equivalentClass [owl:oneOf (dtx_srti:motorway
                                                             dtx_srti:multipleCarriageway
                                                             dtx_srti:other
                                                             dtx_srti:roundabout
                                                             dtx_srti:singleCarriageway
                                                             dtx_srti:slipRoad
                                                             dtx_srti:trafficSquare
                                                             dtx_srti:undefined) ; 
                                                  a owl:Class].
dtx_srti:OpenlrFunctionalRoadClassEnum a owl:Class;
                                       rdfs:comment "Enumuration of functional road class"@en;
                                       rdfs:subClassOf dtx_srti:OpenlrEnumerations;
                                       owl:equivalentClass [owl:oneOf (dtx_srti:frc0
                                                                       dtx_srti:frc1
                                                                       dtx_srti:frc2
                                                                       dtx_srti:frc3
                                                                       dtx_srti:frc4
                                                                       dtx_srti:frc5
                                                                       dtx_srti:frc6
                                                                       dtx_srti:frc7) ; 
                                                            a owl:Class].
dtx_srti:OpenlrGeoCoordinate a owl:Class;
                             rdfs:comment "A geo-coordinate pair is a position in a map defined by its longitude and latitude coordinate values."@en;
                             rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasOpenlrCoordinates ; 
                                              a owl:Restriction],
                                             dtx_srti:OpenlrPointLocationReference.
dtx_srti:OpenlrGridLocationReference a owl:Class;
                                     rdfs:comment "Area defined using an OpenLR™ method consisting in defining it by a tessellation of rectangles"@en;
                                     rdfs:subClassOf [owl:onDataRange xsd:nonNegativeInteger ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:openlrNumRows ; 
                                                      a owl:Restriction],
                                                     [owl:onDataRange xsd:nonNegativeInteger ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:openlrNumColumns ; 
                                                      a owl:Restriction],
                                                     [owl:onClass dtx_srti:OpenlrRectangle ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:hasOpenlrRectangle ; 
                                                      a owl:Restriction],
                                                     dtx_srti:OpenlrAreaLocationReference.
dtx_srti:OpenlrLastLocationReferencePoint a owl:Class;
                                          rdfs:comment "The sequence of location reference points is terminated by a last location reference point."@en;
                                          rdfs:subClassOf dtx_srti:OpenlrBaseReferencePoint.
dtx_srti:OpenlrLine a owl:Class;
                    rdfs:comment "Only for organizational purposes."@en;
                    rdfs:subClassOf dtx_srti:OpenLR.
dtx_srti:OpenlrLineAttributes a owl:Class;
                              rdfs:comment "Line attributes are part of a location reference point and consists of functional road class (FRC),form of way (FOW) and bearing (BEAR) data."@en;
                              rdfs:subClassOf [owl:onClass dtx_srti:AngleInDegreesValue ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:openlrBearing ; 
                                               a owl:Restriction],
                                              [owl:onClass dtx_srti:OpenlrFunctionalRoadClassEnum ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:hasOpenlrLowestFrcToNextLRPoint ; 
                                               a owl:Restriction],
                                              [owl:onClass dtx_srti:OpenlrFormOfWayEnum ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:hasOpenlrFormOfWayEnum ; 
                                               a owl:Restriction],
                                              dtx_srti:OpenLR.
dtx_srti:OpenlrLineLocationReference a owl:Class;
                                     rdfs:comment "A line location reference is defined by an ordered sequence of location reference points and a terminating last location reference point."@en;
                                     rdfs:subClassOf [owl:onClass dtx_srti:OpenlrLastLocationReferencePoint ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:hasOpenlrLastLocationReferencePoint ; 
                                                      a owl:Restriction],
                                                     [owl:onClass dtx_srti:OpenlrLocationReferencePoint ; 
                                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:hasOpenlrLocationReferencePoint ; 
                                                      a owl:Restriction],
                                                     dtx_srti:OpenlrLine.
dtx_srti:OpenlrLinear a owl:Class;
                      rdfs:comment "OpenLR line location reference"@en;
                      rdfs:subClassOf [owl:onClass dtx_srti:OpenlrLineLocationReference ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasOpenlrOppositeDirection ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:OpenlrOffsets ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasOpenlrOffsets ; 
                                       a owl:Restriction],
                                      [owl:onClass dtx_srti:OpenlrLineLocationReference ; 
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasOpenlrFirstDirection ; 
                                       a owl:Restriction],
                                      dtx_srti:OpenlrLine.
dtx_srti:OpenlrLocationReferencePoint a owl:Class;
                                      rdfs:comment "The basis of a location reference is a sequence of location reference points (LRPs)."@en;
                                      rdfs:subClassOf [owl:onClass dtx_srti:OpenlrPathAttributes ; 
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onProperty dtx_srti:hasOpenlrPathAttributes ; 
                                                       a owl:Restriction],
                                                      dtx_srti:OpenlrBaseReferencePoint.
dtx_srti:OpenlrOffsets a owl:Class;
                       rdfs:comment "Offsets are used to locate the start and end of a location more precisely than bounding to the nodes in a network."@en;
                       rdfs:subClassOf [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:openlrPositiveOffset ; 
                                        a owl:Restriction],
                                       [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:openlrNegativeOffset ; 
                                        a owl:Restriction],
                                       dtx_srti:OpenLR.
dtx_srti:OpenlrOrientationEnum a owl:Class;
                               rdfs:comment "Enumeration of side of road"@en;
                               rdfs:subClassOf dtx_srti:OpenlrEnumerations;
                               owl:equivalentClass [owl:oneOf (dtx_srti:againstLineDirection
                                                               dtx_srti:bothDirections
                                                               dtx_srti:noOrientationOrUnknown
                                                               dtx_srti:withLineDirection) ; 
                                                    a owl:Class].
dtx_srti:OpenlrPathAttributes a owl:Class;
                              rdfs:comment "Properties of the path from the associated location reference point to the next location reference point, which are specified to assist correct identification of the point in an external map data source."@en;
                              rdfs:subClassOf [owl:onDataRange xsd:nonNegativeInteger ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:openlrDistanceToNextLRPoint ; 
                                               a owl:Restriction],
                                              [owl:onClass dtx_srti:OpenlrFunctionalRoadClassEnum ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:hasOpenlrLowestFrcToNextLRPoint ; 
                                               a owl:Restriction],
                                              dtx_srti:OpenLR.
dtx_srti:OpenlrPoiWithAccessPoint a owl:Class;
                                  rdfs:comment "A point of interest (POI) along a line with access is a point location which is defined by a linear reference path, an offset value (defining the access point) from the starting node of this path and a coordinate pair that defines the POI itself."@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:hasOpenlrCoordinates ; 
                                                   a owl:Restriction],
                                                  dtx_srti:OpenlrBasePointLocation.
dtx_srti:OpenlrPointAlongLine a owl:Class;
                              rdfs:comment "Point along a line"@en;
                              rdfs:subClassOf dtx_srti:OpenlrBasePointLocation.
dtx_srti:OpenlrPointLocationReference a owl:Class;
                                      rdfs:comment "A point location is a zero-dimensional element in a map that specifies a geometric location."@en;
                                      rdfs:subClassOf dtx_srti:OpenLR.
dtx_srti:OpenlrPolygonCorners a owl:Class;
                              rdfs:comment "A geodetic coordinate Tuple that defines the vertices of the underlying geometrical polygon."@en;
                              rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                               owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:hasPointCoordinates ; 
                                               a owl:Restriction],
                                              dtx_srti:OpenLR.
dtx_srti:OpenlrPolygonLocationReference a owl:Class;
                                        rdfs:comment "The OpenLR method of area definition by providing points that bound the area"@en;
                                        rdfs:subClassOf [owl:onClass dtx_srti:OpenlrPolygonCorners ; 
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                         owl:onProperty dtx_srti:hasOpenlrPolygonCorners ; 
                                                         a owl:Restriction],
                                                        dtx_srti:OpenlrAreaLocationReference.
dtx_srti:OpenlrRectangle a owl:Class;
                         rdfs:comment "Area delimited by a rectangle defined by the geodetic co-ordinates of the two ends of its diagonal from south-west to north-east (the rectangle having two sides that are parallel to lines of latitude)"@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasOpenlrUpperRight ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:PointCoordinates ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasOpenlrLowerLeft ; 
                                          a owl:Restriction],
                                         dtx_srti:OpenLR.
dtx_srti:OpenlrRectangleLocationReference a owl:Class;
                                          rdfs:comment "The openLR method of area definition by providing a rectangular shape defined by two geo-coordinate pairs"@en;
                                          rdfs:subClassOf [owl:onClass dtx_srti:OpenlrRectangle ; 
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty dtx_srti:hasOpenlrRectangle ; 
                                                           a owl:Restriction],
                                                          dtx_srti:OpenlrAreaLocationReference.
dtx_srti:OpenlrSideOfRoadEnum a owl:Class;
                              rdfs:comment "Enumeration of side of road"@en;
                              rdfs:subClassOf dtx_srti:OpenlrEnumerations;
                              owl:equivalentClass [owl:oneOf (dtx_srti:bothSides
                                                              dtx_srti:left
                                                              dtx_srti:onRoadOrUnknown
                                                              dtx_srti:right) ; 
                                                   a owl:Class].
dtx_srti:OperatorAction a owl:Class;
                        rdfs:comment "Actions that a traffic operator can decide to implement to prevent or help correct dangerous or poor driving conditions, including maintenance of the road infrastructure."@en;
                        rdfs:subClassOf dtx_srti:SituationRecord.
dtx_srti:OverallPeriod a owl:Class;
                       rdfs:comment "A continuous or discontinuous period of validity defined by overall bounding start and end times and the possible intersection of valid periods (potentially recurring) with the complement of exception periods (also potentially recurring)."@en;
                       rdfs:subClassOf [owl:onClass time:Instant ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty time:hasEnd ; 
                                        a owl:Restriction],
                                       [owl:onClass time:Instant ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty time:hasBeginning ; 
                                        a owl:Restriction],
                                       time:ProperInterval,
                                       dtx_srti:CommonClasses.
dtx_srti:PayLoadEnumerations a owl:Class;
                             rdfs:comment "Only for organizational purposes"@en;
                             rdfs:subClassOf dtx_srti:Enums.
dtx_srti:PayLoadPublishing a owl:Class;
                           rdfs:comment "Only for organizational purposes. Package PayloadPublication"@en.
dtx_srti:PayloadPublication a owl:Class;
                            rdfs:comment "A payload publication of traffic related information or associated management information created at a specific point in time that can be exchanged via a DATEX II interface."@en;
                            rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:feedType ; 
                                             a owl:Restriction],
                                            [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:feedDescription ; 
                                             a owl:Restriction],
                                            [owl:onDataRange xsd:dateTime ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:publicationTime ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:InternationalIdentifier ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:publicationCreator ; 
                                             a owl:Restriction],
                                            [owl:onClass <https://www.omg.org/spec/LCC/Languages/LanguageRepresentation/Alpha2Code> ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:defaultLanguage ; 
                                             a owl:Restriction],
                                            dtx_srti:PayLoadPublishing.
dtx_srti:PercentageDistanceAlongLinearElement a owl:Class;
                                              rdfs:comment "Distance of a point along a linear element measured from the start node expressed as a percentage of the whole length of the linear element, where start node is relative to the element definition rather than the direction of traffic flow."@en;
                                              rdfs:subClassOf [owl:onDataRange qudt:floatPercentage ; 
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                               owl:onProperty dtx_srti:percentageDistanceAlong ; 
                                                               a owl:Restriction],
                                                              dtx_srti:DistanceAlongLinearElement.
dtx_srti:PersonCategoryEnum a owl:Class;
                            rdfs:comment "Categories of person."@en;
                            rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                            owl:equivalentClass [owl:oneOf (dtx_srti:adult
                                                            dtx_srti:child
                                                            dtx_srti:emergencyServicesPerson
                                                            dtx_srti:fireman
                                                            dtx_srti:infant
                                                            dtx_srti:medicalStaff
                                                            dtx_srti:memberOfThePublic
                                                            dtx_srti:policeman
                                                            dtx_srti:politician
                                                            dtx_srti:publicTransportPassenger
                                                            dtx_srti:sickPerson
                                                            dtx_srti:trafficOfficer
                                                            dtx_srti:trafficWarden
                                                            dtx_srti:veryImportantPerson) ; 
                                                 a owl:Class].
dtx_srti:PointAlongLinearElement a owl:Class;
                                 rdfs:comment "A point on a linear element where the linear element is either a part of or the whole of a linear object (i.e. a road), consistent with EN ISO 19148 definitions."@en;
                                 rdfs:subClassOf [owl:onClass dtx_srti:HeightGradeEnum ; 
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasHeightGradeOfPoint ; 
                                                  a owl:Restriction],
                                                 [owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit> ; 
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasAdministrativeAreaOfPoint ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:LinearDirectionEnum ; 
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:directionRelativeAtPoint ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:DirectionEnum ; 
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:directionAtPoint ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:LinearElement ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasLinearElement ; 
                                                  a owl:Restriction],
                                                 [owl:onClass dtx_srti:DistanceAlongLinearElement ; 
                                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty dtx_srti:hasDistanceAlongLinearElement ; 
                                                  a owl:Restriction],
                                                 dtx_srti:LinearReferencing.
dtx_srti:PointByCoordinates a owl:Class;
                            rdfs:comment "A single point defined only by a coordinate set with an optional bearing direction."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:AngleInDegreesValue ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:bearing ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:PointCoordinates ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasPointCoordinates ; 
                                             a owl:Restriction],
                                            dtx_srti:PointCoordinatesAssociationsTo.
dtx_srti:PointCoordinates a owl:Class;
                          rdfs:comment """In Datex II definition, a pair of planar coordinates defining the geodetic position of a single point using the European Terrestrial Reference System 1989 (ETRS89).

Note: At the moment, in Spain it is used the WGS84 and so, the 2 references are possible ( geo/wgs84_pos (lat, long) / geo_core (xETRS89,yETRS89) )."""@en;
                          rdfs:subClassOf wgspos:Point,
                                          [owl:onDataRange xsd:float ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty wgspos:lon ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:PositionAccuracy ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasHorizontalPositionAccuracy ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:float ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty <https://datos.ign.es/def/geo_core#xETRS89> ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:float ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty <https://datos.ign.es/def/geo_core#yETRS89> ; 
                                           a owl:Restriction],
                                          [owl:onDataRange xsd:float ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty wgspos:lat ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:PositionConfidenceEllipse ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasPositionConfidenceEllipse ; 
                                           a owl:Restriction],
                                          dtx_srti:LocationReferencing,
                                          [owl:onClass dtx_srti:HeightCoordinate ; 
                                           owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasHeightCoordinate ; 
                                           a owl:Restriction].
dtx_srti:PointCoordinatesAssociationsFrom a owl:Class;
                                          rdfs:comment "Only for organizational purposes.Package PointCoordinates."@en;
                                          rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:PointCoordinatesAssociationsTo a owl:Class;
                                        rdfs:comment "A pair of planar coordinates defining the geodetic position of a single point using the European Terrestrial Reference System 1989 (ETRS89)."@en;
                                        rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:PointLocation a owl:Class;
                       rdfs:comment "Location representing a single geospatial point."@en,
                                    """At least one of these aggregated classes must be present. If using multiple instances of the agregated classes, producers must take care to ensure they present the same location.

Associations:
0..1	PointByCoordinates
0..*	PointAlongLinearElement
0..*	AlertCPoint
0..1	TpegPointLocation
0..1	OpenlrPointLocationReference"""@en;
                       rdfs:subClassOf [owl:onClass dtx_srti:TpegPointLocation ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasTpegPointLocation ; 
                                        a owl:Restriction],
                                       [owl:onClass dtx_srti:PointByCoordinates ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasPointByCoordinates ; 
                                        a owl:Restriction],
                                       [owl:onClass dtx_srti:OpenlrPointLocationReference ; 
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onProperty dtx_srti:hasOpenlrPointLocationReference ; 
                                        a owl:Restriction],
                                       dtx_srti:NetworkLocation.
dtx_srti:PoorEnvironmentConditions a owl:Class;
                                   rdfs:comment "Any environmental conditions which may be affecting the driving conditions on the road."@en;
                                   rdfs:subClassOf [owl:onClass dtx_srti:PoorEnvironmentTypeEnum ; 
                                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasPoorEnvironmentTypeEnum ; 
                                                    a owl:Restriction],
                                                   dtx_srti:Conditions.
dtx_srti:PoorEnvironmentTypeEnum a owl:Class;
                                 rdfs:comment "Types of poor environmental conditions."@en;
                                 rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:badWeather
                                                                 dtx_srti:blowingDust
                                                                 dtx_srti:blowingSnow
                                                                 dtx_srti:crosswinds
                                                                 dtx_srti:extremeCold
                                                                 dtx_srti:extremeHeat
                                                                 dtx_srti:fog
                                                                 dtx_srti:frost
                                                                 dtx_srti:hail
                                                                 dtx_srti:rain
                                                                 dtx_srti:sandStorms
                                                                 dtx_srti:smokeHazard
                                                                 dtx_srti:snowFall
                                                                 dtx_srti:stormForceWinds
                                                                 dtx_srti:strongGustsOfWinds
                                                                 dtx_srti:strongWinds
                                                                 dtx_srti:swarmOfInsects
                                                                 dtx_srti:visibilityReduced) ; 
                                                      a owl:Class].
dtx_srti:PositionAccuracy a owl:Class;
                          rdfs:comment "Horizontal position accuracy parameters defined according to EN 16803-1";
                          rdfs:subClassOf [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:accuracyPercentile95 ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:accuracyPercentile75 ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:accuracyPercentile50 ; 
                                           a owl:Restriction],
                                          dtx_srti:PointCoordinatesAssociationsFrom.
dtx_srti:PositionConfidenceCodedErrorEnum a owl:Class;
                                          rdfs:comment "Error code for horizontal or vertical position confidence"@en;
                                          rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                                          owl:equivalentClass [owl:oneOf (dtx_srti:outOfRange
                                                                          dtx_srti:unavailable) ; 
                                                               a owl:Class].
dtx_srti:PositionConfidenceEllipse a owl:Class;
                                   rdfs:comment "Confidence ellipse position defined in a shape of ellipse with a predefined confidence level (e.g. 95 %). The centre of the ellipse shape corresponds to the reference position point for which the position accuracy is evaluated.";
                                   rdfs:subClassOf [owl:onDataRange xsd:boolean ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:semiMajorAxisOrientationError ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:semiMinorAxisLength ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:AngleInDegreesValue ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:semiMajorAxisOrientation ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:semiMajorAxisLength ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:PositionConfidenceCodedErrorEnum ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasSemiMinorAxisLengthCodedError ; 
                                                    a owl:Restriction],
                                                   [owl:onClass dtx_srti:PositionConfidenceCodedErrorEnum ; 
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty dtx_srti:hasSemiMajorAxisLengthCodedError ; 
                                                    a owl:Restriction],
                                                   dtx_srti:PointCoordinatesAssociationsFrom.
dtx_srti:ProbabilityOfOccurrenceEnum a owl:Class;
                                     rdfs:comment "Levels of confidence that the sender has in the information, ordered {certain, probable, risk of}."@en;
                                     rdfs:subClassOf dtx_srti:SituationEnumerations;
                                     owl:equivalentClass [owl:oneOf (dtx_srti:certain
                                                                     dtx_srti:improbable
                                                                     dtx_srti:probable
                                                                     dtx_srti:riskOf) ; 
                                                          a owl:Class].
dtx_srti:PublicEvent a owl:Class;
                     rdfs:comment "Public event"@en;
                     rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtx_srti:venueName ; 
                                      a owl:Restriction],
                                     dtx_srti:Activity.
dtx_srti:PublicEventTypeEnum a owl:Class;
                             rdfs:comment "Types of public events."@en;
                             rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                             owl:equivalentClass [owl:oneOf (dtx_srti:agriculturalShow
                                                             dtx_srti:airShow
                                                             dtx_srti:athleticsMeeting
                                                             dtx_srti:ballGame
                                                             dtx_srti:baseballGame
                                                             dtx_srti:basketballGame
                                                             dtx_srti:bicycleRace
                                                             dtx_srti:boatRace
                                                             dtx_srti:boatShow
                                                             dtx_srti:boxingTournament
                                                             dtx_srti:bullFight
                                                             dtx_srti:ceremonialEvent
                                                             dtx_srti:commercialEvent
                                                             dtx_srti:concert
                                                             dtx_srti:cricketMatch
                                                             dtx_srti:culturalEvent
                                                             dtx_srti:exhibition
                                                             dtx_srti:fair
                                                             dtx_srti:festival
                                                             dtx_srti:filmTVMaking
                                                             dtx_srti:footballMatch
                                                             dtx_srti:funfair
                                                             dtx_srti:gardeningOrFlowerShow
                                                             dtx_srti:golfTournament
                                                             dtx_srti:hockeyGame
                                                             dtx_srti:horseRaceMeeting
                                                             dtx_srti:internationalSportsMeeting
                                                             dtx_srti:majorEvent
                                                             dtx_srti:marathon
                                                             dtx_srti:market
                                                             dtx_srti:match
                                                             dtx_srti:motorShow
                                                             dtx_srti:motorSportRaceMeeting
                                                             dtx_srti:other
                                                             dtx_srti:parade
                                                             dtx_srti:procession
                                                             dtx_srti:raceMeeting
                                                             dtx_srti:rugbyMatch
                                                             dtx_srti:severalMajorEvents
                                                             dtx_srti:show
                                                             dtx_srti:showJumping
                                                             dtx_srti:sportsMeeting
                                                             dtx_srti:stateOccasion
                                                             dtx_srti:tennisTournament
                                                             dtx_srti:tournament
                                                             dtx_srti:tradeFair
                                                             dtx_srti:waterSportsMeeting
                                                             dtx_srti:winterSportsMeeting) ; 
                                                  a owl:Class].
dtx_srti:Ramon_geoClasses a owl:Class;
                          rdfs:comment "RAMON geographic ontology describes countries, NUTS, and Local Administrative Units (LAU) related concepts and properties"@en;
                          rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:Referent a owl:Class;
                  rdfs:comment "A referent on a linear object that has a known location such as a node, a reference marker (e.g. a marker-post), an intersection etc."@en;
                  rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:referentName ; 
                                   a owl:Restriction],
                                  [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:referentDescription ; 
                                   a owl:Restriction],
                                  [owl:onDataRange xsd:string ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:referentIdentifier ; 
                                   a owl:Restriction],
                                  [owl:onClass dtx_srti:PointCoordinates ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasPointCoordinates ; 
                                   a owl:Restriction],
                                  [owl:onClass dtx_srti:ReferentTypeEnum ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasReferentTypeEnum ; 
                                   a owl:Restriction],
                                  dtx_srti:LinearReferencing.
dtx_srti:ReferentTypeEnum a owl:Class;
                          rdfs:comment "A set of types of known points along a linear object such as a road."@en;
                          rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                          owl:equivalentClass [owl:oneOf (dtx_srti:boundary
                                                          dtx_srti:intersection
                                                          dtx_srti:landmark
                                                          dtx_srti:referenceMarker
                                                          dtx_srti:roadNode) ; 
                                               a owl:Class].
dtx_srti:RelativePositionOnCarriagewayEnum a owl:Class;
                                           rdfs:comment "Identifies a relative position across a carriageway"@en;
                                           rdfs:subClassOf dtx_srti:LocationReferencingEnumerations;
                                           owl:equivalentClass [owl:oneOf (dtx_srti:inTheCentre
                                                                           dtx_srti:onTheLeft
                                                                           dtx_srti:onTheRight) ; 
                                                                a owl:Class].
dtx_srti:RelativeTrafficFlowEnum a owl:Class;
                                 rdfs:comment "Assessment of the traffic flow conditions relative to normally expected conditions at this date/time."@en;
                                 rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:trafficFlowNormal
                                                                 dtx_srti:trafficHeavierThanNormal
                                                                 dtx_srti:trafficLighterThanNormal
                                                                 dtx_srti:trafficVeryMuchHeavierThanNormal
                                                                 dtx_srti:trafficVeryMuchLighterThanNormal) ; 
                                                      a owl:Class].
dtx_srti:ReroutingManagement a owl:Class;
                             rdfs:comment "Rerouting management action that is issued by the network/road operator."@en;
                             rdfs:subClassOf [owl:onClass dtx_srti:ReroutingManagementTypeEnum ; 
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty dtx_srti:hasReroutingManagementType ; 
                                              a owl:Restriction],
                                             dtx_srti:NetworkManagement.
dtx_srti:ReroutingManagementTypeEnum a owl:Class;
                                     rdfs:comment "Management actions relating to rerouting."@en;
                                     rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                     owl:equivalentClass [owl:oneOf (dtx_srti:doNotFollowDiversionSigns
                                                                     dtx_srti:doNotUseEntry
                                                                     dtx_srti:doNotUseExit
                                                                     dtx_srti:doNotUseIntersectionOrJunction
                                                                     dtx_srti:followDiversionSigns
                                                                     dtx_srti:followLocalDiversion
                                                                     dtx_srti:followSpecialMarkers
                                                                     dtx_srti:useEntry
                                                                     dtx_srti:useExit
                                                                     dtx_srti:useIntersectionOrJunction) ; 
                                                          a owl:Class].
dtx_srti:RoadInformation a owl:Class;
                         rdfs:comment "Information on a road"@en;
                         rdfs:subClassOf [owl:onDataRange xsd:string ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:roadName ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:string ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:roadDestination ; 
                                          a owl:Restriction],
                                         [owl:onClass <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber> ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasRoadNumber ; 
                                          a owl:Restriction],
                                         dtx_srti:SupplementaryPositionalPack.
dtx_srti:RoadMaintenanceTypeEnum a owl:Class;
                                 rdfs:comment "Types of road maintenance."@en;
                                 rdfs:subClassOf dtx_srti:SituationEnumerations;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:maintenanceWork
                                                                 dtx_srti:other
                                                                 dtx_srti:repairWork
                                                                 dtx_srti:resurfacingWork
                                                                 dtx_srti:roadMarkingWork
                                                                 dtx_srti:snowploughsInUse) ; 
                                                      a owl:Class].
dtx_srti:RoadOrCarriagewayOrLaneManagement a owl:Class;
                                           rdfs:comment "Road, carriageway or lane management action that is instigated by the network/road operator."@en;
                                           rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ; 
                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                            owl:onProperty dtx_srti:minimumCarOccupancy ; 
                                                            a owl:Restriction],
                                                           dtx_srti:NetworkManagement.
dtx_srti:RoadOrCarriagewayOrLaneManagementTypeEnum a owl:Class;
                                                   rdfs:comment "Management actions relating to road, carriageway or lane usage."@en;
                                                   rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                                   owl:equivalentClass [owl:oneOf (dtx_srti:carPoolLaneInOperation
                                                                                   dtx_srti:carriagewayClosures
                                                                                   dtx_srti:clearALaneForEmergencyVehicles
                                                                                   dtx_srti:clearALaneForSnowploughsAndGrittingVehicles
                                                                                   dtx_srti:closedPermanentlyForTheWinter
                                                                                   dtx_srti:contraflow
                                                                                   dtx_srti:doNotUseSpecifiedLanesOrCarriageways
                                                                                   dtx_srti:hardShoulderRunningInOperation
                                                                                   dtx_srti:heightRestrictionInOperation
                                                                                   dtx_srti:intermittentShortTermClosures
                                                                                   dtx_srti:keepToTheLeft
                                                                                   dtx_srti:keepToTheRight
                                                                                   dtx_srti:laneClosures
                                                                                   dtx_srti:lanesDeviated
                                                                                   dtx_srti:narrowLanes
                                                                                   dtx_srti:newRoadworksLayout
                                                                                   dtx_srti:other
                                                                                   dtx_srti:overnightClosures
                                                                                   dtx_srti:roadCleared
                                                                                   dtx_srti:roadClosed
                                                                                   dtx_srti:rollingRoadBlock
                                                                                   dtx_srti:rushHourLaneInOperation
                                                                                   dtx_srti:singleAlternateLineTraffic
                                                                                   dtx_srti:tidalFlowLaneInOperation
                                                                                   dtx_srti:turnAroundInOperation
                                                                                   dtx_srti:useOfSpecifiedLanesOrCarriagewaysAllowed
                                                                                   dtx_srti:useSpecifiedLanesOrCarriageways
                                                                                   dtx_srti:vehicleStorageInOperation
                                                                                   dtx_srti:weightRestrictionInOperation) ; 
                                                                        a owl:Class].
dtx_srti:RoadSurfaceConditions a owl:Class;
                               rdfs:comment "Conditions of the road surface which may affect driving conditions. These may be related to the weather (e.g. ice, snow etc.) or to other conditions (e.g. oil, mud, leaves etc. on the road)"@en;
                               rdfs:subClassOf dtx_srti:Conditions.
dtx_srti:RoadWorks a owl:Class;
                   rdfs:comment "Highway maintenance, installation and construction activities that may potentially affect traffic operations."@en;
                   rdfs:subClassOf [owl:onDataRange xsd:boolean ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:underTraffic ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:RoadworksScaleEnum ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasRoadworksScaleEnum ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:string ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:roadworksIdentifier ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:MaintenanceVehicles ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasMaintenanceVehicles ; 
                                    a owl:Restriction],
                                   dtx_srti:OperatorAction,
                                   [owl:onClass dtx_srti:Subjects ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasSubject ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:Mobility ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasMobility ; 
                                    a owl:Restriction],
                                   [owl:onClass dtx_srti:RoadworksDurationEnum ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasRoadworksDuration ; 
                                    a owl:Restriction],
                                   [owl:onDataRange xsd:boolean ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:urgentRoadworks ; 
                                    a owl:Restriction],
                                   [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:publicTransportAlternative ; 
                                    a owl:Restriction].
dtx_srti:RoadsideAssistance a owl:Class;
                            rdfs:comment "Details of road side assistance required or being given."@en;
                            rdfs:subClassOf [owl:someValuesFrom dtx_srti:RoadsideAssistanceTypeEnum ; 
                                             owl:onProperty dtx_srti:hasRoadsideAssistenceTypeEnum ; 
                                             a owl:Restriction],
                                            dtx_srti:OperatorAction.
dtx_srti:RoadsideAssistanceTypeEnum a owl:Class;
                                    rdfs:comment "Indicates the nature of the road side assistance that will be, is or has been provided."@en;
                                    rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                    owl:equivalentClass [owl:oneOf (dtx_srti:airAmbulance
                                                                    dtx_srti:busPassengerAssistance
                                                                    dtx_srti:emergencyServices
                                                                    dtx_srti:firstAid
                                                                    dtx_srti:foodDelivery
                                                                    dtx_srti:helicopterRescue
                                                                    dtx_srti:other
                                                                    dtx_srti:vehicleRecovery
                                                                    dtx_srti:vehicleRepair) ; 
                                                         a owl:Class].
dtx_srti:RoadworksDurationEnum a owl:Class;
                               rdfs:comment "Expected durations of roadworks in general terms."@en;
                               rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                               owl:equivalentClass [owl:oneOf (dtx_srti:longTerm
                                                               dtx_srti:mediumTerm
                                                               dtx_srti:shortTerm) ; 
                                                    a owl:Class].
dtx_srti:RoadworksScaleEnum a owl:Class;
                            rdfs:comment "Grade of complexity of the roadworks according to the responsible road operator. For example determined by size, duration and/or traffic disruption."@en;
                            rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                            owl:equivalentClass [owl:oneOf (dtx_srti:major
                                                            dtx_srti:mediumRoadworksScale
                                                            dtx_srti:minor) ; 
                                                 a owl:Class].
dtx_srti:SeverityEnum a owl:Class;
                      rdfs:comment "Levels of severity of a situation as whole assessed by the impact that the situation may have on traffic flow as perceived by the supplier."@en;
                      rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                      owl:equivalentClass [owl:oneOf (dtx_srti:high
                                                      dtx_srti:highest
                                                      dtx_srti:low
                                                      dtx_srti:lowest
                                                      dtx_srti:medium
                                                      dtx_srti:none
                                                      dtx_srti:unknown) ; 
                                           a owl:Class].
dtx_srti:SingleRoadLinearLocation a owl:Class;
                                  rdfs:comment """Location representing a linear section along a single road with optional directionality defined between two points on the same road. No matter the kind of linear reference it uses, the constraint of using only a single road must be preserved. Associations:
0..1	TpegLinearLocation
0..*	AlertCLinear"""@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:TpegLinearLocation ; 
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:hasTpegLinearLocation ; 
                                                   a owl:Restriction],
                                                  dtx_srti:LinearLocation.
dtx_srti:Situation a owl:Class;
                   rdfs:comment "An identifiable instance of a traffic/travel situation comprising one or more traffic/travel circumstances which are linked by one or more causal relationships. Each traffic/travel circumstance is represented by a Situation Record."@en;
                   rdfs:subClassOf [owl:onClass dtx_srti:HeaderInformation ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasHeaderInformation ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom dtx_srti:SituationRecord ; 
                                    owl:onProperty dtx_srti:hasSituationRecord ; 
                                    a owl:Restriction],
                                   dtx_srti:PayLoadPublishing.
dtx_srti:SituationEnumerations a owl:Class;
                               rdfs:comment "Only for organizational purposes"@en;
                               rdfs:subClassOf dtx_srti:Enums.
dtx_srti:SituationPublication a owl:Class;
                              rdfs:comment "A publication containing zero or more traffic/travel situations."@en;
                              rdfs:subClassOf dtx_srti:PayloadPublication.
dtx_srti:SituationRecord a owl:Class;
                         rdfs:comment "Any situation record. An identifiable versioned instance of a single record/element within a situation.";
                         rdfs:subClassOf [owl:someValuesFrom xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordVersion ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:Validity ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasValidity ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:Impact ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasImpact ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:dateTime ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordObservationTime ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:ConfidentialityValueEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:confidentialityOverride ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:ProbabilityOfOccurrenceEnum ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasProbabilityOfOccurrence ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:dateTime ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordCreationTime ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:Source ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasSource ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:boolean ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:safetyRelatedMessage ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:string ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordCreationReference ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:dateTime ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordFirstSupplierVersionTime ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:LocationReference ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasLocationReference ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:SeverityEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasSeverityEnum ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:Impact ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasImpactOnOppositeDirection ; 
                                          a owl:Restriction],
                                         [owl:onDataRange xsd:dateTime ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:situationRecordVersionTime ; 
                                          a owl:Restriction],
                                         geosparql:Feature,
                                         dtx_srti:PayLoadPublishing.
dtx_srti:SkosClasses a owl:Class;
                     rdfs:comment "Skos Vocabulary"@en;
                     rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:Source a owl:Class;
                rdfs:comment "Details of the source from which the information was obtained."@en;
                rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:sourceName ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:string ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:sourceIdentification ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:boolean ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:reliable ; 
                                 a owl:Restriction],
                                [owl:onClass dtx_srti:SourceTypeEnum ; 
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty dtx_srti:sourceType ; 
                                 a owl:Restriction],
