                                                rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en.
<http://datex2.eu/schema/3/Common/3_1#MetresAsNonNegativeInteger> a rdfs:Datatype;
                                                                  rdfs:comment "A measure of distance defined in metres in a non negative integer format."@en;
                                                                  rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en.
<http://datex2.eu/schema/3/Common/3_1#MultilingualString> a rdfs:Datatype;
