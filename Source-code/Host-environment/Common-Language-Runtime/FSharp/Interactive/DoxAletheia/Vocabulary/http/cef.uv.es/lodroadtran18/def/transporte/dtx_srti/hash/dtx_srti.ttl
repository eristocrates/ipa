<http://datex2.eu/schema/3/Common/3_1#AlertCLocationCode> a rdfs:Datatype;
                                                          rdfs:comment "Unique code within the ALERT-C location table which identifies the specific point, linear or area location.Unique code within the ALERT-C location table which identifies the specific point, linear or area location."@en;
                                                          rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en.
