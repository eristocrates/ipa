dtx_srti:SubjectTypeOfWorksEnum a owl:Class;
                                rdfs:comment "The subjects with which the roadworks are associated."@en;
                                rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                owl:equivalentClass [owl:oneOf (dtx_srti:bridge
                                                                dtx_srti:buriedCables
                                                                dtx_srti:buriedServices
                                                                dtx_srti:crashBarrier
                                                                dtx_srti:gallery
                                                                dtx_srti:gantry
