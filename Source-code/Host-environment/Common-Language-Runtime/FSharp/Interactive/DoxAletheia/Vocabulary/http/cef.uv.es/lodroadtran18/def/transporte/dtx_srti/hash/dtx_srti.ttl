dtx_srti:delayBand a owl:ObjectProperty;
                   rdfs:comment """The time band within which the additional travel time due to adverse travel conditions of any kind falls, when compared to \"normal conditions\"."""@en;
                   rdfs:domain dtx_srti:Delays;
                   rdfs:range dtx_srti:DelayBandEnum.
dtx_srti:delayTimeValue a owl:DatatypeProperty;
                        rdfs:comment """The value of the additional travel time due to adverse travel conditions of any kind, when compared to \"normal conditions\", given in seconds."""@en;
                        rdfs:domain dtx_srti:Delays;
                        rdfs:range xsd:decimal;
                        owl:equivalentProperty time:seconds.
