                                                        dtx_srti:nonPoliceEmergencyServicePatrol
                                                        dtx_srti:otherOfficialVehicle
                                                        dtx_srti:policePatrol
                                                        dtx_srti:privateBreakdownService
                                                        dtx_srti:publicAndPrivateUtilities
                                                        dtx_srti:registeredMotoristObserver
                                                        dtx_srti:roadAuthorities
                                                        dtx_srti:roadOperatorPatrol
                                                        dtx_srti:roadsideTelephoneCaller
                                                        dtx_srti:spotterAircraft
                                                        dtx_srti:trafficMonitoringStation
                                                        dtx_srti:transitOperator
                                                        dtx_srti:vehicleProbeMeasurement
                                                        dtx_srti:videoProcessingMonitoringStation) ; 
                                             a owl:Class].
dtx_srti:SpeedManagement a owl:Class;
                         rdfs:comment "Speed management action that is instigated by the network/road operator."@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:SpeedValue ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:temporarySpeedLimit ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:SpeedManagementTypeEnum ; 
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasSpeedManagementType ; 
                                          a owl:Restriction],
                                         dtx_srti:NetworkManagement.
dtx_srti:SpeedManagementTypeEnum a owl:Class;
                                 rdfs:comment "Management actions relating to speed."@en;
                                 rdfs:subClassOf dtx_srti:Non-SRTI_Enum.
dtx_srti:SpeedValue a owl:Class;
                    rdfs:comment "A measured or calculated value of speed."@en;
