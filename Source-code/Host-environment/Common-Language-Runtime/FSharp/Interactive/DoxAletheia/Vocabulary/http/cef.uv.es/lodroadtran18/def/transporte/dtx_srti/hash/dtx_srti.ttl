                                                                dtx_srti:roadSigns
                                                                dtx_srti:roadsideDrains
                                                                dtx_srti:roadsideEmbankment
                                                                dtx_srti:roadsideEquipment
                                                                dtx_srti:roundabout
                                                                dtx_srti:tollGate
                                                                dtx_srti:tunnel
                                                                dtx_srti:waterMain) ; 
                                                     a owl:Class].
dtx_srti:Subjects a owl:Class;
                  rdfs:comment "The subjects with which the roadworks are associated."@en;
                  rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#NonNegativeInteger> ; 
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:numberOfSubjects ; 
                                   a owl:Restriction],
                                  [owl:onClass dtx_srti:SubjectTypeOfWorksEnum ; 
                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasSubjectTypeOfWorks ; 
                                   a owl:Restriction],
                                  dtx_srti:CommonClasses.
dtx_srti:SupplementaryPositionalDescription a owl:Class;
                                            rdfs:comment "A collection of supplementary positional information which improves the precision of the location."@en;
                                            rdfs:subClassOf [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:locationPrecision ; 
                                                             a owl:Restriction],
                                                            [owl:onClass dtx_srti:InfrastructureDescriptorEnum ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:hasInfrastructureDescriptor ; 
                                                             a owl:Restriction],
                                                            [owl:onDataRange xsd:nonNegativeInteger ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:sequentialRampNumber ; 
                                                             a owl:Restriction],
                                                            [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:locationDescription ; 
                                                             a owl:Restriction],
                                                            dtx_srti:SupplementaryPositionalPack,
                                                            [owl:onClass dtx_srti:DirectionPurposeEnum ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:hasDirectionPurpose ; 
                                                             a owl:Restriction],
                                                            [owl:onClass dtx_srti:GeographicCharacteristicEnum ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:hasGeographicDescriptor ; 
                                                             a owl:Restriction],
                                                            [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:lengthAffected ; 
                                                             a owl:Restriction],
                                                            [owl:onClass dtx_srti:NamedArea ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:hasNamedArea ; 
                                                             a owl:Restriction],
                                                            [owl:onClass dtx_srti:RelativePositionOnCarriagewayEnum ; 
                                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                             owl:onProperty dtx_srti:hasPositionOnCarriageway ; 
                                                             a owl:Restriction].
dtx_srti:SupplementaryPositionalPack a owl:Class;
                                     rdfs:comment "Supplementary positional information"@en;
                                     rdfs:subClassOf dtx_srti:LocationReferencing.
dtx_srti:TPEGLoc01LinearLocationSubtypeEnum a owl:Class;
                                            rdfs:comment "Types of linear location."@en;
                                            rdfs:subClassOf dtx_srti:TpegEnumerations;
                                            owl:equivalentClass [owl:oneOf (dtx_srti:segment) ; 
                                                                 a owl:Class].
dtx_srti:TimeClasses a owl:Class;
                     rdfs:comment "OWL-Time is an ontology of temporal concepts, for describing the temporal properties of resources. The vocabulary provided expresses facts about relations among instants and intervals, as well as durations. Time positions and durations may be expressed using either the conventional (Gregorian) calendar and clock, or using another temporal reference system such as Unix-time, geologic time, or different calendars."@en;
                     rdfs:subClassOf dtx_srti:ImportedClasses.
dtx_srti:TpegAreaDescriptor a owl:Class;
                            rdfs:comment "A descriptor for describing an area location."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc03AreaDescriptorSubtypeEnum ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:tpegAreaDescriptorType ; 
                                             a owl:Restriction],
                                            dtx_srti:TpegDescriptor.
dtx_srti:TpegAreaLocation a owl:Class;
                          rdfs:comment "A geographic or geometric area defined by a TPEG-Loc structure which may include height information for additional geospatial discrimination"@en;
                          rdfs:subClassOf [owl:onClass dtx_srti:TpegHeight ; 
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:hasTpegHeight ; 
                                           a owl:Restriction],
                                          [owl:onClass dtx_srti:TpegLoc01AreaLocationSubtypeEnum ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:tpegAreaLocationType ; 
                                           a owl:Restriction],
                                          dtx_srti:TpegLoc.
dtx_srti:TpegDescriptor a owl:Class;
                        rdfs:comment "A collection of information providing descriptive references to locations using the TPEG-Loc location referencing approach."@en;
                        rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#MultilingualString> ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:descriptorString ; 
                                         a owl:Restriction],
                                        [owl:onClass [owl:unionOf (<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit>
                                                                   <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber>) ; 
                                                      a owl:Class] ; 
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:descriptor ; 
                                         a owl:Restriction],
                                        dtx_srti:TpegLoc.
dtx_srti:TpegEnumerations a owl:Class;
                          rdfs:comment "Only for organizational purposes"@en;
                          rdfs:subClassOf dtx_srti:Enums.
dtx_srti:TpegFramedPoint a owl:Class;
                         rdfs:comment "A point on the road network which is framed between two other points on the same road."@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc01FramedPointLocationSubtypeEnum ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:tpegFramedPointLocationType ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TpegPoint ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTpegPointTo ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TpegPoint ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTpegPointFrom ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TpegNonJunctionPoint ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTpegFramedPoint ; 
                                          a owl:Restriction],
                                         dtx_srti:TpegPointLocation.
dtx_srti:TpegGeometricArea a owl:Class;
                           rdfs:comment "A geometric area defined by a centre point and a radius."@en;
                           rdfs:subClassOf [owl:onClass dtx_srti:TpegAreaDescriptor ; 
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:hasTpegAreaDescriptor ; 
                                            a owl:Restriction],
                                           [owl:onClass dtx_srti:MetresAsNonNegativeIntegerValue ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:radius ; 
                                            a owl:Restriction],
                                           [owl:onClass dtx_srti:PointCoordinates ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:hasCentrePoint ; 
                                            a owl:Restriction],
                                           dtx_srti:TpegAreaLocation.
dtx_srti:TpegHeight a owl:Class;
                    rdfs:comment "Height information which provides additional discrimination for the applicable area."@en;
                    rdfs:subClassOf [owl:onClass dtx_srti:MetresAsFloatValue ; 
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:height ; 
                                     a owl:Restriction],
                                    [owl:onClass dtx_srti:TpegLoc04HeightTypeEnum ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty dtx_srti:tpegHeightType ; 
                                     a owl:Restriction],
                                    dtx_srti:TpegLoc.
dtx_srti:TpegIlcPointDescriptor a owl:Class;
                                rdfs:comment "A descriptor for describing a junction by defining the intersecting roads."@en;
                                rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc03IlcPointDescriptorSubtypeEnum ; 
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onProperty dtx_srti:tpegIlcPointDescriptorType ; 
                                                 a owl:Restriction],
                                                dtx_srti:TpegPointDescriptor.
dtx_srti:TpegJunction a owl:Class;
                      rdfs:comment "A point on the road network which is a road junction point."@en;
                      rdfs:subClassOf [owl:onClass dtx_srti:TpegJunctionPointDescriptor ; 
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtx_srti:hasTpegJunctionPointDescriptor ; 
                                       a owl:Restriction],
                                      [a owl:Class ; 
                                       owl:intersectionOf ([owl:onClass dtx_srti:TpegIlcPointDescriptor ; 
                                                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty dtx_srti:hasTpegIlcPointDescriptor ; 
                                                           a owl:Restriction]
                                                           [owl:onClass dtx_srti:TpegIlcPointDescriptor ; 
                                                           owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; 
                                                           owl:onProperty dtx_srti:hasTpegIlcPointDescriptor ; 
                                                           a owl:Restriction])],
                                      dtx_srti:TpegPoint;
                      owl:disjointWith dtx_srti:TpegNonJunctionPoint.
dtx_srti:TpegJunctionPointDescriptor a owl:Class;
                                     rdfs:comment "A descriptor for describing a point at a junction on a road network."@en;
                                     rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc03JunctionPointDescriptorSubtypeEnum ; 
                                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                      owl:onProperty dtx_srti:tpegJunctionPointDescriptorType ; 
                                                      a owl:Restriction],
                                                     dtx_srti:TpegPointDescriptor.
dtx_srti:TpegLinearLocation a owl:Class;
                            rdfs:comment "A linear section along a single road defined between two points on the same road by a TPEG-Loc structure."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:TPEGLoc01LinearLocationSubtypeEnum ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:tpegLinearLocationType ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:DirectionEnum ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:tpegDirection ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:TpegPoint ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasTpegPointTo ; 
                                             a owl:Restriction],
                                            dtx_srti:TpegLoc.
dtx_srti:TpegLoc a owl:Class;
                 rdfs:comment "Tpeg location"@en;
                 rdfs:subClassOf dtx_srti:LocationObjects.
dtx_srti:TpegLoc01AreaLocationSubtypeEnum a owl:Class;
                                          rdfs:comment "Types of area."@en;
                                          rdfs:subClassOf dtx_srti:TpegEnumerations;
                                          owl:equivalentClass [owl:oneOf (dtx_srti:largeArea
                                                                          dtx_srti:other) ; 
                                                               a owl:Class].
dtx_srti:TpegLoc01FramedPointLocationSubtypeEnum a owl:Class;
                                                 rdfs:comment "Types of points on the road network framed by two other points on the same road."@en;
                                                 rdfs:subClassOf dtx_srti:TpegEnumerations;
                                                 owl:equivalentClass [owl:oneOf (dtx_srti:framedPoint) ; 
                                                                      a owl:Class].
dtx_srti:TpegLoc01SimplePointLocationSubtypeEnum a owl:Class;
                                                 rdfs:comment "Types of simple point."@en;
                                                 rdfs:subClassOf dtx_srti:TpegEnumerations;
                                                 owl:equivalentClass [owl:oneOf (dtx_srti:intersection
                                                                                 dtx_srti:nonLinkedPoint) ; 
                                                                      a owl:Class].
dtx_srti:TpegLoc03AreaDescriptorSubtypeEnum a owl:Class;
                                            rdfs:comment "Descriptors for describing area locations."@en;
                                            rdfs:subClassOf dtx_srti:TpegEnumerations;
                                            owl:equivalentClass [owl:oneOf (dtx_srti:administrativeAreaName
                                                                            dtx_srti:administrativeReferenceName
                                                                            dtx_srti:areaName
                                                                            dtx_srti:countyName
                                                                            dtx_srti:lakeName
                                                                            dtx_srti:nationName
                                                                            dtx_srti:other
                                                                            dtx_srti:policeForceControlAreaName
                                                                            dtx_srti:regionName
                                                                            dtx_srti:seaName
                                                                            dtx_srti:townName) ; 
                                                                 a owl:Class].
dtx_srti:TpegLoc03IlcPointDescriptorSubtypeEnum a owl:Class;
                                                rdfs:comment "Descriptors for describing a junction by identifying the intersecting roads at a road junction."@en;
                                                rdfs:subClassOf dtx_srti:TpegEnumerations;
                                                owl:equivalentClass [owl:oneOf (dtx_srti:tpegIlcName1
                                                                                dtx_srti:tpegIlcName2
                                                                                dtx_srti:tpegIlcName3) ; 
                                                                     a owl:Class].
dtx_srti:TpegLoc03JunctionPointDescriptorSubtypeEnum a owl:Class;
                                                     rdfs:comment "Descriptors for describing a point at a road junction."@en;
                                                     rdfs:subClassOf dtx_srti:TpegEnumerations;
                                                     owl:equivalentClass [owl:oneOf (dtx_srti:junctionName) ; 
                                                                          a owl:Class].
dtx_srti:TpegLoc03OtherPointDescriptorSubtypeEnum a owl:Class;
                                                  rdfs:comment "Descriptors other than junction names and road descriptors which can help to identify the location of points on the road network."@en;
                                                  rdfs:subClassOf dtx_srti:TpegEnumerations;
                                                  owl:equivalentClass [owl:oneOf (dtx_srti:administrativeAreaName
                                                                                  dtx_srti:administrativeReferenceName
                                                                                  dtx_srti:airportName
                                                                                  dtx_srti:areaName
                                                                                  dtx_srti:buildingName
                                                                                  dtx_srti:busStopIdentifier
                                                                                  dtx_srti:busStopName
                                                                                  dtx_srti:canalName
                                                                                  dtx_srti:countyName
                                                                                  dtx_srti:ferryPortName
                                                                                  dtx_srti:intersectionName
                                                                                  dtx_srti:lakeName
                                                                                  dtx_srti:linkName
                                                                                  dtx_srti:localLinkName
                                                                                  dtx_srti:metroStationName
                                                                                  dtx_srti:nationName
                                                                                  dtx_srti:nonLinkedPointName
                                                                                  dtx_srti:other
                                                                                  dtx_srti:parkingFacilityName
                                                                                  dtx_srti:pointName
                                                                                  dtx_srti:pointOfInterestName
                                                                                  dtx_srti:railwayStation
                                                                                  dtx_srti:regionName
                                                                                  dtx_srti:riverName
                                                                                  dtx_srti:seaName
                                                                                  dtx_srti:serviceAreaName
                                                                                  dtx_srti:tidalRiverName
                                                                                  dtx_srti:townName) ; 
                                                                       a owl:Class].
dtx_srti:TpegLoc04HeightTypeEnum a owl:Class;
                                 rdfs:comment "Types of height."@en;
                                 rdfs:subClassOf dtx_srti:TpegEnumerations;
                                 owl:equivalentClass [owl:oneOf (dtx_srti:aboveSeaLevelTPEGHeight
                                                                 dtx_srti:aboveStreetLevelTPEGHeight
                                                                 dtx_srti:aboveTPEGHeight
                                                                 dtx_srti:atSeaLevelTPEGHeight
                                                                 dtx_srti:atStreetLevelTPEGHeight
                                                                 dtx_srti:atTPEGHeight
                                                                 dtx_srti:belowSeaLevelTPEGHeight
                                                                 dtx_srti:belowStreetLevelTPEGHeight
                                                                 dtx_srti:belowTPEGHeight
                                                                 dtx_srti:other
                                                                 dtx_srti:undefinedTPEGHeight
                                                                 dtx_srti:unknown) ; 
                                                      a owl:Class].
dtx_srti:TpegNamedOnlyArea a owl:Class;
                           rdfs:comment "An area defined by a well-known name."@en;
                           rdfs:subClassOf [owl:someValuesFrom dtx_srti:TpegAreaDescriptor ; 
                                            owl:onProperty dtx_srti:hasTpegAreaDescriptor ; 
                                            a owl:Restriction],
                                           dtx_srti:TpegAreaLocation.
dtx_srti:TpegNonJunctionPoint a owl:Class;
                              rdfs:comment "A point on the road network which is not a road junction point."@en;
                              rdfs:subClassOf [owl:onClass dtx_srti:TpegOtherPointDescriptor ; 
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty dtx_srti:hasTpegOtherPointDescriptor ; 
                                               a owl:Restriction],
                                              dtx_srti:TpegPoint.
dtx_srti:TpegOtherPointDescriptor a owl:Class;
                                  rdfs:comment "General descriptor for describing a point."@en;
                                  rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc03OtherPointDescriptorSubtypeEnum ; 
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty dtx_srti:tpegOtherPointDescriptorType ; 
                                                   a owl:Restriction],
                                                  dtx_srti:TpegPointDescriptor.
dtx_srti:TpegPoint a owl:Class;
                   rdfs:comment "A point on the road network which is either a junction point or a non junction point."@en;
                   rdfs:subClassOf [owl:onClass dtx_srti:PointCoordinates ; 
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty dtx_srti:hasPointCoordinates ; 
                                    a owl:Restriction],
                                   dtx_srti:TpegLoc.
dtx_srti:TpegPointDescriptor a owl:Class;
                             rdfs:comment "A descriptor for describing a point location."@en;
                             rdfs:subClassOf dtx_srti:TpegDescriptor.
dtx_srti:TpegPointLocation a owl:Class;
                           rdfs:comment "A single point on the road network defined by a TPEG-Loc structure and which has an associated direction of traffic flow."@en;
                           rdfs:subClassOf [owl:onClass dtx_srti:DirectionEnum ; 
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty dtx_srti:tpegDirection ; 
                                            a owl:Restriction],
                                           dtx_srti:TpegLoc.
dtx_srti:TpegSimplePoint a owl:Class;
                         rdfs:comment "A point on the road network which is not bounded by any other points on the road network."@en;
                         rdfs:subClassOf [owl:onClass dtx_srti:TpegLoc01SimplePointLocationSubtypeEnum ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:tpegSimplePointLocationType ; 
                                          a owl:Restriction],
                                         [owl:onClass dtx_srti:TpegPoint ; 
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty dtx_srti:hasTpegPoint ; 
                                          a owl:Restriction],
                                         dtx_srti:TpegPointLocation.
dtx_srti:TrafficConstrictionTypeEnum a owl:Class;
                                     rdfs:comment "Types of constriction to which traffic is subjected as a result of an event."@en;
                                     rdfs:subClassOf dtx_srti:SituationEnumerations;
                                     owl:equivalentClass [owl:oneOf (dtx_srti:carriagewayBlocked
                                                                     dtx_srti:carriagewayPartiallyObstructed
                                                                     dtx_srti:lanesBlocked
                                                                     dtx_srti:lanesPartiallyObstructed
                                                                     dtx_srti:roadBlocked
                                                                     dtx_srti:roadPartiallyObstructed) ; 
                                                          a owl:Class].
dtx_srti:TrafficElement a owl:Class;
                        rdfs:comment "Traffic element."@es,
                                     "An event which is not planned by the traffic operator, which is affecting, or has the potential to affect traffic flow."@en;
                        rdfs:subClassOf [owl:onClass dtx_srti:TrafficConstrictionTypeEnum ; 
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty dtx_srti:hasTrafficConstrictionTypeEnum ; 
                                         a owl:Restriction],
                                        dtx_srti:SituationRecord.
dtx_srti:TrafficFlowCharateristicsEnum a owl:Class;
                                       rdfs:comment "The consistency (steadiness) of the traffic flow."@en;
                                       rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                       owl:equivalentClass [owl:oneOf (dtx_srti:erraticFlow
                                                                       dtx_srti:smoothFlow
                                                                       dtx_srti:stopAndGo
                                                                       dtx_srti:trafficBlocked) ; 
                                                            a owl:Class].
dtx_srti:TrafficTrendTypeEnum a owl:Class;
                              rdfs:comment "A characterization of the trend in the traffic conditions at the specified location and direction."@en;
                              rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                              owl:equivalentClass [owl:oneOf (dtx_srti:trafficBuildingUp
                                                              dtx_srti:trafficEasing
                                                              dtx_srti:trafficStable
                                                              dtx_srti:unknown) ; 
                                                   a owl:Class].
dtx_srti:TransitServiceInformationEnum a owl:Class;
                                       rdfs:comment "Types of public transport information."@en;
                                       rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                       owl:equivalentClass [owl:oneOf (dtx_srti:ferry) ; 
                                                            a owl:Class].
dtx_srti:Validity a owl:Class;
                  rdfs:comment "Specification of validity, either explicitly or by a validity time period specification which may be discontinuous."@en;
                  rdfs:subClassOf [owl:onClass dtx_srti:OverallPeriod ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:validityTimeSpecification ; 
                                   a owl:Restriction],
                                  [owl:onClass dtx_srti:ValidityStatusEnum ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtx_srti:hasValidityStatus ; 
                                   a owl:Restriction],
                                  dtx_srti:CommonClasses.
dtx_srti:ValidityStatusEnum a owl:Class;
                            rdfs:comment "Values of validity status that can be assigned to a described event, action or item"@en;
                            rdfs:subClassOf dtx_srti:PayLoadEnumerations;
                            owl:equivalentClass [owl:oneOf (dtx_srti:active
                                                            dtx_srti:definedByValidityTimeSpec
                                                            dtx_srti:planned
                                                            dtx_srti:suspended) ; 
                                                 a owl:Class].
dtx_srti:Vehicle a owl:Class;
                 rdfs:comment "Details of an individual vehicle."@es;
                 rdfs:subClassOf [owl:onClass dtx_srti:VehicleStatusEnum ; 
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty dtx_srti:hasVehicleStatus ; 
                                  a owl:Restriction],
                                 [owl:onClass dtx_srti:VehicleCharacteristics ; 
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty dtx_srti:hasVehicleCharacteristics ; 
                                  a owl:Restriction],
                                 dtx_srti:CommonClasses.
dtx_srti:VehicleCharacteristics a owl:Class;
                                rdfs:comment "The characteristics of a vehicle, e.g. lorry of gross weight greater than 30 tonnes."@en;
                                rdfs:subClassOf dtx_srti:CommonClasses.
dtx_srti:VehicleFlowValue a owl:Class;
                          rdfs:comment "A measured or calculated value of the flow rate of vehicles."@en;
                          rdfs:subClassOf [owl:onDataRange <http://datex2.eu/schema/3/Common/3_1#VehiclesPerHour> ; 
                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty dtx_srti:vehicleFlowRate ; 
                                           a owl:Restriction],
                                          dtx_srti:DataValue.
dtx_srti:VehicleObstruction a owl:Class;
                            rdfs:comment "An obstruction on the road caused by one or more vehicles."@en;
                            rdfs:subClassOf [owl:onClass dtx_srti:VehicleTypeEnum ; 
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasVehicleTypeEnum ; 
                                             a owl:Restriction],
                                            [owl:onClass dtx_srti:VehicleObstructionTypeEnum ; 
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                             owl:onProperty dtx_srti:hasVehicleObstructionTypeEnum ; 
                                             a owl:Restriction],
                                            dtx_srti:Obstruction.
dtx_srti:VehicleObstructionTypeEnum a owl:Class;
                                    rdfs:comment "Types of obstructions involving vehicles."@en;
                                    rdfs:subClassOf dtx_srti:SituationEnumerations;
                                    owl:equivalentClass [owl:oneOf (dtx_srti:abnormalLoad
                                                                    dtx_srti:brokenDownHeavyLorry
                                                                    dtx_srti:brokenDownVehicle
                                                                    dtx_srti:convoy
                                                                    dtx_srti:damagedVehicle
                                                                    dtx_srti:longLoad
                                                                    dtx_srti:militaryConvoy
                                                                    dtx_srti:slowVehicle
                                                                    dtx_srti:vehicleOnFire
                                                                    dtx_srti:vehicleOnWrongCarriageway
                                                                    dtx_srti:vehicleStuck
                                                                    dtx_srti:vehicleWithOverwideLoad) ; 
                                                         a owl:Class].
dtx_srti:VehicleStatusEnum a owl:Class;
                           rdfs:comment "The status of a vehicle."@en;
                           rdfs:subClassOf dtx_srti:PayLoadEnumerations;
                           owl:equivalentClass [owl:oneOf (dtx_srti:brokenDown
                                                           dtx_srti:burntOut
                                                           dtx_srti:damaged
                                                           dtx_srti:damagedAndImmobililized
                                                           dtx_srti:jacknifed
                                                           dtx_srti:onFire
                                                           dtx_srti:overturned
                                                           dtx_srti:spunAround) ; 
                                                a owl:Class].
dtx_srti:VehicleTypeEnum a owl:Class;
                         rdfs:comment "Types of vehicle."@en;
                         rdfs:subClassOf dtx_srti:PayLoadEnumerations;
                         owl:equivalentClass [owl:oneOf (dtx_srti:agriculturalVehicle
                                                         dtx_srti:anyVehicle
                                                         dtx_srti:articulatedVehicle
                                                         dtx_srti:bicycle
                                                         dtx_srti:bus
                                                         dtx_srti:car
                                                         dtx_srti:carOrLightVehicle
                                                         dtx_srti:carWithCaravan
                                                         dtx_srti:carWithTrailer
                                                         dtx_srti:caravan
                                                         dtx_srti:constructionOrMaintenanceVehicle
                                                         dtx_srti:fourWheelDrive
                                                         dtx_srti:highSidedVehicle
                                                         dtx_srti:longHeavyLorry
                                                         dtx_srti:lorry
                                                         dtx_srti:moped
                                                         dtx_srti:motorcycle
                                                         dtx_srti:motorcycleWithSideCar
                                                         dtx_srti:motorscooter
                                                         dtx_srti:other
                                                         dtx_srti:tanker
                                                         dtx_srti:threeWheeledVehicle
                                                         dtx_srti:trailer
                                                         dtx_srti:tram
                                                         dtx_srti:twoWheeledVehicle
                                                         dtx_srti:van
                                                         dtx_srti:vehicleWithCaravan
                                                         dtx_srti:vehicleWithCatalyticConverter
                                                         dtx_srti:vehicleWithTrailer
                                                         dtx_srti:vehicleWithoutCatalyticConverter
                                                         dtx_srti:withEvenNumberedRegistrationPlates
                                                         dtx_srti:withOddNumberedRegistrationPlates) ; 
                                              a owl:Class].
dtx_srti:WeatherRelatedRoadConditionType a owl:Class;
                                         rdfs:comment "Types of road surface conditions which are related to the weather."@en;
                                         rdfs:subClassOf dtx_srti:SituationEnumerations;
                                         owl:equivalentClass [owl:oneOf (dtx_srti:blackIce
                                                                         dtx_srti:ice
                                                                         dtx_srti:icyPatches
                                                                         dtx_srti:snowDrifts
                                                                         dtx_srti:surfaceWater) ; 
                                                              a owl:Class].
dtx_srti:WeatherRelatedRoadConditions a owl:Class;
                                      rdfs:comment "Road surface conditions that are related to the weather which may affect the driving conditions, such as ice, snow or water."@en;
                                      rdfs:subClassOf [owl:someValuesFrom dtx_srti:WeatherRelatedRoadConditionType ; 
                                                       owl:onProperty dtx_srti:hasWeatherRelatedRoadConditionTypeEnum ; 
                                                       a owl:Restriction],
                                                      [owl:complementOf dtx_srti:NonWeatherRelatedRoadConditions ; 
                                                       a owl:Class],
                                                      dtx_srti:RoadSurfaceConditions.
dtx_srti:WinterDrivingManagement a owl:Class;
                                 rdfs:comment "Winter driving management action that is instigated by the network/road operator."@en;
                                 rdfs:subClassOf dtx_srti:NetworkManagement.
dtx_srti:WinterEquipmentManagementTypeEnum a owl:Class;
                                           rdfs:comment "Type of winter equipment management action instigated by operator."@en;
                                           rdfs:subClassOf dtx_srti:Non-SRTI_Enum;
                                           owl:equivalentClass [owl:oneOf (dtx_srti:doNoUseStudTyres
                                                                           dtx_srti:other
                                                                           dtx_srti:useSnowChains
                                                                           dtx_srti:useSnowChainsOrTyres
                                                                           dtx_srti:useSnowTyres
                                                                           dtx_srti:winterEquipmentOnBoardRequired) ; 
                                                                a owl:Class].
