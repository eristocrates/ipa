<http://datex2.eu/schema/3/Common/3_1#DateTime> a rdfs:Datatype;
                                                rdfs:comment "A combination of integer-valued year, month, day, hour, minute properties, a decimal-valued second property and a time zone property from which it is possible to determine the local time, the equivalent UTC time and the time zone offset from UTC."@en;
                                                rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en.
<http://datex2.eu/schema/3/Common/3_1#GmlPosList> a rdfs:Datatype;
                                                  rdfs:comment "List of coordinates, space-separated, within the same coordinate reference system, defining a geometric entity. Modelled on DirectPositionListType in GML (EN ISO 19136), but constrained to represent a 2D or 3D polyline."@en;
                                                  rdfs:isDefinedBy "http://datex2.eu/schema/3/Common/3_1#"@en.
<http://datex2.eu/schema/3/Common/3_1#Language> a rdfs:Datatype;
