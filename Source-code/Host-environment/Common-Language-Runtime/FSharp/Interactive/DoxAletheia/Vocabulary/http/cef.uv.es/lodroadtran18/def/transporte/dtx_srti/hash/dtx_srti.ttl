wgspos:Point a owl:Class;
             rdfs:comment """A point, typically described using a coordinate system relative to Earth, such as WGS84.
  """,
                          """ 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  """;
             rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#";
             rdfs:label "point";
             rdfs:subClassOf wgspos:SpatialThing.
wgspos:SpatialThing a owl:Class;
                    rdfs:comment "Spatial thing"@en;
                    rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en;
                    rdfs:subClassOf dtx_srti:Geo_WGS84.
wgspos:lat a owl:DatatypeProperty;
           rdfs:comment "Latitude in WGS84"@en;
           rdfs:domain dtx_srti:PointCoordinates;
           rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en;
           rdfs:label "latitude"@en;
           rdfs:range xsd:float;
           rdfs:subPropertyOf dtx_srti:geo_WGS84.
wgspos:lon a owl:DatatypeProperty;
           rdfs:comment "Longitude in WGS84"@en;
           rdfs:domain dtx_srti:PointCoordinates;
           rdfs:isDefinedBy "http://www.w3.org/2003/01/geo/wgs84_pos#"@en;
           rdfs:label "longitude"@en;
           rdfs:range xsd:float;
           rdfs:subPropertyOf dtx_srti:geo_WGS84.
