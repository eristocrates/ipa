                    rdfs:domain dtx_srti:TpegDescriptor;
                    rdfs:range [owl:unionOf (<http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/administrativeUnit#AdministrativeUnit>
                                             <http://cef.uv.es/lodroadtran18/def/transporte/dtx_srti/roads#RoadNumber>) ; 
                                a owl:Class].
