                                  rdfs:domain dtx_srti:PointAlongLinearElement;
                                  rdfs:range dtx_srti:LinearDirectionEnum.
dtx_srti:directionRelativeOnLinearSection a owl:ObjectProperty;
                                          rdfs:comment "The direction of traffic flow on the linear section relative to the direction in which the linear element is defined."@en,
                                                       ""@en;
