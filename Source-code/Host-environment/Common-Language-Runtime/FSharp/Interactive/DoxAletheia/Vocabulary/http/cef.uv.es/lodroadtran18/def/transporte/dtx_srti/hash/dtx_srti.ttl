                 owl:NamedIndividual;
               rdfs:comment "Frost can be expected."@en.
dtx_srti:funfair a dtx_srti:PublicEventTypeEnum,
                   owl:NamedIndividual;
                 rdfs:comment "Periodic (e.g. annual), often traditional, gathering for entertainment, which could disrupt traffic."@en.
dtx_srti:fuzzyArea a dtx_srti:NamedAreaTypeEnum,
                     owl:NamedIndividual;
                   rdfs:comment "Fuzzy area"@en.
dtx_srti:gallery a dtx_srti:SubjectTypeOfWorksEnum,
