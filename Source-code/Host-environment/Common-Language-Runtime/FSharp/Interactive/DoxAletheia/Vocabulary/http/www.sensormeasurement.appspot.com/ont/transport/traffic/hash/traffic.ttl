traffic: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
         <http://purl.org/dc/elements/1.1/description> "A traffic ontology that describes the management of the traffic in a straight road with two lanes, both in the same direction. The situation is an ambulance trying to overtake all the other cars and they have to modify their speed and positions in order to able the ambulance to pass as fast as possible."@en;
         <http://purl.org/dc/elements/1.1/title> "Road Traffic Management"@en;
         <http://purl.org/dc/terms/creator> <mailto:jesusv@unavarra.es>,
                                            <mailto:alberto.cordoba@unavarra.es>,
                                            <mailto:antoniojesus.bermejo@unavarra.es>,
                                            <mailto:josej.astrain@unavarra.es>;
         <http://purl.org/dc/terms/issued> "2012-01-21"^^xsd:date;
         <http://purl.org/dc/terms/modified> "2012-09-07"^^xsd:date;
         <http://purl.org/dc/terms/source> <http://link.springer.com/chapter/10.1007%2F978-3-642-32524-3_14>;
         <http://purl.org/vocab/vann/preferredNamespacePrefix> "traffic";
         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://www.sensormeasurement.appspot.com/ont/transport/traffic#";
         a <http://www.w3.org/2002/07/owl#Ontology>,
           <http://www.w3.org/2002/07/owl#NamedIndividual>,
           <http://purl.org/vocommons/voaf#Vocabulary>;
         rdfs:comment " An ontology to describe the management of the traffic";
         <http://www.w3.org/2002/07/owl#versionInfo> 1.0;
         <http://www.w3.org/2004/02/skos/core#historyNote> "Ontology extracted from the paper Ontology Based Road Traffic Management. [Bermejo, A.J. et al. 2012] "@en.
traffic:Accelerate a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:subClassOf traffic:Action.
traffic:Action a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> traffic:Vehicle ; 
                                <http://www.w3.org/2002/07/owl#onProperty> traffic:isActionDoneBy ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               <http://www.w3.org/2002/07/owl#Thing>.
traffic:AfterGap a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:subClassOf traffic:Position.
traffic:Ahead a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf traffic:Space.
traffic:BeforeGap a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf traffic:Position.
traffic:Behind a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf traffic:Space.
traffic:Car1 traffic:beforeTheGap true;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker false;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap true;
             traffic:speedWithBeforeTheGapCar 2 ;
             a traffic:Vehicle,
               <http://www.w3.org/2002/07/owl#NamedIndividual>.
traffic:Car2 traffic:beforeTheGap false;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker true;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap true;
             traffic:speedWithBeforeTheGapCar 1 ;
             a traffic:Vehicle,
               <http://www.w3.org/2002/07/owl#NamedIndividual>.
traffic:Car3 traffic:beforeTheGap false;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker true;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap false;
             traffic:speedWithBeforeTheGapCar 3 ;
             a traffic:Vehicle,
               <http://www.w3.org/2002/07/owl#NamedIndividual>.
traffic:Car4 traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker false;
             traffic:isOvertaking true;
             traffic:speedWithBeforeTheGapCar 3 ;
             a <http://www.w3.org/2002/07/owl#NamedIndividual>,
               traffic:Vehicle.
traffic:ChangeLine a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:subClassOf traffic:Action.
traffic:Decelerate a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:subClassOf traffic:Action.
traffic:FirstAfterGap a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf traffic:Position.
traffic:LastBeforeGap a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf traffic:Position.
traffic:Lateral a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf traffic:Space.
traffic:MaintainDistanceWithCarInFront a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:subClassOf traffic:Action.
traffic:MaintainSpeed a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:subClassOf traffic:Action.
traffic:NoSpace a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf traffic:Space.
traffic:NotOvertaker a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:subClassOf traffic:Vehicle.
traffic:Overtaker a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:subClassOf traffic:Vehicle.
traffic:Position a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:subClassOf traffic:Vehicle.
traffic:SoftAccelerate a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf traffic:Action.
traffic:SoftDecelerate a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf traffic:Action.
traffic:Space a <http://www.w3.org/2002/07/owl#Class>.
traffic:Vehicle a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> traffic:doesAction ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
traffic:beforeTheGap a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain traffic:Vehicle;
                     rdfs:range xsd:boolean;
                     rdfs:subPropertyOf traffic:position.
traffic:bigSpeedDifference a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range xsd:boolean;
                           rdfs:subPropertyOf traffic:speedWith.
traffic:c a <http://www.w3.org/2003/11/swrl#Variable>.
traffic:doesAction a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                     <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                   rdfs:domain traffic:Vehicle.
traffic:hasDirectionValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                            <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                          rdfs:range rdfs:Literal;
                          rdfs:subPropertyOf traffic:movement.
traffic:hasSpace a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
traffic:hasSpaceAhead a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                        <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain traffic:Vehicle;
                      rdfs:range xsd:boolean;
                      rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpaceBehind a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                         <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:domain traffic:Vehicle;
                       rdfs:range xsd:boolean;
                       rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpaceLateral a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:domain traffic:Vehicle;
                        rdfs:range xsd:boolean;
                        rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpeedValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:range xsd:nonNegativeInteger;
                      rdfs:subPropertyOf traffic:movement.
traffic:hasXValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:range xsd:integer;
                  rdfs:subPropertyOf traffic:position.
traffic:hasYValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                  rdfs:range xsd:integer;
                  rdfs:subPropertyOf traffic:position.
traffic:isActionDoneBy a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#AsymmetricProperty>,
                         <http://www.w3.org/2002/07/owl#InverseFunctionalProperty>,
                         <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
                       rdfs:range traffic:Vehicle;
                       <http://www.w3.org/2002/07/owl#inverseOf> traffic:doesAction.
traffic:isInFrontOfOvertaker a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:domain traffic:Vehicle;
                             rdfs:range xsd:boolean;
                             rdfs:subPropertyOf traffic:position.
traffic:isOvertaking a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain traffic:Vehicle;
                     rdfs:range xsd:boolean;
                     rdfs:subPropertyOf traffic:position.
traffic:lastFirstBeforeAfter-TheGap a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                      <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                    rdfs:domain traffic:Vehicle;
                                    rdfs:range xsd:boolean;
                                    rdfs:subPropertyOf traffic:position.
traffic:movement a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
traffic:position a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
traffic:speedWith a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
traffic:speedWithAheadCar a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:domain traffic:Vehicle;
                          rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                      a rdfs:Datatype];
                          rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithBeforeTheGapCar a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:domain traffic:Vehicle;
                                 rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                             a rdfs:Datatype];
                                 rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithBehindCar a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> () ; 
                                       a rdfs:Datatype];
                           rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithOvertaker a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> () ; 
