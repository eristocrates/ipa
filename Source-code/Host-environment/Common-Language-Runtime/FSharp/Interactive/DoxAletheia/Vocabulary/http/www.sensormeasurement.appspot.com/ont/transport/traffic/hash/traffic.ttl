<http://purl.org/vocommons/voaf> a owl:NamedIndividual,
                                   voaf:Vocabulary.
voaf:Vocabulary a owl:Class.
voaf:VocabularySpace a owl:Class;
                     rdfs:comment """Dublin Core properties isPartOf and hasPart are used to link a vocabulary to a 
vocabulary space""",
                                  """A vocabulary space defines any relevant grouping of vocabularies 
e.g., designed for similar purposes or domains, or designed by the same publisher or the same project, etc.
    A vocabulary can belong to zero, one or more vocabulary spaces."""@en;
                     rdfs:isDefinedBy voaf:;
                     rdfs:label "Vocabulary Space"@en.
traffic: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
         dc11:description "A traffic ontology that describes the management of the traffic in a straight road with two lanes, both in the same direction. The situation is an ambulance trying to overtake all the other cars and they have to modify their speed and positions in order to able the ambulance to pass as fast as possible."@en;
         dc11:title "Road Traffic Management"@en;
         dcterms:creator <mailto:jesusv@unavarra.es>,
                         <mailto:alberto.cordoba@unavarra.es>,
                         <mailto:antoniojesus.bermejo@unavarra.es>,
                         <mailto:josej.astrain@unavarra.es>;
         dcterms:issued "2012-01-21"^^xsd:date;
         dcterms:modified "2012-09-07"^^xsd:date;
         dcterms:source <http://link.springer.com/chapter/10.1007%2F978-3-642-32524-3_14>;
         vann:preferredNamespacePrefix "traffic";
         vann:preferredNamespaceUri "http://www.sensormeasurement.appspot.com/ont/transport/traffic#";
         a owl:Ontology,
           owl:NamedIndividual,
           voaf:Vocabulary;
         rdfs:comment " An ontology to describe the management of the traffic";
         owl:versionInfo 1.0;
         skos:historyNote "Ontology extracted from the paper Ontology Based Road Traffic Management. [Bermejo, A.J. et al. 2012] "@en.
traffic:Accelerate a owl:Class;
                   rdfs:subClassOf traffic:Action.
traffic:Action a owl:Class;
               rdfs:subClassOf [owl:someValuesFrom traffic:Vehicle ; 
                                owl:onProperty traffic:isActionDoneBy ; 
                                a owl:Restriction],
                               owl:Thing.
traffic:AfterGap a owl:Class;
                 rdfs:subClassOf traffic:Position.
traffic:Ahead a owl:Class;
              rdfs:subClassOf traffic:Space.
traffic:BeforeGap a owl:Class;
                  rdfs:subClassOf traffic:Position.
traffic:Behind a owl:Class;
               rdfs:subClassOf traffic:Space.
traffic:Car1 traffic:beforeTheGap true;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker false;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap true;
             traffic:speedWithBeforeTheGapCar 2 ;
             a traffic:Vehicle,
               owl:NamedIndividual.
traffic:Car2 traffic:beforeTheGap false;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker true;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap true;
             traffic:speedWithBeforeTheGapCar 1 ;
             a traffic:Vehicle,
               owl:NamedIndividual.
traffic:Car3 traffic:beforeTheGap false;
             traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker true;
             traffic:isOvertaking false;
             traffic:lastFirstBeforeAfter-TheGap false;
             traffic:speedWithBeforeTheGapCar 3 ;
             a traffic:Vehicle,
               owl:NamedIndividual.
traffic:Car4 traffic:bigSpeedDifference false;
             traffic:hasSpaceAhead true;
             traffic:hasSpaceBehind false;
             traffic:hasSpaceLateral false;
             traffic:isInFrontOfOvertaker false;
             traffic:isOvertaking true;
             traffic:speedWithBeforeTheGapCar 3 ;
             a owl:NamedIndividual,
               traffic:Vehicle.
traffic:ChangeLine a owl:Class;
                   rdfs:subClassOf traffic:Action.
traffic:Decelerate a owl:Class;
                   rdfs:subClassOf traffic:Action.
traffic:FirstAfterGap a owl:Class;
                      rdfs:subClassOf traffic:Position.
traffic:LastBeforeGap a owl:Class;
                      rdfs:subClassOf traffic:Position.
traffic:Lateral a owl:Class;
                rdfs:subClassOf traffic:Space.
traffic:MaintainDistanceWithCarInFront a owl:Class;
                                       rdfs:subClassOf traffic:Action.
traffic:MaintainSpeed a owl:Class;
                      rdfs:subClassOf traffic:Action.
traffic:NoSpace a owl:Class;
                rdfs:subClassOf traffic:Space.
traffic:NotOvertaker a owl:Class;
                     rdfs:subClassOf traffic:Vehicle.
traffic:Overtaker a owl:Class;
                  rdfs:subClassOf traffic:Vehicle.
traffic:Position a owl:Class;
                 rdfs:subClassOf traffic:Vehicle.
traffic:SoftAccelerate a owl:Class;
                       rdfs:subClassOf traffic:Action.
traffic:SoftDecelerate a owl:Class;
                       rdfs:subClassOf traffic:Action.
traffic:Space a owl:Class.
traffic:Vehicle a owl:Class;
                rdfs:subClassOf [owl:onProperty traffic:doesAction ; 
                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 a owl:Restriction].
traffic:beforeTheGap a owl:AnnotationProperty,
                       owl:DatatypeProperty;
                     rdfs:domain traffic:Vehicle;
                     rdfs:range xsd:boolean;
                     rdfs:subPropertyOf traffic:position.
traffic:bigSpeedDifference a owl:AnnotationProperty,
                             owl:DatatypeProperty;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range xsd:boolean;
                           rdfs:subPropertyOf traffic:speedWith.
traffic:c a swrl:Variable.
traffic:doesAction a owl:ObjectProperty,
                     owl:AsymmetricProperty,
                     owl:FunctionalProperty,
                     owl:IrreflexiveProperty;
                   rdfs:domain traffic:Vehicle.
traffic:hasDirectionValue a owl:DatatypeProperty,
                            owl:FunctionalProperty;
                          rdfs:range rdfs:Literal;
                          rdfs:subPropertyOf traffic:movement.
traffic:hasSpace a owl:DatatypeProperty.
traffic:hasSpaceAhead a owl:AnnotationProperty,
                        owl:DatatypeProperty;
                      rdfs:domain traffic:Vehicle;
                      rdfs:range xsd:boolean;
                      rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpaceBehind a owl:AnnotationProperty,
                         owl:DatatypeProperty;
                       rdfs:domain traffic:Vehicle;
                       rdfs:range xsd:boolean;
                       rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpaceLateral a owl:AnnotationProperty,
                          owl:DatatypeProperty;
                        rdfs:domain traffic:Vehicle;
                        rdfs:range xsd:boolean;
                        rdfs:subPropertyOf traffic:hasSpace.
traffic:hasSpeedValue a owl:DatatypeProperty,
                        owl:FunctionalProperty;
                      rdfs:range xsd:nonNegativeInteger;
                      rdfs:subPropertyOf traffic:movement.
traffic:hasXValue a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:range xsd:integer;
                  rdfs:subPropertyOf traffic:position.
traffic:hasYValue a owl:DatatypeProperty,
                    owl:FunctionalProperty;
                  rdfs:range xsd:integer;
                  rdfs:subPropertyOf traffic:position.
traffic:isActionDoneBy a owl:ObjectProperty,
                         owl:AsymmetricProperty,
                         owl:InverseFunctionalProperty,
                         owl:IrreflexiveProperty;
                       rdfs:range traffic:Vehicle;
                       owl:inverseOf traffic:doesAction.
traffic:isInFrontOfOvertaker a owl:AnnotationProperty,
                               owl:DatatypeProperty;
                             rdfs:domain traffic:Vehicle;
                             rdfs:range xsd:boolean;
                             rdfs:subPropertyOf traffic:position.
traffic:isOvertaking a owl:AnnotationProperty,
                       owl:DatatypeProperty;
                     rdfs:domain traffic:Vehicle;
                     rdfs:range xsd:boolean;
                     rdfs:subPropertyOf traffic:position.
traffic:lastFirstBeforeAfter-TheGap a owl:AnnotationProperty,
                                      owl:DatatypeProperty;
                                    rdfs:domain traffic:Vehicle;
                                    rdfs:range xsd:boolean;
                                    rdfs:subPropertyOf traffic:position.
traffic:movement a owl:DatatypeProperty.
traffic:position a owl:DatatypeProperty.
traffic:speedWith a owl:DatatypeProperty.
traffic:speedWithAheadCar a owl:DatatypeProperty;
                          rdfs:domain traffic:Vehicle;
                          rdfs:range [owl:oneOf () ; 
                                      a rdfs:Datatype];
                          rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithBeforeTheGapCar a owl:AnnotationProperty,
                                   owl:DatatypeProperty;
                                 rdfs:domain traffic:Vehicle;
                                 rdfs:range [owl:oneOf () ; 
                                             a rdfs:Datatype];
                                 rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithBehindCar a owl:DatatypeProperty;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range [owl:oneOf () ; 
                                       a rdfs:Datatype];
                           rdfs:subPropertyOf traffic:speedWith.
traffic:speedWithOvertaker a owl:DatatypeProperty;
                           rdfs:domain traffic:Vehicle;
                           rdfs:range [owl:oneOf () ; 
                                       a rdfs:Datatype];
                           rdfs:subPropertyOf traffic:speedWith.
<http://www.traffic.com/ontologies/a.owl#hasSpaceAhead> a owl:AnnotationProperty.
<http://www.traffic.com/ontologies/a.owl#hasSpaceBehind> a owl:AnnotationProperty.
<http://www.traffic.com/ontologies/a.owl#hasSpaceLateral> a owl:AnnotationProperty.
<http://www.traffic.com/ontologies/a.owl#isInFrontOfOvertaker> a owl:AnnotationProperty.
<http://www.traffic.com/ontologies/a.owl#isOvertaking> a owl:AnnotationProperty.
<http://www.unavarra.es/> a owl:NamedIndividual,
                            foaf:Organization.
<http://www.unavarra.es/foaf/unavarra.rdf#A.Cordoba> a owl:NamedIndividual,
                                                       foaf:Person.
<http://www.unavarra.es/foaf/unavarra.rdf#A.J.Bermejo> a owl:NamedIndividual,
                                                         foaf:Person.
<http://www.unavarra.es/foaf/unavarra.rdf#J.J.Astrain> a owl:NamedIndividual,
                                                         foaf:Person.
<http://www.unavarra.es/foaf/unavarra.rdf#J.Villadangos> a owl:NamedIndividual,
                                                           foaf:Person.
<http://www.w3org/2003/06/sw-vocab-status/ns#term_status> a owl:AnnotationProperty.
foaf:Organization a owl:Class.
foaf:Person a owl:Class.
foaf:name a owl:AnnotationProperty.
