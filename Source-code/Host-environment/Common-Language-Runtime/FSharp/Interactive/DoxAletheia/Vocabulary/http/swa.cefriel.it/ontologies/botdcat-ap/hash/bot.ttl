@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix bot: <http://swa.cefriel.it/ontologies/botdcat-ap#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.

<http://swa.cefriel.it/ontologies/botdcat-ap> ccrel:license <http://creativecommons.org/licenses/by/4.0/>;
                                              dcterms:contributor "Paolo Cappello",
                                                                  "Irene Celino",
                                                                  "Marco Comerio";
                                              dcterms:creator "Irene Celino",
                                                              "Paolo Cappello",
                                                              "Marco Comerio";
                                              dcterms:date "2017-04-01"^^xsd:date;
                                              dcterms:description "A vocabulary to describe data sources in a way they can be easily reused and accessed by chatbots."@en;
                                              dcterms:issued "2017-04-01"^^xsd:date;
                                              dcterms:modified "2017-04-01"^^xsd:date;
                                              dcterms:publisher <http://www.cefriel.com/>;
                                              dcterms:rights "Copyright © 2017 Cefriel";
                                              dcterms:title "BotDCAT-AP - Data Catalogue vocabulary Application Profile for chatbots"@en;
                                              vann:preferredNamespacePrefix "bot";
                                              vann:preferredNamespaceUri "http://swa.cefriel.it/ontologies/botdcat-ap#";
                                              a owl:Ontology,
                                                voaf:Vocabulary;
                                              rdfs:comment "A vocabulary to describe data sources in a way they can be easily reused and accessed by chatbots."@en;
                                              owl:imports <https://www.w3.org/ns/dcat>,
                                                          <https://joinup.ec.europa.eu/site/core_vocabularies/registry/dcat-ap/DCAT-AP_v1.1.rdf>;
                                              owl:versionInfo 1.0.
bot:EntitiesCatalog vann:usageNote "Optional class. Represents a list of all the entities that can be associated to an Intent."@en;
                    a owl:Class;
                    rdfs:comment "Optional class. Represents a list of all the entities that can be associated to an Intent."@en;
                    rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                    rdfs:label "Entities Catalog"@en;
                    rdfs:subClassOf owl:Thing.
bot:Intent vann:usageNote "Mandatory class. An Intent exposed by the Dataset."@en;
           a owl:Class;
           rdfs:comment "Mandatory class. An Intent exposed by the Dataset."@en;
           rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
           rdfs:label "Intent"@en;
           rdfs:subClassOf owl:Thing.
bot:hasAssetURL vann:usageNote "Optional property. Cardinality [0..1]. This property contains the access URL provided by a SPARQL endpoint handling the Intent."@en;
                a owl:ObjectProperty;
                rdfs:comment "Optional property. Cardinality [0..1]. This property contains the access URL provided by a SPARQL endpoint handling the Intent."@en;
                rdfs:domain bot:Intent;
                rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                rdfs:label "has Asset URL"@en;
                rdfs:range rdfs:Resource.
bot:hasDocumentation vann:usageNote "Recommended property. Cardinality [0..1]. This property refers to a Resource containg information about an Intent."@en;
                     a owl:ObjectProperty;
                     rdfs:comment "Recommended property. Cardinality [0..1]. This property refers to a Resource containg information about an Intent."@en;
                     rdfs:domain bot:Intent;
                     rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                     rdfs:label "has Documentation"@en;
                     rdfs:range rdfs:Resource.
bot:hasEntitiesList vann:usageNote "Optional property. Cardinality [0..n]. This property refers to an Entities Catalog describing the entities connected to an Intent."@en;
                    a owl:ObjectProperty;
                    rdfs:comment "Optional property. Cardinality [0..n]. This property refers to an Entities Catalog connected to an Intent."@en;
                    rdfs:domain bot:Intent;
                    rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                    rdfs:label "has Entities List"@en;
                    rdfs:range bot:EntitiesCatalog.
bot:hasEntity vann:usageNote "Optional property. Cardinality [0..n]. This property refers to an entity. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
              a owl:ObjectProperty;
              rdfs:comment "Optional property. Cardinality [0..n]. This property refers to an entity. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
              rdfs:domain bot:EntitiesCatalog;
              rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
              rdfs:label "has Entity"@en;
              rdfs:range owl:Class.
bot:hasEntityConcept vann:usageNote "Optional property. Cardinality [0..n]. This property refers to an entity specified as a Concept. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
                     a owl:ObjectProperty;
                     rdfs:comment "Optional property. Cardinality [0..n]. This property refers to an entity specified as a Concept. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
                     rdfs:domain bot:EntitiesCatalog;
                     rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                     rdfs:label "has Entity Concept"@en;
                     rdfs:range skos:Concept.
bot:hasEntityDataset vann:usageNote "Optional property. Cardinality [0..n]. This property refers to a Dataset containing all the istances of an entity. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
                     a owl:ObjectProperty;
                     rdfs:comment "Optional property. Cardinality [0..n]. This property refers to a Dataset containing all the istances of an entity. Note that only one of bot:hasEntity, bot:hasEntityConcept and bot:hasEntityCatalog property for each entity must be used."@en;
                     rdfs:domain bot:EntitiesCatalog;
                     rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                     rdfs:label "has Entity Dataset"@en;
                     rdfs:range aerdcat:Dataset.
bot:hasIntent vann:usageNote "Mandatory property. Cardinality [1..n]. This property refers to an Intent handled by the Dataset."@en;
              a owl:ObjectProperty;
              rdfs:comment "Mandatory property. Cardinality [1..n]. This property refers to an Intent handled by the Dataset."@en;
              rdfs:domain aerdcat:Dataset;
              rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
              rdfs:label "has Intent"@en;
              rdfs:range bot:Intent.
bot:hasMethodURL vann:usageNote "Optional property. Cardinality [0..1]. This property contains the access URL provided by an API service handling the Intent."@en;
                 a owl:ObjectProperty;
                 rdfs:comment "Optional property. Cardinality [0..1]. This property contains the access URL provided by an API service handling the Intent."@en;
                 rdfs:domain bot:Intent;
                 rdfs:isDefinedBy <http://swa.cefriel.it/ontologies/botdcat-ap>;
                 rdfs:label "has Method URL"@en;
                 rdfs:range rdfs:Resource.
