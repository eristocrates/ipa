                                    <http://purl.org/dc/elements/1.1/date> "2005-03-11"^^xsd:date;
                                    <http://purl.org/dc/elements/1.1/description> "OWL Full vocabulary for defining lenses and formats on RDF models.";
                                    <http://purl.org/dc/elements/1.1/format> "RDF";
                                    <http://purl.org/dc/elements/1.1/identifier> fresnel:;
                                    <http://purl.org/dc/elements/1.1/title> "Fresnel Lens and Format Core Vocabulary";
