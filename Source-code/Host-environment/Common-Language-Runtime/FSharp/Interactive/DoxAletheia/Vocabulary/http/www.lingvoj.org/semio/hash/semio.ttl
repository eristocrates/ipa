@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix semio: <http://www.lingvoj.org/semio#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.

<http://labs.mondeca.com/vocab/mondeca.rdf#bvatant> a foaf:Person;
                                                    foaf:name "Bernard Vatant".
semio:Code a owl:Class;
           rdfs:comment "A string of characters, generally intended to be a unique identifier in some context"@en;
           rdfs:label "Code"@en;
           rdfs:subClassOf semio:DataSign.
semio:Context a owl:Class;
              rdfs:comment "A resource describing the context. May gather any relevant piece of information: linguistic system context, space-time restrictions, information system, community of users ... "@en;
              rdfs:label "Context"@en.
semio:DataSign a owl:Class;
               rdfs:comment "A sign of which signifier is defined as the value of the Datatype Property 'signifierData'"@en;
               rdfs:label "Data Sign"@en;
               rdfs:subClassOf semio:Sign;
               owl:equivalentClass [owl:onProperty semio:signifierData ; 
                                    owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction].
semio:Icon a owl:Class;
           rdfs:comment "An image which is a symbolic representation of something. Flags, logos, coat of arms ..."@en;
           rdfs:label "Icon"@en;
           rdfs:subClassOf semio:Image.
semio:Image a owl:Class;
            rdfs:comment "Any image used as a sign. Either by direct denotation (a photograph of a cat for the concept of cat), or symbolic conotation (icons)."@en;
            rdfs:label "Image"@en;
            rdfs:subClassOf semio:ObjectSign,
                            foaf:Image.
semio:Multimedia a owl:Class;
                 rdfs:comment "For example a video representation"@en;
                 rdfs:label "Multimedia"@en;
                 rdfs:subClassOf semio:ObjectSign.
semio:ObjectSign a owl:Class;
                 rdfs:comment "A sign of which signifier is defined as the value of the Object Property 'signifierObject'"@en;
                 rdfs:label "Object Sign"@en;
                 rdfs:subClassOf semio:Sign;
                 owl:equivalentClass [owl:onProperty semio:signifierObject ; 
                                      owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                      a owl:Restriction].
semio:Phrase a owl:Class;
             rdfs:comment "A string making sense in some natural language. Typically a term from a vocabulary. Other exemples include assertions, slogans, taglines ..."@en;
             rdfs:label "Phrase"@en;
             rdfs:subClassOf semio:DataSign.
semio:Sign a owl:Class;
           rdfs:comment "A sign has exactly one signifier, either 'signifier data' or 'signifier resource' attribute"@en,
                        "A sign is an information resource. As such, it can be useful to attach metadata using Dublin Core attributes such as creator, creation date etc ..."@en,
                        "Something that stands for something else in a given context. A sign has a signifier (physical data which can be communicated), a signified (a concept, or formal representation), both indicating a referent, which is outside the language scope, and a context in which the signification is asserted."@en;
           rdfs:label "Sign"@en.
semio:Sound a owl:Class;
            rdfs:comment "Typically, the sound rendering of a phrase"@en;
            rdfs:label "Sound"@en;
            rdfs:subClassOf semio:ObjectSign.
semio:UF a owl:ObjectProperty;
         rdfs:comment "Links to an alternative, non-preferred sign for the same signified"@en,
                      "Use this property for signs defined in the same context"@en;
         rdfs:domain semio:Sign;
         rdfs:label "used for"@en;
         rdfs:range semio:Sign.
semio:URI a owl:Class;
          rdfs:comment "A URI is a code used in the context of the Web"@en;
          rdfs:label "Uniform Resource Identifier"@en;
          rdfs:subClassOf semio:Code.
semio:USE a owl:FunctionalProperty,
            owl:ObjectProperty;
          rdfs:comment "Links to a preferred sign for the same signified"@en,
                       "Use this property for signs defined in the same context"@en;
          rdfs:domain semio:Sign;
          rdfs:label "use"@en;
          rdfs:range semio:Sign;
          owl:inverseOf semio:UF.
semio:coreferentWith a owl:ObjectProperty,
                       owl:SymmetricProperty;
                     rdfs:comment "Links two signs considered as having the same referent, even if they have different signifiers. Useful to link different and possibly inconsistent views of the referent."@en,
                                  "Use this property for signs defined in different contexts"@en;
                     rdfs:domain semio:Sign;
                     rdfs:label "coreference"@en;
                     rdfs:range semio:Sign.
semio:significationContext a owl:ObjectProperty;
                           rdfs:comment "A resource defining the signification context, in the scope of which the signifier-signified association is asserted as valid."@en,
                                        "Typically, the context ressource should be constructed as a blank node"@en;
                           rdfs:domain semio:Sign;
                           rdfs:label "signification context"@en;
                           rdfs:range semio:Context.
semio:signified a owl:FunctionalProperty,
                  owl:ObjectProperty;
                rdfs:comment "The resource for which the sign stands for"@en;
                rdfs:domain semio:Sign;
                rdfs:label "signified"@en.
semio:signifierData a owl:DatatypeProperty;
                    rdfs:comment "A data which is the signifier, such as a word, code or any kind of identifier. URI strings can be used as signifiers. In such a case, the default signified is the resource identified by the URI."@en;
                    rdfs:domain semio:DataSign;
                    rdfs:label "signifier data"@en.
semio:signifierObject a owl:ObjectProperty;
                      rdfs:comment "A resource which is the signifier. Typical examples include images or icons, or sound tracks for natural language words."@en;
                      rdfs:domain semio:ObjectSign;
                      rdfs:label "signifier object"@en.
semio:transcription a owl:ObjectProperty,
                      owl:SymmetricProperty;
                    rdfs:comment "A transcription links two signs with the same signified in different formats or supports. For example a phrase to its sound rendering, or a trade mark to a logo."@en,
                                 "Translation is considered as a particular case of transcription (debatable)"@en;
                    rdfs:domain semio:Sign;
                    rdfs:label "transcription"@en;
                    rdfs:range semio:Sign.
semio:translation a owl:ObjectProperty;
                  rdfs:domain semio:Phrase;
                  rdfs:label "translation"@en;
                  rdfs:range semio:Phrase;
                  rdfs:subPropertyOf semio:transcription.
<http://www.lingvoj.org/semio.rdf> dcterms:creator <http://labs.mondeca.com/vocab/mondeca.rdf#bvatant>;
                                   dcterms:description "An ontology of signs"@en;
                                   dcterms:modified "2012-02-20";
                                   dcterms:title "SEMIO Ontology"@en;
                                   a owl:Ontology,
                                     <http://labs.mondeca.com/vocab/voaf#Vocabulary>;
                                   rdfs:comment "This is a very preliminary draft. Use cases for such an ontology are not  clear."@en.
rdfs:comment a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
