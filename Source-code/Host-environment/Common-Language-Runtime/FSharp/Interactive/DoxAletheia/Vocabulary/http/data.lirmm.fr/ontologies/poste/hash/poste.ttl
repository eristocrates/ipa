@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix poste: <http://data.lirmm.fr/ontologies/poste#>.

<http://data.lirmm.fr/ontologies/poste> <http://purl.org/dc/elements/1.1/creator> poste:ghislain;
                                        <http://purl.org/dc/elements/1.1/license> "http://creativecommons.org/licenses/by-sa/3.0/";
                                        <http://purl.org/dc/terms/created> "2012-09-28"^^xsd:date;
                                        <http://purl.org/dc/terms/description> "Vocabulaire décrivant la répartition des points de contact du réseau postal en France métropolitaine, Guadeloupe, Guyane, La Réunion, Martinique, Mayotte, Monaco, Monte-Carlo et Saint-Pierre et Miquelon.";
                                        <http://purl.org/dc/terms/modified> "2014-05-21"^^xsd:date;
                                        <http://purl.org/dc/terms/partOf> <http://data.lirmm.fr/ontologies>;
                                        <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                                        <http://purl.org/dc/terms/title> "Ontologie de la Poste";
                                        <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                                        <http://purl.org/vocab/vann/preferredNamespacePrefix> "poste";
                                        <http://purl.org/vocab/vann/preferredNamespaceUri> "http://data.lirmm.fr/ontologies/poste#";
                                        a <http://www.w3.org/2002/07/owl#Ontology>,
                                          <http://www.w3.org/ns/adms#SemanticAsset>;
                                        <http://xmlns.com/foaf/0.1/homepage> <http://data.lirmm.fr/ontologies/poste.html>.
poste: <http://purl.org/dc/terms/created> "2012-09-25"^^xsd:date;
       <http://purl.org/dc/terms/creator> <http://www.eurecom.fr/~atemezin>,
                                          <http://data.semanticweb.org/person/raphael-troncy>;
       <http://purl.org/dc/terms/license> <http://www.opendatacommons.org/licenses/pddl/1.0/>;
       <http://purl.org/dc/terms/modified> "2013-05-25"^^xsd:date,
                                           "2013-02-03"^^xsd:date,
                                           "2012-09-26"^^xsd:date,
                                           "2013-05-02"^^xsd:date,
                                           "2012-09-28"^^xsd:date,
                                           "2012-09-27"^^xsd:date;
       <http://purl.org/dc/terms/publisher> <http://data.semanticweb.org/organization/eurecom>;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:comment "Vocabulaire décrivant la répartition des points de contact du réseau postal en France métropolitaine, Guadeloupe, Guyane, La Réunion, Martinique, Mayotte, Monaco, Monte-Carlo et Saint-Pierre et Miquelon"@fr;
       rdfs:label "Ontologie de la Poste"@fr;
       rdfs:seeAlso <http://www.data.gouv.fr/var/download/fbd8ad620e37a6cf8165e5619a687ccd.pdf>,
                    <http://www.data.gouv.fr/donnees/view/Liste-des-points-de-contact-du-réseau-postal-français-551640?xtmc=paris&xtcr=7>,
                    <http://data.lirmm.fr/ontologies/poste.html>;
       <http://www.w3.org/2002/07/owl#versionInfo> "0.3".
poste:AgencePostaleCommunale a rdfs:Class,
                               <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Site représentant une agence communale";
                             rdfs:label "Agence postale communale";
                             rdfs:subClassOf poste:PosteOrganisation.
poste:BureauPoste a rdfs:Class,
                    <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Site représentant un bureau de poste";
                  rdfs:label "Bureau de poste";
                  rdfs:subClassOf poste:PosteOrganisation.
poste:PosteOrganisation a rdfs:Class,
                          <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Organisation de la poste en France";
                        rdfs:label "Organisation de la poste".
poste:RelaisCommercant a rdfs:Class,
                         <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Site représentant un relais poste commerçant";
                       rdfs:label "Relais commerçant";
                       rdfs:subClassOf poste:PosteOrganisation.
poste:affranchissementLibreService a rdf:Property;
                                   rdfs:comment "Présence ou non d'un automate d'affranchissement libre service.";
                                   rdfs:domain poste:PosteOrganisation;
                                   rdfs:label "Affranchissement libre service".
poste:changeurMonnaie a rdf:Property;
                      rdfs:comment "changeur de monnaie";
                      rdfs:domain poste:PosteOrganisation;
                      rdfs:label "changeur monnaie".
poste:codePostal a rdf:Property;
                 rdfs:comment "code postal du point de contact";
                 rdfs:domain poste:PosteOrganisation;
                 rdfs:label "Code postal".
poste:complementAdresse a rdf:Property;
                        rdfs:comment "Indication de precisant la structure d'accueil de l'agence, MAIRIE, HOTEL, TABAC";
                        rdfs:domain poste:PosteOrganisation;
                        rdfs:label "Complement Adresse".
poste:distributeur a rdf:Property;
                   rdfs:comment "Présence ou non d'un distributeur automatique de billets (DAB).";
                   rdfs:domain poste:PosteOrganisation;
                   rdfs:label "Distributeur de billets automatique".
poste:ghislain a <http://xmlns.com/foaf/0.1/Person>;
               <http://xmlns.com/foaf/0.1/homepage> <http://data.lirmm.fr/ontologies/poste>;
               <http://xmlns.com/foaf/0.1/nick> "ghislain".
poste:monnaieParis a rdf:Property;
                   rdfs:domain poste:PosteOrganisation;
                   rdfs:label "Monnaie Paris".
poste:photocopieur a rdf:Property;
                   rdfs:comment "Présence ou non d'un photocopieur accessible au public.";
                   rdfs:domain poste:PosteOrganisation;
                   rdfs:label "Photocopieur".
poste:rdf <http://purl.org/dc/terms/FileFormat> <http://data.lirmm.fr/ontologies/poste>;
          <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-sa/3.0/>;
          a <http://www.w3.org/ns/adms#SemanticDistribution>;
          <http://www.w3.org/ns/adms#accessURL> "http://data.lirmm.fr/ontologies/poste.rdf";
          <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
poste:rechargeMoneo a rdf:Property;
                    rdfs:comment "Présence ou non de chargeurs de monnaie. Ils permettent aux clients de s'approvisionner en monnaie.";
                    rdfs:domain poste:PosteOrganisation;
                    rdfs:label "Recharge moneo".
poste:ttl <http://purl.org/dc/terms/FileFormat> <http://data.lirmm.fr/ontologies/poste>;
          <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by-sa/3.0/>;
          a <http://www.w3.org/ns/adms#SemanticDistribution>;
          <http://www.w3.org/ns/adms#accessURL> "http://data.lirmm.fr/ontologies/poste.ttl";
          <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
<http://data.semanticweb.org/organization/eurecom> a <http://www.w3.org/ns/org#Organization>;
                                                   <http://xmlns.com/foaf/0.1/name> "EURECOM".
<http://data.semanticweb.org/person/raphael-troncy> a <http://xmlns.com/foaf/0.1/Person>;
                                                    <http://xmlns.com/foaf/0.1/name> "Raphael Troncy".
<http://www.eurecom.fr/~atemezin> a <http://xmlns.com/foaf/0.1/Person>;
                                  <http://xmlns.com/foaf/0.1/name> "Ghislain Auguste Atemezing".
