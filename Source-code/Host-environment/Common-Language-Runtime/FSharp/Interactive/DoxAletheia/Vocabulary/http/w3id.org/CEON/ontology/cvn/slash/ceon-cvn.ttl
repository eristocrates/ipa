@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ceon-cvn: <http://w3id.org/CEON/ontology/cvn/>.

<http://w3id.org/CEON/ontology/actorODP/Participation> a <http://www.w3.org/2002/07/owl#Class>.
ceon-cvn: <http://purl.org/dc/terms/contributor> "Mikael Lindecrantz",
                                                 "Eva Blomqvist",
                                                 "Robin Keskisärkkä";
          <http://purl.org/dc/terms/created> "2025-05-22"^^xsd:date;
          <http://purl.org/dc/terms/creator> "Huanyu Li";
          <http://purl.org/dc/terms/description> "A core module of the CEON ontology network, defining aspects of the circular value network (CVN) itself.";
          <http://purl.org/dc/terms/issued> "2025-06-30"^^xsd:date;
          <http://purl.org/dc/terms/license> "https://creativecommons.org/licenses/by/4.0/";
          <http://purl.org/dc/terms/publisher> "Onto-DESIDE";
          <http://purl.org/dc/terms/title> "Circular Economy Ontology Network (CEON) - Circular Value Network Module";
          <http://purl.org/vocab/vann/preferredNamespacePrefix> "ceon-cvn";
          <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/CEON/ontoloy/cvn/";
          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.2: CE1-1, CE2-1, CE3-1, CE3-2, CE4-1, CE5-16, C0-1.",
                                                                                                    "In addition to requirements covered by imported ODPs, covers the following requirements from Onto-DESIDE D3.1: CVN-CVN-1, CVN-Process-1,6, CVN-VP-1, CVN-Type-3, C0-1.";
          a <http://www.w3.org/2002/07/owl#Ontology>;
          rdfs:comment "A core module of the CEON ontology network, defining aspects of the circular value network (CVN) itself.";
          rdfs:seeAlso <https://github.com/LiUSemWeb/CEON>;
          <http://www.w3.org/2002/07/owl#imports> <http://w3id.org/CEON/ontology/actor/0.4/>;
          <http://www.w3.org/2002/07/owl#priorVersion> 0.2;
          <http://www.w3.org/2002/07/owl#versionIRI> <http://w3id.org/CEON/ontology/cvn/0.3/>;
          <http://www.w3.org/2002/07/owl#versionInfo> 0.3.
ceon-cvn:CVN a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A network of interlinked value chains and interested parties."@en;
             rdfs:isDefinedBy "ISO 59004:2024 - 3.5.3 value network";
             rdfs:label "Circular Value Network";
             rdfs:subClassOf ceon-cvn:Collaboration.
ceon-cvn:CVNBlueprint a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A plan or a pattern of a CVN configuration that can then be filled with actual actors and processes. The blueprint can be used to capture a desired setup of a network, or for reusing patterns of CVNs.";
                      rdfs:label "Circular Value Network Blueprint".
ceon-cvn:CircularStrategy a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A circular strategy, such as to reccycle, reuse or refurbish something.";
                          rdfs:label "Circular Strategy".
ceon-cvn:Collaboration a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A collaboration between a set of actors.";
                       rdfs:label "Collaboration".
ceon-cvn:aimsAtValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The value proposition that the planned abstract CVN configuration, or concrete network wants to achieve.";
                     rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (ceon-cvn:CVN
                                                                           ceon-cvn:CVNBlueprint) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                     rdfs:label "aims at value";
                     rdfs:range <http://w3id.org/CEON/ontology/value/ValueProposition>.
ceon-cvn:composedOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Both a CVN and a process can be composed of other CVNs or processes.";
                    rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (ceon-cvn:CVN
                                                                          <http://w3id.org/CEON/ontology/processODP/Process>) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                    rdfs:label "composed of";
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (ceon-cvn:CVN
                                                                         <http://w3id.org/CEON/ontology/processODP/Process>) ; 
                                a <http://www.w3.org/2002/07/owl#Class>].
ceon-cvn:createsValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Value creation can be captured at the actor level, i.e. value created by an actor's participation in a collaboration, or at the process or complete CVN level.";
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (<http://w3id.org/CEON/ontology/actorODP/Participation>
                                                                            ceon-cvn:CVN
                                                                            <http://w3id.org/CEON/ontology/processODP/Process>) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "creates value";
                      rdfs:range <http://w3id.org/CEON/ontology/value/Value>.
ceon-cvn:implementsBlueprint a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "The blueprint (or plan) that this concrete CVN is an instance of.";
                             rdfs:domain ceon-cvn:CVN;
                             rdfs:label "implements blueprint";
                             rdfs:range ceon-cvn:CVNBlueprint.
ceon-cvn:implementsStrategy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "A strategy that is implemented by this CVN or CVN blueprint.";
                            rdfs:domain ceon-cvn:CVN;
                            rdfs:label "implements strategy";
                            rdfs:range ceon-cvn:CircularStrategy;
                            rdfs:subPropertyOf ceon-cvn:relatedStrategy.
ceon-cvn:plansToImplementStrategy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "A strategy that is planned to be implemented by this CVN or CVN blueprint.";
                                  rdfs:domain ceon-cvn:CVNBlueprint;
                                  rdfs:label "plans to implement strategy";
                                  rdfs:range ceon-cvn:CircularStrategy;
                                  rdfs:subPropertyOf ceon-cvn:relatedStrategy.
ceon-cvn:relatedStrategy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "A strategy that is targeted by this CVN or CVN blueprint.";
                         rdfs:label "related strategy".
<http://w3id.org/CEON/ontology/processODP/Process> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/resourceODP/Resource> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/value/Value> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/CEON/ontology/value/ValueProposition> a <http://www.w3.org/2002/07/owl#Class>.
xsd:date a rdfs:Datatype.
xsd:gMonthYear a rdfs:Datatype.
xsd:gYear a rdfs:Datatype.
