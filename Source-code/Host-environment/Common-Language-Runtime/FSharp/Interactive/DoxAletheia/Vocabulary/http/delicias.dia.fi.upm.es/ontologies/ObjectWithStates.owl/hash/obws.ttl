@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix obws: <http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl#>.

<http://delicias.dia.fi.upm.es/ontologies/ObjectWithStates.owl> <http://purl.org/dc/terms/creator> <http://www.garcia-castro.com/#me>;
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "Objects must have a unique state"@en,
                                                                                                                                                          "The possible states are: StateA, StateB and StateC"@en,
                                                                                                                                                          "Object states must belong to a single collection of non-duplicate elements (i.e., to a set)"@en,
                                                                                                                                                          "Objects in StateB must have at most one value for property property2"@en,
                                                                                                                                                          "Objects in StateA must have at least one value for property property1"@en,
                                                                                                                                                          "Objects in StateC must have exactly one value for property property3"@en,
                                                                                                                                                          "An object can have three different states"@en;
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "The pattern requires modelling states as individuals instead of as literals."@en;
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "An object can have different states for which different restrictions apply. The goal of the pattern is to allow modelling the different states of an object and the restrictions on such object for its different states"@en;
                                                                <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "A sample scenario is the following. A software defect created in an issue tracker must have a creator and be associated to a certain software product. Once it is checked that the defect is reproducible, it must be assigned to some developer and have a certain priority. However, before checking the defect reproducilibty the defect must not have either asignee or priority."@en;
                                                                a <http://www.w3.org/2002/07/owl#Ontology>;
                                                                rdfs:comment "Ontology including the content ontology design pattern for modelling objects with states."@en;
                                                                rdfs:label "Object with states ontology"@en;
                                                                <http://www.w3.org/2002/07/owl#imports> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>.
obws:Object a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Objects are entities that have different states and that in each state different restrictions on their properties apply."@en;
            rdfs:label "Object"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> obws:hasState ; 
                             <http://www.w3.org/2002/07/owl#onClass> obws:State ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>].
obws:State a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "States are the different states that an object can have. States must belong to a single collection of non-duplicate elements (i.e., to a set)."@en;
           rdfs:label "State"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                            <http://www.w3.org/2002/07/owl#onProperty> <http://ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf> ; 
                            <http://www.w3.org/2002/07/owl#onClass> obws:StateSet ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation>.
obws:StateSet a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "State sets are sets of states (i.e., collections of non-duplicate states)."@en;
              rdfs:label "State set"@en;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/set.owl#Set>.
obws:hasState a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Defines the state of an object."@en;
              rdfs:domain obws:Object;
              rdfs:label "has state"@en;
              rdfs:range obws:State;
              rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting>;
              <http://www.w3.org/2002/07/owl#inverseOf> obws:isStateOf.
obws:isStateOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Defines the object that has an state"@en;
               rdfs:domain obws:State;
               rdfs:label "is state of"@en;
               rdfs:range obws:Object;
               rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor>.
<http://ontologydesignpatterns.org/cp/owl/collectionentity.owl#isMemberOf> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.ontologydesignpatterns.org/cp/owl/set.owl#Set> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ontologydesignpatterns.org/cp/owl/set.owl#size> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#Situation> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#hasSetting> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.ontologydesignpatterns.org/cp/owl/situation.owl#isSettingFor> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
