@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix iot-lite: <http://purl.oclc.org/NET/UNIS/fiware/iot-lite#>.

iot-lite: a <http://www.w3.org/2002/07/owl#Ontology>;
          rdfs:comment "iot-lite is a lightweight ontology based on SSN to describe Internet of Things (IoT) concepts and relationships."@en;
          rdfs:label "iot-lite";
          <http://www.w3.org/2002/07/owl#versionInfo> "0.3 fiesta".
iot-lite:ActuatingDevice a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Device that can actuate over an object or QuantityKind."@en;
                         rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device>.
iot-lite:Attribute a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An attribute of an IoT object that can be exposed by an IoT service (i.e. a room (IoT Object) has a temperature (Attribute), that can be exposed by a temperature sensor (IoT device)."@en.
iot-lite:Circle a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Circle coverage it needs the location of the sensor as the centre of the circle and the radius as a DataProperty."@en;
                rdfs:subClassOf iot-lite:Coverage.
iot-lite:Coverage a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The coverage of an IoT device (i.e. a temperature sensor inside a room has a coverage of that room)."@en.
iot-lite:Entity a <http://www.w3.org/2002/07/owl#Class>;
                <http://www.w3.org/2002/07/owl#equivalentClass> iot-lite:Object.
iot-lite:Metadata a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Class used to describe properties that cannot be described by QuantityKind and Units. i.e. the resolution of a sensor."@en.
iot-lite:Object a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "IoT entity"@en.
iot-lite:Polygon a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The coverage is made up by linking several points by strait lines."@en;
                 rdfs:subClassOf iot-lite:Coverage.
iot-lite:Rectangle a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Teh coverage is made up by giving two points which are the oposite corners of a rentangle."@en;
                   rdfs:subClassOf iot-lite:Coverage.
iot-lite:Service a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Service provided by an IoT Device"@en.
iot-lite:TagDevice a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Tag Device such as QR code or bar code."@en;
                   rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device>.
iot-lite:VirtualEntity a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:subClassOf iot-lite:Entity.
iot-lite:altRelative a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                     rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
                     rdfs:range xsd:string.
iot-lite:endpoint a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Endpoint of the service. It is usually a URL where the service is available.";
                  rdfs:domain iot-lite:Service;
                  rdfs:range xsd:anyURI.
iot-lite:exposedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A device is exposed by a service.";
                   rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device>;
                   rdfs:range iot-lite:Service.
iot-lite:exposes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "For service-oriented queries. The inverse of exposedBy.";
                 rdfs:domain iot-lite:Service;
                 rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Device>;
                 <http://www.w3.org/2002/07/owl#inverseOf> iot-lite:exposedBy.
iot-lite:hasAttribute a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Links the devices with their attributes.";
                      rdfs:domain iot-lite:Entity,
                                  iot-lite:Object;
                      rdfs:range iot-lite:Attribute.
iot-lite:hasCoverage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links the devices with their coverages.";
                     rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device>;
                     rdfs:range iot-lite:Coverage.
iot-lite:hasMetadata a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Links any concept with metadata about that concept.";
                     rdfs:range iot-lite:Metadata.
iot-lite:hasQuantityKind a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Links a sensor or an attribute with the quantity  kind it measures (e.g. A sensor -sensor1- measures temperature: sensor1 hasQuantityKind temperature).";
                         rdfs:domain iot-lite:Attribute,
                                     <http://purl.oclc.org/NET/ssnx/ssn#Sensor>;
                         rdfs:range <http://purl.org/NET/ssnx/qu/qu#QuantityKind>.
iot-lite:hasSensingDevice a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Links a sensor with a sensing device the same way as SSN.";
                          rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Sensor>;
                          rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#SensingDevice>.
iot-lite:hasUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Links the sensor with the units of the quantity kind it measures (e.g. A sensor -sensor1- measures temperature in Celsius: senso1 hasUnit celsius).";
                 rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Sensor>;
                 rdfs:range <http://purl.org/NET/ssnx/qu/qu#Unit>.
iot-lite:id a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Device>;
            rdfs:range xsd:string.
iot-lite:interfaceDescription a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "Description of the service.";
                              rdfs:domain iot-lite:Service;
                              rdfs:range xsd:anyURI.
iot-lite:interfaceType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Defines the type of interface of the service endpoint.";
                       rdfs:domain iot-lite:Service;
                       rdfs:range xsd:string.
iot-lite:isAssociatedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Defines the associations between objects and sensors (e.g. A table (object) has an attribute (temperature at the table) which is associated with a sensor (the temperature sensor of the room). ";
                          rdfs:domain iot-lite:Entity,
                                      iot-lite:Object;
                          rdfs:range iot-lite:Service.
iot-lite:isMobile a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Platform>;
                  rdfs:range xsd:boolean.
iot-lite:isSubSystemOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#System>;
                       rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#System>;
                       <http://www.w3.org/2002/07/owl#inverseOf> <http://purl.oclc.org/NET/ssnx/ssn#hasSubSystem>.
iot-lite:metadataType a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Defines the type pf the metadata value (e.g. resolution of the sensor).";
                      rdfs:domain iot-lite:Metadata;
                      rdfs:range xsd:string.
iot-lite:metadataValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "Value of the metadata";
                       rdfs:domain iot-lite:Metadata;
                       rdfs:range xsd:string.
iot-lite:radius a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Specifies the radius of a circle coverage defined by a point -the center of the circle- and its radius.";
                rdfs:domain iot-lite:Circle;
                rdfs:range xsd:double.
iot-lite:relativeLocation a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                          rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>;
                          rdfs:range xsd:string.
<http://purl.oclc.org/NET/ssnx/ssn#Device> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#System>.
<http://purl.oclc.org/NET/ssnx/ssn#Platform> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.oclc.org/NET/ssnx/ssn#SensingDevice> a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device>,
                                                                  <http://purl.oclc.org/NET/ssnx/ssn#Sensor>.
<http://purl.oclc.org/NET/ssnx/ssn#Sensor> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.oclc.org/NET/ssnx/ssn#System> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.oclc.org/NET/ssnx/ssn#hasSubSystem> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                 rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#System>;
                                                 rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#System>.
<http://purl.oclc.org/NET/ssnx/ssn#onPlatform> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#System>;
                                               rdfs:range <http://purl.oclc.org/NET/ssnx/ssn#Platform>.
<http://purl.org/NET/ssnx/qu/qu#QuantityKind> a <http://www.w3.org/2002/07/owl#Class>.
<http://purl.org/NET/ssnx/qu/qu#Unit> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> iot-lite:altRelative "";
                                                iot-lite:relativeLocation "";
                                                a <http://www.w3.org/2002/07/owl#Class>;
                                                <http://www.w3.org/2003/01/geo/wgs84_pos#alt> "";
                                                <http://www.w3.org/2003/01/geo/wgs84_pos#lat> "";
                                                <http://www.w3.org/2003/01/geo/wgs84_pos#long> "".
<http://www.w3.org/2003/01/geo/wgs84_pos#alt> a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>.
<http://www.w3.org/2003/01/geo/wgs84_pos#lat> a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                              rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>.
<http://www.w3.org/2003/01/geo/wgs84_pos#location> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:range <http://www.w3.org/2003/01/geo/wgs84_pos#Point>.
<http://www.w3.org/2003/01/geo/wgs84_pos#long> a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                               rdfs:domain <http://www.w3.org/2003/01/geo/wgs84_pos#Point>.
