@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix holding: <http://purl.org/ontology/holding#>.

<http://purl.org/goodrelations/v1#Location> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:isDefinedBy <http://purl.org/goodrelations/v1>;
                                            rdfs:label "Location"@en;
                                            <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/Place>.
<http://purl.org/ontology/dso#DocumentService> a <http://www.w3.org/2002/07/owl#Class>;
                                               rdfs:isDefinedBy <http://purl.org/ontology/dso>;
                                               rdfs:label "DocumentService".
<http://purl.org/ontology/ecpo#Chronology> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:isDefinedBy <http://purl.org/ontology/ecpo>;
                                           rdfs:label "Chronology"@en.
<http://purl.org/ontology/holding> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                   <http://purl.org/dc/terms/creator> "Jakob Voß",
                                                                      "Carsten Klee";
                                   <http://purl.org/dc/terms/description> "A vocabulary to express (library) holdings in RDF";
                                   <http://purl.org/dc/terms/modified> "2014-06-30"^^xsd:date;
                                   <http://purl.org/dc/terms/title> "Holding Ontology"@en;
                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "holding";
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/ontology/holding#";
                                   a <http://purl.org/vocommons/voaf#Vocabulary>,
                                     <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:label "Holding Ontology"@en;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "0.1.3rev1".
holding:Agent a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Use one of bf:Agent or foaf:Agent"@en;
              rdfs:label "Agent"@en;
              <http://www.w3.org/2002/07/owl#unionOf> (<http://bibframe.org/vocab/Agent>
                                                       <http://xmlns.com/foaf/0.1/Agent>
                                                       <http://schema.org/Organization>
                                                       <http://schema.org/Person>
                                                       <http://rdaregistry.info/Elements/c/Agent>).
holding:Document a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Use one of bibo:Document, foaf:Document, bf:Work or bf:Instance"@en;
                 rdfs:label "Document"@en;
                 <http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/ontology/bibo/Document>
                                                          <http://xmlns.com/foaf/0.1/Document>
                                                          <http://bibframe.org/vocab/Work>
                                                          <http://bibframe.org/vocab/Instance>
                                                          <http://schema.org/CreativeWork>).
holding:Item a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Use one of bf:HeldItem frbr:Item rdac:Item"@en;
             rdfs:label "Item"@en;
             <http://www.w3.org/2002/07/owl#unionOf> (<http://bibframe.org/vocab/HeldItem>
                                                      <http://purl.org/vocab/frbr/core#Item>
                                                      <http://rdaregistry.info/Elements/c/Item>).
holding:broaderExemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Relates a document to an item that contains an exemplar of the document as part."@en;
                        rdfs:domain holding:Document;
                        rdfs:label "broader exemplar"@en;
                        rdfs:range holding:Item;
                        rdfs:seeAlso <http://rdaregistry.info/Elements/i/containedInItem>;
                        <http://www.w3.org/2002/07/owl#inverseOf> holding:broaderExemplarOf.
holding:broaderExemplarOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Relates an item to a document which is partly exemplified by the item."@en;
                          rdfs:domain holding:Item;
                          rdfs:label "broader exemplar of"@en;
                          rdfs:range holding:Document;
                          rdfs:seeAlso <http://rdaregistry.info/Elements/i/containsItem>;
                          <http://www.w3.org/2002/07/owl#inverseOf> holding:broaderExemplar.
holding:collectedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates an agent to a document and/or item that is collected by the agent."@en,
                                 "Relates a document and/or item to an agent who collects it."@en;
                    rdfs:domain holding:Document,
                                holding:Agent,
                                holding:Item;
                    rdfs:label "collected by"@en,
                               "collects"@en;
                    rdfs:range holding:Item,
                               holding:Agent,
                               holding:Document;
                    rdfs:seeAlso <http://rdaregistry.info/Elements/i/collector>,
                                 <http://rdaregistry.info/Elements/i/collectorOf>;
                    <http://www.w3.org/2002/07/owl#inverseOf> holding:collects,
                                                              holding:collectedBy.
holding:exemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates a document to an item that is an exemplar of the document."@en;
                 rdfs:domain holding:Document;
                 rdfs:label "has exemplar"@en;
                 rdfs:range holding:Item;
                 rdfs:seeAlso <http://rdaregistry.info/Elements/m/exemplarOfManifestation>,
                              <http://purl.org/vocab/frbr/core#exemplar>;
                 <http://www.w3.org/2002/07/owl#inverseOf> holding:exemplarOf.
holding:exemplarOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates an item to the document that is exemplified by the item."@en;
                   rdfs:domain holding:Item;
                   rdfs:label "is examplar of"@en;
                   rdfs:range holding:Document;
                   rdfs:seeAlso <http://rdaregistry.info/Elements/i/manifestationExemplified>,
                                <http://bibframe.org/vocab/holdingFor>;
                   <http://www.w3.org/2002/07/owl#inverseOf> holding:exemplar.
holding:heldBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relates an item to an agent who holds the item."@en;
               rdfs:domain holding:Item;
               rdfs:label "held by"@en;
               rdfs:range holding:Agent;
               rdfs:seeAlso <http://rdaregistry.info/Elements/i/owner>,
                            <http://rdaregistry.info/Elements/i/currentOwner>,
                            <http://bibframe.org/vocab/heldBy>;
               rdfs:subPropertyOf holding:collectedBy;
               <http://www.w3.org/2002/07/owl#inverseOf> holding:holds.
holding:holds a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates an agent to an item which the agent holds."@en;
              rdfs:domain holding:Agent;
              rdfs:label "holds"@en;
              rdfs:range holding:Item;
              rdfs:seeAlso <http://rdaregistry.info/Elements/a/ownerOf>,
                           <http://rdaregistry.info/Elements/a/currentOwnerOf>;
              rdfs:subPropertyOf holding:collects;
              <http://www.w3.org/2002/07/owl#inverseOf> holding:heldBy.
holding:label a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "A call number, shelf mark or similar label of an item"@en;
              rdfs:domain holding:Item;
              rdfs:label "label"@en;
              rdfs:range rdfs:Literal;
              rdfs:seeAlso <http://bibframe.org/vocab/label>,
                           <http://rdaregistry.info/Elements/i/identifierForTheItem>,
                           <http://purl.org/goodrelations/v1#hasStockKeepingUnit>,
                           <http://schema.org/sku>,
                           <http://bibframe.org/vocab/shelfMark>,
                           <http://schema.org/name>;
              rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
holding:narrowerExemplar a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Relates a document to an item that is an exemplar of a part of the document."@en;
                         rdfs:domain holding:Document;
                         rdfs:label "narrower exemplar"@en;
                         rdfs:range holding:Item;
                         rdfs:seeAlso <http://rdaregistry.info/Elements/i/containsItem>;
                         <http://www.w3.org/2002/07/owl#inverseOf> holding:narrowerExemplarOf.
holding:narrowerExemplarOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Relates an item to a document which is partly exemplified by the item."@en;
                           rdfs:domain holding:Item;
                           rdfs:label "narrower exemplar of"@en;
                           rdfs:range holding:Document;
                           rdfs:seeAlso <http://rdaregistry.info/Elements/i/containedInItem>;
                           <http://www.w3.org/2002/07/owl#inverseOf> holding:narrowerExemplar.
