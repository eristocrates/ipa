                  rdfs:label "Attributed Source";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://www.linkedmodel.org/schema/vaem#name> ; 
