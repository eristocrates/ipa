voagm:CreativeCommonsWork <http://purl.org/dc/elements/1.1/description> "A potentially copyrightable work"@en-us;
                          a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                          rdfs:label "Creative Commons Work"@en-us,
                                     "Creative commons work";
                          rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                                          [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> voagm:url ; 
