                                rdfs:isDefinedBy <http://voag.linkedmodel.org/schema/voag>;
                                rdfs:label "Creative Commons Permission"@en-us;
                                rdfs:subClassOf voagm:EnumeratedValue.
voagm:CreativeCommonsProhibition <http://purl.org/dc/elements/1.1/description> "something you may be asked not to do"@en-us;
