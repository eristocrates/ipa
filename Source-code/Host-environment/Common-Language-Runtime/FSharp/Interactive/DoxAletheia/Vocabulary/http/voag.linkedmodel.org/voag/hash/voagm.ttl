                                  <http://www.w3.org/2002/07/owl#onProperty> voagm:hasConfidentiality ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> voagm:GovernanceEvent ; 
