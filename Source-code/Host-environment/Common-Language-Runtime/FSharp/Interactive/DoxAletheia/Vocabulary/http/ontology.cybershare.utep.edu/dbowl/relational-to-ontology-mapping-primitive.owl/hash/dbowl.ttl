@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl> <http://creativecommons.org/ns#license> "http://creativecommons.org/licenses/by/3.0/"^^xsd:anyURI;
                                                                                         <http://protege.stanford.edu/plugins/owl/protege#defaultLanguage> "en";
                                                                                         <http://purl.org/dc/elements/1.1/contributor> """Contributors are those that engage in discussions during the development of this ontology (in alphabetical order):
		michel dumontier
		luis garnica
		""";
                                                                                         <http://purl.org/dc/elements/1.1/creator> "Natalia Villanueva-Rosales"@en,
                                                                                                                                   "iLink @ UTEP"@en,
                                                                                                                                   "http://cybershare.utep.edu"^^xsd:anyURI;
                                                                                         <http://purl.org/dc/elements/1.1/description> """
		Primitive ontology for database to Semantic Web mapping which subsumes classes that
		represent mappings to explicit OWL constructs, such as OWL class, object property, data
		property, etc. Classes in this ontology are populated by individuals representing components of the database schema being mapped.
		"""@en;
                                                                                         <http://purl.org/dc/elements/1.1/issued> "2016-03-01"^^xsd:date;
                                                                                         <http://purl.org/dc/elements/1.1/rights> "free to use,share,modify. modify with attribution [http://creativecommons.org/licenses/by/3.0/].";
                                                                                         <http://purl.org/dc/elements/1.1/title> "Relational to Ontology Mapping Primitive"@en;
                                                                                         <http://purl.org/dc/terms/identifier> "relational-to-ontology-mapping-primitive.owl";
                                                                                         <http://purl.org/dc/terms/modified> "2016-04-01"^^xsd:date;
                                                                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "dbowl"@en;
                                                                                         <http://purl.org/vocab/vann/preferredNamespaceUri> "http://ontology.cybershare.utep.edu/dbowl/";
                                                                                         a <http://www.w3.org/2002/07/owl#Ontology>;
                                                                                         rdfs:isDefinedBy <http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl>;
                                                                                         <http://www.w3.org/2002/07/owl#versionIRI> <http://ontology.cybershare.utep.edu/dbowl/relational-to-ontology-mapping-primitive.owl>;
                                                                                         <http://www.w3.org/2002/07/owl#versionInfo> "2.0".
<http://ontology.cybershare.utep.edu/resource/dbowl/AggregationRelationMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                rdfs:comment "A mapping from a relational database element to the parthood (i.e. hasPart) relation between to cclasses.";
                                                                                rdfs:label "Aggregation Relation Mapping.";
                                                                                rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/BinaryObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                 rdfs:comment "A mapping from a relational database element to a set of two inverse object properties in RDF/OWL.";
                                                                                 rdfs:label "Binary Object Property mapping.";
                                                                                 rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                    rdfs:label "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL.",
                                                                               "Concept Mapping.";
                                                                    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                  rdfs:comment "A mapping from an relational model to a Semantic Web ontology.";
                                                                  rdfs:label "Database to Semantic Web mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/DatatypePropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                             rdfs:comment "A mapping from a relational database element to a datatype property in RDF/OWL.";
                                                                             rdfs:label "Datatype property mapping.";
                                                                             rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/EnnumerationPropertyRangeMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                      rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/PropertyRangeMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/EntityConceptMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                          rdfs:label "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL that will represent an entity.",
                                                                                     "Entity Concept Mapping.";
                                                                          rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/FunctionalDatatypePropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                       rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DatatypePropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/FunctionalObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                     rdfs:comment "A mapping from a relational database element to an object property asserted as functional.",
                                                                                                  "Functional Object Property Mapping.";
                                                                                     rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/InverseFunctionalObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                            rdfs:comment "A mapping from a relational database element to an object property asserted as inverse functional.";
                                                                                            rdfs:label "Inverse Functional Object Property Mapping.";
                                                                                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                           rdfs:comment "A mapping from a relational database element to an object property in RDF/OWL.";
                                                                           rdfs:label "Object Property Mapping.";
                                                                           rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/PropertyDomainMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                           rdfs:comment "A mapping from a relational database element as the domain of an object property.";
                                                                           rdfs:label "Property Domain Mapping";
                                                                           rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/PropertyRangeMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                          rdfs:comment "A mapping from a relational database element as the range of an object property.";
                                                                          rdfs:label "Property Range Mapping";
                                                                          rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/RelationConceptMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                            rdfs:comment "A mapping from an entity or relation from a relational database to a concept/class in RDF/OWL that will represent a relationship.";
                                                                            rdfs:label "Relation Concept Mapping.";
                                                                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ConceptMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/SpecificRelationMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                             rdfs:label "A mapping from a relational database element to the subclass (i.e. is-a) relation between to classes.",
                                                                                        "Specific Relation Mapping.";
                                                                             rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/SymmetricObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                    rdfs:comment "A mapping from a relational database element to an object property asserted as symmetric.";
                                                                                    rdfs:label "Symmetric Object Property Mapping";
                                                                                    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/TransitiveObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                     rdfs:comment "A mapping from a relational database element to an object property asserted as transitive.";
                                                                                     rdfs:label "Transitive Object Property Mapping.";
                                                                                     rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/UnaryObjectPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                                rdfs:comment "A mapping from a relational database element to one object property, i.e. an inverse object property will not be created.",
                                                                                             "Unary Object Property Mapping";
                                                                                rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/ObjectPropertyMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualCollectionMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                              rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualConceptMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                           rdfs:comment "A virtual concept mapping will map a database query description into a concept that is defined by the constraints defined in the query.";
                                                                           rdfs:label "Virtual concept mapping";
                                                                           rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                    rdfs:comment "A virtual mapping will create concepts that will not be populated from the database. Instead, it will contain the restrictions that will define the membership for that concept. They can be used to map restrictions described in views, queries, etc.";
                                                                    rdfs:label "Dabatase virtual concept mapping";
                                                                    rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/DB2SWMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/VirtualPropertyMapping> a <http://www.w3.org/2002/07/owl#Class>;
                                                                            rdfs:comment "A virtual property mapping will map a view to an object property restricted by a condition or a projection. This is used to map views that contain relations that were mapped as binary object properties and not as concepts.";
                                                                            rdfs:label "Virtual property mapping";
                                                                            rdfs:subClassOf <http://ontology.cybershare.utep.edu/resource/dbowl/VirtualMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/equivalentClassMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                            rdfs:label "equivalent class mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/exactly1CardinalityRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                    rdfs:label "exactly one restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/existsSomeRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                           rdfs:label "exists some restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/hasAggregateFunctionMapping> a <http://www.w3.org/2002/07/owl#DatatypeProperty>.
<http://ontology.cybershare.utep.edu/resource/dbowl/hasDomainMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                      rdfs:label "has domain mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/hasGroupingAttributeMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                 rdfs:subPropertyOf <http://ontology.cybershare.utep.edu/resource/dbowl/isCollectionOfMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/hasInversePropertyMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                               rdfs:label "has inverse property mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/hasPartMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                    rdfs:label "has part mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/hasPropertyMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://ontology.cybershare.utep.edu/resource/dbowl/hasRangeMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                     rdfs:label "has range mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfDomainMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfRangeMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://ontology.cybershare.utep.edu/resource/dbowl/hasTypeMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                    rdfs:label "has type mapping".
<http://ontology.cybershare.utep.edu/resource/dbowl/isCollectionOfMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://ontology.cybershare.utep.edu/resource/dbowl/isSubClassOfDomainOfMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                 <http://www.w3.org/2002/07/owl#inverseOf> <http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfDomainMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/isSubClassOfRangeOfMapping> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                <http://www.w3.org/2002/07/owl#inverseOf> <http://ontology.cybershare.utep.edu/resource/dbowl/hasSubClassOfRangeMapping>.
<http://ontology.cybershare.utep.edu/resource/dbowl/max0CardinalityRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                rdfs:label "max 0 restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/max1CardinalityRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                rdfs:label "max 1 restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/min0CardinalityRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                rdfs:label "min 0 restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/min1CardinalityRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                rdfs:label "min 1 restriction".
<http://ontology.cybershare.utep.edu/resource/dbowl/onlyFromPropertyRestriction> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                                                 rdfs:label "only from restriction".
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
