                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:Conductivity a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Parametro  di Qualità"@it,
                                "Quality Parameter"@en;
                   rdfs:label "Conducibilità"@it,
                              "Conductivity"@en;
                   rdfs:subClassOf ispra:Parameter;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:Contract a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Lotto"@it,
                          "Contract"@en;
               <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:EconomicIndicator a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Parametro del quadro economico del lotto."@it,
                                     "Parameter of the project economic framework."@en;
                        rdfs:label "Indicatore economico"@it,
                                   "Economic Indicator"@en;
                        rdfs:subClassOf ispra:Indicator;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:GeoFeature a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Elemento geografico"@it,
                            "Geographical feature"@en;
                 rdfs:subClassOf <http://www.geonames.org/ontology#Feature>;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:Hydrometer a <http://www.w3.org/2002/07/owl#Class>;
