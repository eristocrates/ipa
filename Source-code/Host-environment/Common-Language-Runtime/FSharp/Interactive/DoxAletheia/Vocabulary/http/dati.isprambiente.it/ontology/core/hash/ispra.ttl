                    rdfs:label "Autorità"@it,
                               "Authority kind"@en;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:Barometer a <http://www.w3.org/2002/07/owl#Class>;
