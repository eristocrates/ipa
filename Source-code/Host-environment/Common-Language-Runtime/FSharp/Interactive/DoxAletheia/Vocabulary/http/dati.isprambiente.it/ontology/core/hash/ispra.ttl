                            "Anemometer"@en;
                 rdfs:subClassOf ispra:Instrument;
                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:AuthorityKind a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Ente coinvolto e funzione svolta."@it,
