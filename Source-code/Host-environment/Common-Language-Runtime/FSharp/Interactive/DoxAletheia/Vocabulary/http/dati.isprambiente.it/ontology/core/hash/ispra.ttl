@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ispra: <http://dati.isprambiente.it/ontology/core#>.
@prefix gr: <http://purl.org/goodrelations/v1#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcmitype: <http://purl.org/dc/dcmitype/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix pco: <http://purl.org/procurement/public-contracts#>.
@prefix geonames: <http://www.geonames.org/ontology#>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix status: <http://www.w3.org/2003/06/sw-vocab-status/ns#>.

ispra: ccrel:license <http://creativecommons.org/licenses/by/4.0/deed.it>;
       dc11:creator <http://www.isprambiente.gov.it/it/>,
                    <http://regesta.exe/>;
       dc11:date "2015/12/14";
       dc11:description "L'ontologia ISPRA nasce dall'esigenza di pubblicazione dei dataset LOD ed è finalizzata alla descrizione dei processi e delle attività dell'Istituto negli ambiti circoscritti dai primi dataset pubblicati. Al momento sono descritte in modo analitico le classi e le proprietà che insistono sul dominio specifico della rete ondametrica nazionale, della rete mareografica, del consumo del suolo e degli interventi di dissesto idrogeologico, ma l'obiettivo è di estenderla parallelamente alla pubblicazione di nuovi dataset."@it;
       dc11:publisher <http://www.isprambiente.gov.it/it/>;
       dc11:title "Ispra Ontology"@en;
       vann:preferredNamespacePrefix "ispra";
       vann:preferredNamespaceUri "http://dati.isprambiente.it/ontology/core#";
       a owl:Ontology;
       rdfs:label "Ispra Ontology"@en;
       owl:versionInfo "0.1.0".
ispra:Accelerometer a owl:Class;
                    rdfs:comment "Strumento"@it,
                                 "Instrument"@en;
                    rdfs:label "Accelerometro"@it,
                               "Accelerometer"@en;
                    rdfs:subClassOf ispra:Instrument;
                    status:term_status "stable".
ispra:AirPres a owl:Class;
              rdfs:comment "Parametro Meteorologico"@it,
                           "Meteorological Parameter"@en;
              rdfs:label "Pressione atmosferica"@it,
                         "Atmospheric Pressure"@en;
              rdfs:subClassOf ispra:Parameter;
              status:term_status "stable".
ispra:AirTemp a owl:Class;
              rdfs:comment "Parametro Meteorologico"@it,
                           "Meteorological Parameter"@en;
              rdfs:label "Temperatura dell'aria"@it,
                         "Air Temperature"@en;
              rdfs:subClassOf ispra:Parameter;
              status:term_status "stable".
ispra:Anemometer a owl:Class;
                 rdfs:comment "Strumento"@it,
                              "Instrument"@en;
                 rdfs:label "Anemometro"@it,
                            "Anemometer"@en;
                 rdfs:subClassOf ispra:Instrument;
                 status:term_status "stable".
ispra:AuthorityKind a owl:Class;
                    rdfs:comment "Ente coinvolto e funzione svolta."@it,
                                 "Involved authorities and role played."@en;
                    rdfs:label "Autorità"@it,
                               "Authority kind"@en;
                    status:term_status "stable".
ispra:Barometer a owl:Class;
                rdfs:comment "Strumento"@it,
                             "Instrument"@en;
                rdfs:label "Barometro"@it,
                           "Barometer"@en;
                rdfs:subClassOf ispra:Instrument;
                status:term_status "stable".
ispra:Conductivity a owl:Class;
                   rdfs:comment "Parametro  di Qualità"@it,
                                "Quality Parameter"@en;
                   rdfs:label "Conducibilità"@it,
                              "Conductivity"@en;
                   rdfs:subClassOf ispra:Parameter;
                   status:term_status "stable".
ispra:Contract a owl:Class;
               rdfs:label "Lotto"@it,
                          "Contract"@en;
               status:term_status "stable".
ispra:EconomicIndicator a owl:Class;
                        rdfs:comment "Parametro del quadro economico del lotto."@it,
                                     "Parameter of the project economic framework."@en;
                        rdfs:label "Indicatore economico"@it,
                                   "Economic Indicator"@en;
                        rdfs:subClassOf ispra:Indicator;
                        status:term_status "stable".
ispra:GeoFeature a owl:Class;
                 rdfs:label "Elemento geografico"@it,
                            "Geographical feature"@en;
                 rdfs:subClassOf geonames:Feature;
                 status:term_status "stable".
ispra:Hydrometer a owl:Class;
                 rdfs:comment "Strumento"@it,
                              "Instrument"@en;
                 rdfs:label "Idrometro"@it,
                            "Hydrometer"@en;
                 rdfs:subClassOf ispra:Instrument;
                 status:term_status "stable".
ispra:HydrometricLevel a owl:Class;
                       rdfs:comment "Parametro Oceanografico"@it,
                                    "Oceanographic Parameter"@en;
                       rdfs:label "Livello idrometrico"@it,
                                  "Hydrometric Level"@en;
                       rdfs:subClassOf ispra:Parameter;
                       status:term_status "stable".
ispra:Hygrometer a owl:Class;
                 rdfs:comment "Strumento"@it,
                              "Instrument"@en;
                 rdfs:label "Igrometro"@it,
                            "Hygrometer"@en;
                 rdfs:subClassOf ispra:Instrument;
                 status:term_status "stable".
ispra:Indicator a owl:Class;
                rdfs:label "Indicatore"@it,
                           "Indicator"@en;
                status:term_status "stable".
ispra:IndicatorCollection a owl:Class;
                          rdfs:label "Collezione di indicatori"@it,
                                     "Indicator Collection"@en;
                          status:term_status "stable".
ispra:Instability a owl:Class;
                  rdfs:comment "Tipologia di dissesto indicata in progetto o rilevata in sito."@it,
                               "Type of instability phenomenon shown in the drawings or observed by site visit."@en;
                  rdfs:label "Dissesto"@it,
                             "Instability"@en;
                  status:term_status "stable".
ispra:Instrument a owl:Class;
                 rdfs:label "Strumento"@it,
                            "Instrument"@en;
                 status:term_status "stable".
ispra:Intervention a owl:Class;
                   rdfs:comment "Intervento per la mitigazione del rischio idrogeologico a cui è assegnato uno specifico finanziamento. Può essere costituito da uno più lotti."@it,
                                "A single action, funded under a plan for hydrogeological risk mitigation. It may consist of one or more related projects."@en;
                   rdfs:label "Intervento"@it,
                              "Action"@en;
                   rdfs:subClassOf pco:Contract;
                   status:term_status "stable".
ispra:Lithology a owl:Class;
                rdfs:comment "Tipi litologici indicati in progetto."@it,
                             "Lithology as stated in the project."@en;
                rdfs:label "Litologia"@it,
                           "Lithology"@en;
                status:term_status "stable".
ispra:LotStep a owl:Class;
              rdfs:comment "Passo dell'iter di attuazione del progetto."@it;
              rdfs:label "Passi del lotto"@it,
                         "Lot step"@en;
              status:term_status "stable".
ispra:MarineIndicator a owl:Class;
                      rdfs:label "Indicatore marino"@it,
                                 "Marine Indicator"@en;
                      rdfs:subClassOf ispra:Indicator;
                      status:term_status "stable".
ispra:MeasureStation a owl:Class;
                     rdfs:comment "Insieme di strumenti di misura che permettono il monitoraggio in un dato luogo, per un determinato tempo, relativamente ai suoi parametri fondamentali."@it,
                                  "Facility with instruments and equipment for monitoring in a given place, for a determined period, relatively to its foundamental parameters."@en;
                     rdfs:label "Stazione di Misura"@it,
                                "Measure Station"@en;
                     status:term_status "stable".
ispra:MeasurementCollection a owl:Class;
                            rdfs:comment "Costituisce l'insieme di misure e metadati in un determinato periodo inerenti una grandezza osservata (es. Wind, Wave) in un dato luogo."@it,
                                         "Set of measures and metadata in a specified period regarding an observed parameter (eg. Wind, Wave) in a given place"@en;
                            rdfs:label "Set di Misure"@it,
                                       "Measurement Collection"@en;
                            status:term_status "stable".
ispra:Model a owl:Class;
            rdfs:comment "Tipologia di stazione di misura (ispra-core:MeasureStation) in funzione delle sua caratteristiche principali (grandezza, costruzione, ecc.)"@it,
                         "Type of measuring station (ispra-core: Measure Station) including a set of its main characteristics (size, construction, etc.)"@en;
            rdfs:label "Modello"@it,
                       "Model"@en;
            status:term_status "stable".
ispra:MultiParameterProbe a owl:Class;
                          rdfs:comment "Strumento"@it,
                                       "Instrument"@en;
                          rdfs:label "Sonda Multiparametrica"@it,
                                     "Multi Parameter Probe"@en;
                          rdfs:subClassOf ispra:Instrument;
                          status:term_status "stable".
ispra:PH a owl:Class;
         rdfs:comment "Parametro di Qualità"@it,
                      "Quality Parameter"@en;
         rdfs:label "PH"@it,
                    "PH"@en;
         rdfs:subClassOf ispra:Parameter;
         status:term_status "stable".
ispra:Parameter a owl:Class;
                rdfs:label "Parametro"@it,
                           "Parameter"@en;
                status:term_status "stable".
ispra:Place a owl:Class;
            rdfs:comment "TBC"@it,
                         "TBC"@en;
            rdfs:label "Luogo"@it,
                       "Place"@en;
            status:term_status "stable".
ispra:Redox a owl:Class;
            rdfs:comment "Parametro di Qualità"@it,
                         "Quality Parameter"@en;
            rdfs:label "Redox"@it,
                       "Redox"@en;
            rdfs:subClassOf ispra:Parameter;
            status:term_status "stable".
ispra:RelativeHumidity a owl:Class;
                       rdfs:comment "Parametro Meteorologico"@it,
                                    "Meteorological Parameter"@en;
                       rdfs:label "Umidità relativa"@it,
                                  "Relative Humidity"@en;
                       rdfs:subClassOf ispra:Parameter;
                       status:term_status "stable".
ispra:Repair a owl:Class;
             rdfs:comment "Type of protection works."@en,
                          "Tipologia di opere definite nel progetto ."@it;
             rdfs:label "Opera"@it,
                        "Repair"@en;
             status:term_status "stable".
ispra:SoilUseIndicator a owl:Class;
                       rdfs:label "Indicatore di uso del suolo"@it,
                                  "Use soil Indicator"@en;
                       rdfs:subClassOf ispra:Indicator;
                       status:term_status "stable".
ispra:Sst a owl:Class;
          rdfs:comment "Parametro Oceanografico"@it,
                       "Oceanographic Parameter"@en;
          rdfs:label "Temperatura Superficiale dell'acqua"@it,
                     "Sea Surface Temperature"@en;
          rdfs:subClassOf ispra:Parameter;
          status:term_status "stable".
ispra:Termometer a owl:Class;
                 rdfs:comment "Strumento"@it,
                              "Instrument"@en;
                 rdfs:label "Termometro"@it,
                            "Termometer"@en;
                 rdfs:subClassOf ispra:Instrument;
                 status:term_status "stable".
ispra:WaterTemperature a owl:Class;
                       rdfs:comment "Parametro Oceanografico"@it,
                                    "Oceanographic Parameter"@en;
                       rdfs:label "Temperatura dell'acqua"@it,
                                  "Water Temperature"@en;
                       rdfs:subClassOf ispra:Parameter;
                       status:term_status "stable".
ispra:Wave a owl:Class;
           rdfs:comment "Parametro Oceanografico"@it,
                        "Oceanographic Parameter"@en;
           rdfs:label "Onda"@it,
                      "Wave"@en;
           rdfs:subClassOf ispra:Parameter;
           status:term_status "stable".
ispra:Wind a owl:Class;
           rdfs:comment "Parametro Meteorologico"@it,
                        "Meteorological Parameter"@en;
           rdfs:label "Vento"@it,
                      "Wind"@en;
           rdfs:subClassOf ispra:Parameter;
           status:term_status "stable".
ispra:amountFinanced a owl:DatatypeProperty;
                     rdfs:comment "Importo finanziato (in euro)"@it,
                                  "Amount financed (in Euros)"@en;
                     rdfs:domain ispra:Contract;
                     rdfs:label "Importo finanziato"@it,
                                "Amount financed"@en;
                     rdfs:range xsd:string;
                     status:term_status "stable".
ispra:averagingPeriod a owl:DatatypeProperty;
                      rdfs:comment "Frequenza di restituzione del dato (in Minuti o Ore)"@it,
                                   "Frequency of final outputs (in Minutes or Hours)"@en;
                      rdfs:domain ispra:Instrument;
                      rdfs:label "Restituzione"@it,
                                 "Averaging Period"@en;
                      rdfs:range xsd:string;
                      status:term_status "stable".
ispra:belongsTo a owl:ObjectProperty,
                  owl:AnnotationProperty;
                rdfs:domain dcmitype:Collection;
                rdfs:label "Appartiene a"@it,
                           "Belongs to"@en;
                rdfs:range org:OrganizationalUnit;
                status:term_status "stable".
ispra:certainty a owl:ObjectProperty;
                rdfs:comment "Livello di validazione del dato. Vengono definiti su scala numerica a partire da 0 (dati grezzi). Es. L0, L1, L2, ecc."@it,
                             "Certainty level of the observed data. It is defined as numerical scale starting from 0 (raw data). Eg L0, L1, L2, etc."@en;
                rdfs:domain ispra:MeasurementCollection;
                rdfs:label "Validazione"@it,
                           "Certainty"@en;
                rdfs:range skos:Concept;
                status:term_status "stable".
ispra:code a owl:DatatypeProperty;
           rdfs:comment "Codice identificativo della stazione individuato da organismi nazionali o internazionali."@it,
                        "ID code of the measurement station as assigned by national or international organizations."@en;
           rdfs:domain ispra:MeasureStation;
           rdfs:label "Codice"@it,
                      "Code"@en;
           rdfs:range xsd:string;
           status:term_status "stable".
ispra:contractingAuthority a owl:ObjectProperty;
                           rdfs:comment "Questa proprietà associa il contratto con un'entità generica coinvolta (con un ruolo definito) nel contratto stesso."@it,
                                        "This property connects class contract with a generic entity involved, with specific role, in the contract."@en;
                           rdfs:domain ispra:Contract;
                           rdfs:label "Ente legato all'intervento"@it,
                                      "Contracting authority"@en;
                           rdfs:range ispra:AuthorityKind;
                           status:term_status "stable".
ispra:cup a owl:DatatypeProperty;
          rdfs:comment "E' costituito da una stringa alfanumerica di 15 caratteri, che accompagna ciascun progetto di investimento pubblico a partire dalla fase formale di assegnazione delle risorse."@it,
                       "It consists of a string of 15 alphanumeric characters, which accompanies each contract from the stage of formal resource allocation."@en;
          rdfs:domain ispra:Contract;
          rdfs:label "Codice Unico di Progetto"@it,
                     "Project Unit Code"@en;
          rdfs:range xsd:string;
          status:term_status "stable".
ispra:diameter a owl:DatatypeProperty;
               rdfs:comment "Diametro della stazione di misura."@it,
                            "Diameter of the measure station."@en;
               rdfs:domain ispra:Model;
               rdfs:label "Diametro"@it,
                          "Diameter"@en;
               rdfs:range xsd:string;
               status:term_status "stable".
ispra:directionalResolution a owl:DatatypeProperty;
                            rdfs:comment """Range di osservazione dei parametri direzionali in gradi Nord (\"Omi-directional\" se pari a 360ÃÂ°N)."""@it,
                                         "Directional resolution in degrees North (Omni-directional if 360ÃÂ°N)."@en;
                            rdfs:domain ispra:Instrument;
                            rdfs:label "Risoluzione direzionale"@it,
                                       "Directional resolution"@en;
                            rdfs:range xsd:string;
                            status:term_status "stable".
ispra:entity a owl:ObjectProperty;
             rdfs:comment "Questa proprietà associa la classe AuthorityKind con l'entità."@it,
                          "This property connects class AuthorityKind with the entity."@en;
             rdfs:domain ispra:AuthorityKind;
             rdfs:label "Entità"@it,
                        "Entity"@en;
             rdfs:range gr:BusinessEntity;
             status:term_status "stable".
ispra:generatedBy a owl:ObjectProperty;
                  rdfs:comment "Individua lo strumento che ha generato la misura."@it,
                               "Instruments that generate the measure."@en;
                  rdfs:domain ispra:MeasurementCollection;
                  rdfs:label "Generato da"@it,
                             "Generated by"@en;
                  rdfs:range ispra:Instrument;
                  status:term_status "stable".
ispra:hasAgreement a owl:ObjectProperty;
                   rdfs:comment "Proprietà che collega il contratto con il decreto di attuazione."@it,
                                "This property connects the contract with its framework agreement."@en;
                   rdfs:domain ispra:Contract;
                   rdfs:label "Has agreement"@it,
                              "Ha un accordo quadro"@en;
                   rdfs:range pco:FrameworkAgreement;
                   status:term_status "stable".
ispra:hasEconomicIndicator a owl:ObjectProperty;
                           rdfs:comment "Questa proprietà collega il contratto agli indicatori economici."@it,
                                        "This property connects the Contract to its Economic Indicator"@en;
                           rdfs:domain ispra:Contract;
                           rdfs:label "Ha indicatori economici"@it,
                                      "Has economic indicator"@en;
                           rdfs:range ispra:EconomicIndicator;
                           status:term_status "stable".
ispra:hasIter a owl:ObjectProperty;
              rdfs:comment "Questa proprietà collega il Contratto con il suo iter burocratico."@it,
                           "This property connects the class Contract with its formal procedural steps."@en;
              rdfs:domain ispra:Contract;
              rdfs:label "Ha iter"@it,
                         "Has iter"@en;
              rdfs:range skos:Concept;
              status:term_status "stable".
ispra:hasModel a owl:ObjectProperty;
               rdfs:comment "Questa proprietà collega la Stazione di misura al suo modello."@it,
                            "This property connects the Measure Station with its model."@en;
               rdfs:domain ispra:MeasureStation;
               rdfs:label "Ha modello di stazione di misura"@it,
                          "Has measure station model"@en;
               rdfs:range ispra:Model;
               status:term_status "stable".
ispra:hasStep a owl:ObjectProperty;
              rdfs:comment "Questa proprietà collega il concetto di Iter con i passi relativi"@it,
                           "This property connects the Concept of the formal procedure with its relative steps."@en;
              rdfs:domain ispra:LotStep;
              rdfs:label "Ha passo di iter"@it,
                         "Has step"@en;
              rdfs:range skos:Concept;
              status:term_status "stable".
ispra:hullType a owl:DatatypeProperty;
               rdfs:comment "Tipologia dello scafo  della stazione di misura."@it,
                            "Hull type of the measure station."@en;
               rdfs:domain ispra:Model;
               rdfs:label "Scafo"@it,
                          "Hull Type"@en;
               rdfs:range xsd:string;
               status:term_status "stable".
ispra:instabilityGroup a owl:DatatypeProperty;
                       rdfs:domain ispra:Instability;
                       rdfs:label "Raggruppamento di dissesto"@it,
                                  "Instability group"@en;
                       rdfs:range xsd:string;
                       status:term_status "stable".
ispra:instabilityRelatedTo a owl:ObjectProperty;
                           rdfs:comment "Questa proprietà collega la classe Dissesto al contratto di finanziamento relativo."@it,
                                        "This property connects the class Instability to the contract."@en;
                           rdfs:domain ispra:Instability;
                           rdfs:label "Dissesto relativo a"@it,
                                      "Instability related to"@en;
                           rdfs:range ispra:Contract;
                           status:term_status "stable".
ispra:instabilityType a owl:ObjectProperty;
                      rdfs:comment "Questa proprietà collega la classe Dissesto ad un concetto più specifico di dissesto."@it,
                                   "This property connects the class Instability to the more specific Concept of instability."@en;
                      rdfs:domain ispra:Instability;
                      rdfs:label "Tipo di dissesto"@it,
                                 "Instability type"@en;
                      rdfs:range skos:Concept;
                      status:term_status "stable".
ispra:isDataOf a owl:ObjectProperty;
               rdfs:comment "Associa i dati misurati in un determinato periodo a una grandezza (es. Wind, Wave) osservata in un determinato luogo."@it,
                            "This property connects the measured data in a given period with an observed parameter (eg. Wind, Wave) in a given place."@en;
               rdfs:domain ispra:MeasurementCollection;
               rdfs:label "Grandezza osservata"@it,
                          "Observed Parameter"@en;
               rdfs:range ispra:Parameter;
               status:term_status "stable".
ispra:isDistrictAuthority a owl:DatatypeProperty;
                          rdfs:comment "Booleano che indica se l'autorità svolge anche il ruolo di autorità di distretto."@it,
                                       "Boolean property that states if the authority act as district authority."@en;
                          rdfs:domain ispra:AuthorityKind;
                          rdfs:label "E' autorità di distretto"@it,
                                     "Is district authority"@en;
                          rdfs:range xsd:boolean;
                          status:term_status "stable".
ispra:isLotOf a owl:ObjectProperty;
              rdfs:comment "Questa proprietà collega i lotti al contratto."@it,
                           "This property connects the Lot to the Contract."@en;
              rdfs:domain ispra:Contract;
              rdfs:label "E' lotto di"@it,
                         "Is lot of"@en;
              rdfs:range ispra:Contract;
              status:term_status "stable".
ispra:isPrimary a owl:DatatypeProperty;
                rdfs:comment "Proprietà booleana che individua lo strumento primario (TRUE) che restituisce la misura e gli eventuali strumenti secondari (FALSE) utilizzati in caso di malfunzionamenti o per backup e validazione."@it,
                             "Boolean value identifing the primary measuring instrument (TRUE) and any secondary instruments (FALSE) used in case of malfunctions or for backup and validation."@en;
                rdfs:domain ispra:Instrument;
                rdfs:label "E' strumento primario"@it,
                           "Is primary instruments"@en;
                rdfs:range xsd:boolean;
                status:term_status "stable".
ispra:iterStepType a owl:ObjectProperty;
                   rdfs:comment "Elenco dei passi dell'iter previsti per l'attuazione dell'intervento."@it;
                   rdfs:domain skos:Concept;
                   rdfs:label "Passi dell'iter"@it,
                              "Iter step type"@en;
                   rdfs:range skos:Concept;
                   status:term_status "stable".
ispra:levelling a owl:DatatypeProperty;
                rdfs:comment "Tipologia di operazioni di livellazione utilizzati per la definizione del livello di riferimento."@it,
                             "Levelling activity useful to the definition of the referring level."@en;
                rdfs:domain ispra:Model;
                rdfs:label "Livellazione"@it,
                           "Levelling"@en;
                rdfs:range xsd:string;
                status:term_status "stable".
ispra:levellingTime a owl:DatatypeProperty;
                    rdfs:comment "Anno in cui è stata effettuata l'operazione di livellazione."@it,
                                 "Time (Year) of the levelling activities."@en;
                    rdfs:domain ispra:Model;
                    rdfs:label "Anno di livellazione"@it,
                               "Levelling Time"@en;
                    rdfs:range xsd:string;
                    status:term_status "stable".
ispra:lithologyRelatedTo a owl:ObjectProperty;
                         rdfs:comment "Questa proprietà collega la litologia al contratto."@it,
                                      "This property connects the Lithology to the Contract."@en;
                         rdfs:domain ispra:Lithology;
                         rdfs:label "Litologia collegata a"@it,
                                    "Lithology related to"@en;
                         rdfs:range ispra:Contract;
                         status:term_status "stable".
ispra:lithologyType a owl:ObjectProperty;
                    rdfs:comment "Questa proprietà collega la litologia allo specifico concetto."@it,
                                 "This property connects the Lithology to the specific concept."@en;
                    rdfs:domain ispra:Lithology;
                    rdfs:label "Tipo di litologia"@it,
                               "Lithology type"@en;
                    rdfs:range skos:Concept;
                    status:term_status "stable".
ispra:location a owl:DatatypeProperty;
               rdfs:comment "Localizzazione della stazione di misura (nel caso di mareografi è da intendersi in relazione allo spazio di mare antistante)."@it,
                            "Place in which the station is installed (in the case of tide gauges this place is related to the sea area in front of the station)."@en;
               rdfs:domain ispra:Model;
               rdfs:label "Localizzazione"@it,
                          "Location"@en;
               rdfs:range xsd:string;
               status:term_status "stable".
ispra:lot a owl:ObjectProperty;
          rdfs:comment "Questa proprietà collega i singoli passi del contratto al lotto relativo."@it,
                       "This property connects the class Lot Step to the contract."@en;
          rdfs:domain ispra:LotStep;
          rdfs:label "Lotto"@it,
                     "Lot"@en;
          rdfs:range ispra:Contract;
          status:term_status "stable".
ispra:manufacturer a owl:DatatypeProperty;
                   rdfs:comment "Produttore e modello della stazione di misura."@it,
                                "Manufacter and model of the measure station."@en;
                   rdfs:domain ispra:Model;
                   rdfs:label "Produttore"@it,
                              "Manufacturer"@en;
                   rdfs:range xsd:string;
                   status:term_status "stable".
ispra:measuredBy a owl:ObjectProperty;
                 rdfs:comment "Individua lo strumento presente nella stazione di misura in un determinato luogo che è in grado di misurare una grandezza (es. Wind, Wave) ."@it,
                              "It identifies the instrument located in a station in a given place that measures a parameter (eg. Wind, Wave)."@en;
                 rdfs:domain ispra:Parameter;
                 rdfs:label "Misurato da"@it,
                            "Measured by"@en;
                 rdfs:range ispra:Instrument;
                 status:term_status "stable".
ispra:measurementHeight a owl:DatatypeProperty;
                        rdfs:comment "Altezza dello strumento rispetto al livello di riferimento."@it,
                                     "Instrument height above the reference level."@en;
                        rdfs:domain ispra:Model;
                        rdfs:label "Altezza di misurazione"@it,
                                   "Measurement Height"@en;
                        rdfs:range xsd:string;
                        status:term_status "stable".
ispra:measurementPeriod a owl:DatatypeProperty;
                        rdfs:comment "Intervallo di tempo associato alla misura (Mese-Anno)."@it,
                                     "Measurement Period related to the measure (Month-Year)."@en;
                        rdfs:domain [owl:unionOf (ispra:IndicatorCollection
                                                  ispra:MeasurementCollection) ; 
                                     a owl:Class];
                        rdfs:label "Periodo di misurazione"@it,
                                   "Measurement Period"@en;
                        rdfs:range xsd:gYearMonth;
                        status:term_status "stable".
ispra:measures a owl:ObjectProperty;
               rdfs:comment "Proprietà che collega la stazione di misura con la grandezza  (es. Wind, Wave) osservata in un determinato luogo."@it,
                            "It connects the measure station with the observed parameter (eg. Wind, Wave) in a given place."@en;
               rdfs:domain ispra:MeasureStation;
               rdfs:label "Misura"@it,
                          "Measures"@en;
               rdfs:range ispra:Parameter;
               status:term_status "stable".
ispra:mooringType a owl:DatatypeProperty;
                  rdfs:comment "Tipologia di ormeggio della stazione di misura."@it,
                               "Mooring type of the measure station."@en;
                  rdfs:domain ispra:Model;
                  rdfs:label "Ormeggio"@it,
                             "Mooring Type"@en;
                  rdfs:range xsd:string;
                  status:term_status "stable".
ispra:officialInstabilityType a owl:DatatypeProperty;
                              rdfs:comment "Tipologia di dissesto indicata nel decreto di finanziamento."@it,
                                           "Type of instability declared in the decree"@en;
                              rdfs:domain ispra:Contract;
                              rdfs:label "Dissesto indicato nel decreto"@it,
                                         "Official instability type"@en;
                              rdfs:range xsd:string;
                              status:term_status "stable".
ispra:operationalStatus a owl:ObjectProperty;
                        rdfs:comment "Indica lo stato operativo della stazione di misura (es. Operational, Ceased, ecc.)."@it,
                                     "It indicates the operational status of the measure station (Operational, Ceased, etc.)."@en;
                        rdfs:domain ispra:MeasureStation;
                        rdfs:label "Stato Operativo"@it,
                                   "Operational Status"@en;
                        rdfs:range skos:Concept;
                        status:term_status "stable".
ispra:parameterReported a owl:DatatypeProperty;
                        rdfs:comment "Insieme di grandezze osservate dallo strumento."@it,
                                     "Set of parameters measured by the instrument."@en;
                        rdfs:domain ispra:Instrument;
                        rdfs:label "Parametri riportati"@it,
                                   "Parameters reported"@en;
                        rdfs:range xsd:string;
                        status:term_status "stable".
ispra:phase a owl:DatatypeProperty,
              owl:ObjectProperty;
            rdfs:label "Fase"@it,
                       "Phase"@en;
            rdfs:range xsd:string,
                       skos:Concept;
            status:term_status "stable".
ispra:placedOn a owl:ObjectProperty;
               rdfs:comment "Stazione di misura in cui è presente lo strumento"@it,
                            "Measure station that includes the instrument."@en;
               rdfs:domain ispra:Instrument;
               rdfs:label "Situato in "@it,
                          "Placed on"@en;
               rdfs:range ispra:MeasureStation;
               status:term_status "stable".
ispra:positioningSystem a owl:DatatypeProperty;
                        rdfs:comment "Positioning System installed on the measure station."@en,
                                     "Sistemi di georeferenziazione presenti nella stazione di misura."@it;
                        rdfs:domain ispra:Model;
                        rdfs:label "Georeferenziazione"@it,
                                   "Positioning System"@en;
                        rdfs:range xsd:string;
                        status:term_status "stable".
ispra:primaryGeographicalFeature a owl:ObjectProperty;
                                 rdfs:comment "Luogo primario legato ad un intervento di dissesto."@it,
                                              "Primary geographical feature of a Contract"@en;
                                 rdfs:domain ispra:Contract;
                                 rdfs:label "Luogo primario"@it,
                                            "Primary geographical feature"@en;
                                 rdfs:range ispra:Place;
                                 status:term_status "stable".
ispra:repairCategory a owl:ObjectProperty;
                     rdfs:domain ispra:Repair;
                     rdfs:label "Categoria di opera"@it,
                                "Repair category"@en;
                     rdfs:range skos:Concept;
                     status:term_status "stable".
ispra:repairGroup a owl:ObjectProperty;
                  rdfs:domain skos:Concept;
                  rdfs:label "Gruppo di opera"@it,
                             "Repair group"@en;
                  rdfs:range skos:Concept;
                  status:term_status "stable".
ispra:repairRelatedTo a owl:ObjectProperty;
                      rdfs:comment "Questa proprietà collega l'opera al contratto."@it,
                                   "This property connects the Repair to the Contract."@en;
                      rdfs:domain ispra:Repair;
                      rdfs:label "Opera collegata a"@it,
                                 "Repair related to"@en;
                      rdfs:range ispra:Contract;
                      status:term_status "stable".
ispra:repairType a owl:ObjectProperty;
                 rdfs:comment "Questa proprietà collega l'opera al concetto del vocabolario controllato."@it,
                              "This property connects the Repair to a concept of a specific vocabulary."@en;
                 rdfs:domain ispra:Repair;
                 rdfs:label "Tipologia di opera"@it,
                            "Repair type"@en;
                 rdfs:range skos:Concept;
                 status:term_status "stable".
ispra:role a owl:DatatypeProperty,
             owl:ObjectProperty;
           rdfs:comment "Ruolo dell'ente nella classe Authority kind"@it,
                        "The role of Entity in Authority kind class."@en;
           rdfs:domain ispra:AuthorityKind;
           rdfs:label "Ruolo"@it,
                      "Role"@en;
           rdfs:range skos:Concept;
           status:term_status "stable".
ispra:secondaryGeographicalFeature a owl:ObjectProperty;
                                   rdfs:comment "Luogo secondario legato ad un intervento di dissesto."@it,
                                                "Secondary geographical feature of a Contract"@en;
                                   rdfs:domain ispra:Contract;
                                   rdfs:label "Luogo secondario"@it,
                                              "Secondary geographical feature"@en;
                                   rdfs:range ispra:Place;
                                   status:term_status "stable".
ispra:sensorModel a owl:DatatypeProperty;
                  rdfs:comment "Sensor/Instrument Model."@en,
                               "Modello del sensore/strumento."@it;
                  rdfs:domain ispra:Instrument;
                  rdfs:label "Modello del sensore"@it,
                             "Sensor Model"@en;
                  rdfs:range xsd:string;
                  status:term_status "stable".
ispra:sensorSamplingFrequency a owl:DatatypeProperty;
                              rdfs:comment "Frequenza di campionamento dello strumento (in hertz)."@it,
                                           "Observation sampling of the instrumen (in hertz)."@en;
                              rdfs:domain ispra:Instrument;
                              rdfs:label "Frequenza di campionamento"@it,
                                         "Sensor Sampling Frequency"@en;
                              rdfs:range xsd:string;
                              status:term_status "stable".
ispra:structure a owl:DatatypeProperty;
                rdfs:comment "Material or building type of the measure station."@en,
                             "Materiale o tipologia costruttiva della stazione di misura."@it;
                rdfs:domain ispra:Model;
                rdfs:label "Struttura"@it,
                           "Structure"@en;
                rdfs:range xsd:string;
                status:term_status "stable".
ispra:typeOfDataStation a owl:ObjectProperty;
                        rdfs:comment "Tipologia di stazione di misura."@it,
                                     "Type of Data Station."@en;
                        rdfs:domain ispra:MeasureStation;
                        rdfs:label "Tipo di stazione di misura"@it,
                                   "Type of Data Station"@en;
                        rdfs:range skos:Concept;
                        status:term_status "stable".
ispra:waveHeightReported a owl:DatatypeProperty;
                         rdfs:comment "Parametri di altezza d'onda restituiti dallo strumento."@it,
                                      "Wave height parameters reported by the instrument."@en;
                         rdfs:domain ispra:Instrument;
                         rdfs:label "Output di Altezza d'onda"@it,
                                    "Wave Height Reported"@en;
                         rdfs:range xsd:string;
                         status:term_status "stable".
ispra:wavePeriodReported a owl:DatatypeProperty;
                         rdfs:comment "Parametri di periodo dell'onda restituiti dallo strumento."@it,
                                      "Wave period parameters reported by the instrument."@en;
                         rdfs:domain ispra:Instrument;
                         rdfs:label "Output di Periodo dell'onda"@it,
                                    "Wave Period Reported"@en;
                         rdfs:range xsd:string;
                         status:term_status "stable".
ispra:wmoSensorCode a owl:DatatypeProperty;
                    rdfs:comment "Associa lo strumento al relativo concept definito da WMO."@it,
                                 "It connects the intrument with the analogous concept as defined by WMO."@en;
                    rdfs:domain ispra:Instrument;
                    rdfs:label "Wmo Sensor Code"@it,
                               "Wmo Sensor Code"@en;
                    rdfs:range xsd:anyURI;
                    status:term_status "stable".
dcmitype:Collection a owl:Class.
gr:BusinessEntity a owl:Class;
                  status:term_status "stable".
pco:Contract a owl:Class.
pco:FrameworkAgreement a owl:Class;
                       status:term_status "stable".
<http://regesta.exe/> a foaf:Organization,
                        owl:NamedIndividual.
geonames:Feature a owl:Class.
<http://www.isprambiente.gov.it/it/> a foaf:Organization,
                                       owl:NamedIndividual.
xsd:gYearMonth a rdfs:Datatype.
status:term_status a owl:AnnotationProperty.
skos:Concept a owl:Class;
             status:term_status "stable".
org:OrganizationalUnit a owl:Class;
                       status:term_status "stable".
foaf:Organization a owl:Class.
