@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ispra: <http://dati.isprambiente.it/ontology/core#>.

ispra: <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/deed.it>;
       <http://purl.org/dc/elements/1.1/creator> <http://www.isprambiente.gov.it/it/>,
                                                 <http://regesta.exe/>;
       <http://purl.org/dc/elements/1.1/date> "2015/12/14";
       <http://purl.org/dc/elements/1.1/description> "L'ontologia ISPRA nasce dall'esigenza di pubblicazione dei dataset LOD ed è finalizzata alla descrizione dei processi e delle attività dell'Istituto negli ambiti circoscritti dai primi dataset pubblicati. Al momento sono descritte in modo analitico le classi e le proprietà che insistono sul dominio specifico della rete ondametrica nazionale, della rete mareografica, del consumo del suolo e degli interventi di dissesto idrogeologico, ma l'obiettivo è di estenderla parallelamente alla pubblicazione di nuovi dataset."@it;
       <http://purl.org/dc/elements/1.1/publisher> <http://www.isprambiente.gov.it/it/>;
       <http://purl.org/dc/elements/1.1/title> "Ispra Ontology"@en;
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "ispra";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://dati.isprambiente.it/ontology/core#";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "Ispra Ontology"@en;
       <http://www.w3.org/2002/07/owl#versionInfo> "0.1.0".
ispra:Accelerometer a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Strumento"@it,
                                 "Instrument"@en;
                    rdfs:label "Accelerometro"@it,
                               "Accelerometer"@en;
                    rdfs:subClassOf ispra:Instrument;
                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:AirPres a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Parametro Meteorologico"@it,
                           "Meteorological Parameter"@en;
              rdfs:label "Pressione atmosferica"@it,
                         "Atmospheric Pressure"@en;
              rdfs:subClassOf ispra:Parameter;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable".
ispra:AirTemp a <http://www.w3.org/2002/07/owl#Class>;
