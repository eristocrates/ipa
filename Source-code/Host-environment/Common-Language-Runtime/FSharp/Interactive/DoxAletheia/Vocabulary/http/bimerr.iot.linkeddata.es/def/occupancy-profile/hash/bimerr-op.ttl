bimerr-op:ASHRAEAdaptiveComfort a bimerr-op:ThermalNeed,
                                  <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:ASHRAEComfortEnvelop a bimerr-op:ThermalNeed,
                                 <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:AccousticNeed a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Range of parameter values where occupants do not feel accoustic discomfort and therefore, they don't carry out any actions."@en;
                        rdfs:label "Accoustic Need"@en;
                        rdfs:subClassOf bimerr-op:PhysicalNeed.
bimerr-op:Action a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Actions are the interactions with systems or activities that an occupant can conduct to achieve environmental comfort. Actions connect occupants' inside-world needs with the environmental outside world. (Defintion taken from obXML)"@en;
                 rdfs:label "Action"@en.
bimerr-op:Adjustable a bimerr-op:OperationalModeConcept,
                       <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Afternoon a bimerr-op:TimeOfDay,
                      <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Arrival a bimerr-op:StatusTransitionTypeConcept,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Behavior a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Behavior related to the interaction with buildings"@en;
                   rdfs:label "Behavior"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:identifier ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> bimerr-op:Need ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:influencedByNeed ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (bimerr-op:Action
                                                                                                                             bimerr-op:Inaction) ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Class>] ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:leadsTo ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:DriverSet ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:drivenBy ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:Coefficient a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Class to represent the value and name of coefficients inside mathematical formulas."@en;
                      rdfs:label "Coefficient"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:coefficientValue ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:ConstantValueFormula a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Class to represent constant value mathematical formulas"@en;
                               rdfs:label "Constant Value Formula"@en;
                               rdfs:subClassOf bimerr-op:InteractionFormula.
bimerr-op:ContinuousControl a bimerr-op:OperationalModeConcept,
                              <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:CustomProbabilityModel a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Class to represent instances of custom probabilistic models."@en;
                                 rdfs:label "Custom probability model"@en;
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:probability ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 bimerr-op:MovementModel.
bimerr-op:Day a bimerr-op:TimeOfDay,
                <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:DayLight a <https://w3id.org/saref#Property>,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Departure a bimerr-op:StatusTransitionTypeConcept,
                      <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Driver a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A Driver represents the environmental factor from the outside world that stimulate occupants in their inside world to fulfill a physical, physiological or psychological need."@en;
                 rdfs:label "Driver"@en.
bimerr-op:DriverSet a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Set of drivers that could be causing a behavior at a specific time."@en;
                    rdfs:label "Driver set"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:Driver ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:composedOf ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:EnteringRoom a bimerr-op:Event,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Environment a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Driver related to the environmental conditions that could be causing a behavior."@en;
                      rdfs:label "Environment"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:EnvironmentalParameter ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasEnvironmentalParameter ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      bimerr-op:Driver.
bimerr-op:EnvironmentalParameter a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Class that represent a physical variable of the environment where the driver occurs. It could represent variables that impact directly on the comfort levels of the occupant."@en;
                                 rdfs:label "Environmental parameter"@en;
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:string ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:identifier ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/saref#UnitOfMeasure> ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasUnitOfMeasure ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 <https://w3id.org/saref#Property>.
bimerr-op:Equipment a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Class to represent electrical equipments occupants interact with but do not have influence over indoor thermal conditions. These systems contribute to the energy bugdet estimation."@en;
                    rdfs:label "Equipment"@en;
                    rdfs:subClassOf <https://w3id.org/saref#Device>.
bimerr-op:Evening a bimerr-op:TimeOfDay,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Event a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Driver related to events that could be causing a behavior."@en;
                rdfs:label "Event"@en;
                rdfs:subClassOf bimerr-op:Driver.
bimerr-op:Fall a bimerr-op:Season,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Fixed a bimerr-op:OperationalModeConcept,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Glare a <https://w3id.org/saref#Property>,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Habit a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Driver related to habits that could be causing a behavior."@en;
                rdfs:label "Habit"@en;
                rdfs:subClassOf bimerr-op:Driver.
bimerr-op:IAQNeed a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Range of parameter values where occupants do not feel indoor air quality discomfort and therefore, they don't carry out any actions."@en;
                  rdfs:label "IAQ Need"@en;
                  rdfs:subClassOf bimerr-op:PhysicalNeed.
bimerr-op:ISOAdaptiveComfort a bimerr-op:ThermalNeed,
                               <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Illuminance a <https://w3id.org/saref#Property>,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Inaction a bimerr-op:Inaction,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The Inaction class represents the decision of an occupant to not act and remain uncomfortable within a space."@en;
                   rdfs:label "Inaction"@en.
bimerr-op:IndoorAirQuality a <https://w3id.org/saref#Property>,
                             <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Interaction a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The Interaction class represent the interactions of occupants with systems within a space to recover their comfort."@en;
                      rdfs:label "Interaction"@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:controlValue ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <https://w3id.org/def/saref4building#BuildingObject> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:interactsOver ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:InteractionFormula ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:describedByFormula ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      bimerr-op:Action.
bimerr-op:InteractionConcept a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Types of interactions between occupants and systems."@en;
                             rdfs:label "Interaction concept"@en;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
bimerr-op:InteractionFormula a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Formula to model the probability of interaction between ocupant and system."@en;
                             rdfs:label "Interaction Formula"@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:EnvironmentalParameter ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasIndependentVariable ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:Coefficient ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasCoefficient ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:InteractionScheme a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "An aggregation of SKOS concepts regarding the interaction type between occupants and space systems"@en;
                            rdfs:label "Interaction scheme"@en;
                            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
bimerr-op:LeavingRoom a bimerr-op:Event,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:LightingDevice a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A devide used for illumination."@en;
                         rdfs:label "Lighting device"@en;
                         rdfs:subClassOf <https://w3id.org/saref#Device>.
bimerr-op:LinearFormula a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Class to represent linear mathematical formulas"@en;
                        rdfs:label "Linear Formula"@en;
                        rdfs:subClassOf bimerr-op:InteractionFormula.
bimerr-op:LogitFormula a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Class to represent logit mathematical formulas."@en;
                       rdfs:label "Logit Formula"@en;
                       rdfs:subClassOf bimerr-op:InteractionFormula.
bimerr-op:MarkovChainModel a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Class to represent instances of Markov chain models."@en;
                           rdfs:label "Markov chain model"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:time ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:typicalTime ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:time ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:earlyOccurTime ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           bimerr-op:MovementModel.
bimerr-op:Meeting a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Class to represent a meeting inside a communal space."@en;
                  rdfs:label "Meeting"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:dateTime ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:startTime ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
