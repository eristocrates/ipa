                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:integer ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:occupantAge ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:occupantJobtype ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   <http://xmlns.com/foaf/0.1#Person>,
                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:occupantLifestyle ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:Behavior ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasBehavior ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:string ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:identifier ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:OnOff a bimerr-op:OperationalModeConcept,
                  <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Operable a bimerr-op:OperationalModeConcept,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:OperationalModeConcept a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Types of operational modes for space systems."@en;
                                 rdfs:label "Operational mode concept"@en;
                                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
bimerr-op:OperationalModeConceptScheme a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment "An aggregation of SKOS concepts regarding the operational mode of space systems."@en;
                                       rdfs:label "Operational mode scheme"@en;
                                       rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
bimerr-op:ParameterRange a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Class to represent the minimum and maximm comfort values with respect to an environmental parameter."@en;
                         rdfs:label "Parameter Range"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:minRangeValue ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:maxRangeValue ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:EnvironmentalParameter ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:describesParameter ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:PhysicalNeed a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Physical comfort need that could influence a behavior."@en;
                       rdfs:label "Physical Need"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:ParameterRange ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:definedByRange ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       bimerr-op:Need.
bimerr-op:QuadraticFormula a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Class to represent quadratic mathematical formulas."@en;
                           rdfs:label "Quadratic Formula"@en;
                           rdfs:subClassOf bimerr-op:InteractionFormula.
bimerr-op:Rain a <https://w3id.org/saref#Property>,
                 <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:RandomMovement a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Type of occupant movements inside a building or space."@en;
                         rdfs:label "Random movement"@en;
                         rdfs:subClassOf bimerr-op:Movement.
bimerr-op:RelativeHumidity a <https://w3id.org/saref#Property>,
                             <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Report a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The Report class indicates that an occupant seeks assistance or files a complaint about their personal discomfort, but does not take direct action to satisfy their needs."@en;
                 rdfs:label "Report"@en;
                 rdfs:subClassOf bimerr-op:Action.
bimerr-op:Season a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Season of the year."@en;
                 rdfs:label "Season"@en;
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gMonthDay ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:startSeason ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gMonthDay ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:endSeason ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:SetToControlValue a bimerr-op:InteractionConcept,
                              <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:ShortTermLeaving a bimerr-op:StatusTransitionTypeConcept,
                             <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:ShortTermVisiting a bimerr-op:StatusTransitionTypeConcept,
                              <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:SolarIrradiance a <https://w3id.org/saref#Property>,
                            <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:SpaceOccupancy a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Occupancy percentage of staying in a specific space category in a building."@en;
                         rdfs:label "Space occupancy"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:float ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:percentTimePresence ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:duration ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:duration ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://bimerr.iot.linkeddata.es/def/building#BuildingSpace> ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:relatedToSpace ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         bimerr-op:RandomMovement.
bimerr-op:Spatial a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Driver related to spatial conditions that could be causing a behavior."@en;
                  rdfs:label "Spatial"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://bimerr.iot.linkeddata.es/def/building#BuildingSpace> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:detailedBy ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  bimerr-op:Driver.
bimerr-op:Spring a bimerr-op:Season,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:StatusTransition a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Type of movements to represent transition events between spaces."@en;
                           rdfs:label "Status transition"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:duration ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:typicalDuration ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:duration ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:minimalDuration ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:MovementModel ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:specifiedBy ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:StatusTransitionTypeConcept ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasTransitionType ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           bimerr-op:Movement.
bimerr-op:StatusTransitionScheme a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "An aggregation of SKOS concepts regarding the status transition type of movements between spaces."@en;
                                 rdfs:label "Status transition scheme"@en;
                                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
bimerr-op:StatusTransitionTypeConcept a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "One time event involving occupancy status transition in building level."@en;
                                      rdfs:label "Status transition type concept"@en;
                                      rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
bimerr-op:StayingInRoom a bimerr-op:Event,
                          <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Summer a bimerr-op:Season,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:Temperature a <https://w3id.org/saref#Property>,
                        <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:ThermalNeed a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Range of parameter values where occupants do not feel thermal discomfort and therefore, they don't carry out any actions."@en;
                      rdfs:label "Thermal Need"@en;
                      rdfs:subClassOf bimerr-op:PhysicalNeed.
bimerr-op:Thermostat a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A thermostat is a component which senses the temperature of a physical space and performs actions so that the space temperature is maintained near a desired setpoint. (Definition adapted from Wikipedia)"@en;
                     rdfs:label "Thermostat"@en;
                     rdfs:subClassOf <https://w3id.org/def/saref4building#UnitaryControlElement>.
bimerr-op:Time a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Driver related to time conditions that could be causing a behavior. It also describes the time when another type of driver occur."@en;
               rdfs:label "Time"@en;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:date ; 
                                <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:onHolidays ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#allValuesFrom> bimerr-op:TimeOfDay ; 
                                <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasTimeOfDay ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#allValuesFrom> bimerr-op:Season ; 
                                <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasSeason ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               [<http://www.w3.org/2002/07/owl#allValuesFrom> <http://www.w3.org/2006/time#DayOfWeek> ; 
                                <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasDayOfWeek ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               bimerr-op:Driver.
bimerr-op:TimeOfDay a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Relative time of day."@en;
                    rdfs:label "Time Of Day"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:time ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:startTime ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:time ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:endTime ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>].
bimerr-op:TurnOff a bimerr-op:InteractionConcept,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:TurnOn a bimerr-op:InteractionConcept,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:VisualNeed a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Range of parameter values where occupants do not feel visual discomfort and therefore, they don't carry out any actions."@en;
                     rdfs:label "Visual Need"@en;
                     rdfs:subClassOf bimerr-op:PhysicalNeed.
bimerr-op:WeibullFormula a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Class to represent weibull mathematical formulas."@en;
                         rdfs:label "Weibull Formula"@en;
                         rdfs:subClassOf bimerr-op:InteractionFormula.
bimerr-op:Window a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A window is an opening in a wall, door, roof or vehicle that allows the passage of light, sound, and sometimes air. (Definition taken from Wikipedia)"@en;
                 rdfs:label "Window"@en;
                 rdfs:subClassOf <https://w3id.org/def/saref4building#BuildingObject>.
bimerr-op:Winter a bimerr-op:Season,
                   <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:ZoneOnOff a bimerr-op:OperationalModeConcept,
                      <http://www.w3.org/2002/07/owl#NamedIndividual>.
bimerr-op:buildingAddress a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "A relationship indicating the address of a building"@en;
                          rdfs:label "building address"@en;
                          rdfs:range xsd:string.
bimerr-op:coefficientValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                           rdfs:comment "A relationship indicating the value of a coefficient."@en;
                           rdfs:label "coefficient value"@en;
                           rdfs:range xsd:float.
bimerr-op:composedOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relationship that indicates the composition of a set of drivers."@en;
                     rdfs:domain bimerr-op:DriverSet;
                     rdfs:label "composed of"@en;
                     rdfs:range bimerr-op:Driver.
bimerr-op:controlValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "A relationship indicating the magnitud of a control action over a building system."@en;
                       rdfs:label "control value"@en;
                       rdfs:range xsd:float.
bimerr-op:definedByRange a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                           <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Property used to describe occupant needs by defining comfort limits w.r.t. an environmental parameter."@en;
                         rdfs:domain bimerr-op:PhysicalNeed;
                         rdfs:label "defined by range"@en;
                         rdfs:range bimerr-op:ParameterRange.
bimerr-op:describedByFormula a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Property to relate an interaction with a formula describing the probability of occurance."@en;
                             rdfs:domain bimerr-op:Interaction;
                             rdfs:label "described by formula"@en;
                             rdfs:range bimerr-op:InteractionFormula.
bimerr-op:describesParameter a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                               <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Relates a comfort envelop with an environmental parameter."@en;
                             rdfs:domain bimerr-op:ParameterRange;
                             rdfs:label "describes parameter"@en;
                             rdfs:range bimerr-op:ParameterRange.
bimerr-op:detailedBy a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                       <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relates a spatial driver to an specific building space"@en;
                     rdfs:label "detailed by"@en.
bimerr-op:drivenBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Property to link an occupant with a set of internal or external drivers that are controlling its interactions with building systems."@en;
                   rdfs:domain bimerr-op:Behavior;
                   rdfs:label "driven by"@en;
                   rdfs:range bimerr-op:DriverSet.
bimerr-op:duration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "Average duration of an event."@en;
                   rdfs:label "duration"@en;
                   rdfs:range xsd:duration.
bimerr-op:earlyOccurTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Earliest occurrence time of an event."@en;
                         rdfs:label "early occur time"@en;
                         rdfs:range xsd:time.
bimerr-op:endSeason a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "Relationship that indicates the month when a season ends."@en;
                    rdfs:domain bimerr-op:Season;
                    rdfs:label "end season"@en;
                    rdfs:range xsd:gMonthDay.
bimerr-op:endTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "The end time of an event or activity."@en;
                  rdfs:label "end time"@en;
                  rdfs:range xsd:dateTime.
bimerr-op:hasBehavior a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Property to indicate that an occupant has a behavior."@en;
                      rdfs:domain bimerr-op:Occupant;
                      rdfs:label "has behavior"@en;
                      rdfs:range bimerr-op:Behavior.
bimerr-op:hasCoefficient a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Relates a formula with a coefficient."@en;
                         rdfs:domain bimerr-op:InteractionFormula;
                         rdfs:label "has coefficient"@en;
                         rdfs:range bimerr-op:Coefficient.
bimerr-op:hasDayOfWeek a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Indicates which days of the week are behavioral drivers for an occupant."@en;
                       rdfs:domain bimerr-op:Time;
                       rdfs:label "has day of week"@en;
                       rdfs:range <http://www.w3.org/2006/time#DayOfWeek>.
bimerr-op:hasEnvironmentalParameter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "Relates and occupant environmental driver with an environmental property like temperature or illuminance."@en;
                                    rdfs:domain bimerr-op:Environment;
                                    rdfs:label "has environmental parameter"@en;
                                    rdfs:range bimerr-op:EnvironmentalParameter.
bimerr-op:hasIndependentVariable a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Relates a formula with an independent variable."@en;
                                 rdfs:domain bimerr-op:InteractionFormula;
                                 rdfs:label "has independent variable"@en;
                                 rdfs:range bimerr-op:EnvironmentalParameter.
bimerr-op:hasMeeting a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Indicates that a meeting can occur within a space."@en;
                     rdfs:domain <http://bimerr.iot.linkeddata.es/def/building#BuildingSpace>;
                     rdfs:label "has meeting"@en;
                     rdfs:range bimerr-op:Meeting.
bimerr-op:hasOccupant a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relationship that indicates that an space can have an occupant."@en;
                      rdfs:domain <http://bimerr.iot.linkeddata.es/def/building#BuildingSpace>;
                      rdfs:label "has occupant"@en;
                      rdfs:range bimerr-op:Occupant.
bimerr-op:hasOperationalMode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Relationship to indicate the type of control mode of a system, such as fixed or operable modes for a window."@en;
                             rdfs:domain <https://w3id.org/def/saref4building#PhysicalObject>;
                             rdfs:label "has operational mode"@en;
                             rdfs:range bimerr-op:OperationalModeConcept.
bimerr-op:hasSeason a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Indicates which seasons are behavioral drivers for an occupant."@en;
                    rdfs:domain bimerr-op:Time;
                    rdfs:label "has season"@en;
                    rdfs:range bimerr-op:Season.
bimerr-op:hasTimeOfDay a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Indicates which times during a day are behavioral drivers for an occupant."@en;
                       rdfs:domain bimerr-op:Time;
                       rdfs:label "has time of day"@en;
                       rdfs:range bimerr-op:TimeOfDay.
bimerr-op:hasTransitionType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Relationship that indicates the type of status transition event."@en;
                            rdfs:domain bimerr-op:StatusTransition;
                            rdfs:label "has transition type"@en;
                            rdfs:range bimerr-op:StatusTransitionTypeConcept.
bimerr-op:hasUnitOfMeasure a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                             <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Relates an environmental parameter with a unit of measure."@en;
                           rdfs:label "has unit of measure"@en;
                           rdfs:range <https://w3id.org/saref#UnitOfMeasure>.
bimerr-op:identifier a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                       <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Identifier of an element given in the obXML file. Attribute considered for backward compatibility."@en;
                     rdfs:label "identifier"@en.
bimerr-op:influencedByNeed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Indicates that a driver can be influenced by an occupant comfort need."@en;
                           rdfs:domain bimerr-op:Behavior;
                           rdfs:label "influenced by need"@en;
                           rdfs:range bimerr-op:Need.
bimerr-op:interactsOver a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Relationship that describes an interaction between an occupant and a building component or system."@en;
                        rdfs:domain bimerr-op:Interaction;
                        rdfs:label "interacts over"@en;
                        rdfs:range <https://w3id.org/def/saref4building#PhysicalObject>.
bimerr-op:leadsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relationship to indicate the outcome of a behavior. It could lead to an action over a building system to recover comfort or to a passive acceptance of the environmental conditions."@en;
                  rdfs:domain bimerr-op:Behavior;
                  rdfs:label "leads to"@en.
bimerr-op:maxNumberOccupants a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Relationship that indicates the maximum number of occupants inside a space."@en;
                             rdfs:label "max number occupants"@en;
                             rdfs:range xsd:integer.
bimerr-op:maxRangeValue a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Upper boundary of a parameter range description."@en;
                        rdfs:label "max range value"@en;
                        rdfs:range xsd:float.
bimerr-op:minNumberOccupants a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Relationship that indicates the minimum number of occupants inside a space."@en;
                             rdfs:label "min number occupants"@en;
                             rdfs:range xsd:integer.
bimerr-op:minRangeValue a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                        rdfs:comment "Lower boundary of a parameter range description."@en;
                        rdfs:label "min range value"@en;
                        rdfs:range xsd:float.
bimerr-op:minimalDuration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "The minimal duration of an event."@en;
                          rdfs:label "minimal duration"@en;
                          rdfs:range xsd:duration.
bimerr-op:occupantAge a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                        <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Age of an occupant"@en;
                      rdfs:domain bimerr-op:Occupant;
                      rdfs:label "occupant age"@en;
                      rdfs:range xsd:integer.
bimerr-op:occupantGender a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                           <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "Gender of an occupant"@en;
                         rdfs:domain bimerr-op:Occupant;
                         rdfs:label "occupant gender"@en;
                         rdfs:range xsd:string.
bimerr-op:occupantJobtype a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "Jobtype of an occupant"@en;
                          rdfs:domain bimerr-op:Occupant;
                          rdfs:label "occupant jobtype"@en;
                          rdfs:range xsd:string.
bimerr-op:occupantLifestyle a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                            rdfs:comment "Lifestyle of an occupant"@en;
                            rdfs:domain bimerr-op:Occupant;
                            rdfs:label "occupant lifestyle"@en;
                            rdfs:range xsd:string.
bimerr-op:onHolidays a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "Indicates which days that act as time drivers are holidays."@en;
                     rdfs:label "on holidays"@en;
                     rdfs:range xsd:date.
bimerr-op:percentTimePresence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                              rdfs:comment "Percentage of occupancy time in a space."@en;
                              rdfs:label "percent time presence"@en;
                              rdfs:range xsd:float.
bimerr-op:probability a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Relationship that links a probility to an event. For example the occurance probability of a meeting."@en;
                      rdfs:label "probability"@en;
                      rdfs:range xsd:float.
bimerr-op:relatedToSpace a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Property that relates space occupancy events to an specific building space."@en;
                         rdfs:label "related to space"@en;
                         rdfs:range <http://bimerr.iot.linkeddata.es/def/building#BuildingSpace>.
bimerr-op:specifiedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relates a transition event to a movement model that describe this action."@en;
                      rdfs:label "specified by"@en.
bimerr-op:startSeason a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Relationship that indicates the month when a season start."@en;
                      rdfs:domain bimerr-op:Season;
                      rdfs:label "start season"@en;
                      rdfs:range xsd:gMonthDay.
bimerr-op:startTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The start time of an event or activity."@en;
                    rdfs:label "start time"@en;
                    rdfs:range xsd:dateTime.
bimerr-op:typicalDuration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "The typical duration of an event or activity."@en;
                          rdfs:label "typical duration"@en;
                          rdfs:range xsd:duration.
bimerr-op:typicalTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Typical occurrence time of an event."@en;
                      rdfs:label "typical time"@en;
                      rdfs:range xsd:time.
<http://purl.org/dc/elements/1.1/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
xsd:date a rdfs:Datatype.
xsd:duration a rdfs:Datatype.
xsd:gMonthDay a rdfs:Datatype.
xsd:time a rdfs:Datatype.
<http://www.w3.org/2004/02/skos/core#Concept> a <http://www.w3.org/2002/07/owl#Class>;
                                              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core#>;
                                              rdfs:label "Concept"@en;
                                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/2004/02/skos/core#Concept> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#narrower> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/2004/02/skos/core#ConceptScheme> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#inScheme> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://www.w3.org/2004/02/skos/core#Concept> ; 
                                                               <http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/2004/02/skos/core#broader> ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>].
<http://www.w3.org/2004/02/skos/core#ConceptScheme> a <http://www.w3.org/2002/07/owl#Class>;
                                                    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core#>;
                                                    rdfs:label "Concept Scheme"@en.
<http://www.w3.org/2004/02/skos/core#broader> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                              rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
                                              rdfs:label "broader"@en;
                                              rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
<http://www.w3.org/2004/02/skos/core#inScheme> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
                                               rdfs:label "in scheme"@en;
                                               rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme>.
<http://www.w3.org/2004/02/skos/core#narrower> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
                                               rdfs:label "narrower"@en;
                                               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
<http://www.w3.org/2006/time#DayOfWeek> a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "The day of the week."@en;
                                        rdfs:label "Day of week"@en.
<http://www.w3.org/2006/time#Friday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                       <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Monday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                       <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Saturday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                         <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Sunday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                       <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Thursday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                         <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Tuesday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                        <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://www.w3.org/2006/time#Wednesday> a <http://www.w3.org/2006/time#DayOfWeek>,
                                          <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://xmlns.com/foaf/0.1#Person> a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "The Person class represents people. Something is a Person if it is a person. We don't nitpic about whether they're alive, dead, real, or imaginary. (Definition taken from FOAF)"@en;
                                   rdfs:label "Person"@en.
<https://w3id.org/def/saref4building#BuildingObject> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "An object in the building that can be controlled by devices, such as a door or a window that can be automatically opened or closed by an actuator. (Definition taken from SAREF 1.0)"@en;
                                                     rdfs:label "Building object"@en;
                                                     rdfs:subClassOf <https://w3id.org/def/saref4building#PhysicalObject>.
<https://w3id.org/def/saref4building#PhysicalObject> a <http://www.w3.org/2002/07/owl#Class>;
                                                     rdfs:comment "Any Object that has a proper space region. (Definition extracted from DUL ontology)"@en;
                                                     rdfs:label "Physical object"@en;
                                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> bimerr-op:OperationalModeConcept ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> bimerr-op:hasOperationalMode ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>].
<https://w3id.org/def/saref4building#ShadingDevice> a <http://www.w3.org/2002/07/owl#Class>;
                                                    rdfs:comment "Shading devices are purpose built devices to protect from the sunlight, from natural light, or screening them from view. Shading devices can form part of the facade or can be mounted inside the building, they can be fixed or operable. (Definition taken from S4BLDG ontology)"@en;
                                                    rdfs:label "Shading device"@en;
                                                    rdfs:subClassOf <https://w3id.org/saref#Device>.
<https://w3id.org/def/saref4building#UnitaryControlElement> a <http://www.w3.org/2002/07/owl#Class>;
                                                            rdfs:comment "A unitary control element provides a housing for an aggregation of control or electrical distribution elements that, in combination, perform a singular (unitary) purpose. Each item in the aggregation may have its own geometric representation and location. (Definition taken from S4BLDG ontology)"@en;
                                                            rdfs:label "Unitary control element"@en;
                                                            rdfs:subClassOf <https://w3id.org/saref#Device>.
<https://w3id.org/def/saref4building#contains> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:comment "A relation between a physical space and the objects located in such space."@en;
                                               rdfs:label "contains"@en.
<https://w3id.org/def/saref4building#hasSpace> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                               rdfs:comment "Relation between a building or a building space and the spaces it can be divided into."@en;
                                               rdfs:label "has space"@en.
<https://w3id.org/saref#Device> a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "A tangible object designed to accomplish a particular task in households, common public buildings or offices. In order to accomplish this task, the device performs one or more functions. For example, a washing machine is designed to wash (task) and to accomplish this task it performs the start and stop function."@en;
                                rdfs:label "Device"@en;
                                rdfs:subClassOf <https://w3id.org/def/saref4building#PhysicalObject>.
<https://w3id.org/saref#HVAC> a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Heating, Ventilation and Air Conditioning (HVAC) device that provides indoor environmental comfort. A saref:HVAC is typically used to accomplish saref:Comfort."@en;
                              rdfs:label "HVAC"@en;
                              rdfs:subClassOf <https://w3id.org/saref#Device>.
<https://w3id.org/saref#Property> a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "An aspect of an entity that can be observable by a sensor."@en;
                                  rdfs:label "Property"@en.
<https://w3id.org/saref#UnitOfMeasure> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:comment """The unit of measure is a standard for measurement of a quantity, such as a Property. For example, Power is a property and Watt is a unit of power that represents a definite predetermined power: when we say 10 Watt, we actually mean 10 times the definite predetermined power called \"watt\". Our definition is based on the definition of unit of measure in the Ontology of units of Measure (OM). We propose here a list of some units of measure that are relevant for the purpose of the Smart Appliances ontology, but this list can be extended."""@en;
                                       rdfs:label "Unit of measure"@en.
