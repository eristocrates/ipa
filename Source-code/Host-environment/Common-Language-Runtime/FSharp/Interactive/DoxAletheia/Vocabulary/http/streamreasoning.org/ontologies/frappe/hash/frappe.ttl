@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix frappe: <http://streamreasoning.org/ontologies/frappe#>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
frappe: <http://creativecommons.org/ns#license> "http://www.apache.org/licenses/LICENSE-2.0";
        <http://purl.org/dc/elements/1.1/creator> """Marco Balduini - marco.balduini@polimi.it
Emanuele Della Valle - emanuele.dellavalle@polimi.it""";
        <http://purl.org/dc/terms/issued> "2015-04-07"^^xsd:date;
        <http://purl.org/dc/terms/modified> "2015-04-28T15:30:00.000+02:00"^^xsd:dateTime,
                                            "2015-04-07"^^xsd:date;
        a <http://www.w3.org/2002/07/owl#Ontology>;
        rdfs:comment "FraPPE is a vocabulary to enable Visual Analitycs operations on geo-spatial time varying data. By enabling Visual Analytics instruments FraPPE ease the capture, correalation and comapration operations on geo-spatial data from different sources evolving over time";
        rdfs:label "FraPPE: Frame, Pixel, Place, Event vocabulary";
        <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/2006/time>,
                                                <http://www.w3.org/ns/prov#>,
                                                <http://www.opengis.net/ont/gml>,
                                                <http://purl.org/NET/c4dm/event.owl>,
                                                <http://www.opengis.net/ont/geosparql>,
                                                <http://www.opengis.net/ont/sf>;
        <http://www.w3.org/2002/07/owl#priorVersion> "0.1";
        <http://www.w3.org/2002/07/owl#versionInfo> "0.2".
frappe:Capture a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Activity to create new Captured Frame";
               rdfs:isDefinedBy "stable",
                                "http://streamreasoning.org/ontologies/frappe#";
               rdfs:label "Capture";
               rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>.
frappe:CapturedFrame a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Original time varying representation of a Grid, mediated by the Capture activity";
                     rdfs:isDefinedBy "stable",
                                      "http://streamreasoning.org/ontologies/frappe#";
                     rdfs:label "CapturedFrame";
                     rdfs:subClassOf frappe:Frame.
frappe:Cell a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A Cell represents the basic spatial unit of aggregation of information";
            rdfs:isDefinedBy "stable",
                             "http://streamreasoning.org/ontologies/frappe#";
            rdfs:label "Cell";
            rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>.
frappe:Frame a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Frame represents a time varying representation of a Grid";
             rdfs:isDefinedBy "stable",
                              "http://streamreasoning.org/ontologies/frappe#";
             rdfs:label "Frame";
             rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>.
frappe:Grid a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The Grid represents a group of contiguous Cells";
            rdfs:isDefinedBy "stable",
                             "http://streamreasoning.org/ontologies/frappe#";
            rdfs:label "Grid";
            rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>,
                            <http://www.opengis.net/ont/geosparql#Feature>.
frappe:Pixel a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment """A Pixel is a time varying representation of a Cell
""";
             rdfs:isDefinedBy "stable",
                              "http://streamreasoning.org/ontologies/frappe#";
             rdfs:label "Pixel";
             rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>.
frappe:Place a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Place represents a point in space";
             rdfs:isDefinedBy "stable",
                              "http://streamreasoning.org/ontologies/frappe#";
             rdfs:label "Place";
             rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature>.
frappe:SyntheticFrame a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Synthetic time varying representation of a Grid, mediated by the Synthetize activity. A Synthetic Frame can be be created starting from Captured Frames or Synthetic Frames";
                      rdfs:isDefinedBy "stable",
                                       "http://streamreasoning.org/ontologies/frappe#";
                      rdfs:label "SyntheticFrame";
                      rdfs:subClassOf frappe:Frame.
frappe:Synthetize a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Activity to create new Synthetic Frame";
                  rdfs:isDefinedBy "stable",
                                   "http://streamreasoning.org/ontologies/frappe#";
                  rdfs:label "Synthetize";
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>.
frappe:contains a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates a Frame with its Pixels";
                rdfs:domain frappe:Frame;
                rdfs:isDefinedBy "stable",
                                 "http://streamreasoning.org/ontologies/frappe#";
                rdfs:label "Contains";
                rdfs:range frappe:Pixel.
frappe:hasValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain frappe:Pixel;
                rdfs:range rdfs:Literal.
frappe:isIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relates a Pixel with its Frame";
            rdfs:domain frappe:Pixel;
            rdfs:isDefinedBy "stable",
                             "http://streamreasoning.org/ontologies/frappe#";
            rdfs:label "isIn";
            rdfs:range frappe:Frame;
            <http://www.w3.org/2002/07/owl#inverseOf> frappe:contains.
frappe:isLocationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates a Place with its Events";
                    rdfs:domain frappe:Place;
                    rdfs:isDefinedBy "stable",
                                     "http://streamreasoning.org/ontologies/frappe#";
                    rdfs:label "isLocationOf";
                    rdfs:range <http://purl.org/NET/c4dm/event.owl#Event>.
frappe:isReferredBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates a Cell with its Pixels";
                    rdfs:domain frappe:Cell;
                    rdfs:isDefinedBy "stable",
                                     "http://streamreasoning.org/ontologies/frappe#";
                    rdfs:label "isReferredBy";
                    rdfs:range frappe:Pixel.
frappe:location a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates an Event with its Pixel";
                rdfs:domain <http://purl.org/NET/c4dm/event.owl#Event>;
                rdfs:isDefinedBy "stable",
                                 "http://streamreasoning.org/ontologies/frappe#";
                rdfs:label "location";
                rdfs:range frappe:Place;
                <http://www.w3.org/2002/07/owl#inverseOf> frappe:isLocationOf.
frappe:refers a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates Pixel to its Cell";
              rdfs:domain frappe:Pixel;
              rdfs:isDefinedBy "stable",
                               "http://streamreasoning.org/ontologies/frappe#";
              rdfs:label "refers";
              rdfs:range frappe:Cell;
              <http://www.w3.org/2002/07/owl#inverseOf> frappe:isReferredBy.
frappe:samplingTime a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates a Frame with its creation Instant";
                    rdfs:domain frappe:CapturedFrame;
                    rdfs:isDefinedBy "stable",
                                     "http://streamreasoning.org/ontologies/frappe#";
                    rdfs:label "samplingTs";
                    rdfs:range <http://www.w3.org/2006/time#Instant>.
frappe:timeExposure a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relate a Capture Frame to the time interval needed to capture a minimum quantity of data";
                    rdfs:domain frappe:CapturedFrame;
                    rdfs:isDefinedBy "stable",
                                     "http://streamreasoning.org/ontologies/frappe#";
                    rdfs:label "timeExposure";
                    rdfs:range <http://www.w3.org/2006/time#Interval>.
frappe:wasCapturedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relates a Frame to a Grid";
                       rdfs:domain frappe:CapturedFrame;
                       rdfs:isDefinedBy "stable",
                                        "http://streamreasoning.org/ontologies/frappe#";
                       rdfs:label "wasCapturedFrom";
                       rdfs:range frappe:Grid.
frappe:wasSynthetizedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Relates a Synthetic Frame to the elements needed to the Synthetization";
                          rdfs:domain frappe:SyntheticFrame;
                          rdfs:isDefinedBy "stable",
                                           "http://streamreasoning.org/ontologies/frappe#";
                          rdfs:label "wasSynthetizedFrom";
                          rdfs:range frappe:Frame.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2003/06/sw-vocab-status/ns#status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
