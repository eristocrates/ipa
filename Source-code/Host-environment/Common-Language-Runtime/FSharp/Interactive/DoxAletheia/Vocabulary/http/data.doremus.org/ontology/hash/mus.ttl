mus:U83_has_relative_key a owl:ObjectProperty,
                           owl:NamedIndividual,
                           owl:SymmetricObjectProperty;
                         rdfs:comment "Examples: the key of 'C major' has 'A minor' as relative key"@en,
                                      "Scope Note: Cette classe permet de connecter deux M4 Tonalité qui sont en relation par rapport à l'armure, c'est-à-dire l'une est la relatif majeur ou mineur de l'autre."@fr,
                                      "Scope Note: This class allows to connect two M4 Keys that are in a relative relationship, i.e. one is the relative major or minor of the other one."@en,
                                      "see also http://en.wikipedia.org/wiki/Relative_key",
                                      "Exemples: la clé de 'Do majeur' a 'La mineur' pour tonalité relative"@fr;
                         rdfs:domain mus:M4_Key;
                         rdfs:isDefinedBy mus:;
                         rdfs:label "U83 a pour tonalité relative"@fr,
                                    "U83 has relative key"@en;
                         rdfs:range mus:M4_Key.
mus:U84_has_parallel_key a owl:ObjectProperty,
                           owl:SymmetricObjectProperty,
                           owl:NamedIndividual;
                         rdfs:comment "Scope Note: This class allows to connect two M4 Keys that are in a parallel relationship, i.e. one is the parallel major or minor of the other one."@en,
                                      "Examples: the key of 'C major' has 'C minor' as parallel key"@en,
                                      "see also http://en.wikipedia.org/wiki/Parallel_key",
                                      "Exemples: la clé de 'Do majeur' a 'Do mineur' pour tonalité parallèle"@fr,
                                      "Scope Note: Cette classe permet de connecter deux M4 Tonalité qui sont en une relation parallèle, c'est-à-dire l'une est la parallèle majeur ou mineur de l'autre."@fr;
                         rdfs:domain mus:M4_Key;
                         rdfs:isDefinedBy mus:;
                         rdfs:label "U84 a pour tonalité parallèle"@fr,
                                    "U84 has parallel key"@en;
                         rdfs:range mus:M4_Key.
mus:U85_has_closely_related_key a owl:SymmetricObjectProperty,
                                  owl:ObjectProperty,
                                  owl:NamedIndividual;
                                rdfs:comment "Exemples: la clé de 'Do majeur' a 'Sol majeur' et 'Re majeur' pour tonalités étroitement liées"@fr,
                                             "see also http://en.wikipedia.org/wiki/Closely_related_key",
                                             "Examples: the key of 'C major' has 'G major' and 'D minor' as closely related keys"@en,
                                             "Scope Note: Cette classe permet de connecter deux M4 Tonalité qui sont étroitement liées d'un point de vue harmonique, par ex. ceux sont des destinations ou des transpositions fréquemment utilisées dans une modulation"@fr,
                                             "Scope Note: This class allows to connect two M4 Keys that are mutually closely related from an harmonic point of view, e.g. they are commonly used destinations or transpositions in a modulation."@en;
                                rdfs:domain mus:M4_Key;
                                rdfs:isDefinedBy mus:;
                                rdfs:label "U85 a pour tonalité étroitement lié"@fr,
                                           "U85 has closely related key"@en;
                                rdfs:range mus:M4_Key.
