@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix gd: <http://reference.data.gov/def/govdata/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

gd:Country a rdfs:Class,
             owl:Class;
           rdfs:isDefinedBy <http://vocab.data.gov/gd>;
           rdfs:label "Country";
           rdfs:subClassOf rdfs:Resource.
gd:County a rdfs:Class,
            owl:Class;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "County".
gd:Record a rdfs:Class,
            owl:Class;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "Record".
gd:RecordSet a rdfs:Class,
               owl:Class;
             rdfs:isDefinedBy <http://vocab.data.gov/gd>;
             rdfs:label "RecordSet";
             rdfs:subClassOf rdfs:Resource.
gd:Report a rdfs:Class,
            owl:Class;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "Report".
gd:Site a rdfs:Class,
          owl:Class;
        rdfs:isDefinedBy <http://vocab.data.gov/gd>;
        rdfs:label "Site".
gd:State a rdfs:Class,
           owl:Class;
         rdfs:isDefinedBy <http://vocab.data.gov/gd>;
         rdfs:label "State";
         rdfs:subClassOf rdfs:Resource.
gd:Survey a rdfs:Class,
            owl:Class;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "Survey".
gd:count a rdf:Property,
           owl:DatatypeProperty;
         rdfs:isDefinedBy <http://vocab.data.gov/gd>;
         rdfs:label "count";
         rdfs:range xsd:integer.
gd:country a rdf:Property;
           rdfs:isDefinedBy <http://vocab.data.gov/gd>;
           rdfs:label "country";
           rdfs:range gd:Country.
gd:countyCode a rdf:Property;
              rdfs:isDefinedBy <http://vocab.data.gov/gd>;
              rdfs:label "countyCode";
              rdfs:range gd:County.
gd:denominator a rdf:Property,
                 owl:DatatypeProperty;
               rdfs:isDefinedBy <http://vocab.data.gov/gd>;
               rdfs:label "denominator";
               rdfs:range xsd:float.
gd:median a rdf:Property;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "median".
gd:percentage a rdf:Property;
              rdfs:isDefinedBy <http://vocab.data.gov/gd>;
              rdfs:label "percentage".
gd:record a rdf:Property;
          rdfs:domain gd:RecordSet;
          rdfs:isDefinedBy <http://vocab.data.gov/gd>;
          rdfs:label "record";
          rdfs:range gd:Record.
gd:recordset a rdf:Property;
             rdfs:isDefinedBy <http://vocab.data.gov/gd>;
             rdfs:label "recordset";
             rdfs:range gd:RecordSet.
gd:stateCode a rdf:Property;
             rdfs:isDefinedBy <http://vocab.data.gov/gd>;
             rdfs:label "stateCode";
             rdfs:range gd:State.
<http://vocab.data.gov/gd> dc11:creator <http://vocab.data.gov/gd#George.Thomas>;
                           dc11:description "A RDF Schema that defines concepts and relationships common to all Open Government Data.";
                           dc11:modified "2014-11-22"^^xsd:date;
                           dc11:title "Government Data Vocabulary";
                           vann:preferredNamespacePrefix "gd";
                           vann:preferredNamespaceUri "http://reference.data.gov/def/govdata/";
                           a owl:Ontology;
                           foaf:page <http://vocab.data.gov/gd.html>.
<http://vocab.data.gov/gd#George.Thomas> a foaf:Person;
                                         foaf:homepage <http://vocab.data.gov/gd>;
                                         foaf:name "George Thomas".
<http://vocab.data.gov/gd#HHS> a foaf:Organization;
                               foaf:homepage <http://www.hhs.gov/>;
                               foaf:member <http://vocab.data.gov/gd#George.Thomas>;
                               foaf:name "HHS".
