@base <http://eulersharp.sourceforge.net/2003/03swap/units>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dce: <http://purl.org/dc/elements/1.1/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix mrela: <http://sweet.jpl.nasa.gov/2.3/relaMath.owl#>.
@prefix screla: <http://sweet.jpl.nasa.gov/2.3/relaSci.owl#>.
@prefix unit: <http://sweet.jpl.nasa.gov/2.3/reprSciUnits.owl#>.
@prefix quant: <http://eulersharp.sourceforge.net/2003/03swap/quantities#>.
@prefix clisko: <http://www.agfa.com/w3c/2009/clinicalSKOSSchemes#>.
@prefix units: <http://eulersharp.sourceforge.net/2003/03swap/units#>.

units: dce:creator "Hans Cools, MD, Agfa Healthcare, Belgium"@en;
       dce:description "Formal description of units."@en;
       dce:format "OWL Full"@en;
       dce:publisher "Agfa Healthcare, Belgium"@en;
       dce:title "Units"@en;
       a owl:Ontology;
       rdfs:comment "Using NASA 'SWEET' ontologies."@en,
                    "Specific units are declared in respective ontologies, e.g. leukocytesPerLiter in http://www.agfa.com/w3c/2009/hemogram#."@en.
units:Unit a rdfs:Class;
           rdfs:isDefinedBy units:;
           rdfs:label "unit"@en;
           rdfs:subClassOf unit:Unit;
           skos:definition "Reference mesurement with value 1 in which a quantity measurement is expressed."@en.
units:atto screla:hasNumericValue 1e-18;
           screla:hasSymbol "a";
           a unit:Prefix;
           rdfs:isDefinedBy units:.
units:bit screla:hasSymbol "b";
          a units:Unit;
          rdfs:isDefinedBy units:;
          rdfs:subClassOf [a owl:Restriction ; 
                           owl:onProperty quant:unitOf ; 
                           owl:someValuesFrom [a owl:Restriction ; 
                                               owl:onProperty quant:measurementOf ; 
                                               owl:someValuesFrom quant:DigitalSize]];
          skos:definition "Basic unit of information storage and communication in digital computing and digital information theory. A binary digit, takes a value of either 0 or 1."@en.
units:byte mrela:hasScalingNumber "8"^^xsd:double;
           screla:hasBaseUnit units:bit;
           screla:hasSymbol "B";
           a units:Unit,
             unit:UnitDerivedByScaling;
           rdfs:isDefinedBy units:;
           rdfs:subClassOf [a owl:Restriction ; 
                            owl:onProperty quant:unitOf ; 
                            owl:someValuesFrom [a owl:Restriction ; 
                                                owl:onProperty quant:measurementOf ; 
                                                owl:someValuesFrom quant:DigitalSize]];
           skos:definition "Eight bits"@en.
units:centiliter screla:hasBaseUnit units:liter;
                 screla:hasPrefix unit:centi;
                 screla:hasSymbol "cL";
                 a units:Unit,
                   unit:UnitDerivedByScaling;
                 rdfs:isDefinedBy units:;
                 rdfs:label "centiliter"@en;
                 rdfs:subClassOf [a owl:Restriction ; 
                                  owl:onProperty quant:unitOf ; 
                                  owl:someValuesFrom [a owl:Restriction ; 
                                                      owl:onProperty quant:measurementOf ; 
                                                      owl:someValuesFrom quant:Volume]];
                 skos:exactMatch [a skos:Concept ; 
                                  skos:inScheme clisko:sct20080731 ; 
                                  skos:notation "258772007"^^clisko:sct20080731DT].
units:centimeter screla:hasSymbol "cm";
                 a units:Unit;
                 rdfs:isDefinedBy units:;
                 rdfs:label "centimeter"@en;
                 rdfs:subClassOf unit:centimeter,
                                 [a owl:Restriction ; 
                                  owl:onProperty quant:unitOf ; 
                                  owl:someValuesFrom quant:LengthMeasurement];
                 skos:exactMatch [a skos:Concept ; 
                                  skos:inScheme clisko:sct20080731 ; 
                                  skos:notation "258672001"^^clisko:sct20080731DT].
units:centimeterCubed mrela:toThePower "3"^^xsd:double;
                      screla:hasBaseUnit units:centimeter;
                      screla:hasSymbol "cm³",
                                       "cc";
                      a units:Unit,
                        unit:UnitDerivedByRaisingToPower;
                      rdfs:isDefinedBy units:;
                      rdfs:label "cubic centimeter"@en;
                      rdfs:subClassOf [a owl:Restriction ; 
                                       owl:onProperty quant:unitOf ; 
                                       owl:someValuesFrom quant:VolumeMeasurement];
                      skos:exactMatch [a skos:Concept ; 
                                       skos:inScheme clisko:sct20080731 ; 
                                       skos:notation "258773002"^^clisko:sct20080731DT].
units:centimeterPerSecond mrela:hasOperand units:centimeter,
                                           unit:perSecond;
                          screla:hasSymbol "cm/s";
                          a units:Unit,
                            unit:UnitDefinedByProduct;
                          rdfs:isDefinedBy units:;
                          rdfs:label "centimeter per second"@en;
                          rdfs:subClassOf [a owl:Restriction ; 
                                           owl:onProperty quant:unitOf ; 
                                           owl:someValuesFrom [a owl:Restriction ; 
                                                               owl:onProperty quant:measurementOf ; 
                                                               owl:someValuesFrom quant:Velocity]];
                          skos:exactMatch [a skos:Concept ; 
                                           skos:inScheme clisko:sct20080731 ; 
                                           skos:notation "258990002"^^clisko:sct20080731DT].
units:century a units:Unit;
              rdfs:isDefinedBy units:;
              rdfs:subClassOf unit:century,
                              [a owl:Restriction ; 
                               owl:onProperty quant:unitOf ; 
                               owl:someValuesFrom [a owl:Restriction ; 
                                                   owl:onProperty quant:measurementOf ; 
                                                   owl:someValuesFrom quant:Time]].
units:cubicMeter screla:hasSymbol "m³";
                 a units:Unit;
                 rdfs:isDefinedBy units:;
                 rdfs:label "cubic meter"@en;
                 rdfs:subClassOf unit:meterCubed,
                                 [a owl:Restriction ; 
                                  owl:onProperty quant:unitOf ; 
                                  owl:someValuesFrom quant:VolumeMeasurement];
                 skos:exactMatch [a skos:Concept ; 
                                  skos:inScheme clisko:sct20080731 ; 
                                  skos:notation "396154006"^^clisko:sct20080731DT].
units:cubicMeterPerSecond mrela:hasOperand units:cubicMeter,
                                           units:hertz;
                          screla:hasSymbol "m³/s";
                          a units:Unit,
                            unit:UnitDefinedByProduct;
                          rdfs:isDefinedBy units:;
                          rdfs:label "cubic meter per second"@en;
                          rdfs:subClassOf [a owl:Restriction ; 
                                           owl:onProperty quant:unitOf ; 
                                           owl:someValuesFrom quant:VolumeFLowRateMeasurement].
units:day mrela:hasScalingNumber 86400.0e+00;
          screla:hasBaseUnit units:second;
          screla:hasSymbol "d";
          a units:Unit,
            unit:UnitDerivedByScaling;
          rdfs:isDefinedBy units:;
          rdfs:label "day"@en;
          rdfs:subClassOf [a owl:Restriction ; 
                           owl:onProperty quant:unitOf ; 
                           owl:someValuesFrom [a owl:Restriction ; 
                                               owl:onProperty quant:measurementOf ; 
                                               owl:someValuesFrom quant:Time]];
          skos:exactMatch [a skos:Concept ; 
                           skos:inScheme clisko:sct20080731 ; 
                           skos:notation "258703001"^^clisko:sct20080731DT].
units:decade a units:Unit;
             rdfs:isDefinedBy units:;
             rdfs:subClassOf unit:decade,
                             [a owl:Restriction ; 
                              owl:onProperty quant:unitOf ; 
                              owl:someValuesFrom [a owl:Restriction ; 
                                                  owl:onProperty quant:measurementOf ; 
                                                  owl:someValuesFrom quant:Time]].
units:deci screla:hasNumericValue 1e-01;
           screla:hasSymbol "d";
           a unit:Prefix;
           rdfs:isDefinedBy units:.
units:deciliter screla:hasBaseUnit units:liter;
                screla:hasPrefix units:deci;
                screla:hasSymbol "dL";
                a units:Unit,
                  unit:UnitDerivedByScaling;
                rdfs:isDefinedBy units:;
                rdfs:label "deciliter"@en;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:onProperty quant:unitOf ; 
                                 owl:someValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty quant:measurementOf ; 
                                                     owl:someValuesFrom quant:Volume]];
                skos:exactMatch [a skos:Concept ; 
                                 skos:inScheme clisko:sct20080731 ; 
                                 skos:notation "258771000"^^clisko:sct20080731DT].
units:decimeter screla:hasBaseUnit units:meter;
                screla:hasPrefix units:deci;
                screla:hasSymbol "dm";
                a units:Unit,
                  unit:UnitDerivedByScaling;
                rdfs:isDefinedBy units:;
                rdfs:label "decimeter"@en;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:onProperty quant:unitOf ; 
                                 owl:someValuesFrom quant:LengthMeasurement];
                skos:exactMatch [a skos:Concept ; 
                                 skos:inScheme clisko:sct20080731 ; 
                                 skos:notation "258671008"^^clisko:sct20080731DT].
units:decimeterCubed mrela:toThePower "3"^^xsd:double;
                     screla:hasBaseUnit units:decimeter;
                     screla:hasSymbol "dm³";
                     a units:Unit,
                       unit:UnitDerivedByRaisingToPower;
                     rdfs:isDefinedBy units:;
                     rdfs:label "cubic decimeter"@en;
                     rdfs:subClassOf [a owl:Restriction ; 
                                      owl:onProperty quant:unitOf ; 
                                      owl:someValuesFrom quant:VolumeMeasurement];
                     owl:equivalentClass units:liter;
                     skos:exactMatch [a skos:Concept ; 
                                      skos:inScheme clisko:sct20080731 ; 
                                      skos:notation "258770004"^^clisko:sct20080731DT].
units:degreeC a units:Unit;
              rdfs:isDefinedBy units:;
              rdfs:label "degree Celsius"@en;
              rdfs:subClassOf unit:degreeC,
                              [a owl:Restriction ; 
                               owl:onProperty quant:unitOf ; 
                               owl:someValuesFrom quant:TemperatureMeasurement];
              skos:exactMatch [a skos:Concept ; 
                               skos:inScheme clisko:sct20080731 ; 
                               skos:notation "258712007"^^clisko:sct20080731DT].
units:degreeF a units:Unit;
              rdfs:isDefinedBy units:;
              rdfs:label "degree Fahrenheit"@en;
              rdfs:subClassOf unit:degreeF,
                              [a owl:Restriction ; 
                               owl:onProperty quant:unitOf ; 
                               owl:someValuesFrom quant:TemperatureMeasurement];
              skos:exactMatch [a skos:Concept ; 
                               skos:inScheme clisko:sct20080731 ; 
                               skos:notation "258712004"^^clisko:sct20080731DT].
units:femto screla:hasNumericValue 1e-15;
            screla:hasSymbol "f";
            a unit:Prefix;
            rdfs:isDefinedBy units:.
units:femtoliter screla:hasBaseUnit units:liter;
                 screla:hasPrefix units:femto;
                 screla:hasSymbol "fL";
                 a units:Unit,
                   unit:UnitDerivedByScaling;
                 rdfs:isDefinedBy units:;
                 rdfs:label "femtoliter"@en;
                 rdfs:subClassOf [a owl:Restriction ; 
                                  owl:onProperty quant:unitOf ; 
                                  owl:someValuesFrom [a owl:Restriction ; 
                                                      owl:onProperty quant:measurementOf ; 
                                                      owl:someValuesFrom quant:Volume]].
units:gigaByte screla:hasBaseUnit units:byte;
               screla:hasPrefix unit:giga;
               screla:hasSymbol "GB";
               a units:Unit,
                 unit:UnitDerivedByScaling;
               rdfs:isDefinedBy units:;
               rdfs:subClassOf [a owl:Restriction ; 
                                owl:onProperty quant:unitOf ; 
                                owl:someValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty quant:measurementOf ; 
                                                    owl:someValuesFrom quant:DigitalSize]].
units:gram screla:hasBaseUnit units:kilogram;
           screla:hasSymbol "g";
           a units:Unit,
             unit:UnitDerivedByScaling;
           rdfs:isDefinedBy units:;
           rdfs:label "gram"@en;
           rdfs:subClassOf [a owl:Restriction ; 
                            owl:onProperty quant:unitOf ; 
                            owl:someValuesFrom quant:MassMeasurement];
           skos:exactMatch [a skos:Concept ; 
                            skos:inScheme clisko:sct20080731 ; 
                            skos:notation "258682000"^^clisko:sct20080731DT].
units:gramPerDeciliter mrela:hasOperand units:gram,
                                        units:perDeciliter;
                       screla:hasSymbol "g/dL";
                       a units:Unit,
                         unit:UnitDefinedByProduct;
                       rdfs:isDefinedBy units:;
                       rdfs:label "gram per deciliter"@en;
                       rdfs:subClassOf [a owl:Restriction ; 
                                        owl:onProperty quant:unitOf ; 
                                        owl:someValuesFrom quant:MassConcentrationMeasurement];
                       skos:exactMatch [a skos:Concept ; 
                                        skos:inScheme clisko:sct20080731 ; 
                                        skos:notation "258795003"^^clisko:sct20080731DT].
units:gramPerLiter mrela:hasOperand units:gram,
                                    units:perLiter;
                   screla:hasSymbol "g/L";
                   a units:Unit,
                     unit:UnitDefinedByProduct;
                   rdfs:isDefinedBy units:;
                   rdfs:label "gram per liter"@en;
                   rdfs:subClassOf [a owl:Restriction ; 
                                    owl:onProperty quant:unitOf ; 
                                    owl:someValuesFrom quant:MassConcentrationMeasurement];
                   skos:exactMatch [a skos:Concept ; 
                                    skos:inScheme clisko:sct20080731 ; 
                                    skos:notation "258794004"^^clisko:sct20080731DT].
units:hertz mrela:toThePower -1.0e+00;
            screla:hasBaseUnit unit:second;
            screla:hasSymbol "Hz",
                             "1/s";
            a units:Unit;
            rdfs:isDefinedBy units:;
            rdfs:label "hertz"@en;
            rdfs:subClassOf [a owl:Restriction ; 
                             owl:onProperty quant:unitOf ; 
                             owl:allValuesFrom quant:FrequencyMeasurement];
            skos:definition "Number of cycles per second."@en;
            skos:exactMatch [a skos:Concept ; 
                             skos:inScheme clisko:sct20080731 ; 
                             skos:notation "259025008"^^clisko:sct20080731DT];
            skos:note "SI unit of frequency."@en.
units:hour screla:hasSymbol "h";
           a units:Unit;
           rdfs:isDefinedBy units:;
           rdfs:label "hour"@en;
           rdfs:subClassOf unit:hour,
                           [a owl:Restriction ; 
                            owl:onProperty quant:unitOf ; 
                            owl:someValuesFrom [a owl:Restriction ; 
                                                owl:onProperty quant:measurementOf ; 
                                                owl:someValuesFrom quant:Time]];
           skos:exactMatch [a skos:Concept ; 
                            skos:inScheme clisko:sct20080731 ; 
                            skos:notation "258702006"^^clisko:sct20080731DT].
units:internationalUnitsPerMilliliter screla:hasSymbol "IU/ml";
                                      a units:Unit,
                                        unit:ComplexUnit;
                                      rdfs:isDefinedBy units:;
                                      rdfs:label "international units per milliliter"@en.
units:kelvin a units:Unit;
             rdfs:isDefinedBy units:;
             rdfs:label "kelvin"@en;
             rdfs:subClassOf unit:kelvin,
                             [a owl:Restriction ; 
                              owl:onProperty quant:unitOf ; 
                              owl:someValuesFrom quant:TemperatureMeasurement];
             skos:exactMatch [a skos:Concept ; 
                              skos:inScheme clisko:sct20080731 ; 
                              skos:notation "258713009"^^clisko:sct20080731DT].
units:kiloByte screla:hasBaseUnit units:byte;
               screla:hasPrefix unit:kilo;
               screla:hasSymbol "KB";
               a units:Unit,
                 unit:UnitDerivedByScaling;
               rdfs:isDefinedBy units:;
               rdfs:subClassOf [a owl:Restriction ; 
                                owl:onProperty quant:unitOf ; 
                                owl:someValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty quant:measurementOf ; 
                                                    owl:someValuesFrom quant:DigitalSize]].
units:kilogram a units:Unit;
               rdfs:isDefinedBy units:;
               rdfs:label "kilogram"@en;
               rdfs:subClassOf unit:kilogram,
                               [a owl:Restriction ; 
                                owl:onProperty quant:unitOf ; 
                                owl:someValuesFrom quant:MassMeasurement];
               skos:definition "Kilogram is a unit of mass, equal to the mass of the international prototype of the kilogram."@en;
               skos:exactMatch [a skos:Concept ; 
                                skos:inScheme clisko:sct20080731 ; 
                                skos:notation "258683005"^^clisko:sct20080731DT].
units:kilogramPerMeterSquare screla:hasSymbol "kg/m²";
                             a units:Unit;
                             rdfs:isDefinedBy units:;
                             rdfs:label "kilogram per square meter"@en;
                             skos:exactMatch [a skos:Concept ; 
                                              skos:inScheme clisko:sct20080731 ; 
                                              skos:notation "258896009"^^clisko:sct20080731DT].
units:liter screla:hasSymbol "L";
            a units:Unit;
            rdfs:isDefinedBy units:;
            rdfs:label "liter"@en;
            rdfs:subClassOf [a owl:Restriction ; 
                             owl:onProperty quant:unitOf ; 
                             owl:someValuesFrom quant:VolumeMeasurement];
            owl:equivalentClass units:decimeterCubed;
            skos:exactMatch [a skos:Concept ; 
                             skos:inScheme clisko:sct20080731 ; 
                             skos:notation "258770004"^^clisko:sct20080731DT].
units:megaByte screla:hasBaseUnit units:byte;
               screla:hasPrefix unit:mega;
               screla:hasSymbol "MB";
               a units:Unit,
                 unit:UnitDerivedByScaling;
               rdfs:isDefinedBy units:;
               rdfs:subClassOf [a owl:Restriction ; 
                                owl:onProperty quant:unitOf ; 
                                owl:someValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty quant:measurementOf ; 
                                                    owl:someValuesFrom quant:DigitalSize]].
units:meter a units:Unit;
            rdfs:isDefinedBy units:;
            rdfs:label "meter"@en;
            rdfs:subClassOf unit:meter,
                            [a owl:Restriction ; 
                             owl:onProperty quant:unitOf ; 
                             owl:someValuesFrom quant:LengthMeasurement];
            skos:definition "The metre is the length of the path travelled by light in vacuum during a time interval of 1/299 792 458 of a second."@en;
            skos:exactMatch [a skos:Concept ; 
                             skos:inScheme clisko:sct20080731 ; 
                             skos:notation "258669008"^^clisko:sct20080731DT].
units:meterPerSecond screla:hasSymbol "m/s";
                     a units:Unit;
                     rdfs:isDefinedBy units:;
                     rdfs:label "meter per second"@en;
                     rdfs:subClassOf unit:meterPerSecond,
                                     [a owl:Restriction ; 
                                      owl:onProperty quant:unitOf ; 
                                      owl:someValuesFrom [a owl:Restriction ; 
                                                          owl:onProperty quant:measurementOf ; 
                                                          owl:someValuesFrom quant:Velocity]];
                     skos:exactMatch [a skos:Concept ; 
                                      skos:inScheme clisko:sct20080731 ; 
                                      skos:notation "272090007"^^clisko:sct20080731DT].
units:microgram screla:hasBaseUnit units:gram;
                screla:hasPrefix unit:micro;
                screla:hasSymbol "µg";
                a units:Unit,
                  rdfs:Class,
                  unit:UnitDerivedByScaling;
                rdfs:isDefinedBy units:;
                rdfs:label "microgram"@en;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:onProperty quant:unitOf ; 
                                 owl:someValuesFrom quant:MassMeasurement];
                skos:exactMatch [a skos:Concept ; 
                                 skos:inScheme clisko:sct20080731 ; 
                                 skos:notation "258685003"^^clisko:sct20080731DT].
units:microgramPerKilogram mrela:hasOperand units:microgram,
                                            unit:perKilogram;
                           screla:hasSymbol "µg/kg";
                           a units:Unit,
                             unit:UnitDefinedByProduct;
                           rdfs:isDefinedBy units:;
                           rdfs:label "microgram per kilogram"@en;
                           skos:exactMatch [a skos:Concept ; 
                                            skos:inScheme clisko:sct20080731 ; 
                                            skos:notation "258803005"^^clisko:sct20080731DT].
units:microgramPerKilogramPerMinute mrela:hasOperand units:microgram,
                                                     units:perKilogram,
                                                     units:perMinute;
                                    screla:hasSymbol "µg/kg/min";
                                    a units:Unit,
                                      unit:UnitDefinedByProduct;
                                    rdfs:isDefinedBy units:.
units:microgramPerMilliliter mrela:hasOperand units:microgram,
                                              units:perMilliliter;
                             screla:hasSymbol "µg/mL";
                             a units:Unit,
                               unit:UnitDefinedByProduct;
                             rdfs:isDefinedBy units:;
                             rdfs:label "microgram per milliliter"@en;
                             rdfs:subClassOf [a owl:Restriction ; 
                                              owl:onProperty quant:unitOf ; 
                                              owl:someValuesFrom quant:MassConcentrationMeasurement];
                             skos:exactMatch [a skos:Concept ; 
                                              skos:inScheme clisko:sct20080731 ; 
                                              skos:notation "258801007"^^clisko:sct20080731DT].
units:microgramPerMinute mrela:hasOperand units:microgram,
                                          units:perMinute;
                         screla:hasSymbol "µg/min";
                         a units:Unit,
                           unit:UnitDefinedByProduct;
                         rdfs:isDefinedBy units:;
                         rdfs:label "microgram per minute"@en;
                         skos:exactMatch [a skos:Concept ; 
                                          skos:inScheme clisko:sct20080731 ; 
                                          skos:notation "258837002"^^clisko:sct20080731DT].
units:micrometer screla:hasSymbol "µm";
                 a units:Unit;
                 rdfs:isDefinedBy units:;
                 rdfs:label "micrometer"@en;
                 rdfs:subClassOf unit:micrometer,
                                 [a owl:Restriction ; 
                                  owl:onProperty quant:unitOf ; 
                                  owl:someValuesFrom quant:LengthMeasurement];
                 skos:exactMatch [a skos:Concept ; 
                                  skos:inScheme clisko:sct20080731 ; 
                                  skos:notation "258674000"^^clisko:sct20080731DT].
units:micromole screla:hasBaseUnit units:mole;
                screla:hasPrefix unit:micro;
                screla:hasSymbol "µmol";
                a units:Unit,
                  unit:UnitDerivedByScaling;
                rdfs:isDefinedBy units:;
                rdfs:label "micromole"@en;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:onProperty quant:unitOf ; 
                                 owl:someValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty quant:measurementOf ; 
                                                     owl:someValuesFrom quant:AmountOfSubstance]];
                skos:exactMatch [a skos:Concept ; 
                                 skos:inScheme clisko:sct20080731 ; 
                                 skos:notation "258719008"^^clisko:sct20080731DT].
units:micromolePerLiter mrela:hasOperand units:micromole,
                                         units:perLiter;
                        screla:hasSymbol "µmol/L";
                        a units:Unit,
                          unit:UnitDefinedByProduct;
                        rdfs:isDefinedBy units:;
                        rdfs:label "micromole per liter"@en;
                        skos:exactMatch [a skos:Concept ; 
                                         skos:inScheme clisko:sct20080731 ; 
                                         skos:notation "258814008"^^clisko:sct20080731DT].
units:milliInternationalUnitsPerLiter screla:hasSymbol "mIU/L";
                                      a units:Unit,
                                        unit:ComplexUnit;
                                      rdfs:isDefinedBy units:;
                                      rdfs:label "milli-international units per liter"@en.
units:milligram screla:hasBaseUnit units:gram;
                screla:hasPrefix unit:milli;
                screla:hasSymbol "mg";
                a units:Unit,
                  rdfs:Class,
                  unit:UnitDerivedByScaling;
                rdfs:isDefinedBy units:;
                rdfs:label "milligram"@en;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:onProperty quant:unitOf ; 
                                 owl:someValuesFrom quant:MassMeasurement];
                skos:exactMatch [a skos:Concept ; 
                                 skos:inScheme clisko:sct20080731 ; 
                                 skos:notation "258684004"^^clisko:sct20080731DT].
units:milligramPerDeciliter mrela:hasOperand units:milligram,
                                             units:perDeciliter;
