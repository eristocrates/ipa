                            skos:notation "258705008"^^clisko:sct20080731DT].
units:year screla:hasSymbol "y";
           a units:Unit;
           rdfs:isDefinedBy units:;
           rdfs:label "year"@en;
           rdfs:subClassOf unit:year,
                           [a owl:Restriction ; 
                            owl:onProperty quant:unitOf ; 
                            owl:someValuesFrom [a owl:Restriction ; 
                                                owl:onProperty quant:measurementOf ; 
                                                owl:someValuesFrom quant:Time]];
           skos:exactMatch [a skos:Concept ; 
                            skos:inScheme clisko:sct20080731 ; 
                            skos:notation "258707000"^^clisko:sct20080731DT].
units:yocto screla:hasNumericValue 1e-24;
            screla:hasSymbol "y";
            a unit:Prefix;
            rdfs:isDefinedBy units:.
units:zepto screla:hasNumericValue 1e-21;
            screla:hasSymbol "z";
            a unit:Prefix;
