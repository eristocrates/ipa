@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix voag: <http://voag.linkedmodel.org/voag#>.
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#>.
@prefix vaem: <http://www.linkedmodel.org/schema/vaem#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://www.linkedmodel.org/1.1/schema/dtype> dc11:author "Ralph Hodgson";
                                              dc11:subject "Datatype schema";
                                              dc11:title "Datatype Ontology";
                                              vaem:dateCreated "2011-05-29"^^vaem:dateUnion;
                                              vaem:description """The ontology \"dtype\" provides a specification of simple data types such as enumerations and codelists. These are needed in support of the conversion of XML Schemas and UML Models to OWL. The purpose of \"dtype\" is to provide a foundation for expressing rich data types. These data types are typically needed when dealing with OWL representations of data structures derived from XML Schema.""";
                                              vaem:hasGraphRole vaem:SchemaGraph;
                                              vaem:hasLicenseType voag:CC-SHAREALIKE_3PT0-US;
                                              vaem:lastUpdated "2014-06-28"^^vaem:dateUnion;
                                              vaem:name "DTYPE";
                                              vaem:namespace "http://www.linkedmodel.org/schema/dtype"^^xsd:anyURI;
                                              vaem:namespacePrefix "dtype";
                                              vaem:owner "TopQuadrant";
                                              vaem:revision "1.1";
                                              vaem:usesNonImportedResource dc11:description,
                                                                           dc11:author,
                                                                           dc11:title,
                                                                           dc11:contributor,
                                                                           dc11:subject;
                                              vaem:withAttributionTo voag:TopQuadrantAttribution;
                                              rdfs:label "Datatype Ontology";
                                              owl:versionIRI <http://www.linkedmodel.org/1.1/schema/dtype>;
                                              owl:versionInfo "Created with TopBraid Composer".
<http://www.linkedmodel.org/schema/dtype> a owl:Ontology;
                                          owl:imports <http://www.linkedmodel.org/schema/vaem>.
dtype:CodeList vaem:comment """A codelist is a controlled vocabulary of terms that are used to represent permissible values of a variable in information systems. The representaiton of codes in \"dtype\" has been influenced by CCTS and UBL.""";
               a owl:Class;
               rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                <http://www.linkedmodel.org/schema/dtype>;
               rdfs:label "Codelist";
               rdfs:subClassOf dtype:Enumeration.
dtype:CompositeCodeList vaem:comment "A composite codelist is a codelist made up of other codelists. It does not introduce any new codes.";
                        a owl:Class;
                        rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                         <http://www.linkedmodel.org/schema/dtype>;
                        rdfs:label "Composite Code List";
                        rdfs:subClassOf dtype:CodeList,
                                        [owl:allValuesFrom dtype:CodeList ; 
                                         owl:onProperty dtype:compositeOf ; 
                                         a owl:Restriction];
                        owl:disjointWith dtype:DerivedCodeList,
                                         dtype:SimpleCodeList.
dtype:DerivedCodeList vaem:comment "A derived codelist is a sublist of another codelist. The members that it has must be members of the source list.";
                      a owl:Class;
                      rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                       <http://www.linkedmodel.org/schema/dtype>;
                      rdfs:label "Derived Code List";
                      rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtype:derivedFrom ; 
                                       a owl:Restriction],
                                      dtype:CodeList,
                                      [owl:allValuesFrom dtype:ValueReference ; 
                                       owl:onProperty dtype:hasMember ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom dtype:CodeList ; 
                                       owl:onProperty dtype:derivedFrom ; 
                                       a owl:Restriction];
                      owl:disjointWith dtype:SimpleCodeList,
                                       dtype:CompositeCodeList.
dtype:EnumeratedValue dc11:description "The base class for datatypes that have values that are restriced to a set of literals or tokens. The members of the restriction may themselve be restriced by facets that apply to scalar data types.";
                      a owl:Class;
                      rdfs:isDefinedBy <http://www.linkedmodel.org/schema/dtype>,
                                       <http://www.linkedmodel.org/1.1/schema/dtype>;
                      rdfs:label "DTYPE Enumerated value";
                      rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtype:position ; 
                                       a owl:Restriction],
                                      [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtype:value ; 
                                       a owl:Restriction],
                                      [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtype:code ; 
                                       a owl:Restriction],
                                      [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty vaem:description ; 
                                       a owl:Restriction],
                                      [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty vaem:name ; 
                                       a owl:Restriction],
                                      owl:Thing,
                                      [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty dtype:order ; 
                                       a owl:Restriction],
                                      [owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty vaem:url ; 
                                       a owl:Restriction].
dtype:Enumeration vaem:comment "A type that serves as a container for the enumerated values of an enumeration. This enables the enumeration itself to be referenceable. One need for this is in determing the default value of an enumeration , another need is in the management of sub-enumerations and composite enumerations.";
                  a owl:Class;
                  rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                   <http://www.linkedmodel.org/schema/dtype>;
                  rdfs:label "DTYPE Enumeration";
                  rdfs:subClassOf owl:Thing,
                                  [owl:allValuesFrom dtype:EnumeratedValue ; 
                                   owl:onProperty dtype:defaultValue ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom dtype:EnumeratedValue ; 
                                   owl:onProperty dtype:value ; 
                                   a owl:Restriction],
                                  [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty dtype:defaultValue ; 
                                   a owl:Restriction].
dtype:SimpleCodeList vaem:comment "A simple codelist is one made up only of enumerated values.";
                     a owl:Class;
                     rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                      <http://www.linkedmodel.org/schema/dtype>;
                     rdfs:label "Simple Code List";
                     rdfs:subClassOf dtype:CodeList,
                                     [owl:allValuesFrom dtype:EnumeratedValue ; 
                                      owl:onProperty dtype:hasMember ; 
                                      a owl:Restriction];
                     owl:disjointWith dtype:CompositeCodeList,
                                      dtype:DerivedCodeList.
dtype:ValueReference vaem:comment "A value reference is a pointer to an Enumerated Value. The original position of the value can be overridden by the position attribute.";
                     a owl:Class;
                     rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                      <http://www.linkedmodel.org/schema/dtype>;
                     rdfs:label "Value Reference";
                     rdfs:subClassOf owl:Thing,
                                     [owl:allValuesFrom dtype:EnumeratedValue ; 
                                      owl:onProperty dtype:refersTo ; 
                                      a owl:Restriction],
                                     [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtype:refersTo ; 
                                      a owl:Restriction],
                                     [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty dtype:position ; 
                                      a owl:Restriction].
dtype:code vaem:comment """A property for expressing an encoded value. The range has been set to \"xsd:anySimpleType\" to allow for a variety of scalar datatypes.""";
           a owl:DatatypeProperty;
           rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                            <http://www.linkedmodel.org/schema/dtype>;
           rdfs:label "code";
           rdfs:range xsd:anySimpleType.
dtype:compositeOf vaem:comment "Aproperty for constructing composite data structures";
                  a owl:ObjectProperty;
                  rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                   <http://www.linkedmodel.org/schema/dtype>;
                  rdfs:label "composite of".
dtype:defaultValue vaem:comment """The property \"dtype:defaultValue\" is a general property for specifying a value in situations where none is specified, or can be determined. In some cases of use, this property could have a scalar value and in other cases may need to refer to a first class concept that holds a \"value object\".  For this reason, the  type of this property is set as \"rdf:Property\" and the property is rangeless.""";
                   a rdf:Property;
                   rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                    <http://www.linkedmodel.org/schema/dtype>;
                   rdfs:label "default value".
dtype:derivedFrom vaem:comment "A property for specifying a derivation relationship.";
                  a owl:ObjectProperty;
                  rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                   <http://www.linkedmodel.org/schema/dtype>;
                  rdfs:label "derived from".
dtype:hasMember vaem:comment "A property for specifying how member elements make up a data structure.";
                a owl:ObjectProperty;
                rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                 <http://www.linkedmodel.org/schema/dtype>;
                rdfs:label "has member".
dtype:isInvalid vaem:comment "A boolean flag to state that a value is invalid with respect to its type.";
                a owl:DatatypeProperty;
                rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                 <http://www.linkedmodel.org/schema/dtype>;
                rdfs:label "is invalid";
                rdfs:range xsd:boolean.
dtype:literal vaem:comment "A general purpose property for holding string literals.";
              a owl:DatatypeProperty;
              rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                               <http://www.linkedmodel.org/schema/dtype>;
              rdfs:label "literal";
              rdfs:range xsd:string.
dtype:numericUnion dc11:description """A datatype that is the union of numeric xsd data types. \"numericUnion\" is equivalent to the xsd specification that uses an xsd:union of memberTypes=\"xsd:decimal xsd:double xsd:float xsd:integer\".""";
                   a rdfs:Datatype;
                   rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                    <http://www.linkedmodel.org/schema/dtype>;
                   rdfs:label "numeric union";
                   rdfs:subClassOf rdfs:Resource;
                   owl:equivalentClass [owl:unionOf (xsd:float
                                                     xsd:decimal
                                                     xsd:integer
                                                     xsd:double) ; 
                                        a rdfs:Datatype].
dtype:order vaem:comment """The property \"dtype:order\" provides a means to specify a precedence. One use of order is in specifying ordered enumerations such as \"voag:ConfidentialityLevel\".  A similar property, but with an important type difference, is \"vaem:orderIndex\". This is for use on property occurrences in class axioms where it can be placed on a restriction to specify how that property may be transformed into other representations where ordering has some importance, for example, in XML Schema sequences.  Whereas \"vaem:order\" is a datatype property, \"vaem:orderIndex\" is an annotation property.""";
            a owl:DatatypeProperty;
            rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                             <http://www.linkedmodel.org/schema/dtype>;
            rdfs:label "order";
            rdfs:range xsd:nonNegativeInteger;
            rdfs:seeAlso dtype:orderIndex.
dtype:orderIndex vaem:comment """The property \"dtype:orderIndex\" is an annotation property to specify a position that some value or structure will have. One use is to specify the place that a resource has in a sequence. One use is on property occurrences in class axioms. Here \"vaem:orderIndex\" is placed on a restriction to specify how that property may be transformed into a representation where ordering has some importance, for example, in XML Schema sequences.""";
                 a owl:AnnotationProperty;
                 rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                  <http://www.linkedmodel.org/schema/dtype>;
                 rdfs:label "order index";
                 rdfs:range xsd:nonNegativeInteger.
dtype:position a owl:DatatypeProperty;
               rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                <http://www.linkedmodel.org/schema/dtype>;
               rdfs:label "position";
               rdfs:range xsd:nonNegativeInteger.
dtype:refersTo vaem:comment """An indirection pointer for relating a slot in am occurrence data structure, such as \"dtype:ValueReference\" with another resource.""";
               a owl:ObjectProperty;
               rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                                <http://www.linkedmodel.org/schema/dtype>;
               rdfs:label "refers to".
dtype:type a owl:ObjectProperty;
           rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                            <http://www.linkedmodel.org/schema/dtype>;
           rdfs:label "datatype".
dtype:value vaem:comment """The property \"dtype:value\" is a general property that in some cases could have scalar values and in other cases may refer to a first class concept that is a \"value object\". For this reason, the  type of this property is set as \"rdf:Property\" and the property is rangeless.""";
            a rdf:Property;
            rdfs:isDefinedBy <http://www.linkedmodel.org/1.1/schema/dtype>,
                             <http://www.linkedmodel.org/schema/dtype>;
            rdfs:label "value".
