san-lod:titolo a owl:DatatypeProperty;
               rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/filedesc/titlestmt/titleproper";
               rdfs:domain san-lod:strumento;
               rdfs:label "titolo".
san-lod:titolo_nobiliare a owl:DatatypeProperty;
                         rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/cpfDescription/description/descriptiveEntries/descriptiveEntry/term";
