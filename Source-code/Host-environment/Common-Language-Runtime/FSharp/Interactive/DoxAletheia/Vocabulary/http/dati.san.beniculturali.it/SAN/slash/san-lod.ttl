                                 owl:equivalentProperty <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#cpfRelationType>.
san-lod:tipologiaComplesso a owl:DatatypeProperty;
                           rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaead.xsd//ead/archdesc[@level='otherlevel']/@otherlevel";
                           rdfs:domain san-lod:complessoArchivistico;
