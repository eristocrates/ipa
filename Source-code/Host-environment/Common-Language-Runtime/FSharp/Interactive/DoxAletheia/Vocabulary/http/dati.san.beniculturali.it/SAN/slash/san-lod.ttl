                           rdfs:domain san-lod:strumento;
                           rdfs:label "luogo pubblicazione".
san-lod:luogoTesto a owl:DatatypeProperty;
                   rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/cpfDescription/placeDates/placeDate/place",
                                "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/scons.xsd//scons/localizzazione";
                   rdfs:domain san-lod:luogo;
                   rdfs:label "luogo testo".
san-lod:orario a owl:DatatypeProperty;
               rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/scons.xsd//scons/orario";
               rdfs:domain san-lod:conservatore;
               rdfs:label "orario".
san-lod:ordinamento a owl:DatatypeProperty;
                    rdfs:domain san-lod:complessoArchivistico;
                    rdfs:label "ordinamento".
san-lod:persona a owl:Class;
                rdfs:label "persona";
                rdfs:subClassOf san-lod:produttore;
                owl:equivalentClass foaf:person,
                                    <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#person>.
san-lod:produttore a owl:Class;
                   rdfs:comment "Soggetto (ente, famiglia o persona) che ha prodotto o acquisito per finalità  amministrative, familiari o personali il complesso archivistico oggetto di descrizione. Può essere collegato ad altri soggetti produttori con relazioni gerarchiche o temporali.";
                   rdfs:label "soggetto produttore";
                   rdfs:subClassOf [],
                                   [],
                                   [],
                                   [],
                                   [],
                                   [],
                                   [],
                                   owl:Thing;
                   owl:equivalentClass <http://archivi.ibc.regione.emilia-romagna.it/ontology/eac-cpf#entity>,
                                       [owl:unionOf [] ; 
                                        a owl:Class].
san-lod:professione a owl:DatatypeProperty;
                    rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/cpfDescription/description/descriptiveEntries/descriptiveEntry/term";
                    rdfs:domain san-lod:persona;
                    rdfs:label "professione".
san-lod:profiloIstituzionale a owl:Class;
                             rdfs:comment """Istituzioni, preunitarie o unitarie, descritte una volta per tutte, con riferimento al periodo in cui hanno operato e al contesto storico istituzionale o statuale di appartenenza.
Descrive una volta per tutte un particolare soggetto produttore, e costituisce una chiave di ricerca per tutti i soggetti produttori che appartengono al profilo descritto.""";
                             rdfs:label "profilo istituzionale";
                             rdfs:subClassOf [],
                                             [],
                                             [],
                                             [],
                                             [],
                                             [],
                                             owl:Thing,
                                             [].
san-lod:qualificazioniRelazioniCpf a owl:Class;
                                   rdfs:label "qualificazioni relazioni Cpf";
                                   rdfs:subClassOf [],
                                                   owl:Thing.
san-lod:recordProvenienzaId a owl:DatatypeProperty;
                            rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaead.xsd//ead/archdesc/did/unitid",
                                         "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/control/otherRecordId",
                                         "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/eadid";
                            rdfs:domain [owl:unionOf [] ; 
                                         a owl:Class];
                            rdfs:label "record provenienza id".
san-lod:schedaProvenienzaHref a owl:DatatypeProperty;
                              rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaead.xsd//ead/archdesc/did/unitid/@identifier",
                                           "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/control/sources/source/@xlink:href",
                                           "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/eadid/@URL";
                              rdfs:domain [owl:unionOf [] ; 
                                           a owl:Class];
                              rdfs:label "scheda provenienza href";
                              rdfs:range xsd:anyURI.
san-lod:schedaSAN a owl:DatatypeProperty;
                  rdfs:domain [owl:unionOf [] ; 
                               a owl:Class];
                  rdfs:label "scheda SAN";
                  rdfs:range xsd:anyURI.
san-lod:servizi a owl:DatatypeProperty;
                rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/scons.xsd//scons/servizi";
                rdfs:domain san-lod:conservatore;
                rdfs:label "servizi".
san-lod:sistemaProvenienza a owl:DatatypeProperty;
                           rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/eadid/@identifier",
                                        "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaead.xsd//ead/archdesc/did/unitid/@type",
                                        "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/control/otherRecordId/@localtype";
                           rdfs:domain [owl:unionOf [] ; 
                                        a owl:Class];
                           rdfs:label "sistema provenienza".
san-lod:sitoWeb a owl:Class;
                rdfs:label "sito web";
                rdfs:subClassOf owl:Thing;
                owl:equivalentClass <http://lod.xdams.org/reload/ocsa/contactArea>.
san-lod:sitoWebHref a owl:DatatypeProperty;
                    rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/scons.xsd//scons/sitoweb/@href";
                    rdfs:domain san-lod:sitoWeb;
                    rdfs:label "sito web href";
                    rdfs:range xsd:anyURI;
                    owl:equivalentProperty foaf:homepage.
san-lod:sitoWebTesto a owl:DatatypeProperty;
                     rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/scons.xsd//scons/sitoweb";
                     rdfs:domain san-lod:sitoWeb;
                     rdfs:label "sito web testo".
san-lod:strumento a owl:Class;
                  rdfs:comment "Repertorio - in forma di inventario analitico o sommario, elenco, elenco di versamento, elenco di consistenza, elenco numerico o altro - che descrive in maniera più o meno dettagliata un fondo o parte di esso.";
                  rdfs:label "strumento di ricerca";
                  rdfs:subClassOf [],
                                  [],
                                  [],
                                  [],
                                  [],
                                  [],
                                  owl:Thing,
                                  [];
                  owl:equivalentClass oad:findingAid.
san-lod:strumentoDigitale a owl:Class;
                          rdfs:label "strumento digitale";
                          rdfs:subClassOf [],
                                          [],
                                          owl:Thing.
san-lod:strumentoDigitaleLink a owl:DatatypeProperty;
                              rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/filedesc/editionstmt/edition/extptr/@href";
                              rdfs:domain san-lod:strumentoDigitale;
                              rdfs:label "strumento digitale link";
                              rdfs:range xsd:anyURI.
san-lod:strumentoDigitaleTitolo a owl:DatatypeProperty;
                                rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/strumenti.xsd//ead/eadheader/filedesc/editionstmt/edition/extptr/@title";
                                rdfs:domain san-lod:strumentoDigitale;
                                rdfs:label "strumento digitale titolo".
san-lod:tipoQualificazioniRelCpf a owl:DatatypeProperty;
                                 rdfs:comment "Tracciato schema SAN: http://www.san.beniculturali.it/tracciato/schemaeac.xsd//eac-cpf/cpfDescription/relations/cpfRelation/@localType";
                                 rdfs:domain san-lod:qualificazioniRelazioniCpf;
