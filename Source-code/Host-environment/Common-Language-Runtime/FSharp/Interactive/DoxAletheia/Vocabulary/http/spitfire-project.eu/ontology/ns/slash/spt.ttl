@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix spt: <http://spitfire-project.eu/ontology/ns/>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/identifier> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/source> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://spitfire-project.eu/ontology/ns> <http://purl.org/dc/elements/1.1/creator> <http://myr.altervista.org/foaf.rdf#me>,
                                                                                   "Alexandre Passant";
                                         <http://purl.org/dc/elements/1.1/identifier> "http://spitfire-project.eu/ontology/ns";
                                         <http://purl.org/dc/elements/1.1/rights> "Copyright 2010 - 2012 SPITFIRE.";
                                         <http://purl.org/dc/elements/1.1/title> "SPITFIRE Ontology"@en;
                                         <http://purl.org/dc/terms/license> <http://www.w3.org/Consortium/Legal/2002/copyright-software-20021231.html>;
                                         a <http://www.w3.org/2002/07/owl#Ontology>;
                                         rdfs:comment " Please report any error to myriam.leggieri_at_deri.org",
                                                      "This ontology describes sensors, observations, and related concepts.  It also describes events and their correlations. The final aim is to support a better description  of sensor context.",
                                                      "This ontology is developed by DERI ( http://www.deri.ie ) for the SPITFIRE project ( http://spitfire-project.eu ) . It is based on the alignment among the W3C Semantic Sensor Networks Incubator Group (SSN-XG) ontology, the Dolce-DnS Ultralite ontology and the Event Model F ontology. ";
                                         rdfs:seeAlso "http://spitfire-project.eu".
spt:AccessLayer a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf spt:ModelLayer.
spt:Acoustic a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:Activity rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>,
                             <http://purl.org/ontology/ao/core#LikeableAssociation>,
                             <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event>.
spt:ActuatedProperty a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Property>.
spt:Actuator a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Transducer.
spt:Agent rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Agent>,
                          <http://xmlns.com/foaf/0.1/Agent>,
                          <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object>.
spt:Chemical a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:CoreLayer a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:ModelLayer.
spt:DataLink a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Link Association.";
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf <http://purl.org/ontology/ao/core#LikeableAssociation>.
spt:DeviceRole a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role>.
spt:DistributionLayer a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:subClassOf spt:ModelLayer.
spt:Electrical a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf spt:Energy.
spt:Electromagnetic a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                    rdfs:subClassOf spt:Magnetic,
                                    spt:Electrical.
spt:Energy a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:EnergyLabel a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:EnergySource a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:FlatModel a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:NetworkTopology.
spt:Green a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf spt:EnergyLabel.
spt:HierarchicalModel a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:subClassOf spt:NetworkTopology.
spt:Light a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf spt:Electromagnetic.
spt:LinkActivity a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Quality>.
spt:LinkProperty a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:LinkQuality a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Quality>.
spt:LinkReview a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Link Review.";
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf <http://purl.org/ontology/ao/core#LikeableAssociation>.
spt:Magnetic a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:Mechanical a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf spt:Energy.
spt:MeshModel a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:NetworkTopology.
spt:ModelLayer a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Design>.
spt:Mood a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Motion a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
           rdfs:subClassOf spt:Mechanical.
spt:NetworkLink a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>.
spt:NetworkProperty a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:NetworkQuality a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Quality>.
spt:NetworkTopology a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                    rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Design>.
spt:NotGreen a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:EnergyLabel.
spt:NotRenewable a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:subClassOf spt:EnergySource.
spt:OV a <http://www.w3.org/2002/07/owl#Class>;
       rdfs:comment "Observation Value.";
       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
       rdfs:subClassOf <http://qudt.org/schema/qudt#QuantityValue>,
                       <http://purl.oclc.org/NET/ssnx/ssn#ObservationValue>.
spt:Place a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Location>.
spt:PlatformTemporalProperty a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                             rdfs:subClassOf spt:TemporalProperty.
spt:Power a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Quantity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Observed property (Quantity).";
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Property>,
                             <http://qudt.org/schema/qudt#QuantityKind>.
spt:Renewable a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:EnergySource.
spt:SensorNetwork a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#DesignedArtifact>.
spt:SensorProjectTopic a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:SensorRole a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Role>.
spt:SensorTemporalProperty a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                           rdfs:subClassOf spt:TemporalProperty.
spt:TSMap a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Versions of a same observed Property (Quantity) which vary across time and space, as captured by the sensor's observed values.";
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:TemporalProperty a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Thermal a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:subClassOf spt:Energy.
spt:Transducer a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#Device>.
spt:Unit a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         rdfs:subClassOf <http://purl.oclc.org/NET/muo/muo#UnitOfMeasurement>,
                         <http://qudt.org/schema/qudt#Unit>.
spt:activityEnd a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Relationship among a LinkActivity and the end datetime of the time range which it refers to.";
                rdfs:domain spt:LinkActivity;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range xsd:dateTime.
spt:activityStart a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Relationship among an Activity and the start datetime of the time range which it refers to.";
                  rdfs:domain spt:LinkActivity;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range xsd:dateTime.
spt:actuate a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:domain spt:Actuator;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:Motion;
            <http://www.w3.org/2002/07/owl#inverseOf> spt:actuatedBy.
spt:actuatedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain spt:Motion;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:Actuator;
               <http://www.w3.org/2002/07/owl#inverseOf> spt:actuate.
spt:actuatedProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:ActuatedProperty;
                     <http://www.w3.org/2002/07/owl#inverseOf> spt:actuatedPropertyOf.
spt:actuatedPropertyOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain spt:ActuatedProperty;
                       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                       <http://www.w3.org/2002/07/owl#inverseOf> spt:actuatedProperty.
spt:avgValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:belongsToLayer a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                   rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:ModelLayer;
                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf>.
spt:belongsToNetwork a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                     rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:SensorNetwork;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf>.
spt:bytes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:domain spt:DataLink;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:confidence a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain spt:DataLink;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range xsd:double.
spt:containedIn a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:Place;
                <http://www.w3.org/2002/07/owl#subPropertyOf> <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasLocation>.
spt:describesNetwork a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain spt:NetworkTopology;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:SensorNetwork;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#describes>.
spt:endpoint rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subPropertyOf <https://linked-data-api.googlecode.com/svn/trunk/vocab/api.ttl#endpoint>.
spt:energyConsumed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:Energy.
spt:energyLabel a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject>;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:EnergyLabel.
spt:energyOutcomes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain spt:Energy;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:Activity.
spt:energyRate a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain spt:Energy;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:Power.
spt:energySource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain spt:Energy;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:EnergySource.
spt:energyUsedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain spt:Energy;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:Activity.
spt:feed a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Platform>;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:forSTatus a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain spt:Mood;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:range <http://spitfire-project.eu/ontology/ns/context-types#Status>;
              <http://www.w3.org/2002/07/owl#inverseOf> spt:mood;
              <http://www.w3.org/2002/07/owl#subPropertyOf> <http://purl.org/ontology/ao/core#mood>.
spt:from a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:domain spt:DataLink,
                     spt:Motion;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         <http://www.w3.org/2002/07/owl#inverseOf> spt:to.
spt:inputEnergy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain spt:Energy;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:Transducer;
                <http://www.w3.org/2002/07/owl#inverseOf> spt:outputEnergy.
spt:ipDevice a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Sensor>;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:range xsd:string.
spt:ipGate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain <http://purl.oclc.org/NET/ssnx/ssn#Sensor>;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
           rdfs:range xsd:string.
spt:layer a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
          rdfs:domain spt:NetworkTopology;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:range spt:ModelLayer;
          rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasPart>;
          <http://www.w3.org/2002/07/owl#inverseOf> spt:isLayerOf.
spt:layerOf a <http://www.w3.org/2002/07/owl#TransitiveProperty>;
            rdfs:domain spt:ModelLayer;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:NetworkTopology;
            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isPartOf>;
            <http://www.w3.org/2002/07/owl#inverseOf> spt:hasLayer.
spt:linkActivity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain spt:NetworkLink;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:LinkActivity;
                 <http://www.w3.org/2002/07/owl#inverseOf> spt:linkActivityOf.
spt:linkActivityOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain spt:LinkActivity;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:NetworkLink;
                   <http://www.w3.org/2002/07/owl#inverseOf> spt:linkActivity.
spt:linkActivityValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "Relationship among a LinkActivity and the amount of packets received in the time range specified by the predicates :startDateTime and :endDateTime";
                      rdfs:domain spt:LinkActivity;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:range xsd:integer.
spt:linkQuality a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain spt:NetworkLink;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:LinkQuality;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasQuality>;
                <http://www.w3.org/2002/07/owl#inverseOf> spt:isQualityOf.
spt:linkQualityOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain spt:LinkQuality;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range spt:NetworkLink;
                  rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#isQualityOf>;
                  <http://www.w3.org/2002/07/owl#inverseOf> spt:linkQuality.
spt:linkQualityValue a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:domain spt:LinkQuality;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range xsd:double;
                     rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasDataValue>.
