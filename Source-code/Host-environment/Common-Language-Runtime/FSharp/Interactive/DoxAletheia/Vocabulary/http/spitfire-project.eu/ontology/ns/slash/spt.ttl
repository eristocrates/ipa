@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix muo: <http://purl.oclc.org/NET/muo/muo#>.
@prefix ssnx: <http://purl.oclc.org/NET/ssnx/ssn#>.
@prefix ao: <http://purl.org/ontology/ao/core#>.
@prefix spt: <http://spitfire-project.eu/ontology/ns/>.
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix nsprov: <http://www.w3.org/ns/prov#>.

dc11:creator a owl:AnnotationProperty.
dc11:identifier a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:source a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
<http://spitfire-project.eu/ontology/ns> dc11:creator <http://myr.altervista.org/foaf.rdf#me>,
                                                      "Alexandre Passant";
                                         dc11:identifier "http://spitfire-project.eu/ontology/ns";
                                         dc11:rights "Copyright 2010 - 2012 SPITFIRE.";
                                         dc11:title "SPITFIRE Ontology"@en;
                                         dcterms:license <http://www.w3.org/Consortium/Legal/2002/copyright-software-20021231.html>;
                                         a owl:Ontology;
                                         rdfs:comment " Please report any error to myriam.leggieri_at_deri.org",
                                                      "This ontology describes sensors, observations, and related concepts.  It also describes events and their correlations. The final aim is to support a better description  of sensor context.",
                                                      "This ontology is developed by DERI ( http://www.deri.ie ) for the SPITFIRE project ( http://spitfire-project.eu ) . It is based on the alignment among the W3C Semantic Sensor Networks Incubator Group (SSN-XG) ontology, the Dolce-DnS Ultralite ontology and the Event Model F ontology. ";
                                         rdfs:seeAlso "http://spitfire-project.eu".
spt:AccessLayer a owl:Class;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf spt:ModelLayer.
spt:Acoustic a owl:Class;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:Activity rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf nsprov:Activity,
                             ao:LikeableAssociation,
                             dul:Event.
spt:ActuatedProperty a owl:Class;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:subClassOf ssnx:Property.
spt:Actuator a owl:Class;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Transducer.
spt:Agent rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf nsprov:Agent,
                          foaf:Agent,
                          dul:Object.
spt:Chemical a owl:Class;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:CoreLayer a owl:Class;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:ModelLayer.
spt:DataLink a owl:Class;
             rdfs:comment "Link Association.";
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf ao:LikeableAssociation.
spt:DeviceRole a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf dul:Role.
spt:DistributionLayer a owl:Class;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:subClassOf spt:ModelLayer.
spt:Electrical a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf spt:Energy.
spt:Electromagnetic a owl:Class;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                    rdfs:subClassOf spt:Magnetic,
                                    spt:Electrical.
spt:Energy a owl:Class;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:EnergyLabel a owl:Class;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:EnergySource a owl:Class;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:FlatModel a owl:Class;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:NetworkTopology.
spt:Green a owl:Class;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf spt:EnergyLabel.
spt:HierarchicalModel a owl:Class;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:subClassOf spt:NetworkTopology.
spt:Light a owl:Class;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf spt:Electromagnetic.
spt:LinkActivity a owl:Class;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:subClassOf dul:Quality.
spt:LinkProperty a owl:Class;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:LinkQuality a owl:Class;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf dul:Quality.
spt:LinkReview a owl:Class;
               rdfs:comment "Link Review.";
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf ao:LikeableAssociation.
spt:Magnetic a owl:Class;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:Energy.
spt:Mechanical a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf spt:Energy.
spt:MeshModel a owl:Class;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:NetworkTopology.
spt:ModelLayer a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf dul:Design.
spt:Mood a owl:Class;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Motion a owl:Class;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
           rdfs:subClassOf spt:Mechanical.
spt:NetworkLink a owl:Class;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:subClassOf dul:PhysicalObject.
spt:NetworkProperty a owl:Class;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:NetworkQuality a owl:Class;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:subClassOf dul:Quality.
spt:NetworkTopology a owl:Class;
                    rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                    rdfs:subClassOf dul:Design.
spt:NotGreen a owl:Class;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf spt:EnergyLabel.
spt:NotRenewable a owl:Class;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:subClassOf spt:EnergySource.
spt:OV a owl:Class;
       rdfs:comment "Observation Value.";
       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
       rdfs:subClassOf <http://qudt.org/schema/qudt#QuantityValue>,
                       ssnx:ObservationValue.
spt:Place a owl:Class;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subClassOf dul:Location.
spt:PlatformTemporalProperty a owl:Class;
                             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                             rdfs:subClassOf spt:TemporalProperty.
spt:Power a owl:Class;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Quantity a owl:Class;
             rdfs:comment "Observed property (Quantity).";
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subClassOf ssnx:Property,
                             <http://qudt.org/schema/qudt#QuantityKind>.
spt:Renewable a owl:Class;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:subClassOf spt:EnergySource.
spt:SensorNetwork a owl:Class;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:subClassOf dul:DesignedArtifact.
spt:SensorProjectTopic a owl:Class;
                       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:SensorRole a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf dul:Role.
spt:SensorTemporalProperty a owl:Class;
                           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                           rdfs:subClassOf spt:TemporalProperty.
spt:TSMap a owl:Class;
          rdfs:comment "Versions of a same observed Property (Quantity) which vary across time and space, as captured by the sensor's observed values.";
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:TemporalProperty a owl:Class;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:Thermal a owl:Class;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:subClassOf spt:Energy.
spt:Transducer a owl:Class;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:subClassOf ssnx:Device.
spt:Unit a owl:Class;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         rdfs:subClassOf muo:UnitOfMeasurement,
                         <http://qudt.org/schema/qudt#Unit>.
spt:activityEnd a owl:DatatypeProperty;
                rdfs:comment "Relationship among a LinkActivity and the end datetime of the time range which it refers to.";
                rdfs:domain spt:LinkActivity;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range xsd:dateTime.
spt:activityStart a owl:DatatypeProperty;
                  rdfs:comment "Relationship among an Activity and the start datetime of the time range which it refers to.";
                  rdfs:domain spt:LinkActivity;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range xsd:dateTime.
spt:actuate a owl:ObjectProperty;
            rdfs:domain spt:Actuator;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:Motion;
            owl:inverseOf spt:actuatedBy.
spt:actuatedBy a owl:ObjectProperty;
               rdfs:domain spt:Motion;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:Actuator;
               owl:inverseOf spt:actuate.
spt:actuatedProperty a owl:ObjectProperty;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:ActuatedProperty;
                     owl:inverseOf spt:actuatedPropertyOf.
spt:actuatedPropertyOf a owl:ObjectProperty;
                       rdfs:domain spt:ActuatedProperty;
                       rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                       owl:inverseOf spt:actuatedProperty.
spt:avgValue a owl:ObjectProperty;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:belongsToLayer a owl:TransitiveProperty;
                   rdfs:domain dul:PhysicalObject;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:ModelLayer;
                   rdfs:subPropertyOf dul:isPartOf.
spt:belongsToNetwork a owl:TransitiveProperty;
                     rdfs:domain dul:PhysicalObject;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:SensorNetwork;
                     rdfs:subPropertyOf dul:isPartOf.
spt:bytes a owl:ObjectProperty;
          rdfs:domain spt:DataLink;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:confidence a owl:DatatypeProperty;
               rdfs:domain spt:DataLink;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range xsd:double.
spt:containedIn a owl:TransitiveProperty;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:Place;
                owl:subPropertyOf dul:hasLocation.
spt:describesNetwork a owl:ObjectProperty;
                     rdfs:domain spt:NetworkTopology;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range spt:SensorNetwork;
                     rdfs:subPropertyOf dul:describes.
spt:endpoint rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:subPropertyOf <https://linked-data-api.googlecode.com/svn/trunk/vocab/api.ttl#endpoint>.
spt:energyConsumed a owl:ObjectProperty;
                   rdfs:domain dul:PhysicalObject;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:Energy.
spt:energyLabel a owl:ObjectProperty;
                rdfs:domain dul:PhysicalObject;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:EnergyLabel.
spt:energyOutcomes a owl:ObjectProperty;
                   rdfs:domain spt:Energy;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:Activity.
spt:energyRate a owl:ObjectProperty;
               rdfs:domain spt:Energy;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:Power.
spt:energySource a owl:ObjectProperty;
                 rdfs:domain spt:Energy;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:EnergySource.
spt:energyUsedIn a owl:ObjectProperty;
                 rdfs:domain spt:Energy;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:Activity.
spt:feed a owl:ObjectProperty;
         rdfs:domain ssnx:Platform;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:forSTatus a owl:ObjectProperty;
              rdfs:domain spt:Mood;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:range <http://spitfire-project.eu/ontology/ns/context-types#Status>;
              owl:inverseOf spt:mood;
              owl:subPropertyOf ao:mood.
spt:from a owl:ObjectProperty;
         rdfs:domain spt:DataLink,
                     spt:Motion;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         owl:inverseOf spt:to.
spt:inputEnergy a owl:ObjectProperty;
                rdfs:domain spt:Energy;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:Transducer;
                owl:inverseOf spt:outputEnergy.
spt:ipDevice a owl:DatatypeProperty;
             rdfs:domain ssnx:Sensor;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:range xsd:string.
spt:ipGate a owl:DatatypeProperty;
           rdfs:domain ssnx:Sensor;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
           rdfs:range xsd:string.
spt:layer a owl:TransitiveProperty;
          rdfs:domain spt:NetworkTopology;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:range spt:ModelLayer;
          rdfs:subPropertyOf dul:hasPart;
          owl:inverseOf spt:isLayerOf.
spt:layerOf a owl:TransitiveProperty;
            rdfs:domain spt:ModelLayer;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:NetworkTopology;
            rdfs:subPropertyOf dul:isPartOf;
            owl:inverseOf spt:hasLayer.
spt:linkActivity a owl:ObjectProperty;
                 rdfs:domain spt:NetworkLink;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:LinkActivity;
                 owl:inverseOf spt:linkActivityOf.
spt:linkActivityOf a owl:ObjectProperty;
                   rdfs:domain spt:LinkActivity;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:NetworkLink;
                   owl:inverseOf spt:linkActivity.
spt:linkActivityValue a owl:DatatypeProperty;
                      rdfs:comment "Relationship among a LinkActivity and the amount of packets received in the time range specified by the predicates :startDateTime and :endDateTime";
                      rdfs:domain spt:LinkActivity;
                      rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                      rdfs:range xsd:integer.
spt:linkQuality a owl:ObjectProperty;
                rdfs:domain spt:NetworkLink;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:LinkQuality;
                rdfs:subPropertyOf dul:hasQuality;
                owl:inverseOf spt:isQualityOf.
spt:linkQualityOf a owl:ObjectProperty;
                  rdfs:domain spt:LinkQuality;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range spt:NetworkLink;
                  rdfs:subPropertyOf dul:isQualityOf;
                  owl:inverseOf spt:linkQuality.
spt:linkQualityValue a owl:DatatypeProperty;
                     rdfs:domain spt:LinkQuality;
                     rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                     rdfs:range xsd:double;
                     rdfs:subPropertyOf dul:hasDataValue.
spt:maxValue a owl:ObjectProperty;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:message a owl:DatatypeProperty;
            rdfs:domain <http://spitfire-project.eu/ontology/ns/context-types#Status>;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range xsd:string.
spt:minValue a owl:ObjectProperty;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>.
spt:mood a owl:ObjectProperty;
         rdfs:domain <http://spitfire-project.eu/ontology/ns/context-types#Status>;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         rdfs:range spt:Mood;
         owl:inverseOf spt:forStatus;
         owl:subPropertyOf ao:mood.
spt:nearby a owl:TransitiveProperty;
           rdfs:domain spt:Place;
           rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
           owl:subPropertyOf dul:hasLocation.
spt:netLink a owl:ObjectProperty;
            rdfs:domain dul:PhysicalObject;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:NetworkLink;
            rdfs:subPropertyOf dul:hasComponent;
            owl:inverseOf spt:isLinkOf.
spt:netLinkOf a owl:ObjectProperty;
              rdfs:domain spt:NetworkLink;
              rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
              rdfs:range dul:PhysicalObject;
              rdfs:subPropertyOf dul:isComponentOf;
              owl:inverseOf spt:hasLink.
spt:netRole a owl:ObjectProperty;
            rdfs:domain dul:PhysicalObject;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range dul:Role;
            rdfs:subPropertyOf dul:hasRole.
spt:obs a owl:ObjectProperty;
        rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
        rdfs:range spt:Quantity;
        rdfs:subPropertyOf <http://qudt.org/schema/qudt#quantityKind>,
                           ssnx:observes,
                           ssnx:observedProperty;
        owl:inverseOf spt:obsBy.
spt:obsBy a owl:ObjectProperty;
          rdfs:domain spt:Quantity;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          owl:inverseOf spt:obs.
spt:out a owl:ObjectProperty;
        rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
        rdfs:range spt:OV;
        rdfs:subPropertyOf <http://qudt.org/schema/qudt#quantityValue>,
                           ssnx:madeObservation;
        owl:inverseOf spt:outOf.
spt:outOf a owl:ObjectProperty;
          rdfs:domain spt:OV;
          rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
          rdfs:subPropertyOf <http://qudt.org/schema/qudt#valueForQuantity>,
                             ssnx:observedBy;
          owl:inverseOf spt:out.
spt:outputEnergy a owl:ObjectProperty;
                 rdfs:domain spt:Transducer;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:Energy;
                 owl:inverseOf spt:inputEnergy.
spt:over a owl:TransitiveProperty;
         rdfs:domain spt:Place;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         owl:subPropertyOf dul:hasLocation.
spt:ownedBy a owl:ObjectProperty;
            rdfs:domain dul:PhysicalObject;
            rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
            rdfs:range spt:Agent;
            owl:inverseOf spt:owns.
spt:owns a owl:ObjectProperty;
         rdfs:domain spt:Agent;
         rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
         rdfs:range dul:PhysicalObject;
         owl:inverseOf spt:ownedBy.
spt:priorityLevel a owl:DatatypeProperty;
                  rdfs:domain dul:Role;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range xsd:integer.
spt:projectTopic a owl:TransitiveProperty;
                 rdfs:domain spt:SensorNetwork;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:SensorProjectTopic;
                 owl:inverseOf spt:projectTopicOf.
spt:projectTopicOf a owl:TransitiveProperty;
                   rdfs:domain spt:SensorProjectTopic;
                   rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                   rdfs:range spt:SensorNetwork;
                   owl:inverseOf spt:projectTopic.
spt:sameAsLink a owl:ObjectProperty;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:DataLink;
               rdfs:subPropertyOf owl:sameAs.
spt:sameContext a owl:ObjectProperty;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:DataLink.
spt:sameDomain a owl:ObjectProperty;
               rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
               rdfs:range spt:DataLink.
spt:sameLocation a owl:ObjectProperty;
                 rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                 rdfs:range spt:DataLink.
spt:sameTime a owl:ObjectProperty;
             rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
             rdfs:range spt:DataLink.
spt:savedEnergy a owl:ObjectProperty;
                rdfs:domain dul:PhysicalObject;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:SavedEnergy;
                owl:inverseOf spt:savedEnergyOf.
spt:savedEnergyOf a owl:ObjectProperty;
                  rdfs:domain spt:SavedEnergy;
                  rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                  rdfs:range dul:PhysicalObject;
                  owl:inverseOf spt:savedEnergy.
spt:seeAlsoLink a owl:ObjectProperty;
                rdfs:isDefinedBy <http://spitfire-project.eu/ontology/ns>;
                rdfs:range spt:DataLink;
                rdfs:subPropertyOf rdfs:seeAlso.
