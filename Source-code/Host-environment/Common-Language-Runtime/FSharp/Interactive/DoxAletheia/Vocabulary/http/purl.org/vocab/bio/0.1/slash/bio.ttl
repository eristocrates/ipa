                                                  <http://vocab.org/bio/0.1/.turtle>;
                                a foaf:Document,
                                  dcmitype:Text;
                                foaf:primaryTopic bio:;
                                foaf:topic bio:.
<http://vocab.org/bio/0.1/.turtle> dc11:format "text/plain";
                                   a dcmitype:Text,
                                     foaf:Document;
                                   rdfs:label "Turtle".
foaf:Person a owl:Class;
            owl:equivalentClass [owl:intersectionOf ([owl:onProperty bio:father ; 
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction]
                                                     [owl:onProperty bio:mother ; 
                                                     owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class].
