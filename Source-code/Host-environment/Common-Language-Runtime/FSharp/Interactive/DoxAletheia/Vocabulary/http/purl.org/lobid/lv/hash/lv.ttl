@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix lv: <http://purl.org/lobid/lv#>.

<http://purl.org/lobid/lv> <http://purl.org/dc/terms/creator> <http://lobid.org/team/ap>;
                           <http://purl.org/dc/terms/description> "Under this name space new properties and classes needed for the service lobid ('linking open bibliographic data') are defined . Already existing properties and classes which are (re)used in lobid aren't documented here."@en;
                           <http://purl.org/dc/terms/issued> "2012-01-17";
                           <http://purl.org/dc/terms/license> <http://creativecommons.org/publicdomain/zero/1.0/>;
                           <http://purl.org/dc/terms/modified> "2015-02-09"^^xsd:date;
                           <http://purl.org/dc/terms/publisher> <http://lobid.org/organisation/DE-605>;
                           <http://purl.org/dc/terms/title> "lobid vocab";
                           <http://purl.org/openorg/contact> <mailto:semweb@hbz-nrw.de>;
                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "lv";
                           <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/lobid/lv#";
                           a <http://www.w3.org/2002/07/owl#Ontology>,
                             <http://purl.org/vocommons/voaf#Vocabulary>;
                           <http://www.w3.org/2004/02/skos/core#historyNote> "See the commit history for this vocabulary at https://github.com/lobid/vocabs/commits/master/lobid-vocab.ttl.".
lv:ArchivedWebPage a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Das Produkt der Archivierung einer Webseite."@de,
                                "An archival resource that is product of archiving a web page."@en;
                   rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                   rdfs:label "Archivierte Webseite"@de,
                              "Archived Web Page"@en;
                   rdfs:subClassOf <http://data.archiveshub.ac.uk/def/ArchivalResource>.
lv:Bibliography a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Eine Sammlung von Literaturnachweisen."@de,
                             "A collection of documents relevant to a particular subject or author."@en;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "Bibliografie"@de,
                           "Bibliography"@en;
                rdfs:subClassOf <http://purl.org/ontology/bibo/Collection>.
lv:Biography a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Die Lebensbeschreibung einer Person."@de,
                          "A detailed description or account of a person's life"@en;
             rdfs:isDefinedBy <http://purl.org/lobid/lv>;
             rdfs:label "Biografie"@de,
                        "Biography"@en;
             rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource>.
lv:EditedVolume a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Ein Sammelwerk mit mehreren Beiträgen."@de,
                             "a collection of scholarly or scientific articles written by different authors"@en;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "Aufsatzsammlung"@de,
                           "Edited Volume"@en;
                rdfs:subClassOf <http://purl.org/ontology/bibo/Collection>.
lv:Festschrift a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Einem Gelehrten gewidmete Sammlung von Aufsätzen."@de,
                            "A publication honoring a respected person, especially an academic."@en;
               rdfs:isDefinedBy <http://purl.org/lobid/lv>;
               rdfs:label "Festschrift"@de,
                          "Festschrift"@en;
               rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource>.
lv:Miscellaneous a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Diese Klasse deckt alle Publikationstypen ab, die nicht durch bestehende Klassen erfasst sind. Sie dient insbesondere dem Angebot von Facetten für jene Publikationstypen, die in Bibliothekskatalogen selten zu finden sind."@de,
                              "This class covers all publication types that are not covered by existing class definitions. It is used to enable facets over seldomly found publication types in library catalogs."@en;
                 rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                 rdfs:label "Sonstige"@de,
                            "Miscellaneous"@en;
                 rdfs:seeAlso <https://wiki1.hbz-nrw.de/x/E4AyAQ#Facettenueberhbz01-Daten-misc>;
                 rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource>.
lv:OfficialPublication a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Eine behördliche Publikation für amtliche Bekanntmachungen."@de,
                                    "A publication that records the business and proceedings of a government agency."@en;
                       rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                       rdfs:label "Amtliche Veröffentlichung"@de,
                                  "Official Publication"@en;
                       rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource>.
lv:Schoolbook a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Ein Lehrbuch, das Schullehrer im Unterricht einsetzen."@de,
                           "A textbook used by school teachers in their classes."@en;
              rdfs:isDefinedBy <http://purl.org/lobid/lv>;
              rdfs:label "Schulbuch"@de,
                         "Schoolbook"@en;
              rdfs:subClassOf <http://purl.org/dc/terms/BibliographicResource>.
lv:ags a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
       rdfs:comment "Amtlicher Gemeindeschlüssel (AGS) der Region, in der sich die beschriebene raum-zeitliche Ressource befindet."@de,
                    "Amtlicher Gemeindeschlüssel (AGS) of the region a spatial resource is located in."@en;
       rdfs:isDefinedBy <http://purl.org/lobid/lv>;
       rdfs:label "Community Identification Number"@en,
                  "Amtlicher Gemeindeschlüssel"@de;
       rdfs:range xsd:positiveInteger;
       rdfs:seeAlso <http://en.wikipedia.org/wiki/Community_Identification_Number#Germany>,
                    <http://de.wikipedia.org/wiki/Amtlicher_Gemeindeschlüssel>.
lv:contactqr a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Relates a person, organization or other agent to a QR code that encodes the agent's contact information."@en;
             rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
             rdfs:isDefinedBy <http://purl.org/lobid/lv>;
             rdfs:label "Kontakt-QR-Code"@de,
                        "Contact QR code"@en;
             rdfs:range <http://xmlns.com/foaf/0.1/Image>.
lv:dbsID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "The identifier that was assigned to a library in the context of the German Library Statistics (DBS)."@en,
                      "DBS-Nummer. Der Identifier, der einer Bibliothek innerhalb der Deutschen Bibliotheksstatistik (DBS) zugewiesen wurde."@de;
         rdfs:domain <http://schema.org/Library>;
         rdfs:isDefinedBy <http://purl.org/lobid/lv>;
         rdfs:label "DBS ID"@en,
                    "DBS-ID"@de;
         rdfs:range rdfs:Literal;
         rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
lv:fulltextOnline a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relates a bibliographic resource to an online resource (full text in HTML, PDFs or landing pages in OA repositories, on publishers' websites etc.) that represents the full text of the bibliographic resource or contains a link to a full text of the resource. "@en;
                  rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
                  rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                  rdfs:label "Online-Volltext"@de,
                             "Fulltext online"@en;
                  rdfs:range <http://xmlns.com/foaf/0.1/Document>.
lv:fundertype a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Indicates which type an institution's funder is of. It should be used with a controlled vocabulary like http://purl.org/lobid/fundertype."@en;
              rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
              rdfs:isDefinedBy <http://purl.org/lobid/lv>;
              rdfs:label "Art des Unterhaltträgers"@de,
                         "Type of funding organization"@en;
              rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
lv:hbzID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "The identifier that is assigned to a bibliographic resource in the hbz union catalogue."@en,
                      "HT-Nummer. Der Identifier, der einer bibliographischen Ressource im hbz-Verbundkatalog zugewiesen wurde."@de;
         rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
         rdfs:isDefinedBy <http://purl.org/lobid/lv>;
         rdfs:label "hbz ID"@en,
                    "hbz-ID"@de;
         rdfs:range rdfs:Literal;
         rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
lv:isil a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:comment "International Standard Identifier for Libraries and Related Organizations (ISIL). 'An ISIL identifies an organization, i.e., a library or a related organization, or one of its subordinate units, which is responsible for an action or service in a bibliographic environment (e.g. creation of machine-readable information). It can be used to identify the originator or holder of a resource (e.g. library material).' The literal should conform to this regular expression: [A-Z]{1,4}-[0-9a-zA-Z:-/]{1,11} ."@en,
                     "International Standard Identifier for Libraries and Related Organizations (ISIL). Ein eindeutiger Identifikator für Bibliotheken und verwandte Einrichtungen oder untergeordnete Organisationseinheiten, der durch ISIL-Agenturen vergeben wird. Das Literal sollte durch den folgenden regulären Ausdruck gematcht werden: [A-Z]{1,4}-[0-9a-zA-Z:-/]{1,11} ."@de;
        rdfs:isDefinedBy <http://purl.org/lobid/lv>;
        rdfs:label "ISIL";
        rdfs:range [<http://www.w3.org/2002/07/owl#withRestrictions> ([xsd:pattern "[A-Z]{1,4}-[0-9a-zA-Z:-/]{1,11}"]) ; 
                    <http://www.w3.org/2002/07/owl#onDatatype> xsd:string ; 
                    a rdfs:Datatype];
        rdfs:seeAlso <http://biblstandard.dk/isil/scope.htm>;
        rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
lv:nwbibspatial a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Links a resource in the Northrhine-Westphalian Bibliography (NWBib) to a concept in NWBib's spatial classification."@en,
                             "Verlinkt eine Ressource aus der Nordrhein-Westfälischen Bibliographie mit einer Systemstelle aus der NWBib-Ortssystematik."@de;
                rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "NWBib spatial subject heading"@en,
                           "NWBib-Ortsschlagwort"@de;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                rdfs:subPropertyOf <http://purl.org/dc/terms/subject>.
lv:nwbibsubject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Links a resource in the Northrhine-Westphalian Bibliography (NWBib) to a concept in NWBib's subject classification."@en,
                             "Verlinkt eine Ressource aus der Nordrhein-Westfälischen Bibliographie (NWBib) mit einer Systemstelle aus der NWBib-Sachsystematik."@de;
                rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "NWBib subject heading"@en,
                           "NWBib-Sachschlagwort"@de;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                rdfs:subPropertyOf <http://purl.org/dc/terms/subject>.
lv:rs a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
      rdfs:comment "Regionalschlüssel der Region, in der sich die beschriebene raum-zeitliche Ressource befindet."@de,
                   "Key of the region a spatial resource is located in."@en;
      rdfs:isDefinedBy <http://purl.org/lobid/lv>;
      rdfs:label "Region key"@en,
                 "Regionalschlüssel"@de;
      rdfs:range xsd:positiveInteger;
      rdfs:seeAlso <https://de.wikipedia.org/wiki/Amtlicher_Gemeindeschlüssel#Regionalschl.C3.BCssel>.
lv:stocksize a rdf:Property;
             rdfs:comment "Indicates an institution's stock size. This property is especially used to indicate the size of a library's collection. It is recommended to be used with the controlled vocabulary at http://purl.org/lobid/stocksize."@en;
             rdfs:domain <http://xmlns.com/foaf/0.1/Organization>;
             rdfs:isDefinedBy <http://purl.org/lobid/lv>;
             rdfs:label "Bestandsgröße"@de,
                        "Stock Size"@en.
lv:subjectChain a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "A pipe-separated list of subject terms, optionally followed by a comma-seperated list of permutations (in parentheses)."@en;
                rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "Schlagwortfolge"@de,
                           "Chain of subject terms"@en;
                rdfs:range rdfs:Literal.
lv:titleKeyword a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Indicates a title keyword, possibly in a different spelling than used in the original title."@en;
                rdfs:domain <http://schema.org/CreativeWork>;
                rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                rdfs:label "Titelstichwort"@de,
                           "Title keyword"@en.
lv:urn a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
       rdfs:comment "This property is used to indicate the uniform resource name (URN) of a bibliographic resource. The URN must be stated as a string not as URI, thus identifying the identifier itself and not the resource that is identified by the URN."@en;
       rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
       rdfs:isDefinedBy <http://purl.org/lobid/lv>;
       rdfs:label "URN"@de,
                  "URN"@en;
       rdfs:range rdfs:Literal.
lv:webPageArchived a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "This property is used to link the product of archiving a web page to the web page being archived."@en;
                   rdfs:domain lv:ArchivedWebPage;
                   rdfs:isDefinedBy <http://purl.org/lobid/lv>;
                   rdfs:label "Archivierte Webseite"@de,
                              "Web page archived"@en;
                   rdfs:range <http://schema.org/WebPage>.
lv:zdbID a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:comment "The identifier that is assigned to a bibliographic resource in the German Journal Database (Zeitschriftendatenbank, ZDB)."@en,
                      "ZDB-Nummer. Der Identifier, der einer bibliographischen Ressource in der Zeitschriftendatenbank (ZDB) zugewiesen wurde."@de;
         rdfs:domain <http://purl.org/dc/terms/BibliographicResource>;
         rdfs:isDefinedBy <http://purl.org/lobid/lv>;
         rdfs:label "ZDB ID"@en,
                    "ZDB-ID"@de;
         rdfs:range rdfs:Literal;
         rdfs:subPropertyOf <http://purl.org/dc/terms/identifier>.
