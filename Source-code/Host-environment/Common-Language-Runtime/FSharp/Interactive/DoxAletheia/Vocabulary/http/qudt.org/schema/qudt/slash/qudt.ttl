                  rdfs:label "min inclusive";
                  rdfs:subPropertyOf qudt:lowerBound.
qudt:mySQLName a owl:DatatypeProperty;
               rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                                <http://qudt.org/2.1/schema/qudt>;
               rdfs:label "MySQL name";
               rdfs:range xsd:string.
qudt:negativeDeltaLimit dcterms:description "A negative change limit between consecutive sample values for a parameter. The Negative Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined."^^rdf:HTML;
                        a owl:DatatypeProperty;
                        rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                                         <http://qudt.org/2.1/schema/qudt>;
                        rdfs:label "negative delta limit";
                        rdfs:range xsd:string.
qudt:normativeReference dcterms:description "Provides a way to reference information that is an authorative source providing a standard definition"^^rdf:HTML;
