qudt:referenceUnit a owl:ObjectProperty,
                     owl:FunctionalProperty;
                   rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                                    <http://qudt.org/2.1/schema/qudt>;
                   rdfs:label "reference unit".
qudt:relativeStandardUncertainty dcterms:description "The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value."^^rdf:HTML;
                                 a owl:DatatypeProperty;
                                 rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                                                  <http://qudt.org/2.1/schema/qudt>;
                                 rdfs:label "relative standard uncertainty";
