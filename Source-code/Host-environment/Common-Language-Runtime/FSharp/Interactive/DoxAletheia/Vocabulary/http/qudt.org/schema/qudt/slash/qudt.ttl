qudt:orderedType a rdf:Property;
                 rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                                  <http://qudt.org/2.1/schema/qudt>;
                 rdfs:label "ordered type".
qudt:outOfScope a owl:AnnotationProperty;
