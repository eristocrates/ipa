                                               "http://www.bipm.org/utils/common/documents/jcgm/JCGM_200_2008.pdf"^^xsd:anyURI,
                                               "http://unitsofmeasure.org/trac"^^xsd:anyURI,
                                               "https://www.nist.gov/physical-measurement-laboratory/special-publication-811"^^xsd:anyURI;
                     vaem:graphName "qudt";
