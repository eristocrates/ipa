qudt:quantity dcterms:description "a property to relate an observable thing with a quantity (qud:Quantity)"^^rdf:HTML;
              a owl:ObjectProperty;
              rdfs:isDefinedBy <http://qudt.org/schema/qudt>,
                               <http://qudt.org/2.1/schema/qudt>;
              rdfs:label "quantity".
qudt:quantityValue a owl:ObjectProperty;
