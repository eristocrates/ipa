gml:Solid a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
          rdfs:label "Solid"@en;
          rdfs:subClassOf gml:AbstractGeometricPrimitive.
gml:Sphere a <http://www.w3.org/2002/07/owl#Class>;
