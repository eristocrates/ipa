@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix gml: <http://www.opengis.net/ont/gml#>.

<http://www.opengis.net/ont/geosparql#Feature> rdfs:isDefinedBy <http://www.opengis.net/ont/gml>.
<http://www.opengis.net/ont/geosparql#Geometry> rdfs:isDefinedBy <http://www.opengis.net/ont/gml>.
<http://www.opengis.net/ont/geosparql#SpatialObject> rdfs:isDefinedBy <http://www.opengis.net/ont/gml>.
<http://www.opengis.net/ont/gml> a <http://www.w3.org/2002/07/owl#Ontology>;
                                 <http://www.w3.org/2002/07/owl#imports> <http://www.opengis.net/ont/geosparql>.
gml:AbstractCurveSegment a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                         rdfs:label "Abstract Curve Segment"@en;
                         rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Geometry>.
gml:AbstractGeometricPrimitive a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                               rdfs:label "Abstract Geometric Primitive"@en;
                               rdfs:subClassOf gml:AbstractGeometry.
gml:AbstractGeometry a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                     rdfs:label "Abstract Geometry"@en;
                     rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Geometry>.
gml:AbstractGriddedSurface a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                           rdfs:label "Abstract Gridded Surface"@en;
                           rdfs:subClassOf gml:AbstractParametricCurveSurface.
gml:AbstractParametricCurveSurface a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                                   rdfs:label "Abstract Parametric Curve Surface"@en;
                                   rdfs:subClassOf gml:AbstractSurfacePatch.
gml:AbstractSurfacePatch a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                         rdfs:label "Abstract Surface Patch"@en;
                         rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Geometry>.
gml:Arc a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
        rdfs:label "Arc"@en;
        rdfs:subClassOf gml:ArcString.
gml:ArcByBulge a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
               rdfs:label "Arc by Bulge"@en;
               rdfs:subClassOf gml:ArcStringByBulge.
gml:ArcByCenterPoint a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                     rdfs:label "Arc by Center Point"@en;
                     rdfs:subClassOf gml:AbstractCurveSegment.
gml:ArcString a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
              rdfs:label "Arc String"@en;
              rdfs:subClassOf gml:AbstractCurveSegment.
gml:ArcStringByBulge a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                     rdfs:label "Arc String by Bulge"@en;
                     rdfs:subClassOf gml:AbstractCurveSegment.
gml:BSpline a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
            rdfs:label "BSpline"@en;
            rdfs:subClassOf gml:SplineCurve.
gml:Bezier a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
           rdfs:label "Bezier"@en;
           rdfs:subClassOf gml:BSpline.
gml:Circle a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
           rdfs:label "Circle"@en;
           rdfs:subClassOf gml:Arc.
gml:CircleByCenterPoint a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                        rdfs:label "CircleByCenterPoint"@en;
                        rdfs:subClassOf gml:ArcByCenterPoint.
gml:Clothoid a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
             rdfs:label "Clothoid"@en;
             rdfs:subClassOf gml:AbstractCurveSegment.
gml:Composite a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
              rdfs:label "Composite"@en;
              rdfs:subClassOf gml:GeometricComplex.
gml:CompositeCurve a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                   rdfs:label "Composite Curve"@en;
                   rdfs:subClassOf gml:Composite,
                                   gml:OrientableCurve.
gml:CompositeSolid a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                   rdfs:label "Composite Solid"@en;
                   rdfs:subClassOf gml:Composite,
                                   gml:Solid.
gml:CompositeSurface a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                     rdfs:label "Composite Surface"@en;
                     rdfs:subClassOf gml:Composite,
                                     gml:OrientableSurface.
gml:Cone a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
         rdfs:label "Cone"@en;
         rdfs:subClassOf gml:AbstractGriddedSurface.
gml:CubicSpline a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
                rdfs:label "Cubic Spline"@en;
                rdfs:subClassOf gml:PolynomialSpline.
gml:Curve a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:isDefinedBy <http://www.opengis.net/ont/gml>;
          rdfs:label "Curve"@en;
          rdfs:subClassOf gml:AbstractGeometricPrimitive,
                          gml:OrientableCurve.
gml:Cylinder a <http://www.w3.org/2002/07/owl#Class>;
