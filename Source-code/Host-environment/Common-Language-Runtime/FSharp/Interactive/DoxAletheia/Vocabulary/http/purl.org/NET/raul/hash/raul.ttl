          foaf:member raul:juum;
          foaf:name "DERI".
raul:LiDRC a dcterms:Agent;
           foaf:homepage <http://linkeddata.deri.ie/>;
           foaf:member raul:Michael%20Hausenblas;
           foaf:name "LiDRC".
