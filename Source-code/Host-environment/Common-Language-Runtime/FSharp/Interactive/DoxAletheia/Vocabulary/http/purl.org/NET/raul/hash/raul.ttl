@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix raul: <http://purl.org/NET/raul#>.

raul:Button a rdfs:Class,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Button";
            rdfs:subClassOf raul:Widget.
raul:CREATEOperation a rdfs:Class,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "CREATEOperation";
                     rdfs:subClassOf raul:CRUDOperation.
raul:CRUDOperation a rdfs:Class,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "CRUDOperation";
                   rdfs:subClassOf <http://www.w3.org/2002/07/owl#Class>.
raul:Checkbox a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Checkbox";
              rdfs:subClassOf raul:Button.
raul:DELETEOperation a rdfs:Class,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "DELETEOperation";
                     rdfs:subClassOf raul:CRUDOperation.
raul:DynamicGroup a rdfs:Class,
                    <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "DynamicGroup";
                  rdfs:subClassOf raul:Widget.
raul:Group a rdfs:Class,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "Group";
           rdfs:subClassOf raul:Widget.
raul:Listbox a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Listbox";
             rdfs:subClassOf raul:Widget.
raul:Listitem a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Listitem";
              rdfs:subClassOf raul:Widget.
raul:Page a rdfs:Class,
            <http://www.w3.org/2002/07/owl#Class>;
          rdfs:label "Page";
          rdfs:subClassOf <http://www.w3.org/2002/07/owl#Class>.
raul:READOperation a rdfs:Class,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "READOperation";
                   rdfs:subClassOf raul:CRUDOperation.
raul:Radiobutton a rdfs:Class,
                   <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Radiobutton";
                 rdfs:subClassOf raul:Button.
raul:Textbox a rdfs:Class,
               <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "Textbox";
             rdfs:subClassOf raul:Widget.
raul:UPDATEOperation a rdfs:Class,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "UPDATEOperation";
                     rdfs:subClassOf raul:CRUDOperation.
raul:Widget a rdfs:Class,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Widget";
            rdfs:subClassOf raul:Page.
raul:WidgetContainer a rdfs:Class,
                       <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "WidgetContainer";
                     rdfs:subClassOf raul:Widget.
raul:action a rdf:Property,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain raul:WidgetContainer;
            rdfs:label "action";
            rdfs:range xsd:string.
raul:checked a rdf:Property,
               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain raul:Button;
             rdfs:label "checked";
             rdfs:range xsd:boolean.
raul:class a rdf:Property,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain raul:Page;
           rdfs:label "class";
           rdfs:range xsd:string.
raul:command a rdf:Property,
               <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain raul:Button;
             rdfs:label "command";
             rdfs:range xsd:string.
raul:disabled a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain raul:Widget;
              rdfs:label "disabled";
              rdfs:range xsd:boolean.
raul:group a rdf:Property;
           rdfs:domain raul:Widget;
           rdfs:label "group";
           rdfs:range raul:Group.
raul:hidden a rdf:Property,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain raul:Widget;
            rdfs:label "hidden";
            rdfs:range xsd:boolean.
raul:id a rdf:Property,
          <http://www.w3.org/2002/07/owl#DatatypeProperty>;
        rdfs:domain raul:Page;
        rdfs:label "id";
        rdfs:range xsd:string.
raul:isPassword a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain raul:Textbox;
                rdfs:label "isPassword";
                rdfs:range xsd:boolean.
raul:label a rdf:Property,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain raul:Widget;
           rdfs:label "label";
           rdfs:range xsd:string.
raul:list a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:domain raul:Page;
          rdfs:label "list";
          rdfs:range rdfs:Literal.
raul:maxlength a rdf:Property,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain raul:Textbox;
               rdfs:label "maxlength";
               rdfs:range xsd:int.
raul:method a rdf:Property;
            rdfs:domain raul:WidgetContainer;
            rdfs:label "method";
            rdfs:range raul:CRUDOperation.
raul:multiple a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain raul:Listbox;
              rdfs:label "multiple";
              rdfs:range xsd:boolean.
raul:name a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:domain raul:Widget;
          rdfs:label "name";
          rdfs:range xsd:string.
raul:row a rdf:Property,
           <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:domain raul:Widget;
         rdfs:label "row";
         rdfs:range xsd:integer.
raul:selected a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:domain raul:Listitem;
              rdfs:label "selected";
              rdfs:range xsd:boolean.
raul:size a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:domain raul:Textbox;
          rdfs:label "size";
          rdfs:range xsd:string.
raul:title a rdf:Property,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain raul:Page;
           rdfs:label "title";
           rdfs:range xsd:string.
raul:value a rdf:Property,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain raul:Widget;
           rdfs:label "value";
           rdfs:range xsd:string.
