@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix voaf: <http://purl.org/vocommons/voaf#>.
@prefix vocals: <http://w3id.org/rsp/vocals#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.

voaf:Vocabulary a owl:Class.
vocals: dc11:publisher <http://aislab.hevs.ch/>;
        dcterms:creator <http://streamreasoning.org/vois#YehiaAboSedira>,
                        <http://w3id.org/people/jpcik/me>,
                        <http://streamreasoning.org/vois#RiccardoTommasini>;
        dcterms:description "Cette ontologie a été conçue pour representer des données et meta-données de streams RDF, ainsi que leurs points d'accès."@fr,
                            "Esta ontología has sido diseñada para representar Streams de datos en RDF, así como los endpoints a través de los cuales se puede acceder a los datos de estos streams y los meta datos correspondientes."@es,
                            "This ontology aims to model RDF streams, their metadata, and access endpoints for publishing and consuming these streams"@en;
        dcterms:issued "2017-12-01"^^xsd:date;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
        dcterms:modified "2017-12-10"^^xsd:date;
        dcterms:publisher <http://w3id.org/hes-so/aislab>;
        dcterms:rights "Copyright © 2017 Politecnico di Milano & HES-SO Valais-Wallis";
        dcterms:title "VoCaLS: A Vocabulary and Catalog for Linked Streams"@en,
                      "VoCaLS: Vocabulario y catálogo para Streams enlazados"@es,
                      "VoCaLS: ontologie de representation de données et metadonnées de streams"@fr;
        vann:preferredNamespacePrefix "vocals";
        vann:preferredNamespaceUri "http://w3id.org/rsp/vocals#";
        a owl:Ontology,
          owl:NamedIndividual,
          voaf:Vocabulary;
        rdfs:comment "Esta ontología has sido diseñada para representar Streams de datos en RDF, así como los endpoints a través de los cuales se puede acceder a los datos de estos streams;  y los meta datos correspondientes."@es,
                     "This ontology aims to model RDF streams, their metadata, and access endpoints for publishing and consuming these streams"@en,
                     "Cette ontologie a été conçue pour representer des données et meta-données de streams RDF, ainsi que leurs points d'accès."@fr;
        owl:imports aerdcat:;
        owl:versionInfo "0.1.1".
vocals:RDFStream a owl:Class;
                 rdfs:comment "A stream composed of RDF data elements, i.e. RDF graphs and/or triples."@en;
                 rdfs:isDefinedBy vocals:;
                 rdfs:label "RDFStream"@en;
                 rdfs:seeAlso vocals:Stream;
                 rdfs:subClassOf vocals:Stream.
vocals:Stream a owl:Class;
              rdfs:comment "A potentially infinite sequence of data elements. A stream may be findable and accesible on the Web."@en;
              rdfs:isDefinedBy vocals:;
              rdfs:label "Stream"@en;
              rdfs:seeAlso vocals:StreamDistribution;
              rdfs:subClassOf aerdcat:Dataset.
vocals:StreamDescriptor a owl:Class;
                        rdfs:comment "A Stream Descriptor is a Web document that contains the description of a Stream."@en;
                        rdfs:isDefinedBy vocals:;
                        rdfs:label "StreamDescriptor"@en;
                        rdfs:seeAlso vocals:Stream;
                        rdfs:subClassOf foaf:Document,
                                        aerdcat:CatalogRecord.
vocals:StreamDistribution a owl:Class;
                          rdfs:comment "Represents a specific available form of a stream. Each stream might be available in different forms, these forms might represent different access points of the stream. Examples of distributions include a WebSocket endpoint, an HTTP endpoint, a Server-Sent Events endpoint, MQTT, etc."@en;
                          rdfs:isDefinedBy vocals:;
                          rdfs:label "StreamDistribution"@en;
                          rdfs:seeAlso vocals:Stream;
                          rdfs:subClassOf aerdcat:Distribution;
                          owl:equivalentClass vocals:StreamEndpoint.
vocals:StreamEndpoint a owl:Class;
                      rdfs:comment "Represents a specific available form of a stream. Each stream might be available in different forms, these forms might represent different access points of the stream. Examples of endpoints include a WebSocket endpoint, an HTTP endpoint, a Server-Sent Events endpoint, MQTT, etc."@en;
                      rdfs:isDefinedBy vocals:;
                      rdfs:label "StreamEndpoint"@en;
                      rdfs:subClassOf aerdcat:Distribution.
vocals:StreamPartition a owl:Class;
                       rdfs:comment "A finite subset of the stream that are made available to be accessed and consumed by standard Linked Data services."@en;
                       rdfs:isDefinedBy vocals:;
                       rdfs:label "StreamPartition"@en;
                       rdfs:seeAlso vocals:previous,
                                    vocals:Stream;
                       rdfs:subClassOf aerdcat:Dataset.
vocals:hasEndpoint a owl:ObjectProperty;
                   rdfs:comment "A relationship between a Stream and a StreamEndpoint. A stream may have several endpoints through which its contents can be accessible."@en;
                   rdfs:domain vocals:Stream;
                   rdfs:isDefinedBy vocals:;
                   rdfs:label "hasEndpoint"@en;
                   rdfs:range vocals:StreamEndpoint;
                   rdfs:seeAlso vocals:StreamEndpoint,
                                vocals:Stream;
                   rdfs:subPropertyOf aerdcat:distribution.
vocals:hasPartition a owl:ObjectProperty;
                    rdfs:comment "A relationship between a Stream and a partition, or portion of elements streamed"@en;
                    rdfs:domain vocals:Stream;
                    rdfs:isDefinedBy vocals:;
                    rdfs:label "hasPartition"@en;
                    rdfs:range vocals:StreamPartition;
                    rdfs:seeAlso vocals:StreamPartition,
                                 vocals:Stream.
vocals:previous a owl:ObjectProperty;
                rdfs:comment "Relationship between a stream partition and the previous partition in the stream. it connects stream partitions in order"@en;
                rdfs:domain vocals:StreamPartition;
                rdfs:isDefinedBy vocals:;
                rdfs:label "previous"@en;
                rdfs:range vocals:StreamPartition;
                rdfs:seeAlso vocals:StreamPartition.
aerdcat:CatalogRecord a owl:Class.
aerdcat:Dataset a owl:Class.
aerdcat:Distribution a owl:Class.
aerdcat:distribution a owl:ObjectProperty.
foaf:Document a owl:Class.
