                           a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:subPropertyOf coll:item.
coll:firstItemOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The link to a list in which the item is first item."@en;
                 rdfs:label "is first item of"@en;
                 rdfs:subPropertyOf coll:itemOf;
                 <http://www.w3.org/2002/07/owl#inverseOf> coll:firstItem.
coll:followedBy <http://purl.org/dc/elements/1.1/description> "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is followed by I[i+1], ... , I[n-1] and I[n]."@en;
                a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link to the following item in a list."@en;
                rdfs:domain coll:ListItem;
                rdfs:label "is followed by"@en;
                rdfs:range coll:ListItem.
coll:index a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "A number identifying the position, starting from 1, of a particular list item within a list."@en;
           rdfs:domain coll:ListItem;
           rdfs:label "has index"@en;
           rdfs:range xsd:positiveInteger.
coll:item a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "The link to every item of the bag"@en;
          rdfs:domain coll:Bag;
          rdfs:label "has item"@en;
          rdfs:range coll:Item;
          <http://www.w3.org/2002/07/owl#propertyChainAxiom> (coll:item
                                                              coll:nextItem).
coll:itemContent a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "The link to the actual resource to which the item refers."@en;
                 rdfs:domain coll:Item;
                 rdfs:label "has item content"@en;
                 rdfs:range [<http://www.w3.org/2002/07/owl#complementOf> coll:Item ; 
                             a <http://www.w3.org/2002/07/owl#Class>].
coll:itemContentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The link to the item that refers to the resource."@en;
                   rdfs:label "is item content of"@en;
                   <http://www.w3.org/2002/07/owl#inverseOf> coll:itemContent.
coll:itemOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "The link to a bag in which the item is member."@en;
            rdfs:label "is item of"@en;
            <http://www.w3.org/2002/07/owl#inverseOf> coll:item.
coll:lastItem a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The link to the last item of the list."@en;
              rdfs:domain coll:List;
              rdfs:label "has last item"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#intersectionOf> (coll:ListItem
                                                                          [<http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                                                          <http://www.w3.org/2002/07/owl#onProperty> coll:nextItem ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:subPropertyOf coll:item.
coll:lastItemOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link to a list in which the item is last item."@en;
                rdfs:label "is last item of"@en;
                rdfs:subPropertyOf coll:itemOf;
                <http://www.w3.org/2002/07/owl#inverseOf> coll:lastItem.
coll:nextItem <http://purl.org/dc/elements/1.1/description> "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the next item of I[i] is I[i+1]."@en;
              a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "The link to the next item in a list."@en;
              rdfs:label "has next item"@en;
              rdfs:subPropertyOf coll:followedBy.
coll:precededBy <http://purl.org/dc/elements/1.1/description> "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is preceded by I[i-1], ... , I[2] and I[1]."@en;
                a <http://www.w3.org/2002/07/owl#TransitiveProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The link to the preceding item in a list."@en;
                rdfs:label "is preceded by"@en;
                <http://www.w3.org/2002/07/owl#inverseOf> coll:followedBy.
coll:previousItem <http://purl.org/dc/elements/1.1/description> "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the previous item of I[i] is I[i-1]."@en;
                  a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The link to the previous item in a list."@en;
                  rdfs:label "has previous item"@en;
                  rdfs:subPropertyOf coll:precededBy;
                  <http://www.w3.org/2002/07/owl#inverseOf> coll:nextItem.
coll:size <http://purl.org/dc/elements/1.1/description> """CO defines the size of a collection as the sum of the number of times entities that are part of the collection appear in it. This means that co:size considers how much each entity is involved by a particular collection, i.e.:
- the size of the set {a, b, c} is three
- the size of the bag [a, a, b, b, b, c] is five
- the size of the list (a, b, c, b, a, b, c, c) is seven"""@en;
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "The number of item belonging to a collection."@en;
          rdfs:domain coll:Collection;
          rdfs:label "has size"@en;
          rdfs:range xsd:nonNegativeInteger.
