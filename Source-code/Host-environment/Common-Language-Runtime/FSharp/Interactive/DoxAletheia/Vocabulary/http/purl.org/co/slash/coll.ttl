<http://purl.org/co> dc11:contributor "Silvio Peroni",
                                      "Paolo Ciccarese",
                                      "Marco Ocana";
                     dc11:creator <http://www.paolociccarese.info/>;
                     dc11:date "March 19, 2012";
                     dc11:format "application/rdf+xml";
                     dc11:language "en";
                     dc11:title """The Collections Ontology
(CO)"""@en;
                     a owl:Ontology;
                     owl:imports <http://www.essepuntato.it/2009/10/error>;
                     owl:versionInfo "2.0".
coll:Bag a owl:Class;
         rdfs:comment "Collection that can have a number of copies of each object"@en;
         rdfs:label "bag"@en;
         rdfs:subClassOf coll:Collection;
         owl:disjointWith coll:Set.
coll:Collection a owl:Class;
                rdfs:comment "A group of objects that can be considered as a whole."@en;
                rdfs:label "collection"@en;
                rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty coll:size ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom owl:Thing ; 
                                 owl:onProperty coll:element ; 
                                 a owl:Restriction],
                                owl:Thing;
                owl:disjointWith coll:Item.
coll:Item a owl:Class;
          rdfs:comment "Element belonging to a bag"@en;
          rdfs:label "item"@en;
          rdfs:subClassOf [owl:someValuesFrom coll:Bag ; 
                           owl:onProperty [owl:inverseOf coll:item] ; 
                           a owl:Restriction],
                          owl:Thing.
coll:List a owl:Class;
          rdfs:comment "An ordered array of items, that can be present in multiple copies"@en;
          rdfs:label "list"@en;
          rdfs:subClassOf [owl:intersectionOf (coll:Bag
                                               [owl:allValuesFrom coll:ListItem ; 
                                               owl:onProperty coll:item ; 
                                               a owl:Restriction]) ; 
                           a owl:Class],
                          [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                           owl:onProperty coll:firstItem ; 
                           a owl:Restriction],
                          [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                           owl:onProperty coll:lastItem ; 
                           a owl:Restriction].
coll:ListItem a owl:Class;
              rdfs:comment "element belonging to a list"@en;
              rdfs:label "list item"@en;
              rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                               owl:onProperty coll:index ; 
                               a owl:Restriction],
                              coll:Item.
coll:Set a owl:Class;
         rdfs:comment "A collection that cannot contain duplicate elements."@en;
         rdfs:label "set"@en;
         rdfs:subClassOf coll:Collection.
coll:element a owl:ObjectProperty;
             rdfs:comment "The link to the members of a collection"@en;
             rdfs:domain coll:Collection;
             rdfs:label "has element"@en;
             owl:propertyChainAxiom (coll:item
                                     coll:itemContent).
coll:elementOf a owl:ObjectProperty;
               rdfs:comment "The link to a collection in which the object is member."@en;
               rdfs:label "is element of"@en;
               owl:inverseOf coll:element.
coll:firstItem a owl:FunctionalProperty,
                 owl:ObjectProperty;
               rdfs:comment "The link to the first item of the list."@en;
               rdfs:domain coll:List;
               rdfs:label "has first item"@en;
               rdfs:range [owl:intersectionOf (coll:ListItem
                                               [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty coll:previousItem ; 
                                               a owl:Restriction]
                                               [owl:hasValue "1"^^xsd:positiveInteger ; 
                                               owl:onProperty coll:index ; 
                                               a owl:Restriction]) ; 
                           a owl:Class];
               rdfs:subPropertyOf coll:item.
coll:firstItemOf a owl:ObjectProperty;
                 rdfs:comment "The link to a list in which the item is first item."@en;
                 rdfs:label "is first item of"@en;
                 rdfs:subPropertyOf coll:itemOf;
                 owl:inverseOf coll:firstItem.
coll:followedBy dc11:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is followed by I[i+1], ... , I[n-1] and I[n]."@en;
                a owl:TransitiveProperty,
                  owl:ObjectProperty;
                rdfs:comment "The link to the following item in a list."@en;
                rdfs:domain coll:ListItem;
                rdfs:label "is followed by"@en;
                rdfs:range coll:ListItem.
coll:index a owl:DatatypeProperty;
           rdfs:comment "A number identifying the position, starting from 1, of a particular list item within a list."@en;
           rdfs:domain coll:ListItem;
           rdfs:label "has index"@en;
           rdfs:range xsd:positiveInteger.
coll:item a owl:ObjectProperty;
          rdfs:comment "The link to every item of the bag"@en;
          rdfs:domain coll:Bag;
          rdfs:label "has item"@en;
          rdfs:range coll:Item;
          owl:propertyChainAxiom (coll:item
                                  coll:nextItem).
coll:itemContent a owl:FunctionalProperty,
                   owl:ObjectProperty;
                 rdfs:comment "The link to the actual resource to which the item refers."@en;
                 rdfs:domain coll:Item;
                 rdfs:label "has item content"@en;
                 rdfs:range [owl:complementOf coll:Item ; 
                             a owl:Class].
coll:itemContentOf a owl:ObjectProperty;
                   rdfs:comment "The link to the item that refers to the resource."@en;
                   rdfs:label "is item content of"@en;
                   owl:inverseOf coll:itemContent.
coll:itemOf a owl:ObjectProperty;
            rdfs:comment "The link to a bag in which the item is member."@en;
            rdfs:label "is item of"@en;
            owl:inverseOf coll:item.
coll:lastItem a owl:FunctionalProperty,
                owl:ObjectProperty;
              rdfs:comment "The link to the last item of the list."@en;
              rdfs:domain coll:List;
              rdfs:label "has last item"@en;
              rdfs:range [owl:intersectionOf (coll:ListItem
                                              [owl:cardinality "0"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty coll:nextItem ; 
                                              a owl:Restriction]) ; 
                          a owl:Class];
              rdfs:subPropertyOf coll:item.
coll:lastItemOf a owl:ObjectProperty;
                rdfs:comment "The link to a list in which the item is last item."@en;
                rdfs:label "is last item of"@en;
                rdfs:subPropertyOf coll:itemOf;
                owl:inverseOf coll:lastItem.
coll:nextItem dc11:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the next item of I[i] is I[i+1]."@en;
              a owl:FunctionalProperty,
                owl:ObjectProperty;
              rdfs:comment "The link to the next item in a list."@en;
              rdfs:label "has next item"@en;
              rdfs:subPropertyOf coll:followedBy.
coll:precededBy dc11:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is preceded by I[i-1], ... , I[2] and I[1]."@en;
                a owl:TransitiveProperty,
                  owl:ObjectProperty;
                rdfs:comment "The link to the preceding item in a list."@en;
                rdfs:label "is preceded by"@en;
                owl:inverseOf coll:followedBy.
coll:previousItem dc11:description "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the previous item of I[i] is I[i-1]."@en;
                  a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "The link to the previous item in a list."@en;
                  rdfs:label "has previous item"@en;
                  rdfs:subPropertyOf coll:precededBy;
                  owl:inverseOf coll:nextItem.
coll:size dc11:description """CO defines the size of a collection as the sum of the number of times entities that are part of the collection appear in it. This means that co:size considers how much each entity is involved by a particular collection, i.e.:
- the size of the set {a, b, c} is three
- the size of the bag [a, a, b, b, b, c] is five
- the size of the list (a, b, c, b, a, b, c, c) is seven"""@en;
          a owl:DatatypeProperty;
          rdfs:comment "The number of item belonging to a collection."@en;
          rdfs:domain coll:Collection;
          rdfs:label "has size"@en;
          rdfs:range xsd:nonNegativeInteger.
