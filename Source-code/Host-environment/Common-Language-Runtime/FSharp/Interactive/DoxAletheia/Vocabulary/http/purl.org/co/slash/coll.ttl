coll:Bag a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "Collection that can have a number of copies of each object"@en;
         rdfs:label "bag"@en;
         rdfs:subClassOf coll:Collection;
         <http://www.w3.org/2002/07/owl#disjointWith> coll:Set.
coll:Collection a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A group of objects that can be considered as a whole."@en;
                rdfs:label "collection"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> coll:size ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
