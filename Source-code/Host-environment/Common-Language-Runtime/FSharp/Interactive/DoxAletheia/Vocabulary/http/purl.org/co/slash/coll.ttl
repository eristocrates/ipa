          rdfs:comment "An ordered array of items, that can be present in multiple copies"@en;
          rdfs:label "list"@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (coll:Bag
                                                                           [<http://www.w3.org/2002/07/owl#allValuesFrom> coll:ListItem ; 
                                                                           <http://www.w3.org/2002/07/owl#onProperty> coll:item ; 
                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
