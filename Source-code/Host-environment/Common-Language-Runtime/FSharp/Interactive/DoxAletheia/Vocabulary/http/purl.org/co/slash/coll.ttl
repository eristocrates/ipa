              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               <http://www.w3.org/2002/07/owl#onProperty> coll:index ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              coll:Item.
coll:Set a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "A collection that cannot contain duplicate elements."@en;
         rdfs:label "set"@en;
         rdfs:subClassOf coll:Collection.
coll:element a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "The link to the members of a collection"@en;
             rdfs:domain coll:Collection;
             rdfs:label "has element"@en;
             <http://www.w3.org/2002/07/owl#propertyChainAxiom> (coll:item
                                                                 coll:itemContent).
coll:elementOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The link to a collection in which the object is member."@en;
               rdfs:label "is element of"@en;
               <http://www.w3.org/2002/07/owl#inverseOf> coll:element.
coll:firstItem a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                 <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The link to the first item of the list."@en;
               rdfs:domain coll:List;
               rdfs:label "has first item"@en;
               rdfs:range [<http://www.w3.org/2002/07/owl#intersectionOf> (coll:ListItem
                                                                           [<http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
