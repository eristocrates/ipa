<http://schema.org/author> ebg:order 45 ;
                           <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                           <http://schema.org/rangeIncludes> <http://schema.org/Person>,
                                                             <http://schema.org/Organization>;
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "author";
                           <http://www.w3.org/2004/02/skos/core#definition> "Agent who specified the rules and organization of the identifier system",
                                                                            "Agent who specified the rules and organisation of an Identifier System";
                           <http://www.w3.org/2004/02/skos/core#example> "W3C or TimBL specified web URLs",
                                                                         "W3C specified web URL rules",
                                                                         "Dun and Bradstreet specified DUNS numbers",
                                                                         "GLEIF specified GLEI",
                                                                         "GLEIF specified LEI structure and rules, then formalied it as ISO 17442:2012 Financial services -- Legal Entity Identifier (LEI)".
<http://schema.org/availableLanguage> ebg:order 17 ;
