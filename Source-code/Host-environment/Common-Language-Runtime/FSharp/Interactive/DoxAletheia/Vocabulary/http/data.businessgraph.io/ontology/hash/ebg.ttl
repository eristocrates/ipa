                                                                                  "2010"^^xsd:gYear,
                                                                                  "2010-11"^^xsd:gYearMonth;
                                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Should have a valid XSD datatype.".
<http://schema.org/email> ebg:order 20 ;
                          <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
