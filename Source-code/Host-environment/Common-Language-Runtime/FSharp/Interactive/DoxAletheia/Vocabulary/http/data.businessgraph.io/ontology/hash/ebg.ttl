ebg:WebResource a rdfs:Class;
                rdfs:isDefinedBy ebg:;
                rdfs:label "Web Resource";
                <http://www.w3.org/2004/02/skos/core#definition> "URL complemented with name, language and MIME type(s) to specify what the URL is about".
ebg:adminUnit ebg:order 107 .
ebg:adminUnitL3 ebg:order 31 ;
                <http://schema.org/domainIncludes> <http://www.w3.org/ns/locn#Address>;
                <http://schema.org/rangeIncludes> <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion>;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "admin unit level 3";
                <http://www.w3.org/2004/02/skos/core#definition> "NUTS2 (administrative region) of the address.";
                <http://www.w3.org/2004/02/skos/core#example> "nuts:ITC2 Valle d'Aosta/Vallée d'Aoste",
                                                              "nuts:ITH2 Provincia Autonoma di Trento";
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Use a valid NUTS region. Eg Trentino-Alto Adige/Sudtirol (taken from the Geonames hierarchy above) is not a NUTS region.".
ebg:adminUnitL4 ebg:order 32 ;
                <http://schema.org/domainIncludes> <http://www.w3.org/ns/locn#Address>;
                <http://schema.org/rangeIncludes> <http://rdfdata.eionet.europa.eu/ramon/ontology/NUTSRegion>;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "admin unit level 4";
                <http://www.w3.org/2004/02/skos/core#definition> "NUTS3 (Province) of the address.";
                <http://www.w3.org/2004/02/skos/core#example> "nuts:ITC20 Aosta",
                                                              "nuts:ITH31 Verona".
ebg:adminUnitL5 ebg:order 33 ;
                <http://schema.org/domainIncludes> <http://www.w3.org/ns/locn#Address>;
                <http://schema.org/rangeIncludes> ebg:LAURegion;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "admin unit level 5";
                <http://www.w3.org/2004/02/skos/core#definition> "LAU1 (Municipality/Commune/Settlement) of the address.";
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Some countries (e.g. Bulgaria) use both LAU1 and LAU2 levels. Others (e.g. Italy) use only LAU2.".
ebg:adminUnitL6 ebg:order 34 ;
                <http://schema.org/domainIncludes> <http://www.w3.org/ns/locn#Address>;
                <http://schema.org/rangeIncludes> ebg:LAURegion;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "admin unit level 6";
                <http://www.w3.org/2004/02/skos/core#definition> "LAU2 (Municipality/Commune/Settlement) of the address.";
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Some countries (e.g. Bulgaria) use both LAU1 and LAU2 levels. Others (e.g. Italy) use only LAU2.".
ebg:dissolutionYear ebg:order 16 ;
                    <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                    <http://schema.org/rangeIncludes> xsd:integer;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:label "dissolution year";
                    <http://www.w3.org/2004/02/skos/core#definition> "Year the organization was dissolved or deregistered, as integer.";
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for faceting.".
ebg:exclusionNote ebg:order 108 ;
                  <http://schema.org/domainIncludes> <http://www.w3.org/2004/02/skos/core#Concept>;
                  <http://schema.org/rangeIncludes> rdf:langString;
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Exclusion note of a NACE classification concept";
                  rdfs:isDefinedBy ebg:;
                  rdfs:label "exclusion note".
ebg:foundingYear ebg:order 14 ;
                 <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                 <http://schema.org/rangeIncludes> xsd:integer;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:label "founding year";
                 <http://www.w3.org/2004/02/skos/core#definition> "Year the organization was created, as integer.";
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Used for faceting.".
ebg:geoResolution ebg:order 44 ;
                  <http://schema.org/domainIncludes> <http://schema.org/GeoCoordinates>;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:isDefinedBy ebg:;
                  rdfs:label "geocoordinate resolution";
                  <http://www.w3.org/2004/02/skos/core#definition> "Resolution of a geographic coordinate location: from <resolution/L0> continent (least precise) to <resolution/L10> individual house number (most precise).";
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Values must be mapped to the <resolution/> ConceptScheme (lookup list).",
                                                                  "If geo coordinates are present, resolution must be present too, even if it's a guess. There is no default value.".
ebg:identifierWebResource ebg:order 63 ;
                          <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                          <http://schema.org/rangeIncludes> ebg:IdentifierWebResource;
                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:isDefinedBy ebg:;
                          rdfs:label "identifier web resource";
                          <http://www.w3.org/2004/02/skos/core#definition> "Web resource associated with an identifier system";
                          <http://www.w3.org/2004/02/skos/core#example> "'https://opencorporates.com/companies/{}.xml'  with MIME type 'application/xml'",
                                                                        "'https://opencorporates.com/companies/{}.rdf'  with MIME type 'application/rdf+xml'",
                                                                        "'https://opencorporates.com/companies/{}'      with MIME type 'text/html'",
                                                                        "'https://opencorporates.com/companies/{}.json' with MIME type 'application/json'";
                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Specifies a template that can be used uniformly to build URLs for all identifiers in the system.".
ebg:isEnumerated ebg:order 58 ;
                 <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                 <http://schema.org/rangeIncludes> xsd:boolean;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:isDefinedBy ebg:;
                 rdfs:label "has enumerated identifiers";
                 <http://www.w3.org/2004/02/skos/core#definition> "Whether the system has an Issuer and issued identifiers are kept in a database (register)";
                 <http://www.w3.org/2004/02/skos/core#example> "Websites are not enumerated",
                                                               "Every official register is enumerated".
ebg:isImmutable ebg:order 55 ;
                <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                <http://schema.org/rangeIncludes> xsd:boolean;
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "has immutable identifiers";
                <http://www.w3.org/2004/02/skos/core#definition> "whether identifiers can change";
                <http://www.w3.org/2004/02/skos/core#example> "Some registers encode additional information within the identifier (e.g., some identifiers encode the economic sector of the company). In these cases the identifier changes when the extra information that is encoded changes (see 'Dumb vs. Intelligent Identifiers' in Section 3.1.2.5).".
ebg:isOfficial ebg:order 59 ;
               <http://schema.org/domainIncludes> ebg:IdentifierSystem;
               <http://schema.org/rangeIncludes> xsd:boolean;
               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:isDefinedBy ebg:;
               rdfs:label "is official in jurisdiction";
               <http://www.w3.org/2004/02/skos/core#definition> "Whether the system is considered the official one in all jurisdictions in which it applies.";
               <http://www.w3.org/2004/02/skos/core#example> "False for SDATI identifiers since the SDATI system is not official in Italy.",
                                                             "False for GLEI, since it is not the official register for any of the world's jurisdictions",
                                                             "True for UK Company House identifiers, the official register for the GB jurisdiction",
                                                             "False for Website, Twitter, Facebook in that they don't have any official status".
ebg:isPersistent ebg:order 54 ;
                 <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                 <http://schema.org/rangeIncludes> xsd:boolean;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:isDefinedBy ebg:;
                 rdfs:label "has persistent identifiers";
                 <http://www.w3.org/2004/02/skos/core#definition> "Whether identifiers can be removed from the register (e.g., when a company is dissolved): such are not persistent";
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Some registers 'remove' identifiers when the object they relate to is no longer active, whereas the best practice is to make such identifiers Obsolete.".
ebg:isPublic ebg:order 56 ;
             <http://schema.org/domainIncludes> ebg:IdentifierSystem;
             <http://schema.org/rangeIncludes> xsd:boolean;
             a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:isDefinedBy ebg:;
             rdfs:label "is public";
             <http://www.w3.org/2004/02/skos/core#definition> "whether identifiers from the system are available for public use: consulting, search or download.";
             <http://www.w3.org/2004/02/skos/core#example> "Italian (IT) company identifiers are public. Even though they are not published openly, they are available for a fee, and then can be used freely",
                                                           "DUNS identifiers are not public, even though there are limited lookup services (e.g., https://www.dnb.com/duns-number/lookup.html). Dun and Bradstreet does not allow their use en-masse.";
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Most public systems (but not all) will have some Publishers, and preferably some web resources.".
ebg:isPubliclyTraded ebg:order 7 ;
                     <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                     <http://schema.org/rangeIncludes> xsd:boolean;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:isDefinedBy ebg:;
                     rdfs:label "is publicly traded";
                     <http://www.w3.org/2004/02/skos/core#definition> "Whether the company is publicly traded (listed at a stock exchange) [ebg:].".
ebg:isSingleValued ebg:order 53 ;
                   <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                   <http://schema.org/rangeIncludes> xsd:boolean;
                   a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:isDefinedBy ebg:;
                   rdfs:label "is single-valued";
                   <http://www.w3.org/2004/02/skos/core#definition> "Whether each entity has only one identifier in the system";
                   <http://www.w3.org/2004/02/skos/core#example> "Official person names are single-valued, since each person has one official name (but that can change over time).",
                                                                 "Company IDs are single-valued in most national registers. If two companies merge, the recessive company ID is usually deprecated.",
                                                                 "Websites are not single-valued since a company may have several websites",
                                                                 "Stock exchange tickers are not single-valued, since a company may have several tickers for different kinds of its stock.";
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Similar to owl:FunctionalProperty, and Wikidata Single Value constraint".
ebg:isStartup ebg:order 5 ;
              <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
              <http://schema.org/rangeIncludes> xsd:boolean;
              a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:isDefinedBy ebg:;
              rdfs:label "is startup";
              <http://www.w3.org/2004/02/skos/core#definition> "Whether the company is a startup [ebg:]";
              <http://www.w3.org/2004/02/skos/core#example> "A special section of the IT Business Register http://startup.registroimprese.it/ includes pitch, sectors and business model of startups and innovative SMEs".
ebg:isStateOwned ebg:order 6 ;
                 <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                 <http://schema.org/rangeIncludes> xsd:boolean;
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:isDefinedBy ebg:;
                 rdfs:label "is state owned";
                 <http://www.w3.org/2004/02/skos/core#definition> "Whether this organisation is owned by the government, a government agency, community, city or other public entity.";
                 <http://www.w3.org/2004/02/skos/core#example> "True for the Autonomous Province of Trento (local government).",
                                                               "True for the Norwegian company Statkraft (Norwegian state-owned company).",
                                                               "False for SpazioDati (a private company).";
                 <http://www.w3.org/2004/02/skos/core#scopeNote> "In many cases it's not possible to compute this attribute without access to the shareholder register, so it may be missing.".
ebg:isUnique ebg:order 52 ;
             <http://schema.org/domainIncludes> ebg:IdentifierSystem;
             <http://schema.org/rangeIncludes> xsd:boolean;
             a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:isDefinedBy ebg:;
             rdfs:label "has unique identifiers";
             <http://www.w3.org/2004/02/skos/core#definition> "Whether each identifier in the system relates to only one entity";
             <http://www.w3.org/2004/02/skos/core#example> "Person names are not unique since they are highly ambiguous",
                                                           "Stock exchange tickers are unique to each exchange (but a company can buy the ticker of another, i.e. the identity may change over time)",
                                                           "Company IDs are unique in most national registers: one ID cannot identify two companies",
                                                           "Websites are not unique since a website can be shared by several related companies";
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Similar to: owl:InverseFunctionalProperty, and Wikidata Distinct Values constraint".
ebg:level ebg:order 109 ;
          <http://schema.org/domainIncludes> <http://www.w3.org/2004/02/skos/core#Concept>;
          <http://schema.org/rangeIncludes> xsd:integer;
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Hierarchical level of a thesaurus concept";
          rdfs:isDefinedBy ebg:;
          rdfs:label "concept level".
ebg:numberOfEmployees <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                      <http://schema.org/rangeIncludes> xsd:integer;
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:isDefinedBy ebg:;
                      rdfs:label "number of employees";
                      <http://www.w3.org/2004/02/skos/core#definition> "The number of employees in the company.".
ebg:order ebg:order 110 ;
          <http://schema.org/domainIncludes> <http://www.w3.org/2004/02/skos/core#Concept>;
          <http://schema.org/rangeIncludes> xsd:integer;
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Global order of a thesaurus concept respecting the hierarchical structure (depth-first traversal)";
          rdfs:isDefinedBy ebg:;
          rdfs:label "order".
ebg:orgActivityText ebg:order 11 ;
                    <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                    <http://schema.org/rangeIncludes> rdf:langString;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:isDefinedBy ebg:;
                    rdfs:label "economic activity text";
                    <http://www.w3.org/2004/02/skos/core#definition> "Economic activity of the organization (free text)";
                    <http://www.w3.org/2004/02/skos/core#example> "NACE = 72.19 Scientific research and development in the field of natural, medical, agricultural and technical sciences, without biotechnology",
                                                                  "Free text = Development, exploration and production of opto-electronic systems for analogue and digital holographic recording, interferometric measurement of mechanical characteristics and biological objects at micro and macro level, refractometers, light-sensitive materials for holographic recording, blueprints of museum exhibits, artworks and collection surveys, production of holographic illustrations for students, albums, advertising, souvenirs and others, design and manufacture of holographic optical elements with a wide spectrum of applications, marketing and sale of holographic products, consulting, training and promotion of holographic methods and technologies, mediation, brokerage, and **any other activity not prohibited** by Bulgarian legislation.";
                    <http://www.w3.org/2004/02/skos/core#scopeNote> "Such field is widely used in some countries (e.g. BG) and may include much richer info than rov:orgActivity".
ebg:orgActivityTransitive ebg:order 12 .
ebg:orgStatusText ebg:order 9 ;
                  <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                  <http://schema.org/rangeIncludes> rdf:langString;
                  a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:isDefinedBy ebg:;
                  rdfs:label "status text";
                  <http://www.w3.org/2004/02/skos/core#definition> "Company status as it comes from the original register (free text).";
                  <http://www.w3.org/2004/02/skos/core#example> "Πτώχευση"@el,
                                                                "Dissolved"@en,
                                                                "Revoked"@en,
                                                                "Situation Normale"@fr,
                                                                "En Liquidacion"@es,
                                                                "Inactive"@en;
                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Include valid language tag (see [iana:] for list).",
                                                                  "If both Status and Status Text are present, they must express compatible values (Status Text may be a finer-granularity value).".
ebg:orgTypeText ebg:order 4 ;
                <http://schema.org/domainIncludes> <http://www.w3.org/ns/regorg#RegisteredOrganization>;
                <http://schema.org/rangeIncludes> rdf:langString;
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "type text";
                <http://www.w3.org/2004/02/skos/core#definition> "Company Type (Entity Legal Form) as reported by a national company registe (free text).";
                <http://www.w3.org/2004/02/skos/core#example> "Private Limited Company"@en,
                                                              "Società a responsabilità limitata"@it;
                <http://www.w3.org/2004/02/skos/core#scopeNote> "Include valid language tag (see [iana:] for list).",
                                                                "Because of the difficulties of standardizing Type lookup, we include a free text field",
                                                                "If Type is also present, it must express the same value as Type Text.".
ebg:probabilityOfDefault ebg:order 114 .
ebg:ralCode ebg:order 50 ;
            <http://schema.org/domainIncludes> ebg:IdentifierSystem;
            <http://schema.org/rangeIncludes> xsd:string;
            a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:isDefinedBy ebg:;
            rdfs:label "identifier system RAL code";
            <http://www.w3.org/2004/02/skos/core#definition> "GLEI RAL code for the identifier system.";
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Used only for official registers.".
ebg:replacementPattern ebg:order 62 ;
                       <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                       <http://schema.org/rangeIncludes> xsd:string;
                       a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:isDefinedBy ebg:;
                       rdfs:label "replacement pattern";
                       <http://www.w3.org/2004/02/skos/core#definition> "Pattern to use together with the Validation Regex to normalise identifier values by removing optional decorations";
                       <http://www.w3.org/2004/02/skos/core#example> """\"$1$2$3\" can be used together with the validationRegex \"(\\d{2})-?(\\d{3})-?(\\d{4})\" to extract the pure digits from a DUNS number spelled with optional dashes (e.g. \"36-032-1459\" -> \"360321459\")""".
ebg:rolePositionText <http://schema.org/domainIncludes> <http://www.w3.org/ns/org#Membership>;
                     <http://schema.org/rangeIncludes> xsd:string;
                     a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:label "role text";
                     <http://www.w3.org/2004/02/skos/core#definition> "The (hierarchical) position of the person within a company (in free text), e.g., director.".
ebg:urlTemplate ebg:order 69 ;
                <http://schema.org/domainIncludes> ebg:IdentifierWebResource;
                <http://schema.org/rangeIncludes> xsd:string;
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "URL template";
                <http://www.w3.org/2004/02/skos/core#definition> """URL template of an identifier web resource.
If it has a placeholder {}, substitute the identifier value there.
If it has placeholders like $1, $2… substitute the groups extracted by ebg:validationRegex""";
                <http://www.w3.org/2004/02/skos/core#example> "For OCORP, 'https://opencorporates.com/companies/{}.rdf'  returns company data with MIME type 'application/rdf+xml'",
                                                              "For OCORP, 'https://opencorporates.com/companies/{}.json' returns company data with MIME type 'application/json'",
                                                              "'For the EU Value Added Tax (VIES) register, 'http://ec.europa.eu/taxation_customs/vies/vatResponse.html?memberStateCode=$1&number=$2' with MIME type 'text/html' shows a web page for an identifier that can be parsed with ebg:validationRegex '([A-Z]{2})/(\\d+)'. Here $1 is the member state code, and $2 is the national company id'",
                                                              "'For BR, 'http://data.brreg.no/enhetsregisteret/enhet/{}' with either 'application/xml' or 'application/json' returns the respective MIME type using Content Negotiation'",
                                                              "For OCORP, 'https://opencorporates.com/companies/{}.xml'  returns company data with MIME type 'application/xml'",
                                                              "'For BE Banque-Carrefour des Entreprises, 'https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html?ondernemingsnummer={}' with MIME type 'text/html' shows a web page for the company.'",
                                                              "For OCORP, 'https://opencorporates.com/companies/{}'      returns company data with MIME type 'text/html'".
ebg:validationRegex ebg:order 61 ;
                    <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                    <http://schema.org/rangeIncludes> xsd:string;
                    a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:isDefinedBy ebg:;
                    rdfs:label "validation regex";
                    <http://www.w3.org/2004/02/skos/core#definition> "Regular expression for validating identifier values within the system";
                    <http://www.w3.org/2004/02/skos/core#example> """\"\\d{9}\" is a simple regex for validating DUNS numbers""",
                                                                  """\"([A-Z]{2})/(\\d+)\" is a regex for the EU Value Added Tax (VIES) register, which consists of a member state code followed by slash and a national numeric identifier""",
                                                                  """\"(\\d{2})-?(\\d{3})-?(\\d{4})\" is a regex for validating DUNS numbers that may include optional dashes in the indicated positions (e.g. \"36-032-1459\")""".
ebg:validationRule ebg:order 60 ;
                   <http://schema.org/domainIncludes> ebg:IdentifierSystem;
                   <http://schema.org/rangeIncludes> rdf:Resource;
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:isDefinedBy ebg:;
                   rdfs:label "validation rule";
                   <http://www.w3.org/2004/02/skos/core#definition> "URL providing human or machine-readable rule(s) for validating identifiers in the system";
                   <http://www.w3.org/2004/02/skos/core#example> "http://bsv-bg.com/ describes the BG EIK checksum algorithm in HTML",
                                                                 "http://www.nsi.bg/sites/default/files/konkursi/RGP_OPAK_2014_Annex_6.pdf describes the BG EIK checksum algorithm in PDF. It is by an official source, but is less convenient";
                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Can be in the form of webpage, PDF document, RDF shape, etc. Multiple values about the same validation rule are ok.".
ebg:webResource ebg:order 64 ;
                <http://schema.org/domainIncludes> <http://rdfs.org/ns/void#Dataset>,
                                                   ebg:IdentifierSystem;
                <http://schema.org/rangeIncludes> ebg:WebResource;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:isDefinedBy ebg:;
                rdfs:label "web resource";
                <http://www.w3.org/2004/02/skos/core#definition> "Web resource associated with an identifier system.";
                <http://www.w3.org/2004/02/skos/core#example> "http://opendata.government.bg/dataset/tbprobckn-pernctbp is the open data download site for BG TR.",
                                                              "https://brra.bg is the homepage of BG TR.",
                                                              "https://kbopub.economie.fgov.be/kbopub/zoeknummerform.html is the search URL for BE Banque-Carrefour des Entreprises.".
<http://data.businessgraph.io/resolution/> <http://purl.org/dc/terms/creator> <http://businessgraph.io/>;
                                           <http://purl.org/dc/terms/publisher> <http://businessgraph.io/>;
                                           a <http://www.w3.org/2004/02/skos/core#ConceptScheme>;
                                           rdfs:comment "Resolution of a geographic coordinate location: from continent (least precise) to individual house number (most precise)";
                                           rdfs:isDefinedBy ebg:;
                                           rdfs:label "Geo Coordinate Resolution".
<http://data.businessgraph.io/status/> <http://purl.org/dc/terms/creator> <http://businessgraph.io/>;
                                       <http://purl.org/dc/terms/publisher> <http://businessgraph.io/>;
                                       a <http://www.w3.org/2004/02/skos/core#ConceptScheme>;
                                       rdfs:comment "Company status, e.g. active, inactive. Unfortunately different providers use different definitions";
                                       rdfs:isDefinedBy ebg:;
                                       rdfs:label "Company status".
<http://data.businessgraph.io/type/> <http://purl.org/dc/terms/creator> <http://businessgraph.io/>;
                                     <http://purl.org/dc/terms/publisher> <http://businessgraph.io/>;
                                     a <http://www.w3.org/2004/02/skos/core#ConceptScheme>;
                                     rdfs:comment "Company type (legal form) per jurisdiction";
                                     rdfs:isDefinedBy ebg:;
