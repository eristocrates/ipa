                 <http://www.w3.org/2002/07/owl#minInclusive> 160 ;
                 <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:HighSugarDiet a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "High Sugar Diet";
                  rdfs:subClassOf dpo:SedentaryLifestyle.
dpo:HighTriglycerideLevel a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "";
                          rdfs:label "High Triglyceride Level";
                          rdfs:subClassOf dpo:TriglycerideMeasurement;
                          <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/12228-3>
                                                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                          <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:HighTriglycerideRange ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]);
                          <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:HighTriglycerideRange a <http://www.w3.org/2002/07/owl#DataRange>;
                          rdfs:label "High Triglyceride Range";
                          <http://www.w3.org/2002/07/owl#maxInclusive> 499 ;
                          <http://www.w3.org/2002/07/owl#minInclusive> 200 ;
                          <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:History a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "";
            rdfs:label "History";
            rdfs:subClassOf dpo:PatientCharacteristic;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C54625>;
            <http://www.w3.org/2004/02/skos/core#definition> "The aggregate of past events; the continuum of events occurring in succession leading from the past to the present; a record or narrative description of past events. [Definition Source: NCI]".
dpo:Hyperlipidemia a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "";
                   rdfs:label "Hyperlipidemia";
                   rdfs:subClassOf dpo:Condition;
                   <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C34707>;
                   <http://www.w3.org/2004/02/skos/core#definition> "Elevated levels of lipids in the blood. [Definition Source: NCI]".
dpo:Hypertension a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "";
                 rdfs:label "Hypertension";
                 rdfs:subClassOf dpo:Condition;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C3117>;
                 <http://www.w3.org/2004/02/skos/core#definition> "Blood pressure that is abnormally high. [Definition Source: NCI]".
dpo:HypoglycemiaRisk rdfs:comment "The possiblility of lowering blood sugar below the normal range.";
                     rdfs:label "Hypoglycemia Risk";
                     rdfs:subClassOf dpo:PharmacotherapyFactor;
                     <http://www.w3.org/2004/02/skos/core#definition> "The most important risk factor for the occurrence of hypoglycemia is the aggressiveness of therapy applied to achieve glycemic control. [Definition Source: url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3784865/ ]".
dpo:IncreasedASCVDRisk rdfs:comment "Potential to increase the risk of cardiovascular disease resulting from atherosclerosis.";
                       rdfs:label "Increased ASCVD Risk";
                       rdfs:subClassOf dpo:AtheroscleroticCardiovascularDiseaseRisk;
                       <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:IncreasedDKDRisk rdfs:comment "Potential to increase the risk or progression of diabetic kidney disease.";
                     rdfs:label "Increased Diabetic Kidney Disease Risk";
                     rdfs:subClassOf dpo:DiabeticKidneyDiseaseProgression;
                     <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:IncreasedHeartFailureRisk rdfs:comment "Potential to increase the risk of heart failure.";
                              rdfs:label "Increased Heart Failure Risk";
                              rdfs:subClassOf dpo:HeartFailureRisk;
                              <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:InsufficientExercise a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "Insufficient Exercise";
                         rdfs:subClassOf dpo:SedentaryLifestyle.
dpo:IntermediateEfficacy rdfs:comment "An intermediate capacity to bring about a desired effect.";
                         rdfs:label "Intermediate Efficacy";
                         rdfs:subClassOf dpo:Efficacy;
                         <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:KnownHypoglycemiaRisk rdfs:comment "A known association with the lowering of blood sugar below the normal range.";
                          rdfs:label "Known Hypoglycemia Risk";
                          rdfs:subClassOf dpo:HypoglycemiaRisk;
                          <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:Linagliptin rdfs:comment "";
                rdfs:label "Linagliptin";
                rdfs:subClassOf dpo:DPP4Inhibitor;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_68610>,
                                                                <http://purl.obolibrary.org/obo/NCIT_C83887>;
                <http://www.w3.org/2004/02/skos/core#definition> "A potent, orally bioavailable dihydropurinedione-based inhibitor of dipeptidyl peptidase 4 (DPP-4), with hypoglycemic activity. The inhibition of DPP-4 by linagliptin appears to be longer lasting than that by some other DPP-4 inhibitors tested. [Definition Source: NCI]",
                                                                 "A xanthine that is 7H-xanthine bearing (4-methylquinazolin-2-yl)methyl, methyl, but-2-yn-1-yl and 3-aminopiperidin-1-yl substituents at positions 1, 3, 7 and 8 respectively (the R-enantiomer). Used for treatment of type II diabetes. [Definition Source: CHEBI]".
dpo:Liraglutide rdfs:comment "";
                rdfs:label "Liraglutide";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialASCVDBenefit] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialDKDBenefit] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                dpo:GLP1RA;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_71193>,
                                                                <http://purl.obolibrary.org/obo/NCIT_C82239>;
                <http://www.w3.org/2004/02/skos/core#definition> "A long-acting, fatty acylated glucagon-like peptide-1 (GLP-1) analog administered subcutaneously, with antihyperglycemic activity. Liraglutide's prolonged action and half-life of 11-15 hours are attributed to the attachment of the fatty acid palmitic acid to GLP-1 that reversibly binds to albumin. Albumin binding protects liraglutide from immediate degradation and elimination and causes GLP-1 to be released from abumin in a slow and consistent manner. This agent may cause thyroid C-cell tumors and increases the risk of acute pancreatitis. [Definition Source: NCI]".
dpo:Lixisenatide rdfs:comment "";
                 rdfs:label "Lixisenatide";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralASCVDRisk] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 dpo:GLP1RA;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_85662>,
                                                                 <http://purl.obolibrary.org/obo/NCIT_C166988>;
                 <http://www.w3.org/2004/02/skos/core#definition> "A forty-four membered polypeptide consisting of L-His, Gly, L-Glu, Gly, L-Thr, L-Phe, L-Thr, L-Ser, L-Asp, L-Leu, L-Ser, L-Lys, L-Gln, L-Met, L-Glu, L-Glu, L-Glu, L-Ala, L-Val, L-Arg, L-Leu, L-Phe, L-Ile, L-Glu, L-Trp, L-Leu, L-Lys, L-Asn, Gly, Gly, LPro, L-Ser, L-Ser, Gly, L-Ala, L-Pro, L-Pro, L-Ser, L-Lys, L-Lys, L-Lys, L-Lys, L-Lys, and L-Lys-NH2 residues joined in sequence. Used as an adjunct to diet and exercise for the treatment of adults with type II diabetes. [Definition Source: CHEBI]".
dpo:LowCost rdfs:comment "Relatively inexpensive.";
            rdfs:label "Low Cost";
            rdfs:subClassOf dpo:Cost;
            <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:LowEfficacy rdfs:comment "A low capacity to bring about a desired effect.";
                rdfs:label "Low Efficacy";
                rdfs:subClassOf dpo:Efficacy;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C48226>;
                <http://www.w3.org/2004/02/skos/core#definition> "The lack of expected or desired effect related to a therapy. [Definition Source: NCI]".
dpo:Metformin rdfs:comment "";
              rdfs:label "Metformin";
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:HighEfficacy] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              dpo:Biguanide,
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralWeightChange] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NoKnownHypoglycemiaRisk] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialASCVDBenefit] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralDKDRisk] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralHeartFailureRisk] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                               <http://www.w3.org/2002/07/owl#hasValue> [a dpo:LowCost] ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C61612>,
                                                              <http://purl.bioontology.org/ontology/LNC/55548-2>,
                                                              <http://purl.obolibrary.org/obo/CHEBI_6801>;
              <http://www.w3.org/2004/02/skos/core#definition> "An agent belonging to the biguanide class of antidiabetics with antihyperglycemic activity. Metformin is associated with a very low incidence of lactic acidosis. This agent helps reduce LDL cholesterol and triglyceride levels, and is not associated with weight gain, and prevents the cardiovascular complications of diabetes. Metformin is not metabolized and is excreted unchanged by the kidneys. [Definition Source: NCI]".
dpo:MusculoskeletalSystemSymptom a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A symptom involving the musculoskeletal system.";
                                 rdfs:label "Musculoskeletal System Symptom";
                                 rdfs:subClassOf dpo:Symptom;
                                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000891>;
                                 <http://www.w3.org/2004/02/skos/core#definition> "Musculoskeletal symptoms are defined as pain in the muscles, tendons, and nerves arising from repetitive, continuous, and unnatural movements. These symptoms can be expressed in various areas of the body and affect the quality of life by causing difficulties in performing occupational tasks and activities of daily living (ADL). [Definition Source: url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3567324/ ]".
dpo:NearOptimalLDLLevel a <http://www.w3.org/2002/07/owl#Class>;
