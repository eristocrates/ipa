                         skos:definition "".
dpo:KnownHypoglycemiaRisk rdfs:comment "A known association with the lowering of blood sugar below the normal range.";
                          rdfs:label "Known Hypoglycemia Risk";
                          rdfs:subClassOf dpo:HypoglycemiaRisk;
                          skos:definition "".
dpo:Linagliptin rdfs:comment "";
                rdfs:label "Linagliptin";
                rdfs:subClassOf dpo:DPP4Inhibitor;
                owl:equivalentClass chebi:68610,
                                    ncit:C83887;
                skos:definition "A potent, orally bioavailable dihydropurinedione-based inhibitor of dipeptidyl peptidase 4 (DPP-4), with hypoglycemic activity. The inhibition of DPP-4 by linagliptin appears to be longer lasting than that by some other DPP-4 inhibitors tested. [Definition Source: NCI]",
                                "A xanthine that is 7H-xanthine bearing (4-methylquinazolin-2-yl)methyl, methyl, but-2-yn-1-yl and 3-aminopiperidin-1-yl substituents at positions 1, 3, 7 and 8 respectively (the R-enantiomer). Used for treatment of type II diabetes. [Definition Source: CHEBI]".
dpo:Liraglutide rdfs:comment "";
                rdfs:label "Liraglutide";
                rdfs:subClassOf [owl:onProperty sio:hasAttribute ; 
                                 owl:hasValue [a dpo:PotentialASCVDBenefit] ; 
                                 a owl:Restriction],
                                [owl:onProperty sio:hasAttribute ; 
                                 owl:hasValue [a dpo:PotentialDKDBenefit] ; 
                                 a owl:Restriction],
                                dpo:GLP1RA;
                owl:equivalentClass chebi:71193,
                                    ncit:C82239;
                skos:definition "A long-acting, fatty acylated glucagon-like peptide-1 (GLP-1) analog administered subcutaneously, with antihyperglycemic activity. Liraglutide's prolonged action and half-life of 11-15 hours are attributed to the attachment of the fatty acid palmitic acid to GLP-1 that reversibly binds to albumin. Albumin binding protects liraglutide from immediate degradation and elimination and causes GLP-1 to be released from abumin in a slow and consistent manner. This agent may cause thyroid C-cell tumors and increases the risk of acute pancreatitis. [Definition Source: NCI]".
dpo:Lixisenatide rdfs:comment "";
                 rdfs:label "Lixisenatide";
                 rdfs:subClassOf [owl:onProperty sio:hasAttribute ; 
                                  owl:hasValue [a dpo:NeutralASCVDRisk] ; 
                                  a owl:Restriction],
                                 dpo:GLP1RA;
                 owl:equivalentClass chebi:85662,
                                     ncit:C166988;
                 skos:definition "A forty-four membered polypeptide consisting of L-His, Gly, L-Glu, Gly, L-Thr, L-Phe, L-Thr, L-Ser, L-Asp, L-Leu, L-Ser, L-Lys, L-Gln, L-Met, L-Glu, L-Glu, L-Glu, L-Ala, L-Val, L-Arg, L-Leu, L-Phe, L-Ile, L-Glu, L-Trp, L-Leu, L-Lys, L-Asn, Gly, Gly, LPro, L-Ser, L-Ser, Gly, L-Ala, L-Pro, L-Pro, L-Ser, L-Lys, L-Lys, L-Lys, L-Lys, L-Lys, and L-Lys-NH2 residues joined in sequence. Used as an adjunct to diet and exercise for the treatment of adults with type II diabetes. [Definition Source: CHEBI]".
dpo:LowCost rdfs:comment "Relatively inexpensive.";
            rdfs:label "Low Cost";
            rdfs:subClassOf dpo:Cost;
            skos:definition "".
dpo:LowEfficacy rdfs:comment "A low capacity to bring about a desired effect.";
                rdfs:label "Low Efficacy";
                rdfs:subClassOf dpo:Efficacy;
                owl:equivalentClass ncit:C48226;
                skos:definition "The lack of expected or desired effect related to a therapy. [Definition Source: NCI]".
dpo:Metformin rdfs:comment "";
              rdfs:label "Metformin";
              rdfs:subClassOf [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:HighEfficacy] ; 
                               a owl:Restriction],
                              dpo:Biguanide,
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:NeutralWeightChange] ; 
                               a owl:Restriction],
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:NoKnownHypoglycemiaRisk] ; 
                               a owl:Restriction],
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:PotentialASCVDBenefit] ; 
                               a owl:Restriction],
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:NeutralDKDRisk] ; 
                               a owl:Restriction],
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:NeutralHeartFailureRisk] ; 
                               a owl:Restriction],
                              [owl:onProperty sio:hasAttribute ; 
                               owl:hasValue [a dpo:LowCost] ; 
                               a owl:Restriction];
              owl:equivalentClass ncit:C61612,
                                  <http://purl.bioontology.org/ontology/LNC/55548-2>,
                                  chebi:6801;
              skos:definition "An agent belonging to the biguanide class of antidiabetics with antihyperglycemic activity. Metformin is associated with a very low incidence of lactic acidosis. This agent helps reduce LDL cholesterol and triglyceride levels, and is not associated with weight gain, and prevents the cardiovascular complications of diabetes. Metformin is not metabolized and is excreted unchanged by the kidneys. [Definition Source: NCI]".
dpo:MusculoskeletalSystemSymptom a owl:Class;
                                 rdfs:comment "A symptom involving the musculoskeletal system.";
                                 rdfs:label "Musculoskeletal System Symptom";
                                 rdfs:subClassOf dpo:Symptom;
                                 owl:equivalentClass symp:0000891;
                                 skos:definition "Musculoskeletal symptoms are defined as pain in the muscles, tendons, and nerves arising from repetitive, continuous, and unnatural movements. These symptoms can be expressed in various areas of the body and affect the quality of life by causing difficulties in performing occupational tasks and activities of daily living (ADL). [Definition Source: url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3567324/ ]".
dpo:NearOptimalLDLLevel a owl:Class;
                        rdfs:comment "";
                        rdfs:label "Near Optimal LDL Level";
                        rdfs:subClassOf dpo:CholesterolMeasurement;
                        owl:intersectionOf (<http://purl.bioontology.org/ontology/LNC/2089-1>
                                            [owl:onProperty sio:hasValue ; 
                                            owl:allValuesFrom dpo:NearOptimalLDLRange ; 
                                            a owl:Restriction]);
                        skos:definition "".
dpo:NearOptimalLDLRange a owl:DataRange;
                        rdfs:label "Near Optimal LDL Range";
                        owl:maxInclusive 129 ;
                        owl:minInclusive 100 ;
                        owl:onDataRange xsd:decimal.
dpo:NervousSystemSymptom a owl:Class;
                         rdfs:comment "";
                         rdfs:label "Nervous System Symptom";
                         rdfs:subClassOf dpo:Symptom;
                         owl:equivalentClass symp:0000480;
