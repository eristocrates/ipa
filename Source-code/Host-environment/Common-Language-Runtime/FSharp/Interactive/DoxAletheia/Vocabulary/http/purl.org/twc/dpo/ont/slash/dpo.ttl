                                        rdfs:subClassOf dpo:Symptom;
                                        owl:equivalentClass symp:0000410;
                                        skos:definition "".
dpo:NeutralASCVDRisk rdfs:comment "Minimal effect on reducing or increasing the risk of cardiovascular disease resulting from atherosclerosis.";
