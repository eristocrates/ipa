                   <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NeutralHeartFailureRisk rdfs:comment "Minimal effect on reducing or increasing the risk of heart failure.";
                            rdfs:label "Neutral Heart Failure Risk";
                            rdfs:subClassOf dpo:HeartFailureRisk;
                            <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NeutralWeightChange rdfs:comment "The lack of an effect on the capacity for an increase or decrease in the weight of an individual.";
                        rdfs:label "Neutral Weight Change";
                        rdfs:subClassOf dpo:WeightChangePotential;
                        <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NoKnownHypoglycemiaRisk rdfs:comment "No known association with the lowering of blood sugar below the normal range.";
                            rdfs:label "No Known Hypoglycemia Risk";
                            rdfs:subClassOf dpo:HypoglycemiaRisk;
                            <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NormalTriglycerideLevel a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "";
                            rdfs:label "Normal Triglyceride Level";
                            rdfs:subClassOf dpo:TriglycerideMeasurement;
                            <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/12228-3>
                                                                            [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                            <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:NormalTriglycerideRange ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]);
                            <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NormalTriglycerideRange a <http://www.w3.org/2002/07/owl#DataRange>;
                            rdfs:label "Normal Triglyceride Range";
                            <http://www.w3.org/2002/07/owl#maxInclusive> 149 ;
                            <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:NormalWeight a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "18.5<BMI<24.9";
                 rdfs:label "Normal Weight";
                 rdfs:subClassOf dpo:BodyMassIndexFinding;
                 <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.obolibrary.org/obo/NCIT_C138901>
                                                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:NormalWeightBMIRange ; 
                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]);
                 <http://www.w3.org/2004/02/skos/core#definition> "BMI greater than or equal to 18.5 to 24.9 kg/m^2 [Definition Source: url:https://www.ncbi.nlm.nih.gov/books/NBK541070/ ]".
dpo:NormalWeightBMIRange a <http://www.w3.org/2002/07/owl#DataRange>;
                         rdfs:label "Normal Weight BMI Range";
                         <http://www.w3.org/2002/07/owl#maxInclusive> 24.9;
                         <http://www.w3.org/2002/07/owl#minInclusive> 18.5;
                         <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:NutritionMetabolismAndDevelopmentSymptom a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:comment "A symptom involving the nutrition, metabolism, and/or development system.";
                                             rdfs:label "Nutrition Metabolism and Development Symptom";
                                             rdfs:subClassOf dpo:Symptom;
                                             <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000473>;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Symptoms concerning nutrition metabolism and development [include:] A disorder characterized by a loss of appetite; An abnormal loss of the appetite for food. Anorexia can be caused by cancer, aids, a mental disorder (i.e., anorexia nervosa), or other diseases; Clinical manifestation consisting of a physiopathological lack or loss of appetite accompanied by an aversion to food and the inability to eat; Loss of appetite; The lack or loss of appetite accompanied by an aversion to food and the inability to eat. It is the defining characteristic of the disorder anorexia nervosa. [Definition Source: url:http://www.icd9data.com/2013/Volume1/780-799/780-789/783/default.htm ]".
dpo:Obese a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "30<BMI";
          rdfs:label "Obese";
          rdfs:subClassOf dpo:BodyMassIndexFinding;
          <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C3283>,
                                                          <http://www.ebi.ac.uk/efo/EFO_0007041>;
          <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.obolibrary.org/obo/NCIT_C138901>
                                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                          <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:ObeseBMIRange ; 
                                                          a <http://www.w3.org/2002/07/owl#Restriction>]);
          <http://www.w3.org/2004/02/skos/core#definition> "Having a high amount of body fat (body mass index [BMI] of 30 or more). [Definition Source: NCI]",
                                                           "The quantification of weight/height relationships above a certain threshold that classes an individual as overweight. This threshold may vary based on an individual's ethnicity but is commonly considered to correspond in European populations to a BMI > 30. [Definition Source: EFO:0007041]".
dpo:ObeseBMIRange a <http://www.w3.org/2002/07/owl#DataRange>;
                  rdfs:label "Obese BMI Range";
                  <http://www.w3.org/2002/07/owl#minInclusive> 30 ;
                  <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:Occupation a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "";
               rdfs:label "Occupation";
               rdfs:subClassOf dpo:PatientCharacteristic;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C25193>;
               <http://www.w3.org/2004/02/skos/core#definition> "The principal activity that a person does to earn money. [Definition Source: NCI]".
dpo:OptimalLDLLevel a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "";
                    rdfs:label "Optimal LDL Level";
                    rdfs:subClassOf dpo:CholesterolMeasurement;
                    <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/2089-1>
                                                                    [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                    <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:OptimalLDLRange ; 
                                                                    a <http://www.w3.org/2002/07/owl#Restriction>]);
                    <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:OptimalLDLRange a <http://www.w3.org/2002/07/owl#DataRange>;
                    rdfs:label "Optimal LDL Range";
                    <http://www.w3.org/2002/07/owl#maxInclusive> 100 ;
                    <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:Overweight a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "25<BMI<30";
               rdfs:label "Overweight";
               rdfs:subClassOf dpo:BodyMassIndexFinding;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.ebi.ac.uk/efo/EFO_0005935>;
               <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.obolibrary.org/obo/NCIT_C138901>
                                                               [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                               <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:OverweightBMIRange ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>]);
               <http://www.w3.org/2004/02/skos/core#definition> "The quantification of weight/height relationships above a certain threshold that classes an individual as overweight. This threshold may vary based on an individual's ethnicity but is commonly considered to correspond in European populations to a 25<BMI<30. [Definition Source: EFO:0005935]".
dpo:OverweightBMIRange a <http://www.w3.org/2002/07/owl#DataRange>;
                       rdfs:label "Overweight BMI Range";
                       <http://www.w3.org/2002/07/owl#maxInclusive> 30 ;
                       <http://www.w3.org/2002/07/owl#minInclusive> 25 ;
                       <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:Pain a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:comment "";
         rdfs:label "Pain";
         rdfs:subClassOf dpo:NervousSystemSymptom;
         <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000099>;
         <http://www.w3.org/2004/02/skos/core#definition> "A sensation perception where there is an unpleasant sensation that usually indicates the body is threatened or damaged. The sensation may be sharp or dull, short-lived or chronic, intermittent or continual, confined to one area or spread over the entire body. [ url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp ][Definition Source: SYMP:0000576]".
dpo:PatientCharacteristic a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "";
                          rdfs:label "Patient Characteristic";
                          rdfs:subClassOf dpo:DiagnosticFactor;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C25447>;
                          <http://www.w3.org/2004/02/skos/core#definition> "The distinguishing qualities or prominent aspect of a person. [Definition Source: NCI]".
dpo:PeripheralNeuropathy a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "";
                         rdfs:label "Peripheral Neuropathy";
                         rdfs:subClassOf dpo:MusculoskeletalSystemSymptom;
                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000352>;
                         <http://www.w3.org/2004/02/skos/core#definition> "Peripheral neuropathy refers to the many conditions that involve damage to the peripheral nervous system, the vast communication network that sends signals between the central nervous system (the brain and spinal cord) and all other parts of the body. [Definition Source: url:https://www.ninds.nih.gov/peripheral-neuropathy-fact-sheet ]".
dpo:PersonalHistory a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "";
                    rdfs:label "Personal History";
                    rdfs:subClassOf dpo:History;
                    <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C18772>;
                    <http://www.w3.org/2004/02/skos/core#definition> "A record of a patient's background regarding health and the occurrence of disease events of the individual. In addition, personal medical history may be a variable in epidemiologic studies. [Definition Source: NCI]".
dpo:PersonalHistoryOfFebrileStates a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "";
                                   rdfs:label "Personal History of Febrile States";
                                   rdfs:subClassOf dpo:PersonalHistory;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Febrile seizures are defined as events in infancy or childhood that usually occur between three months and five years of age and are associated with a fever, but without evidence of intracranial infection or a defined cause for the seizure. [Definition Source: url:https://www.aafp.org/pubs/afp/issues/2008/1115/p1199.html ]".
dpo:PersonalHistoryOfGestationalDiabetes a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "";
                                         rdfs:label "Personal History of Gestational Diabetes";
                                         rdfs:subClassOf dpo:PersonalHistory;
                                         <http://www.w3.org/2004/02/skos/core#definition> "Gestational diabetes mellitus (GDM), defined as glucose intolerance that is first recognized during pregnancy, is associated with maternal obesity and confers a 4‐ to 7‐fold greater risk of incident type 2 diabetes (DM), and increased risk of developing the metabolic syndrome (MetS) in midlife. In addition, a history of GDM among nondiabetic women is characterized by elevations in fasting glucose and insulin concentrations, as well as dyslipidemia and greater inflammation in the absence of the MetS. [Definition Source: url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4187501/ ]".
dpo:PharmacotherapyFactor a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A circumstance influencing the treatment of a disease through the use or recommendation of one or more drugs.";
                          rdfs:label "Pharmacotherapy Factor";
                          rdfs:subClassOf dpo:TherapyPlanningComponent;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C18228>;
                          <http://www.w3.org/2004/02/skos/core#definition> "Therapy-related factors identified include: route of administration, treatment complexity, duration of treatment period, medication side effects, degree of behavioral change required, taste of medication and requirement for drug storage. [Definition Source: url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2503662/ ]".
dpo:Pioglitazone rdfs:comment "";
                 rdfs:label "Pioglitazone";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialASCVDBenefit] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 dpo:Thiazolidinedione;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_8228>,
                                                                 <http://purl.obolibrary.org/obo/NCIT_C71633>;
                 <http://www.w3.org/2004/02/skos/core#definition> "An orally-active thiazolidinedione with antidiabetic properties and potential antineoplastic activity. Pioglitazone activates peroxisome proliferator-activated receptor gamma (PPAR-gamma), a ligand-activated transcription factor, thereby inducing cell differentiation and inhibiting cell growth and angiogenesis. This agent also modulates the transcription of insulin-responsive genes, inhibits macrophage and monocyte activation, and stimulates adipocyte differentiation. [Definition Source: NCI]",
                                                                  "A member of the class of thiazolidenediones that is 1,3-thiazolidine-2,4-dione substituted by a benzyl group at position 5 which in turn is substituted by a 2-(5-ethylpyridin-2-yl)ethoxy group at position 4 of the phenyl ring. It exhibits hypoglycemic activity. [Definition Source: CHEBI]".
dpo:Polydipsia a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "";
               rdfs:label "Polydipsia";
               rdfs:subClassOf dpo:NutritionMetabolismAndDevelopmentSymptom;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000560>;
               <http://www.w3.org/2004/02/skos/core#definition> "Polydipsia is a nutrition, metabolism, and development symptom characterized by an excessive or abnormal thirst. [ url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&va=polydipsia ][Definition Source: SYMP:0000560]".
dpo:Polyphagia a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "";
               rdfs:label "Polyphagia";
               rdfs:subClassOf dpo:NutritionMetabolismAndDevelopmentSymptom;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000524>;
               <http://www.w3.org/2004/02/skos/core#definition> "Polyphagia is a nutrition, metabolism, and development symptom characterized by an excessive appetite or eating. [ url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&va=polyphagia ][Definition Source: SYMP:0000524]".
dpo:Polyuria a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "";
             rdfs:label "Polyuria";
             rdfs:subClassOf dpo:UrinarySystemSymptom;
             <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000565>;
             <http://www.w3.org/2004/02/skos/core#definition> "A urinary system symptom that is characterized by the excessive secretion of urine. [ url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&va=polyuria ][Definition Source: SYMP:0000565]".
dpo:PotentialASCVDBenefit rdfs:comment "Potential to reduce the risk of cardiovascular disease resulting from atherosclerosis.";
                          rdfs:label "Potential ASCVD Benefit";
                          rdfs:subClassOf dpo:AtheroscleroticCardiovascularDiseaseRisk;
                          <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:PotentialDKDBenefit rdfs:comment "Potential to decrease the risk or progression of diabetic kidney disease.";
                        rdfs:label "Potential Diabetic Kidney Disease Benefit";
                        rdfs:subClassOf dpo:DiabeticKidneyDiseaseProgression;
                        <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:PotentialHeartFailureBenefit rdfs:comment "Potential to decrease the risk of heart failure.";
                                 rdfs:label "Potential Heart Failure Benefit";
                                 rdfs:subClassOf dpo:HeartFailureRisk;
                                 <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:PrediabetesFastingBloodGlucoseLevel a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment " impaired fasting glucose";
                                        rdfs:label "Prediabetes Fasting Blood Glucose Level";
                                        rdfs:subClassOf dpo:BloodGlucoseMeasurement;
                                        <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/1558-6>
                                                                                        [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                                        <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:PrediabetesFastingBloodGlucoseRange ; 
                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]);
                                        <http://www.w3.org/2004/02/skos/core#definition> "FPG 100 mg/dL (5.6 mmol/L) to 125 mg/dL (6.9 mmol/L). [Definition Source: url:https://doi.org/10.2337/dc22-S002 ]".
dpo:PrediabetesFastingBloodGlucoseRange a <http://www.w3.org/2002/07/owl#DataRange>;
                                        rdfs:label "Prediabetes Fasting Blood Glucose Range";
                                        <http://www.w3.org/2002/07/owl#maxInclusive> 125 ;
                                        <http://www.w3.org/2002/07/owl#minInclusive> 100 ;
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:PrediabetesHbA1CLevel a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "";
                          rdfs:label "Prediabetes HbA1C Level";
                          rdfs:subClassOf dpo:BloodGlucoseMeasurement;
                          <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/59261-8>
                                                                          [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                          <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:PrediabetesHbA1CRange ; 
                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]);
                          <http://www.w3.org/2004/02/skos/core#definition> "A1C 5.7–6.4% (39–47 mmol/mol). [Definition Source: url:https://doi.org/10.2337/dc22-S002 ]".
dpo:PrediabetesHbA1CRange a <http://www.w3.org/2002/07/owl#DataRange>;
                          rdfs:label "Prediabetes HbA1C Range";
                          <http://www.w3.org/2002/07/owl#maxInclusive> 138.62;
                          <http://www.w3.org/2002/07/owl#minInclusive> 117.58;
                          <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:PrediabetesTwoHourBloodGlucoseLevel a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "impaired glucose tolerance";
                                        rdfs:label "Prediabetes Two Hour Blood Glucose Level";
                                        rdfs:subClassOf dpo:BloodGlucoseMeasurement;
                                        <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/1518-0>
                                                                                        [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                                        <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:PrediabetesTwoHourBloodGlucoseRange ; 
                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]);
                                        <http://www.w3.org/2004/02/skos/core#definition> "2-h PG during 75-g OGTT 140 mg/dL (7.8 mmol/L) to 199 mg/dL (11.0 mmol/L). [Definition Source: url:https://doi.org/10.2337/dc22-S002 ]".
dpo:PrediabetesTwoHourBloodGlucoseRange a <http://www.w3.org/2002/07/owl#DataRange>;
                                        rdfs:label "Prediabetes Two Hour Blood Glucose Range";
                                        <http://www.w3.org/2002/07/owl#maxInclusive> 199 ;
                                        <http://www.w3.org/2002/07/owl#minInclusive> 140 ;
                                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:RenalDisease a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Disease associated with kidneys, typically chronic kidney disease.";
                 rdfs:label "Renal Disease";
                 rdfs:subClassOf dpo:Disease;
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C3149>;
                 <http://www.w3.org/2004/02/skos/core#definition> "A neoplastic or non-neoplastic condition affecting the kidney. Representative examples of non-neoplastic conditions include glomerulonephritis and nephrotic syndrome. Representative examples of neoplastic conditions include benign processes (e.g., renal lipoma and renal fibroma) and malignant processes (e.g., renal cell carcinoma and renal lymphoma). [Definition Source: NCI]".
dpo:RenalDosingConsideration rdfs:comment "Drug dosage considerations related to the effect on the kidneys.";
                             rdfs:label "Renal Dosing Consideration";
                             rdfs:subClassOf dpo:RenalEffect;
                             <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:RenalEffect rdfs:comment "A pharmacotherapy factor related to the kidneys.";
                rdfs:label "Renal Effect";
                rdfs:subClassOf dpo:PharmacotherapyFactor;
                <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:Rosiglitazone rdfs:comment "";
                  rdfs:label "Rosiglitazone";
                  rdfs:subClassOf dpo:Thiazolidinedione;
                  <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_50122>,
                                                                  <http://purl.obolibrary.org/obo/NCIT_C62076>;
                  <http://www.w3.org/2004/02/skos/core#definition> "An agent belonging to the glitazone class of antidiabetic agents with antihyperglycemic and anti-inflammatory activities. In addition to its selective affinity for peroxisome proliferator-activated receptor (PPAR) gamma and its ability to lower blood glucose levels, rosiglitazone also exerts anti-inflammatory activity through its ability to inhibit nuclear factor-kappaB (NF-KB) activity and increase I-kappaB levels. In addition, rosiglitazone may cause fluid retention and may worsen congestive heart failure. This agent is also associated with an increased risk of heart attacks. [Definition Source: NCI]".
dpo:SGLT2Inhibitor rdfs:comment "";
                   rdfs:label "SGLT2 Inhibitor";
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NoKnownHypoglycemiaRisk] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   dpo:AntihyperglycemicTreatment,
                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> [a dpo:IntermediateEfficacy] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> [a dpo:HighCost] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                    <http://www.w3.org/2002/07/owl#hasValue> [a dpo:WeightLossPotential] ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C98083>,
                                                                   <http://purl.obolibrary.org/obo/CHEBI_73273>;
                   <http://www.w3.org/2004/02/skos/core#definition> "Any inhibitor of the sodium-glucose co-transporter subtype 2 (SGLT2) with antihyperglycemic activity. By binding to and blocking SGLT2, these inhibitors suppress reabsorption of glucose in the proximal tubule within the kidneys and thereby enhancing urinary excretion of glucose. This eventually normalizes blood glucose levels. SGLT2, a transport system exclusively expressed in the proximal renal tubules, mediates about 90% of renal glucose reabsorption from tubular fluid. [Definition Source: NCI]".
dpo:Saxagliptin rdfs:comment "";
                rdfs:label "Saxagliptin";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> [a dpo:IncreasedHeartFailureRisk] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                dpo:DPP4Inhibitor;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_71272>,
                                                                <http://purl.obolibrary.org/obo/NCIT_C75983>;
                <http://www.w3.org/2004/02/skos/core#definition> "A potent, selective and competitive, cyanopyrrolidine-based, orally bioavailable inhibitor of dipeptidyl peptidase 4 (DPP-4), with hypoglycemic activity. Saxagliptin is metabolized into an, although less potent, active mono-hydroxy metabolite. [Definition Source: NCI]",
                                                                 "A monocarboxylic acid amide obtained by formal condensation of the carboxy group of (2S)-amino(3-hydroxyadamantan-1-yl)acetic acid with the amino group of (1S,3S,5S)-2-azabicyclo[3.1.0]hexane-3-carbonitrile. Used in its monohydrate form for the treatment of Type II diabetes. [Definition Source: CHEBI]".
dpo:SedentaryLifestyle a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "";
                       rdfs:label "Sedentary Lifestyle";
                       rdfs:subClassOf dpo:Behavior;
                       <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C86589>;
                       <http://www.w3.org/2004/02/skos/core#definition> "A type of lifestyle that lacks physical exercise, characterized by sitting, reading, watching television or using a computer for much of the day without vigorous physical exertion. [Definition Source: NCI]".
dpo:SedentaryOccupation a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "";
                        rdfs:label "Sedentary Occupation";
                        rdfs:subClassOf dpo:Occupation;
                        <http://www.w3.org/2004/02/skos/core#definition> "A physical demand level described as the exertion of up to 10 pounds of force occasionally, negligible amount of work frequently, and a negligible amount of force constantly to move objects. [Definition Source: url:https://medical-dictionary.thefreedictionary.com/sedentary+work ]".
dpo:Semaglutide rdfs:comment "";
                rdfs:label "Semaglutide";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialASCVDBenefit] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                 <http://www.w3.org/2002/07/owl#hasValue> [a dpo:PotentialDKDBenefit] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                dpo:GLP1RA;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_167574>,
                                                                <http://purl.obolibrary.org/obo/NCIT_C152328>;
                <http://www.w3.org/2004/02/skos/core#definition> "A polypeptide that contains a linear sequence of 31 amino acids joined together by peptide linkages. It is an agonist of glucagon-like peptide-1 receptors (GLP-1 AR) and used for the treatment of type 2 diabetes. [Definition Source: CHEBI]".
dpo:Sitagliptin rdfs:comment "";
                rdfs:label "Sitagliptin";
                rdfs:subClassOf dpo:DPP4Inhibitor;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_40237>,
                                                                <http://purl.obolibrary.org/obo/NCIT_C73838>;
                <http://www.w3.org/2004/02/skos/core#definition> "An orally available, competitive, beta-amino acid-derived inhibitor of dipeptidyl peptidase 4 (DDP-4) with hypoglycemic activity. Sitagliptin may cause an increased risk in the development of pancreatitis. [Definition Source: NCI]".
dpo:Sulfonylurea rdfs:comment "";
                 rdfs:label "Sulfonylurea";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralASCVDRisk] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:WeightGainPotential] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralHeartFailureRisk] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:HighEfficacy] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralDKDRisk] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 dpo:AntihyperglycemicTreatment,
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:LowCost] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                  <http://www.w3.org/2002/07/owl#hasValue> [a dpo:KnownHypoglycemiaRisk] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_76983>,
                                                                 <http://purl.obolibrary.org/obo/NCIT_C97936>;
                 <http://www.w3.org/2004/02/skos/core#definition> "Sulfonamide urea derivatives with antihyperglycemic activity. Sulphonylurea antidiabetic agents bind to sulfonylurea receptor type 1 (SUR1), the subunit of ATP-sensitive inwardly-rectifier potassium (IKATP) channels on the membranes of pancreatic beta cells, thereby blocking the inward current flow (influx) of positively charged K+ ions into the cell. This results in tonic membrane depolarization, and induces a calcium ion influx through voltage-sensitive calcium channels; increased intracellular calcium ion levels trigger exocytosis of insulin-containing granules. This eventually induces secretion of insulin. The IKATP channels found in pancreatic islets are complexes of four IKATP 6.2 and four SUR1 subunits. In addition, some sulfonylureas of larger molecular size may increase the sensitivity of peripheral tissues to insulin mediated through peroxisome proliferator-activated receptor gamma (PPARgamma). [Definition Source: NCI]".
dpo:Symptom a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "";
            rdfs:label "Symptom";
            rdfs:subClassOf dpo:PatientCharacteristic;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000462>;
            <http://www.w3.org/2004/02/skos/core#definition> "A symptom is a perceived change in function, sensation, loss, disturbance or appearance reported by a patient indicative of a disease. [ url:https://link.springer.com/chapter/10.1007/978-1-4615-4789-1_5 url:https://www.nature.com/subjects/signs-and-symptoms url:https://www.merriam-webster.com/dictionary/symptom ][Definition Source: SYMP:0000462]".
dpo:TestFinding a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A finding or categorization surmised from recorded measurements.";
                rdfs:label "Test Finding";
                rdfs:subClassOf dpo:DiagnosticFactor;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C25209>;
                <http://www.w3.org/2004/02/skos/core#definition> "Annotation used to indicate the size or magnitude of something that was determined by comparison to a standard. [Definition Source: NCI]".
dpo:Therapy a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "";
            rdfs:label "Therapy";
            rdfs:subClassOf dpo:TherapyPlanningComponent;
            <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C49236>;
            <http://www.w3.org/2004/02/skos/core#definition> "An action or administration of therapeutic agents to produce an effect that is intended to alter or stop a pathologic process. [Definition Source: NCI]".
dpo:TherapyPlanningComponent a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "Therapy Planning Component".
dpo:Thiazolidinedione rdfs:comment "";
                      rdfs:label "Thiazolidinedione";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NeutralDKDRisk] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:IncreasedHeartFailureRisk] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:HighEfficacy] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:LowCost] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:WeightGainPotential] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      dpo:AntihyperglycemicTreatment,
                                      [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasAttribute> ; 
                                       <http://www.w3.org/2002/07/owl#hasValue> [a dpo:NoKnownHypoglycemiaRisk] ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/CHEBI_50990>,
                                                                      <http://purl.obolibrary.org/obo/NCIT_C98241>;
                      <http://www.w3.org/2004/02/skos/core#definition> "Any antidiabetic agent with the glitazone (thiazolidinedione) base structure with antihyperglycemic activity. Glitazone antidiabetic agents selectively bind to and stimulate the nuclear receptor peroxisome proliferator-activated receptor (PPAR) gamma. This results in the selective transcription of a number of insulin-sensitive genes involved in glucose metabolism. This eventually enhances insulin sensitivity, reduces insulin resistance and decreases hepatic gluconeogenesis. PPARs function as transcription factors that regulate expressions of genes involved in cellular differentiation, development, and metabolism (carbohydrate, lipid, protein), as well as tumorigenesis; PPARgamma is expressed at high levels in adipose tissue. [Definition Source: NCI]".
dpo:TriglycerideMeasurement a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "";
                            rdfs:label "Triglyceride Measurement";
                            rdfs:subClassOf dpo:TestFinding;
                            <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C64812>;
                            <http://www.w3.org/2004/02/skos/core#definition> "A quantitative measurement of the amount of triglyceride present in a sample. [Definition Source: NCI]".
dpo:Underweight a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "BMI<18.5";
                rdfs:label "Underweight";
                rdfs:subClassOf dpo:BodyMassIndexFinding;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://www.ebi.ac.uk/efo/EFO_0005936>;
                <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.obolibrary.org/obo/NCIT_C138901>
                                                                [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:UnderweightBMIRange ; 
                                                                a <http://www.w3.org/2002/07/owl#Restriction>]);
                <http://www.w3.org/2004/02/skos/core#definition> "The quantification of weight/height relationships below a certain threshold that classes an individual as underweight. This threshold may vary based on an individual's ethnicity but is commonly considered in European populations to correspond to a BMI < 18. [Definition Source: EFO:0005936]".
dpo:UnderweightBMIRange a <http://www.w3.org/2002/07/owl#DataRange>;
                        rdfs:label "Underweight BMI Range";
                        <http://www.w3.org/2002/07/owl#maxInclusive> 18.5;
                        <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:UrinarySystemSymptom a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A symptom involving the urinary system.";
                         rdfs:label "Urinary System Symptom";
                         rdfs:subClassOf dpo:Symptom;
                         <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000486>;
                         <http://www.w3.org/2004/02/skos/core#definition> "Symptoms of urinary disorders vary from person to person and based on the cause of the disorders. Common urinary symptoms include: Abdominal cramping; Abdominal, pelvic or back pain that can be severe; Bloody or pink-colored urine (hematuria); Cloudy urine; Fever and chills; Foul-smelling urine; Frequent urination; General ill feeling; Leaking of urine; Pain during sexual intercourse; Pain or burning with urination (dysuria); Unexplained weight loss; Urgent need to urinate. [Definition Source: url:https://www.healthgrades.com/right-care/kidneys-and-the-urinary-system/urinary-disorders ]".
dpo:UrinaryTractInfection a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "";
                          rdfs:label "Urinary Tract Infection (UTI)";
                          rdfs:subClassOf dpo:UrinarySystemSymptom;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C50791>;
                          <http://www.w3.org/2004/02/skos/core#definition> "A bacterial infectious process affecting any part of the urinary tract, most commonly the bladder and the urethra. Symptoms include urinary urgency and frequency, burning sensation during urination, lower abdominal discomfort, and cloudy urine. [Definition Source: NCI]".
dpo:VeryHighHbA1CLevel a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "";
                       rdfs:label "Very High HbA1C Level";
                       rdfs:subClassOf dpo:BloodGlucoseMeasurement;
                       <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/59261-8>
                                                                       [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:VeryHighHbA1CRange ; 
                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]);
                       <http://www.w3.org/2004/02/skos/core#definition> "A1C ≥ 9%".
dpo:VeryHighHbA1CRange a <http://www.w3.org/2002/07/owl#DataRange>;
                       rdfs:label "Very High HbA1C Range";
                       <http://www.w3.org/2002/07/owl#minInclusive> 215 ;
                       <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:VeryHighLDLLevel a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "";
                     rdfs:label "Very High LDL Level";
                     rdfs:subClassOf dpo:CholesterolMeasurement;
                     <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/2089-1>
                                                                     [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                     <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:VeryHighLDLRange ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]);
                     <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:VeryHighLDLRange a <http://www.w3.org/2002/07/owl#DataRange>;
                     rdfs:label "Very High LDL Range";
                     <http://www.w3.org/2002/07/owl#minInclusive> 190 ;
                     <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:VeryHighTriglycerideLevel a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "";
                              rdfs:label "Very High Triglyceride Level";
                              rdfs:subClassOf dpo:TriglycerideMeasurement;
                              <http://www.w3.org/2002/07/owl#intersectionOf> (<http://purl.bioontology.org/ontology/LNC/12228-3>
                                                                              [<http://www.w3.org/2002/07/owl#onProperty> <http://semanticscience.org/resource/hasValue> ; 
                                                                              <http://www.w3.org/2002/07/owl#allValuesFrom> dpo:VeryHighTriglycerideRange ; 
                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]);
                              <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:VeryHighTriglycerideRange a <http://www.w3.org/2002/07/owl#DataRange>;
                              rdfs:label "Very High Triglyceride Range";
                              <http://www.w3.org/2002/07/owl#minInclusive> 500 ;
                              <http://www.w3.org/2002/07/owl#onDataRange> xsd:decimal.
dpo:VisionSymptom a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A symptom involving visual impairment.";
                  rdfs:label "Vision Symptom";
                  rdfs:subClassOf dpo:Symptom;
                  <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/SYMP_0000320>;
                  <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:WeightChangePotential rdfs:comment "The capacity for an increase or decrease in the weight of an individual.";
                          rdfs:label "Weight Change Potential";
                          rdfs:subClassOf dpo:PharmacotherapyFactor;
                          <http://www.w3.org/2002/07/owl#equivalentClass> <http://purl.obolibrary.org/obo/NCIT_C9232>;
                          <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:WeightGainPotential rdfs:comment "The capacity for an increase in the weight of an individual.";
                        rdfs:label "Weight Gain Potential";
                        rdfs:subClassOf dpo:WeightChangePotential;
                        <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:WeightLossPotential rdfs:comment "The capacity for a decrease in the weight of an individual.";
                        rdfs:label "Weight Loss Potential";
                        rdfs:subClassOf dpo:WeightChangePotential;
                        <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:diabetes_pharmacology_ontology.ttl <http://purl.org/dc/terms/contributor> "Oshani Seneviratne",
                                                                              "Deborah L. McGuinness",
                                                                              "Daniel Gruen",
                                                                              "Jamie McCusker";
                                       <http://purl.org/dc/terms/created> "2022-06-08T18:00:00"^^xsd:dateTime;
                                       <http://purl.org/dc/terms/creator> "Sabbir M. Rashid";
                                       <http://purl.org/dc/terms/description> "The Diabetes Pharmacology Ontology contains the classes needed to describe antihyperglycemic therapies.";
                                       <http://purl.org/dc/terms/license> <http://www.apache.org/licenses/LICENSE-2.0>;
                                       <http://purl.org/dc/terms/modified> "2022-12-18T18:00:00"^^xsd:dateTime;
                                       <http://purl.org/dc/terms/title> "Diabetes Pharmacology Ontology";
                                       a <http://www.w3.org/2002/07/owl#Ontology>;
                                       <http://www.w3.org/2002/07/owl#versionIRI> dpo:1.0.
dpo:hasDiagnosis a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "has diagnosis";
                 rdfs:range dpo:Disease;
                 rdfs:subPropertyOf <http://semanticscience.org/resource/hasAttribute>.
dpo:hasTherapy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "has therapy";
               rdfs:range dpo:Therapy;
               rdfs:subPropertyOf <http://semanticscience.org/resource/hasAttribute>.
dpo:hasTreatmentAversion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:label "has therapy aversion";
                         rdfs:range dpo:Therapy.
dpo:hasTreatmentPreference a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "has therapy preference";
                           rdfs:range dpo:Therapy.
<http://semanticscience.org/resource/hasAttribute> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                                   rdfs:label "has attribute".
<http://www.ebi.ac.uk/efo/EFO_0004340> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "body mass index";
                                       rdfs:subClassOf dpo:ExternalClass.
<http://www.ebi.ac.uk/efo/EFO_0005935> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "overweight body mass index status";
                                       rdfs:subClassOf <http://www.ebi.ac.uk/efo/EFO_0004340>.
<http://www.ebi.ac.uk/efo/EFO_0005936> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "underweight body mass index status";
                                       rdfs:subClassOf <http://www.ebi.ac.uk/efo/EFO_0004340>.
<http://www.ebi.ac.uk/efo/EFO_0007041> a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:label "obese body mass index status";
                                       rdfs:subClassOf <http://www.ebi.ac.uk/efo/EFO_0004340>.
