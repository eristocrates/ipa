                                        <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NeutralASCVDRisk rdfs:comment "Minimal effect on reducing or increasing the risk of cardiovascular disease resulting from atherosclerosis.";
                     rdfs:label "Neutral ASCVD Risk";
                     rdfs:subClassOf dpo:AtheroscleroticCardiovascularDiseaseRisk;
                     <http://www.w3.org/2004/02/skos/core#definition> "".
dpo:NeutralDKDRisk rdfs:comment "Minimal effect on reducing or increasing the risk or progression of diabetic kidney disease.";
                   rdfs:label "Neutral Diabetic Kidney Disease Risk";
