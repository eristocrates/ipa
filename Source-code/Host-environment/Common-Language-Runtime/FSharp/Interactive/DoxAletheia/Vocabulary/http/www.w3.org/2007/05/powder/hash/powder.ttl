@base <https://www.w3.org/TR/2007/WD-powder-voc-20070925/wdr.rdf>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix xml: <http://www.w3.org/XML/1998/namespace>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix http: <http://www.w3.org/2006/http#>.
@prefix wdrd: <http://www.w3.org/2007/05/powder-xsd#>.
@prefix wdr: <http://www.w3.org/2007/05/powder#>.
@prefix : <http://www.w3.org/2007/05/powder#>.
@prefix powder: <http://www.w3.org/2007/05/powder#>.

http:302 a owl:Class.
http:303 a owl:Class.
http:307 a owl:Class.
wdr: a owl:Ontology;
     rdfs:comment "The Web Description Resources (WDR) vocabulary defines a set of classes and properties to be used in order to specify a description of set of resources, and the author responsible of such description."@en;
     rdfs:label "Protocol for Web Description Resources (POWDER): Web Description Resources (WDR) Vocabulary"@en;
     rdfs:seeAlso <http://www.w3.org/TR/powder-dr/>,
                  <http://www.w3.org/TR/powder-grouping/>;
     owl:versionInfo "v 0 j".
wdr:DR a owl:Class;
       rdfs:comment "This class denotes a description, the set of resources to which it applies (the DR scope), and the author who created it. Its three components correspond, respectively, to classes wdr:Descriptors, wdr:ResourceSet, and to foaf:agent which is linked by the property foaf:maker. In addition, it is possible to specify the issue, valid from and expiry dates by using dcterms:issued, wdr:validFrom and wdr:validUntil respectively."@en;
       rdfs:isDefinedBy wdr:DR;
       rdfs:label "Description Resource"@en;
       rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>;
       rdfs:subClassOf [a owl:Restriction ; 
                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty wdr:hasScope],
                       [a owl:Restriction ; 
                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty wdr:hasDescriptors],
                       [a owl:Restriction ; 
                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty foaf:maker],
                       [a owl:Restriction ; 
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty wdr:validFrom],
                       [a owl:Restriction ; 
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty wdr:validUntil],
                       [a owl:Restriction ; 
                        owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                        owl:onProperty dcterms:issued].
wdr:Descriptors a owl:Class;
                rdfs:comment "This class denotes a collection of descriptors that can be specified using RDF/OWL properties defined in any vocabulary. The important difference between this class and rdf:Description is that the properties of the wdr:Descriptors class describe the resources in a Resource Set, not the Description Resource."@en;
                rdfs:isDefinedBy wdr:Descriptors;
                rdfs:label "Descriptors"@en;
                rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>.
wdr:HttpAnyRedirect a owl:Class;
                    rdfs:comment "This class denotes either permanent or temporary HTTP redirection, corresponding to HTTP response codes 301, 302, 303, and 307."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "HTTP Permanent or Temporary Redirection"@en;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#redirection>;
                    rdfs:subClassOf wdr:HttpRedirect;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:unionOf (wdr:HttpPermRedirect
                                                      wdr:HttpTempRedirect)].
wdr:HttpPermRedirect a owl:Class;
                     rdfs:comment "This class denotes permanent HTTP redirection, corresponding to HTTP response code 301."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "HTTP Permanent Redirection"@en;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#redirection>;
                     rdfs:subClassOf wdr:HttpRedirect;
                     owl:disjointWith wdr:HttpTempRedirect;
                     owl:equivalentClass http:301.
wdr:HttpRedirect a owl:Class;
                 rdfs:comment "This class denotes HTTP redirection, corresponding to HTTP response codes 3xx. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "HTTP Redirection"@en.
wdr:HttpTempRedirect a owl:Class;
                     rdfs:comment "This class denotes temporary HTTP redirection, corresponding to HTTP response codes 302, 303, and 307."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "HTTP Temporary Redirection"@en;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#redirection>;
                     rdfs:subClassOf wdr:HttpRedirect;
                     owl:disjointWith wdr:HttpPermRedirect;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:unionOf (http:302
                                                       http:303
                                                       http:307)].
wdr:Package a owl:Class;
            rdfs:comment "This class denotes an ordered, closed collection of Description Resources. A package describes a Resource Set that is the union of the Resource Sets of the DRs within it."@en;
            rdfs:isDefinedBy wdr:Package;
            rdfs:label "Description Resource Package"@en;
            rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#package>;
            rdfs:subClassOf [a owl:Restriction ; 
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty wdr:aboutHosts],
                            [a owl:Restriction ; 
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty wdr:hasScope],
                            [a owl:Restriction ; 
                             owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty wdr:hasDRs].
wdr:PropLookUp a owl:Class;
               rdfs:comment "This class denotes the characteristics of a set of resources and the method to be used to discover them."@en;
               rdfs:isDefinedBy wdr:;
               rdfs:label "Property Lookup"@en;
               rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
               rdfs:subClassOf [a owl:Restriction ; 
                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wdr:lookUpURI],
                               [a owl:Restriction ; 
                                owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wdr:httpMethod],
                               [a owl:Restriction ; 
                                owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wdr:responseRestriction],
                               [a owl:Restriction ; 
                                owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wdr:includeExactResponses].
wdr:ResourceSet a owl:Class;
                rdfs:comment "This class denotes a set of resources in terms of their address and/or characteristics. It is a potentially complex class and is therefore the subject of its own Recommendation (http://www.w3.org/TR/powder-grouping/)"@en;
                rdfs:isDefinedBy wdr:ResourceSet;
                rdfs:label "Resource Set"@en;
                rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#methOutline>;
                rdfs:subClassOf [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeResources],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeSchemes],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeUsers],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeHosts],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:portRestriction],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeExactPaths],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includePathStartsWith],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includePathEndsWith],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeExactQueries],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeFragments],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeUriRegEx],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:ipRestriction],
                                [a owl:Restriction ; 
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty wdr:includeRedirection];
                owl:equivalentClass [a owl:Class ; 
                                     owl:unionOf ([a owl:Class ; 
                                                  rdfs:subClassOf [a owl:Restriction ; 
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty wdr:setDefinition]]
                                                  [a owl:Class ; 
                                                  rdfs:subClassOf [a owl:Restriction ; 
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty owl:unionOf]]
                                                  [a owl:Class ; 
                                                  rdfs:subClassOf [a owl:Restriction ; 
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty owl:intersectionOf]]
                                                  [a owl:Class ; 
                                                  rdfs:subClassOf [a owl:Restriction ; 
                                                                   owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                   owl:onProperty owl:complementOf]])].
wdr:aboutHosts a owl:DatatypeProperty;
               rdfs:comment "This property provides a processing hint about the resources described by the DRs in a Package. As with includeHosts and excludeHosts, the datatype of its range is a white space separated list of URI hosts."@en;
               rdfs:domain <https://www.w3.org/TR/2007/WD-powder-voc-20070925/wdr.rdf#Package>;
               rdfs:isDefinedBy wdr:;
               rdfs:label "about hosts"@en;
               rdfs:range wdrd:uriHostList.
wdr:addressRestriction a owl:DatatypeProperty;
                       rdfs:comment "This property denotes a set of resources in terms of their addresses. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                       rdfs:isDefinedBy wdr:;
                       rdfs:label "address restriction"@en;
                       rdfs:range xsd:string;
                       rdfs:subPropertyOf wdr:setDefinition.
wdr:certifiedBy a owl:DatatypeProperty;
                rdfs:comment "This property links a DR to a certificate that refers back to the DR. The certificate may in any format."@en;
                rdfs:domain wdr:DR;
                rdfs:isDefinedBy wdr:;
                rdfs:label "certified by"@en;
                rdfs:range rdfs:Resource;
                rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#authentication>.
wdr:describedBy a owl:ObjectProperty;
                rdfs:comment "This property can point from any resource to a DR or a DR Package which should include the resource that pointed to it in its scope."@en;
                rdfs:isDefinedBy wdr:;
                rdfs:label "described by"@en;
                rdfs:range <https://www.w3.org/TR/2007/WD-powder-voc-20070925/wdr.rdf#DR>,
                           <https://www.w3.org/TR/2007/WD-powder-voc-20070925/wdr.rdf#Package>;
                rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#semlink>.
wdr:drAuthenticate a rdf:Property;
                   rdfs:comment "This property links a foaf:Agent class (used to give details of a DR's creator) to a resource that provides information about of how DRs attributed to that creator may be authenticated."@en;
                   rdfs:domain foaf:Agent;
                   rdfs:isDefinedBy wdr:;
                   rdfs:label "DR authenticate"@en;
                   rdfs:range rdfs:Resource;
                   rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#discover>.
wdr:excludeConditional a owl:ObjectProperty;
                       rdfs:comment "This property links to an RDF resource that in some way conveys the essential characteristics of resources that are elements of a set. Such a set may then be excluded when interpreting a Resource Set definition."@en;
                       rdfs:isDefinedBy wdr:;
                       rdfs:label "exclude conditional"@en;
                       rdfs:range rdfs:Resource;
                       rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropBasic>;
                       rdfs:subPropertyOf wdr:propertyRestriction.
wdr:excludeExactPaths a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources that have a URI path component exactly matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "exclude exact paths"@en;
                      rdfs:range wdrd:uriPathList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                   <http://www.w3.org/TR/powder-grouping/#query>;
                      rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeExactQueries a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI query component exactly matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "exclude exact queries"@en;
                        rdfs:range wdrd:uriQueryList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeExactResponses a owl:DatatypeProperty;
                          rdfs:comment "This property defines a set of resources for which the response from the given look up URI exactly matches at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                          rdfs:isDefinedBy wdr:;
                          rdfs:label "exclude exact responses"@en;
                          rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
                          rdfs:subPropertyOf wdr:responseRestriction.
wdr:excludeFragments a owl:DatatypeProperty;
                     rdfs:comment "This property defines a set of resources that have a URI fragment component matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "exclude fragments"@en;
                     rdfs:range wdrd:uriFragmentList;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                  <http://www.w3.org/TR/powder-grouping/#query>;
                     rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeHosts a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI host component matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "exclude hosts"@en;
                 rdfs:range wdrd:uriHostList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                 rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeIPs a owl:DatatypeProperty;
               rdfs:comment "This property defines a set of resources that have an IP address matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
               rdfs:isDefinedBy wdr:;
               rdfs:label "exclude IPs"@en;
               rdfs:range wdrd:ipList;
               rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byIP>.
wdr:excludeIpRanges a owl:DatatypeProperty;
                    rdfs:comment "This property defines a set of resources that have an IP address within at least one of the ranges given in a white space separated list of CIDR blocks, that is to be excluded when interpreting a Resource Set definition."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "exclude IP ranges"@en;
                    rdfs:range wdrd:cidrList;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byIP>.
wdr:excludePathContains a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI path component containing at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "exclude path contains"@en;
                        rdfs:range wdrd:uriPathList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludePathEndsWith a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI path component ending with at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "exclude path ends with"@en;
                        rdfs:range wdrd:uriPathList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludePathStartsWith a owl:DatatypeProperty;
                          rdfs:comment "This property defines a set of resources that have a URI path component starting with at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                          rdfs:isDefinedBy wdr:;
                          rdfs:label "exclude path starts with"@en;
                          rdfs:range wdrd:uriPathList;
                          rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                       <http://www.w3.org/TR/powder-grouping/#query>;
                          rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludePortRanges a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources that have a URI port component within at least one of the ranges given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "exclude port ranges"@en;
                      rdfs:range wdrd:uriPortRangeList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                   <http://www.w3.org/TR/powder-grouping/#ports>.
wdr:excludePorts a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI port component matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "exclude ports"@en;
                 rdfs:range wdrd:uriPortList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                              <http://www.w3.org/TR/powder-grouping/#ports>.
wdr:excludeQueryContains a owl:DatatypeProperty;
                         rdfs:comment "This property defines a set of resources that have a URI query component containing at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                         rdfs:isDefinedBy wdr:;
                         rdfs:label "exclude query contains"@en;
                         rdfs:range wdrd:uriQueryList;
                         rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                      <http://www.w3.org/TR/powder-grouping/#query>;
                         rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeResources a owl:DatatypeProperty;
                     rdfs:comment "This property defines a set of one or more resources, identified by a white space separated list of their URIs, that are to be excluded from a Resource Set."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "exclude resources"@en;
                     rdfs:range wdrd:uriList;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#listing>;
                     rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeResponseContains a owl:DatatypeProperty;
                            rdfs:comment "This property defines a set of resources for which the response from the given look up URI contains at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                            rdfs:isDefinedBy wdr:;
                            rdfs:label "exclude response contains"@en;
                            rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
                            rdfs:subPropertyOf wdr:responseRestriction.
wdr:excludeSchemes a owl:DatatypeProperty;
                   rdfs:comment "This property defines a set of resources that have a URI scheme component matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                   rdfs:isDefinedBy wdr:;
                   rdfs:label "exclude schemes"@en;
                   rdfs:range wdrd:uriSchemeList;
                   rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                   rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeUriPattern a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources, by means of white space separated list of URI-like strings that include wildcards, that is to be excluded when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "exclude URI pattern"@en;
                      rdfs:range wdrd:stringList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byUriPattern>;
                      rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeUriRegEx a owl:DatatypeProperty;
                    rdfs:comment "This property defines a set of resources, by means of a Regular Expression match against their URIs, that is to be excluded when interpreting a Resource Set definition."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "exclude URI pattern"@en;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byUriRegEx>,
                                 <http://www.w3.org/TR/xpath-functions/#regex-syntax>;
                    rdfs:subPropertyOf wdr:addressRestriction.
wdr:excludeUsers a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI userinfo component matching at least one of the values given in a white space separated list, that is to be excluded when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "exclude user infos"@en;
                 rdfs:range wdrd:uriUserInfoList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                 rdfs:subPropertyOf wdr:addressRestriction.
wdr:hasDRs a owl:ObjectProperty;
           rdfs:comment "This property denotes an ordered collection of Description Resources in a Package in which it MUST be present."@en;
           rdfs:domain wdr:Package;
           rdfs:isDefinedBy wdr:;
           rdfs:label "has Description Resources"@en;
           rdfs:range wdr:DR;
           rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>.
wdr:hasDescriptors a owl:ObjectProperty;
                   rdfs:comment "This property links a Description Resource to a Descriptors class. It MUST be included in Description Resources."@en;
                   rdfs:domain wdr:DR;
                   rdfs:isDefinedBy wdr:;
                   rdfs:label "has description"@en;
                   rdfs:range wdr:Descriptors;
                   rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>.
wdr:hasScope a owl:ObjectProperty;
             rdfs:comment "This property links a Description Resource to the set of resources to which it applies. It MUST be included in Description Resources."@en;
             rdfs:domain wdr:DR,
                         wdr:Package;
             rdfs:isDefinedBy wdr:;
             rdfs:label "has scope"@en;
             rdfs:range wdr:ResourceSet;
             rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>.
wdr:httpMethod a owl:ObjectProperty;
               rdfs:comment "This property specifies the HTTP method to be used in order to send a request to the lookup service."@en;
               rdfs:domain wdr:PropLookUp;
               rdfs:isDefinedBy wdr:;
               rdfs:label "HTTP method"@en;
               rdfs:range http:Request;
               rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>.
wdr:includeConditional a owl:ObjectProperty;
                       rdfs:comment "This property links to an RDF resource that in some way conveys the essential characteristics of resources that are elements of a set. Such a set may then be included when interpreting a Resource Set definition."@en;
                       rdfs:isDefinedBy wdr:;
                       rdfs:label "include conditional"@en;
                       rdfs:range rdfs:Resource;
                       rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropBasic>;
                       rdfs:subPropertyOf wdr:propertyRestriction.
wdr:includeExactPaths a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources that have a URI path component exactly matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "include exact paths"@en;
                      rdfs:range wdrd:uriPathList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                   <http://www.w3.org/TR/powder-grouping/#query>;
                      rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeExactQueries a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI query component exactly matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "include exact queries"@en;
                        rdfs:range wdrd:uriQueryList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeExactResponses a owl:DatatypeProperty;
                          rdfs:comment "This property defines a set of resources for which the response from the given look up URI exactly matches at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                          rdfs:isDefinedBy wdr:;
                          rdfs:label "include exact responses"@en;
                          rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
                          rdfs:subPropertyOf wdr:responseRestriction.
wdr:includeFragments a owl:DatatypeProperty;
                     rdfs:comment "This property defines a set of resources that have a URI fragment component matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "include fragments"@en;
                     rdfs:range wdrd:uriFragmentList;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                  <http://www.w3.org/TR/powder-grouping/#query>;
                     rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeHosts a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI host component matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "include hosts"@en;
                 rdfs:range wdrd:uriHostList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                 rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeIPs a owl:DatatypeProperty;
               rdfs:comment "This property defines a set of resources that have an IP address matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
               rdfs:isDefinedBy wdr:;
               rdfs:label "include IPs"@en;
               rdfs:range wdrd:ipList;
               rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byIP>;
               rdfs:subPropertyOf wdr:ipRestriction.
wdr:includeIpRanges a owl:DatatypeProperty;
                    rdfs:comment "This property defines a set of resources that have an IP address within at least one of the ranges given in a white space separated list of CIDR blocks, that is to be included when interpreting a Resource Set definition."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "include IP ranges"@en;
                    rdfs:range wdrd:cidrList;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byIP>;
                    rdfs:subPropertyOf wdr:ipRestriction.
wdr:includePathContains a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI path component containing at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "include path contains"@en;
                        rdfs:range wdrd:uriPathList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:includePathEndsWith a owl:DatatypeProperty;
                        rdfs:comment "This property defines a set of resources that have a URI path component ending with at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "include path ends with"@en;
                        rdfs:range wdrd:uriPathList;
                        rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                     <http://www.w3.org/TR/powder-grouping/#query>;
                        rdfs:subPropertyOf wdr:addressRestriction.
wdr:includePathStartsWith a owl:DatatypeProperty;
                          rdfs:comment "This property defines a set of resources that have a URI path component starting with at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                          rdfs:isDefinedBy wdr:;
                          rdfs:label "include path starts with"@en;
                          rdfs:range wdrd:uriPathList;
                          rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                       <http://www.w3.org/TR/powder-grouping/#query>;
                          rdfs:subPropertyOf wdr:addressRestriction.
wdr:includePortRanges a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources that have a URI port component within at least one of the ranges given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "include port ranges"@en;
                      rdfs:range wdrd:uriPortRangeList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                   <http://www.w3.org/TR/powder-grouping/#ports>;
                      rdfs:subPropertyOf wdr:portRestriction.
wdr:includePorts a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI port component matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "include ports"@en;
                 rdfs:range wdrd:uriPortList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                              <http://www.w3.org/TR/powder-grouping/#ports>;
                 rdfs:subPropertyOf wdr:portRestriction.
wdr:includeQueryContains a owl:DatatypeProperty;
                         rdfs:comment "This property defines a set of resources that have a URI query component containing at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                         rdfs:isDefinedBy wdr:;
                         rdfs:label "include query contains"@en;
                         rdfs:range wdrd:uriQueryList;
                         rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                      <http://www.w3.org/TR/powder-grouping/#query>;
                         rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeRedirection a owl:ObjectProperty;
                       rdfs:comment "This property determines whether HTTP-redirected resource are to be included in the Resource Set. Its value can indicate that temporary, permanent or any redirection is allowable."@en;
                       rdfs:isDefinedBy wdr:;
                       rdfs:label "include redirection"@en;
                       rdfs:range wdr:HttpRedirect;
                       rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#redirection>.
wdr:includeResources a owl:DatatypeProperty;
                     rdfs:comment "This property defines a set of one or more resources, identified by a white space separated list of their URIs, that are to be included in a Resource Set."@en;
                     rdfs:isDefinedBy wdr:;
                     rdfs:label "include resources"@en;
                     rdfs:range wdrd:uriList;
                     rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#listing>;
                     rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeResponseContains a owl:DatatypeProperty;
                            rdfs:comment "This property defines a set of resources for which the response from the given look up URI contains at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                            rdfs:isDefinedBy wdr:;
                            rdfs:label "include response contains"@en;
                            rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
                            rdfs:subPropertyOf wdr:responseRestriction.
wdr:includeSchemes a owl:DatatypeProperty;
                   rdfs:comment "This property defines a set of resources that have a URI scheme component matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                   rdfs:isDefinedBy wdr:;
                   rdfs:label "include schemes"@en;
                   rdfs:range wdrd:uriSchemeList;
                   rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                   rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeUriPattern a owl:DatatypeProperty;
                      rdfs:comment "This property defines a set of resources, by means of white space separated list of URI-like strings that include wildcards, that is to be included when interpreting a Resource Set definition."@en;
                      rdfs:isDefinedBy wdr:;
                      rdfs:label "include URI pattern"@en;
                      rdfs:range wdrd:stringList;
                      rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byUriPattern>;
                      rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeUriRegEx a owl:DatatypeProperty;
                    rdfs:comment "This property defines a set of resources, by means of a Regular Expression match against their URIs, that is to be included when interpreting a Resource Set definition."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "include URI pattern"@en;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byUriRegEx>,
                                 <http://www.w3.org/TR/xpath-functions/#regex-syntax>;
                    rdfs:subPropertyOf wdr:addressRestriction.
wdr:includeUsers a owl:DatatypeProperty;
                 rdfs:comment "This property defines a set of resources that have a URI userinfo component matching at least one of the values given in a white space separated list, that is to be included when interpreting a Resource Set definition."@en;
                 rdfs:isDefinedBy wdr:;
                 rdfs:label "include user infos"@en;
                 rdfs:range wdrd:uriUserInfoList;
                 rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>;
                 rdfs:subPropertyOf wdr:addressRestriction.
wdr:ipRestriction a owl:DatatypeProperty;
                  rdfs:comment "This property denotes a set of resources in terms of a set of IP addresses or IP ranges. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                  rdfs:isDefinedBy wdr:;
                  rdfs:label "IP restriction"@en;
                  rdfs:subPropertyOf wdr:addressRestriction.
wdr:lookUpURI a owl:DatatypeProperty;
              rdfs:comment "This property specifies the URI to be resolved in order to discover the characteristics of a candidate resource. It takes a single 'template URI' that will include, or may comprise, the specific string {cURI}. This is to be substituted by the candidate resource's URI before resolution."@en;
              rdfs:domain wdr:PropLookUp;
              rdfs:isDefinedBy wdr:;
              rdfs:label "lookup URI"@en;
              rdfs:range xsd:string;
              rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>.
wdr:mapsTo a owl:ObjectProperty;
           rdfs:comment "This property links from any kind of descriptive resource to a wdr:Descriptors class that is semantically equivalent."@en;
           rdfs:isDefinedBy wdr:;
           rdfs:label "maps to"@en;
           rdfs:range <https://www.w3.org/TR/2007/WD-powder-voc-20070925/wdr.rdf#Descriptors>;
           rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#semlink>.
wdr:portRestriction a owl:DatatypeProperty;
                    rdfs:comment "This property denotes a set of resources in terms of a list of URI ports or port ranges. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                    rdfs:isDefinedBy wdr:;
                    rdfs:label "port restriction"@en;
                    rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byURIcomp>,
                                 <http://www.w3.org/TR/powder-grouping/#ports>;
                    rdfs:subPropertyOf wdr:addressRestriction.
wdr:propertyRestriction a owl:ObjectProperty;
                        rdfs:comment "This property denotes a set of resources in terms of their characteristics. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "property restriction"@en;
                        rdfs:range rdfs:Resource;
                        rdfs:subPropertyOf wdr:setDefinition.
wdr:responseRestriction a owl:DatatypeProperty;
                        rdfs:comment "This property denotes the response provided by a lookup service about the characteristics of a resource. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                        rdfs:domain wdr:PropLookUp;
                        rdfs:isDefinedBy wdr:;
                        rdfs:label "response restriction"@en;
                        rdfs:range wdrd:response.
wdr:setDefinition a rdf:Property;
                  rdfs:comment "This property denotes a set of resources in terms of their address or characteristics. It MUST NOT be used directly in a Resource Set definition but is useful in defining cardinality constraints on its sub properties."@en;
                  rdfs:domain wdr:ResourceSet;
                  rdfs:isDefinedBy wdr:;
                  rdfs:label "set definition"@en.
wdr:supportedBy a owl:DatatypeProperty;
                rdfs:comment "This property links a DR to another data source that supports, i.e. agrees with, the claims and assertions made in the DR. The supporting evidence may in any format."@en;
                rdfs:domain wdr:DR;
                rdfs:isDefinedBy wdr:;
                rdfs:label "supported by"@en;
                rdfs:range rdfs:Resource;
                rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#supportedBy>.
wdr:usePropLookUp a owl:ObjectProperty;
                  rdfs:comment "This property links a Description Resource to a Property Lookup Class."@en;
                  rdfs:isDefinedBy wdr:;
                  rdfs:label "use property lookup"@en;
                  rdfs:range wdr:PropLookUp;
                  rdfs:seeAlso <http://www.w3.org/TR/powder-grouping/#byPropLook>;
                  rdfs:subPropertyOf wdr:setDefinition.
wdr:validFrom a owl:DatatypeProperty;
              rdfs:comment "This property denotes the date from which a Description Resource is valid. It may post-date the DR's issue date."@en;
              rdfs:domain wdr:DR;
              rdfs:isDefinedBy wdr:;
              rdfs:label "valid from"@en;
              rdfs:range xsd:dateTime;
              rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>;
              rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>.
wdr:validUntil a owl:DatatypeProperty;
               rdfs:comment "This property denotes the expiry date of a Description Resource."@en;
               rdfs:domain wdr:DR;
               rdfs:isDefinedBy wdr:;
               rdfs:label "valid until"@en;
               rdfs:range xsd:dateTime;
               rdfs:seeAlso <http://www.w3.org/TR/powder-dr/#structure>;
               rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>.
