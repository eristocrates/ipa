                                    <http://xmlns.com/foaf/0.1/name> "Richard Cyganiak".
<http://vocab.deri.ie/search#rdf> <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/search>;
                                  a <http://www.w3.org/ns/adms#SemanticDistribution>;
                                  <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/search.rdf";
                                  <http://www.w3.org/ns/adms#status> <http://purl.org/adms/status/Completed>.
<http://vocab.deri.ie/search#ttl> <http://purl.org/dc/terms/FileFormat> <http://vocab.deri.ie/search>;
                                  a <http://www.w3.org/ns/adms#SemanticDistribution>;
                                  <http://www.w3.org/ns/adms#accessURL> "http://vocab.deri.ie/search.ttl";
