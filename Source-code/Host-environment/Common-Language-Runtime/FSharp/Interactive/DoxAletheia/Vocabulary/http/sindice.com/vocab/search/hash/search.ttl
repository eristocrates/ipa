                              <http://purl.org/dc/terms/publisher> "http://vocab.deri.ie/search#Digital%20Enterprise%20Research%20Institute%2C%20NUI%20Galway";
                              <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                              <http://purl.org/dc/terms/title> "Sindice Search Vocabulary";
                              <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "search";
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "http://sindice.com/vocab/search#";
                              a <http://www.w3.org/2002/07/owl#Ontology>,
                                <http://www.w3.org/ns/adms#SemanticAsset>;
                              <http://xmlns.com/foaf/0.1/homepage> <http://vocab.deri.ie/search.html>.
<http://vocab.deri.ie/search#Digital%20Enterprise%20Research%20Institute%2C%20NUI%20Galway> a <http://purl.org/dc/terms/Agent>;
                                                                                            <http://xmlns.com/foaf/0.1/homepage> <http://www.deri.ie/>;
