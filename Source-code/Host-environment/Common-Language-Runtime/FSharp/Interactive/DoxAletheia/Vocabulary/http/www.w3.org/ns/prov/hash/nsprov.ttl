nsprov:qualifiedEndOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                      rdfs:label "qualifiedEndOf";
                      <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedEnd.
nsprov:qualifiedForm a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                     rdfs:comment """This annotation property links a subproperty of prov:wasInfluencedBy with the subclass of prov:Influence and the qualifying property that are used to qualify it. 

Example annotation:

    prov:wasGeneratedBy prov:qualifiedForm prov:qualifiedGeneration, prov:Generation .

Then this unqualified assertion:

    :entity1 prov:wasGeneratedBy :activity1 .

can be qualified by adding:

   :entity1 prov:qualifiedGeneration :entity1Gen .
   :entity1Gen 
       a prov:Generation, prov:Influence;
       prov:activity :activity1;
       :customValue 1337 .

Note how the value of the unqualified influence (prov:wasGeneratedBy :activity1) is mirrored as the value of the prov:activity (or prov:entity, or prov:agent) property on the influence class."""@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                      nsprov:;
                     rdfs:subPropertyOf rdfs:seeAlso.
nsprov:qualifiedGeneration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "If this Activity prov:generated Entity :e, then it can qualify how it performed the Generation using prov:qualifiedGeneration [ a prov:Generation;  prov:entity :e; :foo :bar ]."@en;
                           rdfs:domain nsprov:Entity;
                           rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                           rdfs:label "qualifiedGeneration";
                           rdfs:range nsprov:Generation;
                           rdfs:subPropertyOf nsprov:qualifiedInfluence;
                           nsprov:category "qualified";
                           nsprov:component "entities-activities";
                           nsprov:inverse "qualifiedGenerationOf";
                           nsprov:sharesDefinitionWith nsprov:Generation;
                           nsprov:unqualifiedForm nsprov:wasGeneratedBy.
nsprov:qualifiedGenerationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                             rdfs:label "qualifiedGenerationOf";
                             <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedGeneration.
nsprov:qualifiedInfluence a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Because prov:qualifiedInfluence is a broad relation, the more specific relations (qualifiedCommunication, qualifiedDelegation, qualifiedEnd, etc.) should be used when applicable."@en;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                                nsprov:Agent
                                                                                nsprov:Entity) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                          rdfs:label "qualifiedInfluence";
                          rdfs:range nsprov:Influence;
                          nsprov:category "qualified";
                          nsprov:component "derivations";
                          nsprov:inverse "qualifiedInfluenceOf";
                          nsprov:sharesDefinitionWith nsprov:Influence;
                          nsprov:unqualifiedForm nsprov:wasInfluencedBy.
nsprov:qualifiedInfluenceOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                            rdfs:label "qualifiedInfluenceOf";
                            <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedInfluence.
nsprov:qualifiedInsertion a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain nsprov:Dictionary;
                          rdfs:isDefinedBy nsprov:;
                          rdfs:label "qualifiedInsertion";
                          rdfs:range nsprov:Insertion;
                          rdfs:subPropertyOf nsprov:qualifiedDerivation;
                          nsprov:category "collections";
                          nsprov:component "collections";
                          nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                          nsprov:definition "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs.";
                          nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
                          nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI.
nsprov:qualifiedInvalidation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "If this Entity prov:wasInvalidatedBy Activity :a, then it can qualify how it was invalidated using prov:qualifiedInvalidation [ a prov:Invalidation;  prov:activity :a; :foo :bar ]."@en;
                             rdfs:domain nsprov:Entity;
                             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
