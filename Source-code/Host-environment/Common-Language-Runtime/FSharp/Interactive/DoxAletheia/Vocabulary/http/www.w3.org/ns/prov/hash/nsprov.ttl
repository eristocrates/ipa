nsprov:qualifiedSourceOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                         rdfs:label "qualifiedSourceOf";
                         <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedPrimarySource.
nsprov:qualifiedStart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "If this Activity prov:wasStartedBy Entity :e1, then it can qualify how it was started using prov:qualifiedStart [ a prov:Start;  prov:entity :e1; :foo :bar ]."@en;
                      rdfs:domain nsprov:Activity;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
