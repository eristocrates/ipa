                             nsprov:sharesDefinitionWith nsprov:Invalidation;
                             nsprov:unqualifiedForm nsprov:wasInvalidatedBy.
nsprov:qualifiedInvalidationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                               rdfs:label "qualifiedInvalidationOf";
                               <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedInvalidation.
nsprov:qualifiedPrimarySource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "If this Entity prov:hadPrimarySource Entity :e, then it can qualify how using prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :e; :foo :bar ]."@en;
                              rdfs:domain nsprov:Entity;
