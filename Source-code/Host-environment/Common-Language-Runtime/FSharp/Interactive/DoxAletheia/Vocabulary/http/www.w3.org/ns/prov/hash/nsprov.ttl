                            nsprov:component "agents-responsibility";
                            nsprov:inverse "qualifiedAttributionOf";
                            nsprov:sharesDefinitionWith nsprov:Attribution;
                            nsprov:unqualifiedForm nsprov:wasAttributedTo.
nsprov:qualifiedAttributionOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                              rdfs:label "qualifiedAttributionOf";
                              <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedAttribution.
nsprov:qualifiedCommunication a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "If this Activity prov:wasInformedBy Activity :a, then it can qualify how it was influenced using prov:qualifiedCommunication [ a prov:Communication;  prov:activity :a; :foo :bar ]."@en;
                              rdfs:domain nsprov:Activity;
                              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                              rdfs:label "qualifiedCommunication";
                              rdfs:range nsprov:Communication;
                              rdfs:subPropertyOf nsprov:qualifiedInfluence;
                              nsprov:category "qualified";
                              nsprov:component "entities-activities";
                              nsprov:inverse "qualifiedCommunicationOf";
                              nsprov:qualifiedForm nsprov:Communication;
