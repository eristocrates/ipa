                     rdfs:label "revisedEntity";
                     <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedRevision.
nsprov:sharesDefinitionWith a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                             nsprov:;
                            rdfs:subPropertyOf rdfs:seeAlso.
nsprov:specializationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                        rdfs:domain nsprov:Entity;
                        rdfs:isDefinedBy nsprov:,
                                         <http://www.w3.org/ns/prov-o#>;
                        rdfs:label "specializationOf";
                        rdfs:range nsprov:Entity;
                        rdfs:seeAlso nsprov:alternateOf;
                        rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>,
                                           nsprov:alternateOf;
                        nsprov:category "expanded";
                        nsprov:component "alternate";
                        nsprov:constraints "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-constraints.html#prov-dm-constraints-fig"^^xsd:anyURI,
                                           "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                        nsprov:definition "An entity that is a specialization of another shares all aspects of the latter, and additionally presents more specific aspects of the same thing as the latter. In particular, the lifetime of the entity being specialized contains that of any specialization. Examples of aspects include a time period, an abstraction, and a context associated with the entity."@en;
                        nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-specialization"^^xsd:anyURI,
                                  "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-specialization"^^xsd:anyURI;
                        nsprov:inverse "generalizationOf";
                        nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-specialization"^^xsd:anyURI,
                                 "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-specialization"^^xsd:anyURI.
nsprov:started rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
               rdfs:label "started";
               <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasStartedBy.
nsprov:startedAtTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The time at which an activity started. See also prov:endedAtTime."@en;
                     rdfs:domain nsprov:Activity;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "startedAtTime";
                     rdfs:range xsd:dateTime;
                     nsprov:category "starting-point";
                     nsprov:component "entities-activities";
                     nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedStart o prov:atTime) rdfs:subPropertyOf prov:startedAtTime."@en;
                     nsprov:qualifiedForm nsprov:Start,
                                          nsprov:atTime.
nsprov:todo a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
nsprov:unqualifiedForm a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                       rdfs:comment "Classes and properties used to qualify relationships are annotated with prov:unqualifiedForm to indicate the property used to assert an unqualified provenance relation."@en;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                        nsprov:;
                       rdfs:subPropertyOf rdfs:seeAlso.
nsprov:used a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "A prov:Entity that was used by this prov:Activity. For example, :baking prov:used :spoon, :egg, :oven ."@en;
            rdfs:domain nsprov:Activity;
            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
            rdfs:label "used";
            rdfs:range nsprov:Entity;
            rdfs:subPropertyOf nsprov:wasInfluencedBy;
            <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedUsage
                                                                nsprov:entity);
            nsprov:category "starting-point";
            nsprov:component "entities-activities";
            nsprov:inverse "wasUsedBy";
            nsprov:qualifiedForm nsprov:Usage,
                                 nsprov:qualifiedUsage.
nsprov:value a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain nsprov:Entity;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "value";
             nsprov:category "expanded";
             nsprov:component "entities-activities";
             nsprov:definition "Provides a value that is a direct representation of an entity."@en;
             nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-value"^^xsd:anyURI;
             nsprov:editorialNote "This property serves the same purpose as rdf:value, but has been reintroduced to avoid some of the definitional ambiguity in the RDF specification (specifically, 'may be used in describing structured values')."@en,
                                  "The editor's definition comes from http://www.w3.org/TR/rdf-primer/#rdfvalue".
nsprov:wasActivityOfInfluence rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                              rdfs:label "wasActivityOfInfluence";
                              <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadActivity.
nsprov:wasAssociateFor rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                       rdfs:label "wasAssociateFor";
                       <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasAssociatedWith.
nsprov:wasAssociatedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."@en;
                         rdfs:domain nsprov:Activity;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                         rdfs:label "wasAssociatedWith";
                         rdfs:range nsprov:Agent;
                         rdfs:subPropertyOf nsprov:wasInfluencedBy;
                         <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedAssociation
                                                                             nsprov:agent);
                         nsprov:category "starting-point";
                         nsprov:component "agents-responsibility";
                         nsprov:inverse "wasAssociateFor";
                         nsprov:qualifiedForm nsprov:Association,
                                              nsprov:qualifiedAssociation.
nsprov:wasAttributedTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Attribution is the ascribing of an entity to an agent."@en;
                       rdfs:domain nsprov:Entity;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "wasAttributedTo";
                       rdfs:range nsprov:Agent;
                       rdfs:subPropertyOf nsprov:wasInfluencedBy;
                       <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedAttribution
                                                                           nsprov:agent);
                       nsprov:category "starting-point";
                       nsprov:component "agents-responsibility";
                       nsprov:definition "Attribution is the ascribing of an entity to an agent."@en;
                       nsprov:inverse "contributed";
                       nsprov:qualifiedForm nsprov:Attribution,
                                            nsprov:qualifiedAttribution.
nsprov:wasDerivedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "The more specific subproperties of prov:wasDerivedFrom (i.e., prov:wasQuotedFrom, prov:wasRevisionOf, prov:hadPrimarySource) should be used when applicable."@en;
                      rdfs:domain nsprov:Entity;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                      rdfs:label "wasDerivedFrom";
                      rdfs:range nsprov:Entity;
                      rdfs:subPropertyOf nsprov:wasInfluencedBy;
                      <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedDerivation
                                                                          nsprov:entity);
                      nsprov:category "starting-point";
                      nsprov:component "derivations";
                      nsprov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en;
                      nsprov:inverse "hadDerivation";
                      nsprov:qualifiedForm nsprov:Derivation,
                                           nsprov:qualifiedDerivation.
nsprov:wasEndedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "End is when an activity is deemed to have ended. An end may refer to an entity, known as trigger, that terminated the activity."@en;
                  rdfs:domain nsprov:Activity;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "wasEndedBy";
                  rdfs:range nsprov:Entity;
                  rdfs:subPropertyOf nsprov:wasInfluencedBy;
                  <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedEnd
                                                                      nsprov:entity);
                  nsprov:category "expanded";
                  nsprov:component "entities-activities";
                  nsprov:inverse "ended";
                  nsprov:qualifiedForm nsprov:qualifiedEnd,
                                       nsprov:End.
nsprov:wasGeneratedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain nsprov:Entity;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                       <http://www.w3.org/ns/prov-o#>;
                      rdfs:label "wasGeneratedBy";
                      rdfs:range nsprov:Activity;
                      rdfs:subPropertyOf nsprov:wasInfluencedBy;
                      <http://www.w3.org/2002/07/owl#inverseOf> nsprov:generated;
                      <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedGeneration
                                                                          nsprov:activity);
                      nsprov:category "starting-point";
                      nsprov:component "entities-activities";
                      nsprov:inverse "generated";
                      nsprov:qualifiedForm nsprov:Generation,
                                           nsprov:qualifiedGeneration.
nsprov:wasInfluencedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment """This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.""",
                                    "Because prov:wasInfluencedBy is a broad relation, its more specific subproperties (e.g. prov:wasInformedBy, prov:actedOnBehalfOf, prov:wasEndedBy, etc.) should be used when applicable."@en;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                             nsprov:Agent
                                                                             nsprov:Entity) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                        <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "wasInfluencedBy";
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                            nsprov:Agent
                                                                            nsprov:Entity) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       <http://www.w3.org/2002/07/owl#inverseOf> nsprov:influenced;
                       nsprov:category "qualified";
                       nsprov:component "agents-responsibility";
                       nsprov:editorialNote """The sub-properties of prov:wasInfluencedBy can be elaborated in more detail using the Qualification Pattern. For example, the binary relation :baking prov:used :spoon can be qualified by asserting :baking prov:qualifiedUsage [ a prov:Usage; prov:entity :spoon; prov:atLocation :kitchen ] .

Subproperties of prov:wasInfluencedBy may also be asserted directly without being qualified.

prov:wasInfluencedBy should not be used without also using one of its subproperties. 
"""@en;
                       nsprov:inverse "influenced";
                       nsprov:qualifiedForm nsprov:Influence,
                                            nsprov:qualifiedInfluence;
                       nsprov:sharesDefinitionWith nsprov:Influence.
nsprov:wasInformedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "An activity a2 is dependent on or informed by another activity a1, by way of some unspecified entity that is generated by a1 and used by a2."@en;
                     rdfs:domain nsprov:Activity;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "wasInformedBy";
                     rdfs:range nsprov:Activity;
                     rdfs:subPropertyOf nsprov:wasInfluencedBy;
                     <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedCommunication
                                                                         nsprov:activity);
                     nsprov:category "starting-point";
                     nsprov:component "entities-activities";
                     nsprov:inverse "informed";
                     nsprov:qualifiedForm nsprov:qualifiedCommunication,
                                          nsprov:Communication.
nsprov:wasInvalidatedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain nsprov:Entity;
                        rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                         <http://www.w3.org/ns/prov-o#>;
                        rdfs:label "wasInvalidatedBy";
                        rdfs:range nsprov:Activity;
                        rdfs:subPropertyOf nsprov:wasInfluencedBy;
                        <http://www.w3.org/2002/07/owl#inverseOf> nsprov:invalidated;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedInvalidation
                                                                            nsprov:activity);
                        nsprov:category "expanded";
                        nsprov:component "entities-activities";
                        nsprov:inverse "invalidated";
                        nsprov:qualifiedForm nsprov:qualifiedInvalidation,
                                             nsprov:Invalidation.
nsprov:wasMemberOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                   rdfs:label "wasMemberOf";
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadMember.
nsprov:wasPlanOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                 rdfs:label "wasPlanOf";
                 <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadPlan.
nsprov:wasPrimarySourceOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                          rdfs:label "wasPrimarySourceOf";
                          <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadPrimarySource.
nsprov:wasQuotedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "An entity is derived from an original entity by copying, or 'quoting', some or all of it."@en;
                     rdfs:domain nsprov:Entity;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "wasQuotedFrom";
                     rdfs:range nsprov:Entity;
                     rdfs:subPropertyOf nsprov:wasDerivedFrom;
                     <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedQuotation
                                                                         nsprov:entity);
                     nsprov:category "expanded";
                     nsprov:component "derivations";
                     nsprov:inverse "quotedAs";
                     nsprov:qualifiedForm nsprov:qualifiedQuotation,
                                          nsprov:Quotation.
nsprov:wasRevisionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                       <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                     rdfs:comment "A revision is a derivation that revises an entity into a revised version."@en;
                     rdfs:domain nsprov:Entity;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "wasRevisionOf";
                     rdfs:range nsprov:Entity;
                     rdfs:subPropertyOf nsprov:wasDerivedFrom;
                     <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedRevision
                                                                         nsprov:entity);
                     nsprov:category "expanded";
                     nsprov:component "derivations";
                     nsprov:inverse "hadRevision";
                     nsprov:qualifiedForm nsprov:Revision,
                                          nsprov:qualifiedRevision.
nsprov:wasRoleIn rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                 rdfs:label "wasRoleIn";
                 <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadRole.
nsprov:wasStartedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Start is when an activity is deemed to have started. A start may refer to an entity, known as trigger, that initiated the activity."@en;
                    rdfs:domain nsprov:Activity;
                    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                    rdfs:label "wasStartedBy";
                    rdfs:range nsprov:Entity;
                    rdfs:subPropertyOf nsprov:wasInfluencedBy;
                    <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedStart
                                                                        nsprov:entity);
                    nsprov:category "expanded";
                    nsprov:component "entities-activities";
                    nsprov:inverse "started";
                    nsprov:qualifiedForm nsprov:qualifiedStart,
                                         nsprov:Start.
nsprov:wasUsedBy rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                 rdfs:label "wasUsedBy";
                 <http://www.w3.org/2002/07/owl#inverseOf> nsprov:used.
nsprov:wasUsedInDerivation rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                           rdfs:label "wasUsedInDerivation";
                           <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadUsage.
<http://www.w3.org/ns/prov-aq#> a <http://www.w3.org/2002/07/owl#Ontology>;
                                rdfs:comment "0.2",
                                             """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). 

If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."""@en;
                                rdfs:label "PROV Access and Query Ontology"@en;
                                rdfs:seeAlso nsprov:,
                                             <http://www.w3.org/TR/prov-aq/>;
                                <http://www.w3.org/2002/07/owl#versionIRI> <http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/>.
<http://www.w3.org/ns/prov-dc#> a <http://www.w3.org/2002/07/owl#Ontology>;
                                rdfs:comment """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). 

If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."""@en;
                                rdfs:label "Dublin Core extensions of the W3C PROVenance Interchange Ontology (PROV-O) "@en;
                                <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/prov-o#>.
<http://www.w3.org/ns/prov-dictionary#> a <http://www.w3.org/2002/07/owl#Ontology>;
                                        rdfs:comment """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). 

If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."""@en;
                                        rdfs:label "W3C PROVenance Interchange Ontology (PROV-O) Dictionary Extension"@en;
                                        rdfs:seeAlso <http://www.w3.org/TR/prov-dictionary/>,
                                                     <http://www.w3.org/ns/prov>.
<http://www.w3.org/ns/prov-links#> a <http://www.w3.org/2002/07/owl#Ontology>;
                                   rdfs:comment """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/
). All feedback is welcome."""@en;
                                   rdfs:label "W3C PROV Linking Across Provenance Bundles Ontology (PROV-LINKS)"@en;
                                   rdfs:seeAlso <http://www.w3.org/TR/prov-links/>,
                                                <http://www.w3.org/ns/prov>;
                                   <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/prov-o#>;
                                   <http://www.w3.org/2002/07/owl#versionIRI> <http://www.w3.org/ns/prov-links-20130430>;
                                   <http://www.w3.org/2002/07/owl#versionInfo> "Working Group Note version 2013-04-30"@en;
                                   nsprov:specializationOf <http://www.w3.org/ns/prov-links>.
<http://www.w3.org/ns/prov-o#> a <http://www.w3.org/2002/07/owl#Ontology>;
                               rdfs:comment """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page). 

If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/Archives/Public/public-prov-comments/). All feedback is welcome."""@en;
                               rdfs:label "W3C PROVenance Interchange Ontology (PROV-O)"@en;
                               rdfs:seeAlso <http://www.w3.org/TR/prov-o/>,
                                            <http://www.w3.org/ns/prov>;
                               <http://www.w3.org/2002/07/owl#versionIRI> <http://www.w3.org/ns/prov-o-20130430>;
                               <http://www.w3.org/2002/07/owl#versionInfo> "Recommendation version 2013-04-30"@en;
                               nsprov:specializationOf <http://www.w3.org/ns/prov-o>;
                               nsprov:wasRevisionOf <http://www.w3.org/ns/prov-o-20120312>.
