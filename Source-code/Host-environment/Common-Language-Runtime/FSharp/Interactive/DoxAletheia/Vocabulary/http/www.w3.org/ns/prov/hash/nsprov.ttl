nsprov:qualifiedUsingActivity rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                              rdfs:label "qualifiedUsingActivity";
                              <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedUsage.
nsprov:quotedAs rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                rdfs:label "quotedAs";
                <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasQuotedFrom.
nsprov:removedKey a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:domain nsprov:Removal;
                  rdfs:isDefinedBy nsprov:;
                  rdfs:label "removedKey";
                  rdfs:range rdfs:Literal;
                  nsprov:category "collections";
                  nsprov:component "collections";
                  nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
