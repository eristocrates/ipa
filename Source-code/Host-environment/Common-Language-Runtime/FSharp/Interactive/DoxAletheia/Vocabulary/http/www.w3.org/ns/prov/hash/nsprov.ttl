                          nsprov:inverse "qualifiedQuotationOf";
                          nsprov:sharesDefinitionWith nsprov:Quotation;
                          nsprov:unqualifiedForm nsprov:wasQuotedFrom.
nsprov:qualifiedQuotationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                            rdfs:label "qualifiedQuotationOf";
                            <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedQuotation.
nsprov:qualifiedRemoval a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain nsprov:Dictionary;
                        rdfs:isDefinedBy nsprov:;
                        rdfs:label "qualifiedRemoval";
