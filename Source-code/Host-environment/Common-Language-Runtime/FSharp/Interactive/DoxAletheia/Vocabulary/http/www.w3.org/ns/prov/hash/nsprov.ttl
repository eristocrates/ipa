nsprov:qualifiedCommunicationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                                rdfs:label "qualifiedCommunicationOf";
                                <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedCommunication.
nsprov:qualifiedDelegation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "If this Agent prov:actedOnBehalfOf Agent :ag, then it can qualify how with prov:qualifiedResponsibility [ a prov:Responsibility;  prov:agent :ag; :foo :bar ]."@en;
                           rdfs:domain nsprov:Agent;
                           rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
