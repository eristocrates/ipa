_:B24dbbb3edee6d5f8644a437029e62e97 a <http://www.w3.org/2002/07/owl#Axiom>;
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:range;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasInfluencedBy;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                                                                              nsprov:Agent
                                                                                                                              nsprov:Entity) ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Class>];
                                    nsprov:definition "influencer: an identifier (o1) for an ancestor entity, activity, or agent that the former depends on;";
                                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence".
_:B29b5d05bfc47623ced72ed1bab01e65e a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment """Revision is a derivation (see http://www.w3.org/TR/prov-dm/#term-Revision). Moreover, according to 
http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#term-Revision 23 April 2012 'wasRevisionOf is a strict sub-relation of wasDerivedFrom since two entities e2 and e1 may satisfy wasDerivedFrom(e2,e1) without being a variant of each other.'""";
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:subPropertyOf;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasRevisionOf;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:wasDerivedFrom.
_:B34a9b4621b0cc8eb5b6c8afdf45604b8 a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment "Derivation is a particular case of trace (see http://www.w3.org/TR/prov-dm/#term-trace), since it links an entity to another entity that contributed to its existence.";
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:subPropertyOf;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasDerivedFrom;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:wasInfluencedBy.
_:B4597274d38f20a768159c0679c42d5cb a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment "Attribution is a particular case of trace (see http://www.w3.org/TR/prov-dm/#concept-trace), in the sense that it links an entity to the agent that ascribed it.";
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:subPropertyOf;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasAttributedTo;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:wasInfluencedBy;
                                    nsprov:definition "IF wasAttributedTo(e2,ag1,aAttr) holds, THEN wasInfluencedBy(e2,ag1) also holds. ".
_:B53207ad1716ac721f59206ec28fb99fc a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment "hadPrimarySource property is a particular case of wasDerivedFrom (see http://www.w3.org/TR/prov-dm/#term-original-source) that aims to give credit to the source that originated some information.";
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:subPropertyOf;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:hadPrimarySource;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:wasDerivedFrom.
_:Bb0110b018d6f6edf3c4695a0da17e97c a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en;
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:range;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:hadMember;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:Entity;
                                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection".
_:Beae3a195dd543b28cc1dfd8407588605 a <http://www.w3.org/2002/07/owl#Axiom>;
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:domain;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasInfluencedBy;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                                                                              nsprov:Agent
                                                                                                                              nsprov:Entity) ; 
                                                                                     a <http://www.w3.org/2002/07/owl#Class>];
                                    nsprov:definition "influencee: an identifier (o2) for an entity, activity, or agent; ";
                                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence".
_:Bfb3c2eb440a160f47acda2dc4d89e090 a <http://www.w3.org/2002/07/owl#Axiom>;
                                    rdfs:comment """Quotation is a particular case of derivation (see http://www.w3.org/TR/prov-dm/#term-quotation) in which an entity is derived from an original entity by copying, or \"quoting\", some or all of it. """;
                                    <http://www.w3.org/2002/07/owl#annotatedProperty> rdfs:subPropertyOf;
                                    <http://www.w3.org/2002/07/owl#annotatedSource> nsprov:wasQuotedFrom;
                                    <http://www.w3.org/2002/07/owl#annotatedTarget> nsprov:wasDerivedFrom.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment ""@en;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                              nsprov:.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
           rdfs:comment ""@en;
           rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                            nsprov:.
rdfs:seeAlso a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment ""@en.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#topObjectProperty> a <http://www.w3.org/2002/07/owl#ObjectProperty>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
nsprov: a <http://www.w3.org/2002/07/owl#Ontology>;
        rdfs:comment """This document is published by the Provenance Working Group (http://www.w3.org/2011/prov/wiki/Main_Page).

If you wish to make comments regarding this document, please send them to public-prov-comments@w3.org (subscribe public-prov-comments-request@w3.org, archives http://lists.w3.org/
Archives/Public/public-prov-comments/). All feedback is welcome."""@en;
        rdfs:isDefinedBy <http://www.w3.org/ns/prov>;
        rdfs:label "W3C PROVenance Interchange"@en;
        rdfs:seeAlso <http://www.w3.org/TR/prov-o/#names-of-inverse-properties>,
                     <http://www.w3.org/TR/prov-overview/>;
        <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/ns/prov-dictionary#>,
                                                <http://www.w3.org/ns/prov-o#>,
                                                <http://www.w3.org/ns/prov-dc#>,
                                                <http://www.w3.org/ns/prov-links#>,
                                                <http://www.w3.org/ns/prov-o-inverses#>,
                                                <http://www.w3.org/ns/prov-aq#>;
        <http://www.w3.org/2002/07/owl#versionIRI> <http://www.w3.org/ns/prov-20130430>,
                                                   <http://www.w3.org/ns/prov-o-inverses-20130430>;
        nsprov:specializationOf <http://www.w3.org/ns/prov-o-inverses>;
        nsprov:wasDerivedFrom <http://www.w3.org/ns/prov-dictionary#>,
                              <http://www.w3.org/ns/prov-links#>,
                              <http://www.w3.org/ns/prov-aq#>,
                              <http://www.w3.org/ns/prov-dc#>,
                              <http://www.w3.org/ns/prov-o-inverses#>,
                              <http://www.w3.org/ns/prov-o-20130430>,
                              <http://www.w3.org/ns/prov-o#>;
        nsprov:wasRevisionOf <http://www.w3.org/ns/prov-20130312>,
                             <http://www.w3.org/ns/prov-o-inverses-20120312>.
nsprov:Accept a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Accept"@en;
              rdfs:subClassOf nsprov:Activity;
              nsprov:definition "Activity that identifies the acceptance of a resource (e.g., an article in a conference)"@en.
nsprov:Activity a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                rdfs:label "Activity";
                <http://www.w3.org/2002/07/owl#disjointWith> nsprov:Entity;
                nsprov:category "starting-point";
                nsprov:component "entities-activities";
                nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                nsprov:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities.";
                nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Activity"^^xsd:anyURI;
                nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Activity"^^xsd:anyURI.
nsprov:ActivityInfluence a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "It is not recommended that the type ActivityInfluence be asserted without also asserting one of its more specific subclasses."@en,
                                      "ActivityInfluence provides additional descriptions of an Activity's binary influence upon any other kind of resource. Instances of ActivityInfluence use the prov:activity property to cite the influencing Activity."@en;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                         rdfs:label "ActivityInfluence";
                         rdfs:seeAlso nsprov:activity;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> nsprov:hadActivity ; 
                                          <http://www.w3.org/2002/07/owl#maxCardinality> "0"^^xsd:nonNegativeInteger ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         nsprov:Influence;
                         <http://www.w3.org/2002/07/owl#disjointWith> nsprov:EntityInfluence;
                         nsprov:category "qualified";
                         nsprov:editorsDefinition "ActivitiyInfluence is the capacity of an activity to have an effect on the character, development, or behavior of another by means of generation, invalidation, communication, or other."@en.
nsprov:Agent a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "Agent";
             <http://www.w3.org/2002/07/owl#disjointWith> nsprov:InstantaneousEvent;
             nsprov:category "starting-point";
             nsprov:component "agents-responsibility";
             nsprov:definition "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity. "@en;
             nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
             nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Agent"^^xsd:anyURI.
nsprov:AgentInfluence a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "AgentInfluence provides additional descriptions of an Agent's binary influence upon any other kind of resource. Instances of AgentInfluence use the prov:agent property to cite the influencing Agent."@en,
                                   "It is not recommended that the type AgentInfluence be asserted without also asserting one of its more specific subclasses."@en;
                      rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                      rdfs:label "AgentInfluence";
                      rdfs:seeAlso nsprov:agent;
                      rdfs:subClassOf nsprov:Influence;
                      nsprov:category "qualified";
                      nsprov:editorsDefinition "AgentInfluence is the capacity of an agent to have an effect on the character, development, or behavior of another by means of attribution, association, delegation, or other."@en.
nsprov:Association a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedAssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "Association";
                   rdfs:subClassOf nsprov:AgentInfluence;
                   nsprov:category "qualified";
                   nsprov:component "agents-responsibility";
                   nsprov:definition "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity. It further allows for a plan to be specified, which is the plan intended by the agent to achieve some goals in the context of this activity."@en;
                   nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI;
                   nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI;
                   nsprov:unqualifiedForm nsprov:wasAssociatedWith.
nsprov:Attribution a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An instance of prov:Attribution provides additional descriptions about the binary prov:wasAttributedTo relation from an prov:Entity to some prov:Agent that had some responsible for it. For example, :cake prov:wasAttributedTo :baker; prov:qualifiedAttribution [ a prov:Attribution; prov:entity :baker; :foo :bar ]."@en;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "Attribution";
                   rdfs:subClassOf nsprov:AgentInfluence;
                   nsprov:category "qualified";
                   nsprov:component "agents-responsibility";
                   nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                   nsprov:definition """Attribution is the ascribing of an entity to an agent.

When an entity e is attributed to agent ag, entity e was generated by some unspecified activity that in turn was associated to agent ag. Thus, this relation is useful when the activity is not known, or irrelevant."""@en;
                   nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribution"^^xsd:anyURI;
                   nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribution"^^xsd:anyURI;
                   nsprov:unqualifiedForm nsprov:wasAttributedTo.
nsprov:Bundle a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Note that there are kinds of bundles (e.g. handwritten letters, audio recordings, etc.) that are not expressed in PROV-O, but can be still be described by PROV-O."@en;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "Bundle";
              rdfs:subClassOf nsprov:Entity;
              nsprov:category "expanded";
              nsprov:definition "A bundle is a named set of provenance descriptions, and is itself an Entity, so allowing provenance of provenance to be expressed."@en;
              nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-bundle-entity"^^xsd:anyURI;
              nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-bundle-declaration"^^xsd:anyURI.
nsprov:Collection a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "Collection";
                  rdfs:subClassOf nsprov:Entity;
                  nsprov:category "expanded";
                  nsprov:component "collections";
                  nsprov:definition "A collection is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the collections."@en;
                  nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-collection"^^xsd:anyURI.
nsprov:Communication a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An instance of prov:Communication provides additional descriptions about the binary prov:wasInformedBy relation from an informed prov:Activity to the prov:Activity that informed it. For example, :you_jumping_off_bridge prov:wasInformedBy :everyone_else_jumping_off_bridge; prov:qualifiedCommunication [ a prov:Communication; prov:activity :everyone_else_jumping_off_bridge; :foo :bar ]."@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "Communication";
                     rdfs:subClassOf nsprov:ActivityInfluence;
                     nsprov:category "qualified";
                     nsprov:component "entities-activities";
                     nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                     nsprov:definition "Communication is the exchange of an entity by two activities, one activity using the entity generated by the other.";
                     nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Communication"^^xsd:anyURI;
                     nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-wasInformedBy"^^xsd:anyURI;
                     nsprov:unqualifiedForm nsprov:wasInformedBy.
nsprov:Contribute a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label """Contribute
"""@en;
                  rdfs:subClassOf nsprov:Activity;
                  nsprov:definition "Activity that identifies any contribution of an agent to a resource. "@en.
nsprov:Contributor a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Contributor"@en;
                   rdfs:subClassOf nsprov:Role;
                   nsprov:definition "Role with the function of having responsibility for making contributions to a resource. The Agent assigned to this role is associated with a Modify or Create Activities"@en.
nsprov:Copyright a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Copyright"@en;
                 rdfs:subClassOf nsprov:Activity;
                 nsprov:definition "Activity that identifies the Copyrighting activity associated to a resource."@en.
nsprov:Create a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Create"@en;
              rdfs:subClassOf nsprov:Contribute;
              nsprov:definition "Activity that identifies the creation of a resource"@en.
nsprov:Creator a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Creator"@en;
               rdfs:subClassOf nsprov:Contributor;
               nsprov:definition "Role with the function of creating a resource. The Agent assigned to this role is associated with a Create Activity"@en.
nsprov:Delegation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An instance of prov:Delegation provides additional descriptions about the binary prov:actedOnBehalfOf relation from a performing prov:Agent to some prov:Agent for whom it was performed. For example, :mixing prov:wasAssociatedWith :toddler . :toddler prov:actedOnBehalfOf :mother; prov:qualifiedDelegation [ a prov:Delegation; prov:entity :mother; :foo :bar ]."@en;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "Delegation";
                  rdfs:subClassOf nsprov:AgentInfluence;
                  nsprov:category "qualified";
                  nsprov:component "agents-responsibility";
                  nsprov:definition """Delegation is the assignment of authority and responsibility to an agent (by itself or by another agent) to carry out a specific activity as a delegate or representative, while the agent it acts on behalf of retains some responsibility for the outcome of the delegated work.

For example, a student acted on behalf of his supervisor, who acted on behalf of the department chair, who acted on behalf of the university; all those agents are responsible in some way for the activity that took place but we do not say explicitly who bears responsibility and to what degree."""@en;
                  nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-delegation"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-delegation"^^xsd:anyURI;
                  nsprov:unqualifiedForm nsprov:actedOnBehalfOf.
nsprov:Derivation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An instance of prov:Derivation provides additional descriptions about the binary prov:wasDerivedFrom relation from some derived prov:Entity to another prov:Entity from which it was derived. For example, :chewed_bubble_gum prov:wasDerivedFrom :unwrapped_bubble_gum; prov:qualifiedDerivation [ a prov:Derivation; prov:entity :unwrapped_bubble_gum; :foo :bar ]."@en,
                               "The more specific forms of prov:Derivation (i.e., prov:Revision, prov:Quotation, prov:PrimarySource) should be asserted if they apply."@en;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "Derivation";
                  rdfs:subClassOf nsprov:EntityInfluence;
                  nsprov:category "qualified";
                  nsprov:component "derivations";
                  nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                  nsprov:definition "A derivation is a transformation of an entity into another, an update of an entity resulting in a new one, or the construction of a new entity based on a pre-existing entity."@en;
                  nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Derivation"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#Derivation-Relation"^^xsd:anyURI;
                  nsprov:unqualifiedForm nsprov:wasDerivedFrom.
nsprov:Dictionary a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This concept allows for the provenance of the dictionary, but also of its constituents to be expressed. Such a notion of dictionary corresponds to a wide variety of concrete data structures, such as a maps or associative arrays.",
                               "A given dictionary forms a given structure for its members. A different structure (obtained either by insertion or removal of members) constitutes a different dictionary.";
                  rdfs:isDefinedBy nsprov:;
                  rdfs:label "Dictionary";
                  nsprov:category "collections";
                  nsprov:component "collections";
                  nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                  nsprov:definition "A dictionary is an entity that provides a structure to some constituents, which are themselves entities. These constituents are said to be member of the dictionary.";
                  nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI.
nsprov:DirectQueryService a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments.";
                          rdfs:isDefinedBy nsprov:;
                          rdfs:label "ProvenanceService";
                          rdfs:subClassOf nsprov:SoftwareAgent;
                          nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI;
                          nsprov:category "access-and-query".
nsprov:EmptyCollection a <http://www.w3.org/2002/07/owl#Class>,
                         <http://www.w3.org/2002/07/owl#NamedIndividual>;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "EmptyCollection"@en;
                       rdfs:subClassOf nsprov:Collection;
                       nsprov:category "expanded";
                       nsprov:component "collections";
                       nsprov:definition "An empty collection is a collection without members."@en.
nsprov:EmptyDictionary a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy nsprov:;
                       rdfs:label "Empty Dictionary";
                       rdfs:subClassOf nsprov:Dictionary,
                                       nsprov:EmptyCollection;
                       nsprov:category "collections";
                       nsprov:component "collections";
                       nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                       nsprov:definition "An empty dictionary (i.e. has no members).";
                       nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-conceptual-definition"^^xsd:anyURI;
                       nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary"^^xsd:anyURI.
nsprov:End a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "An instance of prov:End provides additional descriptions about the binary prov:wasEndedBy relation from some ended prov:Activity to an prov:Entity that ended it. For example, :ball_game prov:wasEndedBy :buzzer; prov:qualifiedEnd [ a prov:End; prov:entity :buzzer; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ]."@en;
           rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
           rdfs:label "End";
           rdfs:subClassOf nsprov:EntityInfluence,
                           nsprov:InstantaneousEvent;
           nsprov:category "qualified";
           nsprov:component "entities-activities";
           nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
           nsprov:definition "End is when an activity is deemed to have been ended by an entity, known as trigger. The activity no longer exists after its end. Any usage, generation, or invalidation involving an activity precedes the activity's end. An end may refer to a trigger entity that terminated the activity, or to an activity, known as ender that generated the trigger."@en;
           nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-End"^^xsd:anyURI;
           nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-End"^^xsd:anyURI;
           nsprov:unqualifiedForm nsprov:wasEndedBy.
nsprov:Entity a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "Entity";
              <http://www.w3.org/2002/07/owl#disjointWith> nsprov:InstantaneousEvent;
              nsprov:category "starting-point";
              nsprov:component "entities-activities";
              nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
              nsprov:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary. "@en;
              nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-entity"^^xsd:anyURI;
              nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Entity"^^xsd:anyURI.
nsprov:EntityInfluence a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "EntityInfluence provides additional descriptions of an Entity's binary influence upon any other kind of resource. Instances of EntityInfluence use the prov:entity property to cite the influencing Entity."@en,
                                    "It is not recommended that the type EntityInfluence be asserted without also asserting one of its more specific subclasses."@en;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "EntityInfluence";
                       rdfs:seeAlso nsprov:entity;
                       rdfs:subClassOf nsprov:Influence;
                       nsprov:category "qualified";
                       nsprov:editorsDefinition "EntityInfluence is the capacity of an entity to have an effect on the character, development, or behavior of another by means of usage, start, end, derivation, or other. "@en.
nsprov:Generation a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An instance of prov:Generation provides additional descriptions about the binary prov:wasGeneratedBy relation from a generated prov:Entity to the prov:Activity that generated it. For example, :cake prov:wasGeneratedBy :baking; prov:qualifiedGeneration [ a prov:Generation; prov:activity :baking; :foo :bar ]."@en;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "Generation";
                  rdfs:subClassOf nsprov:ActivityInfluence,
                                  nsprov:InstantaneousEvent;
                  nsprov:category "qualified";
                  nsprov:component "entities-activities";
                  nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                  nsprov:definition "Generation is the completion of production of a new entity by an activity. This entity did not exist before generation and becomes available for usage after this generation."@en;
                  nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Generation"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Generation"^^xsd:anyURI;
                  nsprov:unqualifiedForm nsprov:wasGeneratedBy.
nsprov:Influence a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An instance of prov:Influence provides additional descriptions about the binary prov:wasInfluencedBy relation from some influenced Activity, Entity, or Agent to the influencing Activity, Entity, or Agent. For example, :stomach_ache prov:wasInfluencedBy :spoon; prov:qualifiedInfluence [ a prov:Influence; prov:entity :spoon; :foo :bar ] . Because prov:Influence is a broad relation, the more specific relations (Communication, Delegation, End, etc.) should be used when applicable."@en,
                              "Because prov:Influence is a broad relation, its most specific subclasses (e.g. prov:Communication, prov:Delegation, prov:End, prov:Revision, etc.) should be used when applicable."@en;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                 rdfs:label "Influence";
                 nsprov:category "qualified";
                 nsprov:component "derivations";
                 nsprov:definition "Influence is the capacity of an entity, activity, or agent to have an effect on the character, development, or behavior of another by means of usage, start, end, generation, invalidation, communication, derivation, attribution, association, or delegation."@en;
                 nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"^^xsd:anyURI;
                 nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-influence"^^xsd:anyURI;
                 nsprov:unqualifiedForm nsprov:wasInfluencedBy.
nsprov:Insertion a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy nsprov:;
                 rdfs:label "Insertion";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> nsprov:insertedKeyEntityPair ; 
                                  <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:int ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> nsprov:dictionary ; 
                                  <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 nsprov:Derivation;
                 nsprov:category "collections";
                 nsprov:component "collections";
                 nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                 nsprov:definition "Insertion is a derivation that transforms a dictionary into another, by insertion of one or more key-entity pairs.";
                 nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
                 nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI;
                 nsprov:unqualifiedForm nsprov:derivedByInsertionFrom.
nsprov:InstantaneousEvent a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "An instantaneous event, or event for short, happens in the world and marks a change in the world, in its activities and in its entities. The term 'event' is commonly used in process algebra with a similar meaning. Events represent communications or interactions; they are assumed to be atomic and instantaneous."@en;
                          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                          rdfs:label "InstantaneousEvent";
                          nsprov:category "qualified";
                          nsprov:component "entities-activities";
                          nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#dfn-event"^^xsd:anyURI;
                          nsprov:definition "The PROV data model is implicitly based on a notion of instantaneous events (or just events), that mark transitions in the world. Events include generation, usage, or invalidation of entities, as well as starting or ending of activities. This notion of event is not first-class in the data model, but it is useful for explaining its other concepts and its semantics."@en.
nsprov:Invalidation a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An instance of prov:Invalidation provides additional descriptions about the binary prov:wasInvalidatedBy relation from an invalidated prov:Entity to the prov:Activity that invalidated it. For example, :uncracked_egg prov:wasInvalidatedBy :baking; prov:qualifiedInvalidation [ a prov:Invalidation; prov:activity :baking; :foo :bar ]."@en;
                    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                    rdfs:label "Invalidation";
                    rdfs:subClassOf nsprov:ActivityInfluence,
                                    nsprov:InstantaneousEvent;
                    nsprov:category "qualified";
                    nsprov:component "entities-activities";
                    nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                    nsprov:definition "Invalidation is the start of the destruction, cessation, or expiry of an existing entity by an activity. The entity is no longer available for use (or further invalidation) after invalidation. Any generation or usage of an entity precedes its invalidation.";
                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Invalidation"^^xsd:anyURI;
                    nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Invalidation"^^xsd:anyURI;
                    nsprov:unqualifiedForm nsprov:wasInvalidatedBy.
nsprov:KeyEntityPair a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy nsprov:;
                     rdfs:label "Key-Entity Pair";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> nsprov:pairKey ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     [<http://www.w3.org/2002/07/owl#onProperty> nsprov:pairEntity ; 
                                      <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     nsprov:category "collections";
                     nsprov:component "collections";
                     nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                     nsprov:definition "A key-entity pair. Part of a prov:Dictionary through prov:hadDictionaryMember. The key is any RDF Literal, the value is a prov:Entity.";
                     nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
                     nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI.
nsprov:Location a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                rdfs:label "Location";
                rdfs:seeAlso nsprov:atLocation;
                nsprov:category "expanded";
                nsprov:definition "A location can be an identifiable geographic place (ISO 19112), but it can also be a non-geographic place such as a directory, row, or column. As such, there are numerous ways in which location can be expressed, such as by a coordinate, address, landmark, and so forth."@en;
                nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-location"^^xsd:anyURI;
                nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI.
nsprov:Modify a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Modify"@en;
              rdfs:subClassOf nsprov:Activity;
              nsprov:definition "Activity that identifies the modification of a resource. "@en.
nsprov:Organization a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                    rdfs:label "Organization";
                    rdfs:subClassOf nsprov:Agent;
                    nsprov:category "expanded";
                    nsprov:component "agents-responsibility";
                    nsprov:definition "An organization is a social or legal institution such as a company, society, etc.";
                    nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
                    nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI.
nsprov:Person a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "Person";
              rdfs:subClassOf nsprov:Agent;
              nsprov:category "expanded";
              nsprov:component "agents-responsibility";
              nsprov:definition "Person agents are people."@en;
              nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI;
              nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI.
nsprov:Plan a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "There exist no prescriptive requirement on the nature of plans, their representation, the actions or steps they consist of, or their intended goals. Since plans may evolve over time, it may become necessary to track their provenance, so plans themselves are entities. Representing the plan explicitly in the provenance can be useful for various tasks: for example, to validate the execution as represented in the provenance record, to manage expectation failures, or to provide explanations."@en;
            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
            rdfs:label "Plan";
            rdfs:subClassOf nsprov:Entity;
            nsprov:category "expanded",
                            "qualified";
            nsprov:component "agents-responsibility";
            nsprov:definition "A plan is an entity that represents a set of actions or steps intended by one or more agents to achieve some goals.";
            nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Association"^^xsd:anyURI;
            nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Association"^^xsd:anyURI.
nsprov:PrimarySource a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "An instance of prov:PrimarySource provides additional descriptions about the binary prov:hadPrimarySource relation from some secondary prov:Entity to an earlier, primary prov:Entity. For example, :blog prov:hadPrimarySource :newsArticle; prov:qualifiedPrimarySource [ a prov:PrimarySource; prov:entity :newsArticle; :foo :bar ] ."@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "PrimarySource";
                     rdfs:subClassOf nsprov:Derivation;
                     nsprov:category "qualified";
                     nsprov:component "derivations";
                     nsprov:definition """A primary source for a topic refers to something produced by some agent with direct experience and knowledge about the topic, at the time of the topic's study, without benefit from hindsight.

Because of the directness of primary sources, they 'speak for themselves' in ways that cannot be captured through the filter of secondary sources. As such, it is important for secondary sources to reference those primary sources from which they were derived, so that their reliability can be investigated.

A primary source relation is a particular case of derivation of secondary materials from their primary sources. It is recognized that the determination of primary sources can be up to interpretation, and should be done according to conventions accepted within the application's domain."""@en;
                     nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-primary-source"^^xsd:anyURI;
                     nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-original-source"^^xsd:anyURI;
                     nsprov:unqualifiedForm nsprov:hadPrimarySource.
nsprov:Publish a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Publish"@en;
               rdfs:subClassOf nsprov:Activity;
               nsprov:definition "Activity that identifies the publication of a resource"@en.
nsprov:Publisher a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "Publisher"@en;
                 rdfs:subClassOf nsprov:Role;
                 nsprov:definition "Role with the function of publishing a resource. The Agent assigned to this role is associated with a Publish Activity"@en.
nsprov:Quotation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An instance of prov:Quotation provides additional descriptions about the binary prov:wasQuotedFrom relation from some taken prov:Entity from an earlier, larger prov:Entity. For example, :here_is_looking_at_you_kid prov:wasQuotedFrom :casablanca_script; prov:qualifiedQuotation [ a prov:Quotation; prov:entity :casablanca_script; :foo :bar ]."@en;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                 rdfs:label "Quotation";
                 rdfs:subClassOf nsprov:Derivation;
                 nsprov:category "qualified";
                 nsprov:component "derivations";
                 nsprov:definition "A quotation is the repeat of (some or all of) an entity, such as text or image, by someone who may or may not be its original author. Quotation is a particular case of derivation."@en;
                 nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-quotation"^^xsd:anyURI;
                 nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-quotation"^^xsd:anyURI;
                 nsprov:unqualifiedForm nsprov:wasQuotedFrom.
nsprov:Removal a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy nsprov:;
               rdfs:label "Removal";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> nsprov:removedKey ; 
                                <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:int ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               nsprov:Derivation,
                               [<http://www.w3.org/2002/07/owl#onProperty> nsprov:dictionary ; 
                                <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>];
               nsprov:category "collections";
               nsprov:component "collections";
               nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
               nsprov:definition "Removal is a derivation that transforms a dictionary into another, by removing one or more key-entity pairs.";
               nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
               nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI;
               nsprov:unqualifiedForm nsprov:derivedByRemovalFrom.
nsprov:Replace a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Replace"@en;
               rdfs:subClassOf nsprov:Activity;
               nsprov:definition "Activity that identifies the replacement of a resource."@en.
nsprov:Revision a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "An instance of prov:Revision provides additional descriptions about the binary prov:wasRevisionOf relation from some newer prov:Entity to an earlier prov:Entity. For example, :draft_2 prov:wasRevisionOf :draft_1; prov:qualifiedRevision [ a prov:Revision; prov:entity :draft_1; :foo :bar ]."@en;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                rdfs:label "Revision";
                rdfs:subClassOf nsprov:Derivation;
                nsprov:category "qualified";
                nsprov:component "derivations";
                nsprov:definition "A revision is a derivation for which the resulting entity is a revised version of some original. The implication here is that the resulting entity contains substantial content from the original. Revision is a particular case of derivation."@en;
                nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-revision"^^xsd:anyURI;
                nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Revision"^^xsd:anyURI;
                nsprov:unqualifiedForm nsprov:wasRevisionOf.
nsprov:RightsAssignment a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "RightsAssignment"@en;
                        rdfs:subClassOf nsprov:Activity;
                        nsprov:definition "Activity that identifies the rights assignment of a resource."@en.
nsprov:RightsHolder a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "RightsHolder"@en;
                    rdfs:subClassOf nsprov:Role;
                    nsprov:definition "Role with the function of owning or managing rights over a resource. The Agent assigned to this role is associated with a RightsAssignment Activity"@en.
nsprov:Role a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
            rdfs:label "Role";
            rdfs:seeAlso nsprov:hadRole;
            nsprov:category "qualified";
            nsprov:component "agents-responsibility";
            nsprov:definition "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en;
            nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-attribute-role"^^xsd:anyURI;
            nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-attribute"^^xsd:anyURI.
nsprov:ServiceDescription a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Type for a generic provenance query service. Mainly for use in RDF provenance query service descriptions, to facilitate discovery in linked data environments.";
                          rdfs:isDefinedBy nsprov:;
                          rdfs:label "ServiceDescription";
                          rdfs:subClassOf nsprov:SoftwareAgent;
                          nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-query-service-discovery"^^xsd:anyURI;
                          nsprov:category "access-and-query".
nsprov:SoftwareAgent a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                      nsprov:;
                     rdfs:label "SoftwareAgent";
                     rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                                     nsprov:Agent;
                     nsprov:category "expanded";
                     nsprov:component "agents-responsibility";
                     nsprov:definition "A software agent is running software."@en;
                     nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-agent"^^xsd:anyURI,
                               "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-dm.html#term-agent"^^xsd:anyURI;
                     nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-types"^^xsd:anyURI,
                              "http://www.w3.org/TR/2012/WD-prov-dm-20120703/prov-n.html#expression-types"^^xsd:anyURI.
nsprov:Start a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An instance of prov:Start provides additional descriptions about the binary prov:wasStartedBy relation from some started prov:Activity to an prov:Entity that started it. For example, :foot_race prov:wasStartedBy :bang; prov:qualifiedStart [ a prov:Start; prov:entity :bang; :foo :bar; prov:atTime '2012-03-09T08:05:08-05:00'^^xsd:dateTime ] ."@en;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "Start";
             rdfs:subClassOf nsprov:EntityInfluence,
                             nsprov:InstantaneousEvent;
             nsprov:category "qualified";
             nsprov:component "entities-activities";
             nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
             nsprov:definition "Start is when an activity is deemed to have been started by an entity, known as trigger. The activity did not exist before its start. Any usage, generation, or invalidation involving an activity follows the activity's start. A start may refer to a trigger entity that set off the activity, or to an activity, known as starter, that generated the trigger."@en;
             nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Start"^^xsd:anyURI;
             nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Start"^^xsd:anyURI;
             nsprov:unqualifiedForm nsprov:wasStartedBy.
nsprov:Submit a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "Submit"@en;
              rdfs:subClassOf nsprov:Activity;
              nsprov:definition "Activity that identifies the issuance (e.g., publication) of a resource. "@en.
nsprov:Usage a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An instance of prov:Usage provides additional descriptions about the binary prov:used relation from some prov:Activity to an prov:Entity that it used. For example, :keynote prov:used :podium; prov:qualifiedUsage [ a prov:Usage; prov:entity :podium; :foo :bar ]."@en;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "Usage";
             rdfs:subClassOf nsprov:InstantaneousEvent,
                             nsprov:EntityInfluence;
             nsprov:category "qualified";
             nsprov:component "entities-activities";
             nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
             nsprov:definition "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity."@en;
             nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-Usage"^^xsd:anyURI;
             nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-Usage"^^xsd:anyURI;
             nsprov:unqualifiedForm nsprov:used.
nsprov:actedOnBehalfOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "An object property to express the accountability of an agent towards another agent. The subordinate agent acted on behalf of the responsible agent in an actual activity. "@en;
                       rdfs:domain nsprov:Agent;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "actedOnBehalfOf";
                       rdfs:range nsprov:Agent;
                       rdfs:subPropertyOf nsprov:wasInfluencedBy;
                       <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedDelegation
                                                                           nsprov:agent);
                       nsprov:category "starting-point";
                       nsprov:component "agents-responsibility";
                       nsprov:inverse "hadDelegate";
                       nsprov:qualifiedForm nsprov:qualifiedDelegation,
                                            nsprov:Delegation.
nsprov:activity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain nsprov:ActivityInfluence;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                rdfs:label "activity";
                rdfs:range nsprov:Activity;
                rdfs:subPropertyOf nsprov:influencer;
                nsprov:category "qualified";
                nsprov:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
                nsprov:editorsDefinition "The prov:activity property references an prov:Activity which influenced a resource. This property applies to an prov:ActivityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.";
                nsprov:inverse "activityOfInfluence".
nsprov:activityOfInfluence rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                           rdfs:label "activityOfInfluence";
                           <http://www.w3.org/2002/07/owl#inverseOf> nsprov:activity.
nsprov:agent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain nsprov:AgentInfluence;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
             rdfs:label "agent";
             rdfs:range nsprov:Agent;
             rdfs:subPropertyOf nsprov:influencer;
             nsprov:category "qualified";
             nsprov:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
             nsprov:editorsDefinition "The prov:agent property references an prov:Agent which influenced a resource. This property applies to an prov:AgentInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent."@en;
             nsprov:inverse "agentOfInfluence".
nsprov:agentOfInfluence rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                        rdfs:label "agentOfInfluence";
                        <http://www.w3.org/2002/07/owl#inverseOf> nsprov:agent.
nsprov:alternateOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain nsprov:Entity;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                    <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "alternateOf";
                   rdfs:range nsprov:Entity;
                   rdfs:seeAlso nsprov:specializationOf;
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:alternateOf;
                   nsprov:category "expanded";
                   nsprov:component "alternate";
                   nsprov:constraints "http://www.w3.org/TR/2013/REC-prov-constraints-20130430/#prov-dm-constraints-fig"^^xsd:anyURI;
                   nsprov:definition "Two alternate entities present aspects of the same thing. These aspects may be the same or different, and the alternate entities may or may not overlap in time."@en;
                   nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-alternate"^^xsd:anyURI;
                   nsprov:inverse "alternateOf";
                   nsprov:n "http://www.w3.org/TR/2013/REC-prov-n-20130430/#expression-alternate"^^xsd:anyURI.
nsprov:aq a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                           nsprov:;
          rdfs:subPropertyOf rdfs:seeAlso.
nsprov:asInBundle a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment """prov:asInBundle is used to specify which bundle the general entity of a prov:mentionOf property is described.

When :x prov:mentionOf :y and :y is described in Bundle :b, the triple :x prov:asInBundle :b is also asserted to cite the Bundle in which :y was described."""@en;
                  rdfs:domain nsprov:Entity;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-links#>;
                  rdfs:label "asInBundle";
                  rdfs:range nsprov:Bundle;
                  nsprov:inverse "contextOf";
                  nsprov:sharesDefinitionWith nsprov:mentionOf.
nsprov:atLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The Location of any resource."@en,
                               """This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.""";
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Activity
                                                                        nsprov:Agent
                                                                        nsprov:Entity
                                                                        nsprov:InstantaneousEvent) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "atLocation";
                  rdfs:range nsprov:Location;
                  nsprov:category "expanded";
                  nsprov:editorialNote "This property is not functional because the many values could be at a variety of granularies (In this building, in this room, in that chair)."@en,
                                       "The naming of prov:atLocation parallels prov:atTime, and is not named prov:hadLocation to avoid conflicting with the convention that prov:had* properties are used on prov:Influence classes."@en;
                  nsprov:inverse "locationOf";
                  nsprov:sharesDefinitionWith nsprov:Location.
nsprov:atTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "The time at which an InstantaneousEvent occurred, in the form of xsd:dateTime."@en;
              rdfs:domain nsprov:InstantaneousEvent;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "atTime";
              rdfs:range xsd:dateTime;
              nsprov:category "qualified";
              nsprov:component "entities-activities";
              nsprov:sharesDefinitionWith nsprov:InstantaneousEvent;
              nsprov:unqualifiedForm nsprov:invalidatedAtTime,
                                     nsprov:startedAtTime,
                                     nsprov:generatedAtTime,
                                     nsprov:endedAtTime.
nsprov:category a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                rdfs:comment "Classify prov-o terms into three categories, including 'starting-point', 'qualifed', and 'extended'. This classification is used by the prov-o html document to gently introduce prov-o terms to its users. "@en;
                rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                 nsprov:.
nsprov:component a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                 rdfs:comment "Classify prov-o terms into six components according to prov-dm, including 'agents-responsibility', 'alternate', 'annotations', 'collections', 'derivations', and 'entities-activities'. This classification is used so that readers of prov-o specification can find its correspondence with the prov-dm specification."@en;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                  nsprov:.
nsprov:constraints a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                   rdfs:comment "A reference to the principal section of the PROV-CONSTRAINTS document that describes this concept."@en;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                    nsprov:;
                   rdfs:subPropertyOf rdfs:seeAlso.
nsprov:contributed rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                   rdfs:label "contributed";
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasAttributedTo.
nsprov:definition a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                  rdfs:comment "A definition quoted from PROV-DM or PROV-CONSTRAINTS that describes the concept expressed with this OWL term."@en;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                   nsprov:.
nsprov:derivedByInsertionFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:domain nsprov:Dictionary;
                              rdfs:isDefinedBy nsprov:;
                              rdfs:label "derivedByInsertionFrom";
                              rdfs:range nsprov:Dictionary;
                              rdfs:subPropertyOf nsprov:wasDerivedFrom;
                              nsprov:category "collections";
                              nsprov:component "collections";
                              nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                              nsprov:definition "The dictionary was derived from the other by insertion. prov:qualifiedInsertion shows details of the insertion, in particular the inserted key-entity pairs.";
                              nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
                              nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI.
nsprov:derivedByRemovalFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:domain nsprov:Dictionary;
                            rdfs:isDefinedBy nsprov:;
                            rdfs:label "derivedByRemovalFrom";
                            rdfs:range nsprov:Dictionary;
                            rdfs:subPropertyOf nsprov:wasDerivedFrom;
                            nsprov:category "collections";
                            nsprov:component "collections";
                            nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                            nsprov:definition "The dictionary was derived from the other by removal. prov:qualifiedRemoval shows details of the removal, in particular the removed key-entity pairs.";
                            nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI;
                            nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI.
nsprov:describesService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "relates a generic provenance query service resource (type prov:ServiceDescription) to a specific query service description (e.g. a prov:DirectQueryService or a sd:Service)."@en;
                        rdfs:isDefinedBy nsprov:;
                        rdfs:label "describesService";
                        nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/rovenance-query-service-description"^^xsd:anyURI;
                        nsprov:category "access-and-query";
                        nsprov:inverse "serviceDescribedBy".
nsprov:dictionary a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain nsprov:Insertion,
                              nsprov:Removal;
                  rdfs:isDefinedBy nsprov:;
                  rdfs:label "dictionary";
                  rdfs:range nsprov:Dictionary;
                  rdfs:subPropertyOf nsprov:entity;
                  nsprov:category "collections";
                  nsprov:component "collections";
                  nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                  nsprov:definition "The property used by a prov:Insertion and prov:Removal to cite the prov:Dictionary that was prov:derivedByInsertionFrom or prov:derivedByRemovalFrom another dictionary.";
                  nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-removal"^^xsd:anyURI,
                            "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-removal"^^xsd:anyURI,
                           "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI.
nsprov:dm a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
          rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en;
          rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                           nsprov:;
          rdfs:subPropertyOf rdfs:seeAlso.
nsprov:editorialNote a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                     rdfs:comment "A note by the OWL development team about how this term expresses the PROV-DM concept, or how it should be used in context of semantic web or linked data."@en;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                      nsprov:.
nsprov:editorsDefinition a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                         rdfs:comment "When the prov-o term does not have a definition drawn from prov-dm, and the prov-o editor provides one."@en;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                          nsprov:;
                         rdfs:subPropertyOf nsprov:definition.
nsprov:ended rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
             rdfs:label "ended";
             <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasEndedBy.
nsprov:endedAtTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The time at which an activity ended. See also prov:startedAtTime."@en;
                   rdfs:domain nsprov:Activity;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "endedAtTime";
                   rdfs:range xsd:dateTime;
                   nsprov:category "starting-point";
                   nsprov:component "entities-activities";
                   nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedEnd o prov:atTime) rdfs:subPropertyOf prov:endedAtTime."@en;
                   nsprov:qualifiedForm nsprov:End,
                                        nsprov:atTime.
nsprov:entity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain nsprov:EntityInfluence;
              rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
              rdfs:label "entity";
              rdfs:range nsprov:Entity;
              rdfs:subPropertyOf nsprov:influencer;
              nsprov:category "qualified";
              nsprov:editorialNote "This property behaves in spirit like rdf:object; it references the object of a prov:wasInfluencedBy triple."@en;
              nsprov:editorsDefinition "The prov:entity property references an prov:Entity which influenced a resource. This property applies to an prov:EntityInfluence, which is given by a subproperty of prov:qualifiedInfluence from the influenced prov:Entity, prov:Activity or prov:Agent.";
              nsprov:inverse "entityOfInfluence".
nsprov:entityOfInfluence rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                         rdfs:label "entityOfInfluence";
                         <http://www.w3.org/2002/07/owl#inverseOf> nsprov:entity.
nsprov:generalizationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                        rdfs:label "generalizationOf";
                        <http://www.w3.org/2002/07/owl#inverseOf> nsprov:specializationOf.
nsprov:generated a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain nsprov:Activity;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                  <http://www.w3.org/ns/prov-o#>;
                 rdfs:label "generated";
                 rdfs:range nsprov:Entity;
                 rdfs:subPropertyOf nsprov:influenced;
                 <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasGeneratedBy;
                 nsprov:category "expanded";
                 nsprov:component "entities-activities";
                 nsprov:editorialNote "prov:generated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions."@en;
                 nsprov:inverse "wasGeneratedBy";
                 nsprov:sharesDefinitionWith nsprov:Generation.
nsprov:generatedAsDerivation rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                             rdfs:label "generatedAsDerivation";
                             <http://www.w3.org/2002/07/owl#inverseOf> nsprov:hadGeneration.
nsprov:generatedAtTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                       rdfs:comment "The time at which an entity was completely created and is available for use."@en;
                       rdfs:domain nsprov:Entity;
                       rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                       rdfs:label "generatedAtTime";
                       rdfs:range xsd:dateTime;
                       nsprov:category "expanded";
                       nsprov:component "entities-activities";
                       nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedGeneration o prov:atTime) rdfs:subPropertyOf prov:generatedAtTime."@en;
                       nsprov:qualifiedForm nsprov:atTime,
                                            nsprov:Generation.
nsprov:hadActivity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The _optional_ Activity of an Influence, which used, generated, invalidated, or was the responsibility of some Entity. This property is _not_ used by ActivityInfluence (use prov:activity instead)."@en,
                                """This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.""";
                   rdfs:domain nsprov:Influence,
                               [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Delegation
                                                                         nsprov:Derivation
                                                                         nsprov:End
                                                                         nsprov:Start) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "hadActivity";
                   rdfs:range nsprov:Activity;
                   nsprov:category "qualified";
                   nsprov:component "derivations";
                   nsprov:editorialNote "The multiple rdfs:domain assertions are intended. One is simpler and works for OWL-RL, the union is more specific but is not recognized by OWL-RL."@en;
                   nsprov:inverse "wasActivityOfInfluence";
                   nsprov:sharesDefinitionWith nsprov:Activity.
nsprov:hadDelegate rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                   rdfs:label "hadDelegate";
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:actedOnBehalfOf.
nsprov:hadDerivation rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                     rdfs:label "hadDerivation";
                     <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasDerivedFrom.
nsprov:hadDictionaryMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain nsprov:Dictionary;
                           rdfs:isDefinedBy nsprov:;
                           rdfs:label "hadDictionaryMember";
                           rdfs:range nsprov:KeyEntityPair;
                           nsprov:category "collections";
                           nsprov:component "collections";
                           nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                           nsprov:definition "Describes the key-entity pair that was member of a prov:Dictionary. A dictionary can have multiple members.";
                           nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
                           nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI.
nsprov:hadGeneration a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The _optional_ Generation involved in an Entity's Derivation."@en;
                     rdfs:domain nsprov:Derivation;
                     rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                     rdfs:label "hadGeneration";
                     rdfs:range nsprov:Generation;
                     nsprov:category "qualified";
                     nsprov:component "derivations";
                     nsprov:inverse "generatedAsDerivation";
                     nsprov:sharesDefinitionWith nsprov:Generation.
nsprov:hadInfluence rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                    rdfs:label "hadInfluence";
                    <http://www.w3.org/2002/07/owl#inverseOf> nsprov:influencer.
nsprov:hadMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain nsprov:Collection;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                 rdfs:label "hadMember";
                 rdfs:range nsprov:Entity;
                 rdfs:subPropertyOf nsprov:wasInfluencedBy;
                 nsprov:category "expanded";
                 nsprov:component "expanded";
                 nsprov:inverse "wasMemberOf";
                 nsprov:sharesDefinitionWith nsprov:Collection.
nsprov:hadPlan a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The _optional_ Plan adopted by an Agent in Association with some Activity. Plan specifications are out of the scope of this specification."@en;
               rdfs:domain nsprov:Association;
               rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
               rdfs:label "hadPlan";
               rdfs:range nsprov:Plan;
               nsprov:category "qualified";
               nsprov:component "agents-responsibility";
               nsprov:inverse "wasPlanOf";
               nsprov:sharesDefinitionWith nsprov:Plan.
nsprov:hadPrimarySource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain nsprov:Entity;
                        rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                        rdfs:label "hadPrimarySource";
                        rdfs:range nsprov:Entity;
                        rdfs:subPropertyOf nsprov:wasDerivedFrom;
                        <http://www.w3.org/2002/07/owl#propertyChainAxiom> (nsprov:qualifiedPrimarySource
                                                                            nsprov:entity);
                        nsprov:category "expanded";
                        nsprov:component "derivations";
                        nsprov:inverse "wasPrimarySourceOf";
                        nsprov:qualifiedForm nsprov:PrimarySource,
                                             nsprov:qualifiedPrimarySource.
nsprov:hadRevision rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                   rdfs:label "hadRevision";
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasRevisionOf.
nsprov:hadRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The _optional_ Role that an Entity assumed in the context of an Activity. For example, :baking prov:used :spoon; prov:qualified [ a prov:Usage; prov:entity :spoon; prov:hadRole roles:mixing_implement ]."@en,
                            """This property has multiple RDFS domains to suit multiple OWL Profiles. See <a href=\"#owl-profile\">PROV-O OWL Profile</a>.""";
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (nsprov:Association
                                                                     nsprov:InstantaneousEvent) ; 
                            a <http://www.w3.org/2002/07/owl#Class>],
                           nsprov:Influence;
               rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
               rdfs:label "hadRole";
               rdfs:range nsprov:Role;
               nsprov:category "qualified";
               nsprov:component "agents-responsibility";
               nsprov:editorsDefinition "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity), in the context of an instantaneous usage, generation, association, start, and end."@en;
               nsprov:inverse "wasRoleIn";
               nsprov:sharesDefinitionWith nsprov:Role.
nsprov:hadUsage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The _optional_ Usage involved in an Entity's Derivation."@en;
                rdfs:domain nsprov:Derivation;
                rdfs:isDefinedBy nsprov:,
                                 <http://www.w3.org/ns/prov-o#>;
                rdfs:label "hadUsage";
                rdfs:range nsprov:Usage;
                nsprov:category "qualified";
                nsprov:component "derivations";
                nsprov:inverse "wasUsedInDerivation";
                nsprov:sharesDefinitionWith nsprov:Usage.
nsprov:has_anchor a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Indicates anchor URI for a potentially dynamic resource instance."@en;
                  rdfs:isDefinedBy nsprov:;
                  rdfs:label "has_anchor";
                  nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI;
                  nsprov:category "access-and-query";
                  nsprov:inverse "anchorOf".
nsprov:has_provenance a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Indicates a provenance-URI for a resource; the resource identified by this property presents a provenance record about its subject or anchor resource."@en;
                      rdfs:isDefinedBy nsprov:;
                      rdfs:label "has_provenance";
                      nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#resource-represented-as-html"^^xsd:anyURI;
                      nsprov:category "access-and-query";
                      nsprov:inverse "provenanceOf".
nsprov:has_query_service a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Indicates a provenance query service that can access provenance related to its subject or anchor resource."@en;
                         rdfs:isDefinedBy nsprov:;
                         rdfs:label "hasProvenanceService";
                         nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI;
                         nsprov:category "access-and-query";
                         nsprov:inverse "provenanceQueryServiceOf".
nsprov:influenced a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                   <http://www.w3.org/ns/prov-o-inverses#>;
                  rdfs:label "influenced";
                  <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasInfluencedBy;
                  nsprov:category "expanded";
                  nsprov:component "agents-responsibility";
                  nsprov:inverse "wasInfluencedBy";
                  nsprov:sharesDefinitionWith nsprov:Influence.
nsprov:influencer a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Subproperties of prov:influencer are used to cite the object of an unqualified PROV-O triple whose predicate is a subproperty of prov:wasInfluencedBy (e.g. prov:used, prov:wasGeneratedBy). prov:influencer is used much like rdf:object is used."@en;
                  rdfs:domain nsprov:Influence;
                  rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                  rdfs:label "influencer";
                  rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                  nsprov:category "qualified";
                  nsprov:dm "http://www.w3.org/TR/2013/REC-prov-dm-20130430/#term-influence"^^xsd:anyURI;
                  nsprov:editorialNote "This property and its subproperties are used in the same way as the rdf:object property, i.e. to reference the object of an unqualified prov:wasInfluencedBy or prov:influenced triple."@en;
                  nsprov:editorsDefinition "This property is used as part of the qualified influence pattern. Subclasses of prov:Influence use these subproperties to reference the resource (Entity, Agent, or Activity) whose influence is being qualified."@en;
                  nsprov:inverse "hadInfluence".
nsprov:informed rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                rdfs:label "informed";
                <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasInformedBy.
nsprov:insertedKeyEntityPair a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:domain nsprov:Insertion;
                             rdfs:isDefinedBy nsprov:;
                             rdfs:label "insertedKeyEntityPair";
                             rdfs:range nsprov:KeyEntityPair;
                             nsprov:category "collections";
                             nsprov:component "collections";
                             nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                             nsprov:definition "An object property to refer to the prov:KeyEntityPair inserted into a prov:Dictionary.";
                             nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-insertion"^^xsd:anyURI;
                             nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-insertion"^^xsd:anyURI.
nsprov:invalidated a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain nsprov:Activity;
                   rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>,
                                    <http://www.w3.org/ns/prov-o#>;
                   rdfs:label "invalidated";
                   rdfs:range nsprov:Entity;
                   rdfs:subPropertyOf nsprov:influenced;
                   <http://www.w3.org/2002/07/owl#inverseOf> nsprov:wasInvalidatedBy;
                   nsprov:category "expanded";
                   nsprov:component "entities-activities";
                   nsprov:editorialNote "prov:invalidated is one of few inverse property defined, to allow Activity-oriented assertions in addition to Entity-oriented assertions."@en;
                   nsprov:inverse "wasInvalidatedBy";
                   nsprov:sharesDefinitionWith nsprov:Invalidation.
nsprov:invalidatedAtTime a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                         rdfs:comment "The time at which an entity was invalidated (i.e., no longer usable)."@en;
                         rdfs:domain nsprov:Entity;
                         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                         rdfs:label "invalidatedAtTime";
                         rdfs:range xsd:dateTime;
                         nsprov:category "expanded";
                         nsprov:component "entities-activities";
                         nsprov:editorialNote "It is the intent that the property chain holds: (prov:qualifiedInvalidation o prov:atTime) rdfs:subPropertyOf prov:invalidatedAtTime."@en;
                         nsprov:qualifiedForm nsprov:atTime,
                                              nsprov:Invalidation.
nsprov:inverse a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
               rdfs:comment "PROV-O does not define all property inverses. The directionalities defined in PROV-O should be given preference over those not defined. However, if users wish to name the inverse of a PROV-O property, the local name given by prov:inverse should be used."@en;
               rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                                nsprov:;
               rdfs:seeAlso <http://www.w3.org/TR/prov-o/#names-of-inverse-properties>.
nsprov:locationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                  rdfs:label "locationOf";
                  <http://www.w3.org/2002/07/owl#inverseOf> nsprov:atLocation.
nsprov:mentionOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment """prov:mentionOf is used to specialize an entity as described in another bundle. It is to be used in conjuction with prov:asInBundle.

prov:asInBundle is used to cite the Bundle in which the generalization was mentioned."""@en;
                 rdfs:domain nsprov:Entity;
                 rdfs:isDefinedBy <http://www.w3.org/ns/prov-links#>;
                 rdfs:label "mentionOf";
                 rdfs:range nsprov:Entity;
                 rdfs:subPropertyOf nsprov:specializationOf;
                 nsprov:inverse "hadMention".
nsprov:n a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
         rdfs:comment "A reference to the principal section of the PROV-DM document that describes this concept."@en,
                      "A reference to the principal section of the PROV-M document that describes this concept."@en;
         rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>,
                          nsprov:;
         rdfs:subPropertyOf rdfs:seeAlso.
nsprov:order a <http://www.w3.org/2002/07/owl#AnnotationProperty>;
             rdfs:comment "The position that this OWL term should be listed within documentation. The scope of the documentation (e.g., among all terms, among terms within a prov:category, among properties applying to a particular class, etc.) is unspecified."@en;
             rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>.
nsprov:pairEntity a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain nsprov:KeyEntityPair;
                  rdfs:isDefinedBy nsprov:;
                  rdfs:label "pairKey";
                  rdfs:range nsprov:Entity;
                  nsprov:category "collections";
                  nsprov:component "collections";
                  nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
                  nsprov:definition "The value of a KeyEntityPair.";
                  nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
                  nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI.
nsprov:pairKey a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:domain nsprov:KeyEntityPair;
               rdfs:isDefinedBy nsprov:;
               rdfs:label "pairKey";
               rdfs:range rdfs:Literal;
               nsprov:category "collections";
               nsprov:component "collections";
               nsprov:constraints "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#dictionary-constraints"^^xsd:anyURI;
               nsprov:definition "The key of a KeyEntityPair, which is an element of a prov:Dictionary.";
               nsprov:dm "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#term-dictionary-membership"^^xsd:anyURI;
               nsprov:n "http://www.w3.org/TR/2013/NOTE-prov-dictionary-20130430/#expression-dictionary-membership"^^xsd:anyURI.
nsprov:pingback a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates a resource to a provenance pingback service that may receive additional provenance links about the resource."@en;
                rdfs:isDefinedBy nsprov:;
                rdfs:label "provenance pingback";
                nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/#provenance-pingback"^^xsd:anyURI;
                nsprov:category "access-and-query".
nsprov:provenanceUriTemplate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                             rdfs:comment "Relates a provenance service to a URI template string for constructing provenance-URIs."@en;
                             rdfs:isDefinedBy nsprov:;
                             rdfs:label "provenanceUriTemplate";
                             nsprov:aq "http://www.w3.org/TR/2013/NOTE-prov-aq-20130430/"^^xsd:anyURI;
                             nsprov:category "access-and-query".
nsprov:qualifiedAssociation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "If this Activity prov:wasAssociatedWith Agent :ag, then it can qualify the Association using prov:qualifiedAssociation [ a prov:Association;  prov:agent :ag; :foo :bar ]."@en;
                            rdfs:domain nsprov:Activity;
                            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                            rdfs:label "qualifiedAssociation";
                            rdfs:range nsprov:Association;
                            rdfs:subPropertyOf nsprov:qualifiedInfluence;
                            nsprov:category "qualified";
                            nsprov:component "agents-responsibility";
                            nsprov:inverse "qualifiedAssociationOf";
                            nsprov:sharesDefinitionWith nsprov:Association;
                            nsprov:unqualifiedForm nsprov:wasAssociatedWith.
nsprov:qualifiedAssociationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                              rdfs:label "qualifiedAssociationOf";
                              <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedAssociation.
nsprov:qualifiedAttribution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "If this Entity prov:wasAttributedTo Agent :ag, then it can qualify how it was influenced using prov:qualifiedAttribution [ a prov:Attribution;  prov:agent :ag; :foo :bar ]."@en;
                            rdfs:domain nsprov:Entity;
                            rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                            rdfs:label "qualifiedAttribution";
