                           nsprov:unqualifiedForm nsprov:wasDerivedFrom.
nsprov:qualifiedDerivationOf rdfs:isDefinedBy <http://www.w3.org/ns/prov-o-inverses#>;
                             rdfs:label "qualifiedDerivationOf";
                             <http://www.w3.org/2002/07/owl#inverseOf> nsprov:qualifiedDerivation.
nsprov:qualifiedEnd a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "If this Activity prov:wasEndedBy Entity :e1, then it can qualify how it was ended using prov:qualifiedEnd [ a prov:End;  prov:entity :e1; :foo :bar ]."@en;
                    rdfs:domain nsprov:Activity;
                    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#>;
                    rdfs:label "qualifiedEnd";
                    rdfs:range nsprov:End;
