@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix kgc: <http://kgc.knowledge-graph.jp/ontology/kgc.owl#>.

<http://kgc.knowledge-graph.jp/ontology/kgc.owl> <http://purl.org/dc/elements/1.1/description> "This vocabulary set can represent 5W1H (Who, What, When, Where, Why, How) in event (scene) descriptions. This file is also provided in Knowledge Graph Reasoning Challenge.";
                                                 <http://purl.org/dc/elements/1.1/title> "KGRC Ontology";
                                                 a <http://www.w3.org/2002/07/owl#Ontology>;
                                                 rdfs:seeAlso <https://github.com/KnowledgeGraphJapan/KGRC-RDF>;
                                                 <http://www.w3.org/2002/07/owl#versionIRI> kgc:1.0.0.
kgc:AbstractTime a <http://www.w3.org/2002/07/owl#Class>.
kgc:Action a <http://www.w3.org/2002/07/owl#Class>.
kgc:ActionOption a <http://www.w3.org/2002/07/owl#ObjectProperty>.
kgc:Animal a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf kgc:Object.
kgc:CanNotAction a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:subClassOf kgc:NotAction.
kgc:LocationProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:subPropertyOf kgc:SceneObjectProperty.
kgc:Not a <http://www.w3.org/2002/07/owl#ObjectProperty>;
        rdfs:subPropertyOf kgc:ActionOption.
kgc:NotAction a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf kgc:Action.
kgc:OFobj a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf kgc:Object.
kgc:ORobj a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf kgc:Object.
kgc:Object a <http://www.w3.org/2002/07/owl#Class>.
kgc:Person a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:subClassOf kgc:Animal.
kgc:Place a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:subClassOf kgc:Object.
kgc:Property a <http://www.w3.org/2002/07/owl#Class>.
kgc:RelationBetweenScene a <http://www.w3.org/2002/07/owl#ObjectProperty>.
kgc:Scene a <http://www.w3.org/2002/07/owl#Class>.
kgc:SceneObjectProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:subPropertyOf kgc:SceneProperty.
kgc:SceneProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>.
kgc:Situation a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf kgc:Scene.
kgc:Statement a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:subClassOf kgc:Scene.
kgc:Talk a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:subClassOf kgc:Scene.
kgc:TargetObjProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>.
kgc:Thought a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf kgc:Scene.
kgc:adjunct a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:LocationProperty.
kgc:around a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:subPropertyOf kgc:LocationProperty.
kgc:at_the_same_time a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:because a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:canNot a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:subPropertyOf kgc:ActionOption.
kgc:from a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:LocationProperty.
kgc:hasPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:hasPredicate a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:hasProperty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:how a <http://www.w3.org/2002/07/owl#ObjectProperty>;
        rdfs:subPropertyOf kgc:SceneObjectProperty.
kgc:if a <http://www.w3.org/2002/07/owl#ObjectProperty>;
       rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:infoReceiver a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:subPropertyOf kgc:SceneProperty.
kgc:infoSource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:subPropertyOf kgc:SceneProperty.
kgc:left a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:LocationProperty.
kgc:middle a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:subPropertyOf kgc:LocationProperty.
kgc:near a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:LocationProperty.
kgc:next_to a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:LocationProperty.
kgc:ofPart a <http://www.w3.org/2002/07/owl#ObjectProperty>;
           rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:ofWhole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:on a <http://www.w3.org/2002/07/owl#ObjectProperty>;
       rdfs:subPropertyOf kgc:LocationProperty.
kgc:opposite a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:subPropertyOf kgc:LocationProperty.
kgc:orTarget a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:subPropertyOf kgc:TargetObjProperty.
kgc:otherwise a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:right a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:subPropertyOf kgc:LocationProperty.
kgc:subject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:subPropertyOf kgc:SceneProperty.
kgc:then a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:therefore a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:time a <http://www.w3.org/2002/07/owl#ObjectProperty>,
           <http://www.w3.org/2002/07/owl#DatatypeProperty>;
         rdfs:range xsd:DateTime.
kgc:to a <http://www.w3.org/2002/07/owl#ObjectProperty>;
       rdfs:subPropertyOf kgc:LocationProperty.
kgc:what a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:SceneObjectProperty.
kgc:when a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:RelationBetweenScene,
                            kgc:SceneObjectProperty.
kgc:when_during a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:where a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:subPropertyOf kgc:LocationProperty.
kgc:whom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
         rdfs:subPropertyOf kgc:SceneObjectProperty.
kgc:why a <http://www.w3.org/2002/07/owl#ObjectProperty>;
        rdfs:subPropertyOf kgc:SceneObjectProperty.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
xsd:DateTime a <http://www.w3.org/2002/07/owl#Class>.
