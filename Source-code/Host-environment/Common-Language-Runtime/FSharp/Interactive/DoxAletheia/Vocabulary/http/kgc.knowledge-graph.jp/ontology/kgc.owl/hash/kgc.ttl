                     rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:because a owl:ObjectProperty;
            rdfs:subPropertyOf kgc:RelationBetweenScene.
kgc:canNot a owl:ObjectProperty;
           rdfs:subPropertyOf kgc:ActionOption.
kgc:from a owl:ObjectProperty;
         rdfs:subPropertyOf kgc:LocationProperty.
kgc:hasPart a owl:ObjectProperty;
            rdfs:subPropertyOf kgc:TargetObjProperty.
