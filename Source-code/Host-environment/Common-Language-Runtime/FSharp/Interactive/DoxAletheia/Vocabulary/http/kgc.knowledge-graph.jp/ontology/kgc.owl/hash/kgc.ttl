<http://kgc.knowledge-graph.jp/ontology/kgc.owl> dc11:description "This vocabulary set can represent 5W1H (Who, What, When, Where, Why, How) in event (scene) descriptions. This file is also provided in Knowledge Graph Reasoning Challenge.";
                                                 dc11:title "KGRC Ontology";
                                                 a owl:Ontology;
                                                 rdfs:seeAlso <https://github.com/KnowledgeGraphJapan/KGRC-RDF>;
                                                 owl:versionIRI kgc:1.0.0.
kgc:AbstractTime a owl:Class.
kgc:Action a owl:Class.
kgc:ActionOption a owl:ObjectProperty.
kgc:Animal a owl:Class;
           rdfs:subClassOf kgc:Object.
kgc:CanNotAction a owl:Class;
                 rdfs:subClassOf kgc:NotAction.
