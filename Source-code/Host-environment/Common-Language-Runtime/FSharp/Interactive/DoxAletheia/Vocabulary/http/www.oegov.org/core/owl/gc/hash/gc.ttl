gc:CSV-Format <http://purl.org/dc/elements/1.1/description> "A comma separated values (CSV) file is a computer data file used for implementing the tried and true organizational tool, the Comma Separated List. The CSV file is used for the digital storage of data structured in a table of lists form. Each line in the CSV file corresponds to a row in the table. Within a line, fields are separated by commas, and each field belongs to one table column. CSV files are often used for moving tabular data between two different computer programs (like moving between a database program and a spreadsheet program).";
              a gc:DataFormat;
              rdfs:label "CVS Format".
gc:Category a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "Category";
            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                            [<http://www.w3.org/2002/07/owl#allValuesFrom> gc:Category ; 
                             <http://www.w3.org/2002/07/owl#onProperty> gc:subCategory ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>].
