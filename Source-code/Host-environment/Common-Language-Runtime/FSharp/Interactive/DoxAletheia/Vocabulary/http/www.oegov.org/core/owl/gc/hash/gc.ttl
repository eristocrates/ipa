@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

ccrel:License a owl:Class;
              rdfs:subClassOf [owl:maxCardinality "1"^^xsd:int ; 
                               owl:onProperty ccrel:image ; 
                               a owl:Restriction].
ccrel:attributionName a owl:DatatypeProperty.
ccrel:attributionURL a owl:DatatypeProperty;
                     rdfs:range xsd:anyURI.
ccrel:deprecatedOn a owl:AnnotationProperty.
ccrel:image a owl:AnnotationProperty;
            rdfs:range xsd:anyURI.
ccrel:jurisdiction a owl:ObjectProperty.
ccrel:legalcode a owl:ObjectProperty.
ccrel:license a owl:ObjectProperty.
ccrel:morePermissions a owl:ObjectProperty.
ccrel:permits a owl:ObjectProperty.
ccrel:prohibits a owl:ObjectProperty.
ccrel:requires a owl:ObjectProperty.
<http://www.oegov.org/core/owl/gc> ccrel:attributionURL "http://www.topquadrant.com"^^xsd:anyURI;
                                   ccrel:license gc:CreativeCommonsAttributionShareAlike3.0_UnitedStatesLicense;
                                   dc11:creator "Ralph Hodgson";
                                   dc11:date "$Date: 2009-08-24 10:59:06 -0700 (Mon, 24 Aug 2009) $";
                                   dc11:description "Government Core Ontology.";
                                   dc11:rights "Creative Commons Attribution-Share Alike 3.0 United States License";
                                   dc11:source "www.oegov.org";
                                   dc11:title "oeGOV Government Core Ontology";
                                   gc:attributedSource gc:TopQuadrantAttribution;
                                   gc:revision "$Revision: 1365 $";
                                   a owl:Ontology;
                                   owl:imports <http://creativecommons.org/schema.rdf>,
                                               <http://spinrdf.org/spin>,
                                               dc11:,
                                               <http://www.oegov.org/core/owl/cc>;
                                   owl:versionInfo "$Id: gc.n3 1365 2009-08-24 17:59:06Z RalphHodgson $".
gc:Anarcy a owl:Class;
          rdfs:subClassOf gc:PoliticalSystem.
gc:AttributedSource a owl:Class;
                    rdfs:comment "The name, url and other details of an attribution.";
                    rdfs:label "Attributed Source";
                    rdfs:subClassOf owl:Thing,
                                    [owl:allValuesFrom xsd:string ; 
                                     owl:onProperty gc:pointOfContact ; 
                                     a owl:Restriction],
                                    [owl:maxCardinality "1"^^xsd:int ; 
                                     owl:onProperty ccrel:attributionURL ; 
                                     a owl:Restriction],
                                    [owl:cardinality "1"^^xsd:int ; 
                                     owl:onProperty ccrel:attributionName ; 
                                     a owl:Restriction].
gc:CSV-Format dc11:description "A comma separated values (CSV) file is a computer data file used for implementing the tried and true organizational tool, the Comma Separated List. The CSV file is used for the digital storage of data structured in a table of lists form. Each line in the CSV file corresponds to a row in the table. Within a line, fields are separated by commas, and each field belongs to one table column. CSV files are often used for moving tabular data between two different computer programs (like moving between a database program and a spreadsheet program).";
              a gc:DataFormat;
              rdfs:label "CVS Format".
gc:Category a owl:Class;
            rdfs:label "Category";
            rdfs:subClassOf owl:Thing,
                            [owl:allValuesFrom gc:Category ; 
                             owl:onProperty gc:subCategory ; 
                             a owl:Restriction].
gc:CommunistState a owl:Class;
                  rdfs:subClassOf gc:PoliticalSystem.
gc:CreativeCommonsAttributionShareAlike3.0_UnitedStatesLicense ccrel:image "http://i.creativecommons.org/l/by-sa/3.0/us/88x31.png"^^xsd:anyURI;
                                                               ccrel:permits ccrel:DerivativeWorks,
                                                                             ccrel:Distribution;
                                                               ccrel:requires ccrel:Attribution,
                                                                              ccrel:ShareAlike;
                                                               a ccrel:License;
                                                               rdfs:label "Creative Commons Attribution-Share Alike 3.0 United States License".
gc:DataFormat a owl:Class;
              rdfs:label "Data Format";
              rdfs:subClassOf gc:Category.
gc:DateUnion a rdfs:Datatype;
             rdfs:subClassOf rdfs:Resource.
gc:Democracy a owl:Class;
             rdfs:subClassOf gc:PoliticalSystem.
gc:Dictatorship a owl:Class;
                rdfs:subClassOf gc:PoliticalSystem.
gc:Entity a owl:Class;
          rdfs:label "Entity";
          rdfs:subClassOf owl:Thing,
                          [owl:allValuesFrom xsd:string ; 
                           owl:onProperty gc:hashtag ; 
                           a owl:Restriction],
                          [owl:allValuesFrom xsd:anyURI ; 
                           owl:onProperty gc:url ; 
                           a owl:Restriction].
gc:HTML-Format a gc:DataFormat;
               rdfs:label "HTML Format".
gc:KML-Format dc11:description "Keyhole Markup Language (KML) is an XML-based language schema for expressing geographic annotation and visualization on existing or future Web-based, two-dimensional maps and three-dimensional Earth browsers.";
              a gc:DataFormat;
              rdfs:label "KML-Format".
gc:KMZ-Format dc11:description """KML files are very often distributed in KMZ files, which are zipped files with a \".KMZ\" extension. When a KMZ file is unzipped, a single \"doc.kml\" is found along with any overlay and icon images referenced in the KML as well as any network-linked KML files.""";
              a gc:DataFormat;
              rdfs:label "KMZ Format".
gc:Monarchy a owl:Class;
            rdfs:subClassOf gc:PoliticalSystem.
gc:OWL-Format a gc:DataFormat;
              rdfs:label "OWL Format".
gc:Period a owl:Class;
          rdfs:label "Period";
          rdfs:subClassOf owl:Thing.
gc:PoliticalSystem a owl:Class;
                   rdfs:label "Political system";
                   rdfs:subClassOf owl:Thing.
gc:Q1 a gc:Quarter;
      rdfs:label "Q1".
gc:Q2 a gc:Quarter;
      rdfs:label "Q2".
gc:Q3 a gc:Quarter;
      rdfs:label "Q3".
gc:Q4 a gc:Quarter;
      rdfs:label "Q4".
gc:Quarter a owl:Class;
           rdfs:label "Quarter";
           rdfs:subClassOf gc:Period;
           owl:oneOf (gc:Q1
                      gc:Q2
                      gc:Q3
                      gc:Q4).
gc:RDF-Format a gc:DataFormat;
              rdfs:label "RDF Fomat".
gc:RSS-Format a gc:DataFormat;
              rdfs:label "RSS Format".
gc:Republic a owl:Class;
            rdfs:subClassOf gc:PoliticalSystem.
gc:ShapefileFormat dc11:description """The ESRI Shapefile or simply a shapefile is a popular geospatial vector data format for geographic information systems software. It is developed and regulated by ESRI as a (mostly) open specification for data interoperability among ESRI and other software products.[1] A \"shapefile\" commonly refers to a collection of files with \".shp\", \".shx\", \".dbf\", and other extensions on a common prefix name (e.g., \"lakes.*\"). The actual shapefile relates specifically to files with the \".shp\" extension, however this file alone is incomplete for distribution, as the other supporting files are required. Shapefiles spatially describe geometries: points, polylines, and polygons. These, for example, could represent water wells, rivers, and lakes, respectively. Each item may also have attributes that describe the items, such as the name or temperature [Wikipedia].""";
                   a gc:DataFormat;
                   rdfs:label "Shapefile Format".
gc:SocialistState a owl:Class;
                  rdfs:subClassOf gc:PoliticalSystem.
gc:TextFormat a gc:DataFormat;
              rdfs:label "Text Format".
gc:Theocracy a owl:Class;
             rdfs:subClassOf gc:PoliticalSystem.
gc:TopQuadrantAttribution ccrel:attributionName "TopQuadrant, Inc.";
                          ccrel:attributionURL "http://www.topquadrant.com"^^xsd:anyURI;
                          gc:pointOfContact "Ralph Hodgson";
                          a gc:AttributedSource;
                          rdfs:label "TopQuadrant attribution".
gc:Tribal a owl:Class;
          rdfs:subClassOf gc:PoliticalSystem.
gc:UnstructuredDataFormat gc:subCategory gc:HTML-Format;
                          a gc:DataFormat;
                          rdfs:label "Unstructured Data Format".
gc:XML-Format dc11:description "XML (Extensible Markup Language) is a general-purpose specification for creating custom markup languages. It is classified as an extensible language, because it allows the user to define the mark-up elements. XML's purpose is to aid information systems in sharing structured data, especially via the Internet, to encode documents, and to serialize data.";
              a gc:DataFormat;
              rdfs:label "XML Format".
gc:XSL-Format a gc:DataFormat;
              rdfs:label "XSL Format".
gc:archiveURL a owl:DatatypeProperty;
              rdfs:label "archive URL";
              rdfs:range xsd:anyURI;
              rdfs:subPropertyOf gc:url.
gc:attributedSource a owl:ObjectProperty;
                    rdfs:label "attributed source".
gc:awardDate a owl:DatatypeProperty;
             rdfs:label "award date";
             rdfs:range gc:DateUnion;
             rdfs:subPropertyOf gc:date.
gc:category a owl:ObjectProperty;
            rdfs:label "category".
gc:cause a owl:ObjectProperty;
         rdfs:label "cause".
gc:cessationDate a owl:DatatypeProperty;
                 rdfs:label "cessation date";
                 rdfs:range gc:DateUnion;
                 rdfs:subPropertyOf gc:date.
gc:clause a owl:ObjectProperty;
          rdfs:label "clause".
gc:creationDate a owl:DatatypeProperty;
                rdfs:label "creation date";
                rdfs:range gc:DateUnion;
                rdfs:subPropertyOf gc:date.
gc:currency a owl:ObjectProperty;
            rdfs:label "currency".
gc:date a owl:DatatypeProperty;
        rdfs:label "date";
        rdfs:range gc:DateUnion.
gc:endDate a owl:DatatypeProperty;
           rdfs:label "end date";
           rdfs:range xsd:date;
           rdfs:subPropertyOf gc:date.
gc:format a owl:ObjectProperty;
          rdfs:label "format".
gc:foundedOn a owl:DatatypeProperty;
             rdfs:label "founded on";
             rdfs:range gc:DateUnion;
             rdfs:subPropertyOf gc:date.
gc:hashtag a owl:DatatypeProperty;
           rdfs:label "hashtag";
           rdfs:range xsd:string.
gc:identifier a owl:DatatypeProperty;
              rdfs:label "identifier";
              rdfs:range xsd:anySimpleType.
gc:image a owl:AnnotationProperty;
         rdfs:range xsd:anyURI.
gc:licence a owl:DatatypeProperty;
           rdfs:label "licence";
           rdfs:range xsd:string.
gc:member a owl:ObjectProperty;
          rdfs:label "member".
gc:number a owl:DatatypeProperty;
          rdfs:label "number";
          rdfs:range xsd:int.
gc:person a owl:ObjectProperty;
          rdfs:label "person".
gc:pointOfContact a owl:DatatypeProperty;
                  rdfs:label "point of contact";
                  rdfs:range xsd:string.
gc:releasedDate a owl:DatatypeProperty;
                rdfs:label "released date";
                rdfs:range gc:DateUnion;
                rdfs:subPropertyOf gc:date.
gc:result a owl:ObjectProperty;
          rdfs:label "result".
gc:revision a owl:AnnotationProperty;
            rdfs:range xsd:string.
gc:section a owl:ObjectProperty;
           rdfs:label "section".
gc:shortTitle a owl:DatatypeProperty;
              rdfs:label "short title";
              rdfs:range xsd:string.
gc:startDate a owl:DatatypeProperty;
             rdfs:label "start date";
             rdfs:range xsd:date;
             rdfs:subPropertyOf gc:date.
gc:status a owl:ObjectProperty;
          rdfs:label "status".
gc:subCategory a owl:ObjectProperty;
               rdfs:label "sub category".
gc:submissionDate a owl:DatatypeProperty;
                  rdfs:label "submission date";
                  rdfs:range xsd:date;
                  rdfs:subPropertyOf gc:date.
gc:summary a owl:DatatypeProperty;
           rdfs:label "summary";
           rdfs:range xsd:string.
gc:text a owl:DatatypeProperty;
        rdfs:label "text";
        rdfs:range xsd:string.
gc:title a owl:DatatypeProperty;
         rdfs:label "title";
         rdfs:range xsd:string.
gc:updatedDate a owl:DatatypeProperty;
               rdfs:label "updated date";
               rdfs:range xsd:date;
               rdfs:subPropertyOf gc:date.
gc:url a owl:DatatypeProperty;
       rdfs:label "url";
       rdfs:range xsd:anyURI.
gc:year a owl:DatatypeProperty;
        rdfs:label "year";
        rdfs:range xsd:gYear.
xsd:date rdfs:subClassOf gc:DateUnion.
xsd:dateTime rdfs:subClassOf gc:DateUnion.
xsd:gDay rdfs:subClassOf gc:DateUnion.
xsd:gYear rdfs:subClassOf gc:DateUnion.
xsd:gYearMonth rdfs:subClassOf gc:DateUnion.
owl:Ontology rdfs:subClassOf [owl:allValuesFrom ccrel:License ; 
                              owl:onProperty ccrel:license ; 
                              a owl:Restriction],
                             [owl:maxCardinality "1"^^xsd:int ; 
                              owl:onProperty ccrel:license ; 
                              a owl:Restriction],
                             [owl:allValuesFrom gc:AttributedSource ; 
                              owl:onProperty gc:attributedSource ; 
                              a owl:Restriction].
