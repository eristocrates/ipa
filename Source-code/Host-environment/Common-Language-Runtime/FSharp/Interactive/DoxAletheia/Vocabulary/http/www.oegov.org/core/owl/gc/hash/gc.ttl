gc:KML-Format <http://purl.org/dc/elements/1.1/description> "Keyhole Markup Language (KML) is an XML-based language schema for expressing geographic annotation and visualization on existing or future Web-based, two-dimensional maps and three-dimensional Earth browsers.";
              a gc:DataFormat;
              rdfs:label "KML-Format".
gc:KMZ-Format <http://purl.org/dc/elements/1.1/description> """KML files are very often distributed in KMZ files, which are zipped files with a \".KMZ\" extension. When a KMZ file is unzipped, a single \"doc.kml\" is found along with any overlay and icon images referenced in the KML as well as any network-linked KML files.""";
              a gc:DataFormat;
              rdfs:label "KMZ Format".
gc:Monarchy a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:subClassOf gc:PoliticalSystem.
