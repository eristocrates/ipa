                                                              <http://purl.org/dc/elements/1.1/description>.
<http://purl.org/dc/terms/temporal> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#temporal-003>;
                                    <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                    <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                    a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
