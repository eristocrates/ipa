<http://purl.org/dc/terms/title> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#titleT-002>;
                                 <http://purl.org/dc/terms/issued> "2008-01-14"^^xsd:date;
