                                rdfs:label "Type"@en;
                                rdfs:range rdfs:Class;
                                rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/type>.
<http://purl.org/dc/terms/valid> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#valid-003>;
                                 <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                 <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                                 rdfs:comment "Date (often a range) of validity of a resource."@en;
                                 rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                 rdfs:label "Date Valid"@en;
                                 rdfs:range rdfs:Literal;
                                 rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>,
                                                    <http://purl.org/dc/terms/date>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.demcare.eu/ontologies/demlab.owl> <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/3.0/>;
                                              <http://purl.org/dc/elements/1.1/creator> "Georgios Meditskos, Ioannis Kompatsiaris"@en;
                                              <http://purl.org/dc/elements/1.1/description> """The ontology has been developed in the framework of the Dem@Care project for representing the experimentation protocol towards diagnostic support and assessment of Dementia in a controlled environment. The aim of the protocol is to provide a brief overview of their health status of the participants during consultation (cognition, behaviours and function), and to correlate the system (sensor) data with the data collected using typical dementia care assessment tools.

The ontology describes the basic Steps of the experimentation protocol (Directed Activities, Semi-directed Activities and Free Discussion with the Clinician), the Tasks that are involved, as well as the measurement types relevant to each Task. The defined protocol can be reused and further extended, adding new steps, tasks and measured data.

Documentation regarding the ontology vocabulary can be found at http://www.demcare.eu/ontologies/demlab.html"""@en;
                                              <http://purl.org/dc/terms/date> "2014-09-02";
                                              <http://purl.org/dc/terms/rights> "This ontology is licensed under Creative Commons CC BY 3.0 It is developed in the framework of the Dem@Care project (http://www.demcare.eu/) and supported by the Information Technologies Institute (http://www.iti.gr) of the Centre for Research and Technology Hellas."@en;
                                              <http://purl.org/dc/terms/title> "Dem@Care Lab Ontology for Dementia Assessment"@en;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "demlab";
                                              a <http://www.w3.org/2002/07/owl#Ontology>,
                                                <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                              rdfs:seeAlso "http://www.demcare.eu/",
                                                           "http://www.demcare.eu/downloads/D8.1ExperimentationProtocols.pdf";
                                              <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/2006/time>,
                                                                                      <http://xmlns.com/foaf/0.1/>;
                                              <http://www.w3.org/2002/07/owl#versionIRI> <http://www.demcare.eu/ontologies/demlab.owl/1.0>;
                                              <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
demlab:ActivityStatusType a <http://www.w3.org/2002/07/owl#Class>;
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (demlab:completed
                                                                                                                  demlab:incomplete
                                                                                                                  demlab:omitted) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>],
                                                                          [<http://www.w3.org/2002/07/owl#oneOf> (demlab:completed
                                                                                                                  demlab:incomplete
                                                                                                                  demlab:omitted) ; 
                                                                           a <http://www.w3.org/2002/07/owl#Class>].
demlab:AnswerPhoneTask a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment """- The phone is scheduled to ring 10 minutes after the entering of the participant inside the room. 
- During this task, the clinician explains that there is a mistake on the phone bill: the amount was wrong. Consequently, it is expected that the participant corrects his/her phone check and corrects the account balance (tasks normally established before the phone call according to the constraint)."""@en;
                       rdfs:subClassOf demlab:SemiDirectedTask.
demlab:ArticulationControlTask a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment """The participant is asked to pronounce repeatedly a predefined diadochokinetic “Pataka” token as rapid as possible stopping this action upon a sign by the clinician. The clinician will stop the action in 10 sec.

This task is used for assessing:
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. speech rate, pause rate etc."""@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:LatencyData
                                                                                                                                        demlab:StressData
                                                                                                                                        demlab:VoiceData) ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:LatencyData
                                                                                                                                        demlab:StressData
                                                                                                                                        demlab:VoiceData) ; 
                                                                                               a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               demlab:DirectedTask.
demlab:AutonomyAssessment a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Autonomy is assessed based on the performance of the participant during the SemiDirectedActivitiesStep. The property iadl_e (Instrumental Activities of Daily Living for Elderly) can be used to quantify autonomy"@en;
                          rdfs:seeAlso demlab:iadl_e,
                                       demlab:SemiDirectedActivitiesStep;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> demlab:iadl_e ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> demlab:iadl_e ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          demlab:ClinicalAssessment.
demlab:CallPsychologistTask a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment """- The participant has to call the psychologist. Two phone numbers are proposed to the participant (1 visit card of the hair dressing,+ 1 visit card of the CHUN with phone number of a psychologist). 
- According the constraint, the participant has to call the psychologist within the 5 first minutes."""@en;
                            rdfs:subClassOf demlab:SemiDirectedTask.
demlab:ClinicalAssessment a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Root concept for the five types of clinical assessment"@en;
                          rdfs:seeAlso demlab:NeuropsychiatricAndMoodAssessment,
                                       demlab:MotricityAbilitiesAssessment,
                                       demlab:DiagnosisAssessment,
                                       demlab:CognitiveAbilitiesAssessment,
                                       demlab:AutonomyAssessment.
demlab:ClinicalRecord a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A ClinicalRecord contains information about the five types of clinical assessment"@en;
                      rdfs:seeAlso demlab:containsAssessment,
                                   demlab:ClinicalAssessment;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onClass> demlab:Participant ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:isClinicalRecordOf ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:AutonomyAssessment
                                                                                                                               demlab:CognitiveAbilitiesAssessment
                                                                                                                               demlab:DiagnosisAssessment
                                                                                                                               demlab:MotricityAbilitiesAssessment
                                                                                                                               demlab:NeuropsychiatricAndMoodAssessment) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:containsAssessment ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onClass> demlab:Participant ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:isClinicalRecordOf ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:AutonomyAssessment
                                                                                                                               demlab:CognitiveAbilitiesAssessment
                                                                                                                               demlab:DiagnosisAssessment
                                                                                                                               demlab:MotricityAbilitiesAssessment
                                                                                                                               demlab:NeuropsychiatricAndMoodAssessment) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:containsAssessment ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
demlab:CognitiveAbilitiesAssessment a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment """The Cognitive abilities assessment is performed in terms of five scores:
- Mini-Mental State Exam (MMSE). 
- Frontal Assessment Battery (FAB). 
- Trail making test A and B. 
- Short Cognitive Battery. 
- The Free and Cued Selective Reminding Test"""@en;
                                    rdfs:seeAlso demlab:hasMMSEScore,
                                                 demlab:trailMakingTest,
                                                 demlab:fabScore,
                                                 demlab:freeAndCuedRemindingAssessment,
                                                 demlab:shortCognitiveBatteryAssessment;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:shortCognitiveBatteryAssessment ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:freeAndCuedRemindingAssessment ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:hasMMSEScore ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    demlab:ClinicalAssessment,
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:trailMakingTest ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:freeAndCuedRemindingAssessment ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:hasMMSEScore ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:fabScore ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:shortCognitiveBatteryAssessment ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:fabScore ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:trailMakingTest ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>].
demlab:CognitiveAbilitiesData a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Explore functional abilities for the completion of specific activities"@en;
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onClass> demlab:ActivityStatusType ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:activityStatus ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:repetitions ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                               <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:compliantInstructionsOrder ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onClass> demlab:ActivityStatusType ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:activityStatus ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:repetitions ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                               <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:compliantInstructionsOrder ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              demlab:MeasuredData.
demlab:CountingBackwardsTask a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment """(MonoTask) The participant is standing and the clinician asks him/her to count aloud backwards: 
- From 305 to 285 (to change tens and hundreds) one by one; or 
- From 20 to 0 if they make counting mistakes after 2 attempts of the previous backwards counting

This task is used for assessing:
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. speech fluency and articulation"""@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:LatencyData
                                                                                                                                      demlab:StressData
                                                                                                                                      demlab:VoiceData) ; 
                                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:LatencyData
                                                                                                                                      demlab:StressData
                                                                                                                                      demlab:VoiceData) ; 
                                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             demlab:DirectedTask.
demlab:DiagnosisAssessment a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Diagnosis established the day of the recording session. Participant is assigned to one of this 3 categories: Healthy Control participants, Alzheimer’s disease at pre-dementia stage, Alzheimer ’s disease at dementia stage"@en;
                           rdfs:seeAlso demlab:PersonWithPredementia,
                                        demlab:PersonWithDementia,
                                        demlab:DiagnosisType,
                                        demlab:HealthyControlParticipant,
                                        demlab:hasClinicalDiagnosis;
                           rdfs:subClassOf demlab:ClinicalAssessment,
                                           [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onClass> demlab:DiagnosisType ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> demlab:hasClinicalDiagnosis ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                            <http://www.w3.org/2002/07/owl#onClass> demlab:DiagnosisType ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> demlab:hasClinicalDiagnosis ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>].
demlab:DiagnosisType a <http://www.w3.org/2002/07/owl#Class>;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#oneOf> (demlab:healthy
                                                                                                             demlab:dementia
                                                                                                             demlab:predementia) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>],
                                                                     [<http://www.w3.org/2002/07/owl#oneOf> (demlab:healthy
                                                                                                             demlab:dementia
                                                                                                             demlab:predementia) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
demlab:DirectedActivitiesStep a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "This ProtocolStep is conducted by a clinician, who details step by step the different activities to do by the participant. This step involves five Tasks. The tasks Walking, CountingBackwards and WalkingAndCountingBackwards are used for characterizing participants’ gait in mono and dual tasks, and the impact of cognitive activity on gait (e.g., walking speed, step length, stops during the walking exercise done in dual task). The tasks SentenceRepeating and ArticulationControl are vocally-directed tasks: one task consists of repeating a sentence after the clinician (this task is repeated with three sentences), and the other is an articulation control exercise done to evaluate the neuromuscular mechanism of speech production."@en;
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:ArticulationControlTask
                                                                                                                                       demlab:CountingBackwardsTask
                                                                                                                                       demlab:SentenceRepeatingTask
                                                                                                                                       demlab:Task
                                                                                                                                       demlab:WalkingCountingBackwardsTask
                                                                                                                                       demlab:WalkingTask) ; 
                                                                                              a <http://www.w3.org/2002/07/owl#Class>] ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:involvesTask ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:ArticulationControlTask
                                                                                                                                       demlab:CountingBackwardsTask
                                                                                                                                       demlab:SentenceRepeatingTask
                                                                                                                                       demlab:Task
                                                                                                                                       demlab:WalkingCountingBackwardsTask
                                                                                                                                       demlab:WalkingTask) ; 
                                                                                              a <http://www.w3.org/2002/07/owl#Class>] ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> demlab:involvesTask ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              demlab:ProtocolStep.
demlab:DirectedDiscussionTask a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:subClassOf demlab:DiscussionTask.
demlab:DirectedExpressionTask a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "The clinician asks the same questions than the ones asked on the read article, e.g. What is the topic of the article?"@en;
                              rdfs:subClassOf demlab:DirectedDiscussionTask.
demlab:DirectedTask a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Root concept for grouping the Tasks relevant to the DirectedActivitiesStep"@en;
                    rdfs:seeAlso demlab:Task,
                                 demlab:DirectedActivitiesStep;
                    rdfs:subClassOf demlab:Task.
demlab:DiscussionInvolvementData a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment """- Assessment of the impact of cognitive load imposed by the picture description task on speech fluency
- Memory and self-appraisal assessment
- Verbal fluency and mood (Apathy) assessment"""@en;
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> demlab:verbalReactionSpontaneity ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                  <http://www.w3.org/2002/07/owl#onProperty> demlab:verbalReactionSpontaneity ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                 demlab:MeasuredData.
demlab:DiscussionTask a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment """Root concept for grouping the Tasks relevant to the DiscussionWithClinicianStep

The relevant tasks are used for assessing:
- Stress level
- Voice: e.g. speech rate, pause rate etc."""@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:StressData
                                                                                                                               demlab:VoiceData) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:StressData
                                                                                                                               demlab:VoiceData) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> demlab:measuredData ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      demlab:Task.
demlab:DiscussionWithClinicianStep a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "This ProtocolStep involves two Tasks. The first task (DirectedExpressionTask) is a directed discussion during which the clinician assesses the episodic memory of participant through questions related to events and activities of SemiDirectedActivitiesStep. The second task (PictureDescriptionTask) assesses the verbal fluency and mood of participant using a picture that the participant has to describe (with the picture in the eyes) and then to involve a discussion about their interests for the activity represented. This part is done with two different pictures."@en;
                                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:DirectedExpressionTask
                                                                                                                                            demlab:PictureDescriptionTask
                                                                                                                                            demlab:PictureDiscussionTask) ; 
                                                                                                   a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                    <http://www.w3.org/2002/07/owl#onProperty> demlab:involvesTask ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (demlab:DirectedExpressionTask
                                                                                                                                            demlab:PictureDescriptionTask
                                                                                                                                            demlab:PictureDiscussionTask) ; 
                                                                                                   a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                    <http://www.w3.org/2002/07/owl#onProperty> demlab:involvesTask ; 
                                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                                   demlab:ProtocolStep.
demlab:EstablishAccountBalanceTask a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment """- Three bills (Electricity/Gaz/Phone) are proposed. The account balance is given. 
- The participant has to establish the amount balance after having taken into account the three bills."""@en;
                                   rdfs:subClassOf demlab:SemiDirectedTask.
demlab:FindBusLineOnMapTask a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment """- A real bus map is showed to the participant with the indication of the current location of the participant. 
- The participant has to write on a sheet of paper located next to the bus map the bus lines to take for the itinerary (From Hospital to Station train). Two itineraries are accepted."""@en;
                            rdfs:subClassOf demlab:SemiDirectedTask.
demlab:FreeDiscussionTask a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:subClassOf demlab:DiscussionTask.
demlab:FunctionalAbilitiesData a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Explore functional abilities for the completion of specific activities"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                <http://www.w3.org/2002/07/owl#onClass> demlab:HandTrajectoryType ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> demlab:handTrajectory ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                <http://www.w3.org/2002/07/owl#onClass> demlab:HandTrajectoryType ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> demlab:handTrajectory ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               demlab:MeasuredData.
demlab:GaitData a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Gait assessment and impact of a cognitive activity on gait performance"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:walkingSpeedInstantaneous ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:walkingSpeed ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:walkingSpeed ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:stoppingDisplacement ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:dynamicBalance ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onDataRange> xsd:boolean ; 
                                 <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:stoppingDisplacement ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:walkingSpeedInstantaneous ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                demlab:MeasuredData,
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:stepLength ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:dynamicBalance ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> demlab:stepLength ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>].
demlab:HandTrajectoryType a <http://www.w3.org/2002/07/owl#Class>.
demlab:HealthyControlParticipant a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A Healthy Control Participant is defined as the participant whose clinical record contains a healthy clinical diagnosis"@en;
                                 rdfs:seeAlso demlab:healthy,
                                              demlab:DiagnosisType,
                                              demlab:DiagnosisAssessment,
                                              demlab:ClinicalRecord;
                                 rdfs:subClassOf demlab:Participant;
