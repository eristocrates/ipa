                                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                                         demlab:ClinicalAssessment,
                                                         [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                          <http://www.w3.org/2002/07/owl#onProperty> demlab:npi ; 
                                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                                         [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                          <http://www.w3.org/2002/07/owl#onProperty> demlab:npi ; 
                                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                                         [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                          <http://www.w3.org/2002/07/owl#onProperty> demlab:apathyInventory ; 
                                                          a <http://www.w3.org/2002/07/owl#Restriction>].
demlab:OrganisationEfficiencyData a <http://www.w3.org/2002/07/owl#Class>;
