                                                                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> demlab:containsAssessment ; 
                                                                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> demlab:hasClinicalRecord ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (demlab:ClinicalRecord
                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (demlab:DiagnosisAssessment
                                                                                                                                                                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#oneOf> (demlab:healthy) ; 
