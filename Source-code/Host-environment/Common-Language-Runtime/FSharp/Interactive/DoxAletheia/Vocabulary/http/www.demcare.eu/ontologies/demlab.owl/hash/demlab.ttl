                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   demlab:MeasuredData.
demlab:LeaveRoomTask a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "The participant has to leave the room when he/she feels that all activities are performed and achieved"@en;
                     rdfs:subClassOf demlab:SemiDirectedTask.
demlab:MeasuredData a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "MeasuredData is the root concept that groups the measurement types that are collected during the Tasks.".
demlab:MotricityAbilitiesAssessment a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment """Motricity abilities assessment:
- Part III of the Unified Parkinson’s Disease Rating Scale (UPDRS) ."""@en;
                                    rdfs:seeAlso demlab:hasUPDRSScore;
                                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onDataRange> xsd:int ; 
                                                     <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                     <http://www.w3.org/2002/07/owl#onProperty> demlab:hasUPDRSScore ; 
                                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                                    [<http://www.w3.org/2002/07/owl#onDataRange> xsd:int ; 
                                                     <http://www.w3.org/2002/07/owl#qualifiedCardinality> "1"^^xsd:nonNegativeInteger ; 
