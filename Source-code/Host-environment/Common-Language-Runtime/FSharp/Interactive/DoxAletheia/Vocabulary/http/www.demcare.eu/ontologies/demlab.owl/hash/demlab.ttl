                   rdfs:range dcterms:ProvenanceStatement.
dcterms:publisher dcterms:description "Examples of a Publisher include a person, an organization, or a service."@en;
                  dcterms:hasVersion <http://dublincore.org/usage/terms/history/#publisherT-001>;
                  dcterms:issued "2008-01-14"^^xsd:date;
                  dcterms:modified "2010-10-11"^^xsd:date;
                  a owl:AnnotationProperty,
                    owl:ObjectProperty;
                  rdfs:comment "An entity responsible for making the resource available."@en;
                  rdfs:isDefinedBy dcterms:;
                  rdfs:label "Publisher"@en;
                  rdfs:range dcterms:Agent;
                  rdfs:subPropertyOf dc11:publisher.
dcterms:references dcterms:hasVersion <http://dublincore.org/usage/terms/history/#references-003>;
                   dcterms:issued "2000-07-11"^^xsd:date;
                   dcterms:modified "2008-01-14"^^xsd:date;
                   a owl:AnnotationProperty;
                   rdfs:comment "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en;
                   rdfs:isDefinedBy dcterms:;
                   rdfs:label "References"@en;
                   rdfs:subPropertyOf dc11:relation,
                                      dcterms:relation;
                   skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:relation dcterms:description "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en;
                 dcterms:hasVersion <http://dublincore.org/usage/terms/history/#relationT-001>;
                 dcterms:issued "2008-01-14"^^xsd:date;
                 dcterms:modified "2008-01-14"^^xsd:date;
                 a owl:AnnotationProperty;
                 rdfs:comment "A related resource."@en;
                 rdfs:isDefinedBy dcterms:;
                 rdfs:label "Relation"@en;
                 rdfs:subPropertyOf dc11:relation;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:replaces dcterms:hasVersion <http://dublincore.org/usage/terms/history/#replaces-003>;
                 dcterms:issued "2000-07-11"^^xsd:date;
                 dcterms:modified "2008-01-14"^^xsd:date;
                 a owl:AnnotationProperty;
                 rdfs:comment "A related resource that is supplanted, displaced, or superseded by the described resource."@en;
                 rdfs:isDefinedBy dcterms:;
                 rdfs:label "Replaces"@en;
                 rdfs:subPropertyOf dc11:relation,
                                    dcterms:relation;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:requires dcterms:hasVersion <http://dublincore.org/usage/terms/history/#requires-003>;
                 dcterms:issued "2000-07-11"^^xsd:date;
                 dcterms:modified "2008-01-14"^^xsd:date;
                 a owl:AnnotationProperty;
                 rdfs:comment "A related resource that is required by the described resource to support its function, delivery, or coherence."@en;
                 rdfs:isDefinedBy dcterms:;
                 rdfs:label "Requires"@en;
                 rdfs:subPropertyOf dc11:relation,
                                    dcterms:relation;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:rights dcterms:description "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en;
               dcterms:hasVersion <http://dublincore.org/usage/terms/history/#rightsT-001>;
               dcterms:issued "2008-01-14"^^xsd:date;
               dcterms:modified "2008-01-14"^^xsd:date;
               a owl:AnnotationProperty,
                 owl:ObjectProperty;
               rdfs:comment "Information about rights held in and over the resource."@en;
               rdfs:isDefinedBy dcterms:;
               rdfs:label "Rights"@en;
               rdfs:range dcterms:RightsStatement;
               rdfs:subPropertyOf dc11:rights.
dcterms:rightsHolder dcterms:hasVersion <http://dublincore.org/usage/terms/history/#rightsHolder-002>;
                     dcterms:issued "2004-06-14"^^xsd:date;
                     dcterms:modified "2008-01-14"^^xsd:date;
                     a owl:ObjectProperty;
                     rdfs:comment "A person or organization owning or managing rights over the resource."@en;
                     rdfs:isDefinedBy dcterms:;
                     rdfs:label "Rights Holder"@en;
                     rdfs:range dcterms:Agent.
dcterms:source dcterms:description "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en;
               dcterms:hasVersion <http://dublincore.org/usage/terms/history/#sourceT-001>;
               dcterms:issued "2008-01-14"^^xsd:date;
               dcterms:modified "2008-01-14"^^xsd:date;
               a owl:AnnotationProperty;
               rdfs:comment "A related resource from which the described resource is derived."@en;
               rdfs:isDefinedBy dcterms:;
               rdfs:label "Source"@en;
               rdfs:subPropertyOf dc11:source,
                                  dcterms:relation;
               skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:spatial dcterms:hasVersion <http://dublincore.org/usage/terms/history/#spatial-003>;
                dcterms:issued "2000-07-11"^^xsd:date;
                dcterms:modified "2008-01-14"^^xsd:date;
                a owl:ObjectProperty,
                  owl:AnnotationProperty;
                rdfs:comment "Spatial characteristics of the resource."@en;
                rdfs:isDefinedBy dcterms:;
                rdfs:label "Spatial Coverage"@en;
                rdfs:range dcterms:Location;
                rdfs:subPropertyOf dcterms:coverage,
                                   dc11:coverage.
dcterms:subject dcterms:description "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary."@en;
                dcterms:hasVersion <http://dublincore.org/usage/terms/history/#subjectT-002>;
                dcterms:issued "2008-01-14"^^xsd:date;
                dcterms:modified "2012-06-14"^^xsd:date;
                a owl:AnnotationProperty;
                rdfs:comment "The topic of the resource."@en;
                rdfs:isDefinedBy dcterms:;
                rdfs:label "Subject"@en;
                rdfs:subPropertyOf dc11:subject;
                skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
dcterms:tableOfContents dcterms:hasVersion <http://dublincore.org/usage/terms/history/#tableOfContents-003>;
                        dcterms:issued "2000-07-11"^^xsd:date;
                        dcterms:modified "2008-01-14"^^xsd:date;
                        a owl:AnnotationProperty;
                        rdfs:comment "A list of subunits of the resource."@en;
                        rdfs:isDefinedBy dcterms:;
                        rdfs:label "Table Of Contents"@en;
                        rdfs:subPropertyOf dcterms:description,
                                           dc11:description.
dcterms:temporal dcterms:hasVersion <http://dublincore.org/usage/terms/history/#temporal-003>;
                 dcterms:issued "2000-07-11"^^xsd:date;
                 dcterms:modified "2008-01-14"^^xsd:date;
                 a owl:AnnotationProperty,
                   owl:ObjectProperty;
                 rdfs:comment "Temporal characteristics of the resource."@en;
                 rdfs:isDefinedBy dcterms:;
                 rdfs:label "Temporal Coverage"@en;
                 rdfs:range dcterms:PeriodOfTime;
                 rdfs:subPropertyOf dcterms:coverage,
                                    dc11:coverage.
dcterms:title dcterms:hasVersion <http://dublincore.org/usage/terms/history/#titleT-002>;
              dcterms:issued "2008-01-14"^^xsd:date;
              dcterms:modified "2010-10-11"^^xsd:date;
              a owl:DatatypeProperty,
                owl:AnnotationProperty;
              rdfs:comment "A name given to the resource."@en;
              rdfs:isDefinedBy dcterms:;
              rdfs:label "Title"@en;
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf dc11:title.
dcterms:type dcterms:description "Recommended best practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMITYPE]. To describe the file format, physical medium, or dimensions of the resource, use the Format element."@en;
             dcterms:hasVersion <http://dublincore.org/usage/terms/history/#typeT-001>;
             dcterms:issued "2008-01-14"^^xsd:date;
             dcterms:modified "2008-01-14"^^xsd:date;
             a owl:AnnotationProperty,
               owl:ObjectProperty;
             rdfs:comment "The nature or genre of the resource."@en;
             rdfs:isDefinedBy dcterms:;
             rdfs:label "Type"@en;
             rdfs:range rdfs:Class;
             rdfs:subPropertyOf dc11:type.
dcterms:valid dcterms:hasVersion <http://dublincore.org/usage/terms/history/#valid-003>;
              dcterms:issued "2000-07-11"^^xsd:date;
              dcterms:modified "2008-01-14"^^xsd:date;
              a owl:AnnotationProperty,
                owl:DatatypeProperty;
              rdfs:comment "Date (often a range) of validity of a resource."@en;
              rdfs:isDefinedBy dcterms:;
              rdfs:label "Date Valid"@en;
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf dc11:date,
                                 dcterms:date.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
<http://www.demcare.eu/ontologies/demlab.owl> ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
                                              dc11:creator "Georgios Meditskos, Ioannis Kompatsiaris"@en;
                                              dc11:description """The ontology has been developed in the framework of the Dem@Care project for representing the experimentation protocol towards diagnostic support and assessment of Dementia in a controlled environment. The aim of the protocol is to provide a brief overview of their health status of the participants during consultation (cognition, behaviours and function), and to correlate the system (sensor) data with the data collected using typical dementia care assessment tools.

The ontology describes the basic Steps of the experimentation protocol (Directed Activities, Semi-directed Activities and Free Discussion with the Clinician), the Tasks that are involved, as well as the measurement types relevant to each Task. The defined protocol can be reused and further extended, adding new steps, tasks and measured data.

Documentation regarding the ontology vocabulary can be found at http://www.demcare.eu/ontologies/demlab.html"""@en;
                                              dcterms:date "2014-09-02";
                                              dcterms:rights "This ontology is licensed under Creative Commons CC BY 3.0 It is developed in the framework of the Dem@Care project (http://www.demcare.eu/) and supported by the Information Technologies Institute (http://www.iti.gr) of the Centre for Research and Technology Hellas."@en;
                                              dcterms:title "Dem@Care Lab Ontology for Dementia Assessment"@en;
                                              vann:preferredNamespacePrefix "demlab";
                                              a owl:Ontology,
                                                owl:NamedIndividual;
                                              rdfs:seeAlso "http://www.demcare.eu/",
                                                           "http://www.demcare.eu/downloads/D8.1ExperimentationProtocols.pdf";
                                              owl:imports <http://www.w3.org/2006/time>,
                                                          foaf:;
                                              owl:versionIRI <http://www.demcare.eu/ontologies/demlab.owl/1.0>;
                                              owl:versionInfo 1.0.
demlab:ActivityStatusType a owl:Class;
                          owl:equivalentClass [owl:oneOf (demlab:completed
                                                          demlab:incomplete
                                                          demlab:omitted) ; 
                                               a owl:Class],
                                              [owl:oneOf (demlab:completed
                                                          demlab:incomplete
                                                          demlab:omitted) ; 
                                               a owl:Class].
demlab:AnswerPhoneTask a owl:Class;
                       rdfs:comment """- The phone is scheduled to ring 10 minutes after the entering of the participant inside the room. 
- During this task, the clinician explains that there is a mistake on the phone bill: the amount was wrong. Consequently, it is expected that the participant corrects his/her phone check and corrects the account balance (tasks normally established before the phone call according to the constraint)."""@en;
                       rdfs:subClassOf demlab:SemiDirectedTask.
demlab:ArticulationControlTask a owl:Class;
                               rdfs:comment """The participant is asked to pronounce repeatedly a predefined diadochokinetic “Pataka” token as rapid as possible stopping this action upon a sign by the clinician. The clinician will stop the action in 10 sec.

This task is used for assessing:
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. speech rate, pause rate etc."""@en;
                               rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                                demlab:StressData
                                                                                demlab:VoiceData) ; 
                                                                   a owl:Class] ; 
                                                owl:onProperty demlab:measuredData ; 
                                                a owl:Restriction],
                                               [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                                demlab:StressData
                                                                                demlab:VoiceData) ; 
                                                                   a owl:Class] ; 
                                                owl:onProperty demlab:measuredData ; 
                                                a owl:Restriction],
                                               demlab:DirectedTask.
demlab:AutonomyAssessment a owl:Class;
                          rdfs:comment "Autonomy is assessed based on the performance of the participant during the SemiDirectedActivitiesStep. The property iadl_e (Instrumental Activities of Daily Living for Elderly) can be used to quantify autonomy"@en;
                          rdfs:seeAlso demlab:iadl_e,
                                       demlab:SemiDirectedActivitiesStep;
                          rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty demlab:iadl_e ; 
                                           a owl:Restriction],
                                          [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty demlab:iadl_e ; 
                                           a owl:Restriction],
                                          demlab:ClinicalAssessment.
demlab:CallPsychologistTask a owl:Class;
                            rdfs:comment """- The participant has to call the psychologist. Two phone numbers are proposed to the participant (1 visit card of the hair dressing,+ 1 visit card of the CHUN with phone number of a psychologist). 
- According the constraint, the participant has to call the psychologist within the 5 first minutes."""@en;
                            rdfs:subClassOf demlab:SemiDirectedTask.
demlab:ClinicalAssessment a owl:Class;
                          rdfs:comment "Root concept for the five types of clinical assessment"@en;
                          rdfs:seeAlso demlab:NeuropsychiatricAndMoodAssessment,
                                       demlab:MotricityAbilitiesAssessment,
                                       demlab:DiagnosisAssessment,
                                       demlab:CognitiveAbilitiesAssessment,
                                       demlab:AutonomyAssessment.
demlab:ClinicalRecord a owl:Class;
                      rdfs:comment "A ClinicalRecord contains information about the five types of clinical assessment"@en;
                      rdfs:seeAlso demlab:containsAssessment,
                                   demlab:ClinicalAssessment;
                      rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onClass demlab:Participant ; 
                                       owl:onProperty demlab:isClinicalRecordOf ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom [owl:unionOf (demlab:AutonomyAssessment
                                                                       demlab:CognitiveAbilitiesAssessment
                                                                       demlab:DiagnosisAssessment
                                                                       demlab:MotricityAbilitiesAssessment
                                                                       demlab:NeuropsychiatricAndMoodAssessment) ; 
                                                          a owl:Class] ; 
                                       owl:onProperty demlab:containsAssessment ; 
                                       a owl:Restriction],
                                      [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onClass demlab:Participant ; 
                                       owl:onProperty demlab:isClinicalRecordOf ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom [owl:unionOf (demlab:AutonomyAssessment
                                                                       demlab:CognitiveAbilitiesAssessment
                                                                       demlab:DiagnosisAssessment
                                                                       demlab:MotricityAbilitiesAssessment
                                                                       demlab:NeuropsychiatricAndMoodAssessment) ; 
                                                          a owl:Class] ; 
                                       owl:onProperty demlab:containsAssessment ; 
                                       a owl:Restriction].
demlab:CognitiveAbilitiesAssessment a owl:Class;
                                    rdfs:comment """The Cognitive abilities assessment is performed in terms of five scores:
- Mini-Mental State Exam (MMSE). 
- Frontal Assessment Battery (FAB). 
- Trail making test A and B. 
- Short Cognitive Battery. 
- The Free and Cued Selective Reminding Test"""@en;
                                    rdfs:seeAlso demlab:hasMMSEScore,
                                                 demlab:trailMakingTest,
                                                 demlab:fabScore,
                                                 demlab:freeAndCuedRemindingAssessment,
                                                 demlab:shortCognitiveBatteryAssessment;
                                    rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:shortCognitiveBatteryAssessment ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:freeAndCuedRemindingAssessment ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:hasMMSEScore ; 
                                                     a owl:Restriction],
                                                    demlab:ClinicalAssessment,
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:trailMakingTest ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:freeAndCuedRemindingAssessment ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:hasMMSEScore ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:fabScore ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:shortCognitiveBatteryAssessment ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:fabScore ; 
                                                     a owl:Restriction],
                                                    [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:trailMakingTest ; 
                                                     a owl:Restriction].
demlab:CognitiveAbilitiesData a owl:Class;
                              rdfs:comment "Explore functional abilities for the completion of specific activities"@en;
                              rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onClass demlab:ActivityStatusType ; 
                                               owl:onProperty demlab:activityStatus ; 
                                               a owl:Restriction],
                                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty demlab:repetitions ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:boolean ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty demlab:compliantInstructionsOrder ; 
                                               a owl:Restriction],
                                              [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onClass demlab:ActivityStatusType ; 
                                               owl:onProperty demlab:activityStatus ; 
                                               a owl:Restriction],
                                              [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty demlab:repetitions ; 
                                               a owl:Restriction],
                                              [owl:onDataRange xsd:boolean ; 
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onProperty demlab:compliantInstructionsOrder ; 
                                               a owl:Restriction],
                                              demlab:MeasuredData.
demlab:CountingBackwardsTask a owl:Class;
                             rdfs:comment """(MonoTask) The participant is standing and the clinician asks him/her to count aloud backwards: 
- From 305 to 285 (to change tens and hundreds) one by one; or 
- From 20 to 0 if they make counting mistakes after 2 attempts of the previous backwards counting

This task is used for assessing:
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. speech fluency and articulation"""@en;
                             rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                              demlab:StressData
                                                                              demlab:VoiceData) ; 
                                                                 a owl:Class] ; 
                                              owl:onProperty demlab:measuredData ; 
                                              a owl:Restriction],
                                             [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                              demlab:StressData
                                                                              demlab:VoiceData) ; 
                                                                 a owl:Class] ; 
                                              owl:onProperty demlab:measuredData ; 
                                              a owl:Restriction],
                                             demlab:DirectedTask.
demlab:DiagnosisAssessment a owl:Class;
                           rdfs:comment "Diagnosis established the day of the recording session. Participant is assigned to one of this 3 categories: Healthy Control participants, Alzheimer’s disease at pre-dementia stage, Alzheimer ’s disease at dementia stage"@en;
                           rdfs:seeAlso demlab:PersonWithPredementia,
                                        demlab:PersonWithDementia,
                                        demlab:DiagnosisType,
                                        demlab:HealthyControlParticipant,
                                        demlab:hasClinicalDiagnosis;
                           rdfs:subClassOf demlab:ClinicalAssessment,
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass demlab:DiagnosisType ; 
                                            owl:onProperty demlab:hasClinicalDiagnosis ; 
                                            a owl:Restriction],
                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onClass demlab:DiagnosisType ; 
                                            owl:onProperty demlab:hasClinicalDiagnosis ; 
                                            a owl:Restriction].
demlab:DiagnosisType a owl:Class;
                     owl:equivalentClass [owl:oneOf (demlab:healthy
                                                     demlab:dementia
                                                     demlab:predementia) ; 
                                          a owl:Class],
                                         [owl:oneOf (demlab:healthy
                                                     demlab:dementia
                                                     demlab:predementia) ; 
                                          a owl:Class].
demlab:DirectedActivitiesStep a owl:Class;
                              rdfs:comment "This ProtocolStep is conducted by a clinician, who details step by step the different activities to do by the participant. This step involves five Tasks. The tasks Walking, CountingBackwards and WalkingAndCountingBackwards are used for characterizing participants’ gait in mono and dual tasks, and the impact of cognitive activity on gait (e.g., walking speed, step length, stops during the walking exercise done in dual task). The tasks SentenceRepeating and ArticulationControl are vocally-directed tasks: one task consists of repeating a sentence after the clinician (this task is repeated with three sentences), and the other is an articulation control exercise done to evaluate the neuromuscular mechanism of speech production."@en;
                              rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:ArticulationControlTask
                                                                               demlab:CountingBackwardsTask
                                                                               demlab:SentenceRepeatingTask
                                                                               demlab:Task
                                                                               demlab:WalkingCountingBackwardsTask
                                                                               demlab:WalkingTask) ; 
                                                                  a owl:Class] ; 
                                               owl:onProperty demlab:involvesTask ; 
                                               a owl:Restriction],
                                              [owl:allValuesFrom [owl:unionOf (demlab:ArticulationControlTask
                                                                               demlab:CountingBackwardsTask
                                                                               demlab:SentenceRepeatingTask
                                                                               demlab:Task
                                                                               demlab:WalkingCountingBackwardsTask
                                                                               demlab:WalkingTask) ; 
                                                                  a owl:Class] ; 
                                               owl:onProperty demlab:involvesTask ; 
                                               a owl:Restriction],
                                              demlab:ProtocolStep.
demlab:DirectedDiscussionTask a owl:Class;
                              rdfs:subClassOf demlab:DiscussionTask.
demlab:DirectedExpressionTask a owl:Class;
                              rdfs:comment "The clinician asks the same questions than the ones asked on the read article, e.g. What is the topic of the article?"@en;
                              rdfs:subClassOf demlab:DirectedDiscussionTask.
demlab:DirectedTask a owl:Class;
                    rdfs:comment "Root concept for grouping the Tasks relevant to the DirectedActivitiesStep"@en;
                    rdfs:seeAlso demlab:Task,
                                 demlab:DirectedActivitiesStep;
                    rdfs:subClassOf demlab:Task.
demlab:DiscussionInvolvementData a owl:Class;
                                 rdfs:comment """- Assessment of the impact of cognitive load imposed by the picture description task on speech fluency
- Memory and self-appraisal assessment
- Verbal fluency and mood (Apathy) assessment"""@en;
                                 rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty demlab:verbalReactionSpontaneity ; 
                                                  a owl:Restriction],
                                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                  owl:onProperty demlab:verbalReactionSpontaneity ; 
                                                  a owl:Restriction],
                                                 demlab:MeasuredData.
demlab:DiscussionTask a owl:Class;
                      rdfs:comment """Root concept for grouping the Tasks relevant to the DiscussionWithClinicianStep

The relevant tasks are used for assessing:
- Stress level
- Voice: e.g. speech rate, pause rate etc."""@en;
                      rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:StressData
                                                                       demlab:VoiceData) ; 
                                                          a owl:Class] ; 
                                       owl:onProperty demlab:measuredData ; 
                                       a owl:Restriction],
                                      [owl:allValuesFrom [owl:unionOf (demlab:StressData
                                                                       demlab:VoiceData) ; 
                                                          a owl:Class] ; 
                                       owl:onProperty demlab:measuredData ; 
                                       a owl:Restriction],
                                      demlab:Task.
demlab:DiscussionWithClinicianStep a owl:Class;
                                   rdfs:comment "This ProtocolStep involves two Tasks. The first task (DirectedExpressionTask) is a directed discussion during which the clinician assesses the episodic memory of participant through questions related to events and activities of SemiDirectedActivitiesStep. The second task (PictureDescriptionTask) assesses the verbal fluency and mood of participant using a picture that the participant has to describe (with the picture in the eyes) and then to involve a discussion about their interests for the activity represented. This part is done with two different pictures."@en;
                                   rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:DirectedExpressionTask
                                                                                    demlab:PictureDescriptionTask
                                                                                    demlab:PictureDiscussionTask) ; 
                                                                       a owl:Class] ; 
                                                    owl:onProperty demlab:involvesTask ; 
                                                    a owl:Restriction],
                                                   [owl:allValuesFrom [owl:unionOf (demlab:DirectedExpressionTask
                                                                                    demlab:PictureDescriptionTask
                                                                                    demlab:PictureDiscussionTask) ; 
                                                                       a owl:Class] ; 
                                                    owl:onProperty demlab:involvesTask ; 
                                                    a owl:Restriction],
                                                   demlab:ProtocolStep.
demlab:EstablishAccountBalanceTask a owl:Class;
                                   rdfs:comment """- Three bills (Electricity/Gaz/Phone) are proposed. The account balance is given. 
- The participant has to establish the amount balance after having taken into account the three bills."""@en;
                                   rdfs:subClassOf demlab:SemiDirectedTask.
demlab:FindBusLineOnMapTask a owl:Class;
                            rdfs:comment """- A real bus map is showed to the participant with the indication of the current location of the participant. 
- The participant has to write on a sheet of paper located next to the bus map the bus lines to take for the itinerary (From Hospital to Station train). Two itineraries are accepted."""@en;
                            rdfs:subClassOf demlab:SemiDirectedTask.
demlab:FreeDiscussionTask a owl:Class;
                          rdfs:subClassOf demlab:DiscussionTask.
demlab:FunctionalAbilitiesData a owl:Class;
                               rdfs:comment "Explore functional abilities for the completion of specific activities"@en;
                               rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onClass demlab:HandTrajectoryType ; 
                                                owl:onProperty demlab:handTrajectory ; 
                                                a owl:Restriction],
                                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                owl:onClass demlab:HandTrajectoryType ; 
                                                owl:onProperty demlab:handTrajectory ; 
                                                a owl:Restriction],
                                               demlab:MeasuredData.
demlab:GaitData a owl:Class;
                rdfs:comment "Gait assessment and impact of a cognitive activity on gait performance"@en;
                rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:walkingSpeedInstantaneous ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:walkingSpeed ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:walkingSpeed ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:boolean ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:stoppingDisplacement ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:dynamicBalance ; 
                                 a owl:Restriction],
                                [owl:onDataRange xsd:boolean ; 
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:stoppingDisplacement ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:walkingSpeedInstantaneous ; 
                                 a owl:Restriction],
                                demlab:MeasuredData,
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:stepLength ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:dynamicBalance ; 
                                 a owl:Restriction],
                                [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty demlab:stepLength ; 
                                 a owl:Restriction].
demlab:HandTrajectoryType a owl:Class.
demlab:HealthyControlParticipant a owl:Class;
                                 rdfs:comment "A Healthy Control Participant is defined as the participant whose clinical record contains a healthy clinical diagnosis"@en;
                                 rdfs:seeAlso demlab:healthy,
                                              demlab:DiagnosisType,
                                              demlab:DiagnosisAssessment,
                                              demlab:ClinicalRecord;
                                 rdfs:subClassOf demlab:Participant;
                                 owl:equivalentClass [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                              [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                                      [owl:someValuesFrom [owl:oneOf (demlab:healthy) ; 
                                                                                                                                                          a owl:Class] ; 
                                                                                                                                      owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                                      a owl:Restriction]) ; 
                                                                                                                  a owl:Class] ; 
                                                                                              owl:onProperty demlab:containsAssessment ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty demlab:hasClinicalRecord ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                              [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                                      [owl:someValuesFrom [owl:oneOf (demlab:healthy) ; 
                                                                                                                                                          a owl:Class] ; 
                                                                                                                                      owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                                      a owl:Restriction]) ; 
                                                                                                                  a owl:Class] ; 
                                                                                              owl:onProperty demlab:containsAssessment ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty demlab:hasClinicalRecord ; 
                                                      a owl:Restriction].
demlab:LatencyData a owl:Class;
                   rdfs:comment "Explore the time of latency [stimulation, response] during the DirectedActivitiesTask (Explore sensitivity of this measure for assessing the apathy)"@en;
                   rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty demlab:latency ; 
                                    a owl:Restriction],
                                   [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty demlab:latency ; 
                                    a owl:Restriction],
                                   demlab:MeasuredData.
demlab:LeaveRoomTask a owl:Class;
                     rdfs:comment "The participant has to leave the room when he/she feels that all activities are performed and achieved"@en;
                     rdfs:subClassOf demlab:SemiDirectedTask.
demlab:MeasuredData a owl:Class;
                    rdfs:comment "MeasuredData is the root concept that groups the measurement types that are collected during the Tasks.".
demlab:MotricityAbilitiesAssessment a owl:Class;
                                    rdfs:comment """Motricity abilities assessment:
- Part III of the Unified Parkinson’s Disease Rating Scale (UPDRS) ."""@en;
                                    rdfs:seeAlso demlab:hasUPDRSScore;
                                    rdfs:subClassOf [owl:onDataRange xsd:int ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:hasUPDRSScore ; 
                                                     a owl:Restriction],
                                                    [owl:onDataRange xsd:int ; 
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                     owl:onProperty demlab:hasUPDRSScore ; 
                                                     a owl:Restriction],
                                                    demlab:ClinicalAssessment.
demlab:NeuropsychiatricAndMoodAssessment a owl:Class;
                                         rdfs:comment """Neuropsychiatric/Mood assessments:
- NPI 
- DSM-IV Criteria for depression 
- Apathy Inventory (AI) and diagnostic criteria for apathy."""@en;
                                         rdfs:seeAlso demlab:npi,
                                                      demlab:dsm_ivDepressionCriteria,
                                                      demlab:apathyInventory;
                                         rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:dsm_ivDepressionCriteria ; 
                                                          a owl:Restriction],
                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:dsm_ivDepressionCriteria ; 
                                                          a owl:Restriction],
                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:apathyInventory ; 
                                                          a owl:Restriction],
                                                         demlab:ClinicalAssessment,
                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:npi ; 
                                                          a owl:Restriction],
                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:npi ; 
                                                          a owl:Restriction],
                                                         [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                          owl:onProperty demlab:apathyInventory ; 
                                                          a owl:Restriction].
demlab:OrganisationEfficiencyData a owl:Class;
                                  rdfs:comment "Explore ability to organize with efficiency the different activities"@en;
                                  rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty demlab:distanceWalked ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom demlab:Zone ; 
                                                   owl:onProperty demlab:areasOfInterestExplored ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom demlab:Zone ; 
                                                   owl:onProperty demlab:areasOfNoInterestExplored ; 
                                                   a owl:Restriction],
                                                  [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                   owl:onProperty demlab:distanceWalked ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom demlab:Zone ; 
                                                   owl:onProperty demlab:areasOfInterestExplored ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom demlab:Zone ; 
                                                   owl:onProperty demlab:areasOfNoInterestExplored ; 
                                                   a owl:Restriction],
                                                  demlab:MeasuredData.
demlab:Participant a owl:Class;
                   rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass demlab:ClinicalRecord ; 
                                    owl:onProperty demlab:hasClinicalRecord ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:Protocol ; 
                                    owl:onProperty demlab:participates ; 
                                    a owl:Restriction],
                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onClass demlab:ClinicalRecord ; 
                                    owl:onProperty demlab:hasClinicalRecord ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:Protocol ; 
                                    owl:onProperty demlab:participates ; 
                                    a owl:Restriction],
                                   foaf:Person.
demlab:PayBillTask a owl:Class;
                   rdfs:comment """- Three bills (Electricity/Gaz/Phone) are proposed. The participant has to pay the phone bill by check. 
- The check is well completed if the amount, order (i.e. Phone Company), date and signature are right."""@en;
                   rdfs:subClassOf demlab:SemiDirectedTask.
demlab:PersonWithDementia a owl:Class;
                          rdfs:comment "A Person with Dementia is defined as the participant whose clinical record contains a dementia clinical diagnosis"@en;
                          rdfs:seeAlso demlab:dementia,
                                       demlab:DiagnosisType,
                                       demlab:DiagnosisAssessment,
                                       demlab:ClinicalRecord;
                          rdfs:subClassOf demlab:Participant;
                          owl:equivalentClass [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                       [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                               [owl:someValuesFrom [owl:oneOf (demlab:dementia) ; 
                                                                                                                                                   a owl:Class] ; 
                                                                                                                               owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                               a owl:Restriction]) ; 
                                                                                                           a owl:Class] ; 
                                                                                       owl:onProperty demlab:containsAssessment ; 
                                                                                       a owl:Restriction]) ; 
                                                                   a owl:Class] ; 
                                               owl:onProperty demlab:hasClinicalRecord ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                       [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                               [owl:someValuesFrom [owl:oneOf (demlab:dementia) ; 
                                                                                                                                                   a owl:Class] ; 
                                                                                                                               owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                               a owl:Restriction]) ; 
                                                                                                           a owl:Class] ; 
                                                                                       owl:onProperty demlab:containsAssessment ; 
                                                                                       a owl:Restriction]) ; 
                                                                   a owl:Class] ; 
                                               owl:onProperty demlab:hasClinicalRecord ; 
                                               a owl:Restriction].
demlab:PersonWithPredementia a owl:Class;
                             rdfs:comment "A Person with Predementia is defined as the participant whose clinical record contains a predementia clinical diagnosis"@en;
                             rdfs:seeAlso demlab:predementia,
                                          demlab:DiagnosisType,
                                          demlab:DiagnosisAssessment,
                                          demlab:ClinicalRecord;
                             rdfs:subClassOf demlab:Participant;
                             owl:equivalentClass [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                          [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                                  [owl:someValuesFrom [owl:oneOf (demlab:predementia) ; 
                                                                                                                                                      a owl:Class] ; 
                                                                                                                                  owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                                  a owl:Restriction]) ; 
                                                                                                              a owl:Class] ; 
                                                                                          owl:onProperty demlab:containsAssessment ; 
                                                                                          a owl:Restriction]) ; 
                                                                      a owl:Class] ; 
                                                  owl:onProperty demlab:hasClinicalRecord ; 
                                                  a owl:Restriction],
                                                 [owl:someValuesFrom [owl:intersectionOf (demlab:ClinicalRecord
                                                                                          [owl:someValuesFrom [owl:intersectionOf (demlab:DiagnosisAssessment
                                                                                                                                  [owl:someValuesFrom [owl:oneOf (demlab:predementia) ; 
                                                                                                                                                      a owl:Class] ; 
                                                                                                                                  owl:onProperty demlab:hasClinicalDiagnosis ; 
                                                                                                                                  a owl:Restriction]) ; 
                                                                                                              a owl:Class] ; 
                                                                                          owl:onProperty demlab:containsAssessment ; 
                                                                                          a owl:Restriction]) ; 
                                                                      a owl:Class] ; 
                                                  owl:onProperty demlab:hasClinicalRecord ; 
                                                  a owl:Restriction].
demlab:PictureDescriptionTask a owl:Class;
                              rdfs:comment "The clinician shows to the participant one picture representing daily activity and asks the participants to give a verbal description of the picture in a few sentences"@en;
                              rdfs:subClassOf demlab:FreeDiscussionTask.
demlab:PictureDiscussionTask a owl:Class;
                             rdfs:comment "The clinician asks if the participant likes doing this activity and why"@en;
                             rdfs:subClassOf demlab:FreeDiscussionTask.
demlab:PrepareDrugBoxTask a owl:Class;
                          rdfs:comment """- 4 types of drugs are proposed to the participant. 
- The participant has to respect the posology prescribed (2 types of drugs at different moment of the day) and the date (day and moment of the day)."""@en;
                          rdfs:subClassOf demlab:SemiDirectedTask.
demlab:PrepareHotTeaTask a owl:Class;
                         rdfs:comment """- The participant has to switch on the electric kettle. 
- The participant has to pour the hot water on the glass containing the tea bag."""@en;
                         rdfs:subClassOf demlab:SemiDirectedTask.
demlab:Protocol a owl:Class;
                rdfs:comment "A Protocol instance contains information regarding the participant and the duration of the protocol session. It can be also associated with one or more ProtocolSteps that define the Tasks and the corresponding MeasuredData."@en;
                rdfs:seeAlso demlab:MeasuredData,
                             demlab:ProtocolStep,
                             demlab:Task;
                rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass time:Instant ; 
                                 owl:onProperty time:hasBeginning ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom demlab:ProtocolStep ; 
                                 owl:onProperty demlab:hasProtocolStep ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom demlab:ProtocolStep ; 
                                 owl:onProperty demlab:hasProtocolStep ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass time:Instant ; 
                                 owl:onProperty time:hasEnd ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass foaf:Person ; 
                                 owl:onProperty demlab:hasParticipant ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass time:Instant ; 
                                 owl:onProperty time:hasBeginning ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass time:Instant ; 
                                 owl:onProperty time:hasEnd ; 
                                 a owl:Restriction],
                                [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onClass foaf:Person ; 
                                 owl:onProperty demlab:hasParticipant ; 
                                 a owl:Restriction].
demlab:ProtocolStep a owl:Class;
                    rdfs:comment "A ProtocolStep defines the Tasks of interest. Three ProtocolStep types are currently defined in Dem@Care: DirectedActivities, SemiDirectedActivities and DiscussionWithTheClinician"@en;
                    rdfs:seeAlso demlab:SemiDirectedActivitiesStep,
                                 demlab:DirectedActivitiesStep,
                                 demlab:Task,
                                 demlab:DiscussionWithClinicianStep;
                    rdfs:subClassOf [owl:someValuesFrom demlab:Task ; 
                                     owl:onProperty demlab:involvesTask ; 
                                     a owl:Restriction],
                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onClass time:Instant ; 
                                     owl:onProperty time:hasEnd ; 
                                     a owl:Restriction],
                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onClass time:Instant ; 
                                     owl:onProperty time:hasEnd ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom demlab:Task ; 
                                     owl:onProperty demlab:involvesTask ; 
                                     a owl:Restriction],
                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onClass time:Instant ; 
                                     owl:onProperty time:hasBeginning ; 
                                     a owl:Restriction],
                                    [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onClass time:Instant ; 
                                     owl:onProperty time:hasBeginning ; 
                                     a owl:Restriction].
demlab:ReadArticleTask a owl:Class;
                       rdfs:comment """Three articles are proposed to the participant (Topics: Collection Cars; Cooking; Sightseeing). The three articles have the same words number and level of difficulty. Below each articles, the 3 following questions are asked
- Q1/ What is the topic of the article? 
- Q2/ What is the percentage of French interested in the … (Collection Car / Cooking / Sightseeing, text adapted to the article topic)? 
- Q3/ Who is interviewed?"""@en;
                       rdfs:subClassOf demlab:SemiDirectedTask.
demlab:SemiDirectedActivitiesStep a owl:Class;
                                  rdfs:comment "This ProtocolStep consists of assessing the autonomy of the participant. The participant has to organize himself/herself and correctly perform a list of Instrumental Activities of Daily Living (e.g., managing finance, using phone, preparing tea) within a timeframe of 15minutes. For this step, the participant is alone in the experimental setting and can refer to the instruction sheet of paper with the IADLs to perform at any time."@en;
                                  rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:AnswerPhoneTask
                                                                                   demlab:CallPsychologistTask
                                                                                   demlab:EstablishAccountBalanceTask
                                                                                   demlab:FindBusLineOnMapTask
                                                                                   demlab:LeaveRoomTask
                                                                                   demlab:PayBillTask
                                                                                   demlab:PrepareDrugBoxTask
                                                                                   demlab:PrepareHotTeaTask
                                                                                   demlab:Task
                                                                                   demlab:TurnOnTVTask
                                                                                   demlab:WaterPlantTask) ; 
                                                                      a owl:Class] ; 
                                                   owl:onProperty demlab:involvesTask ; 
                                                   a owl:Restriction],
                                                  [owl:allValuesFrom [owl:unionOf (demlab:AnswerPhoneTask
                                                                                   demlab:CallPsychologistTask
                                                                                   demlab:EstablishAccountBalanceTask
                                                                                   demlab:FindBusLineOnMapTask
                                                                                   demlab:LeaveRoomTask
                                                                                   demlab:PayBillTask
                                                                                   demlab:PrepareDrugBoxTask
                                                                                   demlab:PrepareHotTeaTask
                                                                                   demlab:Task
                                                                                   demlab:TurnOnTVTask
                                                                                   demlab:WaterPlantTask) ; 
                                                                      a owl:Class] ; 
                                                   owl:onProperty demlab:involvesTask ; 
                                                   a owl:Restriction],
                                                  demlab:ProtocolStep.
demlab:SemiDirectedTask a owl:Class;
                        rdfs:comment """In this Task the participant has to organize himself/herself and correctly perform a list of Instrumental Activities of Daily Living (e.g., managing finance, using phone, preparing tea) within a timeframe of 15minutes.

The relevant tasks are used for assessing:
- Cognitive abilities through activity repetitions, missed activities, order of activities
- Functional abilities for the completion of specific activities: e.g. hand trajectories
- Stress level"""@en;
                        rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:CognitiveAbilitiesData
                                                                         demlab:FunctionalAbilitiesData
                                                                         demlab:StressData) ; 
                                                            a owl:Class] ; 
                                         owl:onProperty demlab:measuredData ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom [owl:unionOf (demlab:CognitiveAbilitiesData
                                                                         demlab:FunctionalAbilitiesData
                                                                         demlab:StressData) ; 
                                                            a owl:Class] ; 
                                         owl:onProperty demlab:measuredData ; 
                                         a owl:Restriction],
                                        demlab:Task.
demlab:SentenceRepeatingTask a owl:Class;
                             rdfs:comment """- The participant is asked to repeat a short sentence after the assessor. 
- The assessor reads aloud a sentence. The participant repeats the sentence. The action is done once by sentence. Three sentences must be repeated.

This task is used for assessing:
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. verbal reaction time"""@en;
                             rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                              demlab:StressData
                                                                              demlab:VoiceData) ; 
                                                                 a owl:Class] ; 
                                              owl:onProperty demlab:measuredData ; 
                                              a owl:Restriction],
                                             [owl:allValuesFrom [owl:unionOf (demlab:LatencyData
                                                                              demlab:StressData
                                                                              demlab:VoiceData) ; 
                                                                 a owl:Class] ; 
                                              owl:onProperty demlab:measuredData ; 
                                              a owl:Restriction],
                                             demlab:DirectedTask.
demlab:StressData a owl:Class;
                  rdfs:comment "Explore stress level"@en;
                  rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty demlab:stressLevel ; 
                                   a owl:Restriction],
                                  [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onProperty demlab:stressLevel ; 
                                   a owl:Restriction],
                                  demlab:MeasuredData.
demlab:Task a owl:Class;
            rdfs:comment "Each Task involves the collection of one or more measurements (MeasuredData instances)."@en,
                         "";
            rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onClass time:Instant ; 
                             owl:onProperty time:hasEnd ; 
                             a owl:Restriction],
                            [owl:someValuesFrom demlab:MeasuredData ; 
                             owl:onProperty demlab:measuredData ; 
                             a owl:Restriction],
                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onClass time:Instant ; 
                             owl:onProperty time:hasBeginning ; 
                             a owl:Restriction],
                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onClass time:Instant ; 
                             owl:onProperty time:hasEnd ; 
                             a owl:Restriction],
                            [owl:someValuesFrom demlab:MeasuredData ; 
                             owl:onProperty demlab:measuredData ; 
                             a owl:Restriction],
                            [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onClass time:Instant ; 
                             owl:onProperty time:hasBeginning ; 
                             a owl:Restriction].
demlab:TurnOnTVTask a owl:Class;
                    rdfs:comment "The TV is turn off. The participant has to take the remote control and turns on the TV"@en;
                    rdfs:subClassOf demlab:SemiDirectedTask.
demlab:VoiceData a owl:Class;
                 rdfs:comment """- Vocal biomarkers extraction for cognitive load assessment
- Assessment of mutual influence of cognitive activities an motor activities
- Assessment of the verbal reaction time and the impact of cognitive load imposed by the sentence recall task on speech fluency
- Assessment of the level of the participants’ control over the neuromuscular mechanism of speech production"""@en;
                 rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:vowelDuration ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:pauseRate ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:speechRate ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:pauseRate ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:verbalReactionTime ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:vowelDuration ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:speechFluency ; 
                                  a owl:Restriction],
                                 demlab:MeasuredData,
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:articulation ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:verbalReactionTime ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:articulation ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:speechRate ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty demlab:speechFluency ; 
                                  a owl:Restriction].
demlab:WalkingCountingBackwardsTask a owl:Class;
                                    rdfs:comment """(DualTask) The clinician asks the participant to walk and count aloud backwards simultaneously: 
- From 305 until the end of the walking tasks; or 
- From 20 to 0 for participants who don’t manage to count backwards from 305 to 285 during the CountingBackwardsTask

This task is used for assessing:
- Gait: walking speed, step length, etc.
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level
- Voice: e.g. speech fluency and articulation"""@en;
                                    rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:GaitData
                                                                                     demlab:LatencyData
                                                                                     demlab:StressData
                                                                                     demlab:VoiceData) ; 
                                                                        a owl:Class] ; 
                                                     owl:onProperty demlab:measuredData ; 
                                                     a owl:Restriction],
                                                    [owl:allValuesFrom [owl:unionOf (demlab:GaitData
                                                                                     demlab:LatencyData
                                                                                     demlab:StressData
                                                                                     demlab:VoiceData) ; 
                                                                        a owl:Class] ; 
                                                     owl:onProperty demlab:measuredData ; 
                                                     a owl:Restriction],
                                                    demlab:DirectedTask.
demlab:WalkingTask a owl:Class;
                   rdfs:comment """(MonoTask) The clinician asks the participant to walk 4 meters across the room, to turn and then to come back (total walking distance: 8m).

This task is used for assessing:
- Gait: walking speed, step length, etc.
- Latency: time of latency between the end of instructions (stimulation) and the beginning of the task
- Stress level"""@en;
                   rdfs:subClassOf [owl:allValuesFrom [owl:unionOf (demlab:GaitData
                                                                    demlab:LatencyData
                                                                    demlab:StressData) ; 
                                                       a owl:Class] ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:GaitData ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:LatencyData ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   [owl:allValuesFrom [owl:unionOf (demlab:GaitData
                                                                    demlab:LatencyData
                                                                    demlab:StressData) ; 
                                                       a owl:Class] ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:GaitData ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom demlab:LatencyData ; 
                                    owl:onProperty demlab:measuredData ; 
                                    a owl:Restriction],
                                   demlab:DirectedTask.
demlab:WaterPlantTask a owl:Class;
                      rdfs:comment "The participant has to take the water can, and water the plant nearby."@en;
                      rdfs:subClassOf demlab:SemiDirectedTask.
demlab:Zone a owl:Class;
            rdfs:comment "Allows the definition of zones (areas) of interest, e.g. phone zone"@en.
demlab:activityStatus a owl:ObjectProperty;
                      rdfs:comment "The status of a semi-directed activity";
                      rdfs:domain demlab:CognitiveAbilitiesData;
                      rdfs:range demlab:ActivityStatusType;
                      rdfs:seeAlso demlab:CognitiveAbilitiesData,
                                   demlab:ActivityStatusType.
demlab:apathyInventory a owl:DatatypeProperty;
                       rdfs:comment "Apathy Inventory (AI) and diagnostic criteria for apathy"@en;
                       rdfs:domain demlab:NeuropsychiatricAndMoodAssessment;
                       rdfs:seeAlso demlab:NeuropsychiatricAndMoodAssessment.
demlab:areasOfInterestExplored a owl:ObjectProperty;
                               rdfs:comment "Zones of no interest"@en;
                               rdfs:domain demlab:OrganisationEfficiencyData;
                               rdfs:range demlab:Zone;
                               rdfs:seeAlso demlab:OrganisationEfficiencyData.
demlab:areasOfNoInterestExplored a owl:ObjectProperty;
                                 rdfs:comment "Zones of interest"@en;
                                 rdfs:domain demlab:OrganisationEfficiencyData;
                                 rdfs:range demlab:Zone;
                                 rdfs:seeAlso demlab:OrganisationEfficiencyData.
demlab:articulation a owl:DatatypeProperty;
                    rdfs:comment "Measures the articulation control of the participant"@en;
                    rdfs:domain demlab:VoiceData.
demlab:completed a demlab:ActivityStatusType,
                   owl:NamedIndividual.
demlab:compliantInstructionsOrder a owl:DatatypeProperty;
                                  rdfs:comment "Whether the participant followed the activity order suggested by the instructions sheet"@en;
                                  rdfs:domain demlab:CognitiveAbilitiesData;
                                  rdfs:seeAlso demlab:CognitiveAbilitiesData.
demlab:containsAssessment a owl:ObjectProperty;
                          rdfs:comment "A ClinicalRecord contains a ClinicalAssessment";
                          rdfs:domain demlab:ClinicalRecord;
                          rdfs:range demlab:ClinicalAssessment;
                          rdfs:seeAlso demlab:ClinicalRecord,
                                       demlab:ClinicalAssessment.
demlab:dementia a demlab:DiagnosisType,
                  owl:NamedIndividual.
demlab:distanceWalked a owl:DatatypeProperty;
                      rdfs:comment "Total distance walked"@en;
                      rdfs:domain demlab:OrganisationEfficiencyData;
                      rdfs:seeAlso demlab:OrganisationEfficiencyData.
demlab:dsm_ivDepressionCriteria a owl:DatatypeProperty;
                                rdfs:comment "DSM-IV Criteria for depression"@en;
                                rdfs:domain demlab:NeuropsychiatricAndMoodAssessment;
                                rdfs:seeAlso "http://en.wikipedia.org/wiki/Diagnostic_and_Statistical_Manual_of_Mental_Disorders"@en.
demlab:dynamicBalance a owl:DatatypeProperty;
                      rdfs:comment "Dynamical balance during the walking (e.g., people trajectory study)"@en;
                      rdfs:domain demlab:GaitData;
                      rdfs:seeAlso demlab:GaitData.
demlab:fabScore a owl:DatatypeProperty;
                rdfs:comment "Frontal Assessment Battery score"@en;
                rdfs:domain demlab:CognitiveAbilitiesAssessment;
                rdfs:seeAlso demlab:CognitiveAbilitiesAssessment.
demlab:freeAndCuedRemindingAssessment a owl:DatatypeProperty;
                                      rdfs:comment "The Free and Cued Selective Reminding Test"@en;
                                      rdfs:domain demlab:CognitiveAbilitiesAssessment;
                                      rdfs:seeAlso demlab:CognitiveAbilitiesAssessment.
demlab:handTrajectory a owl:ObjectProperty;
                      rdfs:comment "Associates an instance of FunctionalAbilitiesData with a hand trajectory type"@en;
                      rdfs:domain demlab:FunctionalAbilitiesData;
                      rdfs:range demlab:HandTrajectoryType;
                      rdfs:seeAlso demlab:HandTrajectoryType,
                                   demlab:FunctionalAbilitiesData.
demlab:hasClinicalDiagnosis a owl:ObjectProperty;
                            rdfs:comment "The value of the DiagnosisAssessment"@en;
                            rdfs:domain demlab:DiagnosisAssessment;
                            rdfs:range demlab:DiagnosisType;
                            rdfs:seeAlso demlab:DiagnosisType,
                                         demlab:DiagnosisAssessment;
                            rdfs:subPropertyOf owl:topObjectProperty.
demlab:hasClinicalRecord a owl:ObjectProperty;
                         rdfs:comment "Each participant is associated with a clinical record"@en;
                         rdfs:domain demlab:Participant;
                         rdfs:range demlab:ClinicalRecord;
                         rdfs:seeAlso demlab:ClinicalRecord.
demlab:hasMMSEScore a owl:DatatypeProperty;
                    rdfs:comment "Mini-Mental State Exam score"@en;
                    rdfs:domain demlab:CognitiveAbilitiesAssessment;
                    rdfs:seeAlso demlab:CognitiveAbilitiesAssessment.
demlab:hasParticipant a owl:ObjectProperty;
                      rdfs:comment "The participant of the protocol"@en;
                      rdfs:domain demlab:Protocol;
                      rdfs:range demlab:Participant;
                      rdfs:seeAlso demlab:Protocol,
                                   demlab:Person.
demlab:hasProtocolStep a owl:ObjectProperty;
                       rdfs:comment "Each Protocol consists of one or more ProtocolSteps"@en;
                       rdfs:domain demlab:Protocol;
                       rdfs:range demlab:ProtocolStep;
                       rdfs:seeAlso demlab:ProtocolStep,
                                    demlab:Protocol.
demlab:hasUPDRSScore a owl:DatatypeProperty;
                     rdfs:comment "Part III of the Unified Parkinson’s Disease Rating Scale"@en;
                     rdfs:domain demlab:MotricityAbilitiesAssessment;
                     rdfs:seeAlso demlab:MotricityAbilitiesAssessment.
demlab:healthy demlab:hasClinicalDiagnosis demlab:dementia;
               a demlab:DiagnosisType,
                 owl:NamedIndividual.
demlab:iadl_e a owl:DatatypeProperty;
              rdfs:comment "Allows the quantification of autonomy"@en;
              rdfs:domain demlab:AutonomyAssessment;
              rdfs:seeAlso demlab:AutonomyAssessment.
demlab:incomplete a demlab:ActivityStatusType,
                    owl:NamedIndividual.
demlab:involvesTask a owl:ObjectProperty;
                    rdfs:comment "Each ProtocolStep involves one or more Tasks"@en;
                    rdfs:domain demlab:ProtocolStep;
                    rdfs:range demlab:Task;
                    rdfs:seeAlso demlab:Task,
                                 demlab:ProtocolStep.
demlab:isClinicalRecordOf a owl:ObjectProperty;
                          owl:inverseOf demlab:hasClinicalRecord.
demlab:latency a owl:DatatypeProperty;
               rdfs:comment "Time of latency between the end of instructions (stimulation) and the beginning of the task"@en;
               rdfs:domain demlab:LatencyData;
               rdfs:seeAlso demlab:LatencyData.
demlab:measuredData a owl:ObjectProperty;
                    rdfs:domain demlab:Task;
                    rdfs:range demlab:MeasuredData;
                    rdfs:seeAlso demlab:Task,
                                 demlab:MeasuredData,
                                 "Associates a Task with a MeasuredData instance"@en.
demlab:npi a owl:DatatypeProperty;
           rdfs:comment "Neuropsychiatric Inventory"@en;
           rdfs:domain demlab:NeuropsychiatricAndMoodAssessment;
           rdfs:seeAlso demlab:NeuropsychiatricAndMoodAssessment.
demlab:omitted a demlab:ActivityStatusType,
                 owl:NamedIndividual.
demlab:participates a owl:ObjectProperty;
                    rdfs:seeAlso demlab:hasParticipant;
                    owl:inverseOf demlab:hasParticipant.
demlab:pauseRate a owl:DatatypeProperty;
                 rdfs:comment "Pause rate during sentence repetition and mono/dual tasks"@en;
                 rdfs:domain demlab:VoiceData;
                 rdfs:seeAlso demlab:WalkingCountingBackwardsTask,
                              demlab:VoiceData,
                              demlab:SentenceRepeatingTask,
                              demlab:CountingBackwardsTask,
                              demlab:ArticulationControlTask.
demlab:predementia a demlab:DiagnosisType,
                     owl:NamedIndividual.
demlab:repetitions a owl:DatatypeProperty;
                   rdfs:comment "Number of repetitions during semi-directed activities"@en;
                   rdfs:domain demlab:CognitiveAbilitiesData;
                   rdfs:seeAlso demlab:SemiDirectedTask.
demlab:shortCognitiveBatteryAssessment a owl:DatatypeProperty;
                                       rdfs:comment "Short Cognitive Battery"@en;
                                       rdfs:domain demlab:CognitiveAbilitiesAssessment;
                                       rdfs:seeAlso demlab:CognitiveAbilitiesAssessment.
demlab:speechFluency a owl:DatatypeProperty;
                     rdfs:comment "Speech fluency during sentence repetition and picture description tasks"@en;
                     rdfs:domain demlab:VoiceData;
                     rdfs:seeAlso demlab:VoiceData.
demlab:speechRate a owl:DatatypeProperty;
                  rdfs:comment "Speech fluency during sentence repetition and picture description tasks"@en;
                  rdfs:domain demlab:VoiceData;
                  rdfs:seeAlso demlab:VoiceData.
demlab:stepLength a owl:DatatypeProperty;
                  rdfs:comment "Step length"@en;
                  rdfs:domain demlab:GaitData;
                  rdfs:seeAlso demlab:GaitData.
demlab:stoppingDisplacement a owl:DatatypeProperty;
                            rdfs:comment "Stopping displacement during walking"@en;
                            rdfs:domain demlab:GaitData;
                            rdfs:seeAlso demlab:GaitData.
demlab:stressLevel a owl:DatatypeProperty;
                   rdfs:domain demlab:StressData;
                   rdfs:seeAlso demlab:StressData,
                                "Stress level"@en.
demlab:trailMakingTest a owl:DatatypeProperty;
                       rdfs:comment "Trail making test A and B"@en;
                       rdfs:domain demlab:CognitiveAbilitiesAssessment;
                       rdfs:seeAlso demlab:CognitiveAbilitiesAssessment.
demlab:verbalReactionSpontaneity a owl:DatatypeProperty;
                                 rdfs:comment "Time between the end of assessor’s speech and the beginning of participant’s speech (Discussion Task)"@en;
                                 rdfs:domain demlab:DiscussionInvolvementData;
                                 rdfs:seeAlso demlab:DiscussionInvolvementData.
demlab:verbalReactionTime a owl:DatatypeProperty;
                          rdfs:comment "Time interval between the end of assessor’s speech and the beginning of participant’s speech (Sentence Repetition Task)"@en;
                          rdfs:domain demlab:VoiceData;
                          rdfs:seeAlso demlab:VoiceData.
demlab:vowelDuration a owl:DatatypeProperty;
                     rdfs:comment demlab:VoiceData;
                     rdfs:domain demlab:VoiceData;
                     rdfs:seeAlso "Vowel duration"@en;
                     rdfs:subPropertyOf owl:topDataProperty.
demlab:walkingSpeed a owl:DatatypeProperty;
                    rdfs:comment "Walking speed"@en;
                    rdfs:domain demlab:GaitData;
                    rdfs:seeAlso demlab:GaitData.
demlab:walkingSpeedInstantaneous a owl:DatatypeProperty;
                                 rdfs:comment "Walking speed instantaneous (mono task walking activity/dual task)"@en;
                                 rdfs:domain demlab:GaitData;
                                 rdfs:seeAlso demlab:GaitData.
xsd:date a rdfs:Datatype.
skos:note a owl:AnnotationProperty.
