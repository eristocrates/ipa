@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ic: <http://ontology.eil.utoronto.ca/icontact.owl#>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix ccrel: <http://creativecommons.org/ns#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix wgspos: <http://www.w3.org/2003/01/geo/wgs84_pos#>.

_:B8c8014a31a30c1475eddc86854b88a44 a owl:AllDisjointClasses;
                                    owl:members (ic:Address
                                                 ic:AddressType
                                                 ic:DaysOfWeek
                                                 ic:HoursOfOperation
                                                 ic:PhoneNumber
                                                 ic:PhoneType
                                                 ic:StreetDirection
                                                 ic:StreetType).
ccrel:license a owl:AnnotationProperty.
<http://ontology.eil.utoronto.ca/icontact.owl> ccrel:license "http://creativecommons.org/licenses/by/3.0/";
                                               dcterms:creator """Mark S. Fox, http://eil.utoronto.ca/profiles/foxpro.html
Enterprise Integration Laboratory, http://eil.utoronto.ca
University of Toronto, 
msf@eil.utoronto.ca"""@en;
                                               dcterms:description """International Contact Ontology: 

http://ontology.eil.utoronto.ca/icontact.html

This ontology provides basic classes and more detailed properties for  representating international street addresses, phone numbers and emails.  Rather than using existing ontologies, such as vcard, it was decided to create a new one as the vcard and foaf ignore the details of international addresses, phone numbers, etc.

The important part of the ontology are the object and data properties used to describe addresses primarily and phone numbers."""@en;
                                               dcterms:modified "16 April 2015"@en;
                                               dcterms:title "International Contact (Address) Ontology: Addresses, phone numbers and emails."@en;
                                               vann:preferredNamespacePrefix "ic";
                                               vann:preferredNamespaceUri "http://ontology.eil.utoronto.ca/icontact.owl#";
                                               a owl:Ontology;
                                               adms:relatedDocumentation "http://ontology.eil.utoronto.ca/icontact.html".
ic:Address dcterms:description """Address is the main concept for a contact.  It has been designed to represent any type of address in the world, including India and the UK.  For example, the property hasBuilding is important in many UK and Indian addresses to further identify the person or business location.

Street information is divided into separate properties to fully indentify direction (hasStreetDirection), Type (hasStreetType), etc.  See the associated list of properties for more."""@en;
           a owl:Class;
           rdfs:label "Address"@en;
           rdfs:subClassOf [owl:allValuesFrom xsd:string ; 
                            owl:onProperty ic:hasBuilding ; 
                            a owl:Restriction],
                           [owl:allValuesFrom xsd:nonNegativeInteger ; 
                            owl:onProperty ic:hasUnitNumber ; 
                            a owl:Restriction],
                           [owl:allValuesFrom xsd:string ; 
                            owl:onProperty ic:hasCitySection ; 
                            a owl:Restriction],
                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onClass schema:Country ; 
                            owl:onProperty ic:hasCountry ; 
                            a owl:Restriction],
                           ic:iContactThing,
                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onClass schema:City ; 
                            owl:onProperty ic:hasCity ; 
                            a owl:Restriction],
                           [owl:onDataRange xsd:string ; 
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty wgspos:lat ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ic:StreetDirection ; 
                            owl:onProperty ic:hasStreetDirection ; 
                            a owl:Restriction],
                           [owl:allValuesFrom xsd:string ; 
                            owl:onProperty ic:hasPostalCode ; 
                            a owl:Restriction],
                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onClass schema:State ; 
                            owl:onProperty ic:hasState ; 
                            a owl:Restriction],
                           [owl:allValuesFrom xsd:string ; 
                            owl:onProperty ic:hasStreet ; 
                            a owl:Restriction],
                           [owl:onDataRange xsd:string ; 
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty wgspos:long ; 
                            a owl:Restriction],
                           [owl:onDataRange xsd:nonNegativeInteger ; 
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                            owl:onProperty ic:hasStreetNumber ; 
                            a owl:Restriction],
                           [owl:allValuesFrom ic:StreetType ; 
                            owl:onProperty ic:hasStreetType ; 
                            a owl:Restriction].
ic:AddressType dcterms:description "Different type for home, office, cottage, etc."@en;
               a owl:Class;
               rdfs:label "Address Type"@en;
               rdfs:subClassOf ic:iContactThing;
               owl:equivalentClass [owl:oneOf (ic:Cottage
                                               ic:Home
                                               ic:Work) ; 
                                    a owl:Class].
ic:Avenue a owl:NamedIndividual;
          rdfs:label "Avenue"@en.
ic:Boulevard a owl:NamedIndividual;
             rdfs:label "Boulevard"@en.
ic:CellNumber a owl:Class;
              rdfs:label "Mobile Telephone Number"@en;
              rdfs:subClassOf [owl:hasValue ic:CellPhone ; 
                               owl:onProperty ic:hasPhoneType ; 
                               a owl:Restriction],
                              ic:PhoneNumber.
ic:CellPhone a owl:NamedIndividual;
             rdfs:label "Cell Phone"@en.
ic:Circle a owl:NamedIndividual;
          rdfs:label "Circle"@en.
ic:Cottage a owl:NamedIndividual;
           rdfs:label "Cottage Address"@en.
ic:CottageAddress a owl:Class;
                  rdfs:label "Cottage Address"@en;
                  rdfs:subClassOf [owl:hasValue ic:Cottage ; 
                                   owl:onProperty ic:hasAddressType ; 
                                   a owl:Restriction],
                                  ic:Address.
ic:Crescent a owl:NamedIndividual;
            rdfs:label "Crescent"@en.
ic:DaysOfWeek a owl:Class;
              rdfs:label "Days of the Week"@en;
              rdfs:subClassOf ic:iContactThing.
ic:Drive a owl:NamedIndividual;
         rdfs:label "Drive"@en.
ic:East a owl:NamedIndividual;
        rdfs:label "East"@en.
ic:FaxNumber a owl:Class;
             rdfs:label "Fax Telephone Number"@en;
             rdfs:subClassOf [owl:hasValue ic:FaxPhone ; 
                              owl:onProperty ic:hasPhoneType ; 
                              a owl:Restriction],
                             ic:PhoneNumber.
ic:FaxPhone a owl:NamedIndividual;
            rdfs:label "Fax Line"@en.
ic:Friday a owl:NamedIndividual,
            ic:DaysOfWeek;
          rdfs:label "Friday"@en.
ic:Home a owl:NamedIndividual;
        rdfs:label "Home Address"@en.
ic:HomeAddress a owl:Class;
               rdfs:label "Home Address"@en;
               rdfs:subClassOf [owl:hasValue ic:Home ; 
                                owl:onProperty ic:hasAddressType ; 
                                a owl:Restriction],
                               ic:Address.
ic:HomeNumber a owl:Class;
              rdfs:label "Home Telephone Number"@en;
              rdfs:subClassOf [owl:hasValue ic:HomePhone ; 
                               owl:onProperty ic:hasPhoneType ; 
                               a owl:Restriction],
                              ic:PhoneNumber.
ic:HomePhone a owl:NamedIndividual;
             rdfs:label "Home Phone"@en.
ic:HoursOfOperation dcterms:description """HoursOfOperation class provides the ability to define when the contact \"opens\" and \"closes\". Used for businesses."""@en;
                    a owl:Class;
                    rdfs:subClassOf [owl:onDataRange xsd:dateTime ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ic:hasClosingTime ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom ic:DaysOfWeek ; 
                                     owl:onProperty ic:dayofWeek ; 
                                     a owl:Restriction],
                                    [owl:onDataRange xsd:dateTime ; 
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                     owl:onProperty ic:hasOpeningTime ; 
                                     a owl:Restriction],
                                    ic:iContactThing.
ic:Monday a owl:NamedIndividual,
            ic:DaysOfWeek;
          rdfs:label "Monday"@en.
ic:North a owl:NamedIndividual;
         rdfs:label "North"@en.
ic:OperatingProperty dcterms:description "Properties that define the hours of operation of the contact."@en;
                     a owl:ObjectProperty;
                     rdfs:subPropertyOf ic:contactProperty.
ic:PhoneNumber dcterms:description "PhoneNumber is another core class. It is divided into country code, and phone number."@en;
               a owl:Class;
               rdfs:label "Phone Number"@en;
               rdfs:subClassOf [owl:onDataRange xsd:nonNegativeInteger ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty ic:hasPhoneNumber ; 
                                a owl:Restriction],
                               [owl:onDataRange xsd:nonNegativeInteger ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty ic:hasCountryCode ; 
                                a owl:Restriction],
                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onClass ic:PhoneType ; 
                                owl:onProperty ic:hasPhoneType ; 
                                a owl:Restriction],
                               [owl:onDataRange xsd:nonNegativeInteger ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty ic:hasAreaCode ; 
                                a owl:Restriction],
                               ic:iContactThing.
ic:PhoneType dcterms:description "Types of phoned include home, cell, work, etc."@en;
             a owl:Class;
             rdfs:label "Phone Type"@en;
             rdfs:subClassOf ic:iContactThing;
             owl:equivalentClass [owl:oneOf (ic:TollFreePhone
                                             ic:CellPhone
                                             ic:FaxPhone
                                             ic:WorkPhone
                                             ic:HomePhone) ; 
                                  a owl:Class].
ic:Road a owl:NamedIndividual;
        rdfs:label "Road"@en.
ic:Saturday a owl:NamedIndividual,
              ic:DaysOfWeek;
            rdfs:label "Saturday"@en.
ic:SchemaOrgThing a owl:Class.
ic:South a owl:NamedIndividual;
         rdfs:label "South"@en.
ic:Street a owl:NamedIndividual;
          rdfs:label "Street"@en.
ic:StreetDirection a owl:Class;
                   rdfs:label "Street Direction"@en;
                   rdfs:subClassOf ic:iContactThing;
                   owl:equivalentClass [owl:oneOf (ic:South
                                                   ic:West
                                                   ic:East
                                                   ic:North) ; 
                                        a owl:Class].
ic:StreetType a owl:Class;
              rdfs:label "Street Type"@en;
              rdfs:subClassOf ic:iContactThing;
              owl:equivalentClass [owl:oneOf (ic:Drive
                                              ic:Circle
                                              ic:Boulevard
                                              ic:Crescent
                                              ic:Avenue
                                              ic:Road
                                              ic:Street) ; 
                                   a owl:Class].
ic:Sunday a owl:NamedIndividual,
            ic:DaysOfWeek;
          rdfs:label "Sunday"@en.
ic:Thursday a owl:NamedIndividual,
              ic:DaysOfWeek;
            rdfs:label "Thursday"@en.
ic:TollFreeNumber a owl:Class;
                  rdfs:label "Toll  Free Telephone Number"@en;
                  rdfs:subClassOf [owl:hasValue ic:TollFreePhone ; 
                                   owl:onProperty ic:hasPhoneType ; 
                                   a owl:Restriction],
                                  ic:PhoneNumber.
ic:TollFreePhone a owl:NamedIndividual;
                 rdfs:label "Toll Free Number"@en.
ic:Tuesday a owl:NamedIndividual,
             ic:DaysOfWeek;
           rdfs:label "Tuesday"@en.
ic:Wednesday a owl:NamedIndividual,
               ic:DaysOfWeek;
             rdfs:label "Wednesday"@en.
ic:West a owl:NamedIndividual;
        rdfs:label "West"@en.
ic:Work a owl:NamedIndividual;
        rdfs:label "WorkAddress"@en.
ic:WorkAddress a owl:Class;
               rdfs:label "Work Address"@en;
               rdfs:subClassOf [owl:hasValue ic:Work ; 
                                owl:onProperty ic:hasAddressType ; 
                                a owl:Restriction],
                               ic:Address.
ic:WorkNumber a owl:Class;
              rdfs:label "Work Telephone Number"@en;
              rdfs:subClassOf [owl:hasValue ic:WorkPhone ; 
                               owl:onProperty ic:hasPhoneType ; 
                               a owl:Restriction],
                              ic:PhoneNumber.
ic:WorkPhone a owl:NamedIndividual;
             rdfs:label "Work Phone"@en.
ic:addressDataProperty a owl:DatatypeProperty;
                       rdfs:subPropertyOf ic:hasContactDataProperty.
ic:addressProperty a owl:ObjectProperty;
                   rdfs:domain ic:Address;
                   rdfs:subPropertyOf ic:contactProperty.
ic:contactProperty a owl:ObjectProperty.
ic:dayofWeek a owl:ObjectProperty;
             rdfs:comment """Specifies the day of the week, e.g., Monday, that the times apply to.  This is the default for that day and can be overidden by the \"hasDate\" property."""@en;
             rdfs:range ic:DaysOfWeek;
             rdfs:subPropertyOf ic:OperatingProperty.
ic:emailDataProperty a owl:DatatypeProperty;
                     rdfs:subPropertyOf ic:hasContactDataProperty.
ic:hasAddress a owl:ObjectProperty;
              rdfs:comment "hasAddress links any class to the Address class."@en;
              rdfs:range ic:Address;
              rdfs:subPropertyOf ic:contactProperty.
ic:hasAddressType a owl:ObjectProperty;
                  rdfs:label "has Address Type"@en;
                  rdfs:range ic:AddressType;
                  rdfs:subPropertyOf ic:addressProperty.
ic:hasAreaCode a owl:DatatypeProperty;
               rdfs:label "has Area Code"@en;
               rdfs:subPropertyOf ic:telephoneDataProperty.
ic:hasBuilding dcterms:description "The building where the address is located.  Often used in countries like England, India and Japan."@en;
               a owl:DatatypeProperty;
               rdfs:label "has Building"@en;
               rdfs:subPropertyOf ic:addressDataProperty.
ic:hasCity dcterms:description "has City"@en;
           a owl:ObjectProperty;
           rdfs:subPropertyOf ic:addressProperty.
ic:hasCitySection dcterms:description "The section of the city where the address is located.  Often used in countries like England, India and Japan."@en;
                  a owl:DatatypeProperty;
                  rdfs:label "has City Section"@en;
                  rdfs:subPropertyOf ic:addressDataProperty.
ic:hasClosingTime a owl:DatatypeProperty;
                  rdfs:label "has Closing Time"@en;
                  rdfs:range xsd:dateTime;
                  rdfs:subPropertyOf ic:operatingDataProperty.
ic:hasContactDataProperty a owl:DatatypeProperty.
ic:hasCountry a owl:ObjectProperty;
              rdfs:label "has Country"@en;
              rdfs:subPropertyOf ic:addressProperty.
ic:hasCountryCode a owl:DatatypeProperty;
                  rdfs:label "has Country Code"@en;
                  rdfs:subPropertyOf ic:telephoneDataProperty.
ic:hasDate dcterms:description "Specifies the opening and closing times for a specific date.  For example, used to provide times for a holiday which deviates from the norm."@en;
           a owl:DatatypeProperty;
           rdfs:label "has Date"@en;
           rdfs:range xsd:dateTime;
           rdfs:subPropertyOf ic:operatingDataProperty.
ic:hasEmail a owl:ObjectProperty;
            rdfs:label "has Email"@en;
            rdfs:subPropertyOf ic:contactProperty.
ic:hasGeoCoordinates a owl:ObjectProperty;
                     rdfs:label "has Geo Coordinates"@en;
                     rdfs:subPropertyOf ic:addressProperty.
ic:hasLocation dcterms:description "Closet street intersection for the organization."@en;
               a owl:DatatypeProperty;
               rdfs:label "has Location"@en;
               rdfs:range xsd:string;
               rdfs:subPropertyOf ic:hasContactDataProperty.
ic:hasOpeningTime a owl:DatatypeProperty;
                  rdfs:label "has Opening Time"@en;
                  rdfs:range xsd:dateTime;
                  rdfs:subPropertyOf ic:operatingDataProperty.
ic:hasOperatingHours a owl:ObjectProperty;
                     rdfs:label "has Operating Hours"@en;
                     rdfs:range ic:HoursOfOperation;
                     rdfs:subPropertyOf ic:OperatingProperty.
ic:hasPersonalEmail a owl:DatatypeProperty;
                    rdfs:label "has Personal Email"@en;
                    rdfs:subPropertyOf ic:emailDataProperty.
ic:hasPhoneNumber a owl:DatatypeProperty;
                  rdfs:label "has Phone Number"@en;
                  rdfs:subPropertyOf ic:telephoneDataProperty.
ic:hasPhoneType a owl:ObjectProperty;
                rdfs:label "has Phone Type"@en;
                rdfs:range ic:PhoneType;
                rdfs:subPropertyOf ic:contactProperty.
ic:hasPostalCode a owl:DatatypeProperty;
                 rdfs:label "has Postal Code"@en;
                 rdfs:subPropertyOf ic:addressDataProperty.
ic:hasState a owl:ObjectProperty;
            rdfs:label "has State"@en;
            rdfs:subPropertyOf ic:addressProperty.
ic:hasStreet a owl:DatatypeProperty;
             rdfs:label "has Street"@en;
             rdfs:subPropertyOf ic:addressDataProperty.
ic:hasStreetDirection a owl:ObjectProperty;
                      rdfs:domain ic:Address;
                      rdfs:label "has Street Direction"@en;
                      rdfs:range ic:StreetDirection;
                      rdfs:subPropertyOf ic:addressProperty.
ic:hasStreetNumber a owl:DatatypeProperty;
                   rdfs:label "has Street Number"@en;
                   rdfs:subPropertyOf ic:addressDataProperty.
ic:hasStreetType a owl:ObjectProperty;
                 rdfs:domain ic:Address;
                 rdfs:label "has Street Type"@en;
                 rdfs:range ic:StreetType;
                 rdfs:subPropertyOf ic:addressProperty.
ic:hasTelephone a owl:ObjectProperty;
                rdfs:label "has Telephone"@en;
                rdfs:subPropertyOf ic:contactProperty.
ic:hasUnitNumber a owl:DatatypeProperty;
                 rdfs:label "has Unit Number"@en;
                 rdfs:subPropertyOf ic:addressDataProperty.
ic:hasWebSite a owl:DatatypeProperty;
              rdfs:label "has Web Site"@en;
              rdfs:range xsd:string;
              rdfs:subPropertyOf ic:hasContactDataProperty.
ic:hasWorkEmail a owl:DatatypeProperty;
                rdfs:label "has Work Email"@en;
                rdfs:subPropertyOf ic:emailDataProperty.
ic:iContactThing a owl:Class.
ic:operatingDataProperty a owl:DatatypeProperty;
                         rdfs:subPropertyOf ic:hasContactDataProperty.
ic:telephoneDataProperty a owl:DatatypeProperty;
                         rdfs:subPropertyOf ic:hasContactDataProperty.
dcterms:creator a owl:AnnotationProperty.
dcterms:description a owl:AnnotationProperty.
dcterms:modified a owl:AnnotationProperty.
dcterms:title a owl:AnnotationProperty.
vann:preferredNamespacePrefix a owl:AnnotationProperty.
vann:preferredNamespaceUri a owl:AnnotationProperty.
schema:City a owl:Class;
            rdfs:subClassOf ic:SchemaOrgThing.
schema:Country a owl:Class;
               rdfs:subClassOf ic:SchemaOrgThing.
schema:GeoCoordinates a owl:Class;
                      rdfs:subClassOf ic:SchemaOrgThing.
schema:State a owl:Class;
             rdfs:subClassOf ic:SchemaOrgThing.
wgspos:lat a owl:DatatypeProperty;
           rdfs:label "lattitude"@en;
           rdfs:range xsd:string;
           rdfs:subPropertyOf ic:addressDataProperty.
wgspos:long a owl:DatatypeProperty;
            rdfs:label "longitude"@en;
            rdfs:range xsd:string;
            rdfs:subPropertyOf ic:addressDataProperty.
adms:relatedDocumentation a owl:AnnotationProperty.
