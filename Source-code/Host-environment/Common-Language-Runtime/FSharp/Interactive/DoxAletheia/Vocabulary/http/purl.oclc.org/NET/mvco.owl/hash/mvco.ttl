mvco:MakeWorkInstance a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The Action of making an Instance from a Work Manifestation."@en;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:WorkInstance ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>];
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeInstance
                                                                                                                       [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                       <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:WorkManifestation ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                       a <http://www.w3.org/2002/07/owl#Class>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeWorkInstanceCopy a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "The Action of making a WorkInstanceCopy"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:WorkInstanceCopy ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>];
                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeCopy
                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:WorkInstance ; 
