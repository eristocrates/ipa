                           rdfs:comment "The action of making a Manifestation from Work."@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:WorkManifestation ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeManifestation
                                                                                                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Work ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>];
                           <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeWorkManifestationCopy a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "The Action of making a WorkManifestationCopy"@en;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                                <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:WorkManifestationCopy ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>];
                               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeCopy
                                                                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:WorkManifestation ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>];
                               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Manifestation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An object or event which is an expression of a Work."@en;
                   rdfs:subClassOf mvco:IPEntity,
                                   [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                    <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeManifestation ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2002/07/owl#disjointWith> mvco:Product,
                                                                mvco:Work;
                   <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:ModifyCopy a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Action of modifying a copy."@en;
                rdfs:subClassOf mvco:EndUserAction;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MoveContent a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The action of moving the location of a content"@en;
                 rdfs:subClassOf mvco:EndUserAction;
                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Permission a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Authorisation from one RightsOwner to one or more Users to perform one or more Actions on a given IPEntity."@en;
                rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                                [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:User ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> mvco:issuedBy ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> mvco:permitsAction ; 
                                 <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Action ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> mvco:hasRequired ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Fact ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> mvco:issuedBy ; 
                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> mvco:permitsAction ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Action ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                <http://www.w3.org/2002/07/owl#disjointWith> mvco:User;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Produce mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Instantiator"^^xsd:anyURI,
                               "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI;
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The Function of making Products"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (mvco:Copy
                                                                                                                      mvco:Instance
                                                                                                                      mvco:Manifestation) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>] ; 
                              <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                              <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Product ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             mvco:Action;
             <http://www.w3.org/2002/07/owl#disjointWith> mvco:PublicCommunication,
                                                          mvco:Synchronise;
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Producer a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A User who produces a Product from an Instance."@en;
              rdfs:subClassOf mvco:User;
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                               <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Produce ; 
                                                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Product a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Content Item that adds value to IP Entities by including them with an appropriate Licence for the purpose of Publishing"@en;
             rdfs:subClassOf mvco:IPEntity,
                             [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                              <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Produce ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#disjointWith> mvco:Work;
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:PublicCommunication mvco:impliesAlso "http://purl.oclc.org/NET/mvco.owl#Render"^^xsd:anyURI;
                         mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI,
                                           "http://purl.oclc.org/NET/mvco.owl#Producer"^^xsd:anyURI;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The Function of publicly displaying/performing, e.g. live performance, radio, television, internet streaming, multicast of Instances and Manifestations, and download"@en;
                         rdfs:subClassOf mvco:Action,
                                         [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (mvco:Copy
                                                                                                                                  mvco:Instance
                                                                                                                                  mvco:Product) ; 
                                                                                         a <http://www.w3.org/2002/07/owl#Class>] ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2002/07/owl#disjointWith> mvco:Synchronise;
                         <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Render a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The Action of generating a human-perceivable signal"@en;
            rdfs:subClassOf mvco:EndUserAction;
            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Stream a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The Function of Delivering Content to a Device where the transferred Content is Processed for Rendering only and not Stored"@en;
            rdfs:subClassOf mvco:PublicCommunication;
            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Synchronise mvco:impliesAlso "http://purl.oclc.org/NET/mvco.owl#ModifyCopy"^^xsd:anyURI,
                                  "http://purl.oclc.org/NET/mvco.owl#Render"^^xsd:anyURI;
                 mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI;
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The Action of concurrently performing/displaying two distinct IP Entities each for a different human sense e.g. text and audio or video and song"@en;
                 rdfs:subClassOf mvco:Action,
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Work ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:UseData a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Data documenting the functions Actions performed by a Device User on a content item and the associated context";
             <http://www.w3.org/2002/07/owl#disjointWith> mvco:User;
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:User a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Any person or legal entity in a Value-Chain connecting (and including) Creator and End-User."@en;
          rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                          [<http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                           <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Action ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Collective ; 
                           <http://www.w3.org/2002/07/owl#onProperty> mvco:belongsTo ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Work a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A creation that retains intellectual or artistic attributes independently of its Manifestations"@en;
          rdfs:subClassOf mvco:IPEntity,
                          [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:CreateWork ; 
                           <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:WorkInstance a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An object or event which is an example of an Identified Manifestation of a Work (e.g. a File)"@en;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Instance
                                                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                   <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeWorkInstance ; 
                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                   a <http://www.w3.org/2002/07/owl#Class>];
                  <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:WorkInstanceCopy a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A copy of a WorkInstance"@en;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Copy
                                                                                                                       [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeWorkInstanceCopy ; 
                                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                       a <http://www.w3.org/2002/07/owl#Class>];
                      <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:WorkManifestation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An object or event which is an expression of a Manifestation of a Work"@en;
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Manifestation
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeWorkManifestation ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>];
                       <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:WorkManifestationCopy a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A copy of a WorkManifestation."@en;
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Copy
                                                                                                                            [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeWorkManifestationCopy ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>];
                           <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:actOnBehalfOf a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                   rdfs:comment "Relates a ContentHandler with the User under the auspices of which the ContentHandler operates."@en;
                   rdfs:domain mvco:ContentHandler;
                   rdfs:range mvco:User;
                   <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:actedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "Role who has executed the Action";
             rdfs:domain mvco:Action;
             rdfs:range mvco:User;
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:actedOver a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Specifies which IPEntity is the object the Action";
               rdfs:domain mvco:Action;
               rdfs:range mvco:IPEntity;
               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:acts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
          rdfs:comment "Performance of an Action by a User";
          rdfs:domain mvco:User;
          rdfs:range mvco:Action;
          <http://www.w3.org/2002/07/owl#inverseOf> mvco:actedBy;
          <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:belongsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:comment "Relates a User with a Collective"@en;
               rdfs:domain mvco:User;
               rdfs:range mvco:Collective;
               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:hasRequired a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "For a Permission to be valid, the Fact has to hold";
                 rdfs:domain mvco:Permission;
                 rdfs:range mvco:Fact;
                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:hasRightsOwner a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                    rdfs:comment "Defines the owner of the Rights over an IP Entity."@en;
                    rdfs:domain mvco:IPEntity;
                    rdfs:range mvco:User;
                    <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:hasSocialTag a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "Attributes a social tag: text, commentary, critique, synopsis (e.g. FOAF)...";
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (mvco:IPEntity
                                                                        mvco:User) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:range xsd:string;
                  <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:impliesAlso a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
mvco:isDigital a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "distinguishes between digital management of both digital and non digital IP Entities";
               rdfs:domain mvco:IPEntity;
               rdfs:range xsd:boolean;
               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:isMadeUpOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates a composite IPEntity with its constituent IPEntities"@en;
                rdfs:domain mvco:IPEntity;
                rdfs:range mvco:IPEntity;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:isRightsOwnerOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Declares who is the rights owner of this IP Entity";
                     rdfs:domain mvco:User;
                     rdfs:range mvco:IPEntity;
                     <http://www.w3.org/2002/07/owl#inverseOf> mvco:hasRightsOwner;
                     <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:isTrue a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              <http://www.w3.org/2002/07/owl#FunctionalProperty>;
            rdfs:comment "Truth of a proposition";
            rdfs:domain mvco:Fact;
            rdfs:range xsd:boolean;
            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:issuedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Declares who has issued a permission";
              rdfs:domain mvco:Permission;
              rdfs:range mvco:User;
              <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:permitsAction a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relation used to express the Actions that are allowed to be performed."@en;
                   rdfs:domain mvco:Permission;
                   rdfs:range mvco:Action;
                   <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:resultedFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "The dependance of one IP Entity on another."@en;
                  rdfs:domain mvco:IPEntity;
                  rdfs:range mvco:Action;
                  <http://www.w3.org/2002/07/owl#inverseOf> mvco:resultsIn;
                  <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:resultsIn a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#FunctionalProperty>;
               rdfs:comment "Declares which IPentity arises as a result of the execution of an Action. It is a functional relation."@en;
               rdfs:domain mvco:Action;
               rdfs:range mvco:IPEntity;
               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:rightGivenBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                          <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                        rdfs:comment "Title of the ontology";
                                        rdfs:range xsd:string.
<http://www.w3.org/2002/07/owl#Thing> a <http://www.w3.org/2002/07/owl#Class>.
<urn:mpeg:mpeg21:2002:01-DII-NS#RelatedIdentifier> a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                                                   rdfs:comment "It allows the identification information that is related to a Digital Item (or parts thereof).";
                                                   rdfs:domain mvco:IPEntity;
                                                   rdfs:range xsd:string.
