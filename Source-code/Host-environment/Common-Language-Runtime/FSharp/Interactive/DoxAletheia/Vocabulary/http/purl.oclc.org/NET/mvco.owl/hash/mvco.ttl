@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix mvco: <http://purl.oclc.org/NET/mvco.owl#>.

<http://purl.oclc.org/NET/mvco.owl> a <http://www.w3.org/2002/07/owl#Ontology>;
                                    rdfs:comment "ISO/IEC 21000-19 Media Value Chain Ontology (MVCO)"@en;
                                    <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Action a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "The exercise of a Right."@en;
            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                            [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedBy ; 
                             <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:User ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> mvco:actedBy ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2002/07/owl#disjointWith> mvco:IPEntity,
                                                         mvco:Permission,
                                                         mvco:User;
            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Adaptation a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A Work that is derived from another Work"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (mvco:MakeAdaptation
                                                                                                                         mvco:Synchronise) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                mvco:IPEntity;
                <http://www.w3.org/2002/07/owl#disjointWith> mvco:Work,
                                                             mvco:Manifestation,
                                                             mvco:Instance,
                                                             mvco:Copy,
                                                             mvco:Product;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:AdaptationInstance a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An object or event which is an example of an Identified Adaptation Manifestation (e.g. a File)"@en;
                        <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Instance
                                                                                                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeAdaptationInstance ; 
                                                                                                                         <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                         a <http://www.w3.org/2002/07/owl#Class>];
                        <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:AdaptationInstanceCopy a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A copy of an AdaptationInstance"@en;
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Copy
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeAdaptationInstanceCopy ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>];
                            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:AdaptationManifestation a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "An object or event which is an expression of an Adaptation"@en;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Manifestation
                                                                                                                              [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                              <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeAdaptationManifestation ; 
                                                                                                                              a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>];
                             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:AdaptationManifestationCopy a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A copy of an AdaptationManifestation"@en;
                                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:Copy
                                                                                                                                  [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeAdaptationManifestationCopy ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>];
                                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Adaptor a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A User who produces an Adaptation"@en;
             rdfs:subClassOf mvco:User;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                              <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeAdaptation ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Anonymous a mvco:User.
mvco:Broadcast a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The Function that Delivers Content to a Device in a point-to-multipoint modality"@en;
               rdfs:subClassOf mvco:PublicCommunication;
               <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Collective a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Set of two or more Users."@en;
                rdfs:subClassOf mvco:User;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:ContentHandler a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "User who is appointed to act on Content on behalf and within the scope and responsability of another User´s rights."@en;
                    rdfs:subClassOf mvco:User;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> mvco:actOnBehalfOf ; 
                                                                     <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:User ; 
                                                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Copy a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A mechanical reproduction of analogue or digital representations of a given IP Entity. In the case of digital Copies the result is virtually identical  while in the case of analogue Copies the results can vary considerably in quality."@en;
          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeCopy ; 
                           <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                           a <http://www.w3.org/2002/07/owl#Restriction>],
                          mvco:IPEntity;
          <http://www.w3.org/2002/07/owl#disjointWith> mvco:Instance,
                                                       mvco:Manifestation,
                                                       mvco:Product,
                                                       mvco:Work;
          <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:CopyrightExceptionFact a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Fact related to the invokation of a CopyrightException";
                            rdfs:subClassOf mvco:Fact;
                            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:CopyrightExceptionPermission a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Permission to invoke one right exceptionally.";
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:CopyrightExceptionFact ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> mvco:hasRequired ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  mvco:Permission;
                                  <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:CreateWork a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The action of creating a Work."@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:IPEntity ; 
                                                                               <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                               a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                 a <http://www.w3.org/2002/07/owl#Class>],
                                [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Work ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                mvco:Action;
                <http://www.w3.org/2002/07/owl#disjointWith> mvco:EndUserAction,
                                                             mvco:MakeAdaptation,
                                                             mvco:Produce,
                                                             mvco:PublicCommunication,
                                                             mvco:MakeManifestation,
                                                             mvco:MakeCopy,
                                                             mvco:Synchronise,
                                                             mvco:Distribute,
                                                             mvco:MakeInstance;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Creator a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A User who generates a Work and makes its first Manifestation, also referred to as author"@en;
             rdfs:subClassOf mvco:User;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:CreateWork ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Distribute mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Producer"^^xsd:anyURI,
                                  "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The Function of selling, renting and lending"@en;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "0"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                 <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Product ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                mvco:Action;
                <http://www.w3.org/2002/07/owl#disjointWith> mvco:PublicCommunication,
                                                             mvco:MakeAdaptation,
                                                             mvco:MakeCopy,
                                                             mvco:Produce,
                                                             mvco:Synchronise,
                                                             mvco:EndUserAction,
                                                             mvco:MakeInstance,
                                                             mvco:MakeManifestation;
                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Distributor a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A User who distributes a Product"@en;
                 rdfs:subClassOf mvco:User;
                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Distribute ; 
                                                                  <http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Download a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The Action of transferring a file or program from a central computer to a smaller computer or to a computer at a remote location"@en;
              rdfs:subClassOf mvco:PublicCommunication;
              <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:EndUser a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A User in a Value-Chain who ultimately consumes Content."@en;
             rdfs:subClassOf mvco:User;
             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:EndUserAction ; 
                                                              <http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:EndUserAction mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Distributor"^^xsd:anyURI;
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Action performed by an EndUser";
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                    <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Product ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   mvco:Action;
                   <http://www.w3.org/2002/07/owl#disjointWith> mvco:PublicCommunication,
                                                                mvco:Produce,
                                                                mvco:MakeInstance,
                                                                mvco:MakeAdaptation,
                                                                mvco:Synchronise,
                                                                mvco:MakeManifestation,
                                                                mvco:MakeCopy;
                   <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Fact a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Positive proposition.";
          <http://www.w3.org/2002/07/owl#disjointWith> mvco:User;
          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#onProperty> mvco:isTrue ; 
                                                           <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                           a <http://www.w3.org/2002/07/owl#Restriction>];
          <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:IPEntity a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Types of IP Represented as Content: Work, Adaptation, Manifestation, Instance..."@en;
              rdfs:subClassOf <http://www.w3.org/2002/07/owl#Thing>,
                              [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                               <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Action ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> mvco:hasRightsOwner ; 
                               <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:User ; 
                               <http://www.w3.org/2002/07/owl#onProperty> mvco:hasRightsOwner ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:IPEntity ; 
                               <http://www.w3.org/2002/07/owl#onProperty> mvco:isMadeUpOf ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#disjointWith> mvco:User,
                                                           mvco:Permission;
              <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Instance a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An object or event which is an example of an Identified Manifestation (e.g. a File)"@en;
              rdfs:subClassOf mvco:IPEntity,
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeInstance ; 
                               <http://www.w3.org/2002/07/owl#onProperty> mvco:resultedFrom ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#disjointWith> mvco:Manifestation,
                                                           mvco:Product,
                                                           mvco:Work;
              <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:Instantiator a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "A User who interprets a Manifestation of a Work making an Instance"@en;
                  rdfs:subClassOf mvco:User;
                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:MakeInstance ; 
                                                                   <http://www.w3.org/2002/07/owl#onProperty> mvco:acts ; 
                                                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                  <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeAdaptation mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Adaptor"^^xsd:anyURI,
                                      "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The Action of making an Adaptation"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                     <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (mvco:Adaptation
                                                                                                                             mvco:Work) ; 
                                                                                    a <http://www.w3.org/2002/07/owl#Class>] ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Adaptation ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    mvco:Action;
                    <http://www.w3.org/2002/07/owl#disjointWith> mvco:MakeCopy,
                                                                 mvco:Synchronise,
                                                                 mvco:MakeInstance,
                                                                 mvco:MakeManifestation,
                                                                 mvco:Produce,
                                                                 mvco:PublicCommunication;
                    <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeAdaptationInstance a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "The Action of making an Instance from an AdaptationManifestation"@en;
                            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                             <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:AdaptationInstance ; 
                                             a <http://www.w3.org/2002/07/owl#Restriction>];
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeInstance
                                                                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:AdaptationManifestation ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>];
                            <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeAdaptationInstanceCopy a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "The Action of making an AdaptationInstanceCopy"@en;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                                 <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:AdaptationInstanceCopy ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>];
                                <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeCopy
                                                                                                                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:AdaptationInstance ; 
                                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                 a <http://www.w3.org/2002/07/owl#Class>];
                                <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeAdaptationManifestation a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "The action of making an AdaptationManifestation from an Adaptation."@en;
                                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                                  <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:AdaptationManifestation ; 
                                                  a <http://www.w3.org/2002/07/owl#Restriction>];
                                 <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeManifestation
                                                                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Adaptation ; 
                                                                                                                                  <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Class>];
                                 <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeAdaptationManifestationCopy a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:comment "The Action of making an AdaptationManifestationCopy";
                                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                                      <http://www.w3.org/2002/07/owl#allValuesFrom> mvco:AdaptationManifestationCopy ; 
                                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (mvco:MakeCopy
                                                                                                                                      [<http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                                                                                                                      <http://www.w3.org/2002/07/owl#someValuesFrom> mvco:AdaptationManifestation ; 
                                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>];
                                     <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
mvco:MakeCopy mvco:rightGivenBy "http://purl.oclc.org/NET/mvco.owl#Creator"^^xsd:anyURI,
                                "http://purl.oclc.org/NET/mvco.owl#Instantiator"^^xsd:anyURI;
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "The Action of making a Copy"@en;
              rdfs:subClassOf mvco:Action,
                              [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (mvco:Instance
                                                                                                                       mvco:Manifestation) ; 
