                                                                                                                                 mvco:Work) ; 
                                                                                        a <http://www.w3.org/2002/07/owl#Class>] ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#allValuesFrom> mvco:Manifestation ; 
