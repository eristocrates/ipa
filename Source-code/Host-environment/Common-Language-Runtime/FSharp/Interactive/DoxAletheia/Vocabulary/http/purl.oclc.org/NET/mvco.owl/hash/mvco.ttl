mvco:MakeInstance a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The Action of making an Instance from a Manifestation."@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Manifestation ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> mvco:actedOver ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  mvco:Action,
                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> mvco:Instance ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> mvco:resultsIn ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                  <http://www.w3.org/2002/07/owl#disjointWith> mvco:Produce,
