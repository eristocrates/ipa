om:Pressure om:alternativeSymbol "P";
            om:commonlyHasUnit om:newtonPerSquareMetre,
                               om:kilogramSecond-TimeToThePower-2ReciprocalMetre,
                               om:pascal,
                               om:attopascal,
                               om:centipascal,
                               om:decapascal,
                               om:decipascal,
                               om:exapascal,
                               om:femtopascal,
                               om:gigapascal,
                               om:hectopascal,
                               om:kilopascal,
                               om:megapascal,
                               om:micropascal,
                               om:millipascal,
                               om:nanopascal,
                               om:petapascal,
                               om:picopascal,
                               om:terapascal,
                               om:bar,
                               om:decibar,
                               om:microbar,
                               om:millibar,
                               om:metreOfMercury,
                               om:centimetreOfMercury,
                               om:millimetreOfMercury,
                               om:atmosphere-Standard,
                               om:atmosphere-Technical,
                               om:barye,
                               om:torr;
            om:symbol "p";
            a owl:Class;
            rdfs:comment "Pressure is the force applied to or distributed over a surface. It is a derived quantity in the International System of Units. Pressure is force divided by area."@en;
            rdfs:label "pressure"@en,
                       "druk"@nl,
                       "压力"@zh;
            rdfs:subClassOf om:Quantity,
                            [a owl:Restriction ; 
                             owl:onProperty om:hasValue ; 
