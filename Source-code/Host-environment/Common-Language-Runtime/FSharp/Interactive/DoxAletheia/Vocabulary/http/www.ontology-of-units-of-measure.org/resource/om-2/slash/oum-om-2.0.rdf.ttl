om:Molality om:alternativeLabel "molality of solution"@en;
            om:alternativeSymbol "m";
            om:commonlyHasUnit om:molePerKilogram;
            om:symbol "b";
            a owl:Class;
            rdfs:comment "Molality is the number of moles of solute per kilogram of solvent."@en;
            rdfs:label "molality"@en,
                       "molaliteit"@nl;
            rdfs:subClassOf om:Quantity,
                            [a owl:Restriction ; 
                             owl:onProperty om:hasValue ; 
                             owl:allValuesFrom [a owl:Restriction ; 
                                                owl:onProperty om:hasUnit ; 
                                                owl:allValuesFrom om:MolalityUnit]].
om:MolalityUnit a owl:Class;
                rdfs:label "molality unit"@en;
                rdfs:subClassOf om:Unit;
                owl:equivalentClass [a owl:Class ; 
                                     owl:oneOf (om:molePerKilogram)].
om:MolarEnergy om:commonlyHasUnit om:joulePerMole;
               a owl:Class;
               rdfs:label "molar energy"@en,
                          "molaire energie"@nl;
               rdfs:subClassOf om:Quantity,
                               [a owl:Restriction ; 
                                owl:onProperty om:hasValue ; 
                                owl:allValuesFrom [a owl:Restriction ; 
                                                   owl:onProperty om:hasUnit ; 
                                                   owl:allValuesFrom om:MolarEnergyUnit]],
                               [a owl:Restriction ; 
                                owl:onProperty om:hasDimension ; 
                                owl:hasValue om:molarEnergy-Dimension].
om:MolarEnergyUnit a owl:Class;
                   rdfs:label "molar energy unit"@en;
                   rdfs:subClassOf om:Unit;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (om:joulePerMole)].
om:MolarEntropy om:commonlyHasUnit om:joulePerKelvinMole;
                a owl:Class;
                rdfs:label "molar entropy"@en,
                           "molaire entropie"@nl;
                rdfs:subClassOf om:Quantity,
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasValue ; 
                                 owl:allValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty om:hasUnit ; 
                                                    owl:allValuesFrom om:MolarEntropyUnit]],
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasDimension ; 
                                 owl:hasValue om:molarEntropyOrMolarHeatCapacityOrGasConstant-Dimension].
om:MolarEntropyUnit a owl:Class;
                    rdfs:label "molar entropy unit"@en;
                    rdfs:subClassOf om:Unit;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (om:joulePerKelvinMole)].
om:MolarHeatCapacity om:commonlyHasUnit om:joulePerKelvinMole;
                     a owl:Class;
                     rdfs:label "molar heat capacity"@en,
                                "molaire warmtecapaciteit"@nl;
                     rdfs:subClassOf om:Quantity,
                                     [a owl:Restriction ; 
                                      owl:onProperty om:hasValue ; 
                                      owl:allValuesFrom [a owl:Restriction ; 
                                                         owl:onProperty om:hasUnit ; 
                                                         owl:allValuesFrom om:MolarHeatCapacityUnit]],
                                     [a owl:Restriction ; 
                                      owl:onProperty om:hasDimension ; 
                                      owl:hasValue om:molarEntropyOrMolarHeatCapacityOrGasConstant-Dimension].
om:MolarHeatCapacityUnit a owl:Class;
                         rdfs:label "molar heat capacity unit"@en;
                         rdfs:subClassOf om:Unit;
                         owl:equivalentClass [a owl:Class ; 
                                              owl:oneOf (om:joulePerKelvinMole)].
om:MolarMass om:commonlyHasUnit om:kilogramPerMole;
             om:symbol "M";
             a owl:Class;
             rdfs:label "molar mass"@en,
                        "molaire massa"@nl;
             rdfs:subClassOf om:Quantity,
                             [a owl:Restriction ; 
                              owl:onProperty om:hasValue ; 
                              owl:allValuesFrom [a owl:Restriction ; 
                                                 owl:onProperty om:hasUnit ; 
                                                 owl:allValuesFrom om:MolarMassUnit]].
om:MolarMassUnit a owl:Class;
                 rdfs:label "molar mass unit"@en;
                 rdfs:subClassOf om:Unit;
                 owl:equivalentClass [a owl:Class ; 
                                      owl:oneOf (om:kilogramPerMole)].
om:MolarVolume om:commonlyHasUnit om:cubicMetrePerMole,
                                  om:litrePerMole;
               om:symbol "V_m";
               a owl:Class;
               rdfs:label "molar volume"@en,
                          "molair volume"@nl;
               rdfs:subClassOf om:Quantity,
                               [a owl:Restriction ; 
                                owl:onProperty om:hasValue ; 
                                owl:allValuesFrom [a owl:Restriction ; 
                                                   owl:onProperty om:hasUnit ; 
                                                   owl:allValuesFrom om:MolarVolumeUnit]].
om:MolarVolumeUnit a owl:Class;
                   rdfs:label "molar volume unit"@en;
                   rdfs:subClassOf om:Unit;
                   owl:equivalentClass [a owl:Class ; 
                                        owl:oneOf (om:cubicMetrePerMole
                                                   om:litrePerMole)].
om:MolePerPrefixedLitre a owl:Class;
                        rdfs:label "mole per prefixed litre"@en;
                        rdfs:subClassOf om:UnitDivision;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:intersectionOf ([a owl:Restriction ; 
                                                                 owl:onProperty om:hasNumerator ; 
                                                                 owl:hasValue om:mole]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasNumerator ; 
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasDenominator ; 
                                                                 owl:allValuesFrom om:PrefixedLitre]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasDenominator ; 
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger])].
om:MolePerPrefixedMetre a owl:Class;
                        rdfs:label "mole per prefixed metre"@en;
                        rdfs:subClassOf om:UnitDivision;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:intersectionOf ([a owl:Restriction ; 
                                                                 owl:onProperty om:hasNumerator ; 
                                                                 owl:hasValue om:mole]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasNumerator ; 
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasDenominator ; 
                                                                 owl:allValuesFrom om:PrefixedMetre]
                                                                 [a owl:Restriction ; 
                                                                 owl:onProperty om:hasDenominator ; 
                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger])].
om:MomentOfForce om:alternativeLabel "moment"@en;
                 om:commonlyHasUnit om:newtonMetre,
                                    om:micronewtonMetre,
                                    om:millinewtonMetre;
                 om:symbol "M";
                 a owl:Class;
                 rdfs:comment "Moment of force is the effectiveness of a force to produce rotation about an axis measured by the product of the force and the perpendicular distance from the line of action of the force to the axis."@en;
                 rdfs:label "moment of force"@en;
                 rdfs:subClassOf om:Quantity,
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasValue ; 
                                  owl:allValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty om:hasUnit ; 
                                                     owl:allValuesFrom om:MomentOfForceUnit]],
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasDimension ; 
                                  owl:hasValue om:energy-Dimension].
om:MomentOfForceUnit a owl:Class;
                     rdfs:label "moment of force unit"@en;
                     rdfs:subClassOf om:Unit;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (om:newtonMetre
                                                     om:micronewtonMetre
                                                     om:millinewtonMetre)].
om:MomentOfInertia om:alternativeLabel "massatraagheidsmoment"@nl;
                   om:alternativeSymbol "J";
                   om:commonlyHasUnit om:kilogramSquareMetre;
                   om:symbol "I";
                   a owl:Class;
                   rdfs:comment "Moment of inertia is a measure of the effectiveness of mass in rotation."@en;
                   rdfs:label "moment of inertia"@en,
                              "traagheidsmoment"@nl;
                   rdfs:subClassOf om:Quantity,
                                   [a owl:Restriction ; 
                                    owl:onProperty om:hasValue ; 
                                    owl:allValuesFrom [a owl:Restriction ; 
                                                       owl:onProperty om:hasUnit ; 
                                                       owl:allValuesFrom om:MomentOfInertiaUnit]].
om:MomentOfInertiaUnit a owl:Class;
                       rdfs:label "moment of inertia unit"@en;
                       rdfs:subClassOf om:Unit;
                       owl:equivalentClass [a owl:Class ; 
                                            owl:oneOf (om:kilogramSquareMetre)].
om:Momentum om:alternativeLabel "linear momentum"@en;
            om:commonlyHasUnit om:metreKilogramPerSecond-Time;
            om:symbol "p";
            a owl:Class;
            rdfs:comment "Momentum is the product of mass and velocity of an object."@en;
            rdfs:label "momentum"@en,
                       "impuls"@nl;
            rdfs:subClassOf om:Quantity,
                            [a owl:Restriction ; 
                             owl:onProperty om:hasValue ; 
                             owl:allValuesFrom [a owl:Restriction ; 
                                                owl:onProperty om:hasUnit ; 
                                                owl:allValuesFrom om:MomentumUnit]].
om:MomentumUnit a owl:Class;
                rdfs:label "momentum unit"@en;
                rdfs:subClassOf om:Unit;
                owl:equivalentClass [a owl:Class ; 
                                     owl:oneOf (om:metreKilogramPerSecond-Time)].
om:MustardPowderMassFraction om:commonlyHasUnit om:one,
                                                om:percent,
                                                om:gramPerGram;
                             a owl:Class;
                             rdfs:comment "The fraction of the mass of mustard powder in a phenomenon"@en;
                             rdfs:label "mustard powder mass fraction"@en;
                             rdfs:subClassOf om:MassFraction.
om:NeckRingMass om:commonlyHasUnit om:gram,
                                   om:kilogram,
                                   om:tonne;
                om:unofficialLabel "neck ring weight";
                a owl:Class;
                rdfs:label "neck ring mass"@en;
                rdfs:subClassOf om:Mass.
om:NewZealandDollar a om:Unit,
                      om:SingularUnit;
                    rdfs:label "New Zealand dollar"@en,
                               "新西兰美元"@zh.
om:NoiseEquivalentPower om:commonlyHasUnit om:watt;
                        om:symbol "NEP";
                        a owl:Class;
                        rdfs:comment "Radiative flux on a detector needed for a signal/noise ratio of 1 (Kitchin, Astrophysical Techniques, IoP, Table 1.1.2)."@en;
                        rdfs:label "noise equivalent power"@en;
                        rdfs:subClassOf om:Power;
                        ombibo:reference ombibo:Astrophysical_Techniques_chapter1.
om:NormalAlbedo om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Ratio between radiation falling vertically onto an object and the radiation radiated back vertically."@en;
                rdfs:label "normal albedo"@en;
                rdfs:subClassOf om:Albedo.
om:NormalStrain om:commonlyHasUnit om:one,
                                   om:percent;
                a owl:Class;
                rdfs:label "normal strain"@en,
                           "normaalvervorming"@nl;
                rdfs:subClassOf om:Strain.
om:NormalStress om:commonlyHasUnit om:newtonPerSquareMetre,
                                   om:kilogramSecond-TimeToThePower-2ReciprocalMetre,
                                   om:pascal,
                                   om:attopascal,
                                   om:centipascal,
                                   om:decapascal,
                                   om:decipascal,
                                   om:exapascal,
                                   om:femtopascal,
                                   om:gigapascal,
                                   om:hectopascal,
                                   om:kilopascal,
                                   om:megapascal,
                                   om:micropascal,
                                   om:millipascal,
                                   om:nanopascal,
                                   om:petapascal,
                                   om:picopascal,
                                   om:terapascal,
                                   om:bar,
                                   om:decibar,
                                   om:microbar,
                                   om:millibar,
                                   om:metreOfMercury,
                                   om:centimetreOfMercury,
                                   om:millimetreOfMercury,
                                   om:atmosphere-Standard,
                                   om:atmosphere-Technical,
                                   om:barye,
                                   om:torr;
                a owl:Class;
                rdfs:label "normal stress"@en,
                           "normaalspanning"@nl;
                rdfs:subClassOf om:Stress.
om:NormalisedDetectivity om:symbol "D*";
                         a owl:Class;
                         rdfs:comment "The detectivity normalised by multiplying by the square root of the detector area, and by the electrical bandwidth. The units cm Hz(1/2)/W are commonly used and it then represents the signal-to-noise ratio when 1 W of radiation is incident on a detector with an area of 1 cm2, and the electrical bandwidth is 1 Hz."@en;
                         rdfs:label "normalised detectivity"@en;
                         rdfs:subClassOf om:Quantity;
                         ombibo:reference ombibo:Astrophysical_Techniques_chapter1.
om:NorwegianKrone a om:Unit,
                    om:SingularUnit;
                  rdfs:label "Norwegian krone"@en,
                             "挪威克朗"@zh.
om:Number om:commonlyHasUnit om:one;
          om:symbol "N";
          om:unofficialAbbreviation "nr",
                                    "no",
                                    "#";
          a owl:Class;
          rdfs:label "number"@en;
          rdfs:subClassOf om:Quantity,
                          [a owl:Restriction ; 
                           owl:onProperty om:hasDimension ; 
                           owl:hasValue om:dimensionOne],
                          [a owl:Restriction ; 
                           owl:onProperty om:hasValue ; 
                           owl:allValuesFrom [a owl:Restriction ; 
                                              owl:onProperty om:hasUnit ; 
                                              owl:allValuesFrom om:NumberUnit]].
om:NumberAbscisedBuds om:alternativeLabel "#abscised buds"@en;
                      om:commonlyHasUnit om:one;
                      a owl:Class;
                      rdfs:comment "Aantal gevallen knoppen."@nl;
                      rdfs:label "number abscised buds"@en,
                                 "aantal gevallen knoppen"@nl;
                      rdfs:subClassOf om:NumberBuds.
om:NumberAbscisedFlowers om:alternativeLabel "#abscised flowers"@en;
                         om:commonlyHasUnit om:one;
                         a owl:Class;
                         rdfs:comment "Aantal gevallen bloemen."@nl;
                         rdfs:label "number abscised flowers"@en,
                                    "aantal gevallen bloemen"@nl;
                         rdfs:subClassOf om:NumberFlowers.
om:NumberAbscisedLeaves om:alternativeLabel "#abscised leaves"@en;
                        om:commonlyHasUnit om:one;
                        a owl:Class;
                        rdfs:comment "Aantal gevallen bladeren."@nl;
                        rdfs:label "number abscised leaves"@en,
                                   "aantal gevallen bladeren"@nl;
                        rdfs:subClassOf om:NumberLeaves.
om:NumberBlue-DiscoloredFlowers om:alternativeLabel "#blue flowers"@en;
                                om:commonlyHasUnit om:one;
                                a owl:Class;
                                rdfs:comment "Aantal blauwverkleurde bloemen."@nl;
                                rdfs:label "number blue-discolored flowers"@en,
                                           "aantal blauwverkleurde bloemen"@nl;
                                rdfs:subClassOf om:NumberFlowers.
om:NumberBotrytis om:commonlyHasUnit om:one;
                  a owl:Class;
                  rdfs:label "number Botrytis"@en,
                             "aantal Botrytis"@nl;
                  rdfs:subClassOf om:Number.
om:NumberBotrytis0 om:alternativeLabel "b0"@en;
                   om:commonlyHasUnit om:one;
                   a owl:Class;
                   rdfs:comment "Aantal bloemen zonder Botrytis."@nl;
                   rdfs:label "number Botrytis 0"@en,
                              "aantal Botrytis 0"@nl;
                   rdfs:subClassOf om:NumberBotrytis.
om:NumberBotrytis1 om:alternativeLabel "b1"@en;
                   om:commonlyHasUnit om:one;
                   a owl:Class;
                   rdfs:comment "Aantal bloemen met Botrytis 1: enkele laesies: max 3 op één petaal of max 5 op meerdere plekken."@nl;
                   rdfs:label "number Botrytis 1"@en,
                              "aantal Botrytis 1"@nl;
                   rdfs:subClassOf om:NumberBotrytis.
om:NumberBotrytis2 om:alternativeLabel "b2"@en;
                   om:commonlyHasUnit om:one;
                   a owl:Class;
                   rdfs:comment "Aantal bloemen met Botrytis 2: grotere vlek(ken) op één petaal."@nl;
                   rdfs:label "number Botrytis 2"@en,
                              "aantal Botrytis 2"@nl;
                   rdfs:subClassOf om:NumberBotrytis.
om:NumberBotrytis3 om:alternativeLabel "b3"@en;
                   om:commonlyHasUnit om:one;
                   a owl:Class;
                   rdfs:comment "Aantal bloemen met Botrytis 3: één bruin petaal of vlekken op meer petalen."@nl;
                   rdfs:label "number Botrytis 3"@en,
                              "aantal Botrytis 3"@nl;
                   rdfs:subClassOf om:NumberBotrytis.
om:NumberBotrytis4 om:alternativeLabel "b4"@en;
                   om:commonlyHasUnit om:one;
                   a owl:Class;
                   rdfs:comment "Aantal bloemen met Botrytis 4: minimaal één bruin petaal en hart aangetast."@nl;
                   rdfs:label "number Botrytis 4"@en,
                              "aantal Botrytis 4"@nl;
                   rdfs:subClassOf om:NumberBotrytis.
om:NumberBudStadium om:commonlyHasUnit om:one;
                    a owl:Class;
                    rdfs:label "number bud stadium"@en,
                               "aantal knopstadium"@nl;
                    rdfs:subClassOf om:Number.
om:NumberBudStadium1 om:alternativeLabel "s1"@en;
                     om:commonlyHasUnit om:one;
                     a owl:Class;
                     rdfs:comment "Roos aantal in knopstadium 1: spitse knop."@nl;
                     rdfs:label "number bud stadium 1"@en,
                                "aantal knopstadium 1"@nl;
                     rdfs:subClassOf om:NumberBudStadium.
om:NumberBudStadium2 om:alternativeLabel "s2"@en;
                     om:commonlyHasUnit om:one;
                     a owl:Class;
                     rdfs:comment "Roos aantal in knopstadium 2: spitse knop."@nl;
                     rdfs:label "number bud stadium 2"@en,
                                "aantal knopstadium 2"@nl;
                     rdfs:subClassOf om:NumberBudStadium.
om:NumberBudStadium3 om:alternativeLabel "s3"@en;
                     om:commonlyHasUnit om:one;
                     a owl:Class;
                     rdfs:comment "Roos aantal in knopstadium 3: spitse knop."@nl;
                     rdfs:label "number bud stadium 3"@en,
                                "aantal knopstadium 3"@nl;
                     rdfs:subClassOf om:NumberBudStadium.
om:NumberBudStadium4 om:alternativeLabel "s4"@en;
                     om:commonlyHasUnit om:one;
                     a owl:Class;
                     rdfs:comment "Roos aantal in knopstadium 4: spitse knop."@nl;
                     rdfs:label "number bud stadium 4"@en,
                                "aantal knopstadium 4"@nl;
                     rdfs:subClassOf om:NumberBudStadium.
om:NumberBudStadium5 om:alternativeLabel "s5"@en;
                     om:commonlyHasUnit om:one;
                     a owl:Class;
                     rdfs:comment "Roos aantal in knopstadium 5: spitse knop."@nl;
                     rdfs:label "number bud stadium 5"@en,
                                "aantal knopstadium 5"@nl;
                     rdfs:subClassOf om:NumberBudStadium.
om:NumberBuds om:commonlyHasUnit om:one;
              a owl:Class;
              rdfs:label "number buds"@en,
                         "aantal knoppen"@nl;
              rdfs:subClassOf om:Number.
om:NumberColor om:commonlyHasUnit om:one;
               a owl:Class;
               rdfs:label "number color"@en,
                          "aantal kleur"@nl;
               rdfs:subClassOf om:Number.
om:NumberColor1 om:alternativeLabel "color_1"@en;
                om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Voorbeeld avocado Hass: code 1 poster (vrijwel) geheel groen."@nl;
                rdfs:label "number color 1"@en,
                           "aantal kleur 1"@nl;
                rdfs:subClassOf om:NumberColor.
om:NumberColor2 om:alternativeLabel "color_2"@en;
                om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Voorbeeld avocado Hass: code 2 poster meer groen dan donker."@nl;
                rdfs:label "number color 2"@en,
                           "aantal kleur 2"@nl;
                rdfs:subClassOf om:NumberColor.
om:NumberColor3 om:alternativeLabel "color_3"@en;
                om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Voorbeeld avocado Hass: code 3 poster 50% groen."@nl;
                rdfs:label "number color 3"@en,
                           "aantal kleur 3"@nl;
                rdfs:subClassOf om:NumberColor.
om:NumberColor4 om:alternativeLabel "color_4"@en;
                om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Voorbeeld avocado Hass: code 4 poster meer donker dan groen."@nl;
                rdfs:label "number color 4"@en,
                           "aantal kleur 4"@nl;
                rdfs:subClassOf om:NumberColor.
om:NumberColor5 om:alternativeLabel "color_5"@en;
                om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:comment "Voorbeeld avocado Hass: code 5 poster (vrijwel) geheel donker."@nl;
                rdfs:label "number color 5"@en,
                           "aantal kleur 5"@nl;
                rdfs:subClassOf om:NumberColor.
om:NumberDensity om:commonlyHasUnit om:reciprocalCubicMetre,
                                    om:reciprocalCubicCentimetre,
                                    om:reciprocalCubicMillimetre,
                                    om:reciprocalCubicMicrometre,
                                    om:reciprocalCubicNanometre,
                                    om:reciprocalLitre,
                                    om:reciprocalCubicAngstrom,
                                    om:reciprocalCubicParsec;
                 om:symbol "n";
                 a owl:Class;
                 rdfs:label "number density"@en;
                 rdfs:subClassOf om:Quantity,
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasValue ; 
                                  owl:allValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty om:hasUnit ; 
                                                     owl:allValuesFrom om:NumberDensityUnit]],
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasDimension ; 
                                  owl:hasValue om:numberDensity-Dimension].
om:NumberDensityUnit a owl:Class;
                     rdfs:label "number density unit"@en;
                     rdfs:subClassOf om:Unit;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (om:reciprocalCubicAngstrom
                                                     om:reciprocalCubicCentimetre
                                                     om:reciprocalCubicMillimetre
                                                     om:reciprocalCubicMicrometre
                                                     om:reciprocalCubicNanometre
                                                     om:reciprocalLitre
                                                     om:reciprocalCubicMetre
                                                     om:reciprocalCubicParsec)].
om:NumberDryBuds om:alternativeLabel "#dry buds"@en;
                 om:commonlyHasUnit om:one;
                 a owl:Class;
