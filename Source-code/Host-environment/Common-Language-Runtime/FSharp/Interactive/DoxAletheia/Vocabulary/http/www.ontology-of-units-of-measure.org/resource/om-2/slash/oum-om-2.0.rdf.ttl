              rdfs:comment "Total extinction at a specific wavelength. The extinction is caused by dust and gas between a star and the observer. It is the difference between the observed magnitude and the magnitude the source would have had if no extinction had taken place."@en;
              rdfs:label "extinction"@en,
                         "extinctie"@nl;
              rdfs:subClassOf om:Quantity.
om:ExtinctionAtWaveband om:commonlyHasUnit om:magnitude;
                        om:symbol "A_X";
                        a owl:Class;
                        rdfs:label "extinction at waveband"@en;
                        rdfs:subClassOf om:Extinction.
om:ExtinctionAtWavelength om:commonlyHasUnit om:magnitude;
                          om:symbol "A_λ";
                          a owl:Class;
                          rdfs:label "extinction at wavelength"@en;
                          rdfs:subClassOf om:Extinction.
om:ExtinctionInB om:commonlyHasUnit om:magnitude;
                 om:symbol "A_B";
                 a owl:Class;
                 rdfs:label "extinction in B"@en;
                 rdfs:subClassOf om:ExtinctionAtWaveband.
om:ExtinctionInU om:commonlyHasUnit om:magnitude;
                 om:symbol "A_U";
                 a owl:Class;
                 rdfs:label "extinction in U"@en;
                 rdfs:subClassOf om:ExtinctionAtWaveband.
om:ExtinctionInV om:commonlyHasUnit om:magnitude;
                 om:symbol "A_V";
                 a owl:Class;
                 rdfs:label "extinction in V"@en;
                 rdfs:subClassOf om:ExtinctionAtWaveband.
om:FahrenheitScale om:hasDimension om:thermodynamicTemperature-Dimension;
                   om:hasFactor 1.8;
                   om:hasOff-Set -459.67;
                   om:hasScale om:KelvinScale;
                   om:hasUnit om:degreeFahrenheit;
                   a om:IntervalScale;
                   rdfs:label "Fahrenheit scale"@en,
                              "Fahrenheitschaal"@nl,
                              "华氏温标"@zh.
om:FahrenheitTemperature om:commonlyHasUnit om:degreeFahrenheit;
                         om:symbol "T";
                         a owl:Class;
                         rdfs:label "Fahrenheit temperature"@en,
                                    "Fahrenheittemperatuur"@nl;
                         rdfs:subClassOf om:Temperature,
                                         [a owl:Restriction ; 
                                          owl:onProperty om:hasScale ; 
                                          owl:hasValue om:FahrenheitScale],
                                         [a owl:Restriction ; 
                                          owl:onProperty om:hasValue ; 
                                          owl:allValuesFrom [a owl:Restriction ; 
                                                             owl:onProperty om:hasUnit ; 
                                                             owl:allValuesFrom [a owl:Class ; 
                                                                                owl:unionOf (om:FahrenheitTemperatureUnit
                                                                                             om:FahrenheitTemperatureScale)]]].
om:FahrenheitTemperatureScale a owl:Class;
                              rdfs:label "Fahrenheit temperature scale"@en;
                              rdfs:subClassOf om:Scale;
                              owl:equivalentClass [a owl:Class ; 
                                                   owl:oneOf (om:FahrenheitScale)].
om:FahrenheitTemperatureUnit a owl:Class;
                             rdfs:label "Fahrenheit temperature unit"@en;
                             rdfs:subClassOf om:TemperatureUnit;
                             owl:equivalentClass [a owl:Class ; 
                                                  owl:oneOf (om:degreeFahrenheit)].
om:FatMassFraction om:commonlyHasUnit om:one,
                                      om:percent,
                                      om:gramPerGram;
                   a owl:Class;
                   rdfs:comment "The fraction of the mass of fat in a phenomenon"@en;
                   rdfs:label "fat mass fraction"@en;
                   rdfs:subClassOf om:MassFraction.
om:Firmness-Penetrometer-Method1 om:alternativeLabel "firmness_pen_1"@en;
                                 om:commonlyHasUnit om:kilogramPerSquareMetre;
                                 a owl:Class;
                                 rdfs:comment "Stevigheid gemeten met penetrometer methode 1."@nl;
                                 rdfs:label "firmness (penetrometer) (method 1)"@en,
                                            "stevigheid (penetrometer) (methode 1)"@nl;
                                 rdfs:subClassOf om:Quantity.
om:Firmness-Penetrometer-Method2 om:alternativeLabel "firmness_pen_2"@en;
                                 om:commonlyHasUnit om:kilogramPerSquareMetre;
                                 a owl:Class;
                                 rdfs:comment "Stevigheid gemeten met penetrometer methode 2."@nl;
                                 rdfs:label "firmness (penetrometer) (method 2)"@en,
                                            "stevigheid (penetrometer) (methode 2)"@nl;
                                 rdfs:subClassOf om:Quantity.
om:FirstCowlingNumber om:commonlyHasUnit om:one;
                      om:symbol "Co_1";
                      a owl:Class;
                      rdfs:label "first Cowling number"@en;
                      rdfs:subClassOf om:Quantity,
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasValue ; 
                                       owl:allValuesFrom [a owl:Restriction ; 
                                                          owl:onProperty om:hasUnit ; 
                                                          owl:allValuesFrom om:FirstCowlingNumberUnit]],
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasDimension ; 
                                       owl:hasValue om:dimensionOne].
om:FirstCowlingNumberUnit a owl:Class;
                          rdfs:label "first Cowling number unit"@en;
                          rdfs:subClassOf om:Unit;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:oneOf (om:one)].
om:FixedPoint a owl:Class;
              rdfs:label "fixed point"@en;
              rdfs:subClassOf om:Point,
