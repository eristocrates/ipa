                 rdfs:subClassOf om:Number.
om:NumberLeaves om:commonlyHasUnit om:one;
                a owl:Class;
                rdfs:label "number leaves"@en,
                           "aantal bladeren"@nl;
                rdfs:subClassOf om:Number.
om:NumberMalformedBuds om:alternativeLabel "#malformed buds"@en;
