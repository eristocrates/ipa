om:volt om:hasDimension om:electricPotential-Dimension;
        om:hasUnit om:wattPerAmpere;
        om:longcomment "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3. The volt is a derived unit in the International System of Units."@en;
        om:symbol "V";
        a om:SingularUnit,
          om:Unit;
        rdfs:comment "The volt is a unit of electric potential defined as watt divided by ampere = joule divided by coulomb = newton times metre divided by ampere times second = kilogram times square metre divided by ampere times second to the power 3."@en;
        rdfs:label "volt"@en,
                   "volt"@nl.
om:voltPerAmpere om:alternativeSymbol "V A-1",
                                      "V·A-1";
                 om:hasDenominator om:ampere;
                 om:hasDimension om:electricalResistance-Dimension;
                 om:hasNumerator om:volt;
                 om:symbol "V/A";
                 a om:UnitDivision;
                 rdfs:label "volt per ampere"@en,
                            "volt per ampère"@nl.
om:voltPerMetre om:alternativeSymbol "V m-1",
                                     "V·m-1";
                om:hasDenominator om:metre;
                om:hasDimension om:electricField-Dimension;
                om:hasNumerator om:volt;
                om:symbol "V/m";
                a om:UnitDivision;
                rdfs:label "volt per metre"@en,
                           "volt per meter"@nl.
om:voltPerWatt om:alternativeSymbol "V W-1",
                                    "V·W-1";
               om:hasDenominator om:watt;
               om:hasNumerator om:volt;
               om:symbol "V/W";
               a om:UnitDivision;
               rdfs:label "volt per watt"@en,
                          "volt per watt"@nl.
om:voltSecond-Time om:alternativeSymbol "V·s";
                   om:hasDimension om:magneticFlux-Dimension;
                   om:hasTerm1 om:volt;
                   om:hasTerm2 om:second-Time;
                   om:symbol "V s";
                   a om:UnitMultiplication;
                   rdfs:label "volt second"@en,
                              "volt seconde"@nl.
om:volume-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                    om:hasSIElectricCurrentDimensionExponent 0 ;
