                                    rdfs:label "volumetric heat capacity dimension"@en.
om:watt om:hasDimension om:power-Dimension;
        om:hasUnit om:joulePerSecond-Time;
        om:longcomment "The watt is a unit of power defined as joule divided by second = newton times metre divided by second = volt times ampere = kilogram times square metre divided by second to the power 3. The watt is a derived unit in the International System of Units."@en;
        om:symbol "W";
        a om:Unit,
          om:SingularUnit;
        rdfs:comment "The watt is a unit of power defined as joule divided by second = newton times metre divided by second = volt times ampere = kilogram times square metre divided by second to the power 3."@en;
        rdfs:label "watt"@en,
                   "watt"@nl.
om:wattHour om:alternativeLabel "watt-hour"@en,
