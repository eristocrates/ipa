                                                om:microkatal,
                                                om:millikatal,
                                                om:centikatal,
                                                om:decikatal,
                                                om:decakatal,
                                                om:hectokatal,
                                                om:kilokatal,
                                                om:megakatal,
                                                om:gigakatal,
                                                om:terakatal,
                                                om:petakatal,
                                                om:exakatal,
                                                om:zettakatal,
                                                om:yottakatal,
                                                om:kilojoulePerHectogram;
                              a om:SystemOfUnits;
                              rdfs:label "International System of Units"@en,
                                         "Internationale Stelsel van Eenheden"@nl,
                                         "国际单位制"@zh.
om:InternationalUnit om:hasDimension om:mass-Dimension;
                     om:symbol "IU";
                     a om:Unit,
                       om:SingularUnit;
                     rdfs:label "International Unit"@en,
                                "国际单位"@zh.
om:IntervalScale a owl:Class;
                 rdfs:label "interval scale"@en;
                 rdfs:subClassOf om:Scale.
om:IntrinsicColourIndex om:commonlyHasUnit om:magnitude;
                        a owl:Class;
                        rdfs:comment "The colour index a star would have in the absence of interstellar extinction (reddening). It is assumed that all stars of the same spectral type and luminosity class have the same colour index."@en;
                        rdfs:label "intrinsic colour index"@en;
                        rdfs:subClassOf om:ColourIndex.
om:IonizationTemperature om:commonlyHasUnit om:kelvin;
                         om:symbol "T_ion";
                         a owl:Class;
                         rdfs:comment "The temperature of a gas or plasma derived from the relative numbers of neutral atoms and ions. Specifically, it is the temperature for which the Saha equations would predict these relative numbers, assuming the atoms and ions are in thermodynamic equilibrium."@en;
                         rdfs:label "ionization temperature"@en;
                         rdfs:subClassOf om:ThermodynamicTemperature.
om:Irradiance om:alternativeSymbol "E_e";
              om:commonlyHasUnit om:wattPerSquareMetre;
              om:symbol "E";
              a owl:Class;
              rdfs:comment "Irradiance is the power of electromagnetic radiation at a surface per unit area."@en;
              rdfs:label "irradiance"@en;
              rdfs:subClassOf om:PowerDensity.
om:JapaneseYen a om:Unit,
                 om:SingularUnit;
               rdfs:label "Japanese yen"@en,
                          "日元"@zh.
om:JeansMass om:commonlyHasUnit om:kilogram,
                                om:solarMass;
             om:symbol "M_J";
             a owl:Class;
             rdfs:comment "The critical mass of a molecular cloud, above which it will be unstable to collapse."@en;
             rdfs:label "Jeans mass"@en;
             rdfs:subClassOf om:Mass.
om:JohnsonMagnitude om:longcomment "For accurate photometry the magnitude needs to be determined over well-defined spectral regions as the spectrum of to objects may be quite different. These magnitudes are measured using filters that allows only radiation within specific spectral regions (passbands) to pass through to the detector. These filters have accurately defined transmission curves characterised by a central wavelength and a bandwidth. The UBV system devised by Harold Johnson and William Morgan has been the most important general system until recently. The precise definition requires a reflecting telescope with aluminised mirrors fitted with an RCA 1P21 photomultiplier. The U region corresponds to a region in the violet and ultraviolet, the B region corresponds to typical photographic response and the V region to the visual response region (approximating the eye's response curve)."@en;
                    a owl:Class;
                    rdfs:comment "A magnitude measured in one of Johnson's standard passbands (using a standard filter, i.e. U, B, or V)."@en;
                    rdfs:label "Johnson magnitude"@en;
                    rdfs:subClassOf om:Magnitude;
                    ombibo:reference ombibo:Astrophysical_Techniques_chapter3.
om:KelvinScale om:alternativeLabel "International Kelvin Temperature scale of 1990"@en;
               om:hasDimension om:thermodynamicTemperature-Dimension;
               om:hasPoint om:_3To5OnTheKelvinScale,
                           om:_13.8033OnTheKelvinScale,
                           om:approximately17OnTheKelvinScale,
                           om:approximately203OnTheKelvinScale,
                           om:_24.5561OnTheKelvinScale,
                           om:_54.3584OnTheKelvinScale,
                           om:_83.8058OnTheKelvinScale,
                           om:_234.3156OnTheKelvinScale,
                           om:_273.16OnTheKelvinScale,
                           om:_302.9146OnTheKelvinScale,
                           om:_429.7485OnTheKelvinScale,
                           om:_505.078OnTheKelvinScale,
                           om:_692.677OnTheKelvinScale,
                           om:_933.473OnTheKelvinScale,
                           om:_1234.93OnTheKelvinScale,
                           om:_1337.33OnTheKelvinScale,
                           om:_1357.77OnTheKelvinScale;
               om:hasUnit om:kelvin;
               a om:RatioScale;
               rdfs:label "Kelvin scale"@en,
                          "Kelvinschaal"@nl,
                          "开氏温标"@zh.
om:Kerma om:commonlyHasUnit om:joulePerKilogram,
                            om:gray,
                            om:attogray,
                            om:centigray,
                            om:decagray,
                            om:decigray,
                            om:exagray,
                            om:femtogray,
                            om:gigagray,
                            om:hectogray,
                            om:kilogray,
                            om:megagray,
                            om:microgray,
                            om:milligray,
                            om:nanogray,
                            om:petagray,
                            om:picogray,
                            om:teragray,
                            om:rad;
         a owl:Class;
         rdfs:label "kerma"@en;
         rdfs:subClassOf om:AbsorbedDose.
om:KinematicViscosity om:commonlyHasUnit om:squareMetrePerSecond-Time,
                                         om:stokes,
                                         om:centistokes;
                      om:symbol "ν";
                      om:unofficialLabel "viscosity";
                      a owl:Class;
                      rdfs:comment "Kinematic viscosity is the ratio of viscosity to density."@en;
                      rdfs:label "kinematic viscosity"@en,
                                 "kinematische viscositeit"@nl;
                      rdfs:subClassOf om:Quantity,
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasValue ; 
                                       owl:allValuesFrom [a owl:Restriction ; 
                                                          owl:onProperty om:hasUnit ; 
                                                          owl:allValuesFrom om:KinematicViscosityUnit]],
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasDimension ; 
                                       owl:hasValue om:kinematicViscosityOrThermalDiffusivity-Dimension].
om:KinematicViscosityUnit a owl:Class;
                          rdfs:label "kinematic viscosity unit"@en;
                          rdfs:subClassOf om:Unit;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:unionOf ([a owl:Class ; 
                                                            owl:oneOf (om:stokes
                                                                       om:squareMetrePerSecond-Time)]
                                                            om:PrefixedStokes)].
om:KineticEnergy om:alternativeLabel "bewegingsenergie"@nl;
                 om:alternativeSymbol "T",
                                      "K";
                 om:commonlyHasUnit om:newtonMetre,
                                    om:micronewtonMetre,
                                    om:millinewtonMetre,
                                    om:joule,
                                    om:attojoule,
                                    om:centijoule,
                                    om:decajoule,
                                    om:decijoule,
                                    om:exajoule,
                                    om:femtojoule,
                                    om:gigajoule,
                                    om:hectojoule,
                                    om:kilojoule,
                                    om:megajoule,
                                    om:microjoule,
                                    om:millijoule,
                                    om:nanojoule,
                                    om:petajoule,
                                    om:picojoule,
                                    om:terajoule,
                                    om:electronvolt,
                                    om:gigaelectronvolt,
                                    om:kiloelectronvolt,
                                    om:megaelectronvolt,
                                    om:calorie-Mean,
                                    om:kilocalorie-Mean,
                                    om:BritishThermalUnit-39F,
                                    om:BritishThermalUnit-59F,
                                    om:BritishThermalUnit-60F,
                                    om:BritishThermalUnit-InternationalTable,
                                    om:BritishThermalUnit-Mean,
                                    om:BritishThermalUnit-Thermochemical,
                                    om:calorie-15C,
                                    om:calorie-20C,
                                    om:calorie-InternationalTable,
                                    om:calorie-Thermochemical,
                                    om:erg,
                                    om:footPoundal,
                                    om:quad,
                                    om:wattHour,
                                    om:kilowattHour,
                                    om:megawattHour,
                                    om:gigawattHour,
                                    om:terawattHour,
                                    om:therm-EC,
                                    om:therm-US,
                                    om:tonOfTNT,
                                    om:megaerg;
                 om:symbol "E_k";
                 a owl:Class;
                 rdfs:comment "Kinetic energy is energy due to motion."@en;
                 rdfs:label "kinetic energy"@en,
                            "kinetische energie"@nl,
                            "动能"@zh;
                 rdfs:subClassOf om:Energy.
om:KnudsenNumber om:commonlyHasUnit om:one;
                 om:symbol "Kn";
                 a owl:Class;
                 rdfs:comment "The Knudsen number is a dimensionless number defined as the ratio of the molecular mean free path length to a representative physical length scale."@en;
                 rdfs:label "Knudsen number"@en,
                            "getal van Knudsen"@nl;
                 rdfs:subClassOf om:Quantity,
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasValue ; 
                                  owl:allValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty om:hasUnit ; 
                                                     owl:allValuesFrom om:KnudsenNumberUnit]],
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasDimension ; 
                                  owl:hasValue om:dimensionOne].
om:KnudsenNumberUnit a owl:Class;
                     rdfs:label "Knudsen number unit"@en;
                     rdfs:subClassOf om:Unit;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (om:one)].
om:LaTeXCommand om:alternativeLabel "typeset by LaTeX command"@en;
                a owl:AnnotationProperty;
                rdfs:comment "OMLaTeX command that can be used to render this quantity or unit."@en;
                rdfs:label "LaTeX command"@en.
om:LaTeXSymbol om:alternativeLabel "has LaTeX symbol"@en,
                                   "LaTeX formatted symbol"@en;
               a owl:AnnotationProperty;
               rdfs:comment "OMLaTeX formatted symbol may include commands such as \\unit and \\E as defined in OMLaTeX."@en;
               rdfs:label "LaTeX symbol"@en.
om:LabelMass om:commonlyHasUnit om:gram,
                                om:kilogram,
                                om:tonne;
             om:unofficialLabel "label weight";
             a owl:Class;
             rdfs:label "label mass"@en;
             rdfs:subClassOf om:Mass.
om:LactoseMassFraction om:commonlyHasUnit om:one,
                                          om:percent,
                                          om:gramPerGram;
                       a owl:Class;
                       rdfs:comment "The fraction of the mass of lactose in a phenomenon"@en;
                       rdfs:label "lactose mass fraction"@en;
                       rdfs:subClassOf om:MassFraction.
om:Length om:alternativeSymbol "L";
          om:commonlyHasUnit om:metre,
                             om:attometre,
                             om:centimetre,
                             om:decametre,
                             om:decimetre,
                             om:exametre,
                             om:femtometre,
                             om:gigametre,
                             om:hectometre,
                             om:kilometre,
                             om:megametre,
                             om:micrometre,
                             om:millimetre,
                             om:nanometre,
                             om:petametre,
                             om:picometre,
                             om:terametre,
                             om:angstrom,
                             om:chain,
                             om:fathom-USSurvey,
                             om:fermi,
                             om:foot-International,
                             om:foot-USSurvey,
                             om:furlong-International,
                             om:inch-International,
                             om:micron,
                             om:mil-Length,
                             om:mile-Statute,
                             om:mile-USSurvey,
                             om:nauticalMile-International,
                             om:rod-US,
                             om:yard-International,
                             om:astronomicalUnit,
                             om:lightYear,
                             om:parsec,
                             om:solarRadius,
                             om:gigaparsec,
                             om:kiloparsec,
                             om:megaparsec,
                             om:cicero,
                             om:pica-ATA,
                             om:pica-Postscript,
                             om:pica-TeX,
                             om:point-ATA,
                             om:point-Didot,
                             om:point-Postscript,
                             om:point-TeX;
          om:symbol "l";
          a owl:Class;
          rdfs:comment "Length is the amount of space between two geographical points along a curve. It is a base quantity in the International System of Units and other systems of units. Length is speed times time. The metre, a base unit of length in the International System of Units, is defined in terms of speed of light during a certain time interval."@en;
          rdfs:label "length"@en,
                     "lengte"@nl,
                     "长度"@zh;
          rdfs:subClassOf om:Quantity,
                          [a owl:Restriction ; 
                           owl:onProperty om:hasValue ; 
                           owl:allValuesFrom [a owl:Restriction ; 
                                              owl:onProperty om:hasUnit ; 
                                              owl:allValuesFrom om:LengthUnit]],
                          [a owl:Restriction ; 
                           owl:onProperty om:hasDimension ; 
                           owl:hasValue om:length-Dimension].
om:LengthFraction om:commonlyHasUnit om:metrePerMetre,
                                     om:millimetrePerMetre;
                  a owl:Class;
                  rdfs:label "length fraction"@en,
                             "lengtefractie"@nl;
                  rdfs:subClassOf om:Quantity,
                                  [a owl:Restriction ; 
                                   owl:onProperty om:hasDimension ; 
                                   owl:hasValue om:dimensionOne].
om:LengthUnit a owl:Class;
              rdfs:label "length unit"@en;
              rdfs:subClassOf om:Unit;
              owl:equivalentClass [a owl:Class ; 
                                   owl:unionOf ([a owl:Class ; 
                                                owl:oneOf (om:angstrom
                                                           om:astronomicalUnit
