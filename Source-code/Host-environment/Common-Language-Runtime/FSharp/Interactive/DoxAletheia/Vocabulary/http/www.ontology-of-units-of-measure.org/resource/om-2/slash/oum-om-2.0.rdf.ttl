                                  om:microbar,
                                  om:millibar,
                                  om:metreOfMercury,
                                  om:centimetreOfMercury,
                                  om:millimetreOfMercury,
                                  om:atmosphere-Standard,
                                  om:atmosphere-Technical,
                                  om:barye,
                                  om:torr;
               om:symbol "E''";
               a owl:Class;
               rdfs:label "loss modulus"@en;
               rdfs:subClassOf om:DynamicModulus.
om:Luminance om:alternativeSymbol "L_v";
             om:commonlyHasUnit om:candelaPerSquareMetre,
                                om:candelaPerSquareCentimetre,
                                om:footlambert,
                                om:lambert,
                                om:stilb;
             om:symbol "L";
             a owl:Class;
             rdfs:comment "Luminous flux is the total visible energy emitted by a source per unit time."@en;
             rdfs:label "luminance"@en;
             rdfs:subClassOf om:Quantity,
                             [a owl:Restriction ; 
                              owl:onProperty om:hasValue ; 
                              owl:allValuesFrom [a owl:Restriction ; 
                                                 owl:onProperty om:hasUnit ; 
                                                 owl:allValuesFrom om:LuminanceUnit]],
                             [a owl:Restriction ; 
                              owl:onProperty om:hasDimension ; 
                              owl:hasValue om:luminance-Dimension].
om:LuminanceUnit a owl:Class;
                 rdfs:label "luminance unit"@en;
                 rdfs:subClassOf om:Unit;
                 owl:equivalentClass [a owl:Class ; 
                                      owl:oneOf (om:footlambert
                                                 om:lambert
                                                 om:stilb
                                                 om:candelaPerSquareMetre
                                                 om:candelaPerSquareCentimetre)].
om:LuminosityFunction om:commonlyHasUnit om:reciprocalCubicParsec;
                      a owl:Class;
                      rdfs:comment "The number of stars of absolute magnitudes between Mv and Mv+ΔMv per cubic parsec."@en;
                      rdfs:label "luminosity function"@en;
                      rdfs:subClassOf om:NumberDensity.
om:LuminousEfficacy om:commonlyHasUnit om:lumenPerWatt;
                    a owl:Class;
                    rdfs:label "luminous efficacy"@en;
                    rdfs:subClassOf om:Quantity,
                                    [a owl:Restriction ; 
                                     owl:onProperty om:hasValue ; 
                                     owl:allValuesFrom [a owl:Restriction ; 
                                                        owl:onProperty om:hasUnit ; 
                                                        owl:allValuesFrom om:LuminousEfficacyUnit]],
                                    [a owl:Restriction ; 
                                     owl:onProperty om:hasDimension ; 
                                     owl:hasValue om:luminousEfficacy-Dimension].
om:LuminousEfficacyUnit a owl:Class;
                        rdfs:label "luminous efficacy unit"@en;
                        rdfs:subClassOf om:Unit;
                        owl:equivalentClass [a owl:Class ; 
                                             owl:oneOf (om:lumenPerWatt)].
om:LuminousEnergy om:commonlyHasUnit om:lumenSecond-Time;
                  om:symbol "F";
                  a owl:Class;
                  rdfs:label "luminous energy"@en;
                  rdfs:subClassOf om:Quantity,
                                  [a owl:Restriction ; 
                                   owl:onProperty om:hasValue ; 
                                   owl:allValuesFrom [a owl:Restriction ; 
                                                      owl:onProperty om:hasUnit ; 
                                                      owl:allValuesFrom om:LuminousEnergyUnit]],
                                  [a owl:Restriction ; 
                                   owl:onProperty om:hasDimension ; 
                                   owl:hasValue om:luminousEnergy-Dimension].
om:LuminousEnergyUnit a owl:Class;
                      rdfs:label "luminous energy unit"@en;
                      rdfs:subClassOf om:Unit;
                      owl:equivalentClass [a owl:Class ; 
                                           owl:oneOf (om:lumenSecond-Time)].
om:LuminousFlux om:commonlyHasUnit om:candelaSteradian,
                                   om:lumen,
                                   om:attolumen,
                                   om:centilumen,
                                   om:decalumen,
                                   om:decilumen,
                                   om:exalumen,
                                   om:femtolumen,
                                   om:gigalumen,
                                   om:hectolumen,
                                   om:kilolumen,
                                   om:megalumen,
                                   om:microlumen,
                                   om:millilumen,
                                   om:nanolumen,
                                   om:petalumen,
                                   om:picolumen,
                                   om:teralumen;
                om:symbol "F";
                a owl:Class;
                rdfs:comment "Luminous flux is the total visible energy emitted by a source per unit time."@en;
                rdfs:label "luminous flux"@en;
                rdfs:subClassOf om:Quantity,
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasValue ; 
                                 owl:allValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty om:hasUnit ; 
                                                    owl:allValuesFrom om:LuminousFluxUnit]],
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasDimension ; 
                                 owl:hasValue om:luminousFlux-Dimension].
om:LuminousFluxUnit a owl:Class;
                    rdfs:label "luminous flux unit"@en;
                    rdfs:subClassOf om:Unit;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:unionOf ([a owl:Class ; 
                                                      owl:oneOf (om:lumen
                                                                 om:candelaSteradian)]
                                                      om:PrefixedLumen)].
om:LuminousIntensity om:alternativeSymbol "I_v";
                     om:commonlyHasUnit om:candela,
                                        om:attocandela,
                                        om:centicandela,
                                        om:decacandela,
                                        om:decicandela,
                                        om:exacandela,
                                        om:femtocandela,
                                        om:gigacandela,
                                        om:hectocandela,
                                        om:kilocandela,
                                        om:megacandela,
                                        om:microcandela,
                                        om:millicandela,
                                        om:nanocandela,
                                        om:petacandela,
                                        om:picocandela,
                                        om:teracandela;
                     om:symbol "I";
                     a owl:Class;
                     rdfs:comment "Luminous intensity is the wavelength-weighted power emitted by a light source in a particular direction per unit solid angle. It is a base quantity in the International System of Units. Luminous intensity is luminous flux divided by solid angle."@en;
                     rdfs:label "luminous intensity"@en,
                                "lichtsterkte"@nl;
                     rdfs:subClassOf om:Quantity,
                                     [a owl:Restriction ; 
                                      owl:onProperty om:hasValue ; 
                                      owl:allValuesFrom [a owl:Restriction ; 
                                                         owl:onProperty om:hasUnit ; 
                                                         owl:allValuesFrom om:LuminousIntensityUnit]],
                                     [a owl:Restriction ; 
                                      owl:onProperty om:hasDimension ; 
                                      owl:hasValue om:luminousIntensity-Dimension].
om:LuminousIntensityUnit a owl:Class;
                         rdfs:label "luminous intensity unit"@en;
                         rdfs:subClassOf om:Unit;
                         owl:equivalentClass [a owl:Class ; 
                                              owl:unionOf ([a owl:Class ; 
                                                           owl:oneOf (om:candela)]
                                                           om:PrefixedCandela)].
om:MachNumber om:commonlyHasUnit om:one;
              om:symbol "Ma";
              a owl:Class;
              rdfs:comment "The Mach number is the speed of an object that moves through air, or any fluid substance, divided by the speed of sound as it is in that substance."@en;
              rdfs:label "Mach number"@en,
                         "Machgetal"@nl;
              rdfs:subClassOf om:Quantity,
                              [a owl:Restriction ; 
                               owl:onProperty om:hasValue ; 
                               owl:allValuesFrom [a owl:Restriction ; 
                                                  owl:onProperty om:hasUnit ; 
                                                  owl:allValuesFrom om:MachNumberUnit]],
                              [a owl:Restriction ; 
                               owl:onProperty om:hasDimension ; 
                               owl:hasValue om:dimensionOne].
om:MachNumberUnit a owl:Class;
                  rdfs:label "Mach number unit"@en;
                  rdfs:subClassOf om:Unit;
                  owl:equivalentClass [a owl:Class ; 
                                       owl:oneOf (om:one)].
om:MagneticField om:alternativeLabel "magnetic field strength"@en,
                                     "magnetic field intensity"@en,
                                     "magnetizing field"@en;
                 om:commonlyHasUnit om:amperePerMetre,
                                    om:oersted;
                 om:symbol "H";
                 a owl:Class;
                 rdfs:label "magnetic field"@en;
                 rdfs:subClassOf om:Quantity,
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasValue ; 
                                  owl:allValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty om:hasUnit ; 
                                                     owl:allValuesFrom om:MagneticFieldUnit]],
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasDimension ; 
                                  owl:hasValue om:MagneticField-Dimension].
om:MagneticField-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                           om:hasSIElectricCurrentDimensionExponent 1 ;
                           om:hasSILengthDimensionExponent -1 ;
                           om:hasSILuminousIntensityDimensionExponent 0 ;
                           om:hasSIMassDimensionExponent 0 ;
                           om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                           om:hasSITimeDimensionExponent 0 ;
                           a om:Dimension;
                           rdfs:label "magnetic field dimension"@en.
om:MagneticFieldUnit a owl:Class;
                     rdfs:label "magnetic field unit"@en;
                     rdfs:subClassOf om:Unit;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (om:oersted
                                                     om:amperePerMetre)].
om:MagneticFlux om:commonlyHasUnit om:voltSecond-Time,
                                   om:weber,
                                   om:attoweber,
                                   om:centiweber,
                                   om:decaweber,
                                   om:deciweber,
                                   om:exaweber,
                                   om:femtoweber,
                                   om:gigaweber,
                                   om:hectoweber,
                                   om:kiloweber,
                                   om:megaweber,
                                   om:microweber,
                                   om:milliweber,
                                   om:nanoweber,
                                   om:petaweber,
                                   om:picoweber,
                                   om:teraweber,
                                   om:maxwell,
                                   om:statweber,
                                   om:unitPole;
                om:symbol "Φ";
                a owl:Class;
                rdfs:comment "Magnetic flux through any area perpendicular to a magnetic field is the product of the area by the field strength."@en;
                rdfs:label "magnetic flux"@en;
                rdfs:subClassOf om:Quantity,
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasValue ; 
                                 owl:allValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty om:hasUnit ; 
                                                    owl:allValuesFrom om:MagneticFluxUnit]],
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasDimension ; 
                                 owl:hasValue om:magneticFlux-Dimension].
om:MagneticFluxDensity om:alternativeLabel "magnetic field"@en,
                                           "magnetic induction"@en;
                       om:commonlyHasUnit om:weberPerSquareMetre,
                                          om:tesla,
                                          om:attotesla,
                                          om:centitesla,
                                          om:decatesla,
                                          om:decitesla,
                                          om:exatesla,
                                          om:femtotesla,
                                          om:gigatesla,
                                          om:hectotesla,
                                          om:kilotesla,
                                          om:megatesla,
                                          om:microtesla,
                                          om:millitesla,
                                          om:nanotesla,
                                          om:petatesla,
                                          om:picotesla,
                                          om:teratesla,
                                          om:gamma,
                                          om:gauss,
                                          om:stattesla,
                                          om:milligauss;
                       om:symbol "B";
                       a owl:Class;
                       rdfs:label "magnetic flux density"@en;
                       rdfs:subClassOf om:Quantity,
                                       [a owl:Restriction ; 
                                        owl:onProperty om:hasValue ; 
                                        owl:allValuesFrom [a owl:Restriction ; 
                                                           owl:onProperty om:hasUnit ; 
                                                           owl:allValuesFrom om:MagneticFluxDensityUnit]],
                                       [a owl:Restriction ; 
                                        owl:onProperty om:hasDimension ; 
                                        owl:hasValue om:magneticFluxDensity-Dimension].
om:MagneticFluxDensityUnit a owl:Class;
                           rdfs:label "magnetic flux density unit"@en;
                           rdfs:subClassOf om:Unit;
                           owl:equivalentClass [a owl:Class ; 
                                                owl:unionOf ([a owl:Class ; 
                                                             owl:oneOf (om:gamma
                                                                        om:gauss
                                                                        om:stattesla
                                                                        om:tesla
                                                                        om:weberPerSquareMetre
                                                                        om:milligauss)]
                                                             om:PrefixedTesla)].
om:MagneticFluxUnit a owl:Class;
                    rdfs:label "magnetic flux unit"@en;
                    rdfs:subClassOf om:Unit;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:unionOf ([a owl:Class ; 
                                                      owl:oneOf (om:maxwell
                                                                 om:statweber
                                                                 om:unitPole
                                                                 om:weber
                                                                 om:voltSecond-Time)]
                                                      om:PrefixedWeber)].
om:MagneticReynoldsNumber om:commonlyHasUnit om:one;
                          om:symbol "Rm";
                          a owl:Class;
                          rdfs:label "magnetic Reynolds number"@en,
                                     "magnetisch getal van Reynolds"@nl;
                          rdfs:subClassOf om:Quantity,
                                          [a owl:Restriction ; 
                                           owl:onProperty om:hasValue ; 
                                           owl:allValuesFrom [a owl:Restriction ; 
                                                              owl:onProperty om:hasUnit ; 
                                                              owl:allValuesFrom om:MagneticReynoldsNumberUnit]],
                                          [a owl:Restriction ; 
                                           owl:onProperty om:hasDimension ; 
                                           owl:hasValue om:dimensionOne].
om:MagneticReynoldsNumberUnit a owl:Class;
                              rdfs:label "magnetic Reynolds number unit"@en;
                              rdfs:subClassOf om:Unit;
                              owl:equivalentClass [a owl:Class ; 
                                                   owl:oneOf (om:one)].
om:MagnetomotiveForce om:commonlyHasUnit om:ampere,
                                         om:attoampere,
                                         om:centiampere,
                                         om:decaampere,
                                         om:deciampere,
                                         om:exaampere,
                                         om:femtoampere,
                                         om:gigaampere,
                                         om:hectoampere,
                                         om:kiloampere,
                                         om:megaampere,
                                         om:microampere,
                                         om:milliampere,
                                         om:nanoampere,
                                         om:petaampere,
                                         om:picoampere,
                                         om:teraampere,
                                         om:gilbert;
                      om:symbol "F";
                      a owl:Class;
                      rdfs:label "magnetomotive force"@en;
                      rdfs:subClassOf om:Quantity,
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasValue ; 
                                       owl:allValuesFrom [a owl:Restriction ; 
                                                          owl:onProperty om:hasUnit ; 
                                                          owl:allValuesFrom om:MagnetomotiveForceUnit]],
                                      [a owl:Restriction ; 
                                       owl:onProperty om:hasDimension ; 
                                       owl:hasValue om:electricCurrent-Dimension].
om:MagnetomotiveForceUnit a owl:Class;
                          rdfs:label "magnetomotive force unit"@en;
                          rdfs:subClassOf om:Unit;
                          owl:equivalentClass [a owl:Class ; 
                                               owl:unionOf ([a owl:Class ; 
                                                            owl:oneOf (om:gilbert)]
                                                            om:PrefixedAmpere)].
om:Magnitude om:commonlyHasUnit om:one,
                                om:magnitude,
                                om:millimagnitude,
                                om:micromagnitude;
             om:longcomment """The magnitude scale was originally created by Hipparchos of Nicea (160-127 BCE) and was measured by comparing the brightness between stars. Initially this was done inaccurately by eye but is currently done by using photoelectric photometers or even more recently by CCDs. Hipparchos divided the stars into six magnitude (brightness classes), the brightest stars being assigned to the first class and the faintest to the sixth class. By about the middle 1800s it became apparent that the traditional magnitude scale is close to a logarithmic scale with base 2.5. This is due to the fact that the response of the eye is nearly logarithmic. N.R. Pogson formalised the magnitude scale to closely match the traditional (visual) scale. It is now defined as:  
    m₁ - m₂ = - 2.5 log (f₁ / f₂)
    where m₁ - m₂ is the magnitude difference between two objects, and f₁ and f₂ are the luminous fluxes of the two objects. The magnitude of Vega (α Lyrae, HD 172167) is defined to be 0 in all wavelengths and passbands, although in practice this can only be an approximation. The zero point is now defined using multiple standard stars from the north polar sequence (non-variable stars within 2 degrees of the north celestial pole) or secondary standard stars from other parts of the sky. Please note that the scale is inverted, objects of magnitude 1 have a higher luminous flux than objects of magnitude 5. Stars of magnitude 6 are just visible to the naked eye under good observing conditions.
    The units of magnitude, also called magnitude, are usually not indicated except when indicating small magnitude differences when milli- or micromagnitudes are used."""@en;
             om:symbol "m";
             a owl:Class;
             rdfs:comment "Reverse logarithmic measure of the brightness of an object."@en;
             rdfs:label "magnitude"@en,
                        "magnitude"@nl;
             rdfs:subClassOf om:Quantity,
                             [a owl:Restriction ; 
                              owl:onProperty om:hasDimension ; 
                              owl:hasValue om:dimensionOne],
                             [a owl:Restriction ; 
                              owl:onProperty om:hasValue ; 
                              owl:allValuesFrom [a owl:Restriction ; 
                                                 owl:onProperty om:hasUnit ; 
                                                 owl:allValuesFrom om:MagnitudeUnit]];
             ombibo:reference ombibo:Astrophysical_Techniques_chapter3,
                              ombibo:IntroAstronomicalPhotometry_chapter_2.
om:MagnitudeAtMaximumBrightness om:commonlyHasUnit om:one,
                                                   om:magnitude;
                                om:symbol "m_max";
                                a owl:Class;
                                rdfs:comment "The magnitude at maximum brightness of a variable star."@en;
                                rdfs:label "magnitude at maximum brightness"@en;
                                rdfs:subClassOf om:Magnitude.
om:MagnitudeAtMinimumBrightness om:commonlyHasUnit om:one,
                                                   om:magnitude;
                                om:symbol "m_min";
                                a owl:Class;
                                rdfs:comment "The magnitude at minimum brightness of a variable star."@en;
                                rdfs:label "magnitude at minimum brightness"@en;
                                rdfs:subClassOf om:Magnitude.
om:MagnitudeUnit a owl:Class;
                 rdfs:label "magnitude unit"@en;
                 rdfs:subClassOf om:Unit;
                 owl:equivalentClass [a owl:Class ; 
                                      owl:oneOf (om:one
                                                 om:magnitude
                                                 om:millimagnitude
                                                 om:micromagnitude)].
om:ManualFirmness om:alternativeLabel "firmness_m"@en;
                  om:commonlyHasUnit om:_0-5;
                  a owl:Class;
                  rdfs:comment "Firmness manueel: code 0 - 5."@nl;
                  rdfs:label "manual firmness"@en,
                             "manuele stevigheid"@nl;
                  rdfs:subClassOf om:Quantity.
om:Mass om:commonlyHasUnit om:gram,
                           om:attogram,
                           om:exagram,
                           om:centigram,
                           om:decagram,
                           om:decigram,
                           om:femtogram,
                           om:gigagram,
                           om:hectogram,
                           om:kilogram,
                           om:megagram,
                           om:microgram,
                           om:milligram,
                           om:nanogram,
                           om:petagram,
                           om:picogram,
                           om:teragram,
                           om:tonne,
                           om:kilotonne,
                           om:megatonne,
                           om:unifiedAtomicMassUnit,
                           om:nanounifiedAtomicMassUnit,
                           om:carat-Mass,
                           om:grain,
                           om:hundredweight-British,
                           om:hundredweight-US,
                           om:InternationalUnit,
                           om:milligramRAE,
                           om:ounceAvoirdupois,
                           om:ounceApothecaries,
                           om:pennyweight-Troy,
                           om:poundApothecaries,
                           om:poundAvoirdupois,
                           om:slug,
                           om:ton-ShortAssay,
                           om:ton-Long,
                           om:ton-Short,
                           om:solarMass;
        om:symbol "m";
        om:unofficialLabel "weight";
        a owl:Class;
        rdfs:comment "Mass is the amount of matter of a phenomenon. It is a base quantity in the International System of Units. Mass is force divided by acceleration."@en;
        rdfs:label "mass"@en,
                   "massa"@nl,
                   "质量"@zh;
        rdfs:subClassOf om:Quantity,
                        [a owl:Restriction ; 
                         owl:onProperty om:hasValue ; 
                         owl:allValuesFrom [a owl:Restriction ; 
                                            owl:onProperty om:hasUnit ; 
                                            owl:allValuesFrom om:MassUnit]],
                        [a owl:Restriction ; 
                         owl:onProperty om:hasDimension ; 
                         owl:hasValue om:mass-Dimension].
om:MassFlow om:commonlyHasUnit om:kilogramPerSecond-Time;
            a owl:Class;
            rdfs:comment "Mass flow is the movement of substances at equal rates or as a single body."@en;
            rdfs:label "mass flow"@en;
            rdfs:subClassOf om:Quantity,
                            [a owl:Restriction ; 
                             owl:onProperty om:hasValue ; 
                             owl:allValuesFrom [a owl:Restriction ; 
                                                owl:onProperty om:hasUnit ; 
                                                owl:allValuesFrom om:MassFlowUnit]],
                            [a owl:Restriction ; 
                             owl:onProperty om:hasDimension ; 
                             owl:hasValue om:massFlow-Dimension].
om:MassFlowUnit a owl:Class;
                rdfs:label "mass flow unit"@en;
                rdfs:subClassOf om:Unit;
                owl:equivalentClass [a owl:Class ; 
                                     owl:oneOf (om:gramPerDay
                                                om:kilogramPerSecond-Time
                                                om:milligramPerDay)].
om:MassFraction om:alternativeLabel "concentration (w/w)"@en;
                om:commonlyHasUnit om:one,
                                   om:percent,
                                   om:partsPerMillion,
                                   om:gramPerGram,
                                   om:gramPerKilogram,
                                   om:gramPerHectogram,
                                   om:kilogramPerKilogram,
                                   om:milligramPerHectogram,
                                   om:milligramPerKilogram,
                                   om:microgramPerHectogram;
                om:symbol "w";
                a owl:Class;
                rdfs:label "mass fraction"@en,
                           "massafractie"@nl;
                rdfs:subClassOf om:Quantity,
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasDimension ; 
                                 owl:hasValue om:dimensionOne],
                                [a owl:Restriction ; 
                                 owl:onProperty om:hasValue ; 
                                 owl:allValuesFrom [a owl:Restriction ; 
                                                    owl:onProperty om:hasUnit ; 
                                                    owl:allValuesFrom om:MassFractionUnit]].
om:MassFractionUnit a owl:Class;
                    rdfs:label "mass fraction unit"@en;
                    rdfs:subClassOf om:Unit;
                    owl:equivalentClass [a owl:Class ; 
                                         owl:oneOf (om:one
                                                    om:partsPerMillion
                                                    om:percent
                                                    om:gramPerGram
                                                    om:gramPerKilogram
                                                    om:gramPerHectogram
                                                    om:kilogramPerKilogram
                                                    om:milligramPerHectogram
                                                    om:milligramPerKilogram
                                                    om:microgramPerHectogram)].
om:MassPerEnergy a owl:Class;
                 rdfs:label "mass per energy"@en;
                 rdfs:subClassOf om:Quantity,
                                 [a owl:Restriction ; 
                                  owl:onProperty om:hasValue ; 
                                  owl:allValuesFrom [a owl:Restriction ; 
                                                     owl:onProperty om:hasUnit ; 
                                                     owl:allValuesFrom om:MassPerEnergyUnit]].
om:MassPerEnergyUnit a owl:Class;
                     rdfs:label "mass per energy unit"@en;
                     rdfs:subClassOf om:Unit;
                     owl:equivalentClass [a owl:Class ; 
                                          owl:oneOf (om:gramPerJoule
                                                     om:kilogramPerGigaJoule
                                                     om:microgramPerJoule)].
om:MassUnit a owl:Class;
            rdfs:label "mass unit"@en;
            rdfs:subClassOf om:Unit;
            owl:equivalentClass [a owl:Class ; 
                                 owl:unionOf ([a owl:Class ; 
                                              owl:oneOf (om:carat-Mass
                                                         om:grain
                                                         om:gram
                                                         om:hundredweight-British
                                                         om:hundredweight-US
                                                         om:InternationalUnit
                                                         om:milligramRAE
                                                         om:ounceApothecaries
                                                         om:ounceAvoirdupois
                                                         om:pennyweight-Troy
                                                         om:poundApothecaries
                                                         om:poundAvoirdupois
                                                         om:slug
                                                         om:solarMass
                                                         om:ton-ShortAssay
                                                         om:ton-Long
                                                         om:ton-Short
                                                         om:tonne
                                                         om:unifiedAtomicMassUnit)]
                                              om:PrefixedGram
                                              om:PrefixedTonne
                                              om:PrefixedUnifiedAtomicMassUnit)].
om:Measure a owl:Class;
           rdfs:comment """A measure combines a number to a unit of measure. For example, \"3 m\" is a measure."""@en;
           rdfs:label "measure"@en.
om:Metallicity om:commonlyHasUnit om:one;
               a owl:Class;
               rdfs:comment "The log of the ratio between the ratios of the observed Fe and H quantities in a star and the same ratio in the Sun. This is a very important quantity that is often used in astronomy as an indicator of the age of a star."@en;
               rdfs:label "metallicity"@en;
               rdfs:subClassOf om:QuantityOfDimensionOne.
om:MetrePerPrefixedSecond-Time a owl:Class;
                               rdfs:label "metre per prefixed second (time)"@en;
                               rdfs:subClassOf om:UnitDivision;
                               owl:equivalentClass [a owl:Class ; 
                                                    owl:intersectionOf ([a owl:Restriction ; 
                                                                        owl:onProperty om:hasNumerator ; 
                                                                        owl:hasValue om:metre]
                                                                        [a owl:Restriction ; 
                                                                        owl:onProperty om:hasNumerator ; 
                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger]
                                                                        [a owl:Restriction ; 
                                                                        owl:onProperty om:hasDenominator ; 
                                                                        owl:allValuesFrom om:PrefixedSecond-Time]
                                                                        [a owl:Restriction ; 
                                                                        owl:onProperty om:hasDenominator ; 
                                                                        owl:cardinality "1"^^xsd:nonNegativeInteger])].
om:MetrePerPrefixedSecond-TimeSquared a owl:Class;
                                      rdfs:label "metre per prefixed second (time) squared"@en;
                                      rdfs:subClassOf om:UnitDivision;
                                      owl:equivalentClass [a owl:Class ; 
                                                           owl:intersectionOf ([a owl:Restriction ; 
                                                                               owl:onProperty om:hasNumerator ; 
                                                                               owl:hasValue om:metre]
                                                                               [a owl:Restriction ; 
                                                                               owl:onProperty om:hasNumerator ; 
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger]
                                                                               [a owl:Restriction ; 
                                                                               owl:onProperty om:hasDenominator ; 
                                                                               owl:allValuesFrom om:PrefixedSecond-TimeSquared]
                                                                               [a owl:Restriction ; 
                                                                               owl:onProperty om:hasDenominator ; 
                                                                               owl:cardinality "1"^^xsd:nonNegativeInteger])].
om:MexicanPeso a om:Unit,
                 om:SingularUnit;
               rdfs:label "Mexican peso"@en,
                          "墨西哥比索"@zh.
om:ModeratedStarchMassFraction om:commonlyHasUnit om:one,
