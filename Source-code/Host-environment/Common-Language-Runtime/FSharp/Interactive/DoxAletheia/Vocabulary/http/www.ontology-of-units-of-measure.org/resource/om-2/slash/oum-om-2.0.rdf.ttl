om:DynamicModulus om:commonlyHasUnit om:newtonPerSquareMetre,
                                     om:kilogramSecond-TimeToThePower-2ReciprocalMetre,
                                     om:pascal,
                                     om:attopascal,
                                     om:centipascal,
                                     om:decapascal,
                                     om:decipascal,
                                     om:exapascal,
                                     om:femtopascal,
                                     om:gigapascal,
                                     om:hectopascal,
                                     om:kilopascal,
                                     om:megapascal,
                                     om:micropascal,
                                     om:millipascal,
                                     om:nanopascal,
                                     om:petapascal,
                                     om:picopascal,
