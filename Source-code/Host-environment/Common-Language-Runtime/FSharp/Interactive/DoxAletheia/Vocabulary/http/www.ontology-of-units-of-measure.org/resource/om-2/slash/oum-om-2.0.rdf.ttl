om:volumetricHeatCapacity-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                                    om:hasSIElectricCurrentDimensionExponent 0 ;
                                    om:hasSILengthDimensionExponent -1 ;
                                    om:hasSILuminousIntensityDimensionExponent 0 ;
