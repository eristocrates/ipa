               a owl:AnnotationProperty;
               rdfs:label "longcomment"@en,
                          "詳細な注釈"@ja.
om:lumen om:hasDimension om:luminousFlux-Dimension;
         om:hasUnit om:candelaSteradian;
         om:longcomment "The lumen is a unit of luminous flux defined as candela times steradian = lux times square metre. The lumen is a derived unit in the International System of Units."@en;
         om:symbol "lm";
         a om:Unit,
           om:SingularUnit;
         rdfs:comment "The lumen is a unit of luminous flux defined as candela times steradian = lux times square metre."@en;
         rdfs:label "lumen"@en,
                    "lumen"@nl.
om:lumenPerSquareMetre om:alternativeSymbol "lm m-2",
                                            "lm·m-2";
                       om:hasDenominator om:squareMetre;
                       om:hasDimension om:illuminance-Dimension;
                       om:hasNumerator om:lumen;
                       om:symbol "lm/m2";
                       a om:UnitDivision;
                       rdfs:label "lumen per square metre"@en,
                                  "lumen per vierkante meter"@nl.
om:lumenPerWatt om:alternativeSymbol "lm W-1",
                                     "lm·W-1";
                om:hasDenominator om:watt;
                om:hasDimension om:luminousEfficacy-Dimension;
                om:hasNumerator om:lumen;
                om:symbol "lm/W";
                a om:UnitDivision;
                rdfs:label "lumen per watt"@en,
                           "lumen per watt"@nl.
om:lumenSecond-Time om:alternativeSymbol "lm·s";
                    om:hasDimension om:luminousEnergy-Dimension;
                    om:hasTerm1 om:lumen;
                    om:hasTerm2 om:second-Time;
                    om:symbol "lm s";
                    a om:UnitMultiplication;
                    rdfs:label "lumen second"@en,
                               "lumen seconde"@nl.
om:luminance-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                       om:hasSIElectricCurrentDimensionExponent 0 ;
                       om:hasSILengthDimensionExponent -2 ;
                       om:hasSILuminousIntensityDimensionExponent 1 ;
                       om:hasSIMassDimensionExponent 0 ;
                       om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                       om:hasSITimeDimensionExponent 0 ;
                       a om:Dimension;
                       rdfs:label "luminance dimension"@en.
om:luminousEfficacy-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                              om:hasSIElectricCurrentDimensionExponent 0 ;
                              om:hasSILengthDimensionExponent -2 ;
                              om:hasSILuminousIntensityDimensionExponent 1 ;
                              om:hasSIMassDimensionExponent -1 ;
                              om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                              om:hasSITimeDimensionExponent 3 ;
                              a om:Dimension;
                              rdfs:label "luminous efficacy dimension"@en.
om:luminousEnergy-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                            om:hasSIElectricCurrentDimensionExponent 0 ;
                            om:hasSILengthDimensionExponent 0 ;
                            om:hasSILuminousIntensityDimensionExponent 1 ;
                            om:hasSIMassDimensionExponent 0 ;
                            om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                            om:hasSITimeDimensionExponent 1 ;
                            a om:Dimension;
                            rdfs:label "luminous energy dimension"@en.
om:luminousFlux-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                          om:hasSIElectricCurrentDimensionExponent 0 ;
                          om:hasSILengthDimensionExponent 0 ;
                          om:hasSILuminousIntensityDimensionExponent 1 ;
                          om:hasSIMassDimensionExponent 0 ;
                          om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                          om:hasSITimeDimensionExponent 0 ;
                          a om:Dimension;
                          rdfs:label "luminous flux dimension"@en.
om:luminousIntensity-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                               om:hasSIElectricCurrentDimensionExponent 0 ;
                               om:hasSILengthDimensionExponent 0 ;
                               om:hasSILuminousIntensityDimensionExponent 1 ;
                               om:hasSIMassDimensionExponent 0 ;
                               om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                               om:hasSITimeDimensionExponent 0 ;
                               om:symbol "J";
                               a om:Dimension;
                               rdfs:label "luminous intensity dimension"@en,
                                          "lichtsterktedimensie"@nl.
om:luminousIntensityInAGivenDirectionOfASourceThatEmitsMonochromaticRadiationOfFrequency540e12HertzAndThatHasARadiantIntensityInThatDirectionOf1683WattPerSteradian a om:LuminousIntensity;
                                                                                                                                                                    rdfs:label "luminous intensity, in a given direction, of a source that emits monochromatic radiation of frequency 540e12 hertz and that has a radiant intensity in that direction of 1/683 watt per steradian"@en.
om:lux om:hasDimension om:illuminance-Dimension;
       om:hasUnit om:lumenPerSquareMetre;
       om:longcomment "The lux is a unit of illuminance defined as lumen divided by square metre = candela times steradian divided by square metre. The lux is a derived unit in the International System of Units."@en;
       om:symbol "lx";
       a om:Unit,
         om:SingularUnit;
       rdfs:comment "The lux is a unit of illuminance defined as lumen divided by square metre = candela times steradian divided by square metre."@en;
       rdfs:label "lux"@en,
                  "lux"@nl.
om:luxSecond-Time om:alternativeSymbol "lx·s";
                  om:hasDimension om:exposure-Dimension;
                  om:hasTerm1 om:lux;
                  om:hasTerm2 om:second-Time;
                  om:symbol "lx s";
                  a om:UnitMultiplication;
                  rdfs:label "lux second"@en,
                             "lux seconde"@nl.
om:magneticFlux-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                          om:hasSIElectricCurrentDimensionExponent -1 ;
                          om:hasSILengthDimensionExponent 2 ;
                          om:hasSILuminousIntensityDimensionExponent 0 ;
                          om:hasSIMassDimensionExponent 1 ;
