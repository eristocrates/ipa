                                         om:symbol "u/Å3";
                                         a om:UnitDivision;
                                         rdfs:label "unified atomic mass unit per cubic angstrom"@en.
om:unitPole om:hasDimension om:magneticFlux-Dimension;
            om:hasFactor 0.0000001256637;
            om:hasUnit om:weber;
            a om:Unit,
              om:SingularUnit;
            rdfs:comment "The unit pole is a unit of magnetic flux defined as 1.256637e-7 weber."@en;
            rdfs:label "unit pole"@en.
om:unofficialAbbreviation om:alternativeLabel "has unofficial abbreviation"@en,
                                              "非公式な略記がある"@ja;
                          a owl:AnnotationProperty;
