                     rdfs:label "quantum efficiency"@en;
                     rdfs:subClassOf [a owl:Restriction ; 
                                      owl:onProperty om:hasValue ; 
                                      owl:allValuesFrom [a owl:Restriction ; 
                                                         owl:onProperty om:hasUnit ; 
                                                         owl:allValuesFrom om:QuantumEfficiencyUnit]],
                                     om:Quantity,
