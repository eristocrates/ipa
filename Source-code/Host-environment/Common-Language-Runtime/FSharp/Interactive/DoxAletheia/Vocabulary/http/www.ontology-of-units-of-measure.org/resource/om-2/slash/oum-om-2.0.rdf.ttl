om:unifiedAtomicMassUnit om:hasDimension om:mass-Dimension;
                         om:symbol "u";
                         a om:Unit,
                           om:SingularUnit;
                         rdfs:comment "The unified atomic mass unit is a unit of mass defined as 1.660538782(83)e-27 kilogram."@en;
                         rdfs:label "unified atomic mass unit"@en.
om:unifiedAtomicMassUnitPerCubicAngstrom om:alternativeSymbol "u Å-3",
