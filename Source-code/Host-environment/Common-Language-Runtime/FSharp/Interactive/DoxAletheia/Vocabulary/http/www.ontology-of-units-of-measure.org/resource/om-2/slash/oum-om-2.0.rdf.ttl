om:magneticFluxDensity-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                                 om:hasSIElectricCurrentDimensionExponent -1 ;
                                 om:hasSILengthDimensionExponent 0 ;
                                 om:hasSILuminousIntensityDimensionExponent 0 ;
                                 om:hasSIMassDimensionExponent 1 ;
                                 om:hasSIThermodynamicTemperatureDimensionExponent 0 ;
                                 om:hasSITimeDimensionExponent -2 ;
                                 a om:Dimension;
                                 rdfs:label "magnetic flux density dimension"@en.
om:magnitude om:hasDimension om:dimensionOne;
             om:hasUnit om:one;
             om:symbol "mag";
             a om:Unit,
               om:SingularUnit;
             rdfs:comment "Eenheid waarmee de helderheid van sterren wordt aangegeven. Meestal wordt het symbool niet aangeduid (http://en.wikipedia.org/wiki/Magnitude_(astronomy))."@en;
             rdfs:label "magnitude"@en,
                        "magnitude"@nl.
om:magnitudePerSecond-AngleSquared om:alternativeSymbol "mag arcsec-2",
                                                        "mag·arcsec-2";
                                   om:hasDenominator om:second-AngleSquared;
                                   om:hasNumerator om:magnitude;
                                   om:symbol "mag/arcsec2";
                                   a om:UnitDivision;
                                   rdfs:comment "The brightness (in magnitudes) of an area on the celestial sphere of 1 arcsecond by 1 arcsecond."@en;
                                   rdfs:label "magnitude per second (angle) squared"@en.
om:mass-Dimension om:hasSIAmountOfSubstanceDimensionExponent 0 ;
                  om:hasSIElectricCurrentDimensionExponent 0 ;
