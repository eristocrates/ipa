                                                om:terasievert,
                                                om:rem;
                             a owl:Class;
                             rdfs:label "directional dose equivalent"@en;
                             rdfs:subClassOf om:DoseEquivalent.
om:DisodiumEthyleneDiamineTetreAcetateMassFraction om:alternativeLabel "NaEDTA mass fraction"@en;
