                                [owl:onProperty bibo:issn ; 
                                 owl:allValuesFrom rdfs:Literal ; 
                                 a owl:Restriction];
                status:term_status "stable".
bibo:PersonalCommunicationDocument iao:0000112 "A personal communication manifested in some document.";
                                   iao:0000115 "A personal communication manifested in some document.";
                                   a owl:Class;
                                   rdfs:label "Personal Communication Document";
                                   rdfs:subClassOf bibo:Document.
bibo:Proceedings iao:0000112 "Short Definition copied from bibo ontology";
                 iao:0000115 "A compilation of documents published from an event, such as a conference";
                 a owl:Class;
