foaf: rdfs:label "FOAF (Friend of a Friend)".
foaf:Agent iao:0000111 "agent";
           iao:0000112 "see: http://xmlns.com/foaf/spec/#term_Agent";
           iao:0000115 "Agents are things that do stuff",
                       "Things that do stuff.";
           iao:0000117 "PERSON: Scott Hoffmann";
           iao:0000118 "";
           a owl:Class;
           rdfs:comment "An agent";
           rdfs:label "Agent";
           rdfs:subClassOf [owl:onProperty vivo:freetextKeyword ; 
                            owl:allValuesFrom rdfs:Literal ; 
                            a owl:Restriction],
                           [owl:onProperty vivo:freetextKeyword ; 
                            owl:allValuesFrom rdfs:Literal ; 
                            a owl:Restriction],
                           [owl:onProperty vivo:featuredIn ; 
                            owl:allValuesFrom iao:0000030 ; 
                            a owl:Restriction],
                           pobo:BFO_0000004,
                           [owl:onProperty vivo:featuredIn ; 
                            owl:allValuesFrom iao:0000030 ; 
                            a owl:Restriction];
           skos:scopeNote """Used to describe any \"agent\" related to bibliographic items. Such agents can be persons, organizations or groups of any kind."""@en.
foaf:Group iao:0000111 "group";
           iao:0000112 """A group can also be an organization but need not be; typically used for looser associations of people or organizations acting together in some fashion, not necessarily through formal agreement or on a long-term basis. Added to the VIVO ontology to be able to support informal and perhaps even private groups of people around an idea, funding opportunity, or event.

see: http://xmlns.com/foaf/spec/#term_Group""";
           iao:0000115 "A collection of individual agents (and may itself play the role of a Agent, ie. something that can perform actions).",
                       "A collection of individual agents.";
           iao:0000117 "PERSON: Scott Hoffmann";
           a owl:Class;
           rdfs:comment "A group";
           rdfs:label "Group";
           rdfs:subClassOf foaf:Agent.
foaf:Organization iao:0000111 "organization";
                  iao:0000112 "This class will display all the instances in the subclasses below it, as well as any organizations that were added as part of this generic class because there wasn't a specific class available.",
                              "Only use if no specific subclasses of foaf:organization desribe the organization.";
                  iao:0000115 "A kind of Agent corresponding to social instititutions such as companies, societies etc.",
                              "A generic class encompassing several types of organizations.";
                  iao:0000117 "PERSON: Scott Hoffmann";
                  iao:0000118 "";
                  a owl:Class;
                  rdfs:comment "An organization";
                  rdfs:label "Organization";
                  rdfs:subClassOf [owl:onProperty pobo:BFO_0000051 ; 
                                   owl:allValuesFrom foaf:Organization ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:dateTimeInterval ; 
                                   owl:allValuesFrom vivo:DateTimeInterval ; 
                                   a owl:Restriction],
                                  [owl:onProperty pobo:BFO_0000051 ; 
                                   owl:allValuesFrom foaf:Organization ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:abbreviation ; 
                                   owl:allValuesFrom rdfs:Literal ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:dateTimeInterval ; 
                                   owl:allValuesFrom vivo:DateTimeInterval ; 
                                   a owl:Restriction],
                                  [owl:onProperty pobo:RO_0001025 ; 
                                   owl:allValuesFrom vivo:GeographicLocation ; 
                                   a owl:Restriction],
                                  [owl:onProperty pobo:RO_0001025 ; 
                                   owl:allValuesFrom vivo:GeographicLocation ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:abbreviation ; 
                                   owl:allValuesFrom rdfs:Literal ; 
                                   a owl:Restriction],
                                  foaf:Agent;
                  skos:scopeNote "Ued to describe an organization related to bibliographic items such as a publishing company, etc."@en.
foaf:Person iao:0000111 "person";
            iao:0000115 "An instance of a human being (Homo sapiens)",
                        "The most general classification of a person";
            iao:0000117 "PERSON: Melissa Haendel";
            iao:0000118 "";
            a owl:Class;
            rdfs:comment "A person";
            rdfs:label "Person";
            rdfs:subClassOf [owl:onProperty vivo:hasResearchArea ; 
                             owl:allValuesFrom owl:Thing ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:hasResearchArea ; 
                             owl:allValuesFrom owl:Thing ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:geographicFocus ; 
                             owl:allValuesFrom vivo:GeographicRegion ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:eligibleFor ; 
                             owl:allValuesFrom vivo:Credential ; 
                             a owl:Restriction],
