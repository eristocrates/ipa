                rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                rdfs:label "reversed by".
bibo:reviewOf iao:0000112 "The bibo:reviewOf public description was found here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  As of 26 May 2010, bibo:reviewOf is used with the class Review, but core:reviewIn doesn't seem to be being used.";
              a owl:ObjectProperty;
              rdfs:label "review of";
              owl:inverseOf vivo:reviewedIn.
bibo:section iao:0000112 """Di Rado, Alicia. 1995. Trekking through college: Classes explore
