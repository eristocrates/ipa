              rdfs:comment "A document (noun) is a bounded physical representation of body of information designed with the capacity (and usually intent) to communicate. A document may manifest symbolic, diagrammatic or sensory-representational information."@en;
              rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
              rdfs:label "Document";
              rdfs:subClassOf [owl:onProperty pobo:BFO_0000051 ; 
                               owl:allValuesFrom bibo:DocumentPart ; 
                               a owl:Restriction],
                              [owl:onProperty bibo:oclcnum ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty vivo:features ; 
                               owl:allValuesFrom foaf:Agent ; 
                               a owl:Restriction],
                              [owl:onProperty cito:citesAsDataSource ; 
                               owl:allValuesFrom vivo:Dataset ; 
                               a owl:Restriction],
                              [owl:onProperty pobo:BFO_0000051 ; 
                               owl:allValuesFrom bibo:DocumentPart ; 
                               a owl:Restriction],
                              [owl:onProperty bibo:abstract ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty vivo:features ; 
                               owl:allValuesFrom foaf:Agent ; 
                               a owl:Restriction],
                              [owl:onProperty c4o:hasGlobalCitationFrequency ; 
                               owl:allValuesFrom c4o:GlobalCitationCount ; 
                               a owl:Restriction],
                              [owl:onProperty bibo:abstract ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty bibo:oclcnum ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              iao:0000030,
                              [owl:onProperty bibo:numPages ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty cito:citesAsDataSource ; 
                               owl:allValuesFrom vivo:Dataset ; 
                               a owl:Restriction],
                              [owl:onProperty bibo:numPages ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty c4o:hasGlobalCitationFrequency ; 
                               owl:allValuesFrom c4o:GlobalCitationCount ; 
                               a owl:Restriction].
bibo:DocumentPart iao:0000112 "Short Definition from the bibo ontology";
                  iao:0000115 "A distinct part of a larger document or collected document";
                  a owl:Class;
                  rdfs:comment "a distinct part of a larger document or collected document."@en;
                  rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                  rdfs:label "Document Part";
                  rdfs:subClassOf [owl:onProperty vivo:placeOfPublication ; 
                                   owl:allValuesFrom rdfs:Literal ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:publisher ; 
                                   owl:allValuesFrom foaf:Organization ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:publisher ; 
                                   owl:allValuesFrom foaf:Organization ; 
                                   a owl:Restriction],
                                  [owl:onProperty pobo:BFO_0000050 ; 
                                   owl:allValuesFrom bibo:Document ; 
                                   a owl:Restriction],
                                  [owl:onProperty vivo:placeOfPublication ; 
                                   owl:allValuesFrom rdfs:Literal ; 
                                   a owl:Restriction],
                                  bibo:Document,
                                  [owl:onProperty pobo:BFO_0000050 ; 
                                   owl:allValuesFrom bibo:Document ; 
                                   a owl:Restriction];
                  status:term_status "unstable".
bibo:DocumentStatus iao:0000112 """The status of a document with respect to its publication. The statuses are represented as individuals of this class. Use the \"show all individuals of this class\" button on the class control panel to see the currently defined statuses.""",
                                "submitted; accepted; in-press; published; invited; refereed.";
                    iao:0000115 "The status of a document with respect to its publication.";
                    a owl:Class;
                    rdfs:comment "The status of the publication of a document."@en;
                    rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                    rdfs:label "Document Status";
                    status:term_status "stable".
bibo:EditedBook iao:0000112 "Best American Science Writing 2009";
                iao:0000115 "An edited collection of stand-alone articles published as a book";
                a owl:Class;
                rdfs:comment "An edited book."@en;
                rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                rdfs:label "Edited Book";
                rdfs:subClassOf [owl:onProperty vivo:placeOfPublication ; 
                                 owl:allValuesFrom rdfs:Literal ; 
