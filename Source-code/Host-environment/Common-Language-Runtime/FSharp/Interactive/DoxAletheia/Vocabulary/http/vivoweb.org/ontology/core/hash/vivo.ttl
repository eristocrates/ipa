bibo:distributor <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#descriptionAnnot> "Public Description for bibo:distributor taken from here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .";
                 a owl:ObjectProperty;
