                                 a owl:Restriction],
                                [owl:onProperty bibo:edition ; 
                                 owl:allValuesFrom rdfs:Literal ; 
                                 a owl:Restriction];
                status:term_status "stable".
bibo:Excerpt iao:0000112 "Short Definition from the bibo ontology";
             iao:0000115 "A passage selected from a larger work";
             a owl:Class;
             rdfs:comment "A passage selected from a larger work."@en;
             rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
             rdfs:label "Excerpt";
             rdfs:subClassOf bibo:DocumentPart;
             status:term_status "stable".
bibo:Film iao:0000115 "Audiovisual recording in film format";
          a owl:Class;
