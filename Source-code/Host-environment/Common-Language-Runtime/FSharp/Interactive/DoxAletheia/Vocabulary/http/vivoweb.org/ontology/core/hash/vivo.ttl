bibo:Hearing iao:0000112 "Definiton from Bibo here: http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html";
             iao:0000115 "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit.";
             a owl:Class;
             rdfs:comment "An instance or a session in which testimony and arguments are presented, esp. before an official, as a judge in a lawsuit."@en;
             rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
             rdfs:label "Hearing";
             rdfs:subClassOf event:Event;
             status:term_status "stable".
bibo:Image iao:0000112 "photograph; diagram";
           iao:0000115 "A visual representation such as a photograph or graph";
           a owl:Class;
           rdfs:comment "A document that presents visual or diagrammatic information."@en;
           rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
           rdfs:label "Image";
           rdfs:subClassOf bibo:Document;
           status:term_status "stable".
bibo:Interview iao:0000112 "radio or newspaper interview";
               iao:0000115 "A conversation between two or more people where questions are asked by the interviewer to obtain information from the interviewee.";
               a owl:Class;
               rdfs:comment "A formalized discussion between two or more people."@en;
               rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
               rdfs:label "Interview";
               rdfs:subClassOf event:Event;
               status:term_status "stable".
bibo:Issue iao:0000112 "Short Definition from the bibo ontology";
           iao:0000115 "something that is printed or published and distributed, esp. a given number of a periodical";
           a owl:Class;
           rdfs:comment "something that is printed or published and distributed, esp. a given number of a periodical"@en;
           rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
           rdfs:label "Issue";
           rdfs:subClassOf bibo:CollectedDocument;
           status:term_status "stable".
bibo:Journal iao:0000112 "Journal of Information Science; IEEE Intelligent System; Scientometrics",
                         "Articles usually contain abstracts and bibliographies. Includes peer-reviewed, non-peer-reviewed, and open access journals. Journals are usually indexed in the major academic databases such as PubMed and Web of Science.";
             iao:0000115 "Contains original scholarly research or review articles by experts in the field";
             a owl:Class;
             rdfs:comment "A periodical of scholarly journal Articles."@en;
             rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
             rdfs:label "Journal";
             rdfs:subClassOf [owl:onProperty vivo:abbreviation ; 
                              owl:allValuesFrom xsd:string ; 
                              a owl:Restriction],
                             bibo:Periodical,
                             [owl:onProperty vivo:abbreviation ; 
                              owl:allValuesFrom xsd:string ; 
                              a owl:Restriction];
             status:term_status "stable".
bibo:LegalCaseDocument iao:0000115 "Official court  papers for a case";
                       a owl:Class;
                       rdfs:comment "A document accompanying a legal case."@en;
                       rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                       rdfs:label "Legal Case Document";
                       rdfs:subClassOf bibo:LegalDocument;
                       status:term_status "unstable".
bibo:LegalDecision iao:0000115 "The written determination of a case, motion or claim by a court or tribunal";
                   a owl:Class;
                   rdfs:comment "A document containing an authoritative determination (as a decree or judgment) made after consideration of facts or law."@en;
                   rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                   rdfs:label "Decision";
                   rdfs:subClassOf bibo:LegalCaseDocument;
                   status:term_status "unstable".
bibo:LegalDocument iao:0000115 "a document that states some contractual relationship or grants some right";
                   a owl:Class;
                   rdfs:comment "A legal document; for example, a court decision, a brief, and so forth."@en;
                   rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                   rdfs:label "Legal Document";
                   rdfs:subClassOf bibo:Document;
                   status:term_status "stable".
bibo:Legislation iao:0000112 "From OCLC Input Standards, EntW";
                 iao:0000115 "Enactments of legislative bodies, published in either statute or code form";
                 a owl:Class;
                 rdfs:comment "A legal document proposing or enacting a law or a group of laws."@en;
                 rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                 rdfs:label "Legislation";
                 rdfs:subClassOf bibo:LegalDocument;
                 status:term_status "unstable".
bibo:Letter iao:0000112 "A written or printed communication addressed to a person or organization and usually transmitted by mail";
            iao:0000115 "A written or printed communication addressed to a person or organization and usually transmitted by mail";
            a owl:Class;
            rdfs:label "Letter";
            rdfs:subClassOf bibo:PersonalCommunicationDocument.
bibo:Magazine iao:0000112 "New Yorker",
                          "Abstracts and bibliographies are usually not included in magazines.";
              iao:0000115 "Contains articles of current events or general interest, geared to the reading public as being informative or recreational";
              a owl:Class;
              rdfs:comment "A periodical of magazine Articles. A magazine is a publication that is issued periodically, usually bound in a paper cover, and typically contains essays, stories, poems, etc., by many writers, and often photographs and drawings, frequently specializing in a particular subject or area, as hobbies, news, or sports."@en;
              rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
              rdfs:label "Magazine";
              rdfs:subClassOf bibo:Periodical;
              status:term_status "stable".
bibo:Manual iao:0000112 "SDB User Manual";
            iao:0000115 "A book of instructions or guide to a specific topic";
            a owl:Class;
            rdfs:comment "A small reference book, especially one giving instructions."@en;
            rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
            rdfs:label "Manual";
            rdfs:subClassOf bibo:Document;
            status:term_status "unstable".
bibo:Manuscript iao:0000112 "Short Definition is the Medical Subject Heading (MeSH) definition";
                iao:0000115 "Works prepared by hand including handwritten or typescript drafts of pre-publication papers or works not otherwise reproduced in multiple copies";
                a owl:Class;
                rdfs:comment "An unpublished Document, which may also be submitted to a publisher for publication."@en;
                rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                rdfs:label "Manuscript",
                           "manuscript";
                rdfs:subClassOf bibo:Document;
                status:term_status "stable".
bibo:Map iao:0000112 "The Short Definition is how the bibo ontology defines Map. It has been extended to include more broader concept of map which includes science maps, social network maps.";
         iao:0000115 "A graphical depiction of geographic features, scientific discipline, scientific data analytical results";
         a owl:Class;
