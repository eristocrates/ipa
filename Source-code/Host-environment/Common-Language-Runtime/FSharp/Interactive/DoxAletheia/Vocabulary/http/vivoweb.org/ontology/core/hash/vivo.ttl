                                 [owl:onProperty vivo:dateTimeInterval ; 
                                  owl:allValuesFrom vivo:DateTimeInterval ; 
                                  a owl:Restriction],
                                 [owl:onProperty vivo:hideFromDisplay ; 
                                  owl:allValuesFrom xsd:boolean ; 
