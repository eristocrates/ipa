               rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
               rdfs:label "recipient";
               status:term_status "stable".
bibo:rejected a owl:NamedIndividual,
                bibo:DocumentStatus;
              rdfs:label "rejected".
