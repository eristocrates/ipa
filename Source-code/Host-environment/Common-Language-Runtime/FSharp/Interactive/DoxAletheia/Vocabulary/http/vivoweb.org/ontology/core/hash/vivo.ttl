                                                                                              pobo:ERO_0000014) ; 
                                                                                 a owl:Class];
                                                                     owl:inverseOf pobo:ERO_0000481.
<http://vivoweb.org/ontology/scientific-research#studyPopulationCount> iao:0000115 "number of human participants in the study (trial).";
                                                                       a owl:DatatypeProperty;
                                                                       rdfs:label "study population count".
