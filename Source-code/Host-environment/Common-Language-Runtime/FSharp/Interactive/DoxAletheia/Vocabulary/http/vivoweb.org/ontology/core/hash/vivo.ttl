bibo:Slideshow iao:0000112 "Short Definition from the bibo ontology";
               iao:0000115 "A presentation of a series of slides, usually presented in front of an audience with written text and images";
               a owl:Class;
               rdfs:comment "A presentation of a series of slides, usually presented in front of an audience with written text and images."@en;
               rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
