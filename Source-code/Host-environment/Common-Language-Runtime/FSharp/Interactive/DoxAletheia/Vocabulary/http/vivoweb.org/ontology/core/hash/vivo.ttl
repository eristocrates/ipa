         rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
         rdfs:label "Map";
         rdfs:subClassOf bibo:Image;
         status:term_status "unstable".
bibo:Newspaper iao:0000112 "USA Today";
               iao:0000115 "Contains news articles, opinions, features, advertising, and is usually issued daily or weekly";
               a owl:Class;
               rdfs:comment "A periodical of documents, usually issued daily or weekly, containing current news, editorials, feature articles, and usually advertising."@en;
               rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
               rdfs:label "Newspaper";
               rdfs:subClassOf bibo:Periodical;
               status:term_status "stable".
bibo:Note iao:0000112 "Short Definition from bibo ontology";
          iao:0000115 "Notes or annotations about a resource";
          a owl:Class;
          rdfs:comment "Notes or annotations about a resource."@en;
          rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
          rdfs:label "Note";
          rdfs:subClassOf bibo:Document;
          status:term_status "stable".
bibo:Patent iao:0000112 "A patent is an exclusive right granted for an invention, which is a product or a process that provides, in general, a new way of doing something, or offers a new technical solution to a problem.  In order to be patentable, the invention must fulfill certain conditions. (http://www.wipo.int/patentscope/en/)";
            iao:0000115 "(from BIBO) A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years";
            a owl:Class;
            rdfs:comment "A document describing the exclusive right granted by a government to an inventor to manufacture, use, or sell an invention for a certain number of years."@en;
            rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
            rdfs:label "Patent";
            rdfs:subClassOf bibo:Document,
                            [owl:onProperty vivo:dateIssued ; 
                             owl:allValuesFrom vivo:DateTimeValue ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:publisher ; 
                             owl:allValuesFrom foaf:Organization ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:dateIssued ; 
                             owl:allValuesFrom vivo:DateTimeValue ; 
                             a owl:Restriction],
                            [owl:onProperty vivo:publisher ; 
                             owl:allValuesFrom foaf:Organization ; 
                             a owl:Restriction];
            status:term_status "stable".
bibo:Performance iao:0000115 "Something carried out, acted or rendered.";
                 a owl:Class;
                 rdfs:comment "A public performance."@en;
                 rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                 rdfs:label "Performance";
                 rdfs:subClassOf event:Event;
                 status:term_status "unstable".
bibo:Periodical a owl:Class;
                rdfs:comment "A group of related documents issued at regular intervals."@en;
