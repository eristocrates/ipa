                             rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI;
                             rdfs:label "subsequent legal decision".
bibo:transcriptOf iao:0000112 "The bibo:transcriptOf public description was found here:  http://bibotools.googlecode.com/svn/bibo-ontology/trunk/doc/index.html .  Bibo considers this term unstable.";
                  a owl:ObjectProperty;
