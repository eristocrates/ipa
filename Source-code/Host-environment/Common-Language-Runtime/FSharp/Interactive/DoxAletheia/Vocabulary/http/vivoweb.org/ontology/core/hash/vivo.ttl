<http://vivoweb.org/ontology/scientific-research> rdfs:label "VIVO Scientific Research Ontology".
<http://vivoweb.org/ontology/scientific-research#Phase0ClinicalTrial> iao:0000115 "Phase 0 Clinical Trial",
                                                                                  "Phase 0 is a recent designation for exploratory, first-in-human trials  conducted in accordance with the United States Food and Drug Administration's (FDA) 2006 Guidance on Exploratory Investigational New Drug (IND) Studies.  Phase 0 trials are also known as human microdosing  studies and are designed to speed up the development of promising drugs or imaging agents by establishing very early on whether the drug or agent behaves in human subjects as was expected from preclinical studies.";
                                                                      a owl:Class;
                                                                      rdfs:label "Phase 0 Clinical Trial";
                                                                      rdfs:subClassOf pobo:ERO_0000016.
<http://vivoweb.org/ontology/scientific-research#Phase1ClinicalTrial> iao:0000115 "Phase 1 Clinical Trial",
                                                                                  "In Phase I trials, researchers test an experimental drug or treatment in a small group of people (20-80) for the first time to evaluate its safety, determine a safe dosage range, and identify side effects";
                                                                      a owl:Class;
                                                                      rdfs:label "Phase 1 Clinical Trial";
                                                                      rdfs:subClassOf pobo:ERO_0000016.
<http://vivoweb.org/ontology/scientific-research#Phase2ClinicalTrial> iao:0000115 "Phase 2 Clinical Trial",
                                                                                  "In Phase 2 trials, an experimental study drug or treatment is given to a larger group of people (100-300) to see if it is effective and to further evaluate its safety.";
                                                                      a owl:Class;
                                                                      rdfs:label "Phase 2 Clinical Trial";
                                                                      rdfs:subClassOf pobo:ERO_0000016.
<http://vivoweb.org/ontology/scientific-research#Phase3ClinicalTrial> iao:0000115 "Phase 3 Clinical Trial",
                                                                                  "In Phase 3 trials, an experimental study drug or treatment is given to large groups of people (1,000-3,000) to confirm its effectiveness, monitor side effects, compare it to commonly used treatments, and collect information that will allow the experimental drug or treatment to be used safely.";
                                                                      a owl:Class;
                                                                      rdfs:label "Phase 3 Clinical Trial";
                                                                      rdfs:subClassOf pobo:ERO_0000016.
<http://vivoweb.org/ontology/scientific-research#Phase4ClinicalTrial> iao:0000115 "Phase 4 Clinical Trial",
                                                                                  "In Phase 4 trials, post marketing studies delineate additional information including the drug's or treatment's risks, benefits, and optimal use.";
                                                                      a owl:Class;
                                                                      rdfs:label "Phase 4 Clinical Trial";
                                                                      rdfs:subClassOf pobo:ERO_0000016.
<http://vivoweb.org/ontology/scientific-research#accessProvidedBy> a owl:ObjectProperty;
                                                                   rdfs:label "access provided by";
                                                                   rdfs:range pobo:ERO_0000391;
                                                                   owl:inverseOf pobo:ERO_0000029.
<http://vivoweb.org/ontology/scientific-research#documentationFor> a owl:ObjectProperty;
                                                                   rdfs:domain bibo:Document;
                                                                   rdfs:label "documentation for project or resource";
                                                                   rdfs:range [owl:unionOf (pobo:ERO_0000004
                                                                                            pobo:ERO_0000005
                                                                                            pobo:ERO_0000006
                                                                                            pobo:ERO_0000014
                                                                                            pobo:ERO_0000020
