@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix oae: <http://www.ics.forth.gr/isl/oae/core#>.

<http://www.ics.forth.gr/isl/oae/core> <http://purl.org/dc/terms/contributor> <http://users.ics.forth.gr/~tzitzik>;
                                       <http://purl.org/dc/terms/creator> <http://users.ics.forth.gr/~fafalios>;
                                       <http://purl.org/dc/terms/description> "The Open NEE Model defines an extension of the Open Annotation Data Model (http://www.openannotation.org/spec/core) that allows describing in RDF the result of a Named Entity Extraction (NEE) process, enabling thereby an application to run advanced (SPARQL) queries over the annotated data. The model also exploits the Open NEE Configuration Model (http://www.ics.forth.gr/isl/oncm) for relating the output of a NEE process with an applied configuration (serving provenance information to the output of the entire NEE process)."@en;
                                       <http://purl.org/dc/terms/title> "Open NEE Model (Open Annotation Extension)"@en;
                                       a <http://www.w3.org/2002/07/owl#Ontology>;
                                       rdfs:comment "The Open NEE Model defines an extension of the Open Annotation Data Model (http://www.openannotation.org/spec/core) that allows describing in RDF the result of a Named Entity Extraction (NEE) process, enabling thereby an application to run advanced (SPARQL) queries over the annotated data. The model also exploits the Open NEE Configuration Model (http://www.ics.forth.gr/isl/oncm) for relating the output of a NEE process with an applied configuration (serving provenance information to the output of the entire NEE process)."@en;
                                       rdfs:label "Open NEE Model"@en;
                                       rdfs:seeAlso <http://users.ics.forth.gr/~fafalios/files/pubs/fafalios_2015_ijait.pdf>;
                                       <http://www.w3.org/2002/07/owl#imports> <http://www.ics.forth.gr/isl/oncm/core>,
                                                                               <http://www.w3.org/ns/oa#>;
                                       <http://www.w3.org/2002/07/owl#versionInfo> "1.0".
oae:Entity <http://purl.org/dc/terms/description> "Represents an identified entity."@en;
           a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:label "entity"@en;
           rdfs:subClassOf <http://www.w3.org/ns/oa#SemanticTag>.
oae:NEE <http://purl.org/dc/terms/description> "Represents the result of the Named Entity Extraction (NEE) process."@en;
        a <http://www.w3.org/2002/07/owl#NamedIndividual>,
          <http://www.w3.org/ns/oa#Motivation>;
        rdfs:label "Named Entity Extraction (NEE)"@en;
        <http://www.w3.org/2004/02/skos/core#broader> <http://www.w3.org/ns/oa#tagging>;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Result of Named Entity Extraction (NEE) process."@en.
oae:belongsTo <http://purl.org/dc/terms/description> "Relates an entity to a category."@en;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain oae:Entity;
              rdfs:label "belongs to"@en;
              rdfs:range <http://www.ics.forth.gr/isl/oncm/core#Category>.
oae:confidence <http://purl.org/dc/terms/description> "Relates an entity to a literal representing the confidence of an ambiguous entity."@en;
               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain oae:Entity;
               rdfs:label "confidence"@en;
               rdfs:range rdfs:Literal.
oae:detectedAs <http://purl.org/dc/terms/description> "Relates an entity to a literal representing the string in the document that was detected and considered an entity."@en;
               a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:domain oae:Entity;
               rdfs:label "detected as"@en;
               rdfs:range rdfs:Literal.
oae:hasMatchedURI <http://purl.org/dc/terms/description> "Relates an entity to a URI."@en;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain oae:Entity;
                  rdfs:label "has matched URI"@en;
                  rdfs:range rdfs:Resource.
oae:position <http://purl.org/dc/terms/description> "Relates an entity to one or more literals representing the positions in the document in which the entity name was detected."@en;
             a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:domain oae:Entity;
             rdfs:label "position"@en;
             rdfs:range rdfs:Literal.
oae:regardsEntityName <http://purl.org/dc/terms/description> "Relates an entity to a literal representing the actual entity name that exists in a gazetteer of the NEE system."@en;
                      a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:domain oae:Entity;
                      rdfs:label "regards entity name"@en;
                      rdfs:range rdfs:Literal.
oae:score <http://purl.org/dc/terms/description> "Relates an entity to a literal (or a URI to a literal) representing the score of an entity (or of URI)."@en;
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:label "score"@en;
          rdfs:range rdfs:Literal.
oae:usingConfiguration <http://purl.org/dc/terms/description> "Relates the annotation process to a configuration."@en;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain <http://www.w3.org/ns/oa#Annotation>;
                       rdfs:label "using configuration"@en;
                       rdfs:range <http://www.ics.forth.gr/isl/oncm/core#Configuration>.
