@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ngeoi: <http://vocab.lenka.no/geo-deling#>.

<http://vocab.lenka.no/geo-deling> <http://purl.org/dc/elements/1.1/creator> ngeoi:Kjetil%20Kjernsmo;
                                   <http://purl.org/dc/elements/1.1/license> "http://creativecommons.org/licenses/by/3.0/";
                                   <http://purl.org/dc/terms/created> "2011-03-18"^^xsd:date;
                                   <http://purl.org/dc/terms/description> "Dette er et vokabular for administrativ inndeling av Norge, matrikkelen, steder og andre geografiske ting.";
                                   <http://purl.org/dc/terms/modified> "2012-10-11"^^xsd:date;
                                   <http://purl.org/dc/terms/partOf> <http://vocab.lenka.no/>;
                                   <http://purl.org/dc/terms/publisher> "http://vocab.lenka.no/geo-deling#Universitetet%20i%20Oslo";
                                   <http://purl.org/dc/terms/status> <http://purl.org/adms/status/UnderDevelopment>;
                                   <http://purl.org/dc/terms/title> "Landinndelingen i Norge";
                                   <http://purl.org/dc/terms/type> <http://purl.org/adms/assettype/Ontology>;
                                   <http://purl.org/vocab/vann/preferredNamespacePrefix> "geo-deling";
                                   <http://purl.org/vocab/vann/preferredNamespaceUri> "http://vocab.lenka.no/geo-deling#";
                                   a <http://www.w3.org/2002/07/owl#Ontology>;
                                   <http://xmlns.com/foaf/0.1/homepage> <http://vocab.lenka.no/geo-deling.html>.
ngeoi:Fylke a rdfs:Class,
              <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Et fylke er et område som utgjør en førsteordens politisk og administrativ enhet.";
            rdfs:label "Fylke".
ngeoi:Grunneiendom a rdfs:Class,
                     <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Grunneiendom er en geografisk del av landet som har et eget eierforhold.";
                   rdfs:label "Grunneiendom".
ngeoi:Kjetil%20Kjernsmo a <http://xmlns.com/foaf/0.1/Person>;
                        <http://xmlns.com/foaf/0.1/homepage> <http://www.kjetil.kjernsmo.net/>;
                        <http://xmlns.com/foaf/0.1/name> "Kjetil Kjernsmo".
ngeoi:Kommune a rdfs:Class,
                <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "En kommune er et område som utgjør en andreordens politisk og administrativ enhet.";
              rdfs:label "Kommune".
ngeoi:Kommunesenter a rdfs:Class,
                      <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Et kommunesenter er et sted som tjener som administrativt senter for en kommune.";
                    rdfs:label "Kommunesenter";
                    rdfs:subClassOf ngeoi:Sted.
ngeoi:Sted a rdfs:Class,
             <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Et sted er et avgrenset område.";
           rdfs:label "Sted".
ngeoi:Universitetet%20i%20Oslo a <http://purl.org/dc/terms/Agent>;
                               <http://xmlns.com/foaf/0.1/homepage> <http://www.ifi.uio.no/>;
                               <http://xmlns.com/foaf/0.1/member> ngeoi:Kjetil%20Kjernsmo;
                               <http://xmlns.com/foaf/0.1/name> "Universitetet i Oslo".
ngeoi:bnr a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Et bruksnummer er en del av en enhet i det norske eiendomsregisteret, matrikkelen.";
          rdfs:domain ngeoi:Grunneiendom;
          rdfs:label "Bruksnummer";
          rdfs:range rdfs:Literal.
ngeoi:eid-av a rdf:Property;
             rdfs:comment "Indikerer at en grunneiendom er eid av en agent.";
             rdfs:label "Eid av".
ngeoi:eier a rdf:Property;
           rdfs:comment "Indikerer et eierforhold mellom en agent og en grunneiendom.";
           rdfs:domain <http://xmlns.com/foaf/0.1/Agent>;
           rdfs:label "Eier";
           rdfs:range ngeoi:Grunneiendom.
ngeoi:fnr a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Festenummeret er et nummer på et leid grunneiendom i matrikkelen.";
          rdfs:domain ngeoi:Grunneiendom;
          rdfs:label "Festenummer";
          rdfs:range rdfs:Literal.
ngeoi:fylkenr a rdf:Property,
                <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Fylkenummer er et tosifret nummer (eks.: 01) som er unikt for hvert fylke i Norge. ";
              rdfs:domain ngeoi:Fylke;
              rdfs:label "Fylkenummer";
              rdfs:range rdfs:Literal.
ngeoi:gnr a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Gårdsnummer er nummeret på en gårdsenhet i matrikkelen og er unikt innenfor hver kommune. ";
          rdfs:domain ngeoi:Grunneiendom;
          rdfs:label "Gårdsnummer";
          rdfs:range rdfs:Literal.
ngeoi:kommunenr a rdf:Property,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Kommunenummer er et firesifret nummer (eks.: 0101) som er unikt for hver kommune i Norge. ";
                rdfs:domain ngeoi:Kommune;
                rdfs:label "Kommunenummer ";
                rdfs:range rdfs:Literal.
ngeoi:rdf <http://purl.org/dc/terms/FileFormat> <http://vocab.lenka.no/geo-deling>;
          <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>.
ngeoi:senter a rdf:Property;
             rdfs:comment "For å linke en kommune med stedet som er kommunens senter.";
             rdfs:domain ngeoi:Kommune;
             rdfs:label "Senter";
             rdfs:range ngeoi:Kommunesenter.
ngeoi:snr a rdf:Property,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Et seksjonsnummer er et nummer i matrikkelen som benyttes der en eiendom består av flere selvstendige eierenheter som skal selges og pantsettes hver for seg.";
          rdfs:domain ngeoi:Grunneiendom;
          rdfs:label "Seksjonsnummer";
          rdfs:range rdfs:Literal.
ngeoi:ttl <http://purl.org/dc/terms/FileFormat> <http://vocab.lenka.no/geo-deling>;
          <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/3.0/>.
