@base <https://spec.ottr.xyz/rOTTR/0.2.0/puntypes.owl.ttl>.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix ottr: <http://ns.ottr.xyz/0.4/>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix w3: <http://www.w3.org/>.

ottr:Bot ottr:subTypeOf <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-AnnotationProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-DatatypeProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-ObjectProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-ObjectProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-AnnotationProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-AnnotationProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-AnnotationProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-DatatypeProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-ObjectProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-DatatypeProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-DatatypeProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-AnnotationProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-DatatypeProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-ObjectProperty>,
                        <http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-ObjectProperty>.
<http://spec.ottr.xyz/rottr/0.2/PunTypes> a owl:Ontology;
                                          owl:imports <http://spec.ottr.xyz/rottr/0.2/types.owl.ttl>.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-AnnotationProperty> ottr:subTypeOf owl:AnnotationProperty,
                                                                                           owl:Class.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-DatatypeProperty> ottr:subTypeOf owl:DatatypeProperty,
                                                                                         owl:Class.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-AnnotationProperty> ottr:subTypeOf owl:AnnotationProperty,
                                                                                                           owl:Class,
                                                                                                           owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-DatatypeProperty> ottr:subTypeOf owl:DatatypeProperty,
                                                                                                         owl:Class,
                                                                                                         owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-NamedIndividual-ObjectProperty> ottr:subTypeOf owl:Class,
                                                                                                       owl:NamedIndividual,
                                                                                                       owl:ObjectProperty.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Class-ObjectProperty> ottr:subTypeOf owl:Class,
                                                                                       owl:ObjectProperty.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-AnnotationProperty> ottr:subTypeOf owl:AnnotationProperty,
                                                                                              rdfs:Datatype.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-DatatypeProperty> ottr:subTypeOf owl:DatatypeProperty,
                                                                                            rdfs:Datatype.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual> ottr:subTypeOf rdfs:Datatype,
                                                                                           owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-AnnotationProperty> ottr:subTypeOf owl:AnnotationProperty,
                                                                                                              rdfs:Datatype,
                                                                                                              owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-DatatypeProperty> ottr:subTypeOf owl:DatatypeProperty,
                                                                                                            rdfs:Datatype,
                                                                                                            owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-NamedIndividual-ObjectProperty> ottr:subTypeOf rdfs:Datatype,
                                                                                                          owl:NamedIndividual,
                                                                                                          owl:ObjectProperty.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-Datatype-ObjectProperty> ottr:subTypeOf rdfs:Datatype,
                                                                                          owl:ObjectProperty.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-AnnotationProperty> ottr:subTypeOf owl:AnnotationProperty,
                                                                                                     owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-DatatypeProperty> ottr:subTypeOf owl:DatatypeProperty,
                                                                                                   owl:NamedIndividual.
<http://types.ottr.xyz/std/0.1/PunnedTypes#Punned-NamedIndividual-ObjectProperty> ottr:subTypeOf owl:NamedIndividual,
                                                                                                 owl:ObjectProperty.
