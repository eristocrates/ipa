                                                              owl:priorVersion <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201305/ISOTC211/HM/metadata.rdf>;
                                                              owl:versionIRI <https://www.seegrid.csiro.au/subversion/xmml/ontologies/tags/201311/ISOTC211/HM/iso19115/2003/metadata.rdf>.
md:AggregateInformation a owl:Class;
                        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                        rdfs:label "Aggregate information";
                        rdfs:subClassOf [owl:onProperty md:assocationType ; 
                                         owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataset#AssociationTypeCode> ; 
                                         a owl:Restriction],
                                        [owl:onProperty md:aggregateDataSetIdentifier ; 
                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        [owl:onProperty md:initiativeType ; 
                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        [owl:onProperty md:assocationType ; 
                                         owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                         a owl:Restriction],
                                        [owl:onProperty md:aggregateDataSetName ; 
                                         owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#Citation> ; 
                                         a owl:Restriction],
                                        [owl:onProperty md:initiativeType ; 
                                         owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/dataset#InitiativeTypeCode> ; 
                                         a owl:Restriction];
                        skos:notation "MD_AggregateInformation"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:ApplicationSchema.name a owl:ObjectProperty;
                          rdfs:domain md:ApplicationSchemaInformation;
                          rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                          rdfs:label "Application schema.name";
                          rdfs:range <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#Citation>.
md:ApplicationSchemaInformation a owl:Class;
                                rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                                rdfs:label "Application schema information";
                                rdfs:subClassOf [owl:onProperty md:ApplicationSchema.name ; 
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:schemaLanguage ; 
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:softwareDevelopmentFileFormat ; 
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:constraintLanguage ; 
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:softwareDevelopmentFile ; 
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:schemaAscii ; 
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:graphicsFile ; 
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty md:ApplicationSchema.name ; 
                                                 owl:allValuesFrom <http://def.seegrid.csiro.au/isotc211/iso19115/2003/citation#Citation> ; 
                                                 a owl:Restriction];
                                skos:notation "MD_ApplicationSchemaInformation"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:Band a owl:Class;
        rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
        rdfs:label "Band";
        rdfs:subClassOf [owl:onProperty md:scaleFactor ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:peakResponse ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:offset ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:maxValue ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:units ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        md:RangeDimension,
                        [owl:onProperty md:bitsPerValue ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:minValue ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction],
                        [owl:onProperty md:toneGradation ; 
                         owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                         a owl:Restriction];
        skos:notation "MD_Band"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:BrowseGraphic a owl:Class;
                 rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                 rdfs:label "Browse graphic";
                 rdfs:subClassOf [owl:onProperty md:fileType ; 
                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                  a owl:Restriction],
                                 [owl:onProperty md:fileDescription ; 
                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                  a owl:Restriction],
                                 [owl:onProperty md:fileName ; 
                                  owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  a owl:Restriction];
                 skos:notation "MD_BrowseGraphic"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:CellGeometryCode a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                    rdfs:label "Cell geometry code";
                    rdfs:subClassOf skos:Concept;
                    skos:notation "MD_CellGeometryCode"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:CharacterSetCode a owl:Class;
                    rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                    rdfs:label "Character set code";
                    rdfs:subClassOf skos:Concept;
                    skos:notation "MD_CharacterSetCode"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:ClassificationCode a owl:Class;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                      rdfs:label "Classification code";
                      rdfs:subClassOf skos:Concept;
                      skos:notation "MD_ClassificationCode"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:Constraints a owl:Class;
               rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
               rdfs:label "Constraints";
               rdfs:subClassOf [owl:onProperty md:useLimitation ; 
                                owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                a owl:Restriction];
               skos:notation "MD_Constraints"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:ContentInformation a owl:Class;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                      rdfs:label "Content information";
                      skos:notation "MD_ContentInformation"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:CoverageContentTypeCode a owl:Class;
                           rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                           rdfs:label "Coverage content type code";
                           rdfs:subClassOf skos:Concept;
                           skos:notation "MD_CoverageContentTypeCode"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:CoverageDescription a owl:Class;
                       rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                       rdfs:label "Coverage description";
                       rdfs:subClassOf [owl:onProperty md:contentType ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty md:attributeDescription ; 
                                        owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                        a owl:Restriction],
                                       [owl:onProperty md:contentType ; 
                                        owl:allValuesFrom md:CoverageContentTypeCode ; 
                                        a owl:Restriction],
                                       md:ContentInformation;
                       skos:notation "MD_CoverageDescription"^^<http://def.seegrid.csiro.au/isotc211/iso19150/-2/2012/basic#ISOClassName>.
md:DataIdentification a owl:Class;
                      rdfs:isDefinedBy <http://def.seegrid.csiro.au/isotc211/iso19115/2003/metadata>;
                      rdfs:label "Data identification";
                      rdfs:subClassOf md:Identification,
                                      [owl:onProperty md:spatialResolution ; 
                                       owl:onClass md:Resolution ; 
                                       owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:language ; 
                                       owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:spatialRepresentationType ; 
                                       owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:characterSet ; 
                                       owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:supplementalInformation ; 
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:environmentDescription ; 
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:characterSet ; 
                                       owl:allValuesFrom md:CharacterSetCode ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:spatialRepresentationType ; 
                                       owl:allValuesFrom md:SpatialRepresentationTypeCode ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:extent ; 
                                       owl:onClass ext:Extent ; 
                                       owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:topicCategory ; 
                                       owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                       a owl:Restriction],
                                      [owl:onProperty md:topicCategory ; 
