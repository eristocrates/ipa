@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix stories: <http://purl.org/ontology/stories/>.

stories: a <http://www.w3.org/2002/07/owl#Ontology>;
         rdfs:label "Stories Ontology"@en;
         <http://www.w3.org/2002/07/owl#versionInfo> "Revision: 1".
stories:Assertion a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Contains a set of statements in the form of an RDF graph, thus allowing for interpretations to assert beliefs about the state of the system."@en;
                  rdfs:label "Assertion"@en.
stories:EventList a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Provides a means to create an ordered list of events that occur within a story - effectively a pairing of an Event and a numeric position."@en;
                  rdfs:label "EventList"@en;
                  rdfs:subClassOf <http://purl.org/ontology/olo/core#OrderedList>.
stories:EventSlot a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Places an Event in an EventList, with index and neighbouring Event information."@en;
                  rdfs:label "EventSlot"@en;
                  rdfs:subClassOf <http://purl.org/ontology/olo/core#Slot>.
stories:Interpretation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "An interpretation of something in the context of a story, given some supporting material. This is the viewpoint of the interpretation's creator, and may assert statements about the item."@en;
                       rdfs:label "Interpretation"@en.
stories:Story a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A story that may be told, contain other stories, and have a sequence of events."@en;
              rdfs:label "Story"@en.
stories:asserts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The Assertion which is asserted by this interpretation."@en;
                rdfs:domain stories:Interpretation;
                rdfs:label "asserts"@en;
                rdfs:range stories:Assertion.
stories:contextualises a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain stories:Story;
                       rdfs:label "contextualises"@en;
                       rdfs:range stories:Interpretation.
stories:describedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "The inverse of describes, this is an Event describedBy a Thing (e.g. a programme, photo)"@en;
                    rdfs:domain <http://purl.org/NET/c4dm/event.owl#Event>;
                    rdfs:label "describedBy"@en.
stories:describes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "A Thing which describes an Event. This could be a Media Fragment, an Image, etc."@en;
                  rdfs:label "describes"@en;
                  rdfs:range <http://purl.org/NET/c4dm/event.owl#Event>;
                  <http://www.w3.org/2002/07/owl#inverseOf> stories:describedBy.
stories:events a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "An ordered list of Events within this story."@en;
               rdfs:domain stories:Story;
               rdfs:label "event"@en;
               rdfs:range stories:EventList.
stories:facts a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Facts asserted by this assertion, in the form of an RDF graph.";
              rdfs:domain stories:Assertion;
              rdfs:label "facts".
stories:interprets a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "The thing which is interpreted by this interpretation."@en;
                   rdfs:domain stories:Interpretation;
                   rdfs:label "interprets"@en.
stories:item a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain stories:EventSlot;
             rdfs:label "item"@en;
             rdfs:range <http://purl.org/NET/c4dm/event.owl#Event>;
             rdfs:subPropertyOf <http://purl.org/ontology/olo/core#item>.
stories:slot a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:domain stories:EventList;
             rdfs:label "slot"@en;
             rdfs:range stories:EventSlot;
             rdfs:subPropertyOf <http://purl.org/ontology/olo/core#slot>.
stories:sub_story a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "A story which is contained within this story. For example, a TV episode may contain stories for different characters, or one overarching story may contain several other smaller stories."@en;
                  rdfs:domain stories:Story;
                  rdfs:label "sub_story"@en;
                  rdfs:range stories:Story.
stories:subject a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "The subject(s) of the story. e.g. characters, events, skos concepts."@en;
                rdfs:domain stories:Story;
                rdfs:label "subject"@en.
stories:supports a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A Thing which supports an Interpretation (e.g. a supporting document, Event, etc)."@en;
                 rdfs:label "supports"@en;
                 rdfs:range stories:Interpretation.
stories:tells a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "A story told by this Thing. The Thing could be a photograph which has a story attached to it, a person, a country, a monument, etc."@en;
              rdfs:label "tells"@en;
              rdfs:range stories:Story.
