                                     a <http://www.w3.org/2002/07/owl#Ontology>;
                                     rdfs:comment """El objetivo de este vocabulario es la creación de un esquema que permita definir los contenidos de la información relacionada con la oferta de empleo público. 
			Se identifican ciertas variables en el dominio de la oferta de empleo público, que se modelan a través de ciertos tipos de datos y de propiedades relacionadas entre los recursos."""@es;
                                     <http://www.w3.org/2004/02/skos/core#changeNote> [<http://purl.org/dc/elements/1.1/creator> "Martín Álvarez" ; 
                                                                                       <http://purl.org/dc/elements/1.1/date> "2013-09-03" ; 
                                                                                       rdf:value "Corregidas erratas de etiquetado de idiomas."@es],
                                                                                      [<http://purl.org/dc/elements/1.1/creator> "Martín Álvarez" ; 
                                                                                       <http://purl.org/dc/elements/1.1/date> "2013-09-03" ; 
                                                                                       rdf:value "Corregidas erratas de etiquetado de idiomas."@es];
                                     <http://www.w3.org/2004/02/skos/core#historyNote> [<http://purl.org/dc/elements/1.1/creator> "CTIC-CT" ; 
                                                                                        <http://purl.org/dc/elements/1.1/date> "2012-09-01" ; 
                                                                                        rdf:value "Añadidos dos nuevos esquemas de conceptos a la ontología: categorías profesionales y tipos de contrato. Añadidas nuevas propiedades para la descripción de la oferta de empleo."@es],
                                                                                       [<http://purl.org/dc/elements/1.1/creator> "CTIC-CT" ; 
                                                                                        <http://purl.org/dc/elements/1.1/date> "2012-09-01" ; 
                                                                                        rdf:value "Añadidos dos nuevos esquemas de conceptos a la ontología: categorías profesionales y tipos de contrato. Añadidas nuevas propiedades para la descripción de la oferta de empleo."@es].
emp:AnuncioOferta <http://purl.org/dc/terms/issued> "2010-10-01";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Un anuncio de una oferta de empleo"@es;
                  rdfs:isDefinedBy <http://purl.org/ctic/empleo/oferta>;
                  rdfs:label "Anuncio de oferta"@es;
                  rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
emp:OfertaEmpleo <http://purl.org/dc/terms/issued> "2010-10-01";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Una oferta de empleo es un documento que describe los detalles de uno o más trabajos que deben ser cubiertos. Nótese que no es lo mismo un trabajo, que una oferta de trabajo."@es;
                 rdfs:isDefinedBy <http://purl.org/ctic/empleo/oferta>;
                 rdfs:label "Oferta de Empleo"@es;
                 rdfs:subClassOf <http://xmlns.com/foaf/0.1/Document>.
