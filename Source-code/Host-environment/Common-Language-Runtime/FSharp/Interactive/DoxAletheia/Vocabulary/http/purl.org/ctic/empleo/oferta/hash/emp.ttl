                      rdfs:isDefinedBy <http://purl.org/ctic/empleo/oferta>;
                      rdfs:label "Plantilla de personal"@es;
                      rdfs:subClassOf <http://www.w3.org/2006/03/wn/wn20/instances/synset-staff-noun-1>.
