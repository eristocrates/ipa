@prefix rml_star: <http://w3id.org/rml/star/>.

<http://creativecommons.org/ns#license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/license> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/ontology/bibo/status> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespacePrefix> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/vocab/vann/preferredNamespaceUri> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/rml/AssertedTriplesMap> a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "A type of Triples Map that is quoted and asserted in the resulting graph."@en;
                                         rdfs:isDefinedBy rml_star:;
                                         rdfs:label "Asserted Triples Map";
                                         rdfs:subClassOf <http://w3id.org/rml/TriplesMap>.
<http://w3id.org/rml/NonAssertedTriplesMap> a <http://www.w3.org/2002/07/owl#Class>;
                                            rdfs:comment "A type of Triples Map that is quoted but not asserted in the resulting graph"@en;
                                            rdfs:isDefinedBy rml_star:;
                                            rdfs:label "Non Asserted Triples Map";
                                            rdfs:subClassOf <http://w3id.org/rml/TriplesMap>.
<http://w3id.org/rml/StarMap> a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Represents a star map able to generate RDF-star triples."@eb;
                              rdfs:isDefinedBy rml_star:;
                              rdfs:label "Star Map".
<http://w3id.org/rml/TriplesMap> a <http://www.w3.org/2002/07/owl#Class>.
<http://w3id.org/rml/quotedTriplesMap> a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                       rdfs:comment "An quoted TriplesMap element to generate a RDF-star triple as subject or object or another triple from a logical source record."@en;
                                       rdfs:domain <http://w3id.org/rml/StarMap>;
                                       rdfs:isDefinedBy rml_star:;
                                       rdfs:label "quoted triples map";
                                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://w3id.org/rml/AssertedTriplesMap>
                                                                                            <http://w3id.org/rml/NonAssertedTriplesMap>) ; 
                                                   a <http://www.w3.org/2002/07/owl#Class>].
rml_star: <http://purl.org/dc/terms/contributor> "Ana Iglesias Molina",
                                                 "Julián Arenas Guerrero",
                                                 "David Chaves Fraga",
                                                 "Anastasia Dimou";
          <http://purl.org/dc/terms/created> "2023-03-14";
