              rdfs:label "qualifier";
              rdfs:range rdf:Literal;
              <http://www.w3.org/2004/02/skos/core#example> "Rhea (vessels)=rhyta (a kind of drinking vessel) vs rhea (species)=Boehmeria nivea (Chinese grass)".
