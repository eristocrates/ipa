gvp:broaderExtended <http://purl.org/dc/terms/description> """Appropriate ancestors. Meaningful closure of gvp:broader for query expansion. Use this, not skos:broaderTransitive.
Example: Mt Athos has ancestor places (BTPE) World, Europe, Greece, Macedonia, Pangaíon Óros regional division;
and place types (BTIE) inhabited place; and orthodox religious center, Christian religious center, religious center""";
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Appropriate ancestors. Meaningful closure of gvp:broader for query expansion. Use this, not skos:broaderTransitive";
                    rdfs:domain gvp:Subject;
                    rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                    rdfs:label "broaderExtended";
                    rdfs:range gvp:Subject;
                    <http://www.w3.org/2004/02/skos/core#example> """Mt Athos has ancestor places (BTPE) World, Europe, Greece, Macedonia, Pangaíon Óros regional division;
and place types (BTIE) inhabited place; and orthodox religious center, Christian religious center, religious center""".
gvp:broaderGeneric <http://purl.org/dc/terms/description> """BTG (Genus/Species, \"is a\") relation. We also infer iso-thes:broaderGeneric, which goes only between Concepts.
Example: calcite (AAT) BTG mineral (AAT)""";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment """BTG (Genus/Species, \"is a\") relation. We also infer iso-thes:broaderGeneric, which goes only between Concepts""";
                   rdfs:domain gvp:Subject;
                   rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                   rdfs:label "broaderGeneric";
                   rdfs:range gvp:Subject;
                   rdfs:subPropertyOf gvp:broader,
                                      gvp:broaderGenericExtended;
                   <http://www.w3.org/2004/02/skos/core#example> "calcite (AAT) BTG mineral (AAT)".
gvp:broaderGenericExtended <http://purl.org/dc/terms/description> """Ancestors (Generic). Meaningful closure of gvp:broaderGeneric. Infers iso:broaderGeneric for pairs of directly related skos:Concepts.
Example: <anvils and anvil accessories> BTG <forging and metal-shaping tools> BTG <forging and metal-shaping equipment>,
so <anvils and anvil accessories> BTGE <forging and metal-shaping equipment>""";
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Ancestors (Generic). Meaningful closure of gvp:broaderGeneric. Infers iso:broaderGeneric for pairs of directly related skos:Concepts";
                           rdfs:domain gvp:Subject;
                           rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                           rdfs:label "broaderGenericExtended";
                           rdfs:range gvp:Subject;
                           rdfs:subPropertyOf gvp:broaderExtended;
                           <http://www.w3.org/2002/07/owl#propertyChainAxiom> (gvp:broaderGenericExtended
                                                                               gvp:broaderGeneric);
                           <http://www.w3.org/2004/02/skos/core#example> """<anvils and anvil accessories> BTG <forging and metal-shaping tools> BTG <forging and metal-shaping equipment>,
so <anvils and anvil accessories> BTGE <forging and metal-shaping equipment>""".
gvp:broaderInstantial <http://purl.org/dc/terms/description> """BTI (Kind/Instance, \"example of\") relation. We also infer iso-thes:broaderInstantial, which goes only between Concepts.
Example: Rembrandt van Rijn BTI Persons/Artists (ULAN)""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment """BTI (Kind/Instance, \"example of\") relation. We also infer iso-thes:broaderInstantial, which goes only between Concepts""";
                      rdfs:domain gvp:Subject;
                      rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                      rdfs:label "broaderInstantial";
                      rdfs:range gvp:Subject;
                      rdfs:subPropertyOf gvp:broaderInstantialExtended,
                                         gvp:broader;
                      <http://www.w3.org/2004/02/skos/core#example> "Rembrandt van Rijn BTI Persons/Artists (ULAN)".
gvp:broaderInstantialExtended <http://purl.org/dc/terms/description> "Ancestors (Instantial). Meaningful closure of gvp:broaderInstantial. Infers iso:broaderInstantial for pairs of directly related skos:Concepts.";
                              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:domain gvp:Subject;
                              rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                              rdfs:label "broaderInstantialExtended";
                              rdfs:range gvp:Subject;
                              rdfs:subPropertyOf gvp:broaderExtended;
                              <http://www.w3.org/2002/07/owl#propertyChainAxiom> (gvp:broaderInstantialExtended
                                                                                  gvp:broaderGeneric);
                              <http://www.w3.org/2004/02/skos/core#example> """Mt Athos (TGN) BTI orthodox religious center (AAT) BTG Christian religious center (AAT),
so Mt Athos (TGN) BTIE Christian religious center (AAT)""".
