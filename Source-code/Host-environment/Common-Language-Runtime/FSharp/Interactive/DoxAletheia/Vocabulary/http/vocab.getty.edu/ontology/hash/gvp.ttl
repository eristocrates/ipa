                      rdfs:comment "Chain of gvp:broader from Concept to GuideTerms, without intervening Concept";
                      rdfs:domain <http://www.w3.org/2004/02/skos/core#Concept>;
                      rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                      rdfs:label "broaderNonConcept";
                      rdfs:range gvp:GuideTerm.
gvp:broaderNonPreferred <http://purl.org/dc/terms/description> """Auxiliary parents of a subject. Very often there are several non-preferred parents (poly-hierarchy). Can use to mark such parents with [N] in displays .
Example: Non-preferred: \"baking dishes\" BTG \"dishes (vessels)\" (AAT)""";
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Auxiliary parents of a subject. Very often there are several non-preferred parents (poly-hierarchy). Can use to mark such parents with [N] in displays ";
                        rdfs:domain gvp:Subject;
                        rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                        rdfs:label "broaderNonPreferred";
                        rdfs:range gvp:Subject;
                        rdfs:subPropertyOf gvp:broader;
                        <http://www.w3.org/2004/02/skos/core#example> """Non-preferred: \"baking dishes\" BTG \"dishes (vessels)\" (AAT)""".
gvp:broaderPartitive <http://purl.org/dc/terms/description> """BTP (Part/Whole, \"part of\") relation. We also infer iso-thes:broaderPartitive, which goes only between Concepts.
Example: Tuscany (TGN) BTP Italy (TGN)""";
                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment """BTP (Part/Whole, \"part of\") relation. We also infer iso-thes:broaderPartitive, which goes only between Concepts""";
                     rdfs:domain gvp:Subject;
                     rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                     rdfs:label "broaderPartitive";
                     rdfs:range gvp:Subject;
                     rdfs:subPropertyOf gvp:broaderPartitiveExtended,
                                        gvp:broader;
                     <http://www.w3.org/2004/02/skos/core#example> "Tuscany (TGN) BTP Italy (TGN)".
gvp:broaderPartitiveExtended <http://purl.org/dc/terms/description> """Ancestors (Partitive). Meaningful closure of gvp:broaderPartitive. Infers iso:broaderPartitive for pairs of directly related skos:Concepts.
Example: anvil components BTP <anvils and anvil accessories> BTG <forging and metal-shaping tools>,
so anvil components BTPE <forging and metal-shaping tools>""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Ancestors (Partitive). Meaningful closure of gvp:broaderPartitive. Infers iso:broaderPartitive for pairs of directly related skos:Concepts";
                             rdfs:domain gvp:Subject;
                             rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                             rdfs:label "broaderPartitiveExtended";
                             rdfs:range gvp:Subject;
                             rdfs:subPropertyOf gvp:broaderExtended;
                             <http://www.w3.org/2002/07/owl#propertyChainAxiom> (gvp:broaderGeneric
                                                                                 gvp:broaderPartitiveExtended),
                                                                                (gvp:broaderPartitiveExtended
                                                                                 gvp:broaderPartitive),
                                                                                (gvp:broaderPartitiveExtended
                                                                                 gvp:broaderGeneric);
                             <http://www.w3.org/2004/02/skos/core#example> """anvil components BTP <anvils and anvil accessories> BTG <forging and metal-shaping tools>,
so anvil components BTPE <forging and metal-shaping tools>""".
gvp:broaderPreferred <http://purl.org/dc/terms/description> """Main parent of a subject. Needed to display the hierarchy.
Example: Preferred: \"baking dishes\" (AAT) BTG \"bakeware\" (AAT); Sofia (TGN) BTP Bulgaria (TGN)""";
                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Main parent of a subject. Needed to display the hierarchy";
                     rdfs:domain gvp:Subject;
                     rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                     rdfs:label "broaderPreferred";
                     rdfs:range gvp:Subject;
                     rdfs:subPropertyOf gvp:broaderPreferredExtended,
                                        gvp:broader;
                     <http://www.w3.org/2004/02/skos/core#example> """Preferred: \"baking dishes\" (AAT) BTG \"bakeware\" (AAT); Sofia (TGN) BTP Bulgaria (TGN)""".
gvp:broaderPreferredExtended <http://purl.org/dc/terms/description> """Preferred Ancestors. Meaningful closure of gvp:broaderPreferred. Needed to display the hierarchy.
Example: Mt Athos has preferred ancestor places (BTPE) World, Europe, Greece, Macedonia, Pangaíon Óros regional division;
and prefererd place type (BTIE) inhabited place""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Preferred Ancestors. Meaningful closure of gvp:broaderPreferred. Needed to display the hierarchy";
                             rdfs:domain gvp:Subject;
                             rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                             rdfs:label "broaderPreferredExtended";
                             rdfs:range gvp:Subject;
                             <http://www.w3.org/2004/02/skos/core#example> """Mt Athos has preferred ancestor places (BTPE) World, Europe, Greece, Macedonia, Pangaíon Óros regional division;
and prefererd place type (BTIE) inhabited place""".
gvp:contributorAlternatePreferred <http://purl.org/dc/terms/description> "Contributor for which the term is Alternate Preferred. Range is foaf:Agent";
                                  a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                    <http://www.w3.org/2002/07/owl#AnnotationProperty>;
