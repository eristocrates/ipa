                            rdfs:subPropertyOf <http://purl.org/dc/terms/contributor>;
                            <http://www.w3.org/2004/02/skos/core#example> """\"Lycra\" is non-preferred term for WHS""".
gvp:contributorPreferred <http://purl.org/dc/terms/description> """Contributor for which the term is Preferred. Range is foaf:Agent.
Example: \"organza\" is preferred term for WHS""";
                         a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
