                       rdfs:subPropertyOf gvp:placeType;
                       <http://www.w3.org/2004/02/skos/core#example> """The preferred place type of Machupicchu, Peru is \"deserted settlement\" (current)""".
gvp:prefLabelGVP <http://purl.org/dc/terms/description> "Term preferred by the Getty Vocabulary Program. The language is usually English. Applicable to AAT, ULAN, TGN. Used with skosxl:prefLabel";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
