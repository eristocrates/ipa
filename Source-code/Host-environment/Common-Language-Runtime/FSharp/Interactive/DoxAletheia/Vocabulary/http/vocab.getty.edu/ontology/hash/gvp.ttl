                         rdfs:subPropertyOf <http://purl.org/dc/terms/contributor>;
                         <http://www.w3.org/2004/02/skos/core#example> """\"organza\" is preferred term for WHS""".
gvp:displayOrder <http://purl.org/dc/terms/description> """Display order of subject or term amongst its siblings.
If all are 1 then use alphabetical. Domain is gvp:Subject or skosxl:Label""";
                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment """Display order of subject or term amongst its siblings.
If all are 1 then use alphabetical. Domain is gvp:Subject or skosxl:Label""";
