                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Current";
                                          <http://www.w3.org/2004/02/skos/core#scopeNote> "Valid/used currently".
<http://vocab.getty.edu/historic/currentAndHistoric> <http://purl.org/dc/terms/description> """Valid/used both in the past and currently.
Example: Saint Petersburg (TGN)""";
                                                     a <http://www.w3.org/2004/02/skos/core#Concept>,
                                                       <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                                     <http://www.w3.org/2004/02/skos/core#example> "Saint Petersburg (TGN)";
                                                     <http://www.w3.org/2004/02/skos/core#inScheme> <http://vocab.getty.edu/historic/>;
                                                     <http://www.w3.org/2004/02/skos/core#notation> "B";
                                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Both Current and Historic";
                                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Valid/used both in the past and currently".
<http://vocab.getty.edu/historic/historic> <http://purl.org/dc/terms/description> """Valid/used in the past but not currently.
Example: \"Lutetia\" is a historic name for \"Paris\" (TGN). \"weyneschot\" is a 16th-century spelling for \"wainscoting\" (AAT)""";
                                           a <http://www.w3.org/2004/02/skos/core#Concept>,
                                             <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                           <http://www.w3.org/2004/02/skos/core#example> """\"Lutetia\" is a historic name for \"Paris\" (TGN). \"weyneschot\" is a 16th-century spelling for \"wainscoting\" (AAT)""";
                                           <http://www.w3.org/2004/02/skos/core#inScheme> <http://vocab.getty.edu/historic/>;
                                           <http://www.w3.org/2004/02/skos/core#notation> "H";
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Historic";
                                           <http://www.w3.org/2004/02/skos/core#scopeNote> "Valid/used in the past but not currently".
<http://vocab.getty.edu/historic/localUse> <http://purl.org/dc/terms/description> """Used locally for Unidentified Named People mentioned in some document (ULAN only).
Example: 500051176 Abinetti (ULAN) is an unknown artist mentioned in documentation of lot 209 of an auction held 29 Jan 1824 in London""";
                                           a <http://www.w3.org/2004/02/skos/core#Concept>,
                                             <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                           <http://www.w3.org/2004/02/skos/core#example> "500051176 Abinetti (ULAN) is an unknown artist mentioned in documentation of lot 209 of an auction held 29 Jan 1824 in London";
                                           <http://www.w3.org/2004/02/skos/core#inScheme> <http://vocab.getty.edu/historic/>;
                                           <http://www.w3.org/2004/02/skos/core#notation> "LU";
                                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Local Use";
                                           <http://www.w3.org/2004/02/skos/core#scopeNote> "Used locally for Unidentified Named People mentioned in some document (ULAN only)".
<http://vocab.getty.edu/ontology> <http://purl.org/dc/terms/created> "2014-02-15"^^xsd:date;
                                  <http://purl.org/dc/terms/creator> <http://www.ontotext.com/>,
                                                                     <http://www.getty.edu/research/>;
                                  <http://purl.org/dc/terms/modified> "2015-03-25"^^xsd:date;
                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "gvp";
                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "http://vocab.getty.edu/ontology#";
                                  a <http://purl.org/vocommons/voaf#Vocabulary>,
                                    <http://www.w3.org/2002/07/owl#Ontology>,
                                    <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                  rdfs:comment """The GVP Ontology defines classes, properties and values (skos:Concepts) used in GVP LOD.
As of version 3.0, it is complete regarding AAT, TGN and ULAN, and will be extended in time with more elements needed for other GVP vocabularies (CONA).
It uses the SKOS, SKOS-XL, ISO 25964; DC, DCT, BIBO, FOAF, BIO, Schema, PROV, WGS84 ontologies, but we import only the first 3""";
                                  rdfs:label "Getty Vocabulary Program ontology";
                                  rdfs:seeAlso <http://vocab.getty.edu/.well-known/void>,
                                               <http://www.getty.edu/research/tools/vocabularies/lod/>,
                                               <http://lov.okfn.org/dataset/lov/details/vocabulary_gvp.html>,
                                               <http://vocab.getty.edu/doc>,
                                               <http://vocab.getty.edu/doc/queries>;
                                  <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/2004/02/skos/core>,
                                                                          <http://purl.org/iso25964/skos-thes>,
                                                                          <http://www.w3.org/2008/05/skos-xl>;
                                  <http://www.w3.org/2002/07/owl#versionInfo> "3.0";
                                  <http://www.w3.org/2004/02/skos/core#changeNote> <http://vocab.getty.edu/doc#Version_2.0>,
                                                                                   <http://vocab.getty.edu/doc#Version_3.0>,
                                                                                   """2.0 changes: replaced gvp:broaderTransitive with gvp:broaderExtended;
3.0 changes: replaced schema:startDate, endDate with gvp:estStart, estEnd; added ULAN). See details in referenced links""".
gvp:AdminPlaceConcept <http://purl.org/dc/terms/description> """Place defined by administrative boundaries and conditions, including inhabited places, nations, and empires. Used in TGN only.
Example: Burgundy region in France (TGN)""";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Place defined by administrative boundaries and conditions, including inhabited places, nations, and empires. Used in TGN only";
                      rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                      rdfs:label "AdminPlaceConcept";
                      rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>,
                                      gvp:Subject;
                      <http://www.w3.org/2004/02/skos/core#example> "Burgundy region in France (TGN)".
gvp:Biography a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment """Biography of a ULAN agent (schema:Person|Organization). Depending on the agent, has these fields:
- schema:description: one-line-biography
- gvp:estStart
- schema:birthPlace | foundationLocation, pointing to TGN
- gvp:estEnd
- schema:deathPlace | dissolutionLocation, pointing to TGN
- schema:gender, pointing to AAT (male, female, other)
- dct:contributor
The fields of the preferred biogrpahy are also available in the agent.""";
              rdfs:isDefinedBy <http://vocab.getty.edu/ontology>.
gvp:Concept <http://purl.org/dc/terms/description> """Proper concept. Used in AAT only; TGN & ULAN have their own, e.g. gvp:PhysPlaceConcept & gvp:PersonConcept. Used for indexing and cataloguing.
Example: rhyta (AAT)""";
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Proper concept. Used in AAT only; TGN & ULAN have their own, e.g. gvp:PhysPlaceConcept & gvp:PersonConcept. Used for indexing and cataloguing";
            rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
            rdfs:label "Concept";
            rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>,
                            gvp:Subject;
            <http://www.w3.org/2004/02/skos/core#example> "rhyta (AAT)".
gvp:Facet <http://purl.org/dc/terms/description> """One of the major divisions of a vocabulary.
Example: Objects Facet (AAT), World (TGN), Artists (ULAN)""";
          a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "One of the major divisions of a vocabulary";
          rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
          rdfs:label "Facet";
          rdfs:subClassOf gvp:Subject,
                          <http://purl.org/iso25964/skos-thes#ThesaurusArray>;
          <http://www.w3.org/2004/02/skos/core#example> "Objects Facet (AAT), World (TGN), Artists (ULAN)".
gvp:GroupConcept <http://purl.org/dc/terms/description> """Two or more people who generally worked together to collectively create art. Not necessarily legally incorporated. A family of artists may be considered a \"corporate body\". Corresponds to crm:E74_Group, not its subclass crm:E40_Legal_Body.
Example: 500356337 Albrecht Duerer Workshop (ULAN)""";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment """Two or more people who generally worked together to collectively create art. Not necessarily legally incorporated. A family of artists may be considered a \"corporate body\". Corresponds to crm:E74_Group, not its subclass crm:E40_Legal_Body""";
                 rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
                 rdfs:label "GroupConcept";
                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>,
                                 gvp:Subject;
                 <http://www.w3.org/2004/02/skos/core#example> "500356337 Albrecht Duerer Workshop (ULAN)".
gvp:GuideTerm <http://purl.org/dc/terms/description> """Guide Term: place holder to create a level in the hierarchy. Used in AAT and ULAN. Not used for indexing or cataloguing..
Example: <vessels for serving and consuming food> (AAT), ulan:500353455 <named animals> under facet Non-Artists (ULAN)""";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Guide Term: place holder to create a level in the hierarchy. Used in AAT and ULAN. Not used for indexing or cataloguing.";
              rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
              rdfs:label "GuideTerm";
              rdfs:subClassOf gvp:Subject,
                              <http://purl.org/iso25964/skos-thes#ThesaurusArray>;
              <http://www.w3.org/2004/02/skos/core#example> "<vessels for serving and consuming food> (AAT), ulan:500353455 <named animals> under facet Non-Artists (ULAN)".
gvp:Hierarchy <http://purl.org/dc/terms/description> """Top of a hierarchy. Used in AAT only. Not used for indexing or cataloguing.
Example: Containers (Hierarchy Name) (AAT)""";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Top of a hierarchy. Used in AAT only. Not used for indexing or cataloguing";
              rdfs:isDefinedBy <http://vocab.getty.edu/ontology>;
              rdfs:label "Hierarchy";
              rdfs:subClassOf gvp:Subject,
                              <http://purl.org/iso25964/skos-thes#ThesaurusArray>;
              <http://www.w3.org/2004/02/skos/core#example> "Containers (Hierarchy Name) (AAT)".
