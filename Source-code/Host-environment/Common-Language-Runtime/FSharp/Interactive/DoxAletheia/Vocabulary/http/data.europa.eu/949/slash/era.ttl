era:PlatformEdge era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/PlatformEdgeShape>;
                 dcterms:created "2021-08-02"^^xsd:date;
                 dcterms:modified "2025-01-30"^^xsd:date,
