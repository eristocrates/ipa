                          rdfs:label "Minimum radius of vertical curve"@en;
                          status:term_status "stable";
                          skos:scopeNote "Presentation of parameter 1.2.2.0.3.3 'Minimum radius of vertical curve'"@en.
era:NationalRailwayLine dcterms:created "2021-01-25"^^xsd:date;
                        dcterms:modified "2024-11-29"^^xsd:date,
                                         "2021-08-03"^^xsd:date;
                        a owl:Class;
                        rdfs:comment """Railway line within a member state.
A line is a sequence of one or more sections of line, which connects operational points and which may consist of several tracks used for regular railway operation."""@en;
                        rdfs:isDefinedBy era:;
                        rdfs:label "(deprecated) National railway line"@en;
                        rdfs:subClassOf era:InfrastructureElement;
                        owl:deprecated true;
                        owl:disjointWith era:PrimaryLocation;
                        status:term_status "stable".
era:NetAreaReference era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/NetAreaReferenceShape>;
                     dcterms:created "2024-11-29"^^xsd:date;
                     a owl:Class;
