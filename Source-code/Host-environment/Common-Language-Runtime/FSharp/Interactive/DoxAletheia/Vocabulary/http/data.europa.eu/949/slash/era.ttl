era:trackPhaseInfo era:XMLName "EOS_InfoPhase";
                   era:applicable "Y/N";
                   era:dependencyNote """A value is mandatory only if 1.1.1.2.4.1.1 parameter \"Phase separation\" value is \"Y\" (true), otherwise applicability flag is \"N\" (not applicable)"""@en;
                   era:formatNote """In RDF the range is an instance of the era:PhaseInfo class with all its properties.

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, the data format is a character string with the following structure: distance type [MIN/MAX] + length [NNN] + switch off breaker [Y/N] + lower pantograph [Y/N] + km [NNN.NNN]. The structure of the string is as follows:
- distance type [MIN/MAX] - single selection of 'MIN=minimum' or 'MAX=maximum' to show whether the length is a minimum distance between the inner contact strips of the pantographs or a maximum distance between the outer contact strips of the pantographs. Multiple strings for this parameter are accepted;
- length [NNN] - the length of the phase separation in meters;
- switch off breaker [Y/N], single selection of 'yes' or 'no' to show whether the breaker has to be switched off; 
- lower pantograph [Y/N], single selection of 'yes' or 'no' to show whether the pantograph has to be lowered,  
- Km [NNN.NNN] - the location from the start of the line where the new value is valid."""@en;
                   era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
                   era:rinfIndex "1.1.1.2.4.1.2";
                   era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackPhaseInfo>,
                                                <http://data.europa.eu/949/shapes/TrackPhaseInfoApplicability>;
                   dcterms:created "2023-04-05"^^xsd:date;
                   dcterms:modified "2025-06-09"^^xsd:date,
                                    "2025-02-28"^^xsd:date,
                                    "2025-02-18"^^xsd:date;
                   dcterms:replaces era:phaseInfo;
                   a owl:ObjectProperty;
                   rdfs:comment "Relates the Track with PhaseInfo. Indication of required several information on phase separation."@en;
                   rdfs:domain [a owl:Class ; 
                                owl:unionOf ()];
                   rdfs:isDefinedBy era:;
                   rdfs:label "Information on phase separation"@en;
                   rdfs:range era:PhaseInfo;
                   rdfs:seeAlso "ENE TSI: 4.2.15";
                   rdfs:subPropertyOf era:oclSeparationSectionsObjParameter;
                   status:term_status "stable".
era:trackRaisedPantographsDistanceAndSpeed era:XMLName "EPA_NumRaisedSpeed";
                                           era:applicable "Y/N";
                                           era:dependencyNote "Mandatory only if “Overhead contact line (OCL)” is selected in 1.1.1.2.2.1.1, otherwise the parameter is not applicable."@en;
                                           era:formatNote "Three values: [N] is number of pantographs; [NNN] is minimum distance between pantographs, in metres; [NNN] is the speed considered in km/h.";
                                           era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
                                           era:rinfIndex "1.1.1.2.3.3";
                                           era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TrackRaisedPantographsDistanceAndSpeed>,
                                                                        <http://data.europa.eu/949/shapes/TrackRaisedPantographDistanceAndSpeedApplicability>;
                                           era:usedInRCCCalculations true;
