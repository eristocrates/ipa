era:railInclination era:XMLName "ITP_RailInclination";
                    era:applicable "Y";
                    era:eratvIndex "4.6.5";
                    era:formatNote "In XML the accepted value is NN, where N is a digit from 0 to 9."@en;
                    era:inSkosConceptScheme <http://data.europa.eu/949/concepts/rail-inclinations/RailInclinations>;
                    era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
                    era:rinfIndex "1.1.1.1.4.3";
                    era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RailInclination>,
                                                 <http://data.europa.eu/949/shapes/RailInclinationSKOS>;
                    era:usedInRCCCalculations true;
                    dcterms:created "2020-08-24"^^xsd:date;
                    dcterms:modified "2025-02-28"^^xsd:date,
                                     "2024-09-19"^^xsd:date,
                                     "2022-10-20"^^xsd:date;
                    dcterms:source <http://data.europa.eu/eli/reg/2014/1299/2023-09-28>;
                    a owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:comment "An angle defining the inclination of the head of a rail relative to the running surface."@en;
                    rdfs:domain [a owl:Class ; 
                                 owl:unionOf ()];
                    rdfs:isDefinedBy era:;
                    rdfs:label "Rail inclination"@en;
                    rdfs:range skos:Concept;
                    rdfs:seeAlso "INF TSI:4.2.4.7";
                    rdfs:subPropertyOf era:trackObjParameter,
                                       era:vehicleTypeTechnicalObjectCharacteristic;
                    status:term_status "stable";
                    skos:scopeNote """This inclination is in most cases expressed for MS globally, but anyway it requires presentation for the specific track, when in one SoL more values occur.
An angle defining the inclination of the head of a rail when installed in the track relative to the plane of the rails (running surface), equal to the angle between the axis of symmetry of the rail (or of an equivalent symmetrical rail having the same rail head profile) and the perpendicular to the plane of the rails. The typical values for the railway inclination are 1:20, 1:30, 1:40."""@en.
