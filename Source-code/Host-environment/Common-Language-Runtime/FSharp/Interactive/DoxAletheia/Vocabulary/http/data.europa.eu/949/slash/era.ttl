era:tunnelDocRef era:XMLName "ITU_TunnelDocRef";
                 era:applicable "Y/N";
                 era:legalDeadline "1 January 2021"@en;
                 era:rinfIndex "1.1.1.1.8.8.2";
                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/TunnelDocRef>;
