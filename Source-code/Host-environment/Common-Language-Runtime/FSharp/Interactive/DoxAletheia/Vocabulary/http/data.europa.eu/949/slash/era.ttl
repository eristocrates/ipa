era:HABD dcterms:created "2025-02-20"^^xsd:date;
         dcterms:modified "2025-03-01"^^xsd:date;
         a owl:Class;
         rdfs:comment """A trackside Hot Axle Box Detector (HABD), necessary for the route compatibility check.
Specific for the French, Italian and Swedish networks"""@en;
         rdfs:isDefinedBy era:;
         rdfs:label "Hot Axle Box Detector"@en;
         rdfs:subClassOf era:InfrastructureElement;
         owl:disjointWith era:SectionOfLine,
                          era:PrimaryLocation,
                          era:KilometricPost,
                          era:PlatformEdge,
                          era:LevelCrossing,
                          era:Tunnel,
                          era:SpecialArea,
                          era:OperationalPoint,
