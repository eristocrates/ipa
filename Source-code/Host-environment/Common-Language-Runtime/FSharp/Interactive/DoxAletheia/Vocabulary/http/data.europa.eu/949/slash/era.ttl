             era:unitOfMeasure unit:MilliM-PER-M;
             era:usedInRCCCalculations true;
             dcterms:created "2021-08-10"^^xsd:date;
             dcterms:modified "2021-08-10"^^xsd:date,
                              "2025-03-11"^^xsd:date,
