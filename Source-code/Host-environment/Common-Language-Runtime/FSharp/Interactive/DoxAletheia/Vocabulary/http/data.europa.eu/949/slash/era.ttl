                 era:legalDeadline "1 January 2021"@en,
                                   "12 months after publication of Article 7 Guide for OP tracks"@en;
                 era:rinfIndex "1.2.1.1.1.10",
                               "1.1.1.3.2.10";
                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsMVersionApplicability>,
                                              <http://data.europa.eu/949/shapes/EtcsMVersionSKOS>,
                                              <http://data.europa.eu/949/shapes/EtcsMVersion>;
                 era:usedInRCCCalculations true;
                 dcterms:created "2021-08-08"^^xsd:date;
                 dcterms:modified "2025-02-28"^^xsd:date,
                                  "2021-09-12"^^xsd:date,
                                  "2024-04-18"^^xsd:date,
                                  "2025-03-04"^^xsd:date;
