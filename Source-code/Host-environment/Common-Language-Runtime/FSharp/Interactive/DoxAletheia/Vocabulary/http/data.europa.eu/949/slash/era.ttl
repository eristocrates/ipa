era:contactLineSystemType era:XMLName "ECS_SystemType";
                          era:applicable "Y/N";
                          era:dependencyNote "If this parameter is repeated, parameters 1.1.1.2.2.1.2, and 1.1.1.2.2.2 shall be created also for the corresponding type. These two parameters are to be considered children of the current. "@en;
                          era:inSkosConceptScheme <http://data.europa.eu/949/concepts/contact-line-systems/ContactLineSystems>;
                          era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
                          era:rinfIndex "1.1.1.2.2.1.1";
                          era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/ContactLineSystemTypeNotElectrifiedApplicability>,
                                                       <http://data.europa.eu/949/shapes/ContactLineSystemType>,
                                                       <http://data.europa.eu/949/shapes/ContactLineSystemTypeThirdOrFourthRailApplicability>,
                                                       <http://data.europa.eu/949/shapes/ContactLineSystemTypeSKOS>;
                          era:usedInRCCCalculations true;
                          dcterms:created "2021-08-06"^^xsd:date;
                          dcterms:modified "2025-02-28"^^xsd:date,
                                           "2021-08-06"^^xsd:date;
                          a owl:FunctionalProperty,
                            owl:ObjectProperty;
                          rdfs:comment "Indication of the type of the contact line system."@en;
                          rdfs:domain era:ContactLineSystem;
                          rdfs:isDefinedBy era:;
                          rdfs:label "Type of contact line system"@en;
                          rdfs:range skos:Concept;
                          rdfs:subPropertyOf era:contactLineSystemObjParameter;
                          status:term_status "stable";
                          skos:scopeNote """When the value is \"not electrified\", then all parameters 1.1.1.2.2.1.2 - 1.1.1.2.5.3 are not applicable. 
When the value is “Third Rail” or “Fourth Rail”, then parameters 1.1.1.2.2.3, 1.1.1.2.2.5 - 1.1.1.2.4.2.3, 1.1.1.2.5.2 and 1.1.1.2.5.3 are not applicable

For RINF XML data sets:
As long as the data provision through XML data sets is allowed, if this parameter is repeated, parameters 1.1.1.2.2.1.2, 1.1.1.2.2.2, 1.1.1.2.2.4 and 1.1.1.2.5.1 shall be created also for the corresponding type. These four parameters are to be considered children of the current. 
For grouping “children” parameters of the current parameter, an XML attribute called “set” must be declared at the parent and children levels with the same keyword value."""@en.
