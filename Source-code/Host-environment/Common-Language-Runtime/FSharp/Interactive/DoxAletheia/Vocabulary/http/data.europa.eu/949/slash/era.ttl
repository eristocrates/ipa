                         rdfs:range xsd:boolean;
                         rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemDataParameter;
                         status:term_status "stable";
                         skos:scopeNote """As indicated in CCS TSI section 7.2.9.1, an ETCS Level 1 trackside application may require that the on-board is equipped with the corresponding in-fill data transmission (Euroloop or radio) if the release speed is set to zero for safety reasons.
                         
See: TSI CCS 7.2.9.1 & 4.2.3 """@en.
era:etcsLevelType era:XMLName "CPE_Level";
                  era:applicable "Y/N";
                  era:inSkosConceptScheme <http://data.europa.eu/949/concepts/etcs-levels/ETCSLevels>;
                  era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
                  era:rinfIndex "1.2.1.1.1.1",
                                "1.1.1.3.2.1";
                  era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsLevelTypeSKOS>,
                                               <http://data.europa.eu/949/shapes/EtcsLevelType>;
                  era:tsiOPEAppendixD2Index "3.2.7";
                  dcterms:created "2021-08-07"^^xsd:date;
                  dcterms:modified "2025-02-28"^^xsd:date,
                                   "2024-01-08"^^xsd:date,
                                   "2024-04-18"^^xsd:date,
                                   "2025-01-23"^^xsd:date,
                                   "2024-08-13"^^xsd:date;
                  dcterms:relation era:cantDeficiencyBasicSSP,
                                   era:etcsTransmittedTrackConditions,
                                   era:etcsSystemCompatibility,
                                   era:rbcID,
                                   era:gsmRActiveMobiles,
                                   era:etcsDegradedSituation,
                                   era:rbcPhone,
                                   era:etcsMVersion,
                                   era:etcsBaseline;
                  dcterms:source <http://data.europa.eu/eli/reg_impl/2023/1695/oj>;
                  a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:comment "ETCS application level related to the track side equipment."@en;
                  rdfs:domain era:ETCS;
                  rdfs:isDefinedBy era:;
                  rdfs:label "European Train Control System (ETCS) level"@en;
                  rdfs:range skos:Concept;
                  rdfs:seeAlso "TSI CCS (Subset-026, Chapter 2, 2.6)";
                  rdfs:subPropertyOf era:tsiCompliantTrainProtectionSystemObjParameter;
                  status:term_status "stable";
                  skos:scopeNote """The different ERTMS / ETCS application levels are a way to express the possible operating relationships between track and train. 
  
Level definitions are principally related to the track side equipment used, to the way the track side information reaches the on-board units and to which functions are processed in the track side and in the on-board equipment respectively.

If ETCS is on the trackside (one or more levels are selected), all other ETCS parameters (from 1.1.1.3.2.2 to 1.1.1.3.2.10) are applicable and mandatory to be populated with values .
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter is “N”(not applicable). 

The ETCS value NTC is only relevant when the line is dual equipped with ETCS (i.e., balises are placed in the track) and Class B system, and both systems are in operation at the same time. 
In those cases, this parameter should be filled relevant ETCS Level and repeated with the value NTC.
  
If the line is only equipped with Class B, this should be reflected in Parameter 1.1.1.3.5.3, and this parameter etcsLevelType should not be used. 

If operation in the line is authorised for ETCS and non ETCS vehicles using class B system, Parameter 1.1.1.3.5.3 shall also be used in combination with 1.1.1.3.2.1.
See: TSI CCS (Subset-026, Chapter 2, 2.6)"""@en.
