era:RunningTrack era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/RunningTrackShape>;
                 dcterms:created "2020-07-29"^^xsd:date;
                 dcterms:modified "2024-09-19"^^xsd:date,
                                  "2024-11-20"^^xsd:date,
                                  "2022-07-07"^^xsd:date;
                 a owl:Class;
                 rdfs:comment "A running track means any track used for train service movements; passing loops and meeting loops on plain line or track connections only required for train operation are not published"@en;
                 rdfs:isDefinedBy era:;
                 rdfs:label "Running track"@en;
                 rdfs:subClassOf era:Track;
                 owl:disjointWith era:Siding,
                                  era:Tunnel,
                                  era:Switch,
                                  era:Signal;
                 status:term_status "stable";
                 skos:scopeNote "There might be more than one track within the Section of Line, so then the whole set of data for track has to be repeated for each track within the SoL."@en.
era:SectionOfLine era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SectionOfLineShape>;
                  dcterms:created "2021-04-02"^^xsd:date;
                  dcterms:modified "2025-01-30"^^xsd:date,
                                   "2025-03-01"^^xsd:date,
                                   "2024-09-19"^^xsd:date,
                                   "2022-07-07"^^xsd:date;
                  dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>;
                  a owl:Class;
                  rdfs:comment "A section of line means the part of line between adjacent operational points and may consist of several tracks."@en;
                  rdfs:isDefinedBy era:;
                  rdfs:label "Section Of Line"@en;
                  rdfs:subClassOf era:InfrastructureElement,
                                  [a owl:Restriction ; 
                                   owl:onProperty era:opEnd ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onClass era:OperationalPoint],
                                  [a owl:Restriction ; 
                                   owl:onProperty era:opStart ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onClass era:OperationalPoint],
                                  [a owl:Restriction ; 
                                   owl:onProperty era:nationalLine ; 
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                   owl:onClass era:LinearPositioningSystem];
                  owl:disjointWith era:Switch,
                                   era:Signal,
                                   era:Track,
                                   era:SpecialArea,
                                   era:Tunnel;
                  status:term_status "stable";
                  skos:scopeNote "Each network shall be described using as many SoLs as necessary. Each SoL   is generated and identified by OP IDs at start and at end. A SoL only belongs to one Line."@en.
era:Siding era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SidingShape>;
           dcterms:created "2021-08-10"^^xsd:date;
           dcterms:modified "2024-09-19"^^xsd:date,
                            "2024-11-20"^^xsd:date,
                            "2022-10-27"^^xsd:date;
           dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2020-06-16>;
           a owl:Class;
           rdfs:comment "Sidings are all those tracks where running trains in service movements ends and which are not used for operational routing of a train."@en;
           rdfs:isDefinedBy era:;
           rdfs:label "Siding"@en;
           rdfs:subClassOf era:Track;
           owl:disjointWith era:Switch,
                            era:Signal,
                            era:Tunnel;
           status:term_status "stable";
           skos:definition "Siding - Any track(s) within an operational point which is not used for operational routing of a train."@en.
era:Signal era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SignalShape>;
           dcterms:created "2021-04-01"^^xsd:date;
           dcterms:modified "2022-10-27"^^xsd:date,
                            "2025-03-01"^^xsd:date,
                            "2024-09-19"^^xsd:date,
                            "2025-01-30"^^xsd:date;
           dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/2023-09-28>;
           a owl:Class;
           rdfs:comment "A railway signal is a visual display device (next to the tracks or via a DMI in the cabin) that conveys instructions or provides advance warning of instructions regarding the driver's authority to proceed."@en;
           rdfs:isDefinedBy era:;
           rdfs:label "Signal"@en;
           rdfs:seeAlso "https://www.era.europa.eu/system/files/2023-09/index003_-_SUBSET-023_v400.pdf"^^xsd:anyURI;
           rdfs:subClassOf era:InfrastructureElement;
           owl:disjointWith era:Switch,
                            era:Track,
                            era:Tunnel,
                            era:SpecialArea;
           status:term_status "stable";
           skos:definition "Apparatus by means of which a conventional visual or acoustic indication is given, generally concerning the movements/movement authorities of railway vehicles."@en.
era:SpecialArea era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SpecialAreaShape>;
                dcterms:created "2022-10-27"^^xsd:date;
                dcterms:modified "2024-04-18"^^xsd:date,
                                 "2025-03-01"^^xsd:date;
                dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>;
                a owl:Class;
                rdfs:comment """Encompasses all those areas (outside of the operational gauge) or sections (those in tunnels excluded) which influence operation in the gauge itself, such as 
- safe areas, 
- restricted areas (non-stopping areas or industrial risk locations).

For these areas in tunnels, use era:SpecialTunnelArea."""@en;
                rdfs:isDefinedBy era:;
                rdfs:label "Special area"@en;
                rdfs:subClassOf era:InfrastructureElement;
                owl:disjointWith era:Track,
                                 era:Switch,
                                 era:Tunnel;
                status:term_status "stable";
                skos:definition """Non-stopping Area: Area defined by the Infrastructure Manager where it may not be safe or suitable to stop a train.
Safe Area: Area defined by the Infrastructure Manager where it is safe or suitable to stop and evacuate a train.
Industrial Risk Area: locations where it is dangerous for the driver to step out."""@en;
                skos:editorialNote "TODO review the definition".
era:SpecialTunnelArea era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SpecialTunnelAreaShape>;
                      dcterms:created "2022-10-27"^^xsd:date;
                      dcterms:source <http://data.europa.eu/eli/reg_impl/2019/773/oj>;
                      a owl:Class;
                      rdfs:comment """Area or location within a tunnel where there are:
- a safe area: a walkway, evacuation and rescue points;
- a restricted area (non-stopping area or industrial risk location in a tunnel)."""@en;
                      rdfs:isDefinedBy era:;
                      rdfs:label "Special tunnel area"@en;
                      rdfs:subClassOf era:SpecialArea;
                      status:term_status "stable";
                      skos:editorialNote "TODO review the definition".
era:SubsidiaryLocation era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/SubsidiaryLocationShape>;
                       dcterms:created "2024-05-24"^^xsd:date;
                       dcterms:modified "2025-03-10"^^xsd:date;
                       a owl:Class;
                       rdfs:comment "Subsidiary location must be linked to a Primary Location and specifies in more detailed way part, attributes, or usage of Primary location. It may be also a non-rail point or a rail point that is not managed by an Infrastructure Manager (IM). It may be defined by entity having company code according to their needs. The Subsidiary location is optional and dependent upon business needs."@en;
                       rdfs:isDefinedBy era:;
                       rdfs:label "Subsidiary location"@en;
                       rdfs:seeAlso "http://taf-jsg.info/wp-content/uploads/2024/01/20231018-JGS-Handbook-3.4-with-XSD-3.4.0.0.pdf"^^xsd:anyURI;
                       rdfs:subClassOf era:Feature,
                                       [a owl:Restriction ; 
                                        owl:onProperty era:linkedToPrimaryLocation ; 
                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                        owl:onClass era:PrimaryLocation].
