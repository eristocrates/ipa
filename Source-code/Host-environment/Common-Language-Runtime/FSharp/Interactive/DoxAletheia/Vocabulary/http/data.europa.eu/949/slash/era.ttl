era:isQuietRoute era:XMLName "IHS_QuietRoute";
                 era:applicable "Y";
                 era:formatNote "in XML: Y/N";
                 era:legalDeadline "1 January 2021"@en;
                 era:rinfIndex "1.1.1.1.7.11";
                 era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/IsQuietRoute>;
                 dcterms:created "2020-11-04"^^xsd:date;
                 dcterms:modified "2024-01-08"^^xsd:date,
                                  "2025-02-28"^^xsd:date;
                 a owl:FunctionalProperty,
                   owl:DatatypeProperty;
                 rdfs:comment "Belonging to a 'quieter route' in accordance with Article 5b of TSI NOI."@en;
                 rdfs:domain [a owl:Class ; 
                              owl:unionOf ()];
                 rdfs:isDefinedBy era:;
                 rdfs:label "Belonging to a quieter route"@en;
                 rdfs:range xsd:boolean;
                 rdfs:seeAlso "Art 5b of Regulation (EU) 1304/2014 (amended by Regulation (EU) 2019/774) of 16 May 2019";
                 rdfs:subPropertyOf era:healthSafetyAndEnvironmentDataParameter;
                 status:term_status "stable";
                 skos:scopeNote """Art 5B: A quieter route means a part of the railway infrastructure with a minimum length of 20 km on which the average number of daily operated freight trains during the night-time as defined in national legislation transposing Directive 2002/49/EC of the European Parliament and of the Council (5) was higher than 12. The freight traffic in the years 2015, 2016 and 2017 shall be the basis for the calculation of that average number. In case the freight traffic due to exceptional circumstances diverges in a given year from that average number by more than 25 %, the Member State concerned can calculate the average number on the basis of the remaining two years.
Art 5.C 1:   Member States shall designate quieter routes in accordance with Article 5b and the procedure set out in Appendix D.1 of the Annex. They shall provide the European Union Agency for Railways ( the Agency ) with a list of quieter routes six months after the date of publication of this Regulation at the latest. The Agency shall publish those lists on its website."""@en.
era:kilometer era:XMLName "OPRailwayLocation";
              era:applicable "Y/N";
              era:legalDeadline "In accordance with Implementing Decision 2014/880/EU and by 16 March 2019 at the latest"@en;
