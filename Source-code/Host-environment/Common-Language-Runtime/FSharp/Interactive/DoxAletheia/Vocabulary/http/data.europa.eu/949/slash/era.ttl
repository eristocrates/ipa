                                              "12 months after publication of Article 7 Guide"@en;
                            era:rinfIndex "1.1.1.3.2.5",
                                          "1.2.1.1.1.5";
                            era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44>,
                                                         <http://data.europa.eu/949/shapes/HasEtcsNationalPacket44Applicability>;
                            dcterms:created "2024-11-20"^^xsd:date;
                            dcterms:modified "2025-05-05"^^xsd:date;
                            dcterms:replaces era:etcsNationalPacket44;
