                                           "12 months after publication of Article 7 Guide for OP tracks"@en;
                         era:rinfIndex "1.2.1.1.1.3",
                                       "1.1.1.3.2.3";
                         era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/EtcsInfillLineAccess>,
                                                      <http://data.europa.eu/949/shapes/EtcsInfillLineAccessApplicability>;
