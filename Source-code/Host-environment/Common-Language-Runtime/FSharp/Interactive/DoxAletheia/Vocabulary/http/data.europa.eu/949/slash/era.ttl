era:CommonCharacteristicsSubset era:shaclShapeValidationRule <http://data.europa.eu/949/shapes/CommonCharacteristicsSubsetShape>;
                                dcterms:created "2022-11-04"^^xsd:date;
                                dcterms:modified "2026-01-11"^^xsd:date,
