gr:BusinessEntity a owl:Class;
                  rdfs:comment "GoodRelation: This class represents the legal agent making (or seeking) a particular offering. This can be a legal body or a person. A business entity has at least a primary mailing address and contact";
                  rdfs:label "Business Entity"@it,
                             "Business Entity"@en;
                  rdfs:subClassOf wgspos:SpatialThing.
schema:Event a owl:Class.
schema:Place a owl:Class.
schema:location a owl:ObjectProperty;
                rdfs:comment "property of the schema.org ontology";
                rdfs:domain schema:Event;
                rdfs:range schema:Place.
<http://www.disit.org/km4city/schema> dcterms:contributor "Municipality of Florence, Tuscany Region"@en;
                                      dcterms:creator "Paolo Nesi"@en,
                                                      "Nadia Rauch"@en,
                                                      "Pierfrancesco Bellini"@en;
                                      dcterms:description "A Knowledge Model to describe a smart city, that interconnect data from infomobility service, Open Data and other source"@en;
                                      dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/it/>;
                                      dcterms:publisher "DISIT Lab, University of Florence, Italy";
                                      dcterms:rights "The Knowledge Model for the City - km4city - is available under Creative Commons Attribution-ShareAlike 3.0 Unported license"@en;
                                      dcterms:subject "Ontology, Semantic SEO, RDFa, Linked Data, RDF, Semantic Web, Smart Recommender Systems, Smart City, Transportation Network, Smart Mobility, Citizens Services, Semantic Model, knowledge model"@en;
                                      dcterms:title "km4city, the DISIT Knowledge Model for City and Mobility"@en;
                                      vann:preferredNamespacePrefix "km4c";
                                      vann:preferredNamespaceUri "http://www.disit.org/km4city/schema";
                                      a owl:Ontology;
                                      rdfs:comment "The Knowledge Model aims at enabling interconnection, storage and the next interrogation of data from many different sources, such as various portals of the Tuscan region (MIIC, Muoversi in Toscana, Osservatorio dei Trasporti), Open Data provoded by individual municipalities (mainly Florence)."@en;
                                      rdfs:label "km4city, the DISIT Knowledge Model for City and Mobility"@en;
                                      owl:versionInfo "V 1.6.1 RDFSPlus Adaptation, Release 2015-07-28"@en;
                                      foaf:homepage <http://www.disit.org/>.
km4c:AVMRecord a owl:Class;
               rdfs:comment "Corsa programmata da una certa azienda TPL su un certo percorso di una certa linea";
               rdfs:label "Registrazione AVM"@it,
                          "AVM Record"@en;
               rdfs:subClassOf [owl:onDataRange xsd:float ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wgspos:long ; 
                                a owl:Restriction],
                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onClass km4c:Route ; 
                                owl:onProperty km4c:onRoute ; 
                                a owl:Restriction],
                               [owl:onDataRange xsd:float ; 
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty wgspos:lat ; 
                                a owl:Restriction],
                               wgspos:SpatialThing.
