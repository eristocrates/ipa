km4c:composeDirection a owl:ObjectProperty;
                      rdfs:comment "a railway Direction is composed by more railway element";
                      rdfs:domain km4c:RailwayElement;
                      rdfs:range km4c:RailwayDirection;
                      owl:inverseOf km4c:consistOfElement.
km4c:composeSection a owl:ObjectProperty;
                    rdfs:comment "a railway Section is composed by more railway element";
                    rdfs:domain km4c:RailwayElement;
                    rdfs:range km4c:RailwaySection;
