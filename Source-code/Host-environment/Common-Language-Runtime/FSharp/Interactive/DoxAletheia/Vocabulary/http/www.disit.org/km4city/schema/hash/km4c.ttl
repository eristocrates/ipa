           rdfs:range xsd:string.
km4c:hasAVMRecord a owl:ObjectProperty;
                  rdfs:comment "the AVM refer to a specific ride code";
                  rdfs:domain km4c:Ride;
                  rdfs:range km4c:AVMRecord.
km4c:hasAccess a owl:ObjectProperty;
               rdfs:comment "point corresponding to the house number of service";
               rdfs:domain [owl:unionOf (gr:BusinessEntity
                                         km4c:Service) ; 
                            a owl:Class];
               rdfs:range km4c:Entry.
km4c:hasBObservation a owl:ObjectProperty;
                     rdfs:comment "to connect each beacon to observations that it produces";
                     rdfs:domain km4c:Beacon;
                     rdfs:range km4c:BeaconObservation.
km4c:hasCarParkSensor a owl:ObjectProperty;
                      rdfs:comment "to connect each car park to its installed sensor";
                      rdfs:domain km4c:TransferServiceAndRenting;
                      rdfs:range km4c:CarParkSensor;
                      owl:inverseOf km4c:observeCarPark.
km4c:hasElement a owl:ObjectProperty;
                rdfs:comment "a railway line is composed by more railway element";
                rdfs:domain km4c:RailwayLine;
                rdfs:range km4c:RailwayElement.
km4c:hasExpectedTime a owl:ObjectProperty;
                     rdfs:comment "the expected time at the next bus stops";
                     rdfs:domain km4c:BusStopForecast;
                     rdfs:range time:Instant;
                     owl:inverseOf km4c:instantForecast.
km4c:hasExternalAccess a owl:ObjectProperty;
                       rdfs:comment "it corresponds to the outer gate of the building";
                       rdfs:domain km4c:StreetNumber;
                       rdfs:range km4c:Entry.
km4c:hasFirstElem a owl:ObjectProperty;
                  rdfs:comment "the first element concerned the maneuver";
                  rdfs:domain km4c:Maneuver;
                  rdfs:range km4c:RoadElement.
km4c:hasFirstSection a owl:ObjectProperty;
                     rdfs:comment "defines which is the departure section of a route";
                     rdfs:domain km4c:Route;
                     rdfs:range km4c:RouteSection.
km4c:hasFirstStop a owl:ObjectProperty;
                  rdfs:comment "defines which is the departure stop of a route";
                  rdfs:domain km4c:Route;
                  rdfs:range km4c:BusStop.
km4c:hasForecast a owl:ObjectProperty;
                 rdfs:comment "each forecast refers to a specific bus stop";
                 rdfs:domain km4c:BusStop;
                 rdfs:range km4c:BusStopForecast.
km4c:hasGeometry a owl:ObjectProperty;
                 rdfs:comment "some services and all railway elements have a specific geometry like polygons or linestrings";
                 rdfs:domain [owl:unionOf (km4c:RailwayElement
                                           km4c:Service) ; 
                              a owl:Class];
                 rdfs:range geosparql:Geometry.
km4c:hasInternalAccess a owl:ObjectProperty;
                       rdfs:comment "it corresponds to the door of the building";
                       rdfs:domain km4c:StreetNumber;
                       rdfs:range km4c:Entry.
km4c:hasLastStop a owl:ObjectProperty;
                 rdfs:comment "defines which is the last stop of a route";
                 rdfs:domain km4c:Route;
                 rdfs:range km4c:BusStop.
km4c:hasLastStopTime a owl:ObjectProperty;
                     rdfs:comment "the arrival time at last bus stops";
                     rdfs:domain km4c:AVMRecord;
                     rdfs:range time:Instant;
                     owl:inverseOf km4c:instantAVM.
km4c:hasManeuver a owl:ObjectProperty;
                 rdfs:comment "an entry rule can be connected to a specific maneuver";
                 rdfs:domain km4c:EntryRule;
                 rdfs:range km4c:Maneuver.
km4c:hasMunicipality a owl:ObjectProperty;
                     rdfs:comment "a province is formed by more municipalities";
                     rdfs:domain km4c:Province;
                     rdfs:range km4c:Municipality.
km4c:hasObservation a owl:ObjectProperty;
                    rdfs:comment "each road sensor produce a report every XX minuts";
                    rdfs:domain km4c:SensorSite;
                    rdfs:range km4c:Observation.
km4c:hasPrediction a owl:ObjectProperty;
                   rdfs:comment "a report is made up of more predictions";
                   rdfs:domain km4c:WeatherReport;
                   rdfs:range km4c:WeatherPrediction.
km4c:hasProvince a owl:ObjectProperty;
                 rdfs:comment "in a region there are more than one province";
                 rdfs:domain km4c:Region;
                 rdfs:range km4c:Province;
                 owl:inverseOf km4c:isPartOfRegion.
km4c:hasRecord a owl:ObjectProperty;
               rdfs:comment "every 10 minutes a sensor sends a report";
               rdfs:domain km4c:CarParkSensor;
               rdfs:range km4c:SituationRecord.
km4c:hasRegularService a owl:ObjectProperty;
                       rdfs:comment "regular services can be connected to transverse services";
                       rdfs:domain km4c:TransverseService;
                       rdfs:range km4c:RegularService.
km4c:hasResolution a owl:ObjectProperty;
                   rdfs:comment "to connect a resolution to the municipality that have approved it";
                   rdfs:domain km4c:Pa;
                   rdfs:range km4c:Resolution.
km4c:hasRoadElement a owl:ObjectProperty;
                    rdfs:comment "more road elements form an administrative road";
                    rdfs:domain km4c:AdministrativeRoad;
                    rdfs:range km4c:RoadElement.
km4c:hasRoute a owl:ObjectProperty;
              rdfs:comment "each route refers to a line";
              rdfs:domain km4c:PublicTransportLine;
              rdfs:range km4c:Route.
km4c:hasRouteLink a owl:ObjectProperty;
                  rdfs:comment "";
                  rdfs:domain km4c:Route;
                  rdfs:range km4c:RouteLink.
km4c:hasRule a owl:ObjectProperty;
             rdfs:comment "some road elements subject to rules of access";
             rdfs:domain km4c:RoadElement;
             rdfs:range km4c:EntryRule;
             owl:inverseOf km4c:accessToElement.
km4c:hasSecondElem a owl:ObjectProperty;
                   rdfs:comment "the second element concerned the maneuver";
                   rdfs:domain km4c:Maneuver;
                   rdfs:range km4c:RoadElement.
km4c:hasSection a owl:ObjectProperty;
                rdfs:comment "defines all the other section of a route";
                rdfs:domain km4c:Route;
                rdfs:range km4c:RouteSection.
km4c:hasSegment a owl:ObjectProperty;
                rdfs:comment "each road element can be see as a collection of consecutive road link";
                rdfs:domain km4c:RoadElement;
                rdfs:range km4c:RoadLink.
km4c:hasStatistic a owl:ObjectProperty;
                  rdfs:comment "to connect a statistic to the referred municipality";
                  rdfs:domain [owl:unionOf (km4c:Pa
                                            km4c:Road) ; 
                               a owl:Class];
                  rdfs:range km4c:StatisticalData.
km4c:hasStreetNumber a owl:ObjectProperty;
                     rdfs:comment "each road has street numbers";
                     rdfs:domain km4c:Road;
                     rdfs:range km4c:StreetNumber.
km4c:hasThirdElem a owl:ObjectProperty;
                  rdfs:comment "the third element concerned the maneuver";
                  rdfs:domain km4c:Maneuver;
                  rdfs:range km4c:RoadElement.
km4c:hasTransferService a owl:ObjectProperty;
                        rdfs:comment "to connect each train station tothe correspondant service";
                        rdfs:domain km4c:TrainStation;
                        rdfs:range km4c:TransferServiceAndRenting.
km4c:hasTransverseService a owl:ObjectProperty;
                          rdfs:comment "regular services can be connected to transverse services";
                          rdfs:domain km4c:RegularService;
                          rdfs:range km4c:TransverseService.
km4c:hasWeatherReport a owl:ObjectProperty;
                      rdfs:comment "each weather forecasts is connected to a municipality";
                      rdfs:domain km4c:Municipality;
                      rdfs:range km4c:WeatherReport;
                      owl:inverseOf km4c:refersToMunicipality.
km4c:heightHour a owl:DatatypeProperty;
                rdfs:domain km4c:WeatherReport;
                rdfs:range xsd:string.
km4c:hour a owl:DatatypeProperty;
          rdfs:domain km4c:WeatherPrediction;
          rdfs:range xsd:string.
km4c:houseNumber a owl:DatatypeProperty;
                 rdfs:domain [owl:unionOf (km4c:Event
                                           km4c:Service) ; 
                              a owl:Class];
                 rdfs:range xsd:string.
km4c:humidity a owl:DatatypeProperty;
              rdfs:domain km4c:WeatherPrediction;
              rdfs:range xsd:string.
km4c:inMunicipalityOf a owl:ObjectProperty;
                      rdfs:comment "municipality to which the road belongs";
                      rdfs:domain km4c:Road;
                      rdfs:range km4c:Pa.
km4c:includeForecast a owl:ObjectProperty;
                     rdfs:comment "each AVMrecord includes more forecasts";
                     rdfs:domain km4c:AVMRecord;
                     rdfs:range km4c:BusStopForecast.
km4c:instantAVM a owl:ObjectProperty;
                rdfs:comment "the arrival time at last bus stops";
                rdfs:domain time:Instant;
                rdfs:range km4c:AVMRecord.
km4c:instantBObserv a owl:ObjectProperty;
                    rdfs:comment "ime and date of each Beacon observation";
                    rdfs:domain time:Instant;
                    rdfs:range km4c:BeaconObservation;
                    owl:inverseOf km4c:measuredDate.
km4c:instantForecast a owl:ObjectProperty;
                     rdfs:comment "the expected time at the next bus stops";
                     rdfs:domain time:Instant;
                     rdfs:range km4c:BusStopForecast.
km4c:instantObserv a owl:ObjectProperty;
                   rdfs:comment "the time of one observation";
                   rdfs:domain time:Instant;
                   rdfs:range km4c:Observation.
km4c:instantParking a owl:ObjectProperty;
                    rdfs:comment "the generation time of one situation record";
                    rdfs:domain time:Instant;
                    rdfs:range km4c:SituationRecord.
km4c:instantWReport a owl:ObjectProperty;
                    rdfs:comment "the generation time of a new weather report";
                    rdfs:domain time:Instant;
                    rdfs:range km4c:WeatherReport.
km4c:isComposedByElement a owl:ObjectProperty;
                         rdfs:comment "a railway Section is composed by more railway element";
                         rdfs:domain km4c:RailwaySection;
                         rdfs:range km4c:RailwayElement.
km4c:isInElement a owl:ObjectProperty;
                 rdfs:comment "each milestone need to refers to a road";
                 rdfs:domain km4c:Milestone;
                 rdfs:range km4c:RoadElement.
km4c:isInMunicipality a owl:ObjectProperty;
                      rdfs:comment "A bus stop can be connected to the municipality to which belong";
                      rdfs:domain km4c:BusStop;
                      rdfs:range km4c:Pa.
km4c:isInRoad a owl:ObjectProperty;
              rdfs:comment " service and train station can be connected to the referred Road";
              rdfs:domain [owl:unionOf (km4c:Service
                                        km4c:TrainStation) ; 
                           a owl:Class];
              rdfs:range km4c:Road.
km4c:isPartOfLine a owl:ObjectProperty;
                  rdfs:comment "a railway line is composed by more railway element";
                  rdfs:domain km4c:RailwayElement;
                  rdfs:range km4c:RailwayLine;
                  owl:inverseOf km4c:hasElement.
km4c:isPartOfLot a owl:ObjectProperty;
                 rdfs:comment "bus stops and bus lines are part of a lot";
                 rdfs:domain [owl:unionOf (km4c:BusStop
                                           km4c:PublicTransportLine) ; 
                              a owl:Class];
                 rdfs:range km4c:Lot.
km4c:isPartOfProvince a owl:ObjectProperty;
