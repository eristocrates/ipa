                 rdfs:domain km4c:Service;
                 rdfs:range xsd:string.
km4c:formingAdminRoad a owl:ObjectProperty;
                      rdfs:comment "more road elements form an administrative road";
                      rdfs:domain km4c:RoadElement;
                      rdfs:range km4c:AdministrativeRoad;
                      owl:inverseOf km4c:hasRoadElement.
km4c:formsTable a owl:ObjectProperty;
                rdfs:comment "more road sensors form a sensor Table";
                rdfs:domain km4c:SensorSite;
                rdfs:range km4c:SensorSiteTable.
km4c:free a owl:DatatypeProperty;
          rdfs:domain km4c:SituationRecord;
