                                 rdfs:domain lom:MetaMetadataContribution;
                                 rdfs:range xsd:string.
lom:metaMetadataIdentifier a owl:ObjectProperty;
                           rdfs:comment "A globally unique label that identifies this metadata record. IEEE LOM element 3.1.";
                           rdfs:domain lom:LearningObject;
