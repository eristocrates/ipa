ccrel:license a owl:AnnotationProperty.
<http://purl.oclc.org/NET/ssnx/meteo/aws> dc11:creator "Laurent Lefort (CSIRO, Australia and W3C Semantic Sensor Network Incubator Group)";
                                          dc11:description "Meteorological sensor ontology (sensor types)";
                                          dc11:identifier "http://purl.oclc.org/NET/ssnx/meteo/aws";
                                          dc11:rights "Copyright 2010 - 2011 CSIRO. All rights reserved.";
                                          dc11:title "Ontology for Meteorological sensors";
                                          dcterms:created "2010-09-21";
                                          dcterms:modified "2011-06-20";
                                          a owl:Ontology;
                                          rdfs:comment """This ontology is is part of the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG). It is published here in order to generalize the potential usage and the alignment with other standardization efforts of the SSN ontology.

For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/ .

DISCLAIMER: This ontology includes information that has been automatically generated from data sourced from third parties but has not been fully manually checked. It is provided AS-IS, for information only, with no warranties or guarantees and confers no rights.""",
                                                       "Please report any errors to the Semantic Sensor Network Incubator Activity via the public W3C list public-xg-ssn@w3.org";
                                          rdfs:seeAlso "http://www.w3.org/2005/Incubator/ssn/";
                                          owl:imports <http://purl.oclc.org/NET/ssnx/qu/qu>,
                                                      <http://purl.oclc.org/NET/ssnx/ssn>,
                                                      <http://purl.oclc.org/NET/ssnx/cf/cf-property>,
                                                      <http://purl.oclc.org/NET/ssnx/qu/qu-rec20>,
                                                      <http://purl.oclc.org/NET/ssnx/cf/cf-feature>.
aws:Albedometer dc11:source "skos:closeMatch albedometer [GAMP 2.3.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                a owl:Class;
                rdfs:comment "pair of upward and downward facing solarimeters";
                rdfs:label "albedometer";
                rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                 owl:onProperty ssnx:observes ; 
                                 a owl:Restriction],
                                [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                 owl:onProperty ssnx:observes ; 
                                 a owl:Restriction],
                                aws:RadiationSensor.
aws:AneroidDisplacementTransducer dc11:source "skos:closeMatch aneroid displacement transducer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf";
                                  a owl:Class;
                                  rdfs:comment "The aneroid displacement transducer contains a sensor with electrical properties (resistance or capacitance) that changes as the atmospheric pressure changes.";
                                  rdfs:label "aneroid displacement transducer";
                                  rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   owl:onProperty ssnx:observes ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   owl:onProperty ssnx:observes ; 
                                                   a owl:Restriction],
                                                  aws:AtmosphericPressureSensor.
aws:AtmometerOrSmallSurfaceEvaporimeter a owl:Class;
                                        rdfs:label "Atmometer or small surface evaporimeter";
                                        rdfs:subClassOf aws:ScreenedAndOpenPanEvaporimeter.
aws:AtmosphericPressureSensor a owl:Class;
                              rdfs:label "Atmospheric pressure";
                              rdfs:subClassOf ssnx:SensingDevice.
aws:AutomaticSunshineRecorder dc11:source "skos:closeMatch Automatic sunshine recorder [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                              a owl:Class;
                              rdfs:comment "time during which direct radiation (on a plane perpendicular to the Sun’s beam) is larger than 120 Wm-2.";
                              rdfs:label "Automatic sunshine recorder";
                              rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              aws:RadiationSensor.
aws:BimetallicActinograph a owl:Class;
                          rdfs:comment "total solar irradiance on a horizontal surface";
                          rdfs:label "Bimetallic actinograph";
                          rdfs:subClassOf aws:Pyranometer.
aws:CampbellStokesSunshineMeter dc11:source "skos:closeMatch Campbell-Stokes sunshine meter [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                                a owl:Class;
                                rdfs:comment "World standard abolished in 1989";
                                rdfs:label "Campbell-Stokes sunshine meter";
                                rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                                 owl:onProperty ssnx:observes ; 
                                                 a owl:Restriction],
                                                [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                                 owl:onProperty ssnx:observes ; 
                                                 a owl:Restriction],
                                                aws:RadiationSensor.
aws:CapacitanceSensor dc11:source "skos:closeMatch capacitance sensor [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                      a owl:Class;
                      rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.";
                      rdfs:label "capacitance sensor";
                      rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction],
                                      aws:HumiditySensor,
                                      [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       owl:onProperty ssnx:observes ; 
                                       a owl:Restriction].
aws:CapacitiveAluminumOxide a owl:Class;
                            rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.";
                            rdfs:label "Capacitive - aluminum oxide";
                            rdfs:subClassOf aws:CapacitanceSensor.
aws:CapacitiveAneroid a owl:Class;
                      rdfs:comment "The aneroid displacement transducer contains a sensor with electrical properties (resistance or capacitance) that changes as the atmospheric pressure changes.";
                      rdfs:label "Capacitive aneroid";
                      rdfs:subClassOf aws:AneroidDisplacementTransducer.
aws:CapacitiveBead dc11:source "skos:closeMatch Capacitive bead [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                   a owl:Class;
                   rdfs:label "Capacitive bead";
                   rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   aws:TemperatureSensor,
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                    owl:onProperty ssnx:observes ; 
                                    a owl:Restriction].
aws:CapacitiveThinFilmPolymer a owl:Class;
                              rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.";
                              rdfs:label "Capacitive - thin film polymer";
                              rdfs:subClassOf aws:CapacitanceSensor.
aws:ChilledMirrorHygrometer dc11:source "chilled-mirror hygrometer [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                            a owl:Class;
                            rdfs:comment "condensation is detected on the surface of a small polished metal reflecting surface (a mirror), using optical means. The temperature at which condensation is formed is the dew point.";
                            rdfs:label "chilled-mirror hygrometer";
                            rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction],
                                            aws:HumiditySensor,
                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                             owl:onProperty ssnx:observes ; 
                                             a owl:Restriction].
aws:ChilledMirrorSystem dc11:source "skos:closeMatch Chilled mirror system [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                        a owl:Class;
                        rdfs:label "Chilled mirror system";
                        rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                         owl:onProperty ssnx:observes ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                         owl:onProperty ssnx:observes ; 
                                         a owl:Restriction],
                                        aws:TemperatureSensor.
aws:CupAnemometer dc11:source "skos:closeMatch Cup anemometer [GAMP 2.4.1.5] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                  a owl:Class;
                  rdfs:comment "the angular velocity of the cup is directly proportional to the component of the wind speed parallel to the axis of rotation.";
                  rdfs:label "Cup anemometer";
                  rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ; 
                                   owl:onProperty ssnx:observes ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ; 
                                   owl:onProperty ssnx:observes ; 
                                   a owl:Restriction],
                                  aws:WindSensor.
aws:CylindricalResonatorBarometer dc11:source "skos:closeMatch cylindrical resonator barometer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf";
                                  a owl:Class;
                                  rdfs:comment "A cylindrical resonator barometer (or vibrating cylinder air-pressure transducer) is designed to measure absolute air pressure using the vibrating element principle, providing a frequency output from which pressure is computed.";
                                  rdfs:label "cylindrical resonator barometer";
                                  rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   owl:onProperty ssnx:observes ; 
                                                   a owl:Restriction],
                                                  [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   owl:onProperty ssnx:observes ; 
                                                   a owl:Restriction],
                                                  aws:AtmosphericPressureSensor.
aws:DewCell dc11:source "dew cell [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
            a owl:Class;
            rdfs:comment "A dew cell heats a salt solution until its equilibrium vapour pressure equals to the ambient vapour pressure, and maintains this equilibrium The temperature when this occurs is measured and it provides a measure of the ambient vapour pressure";
            rdfs:label "dew cell";
            rdfs:subClassOf aws:HumiditySensor,
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                             owl:onProperty ssnx:observes ; 
                             a owl:Restriction].
aws:DewcelSystem dc11:source "skos:closeMatch Dewcel system [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                 a owl:Class;
                 rdfs:label "Dewcel system";
                 rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 aws:TemperatureSensor.
aws:DifferentialExpansionThermometer dc11:source "skos:closeMatch Differential expansion thermometer [GAMP 2.4.1.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                                     a owl:Class;
                                     rdfs:label "differential expansion thermometer";
                                     rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     aws:TemperatureSensor,
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction],
                                                     [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                                      owl:onProperty ssnx:observes ; 
                                                      a owl:Restriction].
aws:DigitalPiezoResistiveBarometer dc11:source "skos:closeMatch digital piezo-resistive barometer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf";
                                   a owl:Class;
                                   rdfs:label "digital piezo-resistive barometer";
                                   rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                    owl:onProperty ssnx:observes ; 
                                                    a owl:Restriction],
                                                   [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                    owl:onProperty ssnx:observes ; 
                                                    a owl:Restriction],
                                                   aws:AtmosphericPressureSensor.
aws:DirmhirmSaubererPyranometer a owl:Class;
                                rdfs:comment "total solar irradiance on a horizontal surface";
                                rdfs:label "Dirmhirm-Sauberer pyranometer";
                                rdfs:subClassOf aws:Pyranometer.
aws:DropCounters dc11:source "skos:closeMatch Drop counters [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                 a owl:Class;
                 rdfs:comment "Counting the number of uniform droplets corresponding to a fixed volume of water";
                 rdfs:label "Drop counters";
                 rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#MassPerTimePerArea> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#MassPerTimePerArea> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Distance> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ; 
                                  owl:onProperty ssnx:observes ; 
                                  a owl:Restriction],
                                 aws:PrecipitationSensor.
aws:ElectricSensorWhichExploitsTheConductivityVariationAsAFunctionOfWetness dc11:source "skos:closeMatch electric sensor, which exploits the conductivity variation as a function of wetness [GAMP 2.4.1.6.3] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                                                                            a owl:Class;
                                                                            rdfs:label "electric sensor, which exploits the conductivity variation as a function of wetness";
                                                                            rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                                                                             owl:onProperty ssnx:observes ; 
                                                                                             a owl:Restriction],
                                                                                            [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                                                                             owl:onProperty ssnx:observes ; 
                                                                                             a owl:Restriction],
                                                                                            aws:HumiditySensor.
aws:ElectricalResistanceBlock dc11:source "skos:closeMatch Electrical resistance block [GAMP 2.4.1.6.2] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                              a owl:Class;
                              rdfs:label "Electrical resistance block";
                              rdfs:subClassOf [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              aws:HumiditySensor,
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#SurfaceDensity> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                               owl:onProperty ssnx:observes ; 
                                               a owl:Restriction],
                                              [owl:someValuesFrom <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
