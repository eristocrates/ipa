<http://purl.oclc.org/NET/ssnx/meteo/aws> <http://purl.org/dc/elements/1.1/creator> "Laurent Lefort (CSIRO, Australia and W3C Semantic Sensor Network Incubator Group)";
                                          <http://purl.org/dc/elements/1.1/description> "Meteorological sensor ontology (sensor types)";
                                          <http://purl.org/dc/elements/1.1/identifier> "http://purl.oclc.org/NET/ssnx/meteo/aws";
