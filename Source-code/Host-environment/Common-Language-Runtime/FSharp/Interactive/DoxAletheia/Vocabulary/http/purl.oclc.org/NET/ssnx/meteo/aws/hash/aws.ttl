                                          <http://purl.org/dc/terms/modified> "2011-06-20";
                                          a <http://www.w3.org/2002/07/owl#Ontology>;
                                          rdfs:comment """This ontology is is part of the Agriculture Meteorology example showcasing the ontology developed by the W3C Semantic Sensor Networks incubator group (SSN-XG). It is published here in order to generalize the potential usage and the alignment with other standardization efforts of the SSN ontology.

For more information on the group's activities see: http://www.w3.org/2005/Incubator/ssn/ .

DISCLAIMER: This ontology includes information that has been automatically generated from data sourced from third parties but has not been fully manually checked. It is provided AS-IS, for information only, with no warranties or guarantees and confers no rights.""",
                                                       "Please report any errors to the Semantic Sensor Network Incubator Activity via the public W3C list public-xg-ssn@w3.org";
                                          rdfs:seeAlso "http://www.w3.org/2005/Incubator/ssn/";
                                          <http://www.w3.org/2002/07/owl#imports> <http://purl.oclc.org/NET/ssnx/qu/qu>,
                                                                                  <http://purl.oclc.org/NET/ssnx/ssn>,
                                                                                  <http://purl.oclc.org/NET/ssnx/cf/cf-property>,
                                                                                  <http://purl.oclc.org/NET/ssnx/qu/qu-rec20>,
                                                                                  <http://purl.oclc.org/NET/ssnx/cf/cf-feature>.
aws:Albedometer <http://purl.org/dc/elements/1.1/source> "skos:closeMatch albedometer [GAMP 2.3.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "pair of upward and downward facing solarimeters";
                rdfs:label "albedometer";
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                aws:RadiationSensor.
aws:AneroidDisplacementTransducer <http://purl.org/dc/elements/1.1/source> "skos:closeMatch aneroid displacement transducer [CIMO Guide 3.3.1] http://www.wmo.int/pages/prog/www/IMOP/publications/CIMO-Guide/CIMO%20Guide%207th%20Edition,%202008/Part%20I/Chapter%203.pdf";
                                  a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "The aneroid displacement transducer contains a sensor with electrical properties (resistance or capacitance) that changes as the atmospheric pressure changes.";
                                  rdfs:label "aneroid displacement transducer";
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#StressOrPressure> ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  aws:AtmosphericPressureSensor.
aws:AtmometerOrSmallSurfaceEvaporimeter a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:label "Atmometer or small surface evaporimeter";
                                        rdfs:subClassOf aws:ScreenedAndOpenPanEvaporimeter.
aws:AtmosphericPressureSensor a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:label "Atmospheric pressure";
                              rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/ssn#SensingDevice>.
aws:AutomaticSunshineRecorder <http://purl.org/dc/elements/1.1/source> "skos:closeMatch Automatic sunshine recorder [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                              a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "time during which direct radiation (on a plane perpendicular to the Sun’s beam) is larger than 120 Wm-2.";
                              rdfs:label "Automatic sunshine recorder";
                              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                               a <http://www.w3.org/2002/07/owl#Restriction>],
                                              aws:RadiationSensor.
aws:BimetallicActinograph a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "total solar irradiance on a horizontal surface";
                          rdfs:label "Bimetallic actinograph";
                          rdfs:subClassOf aws:Pyranometer.
aws:CampbellStokesSunshineMeter <http://purl.org/dc/elements/1.1/source> "skos:closeMatch Campbell-Stokes sunshine meter [GAMP 2.4.1.1] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                                a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "World standard abolished in 1989";
                                rdfs:label "Campbell-Stokes sunshine meter";
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Duration> ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                aws:RadiationSensor.
aws:CapacitanceSensor <http://purl.org/dc/elements/1.1/source> "skos:closeMatch capacitance sensor [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.";
                      rdfs:label "capacitance sensor";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
