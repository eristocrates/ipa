                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        aws:TemperatureSensor.
aws:CupAnemometer <http://purl.org/dc/elements/1.1/source> "skos:closeMatch Cup anemometer [GAMP 2.4.1.5] http://www.wmo.int/pages/prog/wcp/agm/gamp/gamp_en.html";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "the angular velocity of the cup is directly proportional to the component of the wind speed parallel to the axis of rotation.";
                  rdfs:label "Cup anemometer";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#VelocityOrSpeed> ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
