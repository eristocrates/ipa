aws:ChilledMirrorSystem <http://purl.org/dc/elements/1.1/source> "skos:closeMatch Chilled mirror system [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
                        a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:label "Chilled mirror system";
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Temperature> ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
