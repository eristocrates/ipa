                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      aws:HumiditySensor,
                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless> ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> <http://purl.oclc.org/NET/ssnx/ssn#observes> ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>].
aws:CapacitiveAluminumOxide a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "certain materials interact with water vapour and undergo a change in capacitance, in relation to ambient humidity.";
                            rdfs:label "Capacitive - aluminum oxide";
                            rdfs:subClassOf aws:CapacitanceSensor.
aws:CapacitiveAneroid a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The aneroid displacement transducer contains a sensor with electrical properties (resistance or capacitance) that changes as the atmospheric pressure changes.";
                      rdfs:label "Capacitive aneroid";
                      rdfs:subClassOf aws:AneroidDisplacementTransducer.
aws:CapacitiveBead <http://purl.org/dc/elements/1.1/source> "skos:closeMatch Capacitive bead [ET-AWS] http://www.hydrometeoindustry.org/Meetings2010/ET-AWS-6/Doc8[1]-AWS-MetadataCatalogues.pdf";
