@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ccr: <http://cookingbigdata.com/linkeddata/ccregions#>.

ccr: <http://purl.org/dc/terms/created> "2018-03-06"^^xsd:date;
     <http://purl.org/dc/terms/creator> ccr:manuelparra;
     <http://purl.org/dc/terms/description> "Ontology for the definition of regions and zones of availability on CloudComputing platforms and services. This ontology allows to define model of regions used in large cloud computing providers such as Amazon, Azure, etc."@en;
     <http://purl.org/dc/terms/issued> "2018-04-20"^^xsd:date;
     <http://purl.org/dc/terms/modified> "2018-04-03"^^xsd:date;
     <http://purl.org/dc/terms/publisher> ccr:cookingbigdata;
     <http://purl.org/dc/terms/rights> "Copyright © 2018 Manuel Parra-Royón";
     <http://purl.org/dc/terms/title> "Vocabulary for Regions and Zones on Cloud Computing"@en;
     a <http://www.w3.org/2002/07/owl#Ontology>;
     rdfs:label "Cloud Computing regions and availability zones"@en;
     <http://www.w3.org/2002/07/owl#versionInfo> 1.0.
ccr:AvailabilityZone <http://purl.org/dc/terms/description> "Each region has multiple isolated locations known as Availability Zones."@en;
                     a <http://www.w3.org/2002/07/owl#Class>,
                       rdfs:Class;
                     rdfs:comment "Availability Zone"@en;
                     rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                     rdfs:label "Availability Zone"@en.
ccr:GeographicalZone <http://purl.org/dc/terms/description> "Each Region is hosted in a Geographical Area or Division."@en;
                     a <http://www.w3.org/2002/07/owl#Class>,
                       rdfs:Class;
                     rdfs:comment "Geographical Zone"@en;
                     rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                     rdfs:label "Geographical Zone"@en.
ccr:Location <http://purl.org/dc/terms/description> "Physical location"@en;
             a <http://www.w3.org/2002/07/owl#Class>,
               rdfs:Class;
             rdfs:comment "Location"@en;
             rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
             rdfs:label "Location"@en;
             rdfs:subClassOf ccr:Region.
ccr:Region <http://purl.org/dc/terms/description> "A region is a physical location of a computer center where instances, servers, clusters, etc. are stored. A region is a separate geographic area"@en;
           a <http://www.w3.org/2002/07/owl#Class>,
             rdfs:Class;
           rdfs:comment "Region"@en;
           rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
           rdfs:label "Region"@en.
ccr:availabilityzone_name a rdf:Property;
                          rdfs:comment "Name of the Availability Zone"@en;
                          rdfs:domain ccr:AvailabilityZone;
                          rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                          rdfs:label "AZ Name"@en;
                          rdfs:range xsd:string.
ccr:availabilityzone_status a rdf:Property;
                            rdfs:comment "Status of the Availability Zone"@en;
                            rdfs:domain ccr:AvailabilityZone;
                            rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                            rdfs:label "AZ Status"@en;
                            rdfs:range xsd:boolean.
ccr:cookingbigdata a <http://xmlns.com/foaf/0.1/Organization>;
                   rdfs:seeAlso <http://cookingbigdata.com/about>;
                   <http://xmlns.com/foaf/0.1/homepage> <http://cookingbigdata.com/>;
                   <http://xmlns.com/foaf/0.1/name> "CookingBigData".
ccr:geographical_zone a rdf:Property;
                      rdfs:comment "Administrative Geographical area."@en;
                      rdfs:domain ccr:GeographicalZone;
                      rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                      rdfs:label "Geo Name"@en;
                      rdfs:range <http://schema.org/AdministrativeArea>.
ccr:hasAvailabilityZone a rdf:Property;
                        rdfs:comment "Each Zone has almost one Availability Zone"@en;
                        rdfs:domain ccr:Region;
                        rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                        rdfs:label "has Availability Zone"@en;
                        rdfs:range ccr:AvailabilityZone.
ccr:hasGeographicalZone a rdf:Property;
                        rdfs:comment "Each Region is hosted in a Geographical Area or Division"@en;
                        rdfs:domain ccr:Region;
                        rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                        rdfs:label "has geographical zone"@en;
                        rdfs:range ccr:GeographicalZone.
ccr:manuelparra a <http://xmlns.com/foaf/0.1/Person>;
                rdfs:seeAlso <https://twitter.com/manugrapevine>;
                <http://xmlns.com/foaf/0.1/homepage> <https://twitter.com/manugrapevine>;
                <http://xmlns.com/foaf/0.1/mbox> "manuparra@gmail.com";
                <http://xmlns.com/foaf/0.1/name> "Manuel Parra-Royon".
ccr:region_code a rdf:Property;
                rdfs:comment "Short Code of the region."@en;
                rdfs:domain ccr:Region;
                rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                rdfs:label "Region code"@en;
                rdfs:range xsd:string.
ccr:region_compilance a rdf:Property;
                      rdfs:comment "Compilance with geographical boundaries."@en;
                      rdfs:domain ccr:Region;
                      rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                      rdfs:label "Geo Compilance"@en;
                      rdfs:range xsd:string.
ccr:region_dataresidency a rdf:Property;
                         rdfs:comment "Region Data residency / Sovereignty Location."@en;
                         rdfs:domain ccr:Region;
                         rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                         rdfs:label "Sovereignty Location"@en;
                         rdfs:range <http://schema.org/AdministrativeArea>.
ccr:region_endpoint a rdf:Property;
                    rdfs:comment "Region Endpoint is the URI of the main resource at the region."@en;
                    rdfs:domain ccr:Region;
                    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                    rdfs:label "Region Endpoint"@en;
                    rdfs:range <http://schema.org/EntryPoint>.
ccr:region_location a rdf:Property;
                    rdfs:comment "Physical Location for a region."@en;
                    rdfs:domain ccr:Location;
                    rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                    rdfs:label "Region Location"@en;
                    rdfs:range <http://schema.org/Place>.
ccr:region_name a rdf:Property;
                rdfs:comment "Name of the region."@en;
                rdfs:domain ccr:Region;
                rdfs:isDefinedBy <http://cookingbigdata.com/linkeddata/ccregions>;
                rdfs:label "Region name"@en;
                rdfs:range xsd:string.
