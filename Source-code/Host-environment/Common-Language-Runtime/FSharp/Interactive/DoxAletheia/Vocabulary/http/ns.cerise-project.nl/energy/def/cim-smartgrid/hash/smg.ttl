                                    [owl:onProperty smg:TelephoneNumber.countryCode ; 
                                     owl:allValuesFrom xsd:string ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:TelephoneNumber.areaCode ; 
                                     owl:allValuesFrom xsd:string ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:TelephoneNumber.localNumber ; 
                                     owl:cardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:TelephoneNumber.localNumber ; 
                                     owl:allValuesFrom xsd:string ; 
                                     a owl:Restriction].
smg:TelephoneNumber.areaCode <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                             a owl:DatatypeProperty;
                             rdfs:comment "Area or region code.";
                             rdfs:label "areaCode".
smg:TelephoneNumber.cityCode <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
