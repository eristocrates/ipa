                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      smg:IdentifiedObject,
                                      [<http://www.w3.org/2002/07/owl#onProperty> smg:EndDeviceFunction.EndDevice ; 
                                       <http://www.w3.org/2002/07/owl#allValuesFrom> smg:EndDevice ; 
