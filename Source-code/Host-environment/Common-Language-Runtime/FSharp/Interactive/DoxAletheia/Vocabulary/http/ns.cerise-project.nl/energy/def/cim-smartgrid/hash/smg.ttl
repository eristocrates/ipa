smg:UsagePoint a owl:Class;
               rdfs:comment "Logical or physical point in the network to which readings or events may be attributed. Used at the place where a physical or virtual meter may be located; however, it is not required that a meter be present.";
               rdfs:isDefinedBy smg:Package_Metering;
               rdfs:label "UsagePoint";
               rdfs:subClassOf [owl:onProperty smg:UsagePoint.CustomerAgreement ; 
                                owl:allValuesFrom smg:CustomerAgreement ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.CustomerAgreement ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isSdp ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               smg:IdentifiedObject,
                               [owl:onProperty smg:UsagePoint.CustomerAgreement ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isVirtual ; 
                                owl:allValuesFrom xsd:boolean ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:AmiBillingReadyKind ; 
                                owl:onProperty smg:UsagePoint.amiBillingReady ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.MeterReadings ; 
                                owl:minCardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isSdp ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:UsagePointLocation ; 
                                owl:onProperty smg:UsagePoint.UsagePointLocation ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.amiBillingReady ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.UsagePointLocation ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.CustomerAgreement ; 
                                owl:allValuesFrom smg:CustomerAgreement ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isVirtual ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceCategory ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:UsagePointLocation ; 
                                owl:onProperty smg:UsagePoint.UsagePointLocation ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.MeterReadings ; 
                                owl:minCardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:ServiceCategory ; 
                                owl:onProperty smg:UsagePoint.ServiceCategory ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceCategory ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceSupplier ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceSupplier ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.amiBillingReady ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.MeterReadings ; 
                                owl:allValuesFrom smg:MeterReading ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isSdp ; 
                                owl:allValuesFrom xsd:boolean ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:ServiceCategory ; 
                                owl:onProperty smg:UsagePoint.ServiceCategory ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isVirtual ; 
                                owl:allValuesFrom xsd:boolean ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.MeterReadings ; 
                                owl:allValuesFrom smg:MeterReading ; 
                                a owl:Restriction],
                               [owl:allValuesFrom smg:AmiBillingReadyKind ; 
                                owl:onProperty smg:UsagePoint.amiBillingReady ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceSupplier ; 
                                owl:allValuesFrom smg:ServiceSupplier ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isVirtual ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.ServiceSupplier ; 
                                owl:allValuesFrom smg:ServiceSupplier ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.UsagePointLocation ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:UsagePoint.isSdp ; 
                                owl:allValuesFrom xsd:boolean ; 
                                a owl:Restriction].
smg:UsagePoint.CustomerAgreement a owl:ObjectProperty;
                                 rdfs:comment "Customer agreement regulating this service delivery point.";
                                 rdfs:label "CustomerAgreement".
smg:UsagePoint.MeterReadings a owl:ObjectProperty;
                             rdfs:comment "All meter readings obtained from this usage point.";
                             rdfs:label "MeterReadings";
                             owl:inverseOf smg:MeterReading.UsagePoint.
smg:UsagePoint.ServiceCategory a owl:ObjectProperty;
                               rdfs:comment "Service category delivered by this usage point.";
                               rdfs:label "ServiceCategory".
smg:UsagePoint.ServiceSupplier a owl:ObjectProperty;
                               rdfs:comment "ServiceSupplier (Utility) utilising this usage point to deliver a service.";
                               rdfs:label "ServiceSupplier".
smg:UsagePoint.UsagePointLocation a owl:ObjectProperty;
                                  rdfs:comment "Location of this usage point.";
                                  rdfs:label "UsagePointLocation".
smg:UsagePoint.amiBillingReady <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                               a owl:ObjectProperty;
                               rdfs:comment "Tracks the lifecycle of the metering installation at a usage point with respect to readiness for billing via advanced metering infrastructure reads.";
                               rdfs:label "amiBillingReady".
smg:UsagePoint.isSdp <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                     a owl:DatatypeProperty;
                     rdfs:comment "If true, this usage point is a service delivery point, i.e., a usage point where the ownership of the service changes hands.";
                     rdfs:label "isSdp".
smg:UsagePoint.isVirtual <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                         a owl:DatatypeProperty;
                         rdfs:comment "If true, this usage point is virtual, i.e., no physical location exists in the network where a meter could be located to collect the meter readings. For example, one may define a virtual usage point to serve as an aggregation of usage for all of a companies premises distributed widely across the distribution territory. Otherwise, the usage point is physical, i.e., there is a logical point in the network where a meter could be located to collect meter readings.";
                         rdfs:label "isVirtual".
smg:UsagePointLocation a owl:Class;
                       rdfs:comment "Location of an individual usage point.";
                       rdfs:isDefinedBy smg:Package_Metering;
                       rdfs:label "UsagePointLocation";
                       rdfs:subClassOf smg:Location.
smg:global_package a <http://langdale.com.au/2005/UML#Package>;
                   rdfs:label "Global".
