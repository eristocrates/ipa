smg:MeterMultiplier.kind <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Kind of multiplier.";
                         rdfs:label "kind".
smg:MeterMultiplier.value <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
