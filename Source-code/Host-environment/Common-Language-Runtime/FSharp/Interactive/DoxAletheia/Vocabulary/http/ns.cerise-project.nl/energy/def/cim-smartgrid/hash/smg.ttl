smg:ElectronicAddress.web <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment "World wide web address.";
                          rdfs:label "web".
smg:EndDevice a owl:Class;
              rdfs:comment """Asset container that performs one or more end device functions. One type of end device is a meter which can perform metering, load management, connect/disconnect, accounting functions, etc. Some end devices, such as ones monitoring and controlling air conditioner, refrigerator, pool pumps may be connected to a meter. All end devices may have communication capability defined by the associated communication function(s). An end device may be owned by a consumer, a service provider, utility or otherwise.
There may be a related end device function that identifies a sensor or control point within a metering application or communications systems (e.g., water, gas, electricity).
Some devices may use an optical port that conforms to the ANSI C12.18 standard for communications.""";
              rdfs:isDefinedBy smg:Package_Metering;
              rdfs:label "EndDevice";
              rdfs:subClassOf [owl:onProperty smg:EndDevice.UsagePoint ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:allValuesFrom smg:EndDeviceFunction ; 
                               owl:onProperty smg:EndDevice.EndDeviceFunctions ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.EndDeviceFunctions ; 
                               owl:minCardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.installCode ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.isVirtual ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:allValuesFrom smg:UsagePoint ; 
                               owl:onProperty smg:EndDevice.UsagePoint ; 
                               a owl:Restriction],
                              [owl:allValuesFrom smg:EndDeviceFunction ; 
                               owl:onProperty smg:EndDevice.EndDeviceFunctions ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.EndDeviceFunctions ; 
                               owl:minCardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.installCode ; 
                               owl:allValuesFrom xsd:string ; 
                               a owl:Restriction],
                              [owl:allValuesFrom smg:UsagePoint ; 
                               owl:onProperty smg:EndDevice.UsagePoint ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.isVirtual ; 
                               owl:allValuesFrom xsd:boolean ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.isVirtual ; 
                               owl:allValuesFrom xsd:boolean ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.isVirtual ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.installCode ; 
                               owl:allValuesFrom xsd:string ; 
                               a owl:Restriction],
                              smg:IdentifiedObject,
                              [owl:onProperty smg:EndDevice.installCode ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction],
                              [owl:onProperty smg:EndDevice.UsagePoint ; 
                               owl:cardinality "1"^^xsd:int ; 
                               a owl:Restriction].
smg:EndDevice.EndDeviceFunctions a owl:ObjectProperty;
                                 rdfs:comment "All end device functions this end device performs.";
                                 rdfs:label "EndDeviceFunctions";
                                 owl:inverseOf smg:EndDeviceFunction.EndDevice.
smg:EndDevice.UsagePoint a owl:ObjectProperty;
                         rdfs:comment "Usage point to which this end device belongs.";
                         rdfs:label "UsagePoint".
smg:EndDevice.installCode <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment "Installation code.";
                          rdfs:label "installCode".
smg:EndDevice.isVirtual <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                        a owl:DatatypeProperty;
                        rdfs:comment "If true, there is no physical device. As an example, a virtual meter can be defined to aggregate the consumption for two or more physical meters. Otherwise, this is a physical hardware device.";
                        rdfs:label "isVirtual".
smg:EndDeviceFunction a owl:Class;
                      rdfs:comment "Function performed by an end device such as a meter, communication equipment, controllers, etc.";
                      rdfs:isDefinedBy smg:Package_Metering;
                      rdfs:label "EndDeviceFunction";
                      rdfs:subClassOf [owl:onProperty smg:EndDeviceFunction.EndDevice ; 
                                       owl:allValuesFrom smg:EndDevice ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:EndDeviceFunction.EndDevice ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      smg:IdentifiedObject,
                                      [owl:onProperty smg:EndDeviceFunction.EndDevice ; 
                                       owl:allValuesFrom smg:EndDevice ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:EndDeviceFunction.EndDevice ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction].
smg:EndDeviceFunction.EndDevice a owl:ObjectProperty;
                                rdfs:comment "End device that performs this function.";
                                rdfs:label "EndDevice";
                                owl:inverseOf smg:EndDevice.EndDeviceFunctions.
smg:EndDeviceFunctionKind <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#enumeration>;
                          a owl:Class;
                          rdfs:comment "Kind of end device function.";
                          rdfs:isDefinedBy smg:Package_Metering;
                          rdfs:label "EndDeviceFunctionKind".
smg:EndDeviceFunctionKind.autonomousDst a smg:EndDeviceFunctionKind;
                                        rdfs:comment "Autonomous application of daylight savings time (DST).";
                                        rdfs:label "autonomousDst".
smg:EndDeviceFunctionKind.demandResponse a smg:EndDeviceFunctionKind;
                                         rdfs:comment "Demand response functions.";
                                         rdfs:label "demandResponse".
smg:EndDeviceFunctionKind.electricMetering a smg:EndDeviceFunctionKind;
                                           rdfs:comment "Electricity metering.";
                                           rdfs:label "electricMetering".
smg:EndDeviceFunctionKind.gasMetering a smg:EndDeviceFunctionKind;
                                      rdfs:comment "Gas metering.";
                                      rdfs:label "gasMetering".
smg:EndDeviceFunctionKind.metrology a smg:EndDeviceFunctionKind;
                                    rdfs:comment "Presentation of metered values to a user or another system (always a function of a meter, but might not be supported by a load control unit).";
                                    rdfs:label "metrology".
smg:EndDeviceFunctionKind.onRequestRead a smg:EndDeviceFunctionKind;
                                        rdfs:comment "On-request reads.";
                                        rdfs:label "onRequestRead".
smg:EndDeviceFunctionKind.outageHistory a smg:EndDeviceFunctionKind;
                                        rdfs:comment "Reporting historical power interruption data.";
                                        rdfs:label "outageHistory".
smg:EndDeviceFunctionKind.relaysProgramming a smg:EndDeviceFunctionKind;
                                            rdfs:comment "Support for one or more relays that may be programmable in the meter (and tied to TOU, time pulse, load control or other functions).";
                                            rdfs:label "relaysProgramming".
smg:EndDeviceFunctionKind.reverseFlow a smg:EndDeviceFunctionKind;
                                      rdfs:comment "Detection and monitoring of reverse flow.";
                                      rdfs:label "reverseFlow".
smg:EndDeviceFunctionKind.waterMetering a smg:EndDeviceFunctionKind;
                                        rdfs:comment "Water metering.";
                                        rdfs:label "waterMetering".
smg:IdentifiedObject a owl:Class;
                     rdfs:comment "This is a root class to provide common identification for all classes needing identification and naming attributes.";
                     rdfs:isDefinedBy smg:Package_Core;
                     rdfs:label "IdentifiedObject";
                     rdfs:subClassOf [owl:onProperty smg:IdentifiedObject.aliasName ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.mRID ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.description ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.description ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.name ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.description ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.mRID ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.name ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.name ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.mRID ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.aliasName ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.mRID ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.aliasName ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.aliasName ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.name ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:IdentifiedObject.description ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction].
smg:IdentifiedObject.aliasName <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                               a owl:DatatypeProperty;
                               rdfs:comment """The aliasName is free text human readable name of the object alternative to IdentifiedObject.name. It may be non unique and may not correlate to a naming hierarchy.
The attribute aliasName is retained because of backwards compatibility between CIM relases. It is however recommended to replace aliasName with the Name class as aliasName is planned for retirement at a future time.""";
                               rdfs:label "aliasName".
smg:IdentifiedObject.description <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                                 a owl:DatatypeProperty;
                                 rdfs:comment "The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy.";
                                 rdfs:label "description".
smg:IdentifiedObject.mRID <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment """Master resource identifier issued by a model authority. The mRID must semantically be a UUID as specified in RFC 4122. The mRID is globally unique.
For CIMXML data files in RDF syntax, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements.""";
                          rdfs:label "mRID".
smg:IdentifiedObject.name <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment "The name is any free human readable and possibly non unique text naming the object.";
                          rdfs:label "name".
smg:IntervalBlock a owl:Class;
                  rdfs:comment "Time sequence of readings of the same reading type. Contained interval readings may need conversion through the application of an offset and a scalar defined in associated pending.";
                  rdfs:isDefinedBy smg:Package_Metering;
                  rdfs:label "IntervalBlock";
                  rdfs:subClassOf [owl:onProperty smg:IntervalBlock.MeterReading ; 
                                   owl:allValuesFrom smg:MeterReading ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.MeterReading ; 
                                   owl:cardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom smg:IntervalReading ; 
                                   owl:onProperty smg:IntervalBlock.IntervalReadings ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.MeterReading ; 
                                   owl:cardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.MeterReading ; 
                                   owl:allValuesFrom smg:MeterReading ; 
                                   a owl:Restriction],
                                  [owl:allValuesFrom smg:IntervalReading ; 
                                   owl:onProperty smg:IntervalBlock.IntervalReadings ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.ReadingType ; 
                                   owl:allValuesFrom smg:ReadingType ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.ReadingType ; 
                                   owl:cardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.ReadingType ; 
                                   owl:cardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.IntervalReadings ; 
                                   owl:minCardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.IntervalReadings ; 
                                   owl:minCardinality "1"^^xsd:int ; 
                                   a owl:Restriction],
                                  [owl:onProperty smg:IntervalBlock.ReadingType ; 
                                   owl:allValuesFrom smg:ReadingType ; 
                                   a owl:Restriction].
smg:IntervalBlock.IntervalReadings a owl:ObjectProperty;
                                   rdfs:comment "Interval reading contained in this block.";
                                   rdfs:label "IntervalReadings";
                                   owl:inverseOf smg:IntervalReading.IntervalBlocks.
smg:IntervalBlock.MeterReading a owl:ObjectProperty;
                               rdfs:comment "Meter reading containing this interval block.";
                               rdfs:label "MeterReading".
smg:IntervalBlock.ReadingType a owl:ObjectProperty;
                              rdfs:comment "Type information for interval reading values contained in this block.";
                              rdfs:label "ReadingType".
smg:IntervalReading a owl:Class;
                    rdfs:comment """Data captured at regular intervals of time. Interval data could be captured as incremental data, absolute data, or relative data. The source for the data is usually a tariff quantity or an engineering quantity. Data is typically captured in time-tagged, uniform, fixed-length intervals of 5 min, 10 min, 15 min, 30 min, or 60 min.
Note: Interval Data is sometimes also called \"Interval Data Readings\" (IDR).""";
                    rdfs:isDefinedBy smg:Package_Metering;
                    rdfs:label "IntervalReading";
                    rdfs:subClassOf [owl:allValuesFrom smg:IntervalBlock ; 
                                     owl:onProperty smg:IntervalReading.IntervalBlocks ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:IntervalReading.IntervalBlocks ; 
                                     owl:minCardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    smg:BaseReading,
                                    [owl:allValuesFrom smg:IntervalBlock ; 
                                     owl:onProperty smg:IntervalReading.IntervalBlocks ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:IntervalReading.IntervalBlocks ; 
                                     owl:minCardinality "1"^^xsd:int ; 
                                     a owl:Restriction].
smg:IntervalReading.IntervalBlocks a owl:ObjectProperty;
                                   rdfs:comment "All blocks containing this interval reading.";
                                   rdfs:label "IntervalBlocks";
                                   owl:inverseOf smg:IntervalBlock.IntervalReadings.
smg:Location a owl:Class;
