                                     owl:cardinality "1"^^xsd:int ; 
                                     a owl:Restriction],
                                    smg:IdentifiedObject,
                                    [owl:allValuesFrom smg:ServiceKind ; 
                                     owl:onProperty smg:ServiceCategory.kind ; 
                                     a owl:Restriction],
                                    [owl:onProperty smg:ServiceCategory.kind ; 
                                     owl:cardinality "1"^^xsd:int ; 
                                     a owl:Restriction].
