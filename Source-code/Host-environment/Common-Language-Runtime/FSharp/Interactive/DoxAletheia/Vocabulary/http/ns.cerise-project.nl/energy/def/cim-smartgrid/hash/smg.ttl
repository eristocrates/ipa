                           owl:minCardinality "1"^^xsd:int ; 
                           a owl:Restriction],
                          [owl:onProperty smg:Meter.MeterReadings ; 
                           owl:minCardinality "1"^^xsd:int ; 
                           a owl:Restriction],
                          [owl:onProperty smg:Meter.formNumber ; 
                           owl:allValuesFrom xsd:string ; 
                           a owl:Restriction],
                          [owl:onProperty smg:Meter.MeterReadings ; 
                           owl:minCardinality "1"^^xsd:int ; 
                           a owl:Restriction],
                          [owl:onProperty smg:Meter.MeterMultipliers ; 
                           owl:allValuesFrom smg:MeterMultiplier ; 
