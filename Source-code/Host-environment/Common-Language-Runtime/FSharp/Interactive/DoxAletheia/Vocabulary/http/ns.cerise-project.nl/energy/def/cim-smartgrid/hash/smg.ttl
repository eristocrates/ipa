                           owl:onProperty smg:Meter.MeterReadings ; 
                           a owl:Restriction],
                          smg:EndDevice,
                          [owl:onProperty smg:Meter.MeterMultipliers ; 
                           owl:allValuesFrom smg:MeterMultiplier ; 
                           a owl:Restriction].
smg:Meter.MeterMultipliers a owl:ObjectProperty;
                           rdfs:comment "All multipliers applied at this meter.";
                           rdfs:label "MeterMultipliers";
                           owl:inverseOf smg:MeterMultiplier.Meter.
smg:Meter.MeterReadings a owl:ObjectProperty;
                        rdfs:comment "All meter readings provided by this meter.";
                        rdfs:label "MeterReadings";
                        owl:inverseOf smg:MeterReading.Meter.
smg:Meter.formNumber <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                     a owl:DatatypeProperty;
                     rdfs:comment "Meter form designation per ANSI C12.10 or other applicable standard. An alphanumeric designation denoting the circuit arrangement for which the meter is applicable and its specific terminal arrangement.";
                     rdfs:label "formNumber".
smg:MeterMultiplier a owl:Class;
                    rdfs:comment "Multiplier applied at the meter.";
