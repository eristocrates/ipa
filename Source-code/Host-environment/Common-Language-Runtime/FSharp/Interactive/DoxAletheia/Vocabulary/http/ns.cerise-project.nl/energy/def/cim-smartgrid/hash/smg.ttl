@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix smg: <http://ns.cerise-project.nl/energy/def/cim-smartgrid#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

<http://ns.cerise-project.nl/energy/def/cim-smartgrid> dc11:creator "Maarten Steen (TNO)";
                                                       dc11:publisher <http://www.cerise-project.nl/>;
                                                       a owl:Ontology;
                                                       rdfs:comment "A Profile of the IEC Common Information Model for Smart Grids, developed by the Cerise-SG project.";
                                                       rdfs:label "A CIM Profile for Smart Grids";
                                                       rdfs:seeAlso <http://www.iec.ch/smartgrid/standards/>;
                                                       owl:versionInfo "22/5/2014".
smg:AmiBillingReadyKind <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#enumeration>;
                        a owl:Class;
                        rdfs:comment "Lifecycle states of the metering installation at a usage point with respect to readiness for billing via advanced metering infrastructure reads.";
                        rdfs:isDefinedBy smg:Package_Metering;
                        rdfs:label "AmiBillingReadyKind".
smg:AmiBillingReadyKind.amiCapable a smg:AmiBillingReadyKind;
                                   rdfs:comment "Usage point is equipped with an AMI capable meter that is not yet currently equipped with a communications module.";
                                   rdfs:label "amiCapable".
smg:AmiBillingReadyKind.amiDisabled a smg:AmiBillingReadyKind;
                                    rdfs:comment "Usage point is equipped with an AMI capable meter; however, the AMI functionality has been disabled or is not being used.";
                                    rdfs:label "amiDisabled".
smg:AmiBillingReadyKind.billingApproved a smg:AmiBillingReadyKind;
                                        rdfs:comment "Usage point is equipped with an operating AMI capable meter and accuracy has been certified for billing purposes.";
                                        rdfs:label "billingApproved".
smg:AmiBillingReadyKind.enabled a smg:AmiBillingReadyKind;
                                rdfs:comment "Usage point is equipped with an AMI capable meter having communications capability.";
                                rdfs:label "enabled".
smg:AmiBillingReadyKind.nonAmi a smg:AmiBillingReadyKind;
                               rdfs:comment "Usage point is equipped with a non AMI capable meter.";
                               rdfs:label "nonAmi".
smg:AmiBillingReadyKind.nonMetered a smg:AmiBillingReadyKind;
                                   rdfs:comment "Usage point is not currently equipped with a meter.";
                                   rdfs:label "nonMetered".
smg:AmiBillingReadyKind.operable a smg:AmiBillingReadyKind;
                                 rdfs:comment "Usage point is equipped with an AMI capable meter that is functioning and communicating with the AMI network.";
                                 rdfs:label "operable".
smg:BaseReading a owl:Class;
                rdfs:comment "Common representation for reading values. Note that a reading value may have multiple qualities, as produced by various systems ('ReadingQuality.source').";
                rdfs:isDefinedBy smg:Package_Metering;
                rdfs:label "BaseReading";
                rdfs:subClassOf [owl:onProperty smg:BaseReading.value ; 
                                 owl:allValuesFrom xsd:string ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.source ; 
                                 owl:allValuesFrom xsd:string ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom smg:DateTimeInterval ; 
                                 owl:onProperty smg:BaseReading.timePeriod ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.source ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.source ; 
                                 owl:allValuesFrom xsd:string ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.timePeriod ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.value ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom smg:DateTimeInterval ; 
                                 owl:onProperty smg:BaseReading.timePeriod ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.timePeriod ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.value ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction],
                                smg:IdentifiedObject,
                                [owl:onProperty smg:BaseReading.value ; 
                                 owl:allValuesFrom xsd:string ; 
                                 a owl:Restriction],
                                [owl:onProperty smg:BaseReading.source ; 
                                 owl:cardinality "1"^^xsd:int ; 
                                 a owl:Restriction].
smg:BaseReading.source <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                       a owl:DatatypeProperty;
                       rdfs:comment "System that originally supplied the reading (e.g., customer, AMI system, handheld reading system, another enterprise system, etc.).";
                       rdfs:label "source".
smg:BaseReading.timePeriod <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                           a owl:ObjectProperty;
                           rdfs:comment "Start and end of the period for those readings whose type has a time attribute such as 'billing', seasonal' or 'forTheSpecifiedPeriod'.";
                           rdfs:label "timePeriod".
smg:BaseReading.value <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                      a owl:DatatypeProperty;
                      rdfs:comment "Value of this reading.";
                      rdfs:label "value".
smg:CoordinateSystem a owl:Class;
                     rdfs:comment "Coordinate reference system.";
                     rdfs:isDefinedBy smg:Package_Common;
                     rdfs:label "CoordinateSystem";
                     rdfs:subClassOf [owl:onProperty smg:CoordinateSystem.crsUrn ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.crsUrn ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.Location ; 
                                      owl:allValuesFrom smg:Location ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.Location ; 
                                      owl:minCardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.crsUrn ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.Location ; 
                                      owl:minCardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.crsUrn ; 
                                      owl:allValuesFrom xsd:string ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:CoordinateSystem.Location ; 
                                      owl:allValuesFrom smg:Location ; 
                                      a owl:Restriction],
                                     smg:IdentifiedObject.
smg:CoordinateSystem.Location a owl:ObjectProperty;
                              rdfs:comment "All locations described with position points in this coordinate system.";
                              rdfs:label "Location";
                              owl:inverseOf smg:Location.CoordinateSystem.
smg:CoordinateSystem.crsUrn <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                            a owl:DatatypeProperty;
                            rdfs:comment """A Uniform Resource Name (URN) for the coordinate reference system (crs) used to define 'Location.PositionPoints'.
An example would be the European Petroleum Survey Group (EPSG) code for a coordinate reference system, defined in URN under the Open Geospatial Consortium (OGC) namespace as: urn:ogc :def:uom:EPSG::XXXX, where XXXX is an EPSG code (a full list of codes can be found at the EPSG Registry website http://www.epsg-registry.org/). To define the coordinate system as being WGS84 (latitude, longitude) using an EPSG OGC, this attribute would be urn:ogc:def:uom:EPSG::4236.
A profile should limit this code to a set of allowed URNs agreed to by all sending and receiving parties.""";
                            rdfs:label "crsUrn".
smg:Customer a owl:Class;
             rdfs:comment "Organisation receiving services from service supplier.";
             rdfs:isDefinedBy smg:Package_Customers;
             rdfs:label "Customer";
             rdfs:subClassOf [owl:onProperty smg:Customer.kind ; 
                              owl:allValuesFrom smg:CustomerKind ; 
                              a owl:Restriction],
                             [owl:onProperty smg:Customer.kind ; 
                              owl:cardinality "1"^^xsd:int ; 
                              a owl:Restriction],
                             smg:OrganisationRole,
                             [owl:onProperty smg:Customer.kind ; 
                              owl:allValuesFrom smg:CustomerKind ; 
                              a owl:Restriction],
                             [owl:onProperty smg:Customer.kind ; 
                              owl:cardinality "1"^^xsd:int ; 
                              a owl:Restriction].
smg:Customer.kind <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                  a owl:ObjectProperty;
                  rdfs:comment "Kind of customer.";
                  rdfs:label "kind".
smg:CustomerAgreement a owl:Class;
                      rdfs:comment "Agreement between the customer and the service supplier to pay for service at a specific service location. It records certain billing information about the type of service provided at the service location and is used during charge creation to determine the type of service.";
                      rdfs:isDefinedBy smg:Package_Customers;
                      rdfs:label "CustomerAgreement";
                      rdfs:subClassOf [owl:onProperty smg:CustomerAgreement.Customer ; 
                                       owl:allValuesFrom smg:Customer ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceSupplier ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.Customer ; 
                                       owl:allValuesFrom smg:Customer ; 
                                       a owl:Restriction],
                                      smg:IdentifiedObject,
                                      [owl:onProperty smg:CustomerAgreement.ServiceCategory ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceCategory ; 
                                       owl:allValuesFrom smg:ServiceCategory ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceSupplier ; 
                                       owl:allValuesFrom smg:ServiceSupplier ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.Customer ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceCategory ; 
                                       owl:allValuesFrom smg:ServiceCategory ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceSupplier ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceCategory ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.Customer ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:CustomerAgreement.ServiceSupplier ; 
                                       owl:allValuesFrom smg:ServiceSupplier ; 
                                       a owl:Restriction].
smg:CustomerAgreement.Customer a owl:ObjectProperty;
                               rdfs:comment "Customer for this agreement.";
                               rdfs:label "Customer".
smg:CustomerAgreement.ServiceCategory a owl:ObjectProperty;
                                      rdfs:comment "Service category for this agreement.";
                                      rdfs:label "ServiceCategory".
smg:CustomerAgreement.ServiceSupplier a owl:ObjectProperty;
                                      rdfs:comment "Service supplier for this customer agreement.";
                                      rdfs:label "ServiceSupplier".
smg:CustomerKind <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#enumeration>;
                 a owl:Class;
                 rdfs:comment "Kind of customer.";
                 rdfs:isDefinedBy smg:Package_Customers;
                 rdfs:label "CustomerKind".
smg:CustomerKind.commercialIndustrial a smg:CustomerKind;
                                      rdfs:comment "Commercial industrial customer.";
                                      rdfs:label "commercialIndustrial".
smg:CustomerKind.energyServiceScheduler a smg:CustomerKind;
                                        rdfs:comment "Customer as energy service scheduler.";
                                        rdfs:label "energyServiceScheduler".
smg:CustomerKind.energyServiceSupplier a smg:CustomerKind;
                                       rdfs:comment "Customer as energy service supplier.";
                                       rdfs:label "energyServiceSupplier".
smg:CustomerKind.internalUse a smg:CustomerKind;
                             rdfs:comment "Internal use customer.";
                             rdfs:label "internalUse".
smg:CustomerKind.other a smg:CustomerKind;
                       rdfs:comment "Other kind of customer.";
                       rdfs:label "other".
smg:CustomerKind.pumpingLoad a smg:CustomerKind;
                             rdfs:comment "Pumping load customer.";
                             rdfs:label "pumpingLoad".
smg:CustomerKind.residential a smg:CustomerKind;
                             rdfs:comment "Residential customer.";
                             rdfs:label "residential".
smg:CustomerKind.residentialAndCommercial a smg:CustomerKind;
                                          rdfs:comment "Residential and commercial customer.";
                                          rdfs:label "residentialAndCommercial".
smg:CustomerKind.residentialAndStreetlight a smg:CustomerKind;
                                           rdfs:comment "Residential and streetlight customer.";
                                           rdfs:label "residentialAndStreetlight".
smg:CustomerKind.residentialFarmService a smg:CustomerKind;
                                        rdfs:comment "Residential farm service customer.";
                                        rdfs:label "residentialFarmService".
smg:CustomerKind.residentialStreetlightOthers a smg:CustomerKind;
                                              rdfs:comment "Residential streetlight or other related customer.";
                                              rdfs:label "residentialStreetlightOthers".
smg:CustomerKind.windMachine a smg:CustomerKind;
                             rdfs:comment "Wind machine customer.";
                             rdfs:label "windMachine".
smg:DateTimeInterval <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#compound>;
                     a owl:Class;
                     rdfs:comment "Interval between two date and time points.";
                     rdfs:isDefinedBy smg:Package_Domain;
                     rdfs:label "DateTimeInterval";
                     rdfs:subClassOf [owl:onProperty smg:DateTimeInterval.end ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.start ; 
                                      owl:allValuesFrom xsd:dateTime ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.start ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.end ; 
                                      owl:allValuesFrom xsd:dateTime ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.start ; 
                                      owl:allValuesFrom xsd:dateTime ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.end ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.end ; 
                                      owl:allValuesFrom xsd:dateTime ; 
                                      a owl:Restriction],
                                     [owl:onProperty smg:DateTimeInterval.start ; 
                                      owl:cardinality "1"^^xsd:int ; 
                                      a owl:Restriction].
smg:DateTimeInterval.end <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                         a owl:DatatypeProperty;
                         rdfs:comment "End date and time of this interval.";
                         rdfs:label "end".
smg:DateTimeInterval.start <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                           a owl:DatatypeProperty;
                           rdfs:comment "Start date and time of this interval.";
                           rdfs:label "start".
smg:ElectronicAddress <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#compound>;
                      a owl:Class;
                      rdfs:comment "Electronic address information.";
                      rdfs:isDefinedBy smg:Package_Common;
                      rdfs:label "ElectronicAddress";
                      rdfs:subClassOf [owl:onProperty smg:ElectronicAddress.userID ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.web ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email2 ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email2 ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.radio ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email1 ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.radio ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.mac ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.password ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.lan ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.web ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.lan ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.mac ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.password ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.web ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email1 ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email2 ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email2 ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.email1 ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.lan ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.userID ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.lan ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.mac ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.web ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.password ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.mac ; 
                                       owl:allValuesFrom xsd:string ; 
                                       a owl:Restriction],
                                      [owl:onProperty smg:ElectronicAddress.radio ; 
                                       owl:cardinality "1"^^xsd:int ; 
                                       a owl:Restriction],
