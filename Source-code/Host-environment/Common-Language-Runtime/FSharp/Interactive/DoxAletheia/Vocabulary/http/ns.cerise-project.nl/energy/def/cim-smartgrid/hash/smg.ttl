smg:Location.phone2 <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                    a owl:ObjectProperty;
                    rdfs:comment "Additional phone number.";
                    rdfs:label "phone2".
smg:Location.secondaryAddress <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                              a owl:ObjectProperty;
