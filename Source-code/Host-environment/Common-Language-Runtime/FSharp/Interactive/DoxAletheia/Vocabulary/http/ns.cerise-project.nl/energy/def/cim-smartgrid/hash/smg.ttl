smg:MeterReading.Meter a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Meter providing this reading.";
                       rdfs:label "Meter";
                       <http://www.w3.org/2002/07/owl#inverseOf> smg:Meter.MeterReadings.
smg:MeterReading.Readings a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "All reading values contained within this meter reading.";
                          rdfs:label "Readings";
