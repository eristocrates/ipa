                                    [<http://www.w3.org/2002/07/owl#onProperty> smg:IntervalReading.IntervalBlocks ; 
                                     <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:int ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>].
