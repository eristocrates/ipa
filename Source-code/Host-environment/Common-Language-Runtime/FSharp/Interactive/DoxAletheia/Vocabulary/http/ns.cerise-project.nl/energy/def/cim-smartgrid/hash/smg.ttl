                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.stateOrProvince ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.section ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.country ; 
                                owl:allValuesFrom xsd:string ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.name ; 
                                owl:allValuesFrom xsd:string ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.code ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.stateOrProvince ; 
                                owl:allValuesFrom xsd:string ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.name ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.name ; 
                                owl:allValuesFrom xsd:string ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.stateOrProvince ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.section ; 
                                owl:cardinality "1"^^xsd:int ; 
                                a owl:Restriction],
                               [owl:onProperty smg:TownDetail.code ; 
                                owl:cardinality "1"^^xsd:int ; 
