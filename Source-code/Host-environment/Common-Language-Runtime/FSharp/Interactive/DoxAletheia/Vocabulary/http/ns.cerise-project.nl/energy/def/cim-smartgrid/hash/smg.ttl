                              rdfs:comment "(if applicable) Extension for this telephone number.";
                              rdfs:label "extension".
smg:TelephoneNumber.localNumber <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                                a owl:DatatypeProperty;
                                rdfs:comment "Main (local) part of this telephone number.";
                                rdfs:label "localNumber".
smg:TownDetail <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#compound>;
               a owl:Class;
