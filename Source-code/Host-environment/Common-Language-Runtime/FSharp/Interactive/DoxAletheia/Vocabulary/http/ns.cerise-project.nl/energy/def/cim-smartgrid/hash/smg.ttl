smg:TownDetail.code <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                    a owl:DatatypeProperty;
                    rdfs:comment "Town code.";
                    rdfs:label "code".
smg:TownDetail.country <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                       a owl:DatatypeProperty;
                       rdfs:comment "Name of the country.";
                       rdfs:label "country".
smg:TownDetail.name <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                    a owl:DatatypeProperty;
