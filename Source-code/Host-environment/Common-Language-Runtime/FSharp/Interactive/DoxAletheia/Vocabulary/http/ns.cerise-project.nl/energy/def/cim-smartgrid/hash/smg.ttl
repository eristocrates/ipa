smg:ElectronicAddress.userID <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                             a owl:DatatypeProperty;
                             rdfs:comment "User ID needed to log in, which can be for an individual person, an organisation, a location, etc.";
