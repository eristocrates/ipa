                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> smg:MeterReading.Meter ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> smg:Meter ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> smg:MeterReading.Meter ; 
                                  <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:int ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#onProperty> smg:MeterReading.Readings ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> smg:Reading ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
