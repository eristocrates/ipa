smg:ElectronicAddress.email1 <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                             a owl:DatatypeProperty;
                             rdfs:comment "Primary email address.";
                             rdfs:label "email1".
smg:ElectronicAddress.email2 <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                             a owl:DatatypeProperty;
                             rdfs:comment "Alternate email address.";
                             rdfs:label "email2".
smg:ElectronicAddress.lan <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment "Address on local area network.";
                          rdfs:label "lan".
smg:ElectronicAddress.mac <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                          a owl:DatatypeProperty;
                          rdfs:comment "MAC (Media Access Control) address.";
                          rdfs:label "mac".
smg:ElectronicAddress.password <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                               a owl:DatatypeProperty;
                               rdfs:comment "Password needed to log in.";
                               rdfs:label "password".
smg:ElectronicAddress.radio <http://langdale.com.au/2005/UML#hasStereotype> <http://langdale.com.au/2005/UML#attribute>;
                            a owl:DatatypeProperty;
                            rdfs:comment "Radio address.";
