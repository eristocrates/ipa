@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cld: <http://purl.org/cld/terms/>.

cld: <http://purl.org/dc/terms/creator> [rdfs:label "Dublin Core Collection Description Working Group"];
     <http://purl.org/dc/terms/modified> "2013-06-26"^^<http://purl.org/dc/terms/W3CDTF>;
     <http://purl.org/dc/terms/title> "The Collection Description Terms"@en;
     <http://www.w3.org/2004/02/skos/core#changeNote> "2013-08-20: added missing VES, CDType."@en.
cld:AccrualMethod a <http://www.w3.org/2004/02/skos/core#ConceptScheme>,
                    <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
                  rdfs:comment "A set of methods by which items are added to a collection."@en;
                  rdfs:isDefinedBy cld:;
                  rdfs:label "Collection Description Accrual Method Vocabulary"@en;
                  rdfs:seeAlso <http://dublincore.org/groups/collections/accrual-method/>,
                               <http://purl.org/cld/accmeth/>.
cld:AccrualPolicy a <http://www.w3.org/2004/02/skos/core#ConceptScheme>,
                    <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
                  rdfs:comment "A set of policies governing the addition of items are added to a collection."@en;
                  rdfs:isDefinedBy cld:;
                  rdfs:label "Collection Description Accrual Policy Vocabulary"@en;
                  rdfs:seeAlso <http://dublincore.org/groups/collections/accrual-policy/>,
                               <http://purl.org/cld/accpol/>.
cld:CDType a <http://www.w3.org/2004/02/skos/core#ConceptScheme>,
             <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
           rdfs:comment "A set of types of collection description."@en;
           rdfs:isDefinedBy cld:;
           rdfs:label "Collection Description Type Vocabulary"@en;
           rdfs:seeAlso <http://dublincore.org/groups/collections/colldesc-type/>,
                        <http://purl.org/cld/cdtype/>.
cld:Frequency <http://purl.org/dc/elements/1.1/description> "The Collection Description Frequency Vocabulary is based on the set of codes used for publication frequency in the MARC 21 Concise Format for Holdings Data."@en;
              a <http://www.w3.org/2004/02/skos/core#ConceptScheme>,
                <http://purl.org/dc/dcam/VocabularyEncodingScheme>;
              rdfs:comment "A set of frequencies with which a repeatable event occurs.."@en;
              rdfs:isDefinedBy cld:;
              rdfs:label "Collection Description Frequency Vocabulary"@en;
              rdfs:seeAlso <http://www.loc.gov/marc/holdings/echdcapt.html>,
                           <http://dublincore.org/groups/collections/frequency/>,
                           <http://purl.org/cld/freq/>.
cld:RKMS-ISO8601 rdfs:comment "Instances of this datatype are dates or periods of time represented as literals according to the rules specified in Recordkeeping Metadata Schema Extension to ISO8601."@en;
                 rdfs:isDefinedBy cld:;
                 rdfs:label "Recordkeeping Metadata Schema Extension to ISO8601"@en;
                 rdfs:seeAlso <http://www.sims.monash.edu.au/research/rcrg/research/spirt/deliver/schemes.html#rkmsextension>.
cld:associatedCollection a rdf:Property;
                         rdfs:comment "A second collection that is associated with the current collection."@en;
                         rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
                         rdfs:isDefinedBy cld:;
                         rdfs:label "Associated Collection"@en;
                         rdfs:range <http://purl.org/dc/dcmitype/Collection>;
                         rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
cld:catalogueOrIndex a rdf:Property;
                     rdfs:comment "A catalogue for, or index of, the collection."@en;
                     rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
                     rdfs:isDefinedBy cld:;
                     rdfs:label "Catalogue or Index"@en;
                     rdfs:range <http://purl.org/cld/cdtype/CatalogueOrIndex>,
                                <http://purl.org/dc/dcmitype/Collection>;
                     rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/description>.
cld:dateItemsCreated a rdf:Property;
                     rdfs:comment "A range of dates over which the individual items within the collection were created."@en;
                     rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
                     rdfs:isDefinedBy cld:;
                     rdfs:label "Date Items Created"@en;
                     rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>.
cld:describedCollection a rdf:Property;
                        rdfs:comment "A collection that is described by the current collection."@en;
                        rdfs:domain <http://purl.org/cld/cdtype/CatalogueOrIndex>,
                                    <http://purl.org/dc/dcmitype/Collection>;
                        rdfs:isDefinedBy cld:;
                        rdfs:label "Described Collection"@en;
                        rdfs:range <http://purl.org/dc/dcmitype/Collection>;
                        rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
cld:isAccessedVia a rdf:Property;
                  rdfs:comment "A service that provides access to the items within the collection."@en;
                  rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
                  rdfs:isDefinedBy cld:;
                  rdfs:label "Is Accessed Via"@en;
                  rdfs:range <http://purl.org/dc/dcmitype/Service>;
                  rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
cld:isLocatedAt a rdf:Property;
                rdfs:comment "A location where the collection is held."@en;
                rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
                rdfs:isDefinedBy cld:;
                rdfs:label "Is Located At"@en;
                rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/relation>.
cld:itemFormat a rdf:Property;
               rdfs:comment "The media type, physical or digital, of one or more items within the collection."@en;
               rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
               rdfs:isDefinedBy cld:;
               rdfs:label "Item Format"@en.
cld:itemType a rdf:Property;
             rdfs:comment "The nature or genre of the content of one or more items within the collection."@en;
             rdfs:domain <http://purl.org/dc/dcmitype/Collection>;
             rdfs:isDefinedBy cld:;
             rdfs:label "Item Type"@en.
