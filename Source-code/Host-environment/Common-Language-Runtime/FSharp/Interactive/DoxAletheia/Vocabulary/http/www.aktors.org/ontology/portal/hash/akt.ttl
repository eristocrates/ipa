akt:Broken-Version a akt:Software-Status;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Business-Area a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Generic-Area-Of-Interest.
akt:Capital-City a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                 rdfs:subClassOf akt:City.
akt:Charitable-Organization a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf akt:Non-Profit-Organization.
akt:City a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
         rdfs:subClassOf akt:Municipal-Unit.
akt:Civil-Service a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Government-Organization.
akt:Cognitive-Modelling-Research-Area a akt:Research-Area;
                                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Collaborative-Hypermedia akt:sub-area-of akt:Hypermedia;
                             a akt:Research-Area;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Company a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Profit-Organization.
akt:Composite-Publication a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "A publication which contains items which cane be themselves referenced through a publication reference.  Composite publications include newspapers, magazines and journals. A book which is a collection of articles is a composite publication, a monograph is not";
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> akt:contains-publication ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Publication ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> akt:contains-publication ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>].
akt:Computing-Research-Area a akt:Research-Area;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Computing-Technology a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Technology.
akt:Conference a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Conference-Proceedings-Reference ; 
                                <http://www.w3.org/2002/07/owl#onProperty> akt:published-proceedings ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               akt:Publication-Type-Event,
                               akt:Meeting-Taking-Place.
akt:Conference-Proceedings-Reference a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                     rdfs:subClassOf akt:Publication-Reference.
akt:Conferring-An-Award a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Generalized-Transfer.
akt:Country a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Geopolitical-Entity.
akt:Currency a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akt:Information-Bearing-Object.
akt:DEng a akt:Academic-Degree;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Daily-Newspaper a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#hasValue> <http://www.aktors.org/ontology/support#twentyfour-hour-duration> ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> akt:has-periodicity ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    akt:Newspaper.
akt:Degree a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A degree is type of award";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Award.
akt:Distance-Teaching-University a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                 rdfs:subClassOf akt:University.
akt:Dr a akt:Appellation;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Dynamic-Linking akt:sub-area-of akt:Hypermedia;
                    a akt:Research-Area;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:E-Commerce-Research-Area a akt:Research-Area;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Edited-Book a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> akt:has-publication-reference ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Edited-Book-Reference ; 
                                 <http://www.w3.org/2002/07/owl#onProperty> akt:has-publication-reference ; 
                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                akt:Publication.
akt:Edited-Book-Reference a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Person ; 
                                           <http://www.w3.org/2002/07/owl#onProperty> akt:edited-by ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          akt:Book-Reference.
akt:Editor a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Implemented-System.
akt:Educational-Employee a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Educational-Organization ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> akt:works-for ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> akt:works-for ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         akt:Employee.
akt:Educational-Organization a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf akt:Learning-Centred-Organization.
akt:Educational-Organization-Unit a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Educational-Organization ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> akt:unit-of-organization ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  akt:Organization-Unit.
akt:Email-Medium a akt:Information-Transfer-Medium;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Email-Message a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Message.
akt:Employee a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akt:Affiliated-Person,
                             akt:Working-Person.
akt:Employment-Contract-Type a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>;
                             <http://www.w3.org/2002/07/owl#oneOf> (akt:Permanent-Contract
                                                                    akt:Temporary-Contract).
akt:Event a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "This is a minimalist definition of class event.  We start with the very basic and we will then add slots as we specialise this definition for specific classes of events. The fillers of slots has-other-agents-involved and has-main-agent should not intersect";
          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
          rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing>.
akt:Event-Involving-Movement a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "This is an event in which the main agent (plus maybe others) goes from some place to another";
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> akt:location-at-end ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#maxCardinality> "1"^^xsd:nonNegativeInteger ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> akt:location-at-start ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             akt:Event.
akt:Event-Involving-Production a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "When something is produced";
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf akt:Event.
akt:Experimental-Version a akt:Software-Status;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Female-Gender a akt:Gender;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Financial-Award a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Award.
akt:Full-Time a akt:Work-Status;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Gender a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "HPKB says that genders are intangible..Uhm...";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>;
           <http://www.w3.org/2002/07/owl#oneOf> (akt:Male-Gender
                                                  akt:Female-Gender).
akt:Generalised-Means-Of-Transport a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "This is a generic class to catch all sorts of borderline and metaphorical ways to carry things from A to B";
                                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                   rdfs:subClassOf <http://www.aktors.org/ontology/support#Thing>.
akt:Generalized-Transfer a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An event in which the main agent transfers something (the thing-acted-on, tangible or intangible) to one or more recipient agents. Note that we do not say anything about whether the original agent still retain the thing-acted-on.  In some cases this is clearly true ('I pass my wisdom on to my daughter'), in other cases it is not (I give you my wallet).";
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Event-Involving-Movement.
akt:Generic-Agent a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "This is a generic notion, an agent can be an organization, a person an animal, a software agent, etc";
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:label "Generic Agent";
                  rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing>.
akt:Generic-Area-Of-Interest a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A generic class to specify generic areas for research or business initiatives. For instance, the area in which a project is situated";
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>.
akt:Geographical-Region a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "'Real' geographical regions";
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Location,
                                        <http://www.aktors.org/ontology/support#Tangible-Thing>.
akt:Geopolitical-Entity a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A geopolitical entity is a geographical area which is associated with some sort of political structure. For instance, Russia, Italy, The-city-of-Messina, etc. A geopolitical entity can be also seen as an agent - e.g., France declared war to Spain";
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Generic-Agent,
                                        akt:Geographical-Region.
