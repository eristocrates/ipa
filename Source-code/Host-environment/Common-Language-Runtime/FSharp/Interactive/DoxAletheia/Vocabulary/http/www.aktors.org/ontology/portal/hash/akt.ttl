akt:Information-Bearing-Object a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "This notion comes from Cyc.  It is useful to group together all information bearing entities, including video, audio and documents. An information bearing object may have an author (a generic agent) and may be owned by a legal agent. It is a tangible object";
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Legal-Agent ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> akt:owned-by ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Generic-Agent ; 
                                                <http://www.w3.org/2002/07/owl#onProperty> akt:has-author ; 
                                                a <http://www.w3.org/2002/07/owl#Restriction>],
                                               <http://www.aktors.org/ontology/support#Tangible-Thing>.
