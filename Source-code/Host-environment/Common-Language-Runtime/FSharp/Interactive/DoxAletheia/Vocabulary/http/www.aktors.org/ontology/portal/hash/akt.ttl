akt:Organization a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "An organization is a type of legal agent";
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                 rdfs:label "Organization";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Organization-Unit ; 
