akt:uses-resource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain akt:Activity;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:range <http://www.aktors.org/ontology/support#Thing>.
akt:very-large-size a akt:Organization-Size;
                    rdfs:comment "An organization with over 10000 employees";
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:label "very large".
akt:works-for a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain akt:Employee;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
              rdfs:range akt:Organization;
              rdfs:subPropertyOf akt:has-affiliation.
akt:works-in-unit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain akt:Employee;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:range akt:Organization-Unit;
                  rdfs:subPropertyOf akt:has-affiliation-to-unit.
