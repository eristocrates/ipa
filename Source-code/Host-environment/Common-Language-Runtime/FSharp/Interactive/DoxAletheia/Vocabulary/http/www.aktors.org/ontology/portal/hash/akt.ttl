@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix akt: <http://www.aktors.org/ontology/portal#>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.aktors.org/ontology/portal> <http://purl.org/dc/elements/1.1/creator> "Enrico Motta (OCML version)",
                                                                                  "Nick Gibbins (OWL translation)",
                                                                                  "AKT Project";
                                        <http://purl.org/dc/elements/1.1/description> """The AKT Reference Ontology has been designed to support the AKT-2 demonstrator (\"AKTive Portal\"), and subsequent activities. The ontology, designed by the AKT-2 group and codified by Enrico Motta, extends Version 1."""@en;
                                        <http://purl.org/dc/elements/1.1/source> <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                        <http://purl.org/dc/elements/1.1/title> "AKT Reference Ontology (Portal Ontology)"@en;
                                        <http://purl.org/dc/terms/created> "2003-02-10";
                                        a <http://www.w3.org/2002/07/owl#Ontology>;
                                        rdfs:label "AKT Reference Ontology (Portal Ontology)";
                                        rdfs:seeAlso <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                        <http://www.w3.org/2002/07/owl#imports> <http://www.aktors.org/ontology/support>;
                                        <http://www.w3.org/2002/07/owl#versionInfo> "2.0".
akt:Abstract-Information a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Information in general, independent of an object in which it is encoded. Whatever is transferred in an information-transfer event. It is clearly an intangible thing";
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>.
akt:Academic a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Higher-Educational-Organization ; 
                              <http://www.w3.org/2002/07/owl#onProperty> akt:works-for ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             akt:Educational-Employee.
akt:Academic-Degree a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Degree.
akt:Academic-Support-Staff a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Higher-Educational-Organization ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> akt:works-for ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           akt:Educational-Employee.
akt:Academic-Support-Unit a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf akt:Educational-Organization-Unit.
akt:Academic-Unit a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:University ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> akt:unit-of-organization ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  akt:Educational-Organization-Unit.
akt:Activity a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf <http://www.aktors.org/ontology/support#Temporal-Thing>.
akt:Adaptive-Hypermedia akt:sub-area-of akt:Hypermedia;
                        a akt:Research-Area;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Address a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A generic class for addresses, whether email or postal. We see an address as abstract information and therefore it is an intangible thing";
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Abstract-Information.
akt:Affiliated-Person a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "A person which has an affiliation with some organization. For instance employees are affiliated to the organization they work for, students to the institution where they are studying, etc. A person can have multiple affiliations, which means that there is no constraint relating the values of slot has-affiliation-to-unit to the values of slot has-affiliation";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> akt:has-affiliation ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      akt:Person.
akt:Agent-Based-Computing a akt:Research-Area;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Alpha-Version a akt:Software-Status;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Amount-Of-Money a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Currency ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> <http://www.aktors.org/ontology/support#has-unit-of-measure> ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    <http://www.aktors.org/ontology/support#Physical-Quantity>.
akt:Appellation a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>.
akt:Article-In-A-Composite-Publication a <http://www.w3.org/2002/07/owl#Class>;
                                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Composite-Publication ; 
                                                        <http://www.w3.org/2002/07/owl#onProperty> akt:included-in-publication ; 
                                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                                       akt:Publication.
akt:Article-Reference a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf akt:Publication-Reference.
akt:Artificial-Intelligence-Research-Area a akt:Research-Area;
                                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Attending-A-Conference a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Conference ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> akt:event-attended ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           akt:Attending-An-Event.
akt:Attending-An-Event a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Event.
akt:Award a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "An award is an intangible thing, even if the piece of paper which is often associated with an award is tangible.  What about the virtual piece of paper in the virtual degree ceremony?  I guess that ought to be an intangible";
          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
          rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>.
akt:Awarding-Body a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Legal agents can be either organizations or people. An awarding body is normally an organization, an individual, or a bunch of people";
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Legal-Agent.
akt:BA a akt:Academic-Degree;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:BSc a akt:Academic-Degree;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Beta-Version a akt:Software-Status;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Book a <http://www.w3.org/2002/07/owl#Class>;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                          <http://www.w3.org/2002/07/owl#onProperty> akt:has-publication-reference ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Book-Reference ; 
                          <http://www.w3.org/2002/07/owl#onProperty> akt:has-publication-reference ; 
                          a <http://www.w3.org/2002/07/owl#Restriction>],
                         akt:Publication.
akt:Book-Publishing a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Publication-Type-Event.
akt:Book-Reference a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Publishing-House ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> akt:published-by ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   akt:Publication-Reference.
akt:Book-Section-Reference a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
