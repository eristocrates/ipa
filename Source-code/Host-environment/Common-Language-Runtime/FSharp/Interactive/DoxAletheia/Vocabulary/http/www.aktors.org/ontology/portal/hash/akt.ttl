@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix akt: <http://www.aktors.org/ontology/portal#>.
@prefix akts: <http://www.aktors.org/ontology/support#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

dc11:creator a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:created a owl:AnnotationProperty.
<http://www.aktors.org/ontology/portal> dc11:creator "Enrico Motta (OCML version)",
                                                     "Nick Gibbins (OWL translation)",
                                                     "AKT Project";
                                        dc11:description """The AKT Reference Ontology has been designed to support the AKT-2 demonstrator (\"AKTive Portal\"), and subsequent activities. The ontology, designed by the AKT-2 group and codified by Enrico Motta, extends Version 1."""@en;
                                        dc11:source <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                        dc11:title "AKT Reference Ontology (Portal Ontology)"@en;
                                        dcterms:created "2003-02-10";
                                        a owl:Ontology;
                                        rdfs:label "AKT Reference Ontology (Portal Ontology)";
                                        rdfs:seeAlso <http://d3e.open.ac.uk/akt/2002/ref-onto.html>;
                                        owl:imports <http://www.aktors.org/ontology/support>;
                                        owl:versionInfo "2.0".
akt:Abstract-Information a owl:Class;
                         rdfs:comment "Information in general, independent of an object in which it is encoded. Whatever is transferred in an information-transfer event. It is clearly an intangible thing";
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akts:Intangible-Thing.
akt:Academic a owl:Class;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf [owl:allValuesFrom akt:Higher-Educational-Organization ; 
                              owl:onProperty akt:works-for ; 
                              a owl:Restriction],
                             akt:Educational-Employee.
akt:Academic-Degree a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Degree.
akt:Academic-Support-Staff a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [owl:allValuesFrom akt:Higher-Educational-Organization ; 
                                            owl:onProperty akt:works-for ; 
                                            a owl:Restriction],
                                           akt:Educational-Employee.
akt:Academic-Support-Unit a owl:Class;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf akt:Educational-Organization-Unit.
akt:Academic-Unit a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf [owl:allValuesFrom akt:University ; 
                                   owl:onProperty akt:unit-of-organization ; 
                                   a owl:Restriction],
                                  akt:Educational-Organization-Unit.
akt:Activity a owl:Class;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akts:Temporal-Thing.
akt:Adaptive-Hypermedia akt:sub-area-of akt:Hypermedia;
                        a akt:Research-Area;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Address a owl:Class;
            rdfs:comment "A generic class for addresses, whether email or postal. We see an address as abstract information and therefore it is an intangible thing";
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Abstract-Information.
akt:Affiliated-Person a owl:Class;
                      rdfs:comment "A person which has an affiliation with some organization. For instance employees are affiliated to the organization they work for, students to the institution where they are studying, etc. A person can have multiple affiliations, which means that there is no constraint relating the values of slot has-affiliation-to-unit to the values of slot has-affiliation";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                       owl:onProperty akt:has-affiliation ; 
                                       a owl:Restriction],
                                      akt:Person.
akt:Agent-Based-Computing a akt:Research-Area;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Alpha-Version a akt:Software-Status;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Amount-Of-Money a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf [owl:allValuesFrom akt:Currency ; 
                                     owl:onProperty akts:has-unit-of-measure ; 
                                     a owl:Restriction],
                                    akts:Physical-Quantity.
akt:Appellation a owl:Class;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf akts:Intangible-Thing.
akt:Article-In-A-Composite-Publication a owl:Class;
                                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                       rdfs:subClassOf [owl:allValuesFrom akt:Composite-Publication ; 
                                                        owl:onProperty akt:included-in-publication ; 
                                                        a owl:Restriction],
                                                       akt:Publication.
akt:Article-Reference a owl:Class;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf akt:Publication-Reference.
akt:Artificial-Intelligence-Research-Area a akt:Research-Area;
                                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Attending-A-Conference a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [owl:allValuesFrom akt:Conference ; 
                                            owl:onProperty akt:event-attended ; 
                                            a owl:Restriction],
                                           akt:Attending-An-Event.
akt:Attending-An-Event a owl:Class;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Event.
akt:Award a owl:Class;
          rdfs:comment "An award is an intangible thing, even if the piece of paper which is often associated with an award is tangible.  What about the virtual piece of paper in the virtual degree ceremony?  I guess that ought to be an intangible";
          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
          rdfs:subClassOf akts:Intangible-Thing.
akt:Awarding-Body a owl:Class;
                  rdfs:comment "Legal agents can be either organizations or people. An awarding body is normally an organization, an individual, or a bunch of people";
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Legal-Agent.
akt:BA a akt:Academic-Degree;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:BSc a akt:Academic-Degree;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Beta-Version a akt:Software-Status;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Book a owl:Class;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
         rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                          owl:onProperty akt:has-publication-reference ; 
                          a owl:Restriction],
                         [owl:allValuesFrom akt:Book-Reference ; 
                          owl:onProperty akt:has-publication-reference ; 
                          a owl:Restriction],
                         akt:Publication.
akt:Book-Publishing a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Publication-Type-Event.
akt:Book-Reference a owl:Class;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf [owl:allValuesFrom akt:Publishing-House ; 
                                    owl:onProperty akt:published-by ; 
                                    a owl:Restriction],
                                   akt:Publication-Reference.
akt:Book-Section-Reference a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf akt:Publication-Reference.
akt:Broken-Version a akt:Software-Status;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Business-Area a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Generic-Area-Of-Interest.
akt:Capital-City a owl:Class;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                 rdfs:subClassOf akt:City.
akt:Charitable-Organization a owl:Class;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf akt:Non-Profit-Organization.
akt:City a owl:Class;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
         rdfs:subClassOf akt:Municipal-Unit.
akt:Civil-Service a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Government-Organization.
akt:Cognitive-Modelling-Research-Area a akt:Research-Area;
                                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Collaborative-Hypermedia akt:sub-area-of akt:Hypermedia;
                             a akt:Research-Area;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Company a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Profit-Organization.
akt:Composite-Publication a owl:Class;
                          rdfs:comment "A publication which contains items which cane be themselves referenced through a publication reference.  Composite publications include newspapers, magazines and journals. A book which is a collection of articles is a composite publication, a monograph is not";
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                           owl:onProperty akt:contains-publication ; 
                                           a owl:Restriction],
                                          [owl:allValuesFrom akt:Publication ; 
                                           owl:onProperty akt:contains-publication ; 
                                           a owl:Restriction].
akt:Computing-Research-Area a akt:Research-Area;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Computing-Technology a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Technology.
akt:Conference a owl:Class;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf [owl:allValuesFrom akt:Conference-Proceedings-Reference ; 
                                owl:onProperty akt:published-proceedings ; 
                                a owl:Restriction],
                               akt:Publication-Type-Event,
                               akt:Meeting-Taking-Place.
akt:Conference-Proceedings-Reference a owl:Class;
                                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                     rdfs:subClassOf akt:Publication-Reference.
akt:Conferring-An-Award a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Generalized-Transfer.
akt:Country a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Geopolitical-Entity.
akt:Currency a owl:Class;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akt:Information-Bearing-Object.
akt:DEng a akt:Academic-Degree;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Daily-Newspaper a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf [owl:hasValue akts:twentyfour-hour-duration ; 
                                     owl:onProperty akt:has-periodicity ; 
                                     a owl:Restriction],
                                    akt:Newspaper.
akt:Degree a owl:Class;
           rdfs:comment "A degree is type of award";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Award.
akt:Distance-Teaching-University a owl:Class;
                                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                 rdfs:subClassOf akt:University.
akt:Dr a akt:Appellation;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Dynamic-Linking akt:sub-area-of akt:Hypermedia;
                    a akt:Research-Area;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:E-Commerce-Research-Area a akt:Research-Area;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Edited-Book a owl:Class;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akt:has-publication-reference ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom akt:Edited-Book-Reference ; 
                                 owl:onProperty akt:has-publication-reference ; 
                                 a owl:Restriction],
                                akt:Publication.
akt:Edited-Book-Reference a owl:Class;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf [owl:allValuesFrom akt:Person ; 
                                           owl:onProperty akt:edited-by ; 
                                           a owl:Restriction],
                                          akt:Book-Reference.
akt:Editor a owl:Class;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Implemented-System.
akt:Educational-Employee a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf [owl:allValuesFrom akt:Educational-Organization ; 
                                          owl:onProperty akt:works-for ; 
                                          a owl:Restriction],
                                         [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                          owl:onProperty akt:works-for ; 
                                          a owl:Restriction],
                                         akt:Employee.
akt:Educational-Organization a owl:Class;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf akt:Learning-Centred-Organization.
akt:Educational-Organization-Unit a owl:Class;
                                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                  rdfs:subClassOf [owl:allValuesFrom akt:Educational-Organization ; 
                                                   owl:onProperty akt:unit-of-organization ; 
                                                   a owl:Restriction],
                                                  akt:Organization-Unit.
akt:Email-Medium a akt:Information-Transfer-Medium;
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Email-Message a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Message.
akt:Employee a owl:Class;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akt:Affiliated-Person,
                             akt:Working-Person.
akt:Employment-Contract-Type a owl:Class;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf akts:Intangible-Thing;
                             owl:oneOf (akt:Permanent-Contract
                                        akt:Temporary-Contract).
akt:Event a owl:Class;
          rdfs:comment "This is a minimalist definition of class event.  We start with the very basic and we will then add slots as we specialise this definition for specific classes of events. The fillers of slots has-other-agents-involved and has-main-agent should not intersect";
          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
          rdfs:subClassOf akts:Temporal-Thing.
akt:Event-Involving-Movement a owl:Class;
                             rdfs:comment "This is an event in which the main agent (plus maybe others) goes from some place to another";
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty akt:location-at-end ; 
                                              a owl:Restriction],
                                             [owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                              owl:onProperty akt:location-at-start ; 
                                              a owl:Restriction],
                                             akt:Event.
akt:Event-Involving-Production a owl:Class;
                               rdfs:comment "When something is produced";
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf akt:Event.
akt:Experimental-Version a akt:Software-Status;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Female-Gender a akt:Gender;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Financial-Award a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Award.
akt:Full-Time a akt:Work-Status;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Gender a owl:Class;
           rdfs:comment "HPKB says that genders are intangible..Uhm...";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akts:Intangible-Thing;
           owl:oneOf (akt:Male-Gender
                      akt:Female-Gender).
akt:Generalised-Means-Of-Transport a owl:Class;
                                   rdfs:comment "This is a generic class to catch all sorts of borderline and metaphorical ways to carry things from A to B";
                                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                   rdfs:subClassOf akts:Thing.
akt:Generalized-Transfer a owl:Class;
                         rdfs:comment "An event in which the main agent transfers something (the thing-acted-on, tangible or intangible) to one or more recipient agents. Note that we do not say anything about whether the original agent still retain the thing-acted-on.  In some cases this is clearly true ('I pass my wisdom on to my daughter'), in other cases it is not (I give you my wallet).";
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Event-Involving-Movement.
akt:Generic-Agent a owl:Class;
                  rdfs:comment "This is a generic notion, an agent can be an organization, a person an animal, a software agent, etc";
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:label "Generic Agent";
                  rdfs:subClassOf akts:Temporal-Thing.
akt:Generic-Area-Of-Interest a owl:Class;
                             rdfs:comment "A generic class to specify generic areas for research or business initiatives. For instance, the area in which a project is situated";
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                             rdfs:subClassOf akts:Intangible-Thing.
akt:Geographical-Region a owl:Class;
                        rdfs:comment "'Real' geographical regions";
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Location,
                                        akts:Tangible-Thing.
akt:Geopolitical-Entity a owl:Class;
                        rdfs:comment "A geopolitical entity is a geographical area which is associated with some sort of political structure. For instance, Russia, Italy, The-city-of-Messina, etc. A geopolitical entity can be also seen as an agent - e.g., France declared war to Spain";
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Generic-Agent,
                                        akt:Geographical-Region.
akt:Giving-A-Talk a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf akt:Information-Transfer-Event.
akt:Government a owl:Class;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf akt:Government-Organization.
akt:Government-Organization a owl:Class;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf akt:Non-Profit-Organization.
akt:Graphic-Designer a owl:Class;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf akt:Employee.
akt:Hardware-Platform a owl:Class;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf akt:Hardware-Technology.
akt:Hardware-Technology a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Computing-Technology.
akt:Higher-Educational-Organization a owl:Class;
                                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                    rdfs:subClassOf akt:Educational-Organization.
akt:Human-Computer-Interaction akt:sub-area-of akt:Computing-Research-Area;
                               a akt:Research-Area;
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Hypermedia a akt:Research-Area;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Implemented-System a owl:Class;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Software-Technology.
akt:Incidental-KA akt:sub-area-of akt:Knowledge-Acquisition;
                  a akt:Research-Area;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Industrial-Organization a owl:Class;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf akt:Profit-Organization.
akt:Information-Bearing-Object a owl:Class;
                               rdfs:comment "This notion comes from Cyc.  It is useful to group together all information bearing entities, including video, audio and documents. An information bearing object may have an author (a generic agent) and may be owned by a legal agent. It is a tangible object";
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf [owl:allValuesFrom akt:Legal-Agent ; 
                                                owl:onProperty akt:owned-by ; 
                                                a owl:Restriction],
                                               [owl:allValuesFrom akt:Generic-Agent ; 
                                                owl:onProperty akt:has-author ; 
                                                a owl:Restriction],
                                               akts:Tangible-Thing.
akt:Information-Extraction akt:sub-area-of akt:Language-Engineering;
                           a akt:Research-Area;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Information-Retrieval a akt:Research-Area;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Information-Transfer-Event a owl:Class;
                               rdfs:comment "A generalized transfer in which information is passed from main agent to one or more recipient agents.  Examples include giving a tutorial.";
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf akt:Generalized-Transfer.
akt:Information-Transfer-Medium a owl:Class;
                                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                rdfs:subClassOf akt:Generalised-Means-Of-Transport.
akt:Journal a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf [owl:allValuesFrom akt:Publication ; 
                             owl:onProperty akt:contains-article ; 
                             a owl:Restriction],
                            akt:Composite-Publication,
                            akt:Serial-Publication;
            owl:disjointWith akt:Newspaper,
                             akt:Magazine.
akt:Knowledge-Acquisition akt:sub-area-of akt:Knowledge-Management;
                          a akt:Research-Area;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Lifecycle akt:sub-area-of akt:Knowledge-Management;
                        a akt:Research-Area;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Maintenance akt:sub-area-of akt:Knowledge-Management;
                          a akt:Research-Area;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Management a akt:Research-Area;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Modelling akt:sub-area-of akt:Knowledge-Management;
                        a akt:Research-Area;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Publishing akt:sub-area-of akt:Knowledge-Management;
                         a akt:Research-Area;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Retrieval akt:sub-area-of akt:Knowledge-Management;
                        a akt:Research-Area;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Knowledge-Reuse akt:sub-area-of akt:Knowledge-Management;
                    a akt:Research-Area;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Lady a akt:Appellation;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Language-Engineering a akt:Research-Area;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Learning-Centred-Organization a owl:Class;
                                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                  rdfs:subClassOf akt:Organization.
akt:Learning-Research-Area a akt:Research-Area;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Lecturer-In-Academia a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Academic.
akt:Legal-Agent a owl:Class;
                rdfs:comment "Some agents have legal status: definitely organizations and people, anybody else?";
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:label "Legal Agent";
                rdfs:subClassOf akt:Generic-Agent.
akt:Letter a owl:Class;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Message.
akt:Local-District a owl:Class;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Geopolitical-Entity.
akt:Location a owl:Class;
             rdfs:comment "A generic class for locations.  It includes both real and fantastic places";
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf akts:Tangible-Thing.
akt:MA a akt:Academic-Degree;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:MSc a akt:Academic-Degree;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Magazine a owl:Class;
             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
             rdfs:subClassOf [owl:allValuesFrom akt:Publication ; 
                              owl:onProperty akt:contains-article ; 
                              a owl:Restriction],
                             akt:Composite-Publication,
                             akt:Serial-Publication;
             owl:disjointWith akt:Newspaper,
                              akt:Journal.
akt:Male-Gender a akt:Gender;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Meeting-Taking-Place a owl:Class;
                         rdfs:comment "A meeting type of event. Note that both attendee and organizer have multiple cardinality";
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Social-Gathering.
akt:Message a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Information-Bearing-Object.
akt:Method a owl:Class;
           rdfs:comment "Merrian-Webster has a good set of definitions for a method. They say it is 'a systematic procedure, technique, or mode of inquiry employed by or proper to a particular discipline or art;  a systematic plan followed in presenting material for instruction; a way, technique, or process of or for doing something; a body of skills or techniques'. This is very much also what we mean by method.";
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf [owl:allValuesFrom akt:Organization ; 
                            owl:onProperty akt:owned-by ; 
                            a owl:Restriction],
                           [owl:allValuesFrom akt:Person ; 
                            owl:onProperty akt:has-author ; 
                            a owl:Restriction],
                           akts:Intangible-Thing.
akt:Miss a akt:Appellation;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Mr a akt:Appellation;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Mrs a akt:Appellation;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Ms a akt:Appellation;
       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Multimedia-Designer a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Employee.
akt:Multimedia-Research-Area a akt:Research-Area;
                             rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Municipal-Unit a owl:Class;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Geopolitical-Entity.
akt:News-Item a owl:Class;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
              rdfs:subClassOf akt:Article-In-A-Composite-Publication.
akt:Newspaper a owl:Class;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
              rdfs:subClassOf [owl:allValuesFrom akt:News-Item ; 
                               owl:onProperty akt:contains-news-item ; 
                               a owl:Restriction],
                              akt:Composite-Publication,
                              akt:Periodical-Publication;
              owl:disjointWith akt:Magazine,
                               akt:Journal.
akt:Non-Profit-Organization a owl:Class;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf akt:Organization.
akt:Ontologies akt:sub-area-of akt:Knowledge-Modelling;
               a akt:Research-Area;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Operating-System a owl:Class;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf akt:Implemented-System.
akt:Organization a owl:Class;
                 rdfs:comment "An organization is a type of legal agent";
                 rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                 rdfs:label "Organization";
                 rdfs:subClassOf [owl:allValuesFrom akt:Organization-Unit ; 
                                  owl:onProperty akt:has-sub-unit ; 
                                  a owl:Restriction],
                                 [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                  owl:onProperty akt:has-size ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom akt:Affiliated-Person ; 
                                  owl:onProperty akt:headed-by ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom akt:Organization ; 
                                  owl:onProperty akt:organization-part-of ; 
                                  a owl:Restriction],
                                 akt:Legal-Agent,
                                 [owl:allValuesFrom akt:Organization-Size ; 
                                  owl:onProperty akt:has-size ; 
                                  a owl:Restriction],
                                 [owl:allValuesFrom akt:Affiliated-Person ; 
                                  owl:onProperty akt:affiliated-person ; 
                                  a owl:Restriction].
akt:Organization-Size a owl:Class;
                      rdfs:comment "We use EU guidelines to distinguish between different organization sizes";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:label "Organization Size";
                      rdfs:subClassOf akts:Intangible-Thing;
                      owl:oneOf (akt:very-large-size
                                 akt:large-size
                                 akt:medium-size
                                 akt:small-size
                                 akt:micro-size).
akt:Organization-Unit a owl:Class;
                      rdfs:comment "An organization may have a number of units. Units may themselves have sub-units";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf akt:Generic-Agent.
akt:Organizational-Learning akt:sub-area-of akt:Learning-Research-Area;
                            a akt:Research-Area;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Part-Time a akt:Work-Status;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Partnership a owl:Class;
                rdfs:comment "A partnership is not necessarily a company, e.g. a consultancy firm is not a company";
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf akt:Profit-Organization.
akt:Periodical-Publication a owl:Class;
                           rdfs:comment "This comes from the ontolingua library. A periodical-publication is published regularly, such as once every week.  Strictly speaking, the noun 'periodical' is used by librarians to refer to things published at intervals of greater than a day.  We use the phase periodical-publication to include newspapers and other daily publications, since they share many bibliographic features. The periodicity indicates how often the publication comes out. Note that this is a duration, rather than a time interval. A time interval indicates a specific time interval on the time continuum, so we need to model periodicity as a time quantity";
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                            owl:onProperty akt:has-periodicity ; 
                                            a owl:Restriction],
                                           [owl:allValuesFrom akts:Duration ; 
                                            owl:onProperty akt:has-periodicity ; 
                                            a owl:Restriction],
                                           akt:Serial-Publication.
akt:Permanent-Contract a akt:Employment-Contract-Type;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Person a owl:Class;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akts:Tangible-Thing,
                           akt:Legal-Agent.
akt:PhD a akt:Academic-Degree;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:PhD-Student a owl:Class;
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf [owl:allValuesFrom akt:Higher-Educational-Organization ; 
                                 owl:onProperty akt:studies-at ; 
                                 a owl:Restriction],
                                akt:Student.
akt:Political-Organization a owl:Class;
                           rdfs:comment "An organization which has a political connotation";
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:label "Political Organization";
                           rdfs:subClassOf akt:Organization.
akt:Postal-Address a owl:Class;
                   rdfs:comment "Modified to allow addresses to be given as strings, with no structure";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Address.
akt:Private-Company a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akt:Company.
akt:Problem-Solving-Methods akt:sub-area-of akt:Knowledge-Reuse,
                                            akt:Knowledge-Modelling;
                            a akt:Research-Area;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Proceedings-Paper-Reference a owl:Class;
                                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                rdfs:subClassOf akt:Publication-Reference.
akt:Prof a akt:Appellation;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Professor-In-Academia a owl:Class;
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf akt:Academic.
akt:Profit-Organization a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Organization.
akt:Programming-Environment a owl:Class;
                            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                            rdfs:subClassOf [owl:allValuesFrom akt:Programming-Language ; 
                                             owl:onProperty akt:supports-language ; 
                                             a owl:Restriction],
                                            akt:Implemented-System.
akt:Programming-Language a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Specification-Or-Computing-Language.
akt:Project a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty akt:has-project-member ; 
                             a owl:Restriction],
                            [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty akt:involves-organization ; 
                             a owl:Restriction],
                            [owl:allValuesFrom [owl:unionOf (akt:Event
                                                             akt:Technology
                                                             akt:Method
                                                             akt:Organization
                                                             akt:Information-Bearing-Object) ; 
                                                a owl:Class] ; 
                             owl:onProperty akt:produces-output ; 
                             a owl:Restriction],
                            akt:Activity.
akt:Project-Officer-In-Academia a owl:Class;
                                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                rdfs:subClassOf akt:Academic-Support-Staff.
akt:Public-Company a owl:Class;
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Company.
akt:Publication a owl:Class;
                rdfs:comment "A publication is something which has one or more publication references. A publication can be both an article in a journal or a journal itself. The distinction between publication and publication-reference makes it possible to distinguish between multiple occurrences of the sam publication, for instance in different media";
                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                rdfs:subClassOf [owl:allValuesFrom akt:Publication-Reference ; 
                                 owl:onProperty akt:cites-publication-reference ; 
                                 a owl:Restriction],
                                [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                 owl:onProperty akt:has-publication-reference ; 
                                 a owl:Restriction],
                                [owl:allValuesFrom akt:Publication-Reference ; 
                                 owl:onProperty akt:has-publication-reference ; 
                                 a owl:Restriction],
                                akt:Information-Bearing-Object.
akt:Publication-Reference a owl:Class;
                          rdfs:comment "we have decided that a publication reference is an intangible, abstract information";
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf [owl:allValuesFrom akt:Location ; 
                                           owl:onProperty akt:has-place-of-publication ; 
                                           a owl:Restriction],
                                          [owl:allValuesFrom akts:Calendar-Date ; 
                                           owl:onProperty akt:has-date ; 
                                           a owl:Restriction],
                                          [owl:allValuesFrom akt:Generic-Agent ; 
                                           owl:onProperty akt:has-author ; 
                                           a owl:Restriction],
                                          akt:Abstract-Information.
akt:Publication-Type-Event a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf [owl:allValuesFrom akt:Publication ; 
                                            owl:onProperty akt:event-product ; 
                                            a owl:Restriction],
                                           akt:Event-Involving-Production.
akt:Publishing-House a owl:Class;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf akt:Organization.
akt:R-And-D-Institute a owl:Class;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:subClassOf akt:Learning-Centred-Organization.
akt:R-And-D-Institute-Within-Larger-Institute a owl:Class;
                                              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                              rdfs:subClassOf akt:Organization-Unit,
                                                              akt:R-And-D-Institute.
akt:Reader-In-Academia a owl:Class;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Academic.
akt:Recorded-Audio a owl:Class;
                   rdfs:comment "Any kind of recorded audio, which is tangible.  This also includes a audio file on a machine";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Information-Bearing-Object.
akt:Recorded-Video a owl:Class;
                   rdfs:comment "Any kind of recorded video, which is tangible.  This also includes a mpeg file on a machine";
                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                   rdfs:subClassOf akt:Information-Bearing-Object.
akt:Released-Version a akt:Software-Status;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Research-Area a owl:Class;
                  rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                  rdfs:subClassOf [owl:allValuesFrom akt:Research-Area ; 
                                   owl:onProperty akt:sub-area-of ; 
                                   a owl:Restriction],
                                  akt:Generic-Area-Of-Interest.
akt:Research-Assistant-In-Academia a owl:Class;
                                   rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                   rdfs:subClassOf akt:Researcher-In-Academia.
akt:Research-Fellow-In-Academia a owl:Class;
                                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                rdfs:subClassOf akt:Researcher-In-Academia.
akt:Researcher a owl:Class;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf akt:Working-Person.
akt:Researcher-In-Academia a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf akt:Researcher,
                                           akt:Academic.
akt:School a owl:Class;
           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
           rdfs:subClassOf akt:Educational-Organization.
akt:Scripting-Language a owl:Class;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Specification-Or-Computing-Language.
akt:Secretary a owl:Class;
              rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
              rdfs:subClassOf akt:Employee.
akt:Self-Employed-Person a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Working-Person.
akt:Semantic-Web-Area akt:sub-area-of akt:Web-Research-Area;
                      a akt:Research-Area;
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Sending-An-Email a owl:Class;
                     rdfs:comment "a generalized transfer in which information is passed from main agent to one or more recipient agents.  examples include giving a tutorial.";
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf [owl:hasValue akt:Email-Medium ; 
                                      owl:onProperty akt:information-transfer-medium-used ; 
                                      a owl:Restriction],
                                     [owl:allValuesFrom akt:Email-Message ; 
                                      owl:onProperty akt:information-object-being-transferred ; 
                                      a owl:Restriction],
                                     akt:Information-Transfer-Event.
akt:Senior-Lecturer-In-Academia a owl:Class;
                                rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                rdfs:subClassOf akt:Academic.
akt:Senior-Research-Fellow-In-Academia a owl:Class;
                                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                       rdfs:subClassOf akt:Researcher-In-Academia.
akt:Serial-Publication a owl:Class;
                       rdfs:comment "This used to be called periodical publication.  However, many periodicals do not appear at fixed intervals, which is why librarians refer to them as serials. So, we now use the concept of serial publication and the has-periodicity slot has been removed";
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Publication;
                       owl:unionOf (akt:Journal
                                    akt:Magazine
                                    akt:Newspaper).
akt:Sir a akt:Appellation;
        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Small-Or-Medium-Sized-Organization a owl:Class;
                                       rdfs:comment "SME are important, so we define a class to represent them explicitly. In some case we might not know or we do not want to bother specifying excatly whether something is a small-organization or a medium-organization. Hence, we can just say 'x is a SME' without going into further detail.";
                                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                       rdfs:label "Small or Medium-sized Organization";
                                       rdfs:subClassOf [owl:allValuesFrom [owl:oneOf (akt:medium-size
                                                                                      akt:small-size) ; 
                                                                           a owl:Class] ; 
                                                        owl:onProperty akt:has-size ; 
                                                        a owl:Restriction],
                                                       akt:Organization.
akt:Social-Gathering a owl:Class;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf akt:Event.
akt:Software-Status a owl:Class;
                    rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                    rdfs:subClassOf akts:Intangible-Thing.
akt:Software-Technology a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Computing-Technology.
akt:Software-Visualization akt:sub-area-of akt:Human-Computer-Interaction;
                           a akt:Research-Area;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Specification-Language a owl:Class;
                           rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                           rdfs:subClassOf akt:Specification-Or-Computing-Language.
akt:Specification-Or-Computing-Language a owl:Class;
                                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                                        rdfs:subClassOf akt:Software-Technology.
akt:Student a owl:Class;
            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf [owl:allValuesFrom akt:Educational-Organization-Unit ; 
                             owl:onProperty akt:studies-in-unit ; 
                             a owl:Restriction],
                            [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty akt:studies-in-unit ; 
                             a owl:Restriction],
                            [owl:allValuesFrom akt:Educational-Organization ; 
                             owl:onProperty akt:studies-at ; 
                             a owl:Restriction],
                            [owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                             owl:onProperty akt:studies-at ; 
                             a owl:Restriction],
                            akt:Affiliated-Person.
akt:System-Administrator a owl:Class;
                         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                         rdfs:subClassOf akt:Employee.
akt:Technical-Report-Reference a owl:Class;
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                               rdfs:subClassOf akt:Publication-Reference.
akt:Technology a owl:Class;
               rdfs:comment "By technology we mean engineered applications of science. I guess we are probably confining ourselves to tangible things but as I am not sure I will use thing as the direct superclass - e.g., an algorithm is an intangible thing, but it could be seen as a technology, if we give a broad interpretation of the term";
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf [owl:allValuesFrom akt:Generic-Agent ; 
                                owl:onProperty akt:has-author ; 
                                a owl:Restriction],
                               akts:Thing.
akt:Telepresence-Research-Area a akt:Research-Area;
                               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Temporary-Contract a akt:Employment-Contract-Type;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>.
akt:Thesis-Reference a owl:Class;
                     rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                     rdfs:subClassOf akt:Publication-Reference.
akt:Town a owl:Class;
         rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
         rdfs:subClassOf akt:Municipal-Unit.
akt:Transportation-Device a owl:Class;
                          rdfs:comment "Something tangible designed to transport people, animals, objects from A to B. For instance a bycicle, a car, a boat, etc.";
                          rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                          rdfs:subClassOf akts:Tangible-Thing,
                                          akt:Generalised-Means-Of-Transport.
akt:University a owl:Class;
               rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
               rdfs:subClassOf akt:Higher-Educational-Organization.
akt:University-Faculty a owl:Class;
                       rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                       rdfs:subClassOf akt:Academic-Unit.
