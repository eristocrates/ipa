            rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
            rdfs:subClassOf akt:Municipal-Unit.
akt:Visiting-Researcher a owl:Class;
                        rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                        rdfs:subClassOf akt:Affiliated-Person,
                                        akt:Researcher.
akt:Web-Based-Editor a owl:Class;
