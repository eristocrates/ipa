                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> akt:has-size ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Affiliated-Person ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> akt:headed-by ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Organization ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> akt:organization-part-of ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 akt:Legal-Agent,
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Organization-Size ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> akt:has-size ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#allValuesFrom> akt:Affiliated-Person ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> akt:affiliated-person ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>].
akt:Organization-Size a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "We use EU guidelines to distinguish between different organization sizes";
                      rdfs:isDefinedBy <http://www.aktors.org/ontology/portal>;
                      rdfs:label "Organization Size";
                      rdfs:subClassOf <http://www.aktors.org/ontology/support#Intangible-Thing>;
                      <http://www.w3.org/2002/07/owl#oneOf> (akt:very-large-size
                                                             akt:large-size
                                                             akt:medium-size
                                                             akt:small-size
                                                             akt:micro-size).
akt:Organization-Unit a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "An organization may have a number of units. Units may themselves have sub-units";
