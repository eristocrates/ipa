taxon: <http://purl.org/dc/terms/creator> <http://lod.taxonconcept.org/ontology/people.owl#Peter_J_DeVries>;
       <http://purl.org/dc/terms/description> "Version 0.18 This is the initial vocabulary for Mapping the various taxon classes on the Linked Open Data Cloud"@en;
       <http://purl.org/dc/terms/issued> "2012-05-27";
       <http://purl.org/dc/terms/modified> "2013-03-18";
       <http://purl.org/dc/terms/publisher> <http://lod.taxonconcept.org/ontology/txn.owl#TaxonConcept_Knowledge_Base_Project>;
       <http://purl.org/dc/terms/title> "TaxonMap Ontology"@en;
       <http://purl.org/vocab/vann/preferredNamespacePrefix> "taxon";
       <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/biodiversity/taxon/";
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:comment "Version 0.18 Added those taxon classes I know about, and data type properties for scientific name and authority"@en;
       rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl>;
       rdfs:label "TaxonMap Ontology"@en;
       <http://www.w3.org/2002/07/owl#versionInfo> 0.17.
