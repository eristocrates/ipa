taxon:Cycad a owl:Class;
            rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl>;
            rdfs:label "Cycad";
            rdfs:subClassOf taxon:Plant.
taxon:DataObject a owl:Class;
                 rdfs:isDefinedBy <http://lod.taxonconcept.org/ontology/taxon.owl>;
