                  a rdf:Property;
                  rdfs:comment "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled.";
                  rdfs:label "eventStatus".
shema:events shema:domainIncludes shema:Organization,
                                  shema:Place;
             shema:rangeIncludes shema:Event;
             shema:supersededBy shema:event;
             a rdf:Property;
             rdfs:comment "Upcoming or past events associated with this place or organization.";
             rdfs:label "events".
shema:exampleOfWork <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
                    shema:domainIncludes shema:CreativeWork;
