shema:ReservationStatusType a rdfs:Class;
                            rdfs:comment "Enumerated status values for Reservation.";
                            rdfs:label "ReservationStatusType";
                            rdfs:subClassOf shema:Enumeration.
shema:ReserveAction a rdfs:Class;
