shema:addOn <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
            shema:domainIncludes shema:Offer;
            shema:rangeIncludes shema:Offer;
