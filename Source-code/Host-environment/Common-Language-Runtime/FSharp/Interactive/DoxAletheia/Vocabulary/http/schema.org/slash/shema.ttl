                       rdfs:comment "The release date of a vehicle model (often used to differentiate versions of the same make and model).";
                       rdfs:label "vehicleModelDate".
shema:vehicleSeatingCapacity <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                             shema:domainIncludes shema:Vehicle;
                             shema:rangeIncludes shema:QuantitativeValue,
                                                 shema:Number;
                             a rdf:Property;
                             rdfs:comment """The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.<br/><br/>

Typical unit code(s): C62 for persons.""";
                             rdfs:label "vehicleSeatingCapacity".
shema:vehicleTransmission <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                          shema:domainIncludes shema:Vehicle;
                          shema:rangeIncludes shema:URL,
                                              shema:QualitativeValue,
                                              shema:Text;
                          a rdf:Property;
                          rdfs:comment """The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars).""";
                          rdfs:label "vehicleTransmission".
shema:vendor shema:domainIncludes shema:BuyAction;
             shema:rangeIncludes shema:Person,
                                 shema:Organization;
             shema:supersededBy shema:seller;
             a rdf:Property;
             rdfs:comment "'vendor' is an earlier term for 'seller'.";
             rdfs:label "vendor";
             rdfs:subPropertyOf shema:participant.
shema:version shema:domainIncludes shema:CreativeWork;
              shema:rangeIncludes shema:Number,
                                  shema:Text;
              a rdf:Property;
              rdfs:comment "The version of the CreativeWork embodied by a specified resource.";
              rdfs:label "version".
shema:video shema:domainIncludes shema:CreativeWork;
            shema:rangeIncludes shema:Clip,
                                shema:VideoObject;
            a rdf:Property;
            rdfs:comment "An embedded video object.";
            rdfs:label "video".
shema:videoFormat shema:domainIncludes shema:BroadcastService,
                                       shema:ScreeningEvent,
                                       shema:BroadcastEvent;
                  shema:rangeIncludes shema:Text;
                  a rdf:Property;
                  rdfs:comment "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.).";
                  rdfs:label "videoFormat".
shema:videoFrameSize shema:domainIncludes shema:VideoObject;
                     shema:rangeIncludes shema:Text;
                     a rdf:Property;
                     rdfs:comment "The frame size of the video.";
                     rdfs:label "videoFrameSize".
shema:videoQuality shema:domainIncludes shema:VideoObject;
                   shema:rangeIncludes shema:Text;
                   a rdf:Property;
                   rdfs:comment "The quality of the video.";
                   rdfs:label "videoQuality".
shema:volumeNumber <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
                   shema:domainIncludes shema:PublicationVolume;
                   shema:rangeIncludes shema:Integer,
                                       shema:Text;
                   a rdf:Property;
                   rdfs:comment """Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\".""";
                   rdfs:label "volumeNumber";
                   rdfs:subPropertyOf shema:position;
                   <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/ontology/bibo/volume>.
shema:warranty <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
               shema:domainIncludes shema:Demand,
                                    shema:Offer;
               shema:rangeIncludes shema:WarrantyPromise;
               a rdf:Property;
               rdfs:comment "The warranty promise(s) included in the offer.";
               rdfs:label "warranty".
shema:warrantyPromise shema:domainIncludes shema:SellAction,
                                           shema:BuyAction;
                      shema:rangeIncludes shema:WarrantyPromise;
                      shema:supersededBy shema:warranty;
                      a rdf:Property;
                      rdfs:comment "The warranty promise(s) included in the offer.";
                      rdfs:label "warrantyPromise".
shema:warrantyScope <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
                    shema:domainIncludes shema:WarrantyPromise;
                    shema:rangeIncludes shema:WarrantyScope;
                    a rdf:Property;
                    rdfs:comment "The scope of the warranty promise.";
                    rdfs:label "warrantyScope".
shema:webCheckinTime shema:domainIncludes shema:Flight;
                     shema:rangeIncludes shema:DateTime;
                     a rdf:Property;
                     rdfs:comment "The time when a passenger can check into the flight online.";
                     rdfs:label "webCheckinTime".
shema:weight <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
             shema:domainIncludes shema:Person,
                                  shema:Product;
             shema:rangeIncludes shema:QuantitativeValue;
             a rdf:Property;
             rdfs:comment "The weight of the product or person.";
             rdfs:label "weight".
shema:width shema:domainIncludes shema:Product,
                                 shema:VisualArtwork,
                                 shema:MediaObject;
            shema:rangeIncludes shema:QuantitativeValue,
                                shema:Distance;
            a rdf:Property;
            rdfs:comment "The width of the item.";
            rdfs:label "width".
shema:winner shema:domainIncludes shema:LoseAction;
             shema:rangeIncludes shema:Person;
             a rdf:Property;
             rdfs:comment "A sub property of participant. The winner of the action.";
             rdfs:label "winner";
             rdfs:subPropertyOf shema:participant.
shema:wordCount shema:domainIncludes shema:Article;
                shema:rangeIncludes shema:Integer;
                a rdf:Property;
                rdfs:comment "The number of words in the text of the Article.";
                rdfs:label "wordCount".
shema:workExample <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
                  shema:domainIncludes shema:CreativeWork;
                  shema:inverseOf shema:exampleOfWork;
                  shema:rangeIncludes shema:CreativeWork;
                  a rdf:Property;
                  rdfs:comment "Example/instance/realization/derivation of the concept of this creative work. eg. The paperback edition, first edition, or eBook.";
                  rdfs:label "workExample".
shema:workFeatured shema:domainIncludes shema:Event;
                   shema:rangeIncludes shema:CreativeWork;
                   a rdf:Property;
                   rdfs:comment """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""";
                   rdfs:label "workFeatured".
shema:workHours shema:domainIncludes shema:JobPosting;
                shema:rangeIncludes shema:Text;
                a rdf:Property;
                rdfs:comment "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm).";
                rdfs:label "workHours".
shema:workLocation shema:domainIncludes shema:Person;
                   shema:rangeIncludes shema:ContactPoint,
                                       shema:Place;
                   a rdf:Property;
                   rdfs:comment "A contact location for a person's place of work.";
                   rdfs:label "workLocation";
                   rdfs:subPropertyOf shema:location.
shema:workPerformed shema:domainIncludes shema:Event;
                    shema:rangeIncludes shema:CreativeWork;
                    a rdf:Property;
                    rdfs:comment "A work performed in some event, for example a play performed in a TheaterEvent.";
                    rdfs:label "workPerformed";
                    rdfs:subPropertyOf shema:workFeatured.
shema:workPresented shema:domainIncludes shema:ScreeningEvent;
                    shema:rangeIncludes shema:Movie;
                    a rdf:Property;
                    rdfs:comment "The movie presented during this event.";
                    rdfs:label "workPresented";
                    rdfs:subPropertyOf shema:workFeatured.
shema:worksFor shema:domainIncludes shema:Person;
               shema:rangeIncludes shema:Organization;
               a rdf:Property;
               rdfs:comment "Organizations that the person works for.";
               rdfs:label "worksFor".
shema:worstRating shema:domainIncludes shema:Rating;
                  shema:rangeIncludes shema:Number,
                                      shema:Text;
                  a rdf:Property;
                  rdfs:comment "The lowest value allowed in this rating system. If worstRating is omitted, 1 is assumed.";
                  rdfs:label "worstRating".
shema:xpath <http://purl.org/dc/terms/source> <https://github.com/schemaorg/schemaorg/issues/1389>;
            shema:category "issue-1389";
            shema:domainIncludes shema:WebPageElement,
                                 shema:SpeakableSpecification;
            shema:rangeIncludes shema:XPathType;
            a rdf:Property;
            rdfs:comment """An XPath, e.g. of a <a class=\"localLink\" href=\"http://schema.org/SpeakableSpecification\">SpeakableSpecification</a> or <a class=\"localLink\" href=\"http://schema.org/WebPageElement\">WebPageElement</a>. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\".""";
            rdfs:label "xpath".
shema:yearlyRevenue shema:domainIncludes shema:BusinessAudience;
                    shema:rangeIncludes shema:QuantitativeValue;
                    a rdf:Property;
                    rdfs:comment "The size of the business in annual revenue.";
                    rdfs:label "yearlyRevenue".
shema:yearsInOperation shema:domainIncludes shema:BusinessAudience;
                       shema:rangeIncludes shema:QuantitativeValue;
                       a rdf:Property;
                       rdfs:comment "The age of the business.";
                       rdfs:label "yearsInOperation".
shema:yield shema:domainIncludes shema:HowTo;
            shema:rangeIncludes shema:QuantitativeValue,
                                shema:Text;
            a rdf:Property;
            rdfs:comment "The quantity that results by performing instructions. For example, a paper airplane, 10 personalized candles.";
            rdfs:label "yield".
