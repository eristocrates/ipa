shema:priceSpecification <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
                         shema:domainIncludes shema:TradeAction,
                                              shema:Offer,
                                              shema:Demand;
                         shema:rangeIncludes shema:PriceSpecification;
                         a rdf:Property;
