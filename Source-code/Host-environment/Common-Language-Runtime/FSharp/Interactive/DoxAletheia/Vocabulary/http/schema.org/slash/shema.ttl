shema:dateVehicleFirstRegistered <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                                 shema:domainIncludes shema:Vehicle;
                                 shema:rangeIncludes shema:Date;
