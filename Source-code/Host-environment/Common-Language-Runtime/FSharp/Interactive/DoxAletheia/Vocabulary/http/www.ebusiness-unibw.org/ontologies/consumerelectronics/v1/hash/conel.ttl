conel:AudioFeatures conel:belongsToModule "TV"@en;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Additional audio equipment and abilities."@en;
                    rdfs:isDefinedBy <http://www.ebusiness-unibw.org/ontologies/consumerelectronics/v1>;
                    rdfs:label "Audio Eigenschaften"@de,
                               "Audio Features"@en;
                    rdfs:subClassOf conel:Features.
conel:AudioInput conel:belongsToModule "Camcorder"@en;
                 a conel:Features;
                 rdfs:comment "Defines the support of a computer soundcard driver protocol for digital audio specified by Steinberg, providing a low-latency and high fidelity interface between a software application and a computer's sound card."@en;
                 rdfs:label "Audio input"@en,
                            "Audioeingang"@de.
conel:AudioInterfaceType conel:belongsToModule "MP3Player"@en;
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment """Interface generally refers to an abstraction that an entity provides of itself to the outside (refers to audio output).

(This description is partly based on or reuses content from the Wikipedia article \"Interface (computer science)\" (http://en.wikipedia.org/wiki/Interface_(computer_science)) and is licensed under the GNU Free Documentation License (http://www.gnu.org/copyleft/fdl.html).)"""@en;
                         rdfs:isDefinedBy <http://www.ebusiness-unibw.org/ontologies/consumerelectronics/v1>;
                         rdfs:label "Audio Interface Type"@en,
                                    "Audioschnittstellentyp"@de;
                         rdfs:subClassOf <http://purl.org/goodrelations/v1#QualitativeValue>.
conel:AutoChannelSearch conel:belongsToModule "TV"@en;
                        a conel:GeneralFeatures;
                        rdfs:comment "Gives an indication of preprogrammed channels for the user of a television so that he does not need to programm it himself."@en;
                        rdfs:label "Automatischer Sendersuchlauf"@de,
                                   "Auto channel search"@en.
conel:AutoVolumeLeveller conel:belongsToModule "TV"@en;
                         a conel:AudioFeatures;
                         rdfs:comment "Levels the audio volume of televisions automatically so that undesired peaks in the sound can be reduced."@en;
                         rdfs:label "Automatische Lautstärkenanpassung"@de,
                                    "Auto volume leveller"@en.
conel:AutoWhiteBalance conel:belongsToModule "Camcorder"@en;
                       a conel:WhiteBalance;
                       rdfs:comment "Ability to adapt of different adjustments of the intensities of the colors."@en;
                       rdfs:label "Automatischer Weißabgleich"@de,
                                  "Auto white balance"@en.
conel:AutomaticPictureStabilizer conel:belongsToModule "DigitalCamera, Camcorder"@en;
                                 a conel:Features;
                                 rdfs:comment "A device used to stabilize a picture in order to keep it in a steady position."@en;
                                 rdfs:label "Automatischer Bildstabilisator"@de,
                                            "Automatic picture stabilizer"@en.
