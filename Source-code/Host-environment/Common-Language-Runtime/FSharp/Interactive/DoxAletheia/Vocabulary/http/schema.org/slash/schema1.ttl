                                        schema1:Organization;
                  a rdf:Property;
                  rdfs:comment "A sub property of participant. The participant who is at the receiving end of the action.";
                  rdfs:label "recipient";
                  rdfs:subPropertyOf schema1:participant.
schema1:recordLabel <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
                    schema1:domainIncludes schema1:MusicRelease;
                    schema1:rangeIncludes schema1:Organization;
                    a rdf:Property;
                    rdfs:comment "The label that issued the release.";
                    rdfs:label "recordLabel";
                    <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/ontology/mo/label>.
schema1:recordedAs <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
                   schema1:domainIncludes schema1:MusicComposition;
                   schema1:inverseOf schema1:recordingOf;
                   schema1:rangeIncludes schema1:MusicRecording;
                   a rdf:Property;
                   rdfs:comment "An audio recording of the work.";
                   rdfs:label "recordedAs".
schema1:recordedAt schema1:domainIncludes schema1:CreativeWork;
                   schema1:inverseOf schema1:recordedIn;
                   schema1:rangeIncludes schema1:Event;
                   a rdf:Property;
                   rdfs:comment "The Event where the CreativeWork was recorded. The CreativeWork may capture all or part of the event.";
                   rdfs:label "recordedAt".
schema1:recordedIn schema1:domainIncludes schema1:Event;
                   schema1:inverseOf schema1:recordedAt;
                   schema1:rangeIncludes schema1:CreativeWork;
                   a rdf:Property;
                   rdfs:comment "The CreativeWork that captured all or part of this Event.";
                   rdfs:label "recordedIn".
schema1:recordingOf <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
                    schema1:domainIncludes schema1:MusicRecording;
                    schema1:inverseOf schema1:recordedAs;
                    schema1:rangeIncludes schema1:MusicComposition;
                    a rdf:Property;
                    rdfs:comment "The composition this track is a recording of.";
                    rdfs:label "recordingOf".
schema1:referenceQuantity <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>,
                                                            <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsProperties>;
                          schema1:domainIncludes schema1:UnitPriceSpecification;
                          schema1:rangeIncludes schema1:QuantitativeValue;
                          a rdf:Property;
                          rdfs:comment "The reference quantity for which a certain price applies, e.g. 1 EUR per 4 kWh of electricity. This property is a replacement for unitOfMeasurement for the advanced cases where the price does not relate to a standard unit.";
                          rdfs:label "referenceQuantity".
schema1:referencesOrder schema1:domainIncludes schema1:Invoice;
                        schema1:rangeIncludes schema1:Order;
                        a rdf:Property;
                        rdfs:comment "The Order(s) related to this Invoice. One or more Orders may be combined into a single Invoice.";
                        rdfs:label "referencesOrder".
schema1:regionsAllowed schema1:domainIncludes schema1:MediaObject;
                       schema1:rangeIncludes schema1:Place;
                       a rdf:Property;
                       rdfs:comment """The regions where the media is allowed. If not specified, then it's assumed to be allowed everywhere. Specify the countries in <a href=\"http://en.wikipedia.org/wiki/ISO_3166\">ISO 3166 format</a>.""";
                       rdfs:label "regionsAllowed".
schema1:relatedLink schema1:domainIncludes schema1:WebPage;
                    schema1:rangeIncludes schema1:URL;
                    a rdf:Property;
