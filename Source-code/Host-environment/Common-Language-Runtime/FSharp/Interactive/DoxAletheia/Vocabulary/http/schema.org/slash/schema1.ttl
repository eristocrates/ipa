                      rdfs:label "datePublished".
schema1:dateRead schema1:domainIncludes schema1:Message;
                 schema1:rangeIncludes schema1:Date,
                                       schema1:DateTime;
                 a rdf:Property;
                 rdfs:comment "The date/time at which the message has been read by the recipient if a single recipient exists.";
                 rdfs:label "dateRead".
schema1:dateReceived schema1:domainIncludes schema1:Message;
                     schema1:rangeIncludes schema1:DateTime;
