                                    rdfs:label "vehicleIdentificationNumber";
                                    rdfs:subPropertyOf schema1:serialNumber.
schema1:vehicleInteriorColor <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                             schema1:domainIncludes schema1:Vehicle;
                             schema1:rangeIncludes schema1:Text;
                             a rdf:Property;
                             rdfs:comment "The color or color combination of the interior of the vehicle.";
                             rdfs:label "vehicleInteriorColor".
schema1:vehicleInteriorType <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                            schema1:domainIncludes schema1:Vehicle;
                            schema1:rangeIncludes schema1:Text;
                            a rdf:Property;
                            rdfs:comment "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.). While most interior types are characterized by the material used, an interior type can also be based on vehicle usage or target audience.";
                            rdfs:label "vehicleInteriorType".
schema1:vehicleModelDate <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                         schema1:domainIncludes schema1:Vehicle;
                         schema1:rangeIncludes schema1:Date;
                         a rdf:Property;
                         rdfs:comment "The release date of a vehicle model (often used to differentiate versions of the same make and model).";
                         rdfs:label "vehicleModelDate".
schema1:vehicleSeatingCapacity <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                               schema1:domainIncludes schema1:Vehicle;
                               schema1:rangeIncludes schema1:QuantitativeValue,
                                                     schema1:Number;
                               a rdf:Property;
                               rdfs:comment """The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.<br/><br/>

Typical unit code(s): C62 for persons.""";
                               rdfs:label "vehicleSeatingCapacity".
schema1:vehicleTransmission <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#Automotive_Ontology_Working_Group>;
                            schema1:domainIncludes schema1:Vehicle;
                            schema1:rangeIncludes schema1:URL,
                                                  schema1:QualitativeValue,
                                                  schema1:Text;
                            a rdf:Property;
                            rdfs:comment """The type of component used for transmitting the power from a rotating power source to the wheels or other relevant component(s) (\"gearbox\" for cars).""";
                            rdfs:label "vehicleTransmission".
schema1:vendor schema1:domainIncludes schema1:BuyAction;
               schema1:rangeIncludes schema1:Person,
                                     schema1:Organization;
               schema1:supersededBy schema1:seller;
               a rdf:Property;
               rdfs:comment "'vendor' is an earlier term for 'seller'.";
               rdfs:label "vendor";
               rdfs:subPropertyOf schema1:participant.
schema1:version schema1:domainIncludes schema1:CreativeWork;
                schema1:rangeIncludes schema1:Number,
                                      schema1:Text;
                a rdf:Property;
                rdfs:comment "The version of the CreativeWork embodied by a specified resource.";
                rdfs:label "version".
schema1:video schema1:domainIncludes schema1:CreativeWork;
              schema1:rangeIncludes schema1:Clip,
                                    schema1:VideoObject;
              a rdf:Property;
              rdfs:comment "An embedded video object.";
              rdfs:label "video".
schema1:videoFormat schema1:domainIncludes schema1:BroadcastService,
                                           schema1:ScreeningEvent,
                                           schema1:BroadcastEvent;
                    schema1:rangeIncludes schema1:Text;
                    a rdf:Property;
                    rdfs:comment "The type of screening or video broadcast used (e.g. IMAX, 3D, SD, HD, etc.).";
                    rdfs:label "videoFormat".
schema1:videoFrameSize schema1:domainIncludes schema1:VideoObject;
                       schema1:rangeIncludes schema1:Text;
                       a rdf:Property;
                       rdfs:comment "The frame size of the video.";
                       rdfs:label "videoFrameSize".
schema1:videoQuality schema1:domainIncludes schema1:VideoObject;
                     schema1:rangeIncludes schema1:Text;
                     a rdf:Property;
                     rdfs:comment "The quality of the video.";
                     rdfs:label "videoQuality".
schema1:volumeNumber <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
                     schema1:domainIncludes schema1:PublicationVolume;
                     schema1:rangeIncludes schema1:Integer,
                                           schema1:Text;
                     a rdf:Property;
                     rdfs:comment """Identifies the volume of publication or multi-part work; for example, \"iii\" or \"2\".""";
                     rdfs:label "volumeNumber";
                     rdfs:subPropertyOf schema1:position;
                     <http://www.w3.org/2002/07/owl#equivalentProperty> <http://purl.org/ontology/bibo/volume>.
schema1:warranty <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
                 schema1:domainIncludes schema1:Demand,
                                        schema1:Offer;
                 schema1:rangeIncludes schema1:WarrantyPromise;
                 a rdf:Property;
                 rdfs:comment "The warranty promise(s) included in the offer.";
                 rdfs:label "warranty".
schema1:warrantyPromise schema1:domainIncludes schema1:SellAction,
                                               schema1:BuyAction;
                        schema1:rangeIncludes schema1:WarrantyPromise;
                        schema1:supersededBy schema1:warranty;
                        a rdf:Property;
                        rdfs:comment "The warranty promise(s) included in the offer.";
                        rdfs:label "warrantyPromise".
schema1:warrantyScope <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
                      schema1:domainIncludes schema1:WarrantyPromise;
                      schema1:rangeIncludes schema1:WarrantyScope;
                      a rdf:Property;
                      rdfs:comment "The scope of the warranty promise.";
                      rdfs:label "warrantyScope".
schema1:webCheckinTime schema1:domainIncludes schema1:Flight;
                       schema1:rangeIncludes schema1:DateTime;
                       a rdf:Property;
                       rdfs:comment "The time when a passenger can check into the flight online.";
                       rdfs:label "webCheckinTime".
schema1:weight <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
               schema1:domainIncludes schema1:Person,
                                      schema1:Product;
               schema1:rangeIncludes schema1:QuantitativeValue;
               a rdf:Property;
               rdfs:comment "The weight of the product or person.";
               rdfs:label "weight".
schema1:width schema1:domainIncludes schema1:Product,
                                     schema1:VisualArtwork,
                                     schema1:MediaObject;
              schema1:rangeIncludes schema1:QuantitativeValue,
                                    schema1:Distance;
              a rdf:Property;
              rdfs:comment "The width of the item.";
              rdfs:label "width".
schema1:winner schema1:domainIncludes schema1:LoseAction;
               schema1:rangeIncludes schema1:Person;
               a rdf:Property;
               rdfs:comment "A sub property of participant. The winner of the action.";
               rdfs:label "winner";
               rdfs:subPropertyOf schema1:participant.
schema1:wordCount schema1:domainIncludes schema1:Article;
                  schema1:rangeIncludes schema1:Integer;
                  a rdf:Property;
                  rdfs:comment "The number of words in the text of the Article.";
                  rdfs:label "wordCount".
schema1:workExample <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
                    schema1:domainIncludes schema1:CreativeWork;
                    schema1:inverseOf schema1:exampleOfWork;
                    schema1:rangeIncludes schema1:CreativeWork;
                    a rdf:Property;
                    rdfs:comment "Example/instance/realization/derivation of the concept of this creative work. eg. The paperback edition, first edition, or eBook.";
                    rdfs:label "workExample".
schema1:workFeatured schema1:domainIncludes schema1:Event;
                     schema1:rangeIncludes schema1:CreativeWork;
                     a rdf:Property;
                     rdfs:comment """A work featured in some event, e.g. exhibited in an ExhibitionEvent.
       Specific subproperties are available for workPerformed (e.g. a play), or a workPresented (a Movie at a ScreeningEvent).""";
                     rdfs:label "workFeatured".
schema1:workHours schema1:domainIncludes schema1:JobPosting;
                  schema1:rangeIncludes schema1:Text;
                  a rdf:Property;
                  rdfs:comment "The typical working hours for this job (e.g. 1st shift, night shift, 8am-5pm).";
                  rdfs:label "workHours".
schema1:workLocation schema1:domainIncludes schema1:Person;
                     schema1:rangeIncludes schema1:ContactPoint,
                                           schema1:Place;
                     a rdf:Property;
                     rdfs:comment "A contact location for a person's place of work.";
                     rdfs:label "workLocation";
                     rdfs:subPropertyOf schema1:location.
schema1:workPerformed schema1:domainIncludes schema1:Event;
                      schema1:rangeIncludes schema1:CreativeWork;
                      a rdf:Property;
                      rdfs:comment "A work performed in some event, for example a play performed in a TheaterEvent.";
                      rdfs:label "workPerformed";
                      rdfs:subPropertyOf schema1:workFeatured.
schema1:workPresented schema1:domainIncludes schema1:ScreeningEvent;
                      schema1:rangeIncludes schema1:Movie;
                      a rdf:Property;
                      rdfs:comment "The movie presented during this event.";
                      rdfs:label "workPresented";
                      rdfs:subPropertyOf schema1:workFeatured.
schema1:worksFor schema1:domainIncludes schema1:Person;
                 schema1:rangeIncludes schema1:Organization;
                 a rdf:Property;
                 rdfs:comment "Organizations that the person works for.";
                 rdfs:label "worksFor".
schema1:worstRating schema1:domainIncludes schema1:Rating;
                    schema1:rangeIncludes schema1:Number,
                                          schema1:Text;
                    a rdf:Property;
                    rdfs:comment "The lowest value allowed in this rating system. If worstRating is omitted, 1 is assumed.";
                    rdfs:label "worstRating".
schema1:xpath <http://purl.org/dc/terms/source> <https://github.com/schemaorg/schemaorg/issues/1389>;
              schema1:category "issue-1389";
              schema1:domainIncludes schema1:WebPageElement,
                                     schema1:SpeakableSpecification;
              schema1:rangeIncludes schema1:XPathType;
              a rdf:Property;
              rdfs:comment """An XPath, e.g. of a <a class=\"localLink\" href=\"http://schema.org/SpeakableSpecification\">SpeakableSpecification</a> or <a class=\"localLink\" href=\"http://schema.org/WebPageElement\">WebPageElement</a>. In the latter case, multiple matches within a page can constitute a single conceptual \"Web page element\".""";
              rdfs:label "xpath".
schema1:yearlyRevenue schema1:domainIncludes schema1:BusinessAudience;
                      schema1:rangeIncludes schema1:QuantitativeValue;
                      a rdf:Property;
                      rdfs:comment "The size of the business in annual revenue.";
                      rdfs:label "yearlyRevenue".
schema1:yearsInOperation schema1:domainIncludes schema1:BusinessAudience;
                         schema1:rangeIncludes schema1:QuantitativeValue;
                         a rdf:Property;
                         rdfs:comment "The age of the business.";
                         rdfs:label "yearsInOperation".
schema1:yield schema1:domainIncludes schema1:HowTo;
              schema1:rangeIncludes schema1:QuantitativeValue,
                                    schema1:Text;
              a rdf:Property;
              rdfs:comment "The quantity that results by performing instructions. For example, a paper airplane, 10 personalized candles.";
              rdfs:label "yield".
