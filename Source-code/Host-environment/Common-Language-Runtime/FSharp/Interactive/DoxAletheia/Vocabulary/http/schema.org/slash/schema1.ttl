                                 schema1:EmergencyService,
                                 schema1:MedicalOrganization.
schema1:Hostel a rdfs:Class;
               rdfs:comment """A hostel - cheap accommodation, often in shared dormitories.
<br /><br />
See also the <a href=\"/docs/hotels.html\">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.""";
               rdfs:label "Hostel";
               rdfs:subClassOf schema1:LodgingBusiness.
schema1:Hotel <http://purl.org/dc/terms/source> <https://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#STI_Accommodation_Ontology>;
              a rdfs:Class;
              rdfs:comment """A hotel is an establishment that provides lodging paid on a short-term basis (Source: Wikipedia, the free encyclopedia, see http://en.wikipedia.org/wiki/Hotel).
<br /><br />
See also the <a href=\"/docs/hotels.html\">dedicated document on the use of schema.org for marking up hotels and other forms of accommodations</a>.""";
              rdfs:label "Hotel";
              rdfs:subClassOf schema1:LodgingBusiness.
