schema1:offers <http://purl.org/dc/terms/source> <https://github.com/schemaorg/schemaorg/issues/2289>;
               schema1:category "issue-2289";
               schema1:domainIncludes schema1:Trip,
                                      schema1:Event,
                                      schema1:AggregateOffer,
                                      schema1:CreativeWork,
                                      schema1:Service,
                                      schema1:MenuItem,
