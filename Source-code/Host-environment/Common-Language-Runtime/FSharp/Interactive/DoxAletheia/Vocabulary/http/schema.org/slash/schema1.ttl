                                      a rdfs:Class;
                                      rdfs:comment "A statistical distribution of values.";
                                      rdfs:label "QuantitativeValueDistribution";
                                      rdfs:subClassOf schema1:StructuredValue.
schema1:Quantity a rdfs:Class;
                 rdfs:comment "Quantities such as distance, time, mass, weight, etc. Particular instances of say Mass are entities like '3 Kg' or '4 milligrams'.";
                 rdfs:label "Quantity";
                 rdfs:subClassOf schema1:Intangible.
schema1:Question <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_QAStackExchange>;
