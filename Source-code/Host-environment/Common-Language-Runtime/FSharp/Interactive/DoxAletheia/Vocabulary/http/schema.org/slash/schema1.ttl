                    rdfs:label "relatedLink".
schema1:relatedTo schema1:domainIncludes schema1:Person;
                  schema1:rangeIncludes schema1:Person;
                  a rdf:Property;
                  rdfs:comment "The most generic familial relation.";
                  rdfs:label "relatedTo".
schema1:releaseDate <http://purl.org/dc/terms/source> <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
