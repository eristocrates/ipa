@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix infor: <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> "what are the physical realizations of this information object?, what information objects are realized by this physical object?"^^rdf:PlainLiteral;
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> "This CP allows designers to model information objects and their realizations. This allows to reason about physical objects and the information they realize, by keeping them distinguished.";
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> "To represent information objects and physical entities that realize them.";
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> "It is specialized by multimedia data segment decomposition.";
                                                                          <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> "John Lennon’s biography I Me Mine has been realized in a limited 2000-copy edition.";
                                                                          a <http://www.w3.org/2002/07/owl#Ontology>;
                                                                          rdfs:label "information realization"^^rdf:PlainLiteral;
                                                                          <http://www.w3.org/2002/07/owl#imports> <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                                          <http://www.w3.org/2002/07/owl#versionInfo> "Created by Aldo Gangemi and Valentina Presutti",
                                                                                                                      "1.1 added rdfs:isDefinedBy for all named entities".
infor:InformationObject a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "A piece of information, such as a musical composition, a text, a word, a picture, independently from how it is concretely realized.";
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                        rdfs:label "Information object"@en;
                        rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> infor:InformationRealization ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> infor:isRealizedBy ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#allValuesFrom> infor:InformationRealization ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> infor:isRealizedBy ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> infor:InformationRealization ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> infor:isRealizedBy ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>],
                                        [<http://www.w3.org/2002/07/owl#allValuesFrom> infor:InformationRealization ; 
                                         <http://www.w3.org/2002/07/owl#onProperty> infor:isRealizedBy ; 
                                         a <http://www.w3.org/2002/07/owl#Restriction>];
                        <http://www.w3.org/2002/07/owl#disjointWith> infor:InformationRealization.
infor:InformationRealization a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "A concrete realization of an information object, e.g. the written document containing the text of a law.";
                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                             rdfs:label "Information realization"@en;
                             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> infor:InformationObject ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> infor:realizes ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>],
                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> infor:InformationObject ; 
                                              <http://www.w3.org/2002/07/owl#onProperty> infor:realizes ; 
                                              a <http://www.w3.org/2002/07/owl#Restriction>].
infor:isRealizedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A relation between an information realization and an information object, e.g. the paper copy of the Italian Constitution realizes the text of the Constitution.";
                   rdfs:domain infor:InformationObject;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                   rdfs:label "is realized by"@en;
                   rdfs:range infor:InformationRealization;
                   <http://www.w3.org/2002/07/owl#inverseOf> infor:realizes.
infor:realizes a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "A relation between an information realization and an information object, e.g. the paper copy of the Italian Constitution realizes the text of the Constitution.";
               rdfs:domain infor:InformationRealization;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
               rdfs:label "realizes"@en;
               rdfs:range infor:InformationObject.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#coversRequirements> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#extractedFrom> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasConsequences> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#hasIntent> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#relatedCPs> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#scenarios> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:comment a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:isDefinedBy a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
rdfs:label a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://www.w3.org/2002/07/owl#versionInfo> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
