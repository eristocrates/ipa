@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix infor: <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl#>.

<http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl> cpa:coversRequirements "what are the physical realizations of this information object?, what information objects are realized by this physical object?"^^rdf:PlainLiteral;
                                                                          cpa:extractedFrom "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"^^rdf:PlainLiteral;
                                                                          cpa:hasConsequences "This CP allows designers to model information objects and their realizations. This allows to reason about physical objects and the information they realize, by keeping them distinguished.";
                                                                          cpa:hasIntent "To represent information objects and physical entities that realize them.";
                                                                          cpa:relatedCPs "It is specialized by multimedia data segment decomposition.";
                                                                          cpa:scenarios "John Lennon’s biography I Me Mine has been realized in a limited 2000-copy edition.";
                                                                          a owl:Ontology;
                                                                          rdfs:label "information realization"^^rdf:PlainLiteral;
                                                                          owl:imports <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl>;
                                                                          owl:versionInfo "Created by Aldo Gangemi and Valentina Presutti",
                                                                                          "1.1 added rdfs:isDefinedBy for all named entities".
infor:InformationObject a owl:Class;
                        rdfs:comment "A piece of information, such as a musical composition, a text, a word, a picture, independently from how it is concretely realized.";
                        rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                        rdfs:label "Information object"@en;
                        rdfs:subClassOf [owl:someValuesFrom infor:InformationRealization ; 
                                         owl:onProperty infor:isRealizedBy ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom infor:InformationRealization ; 
                                         owl:onProperty infor:isRealizedBy ; 
                                         a owl:Restriction],
                                        [owl:someValuesFrom infor:InformationRealization ; 
                                         owl:onProperty infor:isRealizedBy ; 
                                         a owl:Restriction],
                                        [owl:allValuesFrom infor:InformationRealization ; 
                                         owl:onProperty infor:isRealizedBy ; 
                                         a owl:Restriction];
                        owl:disjointWith infor:InformationRealization.
infor:InformationRealization a owl:Class;
                             rdfs:comment "A concrete realization of an information object, e.g. the written document containing the text of a law.";
                             rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                             rdfs:label "Information realization"@en;
                             rdfs:subClassOf [owl:someValuesFrom infor:InformationObject ; 
                                              owl:onProperty infor:realizes ; 
                                              a owl:Restriction],
                                             [owl:someValuesFrom infor:InformationObject ; 
                                              owl:onProperty infor:realizes ; 
                                              a owl:Restriction].
infor:isRealizedBy a owl:ObjectProperty;
                   rdfs:comment "A relation between an information realization and an information object, e.g. the paper copy of the Italian Constitution realizes the text of the Constitution.";
                   rdfs:domain infor:InformationObject;
                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
                   rdfs:label "is realized by"@en;
                   rdfs:range infor:InformationRealization;
                   owl:inverseOf infor:realizes.
infor:realizes a owl:ObjectProperty;
               rdfs:comment "A relation between an information realization and an information object, e.g. the paper copy of the Italian Constitution realizes the text of the Constitution.";
               rdfs:domain infor:InformationRealization;
               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/informationrealization.owl>;
               rdfs:label "realizes"@en;
               rdfs:range infor:InformationObject.
cpa:coversRequirements a owl:AnnotationProperty.
cpa:extractedFrom a owl:AnnotationProperty.
cpa:hasConsequences a owl:AnnotationProperty.
cpa:hasIntent a owl:AnnotationProperty.
cpa:relatedCPs a owl:AnnotationProperty.
cpa:scenarios a owl:AnnotationProperty.
rdfs:comment a owl:AnnotationProperty.
rdfs:isDefinedBy a owl:AnnotationProperty.
rdfs:label a owl:AnnotationProperty.
owl:versionInfo a owl:AnnotationProperty.
