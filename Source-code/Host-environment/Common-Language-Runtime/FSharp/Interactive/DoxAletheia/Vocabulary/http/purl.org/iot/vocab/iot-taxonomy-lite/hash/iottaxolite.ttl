                            rdfs:label "Heart Beat Sensor"@en;
                            rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:Heating a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An actuator to automatically switch on/off the heating."@en;
                    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                    rdfs:label "Heating Actuating Device"@en;
                    rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:Hertz a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The SI unit of frequency, equal to one cycle per second."@en;
                  rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                  rdfs:label "Hertz"@en;
                  rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:Hour a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Hour of the day."@en;
                 rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                 rdfs:label "Hour"@en;
                 rdfs:seeAlso <http://sweet.jpl.nasa.gov/ontology/units.owl#hour>;
                 rdfs:subClassOf iottaxolite:SecondTime.
iottaxolite:HouseholdApplianceTemperature a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment "Measure of Household Appliance Temperature."@en;
                                          rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
