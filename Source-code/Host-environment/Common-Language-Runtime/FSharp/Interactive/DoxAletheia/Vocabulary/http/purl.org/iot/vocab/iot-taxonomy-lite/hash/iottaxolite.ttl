                                  rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                  rdfs:label " Human Presence Detector"@en;
                                  rdfs:subClassOf iottaxolite:PresenceDetector.
iottaxolite:Humidity a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A quantity representing the amount of water vapour in the atmosphere or in a gas."@en;
                     rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                     rdfs:label "Humidity"@en;
                     rdfs:seeAlso <http://paul.staroch.name/thesis/SmartHomeWeather.owl#Humidity>,
                                  <http://openiot.eu/ontology/ns/AtmosphereHumidity>,
                                  <http://elite.polito.it/ontologies/dogont.owl#HumidityMeasurementMNotification>;
                     rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:HumiditySensor a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Humidity sensor or hygrometer is an instrument used for measuring the moisture concent in the environment."@en;
                           rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                           rdfs:label "Humidity Sensor"@en;
                           rdfs:seeAlso <http://purl.oclc.org/NET/ssnx/meteo/aws#HumiditySensor>;
                           rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:Hydrophone a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A hydrophone is a microphone designed to be used underwater for recording or listening to underwater sound."@en;
                       rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                       rdfs:label "Hydrophone"@en;
                       rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:IEEE802154InterfaceEnergyMeter a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment "Sensor that measures the power consumption of the IEEE802.15.4 interface nodes."@en;
                                           rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                           rdfs:label "IEEE802.15.4 Interface Energy Meter"@en;
                                           rdfs:subClassOf iottaxolite:EnergyMeter.
iottaxolite:INR <http://purl.org/dc/elements/1.1/description> """A system established by the World Health Organization (WHO) and the International Committee on Thrombosis and Hemostasis for reporting the results of blood coagulation (clotting) tests. Abbreviated INR. Under the INR system, all results are standardized. For example, a person taking the anticoagulant warfarin (brand name: Coumadin) would regularly have blood tested to measure the INR. The INR permits patients on anticoagulants to travel and obtain comparable test results wherever they are.
        Medical Definition of International normalized ratio, MedicineNet"""@en;
                a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                rdfs:label "International Normalized Ratio"@en;
                rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:IdentifyOutlierObservsations a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:comment "Purpose to identify if an observation is outlier or not."@en;
                                         rdfs:label "Identify Outlier Observsations"@en;
                                         rdfs:subClassOf <http://purl.org/adaptcentre/openscience/ontologies/consent#Purpose>.
iottaxolite:Illuminance a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Illuminance is the total luminous flux incident on a surface, per unit area."@en;
                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                        rdfs:label "Illuminance"@en;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:ImageSensor a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Sensor that detects and conveys the information that constitutes an image."@en;
                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                        rdfs:label "Image Sensor"@en;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:Inch a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Length in inches."@en;
                 rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                 rdfs:label "Inch"@en;
                 rdfs:subClassOf iottaxolite:Metre.
iottaxolite:Index a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "Arbitrary indirect reference which should be translated into meaningful measurements by using the corresponding decoding algorithm detailed in the resource description. In this case the returned values can only take certain values from a finite set."@en;
                  rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                  rdfs:label "Index"@en;
                  rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:IntDlLatency a <http://www.w3.org/2002/07/owl#Class>;
