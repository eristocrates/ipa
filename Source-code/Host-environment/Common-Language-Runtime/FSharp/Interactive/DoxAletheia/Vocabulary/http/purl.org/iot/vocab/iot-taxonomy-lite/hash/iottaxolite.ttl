                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                               rdfs:label "Watt Per Square Metre, Watt Per Square Meter"@en;
                               rdfs:seeAlso "http://purl.oclc.org/NET/ssnx/qu/unit#wattPerSquareMetre";
                               rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:Weather a <http://www.w3.org/2002/07/owl#Class>;
