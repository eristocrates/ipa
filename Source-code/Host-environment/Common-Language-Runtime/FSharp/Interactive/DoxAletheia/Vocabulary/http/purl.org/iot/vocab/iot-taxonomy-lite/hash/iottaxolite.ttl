@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix iottaxolite: <http://purl.org/iot/vocab/iot-taxonomy-lite#>.

<http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Tag> a <http://www.w3.org/2002/07/owl#Class>;
                                                    rdfs:comment """
        Device that can redirect to a resource with information (i.e. RFID, NFC, QR-codes, bar-codes).
        """@en;
                                                    rdfs:label "Tagging Device"@en;
                                                    rdfs:subClassOf <http://www.w3.org/ns/ssn/System>.
<http://purl.oclc.org/NET/ssnx/qu/qu#Unit> a <http://www.w3.org/2002/07/owl#Class>;
                                           rdfs:comment """A Unit is an abstract classifier that represents the [VIM] concept of \"measurement unit\" that is defined as \"real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the two quantities as a number.\"""";
                                           rdfs:isDefinedBy "http://purl.oclc.org/NET/ssnx/qu";
                                           rdfs:label "Unit";
                                           rdfs:seeAlso "http://www.omgsysml.org/qudv#Unit".
<http://purl.org/adaptcentre/openscience/ontologies/consent#Action> a <http://www.w3.org/2002/07/owl#Class>;
                                                                    rdfs:comment "'action' defines what action is permitted by the consent.",
                                                                                 "'action' is used to identify what action is permitted by the consent.";
                                                                    rdfs:label "Action".
<http://purl.org/adaptcentre/openscience/ontologies/consent#Purpose> a <http://www.w3.org/2002/07/owl#Class>;
                                                                     rdfs:comment "'purpose' indicates for what purpose the action is allowed by the consent on the data";
                                                                     rdfs:label "Purpose".
<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/rights> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/issued> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
iottaxolite: <http://purl.org/dc/elements/1.1/contributor> "Rachit Agarwal, Inria, Paris"@en,
                                                           "Tarek Elsaleh, UNIS, Surrey"@en,
                                                           "Elias Tragos, UCD, Dublin"@en;
             <http://purl.org/dc/elements/1.1/description> """The IoT-Taxonomy-lite is adapted from M3-lite taxonomy. This taxonomy is refactored and defines many other concepts such as subclasses of Feature-of-Interest and Quality-of-Observation. 

        We further acknowledge authors of M3-lite for the initial work.

        Please report any errors to rachit.agarwal@inria.fr

        """@en;
             <http://purl.org/dc/elements/1.1/rights> "Creative Commons Attribution 4.0 International";
             <http://purl.org/dc/elements/1.1/title> "The IoTTaxonomy-lite Taxonomy"@en;
             <http://purl.org/dc/terms/issued> "2019-09-07"^^xsd:date;
             <http://purl.org/dc/terms/modified> "2019-09-07"^^xsd:date;
             <http://purl.org/vocab/vann/preferredNamespacePrefix> "iot-taxonomy-lite";
             <http://purl.org/vocab/vann/preferredNamespaceUri> "http://purl.org/iot/vocab/iot-taxonomy-lite#";
             a <http://www.w3.org/2002/07/owl#Ontology>;
             rdfs:comment "The IoT-Taxonomy-lite is adapted from M3-lite taxonomy. This taxonomy is refactored and defines many other concepts such as subclasses of Feature-of-Interest and Quality-of-Observation. "@en;
             <http://www.w3.org/2002/07/owl#versionInfo> 1 .
iottaxolite:ABS a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The ABS (Anti-lock Braking System) receives information from ABS computer to control the pressure on the breaks, This helps the wheels not to get locked up, it adjust the break pressure and prevents the wheels from locking. (Definition Source Google)."@en;
                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                rdfs:label "ABS (Anti-lock Braking System) Actuating Device"@en;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:AccInitialERabEstabSuccRate a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "Initial E-UTRAN Radio Access Bearer establishment success rate."@en;
                                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                        rdfs:label "Initial E-RAB Establishment Success Rate"@en;
                                        rdfs:subClassOf iottaxolite:Communication.
iottaxolite:AccInitialERabSetupSuccRate a <http://www.w3.org/2002/07/owl#Class>;
                                        rdfs:comment "Initial E-UTRAN Radio Access Bearer setup success rate."@en;
                                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                        rdfs:label "Initial E-RAB Setup Success Rate"@en;
                                        rdfs:subClassOf iottaxolite:Communication.
iottaxolite:AccRrcConnSetupSuccRate a <http://www.w3.org/2002/07/owl#Class>;
                                    rdfs:comment "Radio Resource Control connection setup success rate."@en;
                                    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                    rdfs:label "RRC Connection Setup Success Rate"@en;
                                    rdfs:subClassOf iottaxolite:Communication.
iottaxolite:AccS1SigEstabSuccRate a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "S1 (S1 standardized interface between eNB and Evolved Packet Core) signalling establishment success rate."@en;
                                  rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                  rdfs:label "S1 Signalling Establishment Success Rate"@en;
                                  rdfs:subClassOf iottaxolite:Communication.
iottaxolite:Acceleration a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "The rate of change of the velocity of a particle with respect to time."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Acceleration"@en;
                         rdfs:seeAlso "http://purl.oclc.org/NET/ssnx/qu/dim#Acceleration";
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:AccelerationInstantaneous a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "The acceleration at a given instant of time."@en;
                                      rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                      rdfs:label "Instantaneous Acceleration"@en;
                                      rdfs:subClassOf iottaxolite:Acceleration.
iottaxolite:Accelerometer a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment " Accelerometers are used to automatically determine the orientation in which the user is holding the IoT Object (portrait or landscape)."@en;
                          rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                          rdfs:label "Accelerometer"@en;
                          rdfs:seeAlso <http://casas.wsu.edu/owl/cose.owl#Accelerometer>;
                          rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:ActivePower a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "The product of the voltage across a branch of an alternating-current circuit and the component of the electric current that is in phase with the voltage."@en;
                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                        rdfs:label "Active Power"@en;
                        rdfs:seeAlso "http://purl.oclc.org/NET/ssnx/qu/quantity#activePower";
                        rdfs:subClassOf iottaxolite:Power.
iottaxolite:Agriculture a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Agriculture, Smart farm as an Internet of Things (IoT) applicative domain."@en;
                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                        rdfs:label "Agriculture DOI"@en;
                        rdfs:subClassOf iottaxolite:DomainOfInterest.
iottaxolite:AirConditioner a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "An actuator to automatically switch on/off the air conditioner."@en;
                           rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                           rdfs:label "Air Conditioner Actuating Device"@en;
                           rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:AirHumiditySensor a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Sensor used to measure air humidity."@en;
                              rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                              rdfs:label "Air Humidity Sensor"@en;
                              rdfs:subClassOf iottaxolite:HumiditySensor.
iottaxolite:AirPollutantSensor a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Air Pollutant Sensor are devices that detect and monitor the presence of air pollution in the surrounding area (source Wikipedia)."@en;
                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                               rdfs:label "Air Pollutant Sensor"@en;
                               rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:AirPollution a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Usually measured using Air Quality Index (AQI), it is the measure of Air Pollution in the environment. It is similar to Air Quality."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Air Pollution Quantity Kind"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:AirQuality a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Usually measured using an air quality index (AQI) that is a number used by government agencies to communicate to the public how polluted the air currently is or how polluted it is forecast to become. Different countries have their own air quality indices, corresponding to different national air quality standards. It is the measure of Air Quality of the environment. It is similar to Air Pollution. (Source Wikipedia)."@en;
                       rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                       rdfs:label "Air Quality Quantity Kind"@en;
                       rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:AirTemperature a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "The temperature of the air that would be indicated by a thermometer exposed to the air at a location sheltered from direct solar radiation."@en;
                           rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                           rdfs:label "Air Temperature, Weather Temperature, Ambient Temperature"@en;
                           rdfs:seeAlso <http://paul.staroch.name/thesis/SmartHomeWeather.owl#Temperature>,
                                        <http://openiot.eu/ontology/ns/AirTemperature>;
                           rdfs:subClassOf iottaxolite:Temperature.
iottaxolite:AirThermometer a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Device to measure the Air temperature of either indoor or outdoor atmosphere."@en;
                           rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                           rdfs:label "Air Thermometer"@en;
                           rdfs:subClassOf iottaxolite:Thermometer.
iottaxolite:AlarmSystem a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "An actuator to automatically switch on/off the alarm system."@en;
                        rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                        rdfs:label "Alarm System Actuating Device"@en;
                        rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:AlcoholLevel a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Measure of Alcohol Level in the system."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Alcohol Level Quantity Kind"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:AlcoholLevelSensor a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Device used to detect and measure Alcohol Level in the system."@en;
                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                               rdfs:label "Alcohol Level Sensor"@en;
                               rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:Ampere a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "The ampere is the SI unit for measuring an electric current which is the flow of electric charges through a surface at the rate of one coulomb per second.The ampere is the SI unit for measuring an electric current which is the flow of electric charges through a surface at the rate of one coulomb per second."@en;
                   rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                   rdfs:label "Ampere (A)"@en;
                   rdfs:seeAlso "http://purl.oclc.org/NET/ssnx/qu/unit#ampere",
                                <http://sweet.jpl.nasa.gov/ontology/units.owl#ampere>,
                                <http://data.qudt.org/qudt/owl/1.0.0/unit.owl#Ampere>;
                   rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:AngularSpeed a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "It is the rate of change of angular displacement and is a vector quantity (more precisely, a pseudovector) that specifies the angular speed (rotational speed) of an object and the axis about which the object is rotating. (Source Wikipedia)."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Angular Speed"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:Animals a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "when the source of the sound were animals."@en;
                    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                    rdfs:label "Animals as Sound Source"@en;
                    rdfs:subClassOf iottaxolite:SoundSource.
iottaxolite:AtmosphericPressure a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "The pressure exerted by the atmosphere as a consequence of gravitational attraction exerted upon the column of air lying directly above the point in question."@en;
                                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                rdfs:label "Atmospheric Pressure"@en;
                                rdfs:seeAlso "http://purl.oclc.org/NET/ssnx/qu/quantity#atmosphericPressure",
                                             <http://paul.staroch.name/thesis/SmartHomeWeather.owl#AtmosphericPressure>,
                                             <http://openiot.eu/ontology/ns/AtmospherePressure>;
                                rdfs:subClassOf iottaxolite:Pressure.
iottaxolite:AtmosphericPressureSensor a <http://www.w3.org/2002/07/owl#Class>;
                                      rdfs:comment "Atmospheric Pressure Sensor, Barometer or Barometric Pressure Sensor is a scientific instrument used in meteorology to measure atmospheric pressure."@en;
                                      rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                      rdfs:label "Atmospheric Pressure Sensor"@en;
                                      rdfs:seeAlso <http://purl.oclc.org/NET/ssnx/meteo/aws#AtmosphericPressureSensor>,
                                                   <http://casas.wsu.edu/owl/cose.owl#BarometricPressureSensor>,
                                                   <http://archive.knoesis.org/research/semsci/application_domain/sem_sensor/ont/weather.owlPressure>;
                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:AutomaticSensing a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "When the devices are set to take the observations Automatically without any external aid."@en;
                             rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                             rdfs:label "Automatic Measurement Type"@en;
                             rdfs:subClassOf iottaxolite:MeasurementType.
iottaxolite:Bad a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "When the quality of observation is bad"@en;
                rdfs:label "Bad"@en;
                rdfs:subClassOf iottaxolite:QualityOfObservation.
iottaxolite:Bar a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Metric unit of atmospheric pressure equal to 14.50 pounds per square inch (lb/in2), 1.02 kilograms per square centimetre (kg/cm2), 29.53 inches of mercury (in Hg), or 0.9869 atmosphere."@en;
                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                rdfs:label "Bar"@en;
                rdfs:seeAlso "http://qudt.org/vocab/unit#Bar";
                rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:Barcode a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "A tagging device can be Barcode."@en;
                    rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                    rdfs:label "Barcode Tagging Device"@en;
                    rdfs:subClassOf <http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Tag>.
iottaxolite:BatteryLevel a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Measure of the percentage of the battery capacity that remains available."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Battery Level Quantity Kind"@en;
                         rdfs:seeAlso "http://www.w3.org/2007/uwa/context/deliveryContext.owl#BatteryLevel";
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:BeatPerMinute a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Beat Per Minute (bpm) is the unit to measure heart rate."@en;
                          rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                          rdfs:label "Beat Per Minute (bpm)"@en;
                          rdfs:subClassOf <http://purl.oclc.org/NET/ssnx/qu/qu#Unit>.
iottaxolite:Blind a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "An actuator to automatically switch on/off the window blinds."@en;
                  rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                  rdfs:label "Blind Actuating Device"@en;
                  rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:BloodCoagulation <http://purl.org/dc/elements/1.1/description> "Blood Coagulation is the process by which blood changes from  liquid to gel to form a blood clot. It allows the cessation of blood loss from an injury."@en;
                             a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                             rdfs:label "Blood Coagulation"@en;
                             rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:BloodGlucose a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Measure of Blood glucose level or blood sugar level."@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Blood Glucose Quantity Kind"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:BloodPressure a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Measure of the pressure in your blood vessels when your heart rests between beats."@en;
                          rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                          rdfs:label "Blood Pressure"@en;
                          rdfs:subClassOf iottaxolite:Pressure.
iottaxolite:BloodPressureSensor a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Device used to measure Blood Pressure."@en;
                                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                rdfs:label "Blood Pressure Sensor"@en;
                                rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:BoardTemperature a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Measure of board temperature."@en;
                             rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                             rdfs:label "Board Temperature"@en;
                             rdfs:subClassOf iottaxolite:Temperature.
iottaxolite:BoardThermometer a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Device used to measure board temperature."@en;
                             rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                             rdfs:label "Board Thermometer"@en;
                             rdfs:subClassOf iottaxolite:Thermometer.
iottaxolite:BoardVoltageSensor a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Sensor used to measure board input voltage."@en;
                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                               rdfs:label "Board Voltage Sensor"@en;
                               rdfs:subClassOf iottaxolite:VoltageSensor.
iottaxolite:BodyTemperature a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Measure of body temperature."@en;
                            rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                            rdfs:label "Body Temperature"@en;
                            rdfs:subClassOf iottaxolite:Temperature.
iottaxolite:BodyThermometer a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Device used to measure body temperature."@en;
                            rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                            rdfs:label "Body Thermometer"@en;
                            rdfs:subClassOf iottaxolite:Thermometer.
iottaxolite:Boiler a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An actuator to automatically switch on/off the boiler."@en;
                   rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                   rdfs:label "Boiler Actuating Device"@en;
                   rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:BuildingAutomation a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Smart Home/Building Automation as an Internet of Things (IoT) applicative domain."@en;
                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                               rdfs:label "Smart Building DOI"@en;
                               rdfs:seeAlso <http://elite.polito.it/ontologies/dogont.owl#BuildingEnvironment>;
                               rdfs:subClassOf iottaxolite:DomainOfInterest.
iottaxolite:BuildingTemperature a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Measure of building or room temperature."@en;
                                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                rdfs:label "Building/Room Temperature"@en;
                                rdfs:subClassOf iottaxolite:Temperature.
iottaxolite:Bus a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "A large motor vehicle carrying passengers by road, typically one serving the public on a fixed route and for a fare."@en;
                rdfs:label "Bus"@en;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/Platform>.
iottaxolite:CO2 a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Carbon Dioxide (CO2) measure in the atmosphere."@en;
                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                rdfs:label "Carbon Dioxide (CO2) Quantity Kind"@en;
                rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:CO2Sensor a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Carbon Dioxide (CO2) Sensor used to measure level of CO2 in the atmosphere."@en;
                      rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                      rdfs:label "Carbon Dioxide (CO2) Sensor"@en;
                      rdfs:subClassOf iottaxolite:GaseousPollutantSensor.
iottaxolite:COSensor a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "Device to detect Carbon Monoxide (CO) in the environment."@en;
                     rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                     rdfs:label "Carbon Monoxide (CO) Sensor"@en;
