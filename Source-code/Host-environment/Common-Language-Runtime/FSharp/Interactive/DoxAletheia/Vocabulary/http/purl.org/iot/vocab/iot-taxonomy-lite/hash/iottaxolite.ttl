                          rdfs:isDefinedBy m3lite:;
                          rdfs:label "Dimensionless"@en;
                          rdfs:seeAlso <http://purl.oclc.org/NET/ssnx/qu/dim#Dimensionless>;
                          rdfs:subClassOf qu:Unit.
iottaxolite:Direction a owl:Class;
