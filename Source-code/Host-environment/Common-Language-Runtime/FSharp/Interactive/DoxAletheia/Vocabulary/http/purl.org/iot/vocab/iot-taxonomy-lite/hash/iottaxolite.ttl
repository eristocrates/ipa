                    rdfs:subClassOf iottaxolite:DomainOfInterest.
iottaxolite:WeatherLuminosity a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Luminosity in the weather"@en;
                              rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                              rdfs:label "Weather Luminosity"@en;
                              rdfs:subClassOf iottaxolite:Illuminance.
iottaxolite:WeatherPrecipitation a <http://www.w3.org/2002/07/owl#Class>;
