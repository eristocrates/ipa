                            rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                            rdfs:label "Wind Speed Sensor"@en;
                            rdfs:subClassOf iottaxolite:SpeedSensor.
iottaxolite:Window a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An actuator to automatically open/close the window."@en;
                   rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                   rdfs:label "Window Actuating Device"@en;
                   rdfs:subClassOf <http://www.w3.org/ns/sosa/Actuator>.
iottaxolite:WorkingState a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Indicator of whether a person (or object) is working or not"@en;
                         rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                         rdfs:label "Working State"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/sosa/ObservableProperty>.
iottaxolite:WorkingStateDriver a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Indicator of whether the driver of a vehicle is present or not"@en;
                               rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
