iottaxolite:WindDirectionSensor a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Device used to detect wind direction."@en;
                                rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
                                rdfs:label "Wind Direction Sensor"@en;
                                rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor>.
iottaxolite:WindSpeed a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The ratio of the distance covered by moving air to the time quantity taken to cover it."@en;
                      rdfs:isDefinedBy <http://purl.org/iot/vocab/m3-lite#>;
