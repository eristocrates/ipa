                   rdfs:label "Drawer Actuating Device"@en;
                   rdfs:subClassOf sosa:Actuator.
iottaxolite:DustSensor a owl:Class;
                       rdfs:comment "A sensing device that measures dust particle concentration."@en;
                       rdfs:isDefinedBy m3lite:;
