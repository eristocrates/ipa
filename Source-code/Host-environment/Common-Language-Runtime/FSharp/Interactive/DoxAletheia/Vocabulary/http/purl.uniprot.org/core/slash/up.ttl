up: a <http://www.w3.org/2002/07/owl#Ontology>;
    rdfs:comment "Properties and classes used for protein annotation.".
up:API a up:Mass_Measurement_Method,
         <http://www.w3.org/2002/07/owl#Thing>;
       rdfs:comment "Mass measurement using Atmospheric Pressure Ionization";
       rdfs:label "Atmospheric Pressure Ionization".
up:Absorption_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Indicates the wavelength in nm at which photoreactive proteins such as opsins and DNA photolyases show maximal absorption.";
                         rdfs:label "Absorption";
                         rdfs:subClassOf up:Biophysicochemical_Annotation.
up:Active_Site_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Amino acid(s) involved in the activity of an enzyme.";
                          rdfs:label "Active Site";
                          rdfs:seeAlso "http://www.uniprot.org/manual/act_site"^^xsd:anyURI;
                          rdfs:subClassOf up:Site_Annotation.
up:Allergen_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Information relevant to allergenic proteins.";
                       rdfs:label "Allergen";
                       rdfs:seeAlso "http://www.uniprot.org/manual/allergenic_properties"^^xsd:anyURI;
                       rdfs:subClassOf up:Annotation.
up:Alternative_Initiation_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:label "Alternative Initiation";
                                     rdfs:subClassOf up:Alternative_Products_Annotation.
up:Alternative_Products_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Description of the existence of related protein sequences produced by alternative splicing of the same gene or by the use of alternative initiation codons.";
                                   rdfs:label "Alternative Products";
                                   rdfs:seeAlso "http://www.uniprot.org/manual/alternative_products"^^xsd:anyURI;
                                   rdfs:subClassOf up:Annotation.
up:Alternative_Promoter_Usage_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                         rdfs:label "Alternative Promoter Usage";
                                         rdfs:subClassOf up:Alternative_Products_Annotation.
up:Alternative_Sequence_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Description of sequence variants produced by alternative splicing.";
                                   rdfs:label "Splice Variant";
                                   rdfs:seeAlso "http://www.uniprot.org/manual/var_seq"^^xsd:anyURI;
                                   rdfs:subClassOf up:Natural_Variation_Annotation.
up:Alternative_Splicing_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:label "Alternative Splicing";
                                   rdfs:subClassOf up:Alternative_Products_Annotation.
up:Annotation a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Description of a resource on a specific topic.".
up:Apicoplast a up:Organelle,
                <http://www.w3.org/2002/07/owl#Thing>;
              rdfs:label "Apicoplast".
up:Attribution a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Entity used to attach evidence or provenance to a rdf statement via reification."@en.
up:Beta_Strand_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Beta strand regions within the experimentally determined protein structure";
                          rdfs:label "Strand";
                          rdfs:seeAlso "http://www.uniprot.org/manual/strand"^^xsd:anyURI;
                          rdfs:subClassOf up:Secondary_Structure_Annotation.
up:Binding_Site_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Binding site for any chemical group (co-enzyme, prosthetic group, etc.).";
                           rdfs:label "Binding Site";
                           rdfs:seeAlso "http://www.uniprot.org/manual/binding"^^xsd:anyURI;
                           rdfs:subClassOf up:Site_Annotation.
up:Biophysicochemical_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Biophysical and physicochemical data such as pH dependence, temperature dependence, kinetic parameters, redox potentials, and maximal absorption.";
                                 rdfs:label "Biophysicochemical Property";
                                 rdfs:seeAlso "http://purl.uniprot.org/core/biophysicochemical_properties"^^xsd:anyURI;
                                 rdfs:subClassOf up:Annotation.
up:Biotechnology_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "Description of the use of a specific protein in a biotechnological process.";
                            rdfs:label "Biotechnology";
                            rdfs:seeAlso "http://www.uniprot.org/manual/biotechnological_use"^^xsd:anyURI;
                            rdfs:subClassOf up:Annotation.
up:Book_Citation a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A chapter from a book.";
                 rdfs:label "Book Citation";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> up:name ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> up:name ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 up:Published_Citation.
up:By_Similarity a up:Status,
                   <http://www.w3.org/2002/07/owl#Thing>;
                 rdfs:label "By Similarity".
up:Calcium_Binding_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Extent of a calcium-binding region.";
                              rdfs:label "Calcium Binding";
                              rdfs:seeAlso "http://www.uniprot.org/manual/ca_bind"^^xsd:anyURI;
                              rdfs:subClassOf up:Region_Annotation.
up:Catalytic_Activity_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Description of the reactions catalyzed by an enzyme.";
                                 rdfs:label "Catalytic Activity";
                                 rdfs:seeAlso "http://www.uniprot.org/manual/catalytic_activity"^^xsd:anyURI;
                                 rdfs:subClassOf up:Annotation.
up:Caution_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Warning about possible errors and/or grounds for confusion.";
                      rdfs:label "Caution";
                      rdfs:seeAlso "http://www.uniprot.org/manual/caution"^^xsd:anyURI;
                      rdfs:subClassOf up:Annotation.
up:Cellular_Component a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "Cellular Component";
                      rdfs:subClassOf up:Subcellular_Location.
up:Chain_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Extent of a polypeptide chain in the mature protein.";
                    rdfs:label "Chain";
                    rdfs:seeAlso "http://www.uniprot.org/manual/chain"^^xsd:anyURI;
                    rdfs:subClassOf up:Molecule_Processing_Annotation.
up:Chloroplast a up:Organelle,
                 <http://www.w3.org/2002/07/owl#Thing>;
               rdfs:label "Chloroplast".
up:Citation a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Description of a publication from which data was obtained.";
            rdfs:seeAlso "http://www.uniprot.org/manual/references"^^xsd:anyURI;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:date ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gYear ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gYearMonth ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                             a <http://www.w3.org/2002/07/owl#Class>],
                            [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:date ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gYear ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:gYearMonth ; 
                                                                      <http://www.w3.org/2002/07/owl#onProperty> up:date ; 
                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
            <http://www.w3.org/2002/07/owl#disjointWith> up:Sequence,
                                                         up:Range,
                                                         up:Protein.
up:Citation_Statement a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The relationship between a resource and a citation.";
                      rdfs:label "Citation Statement";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (up:Strain
                                                                                                                               up:Tissue
                                                                                                                               up:Transposon) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> up:context ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      [<http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (up:Strain
                                                                                                                               up:Tissue
                                                                                                                               up:Transposon) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> up:context ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      rdf:Statement.
up:Class a up:Rank,
           <http://www.w3.org/2002/07/owl#Thing>;
         rdfs:label "Taxonomy rank Class".
up:Cluster a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "Cluster of proteins with similar sequences.";
           rdfs:seeAlso "http://www.uniprot.org/uniref/"^^xsd:anyURI;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> up:Sequence ; 
                            <http://www.w3.org/2002/07/owl#onProperty> up:member ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#allValuesFrom> up:Sequence ; 
