up:Rank a <http://www.w3.org/2002/07/owl#Class>;
        rdfs:comment "A rank of a taxon.".
up:Redox_Potential_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "Reports the value of the standard (midpoint) oxido-reduction potential(s) for electron transport proteins.";
                              rdfs:label "Redox Potential";
                              rdfs:subClassOf up:Biophysicochemical_Annotation.
