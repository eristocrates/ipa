                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           <http://www.w3.org/2002/07/owl#Class>.
up:Cross-link_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Posttranslationally formed amino acid bonds.";
                         rdfs:label "Crosslink";
                         rdfs:seeAlso "http://www.uniprot.org/manual/crosslnk"^^xsd:anyURI;
                         rdfs:subClassOf up:Modification_Annotation.
up:Cyanelle a up:Organelle,
              <http://www.w3.org/2002/07/owl#Thing>;
