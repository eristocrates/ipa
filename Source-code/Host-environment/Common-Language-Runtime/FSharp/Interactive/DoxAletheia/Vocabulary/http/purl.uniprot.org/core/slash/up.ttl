            rdfs:subClassOf <http://www.w3.org/2002/07/owl#Class>.
up:Developmental_Stage_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Description of the developmentally-specific expression of a protein.";
