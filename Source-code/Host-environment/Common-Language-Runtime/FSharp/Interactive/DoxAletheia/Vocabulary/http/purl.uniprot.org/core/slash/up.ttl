                         "http://www.uniprot.org/help/uniparc"^^xsd:anyURI.
up:Sequence_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Description of a special region or site in a protein sequence.";
                       rdfs:label "Sequence Annotation";
                       rdfs:seeAlso "http://www.uniprot.org/manual/sequence_annotation"^^xsd:anyURI;
                       rdfs:subClassOf up:Annotation.
up:Sequence_Caution_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:comment "Warning about possible errors related to the protein sequence";
                               rdfs:label "Sequence Caution";
                               rdfs:seeAlso "http://www.uniprot.org/manual/sequence_caution"^^xsd:anyURI;
                               rdfs:subClassOf up:Sequence_Annotation.
up:Sequence_Conflict_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Different sources report differing sequences.";
                                rdfs:label "Sequence Conflict";
                                rdfs:seeAlso "http://www.uniprot.org/manual/conflict"^^xsd:anyURI;
                                rdfs:subClassOf up:Experimental_Information_Annotation.
up:Sequence_Uncertainty_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                   rdfs:comment "Used to describe region(s) of a sequence for which the authors are unsure about the sequence assignment.";
                                   rdfs:label "Unsure Residue";
                                   rdfs:seeAlso "http://www.uniprot.org/manual/unsure"^^xsd:anyURI;
                                   rdfs:subClassOf up:Experimental_Information_Annotation.
up:Signal_Peptide_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "Extent of a signal sequence (prepeptide).";
                             rdfs:label "Signal Peptide";
                             rdfs:seeAlso "http://www.uniprot.org/manual/signal"^^xsd:anyURI;
                             rdfs:subClassOf up:Molecule_Processing_Annotation.
up:Similarity_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "Description of the similarities (sequence or structural) of a protein with other proteins.";
                         rdfs:label "Similarity";
                         rdfs:seeAlso "http://www.uniprot.org/manual/sequence_similarities"^^xsd:anyURI;
                         rdfs:subClassOf up:Annotation.
up:Simple_Sequence a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "Simple Sequence";
                   rdfs:subClassOf up:Known_Sequence.
up:Site_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Any interesting single amino-acid site on the sequence, that is not defined by another feature key. It can also apply to an amino acid bond which is represented by the positions of the two flanking amino acids.";
                   rdfs:label "Site";
                   rdfs:seeAlso "http://www.uniprot.org/manual/site"^^xsd:anyURI;
                   rdfs:subClassOf up:Sequence_Annotation.
