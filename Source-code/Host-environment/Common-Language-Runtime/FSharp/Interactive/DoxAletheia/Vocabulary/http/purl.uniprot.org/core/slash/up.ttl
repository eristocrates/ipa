                           <http://www.w3.org/2002/07/owl#Thing>;
           <http://www.w3.org/2002/07/owl#disjointWith> up:Sequence,
                                                        up:Protein.
up:Cofactor_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Description of an enzyme cofactor.";
                       rdfs:label "Cofactor";
                       rdfs:seeAlso "http://www.uniprot.org/manual/cofactor"^^xsd:anyURI;
                       rdfs:subClassOf up:Annotation.
up:Coiled_Coil_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Extent of a coiled-coil region.";
                          rdfs:label "Coiled-Coil";
                          rdfs:seeAlso "http://www.uniprot.org/manual/coiled"^^xsd:anyURI;
                          rdfs:subClassOf up:Region_Annotation.
up:Compositional_Bias_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Extent of a compositionally biased region.";
                                 rdfs:label "Compositionally Biased Region";
                                 rdfs:seeAlso "http://www.uniprot.org/manual/compbias"^^xsd:anyURI;
                                 rdfs:subClassOf up:Region_Annotation.
up:Concept a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A concept used to classify resources.";
           rdfs:label "Concept";
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#allValuesFrom> up:Concept ; 
                            <http://www.w3.org/2002/07/owl#onProperty> up:replaces ; 
