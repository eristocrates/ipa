up:Secondary_Structure_Annotation a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "Describes the secondary structure of proteins whose tertiary structure is known experimentally.";
                                  rdfs:label "Secondary Structure";
                                  rdfs:subClassOf up:Sequence_Annotation.
up:Sequence a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "An amino acid sequence.";
