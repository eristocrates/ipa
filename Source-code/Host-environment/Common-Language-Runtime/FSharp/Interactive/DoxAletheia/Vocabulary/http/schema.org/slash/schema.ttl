                                      schema:ParcelDelivery,
                                      schema:Trip,
                                      schema:Invoice,
                                      schema:CreativeWork,
                                      schema:EducationalOccupationalProgram,
                                      schema:Service;
                schema:rangeIncludes schema:Person,
                                     schema:Organization;
                a rdf:Property;
