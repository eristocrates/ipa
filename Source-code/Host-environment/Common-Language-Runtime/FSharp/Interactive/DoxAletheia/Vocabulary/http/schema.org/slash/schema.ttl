                  rdfs:comment "The key, mode, or scale this composition uses.";
                  rdfs:label "musicalKey".
schema:naics dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_GoodRelationsTerms>;
