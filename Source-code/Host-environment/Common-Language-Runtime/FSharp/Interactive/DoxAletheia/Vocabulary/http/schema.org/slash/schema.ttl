schema:DataType a rdfs:Class;
                rdfs:comment "The basic data types such as Integers, Strings, etc.";
                rdfs:label "DataType";
                rdfs:subClassOf rdfs:Class.
schema:Dataset dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_DatasetClass>;
