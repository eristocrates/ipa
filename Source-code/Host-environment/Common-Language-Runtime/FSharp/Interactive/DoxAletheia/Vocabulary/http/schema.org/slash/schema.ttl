               rdfs:label "seatRow".
schema:seatSection schema:domainIncludes schema:Seat;
                   schema:rangeIncludes schema:Text;
                   a rdf:Property;
                   rdfs:comment "The section location of the reserved seat (e.g. Orchestra).";
