           schema:rangeIncludes schema:Text;
           a rdf:Property;
           rdfs:comment "The Manufacturer Part Number (MPN) of the product, or the product to which the offer refers.";
           rdfs:label "mpn".
schema:multipleValues schema:domainIncludes schema:PropertyValueSpecification;
                      schema:rangeIncludes schema:Boolean;
                      a rdf:Property;
                      rdfs:comment "Whether multiple values are allowed for the property.  Default is false.";
                      rdfs:label "multipleValues".
schema:musicArrangement dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
