                         rdfs:label "foodEstablishment";
                         rdfs:subPropertyOf schema:location.
schema:foodEvent schema:domainIncludes schema:CookAction;
                 schema:rangeIncludes schema:FoodEvent;
                 a rdf:Property;
                 rdfs:comment "A sub property of location. The specific food event where the action occurred.";
                 rdfs:label "foodEvent";
                 rdfs:subPropertyOf schema:location.
schema:founder schema:domainIncludes schema:Organization;
               schema:rangeIncludes schema:Person;
               a rdf:Property;
               rdfs:comment "A person who founded this organization.";
               rdfs:label "founder".
schema:founders schema:domainIncludes schema:Organization;
                schema:rangeIncludes schema:Person;
                schema:supersededBy schema:founder;
                a rdf:Property;
                rdfs:comment "A person who founded this organization.";
                rdfs:label "founders".
schema:foundingDate schema:domainIncludes schema:Organization;
                    schema:rangeIncludes schema:Date;
