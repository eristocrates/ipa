                 rdfs:label "faxNumber".
schema:featureList schema:domainIncludes schema:SoftwareApplication;
                   schema:rangeIncludes schema:Text,
                                        schema:URL;
                   a rdf:Property;
                   rdfs:comment "Features or modules provided by this application (and possibly required by other applications).";
                   rdfs:label "featureList".
schema:feesAndCommissionsSpecification dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#FIBO>;
