schema:CompilationAlbum dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
                        a schema:MusicAlbumProductionType;
                        rdfs:comment "CompilationAlbum.";
                        rdfs:label "CompilationAlbum".
schema:CompletedActionStatus a schema:ActionStatusType;
