schema:seller schema:domainIncludes schema:Flight,
                                    schema:Offer,
                                    schema:BuyAction,
                                    schema:Demand,
                                    schema:Order;
              schema:rangeIncludes schema:Person,
                                   schema:Organization;
              a rdf:Property;
              rdfs:comment "An entity which offers (sells / leases / lends / loans) the services / goods.  A seller may also be a provider.";
