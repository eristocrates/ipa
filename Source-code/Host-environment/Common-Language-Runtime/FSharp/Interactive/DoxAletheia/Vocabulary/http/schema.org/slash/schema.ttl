schema:lowPrice schema:domainIncludes schema:AggregateOffer;
                schema:rangeIncludes schema:Number,
                                     schema:Text;
                a rdf:Property;
                rdfs:comment """The lowest price of all offers available.<br/><br/>

Usage guidelines:<br/><br/>

<ul>
<li>Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similiar Unicode symbols.</li>
<li>Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator.</li>
</ul>
""";
                rdfs:label "lowPrice".
schema:lyricist dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#MBZ>;
