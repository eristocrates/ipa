            rdfs:label "owns".
schema:pageEnd dcterms:source <http://www.w3.org/wiki/WebSchemas/SchemaDotOrgSources#source_bibex>;
               schema:domainIncludes schema:Chapter,
                                     schema:PublicationVolume,
                                     schema:PublicationIssue,
                                     schema:Article;
               schema:rangeIncludes schema:Text,
