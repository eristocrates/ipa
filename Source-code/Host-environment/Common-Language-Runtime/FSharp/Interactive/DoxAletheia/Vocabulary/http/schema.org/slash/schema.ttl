                            schema:rangeIncludes schema:Text;
                            a rdf:Property;
                            rdfs:comment "The type of composition (e.g. overture, sonata, symphony, etc.).";
                            rdfs:label "musicCompositionForm".
schema:musicGroupMember schema:domainIncludes schema:MusicGroup;
