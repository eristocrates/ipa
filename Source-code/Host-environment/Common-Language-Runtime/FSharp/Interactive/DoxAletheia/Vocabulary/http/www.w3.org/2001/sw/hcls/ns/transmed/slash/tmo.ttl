                                     "OCRe_research:Intervention",
                                     "NCIt:Intervention";
                  a owl:Class;
                  rdfs:label "intervention"@en;
                  rdfs:subClassOf transmed:TMO_0029.
transmed:TMO_0031 iao:0000119 "NCI thesaurus";
                  dc11:description "A diagnosis is a study composed of investigation, analysis and recognition of the presence and nature of disease, condition, or injury from expressed signs and symptoms; also, the scientific determination of any kind; the concise results of such an investigation."@en;
                  oboinowl:hasDbXref "Galen:Diagnosis",
                                     "ACGT:Diagnosis",
