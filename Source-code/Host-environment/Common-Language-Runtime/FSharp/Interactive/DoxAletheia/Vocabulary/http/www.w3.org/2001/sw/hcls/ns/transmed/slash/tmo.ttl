transmed:TMO_0304 dc11:description "A drug interaction is a process in which a drug interacts with a living system in such a way that it affects its behaviour."@en;
                  oboinowl:hasDbXref "pharmgkb:Association",
                                     "pharmgkb:DrugGeneVariantInteraction",
                                     "drugbank:drug_interactions";
                  a owl:Class;
                  rdfs:label "drug interaction"@en;
                  rdfs:subClassOf span:ProcessualEntity.
transmed:tmo dc11:creator "Elgar Pichler",
                          "Matthias Samwald",
