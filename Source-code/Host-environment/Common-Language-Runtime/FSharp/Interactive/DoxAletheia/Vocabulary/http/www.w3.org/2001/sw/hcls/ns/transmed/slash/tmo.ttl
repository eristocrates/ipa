                  rdfs:subClassOf transmed:TMO_0215.
transmed:TMO_0038 dc11:description "A genotype with a single-nucleotide polymorphism (SNP). A SNP is a variation at a single nucleotide locus in the genomes of members of a species. For a variation to be considered a SNP, it must occur in at least 1% of the population."@en;
                  oboinowl:hasDbXref "UMLS:C0752046",
                                     "SO:0000694",
                                     "NCIt:Single_Nucleotide_Polymorphism",
                                     "MSH:D020641";
                  a owl:Class;
                  rdfs:label "genotype with SNP"@en;
                  rdfs:subClassOf transmed:TMO_0080.
transmed:TMO_0039 dc11:description "A genotype of which variants with a different number of copies of a sequence identifical region exist."@en;
                  oboinowl:hasDbXref "SO:0001019";
                  a owl:Class;
                  rdfs:label "genotype with copy number variation"@en;
                  rdfs:subClassOf transmed:TMO_0080.
transmed:TMO_0040 dc11:description "A drug-drug interaction is a drug interaction in which two drugs interact in such a way to produce an abnormal phenotypic event."@en;
                  oboinowl:hasDbXref "IAO:0000124",
                                     "SNOMEDCT:404204005";
                  a owl:Class;
                  rdfs:label "drug-drug interaction"@en;
