transmed:TMO_0042 dc11:description "The mechanism of action is a description of processes and behaviour of a biologically active molecule in its administration into a living system."@en;
                  oboinowl:hasDbXref "NCIt:Mechanism_of_Action";
                  a owl:Class;
                  rdfs:label "mechanism of action"@en;
                  rdfs:subClassOf transmed:TMO_0090.
transmed:TMO_0043 iao:0000119 "CDISC glossary";
                  dc11:description "An adverse drug event is a any untoward medical occurrence in a patient or clinical investigation subject administered a pharmaceutical product and which does not necessarily have a causal relationship with this treatment. An adverse event (AE) can therefore be any unintended sign (including an abnormal laboratory finding), symptom,or disease temporally associated with the use of a medicinal (investigational) product, whether or not related to the medicinal (investigational) product."@en;
                  oboinowl:hasDbXref "sider:side_effects",
                                     "SNOMEDCT:406644009",
                                     "MSH:D004362";
                  a owl:Class;
                  rdfs:label "adverse drug event"@en;
                  rdfs:subClassOf transmed:TMO_0061.
transmed:TMO_0044 iao:0000119 "NCI Thesaurus";
                  dc11:description "A pathway is a representation of a set or series of interactions, often forming a network, which biologists have found useful to group together for organizational, historic, biophysical, or other reasons."@en;
                  oboinowl:hasDbXref "IEV:0000001",
                                     "NCIt:Pathway",
                                     "GRO:Pathway",
                                     "Galen:Pathway",
                                     "MI:0619";
                  a owl:Class;
                  rdfs:label "pathway"@en;
                  rdfs:subClassOf transmed:TMO_0090.
transmed:TMO_0045 dc11:description "A population is a collection of organisms."@en;
                  oboinowl:hasDbXref "IAO:0000120",
                                     "dcterms:AgentClass",
                                     "OCRe_research:Population";
                  a owl:Class;
                  rdfs:label "population"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#MaterialEntity>.
transmed:TMO_0046 dc11:description "An arm of clinical study is a population that participates in a clinical trial and is subject to some intervention."@en;
                  oboinowl:hasDbXref "linkedct:trial_arm_group",
