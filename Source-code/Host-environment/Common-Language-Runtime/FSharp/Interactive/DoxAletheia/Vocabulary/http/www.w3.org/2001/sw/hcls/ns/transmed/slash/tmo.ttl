                  rdfs:label "symptom"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0024 dc11:description "A medical measure is a measure that describes or is a measure of medically relevant entities."@en;
                  a owl:Class;
                  rdfs:label "medical measure"@en;
                  rdfs:subClassOf transmed:TMO_0010.
transmed:TMO_0025 dc11:description "An institution is an entity created by legislation or by practice which acts legally in the same way as a person."@en;
