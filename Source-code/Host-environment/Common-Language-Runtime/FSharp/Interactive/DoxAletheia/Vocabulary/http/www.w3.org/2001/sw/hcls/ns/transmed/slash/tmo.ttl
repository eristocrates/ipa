                  a owl:Class;
                  rdfs:label "drug measure"@en;
                  rdfs:subClassOf transmed:TMO_0010.
transmed:TMO_0034 dc11:description "Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity."@en;
