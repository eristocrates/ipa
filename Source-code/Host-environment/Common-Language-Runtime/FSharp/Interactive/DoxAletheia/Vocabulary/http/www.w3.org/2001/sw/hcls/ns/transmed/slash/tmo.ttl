transmed:TMO_0227 dc11:description "A genotype with a multiple-nucleotide polymorphism (MNP). An MNP is a variation of several adjacent nucleotides in the genomes of members of a species. For a variation to be considered an MNP, it must occur in at least 1% of the population."@en;
                  a owl:Class;
                  rdfs:label "genotype with multiple nucleotide polymorphism"@en;
                  rdfs:subClassOf transmed:TMO_0080.
transmed:TMO_0228 a owl:Class;
