transmed:TMO_0000 dc11:description "An active ingredient is a pharmaceutical ingredient that has the disposition to treat a certain disease."@en;
                  oboinowl:hasDbXref "HL7V3.0:ACTI";
                  a owl:Class;
                  rdfs:label "active ingredient"@en;
                  rdfs:subClassOf transmed:TMO_0071;
                  owl:equivalentClass [owl:intersectionOf (transmed:TMO_0071
                                                           [owl:someValuesFrom transmed:TMO_0064 ; 
                                                           owl:onProperty obi:0000316 ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom transmed:TMO_0001 ; 
                                                           owl:onProperty <http://www.obofoundry.org/ro/ro.owl#part_of> ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
transmed:TMO_0001 dc11:description "A formulated pharmaceutical is a chemical substance whose granular parts include an active ingredient, an excipient, and possibly a stability regulator for the active ingredient."@en;
                  oboinowl:hasDbXref "medicare:drugs",
                                     "UMLS:C1705957",
                                     "sider:drugs",
                                     "NCIt:Pharmaceutical_Formulation",
                                     "pharmgkb:Drug",
                                     "drugbank:drugs",
                                     "dailymed:drugs";
                  a owl:Class;
                  rdfs:label "formulated pharmaceutical"@en;
                  rdfs:subClassOf transmed:TMO_0063,
                                  [owl:someValuesFrom transmed:TMO_0071 ; 
                                   owl:onProperty <http://www.obofoundry.org/ro/ro.owl#has_proper_part> ; 
                                   a owl:Restriction].
transmed:TMO_0002 dc11:description "A pharmaceutical product is a formulated pharmaceutical that has been approved to treat patients."@en;
                  oboinowl:hasDbXref "UMLS:C1708062",
                                     "NCIt:Finished_Pharmaceutical_Product";
                  a owl:Class;
                  rdfs:label "pharmaceutical product"@en;
                  rdfs:subClassOf transmed:TMO_0001.
transmed:TMO_0003 dc11:description "An inactive ingredient is a pharmaceutical ingredient that is part of a pharmaceutical formulation but does not have the disposition to treat a certain disease."@en;
                  oboinowl:hasDbXref "HL7V3.0:IACT";
                  a owl:Class;
                  rdfs:label "inactive ingredient"@en;
                  rdfs:subClassOf transmed:TMO_0071;
                  owl:equivalentClass [owl:intersectionOf (transmed:TMO_0071
                                                           [owl:someValuesFrom transmed:TMO_0065 ; 
                                                           owl:onProperty obi:0000316 ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom transmed:TMO_0001 ; 
                                                           owl:onProperty <http://www.obofoundry.org/ro/ro.owl#part_of> ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
transmed:TMO_0004 dc11:description "An absent phenotype is a phenotype that represents the notable absence of a characteristic."@en;
                  a owl:Class;
                  rdfs:label "absent phenotype"@en;
                  rdfs:subClassOf transmed:TMO_0019.
transmed:TMO_0005 dc11:description "A genetic description is a description of the genetic composition of some entity."@en;
                  a owl:Class;
                  rdfs:label "genetic description"@en;
                  rdfs:subClassOf transmed:TMO_0089.
transmed:TMO_0006 dc11:description "A role played by a material entity it being the subject of a study."@en;
                  oboinowl:hasDbXref "NCIt:Target",
                                     "UMLS:C1521840";
                  a owl:Class;
                  rdfs:label "subject role"@en;
                  rdfs:subClassOf <http://www.ifomis.org/bfo/1.1/snap#Role>;
                  owl:disjointWith transmed:TMO_0221,
                                   iao:0000442,
                                   transmed:TMO_0074,
                                   transmed:TMO_0073.
transmed:TMO_0007 iao:0000119 "NCI Thesaurus";
                  dc11:description "A prognosis is a hypothesis about the likely course of a disease, the chance of recovery or recurrence."@en;
                  oboinowl:hasDbXref "UMLS:C0033325",
                                     "NCIt:Prognosis",
                                     "MSH:D011379",
                                     "Galen:Prognosis";
                  a owl:Class;
                  rdfs:label "prognosis"@en;
                  rdfs:subClassOf transmed:TMO_0059.
transmed:TMO_0008 dc11:description "A patient role is a role played a human subject that receives medical attention, care or treatment or who is registered with a medical institution with the purpose of receiving medical care when necessary."@en;
                  a owl:Class;
                  rdfs:label "patient role"@en;
                  rdfs:subClassOf transmed:TMO_0060.
transmed:TMO_0009 dc11:description "An medical expert role is a role played by a human in a clinical context who is involved in the assessment or administration of treatment or its results."@en;
                  oboinowl:hasDbXref "OCRe_clinical:Clinician";
                  a owl:Class;
                  rdfs:label "medical expert role"@en;
                  rdfs:subClassOf transmed:TMO_0074.
transmed:TMO_0010 dc11:description "A biomedical measure is an information content entity that describes or is a measure of biomedically relevant entities."@en;
                  a owl:Class;
                  rdfs:label "biomedical measure"@en;
                  rdfs:subClassOf transmed:TMO_0093.
transmed:TMO_0011 dc11:description "A molecular structure description is a description of a molecule in terms of its composition and connectivity."@en;
                  a owl:Class;
                  rdfs:comment "Examples: connection table, fragment, pharmacophore.";
                  rdfs:label "molecular structure description"@en;
                  rdfs:subClassOf transmed:TMO_0106.
transmed:TMO_0012 iao:0000119 "American Heritage(R) Stedman's Medical Dictionary";
                  dc11:description "A patent is an information entity granted by a patent office which confers upon the patenter the sole right to make, use and sell an invention for a set period of time."@en;
                  oboinowl:hasDbXref "BIRNLex:2364",
                                     "Galen:patent",
                                     "MSH:D020490",
                                     "IAO:0000313",
                                     "BRO:Patent";
                  a owl:Class;
                  rdfs:label "patent"@en;
                  rdfs:subClassOf iao:0000310.
transmed:TMO_0013 dc11:description "An exclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the exclusion of candidate patients."@en;
                  oboinowl:hasDbXref "IAO:0000124";
                  a owl:Class;
                  rdfs:label "exclusion criterion for clinical trial"@en;
                  rdfs:subClassOf transmed:TMO_0077.
transmed:TMO_0014 dc11:description "A inclusion criterion for clinical trial is a clinical trial criterion which, if satisfied, supports the inclusion of candidate patients."@en;
                  oboinowl:hasDbXref "IAO:0000124";
                  a owl:Class;
                  rdfs:label "inclusion criterion for clinical trial"@en;
                  rdfs:subClassOf transmed:TMO_0077.
transmed:TMO_0015 dc11:description "A diagnostic result is a medical measure of determining the nature of a  problem or illness through medical procedure."@en;
                  oboinowl:hasDbXref "IAO:0000124";
                  a owl:Class;
                  rdfs:label "diagnostic result"@en;
                  rdfs:subClassOf transmed:TMO_0136.
transmed:TMO_0016 dc11:description "A clinical protocol is a directive information entity about the objective(s), design, methodology, statistical considerations, and organization of a clinical procedure."@en;
                  oboinowl:hasDbXref "IAO:0000124";
                  a owl:Class;
                  rdfs:label "clinical protocol"@en;
                  rdfs:subClassOf iao:0000033.
transmed:TMO_0017 dc11:description "Evidence is a group of indicators that are relevant in some decision-making process."@en;
                  oboinowl:hasDbXref "IAO:0000123",
                                     "UMLS:C0332120",
                                     "NCIt:Evidence";
                  a owl:Class;
                  rdfs:label "evidence"@en;
                  rdfs:subClassOf transmed:TMO_0109.
transmed:TMO_0018 dc11:description "An environmental description is a description concerning some aspect of a physical environment."@en;
                  oboinowl:hasDbXref "IAO:0000123";
                  a owl:Class;
                  rdfs:label "environmental description"@en;
                  rdfs:subClassOf transmed:TMO_0089.
transmed:TMO_0019 dc11:description "A phenotype is an observable characteristic of an organism."@en;
                  a owl:Class;
                  rdfs:label "phenotype"@en;
                  rdfs:subClassOf transmed:TMO_0084.
transmed:TMO_0020 dc11:description "A personal medical history is a medical record consisting of a collection of information obtained from the patient and from other sources concerning the patient's health."@en;
                  oboinowl:hasDbXref "pchr:Encounter",
                                     "UMLS:C0262926",
                                     "NCIt:Personal_Medical_History";
