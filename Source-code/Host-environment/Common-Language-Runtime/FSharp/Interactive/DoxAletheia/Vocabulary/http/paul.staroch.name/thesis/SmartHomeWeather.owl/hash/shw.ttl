shw:VeryRainyWeather a owl:Class;
                     owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                              [owl:unionOf ([owl:someValuesFrom shw:ExtremelyHeavyRain ; 
                                                                           owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                           a owl:Restriction]
