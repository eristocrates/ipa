                                                                           a owl:Restriction]) ; 
                                                              a owl:Class]) ; 
                                          a owl:Class].
shw:WeatherCondition a owl:Class;
                     rdfs:comment """A WeatherCondition is a simple description of the state of the weather. Currently there are: Cloud, Fog, LightCloud, PartlyCloud, Rain, Sleet, Snow, Sun, Thunder.

Several instances of WeatherCondition can be associated with the same instance of WeatherPhenomenon using the hasCondition property. That way, it is possible to describe a thunderstorm that comes with rain.""";
                     rdfs:seeAlso shw:hasCondition,
                                  shw:WeatherPhenomenon;
                     rdfs:subClassOf owl:Thing;
                     owl:equivalentClass [owl:oneOf (shw:LightCloud
                                                     shw:PartlyCloud
                                                     shw:Sleet
                                                     shw:Sun
                                                     shw:Snow
                                                     shw:Fog
                                                     shw:Thunder
                                                     shw:Cloud
                                                     shw:Rain) ; 
                                          a owl:Class].
shw:WeatherPhenomenon a owl:Class;
                      rdfs:comment shw:sunAngleNoon,
                                   shw:belongsToState,
                                   shw:hasTemperature,
                                   shw:hasWindSpeed,
                                   shw:hasDewPoint,
                                   shw:hasPressure,
                                   """A WeatherPhenomenon specifies information about the weather (temperature, humidity etc.) for a certain WeatherState. It is linked to the WeatherState using the belongsToState property.

For specifying the weather information, there exist several data properties: hasTemperature, hasHumidity, hasDewPoint, hasWindSpeed, hasWindDirection, hasPrecipitationProbability, hasPrecipitationValue, hasPressure, hasCloudCover, hasCloudAltitude, hasSunRadiation and hasSunAngleNoon.""",
                                   shw:WeatherState,
                                   shw:hasCloudCover,
                                   shw:hasHumidity,
                                   shw:hasPrecipitationValue,
                                   shw:hasWindDirection,
                                   shw:hasSunRadiation,
                                   shw:hasPrecipitationProbability,
                                   shw:hasCloudAltitude.
shw:WeatherReport a owl:Class;
                  rdfs:comment """A WeatherObservation puts together all the information known at a certain time about both the current and the future weather at a certain location.

Using the mandatory properties location a Point -- having latitude, longitude and altitude -- the location this WeatherObservation belongs to is specified. The property hasObservation time gives the time when the data has been collected.

A WeatherObservation can have an arbitrary number of WeatherStates. Each of them gives some information about either the current state of the weather or the weather predicted for some time in the future.""";
                  rdfs:seeAlso shw:belongsToWeather,
                               shw:WeatherState;
                  rdfs:subClassOf [owl:someValuesFrom shw:WeatherState ; 
                                   owl:onProperty shw:hasWeatherState ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom shw:WeatherReportSource ; 
                                   owl:onProperty shw:hasSource ; 
                                   a owl:Restriction],
                                  [owl:maxQualifiedCardinality "3"^^xsd:nonNegativeInteger ; 
                                   owl:onClass shw:WeatherCondition ; 
                                   owl:onProperty shw:hasCondition ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom [owl:intersectionOf (time:Instant
                                                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onClass [owl:hasValue time:unitMinute ; 
                                                                                        owl:onProperty time:unitType ; 
                                                                                        a owl:Restriction] ; 
                                                                           owl:onProperty time:inDateTime ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class] ; 
                                   owl:onProperty shw:hasObservationTime ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom xsd:positiveInteger ; 
                                   owl:onProperty shw:hasPriority ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom [owl:intersectionOf (time:Interval
                                                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onClass [owl:someValuesFrom xsd:decimal ; 
                                                                                        owl:onProperty time:hours ; 
                                                                                        a owl:Restriction] ; 
                                                                           owl:onProperty time:hasDurationDescription ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class] ; 
                                   owl:onProperty shw:hasStartTime ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom wgspos:Point ; 
                                   owl:onProperty wgspos:location ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom [owl:intersectionOf (time:Interval
                                                                           [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                                           owl:onClass [owl:someValuesFrom xsd:decimal ; 
                                                                                        owl:onProperty time:hours ; 
                                                                                        a owl:Restriction] ; 
                                                                           owl:onProperty time:hasDurationDescription ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class] ; 
                                   owl:onProperty shw:hasEndTime ; 
                                   a owl:Restriction].
shw:WeatherReportFromSensor a owl:Class;
                            owl:equivalentClass [owl:intersectionOf (shw:WeatherReport
                                                                     [owl:someValuesFrom shw:SensorSource ; 
                                                                     owl:onProperty shw:hasSource ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
shw:WeatherReportFromService a owl:Class;
                             owl:equivalentClass [owl:intersectionOf (shw:WeatherReport
                                                                      [owl:someValuesFrom shw:ServiceSource ; 
                                                                      owl:onProperty shw:hasSource ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class].
shw:WeatherReportSource a owl:Class;
                        rdfs:comment """WeatherStateSource represents a source of weather data, either from a (collection of) sensor(s) (sub-concept SensorSource) or from an internet service (ServiceSource).

WeatherStateSource is connected to WeatherState via the hasSource/isSourceOf properties.""";
                        rdfs:seeAlso shw:isSourceOf,
                                     shw:hasSource,
                                     shw:WeatherState;
                        rdfs:subClassOf [owl:unionOf (shw:SensorSource
                                                      shw:ServiceSource) ; 
                                         a owl:Class],
                                        owl:Thing.
shw:WeatherState a owl:Class;
                 rdfs:comment """A WeatherState is a set of weather information (temperature, humidity etc.). It is assigned to exactly one WeatherObservation (properties belongsToWeatherObservation/hasWeatherState), has a priority (property hasPriority) and has a source (where the weather information comes from, properties hasSource/isSourceOf).

The weather information itself (temperature, humidity etc.) is provided using instances of WeatherPhenomenon that are connected using the belongsToState/hasWeatherPhenomenon properties.""";
                 rdfs:seeAlso shw:hasTemporalEntity,
                              shw:WeatherStateSource,
                              shw:hasWeatherState,
                              time:TemporalEntity,
                              shw:WeatherObservation,
                              shw:hasWeatherPhenomenon,
                              shw:WeatherPhenomenon,
                              shw:hasSource.
shw:WestWind a owl:Class;
             rdfs:comment "A WeatherPhenomenon giving information about wind. There are two properties: hasWindDirection gives the cloud cover of this layer in degrees (an integer in the interval [0-359] where 0 is North, 90 is East etc.). hasWindSpeed is a float specifying wind speed in m/s.";
             rdfs:seeAlso shw:hasWindSpeed,
                          shw:hasWindDirection,
                          shw:WeatherPhenomenon;
             owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                      [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                              owl:onProperty muo:measuredIn ; 
                                                                                              a owl:Restriction]
                                                                                              [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive 225 ]) ; 
                                                                                                                  owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                  a rdfs:Datatype] ; 
                                                                                              owl:onProperty muo:numericalValue ; 
                                                                                              a owl:Restriction]
                                                                                              [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 315 ]) ; 
                                                                                                                  owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                  a rdfs:Datatype] ; 
                                                                                              owl:onProperty muo:numericalValue ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty shw:hasWindDirection ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:metresPerSecond ; 
                                                                                              owl:onProperty muo:measuredIn ; 
                                                                                              a owl:Restriction]
                                                                                              [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                                  owl:onDatatype xsd:float ; 
                                                                                                                  a rdfs:Datatype] ; 
                                                                                              owl:onProperty muo:numericalValue ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty shw:hasWindSpeed ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
shw:Wind a owl:Class;
         rdfs:comment "A WeatherPhenomenon giving information about wind. There are two properties: hasWindDirection gives the cloud cover of this layer in degrees (an integer in the interval [0-359] where 0 is North, 90 is East etc.). hasWindSpeed is a float specifying wind speed in m/s.";
         rdfs:seeAlso shw:hasWindSpeed,
                      shw:hasWindDirection,
                      shw:WeatherPhenomenon;
         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:metresPerSecond ; 
                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                          a owl:Restriction]
                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                              a rdfs:Datatype] ; 
                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                          a owl:Restriction]) ; 
                                                                      a owl:Class] ; 
                                                  owl:onProperty shw:hasWindSpeed ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
shw:WindyWeather a owl:Class;
                 owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                          [owl:unionOf (shw:StormyWeather
                                                                       [owl:someValuesFrom shw:StrongWind ; 
                                                                       owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                       a owl:Restriction]) ; 
                                                          a owl:Class]) ; 
                                      a owl:Class].
shw:belongsToWeatherReport a owl:ObjectProperty;
                           rdfs:comment "Inverse property of hasWeatherState.";
                           rdfs:seeAlso shw:hasWeatherState;
                           rdfs:subPropertyOf owl:topObjectProperty;
                           owl:inverseOf shw:hasWeatherState.
shw:belongsToWeatherState a owl:ObjectProperty;
                          rdfs:comment "Inverse property of hasWeatherPhenomenon.";
                          rdfs:seeAlso shw:hasWeatherPhenomenon.
shw:cloudCoverage a muo:PhysicalQuality,
                    owl:NamedIndividual.
shw:hasCloudAltitude a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:domain shw:WeatherPhenomenon;
                     rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/length/meter> ; 
                                                     owl:onProperty muo:measuredIn ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom xsd:integer ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf muo:qualityValue.
shw:hasCloudCover a owl:FunctionalProperty,
                    owl:ObjectProperty;
                  rdfs:domain shw:WeatherPhenomenon;
                  rdfs:range [owl:intersectionOf ([owl:hasValue shw:okta ; 
                                                  owl:onProperty muo:measuredIn ; 
                                                  a owl:Restriction]
                                                  [owl:someValuesFrom [owl:withRestrictions ([xsd:maxInclusive 9 ]) ; 
                                                                      owl:onDatatype xsd:nonNegativeInteger ; 
                                                                      a rdfs:Datatype] ; 
                                                  owl:onProperty muo:numericalValue ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class];
                  rdfs:subPropertyOf muo:qualityValue.
shw:hasCondition a owl:ObjectProperty;
                 rdfs:comment "Links a WeatherCondition to a WeatherPhenomenon. A WeatherPhenomenon can be associated with an arbitrary number of instances of WeatherCondition.";
                 rdfs:domain shw:WeatherState;
                 rdfs:range shw:WeatherCondition;
                 rdfs:seeAlso shw:WeatherPhenomenon,
                              shw:WeatherCondition.
shw:hasDewPointValue a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:domain shw:WeatherPhenomenon;
                     rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                     owl:onProperty muo:measuredIn ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom xsd:float ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf muo:qualityValue.
shw:hasEndTime a owl:FunctionalProperty,
                 owl:ObjectProperty;
               rdfs:domain shw:WeatherReport;
               rdfs:range [owl:intersectionOf (time:Interval
                                               [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                               owl:onClass time:DateTimeDescription ; 
                                               owl:onProperty time:hasDurationDescription ; 
                                               a owl:Restriction]) ; 
                           a owl:Class].
shw:hasHumidityValue a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:domain shw:WeatherPhenomenon;
                     rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/fraction/percent> ; 
                                                     owl:onProperty muo:measuredIn ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                         owl:onDatatype xsd:float ; 
                                                                         a rdfs:Datatype] ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom [owl:withRestrictions ([xsd:maxInclusive "1.0"^^xsd:float]) ; 
                                                                         owl:onDatatype xsd:float ; 
                                                                         a rdfs:Datatype] ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf muo:qualityValue.
shw:hasNextWeatherState a owl:InverseFunctionalProperty,
                          owl:FunctionalProperty,
                          owl:ObjectProperty;
                        rdfs:domain shw:WeatherState;
                        rdfs:range shw:WeatherState.
shw:hasObservationTime a owl:FunctionalProperty,
                         owl:ObjectProperty;
                       rdfs:domain shw:WeatherReport;
                       rdfs:range [owl:intersectionOf (time:Instant
                                                       [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                       owl:onClass [owl:hasValue time:unitMinute ; 
                                                                    owl:onProperty time:unitType ; 
                                                                    a owl:Restriction] ; 
                                                       owl:onProperty time:inDateTime ; 
                                                       a owl:Restriction]) ; 
                                   a owl:Class].
shw:hasPrecipitationIntensity a owl:FunctionalProperty,
                                owl:ObjectProperty;
                              rdfs:domain shw:WeatherPhenomenon;
                              rdfs:range [owl:intersectionOf ([owl:hasValue shw:millimetresPerHour ; 
                                                              owl:onProperty muo:measuredIn ; 
                                                              a owl:Restriction]
                                                              [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                  owl:onDatatype xsd:float ; 
                                                                                  a rdfs:Datatype] ; 
                                                              owl:onProperty muo:numericalValue ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class];
                              rdfs:subPropertyOf muo:qualityValue.
shw:hasPrecipitationProbability a owl:FunctionalProperty,
                                  owl:ObjectProperty;
                                rdfs:domain shw:WeatherPhenomenon;
                                rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/fraction/percent> ; 
                                                                owl:onProperty muo:measuredIn ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                    owl:onDatatype xsd:float ; 
                                                                                    a rdfs:Datatype] ; 
                                                                owl:onProperty muo:numericalValue ; 
                                                                a owl:Restriction]
                                                                [owl:someValuesFrom [owl:withRestrictions ([xsd:maxInclusive "1.0"^^xsd:float]) ; 
                                                                                    owl:onDatatype xsd:float ; 
                                                                                    a rdfs:Datatype] ; 
                                                                owl:onProperty muo:numericalValue ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class];
                                rdfs:subPropertyOf muo:qualityValue.
shw:hasPressureValue a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:domain shw:WeatherPhenomenon;
                     rdfs:range [owl:intersectionOf ([owl:hasValue shw:hectopascal ; 
                                                     owl:onProperty muo:measuredIn ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom xsd:float ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf muo:qualityValue.
shw:hasPreviousWeatherState a owl:ObjectProperty;
                            owl:inverseOf shw:hasNextWeatherState.
shw:hasPriority a owl:FunctionalProperty,
                  owl:DatatypeProperty;
                rdfs:comment "Specifies the priority of a WeatherState (a positive integer). The higher this value is compared to another WeatherState's priority, the more the WeatherState takes precedence over the other WeatherState.";
                rdfs:domain shw:WeatherReport;
                rdfs:range xsd:positiveInteger;
                rdfs:subPropertyOf owl:topDataProperty.
shw:hasSolarRadiationValue a owl:FunctionalProperty,
                             owl:ObjectProperty;
                           rdfs:domain shw:WeatherPhenomenon;
                           rdfs:range [owl:intersectionOf ([owl:hasValue shw:wattsPerSquareMeter ; 
                                                           owl:onProperty muo:measuredIn ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                               owl:onDatatype xsd:float ; 
                                                                               a rdfs:Datatype] ; 
                                                           owl:onProperty muo:numericalValue ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class];
                           rdfs:subPropertyOf muo:qualityValue.
shw:hasSource a owl:FunctionalProperty,
                owl:ObjectProperty;
              rdfs:comment "Associates a WeatherStateSource with a WeatherState, i.e. specifies where a WeatherState's data comes from. One WeatherState can only have one WeatherStateSource.";
              rdfs:domain shw:WeatherReport;
              rdfs:range shw:WeatherReportSource;
              rdfs:seeAlso shw:isSourceOf,
                           shw:WeatherStateSource,
                           shw:WeatherState.
shw:hasStartTime a owl:FunctionalProperty,
                   owl:ObjectProperty;
                 rdfs:domain shw:WeatherReport;
                 rdfs:range [owl:intersectionOf (time:Interval
                                                 [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 owl:onClass time:DateTimeDescription ; 
                                                 owl:onProperty time:hasDurationDescription ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
shw:hasSunDirection a owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:domain shw:WeatherPhenomenon;
                    rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                    owl:onProperty muo:measuredIn ; 
                                                    a owl:Restriction]
                                                    [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                        owl:onDatatype xsd:nonNegativeInteger ; 
                                                                        a rdfs:Datatype] ; 
                                                    owl:onProperty muo:numericalValue ; 
                                                    a owl:Restriction]) ; 
                                a owl:Class];
                    rdfs:subPropertyOf muo:qualityValue.
shw:hasSunElevationAngle a owl:FunctionalProperty,
                           owl:ObjectProperty;
                         rdfs:domain shw:WeatherPhenomenon;
                         rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                         owl:onProperty muo:measuredIn ; 
                                                         a owl:Restriction]
                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "-90.0"^^xsd:float]) ; 
                                                                             owl:onDatatype xsd:float ; 
                                                                             a rdfs:Datatype] ; 
                                                         owl:onProperty muo:numericalValue ; 
                                                         a owl:Restriction]
                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:maxInclusive "90.0"^^xsd:float]) ; 
                                                                             owl:onDatatype xsd:float ; 
                                                                             a rdfs:Datatype] ; 
                                                         owl:onProperty muo:numericalValue ; 
                                                         a owl:Restriction]) ; 
                                     a owl:Class];
                         rdfs:subPropertyOf muo:qualityValue.
shw:hasTemperatureValue a owl:FunctionalProperty,
                          owl:ObjectProperty;
                        rdfs:domain shw:WeatherPhenomenon;
                        rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                        owl:onProperty muo:measuredIn ; 
                                                        a owl:Restriction]
                                                        [owl:someValuesFrom xsd:float ; 
                                                        owl:onProperty muo:numericalValue ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class];
                        rdfs:subPropertyOf muo:qualityValue.
shw:hasWeatherPhenomenon a owl:InverseFunctionalProperty,
                           owl:ObjectProperty;
                         rdfs:comment "Associates a WeatherPhenomenon to its WeatherState. One WeatherPhenomenon can only belong to one WeatherState, but one WeatherState can have an arbitrary number of instances of WeatherPhenomenon.";
                         rdfs:domain shw:WeatherState;
                         rdfs:range shw:WeatherPhenomenon;
                         rdfs:seeAlso shw:belongsToState,
                                      shw:WeatherState,
                                      shw:WeatherPhenomenon;
                         owl:inverseOf shw:belongsToWeatherState.
shw:hasWeatherState a owl:InverseFunctionalProperty,
                      owl:FunctionalProperty,
                      owl:ObjectProperty;
                    rdfs:comment "Associates a WeatherState to a WeatherObservation. One WeatherState can only be associated with one WeatherObservation.";
                    rdfs:domain shw:WeatherReport;
                    rdfs:range shw:WeatherState;
                    rdfs:seeAlso shw:belongsToWeather,
                                 shw:WeatherState,
                                 shw:WeatherObservation.
shw:hasWindDirection a owl:FunctionalProperty,
                       owl:ObjectProperty;
                     rdfs:domain shw:WeatherPhenomenon;
                     rdfs:range [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                     owl:onProperty muo:measuredIn ; 
                                                     a owl:Restriction]
                                                     [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                         owl:onDatatype xsd:nonNegativeInteger ; 
                                                                         a rdfs:Datatype] ; 
                                                     owl:onProperty muo:numericalValue ; 
                                                     a owl:Restriction]) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf muo:qualityValue.
shw:hasWindSpeed a owl:FunctionalProperty,
                   owl:ObjectProperty;
                 rdfs:domain shw:WeatherPhenomenon;
                 rdfs:range [owl:intersectionOf ([owl:hasValue shw:metresPerSecond ; 
                                                 owl:onProperty muo:measuredIn ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                     owl:onDatatype xsd:float ; 
                                                                     a rdfs:Datatype] ; 
                                                 owl:onProperty muo:numericalValue ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class];
                 rdfs:subPropertyOf muo:qualityValue.
shw:hectopascal muo:derivesFrom <http://purl.oclc.org/NET/muo/ucum/unit/pressure/Pascal>;
                muo:measuresQuality <http://purl.oclc.org/NET/muo/ucum/physical-quality/pressure>;
                muo:modifierPrefix <http://purl.oclc.org/NET/muo/ucum/prefix/hecto>;
                a muo:SimpleDerivedUnit,
                  owl:NamedIndividual.
shw:irradiance a muo:PhysicalQuality,
                 owl:NamedIndividual.
shw:isSourceOf a owl:ObjectProperty;
               rdfs:comment "Inverse property of hasSource.";
               rdfs:seeAlso shw:hasSource;
               owl:inverseOf shw:hasSource.
shw:metresPerSecond muo:derivesFrom <http://purl.oclc.org/NET/muo/ucum/unit/time/second>,
                                    <http://purl.oclc.org/NET/muo/ucum/unit/length/meter>;
                    muo:measuresQuality shw:speed;
                    a muo:ComplexDerivedUnit,
                      owl:NamedIndividual.
shw:millimeter muo:derivesFrom <http://purl.oclc.org/NET/muo/ucum/unit/length/meter>;
               muo:measuresQuality <http://purl.oclc.org/NET/muo/ucum/physical-quality/length>;
               muo:modifierPrefix <http://purl.oclc.org/NET/muo/ucum/prefix/milli>;
               a muo:SimpleDerivedUnit,
                 owl:NamedIndividual.
shw:millimetresPerHour muo:derivesFrom shw:millimeter,
                                       <http://purl.oclc.org/NET/muo/ucum/unit/time/hour>;
                       muo:measuresQuality shw:precipitationIntensity;
                       a muo:ComplexDerivedUnit,
                         owl:NamedIndividual.
shw:okta muo:measuresQuality shw:cloudCoverage;
         muo:prefSymbol "";
         ucum:code1 "";
         ucum:code2 "";
         a muo:UnitOfMeasurement,
           owl:NamedIndividual.
shw:precipitationIntensity a muo:PhysicalQuality,
                             owl:NamedIndividual.
shw:speed a muo:PhysicalQuality,
            owl:NamedIndividual.
shw:squareMeter muo:derivesFrom <http://purl.oclc.org/NET/muo/ucum/unit/length/meter>;
                muo:measuresQuality <http://purl.oclc.org/NET/muo/ucum/physical-quality/area>;
                a muo:SimpleDerivedUnit,
                  owl:NamedIndividual.
shw:wattsPerSquareMeter muo:derivesFrom shw:squareMeter,
                                        <http://purl.oclc.org/NET/muo/ucum/unit/power/Watt>;
                        muo:measuresQuality shw:irradiance;
                        a muo:ComplexDerivedUnit,
                          owl:NamedIndividual.
muo:numericalValue a owl:FunctionalProperty,
                     owl:DatatypeProperty;
                   rdfs:domain muo:QualityValue.
dc11:date a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
wgspos: dc11:date "$Date: 2009/04/20 15:00:30 $";
        dc11:description """A vocabulary for representing latitude, longitude and 
 altitude information in the WGS84 geodetic reference datum. 
 Version $Id: wgs84_pos.rdf,v 1.22 2009/04/20 15:00:30 timbl Exp $. See http://www.w3.org/2003/01/geo/ for more details.""";
        dc11:title "WGS84 Geo Positioning: an RDF vocabulary";
        rdfs:comment """Recent changes to this namespace:
$Log: wgs84_pos.rdf,v $
Revision 1.22  2009/04/20 15:00:30  timbl
Remove the time bits which have been deal with elsewhere eg in iCal.

Revision 1.21  2009/04/20 12:52:47  timbl
try again

Revision 1.20  2009/04/20 12:42:11  timbl
Add Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)

Revision 1.19  2009/04/20 12:36:31  timbl
Add Event (edited ages ago and never checked in), and location (following discussion http://chatlogs.planetrdf.com/swig/2009-04-20#T12-36-09)

Revision 1.18  2006/02/01 22:01:04  danbri
Clarified that lat and long are decimal degrees, and that alt is decimal metres about local reference ellipsoid

Revision 1.17  2004/02/06 17:38:12  danbri
Fixed a bad commit screwup

Revision 1.15  2003/04/19 11:24:08  danbri
Fixed the typo even more.

Revision 1.14  2003/04/19 11:16:56  danbri
fixed a typo

Revision 1.13  2003/02/19 22:27:27  connolly
relaxed domain constraints on lat/long/alt from Point to SpatialThing

Revision 1.12  2003/01/12 01:41:41  danbri
Trying local copy of XSLT doc.

Revision 1.11  2003/01/12 01:20:18  danbri
added a link to morten's xslt rdfs viewer.

Revision 1.10  2003/01/11 18:56:49  danbri
Removed datatype range from lat and long properties, since they would
have required each occurance of the property to mention the datatype.

Revision 1.9  2003/01/11 11:41:31  danbri
Another typo; repaired rdfs:Property to rdf:Property x4

Revision 1.8  2003/01/11 11:05:02  danbri
Added an rdfs:range for each lat/long/alt property,
http://www.w3.org/2001/XMLSchema#float

Revision 1.7  2003/01/10 20:25:16  danbri
Longer rdfs:comment for Point, trying to be Earth-centric and neutral about
coordinate system(s) at the same time. Feedback welcomed.

Revision 1.6  2003/01/10 20:18:30  danbri
Added CVS log comments into the RDF/XML as an rdfs:comment property of the
vocabulary. Note that this is not common practice (but seems both harmless
and potentially useful).


revision 1.5
date: 2003/01/10 20:14:31;  author: danbri;  state: Exp;  lines: +16 -5
Updated schema:
Added a dc:date, added url for more info. Changed the rdfs:label of the
namespace from gp to geo. Added a class Point, set as the rdfs:domain of
each property. Added XML comment on the lat_long property suggesting that
we might not need it (based on #rdfig commentary from implementors).

revision 1.4
date: 2003/01/10 20:01:07;  author: danbri;  state: Exp;  lines: +6 -5
Fixed typo; several rdfs:about attributes are now rdf:about. Thanks to MortenF in
#rdfig for catching this error.

revision 1.3
date: 2003/01/10 11:59:03;  author: danbri;  state: Exp;  lines: +4 -3
fixed buglet in vocab, added more wgs links

revision 1.2
date: 2003/01/10 11:01:11;  author: danbri;  state: Exp;  lines: +4 -4
Removed alt from the as-a-flat-string property, and switched from
space separated to comma separated.

revision 1.1
date: 2003/01/10 10:53:23;  author: danbri;  state: Exp;
basic geo vocab""";
        rdfs:label "geo".
wgspos:Point a owl:Class;
             rdfs:comment "A point, typically described using a coordinate system relative to Earth, such as WGS84.",
                          """Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).""";
             rdfs:label "point";
             rdfs:subClassOf wgspos:SpatialThing.
wgspos:SpatialThing a owl:Class;
                    rdfs:comment """Anything with spatial extent, i.e. size, shape, or position.
 e.g. people, places, bowling balls, as well as abstract areas like cubes.""";
                    rdfs:label "SpatialThing".
wgspos:alt a owl:FunctionalProperty,
             owl:DatatypeProperty;
           rdfs:domain wgspos:SpatialThing.
wgspos:lat a owl:FunctionalProperty,
             owl:DatatypeProperty;
           rdfs:domain wgspos:SpatialThing.
wgspos:lat_long rdfs:comment "A comma-separated representation of a latitude, longitude coordinate.";
                rdfs:label "lat/long".
wgspos:location a owl:FunctionalProperty,
                  owl:ObjectProperty;
                rdfs:range wgspos:SpatialThing;
                rdfs:subPropertyOf foaf:based_near.
wgspos:long a owl:FunctionalProperty,
              owl:DatatypeProperty;
            rdfs:domain wgspos:SpatialThing;
            rdfs:subPropertyOf owl:topDataProperty.
time:TemporalEntity rdfs:comment "A TemporalEntity describes the temporal dimension of a WeatherState. This can either be a specific moment (an Instant that has a specific time) or a period of time (an Interval having a start time and an end time).";
                    rdfs:seeAlso time:Interval,
                                 time:Instant,
                                 shw:WeatherState.
foaf:based_near a owl:ObjectProperty.
