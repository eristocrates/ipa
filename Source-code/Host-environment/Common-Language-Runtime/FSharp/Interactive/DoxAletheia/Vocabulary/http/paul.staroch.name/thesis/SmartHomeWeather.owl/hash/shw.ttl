<http://paul.staroch.name/foaf/staroch.rdf#paul> a foaf:Person.
shw: ccrel:license <http://creativecommons.org/licenses/by/3.0/>;
     dc11:contributor <http://paul.staroch.name/foaf/staroch.rdf#paul>,
                      "Mario Kofler";
     dc11:creator <http://paul.staroch.name/foaf/staroch.rdf#paul>;
     dc11:description "A ontology defining weather-related concepts and properties being relevant to smart home systems that provide predictive control.";
     dc11:issued "2013-08-29"^^xsd:date;
     dc11:modified "2014-03-23"^^xsd:date;
     dc11:publisher <http://paul.staroch.name/foaf/staroch.rdf#paul>;
     dc11:title "SmartHomeWeather";
     vann:preferredNamespacePrefix "shw";
     vann:preferredNamespaceUri "http://paul.staroch.name/thesis/SmartHomeWeather.owl";
     a owl:Ontology;
     owl:imports <http://www.w3.org/2006/time>,
                 ucum:;
     owl:versionInfo 1.0.
shw:AboveRoomTemperature a owl:Class;
                         rdfs:comment "A WeatherPhenomenon describing a temperature of more than 25 degrees Celsius.";
                         rdfs:seeAlso shw:hasTemperature,
                                      shw:WeatherPhenomenon,
                                      shw:Temperature;
                         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minExclusive "25.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxInclusive "30.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty shw:hasTemperatureValue ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
shw:AiringWeather a owl:Class;
                  owl:equivalentClass [owl:intersectionOf (shw:FairWeather
                                                           shw:PleasantTemperatureWeather) ; 
                                       a owl:Class].
shw:AstronomicalTwilight a owl:Class;
                         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                                                                              owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty shw:hasSunDirection ; 
                                                                  a owl:Restriction]
                                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "-18.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "-12.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty shw:hasSunElevationAngle ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
shw:AtmosphericPressure a owl:Class;
                        rdfs:comment "A WeatherPhenomenon specifying atmospheric pressure using the hasPressure property (in hPa/mbar on MSL).";
                        rdfs:seeAlso shw:hasPressure,
                                     shw:WeatherPhenomenon;
                        owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                                 [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:hectopascal ; 
                                                                                                         owl:onProperty muo:measuredIn ; 
                                                                                                         a owl:Restriction]
                                                                                                         [owl:someValuesFrom xsd:float ; 
                                                                                                         owl:onProperty muo:numericalValue ; 
                                                                                                         a owl:Restriction]) ; 
                                                                                     a owl:Class] ; 
                                                                 owl:onProperty shw:hasPressureValue ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
shw:BelowRoomTemperature a owl:Class;
                         rdfs:comment "A WeatherPhenomenon describing a temperature of less than 20 degrees Celsius.";
                         rdfs:seeAlso shw:hasTemperature,
                                      shw:WeatherPhenomenon,
                                      shw:Temperature;
                         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "10.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]
                                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "20.0"^^xsd:float]) ; 
                                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                                              a rdfs:Datatype] ; 
                                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty shw:hasTemperatureValue ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
shw:Calm a owl:Class;
         rdfs:comment "A WeatherPhenomenon describing a wind speed of less than 1 m/s.";
         rdfs:seeAlso shw:hasWindSpeed,
                      shw:hasWindDirection,
                      shw:Wind,
                      shw:WeatherPhenomenon;
         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:metresPerSecond ; 
                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                          a owl:Restriction]
                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                              a rdfs:Datatype] ; 
                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                          a owl:Restriction]
                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "1.0"^^xsd:float]) ; 
                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                              a rdfs:Datatype] ; 
                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                          a owl:Restriction]) ; 
                                                                      a owl:Class] ; 
                                                  owl:onProperty shw:hasWindSpeed ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
shw:CalmWeather a owl:Class;
                owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                         [owl:unionOf ([owl:someValuesFrom shw:Calm ; 
                                                                      owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                      a owl:Restriction]
                                                                      [owl:someValuesFrom shw:LightWind ; 
                                                                      owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                      a owl:Restriction]) ; 
                                                         a owl:Class]) ; 
                                     a owl:Class].
shw:CivilTwilight a owl:Class;
                  owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                           [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                                   owl:onProperty muo:measuredIn ; 
                                                                                                   a owl:Restriction]
                                                                                                   [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                                                                       owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                       a rdfs:Datatype] ; 
                                                                                                   owl:onProperty muo:numericalValue ; 
                                                                                                   a owl:Restriction]) ; 
                                                                               a owl:Class] ; 
                                                           owl:onProperty shw:hasSunDirection ; 
                                                           a owl:Restriction]
                                                           [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                                   owl:onProperty muo:measuredIn ; 
                                                                                                   a owl:Restriction]
                                                                                                   [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "-6.0"^^xsd:float]) ; 
                                                                                                                       owl:onDatatype xsd:float ; 
                                                                                                                       a rdfs:Datatype] ; 
                                                                                                   owl:onProperty muo:numericalValue ; 
                                                                                                   a owl:Restriction]
                                                                                                   [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "0.0"^^xsd:float]) ; 
                                                                                                                       owl:onDatatype xsd:float ; 
                                                                                                                       a rdfs:Datatype] ; 
                                                                                                   owl:onProperty muo:numericalValue ; 
                                                                                                   a owl:Restriction]) ; 
                                                                               a owl:Class] ; 
                                                           owl:onProperty shw:hasSunElevationAngle ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
shw:ClearSky a owl:Class;
             rdfs:comment """A WeatherPhenomenon describing a cloud layer with cloud cover 0 (clear sky).

NOTE: This class only specifies a single cloud layer. It does not make any statement about other cloud layers.""";
             rdfs:seeAlso shw:hasCloudCover,
                          shw:hasCloudAltitude,
                          shw:WeatherPhenomenon,
                          shw:CloudCover;
             owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                      [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:okta ; 
                                                                                              owl:onProperty muo:measuredIn ; 
                                                                                              a owl:Restriction]
                                                                                              [owl:hasValue 0  ; 
                                                                                              owl:onProperty muo:numericalValue ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty shw:hasCloudCover ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
shw:ClearWeather a owl:Class;
                 owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                          [owl:unionOf ([owl:someValuesFrom shw:ClearSky ; 
                                                                       owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                       a owl:Restriction]
                                                                       [owl:someValuesFrom shw:PartlyCloudy ; 
                                                                       owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                       a owl:Restriction]) ; 
                                                          a owl:Class]) ; 
                                      a owl:Class].
shw:Cloud a shw:WeatherCondition,
            owl:NamedIndividual.
shw:CloudCover a owl:Class;
               rdfs:comment """A WeatherPhenomenon giving information about a cloud layer. There are two properties: hasCloudCover gives the cloud cover of this layer in okta (an integer in the interval [0-9] where 0 is clear sky, 8 is overcast and 9 is unknown). hasCloudAltitude gives the altitude of that cloud layer.

If there is more than one cloud layer, for each cloud layer another WeatherPhenomenon must be created and linked to the appropriate WeatherState.""";
               rdfs:seeAlso shw:hasCloudCover,
                            shw:hasCloudAltitude,
                            shw:WeatherPhenomenon;
               owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                        [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:okta ; 
                                                                                                owl:onProperty muo:measuredIn ; 
                                                                                                a owl:Restriction]
                                                                                                [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 10 ]) ; 
                                                                                                                    owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                    a rdfs:Datatype] ; 
                                                                                                owl:onProperty muo:numericalValue ; 
                                                                                                a owl:Restriction]) ; 
                                                                            a owl:Class] ; 
                                                        owl:onProperty shw:hasCloudCover ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class].
shw:CloudyWeather a owl:Class;
                  owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                           [owl:unionOf ([owl:someValuesFrom shw:MostlyCloudy ; 
                                                                        owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                        a owl:Restriction]
                                                                        [owl:someValuesFrom shw:Overcast ; 
                                                                        owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                        a owl:Restriction]) ; 
                                                           a owl:Class]) ; 
                                       a owl:Class].
shw:Cold a owl:Class;
         owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                  [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                                                          owl:onProperty muo:measuredIn ; 
                                                                                          a owl:Restriction]
                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                              a rdfs:Datatype] ; 
                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                          a owl:Restriction]
                                                                                          [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "10.0"^^xsd:float]) ; 
                                                                                                              owl:onDatatype xsd:float ; 
                                                                                                              a rdfs:Datatype] ; 
                                                                                          owl:onProperty muo:numericalValue ; 
                                                                                          a owl:Restriction]) ; 
                                                                      a owl:Class] ; 
                                                  owl:onProperty shw:hasTemperatureValue ; 
                                                  a owl:Restriction]) ; 
                              a owl:Class].
shw:ColdWeather a owl:Class;
                owl:equivalentClass [owl:intersectionOf (shw:WeatherState
                                                         [owl:unionOf ([owl:someValuesFrom shw:Cold ; 
                                                                      owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                      a owl:Restriction]
                                                                      [owl:someValuesFrom shw:Frost ; 
                                                                      owl:onProperty shw:hasWeatherPhenomenon ; 
                                                                      a owl:Restriction]) ; 
                                                         a owl:Class]) ; 
                                     a owl:Class].
shw:CurrentWeatherReport a owl:Class;
                         rdfs:comment "A WeatherState describing the current weather.";
                         rdfs:seeAlso shw:hasTime,
                                      shw:ZeroHour,
                                      shw:WeatherState;
                         owl:disjointWith shw:ForecastWeatherReport;
                         owl:equivalentClass [owl:intersectionOf (shw:WeatherReport
                                                                  [owl:someValuesFrom [owl:someValuesFrom [owl:hasValue 0  ; 
                                                                                                          owl:onProperty time:hours ; 
                                                                                                          a owl:Restriction] ; 
                                                                                      owl:onProperty time:hasDurationDescription ; 
                                                                                      a owl:Restriction] ; 
                                                                  owl:onProperty shw:hasStartTime ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
shw:CurrentWeatherReportFromSensor a owl:Class;
                                   rdfs:comment "A WeatherState about the current weather based on data retrieved from a (collection of) sensor(s), e.g. it is connected to an instance of SensorSource via the hasSource property.";
                                   rdfs:seeAlso shw:WeatherStateFromSensor,
                                                shw:WeatherState,
                                                shw:CurrentWeatherState;
                                   owl:equivalentClass [owl:intersectionOf (shw:CurrentWeatherReport
                                                                            shw:WeatherReportFromSensor) ; 
                                                        a owl:Class].
shw:CurrentWeatherReportFromService a owl:Class;
                                    rdfs:comment "A WeatherState about the current weather based on data retrieved from an internet service, e.g. it is connected to an instance of ServiceSource via the hasSource property.";
                                    rdfs:seeAlso shw:WeatherStateFromService,
                                                 shw:WeatherState,
                                                 shw:CurrentWeatherState;
                                    owl:equivalentClass [owl:intersectionOf (shw:CurrentWeatherReport
                                                                             shw:WeatherReportFromService) ; 
                                                         a owl:Class].
shw:Day a owl:Class;
        owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                 [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                         owl:onProperty muo:measuredIn ; 
                                                                                         a owl:Restriction]
                                                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                                                             owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                             a rdfs:Datatype] ; 
                                                                                         owl:onProperty muo:numericalValue ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty shw:hasSunDirection ; 
                                                 a owl:Restriction]
                                                 [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                         owl:onProperty muo:measuredIn ; 
                                                                                         a owl:Restriction]
                                                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                             owl:onDatatype xsd:float ; 
                                                                                                             a rdfs:Datatype] ; 
                                                                                         owl:onProperty muo:numericalValue ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
                                                 owl:onProperty shw:hasSunElevationAngle ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
shw:DewPoint a owl:Class;
             rdfs:comment "A WeatherPhenomenon specifying the dew point. The actual value is specified in degrees Celsius using the hasDewPoint property.";
             rdfs:seeAlso shw:hasDewPoint,
                          shw:WeatherPhenomenon;
             owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                      [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/temperature/degree-Celsius> ; 
                                                                                              owl:onProperty muo:measuredIn ; 
                                                                                              a owl:Restriction]
                                                                                              [owl:someValuesFrom xsd:float ; 
                                                                                              owl:onProperty muo:numericalValue ; 
                                                                                              a owl:Restriction]) ; 
                                                                          a owl:Class] ; 
                                                      owl:onProperty shw:hasDewPointValue ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class].
shw:DirectionalWind a owl:Class;
                    rdfs:comment "A WeatherPhenomenon giving information about wind. There are two properties: hasWindDirection gives the cloud cover of this layer in degrees (an integer in the interval [0-359] where 0 is North, 90 is East etc.). hasWindSpeed is a float specifying wind speed in m/s.";
                    rdfs:seeAlso shw:hasWindSpeed,
                                 shw:hasWindDirection,
                                 shw:WeatherPhenomenon;
                    owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                             [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/plane-angle/degree> ; 
                                                                                                     owl:onProperty muo:measuredIn ; 
                                                                                                     a owl:Restriction]
                                                                                                     [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive 360 ]) ; 
                                                                                                                         owl:onDatatype xsd:nonNegativeInteger ; 
                                                                                                                         a rdfs:Datatype] ; 
                                                                                                     owl:onProperty muo:numericalValue ; 
                                                                                                     a owl:Restriction]) ; 
                                                                                 a owl:Class] ; 
                                                             owl:onProperty shw:hasWindDirection ; 
                                                             a owl:Restriction]
                                                             [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue shw:metresPerSecond ; 
                                                                                                     owl:onProperty muo:measuredIn ; 
                                                                                                     a owl:Restriction]
                                                                                                     [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.0"^^xsd:float]) ; 
                                                                                                                         owl:onDatatype xsd:float ; 
                                                                                                                         a rdfs:Datatype] ; 
                                                                                                     owl:onProperty muo:numericalValue ; 
                                                                                                     a owl:Restriction]) ; 
                                                                                 a owl:Class] ; 
                                                             owl:onProperty shw:hasWindSpeed ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class].
shw:Dry a owl:Class;
        rdfs:comment "A WeatherPhenomenon describing a humidity of less than 40 percent.";
        rdfs:seeAlso shw:hasHumidity,
                     shw:WeatherPhenomenon;
        owl:equivalentClass [owl:intersectionOf (shw:WeatherPhenomenon
                                                 [owl:someValuesFrom [owl:intersectionOf ([owl:hasValue <http://purl.oclc.org/NET/muo/ucum/unit/fraction/percent> ; 
                                                                                         owl:onProperty muo:measuredIn ; 
                                                                                         a owl:Restriction]
                                                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:minInclusive "0.3"^^xsd:float]) ; 
                                                                                                             owl:onDatatype xsd:float ; 
                                                                                                             a rdfs:Datatype] ; 
                                                                                         owl:onProperty muo:numericalValue ; 
                                                                                         a owl:Restriction]
                                                                                         [owl:someValuesFrom [owl:withRestrictions ([xsd:maxExclusive "0.4"^^xsd:float]) ; 
                                                                                                             owl:onDatatype xsd:float ; 
                                                                                                             a rdfs:Datatype] ; 
                                                                                         owl:onProperty muo:numericalValue ; 
                                                                                         a owl:Restriction]) ; 
                                                                     a owl:Class] ; 
