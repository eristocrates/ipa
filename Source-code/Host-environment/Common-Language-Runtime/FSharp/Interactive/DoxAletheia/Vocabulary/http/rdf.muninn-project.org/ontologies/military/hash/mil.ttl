                                    mil:MilitaryRank;
                                  rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                  rdfs:label "Admiral"@en,
                                             "Admiral"@de,
                                             "Amiral"@fr;
                                  owl:sameAs resource:Admiral;
                                  skos:definition """Admiral is the rank, or part of the name of the ranks, of the highest naval officers. It is usually considered a full admiral (equivalent to full general) and above vice admiral and below admiral of the fleet. It is usually abbreviated to \"Adm\" or \"ADM\". Where relevant, admiral has a NATO code of OF-9, and is a 4 star rank."""@en;
                                  skos:inScheme mil:NavyServiceBranch;
                                  org:rankEquivalentTo mil:Rank_Air_marshal_EnglishTradition,
                                                       mil:Rank_General_officer_EnglishTradition;
                                  org:rankJuniorToTransitive mil:Rank_Admiral_of_the_fleet_EnglishTradition;
                                  org:rankSeniorToTransitive <http://rdf.muninn-project.org/ontologies/military#Rank_Commodore_(rank)_EnglishTradition>.
