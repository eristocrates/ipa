mil:Rank_Schout-bij-nacht void:inDataset mil:datasetdefinition;
                          a skos:Concept,
                            mil:MilitaryRank;
                          rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                          rdfs:label "Schout-bij-nacht"@nl,
                                     "Schout-bij-nacht"@fr,
                                     "Schout-bij-nacht"@en,
                                     "Schoutbynacht"@no,
                                     "Schoutbynacht"@sv,
                                     "Ð¨Ð°ÑÑÐ±ÐµÐ½Ð°ÑÑ"@ru;
                          owl:sameAs resource:Schout-bij-nacht;
                          skos:definition "Schout-bij-nacht is a Dutch Naval rank, equivalent to Rear Admiral in the US Navy and Royal Navy. It is the second most junior Admiral position of the Dutch Navy, ranking above Commandeur and below a Vice-admiraal. The rank of Schout-bij-nacht originated between the 15th and 16th century. Translated as Watch-at-night, the Schout-bij-Nacht was the officer who supervised the ship when the Captain was asleep."@en;
                          foaf:name "Schout-bij-nacht".
