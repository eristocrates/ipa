              rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
              rdfs:label "Next Of Kin"@en;
              <http://www.w3.org/2004/02/skos/core#definition> "A person with a loose family / emotional connection that is listed by someone to be contacted in the event of death. This is a loosely defined term meant for commemoration and honour roll purposes.This term does not provide a hook for provenance information."@en;
              <http://xmlns.com/foaf/0.1/name> "Next Of Kin"@en.
mil:nominalSize <http://rdfs.org/ns/void#inDataset> mil:datasetdefinition;
                a <http://www.w3.org/2004/02/skos/core#Concept>,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                rdfs:label "Nominal Unit Size"@en;
                <http://xmlns.com/foaf/0.1/name> "Nominal unit size".
mil:placeOfEnlistment <http://rdfs.org/ns/void#inDataset> mil:datasetdefinition;
                      a <http://www.w3.org/2004/02/skos/core#Concept>,
                        <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                      rdfs:label "Place Of Enlistment"@en;
                      <http://www.w3.org/2004/02/skos/core#definition> "The place of initial enlistment into a military. This is property that is meant for commemoration purposes. For bureaucratic and historical reasons, this property may occur more than once.This term does not provide a hook for provenance information."@en;
                      <http://xmlns.com/foaf/0.1/name> "Place Of Enlistment"@en.
mil:rankOf <http://rdfs.org/ns/void#inDataset> mil:datasetdefinition;
           a <http://www.w3.org/2004/02/skos/core#Concept>,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:domain <http://www.w3.org/ns/org#Organization>;
           rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
           rdfs:label "Rank used by"@en;
           rdfs:range mil:MilitaryRank;
           rdfs:subPropertyOf <http://www.w3.org/2004/02/skos/core#inScheme>;
           <http://xmlns.com/foaf/0.1/name> "rankOf".
mil:spacethefinalfrontier <http://rdfs.org/ns/void#inDataset> mil:datasetdefinition;
                          a <http://www.w3.org/2004/02/skos/core#Concept>,
