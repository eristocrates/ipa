mil:Rank_Kapudan_Pasha void:inDataset mil:datasetdefinition;
                       a skos:Concept,
                         mil:MilitaryRank;
                       rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                       rdfs:label "Capitan pacha"@fr,
                                  "Kapudan Pascha"@de,
                                  "Kapudan Pasha"@en,
                                  "ÐÐ°Ð¿ÑÐ´Ð°Ð½-Ð¿Ð°ÑÐ°"@ru;
                       owl:sameAs resource:Kapudan_Pasha;
                       skos:definition "Kapudan Pasha or Kapudan-i Derya were the titles given to the chief commander of the navy in the Ottoman Empire. The title Kapudan-i Derya was first granted during the reign of Bayezid I as an official rank within the state structure. Starting with the reign of Mehmed II, holders of the rank were accorded the status of viziers and held the title of Pasha, thus they were more often called Kapudan Pasha."@en;
                       foaf:name "Kapudan Pasha".
