mil:Rank_Marshal_EnglishTradition mil:rankOf mil:EnglishTradition;
                                  void:inDataset mil:datasetdefinition;
                                  a skos:Concept,
                                    mil:MilitaryRank;
                                  rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                  rdfs:label "Maréchal (armée)"@fr,
                                             "Marschall"@de,
                                             "Marshal"@en,
                                             "Marshal"@fr;
                                  owl:sameAs resource:Marshal;
                                  skos:definition """Marshal (also spelled marshall, more commonly in British English than American English), is a word used in several official titles of various branches of society. The word is an ancient loan word from Old (Norman) French, cf. modern French maréchal, which in turn is a borrowing from Old Frankish *marhskalk \"stable boy, keeper, servant\", still continued by Middle Dutch maerscalc, marscal \"id. \", modern Dutch maarschalk \"military commander\" (the meaning is under French influence)."""@en;
                                  skos:inScheme mil:ArmyServiceBranch;
                                  org:rankEquivalentTo mil:Rank_Admiral_of_the_fleet_EnglishTradition,
                                                       mil:Rank_Marshal_of_the_air_force_EnglishTradition.
mil:Rank_Marshal_of_the_Soviet_Union void:inDataset mil:datasetdefinition;
                                     a mil:MilitaryRank,
                                       skos:Concept;
                                     rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                     rdfs:label "ÐÐ°ÑÑÐ°Ð» Ð¡Ð¾Ð²ÐµÑÑÐºÐ¾Ð³Ð¾ Ð¡Ð¾ÑÐ·Ð°"@ru,
                                                "Maréchal de l'Union soviétique"@fr,
                                                "Marshal of the Soviet Union"@en,
                                                "Neuvostoliiton marsalkka"@fi,
                                                "Marechal da União Soviética"@pt,
                                                "Maresciallo dell'Unione Sovietica"@it,
                                                "Maarschalk van de Sovjet-Unie"@nl,
                                                "Marschall der Sowjetunion"@de,
                                                "MarszaÅkowie ZSRR"@pl,
                                                "Mariscal de la Unión Soviética"@es,
                                                "Marskalk av Sovjetunionen"@no,
                                                "Marskalk av Sovjetunionen"@sv;
                                     owl:sameAs resource:Marshal_of_the_Soviet_Union;
                                     skos:definition "Marshal of the Soviet Union was the de facto highest military rank of the Soviet Union. (The highest rank de jure, Generalissimus of the Soviet Union, was created for Joseph Stalin and held by him alone). The rank of Marshal of the Soviet Union was created in 1935 and abolished in 1991. Forty-one people held the rank of Marshal of the Soviet Union. The equivalent naval rank was Admiral of the Fleet of the Soviet Union."@en;
                                     foaf:name "Marshal of the Soviet Union".
