mil:Rank_Trierarch void:inDataset mil:datasetdefinition;
                   a mil:MilitaryRank,
                     skos:Concept;
                   rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                   rdfs:label "Trierarch"@en,
                              "Ð¢ÑÐ¸ÐµÑÐ°ÑÑÐ¸Ñ"@ru,
                              "Trierarca"@es,
                              "Trierarchie"@de,
                              "Trierarchia"@it,
                              "Triérarchie"@fr,
                              "Trierark"@no;
                   owl:sameAs resource:Trierarch;
                   skos:definition "Trierarch was the title of officers who commanded a trireme (triÄres) in the classical Greek world. In Athens and a few other states this officer was also required to pay for the outfitting and maintenance of the ship. Trierarchs thus had to be men of considerable means, since the expenses incurred could run as high as a talent in the course of a year."@en;
                   foaf:name "Trierarch".
