mil:Rank_Corporal_EnglishTradition mil:rankOf mil:EnglishTradition;
                                   void:inDataset mil:datasetdefinition;
                                   a mil:MilitaryRank,
                                     skos:Concept;
                                   rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                   rdfs:label "Caporal"@fr,
                                              "Korporal"@de,
                                              "Corporal"@en;
                                   owl:sameAs resource:Corporal;
                                   skos:definition "Corporal is a rank in use in some form by most militaries and by some police forces or other uniformed organizations. It is usually equivalent to NATO Rank Code OR-4. The rank of corporal nominally corresponds to commanding a section or squad of soldiers. However, in the United States Army, but not the U.S. Marines, a corporal is usually a fire team leader or second-in-command of a squad of soldiers."@en;
                                   skos:inScheme mil:ArmyServiceBranch,
                                                 mil:AirForceServiceBranch;
                                   org:rankEquivalentTo mil:Rank_Leading_seaman_EnglishTradition,
                                                        mil:Rank_Corporal_EnglishTradition;
                                   org:rankJuniorToTransitive mil:Rank_Sergeant_EnglishTradition;
                                   org:rankSeniorToTransitive mil:Rank_Aircraftman_EnglishTradition,
                                                              mil:Rank_Private_EnglishTradition.
mil:Rank_Daejang void:inDataset mil:datasetdefinition;
                 a skos:Concept,
                   mil:MilitaryRank;
                 rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                 rdfs:label "Daejang"@en;
                 owl:sameAs resource:Daejang;
                 skos:definition "Daejang is a senior military rank of the Korean Peninsula, used by both North and South Korea. It is considered the combined equivalent of a General and Admiral in other nations. The rank of Daejang is sometimes spelled as Taejang, depending on the transliteration system used (Taejang in McCune-Reischauer, Daejang in official ROK transliteration system)."@en;
                 foaf:name "Daejang".
