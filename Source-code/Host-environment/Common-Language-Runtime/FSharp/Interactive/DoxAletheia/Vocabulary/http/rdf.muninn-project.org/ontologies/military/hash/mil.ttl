mil:Rank_Suba%C5%9Fi void:inDataset mil:datasetdefinition;
                     a skos:Concept,
                       mil:MilitaryRank;
                     rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                     rdfs:label "SubaÅi"@en;
                     owl:sameAs resource:Suba%C5%9Fi;
                     skos:definition "SubaÅi was an Ottoman gubernatorial title used to describe different positions within Ottoman hierarchy, depending on the context. This title was given to sanjak-beys of Ottoman sanjaks which generated more than 15,000 aspers per annum or to the assistants of the sanjabey. The term was also used for commander of the town or castle in Ottoman Empire, an ancient version of chief of police. A surname found among Balkan families, SubaÅ¡a or SubaÅ¡iÄ, is derived from the SubaÅi title."@en;
                     foaf:name "SubaÅi".
mil:Rank_Subaltern void:inDataset mil:datasetdefinition;
                   a skos:Concept,
                     mil:MilitaryRank;
                   rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                   rdfs:label "Subaltern"@en,
                              "Subalternofficer"@sv,
                              "Ð¡ÑÐ±Ð°Ð»ÑÐµÑÐ½-Ð¾ÑÐ¸ÑÐµÑ"@ru,
                              "Subalternoffiser"@no;
                   owl:sameAs resource:Subaltern;
                   skos:definition """A subaltern is a chiefly British military term for a junior officer. Literally meaning \"subordinate,\" subaltern is used to describe commissioned officers below the rank of captain and generally comprises the various grades of lieutenant. In the British Army the senior subaltern rank was captain-lieutenant, obsolete since the 18th century."""@en;
                   foaf:name "Subaltern".
