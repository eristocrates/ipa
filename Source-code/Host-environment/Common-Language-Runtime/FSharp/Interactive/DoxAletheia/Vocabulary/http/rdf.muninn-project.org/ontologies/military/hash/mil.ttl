mil:Rank_Colonel_EnglishTradition mil:rankOf mil:EnglishTradition;
                                  void:inDataset mil:datasetdefinition;
                                  a skos:Concept,
                                    mil:MilitaryRank;
                                  rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                  rdfs:label "Colonel"@fr,
                                             "Colonel"@en,
                                             "Oberst"@de;
                                  owl:sameAs resource:Colonel;
                                  skos:definition """Colonel, abbreviated as Col or COL, is a military rank of a senior commissioned officer. It or a corresponding rank exists in most armies and in many air forces; the naval equivalent rank is generally \"Captain\". It is also used in some police forces and other paramilitary rank structures. A colonel is typically in charge of a regiment in an army. \"Colonel\" is usually the highest or second-highest field rank, and is below the general ranks."""@en;
                                  skos:inScheme mil:ArmyServiceBranch;
                                  org:rankEquivalentTo <http://rdf.muninn-project.org/ontologies/military#Rank_Captain_(naval)_EnglishTradition>,
                                                       mil:Rank_Group_captain_EnglishTradition;
                                  org:rankJuniorToTransitive mil:Rank_Brigadier_EnglishTradition;
                                  org:rankSeniorToTransitive mil:Rank_Lieutenant_colonel_EnglishTradition.
