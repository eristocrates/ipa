mil:Rank_Schout-bij-nacht <http://rdfs.org/ns/void#inDataset> mil:datasetdefinition;
                          a <http://www.w3.org/2004/02/skos/core#Concept>,
                            mil:MilitaryRank;
                          rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                          rdfs:label "Schout-bij-nacht"@nl,
