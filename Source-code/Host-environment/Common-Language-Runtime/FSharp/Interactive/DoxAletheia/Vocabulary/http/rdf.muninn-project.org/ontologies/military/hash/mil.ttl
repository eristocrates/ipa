mil:Rank_Syntagmatarchis void:inDataset mil:datasetdefinition;
                         a skos:Concept,
                           mil:MilitaryRank;
                         rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                         rdfs:label "Syntagmatarchis"@en;
                         owl:sameAs resource:Syntagmatarchis;
                         skos:definition """Syntagmatarchis, sometimes anglicized as Syntagmatarch, is used in modern Greek to denote the rank of Colonel. It is translated as \"leader of a regiment (syntagma)\", and dates back to the Classical Age armies. However, the name is misleading in that the Hellenic Army retains very few regiments in its command structure. Thus, the typical responsibilities of Syntagmatarches are in staff positions, or as Executive Officers in brigades."""@en;
                         foaf:name "Syntagmatarchis".
