                         rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                         rdfs:label "Second Corporal"@en;
                         owl:sameAs resource:Second_Corporal;
                         skos:definition "Second Corporal was a rank in the Royal Engineers and Army Ordnance Corps of the British Army. Second Corporals wore one rank chevron, but unlike Lance-Corporals they held full non-commissioned officer rank. They were thus equivalent to Bombardiers in the Royal Artillery. The rank was abolished in 1920."@en;
                         foaf:name "Second Corporal".
