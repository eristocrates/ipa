mil:Rank_Lieutenant_EnglishTradition mil:rankOf mil:EnglishTradition;
                                     void:inDataset mil:datasetdefinition;
                                     a skos:Concept,
                                       mil:MilitaryRank;
                                     rdfs:isDefinedBy <http://rdf.muninn-project.org/ontologies/military>;
                                     rdfs:label "Lieutenant"@en,
                                                "Lieutenant"@de,
                                                "Leutnant"@de,
                                                "Lieutenant (grade militaire)"@fr;
                                     owl:sameAs resource:Lieutenant;
                                     skos:definition """A Lieutenant is a commissioned officer in many nations' armed forces. Typically, the rank of lieutenant in naval usage is senior to the army rank. It is also used in fire services, emergency medical services, security services and police forces as a rank. Lieutenant may also appear as part of a title used in various other organizations with a codified command structure. It often designates someone who is \"second-in-command,\" and as such, may precede the name of the rank directly above it."""@en;
                                     skos:inScheme mil:ArmyServiceBranch;
                                     org:rankEquivalentTo mil:Rank_Flying_officer_EnglishTradition,
                                                          mil:Rank_Sub-lieutenant_EnglishTradition;
                                     org:rankJuniorToTransitive mil:Rank_Captain_EnglishTradition;
                                     org:rankSeniorToTransitive mil:Rank_Second_lieutenant_EnglishTradition.
