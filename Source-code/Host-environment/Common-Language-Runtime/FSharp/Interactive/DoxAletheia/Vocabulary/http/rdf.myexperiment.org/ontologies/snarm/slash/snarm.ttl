@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix snarm: <http://rdf.myexperiment.org/ontologies/snarm/>.

<http://purl.org/dc/elements/1.1/contributor> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/date> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/format> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/language> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/publisher> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/RightsStatement> a <http://www.w3.org/2002/07/owl#Class>.
snarm: <http://purl.org/dc/elements/1.1/contributor> "David R Newman";
       <http://purl.org/dc/elements/1.1/creator> <http://id.ecs.soton.ac.uk/person/9421>;
       <http://purl.org/dc/elements/1.1/date> "2009-01-28"^^xsd:date;
       <http://purl.org/dc/elements/1.1/format> "rdf/xml";
       <http://purl.org/dc/elements/1.1/language> "en";
       <http://purl.org/dc/elements/1.1/publisher> <http://rdf.myexperiment.org/>;
       <http://purl.org/dc/elements/1.1/title> "Simple Network Access Rights Management (SNARM) Ontology"@en;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:comment " This ontology is designed for representing access rights within a simple network of associated users/groups.";
       rdfs:label "SNARM Ontology v1.1";
       <http://www.w3.org/2002/07/owl#versionInfo> "$Date: 2011/09/02 $",
                                                   "".
snarm:Access a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "The Unrestricted Access to an AccessType";
             rdfs:isDefinedBy snarm:;
             rdfs:label "Access";
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> snarm:has-access-type ; 
                              <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>];
             <http://www.w3.org/2002/07/owl#disjointWith> snarm:Accesser,
                                                          snarm:AccessType,
                                                          snarm:Policy.
snarm:AccessType a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "The AccessType that is being giving, e.g. view, edit, download, etc.";
                 rdfs:isDefinedBy snarm:;
                 rdfs:label "AccessType";
                 <http://www.w3.org/2002/07/owl#disjointWith> snarm:Access,
                                                              snarm:Accesser,
                                                              snarm:Policy.
snarm:Accesser a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "The Accesser that is getting access";
               rdfs:isDefinedBy snarm:;
               rdfs:label "Accesser";
               <http://www.w3.org/2002/07/owl#disjointWith> snarm:Access,
                                                            snarm:AccessType,
                                                            snarm:Policy.
snarm:Policy a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A Policy for the access rights to an object for users in the social network";
             rdfs:isDefinedBy snarm:;
             rdfs:label "Policy";
             rdfs:subClassOf <http://purl.org/dc/terms/RightsStatement>;
             <http://www.w3.org/2002/07/owl#disjointWith> snarm:Access,
                                                          snarm:Accesser,
                                                          snarm:AccessType.
snarm:RestrictedAccess a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "The restricted Access to an AccessType";
                       rdfs:isDefinedBy snarm:;
                       rdfs:label "RestrictedAccess";
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> snarm:has-accesser ; 
                                        <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       snarm:Access.
snarm:has-access a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "An Access that a Policy provides";
                 rdfs:domain snarm:Policy;
                 rdfs:isDefinedBy snarm:;
                 rdfs:label "has-access";
                 rdfs:range snarm:Access.
snarm:has-access-type a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                      rdfs:comment "The AccessType an Access provides";
                      rdfs:isDefinedBy snarm:;
                      rdfs:label "has-access-type";
                      rdfs:range snarm:AccessType.
snarm:has-accesser a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#FunctionalProperty>;
                   rdfs:comment "An Accesser that a Mode provides access to";
                   rdfs:domain snarm:Access;
                   rdfs:isDefinedBy snarm:;
                   rdfs:label "has-accesser";
                   rdfs:range snarm:Accesser.
