roh:PersonContract <http://w3id.org/roh/mirror/skos#prefLabel> "Contrato de trabalho"@pt,
                                                               "Contracte de treball"@ca-ad,
                                                               "Contracte de treball"@ca-es,
                                                               "Employment contract"@en,
                                                               "Contrat de travail"@fr,
                                                               "Contrato de trabajo"@es;
                   a owl:Class;
                   rdfs:comment "An agreement between a person and an organization to work in a project for a specified duration."@en;
                   rdfs:label "Contrato de trabalho"@pt,
                              "Contrat de travail"@fr,
                              "Contracte de treball"@ca-ad,
                              "Contracte de treball"@ca-es,
                              "Contrato de trabajo"@es,
                              "Contrato de Persona"@es,
                              "Person Contract"@en;
                   rdfs:subClassOf [owl:onProperty roh:hasHRClassification ; 
                                    owl:allValuesFrom <http://w3id.org/roh/mirror/skos#Concept> ; 
                                    a owl:Restriction],
                                   <http://w3id.org/roh/mirror/vivo#Contract>,
                                   [owl:someValuesFrom <http://w3id.org/roh/mirror/skos#Concept> ; 
                                    owl:onProperty roh:hasHRClassification ; 
                                    a owl:Restriction];
                   owl:disjointWith roh:ProjectContract.
roh:PersonExpense a owl:Class;
                  rdfs:comment """A ProjectExpense is carried out by a Researcher (by default the principal researcher) in charge of a Project, which indirectly links it to Funding, understood as a set of FundingAmounts. The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services.\"^^rdfs:Literal"""@en;
                  rdfs:label "Gasto de Persona"@es,
                             "Person Expense"@en;
                  rdfs:subClassOf roh:Expense;
                  owl:disjointWith roh:ProjectExpense.
roh:PhDSupervisingRelationship a owl:Class;
                               rdfs:label "PhD Supervising Relationship"@en,
                                          "Relación de Supervisión de Doctorado"@es;
                               rdfs:subClassOf [owl:onProperty roh:produces ; 
                                                owl:allValuesFrom roh:PhDThesis ; 
                                                a owl:Restriction],
                                               roh:SupervisingRelationship.
roh:PhDThesis <http://w3id.org/roh/mirror/skos#altLabel> "Tese de doutoramento"@gl;
              <http://w3id.org/roh/mirror/skos#prefLabel> "Tesi doctoral"@ca-es,
                                                          "Doctoral thesis"@en,
                                                          "Tesis doctoral"@es,
                                                          "Doktorego tesi"@eu,
                                                          "Tese doctoral"@gl,
                                                          "Tese de doutoramento"@pt,
                                                          "Thèse doctorale"@fr,
                                                          "Tesi doctoral"@ca-ad;
              a owl:Class;
              rdfs:comment "A thesis reporting a research project undertaken as part of an undergraduate course of education to receive a doctoral degree."@en,
                           "A document created to summarize research findings associated with the completion of a doctoral thesis."@en;
              rdfs:label "Tese doctoral"@gl,
                         "Tesis doctoral"@es,
                         "Thèse doctorale"@fr,
                         "Doktore tesi"@eu,
                         "Tesis de Doctorado"@es,
                         "Tese de doutoramento"@pt,
                         "Tesi doctoral"@ca-ad,
                         "Tesi doctoral"@ca-es,
                         "PhD Thesis"@en,
                         "Doctoral thesis"@en;
              rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Thesis>.
roh:PhDThesisMetric a owl:Class;
                    rdfs:label "Métrica de Tesis Doctoral"@es,
                               "PhD Thesis Metric"@en;
                    rdfs:subClassOf [owl:someValuesFrom xsd:boolean ; 
                                     owl:onProperty roh:cumLaude ; 
                                     a owl:Restriction],
