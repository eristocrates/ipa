                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeValue> ; 
                                          owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeValue> ; 
                                          a owl:Restriction],
                                         <http://w3id.org/roh/mirror/vivo#Relationship>,
                                         [owl:someValuesFrom <http://w3id.org/roh/mirror/foaf#Agent> ; 
                                          owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                                          owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom roh:AuditorRole ; 
                                          owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                                          owl:allValuesFrom [owl:unionOf (roh:AuditeeRole
                                                                          roh:AuditorRole
                                                                          <http://w3id.org/roh/mirror/foaf#Agent>) ; 
                                                             a owl:Class] ; 
                                          a owl:Restriction].
roh:AuditorRole a owl:Class;
                rdfs:label "Auditor Role"@en,
                           "Rol de Auditor"@es;
                rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>.
