                                                           rdfs:label "organización sucesora"@es,
                                                                      "successor organization"@en;
                                                           rdfs:range <http://w3id.org/roh/mirror/foaf#Organization>;
                                                           rdfs:subPropertyOf roh:hasSucessor.
<http://w3id.org/roh/mirror/vivo#hrJobTitle> <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#descriptionAnnot> "Definition http://en.wikipedia.org/wiki/Job_title#Job_title.";
                                             <http://vitro.mannlib.cornell.edu/ns/vitro/0.7#exampleAnnot> "administrative secretary";
