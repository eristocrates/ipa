                                              rdfs:label "publishes"@en;
                                              rdfs:range <http://w3id.org/roh/mirror/bibo#Document>.
<http://w3id.org/roh/mirror/vivo#rank> a owl:DatatypeProperty;
                                       rdfs:comment "this number indicates a position in a list"@en;
                                       rdfs:label "ordinal"@es,
                                                  "rank"@en.
<http://w3id.org/roh/mirror/vivo#relatedBy> iao:0000115 "Relates a Thing to a Relationship as a Thing that is somehow related to other Thing in the same Relationship instance. A Relationship instnace is a predicate over Thing and is created by an Agent."@en;
                                            a owl:ObjectProperty;
                                            rdfs:label "relacionado con"@es,
                                                       "related by"@en;
                                            owl:inverseOf <http://w3id.org/roh/mirror/vivo#relates>.
<http://w3id.org/roh/mirror/vivo#relates> iao:0000115 "Relates a Relationship instance to the one or more Thing of the Relationship. There is a separate property (assigned by) to relate to the Agent that defines the Relationship."@en;
                                          a owl:ObjectProperty;
                                          rdfs:label "relates"@en,
                                                     "se relaciona"@es.
<http://w3id.org/roh/mirror/vivo#researcherId> iao:0000112 """RearcherID is a Thomson Reuters project where researchers have a place to manage and share their professional information. It will allow them to solve author identity issues while simultaneously adding dynamic citation metrics and collaboration networks to your personal profile.
Definition source: http://isiwebofknowledge.com/researcherid/""";
                                               a owl:DatatypeProperty;
                                               rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
                                               rdfs:label "ISI Researcher ID"@en;
                                               rdfs:subPropertyOf <http://w3id.org/roh/mirror/vivo#identifier>.
<http://w3id.org/roh/mirror/vivo#scopusId> iao:0000112 "Home page for Scopus: http://www.scopus.com/home.url";
                                           a owl:DatatypeProperty;
                                           rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
                                           rdfs:label "Scopus ID"@en;
                                           rdfs:subPropertyOf <http://w3id.org/roh/mirror/vivo#identifier>.
<http://w3id.org/roh/mirror/vivo#start> a owl:ObjectProperty;
                                        rdfs:comment "The date/time value in which something starts."@en;
                                        rdfs:domain <http://w3id.org/roh/mirror/vivo#DateTimeInterval>;
                                        rdfs:label "comienzo"@es,
                                                   "start"@en;
                                        rdfs:range <http://w3id.org/roh/mirror/vivo#DateTimeValue>;
                                        rdfs:subPropertyOf <http://w3id.org/roh/mirror/vivo#dateTimeValue>.
<http://w3id.org/roh/mirror/vivo#supportedInformationResource> a owl:ObjectProperty;
                                                               rdfs:comment "an information resource (typically a publication) supported by (typically via funding) an agreement (such as a grant)"@en;
                                                               rdfs:label "publicaciones admitidas u otros trabajos"@es,
                                                                          "supported publications or other works"@en.
