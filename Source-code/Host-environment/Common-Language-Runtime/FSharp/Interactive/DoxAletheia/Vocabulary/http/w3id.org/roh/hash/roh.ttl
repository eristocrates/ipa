                                                          owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ; 
                                                          a owl:Restriction];
                                         status:term_status "stable".
<http://w3id.org/roh/mirror/bibo#Thesis> iao:0000112 "Short Definition from OCLC Input Standards, EntW";
