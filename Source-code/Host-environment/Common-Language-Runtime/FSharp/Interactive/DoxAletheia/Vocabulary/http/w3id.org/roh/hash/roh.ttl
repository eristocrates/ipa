roh:requires a owl:ObjectProperty;
             rdfs:comment "This property relates roles and their requisites, i.e. other roles."@en;
             rdfs:domain [owl:unionOf (<http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>
                                       <http://w3id.org/roh/mirror/vivo#AwardedDegree>) ; 
                          a owl:Class];
             rdfs:label "requires"@en;
             rdfs:range [owl:unionOf (<http://w3id.org/roh/mirror/bibo#Document>
                                      <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>) ; 
                         a owl:Class].
roh:researchLine a owl:DatatypeProperty;
                 rdfs:comment "A free-text property to define the research line in which an Organization or Researcher is working on."@en;
                 rdfs:label "línea de investigación"@es,
                            "research line"@en;
                 rdfs:range xsd:string.
roh:researchResultHasPart a owl:ObjectProperty;
                          rdfs:comment "A core relation that holds between a whole, that in this case is an Research Object (roh:ResearchObject), and its part ."@es;
                          rdfs:domain roh:ResearchResult;
                          rdfs:label "research result has part"@en,
                                     "resultado de investigación contiene"@es;
                          rdfs:range [owl:unionOf (roh:ExperimentalProtocol
                                                   <http://w3id.org/roh/mirror/bibo#Document>
                                                   <http://w3id.org/roh/mirror/obo/ero#ERO_0000071>) ; 
                                      a owl:Class];
                          rdfs:subPropertyOf <http://w3id.org/roh/mirror/obo/ro#BFO_0000051>.
roh:reservableOf a owl:ObjectProperty;
                 rdfs:comment "An Infrastructure belonging to an Agent."@en;
                 rdfs:domain roh:Reservable;
                 rdfs:label "reservable de"@es,
                            "reservable of"@en;
                 rdfs:range <http://w3id.org/roh/mirror/foaf#Agent>.
roh:reviews a owl:ObjectProperty;
            rdfs:comment "a proerty to link a person to a publication as a reviewer."@en;
            rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
            rdfs:label "reviews"@en;
            rdfs:range <http://w3id.org/roh/mirror/bibo#Document>.
roh:roleOf a owl:ObjectProperty;
           rdfs:comment "The Role held by an Agent in a Relationship."@en;
           rdfs:domain <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>;
           rdfs:label "rol de"@es,
                      "role of"@en;
           rdfs:range <http://w3id.org/roh/mirror/foaf#Agent>.
roh:seqOfAuthors a owl:ObjectProperty;
                 rdfs:comment "An unordered list of authors."@en,
                              "Una lista no ordenada de los autores."@es;
                 rdfs:label "conjunto de autores"@es,
                            "seq of authors"@en;
                 rdfs:range rdf:Seq.
roh:softwareStatus a owl:ObjectProperty;
                   rdfs:comment "The status of a Software  (Final or Provisional)."@en;
                   rdfs:domain <http://w3id.org/roh/mirror/obo/ero#ERO_0000071>;
                   rdfs:label "estatus de software"@es,
                              "software status"@en;
                   rdfs:range [owl:unionOf (roh:Final
                                            roh:Provisional) ; 
                               a owl:Class].
roh:speakingSkill a owl:DatatypeProperty;
                  rdfs:comment "The ability to speak a language."@en;
                  rdfs:domain roh:LanguageCertificate;
                  rdfs:label "expresión oral"@es,
                             "speaking skill"@en;
                  rdfs:range [owl:oneOf () ; 
                              a rdfs:Datatype];
                  rdfs:subPropertyOf roh:languageSkill.
roh:spends a owl:ObjectProperty;
           rdfs:comment "An entity spending an Expense."@en;
           rdfs:label "gasta"@es,
                      "spends"@en;
           rdfs:range roh:Expense;
           owl:inverseOf roh:spentBy.
roh:spentBy a owl:ObjectProperty;
            rdfs:comment "An Expense spent by an Entity."@en;
            rdfs:domain roh:Expense;
            rdfs:label "gasto realizado por"@es,
                       "spent by"@en.
roh:spokenInteractionSkill a owl:DatatypeProperty;
                           rdfs:comment "The ability to participate into a conversation."@en;
                           rdfs:domain roh:LanguageCertificate;
                           rdfs:label "interacción oral"@es,
                                      "spoken interaction skill"@en;
                           rdfs:range [owl:oneOf () ; 
                                       a rdfs:Datatype];
                           rdfs:subPropertyOf roh:languageSkill.
roh:summary a owl:DatatypeProperty;
            rdfs:comment "A textual summary of the Curriculum Vitae"@en;
            rdfs:domain roh:CurriculumVitae;
            rdfs:label "resumen"@es,
                       "summary"@en.
roh:supervisedBy a owl:ObjectProperty;
                 rdfs:comment "A Thesis supervised by a Person."@en;
                 rdfs:domain <http://w3id.org/roh/mirror/bibo#Thesis>;
                 rdfs:label "supervisado por"@es,
                            "supervised by"@en;
                 rdfs:range <http://w3id.org/roh/mirror/foaf#Person>;
                 owl:inverseOf roh:supervisorOf.
roh:supervisorOf a owl:ObjectProperty;
                 rdfs:comment "A Person supervising a Thesis."@en;
                 rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
                 rdfs:label "supervisor de"@es,
                            "supervisor of"@en;
                 rdfs:range <http://w3id.org/roh/mirror/bibo#Thesis>.
roh:supports a owl:ObjectProperty;
             rdfs:comment "A Funding which supports a Person Contract or a Project."@en;
             rdfs:domain roh:Funding;
             rdfs:label "apoya"@es,
                        "supports"@en.
roh:taughtBy a owl:ObjectProperty;
             rdfs:label "taught by"@en;
             owl:inverseOf roh:teaches.
roh:taxID a owl:DatatypeProperty;
          rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
          rdfs:label "tax ID"@en;
          rdfs:subPropertyOf <http://w3id.org/roh/mirror/vivo#identifier>.
roh:teaches a owl:ObjectProperty;
            rdfs:domain <http://w3id.org/roh/mirror/foaf#Person>;
            rdfs:label "teaches"@en;
            rdfs:range [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                            [owl:someValuesFrom roh:AcademicSubject ; 
                                            owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                            a owl:Restriction]) ; 
                        a owl:Class].
roh:title a owl:DatatypeProperty;
          rdfs:comment "A data property that associates a title to any ROH entity requiring it.";
          rdfs:label "title"@en,
                     "título"@es.
roh:upc a owl:DatatypeProperty;
        rdfs:label "Universal Product Code"@en,
                   "has UPC"@en;
        rdfs:range xsd:string;
        rdfs:subPropertyOf <http://w3id.org/roh/mirror/vivo#identifier>.
roh:url a owl:DatatypeProperty;
        rdfs:comment "A Uniform Resource Identifier."@en;
        rdfs:label "url"@en,
                   "url"@es.
roh:utilizes a owl:ObjectProperty;
             rdfs:domain roh:ResearchContribution;
             rdfs:label "utilizes"@en;
             rdfs:range roh:ResearchMaterial;
             rdfs:subPropertyOf pobo:RO_0000057.
roh:writingSkill a owl:DatatypeProperty;
                 rdfs:comment "The ability to write into a certain language."@en;
                 rdfs:domain roh:LanguageCertificate;
                 rdfs:label "expresión escrita"@es,
                            "writing skill"@en;
                 rdfs:range [owl:oneOf () ; 
                             a rdfs:Datatype];
                 rdfs:subPropertyOf roh:languageSkill.
