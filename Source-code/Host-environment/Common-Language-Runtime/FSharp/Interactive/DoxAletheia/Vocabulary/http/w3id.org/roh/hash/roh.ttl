                                                                                                  roh:PatentApplication
                                                                                                  <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>
                                                                                                  <http://w3id.org/roh/mirror/vivo#Project>
                                                                                                  <http://w3id.org/roh/mirror/vivo#Relationship>) ; 
                                                                                     a owl:Class] ; 
                                                                  a owl:Restriction],
                                                                 [owl:onProperty roh:hasKnowledgeArea ; 
                                                                  owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                                                         [owl:someValuesFrom roh:KnowledgeArea ; 
                                                                                                         owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                                                         a owl:Restriction]) ; 
                                                                                     a owl:Class] ; 
                                                                  a owl:Restriction],
                                                                 [owl:onProperty roh:roleOf ; 
                                                                  owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Agent> ; 
                                                                  a owl:Restriction].
<http://w3id.org/roh/mirror/obo/bfo#BFO_0000038> a owl:Class;
