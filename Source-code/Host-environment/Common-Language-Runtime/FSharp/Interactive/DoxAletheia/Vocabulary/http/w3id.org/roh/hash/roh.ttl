                                                  rdfs:label "enfoque geográfico"@es,
                                                             "geographic focus"@en.
<http://w3id.org/roh/mirror/vivo#hasGoverningAuthority> a owl:ObjectProperty;
                                                        rdfs:comment "An authority which is in charge of managing something."@en;
                                                        rdfs:label "autoridad gobernante"@es,
                                                                   "governing authority"@en.
<http://w3id.org/roh/mirror/vivo#hasPredecessorOrganization> a owl:ObjectProperty,
                                                               owl:TransitiveProperty;
                                                             rdfs:comment "The Organization from which the new Organization has created."@en;
                                                             rdfs:domain <http://w3id.org/roh/mirror/foaf#Organization>;
                                                             rdfs:label "organización predecesora"@es,
                                                                        "predecessor organization"@en;
                                                             rdfs:range <http://w3id.org/roh/mirror/foaf#Organization>;
                                                             rdfs:subPropertyOf roh:hasPredecessor;
                                                             owl:inverseOf <http://w3id.org/roh/mirror/vivo#hasSuccessorOrganization>.
<http://w3id.org/roh/mirror/vivo#hasPublicationVenue> a owl:ObjectProperty;
                                                      rdfs:comment "A publication published in a collection of documents."@en;
                                                      rdfs:label "publicado en"@es,
                                                                 "published in"@en;
                                                      owl:inverseOf <http://w3id.org/roh/mirror/vivo#publicationVenueFor>.
<http://w3id.org/roh/mirror/vivo#hasSuccessorOrganization> a owl:ObjectProperty,
