roh:CurriculumVitae <http://w3id.org/roh/mirror/skos#altLabel> "Curriculum vitæ"@fr,
                                                               "Curriculum vitæ"@pt,
                                                               "Résumé"@en,
                                                               "CV"@pt,
                                                               "CV"@ca,
                                                               "CV"@en,
                                                               "CV"@es,
                                                               "CV"@eu,
                                                               "CV"@fr,
                                                               "CV"@gl,
                                                               "Curriculum vitae"@ca,
                                                               "Curriculum vitae"@es,
                                                               "Currículo"@es,
                                                               "Currículo"@gl,
                                                               "Currículo"@pt,
                                                               "Resume"@en,
                                                               "Currículum"@ca,
                                                               "Currículum"@es;
                    <http://w3id.org/roh/mirror/skos#prefLabel> "Curriculum vitae"@en,
                                                                "Curriculum vitae"@fr,
                                                                "Curriculum vitae"@pt,
                                                                "Currículum vitae"@ca,
                                                                "Currículum vitae"@es;
                    a owl:Class;
                    rdfs:comment "roh:CurriculumVitae adds extra fields necessary to be able to complete the CV of a foaf:Person which cannot be extracted from the relationships with roh:ResearchObject and vivo:Project, among others, that a foaf:Person may have.",
                                 "A document used and created by a person to present their background, skills and accomplishments."@en;
                    rdfs:label "Currículum vitae"@ca-ad,
                               "Currículum vitae"@ca-es,
                               "Currículum vitae"@en,
                               "Currículum vitae"@es,
                               "Currículum vitae"@gl,
                               "Curriculum Vitae"@en,
                               "Curriculum Vitae"@es,
                               "Curriculum vitae"@eu,
                               "Curriculum vitae"@fr,
                               "Curriculum vitae"@pt;
                    rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Document>,
                                    [owl:onProperty roh:summary ; 
                                     owl:allValuesFrom xsd:string ; 
                                     a owl:Restriction].
roh:Database a owl:Class;
             rdfs:label "Database"@en;
             rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#CollectedDocument>.
roh:DegreeHomologation a owl:Class;
                       rdfs:label "Degree Homologation"@en,
                                  "Homologación de Titulación"@es;
                       rdfs:subClassOf [owl:someValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeValue> ; 
                                        owl:onProperty <http://w3id.org/roh/mirror/vivo#dateIssued> ; 
                                        a owl:Restriction],
                                       [owl:someValuesFrom <http://w3id.org/roh/mirror/vivo#AwardedDegree> ; 
                                        owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                                        a owl:Restriction],
                                       [owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                                        owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#AwardedDegree> ; 
                                        a owl:Restriction],
                                       roh:Accreditation.
roh:DegreeMetric a owl:Class;
                 rdfs:label "Degree Metric"@en,
                            "Métrica de Grado"@es;
                 rdfs:subClassOf roh:Metric.
roh:DisseminationEvent a owl:Class;
                       rdfs:label "Dissemination Event"@en;
                       rdfs:subClassOf roh:Activity.
roh:DoctoralDegree <http://w3id.org/roh/mirror/skos#altLabel> "Doctorate"@en,
                                                              "Doktoretza"@eu;
                   <http://w3id.org/roh/mirror/skos#prefLabel> "Doctorado"@es,
                                                               "Doctoral degree"@en,
                                                               "Doktorego"@eu,
                                                               "Doctorat"@fr-ca,
                                                               "Doctorat"@ca-ad,
                                                               "Doctorat"@ca-es,
                                                               "Doctorat"@fr-be,
                                                               "Doctorat"@fr-ch,
                                                               "Doctorat"@fr-fr,
                                                               "Doutoramento"@gl,
                                                               "Doutoramento"@pt;
                   a owl:Class;
                   rdfs:label "Doktorego"@eu,
                              "Doctorat"@ca-ad,
                              "Doctorat"@ca-es,
                              "Doctorat"@fr-be,
                              "Doctorat"@fr-ca,
                              "Doctorat"@fr-ch,
                              "Doctorat"@fr-fr,
                              "Doutoramento"@gl,
                              "Doctoral degree"@en,
                              "Doutoramento"@pt,
                              "Doctorado"@es;
                   rdfs:subClassOf <http://w3id.org/roh/mirror/vivo#AcademicDegree>.
roh:Dossier a owl:Class;
            rdfs:comment "File is a collection in which all assets related to a Project are stored, including the Research Proposal, approval documents, viability plans and so on associated to a project are stored."@en;
            rdfs:label "Dossier"@en,
                       "Dossier"@es;
            rdfs:subClassOf [owl:someValuesFrom xsd:string ; 
                             owl:onProperty <http://w3id.org/roh/mirror/vivo#description> ; 
                             a owl:Restriction],
                            <http://w3id.org/roh/mirror/bibo#Collection>,
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                             owl:allValuesFrom [owl:unionOf (roh:FundingProgram
                                                             roh:ProjectContract
                                                             <http://w3id.org/roh/mirror/bibo#Report>
                                                             <http://w3id.org/roh/mirror/vivo#Project>) ; 
                                                a owl:Class] ; 
                             a owl:Restriction],
                            [owl:onProperty roh:title ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                             owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                             owl:allValuesFrom rdfs:Literal ; 
                             a owl:Restriction],
                            [owl:someValuesFrom rdfs:Literal ; 
                             owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                             a owl:Restriction],
                            [owl:someValuesFrom xsd:string ; 
                             owl:onProperty roh:title ; 
                             a owl:Restriction];
            owl:disjointWith <http://w3id.org/roh/mirror/bibo#Periodical>.
roh:EditedPublication a owl:Class;
                      rdfs:label "Edited publication"@en;
                      rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Document>.
roh:EthicalAudit a owl:Class;
                 rdfs:label "EthicalAudit"@en;
                 rdfs:subClassOf roh:EthicalReport;
                 owl:disjointWith roh:EthicalValidation.
roh:EthicalReport a owl:Class;
                  rdfs:label "EthicalReport"@en;
                  rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Report>.
roh:EthicalValidation a owl:Class;
                      rdfs:label "EthicalValidation"@en;
                      rdfs:subClassOf [owl:someValuesFrom roh:Status ; 
                                       owl:onProperty roh:documentStatus ; 
                                       a owl:Restriction],
                                      [owl:onProperty roh:documentStatus ; 
                                       owl:allValuesFrom roh:Status ; 
                                       a owl:Restriction],
                                      roh:EthicalReport.
roh:EthicsCommittee a owl:Class;
                    rdfs:comment "An ethics committee is a body responsible for ensuring that medical experimentation and human subject research are carried out in an ethical manner in accordance with national and international law."@en;
                    rdfs:label "Comite Etico"@es,
                               "Ethics Comitee"@en;
                    rdfs:subClassOf [owl:onProperty roh:produces ; 
                                     owl:allValuesFrom roh:EthicalReport ; 
                                     a owl:Restriction],
                                    <http://w3id.org/roh/mirror/foaf#Organization>.
roh:EuropeanAgriculturalGuaranteeFund a owl:NamedIndividual,
                                        roh:FundingSource;
                                      rdfs:comment "A fund allocated by the European Union. It finances direct payments to farmers under the Common Agricultural Policy (CAP) and measures to regulate agricultural markets such as intervention and export refunds."@en;
                                      rdfs:label "European Agricultural Guarantee Fund"@en,
                                                 "Fondo Europeo de Orientación y Garantía Agrícola"@es.
roh:EuropeanMaritimeAndFisheriesFund a owl:NamedIndividual,
                                       roh:FundingSource;
                                     rdfs:comment "The EMFF is the fund for the EU's maritime and fisheries policies for 2014-2020."@en;
                                     rdfs:label "European Maritime and Fisheries Fund"@en,
                                                "Fondo Europeo Marítimo y de Pesca"@es.
roh:EuropeanRegionalDevelopmentFund a owl:NamedIndividual,
                                      roh:FundingSource;
                                    rdfs:comment "A fund allocated by the European Union. Its purpose is to transfer money from richer regions (not countries), and invest it in the infrastructure and services of underdeveloped regions. This will allow those regions to start attracting private sector investments, and create jobs on their own."@en;
                                    rdfs:label "European Regional Development Fund"@en,
                                               "Fondo Europeo de Desarrollo Regional"@es.
roh:EuropeanSocialFund a owl:NamedIndividual,
                         roh:FundingSource;
                       rdfs:comment "It is one of the European Structural and Investment Funds (ESIF), which are dedicated to improving social cohesion and economic well-being across the regions of the Union. The funds are redistributive financial instruments that support cohesion within Europe by concentrating spending on the less-developed regions."@en;
                       rdfs:label "European Social Fund"@en,
                                  "Fondo Social Europeo"@es.
roh:EvaluationSummary a owl:Class;
                      rdfs:comment "An evaluation summary provided by a funding organization."@en;
                      rdfs:label "Evaluation Summary"@en,
                                 "Resumen de Evaluación"@es;
                      rdfs:subClassOf [owl:onProperty roh:evaluationStatus ; 
                                       owl:allValuesFrom [owl:unionOf (roh:Final
                                                                       roh:Provisional) ; 
                                                          a owl:Class] ; 
                                       a owl:Restriction],
                                      <http://w3id.org/roh/mirror/bibo#Report>.
roh:EventOrganiser a owl:Class;
                   rdfs:comment "A role of organising cientific events, such as conferences, workshops, etc."@en;
                   rdfs:label "Event organiser"@en;
                   rdfs:subClassOf <http://w3id.org/roh/mirror/vivo#OrganizerRole>.
roh:Expense a owl:Class;
            rdfs:comment "A roh:Expense is carried out in a vivo:Project or by foaf:Person and associated through relationship roh:spends. It timestamps each expense with a vivo:DateTimeValue and has attributes roh:monetaryAmount, roh:currency, roh:title and roh:description and expenseAmount . The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services. Some of these classes still not defined.";
            rdfs:label "Gasto"@es,
                       "Expense"@en;
            rdfs:subClassOf [owl:onProperty roh:currency ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty roh:title ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty roh:monetaryAmount ; 
                             owl:allValuesFrom xsd:decimal ; 
                             a owl:Restriction],
                            [owl:someValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeValue> ; 
                             owl:onProperty <http://w3id.org/roh/mirror/vivo#dateIssued> ; 
                             a owl:Restriction],
                            [owl:someValuesFrom xsd:decimal ; 
                             owl:onProperty roh:monetaryAmount ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#description> ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty roh:hasExpenseClassification ; 
                             owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                    [owl:someValuesFrom roh:ExpenseClassification ; 
                                                                    owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class] ; 
                             a owl:Restriction],
                            [owl:onProperty roh:expenseModality ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateIssued> ; 
                             owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeValue> ; 
                             a owl:Restriction].
roh:ExpenseClassification a owl:Class;
                          rdfs:label "Expense Classification"@en;
                          rdfs:subClassOf <http://w3id.org/roh/mirror/skos#ConceptScheme>.
roh:ExperimentalProtocol a owl:Class;
                         rdfs:label "Experimental Protocol"@en,
                                    "Protocolo Experimental"@es;
                         rdfs:subClassOf [owl:onProperty <http://w3id.org/roh/mirror/vivo#freetextKeyword> ; 
                                          owl:allValuesFrom xsd:string ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:repositoryHasPart ; 
                                          owl:allValuesFrom roh:Repository ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:produces ; 
                                          owl:allValuesFrom roh:ExperimentalProtocolResult ; 
                                          a owl:Restriction],
                                         <http://w3id.org/roh/mirror/obo/bfo#BFO_0000015>,
                                         [owl:someValuesFrom xsd:string ; 
                                          owl:onProperty roh:title ; 
                                          a owl:Restriction],
                                         [owl:onProperty cito:cites ; 
                                          owl:allValuesFrom owl:Thing ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:language ; 
                                          owl:allValuesFrom rdfs:Literal ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:hasKnowledgeArea ; 
                                          owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                                 [owl:someValuesFrom roh:KnowledgeArea ; 
                                                                                 owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                                 a owl:Restriction]) ; 
                                                             a owl:Class] ; 
                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                                          owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:correspondingAuthor ; 
                                          owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Person> ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:seqOfAuthors ; 
                                          owl:allValuesFrom rdf:Seq ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:hasPredecessor ; 
                                          owl:allValuesFrom roh:ExperimentalProtocol ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:partOfResearchResult ; 
                                          owl:allValuesFrom roh:ResearchResult ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:title ; 
                                          owl:allValuesFrom xsd:string ; 
                                          a owl:Restriction],
                                         [owl:onProperty roh:seqOfAuthors ; 
                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/bibo#abstract> ; 
                                          owl:allValuesFrom xsd:string ; 
                                          a owl:Restriction],
                                         [owl:onProperty <http://w3id.org/roh/mirror/foaf#homepage> ; 
                                          owl:allValuesFrom <http://w3id.org/roh/mirror/bibo#Webpage> ; 
                                          a owl:Restriction].
roh:ExperimentalProtocolResult a owl:Class;
                               rdfs:comment "Document that contains the result or execution of a Experimental Protocol."@en,
                                            "Documento que describe el resultado y la ejecución del protocolo experimental."@es;
                               rdfs:label "Experimental Protocol Result"@en,
                                          "Resultado del Protocolo Experimental"@es;
                               rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Document>.
roh:ExternalMemberRole a owl:Class;
                       rdfs:comment "A member who works in a Project or participates in an Activity but do not belong to the main Organization."@en;
                       rdfs:label "External Member Role"@en,
                                  "Rol de Miembro Externo"@es;
                       rdfs:subClassOf <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023>.
roh:FacultyPositionEmeritus a owl:Class;
                            rdfs:comment "A retired professor who has retained their rank, title and privileges."@en;
                            rdfs:label "Faculty Position Emeritus"@en,
                                       "Posición de Profesor Emérito"@es;
                            rdfs:subClassOf <http://w3id.org/roh/mirror/vivo#FacultyPosition>.
roh:Final a owl:Class;
          rdfs:label "Final"@en;
          rdfs:subClassOf roh:Status.
roh:Funded a owl:Class;
           rdfs:label "Funded"@en;
           rdfs:subClassOf roh:Status.
roh:Funding a owl:Class;
            rdfs:comment "A roh:Funding is the funding associated to a vivo:Project whose funding is associated to a roh:FundingProgram, which in turn is associated to a vivo:FundingOrganization. A roh:Funding consists of several roh:FundingAmounts, associated to the different entities that participate in a project and to the annuities in which they do it.  Funding gathers information about the total funding received for a Project and its currency through properties roh:monetaryAmount and roh:currency. A roh:FundingSource funds a roh:FundingProgram. A roh:Funding supports a vivo:Project or a roh:PersonContract. A Funding can be tagged as public or private, by updating the data property roh:publicFunding.";
            rdfs:label "Financiación"@es,
                       "Funding"@en;
            rdfs:subClassOf [owl:someValuesFrom rdfs:Literal ; 
                             owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                             a owl:Restriction],
                            [owl:onProperty roh:fundedBy ; 
                             owl:allValuesFrom [owl:unionOf (roh:FundingProgram
                                                             <http://w3id.org/roh/mirror/vivo#FundingOrganization>) ; 
                                                a owl:Class] ; 
                             a owl:Restriction],
                            [owl:someValuesFrom xsd:boolean ; 
                             owl:onProperty roh:publicFunding ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                             owl:maxCardinality "1"^^xsd:nonNegativeInteger ; 
                             a owl:Restriction],
                            [owl:onProperty roh:hasKnowledgeArea ; 
                             owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                    [owl:someValuesFrom roh:KnowledgeArea ; 
                                                                    owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class] ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#description> ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/obo/ro#BFO_0000051> ; 
                             owl:allValuesFrom roh:FundingAmount ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                             owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                             a owl:Restriction],
                            [owl:onProperty <http://w3id.org/roh/mirror/vivo#freetextKeyword> ; 
                             owl:allValuesFrom xsd:string ; 
                             a owl:Restriction],
                            [owl:onProperty roh:hasContract ; 
                             owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#Contract> ; 
                             a owl:Restriction].
roh:FundingAmount a owl:Class;
                  rdfs:comment "A roh:FundingAmount is linked to a roh:Funding which is roh:fundedBy a roh:FundingProgram and finances a Project (through roh:supports relationship). Each FundingAmount is associated to an Organization participating in the Project (through roh:grants relationship) for each project specific annuity."^^rdfs:Literal;
                  rdfs:label "Funding Amount"@en,
                             "Monto de Financiación"@es;
                  rdfs:subClassOf [owl:onProperty roh:grants ; 
                                   owl:allValuesFrom <http://w3id.org/roh/mirror/foaf#Organization> ; 
                                   a owl:Restriction],
                                  [owl:onProperty <http://w3id.org/roh/mirror/obo/ro#BFO_0000050> ; 
                                   owl:allValuesFrom roh:Funding ; 
                                   a owl:Restriction],
                                  [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                                   owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                                   a owl:Restriction],
                                  [owl:onProperty roh:currency ; 
                                   owl:allValuesFrom xsd:string ; 
                                   a owl:Restriction],
                                  [owl:onProperty roh:monetaryAmount ; 
                                   owl:allValuesFrom xsd:decimal ; 
                                   a owl:Restriction].
roh:FundingProgram a owl:Class;
                   rdfs:comment "A roh:FundingProgram is promoted (roh:promotedBy) by a Funding Organization (vivo:FundingOrganization) and it is in place for a time interval (vivo:dateTimeInterval)",
                                "A programme of related funded projects, typically established by a funding organization."@en;
                   rdfs:label "Funding programme"@en,
                              "Programa de Financiación"@es,
                              "Funding Program"@en;
                   rdfs:subClassOf [owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                                    owl:allValuesFrom rdfs:Literal ; 
                                    a owl:Restriction],
                                   [owl:onProperty <http://w3id.org/roh/mirror/obo/ro#BFO_0000051> ; 
                                    owl:allValuesFrom roh:FundingProgram ; 
                                    a owl:Restriction],
                                   [owl:onProperty <http://w3id.org/roh/mirror/geonames#locatedIn> ; 
                                    owl:allValuesFrom <http://w3id.org/roh/mirror/geonames#Feature> ; 
                                    a owl:Restriction],
                                   [owl:onProperty roh:title ; 
                                    owl:allValuesFrom xsd:string ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom <http://w3id.org/roh/mirror/vivo#FundingOrganization> ; 
                                    owl:onProperty roh:promotedBy ; 
                                    a owl:Restriction],
                                   [owl:onProperty <http://w3id.org/roh/mirror/vivo#relatedBy> ; 
                                    owl:allValuesFrom roh:Dossier ; 
                                    a owl:Restriction],
                                   [owl:onProperty roh:hasFundingProgramClassification ; 
                                    owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                           [owl:someValuesFrom roh:FundingProgramClassification ; 
                                                                           owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class] ; 
                                    a owl:Restriction],
                                   [owl:onProperty <http://w3id.org/roh/mirror/vivo#dateTimeInterval> ; 
                                    owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#DateTimeInterval> ; 
                                    a owl:Restriction],
                                   [owl:onProperty <http://w3id.org/roh/mirror/vivo#description> ; 
                                    owl:allValuesFrom xsd:string ; 
                                    a owl:Restriction],
                                   [owl:onProperty roh:promotedBy ; 
                                    owl:allValuesFrom <http://w3id.org/roh/mirror/vivo#FundingOrganization> ; 
                                    a owl:Restriction].
roh:FundingProgramClassification a owl:Class;
                                 rdfs:label "Funding Program Classification"@en;
                                 rdfs:subClassOf <http://w3id.org/roh/mirror/skos#ConceptScheme>.
roh:FundingSource a owl:Class;
                  rdfs:comment """We have just considered a subset of the available funding sources, taking into account the sample datasets provided by University of Murcia

A roh:FundingSource roh:feeds a roh:Funding with funds to sponsor some projects."""@en;
                  rdfs:label "Fuente de Financiación"@es,
                             "Funding Source"@en;
                  rdfs:subClassOf [owl:onProperty roh:funds ; 
                                   owl:allValuesFrom roh:FundingProgram ; 
                                   a owl:Restriction].
roh:GitHubRepository a owl:Class;
                     rdfs:comment "Es un repositorio concreto almacenado en https://github.com."@es,
                                  "It's a concrete Repository that is stored in https://github.com."@en;
                     rdfs:label "GitHub Repository"@en,
                                "Repositorio de GitHub"@es;
                     rdfs:subClassOf [owl:onProperty roh:hasPredecessor ; 
                                      owl:allValuesFrom roh:GitHubRepository ; 
                                      a owl:Restriction],
                                     roh:Repository.
roh:Grant a owl:Class;
          rdfs:comment "A financial award provided by a funding organisation for a particular project or purpose, usually awarded on the basis of a competitive application."@en,
                       "An amount of money given especially by the government to a person or organization for a special purpose."@en;
          rdfs:label "Grant"@en,
                     "Subvención"@es;
          rdfs:subClassOf roh:Funding.
roh:HRClassification a owl:Class;
                     rdfs:label "Clasificación de los recursos humanos"@es,
                                "Human Resource Classification"@en;
                     rdfs:subClassOf <http://w3id.org/roh/mirror/skos#ConceptScheme>.
roh:Invention a owl:Class;
              rdfs:comment "Invention"@en,
                           "A new device, method, or process developed from study and experimentation in the framework of research."@en;
              rdfs:label "Invention"@en;
              rdfs:subClassOf [owl:onProperty <http://w3id.org/roh/mirror/vivo#relates> ; 
                               owl:allValuesFrom <http://w3id.org/roh/mirror/obo/bfo#BFO_0000023> ; 
                               a owl:Restriction],
                              [owl:onProperty roh:hasKnowledgeArea ; 
                               owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                      [owl:someValuesFrom roh:KnowledgeArea ; 
                                                                      owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class] ; 
                               a owl:Restriction],
                              [owl:onProperty roh:isSupportedBy ; 
                               owl:allValuesFrom roh:Funding ; 
                               a owl:Restriction],
                              [owl:onProperty <http://w3id.org/roh/mirror/vivo#relatedBy> ; 
                               owl:allValuesFrom roh:Dossier ; 
                               a owl:Restriction],
                              [owl:onProperty <http://w3id.org/roh/mirror/vivo#description> ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty <http://w3id.org/roh/mirror/vivo#identifier> ; 
                               a owl:Restriction],
                              [owl:onProperty <http://w3id.org/roh/mirror/vivo#abbreviation> ; 
                               owl:allValuesFrom rdfs:Literal ; 
                               a owl:Restriction],
                              [owl:onProperty roh:patentStatus ; 
                               owl:allValuesFrom [owl:unionOf (roh:Accepted
                                                               roh:Rejected
                                                               roh:Submitted) ; 
                                                  a owl:Class] ; 
                               a owl:Restriction],
                              [owl:onProperty <http://w3id.org/roh/mirror/geonames#locatedIn> ; 
                               owl:allValuesFrom <http://w3id.org/roh/mirror/geonames#Feature> ; 
                               a owl:Restriction],
                              [owl:onProperty roh:produces ; 
                               owl:allValuesFrom roh:ResearchObject ; 
                               a owl:Restriction],
                              [owl:onProperty roh:hasPropertyClassification ; 
                               owl:allValuesFrom [owl:intersectionOf (<http://w3id.org/roh/mirror/skos#Concept>
                                                                      [owl:someValuesFrom roh:PropertyClassification ; 
                                                                      owl:onProperty <http://w3id.org/roh/mirror/skos#inScheme> ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class] ; 
                               a owl:Restriction],
                              [owl:onProperty roh:spends ; 
                               owl:allValuesFrom roh:PatentExpense ; 
                               a owl:Restriction],
                              [owl:onProperty <http://w3id.org/roh/mirror/obo/ro#BFO_0000051> ; 
                               owl:allValuesFrom roh:PatentApplication ; 
                               a owl:Restriction],
                              [owl:onProperty roh:fundedBy ; 
                               owl:allValuesFrom roh:FundingProgram ; 
                               a owl:Restriction],
                              [owl:someValuesFrom xsd:string ; 
                               owl:onProperty <http://w3id.org/roh/mirror/vivo#freetextKeyword> ; 
                               a owl:Restriction],
                              [owl:someValuesFrom xsd:string ; 
                               owl:onProperty roh:title ; 
                               a owl:Restriction],
                              [owl:onProperty roh:title ; 
                               owl:allValuesFrom xsd:string ; 
                               a owl:Restriction].
roh:Invoice a owl:Class;
            rdfs:label "Factura"@es,
