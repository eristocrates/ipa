                                    [owl:onProperty roh:mark ; 
                                     owl:allValuesFrom xsd:string ; 
                                     a owl:Restriction],
                                    roh:ThesisMetric.
roh:PressArticle a owl:Class;
                 rdfs:label "Press Article"@en;
                 rdfs:subClassOf <http://w3id.org/roh/mirror/bibo#Article>.
roh:Product a owl:Class;
            rdfs:comment "A product as outcome of a project."@en;
            rdfs:label "Product"@en.
roh:ProformaInvoice a owl:Class;
                    rdfs:label "Proforma invoice"@en;
                    rdfs:subClassOf roh:Invoice.
roh:ProjectClassification a owl:Class;
                          rdfs:label "Clasificación de Proyecto"@es,
                                     "Project Classification"@en;
                          rdfs:subClassOf <http://w3id.org/roh/mirror/skos#ConceptScheme>.
roh:ProjectContract a owl:Class;
                    rdfs:comment "An agreement among different organizations to work in a project for a specified duration."@en;
                    rdfs:label "Contrato de Proyecto"@es,
                               "Project Contract"@en;
                    rdfs:subClassOf <http://w3id.org/roh/mirror/vivo#Contract>.
roh:ProjectExpense a owl:Class;
                   rdfs:comment "A ProjectExpense is carried out by a Researcher (by default the principal researcher) in charge of a Project, which indirectly links it to Funding, understood as a set of FundingAmounts. The types of expenses considered are: Personnel Expenses, Subcontracting, Travel, Equipment, Research Infrastructure and Other Goods and Services."^^rdfs:Literal;
                   rdfs:label "Gasto de Proyecto"@es,
                              "Project Expense"@en;
                   rdfs:subClassOf roh:Expense.
roh:PropertyClassification a owl:Class;
                           rdfs:label "Clasificación de la propiedad"@es,
                                      "Property Classification"@en;
                           rdfs:subClassOf <http://w3id.org/roh/mirror/skos#ConceptScheme>.
roh:ProposalSubmitted a owl:Class;
                      rdfs:label "Proposal Submitted"@en;
                      rdfs:subClassOf roh:Status.
roh:Prototype a owl:Class;
              rdfs:comment "A product prototype"@en;
              rdfs:label "Prototype"@en;
              rdfs:subClassOf roh:Product.
roh:Provisional a owl:Class;
                rdfs:label "Provisional"@en;
                rdfs:subClassOf roh:Status.
roh:PublicationMetric a owl:Class;
                      rdfs:comment "An article is cited roh:citationCount times in the roh:metricName network. Example: if an article is cited 5 times in the Web of Science, then the roh:metricName should be Web of Science and the roh:citationCount 5. Thus, a roh:metricName can be roh and the value of roh:citationCount the number of times that article has been cited in the knowledge graph of this ontology."@en,
                                   "Un artículo es citado roh:citationCount veces en la red the roh:metricName. Ejemplo: si un artículo ha sido citado 5 veces en la Web of Science, entonces los atributos roh:metricName debe ser Web Of Science y roh:citationCount 5. De este modo, una roh:metricName puede ser roh y el valor de roh:citationCount el número de veces que dicho artículo ha sido citado en el grafo de conocimiento de esta ontología."@es;
                      rdfs:label "Métrica de Publicación"@es,
                                 "Publication Metric"@en;
                      rdfs:subClassOf [owl:someValuesFrom xsd:string ; 
                                       owl:onProperty roh:metricName ; 
                                       a owl:Restriction],
                                      [owl:onProperty roh:citationCount ; 
                                       owl:allValuesFrom xsd:integer ; 
                                       a owl:Restriction],
                                      roh:Metric.
roh:README a owl:Class;
           rdfs:comment "Documento llamado README que describe el contenido de un Repositorio."@es,
                        "The document named README that describe the content of a concret Repository."@en;
           rdfs:label "README"@en;
           rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (roh:Repository
                                                             <http://w3id.org/roh/mirror/obo/ero#ERO_0000071>) ; 
