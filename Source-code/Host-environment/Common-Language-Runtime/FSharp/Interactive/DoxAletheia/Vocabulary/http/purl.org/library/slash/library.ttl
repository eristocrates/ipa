                rdfs:subClassOf <http://schema.org/CreativeWork>;
                <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/CreativeWork/WebSite>;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:hasCarrier a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain <http://schema.org/CreativeWork>;
                   rdfs:isDefinedBy library:;
                   rdfs:label "has carrier"@en;
                   rdfs:range library:Carrier;
                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:holdingsCount a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment """This is the number of identifiable \"library\" collections that \"hold\" one or more exemplars (aka copies or \"Items\").""";
                      rdfs:domain <http://schema.org/CreativeWork>;
                      rdfs:isDefinedBy library:;
                      rdfs:label "holdings count";
                      rdfs:range xsd:integer;
                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:oclcnum a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:domain <http://schema.org/CreativeWork>;
                rdfs:isDefinedBy library:;
                rdfs:label "oclcnum"@en;
                rdfs:range xsd:integer;
                <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:placeOfPublication a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "This is the place where the schema:CreativeWork was published."@en;
                           rdfs:domain <http://schema.org/CreativeWork>;
                           rdfs:isDefinedBy library:;
                           rdfs:label "place of publication"@en;
                           rdfs:range <http://schema.org/Place>;
                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
<http://viaf.org/viaf/136069274> a <http://schema.org/Organization>,
