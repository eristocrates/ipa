@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix library: <http://purl.org/library/>.

<http://purl.org/dc/elements/1.1/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/description> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/elements/1.1/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
library: <http://purl.org/dc/elements/1.1/creator> <http://viaf.org/viaf/136069274>;
         <http://purl.org/dc/elements/1.1/description> """These are \"library\" extension terms intended for use with Schema.org""";
         <http://purl.org/dc/elements/1.1/title> """Experimental \"library\" extension vocabulary for use with Schema.org"""@en;
         a <http://www.w3.org/2002/07/owl#Ontology>.
library:ArchiveMaterial a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:isDefinedBy library:;
                        rdfs:label "ArchiveMaterial"@en;
                        rdfs:subClassOf <http://schema.org/CreativeWork>;
                        <http://www.w3.org/2002/07/owl#equivalentClass> <http://schema.org/CreativeWork/ArchiveMaterial>;
                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:Audiobook a <http://schema.org/BookFormatType>,
                    <http://www.w3.org/2002/07/owl#NamedIndividual>;
                  rdfs:isDefinedBy library:;
                  rdfs:label "Audio Book"@en;
                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable".
library:BlurayDisk a library:Carrier,
                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
