              rdfs:isDefinedBy dcterms:;
              rdfs:label "Date Valid"@en;
              rdfs:range rdfs:Literal;
              rdfs:subPropertyOf dc11:date,
                                 dcterms:date.
<http://reference.data.gov.au/def/datasetOntology> dcterms:creator <http://linked.data.gov.au/>;
                                                   dcterms:publisher <http://linked.data.gov.au/>;
                                                   dcterms:rights <http://creativecommons.org/licenses/by/4.0/>;
                                                   a owl:NamedIndividual.
<http://reference.data.gov.au/def/datasetOntology#> dcterms:publisher <http://purl.org/dc/aboutdcmi#DCMI>;
                                                    a owl:NamedIndividual.
<http://reference.data.gov.au/def/ont/dataset> dc11:contributor <http://reference.data.gov.au/def/ont/d.lowe@bom.gov.au>;
                                               dc11:publisher "Australian Government Linked Data Working Group"@en;
                                               dcterms:contributor <http://reference.data.gov.au/def/ont/simon.cox@csiro.au>,
                                                                   <http://reference.data.gov.au/def/ont/armin.haller@anu.edu.au>,
                                                                   <http://reference.data.gov.au/def/ont/nicholas.car@ga.gov.au>;
                                               dcterms:created "2015-06-19"^^xsd:date;
                                               dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
                                               dcterms:modified "2017-09-26"^^xsd:date;
                                               dcterms:title "Dataset Ontology"@en;
                                               a owl:Ontology;
                                               rdfs:comment """The data.gov.au Dataset Ontology is an OWL ontology designed to describe the characteristics of datasets published on data.gov.au.

The ontology contains elements which describe the publication, update, origin, governance, spatial and temporal coverage and other contextual information about the dataset. The ontology also covers aspects of organisational custodianship and governance.
 
By using this ontology to describe datasets on data.gov.au publishers increase discoverability and enable the consumption of this information in other applications/systems as Linked Data. It further enables decentralised publishing of catalogs and facilitates federated dataset search across sites, e.g. in datasets that are published by the States.
 
Other publishers of Linked Data may make assertions about data published using this ontology, e.g. they may publish information about the use of the dataset in other applications."""@en;
                                               owl:imports <http://www.w3.org/2006/vcard/ns>,
                                                           <http://www.w3.org/2006/time>,
                                                           <http://www.w3.org/ns/prov-o>,
                                                           <http://www.opengis.net/ont/geosparql>,
                                                           <http://www.w3.org/ns/dcat>;
                                               owl:priorVersion <https://github.com/AGLDWG/TR/blob/master/government.ttl>;
                                               owl:versionIRI <http://reference.data.gov.au/def/ont/dataset/1.0>;
                                               owl:versionInfo "1.0"@en.
donto:AGIFTFunction dc11:source agls:FunctionClass;
                    a owl:Class;
                    rdfs:comment "The Government Function defined by the Australian Governments' Interactive Functions Thesaurus that best describes the data contained within a Dataset."@en;
                    rdfs:label "Function"@en;
                    rdfs:seeAlso <https://data.naa.gov.au/def/agift/export/def/agift.rdf>;
                    rdfs:subClassOf donto:Classifier.
donto:AssociatedOrganisation a owl:Class;
                             rdfs:comment "An AssociatedOrganisation is an Organisation that is responsible for an Event that changed a Dataset the Organisation is associated with."@en;
                             rdfs:subClassOf nsprov:Association.
donto:Catalog a owl:Class;
              rdfs:comment "A Catalog is a curated collection of metadata about datasets."@en;
              rdfs:isDefinedBy "https://www.w3.org/ns/dcat#Catalog"@en;
              rdfs:label "Catalog"@en;
              rdfs:subClassOf aerdcat:Catalog,
                              nsprov:Entity.
donto:Classifier a owl:Class;
                 rdfs:comment "A classifier used for Australian Government Data."@en;
                 rdfs:subClassOf skos:Concept.
donto:Dataset a owl:Class;
              rdfs:comment "A Dataset is a collection of resources, published or curated by an agent, and openly available for download in one or more formats."@en;
              rdfs:label "Dataset"@en;
              rdfs:subClassOf [owl:someValuesFrom dcterms:LicenseDocument ; 
                               owl:onProperty dcterms:license ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty donto:dateChangeEvent ; 
                               a owl:Restriction],
                              [owl:someValuesFrom rdfs:Literal ; 
                               owl:onProperty donto:dateUpdated ; 
                               a owl:Restriction],
                              [owl:onProperty donto:agiftFunction ; 
                               owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                               a owl:Restriction],
                              aerdcat:Dataset,
                              nsprov:Entity.
donto:DatasetChangeEvent a owl:Class;
                         rdfs:comment "A Dataset Change Event is a description of an event that happens at a given point in time and that results in any type of change to the Dataset."@en;
                         rdfs:label "Dataset Change Event"@en;
                         rdfs:subClassOf nsprov:Activity.
donto:DatasetPublicationEvent a owl:Class;
                              rdfs:comment "A Dataset Publication Event is a description of an event that happens at a given point in time and that results in the publication of a Dataset on data.gov.au."@en;
                              rdfs:label "Dataset Publication Event"@en;
                              rdfs:subClassOf donto:DatasetChangeEvent.
donto:Distribution a owl:Class;
                   rdfs:comment "A Distribution defines the available form of a Dataset, i.e. different formats of the Dataset or different type of endpoints the Dataset can be retrieved from."@en;
                   rdfs:label "Distribution"@en;
                   rdfs:subClassOf aerdcat:Distribution,
                                   nsprov:Entity.
donto:Document a owl:Class;
               rdfs:label "Document"@en;
               rdfs:subClassOf nsprov:Entity;
               owl:equivalentClass foaf:Document.
donto:Federal a owl:Class;
              rdfs:comment "Federal Government denotes the federal democratic administrative authority of the Commonwealth of Australia."@en;
              rdfs:label "Federal Government"@en;
              rdfs:subClassOf donto:LevelOfGovernment.
donto:FieldOfResearch a owl:Class;
                      rdfs:comment "The Field of Research defined by the Australian and New Zealand Standard Research Classification (ANZSRC) that best describes the type of methods applied to obtain the data contained within a Dataset."@en;
                      rdfs:label "Field of Research"@en;
                      rdfs:subClassOf donto:Classifier.
donto:GazettedLocality a owl:Class;
                       rdfs:comment "Locality with a name authorised by a government agency";
                       rdfs:label "Spatial Gazetteer"@en;
                       rdfs:subClassOf donto:Locality.
donto:Geometry a owl:Class;
               rdfs:subClassOf donto:SpatialThing,
                               geosparql:Geometry.
donto:GovernmentAgency a owl:Class;
                       rdfs:comment "A Government Agency is a kind of Organisation in the Commonwealth of Australia that is a distinct and recognisable body which has responsibility for carrying out administrative functions."@en;
                       rdfs:label "Government Agency"@en;
                       rdfs:seeAlso <http://recordsearch.naa.gov.au/manual/Provenance/AgencyDefinition.htm#DEFINITION>;
                       rdfs:subClassOf donto:Organisation.
donto:LevelOfGovernment a owl:Class;
                        rdfs:comment "Level of Government is a description that is used to describe the Jurisidiction of an Organisation."@en;
                        rdfs:label "Level of Government"@en.
donto:LocalGovernmentArea a owl:Class;
                          rdfs:comment "Local Government is the lowest tier of government in the Commonwealth of Australia administered under the states and territories."@en;
                          rdfs:label "Local Government"@en;
                          rdfs:subClassOf [owl:onProperty donto:inState ; 
                                           owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                           a owl:Restriction],
                                          donto:LevelOfGovernment.
donto:Locality a owl:Class;
               rdfs:comment "Locality is a Spatial Thing corresponding to a place or area, which is denoted by a commonly recognised, or formally designated, name or description.";
               rdfs:subClassOf donto:SpatialThing.
donto:MaintenanceResponsibility a owl:Class;
                                rdfs:comment "Provides information about the maintenance arrangements for the dataset. At a minimum the Agent and start-time for the maintenance responsibility is required."@en;
                                rdfs:label "Dataset Maintenance Arrangement"@en;
                                rdfs:subClassOf [owl:onProperty nsprov:wasAssociatedWith ; 
                                                 owl:minCardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty nsprov:endedAtTime ; 
                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                [owl:onProperty nsprov:startedAtTime ; 
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger ; 
                                                 a owl:Restriction],
                                                nsprov:Activity.
donto:Organisation a owl:Class;
                   rdfs:comment "An Organisation is a kind of Agent representing, for example, a business or government, or organisational subunits thereof."@en;
                   rdfs:label "Organisation"@en;
                   rdfs:subClassOf dcterms:Agent,
                                   nsprov:Organization.
donto:Point a owl:Class;
            rdfs:comment "A Point is a point in space using its geographic coordinates."@en,
                         "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG.";
            rdfs:label "Point"@en;
            rdfs:seeAlso <http://www.w3.org/2003/01/geo/wgs84_pos>;
            rdfs:subClassOf donto:Geometry.
donto:Polygon a owl:Class;
              rdfs:comment "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG.";
              rdfs:label "Polygon"@en;
              rdfs:subClassOf donto:Geometry.
donto:Role a owl:Class;
           rdfs:comment "A Role corresponds to the involvement of an Agent in an Event, e.g. fulfilling a publisher, contributor or custodian Role."@en;
           rdfs:label "Role"@en;
           rdfs:subClassOf nsprov:Role.
donto:SpatialThing a owl:Class;
                   rdfs:comment "A Spatial Thing describes the spatial characteristics of the resources within a Dataset, i.e. the geographical area where data was collected, a place which is the predominant subject of the Dataset, or a location which is the focus of an activity described in the Dataset."@en,
                                "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be  w3 geo or OGC GeoSPARQL or both, or something else as proposed by SDWWG.";
                   rdfs:label "Spatial Thing"@en;
                   rdfs:subClassOf geosparql:SpatialObject.
donto:StateOrTerritory a owl:Class;
                       rdfs:comment "States and Territories Government are the second tier of Government in the Commonwealth of Australia. The Commonwealth of Australia comprises of six states and various territories some of which enjoy a large degree of self-governance."@en;
                       rdfs:label "State and Territories Government"@en;
                       rdfs:subClassOf donto:LevelOfGovernment.
donto:Timelnterval a owl:Class;
                   rdfs:comment "A Time Interval describes a time period (interval) during which data was collected or observations were made that are described in the Dataset."@en,
                                "Note that this is a subclass of the Interval class from OWL-Time.";
                   rdfs:label "Time Interval"@en;
                   rdfs:subClassOf time:Interval.
donto:agiftFunction a owl:ObjectProperty;
                    rdfs:comment "The AGIFT classification for this dataset";
                    rdfs:label "AGIFT Theme";
                    rdfs:range donto:AGIFTFunction;
                    rdfs:subPropertyOf donto:classifiedAs.
donto:classifiedAs a owl:ObjectProperty;
                   rdfs:comment "A relation to define the main category of the dataset. A dataset can have multiple themes."@en;
                   rdfs:domain donto:Dataset;
                   rdfs:range donto:Classifier;
                   rdfs:subPropertyOf aerdcat:theme.
donto:dateChangeEvent a owl:DatatypeProperty;
                      rdfs:comment "The date a change was made."@en;
                      rdfs:label "Change Event Date"@en;
                      rdfs:range xsd:dateTime;
                      rdfs:subPropertyOf dcterms:dateAccepted.
donto:dateUpdated a owl:DatatypeProperty;
                  rdfs:comment "A relation to define when the Dataset was updated, i.e. a minor change that is not reflected in a Dataset Change Event."@en;
                  rdfs:label "Update Date"@en;
                  rdfs:range xsd:dateTime;
                  rdfs:subPropertyOf donto:dateChangeEvent.
donto:fileSize a owl:DatatypeProperty;
               rdfs:comment "The size of a distribution in bytes."@en;
               rdfs:label "File Size"@en;
               owl:equivalentProperty aerdcat:byteSize.
donto:hasAgent a owl:ObjectProperty;
               rdfs:comment "Defines a relationship for the Agent responsible for a DatasetChangeEvent through an Association that defines the Organisation that the Agent is associated with for that Event."@en;
               rdfs:range dcterms:Agent;
               rdfs:subPropertyOf nsprov:agent.
donto:hasContact a owl:ObjectProperty;
                 rdfs:comment "Defines an agent who is the contact for inquiries on a Dataset."@en;
                 owl:equivalentProperty aerdcat:contactPoint.
donto:hasDataset a owl:ObjectProperty;
                 rdfs:comment "Defines a Dataset to be part of a Catalog."@en;
                 owl:equivalentProperty aerdcat:dataset;
                 owl:inverseOf donto:inCatalog.
donto:hasDistribution a owl:ObjectProperty;
                      rdfs:comment "Defines the available distribution(s) for a Dataset."@en;
                      rdfs:domain donto:Dataset;
                      rdfs:range donto:Distribution;
                      rdfs:subPropertyOf aerdcat:distribution.
donto:hasDownloadURL a owl:ObjectProperty;
                     rdfs:comment "Defines the URLs that contains the Distribution of the Dataset in a given format."@en;
                     owl:equivalentProperty aerdcat:downloadURL.
donto:hasLandingPage a owl:ObjectProperty;
                     rdfs:comment "Defines a relation that associates a Catalog, Dataset or Distribution with its (one) main Web page that can be navigated to in a Web browser to gain access to the dataset, its distributions and/or additional information."@en;
                     rdfs:range foaf:Document;
                     rdfs:subPropertyOf aerdcat:landingPage.
donto:hasLevelOfGovernment a owl:ObjectProperty;
                           rdfs:comment "Defines a relation that denotes the Level of Government of an Organisation, typically a Government Agency."@en;
                           rdfs:domain donto:Organisation;
                           rdfs:range donto:LevelOfGovernment.
donto:hasLicense a owl:ObjectProperty;
                 rdfs:comment "A relation that associates a Catalog, Dataset or Distribution to its license document under which it is made available."@en;
                 rdfs:subPropertyOf dcterms:license.
donto:hasLocalGovernmentArea a owl:ObjectProperty;
                             rdfs:comment "Defines a relation that denotes the Local Government representing a Locality (a Spatial Thing)."@en;
                             rdfs:domain donto:Locality;
                             rdfs:range donto:LocalGovernmentArea.
donto:hasMember a owl:ObjectProperty;
                owl:inverseOf donto:isMemberOf.
donto:hasPurpose a owl:DatatypeProperty;
                 rdfs:comment "The purpose of a Dataset."@en;
                 rdfs:domain donto:Dataset;
                 rdfs:range rdfs:Literal.
donto:hasSpatialExtent a owl:ObjectProperty;
                       rdfs:comment "Spatial extent corresponds to the geographic area within which all items in the dataset fall.";
                       rdfs:domain [owl:unionOf (donto:Dataset
                                                 donto:Locality) ; 
                                    a owl:Class];
                       rdfs:range donto:SpatialThing.
donto:hasTemporalExtent a owl:ObjectProperty;
                        rdfs:comment "Temporal extent corresponds to the time interval within which all items in the dataset occur.";
                        rdfs:domain donto:Dataset;
                        rdfs:range donto:Timelnterval.
donto:hasUpdateFrequency a owl:ObjectProperty;
                         rdfs:comment "Describes the anticipated frequency of updates of a Dataset."@en.
donto:inCatalog a owl:ObjectProperty.
donto:inState a owl:ObjectProperty;
              rdfs:comment "Defines the State or Territory a Locality is located in."@en;
              rdfs:domain donto:Locality;
              rdfs:range donto:StateOrTerritory.
donto:isAssociatedWith a owl:ObjectProperty;
                       rdfs:comment "Defines an association between a Dataset Change Event (e.g. Publishing) and an Association that defines the Agent and/or the Organisation responsible for that Change Event."@en;
                       rdfs:domain donto:DatasetChangeEvent;
                       rdfs:range nsprov:Association;
                       rdfs:subPropertyOf nsprov:qualifiedAssociation;
                       owl:inverseOf donto:participatesIn.
donto:isChangedBy a owl:ObjectProperty;
                  rdfs:comment "Defines a relation that relates a Dataset Change Event to a Dataset. Typically, at least, a Publishing Change Event should be defined that describes when a Dataset is published on the Web."@en;
                  rdfs:domain donto:Dataset;
                  rdfs:range donto:DatasetChangeEvent;
                  rdfs:subPropertyOf nsprov:wasInfluencedBy;
                  owl:inverseOf donto:resultedIn.
donto:isDescribedBy a owl:ObjectProperty;
                    rdfs:comment "Defines a relation that associates a Thing to a Dataset that describes the Dataset in more detail."@en;
                    rdfs:domain donto:Dataset;
                    rdfs:range owl:Thing;
                    rdfs:subPropertyOf foaf:isPrimaryTopicOf.
donto:isMemberOf a owl:ObjectProperty;
                 rdfs:comment "Defines a relation that denotes the beloning of an Agent to an Organisation."@en;
                 rdfs:domain vcard2006:Agent;
                 rdfs:range donto:Organisation.
donto:keyword a owl:DatatypeProperty;
              rdfs:comment "A keyword associated with the Dataset."@en;
              rdfs:label "Keyword"@en;
              owl:equivalentProperty aerdcat:keyword.
donto:maintenanceArrangement a owl:ObjectProperty;
                             rdfs:comment "Links to a description of a maintenance activity."@en;
                             rdfs:domain dcmitype:Dataset;
                             rdfs:range donto:MaintenanceResponsibility;
                             rdfs:subPropertyOf nsprov:wasInfluencedBy.
donto:participatesIn a owl:ObjectProperty.
donto:playsRole a owl:ObjectProperty;
                rdfs:comment "A relation that defines the Role someone plays in a Dataset Change event defined through an Association entity."@en;
                rdfs:domain nsprov:Association;
                rdfs:range donto:Role;
                rdfs:subPropertyOf nsprov:hadRole;
                owl:inverseOf donto:roleOf.
donto:publisher a owl:AnnotationProperty,
                  owl:ObjectProperty;
                rdfs:comment "A Publisher plays the Role of uploading the Dataset to data.gov.au."@en;
                rdfs:subPropertyOf dcterms:publisher.
donto:resultedIn a owl:ObjectProperty.
donto:roleOf a owl:ObjectProperty.
donto:title a owl:AnnotationProperty,
              owl:DatatypeProperty;
            rdfs:subPropertyOf dcterms:title.
donto:updateDate a owl:AnnotationProperty,
                   owl:DatatypeProperty;
                 rdfs:subPropertyOf dcterms:modified.
<http://www.agls.gov.au/agls/1.2/availability> a owl:AnnotationProperty.
<http://www.agls.gov.au/agls/1.2/function> a owl:AnnotationProperty.
<http://www.agls.gov.au/agls/1.2/mandate> a owl:AnnotationProperty.
agls: dcterms:created "2002-04-18";
      dcterms:creator "National Archives of Australia"@en-au;
      dcterms:description "The AGLS Metadata Terms Namespace provides URIs for the AGLS Metadata Terms Vocabulary. Vocabulary terms are declared using RDF Schema language to support RDF applications. The AGLS Metadata Terms form a richer vocabulary, which is intended to facilitate discovery of resources. It will be updated according to AGLS Working Group decisions."@en-au;
      dcterms:language "English";
      dcterms:modified "2010-06-30";
      dcterms:publisher "National Archives of Australia"@en-au;
      dcterms:rights "Copyright Commonwealth of Australia 2007";
      dcterms:title "The AGLS Metadata Terms Namespace providing access to its content by means of an RDF Schema."@en-au.
agls:AGLSAgentClass dcterms:issued "2008-05-27";
                    dcterms:modified "2010-04-13";
                    a owl:Class;
                    rdfs:comment "A set of agent encoding schemes and/or formats"@en-au;
                    rdfs:isDefinedBy agls:;
                    rdfs:label "AGLS Agent Class"@en-au.
agls:AZNSCO dcterms:issued "2002-04-18";
            dcterms:modified "2009-02-02";
            a rdfs:Datatype;
            rdfs:comment "The set of occupations specified by the Australian Bureau of Statistics."@en-au;
            rdfs:isDefinedBy agls:;
            rdfs:label "Australian and New Zealand Standard Classification of Occupations"@en-au;
            rdfs:seeAlso <http://www.abs.gov.au/anzsco/>.
agls:AgentClass a owl:Class.
agls:AglsAgent dcterms:issued "2002-04-18";
               dcterms:modified "2009-02-02";
               a rdfs:Datatype;
               rdfs:comment "The set of agents defined by contact details according to Dublin Core Structured Values"@en-au;
               rdfs:isDefinedBy agls:;
               rdfs:label "AAGLS Agent Scheme"@en-au;
               rdfs:seeAlso <http://www.agls.gov.au/documents/AglsAgent/>.
agls:AglsAvail dcterms:issued "2002-04-18";
               dcterms:modified "2009-02-02";
               a rdfs:Datatype;
               rdfs:comment "The set of resource availability or physical access to a resource defined by contact details according to Dublin Core Structured Values"@en-au;
               rdfs:isDefinedBy agls:;
               rdfs:label "AGLS Availability Scheme"@en-au;
               rdfs:seeAlso <http://www.agls.gov.au/documents/AglsAvail/>.
agls:AudienceClass a owl:Class.
agls:AvailClass dcterms:issued "2007-12-12";
                dcterms:modified "2009-02-02";
                a owl:Class;
                rdfs:comment "A set of availability encoding schemes and/or formats"@en-au;
                rdfs:isDefinedBy agls:;
                rdfs:label "Availability Class"@en-au.
agls:DocumentClass dcterms:issued "2007-12-12";
                   dcterms:modified "2009-02-02";
                   a owl:Class;
                   rdfs:comment "A set of document encoding schemes and/or formats"@en-au;
                   rdfs:isDefinedBy agls:;
                   rdfs:label "Document Class"@en-au.
agls:FunctionClass dcterms:issued "2007-12-12";
                   dcterms:modified "2010-04-13";
                   a owl:Class;
                   rdfs:comment "A set of function encoding schemes and/or formats"@en-au;
                   rdfs:isDefinedBy agls:;
                   rdfs:label "Function Class"@en-au.
agls:GOLD dcterms:issued "2002-04-18";
          dcterms:modified "2009-02-02";
          a rdfs:Datatype;
          rdfs:comment "The set of agents defined by contact details according to X500 syntax."@en-au;
          rdfs:isDefinedBy agls:;
          rdfs:label "Government Online Directory"@en-au;
          rdfs:seeAlso <http://gold.directory.gov.au/>.
agls:Geocode dcterms:issued "2008-10-21";
             dcterms:modified "2010-04-13";
             a rdfs:Datatype;
             rdfs:comment "Geographic coordinates expressed as latitude and longitude."@en-au;
             rdfs:isDefinedBy agls:;
             rdfs:label "Geocode"@en-au.
agls:JuriClass dcterms:issued "2007-12-12";
               dcterms:modified "2009-02-02";
               a owl:Class;
               rdfs:comment "A set of jurisdiction encoding schemes and/or formats"@en-au;
               rdfs:isDefinedBy agls:;
               rdfs:label "Jurisdiction Class"@en-au.
agls:ServiceClass dcterms:issued "2007-12-12";
                  dcterms:modified "2010-04-13";
                  a owl:Class;
                  rdfs:comment "A set of service encoding schemes and/or formats"@en-au;
                  rdfs:isDefinedBy agls:;
                  rdfs:label "Service Class"@en-au.
agls:act dcterms:issued "2002-04-18";
         dcterms:modified "2009-02-02";
         dcterms:type rdf:Property;
         a owl:AnnotationProperty;
         rdfs:comment "A specific piece of legislation which requires or drives the creation or provision of the resource."@en-au;
         rdfs:isDefinedBy agls:;
         rdfs:label "Act"@en-au;
         rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/mandate>,
                            agls:mandate.
agls:aggregationLevel dcterms:description "There are only two values possible for this refinement, either item or collection."@en-au;
                      dcterms:issued "2002-04-18";
                      dcterms:modified "2007-12-19";
                      dcterms:type rdf:Property;
                      a owl:AnnotationProperty,
                        owl:ObjectProperty;
                      rdfs:comment "The level of aggregation of the described resource."@en-au;
                      rdfs:domain dcterms:Collection;
                      rdfs:isDefinedBy agls:;
                      rdfs:label "Aggregation Level"@en-au;
                      rdfs:subPropertyOf dcterms:type,
                                         dc11:type.
agls:agls-audience dcterms:issued "2002-04-18";
                   dcterms:modified "2009-02-02";
                   a owl:Class;
                   rdfs:comment "The set of audience types specified by the AGLS Audience Scheme."@en-au;
                   rdfs:isDefinedBy agls:;
                   rdfs:label "AGLS Audience Vocabulary"@en-au;
                   rdfs:seeAlso <http://www.agls.gov.au/documents/agls-audience/>.
agls:availability dcterms:issued "2007-12-19";
                  dcterms:modified "2009-02-02";
                  dcterms:type rdf:Property;
                  a owl:AnnotationProperty;
                  rdfs:comment "How the resource can be obtained or accessed, or contact information."@en-au;
                  rdfs:isDefinedBy agls:;
                  rdfs:label "Availability"@en-au;
                  rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/availability>.
agls:case dcterms:issued "2002-04-18";
          dcterms:modified "2009-02-02";
          dcterms:type rdf:Property;
          a owl:AnnotationProperty;
          rdfs:comment "A specific piece of case law which requires or drives the creation or provision of the resource."@en-au;
          rdfs:isDefinedBy agls:;
          rdfs:label "Case"@en-au;
          rdfs:subPropertyOf <http://www.agls.gov.au/agls/1.2/mandate>,
                             agls:mandate.
agls:category dcterms:description "There are only three valid values for this property, 'service', 'document' or 'agency'."@en-au;
              dcterms:issued "2002-04-18";
              dcterms:modified "2009-02-02";
              dcterms:type rdf:Property;
              a owl:ObjectProperty,
                owl:AnnotationProperty;
              rdfs:comment "The generic type of the resource being described."@en-au;
              rdfs:isDefinedBy agls:;
              rdfs:label "Category"@en-au;
              rdfs:subPropertyOf dcterms:type,
                                 dc11:type.
agls:dateLicensed dcterms:issued "2007-12-12";
                  dcterms:modified "2009-02-02";
                  dcterms:type rdf:Property;
                  a owl:AnnotationProperty,
                    owl:DatatypeProperty;
                  rdfs:comment "Date a license was applied or became effective."@en-au;
                  rdfs:isDefinedBy agls:;
                  rdfs:label "Date Licensed"@en-au;
                  rdfs:range rdfs:Literal;
                  rdfs:subPropertyOf dc11:date,
                                     dcterms:date.
agls:documentType dcterms:description "Document is used in its widest sense and includes such things as software, sound files and images."@en-au;
                  dcterms:issued "2002-04-18";
                  dcterms:modified "2007-12-19";
                  dcterms:type rdf:Property;
                  a owl:AnnotationProperty,
                    owl:ObjectProperty;
