                                  rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/source>,
                                                     <http://purl.org/dc/terms/relation>;
                                  <http://www.w3.org/2004/02/skos/core#note> "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
<http://purl.org/dc/terms/spatial> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#spatial-003>;
                                   <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                     <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                     <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                   rdfs:comment "Spatial characteristics of the resource."@en;
                                   rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                   rdfs:label "Spatial Coverage"@en;
                                   rdfs:range <http://purl.org/dc/terms/Location>;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/coverage>,
                                                      <http://purl.org/dc/elements/1.1/coverage>.
<http://purl.org/dc/terms/subject> <http://purl.org/dc/terms/description> "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary."@en;
                                   <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#subjectT-002>;
                                   <http://purl.org/dc/terms/issued> "2008-01-14"^^xsd:date;
                                   <http://purl.org/dc/terms/modified> "2012-06-14"^^xsd:date;
                                   a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                     <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                   rdfs:comment "The topic of the resource."@en;
                                   rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                   rdfs:label "Subject"@en;
                                   rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/subject>;
                                   <http://www.w3.org/2004/02/skos/core#note> "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/).  As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en.
<http://purl.org/dc/terms/tableOfContents> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#tableOfContents-003>;
                                           <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                           <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                           a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                             <http://www.w3.org/2002/07/owl#AnnotationProperty>;
                                           rdfs:comment "A list of subunits of the resource."@en;
                                           rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                           rdfs:label "Table Of Contents"@en;
                                           rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/description>,
                                                              <http://purl.org/dc/terms/description>.
<http://purl.org/dc/terms/temporal> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#temporal-003>;
                                    <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                    <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                    a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                      <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                      <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                    rdfs:comment "Temporal characteristics of the resource."@en;
                                    rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                    rdfs:label "Temporal Coverage"@en;
                                    rdfs:range <http://purl.org/dc/terms/PeriodOfTime>;
                                    rdfs:subPropertyOf <http://purl.org/dc/terms/coverage>,
                                                       <http://purl.org/dc/elements/1.1/coverage>.
<http://purl.org/dc/terms/title> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#titleT-002>;
                                 <http://purl.org/dc/terms/issued> "2008-01-14"^^xsd:date;
                                 <http://purl.org/dc/terms/modified> "2010-10-11"^^xsd:date;
                                 a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                 rdfs:comment "A name given to the resource."@en;
                                 rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                 rdfs:label "Title"@en;
                                 rdfs:range rdfs:Literal;
                                 rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/title>.
<http://purl.org/dc/terms/type> <http://purl.org/dc/terms/description> "Recommended best practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMITYPE]. To describe the file format, physical medium, or dimensions of the resource, use the Format element."@en;
                                <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#typeT-001>;
                                <http://purl.org/dc/terms/issued> "2008-01-14"^^xsd:date;
                                <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                a <http://www.w3.org/2002/07/owl#NamedIndividual>,
                                  <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "The nature or genre of the resource."@en;
                                rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                rdfs:label "Type"@en;
                                rdfs:range rdfs:Class;
                                rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/type>.
<http://purl.org/dc/terms/valid> <http://purl.org/dc/terms/hasVersion> <http://dublincore.org/usage/terms/history/#valid-003>;
                                 <http://purl.org/dc/terms/issued> "2000-07-11"^^xsd:date;
                                 <http://purl.org/dc/terms/modified> "2008-01-14"^^xsd:date;
                                 a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                                   <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                                   <http://www.w3.org/2002/07/owl#NamedIndividual>;
                                 rdfs:comment "Date (often a range) of validity of a resource."@en;
                                 rdfs:isDefinedBy <http://purl.org/dc/terms/>;
                                 rdfs:label "Date Valid"@en;
                                 rdfs:range rdfs:Literal;
                                 rdfs:subPropertyOf <http://purl.org/dc/elements/1.1/date>,
                                                    <http://purl.org/dc/terms/date>.
<http://reference.data.gov.au/def/datasetOntology> <http://purl.org/dc/terms/creator> <http://linked.data.gov.au/>;
                                                   <http://purl.org/dc/terms/publisher> <http://linked.data.gov.au/>;
                                                   <http://purl.org/dc/terms/rights> <http://creativecommons.org/licenses/by/4.0/>;
                                                   a <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://reference.data.gov.au/def/datasetOntology#> <http://purl.org/dc/terms/publisher> <http://purl.org/dc/aboutdcmi#DCMI>;
                                                    a <http://www.w3.org/2002/07/owl#NamedIndividual>.
<http://reference.data.gov.au/def/ont/dataset> <http://purl.org/dc/elements/1.1/contributor> <http://reference.data.gov.au/def/ont/d.lowe@bom.gov.au>;
                                               <http://purl.org/dc/elements/1.1/publisher> "Australian Government Linked Data Working Group"@en;
                                               <http://purl.org/dc/terms/contributor> <http://reference.data.gov.au/def/ont/simon.cox@csiro.au>,
                                                                                      <http://reference.data.gov.au/def/ont/armin.haller@anu.edu.au>,
                                                                                      <http://reference.data.gov.au/def/ont/nicholas.car@ga.gov.au>;
                                               <http://purl.org/dc/terms/created> "2015-06-19"^^xsd:date;
                                               <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/>;
                                               <http://purl.org/dc/terms/modified> "2017-09-26"^^xsd:date;
                                               <http://purl.org/dc/terms/title> "Dataset Ontology"@en;
                                               a <http://www.w3.org/2002/07/owl#Ontology>;
                                               rdfs:comment """The data.gov.au Dataset Ontology is an OWL ontology designed to describe the characteristics of datasets published on data.gov.au.

The ontology contains elements which describe the publication, update, origin, governance, spatial and temporal coverage and other contextual information about the dataset. The ontology also covers aspects of organisational custodianship and governance.
 
By using this ontology to describe datasets on data.gov.au publishers increase discoverability and enable the consumption of this information in other applications/systems as Linked Data. It further enables decentralised publishing of catalogs and facilitates federated dataset search across sites, e.g. in datasets that are published by the States.
 
Other publishers of Linked Data may make assertions about data published using this ontology, e.g. they may publish information about the use of the dataset in other applications."""@en;
                                               <http://www.w3.org/2002/07/owl#imports> <http://www.w3.org/2006/vcard/ns>,
                                                                                       <http://www.w3.org/2006/time>,
                                                                                       <http://www.w3.org/ns/prov-o>,
                                                                                       <http://www.opengis.net/ont/geosparql>,
                                                                                       <http://www.w3.org/ns/dcat>;
                                               <http://www.w3.org/2002/07/owl#priorVersion> <https://github.com/AGLDWG/TR/blob/master/government.ttl>;
                                               <http://www.w3.org/2002/07/owl#versionIRI> <http://reference.data.gov.au/def/ont/dataset/1.0>;
                                               <http://www.w3.org/2002/07/owl#versionInfo> "1.0"@en.
donto:AGIFTFunction <http://purl.org/dc/elements/1.1/source> <http://www.agls.gov.au/agls/terms/FunctionClass>;
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The Government Function defined by the Australian Governments' Interactive Functions Thesaurus that best describes the data contained within a Dataset."@en;
                    rdfs:label "Function"@en;
                    rdfs:seeAlso <https://data.naa.gov.au/def/agift/export/def/agift.rdf>;
                    rdfs:subClassOf donto:Classifier.
donto:AssociatedOrganisation a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:comment "An AssociatedOrganisation is an Organisation that is responsible for an Event that changed a Dataset the Organisation is associated with."@en;
                             rdfs:subClassOf <http://www.w3.org/ns/prov#Association>.
donto:Catalog a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Catalog is a curated collection of metadata about datasets."@en;
              rdfs:isDefinedBy "https://www.w3.org/ns/dcat#Catalog"@en;
              rdfs:label "Catalog"@en;
              rdfs:subClassOf <http://www.w3.org/ns/dcat#Catalog>,
                              <http://www.w3.org/ns/prov#Entity>.
donto:Classifier a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "A classifier used for Australian Government Data."@en;
                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept>.
donto:Dataset a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A Dataset is a collection of resources, published or curated by an agent, and openly available for download in one or more formats."@en;
              rdfs:label "Dataset"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> <http://purl.org/dc/terms/LicenseDocument> ; 
                               <http://www.w3.org/2002/07/owl#onProperty> <http://purl.org/dc/terms/license> ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                               <http://www.w3.org/2002/07/owl#onProperty> donto:dateChangeEvent ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#someValuesFrom> rdfs:Literal ; 
                               <http://www.w3.org/2002/07/owl#onProperty> donto:dateUpdated ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#onProperty> donto:agiftFunction ; 
                               <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              <http://www.w3.org/ns/dcat#Dataset>,
                              <http://www.w3.org/ns/prov#Entity>.
donto:DatasetChangeEvent a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A Dataset Change Event is a description of an event that happens at a given point in time and that results in any type of change to the Dataset."@en;
                         rdfs:label "Dataset Change Event"@en;
                         rdfs:subClassOf <http://www.w3.org/ns/prov#Activity>.
donto:DatasetPublicationEvent a <http://www.w3.org/2002/07/owl#Class>;
                              rdfs:comment "A Dataset Publication Event is a description of an event that happens at a given point in time and that results in the publication of a Dataset on data.gov.au."@en;
                              rdfs:label "Dataset Publication Event"@en;
                              rdfs:subClassOf donto:DatasetChangeEvent.
donto:Distribution a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Distribution defines the available form of a Dataset, i.e. different formats of the Dataset or different type of endpoints the Dataset can be retrieved from."@en;
                   rdfs:label "Distribution"@en;
                   rdfs:subClassOf <http://www.w3.org/ns/dcat#Distribution>,
                                   <http://www.w3.org/ns/prov#Entity>.
donto:Document a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "Document"@en;
               rdfs:subClassOf <http://www.w3.org/ns/prov#Entity>;
               <http://www.w3.org/2002/07/owl#equivalentClass> <http://xmlns.com/foaf/0.1/Document>.
donto:Federal a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Federal Government denotes the federal democratic administrative authority of the Commonwealth of Australia."@en;
              rdfs:label "Federal Government"@en;
              rdfs:subClassOf donto:LevelOfGovernment.
donto:FieldOfResearch a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "The Field of Research defined by the Australian and New Zealand Standard Research Classification (ANZSRC) that best describes the type of methods applied to obtain the data contained within a Dataset."@en;
                      rdfs:label "Field of Research"@en;
                      rdfs:subClassOf donto:Classifier.
donto:GazettedLocality a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Locality with a name authorised by a government agency";
                       rdfs:label "Spatial Gazetteer"@en;
                       rdfs:subClassOf donto:Locality.
donto:Geometry a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:subClassOf donto:SpatialThing,
                               <http://www.opengis.net/ont/geosparql#Geometry>.
donto:GovernmentAgency a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A Government Agency is a kind of Organisation in the Commonwealth of Australia that is a distinct and recognisable body which has responsibility for carrying out administrative functions."@en;
                       rdfs:label "Government Agency"@en;
                       rdfs:seeAlso <http://recordsearch.naa.gov.au/manual/Provenance/AgencyDefinition.htm#DEFINITION>;
                       rdfs:subClassOf donto:Organisation.
donto:LevelOfGovernment a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment "Level of Government is a description that is used to describe the Jurisidiction of an Organisation."@en;
                        rdfs:label "Level of Government"@en.
donto:LocalGovernmentArea a <http://www.w3.org/2002/07/owl#Class>;
                          rdfs:comment "Local Government is the lowest tier of government in the Commonwealth of Australia administered under the states and territories."@en;
                          rdfs:label "Local Government"@en;
                          rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> donto:inState ; 
                                           <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                           a <http://www.w3.org/2002/07/owl#Restriction>],
                                          donto:LevelOfGovernment.
donto:Locality a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Locality is a Spatial Thing corresponding to a place or area, which is denoted by a commonly recognised, or formally designated, name or description.";
               rdfs:subClassOf donto:SpatialThing.
donto:MaintenanceResponsibility a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:comment "Provides information about the maintenance arrangements for the dataset. At a minimum the Agent and start-time for the maintenance responsibility is required."@en;
                                rdfs:label "Dataset Maintenance Arrangement"@en;
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#wasAssociatedWith> ; 
                                                 <http://www.w3.org/2002/07/owl#minCardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#endedAtTime> ; 
                                                 <http://www.w3.org/2002/07/owl#minCardinality> "0"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                [<http://www.w3.org/2002/07/owl#onProperty> <http://www.w3.org/ns/prov#startedAtTime> ; 
                                                 <http://www.w3.org/2002/07/owl#cardinality> "1"^^xsd:nonNegativeInteger ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                <http://www.w3.org/ns/prov#Activity>.
donto:Organisation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An Organisation is a kind of Agent representing, for example, a business or government, or organisational subunits thereof."@en;
                   rdfs:label "Organisation"@en;
                   rdfs:subClassOf <http://purl.org/dc/terms/Agent>,
                                   <http://www.w3.org/ns/prov#Organization>.
donto:Point a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A Point is a point in space using its geographic coordinates."@en,
                         "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG.";
            rdfs:label "Point"@en;
            rdfs:seeAlso <http://www.w3.org/2003/01/geo/wgs84_pos>;
            rdfs:subClassOf donto:Geometry.
donto:Polygon a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be from WGS84_pos or OGC GeoSPARQL or both, or something else as proposed by the W3C SDWWG.";
              rdfs:label "Polygon"@en;
              rdfs:subClassOf donto:Geometry.
donto:Role a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A Role corresponds to the involvement of an Agent in an Event, e.g. fulfilling a publisher, contributor or custodian Role."@en;
           rdfs:label "Role"@en;
           rdfs:subClassOf <http://www.w3.org/ns/prov#Role>.
donto:SpatialThing a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Spatial Thing describes the spatial characteristics of the resources within a Dataset, i.e. the geographical area where data was collected, a place which is the predominant subject of the Dataset, or a location which is the focus of an activity described in the Dataset."@en,
                                "This is a stub class which allows us to defer which external vocabulary to adopt. Adoption can be at run-time through a owl:equivalentClass axiom in the data - likely to be  w3 geo or OGC GeoSPARQL or both, or something else as proposed by SDWWG.";
                   rdfs:label "Spatial Thing"@en;
                   rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject>.
donto:StateOrTerritory a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "States and Territories Government are the second tier of Government in the Commonwealth of Australia. The Commonwealth of Australia comprises of six states and various territories some of which enjoy a large degree of self-governance."@en;
                       rdfs:label "State and Territories Government"@en;
                       rdfs:subClassOf donto:LevelOfGovernment.
donto:Timelnterval a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A Time Interval describes a time period (interval) during which data was collected or observations were made that are described in the Dataset."@en,
                                "Note that this is a subclass of the Interval class from OWL-Time.";
                   rdfs:label "Time Interval"@en;
                   rdfs:subClassOf <http://www.w3.org/2006/time#Interval>.
donto:agiftFunction a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "The AGIFT classification for this dataset";
                    rdfs:label "AGIFT Theme";
                    rdfs:range donto:AGIFTFunction;
                    rdfs:subPropertyOf donto:classifiedAs.
donto:classifiedAs a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A relation to define the main category of the dataset. A dataset can have multiple themes."@en;
                   rdfs:domain donto:Dataset;
                   rdfs:range donto:Classifier;
                   rdfs:subPropertyOf <http://www.w3.org/ns/dcat#theme>.
donto:dateChangeEvent a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The date a change was made."@en;
                      rdfs:label "Change Event Date"@en;
                      rdfs:range xsd:dateTime;
                      rdfs:subPropertyOf <http://purl.org/dc/terms/dateAccepted>.
donto:dateUpdated a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "A relation to define when the Dataset was updated, i.e. a minor change that is not reflected in a Dataset Change Event."@en;
                  rdfs:label "Update Date"@en;
                  rdfs:range xsd:dateTime;
                  rdfs:subPropertyOf donto:dateChangeEvent.
donto:fileSize a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The size of a distribution in bytes."@en;
               rdfs:label "File Size"@en;
               <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.w3.org/ns/dcat#byteSize>.
donto:hasAgent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Defines a relationship for the Agent responsible for a DatasetChangeEvent through an Association that defines the Organisation that the Agent is associated with for that Event."@en;
               rdfs:range <http://purl.org/dc/terms/Agent>;
               rdfs:subPropertyOf <http://www.w3.org/ns/prov#agent>.
donto:hasContact a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Defines an agent who is the contact for inquiries on a Dataset."@en;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.w3.org/ns/dcat#contactPoint>.
donto:hasDataset a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Defines a Dataset to be part of a Catalog."@en;
                 <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.w3.org/ns/dcat#dataset>;
                 <http://www.w3.org/2002/07/owl#inverseOf> donto:inCatalog.
donto:hasDistribution a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Defines the available distribution(s) for a Dataset."@en;
                      rdfs:domain donto:Dataset;
                      rdfs:range donto:Distribution;
                      rdfs:subPropertyOf <http://www.w3.org/ns/dcat#distribution>.
donto:hasDownloadURL a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Defines the URLs that contains the Distribution of the Dataset in a given format."@en;
                     <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.w3.org/ns/dcat#downloadURL>.
donto:hasLandingPage a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Defines a relation that associates a Catalog, Dataset or Distribution with its (one) main Web page that can be navigated to in a Web browser to gain access to the dataset, its distributions and/or additional information."@en;
                     rdfs:range <http://xmlns.com/foaf/0.1/Document>;
                     rdfs:subPropertyOf <http://www.w3.org/ns/dcat#landingPage>.
donto:hasLevelOfGovernment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Defines a relation that denotes the Level of Government of an Organisation, typically a Government Agency."@en;
                           rdfs:domain donto:Organisation;
                           rdfs:range donto:LevelOfGovernment.
donto:hasLicense a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "A relation that associates a Catalog, Dataset or Distribution to its license document under which it is made available."@en;
                 rdfs:subPropertyOf <http://purl.org/dc/terms/license>.
donto:hasLocalGovernmentArea a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Defines a relation that denotes the Local Government representing a Locality (a Spatial Thing)."@en;
                             rdfs:domain donto:Locality;
                             rdfs:range donto:LocalGovernmentArea.
donto:hasMember a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                <http://www.w3.org/2002/07/owl#inverseOf> donto:isMemberOf.
donto:hasPurpose a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The purpose of a Dataset."@en;
                 rdfs:domain donto:Dataset;
                 rdfs:range rdfs:Literal.
donto:hasSpatialExtent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Spatial extent corresponds to the geographic area within which all items in the dataset fall.";
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (donto:Dataset
                                                                             donto:Locality) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:range donto:SpatialThing.
donto:hasTemporalExtent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Temporal extent corresponds to the time interval within which all items in the dataset occur.";
                        rdfs:domain donto:Dataset;
                        rdfs:range donto:Timelnterval.
donto:hasUpdateFrequency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Describes the anticipated frequency of updates of a Dataset."@en.
donto:inCatalog a <http://www.w3.org/2002/07/owl#ObjectProperty>.
donto:inState a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Defines the State or Territory a Locality is located in."@en;
              rdfs:domain donto:Locality;
              rdfs:range donto:StateOrTerritory.
donto:isAssociatedWith a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Defines an association between a Dataset Change Event (e.g. Publishing) and an Association that defines the Agent and/or the Organisation responsible for that Change Event."@en;
                       rdfs:domain donto:DatasetChangeEvent;
                       rdfs:range <http://www.w3.org/ns/prov#Association>;
                       rdfs:subPropertyOf <http://www.w3.org/ns/prov#qualifiedAssociation>;
                       <http://www.w3.org/2002/07/owl#inverseOf> donto:participatesIn.
donto:isChangedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Defines a relation that relates a Dataset Change Event to a Dataset. Typically, at least, a Publishing Change Event should be defined that describes when a Dataset is published on the Web."@en;
                  rdfs:domain donto:Dataset;
                  rdfs:range donto:DatasetChangeEvent;
                  rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasInfluencedBy>;
                  <http://www.w3.org/2002/07/owl#inverseOf> donto:resultedIn.
donto:isDescribedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Defines a relation that associates a Thing to a Dataset that describes the Dataset in more detail."@en;
                    rdfs:domain donto:Dataset;
                    rdfs:range <http://www.w3.org/2002/07/owl#Thing>;
                    rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/isPrimaryTopicOf>.
donto:isMemberOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Defines a relation that denotes the beloning of an Agent to an Organisation."@en;
                 rdfs:domain <http://www.w3.org/2006/vcard/ns#Agent>;
                 rdfs:range donto:Organisation.
donto:keyword a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "A keyword associated with the Dataset."@en;
              rdfs:label "Keyword"@en;
              <http://www.w3.org/2002/07/owl#equivalentProperty> <http://www.w3.org/ns/dcat#keyword>.
donto:maintenanceArrangement a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:comment "Links to a description of a maintenance activity."@en;
                             rdfs:domain <http://purl.org/dc/dcmitype/Dataset>;
                             rdfs:range donto:MaintenanceResponsibility;
                             rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasInfluencedBy>.
donto:participatesIn a <http://www.w3.org/2002/07/owl#ObjectProperty>.
donto:playsRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A relation that defines the Role someone plays in a Dataset Change event defined through an Association entity."@en;
                rdfs:domain <http://www.w3.org/ns/prov#Association>;
                rdfs:range donto:Role;
                rdfs:subPropertyOf <http://www.w3.org/ns/prov#hadRole>;
                <http://www.w3.org/2002/07/owl#inverseOf> donto:roleOf.
donto:publisher a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                  <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "A Publisher plays the Role of uploading the Dataset to data.gov.au."@en;
                rdfs:subPropertyOf <http://purl.org/dc/terms/publisher>.
donto:resultedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>.
donto:roleOf a <http://www.w3.org/2002/07/owl#ObjectProperty>.
donto:title a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
              <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:subPropertyOf <http://purl.org/dc/terms/title>.
donto:updateDate a <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:subPropertyOf <http://purl.org/dc/terms/modified>.
