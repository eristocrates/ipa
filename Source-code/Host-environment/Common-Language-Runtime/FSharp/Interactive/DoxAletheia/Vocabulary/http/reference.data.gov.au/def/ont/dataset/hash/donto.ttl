                  rdfs:isDefinedBy agls:;
                  rdfs:label "Document Type"@en-au;
                  rdfs:subPropertyOf dcterms:type,
                                     dc11:type.
agls:function dcterms:issued "2007-12-19";
              dcterms:modified "2007-12-19";
              dcterms:type rdf:Property;
              a owl:AnnotationProperty;
