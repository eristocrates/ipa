               spin:labelTemplate "Syntax rule: only numbers allowed in {?arg1}!";
               a spin:Template;
               rdfs:comment "This query flags all instances with property ?arg1 that have characters other than numbers as literal values."@en;
               rdfs:label "syntax check in all instances: only numbers allowed"@en;
               rdfs:subClassOf dqc:SyntaxConstraints.
dqc:SyntaxConstraints spin:abstract true;
                      a spin:Template;
                      rdfs:comment "Syntax constraints identify values that do not adhere to syntactical rules. {@en} ";
                      rdfs:label "syntax constraints"@en;
                      rdfs:subClassOf dqc:ConstraintTemplates.
dqc:UniqueValueAll spin:body [sp:where ([sp:subject _:B4eaedc8e395bd80ad3cf5f8cfd8c2804 ; 
                                        sp:predicate spin:_arg1 ; 
                                        sp:object _:Baa4a5c7edfebd6d744f2978c9463ff6d]
                                        [sp:subject _:B001c6fbf9a80fc057024cf721434c59d ; 
                                        sp:predicate spin:_arg1 ; 
                                        sp:object _:B8de26f9d84970171665d3042d5defca0]
                                        [sp:expression [sp:arg2 [sp:arg2 _:B001c6fbf9a80fc057024cf721434c59d ; 
                                                                sp:arg1 _:B4eaedc8e395bd80ad3cf5f8cfd8c2804 ; 
                                                                a sp:ne] ; 
                                                       sp:arg1 [sp:arg2 [sp:arg1 _:B8de26f9d84970171665d3042d5defca0 ; 
                                                                         a sp:str] ; 
                                                                sp:arg1 [sp:arg1 _:Baa4a5c7edfebd6d744f2978c9463ff6d ; 
                                                                         a sp:str] ; 
                                                                a sp:eq] ; 
                                                       a sp:and] ; 
                                        a sp:Filter]) ; 
                              sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?a .
    _:b0 spin:violationPath ?arg1 .
}
WHERE {
    ?a ?arg1 ?uniqueValue1 .
    ?b ?arg1 ?uniqueValue2 .
    FILTER ((str(?uniqueValue1) = str(?uniqueValue2)) && (?a != ?b)) 
}""" ; 
                              sp:templates ([sp:subject _:B6883d14f724694cf11a6b9f673925e7b ; 
                                            sp:predicate rdf:type ; 
                                            sp:object spin:ConstraintViolation]
                                            [sp:subject _:B6883d14f724694cf11a6b9f673925e7b ; 
                                            sp:predicate spin:violationRoot ; 
                                            sp:object _:B4eaedc8e395bd80ad3cf5f8cfd8c2804]
                                            [sp:subject _:B6883d14f724694cf11a6b9f673925e7b ; 
                                            sp:predicate spin:violationPath ; 
                                            sp:object spin:_arg1]) ; 
                              a sp:Construct];
                   spin:constraint [spl:valueType rdf:Property ; 
                                    spl:predicate sp:arg1 ; 
                                    rdfs:comment "Select property to be tested!"@en ; 
                                    a spl:Argument];
                   spin:labelTemplate "Values in {?arg1} must be unique!";
                   a spin:Template;
                   rdfs:comment "This query returns all instances where the value for property ?arg1 is not unique in the tested data set. The query tolerates chaotic language tag assignments."@en;
                   rdfs:label "Uniqueness check for all values in a property"@en;
                   rdfs:subClassOf dqc:UniquenessConstraints.
dqc:UniqueValueClass spin:body [sp:where ([sp:subject _:Bef91c18a1cdf1820188a7b2f253d17bc ; 
                                          sp:predicate rdf:type ; 
                                          sp:object spin:_arg1]
                                          [sp:subject _:Bef91c18a1cdf1820188a7b2f253d17bc ; 
