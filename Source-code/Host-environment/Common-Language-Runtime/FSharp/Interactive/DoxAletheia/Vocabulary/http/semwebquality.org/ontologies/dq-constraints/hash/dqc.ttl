                                          sp:object _:B845d9d710b70da0f6b7285a12acffa06]
                                          [sp:subject _:B29d8cc3257ea6371bc9c4be823cdbe38 ; 
                                          sp:predicate rdf:type ; 
                                          sp:object spin:_arg1]
                                          [sp:subject _:B29d8cc3257ea6371bc9c4be823cdbe38 ; 
                                          sp:predicate spin:_arg2 ; 
                                          sp:object _:Ba47457640fd11d7e6d583659492460eb]
                                          [sp:expression [sp:arg2 [sp:arg2 _:B29d8cc3257ea6371bc9c4be823cdbe38 ; 
                                                                  sp:arg1 _:Bef91c18a1cdf1820188a7b2f253d17bc ; 
                                                                  a sp:ne] ; 
                                                         sp:arg1 [sp:arg2 [sp:arg1 _:Ba47457640fd11d7e6d583659492460eb ; 
                                                                           a sp:str] ; 
