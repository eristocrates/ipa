                                     a sp:Let]
                                     [sp:expression [sp:arg2 [sp:arg1 [sp:arg2 "^[0-9]{13}$" ; 
                                                                      sp:arg1 [sp:arg1 _:B6c13d5692e5fd8c068470d534045f41f ; 
                                                                               a sp:str] ; 
                                                                      a sp:regex] ; 
                                                             a sp:not] ; 
                                                    sp:arg1 [sp:arg2 [sp:arg2 10  ; 
                                                                      sp:arg1 [sp:arg2 [sp:arg1 _:Be7a3a5b91b1d95f06226f20540b1b3b8 ; 
                                                                                        a xsd:int] ; 
