                                             sp:object spin:_arg2]) ; 
                               a sp:Construct];
                    spin:constraint [spl:valueType rdfs:Class ; 
                                     spl:predicate sp:arg1 ; 
                                     rdfs:comment "Select class to be tested!"@en ; 
                                     a spl:Argument],
                                    [spl:valueType rdf:Property ; 
                                     spl:predicate sp:arg2 ; 
                                     rdfs:comment "Select property to be tested!" ; 
                                     a spl:Argument];
                    spin:labelTemplate "Mandatory literals in {?arg2} of class {?arg1}!";
                    a spin:Template;
                    rdfs:comment "This query returns all instances of class ?arg1 where the literal for ?arg2 is empty. It does not return instances where the whole property ?arg2 is missing."@en;
                    rdfs:label "mandatory literal value check in instances of a class"@en;
                    rdfs:subClassOf dqc:MissingElementConstraints.
dqc:MissingLiteralsAndProperties spin:body [sp:where ([sp:elements (([sp:subject spin:_this ; 
                                                                   sp:predicate rdf:type ; 
                                                                   sp:object spin:_arg1]
                                                                   [sp:subject spin:_this ; 
                                                                   sp:predicate spin:_arg2 ; 
                                                                   sp:object ""])
                                                                   ([sp:subject spin:_this ; 
                                                                   sp:predicate rdf:type ; 
                                                                   sp:object spin:_arg1]
                                                                   [sp:elements ([sp:subject spin:_this ; 
                                                                                sp:predicate spin:_arg2 ; 
                                                                                sp:object [sp:varName "value"]]) ; 
                                                                   a sp:NotExists])) ; 
                                                      a sp:Union]) ; 
                                            sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?this .
    _:b0 spin:violationPath ?arg2 .
}
WHERE {
    {
        ?this a ?arg1 .
        ?this ?arg2 \"\" .
    }
    UNION
    {
        ?this a ?arg1 .
        NOT EXISTS {
            ?this ?arg2 ?value .
        } 
    } 
}""" ; 
                                            sp:templates ([sp:subject _:B853e7afc4df09d0ee78000849411f5f9 ; 
                                                          sp:predicate rdf:type ; 
                                                          sp:object spin:ConstraintViolation]
                                                          [sp:subject _:B853e7afc4df09d0ee78000849411f5f9 ; 
                                                          sp:predicate spin:violationRoot ; 
                                                          sp:object spin:_this]
                                                          [sp:subject _:B853e7afc4df09d0ee78000849411f5f9 ; 
                                                          sp:predicate spin:violationPath ; 
                                                          sp:object spin:_arg2]) ; 
                                            a sp:Construct];
                                 spin:constraint [spl:valueType rdf:Property ; 
                                                  spl:predicate sp:arg2 ; 
                                                  rdfs:comment "Select property to be tested!" ; 
                                                  a spl:Argument],
                                                 [spl:valueType rdfs:Class ; 
                                                  spl:predicate sp:arg1 ; 
                                                  rdfs:comment "Select class that contains intances to be tested!" ; 
                                                  a spl:Argument];
                                 spin:labelTemplate "Property {?arg2} is mandatory and must not contain empty literals for instances of class {?arg1}!";
                                 a spin:Template;
                                 rdfs:comment "This query returns all instances of class ?arg1 where the literal for ?arg2 is empty or the whole property ?arg2 is missing."@en;
                                 rdfs:label "Mandatory literal value and property check in instances of a class"@en;
                                 rdfs:subClassOf dqc:MissingElementConstraints.
dqc:MissingProperties spin:body [sp:where ([sp:subject _:Bd52fe249115bf7f075daf575d9d93a2a ; 
                                           sp:predicate rdf:type ; 
                                           sp:object spin:_arg1]
                                           [sp:elements ([sp:subject _:Bd52fe249115bf7f075daf575d9d93a2a ; 
                                                        sp:predicate spin:_arg2 ; 
                                                        sp:object [sp:varName "value"]]) ; 
                                           a sp:NotExists]) ; 
                                 sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg2 .
}
