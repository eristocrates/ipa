                                                                           a sp:str] ; 
                                                                  a sp:eq] ; 
                                                         a sp:and] ; 
                                          a sp:Filter]) ; 
                                sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?a .
    _:b0 spin:violationPath ?arg2 .
}
WHERE {
    ?a a ?arg1 .
    ?a ?arg2 ?uniqueValue1 .
    ?b a ?arg1 .
    ?b ?arg2 ?uniqueValue2 .
    FILTER ((str(?uniqueValue1) = str(?uniqueValue2)) && (?a != ?b)) 
}""" ; 
                                sp:templates ([sp:subject _:B2256573173e741cfcdae2ffba74a0ecf ; 
                                              sp:predicate rdf:type ; 
                                              sp:object spin:ConstraintViolation]
                                              [sp:subject _:B2256573173e741cfcdae2ffba74a0ecf ; 
