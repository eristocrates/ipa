                                                                       sp:predicate rdf:type ; 
                                                                       sp:object spin:ConstraintViolation]
                                                                       [sp:subject _:B7b54f901e7a2e6019879873c6ae6f86e ; 
                                                                       sp:predicate spin:violationRoot ; 
                                                                       sp:object _:B79fb3d9f71795320d6484efe7056adbe]
                                                                       [sp:subject _:B7b54f901e7a2e6019879873c6ae6f86e ; 
                                                                       sp:predicate spin:violationPath ; 
                                                                       sp:object spin:_arg2]
                                                                       [sp:subject _:B7b54f901e7a2e6019879873c6ae6f86e ; 
                                                                       sp:predicate spin:violationPath ; 
                                                                       sp:object spin:_arg3]) ; 
                                                         a sp:Construct];
                                              spin:constraint [spl:valueType rdf:Property ; 
                                                               spl:predicate sp:arg5 ; 
                                                               rdfs:comment "Select first property of trusted reference that holds legal values for property 1!" ; 
                                                               a spl:Argument],
                                                              [spl:valueType rdf:Property ; 
                                                               spl:predicate sp:arg3 ; 
                                                               rdfs:comment "Select property 2 of functional dependency!" ; 
                                                               a spl:Argument],
                                                              [spl:valueType rdfs:Class ; 
                                                               spl:predicate sp:arg4 ; 
                                                               rdfs:comment "Select class of trusted reference that holds instances with legal value combinations!" ; 
                                                               a spl:Argument],
                                                              [spl:valueType rdf:Property ; 
                                                               spl:predicate sp:arg6 ; 
                                                               rdfs:comment "Select second property of trusted reference that holds legal values for property 2!" ; 
                                                               a spl:Argument],
                                                              [spl:valueType rdf:Property ; 
                                                               spl:predicate sp:arg2 ; 
                                                               rdfs:comment "Select property 1 of functional dependency!" ; 
                                                               a spl:Argument],
                                                              [spl:valueType rdfs:Class ; 
                                                               spl:predicate sp:arg1 ; 
                                                               rdfs:comment "Select class that holds instances to be tested!" ; 
                                                               a spl:Argument];
                                              spin:labelTemplate "Value combinations of properties {?arg2} and {?arg3} must always be identical with value combinations of properties {?arg5} and {?arg6} of class {?arg4}  for all instances of class {?arg1}!";
                                              a spin:Template;
                                              rdfs:comment "This query flags instances of class ?arg 1 with properties ?arg2 and ?arg3 that do not have the exact value combination in instances of the trusted reference in class ?arg4. The semantics of property ?arg2 should be equal with property ?arg5, and the semantics of property ?arg3 should be equal with ?arg6. The query tolerates homonymous values, i.e. the same value may be assigned to different dependent values. Value combinations that cannot be found in the trusted reference will also be flagged. The query will also test the existence of a single value in the trusted reference when one property of the tested data is missing."@en;
                                              rdfs:label "Functional dependency check in class instances with trusted reference"@en;
                                              rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:FunctionalDependencyTrustedReference_ClassOverBlankNode spin:body [sp:where ([sp:subject _:B5b7b4541ef28bee77e68319e629e9082 ; 
                                                                                 sp:predicate rdf:type ; 
                                                                                 sp:object spin:_arg1]
                                                                                 [sp:elements ([sp:subject _:B5b7b4541ef28bee77e68319e629e9082 ; 
                                                                                              sp:predicate spin:_arg2 ; 
                                                                                              sp:object _:B748500947cbbcce4a17c67446e22f81c]
                                                                                              [sp:elements ([sp:subject _:B748500947cbbcce4a17c67446e22f81c ; 
                                                                                                           sp:predicate spin:_arg3 ; 
                                                                                                           sp:object _:B515a21842bbf395cdccfeb54dac03653]) ; 
                                                                                              a sp:Optional]
                                                                                              [sp:elements ([sp:subject _:B5b7b4541ef28bee77e68319e629e9082 ; 
                                                                                                           sp:predicate spin:_arg4 ; 
                                                                                                           sp:object _:Ba07c4f7f45152435a65e5f304c7307c5]) ; 
                                                                                              a sp:Optional]) ; 
                                                                                 a sp:Optional]
                                                                                 [sp:elements ([sp:subject _:B38f04b2d3962255f3bb280d87398bc6e ; 
                                                                                              sp:predicate rdf:type ; 
                                                                                              sp:object spin:_arg5]
                                                                                              [sp:subject _:B38f04b2d3962255f3bb280d87398bc6e ; 
                                                                                              sp:predicate [sp:varName "arg6"] ; 
                                                                                              sp:object _:B515a21842bbf395cdccfeb54dac03653]
                                                                                              [sp:subject _:B38f04b2d3962255f3bb280d87398bc6e ; 
                                                                                              sp:predicate [sp:varName "arg7"] ; 
                                                                                              sp:object _:Ba07c4f7f45152435a65e5f304c7307c5]) ; 
                                                                                 a sp:NotExists]) ; 
                                                                       sp:text """CONSTRUCT { 
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg3 .
    _:b0 spin:violationPath ?arg4 .
}
WHERE {
    ?s a ?arg1 .
    OPTIONAL {
        ?s ?arg2 ?node .
        OPTIONAL {
            ?node ?arg3 ?value1 .
        } 
        OPTIONAL {
            ?s ?arg4 ?value2 .
        } 
    } 
    NOT EXISTS {
        ?s2 a ?arg5 .
        ?s2 ?arg6 ?value1 .
        ?s2 ?arg7 ?value2 .
    } 
}""" ; 
                                                                       sp:templates ([sp:subject _:B46bb1189fda5589b0d672f8072e865cf ; 
                                                                                     sp:predicate rdf:type ; 
                                                                                     sp:object spin:ConstraintViolation]
                                                                                     [sp:subject _:B46bb1189fda5589b0d672f8072e865cf ; 
                                                                                     sp:predicate spin:violationRoot ; 
                                                                                     sp:object _:B5b7b4541ef28bee77e68319e629e9082]
                                                                                     [sp:subject _:B46bb1189fda5589b0d672f8072e865cf ; 
                                                                                     sp:predicate spin:violationPath ; 
                                                                                     sp:object spin:_arg3]
                                                                                     [sp:subject _:B46bb1189fda5589b0d672f8072e865cf ; 
                                                                                     sp:predicate spin:violationPath ; 
                                                                                     sp:object spin:_arg4]) ; 
                                                                       a sp:Construct];
                                                            spin:constraint [spl:valueType rdf:Property ; 
                                                                             spl:predicate sp:arg7 ; 
                                                                             rdfs:comment "Select second property of trusted reference that holds legal values for property 2!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdf:Property ; 
                                                                             spl:predicate sp:arg6 ; 
                                                                             rdfs:comment "Select first property of trusted reference that holds legal values for property 1!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdf:Property ; 
                                                                             spl:predicate sp:arg4 ; 
                                                                             rdfs:comment "Select property 2 of functional dependency!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdf:Property ; 
                                                                             spl:predicate sp:arg2 ; 
                                                                             rdfs:comment "Select property that holds blank nodes!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdfs:Class ; 
                                                                             spl:predicate sp:arg1 ; 
                                                                             rdfs:comment "Select class that holds instances to be tested!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdfs:Class ; 
                                                                             spl:predicate sp:arg5 ; 
                                                                             rdfs:comment "Select class of trusted reference that holds instances with legal value combinations!" ; 
                                                                             a spl:Argument],
                                                                            [spl:valueType rdf:Property ; 
                                                                             spl:predicate sp:arg3 ; 
                                                                             rdfs:comment "Select property 1 of functional dependency!" ; 
                                                                             a spl:Argument];
                                                            spin:labelTemplate "Value combinations of properties {?arg3} and {?arg4} must always be identical with value combinations of properties {?arg6} and {?arg7} of class {?arg5}  for all instances of class {?arg1}!";
                                                            a spin:Template;
                                                            rdfs:comment """This query is designed to test (blank node) instances of the property-and-node element (rdf:parseType=\"Resource\") ?arg2 that are part of the instances of class ?arg 1. The query flags instances of property ?arg2 with properties ?arg3 and ?arg4 that do not have the exact value combination in instances of the trusted reference in class ?arg5. The semantics of property ?arg3 should be equal with property ?arg6, and the semantics of property ?arg4 should be equal with ?arg7. The query tolerates homonymous values, i.e. the same value may be assigned to different dependent values. Value combinations that cannot be found in the trusted reference will also be flagged. The query will also test the existence of a single value in the trusted reference when one property of the tested data is missing."""@en;
                                                            rdfs:label "Functional dependency check in blank node instances of a class with trusted reference"@en;
                                                            rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:FunctionalDependentEmptyValueAll spin:body [sp:where ([sp:subject _:Bb5038e0d68759b0c6e169aebf2cdc080 ; 
                                                          sp:predicate spin:_arg1 ; 
                                                          sp:object spin:_arg2]
                                                          [sp:expression [sp:arg1 [sp:arg3 "" ; 
                                                                                  sp:arg2 spin:_arg3 ; 
                                                                                  sp:arg1 _:Bb5038e0d68759b0c6e169aebf2cdc080 ; 
                                                                                  a spl:hasValue] ; 
                                                                         a sp:not] ; 
                                                          a sp:Filter]) ; 
                                                sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg3 .
}
WHERE {
    ?s ?arg1 ?arg2 .
    FILTER (!spl:hasValue(?s, ?arg3, \"\"^^xsd:string)) 
}""" ; 
                                                sp:templates ([sp:subject _:B6dba93dccac4677f2aa99a4989de07b2 ; 
                                                              sp:predicate rdf:type ; 
                                                              sp:object spin:ConstraintViolation]
                                                              [sp:subject _:B6dba93dccac4677f2aa99a4989de07b2 ; 
                                                              sp:predicate spin:violationRoot ; 
                                                              sp:object _:Bb5038e0d68759b0c6e169aebf2cdc080]
                                                              [sp:subject _:B6dba93dccac4677f2aa99a4989de07b2 ; 
                                                              sp:predicate spin:violationPath ; 
                                                              sp:object spin:_arg3]) ; 
                                                a sp:Construct];
                                     spin:constraint [spl:valueType rdf:Property ; 
                                                      spl:predicate sp:arg1 ; 
                                                      rdfs:comment "Select property 1 of functional dependency!" ; 
                                                      a spl:Argument],
                                                     [spl:valueType xsd:string ; 
                                                      spl:predicate sp:arg2 ; 
                                                      rdfs:comment "Enter functionally dependent value 1 of property 1!"@en ; 
                                                      a spl:Argument],
                                                     [spl:valueType rdf:Property ; 
                                                      spl:predicate sp:arg3 ; 
                                                      rdfs:comment "Select property that must contain empty literal!" ; 
                                                      a spl:Argument];
                                     spin:labelTemplate "When {?arg1} has value {?arg2}, then {?arg3} has to be empty!";
                                     a spin:Template;
                                     rdfs:comment "This query returns all instances with value ?arg2 for property ?arg1 that do not have an empty literal string for property ?arg3."@en;
                                     rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:InconsistentValueRangeAll spin:body [sp:where ([sp:subject _:B4ff42f1a8032cb3dcd4e6455d0b9e66c ; 
                                                   sp:predicate spin:_arg1 ; 
                                                   sp:object _:B52ad0f8337fdd0c70f61846140a6146d]
                                                   [sp:subject _:B4ff42f1a8032cb3dcd4e6455d0b9e66c ; 
                                                   sp:predicate spin:_arg2 ; 
                                                   sp:object _:Bea08dfc8638975e8edb13495c17f482c]
                                                   [sp:expression [sp:arg2 _:Bea08dfc8638975e8edb13495c17f482c ; 
                                                                  sp:arg1 _:B52ad0f8337fdd0c70f61846140a6146d ; 
                                                                  a sp:ge] ; 
                                                   a sp:Filter]) ; 
                                         sp:text """CONSTRUCT 
  { _:c0 rdf:type spin:ConstraintViolation .
    _:c0 spin:violationRoot ?instance .
    _:c0 spin:violationPath ?arg1 .
    _:c0 spin:violationPath ?arg2 .}
WHERE
  { ?instance ?arg1 ?from .
    ?instance ?arg2 ?through
    FILTER ( ?from >= ?through )
  }""" ; 
                                         sp:templates ([sp:subject _:B9b7b27fa7696f8e8f616642c6591b073 ; 
                                                       sp:predicate rdf:type ; 
                                                       sp:object spin:ConstraintViolation]
                                                       [sp:subject _:B9b7b27fa7696f8e8f616642c6591b073 ; 
                                                       sp:predicate spin:violationRoot ; 
                                                       sp:object _:B4ff42f1a8032cb3dcd4e6455d0b9e66c]
                                                       [sp:subject _:B9b7b27fa7696f8e8f616642c6591b073 ; 
                                                       sp:predicate spin:violationPath ; 
                                                       sp:object spin:_arg1]
                                                       [sp:subject _:B9b7b27fa7696f8e8f616642c6591b073 ; 
                                                       sp:predicate spin:violationPath ; 
                                                       sp:object spin:_arg2]) ; 
                                         a sp:Construct];
                              spin:constraint [spl:valueType rdf:Property ; 
                                               spl:predicate sp:arg2 ; 
                                               rdfs:comment "Please enter the datatype property that shall hold the greater value!" ; 
                                               a spl:Argument],
                                              [spl:valueType rdf:Property ; 
                                               spl:predicate sp:arg1 ; 
                                               rdfs:comment "Please enter the datatype property that shall hold the lower value!" ; 
                                               a spl:Argument];
                              spin:labelTemplate "Value in {?arg1} cannot be greater than value of {?arg2}!";
                              a spin:Template;
                              rdfs:comment "This query flags all instances with inconsistant value ranges. Among others it is suitable for value ranges with datatypes xsd:integer, xsd:int, xsd:float, xsd:date, and xsd:dateTime. The literals must be typed."@en;
                              rdfs:label "Inconsistent value range all";
                              rdfs:subClassOf dqc:ValueRangeConstraints.
dqc:LegalValueConstraints spin:abstract true;
                          a spin:Template;
                          rdfs:comment "Legal value constraints identify values that are either not explicitly allowed or explicitly illegal."@en;
                          rdfs:label "legal value constraints"@en;
                          rdfs:subClassOf dqc:ConstraintTemplates.
dqc:LettersAll spin:body [sp:where ([sp:subject _:B043e3101ef8fae4e38161f06bc044f4e ; 
                                    sp:predicate spin:_arg1 ; 
                                    sp:object _:B6faaef1b59ac46b40d55037cecf1de4c]
                                    [sp:expression [sp:arg1 [sp:arg2 "^([A-Za-z])*$" ; 
                                                            sp:arg1 [sp:arg1 _:B6faaef1b59ac46b40d55037cecf1de4c ; 
                                                                     a sp:str] ; 
                                                            a sp:regex] ; 
                                                   a sp:not] ; 
                                    a sp:Filter]) ; 
                          sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg1 .
}
WHERE {
    ?s ?arg1 ?value .
    FILTER (!regex(str(?value), \"^([A-Za-z])*$\"^^xsd:string)) 
}""" ; 
                          sp:templates ([sp:subject _:B550c49c7359e1482c9229c4376bbe482 ; 
                                        sp:predicate rdf:type ; 
                                        sp:object spin:ConstraintViolation]
                                        [sp:subject _:B550c49c7359e1482c9229c4376bbe482 ; 
                                        sp:predicate spin:violationRoot ; 
                                        sp:object _:B043e3101ef8fae4e38161f06bc044f4e]
                                        [sp:subject _:B550c49c7359e1482c9229c4376bbe482 ; 
                                        sp:predicate spin:violationPath ; 
                                        sp:object spin:_arg1]) ; 
                          a sp:Construct];
               spin:constraint [spl:valueType rdf:Property ; 
                                spl:predicate sp:arg1 ; 
                                rdfs:comment "Select property to be tested!" ; 
                                a spl:Argument];
               spin:labelTemplate "Syntax rule: only letters allowed in {?arg1}!";
               a spin:Template;
               rdfs:comment "This query flags all instances with property ?arg1 that do not have letters as literal values. The query tolerates language tags."@en;
               rdfs:label "syntax check in all instances: only letters allowed"@en;
               rdfs:subClassOf dqc:SyntaxConstraints.
dqc:LettersAndDotsAll spin:body [sp:where ([sp:subject _:B66033c9fa1882331f443173bc3a14408 ; 
                                           sp:predicate spin:_arg1 ; 
                                           sp:object _:Bddcb3dbf2a5f3763eee7a4287d123f6f]
                                           [sp:expression [sp:arg1 [sp:arg2 "^([A-Za-z\\. ])*$" ; 
                                                                   sp:arg1 [sp:arg1 _:Bddcb3dbf2a5f3763eee7a4287d123f6f ; 
                                                                            a sp:str] ; 
                                                                   a sp:regex] ; 
                                                          a sp:not] ; 
                                           a sp:Filter]) ; 
                                 sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg1 .
}
WHERE {
    ?s ?arg1 ?value .
    FILTER (!regex(str(?value), \"^([A-Za-z\\\\. ])*$\"^^xsd:string)) 
}""" ; 
                                 sp:templates ([sp:subject _:B56eea82e97bffb041372eb7443e6f35c ; 
                                               sp:predicate rdf:type ; 
                                               sp:object spin:ConstraintViolation]
                                               [sp:subject _:B56eea82e97bffb041372eb7443e6f35c ; 
                                               sp:predicate spin:violationRoot ; 
                                               sp:object _:B66033c9fa1882331f443173bc3a14408]
                                               [sp:subject _:B56eea82e97bffb041372eb7443e6f35c ; 
                                               sp:predicate spin:violationPath ; 
                                               sp:object spin:_arg1]) ; 
                                 a sp:Construct];
                      spin:constraint [spl:valueType rdf:Property ; 
                                       spl:predicate sp:arg1 ; 
                                       rdfs:comment "Select property to be tested!" ; 
                                       a spl:Argument];
                      spin:labelTemplate "Syntax rule: only letters and dots allowed in {?arg1}!";
                      a spin:Template;
                      rdfs:comment "This query flags all instances with property ?arg1 that have characters other than letters or dots in literal values. The query tolerates language tags."@en;
                      rdfs:label "syntax check in all instances: only letters and dots allowed"@en;
                      rdfs:subClassOf dqc:SyntaxConstraints.
dqc:ListedIllegalValueAll spin:body [sp:where ([sp:subject _:Bd1f2c53750436d60dca6affe8995a763 ; 
                                               sp:predicate spin:_arg1 ; 
                                               sp:object _:B7fad0a8bf20a66d6709462e11bb6ff3c]
                                               [sp:elements ([sp:subject _:B24d252a77ca44b206d813706cbfd6a8b ; 
