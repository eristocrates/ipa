                                               [sp:subject _:Bfdd99e9800603cb05b2ecdc3ba8c50b9 ; 
                                               sp:predicate spin:violationPath ; 
                                               sp:object spin:_arg2]) ; 
                                 a sp:Construct];
                      spin:constraint [spl:valueType rdfs:Class ; 
                                       spl:predicate sp:arg1 ; 
                                       rdfs:comment "Select class that contains instances to be tested!"@en ; 
                                       a spl:Argument],
                                      [spl:valueType rdf:Property ; 
                                       spl:predicate sp:arg2 ; 
                                       rdfs:comment "Select property to be tested!"@en ; 
                                       a spl:Argument];
                      spin:labelTemplate "Property {?arg2} is mandatory but may contain empty literals for instances of class {?arg1}!";
                      a spin:Template;
                      rdfs:comment "This query returns all instances of class ?arg1 where property ?arg2 is missing. It explicitly tolerates empty literal values in property ?arg2."@en;
                      rdfs:label "Mandatory property check in instances of a class"@en;
                      rdfs:subClassOf dqc:MissingElementConstraints.
dqc:NumbersAll spin:body [sp:where ([sp:subject _:B3f0c78cbbcaa3536b44008148d992d54 ; 
                                    sp:predicate spin:_arg1 ; 
                                    sp:object _:Bff8586249213af7abdaf25a891308a4b]
                                    [sp:expression [sp:arg1 [sp:arg2 "^([0-9])*$" ; 
                                                            sp:arg1 [sp:arg1 _:Bff8586249213af7abdaf25a891308a4b ; 
                                                                     a sp:str] ; 
                                                            a sp:regex] ; 
                                                   a sp:not] ; 
                                    a sp:Filter]) ; 
                          sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg1 .
}
WHERE {
    ?s ?arg1 ?value .
    FILTER (!regex(str(?value), \"^([0-9])*$\"^^xsd:string)) 
}""" ; 
                          sp:templates ([sp:subject _:Bb53eef7784bba703ae32f3a3377c0dc0 ; 
                                        sp:predicate rdf:type ; 
                                        sp:object spin:ConstraintViolation]
