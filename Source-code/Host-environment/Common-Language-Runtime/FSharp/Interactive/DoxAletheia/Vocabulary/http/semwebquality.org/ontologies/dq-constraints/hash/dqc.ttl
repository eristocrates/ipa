                                                                                                 a xsd:int] ; 
                                                                                        sp:arg1 [sp:arg2 [sp:arg1 _:B9b6ede0a9f1e84bbc43ad54128a3bf1a ; 
                                                                                                          a xsd:int] ; 
                                                                                                 sp:arg1 [sp:arg2 [sp:arg1 _:Bb04db965e73381b5120680d42619ebdf ; 
                                                                                                                   a xsd:int] ; 
                                                                                                          sp:arg1 [sp:arg1 _:B0a272103742d760acf8d73a38efd8606 ; 
                                                                                                                   a xsd:int] ; 
                                                                                                          a sp:add] ; 
                                                                                                 a sp:add] ; 
                                                                                        a sp:add] ; 
                                                                               a sp:add] ; 
                                                                      a sp:add] ; 
                                                             a sp:mul] ; 
                                                    a sp:add] ; 
                                     a sp:Let]
                                     [sp:variable _:Bef34cb94d081537ee659a1a604c1eaf9 ; 
                                     sp:expression [sp:arg3 [sp:arg1 [sp:arg1 _:B05dbe0d60d7941e968f93c65c3cedcad ; 
                                                                      a sp:str] ; 
                                                             a fn:string-length] ; 
                                                    sp:arg2 [sp:arg2 1  ; 
                                                             sp:arg1 [sp:arg1 [sp:arg1 _:B05dbe0d60d7941e968f93c65c3cedcad ; 
                                                                               a sp:str] ; 
                                                                      a fn:string-length] ; 
                                                             a sp:sub] ; 
                                                    sp:arg1 [sp:arg1 _:B05dbe0d60d7941e968f93c65c3cedcad ; 
