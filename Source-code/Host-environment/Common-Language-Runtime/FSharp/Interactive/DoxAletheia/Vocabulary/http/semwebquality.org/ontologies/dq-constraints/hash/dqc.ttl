                           sp:text """CONSTRUCT 
  { _:c0 rdf:type spin:ConstraintViolation .
    _:c0 spin:violationRoot ?instance .
    _:c0 spin:violationPath ?arg2 .}
WHERE
  { ?instance rdf:type ?arg1 .
    ?instance ?arg2 ?ean
    LET (?1 := afn:substr(str(?ean), 0, 1))
    LET (?2 := afn:substr(str(?ean), 1, 2))
    LET (?3 := afn:substr(str(?ean), 2, 3))
    LET (?4 := afn:substr(str(?ean), 3, 4))
    LET (?5 := afn:substr(str(?ean), 4, 5))
    LET (?6 := afn:substr(str(?ean), 5, 6))
    LET (?7 := afn:substr(str(?ean), 6, 7))
    LET (?8 := afn:substr(str(?ean), 7, 8))
    LET (?9 := afn:substr(str(?ean), 8, 9))
    LET (?10 := afn:substr(str(?ean), 9, 10))
    LET (?11 := afn:substr(str(?ean), 10, 11))
    LET (?12 := afn:substr(str(?ean), 11, 12))
    LET (?13 := afn:substr(str(?ean), 12, 13))
    LET (?value := ( ( ( ( ( ( ( xsd:int(?2) + xsd:int(?4) ) + xsd:int(?6) ) + xsd:int(?8) ) + xsd:int(?10) ) + xsd:int(?12) ) * 3 ) + ( ( ( ( ( xsd:int(?1) + xsd:int(?3) ) + xsd:int(?5) ) + xsd:int(?7) ) + xsd:int(?9) ) + xsd:int(?11) ) ))
    LET (?check := afn:substr(str(?value), ( fn:string-length(str(?value)) - 1 ), fn:string-length(str(?value))))
    FILTER ( ( ( ( xsd:int(?check) + xsd:int(?13) ) != 0 ) && ( ( xsd:int(?check) + xsd:int(?13) ) != 10 ) ) || ( ! regex(str(?ean), \"^[0-9]{13}$\") ) )
  }""" ; 
                           sp:templates ([sp:subject _:B22ec42350f4ba4455f73f6bfa699324a ; 
                                         sp:predicate rdf:type ; 
                                         sp:object spin:ConstraintViolation]
                                         [sp:subject _:B22ec42350f4ba4455f73f6bfa699324a ; 
                                         sp:predicate spin:violationRoot ; 
                                         sp:object _:B610cd47b6f24ea72bafa46e6cd585076]
                                         [sp:subject _:B22ec42350f4ba4455f73f6bfa699324a ; 
                                         sp:predicate spin:violationPath ; 
                                         sp:object spin:_arg2]) ; 
                           a sp:Construct];
                spin:constraint [spl:valueType rdf:Property ; 
                                 spl:predicate sp:arg2 ; 
                                 rdfs:comment "Please enter the property holding the EAN-13!" ; 
                                 a spl:Argument],
                                [spl:valueType rdfs:Class ; 
                                 spl:predicate sp:arg1 ; 
                                 rdfs:comment "Please enter the class holding the instances that shall be tested!" ; 
                                 a spl:Argument];
                spin:labelTemplate "Incorrect EAN-13 in {?arg2} of {?arg1} class instances!";
                a spin:Template;
                rdfs:comment "This query flags wrong EAN-13 values in instances of a specified class."@en;
                rdfs:label "EAN-13 Class";
                rdfs:subClassOf dqc:SyntaxConstraints.
dqc:ExclusiveFunctionalDependencyAll spin:body [sp:where ([sp:subject _:B32ed09fc10e5ca00dc732a348a7bd40e ; 
                                                          sp:predicate spin:_arg1 ; 
                                                          sp:object spin:_arg2]
                                                          [sp:expression [sp:arg1 [sp:arg3 spin:_arg4 ; 
                                                                                  sp:arg2 spin:_arg3 ; 
                                                                                  sp:arg1 _:B32ed09fc10e5ca00dc732a348a7bd40e ; 
                                                                                  a spl:hasValue] ; 
                                                                         a sp:not] ; 
                                                          a sp:Filter]) ; 
                                                sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg3 .
}
WHERE {
    ?s ?arg1 ?arg2 .
    FILTER (!spl:hasValue(?s, ?arg3, ?arg4)) 
}""" ; 
                                                sp:templates ([sp:subject _:B492186ed07158607df7d766a06431ca5 ; 
                                                              sp:predicate rdf:type ; 
                                                              sp:object spin:ConstraintViolation]
                                                              [sp:subject _:B492186ed07158607df7d766a06431ca5 ; 
                                                              sp:predicate spin:violationRoot ; 
                                                              sp:object _:B32ed09fc10e5ca00dc732a348a7bd40e]
                                                              [sp:subject _:B492186ed07158607df7d766a06431ca5 ; 
                                                              sp:predicate spin:violationPath ; 
                                                              sp:object spin:_arg3]) ; 
                                                a sp:Construct];
                                     spin:constraint [spl:valueType rdf:Property ; 
                                                      spl:predicate sp:arg1 ; 
                                                      rdfs:comment "Select property 1 of functional dependency!" ; 
                                                      a spl:Argument],
                                                     [spl:valueType xsd:string ; 
                                                      spl:predicate sp:arg2 ; 
                                                      rdfs:comment "Enter functionally dependent value 1 of property 1!" ; 
                                                      a spl:Argument],
                                                     [spl:valueType xsd:string ; 
                                                      spl:predicate sp:arg4 ; 
                                                      rdfs:comment "Enter functionally dependent value 2 of property 2!" ; 
                                                      a spl:Argument],
                                                     [spl:valueType rdf:Property ; 
                                                      spl:predicate sp:arg3 ; 
                                                      rdfs:comment "Select property 2 of functional dependency!" ; 
                                                      a spl:Argument];
                                     spin:labelTemplate """Value \"{?arg2}\" of {?arg1} must only have value \"{?arg4}\" in {?arg3} in all instances!""";
                                     a spin:Template;
                                     rdfs:comment "This query flags instances with property ?arg1 and value ?arg2 that do not have value ?arg4 with property ?arg3. It is only suitable for value dependencies with one to one cardinality. The query does not tolerate homonyms and is not restricted to a specific class."@en;
                                     rdfs:label "exclusive functional dependency check in all instances"@en;
                                     rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:ExclusiveFunctionalDependencyClass spin:body [sp:where ([sp:subject spin:_this ; 
                                                            sp:predicate rdf:type ; 
                                                            sp:object spin:_arg1]
                                                            [sp:subject spin:_this ; 
                                                            sp:predicate spin:_arg2 ; 
                                                            sp:object spin:_arg3]
                                                            [sp:expression [sp:arg1 [sp:arg3 spin:_arg5 ; 
                                                                                    sp:arg2 spin:_arg4 ; 
                                                                                    sp:arg1 spin:_this ; 
                                                                                    a spl:hasValue] ; 
                                                                           a sp:not] ; 
                                                            a sp:Filter]) ; 
                                                  sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?this .
    _:b0 spin:violationPath ?arg4 .
}
WHERE {
    ?this a ?arg1 .
    ?this ?arg2 ?arg3 .
    FILTER (!spl:hasValue(?this, ?arg4, ?arg5)) 
}""" ; 
                                                  sp:templates ([sp:subject _:Bfd0a354d8f72a7770407f86916bfa6bd ; 
                                                                sp:predicate rdf:type ; 
                                                                sp:object spin:ConstraintViolation]
                                                                [sp:subject _:Bfd0a354d8f72a7770407f86916bfa6bd ; 
                                                                sp:predicate spin:violationRoot ; 
                                                                sp:object spin:_this]
                                                                [sp:subject _:Bfd0a354d8f72a7770407f86916bfa6bd ; 
                                                                sp:predicate spin:violationPath ; 
                                                                sp:object spin:_arg4]) ; 
                                                  a sp:Construct];
                                       spin:constraint [spl:valueType rdfs:Class ; 
                                                        spl:predicate sp:arg1 ; 
                                                        rdfs:comment "Select class that holds instances to be tested!" ; 
                                                        a spl:Argument],
                                                       [spl:valueType xsd:string ; 
                                                        spl:predicate sp:arg5 ; 
                                                        rdfs:comment "Enter functionally dependent value 2 of property 2!" ; 
                                                        a spl:Argument],
                                                       [spl:valueType xsd:string ; 
                                                        spl:predicate sp:arg3 ; 
                                                        rdfs:comment "Enter functionally dependent value 1 of property 1!" ; 
                                                        a spl:Argument],
                                                       [spl:valueType rdf:Property ; 
                                                        spl:predicate sp:arg2 ; 
                                                        rdfs:comment "Select property 1 of functional dependency!" ; 
                                                        a spl:Argument],
                                                       [spl:valueType rdf:Property ; 
                                                        spl:predicate sp:arg4 ; 
                                                        rdfs:comment "Select property 2 of functional dependency!" ; 
                                                        a spl:Argument];
                                       spin:labelTemplate """Value \"{?arg3}\" of {?arg2} must only have value \"{?arg5}\" in {?arg4} in instances of class {?arg1}!""";
                                       a spin:Template;
                                       rdfs:comment "This query flags instances of class ?arg1 with property ?arg2 and value ?arg3 that do not have value ?arg5 with property ?arg4. It is only suitable for value dependencies with one to one cardinality. The query does not tolerate homonyms. Not defined dependencies will not be flagged."@en;
                                       rdfs:label "exclusive functional dependency check in class instances"@en;
                                       rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:FiveDigitNumericAll spin:body [sp:where ([sp:subject _:B86a3acb6379d00fd2afb2543b422b210 ; 
                                             sp:predicate spin:_arg1 ; 
                                             sp:object _:B9b6c15f52f1558e81f130fc5a23ae2c2]
                                             [sp:expression [sp:arg1 [sp:arg2 "^[0-9]{5}$" ; 
                                                                     sp:arg1 [sp:arg1 _:B9b6c15f52f1558e81f130fc5a23ae2c2 ; 
                                                                              a sp:str] ; 
                                                                     a sp:regex] ; 
                                                            a sp:not] ; 
                                             a sp:Filter]) ; 
                                   sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg1 .
}
WHERE {
    ?s ?arg1 ?value .
    FILTER (!regex(str(?value), \"^[0-9]{5}$\"^^xsd:string)) 
}""" ; 
                                   sp:templates ([sp:subject _:B705685fb1b271d16c0e3436907c1465a ; 
                                                 sp:predicate rdf:type ; 
                                                 sp:object spin:ConstraintViolation]
                                                 [sp:subject _:B705685fb1b271d16c0e3436907c1465a ; 
                                                 sp:predicate spin:violationRoot ; 
                                                 sp:object _:B86a3acb6379d00fd2afb2543b422b210]
                                                 [sp:subject _:B705685fb1b271d16c0e3436907c1465a ; 
                                                 sp:predicate spin:violationPath ; 
                                                 sp:object spin:_arg1]) ; 
                                   a sp:Construct];
                        spin:constraint [spl:valueType rdf:Property ; 
                                         spl:predicate sp:arg1 ; 
                                         rdfs:comment "Select the property that contains the US zip codes!" ; 
                                         a spl:Argument];
                        spin:labelTemplate "Syntax rule: {?arg1} must contain 5-digit numeric value in all instances!";
                        a spin:Template;
                        rdfs:comment "This query flags all instances that do not have a five digit numeric value for property ?arg1."@en;
                        rdfs:label "syntax check in all instances:  5 digit numeric values"@en;
                        rdfs:subClassOf dqc:SyntaxConstraints.
dqc:FunctionalDependencyConstraints spin:abstract true;
                                    a spin:Template;
                                    rdfs:comment "Functional dependencies are dependencies between the values of two or more different properties. Functional dependency constraints check the abidance of functional dependencies."@en;
                                    rdfs:label "functional dependency constraints"@en;
                                    rdfs:subClassOf dqc:ConstraintTemplates.
dqc:FunctionalDependencyTrustedReferenceAll spin:body [sp:where ([sp:elements ([sp:subject _:B24cf648d189177477feeba0f82de0348 ; 
                                                                              sp:predicate spin:_arg1 ; 
                                                                              sp:object _:B893f1d7b05b13c5a77321722ba192f05]
                                                                              [sp:elements ([sp:subject _:B24cf648d189177477feeba0f82de0348 ; 
                                                                                           sp:predicate spin:_arg2 ; 
                                                                                           sp:object _:B2363f0fb0f18a9b5059b53fb8a52a9a4]) ; 
                                                                              a sp:Optional]) ; 
                                                                 a sp:Optional]
                                                                 [sp:elements ([sp:subject _:Bf80821a67af396689fb0e7b8fbd9d446 ; 
                                                                              sp:predicate rdf:type ; 
                                                                              sp:object spin:_arg3]
                                                                              [sp:subject _:Bf80821a67af396689fb0e7b8fbd9d446 ; 
                                                                              sp:predicate spin:_arg4 ; 
                                                                              sp:object _:B893f1d7b05b13c5a77321722ba192f05]
                                                                              [sp:subject _:Bf80821a67af396689fb0e7b8fbd9d446 ; 
                                                                              sp:predicate spin:_arg5 ; 
                                                                              sp:object _:B2363f0fb0f18a9b5059b53fb8a52a9a4]) ; 
                                                                 a sp:NotExists]) ; 
                                                       sp:text """CONSTRUCT {
    _:b0 a spin:ConstraintViolation .
    _:b0 spin:violationRoot ?s .
    _:b0 spin:violationPath ?arg1 .
    _:b0 spin:violationPath ?arg2 .
}
WHERE {
    OPTIONAL {
        ?s ?arg1 ?value1 .
        OPTIONAL {
            ?s ?arg2 ?value2 .
        } 
    } 
    NOT EXISTS {
        ?s2 a ?arg3 .
        ?s2 ?arg4 ?value1 .
        ?s2 ?arg5 ?value2 .
    } 
}""" ; 
                                                       sp:templates ([sp:subject _:Bca882624b004366408fb0629afd972b8 ; 
                                                                     sp:predicate rdf:type ; 
                                                                     sp:object spin:ConstraintViolation]
                                                                     [sp:subject _:Bca882624b004366408fb0629afd972b8 ; 
                                                                     sp:predicate spin:violationRoot ; 
                                                                     sp:object _:B24cf648d189177477feeba0f82de0348]
                                                                     [sp:subject _:Bca882624b004366408fb0629afd972b8 ; 
                                                                     sp:predicate spin:violationPath ; 
                                                                     sp:object spin:_arg1]
                                                                     [sp:subject _:Bca882624b004366408fb0629afd972b8 ; 
                                                                     sp:predicate spin:violationPath ; 
                                                                     sp:object spin:_arg2]) ; 
                                                       a sp:Construct];
                                            spin:constraint [spl:valueType rdfs:Class ; 
                                                             spl:predicate sp:arg3 ; 
                                                             rdfs:comment "Select class of trusted reference that holds instances with legal value combinations!" ; 
                                                             a spl:Argument],
                                                            [spl:valueType rdf:Property ; 
                                                             spl:predicate sp:arg2 ; 
                                                             rdfs:comment "Select property 2 of functional dependency!" ; 
                                                             a spl:Argument],
                                                            [spl:valueType rdf:Property ; 
                                                             spl:predicate sp:arg1 ; 
                                                             rdfs:comment "Select property 1 of functional dependency!" ; 
                                                             a spl:Argument],
                                                            [spl:valueType rdf:Property ; 
                                                             spl:predicate sp:arg5 ; 
                                                             rdfs:comment "Select second property of trusted reference that holds legal values for property 2!" ; 
                                                             a spl:Argument],
                                                            [spl:valueType rdf:Property ; 
                                                             spl:predicate sp:arg4 ; 
                                                             rdfs:comment "Select first property of trusted reference that holds legal values for property 1!" ; 
                                                             a spl:Argument];
                                            spin:labelTemplate "Value combinations of properties {?arg1} and {?arg2} must always be identical with value combinations of properties {?arg4} and {?arg5} in class {?arg3} for all instances!";
                                            a spin:Template;
                                            rdfs:comment "This query flags instances with properties ?arg1 and ?arg2 that do not have a corresponding value combination in instances of the trusted reference in class ?arg3. The semantics of property ?arg1 should be equal with property ?arg4, and the semantics of property ?arg2 should be equal with ?arg5. The query tolerates homonymous values, i.e. the same value may be assigned to different dependent values by using different instances in the trusted reference. Value combinations that cannot be found in the trusted reference will also be flagged as incorrect. The query will also test the existence of a single value in the trusted reference when one property of the tested data is missing."@en;
                                            rdfs:label "Functional dependency check in all instances with trusted reference"@en;
                                            rdfs:subClassOf dqc:FunctionalDependencyConstraints.
dqc:FunctionalDependencyTrustedReferenceClass spin:body [sp:where ([sp:subject _:B79fb3d9f71795320d6484efe7056adbe ; 
                                                                   sp:predicate rdf:type ; 
                                                                   sp:object spin:_arg1]
                                                                   [sp:elements ([sp:subject _:B79fb3d9f71795320d6484efe7056adbe ; 
