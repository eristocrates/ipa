<http://purl.org/dc/terms/created> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/creator> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/modified> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://purl.org/dc/terms/title> a <http://www.w3.org/2002/07/owl#AnnotationProperty>.
<http://w3id.org/charta77/jup> <http://creativecommons.org/ns#license> <http://opendatacommons.org/licenses/odbl/1.0/>;
                               <http://purl.org/dc/terms/created> "2014-07-01"^^xsd:date;
                               <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/mbox> "petr.hazuza@bariery.cz" ; 
                                                                   <http://xmlns.com/foaf/0.1/firstName> "Petr" ; 
                                                                   <http://xmlns.com/foaf/0.1/familyName> "Hazuza"];
                               <http://purl.org/dc/terms/description> "The vocabulary of building accessibility was created within the project Maps without Barriers realized under Charta 77 Foundation – Barriers Account. It is based on the Object Accessibility Categorization Methodology, however, it is completed with entities arising from the needs of the project. This vocabulary is also part of a diploma thesis entitled Ontology of Building Accessibility. The project is co-financed from resources provided by the European Union and European Regional Development Fund."@en,
                                                                      "Slovnik prisupnosti budov vznikl v ramci projektu Mapy bez barier, ktery realizuje Nadace Charty 77 - Konto Bariery. Vychazi z Metodiky kategorizace pristupnosti objektu, je vsak doplnen i o entity vyplyvajici z pozadavku projektu. Tento slovnik je i tematem diplomove prace Ontologie pristupnosti budov. Projekt je spolufinancovan z prostredku Evropske unie, Evropskeho fondu pro regionalni rozvoj."@cs;
                               <http://purl.org/dc/terms/issued> "2016-02-18"^^xsd:date;
                               <http://purl.org/dc/terms/modified> "2016-07-14"^^xsd:date;
                               <http://purl.org/dc/terms/title> "Slovnik pristupnosti budov"@cs,
                                                                "Ontology of Building Accessibility"@en;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "jup";
                               a <http://www.w3.org/2002/07/owl#Ontology>,
                                 <http://purl.org/vocommons/voaf#Vocabulary>;
                               rdfs:seeAlso <https://mapybezbarier.cz/download/turtle/mapybezbarier.ttl.zip>,
                                            <http://rdf.pth.name/data.ttl>,
                                            <http://rdf.pth.name/example.ttl>,
                                            <http://www.presbariery.cz/prilohy/metodika-metodika-kategorizace-pristupnosti-objektu.pdf>,
                                            <http://lod.mapybezbarier.cz/sparql>,
                                            <http://www.mapybezbarier.cz/>;
                               <http://www.w3.org/2002/07/owl#versionInfo> "2.0".
jup:AOB jup:hasForm jup:ElevatorMKPOForm,
                    jup:ObjectMKPOForm;
        jup:seeAlso <http://www.dinasys.cz/en/products-profiles/acoustic-guiding-beacons.html>,
                    <http://bariery.centrumpronevidome.cz/bariery/akusticke.htm>;
        rdfs:label "Acoustic orientation beacon"@en,
                   "Akusticky orientacni majacek"@cs;
        rdfs:subClassOf jup:PhysicalEntity,
                        jup:MappableEntity.
jup:AOBAnnouncement a rdfs:Class;
