                                      "Schema typu hlaseni AOB"@cs.
jup:AccessibleObjectMKPO a jup:ObjectCategorizationMKPO,
                           skos:Concept;
                         rdfs:isDefinedBy <http://www.presbariery.cz/prilohy/metodika_kategorizace_pristupnosti.pdf>;
                         skos:inScheme jup:ObjectCategorizationsMKPOScheme;
                         skos:prefLabel "Accessible object as compliant with Object Accessibility Categorization Methodology"@en,
                                        "Pristupny objekt podle Metodiky Kategorizace Pristupnosti Objektu"@cs.
