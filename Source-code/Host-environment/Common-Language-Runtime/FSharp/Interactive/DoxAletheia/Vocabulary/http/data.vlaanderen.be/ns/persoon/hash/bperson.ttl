bperson:Afstamming vann:usageNote "De afstamming kan ook niet-biologisch zijn, bv adoptie. Afstamming kan ook in opgaande lijn worden bekeken. Het begrip is enger dan verwantschap dat oa ook huwelijk inhoudt."@nl;
                   a owl:Class;
                   rdfs:comment "Afstamming is de dalende lijn van bloedverwantschap tussen verschillende generaties."@nl;
                   rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                   rdfs:label "Afstamming"@nl;
                   rdfs:subClassOf bperson:Persoonsrelatie.
bperson:BurgerlijkeStaat vann:usageNote "Slaat op huwelijk, partnerregistratie, afstamming, voogdij etc. Is maw de toestand van bepaalde verhoudingen tussen personen."@nl;
                         a owl:Class;
                         rdfs:comment "Burgerrechtelijke toestand van een persoon."@nl;
                         rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                         rdfs:label "Burgerlijke Staat"@nl.
bperson:Domicilie vann:usageNote "Plaats waar de persoon het grootste deel vd tijd verblijft binnen de jurisdictie waarvan hij Inwoner is. Dit wordt doorgaans officieel vastgesteld en geregistreerd ih bevolkingsregister. Kan in praktijk verschillend vd feitelijke verblijfplaats."@nl;
                  a owl:Class;
                  rdfs:comment "Hoofdverblijfplaats ve persoon."@nl;
                  rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                  rdfs:label "Domicilie"@nl;
                  rdfs:subClassOf bperson:Verblijfplaats.
bperson:Geboorte vann:usageNote " "@nl;
                 a owl:Class;
                 rdfs:comment "Het ter wereld komen vd persoon."@nl;
                 rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                 rdfs:label "Geboorte"@nl;
                 rdfs:subClassOf bperson:Persoonsgebeurtenis;
                 owl:equivalentClass bio:Birth.
bperson:GeenInwoner vann:usageNote "Plaats of land wordt hier vertegenwoordigd door de entiteit jurisdictie."@nl;
                    a owl:Class;
                    rdfs:comment "Persoon die niet in een bepaalde plaats of land woont."@nl;
                    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                    rdfs:label "Geen Inwoner"@nl;
                    rdfs:subClassOf bperson:Inwonerschap.
bperson:GeregistreerdPersoon vann:usageNote "Doorgaans is dit register een bevolkingsregister maar het kan bv ook een kiesregister zijn. De ingeschreven gegevens hebben betrekking op de identeit (vb naam en voornaam) en de Verblijfplaats vd persoon en op belangrijke levensgebeurtenissen zoals geboorte, huwelijk, overlijden etc. Deze gegevens worden typisch geregistreerd door de overheid, ze bieden de ingeschreven persoon wettelijke bescherming en laten de overheid toe om basisstatistieken op te stellen over zijn bevolking."@nl;
                             a owl:Class;
                             rdfs:comment "Persoon waarvan de gegevens zijn ingeschreven in een register."@nl;
                             rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                             rdfs:label "Geregistreerd Persoon"@nl;
                             rdfs:subClassOf person:Person.
bperson:Gezin vann:usageNote "Ruimer begrip dan familie waar het gezin louter bestaat uit nabije bloedverwanten, bv een enpersoonsgezin of living apart together. Gezinsleden hebben doorgaans dezelfde Verblijfplaats."@nl;
              a owl:Class;
              rdfs:comment "Samenwerkingsvorm die een herkenbare sociale eenheid vormt (bv tgv huwelijk), met al dan niet verwante personen die duurzame banden hebben en elkaar onderling steun en verzorging verlenen."@nl;
              rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
              rdfs:label "Gezin"@nl;
              rdfs:subClassOf org:Organization.
bperson:Gezinsrelatie vann:usageNote "Bv echtgenoot, zoon, schoonmoeder."@nl;
                      a owl:Class;
                      rdfs:comment "Relatie tussen leden van eenzelfde gezin."@nl;
                      rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                      rdfs:label "Gezinsrelatie"@nl;
                      rdfs:subClassOf bperson:Persoonsrelatie.
bperson:Huwelijk vann:usageNote "Kan, net als bv samenwonen, de basis vormen van een gezin."@nl;
                 a owl:Class;
                 rdfs:comment "Een door burgerlijk of religieus recht geregelde samenlevingsvorm van twee personen."@nl;
                 rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                 rdfs:label "Huwelijk"@nl;
                 rdfs:subClassOf bperson:Persoonsrelatie.
bperson:Inwoner vann:usageNote "Plaats of land wordt hier vertegenwoordigd door de entiteit jurisdictie."@nl;
                a owl:Class;
                rdfs:comment "Persoon die in een bepaalde plaats of land woont."@nl;
                rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                rdfs:label "Inwoner"@nl;
                rdfs:subClassOf bperson:Inwonerschap.
bperson:Inwonerschap vann:usageNote " "@nl;
                     a owl:Class;
                     rdfs:comment "Het feit dat een persoon verblijf houdt in een plaats of land."@nl;
                     rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                     rdfs:label "Inwonerschap"@nl.
bperson:Inwonerschap.binnenJurisdictie vann:usageNote " "@nl;
                                       a owl:ObjectProperty;
                                       rdfs:comment "Jurisdictie waarbinnen het inwonerschap (ve persoon) is gedefineerd."@nl;
                                       rdfs:domain bperson:Inwonerschap;
                                       rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                                       rdfs:label "binnen jurisdictie"@nl;
                                       rdfs:range dcterms:Jurisdiction.
bperson:Nationaliteit vann:usageNote "Merk op dat dit begrip ruimer is dan staatsburgerschap (dat zich beperkt tot de relatie met een staat). Wie de nationaliteit ve bepaald land heeft is er doorgaans ook automatisch staatsburger van. Nationaliteit wordt doorgaans autamatisch verkregen door geboorte: men krijgt hetzij de nationaliteit van zijn ouders of men krijgt deze vh land waar men Inwoner van is. Men kan een bepaalde nationaliteit ook verkrijgen door naturalisatie. In principe verliest men dan zijn oorspronkelijke nationaliteit, maar dat is niet altijd zo (meervoudige nationaliteit)."@nl;
                      a owl:Class;
                      rdfs:comment "De relatie tussen een persoon en een staat, cultuur of loyaliteit."@nl;
                      rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                      rdfs:label "Nationaliteit"@nl.
bperson:Overlijden vann:usageNote " "@nl;
                   a owl:Class;
                   rdfs:comment "Het doodgaan vd Persoon."@nl;
                   rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                   rdfs:label "Overlijden"@nl;
                   rdfs:subClassOf bperson:Persoonsgebeurtenis;
                   owl:equivalentClass bio:Death.
bperson:PermanentInwoner vann:usageNote "Is een verblijfsrecht dat in principe officieel moet worden toegekend als de persoon geen staatsburger is."@nl;
                         a owl:Class;
                         rdfs:comment "Persoon die permanent in een bepaalde plaats of land woont."@nl;
                         rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                         rdfs:label "Permanent Inwoner"@nl;
                         rdfs:subClassOf bperson:Inwoner.
bperson:Persoonsgebeurtenis vann:usageNote " "@nl;
                            a owl:Class;
                            rdfs:comment "Belangrijke gebeurtenis ih leven ve persoon."@nl;
                            rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                            rdfs:label "Persoonsgebeurtenis"@nl.
bperson:Persoonsrelatie vann:usageNote "Typisch zijn dit burgerrechtelijke relaties (zie burgerlijke staat) maar niet noodzakelijk daartoe beperkt."@nl;
                        a owl:Class;
                        rdfs:comment "Relatie tussen twee of meer personen."@nl;
                        rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                        rdfs:label "Persoonsrelatie"@nl.
bperson:Samenwonen vann:usageNote "Kan, net als bv een huwelijk, de basis vormen van een gezin."@nl;
                   a owl:Class;
                   rdfs:comment "Regeling waarbij twee personen die niet getrouwd zijn samenleven."@nl;
                   rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                   rdfs:label "Samenwonen"@nl;
                   rdfs:subClassOf bperson:Persoonsrelatie.
bperson:Staatsburger vann:usageNote " "@nl;
                     a owl:Class;
                     rdfs:comment "Persoon die juridisch verbonden is met een staat."@nl;
                     rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                     rdfs:label "Staatsburger"@nl;
                     rdfs:subClassOf bperson:Staatsburgerschap.
bperson:Staatsburgerschap vann:usageNote "Vloeit meestal voort uit de nationaliteit ve persoon. De rechten en plichten waarvan sprake zijn burgerrechten (vb godsdienstvrijheid) of van politieke (vb stemrecht) of sociale aard (bv recht op een uitkering).  "@nl;
                          a owl:Class;
                          rdfs:comment "Juridische band ve persoon met een staat, waaraan bepaalde rechten en plichten verbonden zijn"@nl;
                          rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                          rdfs:label "Staatburgerschap"@nl.
bperson:Staatsburgerschap.binnenJurisdictie vann:usageNote " "@nl;
                                            a owl:ObjectProperty;
                                            rdfs:comment "Jurisdictie waarbinnen het staatsburgerschap (ve persoon) is gedefineerd."@nl;
                                            rdfs:domain bperson:Staatsburgerschap;
                                            rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                                            rdfs:label "binnen jurisdictie"@nl;
                                            rdfs:range dcterms:Jurisdiction.
bperson:TijdelijkInwoner vann:usageNote "Is een verblijfsrecht dat in principe enkel wordt toegekend omwille ve zeer specifieke reden bv werken of studeren. Exclusief personen met kort verblijf, bv als toerist."@nl;
                         a owl:Class;
                         rdfs:comment "Persoon die tijdelijk in een plaats of land woont."@nl;
                         rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                         rdfs:label "Tijdelijk Inwoner"@nl;
                         rdfs:subClassOf bperson:Inwoner.
bperson:Verblijfplaats vann:usageNote " "@nl;
                       a owl:Class;
                       rdfs:comment "Plaats waar een persoon al dan niet tijdelijk woont of logeert."@nl;
                       rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                       rdfs:label "Verblijfplaats"@nl.
bperson:Voogdij vann:usageNote "Dit is bv het geval voor minderjarigen die hun ouders zijn verloren of voor meerderjarigen die hun verstandelijke vermogens zijn verloren."@nl;
                a owl:Class;
                rdfs:comment "Situatie waarbij een persoon die optreedt als voogd ve ander persoon en in die hoedanigheid instaat voor deze persoon en zijn goederen."@nl;
                rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                rdfs:label "Voogdij"@nl;
                rdfs:subClassOf bperson:Persoonsrelatie.
bperson:Vreemdeling vann:usageNote "Daardoor kan de persoon geen staatsburger worden genoemd. In praktijk geniet de Vreemdeling als Inwoner een subset vd burgerrechten die een Staatsbutger wel heeft. Bv wel godsdienstvrijheid maar geen stemrecht."@nl;
                    a owl:Class;
                    rdfs:comment "Persoon die niet de nationaliteit bezit vh land waar hij verblijft."@nl;
                    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                    rdfs:label "Vreemdeling"@nl;
                    rdfs:subClassOf bperson:Staatsburgerschap.
bperson:afstammingsType vann:usageNote "Bv geadopteerd, kind uit huwelijk, erkend door de vader etc."@nl;
                        a owl:ObjectProperty;
                        rdfs:comment "Aard vd afstamming."@nl;
                        rdfs:domain bperson:Afstamming;
                        rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                        rdfs:label "afstammingstype"@nl;
                        rdfs:range skos:Concept.
bperson:datum vann:usageNote " "@nl;
