                 rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                 rdfs:label "geslacht"@nl;
                 rdfs:range skos:Concept.
bperson:gezinsadres vann:usageNote "Dikwijls een criterium om te bepalen of personen deel uitmaken van eenzelfde gezin."@nl;
                    a owl:ObjectProperty;
                    rdfs:comment "Verblijfplaats vh gezin."@nl;
