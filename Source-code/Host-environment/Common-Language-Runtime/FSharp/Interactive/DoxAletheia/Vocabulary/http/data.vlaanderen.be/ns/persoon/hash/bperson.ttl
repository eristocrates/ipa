                    rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                    rdfs:label "gezinsadres"@nl;
                    rdfs:range locn:Address.
bperson:gezinsrelatietype vann:usageNote "Wordt typisch bepaald tov het gezinshoofd. Bv als de vader gezinshoofd is en een gezinslid is zoon, dan zou als de grootvader gezinshoofd was datzelfde gezinslid kleinzoon zijn."@nl;
                          a owl:ObjectProperty;
                          rdfs:comment "Aard vd relatie."@nl;
                          rdfs:domain bperson:Gezinsrelatie;
                          rdfs:isDefinedBy <http://data.vlaanderen.be/ns/persoon>;
                          rdfs:label "gezinsrelatietype"@nl;
                          rdfs:range skos:Concept.
bperson:heeftBurgerlijkeStaat vann:usageNote " "@nl;
