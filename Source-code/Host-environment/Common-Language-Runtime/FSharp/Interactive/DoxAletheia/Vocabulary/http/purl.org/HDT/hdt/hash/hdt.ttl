hdt:Dataset dcterms:description "HDT Dataset"@en-us;
            dcterms:issued "2010-10-03";
            dcterms:modified "2010-10-03";
            a rdfs:Class;
            rdfs:subClassOf <http://rdfs.org/ns/void#Dataset>.
