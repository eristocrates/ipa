@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfa: <http://www.w3.org/ns/rdfa#>.

<http://www.ivan-herman.net/foaf#me> a <http://xmlns.com/foaf/0.1/Person>;
                                     rdfs:seeAlso <http://www.ivan-herman.net/foaf>;
                                     <http://xmlns.com/foaf/0.1/mbox> <mailto:ivan@w3.org>;
                                     <http://xmlns.com/foaf/0.1/name> "Ivan Herman";
                                     <http://xmlns.com/foaf/0.1/title> "Semantic Web Activity Lead";
                                     <http://xmlns.com/foaf/0.1/workplaceHomepage> <http://www.w3.org/>.
rdfa: <http://purl.org/dc/terms/creator> <http://www.ivan-herman.net/foaf#me>;
      <http://purl.org/dc/terms/date> "2013-01-18";
      <http://purl.org/dc/terms/description> "This document describes the RDFa Vocabulary for Term and Prefix Assignment. The Vocabulary is used to modify RDFa 1.1 processing behavior.";
      <http://purl.org/dc/terms/publisher> <http://www.w3.org/data#W3C>;
      <http://purl.org/dc/terms/title> "RDFa Vocabulary for Term and Prefix Assignment, and for Processor Graph Reporting";
      a <http://www.w3.org/2002/07/owl#Ontology>;
      rdfs:isDefinedBy <http://www.w3.org/TR/rdfa-core/#s_initialcontexts>;
      <http://www.w3.org/2002/07/owl#versionInfo> "$Date: 2013-03-11 07:54:23 $".
rdfa:DocumentError <http://purl.org/dc/terms/description> "error condition; to be used when the document fails to be fully processed as a result of non-conformant host language markup";
                   rdfs:subClassOf rdfa:Error.
rdfa:Error <http://purl.org/dc/terms/description> "is the class for all error conditions";
           rdfs:subClassOf rdfa:PGClass.
rdfa:Info <http://purl.org/dc/terms/description> "is the class for all informations";
          rdfs:subClassOf rdfa:PGClass.
rdfa:PGClass <http://purl.org/dc/terms/description> "is the top level class of the hierarchy";
             a <http://www.w3.org/2002/07/owl#Class>,
               rdfs:Class.
rdfa:Pattern <http://purl.org/dc/terms/description> "Class to identify an (RDF) resource whose properties are to be copied to another resource";
             a <http://www.w3.org/2002/07/owl#Class>,
               rdfs:Class.
rdfa:PrefixMapping <http://purl.org/dc/terms/description> "is the class for prefix mappings";
                   rdfs:subClassOf rdfa:PrefixOrTermMapping.
rdfa:PrefixOrTermMapping <http://purl.org/dc/terms/description> "is the top level class for prefix or term mappings";
                         a <http://www.w3.org/2002/07/owl#Class>,
                           rdfs:Class.
rdfa:PrefixRedefinition <http://purl.org/dc/terms/description> "warning; to be used when a prefix, either from the initial context or inherited from an ancestor node, is redefined in an element";
                        rdfs:subClassOf rdfa:Warning.
rdfa:TermMapping <http://purl.org/dc/terms/description> "is the class for term mappings";
                 rdfs:subClassOf rdfa:PrefixOrTermMapping.
rdfa:UnresolvedCURIE <http://purl.org/dc/terms/description> "warning; to be used when a CURIE prefix fails to be resolved";
                     rdfs:subClassOf rdfa:Warning.
rdfa:UnresolvedTerm <http://purl.org/dc/terms/description> "warning; to be used when a Term fails to be resolved";
                    rdfs:subClassOf rdfa:Warning.
rdfa:VocabReferenceError <http://purl.org/dc/terms/description> "warning; to be used when the value of a @vocab attribute cannot be dereferenced, hence the vocabulary expansion cannot be completed";
                         rdfs:subClassOf rdfa:Warning.
rdfa:Warning <http://purl.org/dc/terms/description> "is the class for all warnings";
             rdfs:subClassOf rdfa:PGClass.
rdfa:context <http://purl.org/dc/terms/description> "provides extra context for the error, eg, http response, an XPointer/XPath information, or simply the URI that created the error";
             a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               rdf:Property;
             rdfs:domain rdfa:PGClass.
rdfa:copy <http://purl.org/dc/terms/description> "identifies the resource (i.e., pattern) whose properties and values should be copied to replace the current triple (retaining the subject of the triple).";
          a <http://www.w3.org/2002/07/owl#ObjectProperty>,
            rdf:Property.
rdfa:prefix <http://purl.org/dc/terms/description> "defines a prefix mapping for a URI; the value is supposed to be a NMTOKEN";
            a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
              rdf:Property;
            rdfs:domain rdfa:PrefixMapping.
rdfa:term <http://purl.org/dc/terms/description> "defines a term mapping for a URI; the value is supposed to be a NMTOKEN";
          a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
            rdf:Property;
          rdfs:domain rdfa:TermMapping.
rdfa:uri <http://purl.org/dc/terms/description> "defines the URI for either a prefix or a term mapping; the value is supposed to be an absolute URI";
         a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
           rdf:Property;
         rdfs:domain rdfa:PrefixOrTermMapping.
rdfa:usesVocabulary <http://purl.org/dc/terms/description> """provides a relationship between the host document and a vocabulary
	defined using the @vocab facility of RDFa1.1""";
                    a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                      rdf:Property.
rdfa:vocabulary <http://purl.org/dc/terms/description> "defines an absolute URI to be used as a default vocabulary; the value is can be any string; for documentation purposes it is advised to use the string 'true' or 'True'.";
                a <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                  rdf:Property.
