@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ccsla: <http://cookingbigdata.com/linkeddata/ccsla#>.

ccsla: <http://purl.org/dc/terms/created> "2018-03-06"^^xsd:date;
       <http://purl.org/dc/terms/creator> ccsla:manuelparra;
       <http://purl.org/dc/terms/description> "Service Level Agreement for Cloud Computing Services. This ontology allows to define model of SLA/SLO used in large cloud computing providers such as Amazon, Azure, etc., including terms, claims, credit, compensations, etc"@en;
       <http://purl.org/dc/terms/issued> "2018-05-20"^^xsd:date;
       <http://purl.org/dc/terms/modified> "2018-04-03"^^xsd:date;
       <http://purl.org/dc/terms/publisher> ccsla:cookingbigdata;
       <http://purl.org/dc/terms/rights> "Copyright © 2018 Manuel Parra-Royón";
       <http://purl.org/dc/terms/title> "SLA and SLO for Cloud Computing Services"@en;
       a <http://www.w3.org/2002/07/owl#Ontology>;
       rdfs:label "Service Level Agreement for Cloud Computing"@en;
       <http://www.w3.org/2002/07/owl#versionInfo> 1.0;
       <https://creativecommons.org/ns#licence> <https://creativecommons.org/licenses/by/3.0/>.
ccsla:Claim a <http://www.w3.org/2002/07/owl#Class>,
              rdfs:Class;
            rdfs:comment "Claims of the agreement license"@en;
            rdfs:isDefinedBy ccsla:Claim;
            rdfs:label "Claims of the agreement"@en;
            rdfs:subClassOf ccsla:Term.
ccsla:Condition a <http://www.w3.org/2002/07/owl#Class>,
                  rdfs:Class;
                rdfs:comment "Conditions and levels of the agreement and compensation"@en;
                rdfs:isDefinedBy ccsla:Condition;
                rdfs:label "Conditions of compensation"@en.
ccsla:Definition a <http://www.w3.org/2002/07/owl#Class>,
                   rdfs:Class;
                 rdfs:comment "Definitions of the agreement license used in terms"@en;
                 rdfs:isDefinedBy ccsla:Definition;
                 rdfs:label "Definitions of the agreement"@en.
ccsla:Limitation a <http://www.w3.org/2002/07/owl#Class>,
                   rdfs:Class;
                 rdfs:comment "Limitations and Exclusions of the agreement license considering Compensations"@en;
                 rdfs:isDefinedBy ccsla:Limitation;
                 rdfs:label "Limitations of the agreement"@en;
                 rdfs:subClassOf ccsla:Term.
ccsla:SLA a <http://www.w3.org/2002/07/owl#Class>,
            rdfs:Class;
          rdfs:comment "SLA Main Class"@en;
          rdfs:isDefinedBy ccsla:SLA;
          rdfs:label "SLA Class"@en.
ccsla:ServiceCredit a <http://www.w3.org/2002/07/owl#Class>,
                      rdfs:Class;
                    rdfs:comment "ServiceCredits of the agreement license considering Compensations terms"@en;
                    rdfs:isDefinedBy ccsla:ServiceCredit;
                    rdfs:label "ServiceCredits of the agreement"@en;
                    rdfs:subClassOf ccsla:Term.
ccsla:Term a <http://www.w3.org/2002/07/owl#Class>,
             rdfs:Class;
           rdfs:comment "Term of the SLA"@en;
           rdfs:isDefinedBy ccsla:Term;
           rdfs:label "Term of the agreement"@en.
ccsla:containsTerm a rdf:Property;
                   rdfs:comment "SLA contains Terms of the agreement"@en;
                   rdfs:domain ccsla:SLA;
                   rdfs:isDefinedBy ccsla:containsTerm;
                   rdfs:label "SLA Contains"@en;
                   rdfs:range ccsla:Term.
ccsla:cookingbigdata a <http://xmlns.com/foaf/0.1/Organization>;
                     rdfs:seeAlso <http://cookingbigdata.com/about>;
                     <http://xmlns.com/foaf/0.1/homepage> <http://cookingbigdata.com/>;
                     <http://xmlns.com/foaf/0.1/name> "CookingBigData".
ccsla:hasCompensation a rdf:Property;
                      rdfs:comment "Term Compensation of the agreement"@en;
                      rdfs:domain ccsla:Term;
                      rdfs:isDefinedBy ccsla:hasCompensation;
                      rdfs:label "Term Compensation"@en;
                      rdfs:range ccsla:Condition.
ccsla:hasDefinitionValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Definition values of an agreement term."@en;
                         rdfs:domain ccsla:Definition;
                         rdfs:label "Definition values"@en;
                         rdfs:range <http://schema.org/structuredValue>.
ccsla:hasTermValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Definition values of an agreement term."@en;
                   rdfs:domain ccsla:Definition;
                   rdfs:label "Terms values"@en;
                   rdfs:range <http://schema.org/structuredValue>.
ccsla:hasValidity a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Validity interval of an agreement term."@en;
                  rdfs:domain ccsla:SLA;
                  rdfs:label "Validity interval"@en;
                  rdfs:range <http://www.w3.org/2006/time#Interval>.
ccsla:includeDefs a rdf:Property;
                  rdfs:comment "Include definitions"@en;
                  rdfs:domain ccsla:Term;
                  rdfs:isDefinedBy ccsla:includeDefs;
                  rdfs:label "Include Defs"@en;
                  rdfs:range ccsla:Definition.
ccsla:includeValue a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Values of the condition"@en;
                   rdfs:domain ccsla:Condition;
                   rdfs:isDefinedBy ccsla:includeValue;
                   rdfs:label "With values"@en;
                   rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (<http://purl.org/goodrelations/v1#QuantitativeValue>
                                                                        <http://purl.org/goodrelations/v1#QualitativeValue>) ; 
                               a <http://www.w3.org/2002/07/owl#Class>].
ccsla:manuelparra a <http://xmlns.com/foaf/0.1/Person>;
                  rdfs:seeAlso <https://twitter.com/manugrapevine>;
                  <http://xmlns.com/foaf/0.1/homepage> <https://twitter.com/manugrapevine>;
                  <http://xmlns.com/foaf/0.1/mbox> "manuparra@gmail.com";
                  <http://xmlns.com/foaf/0.1/name> "Manuel Parra-Royon".
