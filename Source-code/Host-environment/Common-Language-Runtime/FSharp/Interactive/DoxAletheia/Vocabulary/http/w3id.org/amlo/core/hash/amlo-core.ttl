@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix amlo-core: <http://w3id.org/amlo/core#>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.

[] owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger.
dc11:contributor a owl:AnnotationProperty.
dc11:creator a owl:AnnotationProperty.
dc11:date a owl:AnnotationProperty.
dc11:description a owl:AnnotationProperty.
dc11:rights a owl:AnnotationProperty.
dc11:title a owl:AnnotationProperty.
dcterms:license a owl:AnnotationProperty.
<http://w3id.org/amlo/core> dc11:creator "Andrea Danielli",
                                         "Enrico Fagnoni";
                            dc11:date "2020-01-01";
                            dc11:description <https://gitlab.com/mopso/amlo/raw/master/core/uml.png>,
                                             """The AMLO-core is the main module of the AMLO projects that extends the Financial Industry Business Ontology (FIBO) with some concepts to describe the Anti Money Laundering (AML) knowledge and facts.

AMLO-core can be used as an upper ontology to derive taxonomies and axioms as well as a way to exchange information among investigators."""@en;
                            dc11:rights "The amlo-core  vocabulary was developed by developed by  Enrico Fagnoni and Andrea Danielli in the scope of AMLO project Copyright (c) by 2019-2020 by LinkedDataCenter and it is available under the Creative Commons Attribution 4.0.  This work is an extension of the FIBO ontology Copyright (c) by 2014-2019 EDM Council, Inc. and Object Management Group, Inc."@en;
                            dc11:title "Anti Money Laundering Ontology core vocabulary  (AMLO-core)"@en;
                            dcterms:license <http://creativecommons.org/licenses/by/4.0/>;
                            a owl:Ontology;
                            rdfs:comment """AMLO-core is a formal conceptual model that defines the main terms used in Anti Money Laundering (AML) investigations. 

AMLO-core  is developed by a multidisciplinary group of domain experts and data scientists as part of the AMLO project hosted by LinkedData.Center."""@en;
                            rdfs:label "AMLO-core vocabulary"@en;
                            rdfs:seeAlso <https://linkeddata.center/>,
                                         <https://gitlab.com/mopso/amlo>;
                            owl:versionIRI <https://gitlab.com/mopso/amlo/raw/master/core/core.rdf#ontology>;
                            owl:versionInfo "dev-1.0.1".
amlo-core:Accountable a owl:Class;
                      rdfs:comment "identifica un agente come   responsabile di una operatività inattesa"@it;
                      rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ResponsibleParty>,
                                      <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole>.
amlo-core:Analyst a owl:Class;
                  rdfs:comment "identifica un agente preposto alla valutazione di una operatività inattesa"@it;
                  rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ResponsibleParty>,
                                  <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingIssuer>,
                                  <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingParty>,
                                  <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole>.
amlo-core:Book a owl:Class;
               rdfs:comment "identifica un qualsiasi registro usato per annotare record"@it;
               rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/hasIdentity> ; 
                                owl:onClass [owl:someValuesFrom <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/Record> ; 
                                             owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/comprises> ; 
                                             a owl:Restriction] ; 
                                a owl:Restriction],
                               <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Roles/ThingInRole>.
amlo-core:Cash a owl:Class;
               rdfs:comment "un ammotare di denaro in banconote o monete"@it;
               rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/AmountOfMoney>.
amlo-core:Gender a owl:Class;
                 rdfs:comment "A person Gender";
                 rdfs:label "".
amlo-core:IntangibleAsset a owl:Class;
                          rdfs:comment "qualsiasi bene intangibile che non sia denaro o immobili"@it.
amlo-core:OriginatorBook a owl:Class;
                         rdfs:comment "identifica un registro  (es. libro mastro) usato  usato per annotare un trasferimento  da parte dell'ordinate"@it;
                         rdfs:subClassOf amlo-core:Book.
amlo-core:OriginatorParty a owl:Class;
                          rdfs:comment "identifica  un agente che ordina un trasferimento"@it;
                          rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole>.
amlo-core:Reasoner a owl:Class;
                   rdfs:comment "identifica un un agente che ragionando su dati esistenti inferisce nuove informazioni"@it;
                   rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole>.
amlo-core:RecipientBook a owl:Class;
                        rdfs:comment "identifica un registro  (es. libro mastro) usato  usato per annotare un trasferimento  dala parte del ricevente"@it;
                        rdfs:subClassOf amlo-core:Book.
amlo-core:RecipientParty a owl:Class;
                         rdfs:comment "identifica un agente  come destinatario di un trasferimento"@it;
                         rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole>.
amlo-core:RiskEstimator a rdfs:Datatype;
                        rdfs:comment "un valore probabilistico che esclude certezze"@it;
                        owl:equivalentClass [owl:withRestrictions ([xsd:minInclusive 0 ]
                                                                   [xsd:maxInclusive 1 ]) ; 
                                             owl:onDatatype xsd:decimal ; 
                                             a rdfs:Datatype].
amlo-core:RiskEvaluation a owl:Class;
                         rdfs:comment "un opinione espressa su un rischio"@it;
                         rdfs:subClassOf [owl:someValuesFrom owl:Thing ; 
                                          owl:onProperty amlo-core:assessedOn ; 
                                          a owl:Restriction],
                                         [owl:someValuesFrom skos:Concept ; 
                                          owl:onProperty amlo-core:onRiskFactor ; 
                                          a owl:Restriction],
                                         <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Opinion>.
amlo-core:RiskRating a owl:Class;
                     rdfs:comment "una stima di un  fattore di rischio associato a qualcosa"@it;
                     rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                      owl:onProperty amlo-core:hasRiskEstimator ; 
                                      owl:onDataRange amlo-core:RiskEstimator ; 
                                      a owl:Restriction],
                                     amlo-core:RiskEvaluation.
amlo-core:RiskSizing a owl:Class;
                     rdfs:comment "un dimensionamento del rischio basato su una o più quantità misurabili associato a qualcosa"@it;
                     rdfs:subClassOf amlo-core:RiskEvaluation.
amlo-core:SuspectRating a owl:Class;
                        rdfs:comment "rappresenta l'esito di un’attività di investigazione su una operatività inattesa  finalizzata a valutarne il grado di sospetto"@it;
                        rdfs:subClassOf [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                         owl:onProperty amlo-core:hasSuspectRatingScore ; 
                                         owl:onClass amlo-core:SuspectRatingScore ; 
                                         a owl:Restriction],
                                        <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/Rating>.
amlo-core:SuspectRatingScore a owl:Class;
                             rdfs:comment "definisce qualitativamente il grado di sospetto che grava su qualcosa"@it;
                             rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/QualitativeRatingScore>.
amlo-core:Transfer a owl:Class;
                   rdfs:comment "un trasferimento di denaro o di un altro valore che coinvolge un ordinate, un ricevente e eventuali registri su cui è annotato il trasferimento"@it;
                   rdfs:subClassOf [owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/involves> ; 
                                    owl:onClass amlo-core:Book ; 
                                    owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    owl:onProperty amlo-core:transfers ; 
                                    owl:onClass [owl:unionOf (amlo-core:IntangibleAsset
                                                              <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/AmountOfMoney>
                                                              <https://spec.edmcouncil.org/fibo/ontology/FND/Places/Locations/RealEstate>
                                                              <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good>) ; 
                                                 a owl:Class] ; 
                                    a owl:Restriction],
                                   [owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasPartyInRole> ; 
                                    owl:onClass amlo-core:OriginatorParty ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   [owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasPartyInRole> ; 
                                    owl:onClass amlo-core:RecipientParty ; 
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                    a owl:Restriction],
                                   <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence>.
amlo-core:UnexpectedActivity a owl:Class;
                             rdfs:comment "evidenzia un insieme di movimenti, eventi o azioni non usuali che sono attribuiti ad un agente"@it;
                             rdfs:subClassOf [owl:someValuesFrom amlo-core:Accountable ; 
                                              owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasPartyInRole> ; 
                                              a owl:Restriction],
                                             <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/Record>.
amlo-core:UnexpectedActivityReport a owl:Class;
                                   rdfs:comment "un documento che riporta una operatività inattesa da segnalare ad un agente preposto alla sua valutazione"@it;
                                   rdfs:subClassOf [owl:someValuesFrom amlo-core:UnexpectedActivity ; 
                                                    owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/reportsOn> ; 
                                                    a owl:Restriction],
                                                   [owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; 
                                                    owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/isReportedTo> ; 
                                                    owl:onClass amlo-core:Analyst ; 
                                                    a owl:Restriction],
                                                   <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentReport>.
amlo-core:assessedOn a owl:ObjectProperty;
                     rdfs:comment "si riferisce all'oggetto di una valutazione"@it;
                     owl:inverseOf amlo-core:hasEvaluation.
amlo-core:detects a owl:ObjectProperty;
                  rdfs:comment "rileva una operatività inattesa"@it;
                  rdfs:range amlo-core:UnexpectedActivity;
                  owl:inverseOf amlo-core:isDetectedBy.
amlo-core:female a owl:NamedIndividual,
                   amlo-core:Gender;
                 rdfs:comment "a female person"@en.
amlo-core:hasEvaluation a owl:ObjectProperty;
                        rdfs:comment "collega un soggetto ad una valutazione"@it.
amlo-core:hasGender a owl:ObjectProperty,
                      owl:FunctionalProperty;
                    rdfs:domain <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person>;
                    rdfs:range amlo-core:Gender.
amlo-core:hasRiskEstimator a owl:DatatypeProperty;
                           rdfs:comment "un valore copreso tra 0 e 1 che rappresenta lo stimatore di un rischio"@it;
                           rdfs:range amlo-core:RiskEstimator.
amlo-core:hasSizeEstimator a owl:ObjectProperty;
                           rdfs:comment "collega una stima quantitativa ad un rischio"@it.
amlo-core:hasSuspectRatingScore a owl:ObjectProperty;
                                rdfs:comment "collega un valore qualitativo espresso su un rischio"@it;
                                rdfs:range amlo-core:SuspectRatingScore;
                                rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/hasRatingScore>.
amlo-core:isDetectedBy a owl:ObjectProperty;
                       rdfs:comment "è rilevata da une evento di ricerca operatività sospetta"@it;
                       rdfs:domain amlo-core:UnexpectedActivity.
amlo-core:isRecordedIn a owl:ObjectProperty;
                       rdfs:comment "identifica un libro utilizzato per registrare un trasferimento"@it;
                       rdfs:domain amlo-core:Transfer.
amlo-core:male a owl:NamedIndividual,
                 amlo-core:Gender;
               rdfs:comment "a male person"@en.
amlo-core:not-enough-data a owl:NamedIndividual,
                            amlo-core:SuspectRatingScore;
                          rdfs:comment "valutazione non effettuata per mancanza di dati"@it.
amlo-core:not-suspicious a owl:NamedIndividual,
                           amlo-core:SuspectRatingScore;
                         rdfs:comment "il soggetto annotato non è sospetto"@it.
amlo-core:onRiskFactor a owl:ObjectProperty;
                       rdfs:comment "collega qualcosa ald un concetto di rischio astratto"@it;
                       rdfs:range skos:Concept.
amlo-core:suspect-codes a owl:NamedIndividual,
                          <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Codes/CodeSet>;
                        rdfs:comment "definisce i possibili gradi di sospetto"@it.
amlo-core:suspect-rating-scale a owl:NamedIndividual,
                                 <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingScale>;
                               rdfs:comment "la scala di gradazione  gradazione del sospetto"@it.
amlo-core:suspicious a owl:NamedIndividual,
                       amlo-core:SuspectRatingScore;
                     rdfs:comment "il soggetto annotato è sospetto"@it.
amlo-core:to-be-ignored a owl:NamedIndividual,
                          amlo-core:SuspectRatingScore;
                        rdfs:comment "il grado di sospetto non è valutato perchè una direttiva impedisce esplicitamente la valutazione del soggetto"@it.
amlo-core:transfers a owl:ObjectProperty;
                    rdfs:comment "trasferisce qualcosa"@it;
                    rdfs:domain amlo-core:Transfer;
                    rdfs:range owl:Thing.
amlo-core:unexpected a owl:NamedIndividual,
                       amlo-core:SuspectRatingScore;
                     rdfs:comment "il soggetto è potenzialmente sospetto a causa della presenza di indici di anomalia o altri elementi di attenzione"@it.
owl:qualifiedCardinality a owl:AnnotationProperty.
skos:Concept a owl:Class.
skos:definition a owl:AnnotationProperty.
<https://spec.edmcouncil.org/fibo/ontology/BE/FunctionalEntities/FunctionalEntities/FunctionalEntity> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/BE/OwnershipAndControl/Executives/ResponsibleParty> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Bank> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccount> a owl:Class;
                                                                                                   owl:equivalentClass [owl:intersectionOf (<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/Account>
                                                                                                                                            [owl:someValuesFrom <https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccountIdentifier> ; 
                                                                                                                                            owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/Agents/isIdentifiedBy> ; 
                                                                                                                                            a owl:Restriction]
                                                                                                                                            [owl:someValuesFrom <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Bank> ; 
                                                                                                                                            owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasPartyInRole> ; 
                                                                                                                                            a owl:Restriction]
                                                                                                                                            [owl:someValuesFrom <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/Bank> ; 
                                                                                                                                            owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/isProvidedBy> ; 
                                                                                                                                            a owl:Restriction]) ; 
                                                                                                                        a owl:Class].
<https://spec.edmcouncil.org/fibo/ontology/FBC/ProductsAndServices/ClientsAndAccounts/BankAccountIdentifier> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/AmountOfMoney> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/Agents/isIdentifiedBy> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/AgentsAndPeople/People/Person> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentActivity> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/AssessmentReport> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Assessments/Opinion> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Codes/CodeSet> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/Record> a owl:Class;
                                                                              rdfs:subClassOf [owl:someValuesFrom <https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Documents/Record> ; 
                                                                                               owl:onProperty <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/comprises> ; 
                                                                                               a owl:Restriction].
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/QualitativeRatingScore> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/QuantitativeRatingScore> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/Rating> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingIssuer> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingParty> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/RatingScale> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Ratings/hasRatingScore> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/isReportedTo> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Arrangements/Reporting/reportsOn> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/FinancialDates/CombinedDateTime> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/Occurrence> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/PartyInRole> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Parties/hasPartyInRole> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Parties/Roles/ThingInRole> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Places/Locations/RealEstate> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/Good> a owl:Class.
<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/comprises> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/hasIdentity> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/involves> a owl:ObjectProperty.
<https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/isProvidedBy> a owl:ObjectProperty.
