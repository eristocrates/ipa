                                                                                       <http://www.commit-nl.nl/people/morsey>;
                                         <http://purl.org/dc/elements/1.1/creator> <http://alex.willner.ws/about#me>;
                                         <http://purl.org/dc/elements/1.1/description> <http://raw.githubusercontent.com/open-multinet/playground-rspecs-ontology/master/ontologies/pics/omn.png>,
                                                                                       "This ontology defines the most abstract concepts and properties that are needed to semantically manage resource within federated infrastructures."@en;
                                         <http://purl.org/dc/elements/1.1/publisher> <http://open-multinet.org/>;
                                         <http://purl.org/dc/elements/1.1/rights> <http://creativecommons.org/licenses/by/4.0/>;
                                         <http://purl.org/dc/elements/1.1/title> "Open-Multinet Upper Ontology"@en;
                                         <http://purl.org/dc/terms/created> "2014-11-11"^^xsd:date;
                                         <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/>;
                                         <http://purl.org/dc/terms/modified> "2015-04-04"^^xsd:date;
                                         <http://purl.org/vocab/vann/preferredNamespacePrefix> "omn";
                                         <http://purl.org/vocab/vann/preferredNamespaceUri> omn:;
                                         a <http://www.w3.org/2002/07/owl#Ontology>,
                                           <http://purl.org/vocommons/voaf#Vocabulary>;
                                         rdfs:comment "This ontology defines the most abstract concepts and properties that are needed to semantically manage resource within federated infrastructures."@en;
                                         rdfs:label "omn"@en;
                                         <http://www.w3.org/2002/07/owl#versionInfo> "2015-04-04".
omn:Attribute a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "Examples: Monitoring information, Color attributes, Reservation information, QoS, SLAs, Location, Configuration, ..."@en,
                           "Describes the attributes of an omn:Group, omn:Resource, omn:Service or omn:Component in more detail"@en;
              rdfs:label "Attribute"@en;
              rdfs:seeAlso <http://schemas.ogf.org/nml/2013/05/base#Location>,
                           <http://geni-orca.renci.org/owl/app-color.owl#ColorAttribute>.
omn:Component a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An Entity that is part of an omn:Resource or omn:Service. It does not need to be an omn:Resource or an omn:Service itself."@en,
                           "Examples: CPU, Sensor, Core, Port, Image"@en;
              rdfs:label "Component"@en;
              rdfs:seeAlso <http://schema.org/partOfSystem>,
                           <http://www.ontologydesignpatterns.org/cp/owl/move.owl#formsPartOf>,
                           <http://purl.org/dc/terms/isPartOf>.
omn:Dependency a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:comment "Helps to defines a directional relationship between omn:Resource, omn:Group, omn:Component or omn:Service. It makes it possible to annotate the dependencies with additional properties."@en,
                            "Examples: application coloring (in GENI context), orchestration needs dependencies"@en;
               rdfs:label "Dependency"@en;
               rdfs:seeAlso <http://www.science.uva.nl/research/sne/indl#implements>,
                            <http://geni-orca.renci.org/owl/app-color.owl#ColorAttribute>,
                            <http://fp7-novi.eu/im.owl#implements>.
omn:Environment a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "The operating conditions under which a omn:Resource, omn:Group, omn:Service is operating."@en,
                             "Examples: interference, concurrent virtual machines, concurrent traffic, temperature, heat, ..."@en;
                rdfs:label "Environment"@en;
                rdfs:seeAlso <http://schema.org/Place>.
omn:Group a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "A collection of omn:Resource, omn:Service or omn:Group"@en,
                       "Examples: Bi-directional Link, ..."@en;
          rdfs:label "Group"@en;
          rdfs:seeAlso <http://schemas.ogf.org/nml/2013/05/base#Group>,
                       <http://geni-orca.renci.org/owl/collections.owl#Collection>,
                       <http://fp7-novi.eu/im.owl#Group>.
omn:Layer a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Examples: In networking, an end-to-end connectivity has to be on the same layer (path finding). For resources, it can describe the capability to adapt to a virtualized version"@en,
                       "Describes a place within a hierarchy a specific omn:Group, omn:Resource, omn:Service or omn:Component can adapt to."@en;
          rdfs:label "Layer"@en;
          rdfs:seeAlso <http://www.science.uva.nl/research/sne/indl#VirtualNode>,
                       <http://schemas.ogf.org/nml/2013/05/base#AdaptationService>.
omn:Reservation a <http://www.w3.org/2002/07/owl#Class>;
                rdfs:comment "Examples: (Earliest) Start and (lates) end time, data volume, ..."@en,
                             "A specification of a guarantee"@en;
                rdfs:label "Reservation"@en;
                rdfs:seeAlso <http://www.w3.org/2006/time#Interval>.
omn:Resource a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "An Entity that can be provisioned/controlled/measured by APIs"@en,
                          "Examples: Node, Link, People, ..."@en;
             rdfs:label "Resource"@en;
             rdfs:seeAlso <http://schemas.ogf.org/nml/2013/05/base#Node>,
                          <http://fp7-novi.eu/im.owl#Node>.
omn:Service a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "Examples: Aggregate Manager, Portal, Measurement Service, Hadoop, Broker, ..."@en,
                         "An Entity that has an API/capability to use it, it may depend on an omn:Resource"@en;
            rdfs:label "Service"@en;
            rdfs:seeAlso <http://schemas.ogf.org/nml/2013/05/base#Service>,
                         <http://fp7-novi.eu/im.owl#Service>,
                         <http://purl.org/goodrelations/v1#ProductOrService>,
                         <http://purl.org/ontology/service#Service>,
                         <http://purl.org/dc/dcmitype/Service>,
                         <http://schema.org/Service>.
omn:Topology a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "A collection of omn:Resource, omn:Service or omn:Group"@en,
                          "Examples: Infrastructure, Reservation, Slice, ..."@en;
             rdfs:label "Topology"@en;
             rdfs:subClassOf omn:Group.
omn:adaptableFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "determines the resource from which this resource can be adapted from - e.g. from an Ethernet to a FDDI port."@en;
                  rdfs:domain omn:Layer;
                  rdfs:label "adaptable from"@en;
                  rdfs:range omn:Layer;
                  <http://www.w3.org/2002/07/owl#inverseOf> omn:adaptableTo.
omn:adaptableTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "determines to which resource this resource can adapts to - e.g. from an Ethernet to a FDDI port."@en;
                rdfs:domain omn:Layer;
                rdfs:label "adaptable to"@en;
                rdfs:range omn:Layer;
                <http://www.w3.org/2002/07/owl#inverseOf> omn:adaptableFrom.
omn:adaptsFrom a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
               rdfs:comment "determines from which resource this resource adapts - e.g. from an Ethernet to a FDDI port."@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                     omn:Group
                                                                     omn:Resource
                                                                     omn:Service) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "adapts from"@en;
               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                    omn:Group
                                                                    omn:Resource
                                                                    omn:Service) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
               <http://www.w3.org/2002/07/owl#inverseOf> omn:adaptsTo.
omn:adaptsTo a <http://www.w3.org/2002/07/owl#ObjectProperty>,
               <http://www.w3.org/2002/07/owl#IrreflexiveProperty>;
             rdfs:comment "determines to which resource this resource adapts - e.g. from an Ethernet to a FDDI port."@en;
             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                   omn:Group
                                                                   omn:Resource
                                                                   omn:Service) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
             rdfs:label "adapts to"@en;
             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                  omn:Group
                                                                  omn:Resource
                                                                  omn:Service) ; 
                         a <http://www.w3.org/2002/07/owl#Class>];
             <http://www.w3.org/2002/07/owl#inverseOf> omn:adaptsFrom.
omn:dependsOn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "claims dependency"@en;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                    omn:Group
                                                                    omn:Resource
                                                                    omn:Service) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "depends on"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                   omn:Group
                                                                   omn:Resource
                                                                   omn:Service) ; 
                          a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:subPropertyOf omn:relatesTo.
omn:fromDependency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "claims dependency"@en;
                   rdfs:domain omn:Dependency;
                   rdfs:label "from dependency"@en;
                   rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                        omn:Group
                                                                        omn:Resource
                                                                        omn:Service) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                   <http://www.w3.org/2002/07/owl#inverseOf> omn:toDependency.
omn:hasAttribute a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "link to a general attribute of the resource - e.g. to a ReadOnly class"@en;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                       omn:Group
                                                                       omn:Resource
                                                                       omn:Service) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "has attribute"@en;
                 rdfs:range omn:Attribute;
                 <http://www.w3.org/2002/07/owl#inverseOf> omn:isAttributeOf.
omn:hasComponent a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "component of the resource - e.g. a CPU"@en;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                       omn:Resource
                                                                       omn:Service) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "has component"@en;
                 rdfs:range omn:Component;
                 rdfs:seeAlso <http://fp7-novi.eu/im.owl#hasComponent>;
                 <http://www.w3.org/2002/07/owl#inverseOf> omn:isComponentOf.
omn:hasEndpoint a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                  <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The URL of the API of a service"@en;
                rdfs:domain omn:Service;
                rdfs:label "has endpoint"@en;
                rdfs:range xsd:anyURI.
omn:hasGroup a <http://www.w3.org/2002/07/owl#ObjectProperty>;
             rdfs:comment "a group that is related to this resource - e.g. a reserved topology within an infrastructure"@en;
             rdfs:domain omn:Group;
             rdfs:label "has group"@en;
             rdfs:range omn:Group;
             <http://www.w3.org/2002/07/owl#inverseOf> omn:isGroupOf.
omn:hasReservation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "the reservation details of a resource - e.g. an immediate reservation for 3 hours"@en;
                   rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Group
                                                                         omn:Resource
                                                                         omn:Service) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                   rdfs:label "has reservation"@en;
                   rdfs:range omn:Reservation.
omn:hasResource a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "a resource that this resource contains - e.g. a node within a reserved topology"@en;
                rdfs:domain omn:Group;
                rdfs:label "has resource"@en;
                rdfs:range omn:Resource;
                rdfs:seeAlso <http://fp7-novi.eu/im.owl#contains>;
                <http://www.w3.org/2002/07/owl#inverseOf> omn:isResourceOf.
omn:hasService a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "a service that this resource contains - e.g. a Hadoop instance within a reserved topology"@en;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Group
                                                                     omn:Resource
                                                                     omn:Service) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "has service"@en;
               rdfs:range omn:Service.
omn:isAttributeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain omn:Attribute;
                  rdfs:label "is attribute of"@en;
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                       omn:Group
                                                                       omn:Resource
                                                                       omn:Service) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  <http://www.w3.org/2002/07/owl#inverseOf> omn:hasAttribute.
omn:isComponentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain omn:Component;
                  rdfs:label "is component of"@en;
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                       omn:Resource
                                                                       omn:Service) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  <http://www.w3.org/2002/07/owl#inverseOf> omn:hasComponent.
omn:isGroupOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:domain omn:Group;
              rdfs:label "is group of"@en;
              rdfs:range omn:Group.
omn:isReadonly a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                 <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "information/attribute that is not writable"@en;
               rdfs:domain omn:Attribute;
               rdfs:label "is read only"@en;
               rdfs:range xsd:boolean.
omn:isReservationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:domain omn:Reservation;
                    rdfs:label "is reservation of"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Group
                                                                         omn:Resource
                                                                         omn:Service) ; 
                                a <http://www.w3.org/2002/07/owl#Class>];
                    <http://www.w3.org/2002/07/owl#inverseOf> omn:hasReservation.
omn:isResourceOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain omn:Resource;
                 rdfs:label "is resource of"@en;
                 rdfs:range omn:Group;
                 rdfs:seeAlso <http://fp7-novi.eu/im.owl#contains>.
omn:isServiceOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain omn:Service;
                rdfs:label "is service of"@en;
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Group
                                                                     omn:Resource
                                                                     omn:Service) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:seeAlso <http://purl.org/ontology/service#providedBy>;
                <http://www.w3.org/2002/07/owl#inverseOf> omn:hasService.
omn:relatesTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "claims a general dependency"@en;
              rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                    omn:Group
                                                                    omn:Resource
                                                                    omn:Service) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
              rdfs:label "relates to"@en;
              rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                   omn:Group
                                                                   omn:Resource
                                                                   omn:Service) ; 
                          a <http://www.w3.org/2002/07/owl#Class>].
omn:toDependency a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                       omn:Group
                                                                       omn:Resource
                                                                       omn:Service) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "to dependency"@en;
                 rdfs:range omn:Dependency.
omn:withinEnvironment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (omn:Component
                                                                            omn:Group
                                                                            omn:Resource
                                                                            omn:Service) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "within environment"@en;
                      rdfs:range omn:Environment.
<http://www.w3.org/2002/07/owl#AllDisjointClasses> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#IrreflexiveProperty> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2002/07/owl#NamedIndividual> a <http://www.w3.org/2002/07/owl#Class>.
<http://www.w3.org/2006/time#Interval> rdfs:subClassOf omn:Reservation.
