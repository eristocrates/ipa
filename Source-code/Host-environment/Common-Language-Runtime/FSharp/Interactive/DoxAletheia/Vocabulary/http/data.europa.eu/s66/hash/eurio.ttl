                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:startDate ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#Project>.
eurio:ProjectDeliverable a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A document referring to the results obtained during the development of a project."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Project Deliverable"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:description ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:hasResultType ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         eurio:Result;
                         <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/ProjectReportDocument>.
eurio:ProjectPublication a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A scientific publication (e.g., journal article, conference paper, thesis dissertation, book, etc.) that resulted from the project activities."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Project Publication"@en;
                         rdfs:subClassOf eurio:Result,
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:journalNumber ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:publisher ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:publishedYear ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:journalTitle ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:author ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>],
                                         [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:publishedPages ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/Expression>.
eurio:ProjectReportSummary a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "A document reporting on the progress of an on-going or completed project at a given period.."@en;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "Project Report Summary"@en;
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> eurio:startDate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> eurio:abstract ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           eurio:Result,
                                           [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> eurio:endDate ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> eurio:finalResults ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> eurio:workPerformed ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>];
                           <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/ProjectReportSummary>.
eurio:PublicBody a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Organisation or agency depending on a government, State or other supranational organisation and mainly operated by the government."@en;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "Public Body"@en;
                 rdfs:subClassOf eurio:Organisation;
                 <http://www.w3.org/2004/02/skos/core#closeMatch> <https://w3id.org/dingo#GovernamentalOrganisation>,
                                                                  <http://purl.org/cerif/frapo/NotForProfitOrganization>.
eurio:ResearchOrganisation a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:comment "Organisations devoted to research activities."@en;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "Research Organisation"@en;
                           rdfs:subClassOf eurio:Organisation;
                           <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#ResearchPerformingOrganisation>.
eurio:Result a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:comment "Any tangible or intangible output of the project (such as data, knowledge and information, whatever their form or nature, whether or not they can be protected), which are generated in the project."@en;
             rdfs:isDefinedBy eurio:;
             rdfs:label "Result"@en;
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                              <http://www.w3.org/2002/07/owl#onProperty> eurio:title ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                              <http://www.w3.org/2002/07/owl#onProperty> eurio:language ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                              <http://www.w3.org/2002/07/owl#onProperty> eurio:url ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>].
eurio:Role a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "The function assumed by or ascribed to an entity (typically an organisation) in a particular project. It can be used to precise or represent additional information about a relationship or property such as participation or membership. In CORDIS, it represents the participation of an organisation in a research project."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Role"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:startDate ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:roleLabel ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:endDate ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:isInvolvedIn ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#Role>.
eurio:SME a <http://www.w3.org/2002/07/owl#Class>;
          rdfs:comment "Small and Medium Enterprises."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "SME"@en;
          rdfs:subClassOf eurio:Organisation;
          <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/cerif/frapo/SME>.
eurio:Site a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "The physical extension of entities that participate in or form part of research projects."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Site"@en;
           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:name ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:hasAddress ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:hasCoordinates ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:hasGeographicalLocation ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>],
                           [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                            <http://www.w3.org/2002/07/owl#onProperty> eurio:isSiteOf ; 
                            a <http://www.w3.org/2002/07/owl#Restriction>];
           <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/ns/org#Site>.
eurio:ThesisDissertation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "A book authored by a student containing a formal presentations of research outputs submitted for examination in completion of a course of study at an institution of higher education, to fulfil the requirements for an academic degree. Also know as a dissertation."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Thesis Dissertation"@en;
                         rdfs:subClassOf eurio:ProjectPublication;
                         <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/Thesis>.
eurio:TitleAcronym a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An acronym explicitly defined as the title or name of another entity (e.g. Project, Organisation, Funding Scheme, etc.)."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Title Acronym"@en;
                   rdfs:subClassOf eurio:Acronym.
eurio:abstract a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The general summary and ideas of a CORDIS entity, e.g., project, result."@en;
               rdfs:isDefinedBy eurio:;
               rdfs:label "abstract"@en;
               rdfs:range xsd:string.
eurio:addressCountry a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The country of the place or address. You can also provide the two-letter ISO 3166-1 alpha-2 country code."@en;
                     rdfs:domain eurio:PostalAddress;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "address country"@en;
                     rdfs:range xsd:string.
eurio:addressLocality a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The locality, town or city of the place or address."@en;
                      rdfs:domain eurio:PostalAddress;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "address locality"@en;
                      rdfs:range xsd:string.
eurio:author a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
             rdfs:comment "The list of authors."@en;
             rdfs:isDefinedBy eurio:;
             rdfs:label "author"@en;
             rdfs:range xsd:string.
eurio:code a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "A CORDA code."@en;
           rdfs:domain eurio:FundingScheme;
           rdfs:isDefinedBy eurio:;
           rdfs:label "code"@en;
           rdfs:range xsd:string.
eurio:currency a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The currency in which the monetary amount is expressed."@en;
               rdfs:domain eurio:MonetaryAmount;
               rdfs:isDefinedBy eurio:;
               rdfs:label "currency"@en;
               rdfs:range xsd:string.
eurio:date a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The date in which the grant payment took place."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "date"@en;
           rdfs:range xsd:date.
eurio:definition a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The definition of the acronym."@en;
                 rdfs:domain eurio:Acronym;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "definition"@en;
                 rdfs:range xsd:string.
eurio:description a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "A brief summary of the entity (project, etc.)."@en;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "description"@en;
                  rdfs:range xsd:string.
eurio:disburses a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates the funding agency to the grant(s) that it disburses."@en;
                rdfs:domain eurio:FundingAgency;
                rdfs:isDefinedBy eurio:;
                rdfs:label "disburses"@en;
                rdfs:range eurio:Grant;
                <http://www.w3.org/2002/07/owl#inverseOf> eurio:isDisbursedBy.
eurio:doi a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "The digital object identifier of a publication."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "doi"@en;
          rdfs:range xsd:anyURI.
eurio:duration a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The period of time an entity (e.g. project, grant, etc.) has taken, represented as number of months."@en;
               rdfs:isDefinedBy eurio:;
               rdfs:label "duration"@en;
               rdfs:range xsd:nonNegativeInteger.
eurio:endDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "The date on which an entity (e.g. project, grant, etc.) is finalized or ceases to exist."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "end date"@en;
              rdfs:range xsd:date;
              rdfs:subPropertyOf eurio:date.
eurio:finalResults a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "A brief description of the project findings."@en;
                   rdfs:domain eurio:ProjectReportSummary;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "final results"@en;
                   rdfs:range xsd:string.
eurio:fullAddress a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                  rdfs:comment "The full address of a physical location of an entity."@en;
                  rdfs:domain eurio:PostalAddress;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "full address"@en;
                  rdfs:range xsd:string.
eurio:funds a <http://www.w3.org/2002/07/owl#ObjectProperty>;
            rdfs:comment "Relates the grant with the project(s) that are completely or partially funded by it."@en;
            rdfs:domain eurio:Grant;
            rdfs:isDefinedBy eurio:;
            rdfs:label "funds"@en;
            rdfs:range eurio:Project;
            <http://www.w3.org/2002/07/owl#inverseOf> eurio:isFundedBy.
eurio:hasAcronym a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates an entity (e.g. project, grant, etc.) with its acronym(s). This includes acronyms representing the entity’s title as well as any additional acronyms extracted from other attributes of the entity."@en;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "has acronym"@en;
                 rdfs:range eurio:Acronym;
                 <http://www.w3.org/2002/07/owl#inverseOf> eurio:isAcronymOf.
eurio:hasAddress a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates a physical location to its registered address."@en;
                 rdfs:domain eurio:Site;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "has address"@en;
                 rdfs:range eurio:PostalAddress.
eurio:hasAssociatedFundingScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                 rdfs:comment "Relates an entity other than funding scheme (e.g., result, etc.) with associated funding schemes."@en;
                                 rdfs:isDefinedBy eurio:;
                                 rdfs:label "has associated funding scheme"@en;
                                 rdfs:range eurio:FundingScheme.
eurio:hasBeneficiary a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "Relates the grant to the organisation role(s) that are a beneficiary of the grant. "@en;
                     rdfs:domain eurio:Grant;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "has beneficiary"@en;
                     rdfs:range eurio:Role;
                     <http://www.w3.org/2002/07/owl#inverseOf> eurio:isBeneficiaryOf.
eurio:hasCoordinates a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:comment "The geo-coordinates of a place"@en;
                     rdfs:domain eurio:Site;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "has coordinates"@en;
                     rdfs:range eurio:Coordinates.
eurio:hasEUCountryCode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "The country code of the location or address according to the EU country codes."@en;
                       rdfs:domain eurio:Country;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has EU country code"@en;
                       rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasEuroSciVocClassification a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                  rdfs:comment "One or more values from the EuroSciVoc taxonomy that represent the main fields of science of the project."@en;
                                  rdfs:domain eurio:Project;
                                  rdfs:isDefinedBy eurio:;
                                  rdfs:label "has EuroSciVoc classification"@en;
                                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasFundingAmount a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relates the grant or funding scheme to the amount of money available for funding."@en;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (eurio:FundingScheme
                                                                             eurio:Grant) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has funding amount"@en;
                       rdfs:range eurio:MonetaryAmount.
eurio:hasFundingScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relates the grant to the funding scheme of which the grant forms a part."@en;
                       rdfs:domain eurio:Grant;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has funding scheme"@en;
                       rdfs:range eurio:FundingScheme;
                       <http://www.w3.org/2002/07/owl#inverseOf> eurio:hasGrant.
eurio:hasFundingSchemeCall a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Indicates the Call under which a project has been funded."@en;
                           rdfs:domain eurio:Grant;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "has funding scheme call"@en;
                           rdfs:range eurio:FundingScheme;
                           rdfs:subPropertyOf eurio:hasFundingScheme.
eurio:hasFundingSchemeCategory a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "A list of terms specifying the different categories / types of funding schemes."@en;
                               rdfs:domain eurio:FundingScheme;
                               rdfs:isDefinedBy eurio:;
                               rdfs:label "has funding scheme category"@en;
                               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasFundingSchemeProgramme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                                rdfs:comment "Indicates the legal basis under which a project has been funded."@en;
                                rdfs:domain eurio:Grant;
                                rdfs:isDefinedBy eurio:;
                                rdfs:label "has funding scheme programme"@en;
                                rdfs:range eurio:FundingScheme;
                                rdfs:subPropertyOf eurio:hasFundingScheme.
eurio:hasFundingSchemeTopic a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                            rdfs:comment "Indicates the Topic under which a project has been funded."@en;
                            rdfs:domain eurio:Grant;
                            rdfs:isDefinedBy eurio:;
                            rdfs:label "has funding scheme topic"@en;
                            rdfs:range eurio:FundingScheme;
                            rdfs:subPropertyOf eurio:hasFundingScheme.
eurio:hasFundingSchemeType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Indicates the type of action under which a project has been funded."@en;
                           rdfs:domain eurio:Grant;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "has funding scheme type"@en;
                           rdfs:range eurio:FundingScheme;
                           rdfs:subPropertyOf eurio:hasFundingScheme.
eurio:hasGeographicalLocation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:comment "The basic containment relation between a place and one that contains it"@en;
                              rdfs:domain eurio:Site;
                              rdfs:isDefinedBy eurio:;
                              rdfs:label "has geographical location"@en;
                              rdfs:range eurio:AdministrativeArea.
eurio:hasGrant a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relates a funding scheme with the grants that form part of it. "@en;
               rdfs:domain eurio:FundingScheme;
               rdfs:isDefinedBy eurio:;
               rdfs:label "has grant"@en;
               rdfs:range eurio:Grant.
eurio:hasISOCountryCode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "The 2-digit ISO country code."@en;
                        rdfs:domain eurio:Country;
                        rdfs:isDefinedBy eurio:;
                        rdfs:label "has ISO country code"@en;
                        rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasInvolvedParty a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relates the Project to the roles that are involved in the project."@en;
                       rdfs:domain eurio:Project;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has involved party"@en;
                       rdfs:range eurio:Role;
                       <http://www.w3.org/2002/07/owl#inverseOf> eurio:isInvolvedIn.
eurio:hasNUTS0code a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A value representing the NUTS-0 code of the place or address."@en;
                   rdfs:domain eurio:AdministrativeArea;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has NUTS 0 code"@en;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:subPropertyOf eurio:hasNUTSCode.
eurio:hasNUTS1code a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A value representing the NUTS-1 code of the place or address."@en;
                   rdfs:domain eurio:AdministrativeArea;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has NUTS 1 code"@en;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:subPropertyOf eurio:hasNUTSCode.
eurio:hasNUTS2code a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A value representing the NUTS-2 code of the place or address."@en;
                   rdfs:domain eurio:AdministrativeArea;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has NUTS 2 code"@en;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:subPropertyOf eurio:hasNUTSCode.
eurio:hasNUTS3code a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "A value representing the NUTS-3 code of the place or address."@en;
                   rdfs:domain eurio:AdministrativeArea;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has NUTS 3 code"@en;
                   rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>;
                   rdfs:subPropertyOf eurio:hasNUTSCode.
eurio:hasNUTSCode a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "A value representing the NUTS code of the place or address."@en;
                  rdfs:domain eurio:AdministrativeArea;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "has NUTS code"@en;
                  rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasNextFundingScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:comment "Relates a funding scheme with the next funding scheme."@en;
                           rdfs:domain eurio:FundingScheme;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "has next funding scheme"@en;
                           rdfs:range eurio:FundingScheme.
eurio:hasPayment a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates the grant to its payment(s)."@en;
                 rdfs:domain eurio:Grant;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "has payment"@en;
                 rdfs:range eurio:GrantPayment;
                 <http://www.w3.org/2002/07/owl#inverseOf> eurio:isPaymentOf.
eurio:hasPaymentAmount a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Relates the payment to the amount of money that was given to the beneficiary of the payment."@en;
                       rdfs:domain eurio:GrantPayment;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has payment amount"@en;
                       rdfs:range eurio:MonetaryAmount.
eurio:hasPreviousFundingScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:comment "Relates a funding scheme with the previous funding scheme."@en;
                               rdfs:domain eurio:FundingScheme;
                               rdfs:isDefinedBy eurio:;
                               rdfs:label "has previous funding scheme"@en;
                               rdfs:range eurio:FundingScheme.
eurio:hasRecipient a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates the grant payment to the organisation role(s) which have received the grant payment. Inverse property of isRecipientOf."@en;
                   rdfs:domain eurio:GrantPayment;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has recipient"@en;
                   rdfs:range eurio:Role;
                   <http://www.w3.org/2002/07/owl#inverseOf> eurio:isRecipientOf.
eurio:hasRelatedProject a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                          <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:comment "Represents a generic non parent-child relation between two CORDIS projects."@en;
                        rdfs:domain eurio:Project;
                        rdfs:isDefinedBy eurio:;
                        rdfs:label "has related project"@en;
                        rdfs:range eurio:Project.
eurio:hasRelatedScheme a <http://www.w3.org/2002/07/owl#SymmetricProperty>,
                         <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:comment "Represents a generic non parent-child relation between two funding schemes."@en;
                       rdfs:domain eurio:FundingScheme;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "has related scheme"@en;
                       rdfs:range eurio:FundingScheme.
eurio:hasResult a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:comment "Relates the project with its result(s)."@en;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (eurio:Project) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:isDefinedBy eurio:;
                rdfs:label "has result"@en;
                rdfs:range eurio:Result;
                <http://www.w3.org/2002/07/owl#inverseOf> eurio:isResultOf.
eurio:hasResultType a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "A list of terms specifying the types of results that can have a project."@en;
                    rdfs:domain eurio:Result;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "has result type"@en;
                    rdfs:range <http://www.w3.org/2004/02/skos/core#Concept>.
eurio:hasRole a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates the organisation to the roles that the organisation takes."@en;
              rdfs:domain eurio:Organisation;
              rdfs:isDefinedBy eurio:;
              rdfs:label "has role"@en;
              rdfs:range eurio:Role;
              <http://www.w3.org/2002/07/owl#inverseOf> eurio:isRoleOf.
eurio:hasSite a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "relates an organisation to its physical site"@en;
              rdfs:domain eurio:Organisation;
              rdfs:isDefinedBy eurio:;
              rdfs:label "has site"@en;
              rdfs:range eurio:Site.
eurio:hasSubOrganisation a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:comment "Relates the organisation with another organisation which is a sub-part or child of it."@en;
                         rdfs:domain eurio:Organisation;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "has sub-organisation"@en;
                         rdfs:range eurio:Organisation;
                         <http://www.w3.org/2002/07/owl#inverseOf> eurio:isSubOrganisationOf.
eurio:hasSubScheme a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates the funding scheme to its sub-schemes."@en;
                   rdfs:domain eurio:FundingScheme;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has subscheme"@en;
                   rdfs:range eurio:FundingScheme;
                   <http://www.w3.org/2002/07/owl#inverseOf> eurio:isSubSchemeOf.
eurio:hasTotalCost a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates the project with the amount of money expected, required, or given in payment for the project."@en;
                   rdfs:domain eurio:Project;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "has total cost"@en;
                   rdfs:range eurio:MonetaryAmount.
eurio:hasUnit a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:comment "Relates the organisation with a unit or department that forms part of the organisation."@en;
              rdfs:domain eurio:Organisation;
              rdfs:isDefinedBy eurio:;
              rdfs:label "has unit"@en;
              rdfs:range eurio:OrganisationUnit;
              <http://www.w3.org/2002/07/owl#inverseOf> eurio:isUnitOf.
eurio:identifier a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
                   <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The internal CORDA identifier."@en;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "identifier"@en;
                 rdfs:range xsd:string.
eurio:implements a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates a funding agency to the funding schemes that it implements and administers."@en;
                 rdfs:domain eurio:FundingAgency;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "implements"@en;
                 rdfs:range eurio:FundingScheme;
                 <http://www.w3.org/2002/07/owl#inverseOf> eurio:isImplementedBy.
eurio:isAcronymOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relates the acronym to the entity or entities to which it belongs."@en;
                  rdfs:domain eurio:Acronym;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "is acronym of"@en.
eurio:isBeneficiaryOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relates the role to the grant(s) of which the role is a beneficiary."@en;
                      rdfs:domain eurio:Role;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "is beneficiary of"@en;
                      rdfs:range eurio:Grant.
eurio:isDisbursedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates the grant to the funding agency that disburses the grant."@en;
                    rdfs:domain eurio:Grant;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "is disbursed by"@en;
                    rdfs:range eurio:FundingAgency.
eurio:isFundedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates the project with the grant(s) that completely or partially fund the project."@en;
                 rdfs:domain eurio:Project;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "is funded by"@en;
                 rdfs:range eurio:Grant.
eurio:isImplementedBy a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:comment "Relates the funding scheme with the funding agency that implements and administers the scheme."@en;
                      rdfs:domain eurio:FundingScheme;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "is implemented by"@en;
                      rdfs:range eurio:FundingAgency.
eurio:isInvolvedIn a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:comment "Relates the role to the Project in which it is involved."@en;
                   rdfs:domain eurio:Role;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "is involved in"@en;
                   rdfs:range eurio:Project.
eurio:isPaymentOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:comment "Relates a payment to the grant of which it is a part."@en;
                  rdfs:domain eurio:GrantPayment;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "is payment of"@en;
                  rdfs:range eurio:Grant.
eurio:isRecipientOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates the organisation role with the grant payment(s) which they have received. Inverse property of hasRecipient."@en;
                    rdfs:domain eurio:Role;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "is recipient of"@en;
                    rdfs:range eurio:GrantPayment.
eurio:isResultOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:comment "Relates the results with the Project(s) involved."@en;
                 rdfs:domain eurio:Result;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "is result of"@en;
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (eurio:Project) ; 
                             a <http://www.w3.org/2002/07/owl#Class>].
eurio:isRoleOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relates the organisation role to the organisation which assumes the role."@en;
               rdfs:domain eurio:Role;
               rdfs:isDefinedBy eurio:;
               rdfs:label "is role of"@en;
               rdfs:range eurio:Organisation.
eurio:isSiteOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Indicates an entity which has presence at the given site"@en;
               rdfs:domain eurio:Site;
               rdfs:isDefinedBy eurio:;
               rdfs:label "is site of"@en;
               rdfs:range eurio:Organisation.
eurio:isSubOrganisationOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:comment "Relates the organisation with another organisation of which it is a sub-part."@en;
                          rdfs:domain eurio:Organisation;
                          rdfs:isDefinedBy eurio:;
                          rdfs:label "is sub-organisation of"@en;
                          rdfs:range eurio:Organisation.
eurio:isSubSchemeOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                    rdfs:comment "Relates the funding scheme to its parent scheme of which this funding scheme forms a part. "@en;
                    rdfs:domain eurio:FundingScheme;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "is subscheme of"@en;
                    rdfs:range eurio:FundingScheme.
eurio:isUnitOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "Relates the unit to the organisation of which the unit forms a part. "@en;
               rdfs:domain eurio:OrganisationUnit;
               rdfs:isDefinedBy eurio:;
               rdfs:label "is unit of"@en;
               rdfs:range eurio:Organisation.
eurio:isbn a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The international standard book number of book publications."@en;
           rdfs:domain eurio:ProjectPublication;
           rdfs:isDefinedBy eurio:;
           rdfs:label "isbn"@en;
           rdfs:range xsd:string.
eurio:issn a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
             <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The international standard serial number of journal publications."@en;
           rdfs:domain eurio:ProjectPublication;
           rdfs:isDefinedBy eurio:;
           rdfs:label "issn"@en;
           rdfs:range xsd:string.
eurio:journalNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The journal number of a published result."@en;
                    rdfs:domain eurio:ProjectPublication;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "journal number"@en;
                    rdfs:range xsd:string.
eurio:journalTitle a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The title of the journal of a published result."@en;
                   rdfs:domain eurio:ProjectPublication;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "journal title"@en;
                   rdfs:range xsd:string.
eurio:keyword a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
              rdfs:comment "Word or words that represent the main idea of a referred entity (e.g., project. project result, etc.)"@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "keyword"@en;
              rdfs:range xsd:string.
eurio:language a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The language used in a project result."@en;
               rdfs:isDefinedBy eurio:;
               rdfs:label "language"@en;
               rdfs:range xsd:string.
eurio:latitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The latitude of a location. For example 37.42242 (WGS 84)."@en;
               rdfs:domain eurio:Coordinates;
               rdfs:isDefinedBy eurio:;
               rdfs:label "latitude"@en;
               rdfs:range xsd:decimal.
eurio:legalName a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The official name of the organization, e.g. the registered company name."@en;
                rdfs:domain eurio:Organisation;
                rdfs:isDefinedBy eurio:;
                rdfs:label "legal name"@en;
                rdfs:range xsd:string.
eurio:longitude a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The longitude of a location. For example -122.08585 (WGS 84)."@en;
                rdfs:domain eurio:Coordinates;
                rdfs:isDefinedBy eurio:;
                rdfs:label "longitude"@en;
                rdfs:range xsd:decimal.
eurio:name a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
           rdfs:comment "The name of an entity"@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "name"@en;
           rdfs:range xsd:string.
eurio:order a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:domain eurio:OrganisationRole;
            rdfs:range xsd:nonNegativeInteger.
eurio:periodFrom a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The date that the reporting period started."@en;
                 rdfs:domain eurio:ProjectReportSummary;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "period from"@en;
                 rdfs:range xsd:date.
eurio:periodNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                   rdfs:comment "The number of the reporting period."@en;
                   rdfs:domain eurio:ProjectReportSummary;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "period number"@en;
                   rdfs:range xsd:nonNegativeInteger.
eurio:periodTo a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
               rdfs:comment "The date that the reporting period ended."@en;
               rdfs:domain eurio:ProjectReportSummary;
               rdfs:isDefinedBy eurio:;
               rdfs:label "period to"@en;
               rdfs:range xsd:date.
eurio:postOfficeBoxNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                          rdfs:comment "The post office box number for PO box addresses."@en;
                          rdfs:domain eurio:PostalAddress;
                          rdfs:isDefinedBy eurio:;
                          rdfs:label "post office box number"@en;
                          rdfs:range xsd:string.
eurio:postalCode a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                 rdfs:comment "The postal code of the place or address."@en;
                 rdfs:domain eurio:PostalAddress;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "postal code"@en;
                 rdfs:range xsd:string.
eurio:projectStatus a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The current status (signed, ongoing, terminated, etc.) of the project."@en;
                    rdfs:domain eurio:Project;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "project status"@en;
                    rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("CANCEL"
                                                                       "CLOSED"
                                                                       "ONGOING"
                                                                       "SIGNED"
                                                                       "TERMINATED") ; 
                                a rdfs:Datatype].
eurio:publishedPages a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                     rdfs:comment "The pages of a published result."@en;
                     rdfs:domain eurio:ProjectPublication;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "published pages"@en;
                     rdfs:range xsd:string.
eurio:publishedYear a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The year of publication."@en;
                    rdfs:domain eurio:ProjectPublication;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "published year"@en;
                    rdfs:range xsd:nonNegativeInteger.
eurio:publisher a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Represents the publishing body of a published result."@en;
                rdfs:domain eurio:ProjectPublication;
                rdfs:isDefinedBy eurio:;
                rdfs:label "publisher"@en;
                rdfs:range xsd:string.
eurio:rcn a <http://www.w3.org/2002/07/owl#FunctionalProperty>,
            <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "Internal CORDIS identifier used for the identification of the domain entities (e.g., projects, project results, organisations, funding schemes, etc.). Stands for Resource Control Number."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "rcn"@en;
          rdfs:range xsd:nonNegativeInteger.
eurio:refersTo a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:comment "The entity to which this acronym refers. This can either be an entity inside of the knowledge graph or an external entity of any type."@en;
               rdfs:domain eurio:Acronym;
               rdfs:isDefinedBy eurio:;
               rdfs:label "refers to"@en.
eurio:roleLabel a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "Title for capturing the role of an organisation."@en;
                rdfs:domain eurio:OrganisationRole;
                rdfs:isDefinedBy eurio:;
                rdfs:label "role label"@en;
                rdfs:range [<http://www.w3.org/2002/07/owl#oneOf> ("coordinator"
                                                                   "international partner"
                                                                   "participant"
                                                                   "partner"
                                                                   "third party") ; 
                            a rdfs:Datatype].
eurio:shortForm a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The value of the acronym."@en;
                rdfs:domain eurio:Acronym;
                rdfs:isDefinedBy eurio:;
                rdfs:label "short form"@en;
                rdfs:range xsd:string.
eurio:signatureDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The day a grant agreement has been signed."@en;
                    rdfs:domain eurio:Project;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "signature date"@en;
                    rdfs:range xsd:date;
                    rdfs:subPropertyOf eurio:date.
eurio:startDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The time an entity (e.g. project, grant, etc.) is initialized or starts to take effect."@en;
                rdfs:isDefinedBy eurio:;
                rdfs:label "start date"@en;
                rdfs:range xsd:date;
                rdfs:subPropertyOf eurio:date.
eurio:streetAddress a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "The street name and number of the place or address."@en;
                    rdfs:domain eurio:PostalAddress;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "street address"@en;
                    rdfs:range xsd:string.
eurio:terminationDate a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                      rdfs:comment "The termination date of a project."@en;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "termination date"@en;
                      rdfs:range xsd:date;
                      rdfs:subPropertyOf eurio:date.
eurio:title a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The entity’s (e.g. project, work package, etc.) official name or title."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "title"@en;
            rdfs:range xsd:string.
eurio:url a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
          rdfs:comment "A URL that links internet resources related to a CORDIS entity."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "URL"@en;
          rdfs:range xsd:anyURI.
eurio:value a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
            rdfs:comment "The value of amount being expressed."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "value"@en;
            rdfs:range xsd:decimal.
eurio:vatNumber a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                rdfs:comment "The unique number that identifies a taxable organisation or non-taxable legal entity that is registered for VAT."@en;
                rdfs:domain eurio:Organisation;
                rdfs:isDefinedBy eurio:;
                rdfs:label "VAT number"@en;
                rdfs:range xsd:string.
eurio:workPerformed a <http://www.w3.org/2002/07/owl#DatatypeProperty>;
                    rdfs:comment "A summary of the work carried out during the development of the project."@en;
                    rdfs:domain eurio:ProjectReportSummary;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "work performed"@en;
                    rdfs:range xsd:string.
<http://publications.europa.eu/resource/authority/language/ENG> a <http://www.w3.org/2004/02/skos/core#Concept>.
<http://publications.europa.eu/resource/dataset/eurio> <http://purl.org/dc/terms/creator> [<http://xmlns.com/foaf/0.1/name> "Publications Office of the European Commission"@en ; 
                                                                                           a <http://xmlns.com/foaf/0.1/Agent>];
                                                       <http://purl.org/dc/terms/description> "The EUropean Research Information Ontology (EURIO) conceptualises, formally encodes and makes available in an open, structured and machine-readable format data about research projects funded by the EU's framework programmes for research and innovation."@en;
