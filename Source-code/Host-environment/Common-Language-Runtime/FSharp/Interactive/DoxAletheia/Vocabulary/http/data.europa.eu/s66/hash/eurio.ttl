@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix eurio: <http://data.europa.eu/s66#>.
@prefix eurovoc: <http://eurovoc.europa.eu/>.
@prefix frapo: <http://purl.org/cerif/frapo/>.
@prefix fabio: <http://purl.org/spar/fabio/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix w3: <http://www.w3.org/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix adms: <http://www.w3.org/ns/adms#>.
@prefix locn: <http://www.w3.org/ns/locn#>.
@prefix org: <http://www.w3.org/ns/org#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix w3id: <https://w3id.org/>.
@prefix dg: <https://w3id.org/dingo#>.
@prefix cpov: <http://data.europa.eu/m8g/>.
@prefix dc11: <http://purl.org/dc/elements/1.1/>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix schema: <http://schema.org/>.
@prefix xmls: <http://www.w3.org/2001/XMLSchema#>.
@prefix vcard2006: <http://www.w3.org/2006/vcard/ns#>.
@prefix aerdcat: <http://www.w3.org/ns/dcat#>.

_:B10709f42655290615a69babcddf6933a a owl:AllDisjointClasses;
                                    owl:members (eurio:ProjectDeliverable
                                                 eurio:ProjectPublication
                                                 eurio:ProjectReportSummary).
_:B2757b133748b0521831844bad093564f aerdcat:accessURL eurio:;
                                    aerdcat:downloadURL eurio:.
[] foaf:mbox "cordis@publications.europa.eu".
_:Bc014ed49817da222bb93ddd32830ef37 a owl:AllDisjointClasses;
                                    owl:members (eurio:ForProfitOrganisation
                                                 eurio:FundingAgency
                                                 eurio:HigherOrSecondaryEducation
                                                 eurio:PublicBody
                                                 eurio:ResearchOrganisation
                                                 eurio:SME).
_:Be7fe4c47e901838fb47ac58556155d1e a owl:AllDisjointClasses;
                                    owl:members (eurio:JournalPaper
                                                 eurio:ProceedingsPaper).
eurio:Acronym a owl:Class;
              rdfs:comment "An abbreviation formed from the initial letters of other words and pronounced as a word. It can refer to any type of entities in the CORDIS conceptual framework, and may be stated explicitly or extracted automatically from text."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Acronym"@en;
              rdfs:subClassOf [owl:cardinality 1  ; 
                               owl:onProperty eurio:shortForm ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:definition ; 
                               a owl:Restriction].
eurio:AdministrativeArea a owl:Class;
                         rdfs:comment "An administrative geographical area that is typically managed by a public body. It can be a country, a region, a municipality, a province, a sub-municipality area, etc."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Administrative Area"@en;
                         rdfs:subClassOf [owl:cardinality 1  ; 
                                          owl:onProperty eurio:name ; 
                                          a owl:Restriction];
                         skos:broadMatch schema:AdministrativeArea,
                                         cpov:AdminUnit.
eurio:Book a owl:Class;
           rdfs:comment "A non-serial document that is complete in one volume or a designated finite number of volumes. A book published by a publisher is usually identified by an International Standard Book Number (ISBN), and may be manifested as a physical printed publication on paper bound in a hard or soft cover, or in electronic format as an 'e-book'."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Book"@en;
           rdfs:subClassOf eurio:ProjectPublication;
           skos:broadMatch fabio:Book.
eurio:Coordinates a owl:Class;
                  rdfs:comment "The geo coordinates for a location of entities that participate in or form part of research projects."@en;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "Coordinates"@en;
                  rdfs:subClassOf [owl:cardinality 1  ; 
                                   owl:onProperty eurio:longitude ; 
                                   a owl:Restriction],
                                  [owl:cardinality 1  ; 
                                   owl:onProperty eurio:latitude ; 
                                   a owl:Restriction];
                  skos:broadMatch locn:Geometry;
                  skos:closeMatch schema:GeoCoordinates.
eurio:Country a owl:Class;
              rdfs:comment "A country"@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Country"@en;
              rdfs:subClassOf [owl:maxCardinality 1  ; 
                               owl:onProperty eurio:hasEUCountryCode ; 
                               a owl:Restriction],
                              eurio:AdministrativeArea;
              skos:broadMatch schema:Country.
eurio:DetectedAcronym a owl:Class;
                      rdfs:comment "Any acronym that has been detected, automatically or manually, from the description of an entity or from any other form of natural language text."@en;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "Detected Acronym"@en;
                      rdfs:subClassOf eurio:Acronym;
                      owl:disjointWith eurio:TitleAcronym.
eurio:ForProfitOrganisation a owl:Class;
                            rdfs:comment "A for profit entity"@en;
                            rdfs:isDefinedBy eurio:;
                            rdfs:label "For Profit Organisation"@en;
                            rdfs:subClassOf eurio:Organisation;
                            skos:broadMatch dg:ForProfitOrganisation.
eurio:FundingAgency a owl:Class;
                    rdfs:comment "An organisation that materially administrates funding schemes and disburses related grants. In the context of CORDIS, it represents the various European agencies responsible for funding research projects (e.g. ERC, EASME, REA, etc.)."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Funding Agency"@en;
                    rdfs:subClassOf eurio:Organisation;
                    skos:broadMatch dg:FundingAgency.
eurio:FundingScheme a owl:Class;
                    rdfs:comment "Set of rules and conditions which forms the basis for public funding of European research. In CORDIS, they represent the different legal frameworks (e.g. FP6, FP7, H2020). They can also be used to represent the different calls inside each framework by using the recursive relation “partOfScheme”."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Funding Scheme"@en;
                    rdfs:subClassOf [owl:cardinality 1  ; 
                                     owl:onProperty eurio:isImplementedBy ; 
                                     a owl:Restriction],
                                    [owl:allValuesFrom xsd:nonNegativeInteger ; 
                                     owl:onProperty eurio:duration ; 
                                     a owl:Restriction],
                                    [owl:minCardinality 1  ; 
                                     owl:onProperty eurio:url ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:hasFundingSchemeCategory ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:title ; 
                                     a owl:Restriction];
                    skos:broadMatch dg:FundingScheme.
eurio:Grant a owl:Class;
            rdfs:comment "A disbursed fund paid to a recipient or beneficiary within the context of a funded research project. In the context of CORDIS, it represents a grant of a specific EU programme (e.g. an H2020 grant)."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "Grant"@en;
            rdfs:subClassOf [owl:cardinality 1  ; 
                             owl:onProperty eurio:startDate ; 
                             a owl:Restriction],
                            [owl:minCardinality 1  ; 
                             owl:onProperty eurio:hasBeneficiary ; 
                             a owl:Restriction],
                            [owl:cardinality 1  ; 
                             owl:onProperty eurio:isDisbursedBy ; 
                             a owl:Restriction],
                            [owl:someValuesFrom xsd:nonNegativeInteger ; 
                             owl:onProperty eurio:duration ; 
                             a owl:Restriction],
                            [owl:cardinality 1  ; 
                             owl:onProperty eurio:hasFundingAmount ; 
                             a owl:Restriction],
                            [owl:cardinality 1  ; 
                             owl:onProperty eurio:endDate ; 
                             a owl:Restriction],
                            [owl:minCardinality 1  ; 
                             owl:onProperty eurio:hasFundingScheme ; 
                             a owl:Restriction],
                            [owl:minCardinality 1  ; 
                             owl:onProperty eurio:funds ; 
                             a owl:Restriction],
                            [owl:minCardinality 1  ; 
                             owl:onProperty eurio:hasPayment ; 
                             a owl:Restriction];
            skos:broadMatch dg:Grant.
eurio:GrantPayment a owl:Class;
                   rdfs:comment "A single payment to a recipient or beneficiary of a Grant within a research project."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Grant Payment"@en;
                   rdfs:subClassOf [owl:cardinality 1  ; 
                                    owl:onProperty eurio:hasPaymentAmount ; 
                                    a owl:Restriction];
                   skos:broadMatch dg:GrantPayment.
eurio:HigherOrSecondaryEducation a owl:Class;
                                 rdfs:comment "Institution that provides education."@en;
                                 rdfs:isDefinedBy eurio:;
                                 rdfs:label "Higher Or Secondary Education"@en;
                                 rdfs:subClassOf eurio:Organisation;
                                 skos:broadMatch dg:EducationOrganisation,
                                                 schema:EducationalOrganization.
eurio:JournalPaper a owl:Class;
                   rdfs:comment "An article, typically the realization of a research paper reporting original research findings, published in a journal issue."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Journal Paper"@en;
                   rdfs:subClassOf eurio:ProjectPublication;
                   skos:broadMatch fabio:JournalArticle.
eurio:MonetaryAmount a owl:Class;
                     rdfs:comment "A monetary value or range. This type can be used to describe an amount of money such as $50 USD, or a range as in describing a bank account being suitable for a balance between £1,000 and £1,000,000 GBP, or the value of a salary, etc."@en;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "Monetary Amount"@en;
                     rdfs:subClassOf [owl:cardinality 1  ; 
                                      owl:onProperty eurio:value ; 
                                      a owl:Restriction];
                     skos:broadMatch schema:MonetaryAmount.
eurio:NonPeerReviewedPublication a owl:Class;
                                 rdfs:comment "A work that hasn't undergone peer reviewing prior to its publication."@en;
                                 rdfs:isDefinedBy eurio:;
                                 rdfs:label "Non Peer-Reviewed Publication"@en;
                                 rdfs:subClassOf eurio:ProjectPublication.
eurio:Organisation a owl:Class;
                   rdfs:comment "Represents a group of people, with the same purpose, organized together into a community or other social, commercial or political structure that participate in CORDIS projects."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Organisation"@en;
                   rdfs:subClassOf [owl:cardinality 1  ; 
                                    owl:onProperty eurio:identifier ; 
                                    a owl:Restriction],
                                   [owl:allValuesFrom eurio:OrganisationRole ; 
                                    owl:onProperty eurio:hasRole ; 
                                    a owl:Restriction],
                                   [owl:cardinality 1  ; 
                                    owl:onProperty eurio:vatNumber ; 
                                    a owl:Restriction],
                                   [owl:maxCardinality 1  ; 
                                    owl:onProperty eurio:url ; 
                                    a owl:Restriction],
                                   [owl:cardinality 1  ; 
                                    owl:onProperty eurio:rcn ; 
                                    a owl:Restriction],
                                   [owl:minCardinality 1  ; 
                                    owl:onProperty eurio:hasSite ; 
                                    a owl:Restriction],
                                   [owl:cardinality 1  ; 
                                    owl:onProperty eurio:legalName ; 
                                    a owl:Restriction];
                   skos:broadMatch dg:Organisation,
                                   org:Organization.
eurio:OrganisationRole a owl:Class;
                       rdfs:comment "Function assumed by or ascribed to an organisation that takes part in a particular project. In CORDIs, it represents roles such as coordinator, partner, consortium member, etc."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Organisation Role"@en;
                       rdfs:subClassOf [owl:cardinality 1  ; 
                                        owl:onProperty eurio:isRoleOf ; 
                                        a owl:Restriction],
                                       [owl:allValuesFrom eurio:Organisation ; 
                                        owl:onProperty eurio:isRoleOf ; 
                                        a owl:Restriction],
                                       eurio:Role;
                       skos:broadMatch dg:OrganisationRole.
eurio:OrganisationUnit a owl:Class;
                       rdfs:comment "A department or unit which is part of some larger Organization and only has full recognition within the context of that Organization. In CORDIS, it represents for instance the different departments of a university that participate in a particular project."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Organisation Unit"@en;
                       skos:broadMatch org:OrganizationalUnit.
eurio:PostalAddress a owl:Class;
                    rdfs:comment "The postal address of entities that participate in or form part of research projects."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Postal Address"@en;
                    rdfs:subClassOf [owl:cardinality 1  ; 
                                     owl:onProperty eurio:postalCode ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:streetAddress ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:addressCountry ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:fullAddress ; 
                                     a owl:Restriction],
                                    [owl:cardinality 1  ; 
                                     owl:onProperty eurio:addressLocality ; 
                                     a owl:Restriction];
                    skos:broadMatch schema:PostalAddress,
                                    locn:Address.
eurio:ProceedingsPaper a owl:Class;
                       rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually presented at a workshop and published within a workshop proceedings volume."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Procedings Paper"@en;
                       rdfs:subClassOf eurio:ProjectPublication;
                       skos:broadMatch fabio:WorkshopPaper.
eurio:Project a owl:Class;
              rdfs:comment "A planned research work that has one or more objectives (divided or not into tasks) and is conducted by one or more organisations. In CORDIS, it represents a project funded by an EU programme."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Project"@en;
              rdfs:subClassOf [owl:cardinality 1  ; 
                               owl:onProperty eurio:title ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:abstract ; 
                               a owl:Restriction],
                              [owl:minCardinality 1  ; 
                               owl:onProperty eurio:isFundedBy ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:hasTotalCost ; 
                               a owl:Restriction],
                              [owl:maxCardinality 1  ; 
                               owl:onProperty eurio:doi ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:signatureDate ; 
                               a owl:Restriction],
                              [owl:minCardinality 1  ; 
                               owl:onProperty eurio:hasInvolvedParty ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:endDate ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:rcn ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:duration ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:projectStatus ; 
                               a owl:Restriction],
                              [owl:maxCardinality 1  ; 
                               owl:onProperty eurio:url ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:identifier ; 
                               a owl:Restriction],
                              [owl:cardinality 1  ; 
                               owl:onProperty eurio:startDate ; 
                               a owl:Restriction];
              skos:broadMatch dg:Project.
eurio:ProjectDeliverable a owl:Class;
                         rdfs:comment "A document referring to the results obtained during the development of a project."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Project Deliverable"@en;
                         rdfs:subClassOf [owl:maxCardinality 1  ; 
                                          owl:onProperty eurio:description ; 
                                          a owl:Restriction],
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:hasResultType ; 
                                          a owl:Restriction],
                                         eurio:Result;
                         skos:broadMatch fabio:ProjectReportDocument.
eurio:ProjectPublication a owl:Class;
                         rdfs:comment "A scientific publication (e.g., journal article, conference paper, thesis dissertation, book, etc.) that resulted from the project activities."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Project Publication"@en;
                         rdfs:subClassOf eurio:Result,
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:journalNumber ; 
                                          a owl:Restriction],
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:publisher ; 
                                          a owl:Restriction],
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:publishedYear ; 
                                          a owl:Restriction],
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:journalTitle ; 
                                          a owl:Restriction],
                                         [owl:cardinality 1  ; 
                                          owl:onProperty eurio:author ; 
                                          a owl:Restriction],
                                         [owl:maxCardinality 1  ; 
                                          owl:onProperty eurio:publishedPages ; 
                                          a owl:Restriction];
                         skos:broadMatch fabio:Expression.
eurio:ProjectReportSummary a owl:Class;
                           rdfs:comment "A document reporting on the progress of an on-going or completed project at a given period.."@en;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "Project Report Summary"@en;
                           rdfs:subClassOf [owl:maxCardinality 1  ; 
                                            owl:onProperty eurio:startDate ; 
                                            a owl:Restriction],
                                           [owl:cardinality 1  ; 
                                            owl:onProperty eurio:abstract ; 
                                            a owl:Restriction],
                                           eurio:Result,
                                           [owl:maxCardinality 1  ; 
                                            owl:onProperty eurio:endDate ; 
                                            a owl:Restriction],
                                           [owl:maxCardinality 1  ; 
                                            owl:onProperty eurio:finalResults ; 
                                            a owl:Restriction],
                                           [owl:maxCardinality 1  ; 
                                            owl:onProperty eurio:workPerformed ; 
                                            a owl:Restriction];
                           skos:broadMatch fabio:ProjectReportSummary.
eurio:PublicBody a owl:Class;
                 rdfs:comment "Organisation or agency depending on a government, State or other supranational organisation and mainly operated by the government."@en;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "Public Body"@en;
                 rdfs:subClassOf eurio:Organisation;
                 skos:closeMatch dg:GovernamentalOrganisation,
                                 frapo:NotForProfitOrganization.
eurio:ResearchOrganisation a owl:Class;
                           rdfs:comment "Organisations devoted to research activities."@en;
                           rdfs:isDefinedBy eurio:;
                           rdfs:label "Research Organisation"@en;
                           rdfs:subClassOf eurio:Organisation;
                           skos:broadMatch dg:ResearchPerformingOrganisation.
eurio:Result a owl:Class;
             rdfs:comment "Any tangible or intangible output of the project (such as data, knowledge and information, whatever their form or nature, whether or not they can be protected), which are generated in the project."@en;
             rdfs:isDefinedBy eurio:;
             rdfs:label "Result"@en;
             rdfs:subClassOf [owl:cardinality 1  ; 
                              owl:onProperty eurio:title ; 
                              a owl:Restriction],
                             [owl:cardinality 1  ; 
                              owl:onProperty eurio:language ; 
                              a owl:Restriction],
                             [owl:maxCardinality 1  ; 
                              owl:onProperty eurio:url ; 
                              a owl:Restriction].
eurio:Role a owl:Class;
           rdfs:comment "The function assumed by or ascribed to an entity (typically an organisation) in a particular project. It can be used to precise or represent additional information about a relationship or property such as participation or membership. In CORDIS, it represents the participation of an organisation in a research project."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Role"@en;
           rdfs:subClassOf [owl:cardinality 1  ; 
                            owl:onProperty eurio:startDate ; 
                            a owl:Restriction],
                           [owl:cardinality 1  ; 
                            owl:onProperty eurio:roleLabel ; 
                            a owl:Restriction],
                           [owl:cardinality 1  ; 
                            owl:onProperty eurio:endDate ; 
                            a owl:Restriction],
                           [owl:cardinality 1  ; 
                            owl:onProperty eurio:isInvolvedIn ; 
                            a owl:Restriction];
           skos:broadMatch dg:Role.
eurio:SME a owl:Class;
          rdfs:comment "Small and Medium Enterprises."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "SME"@en;
          rdfs:subClassOf eurio:Organisation;
          skos:broadMatch frapo:SME.
eurio:Site a owl:Class;
           rdfs:comment "The physical extension of entities that participate in or form part of research projects."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Site"@en;
           rdfs:subClassOf [owl:cardinality 1  ; 
                            owl:onProperty eurio:name ; 
                            a owl:Restriction],
                           [owl:cardinality 1  ; 
                            owl:onProperty eurio:hasAddress ; 
                            a owl:Restriction],
                           [owl:maxCardinality 1  ; 
                            owl:onProperty eurio:hasCoordinates ; 
                            a owl:Restriction],
                           [owl:minCardinality 1  ; 
                            owl:onProperty eurio:hasGeographicalLocation ; 
                            a owl:Restriction],
                           [owl:cardinality 1  ; 
                            owl:onProperty eurio:isSiteOf ; 
                            a owl:Restriction];
           skos:broadMatch org:Site.
eurio:ThesisDissertation a owl:Class;
                         rdfs:comment "A book authored by a student containing a formal presentations of research outputs submitted for examination in completion of a course of study at an institution of higher education, to fulfil the requirements for an academic degree. Also know as a dissertation."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Thesis Dissertation"@en;
                         rdfs:subClassOf eurio:ProjectPublication;
                         skos:broadMatch fabio:Thesis.
eurio:TitleAcronym a owl:Class;
                   rdfs:comment "An acronym explicitly defined as the title or name of another entity (e.g. Project, Organisation, Funding Scheme, etc.)."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Title Acronym"@en;
                   rdfs:subClassOf eurio:Acronym.
eurio:abstract a owl:DatatypeProperty;
               rdfs:comment "The general summary and ideas of a CORDIS entity, e.g., project, result."@en;
               rdfs:isDefinedBy eurio:;
               rdfs:label "abstract"@en;
               rdfs:range xsd:string.
eurio:addressCountry a owl:DatatypeProperty;
                     rdfs:comment "The country of the place or address. You can also provide the two-letter ISO 3166-1 alpha-2 country code."@en;
                     rdfs:domain eurio:PostalAddress;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "address country"@en;
                     rdfs:range xsd:string.
eurio:addressLocality a owl:DatatypeProperty;
                      rdfs:comment "The locality, town or city of the place or address."@en;
                      rdfs:domain eurio:PostalAddress;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "address locality"@en;
                      rdfs:range xsd:string.
eurio:author a owl:DatatypeProperty;
             rdfs:comment "The list of authors."@en;
             rdfs:isDefinedBy eurio:;
             rdfs:label "author"@en;
             rdfs:range xsd:string.
eurio:code a owl:FunctionalProperty,
             owl:DatatypeProperty;
           rdfs:comment "A CORDA code."@en;
           rdfs:domain eurio:FundingScheme;
           rdfs:isDefinedBy eurio:;
           rdfs:label "code"@en;
           rdfs:range xsd:string.
eurio:currency a owl:DatatypeProperty;
               rdfs:comment "The currency in which the monetary amount is expressed."@en;
               rdfs:domain eurio:MonetaryAmount;
               rdfs:isDefinedBy eurio:;
               rdfs:label "currency"@en;
               rdfs:range xsd:string.
eurio:date a owl:DatatypeProperty;
           rdfs:comment "The date in which the grant payment took place."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "date"@en;
           rdfs:range xsd:date.
eurio:definition a owl:DatatypeProperty;
                 rdfs:comment "The definition of the acronym."@en;
                 rdfs:domain eurio:Acronym;
                 rdfs:isDefinedBy eurio:;
                 rdfs:label "definition"@en;
                 rdfs:range xsd:string.
eurio:description a owl:DatatypeProperty;
                  rdfs:comment "A brief summary of the entity (project, etc.)."@en;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "description"@en;
                  rdfs:range xsd:string.
eurio:disburses a owl:ObjectProperty;
                rdfs:comment "Relates the funding agency to the grant(s) that it disburses."@en;
                rdfs:domain eurio:FundingAgency;
                rdfs:isDefinedBy eurio:;
                rdfs:label "disburses"@en;
                rdfs:range eurio:Grant;
                owl:inverseOf eurio:isDisbursedBy.
eurio:doi a owl:FunctionalProperty,
            owl:DatatypeProperty;
          rdfs:comment "The digital object identifier of a publication."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "doi"@en;
          rdfs:range xsd:anyURI.
eurio:duration a owl:DatatypeProperty;
               rdfs:comment "The period of time an entity (e.g. project, grant, etc.) has taken, represented as number of months."@en;
               rdfs:isDefinedBy eurio:;
               rdfs:label "duration"@en;
               rdfs:range xsd:nonNegativeInteger.
eurio:endDate a owl:DatatypeProperty;
              rdfs:comment "The date on which an entity (e.g. project, grant, etc.) is finalized or ceases to exist."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "end date"@en;
              rdfs:range xsd:date;
