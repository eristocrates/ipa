                           rdfs:range eurio:FundingScheme;
                           rdfs:subPropertyOf eurio:hasFundingScheme.
eurio:hasGeographicalLocation a owl:ObjectProperty;
                              rdfs:comment "The basic containment relation between a place and one that contains it"@en;
