                    rdfs:isDefinedBy eurio:;
                    rdfs:label "project status"@en;
                    rdfs:range [owl:oneOf ("CANCEL"
                                           "CLOSED"
                                           "ONGOING"
                                           "SIGNED"
                                           "TERMINATED") ; 
                                a rdfs:Datatype].
eurio:publishedPages a owl:DatatypeProperty;
                     rdfs:comment "The pages of a published result."@en;
                     rdfs:domain eurio:ProjectPublication;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "published pages"@en;
                     rdfs:range xsd:string.
eurio:publishedYear a owl:DatatypeProperty;
                    rdfs:comment "The year of publication."@en;
                    rdfs:domain eurio:ProjectPublication;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "published year"@en;
                    rdfs:range xsd:nonNegativeInteger.
eurio:publisher a owl:DatatypeProperty;
                rdfs:comment "Represents the publishing body of a published result."@en;
                rdfs:domain eurio:ProjectPublication;
                rdfs:isDefinedBy eurio:;
                rdfs:label "publisher"@en;
                rdfs:range xsd:string.
eurio:rcn a owl:FunctionalProperty,
            owl:DatatypeProperty;
          rdfs:comment "Internal CORDIS identifier used for the identification of the domain entities (e.g., projects, project results, organisations, funding schemes, etc.). Stands for Resource Control Number."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "rcn"@en;
          rdfs:range xsd:nonNegativeInteger.
eurio:refersTo a owl:ObjectProperty;
               rdfs:comment "The entity to which this acronym refers. This can either be an entity inside of the knowledge graph or an external entity of any type."@en;
               rdfs:domain eurio:Acronym;
               rdfs:isDefinedBy eurio:;
               rdfs:label "refers to"@en.
eurio:roleLabel a owl:DatatypeProperty;
                rdfs:comment "Title for capturing the role of an organisation."@en;
                rdfs:domain eurio:OrganisationRole;
                rdfs:isDefinedBy eurio:;
                rdfs:label "role label"@en;
                rdfs:range [owl:oneOf ("coordinator"
                                       "international partner"
                                       "participant"
                                       "partner"
                                       "third party") ; 
                            a rdfs:Datatype].
eurio:shortForm a owl:DatatypeProperty;
                rdfs:comment "The value of the acronym."@en;
                rdfs:domain eurio:Acronym;
                rdfs:isDefinedBy eurio:;
                rdfs:label "short form"@en;
                rdfs:range xsd:string.
eurio:signatureDate a owl:DatatypeProperty;
                    rdfs:comment "The day a grant agreement has been signed."@en;
                    rdfs:domain eurio:Project;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "signature date"@en;
                    rdfs:range xsd:date;
                    rdfs:subPropertyOf eurio:date.
eurio:startDate a owl:DatatypeProperty;
                rdfs:comment "The time an entity (e.g. project, grant, etc.) is initialized or starts to take effect."@en;
                rdfs:isDefinedBy eurio:;
                rdfs:label "start date"@en;
                rdfs:range xsd:date;
                rdfs:subPropertyOf eurio:date.
eurio:streetAddress a owl:DatatypeProperty;
                    rdfs:comment "The street name and number of the place or address."@en;
                    rdfs:domain eurio:PostalAddress;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "street address"@en;
                    rdfs:range xsd:string.
eurio:terminationDate a owl:DatatypeProperty;
                      rdfs:comment "The termination date of a project."@en;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "termination date"@en;
                      rdfs:range xsd:date;
                      rdfs:subPropertyOf eurio:date.
eurio:title a owl:DatatypeProperty;
            rdfs:comment "The entity’s (e.g. project, work package, etc.) official name or title."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "title"@en;
            rdfs:range xsd:string.
eurio:url a owl:DatatypeProperty;
          rdfs:comment "A URL that links internet resources related to a CORDIS entity."@en;
          rdfs:isDefinedBy eurio:;
          rdfs:label "URL"@en;
          rdfs:range xsd:anyURI.
eurio:value a owl:DatatypeProperty;
            rdfs:comment "The value of amount being expressed."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "value"@en;
            rdfs:range xsd:decimal.
eurio:vatNumber a owl:DatatypeProperty;
                rdfs:comment "The unique number that identifies a taxable organisation or non-taxable legal entity that is registered for VAT."@en;
                rdfs:domain eurio:Organisation;
                rdfs:isDefinedBy eurio:;
                rdfs:label "VAT number"@en;
                rdfs:range xsd:string.
eurio:workPerformed a owl:DatatypeProperty;
                    rdfs:comment "A summary of the work carried out during the development of the project."@en;
                    rdfs:domain eurio:ProjectReportSummary;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "work performed"@en;
                    rdfs:range xsd:string.
<http://publications.europa.eu/resource/authority/language/ENG> a skos:Concept.
<http://publications.europa.eu/resource/dataset/eurio> dcterms:creator [foaf:name "Publications Office of the European Commission"@en ; 
                                                                        a foaf:Agent];
                                                       dcterms:description "The EUropean Research Information Ontology (EURIO) conceptualises, formally encodes and makes available in an open, structured and machine-readable format data about research projects funded by the EU's framework programmes for research and innovation."@en;
                                                       dcterms:issued "2021-12-01T00:00:00"^^xsd:dateTime;
                                                       dcterms:language <http://publications.europa.eu/resource/authority/language/ENG>;
                                                       dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
                                                       dcterms:modified "2025-05-08T00:00:00"^^xsd:dateTime;
                                                       dcterms:publisher <http://publications.europa.eu/resource/authority/corporate-body/PUBL>;
                                                       dcterms:title "EURIO: EUropean Research Information Ontology"@en;
                                                       dcterms:type <http://purl.org/adms/assettype/Ontology>;
                                                       vann:preferredNamespacePrefix "eurio";
                                                       a aerdcat:Dataset,
                                                         adms:Asset,
                                                         owl:Ontology;
                                                       rdfs:comment "CORDIS is the portal responsible for publishing the results of EU-funded research and innovation projects. EURIO (EUropean Research Information Ontology) is the conceptual data model developed by the Publications Office of the European Commission to represent and structure the CORDIS content in a semantic format improving its transparency, reusability and accessibility."@en;
                                                       owl:versionIRI <http://data.europa.eu/s66/v2.5#>;
                                                       owl:versionInfo "2.5.0";
                                                       adms:status <http://purl.org/adms/status/Completed>;
                                                       adms:versionNotes "Update to delete person class and contact details."@en;
                                                       aerdcat:contactPoint [vcard2006:hasEmail <mailto:op-info@publications.europa.eu> ; 
                                                                             vcard2006:fn "Publications Office of the European Union"@en ; 
                                                                             a vcard2006:Organization ; 
                                                                             a vcard2006:Kind];
                                                       aerdcat:contributor [foaf:name "Cognizone" ; 
                                                                            a foaf:Agent];
                                                       aerdcat:distribution [dcterms:license <https://creativecommons.org/licenses/by/4.0/> ; 
                                                                             aerdcat:accessURL <https://op.europa.eu/en/web/eu-vocabularies/eurio> ; 
                                                                             dcterms:downloadURL <https://op.europa.eu/s/eurio-v2.5.ttl> ; 
                                                                             a aerdcat:Distribution];
