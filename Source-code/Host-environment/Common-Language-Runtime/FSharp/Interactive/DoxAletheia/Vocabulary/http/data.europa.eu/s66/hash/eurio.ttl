eurio:hasFundingSchemeCategory a owl:ObjectProperty;
                               rdfs:comment "A list of terms specifying the different categories / types of funding schemes."@en;
                               rdfs:domain eurio:FundingScheme;
                               rdfs:isDefinedBy eurio:;
                               rdfs:label "has funding scheme category"@en;
