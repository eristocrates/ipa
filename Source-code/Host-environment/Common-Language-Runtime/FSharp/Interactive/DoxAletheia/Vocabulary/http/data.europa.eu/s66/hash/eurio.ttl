eurio:hasFundingSchemeProgramme a owl:ObjectProperty;
                                rdfs:comment "Indicates the legal basis under which a project has been funded."@en;
                                rdfs:domain eurio:Grant;
                                rdfs:isDefinedBy eurio:;
