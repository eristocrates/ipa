eurio:Acronym a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "An abbreviation formed from the initial letters of other words and pronounced as a word. It can refer to any type of entities in the CORDIS conceptual framework, and may be stated explicitly or extracted automatically from text."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Acronym"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:shortForm ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:definition ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>].
eurio:AdministrativeArea a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "An administrative geographical area that is typically managed by a public body. It can be a country, a region, a municipality, a province, a sub-municipality area, etc."@en;
                         rdfs:isDefinedBy eurio:;
                         rdfs:label "Administrative Area"@en;
                         rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                          <http://www.w3.org/2002/07/owl#onProperty> eurio:name ; 
                                          a <http://www.w3.org/2002/07/owl#Restriction>];
                         <http://www.w3.org/2004/02/skos/core#broadMatch> <http://schema.org/AdministrativeArea>,
                                                                          <http://data.europa.eu/m8g/AdminUnit>.
eurio:Book a <http://www.w3.org/2002/07/owl#Class>;
           rdfs:comment "A non-serial document that is complete in one volume or a designated finite number of volumes. A book published by a publisher is usually identified by an International Standard Book Number (ISBN), and may be manifested as a physical printed publication on paper bound in a hard or soft cover, or in electronic format as an 'e-book'."@en;
           rdfs:isDefinedBy eurio:;
           rdfs:label "Book"@en;
           rdfs:subClassOf eurio:ProjectPublication;
           <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/Book>.
eurio:Coordinates a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:comment "The geo coordinates for a location of entities that participate in or form part of research projects."@en;
                  rdfs:isDefinedBy eurio:;
                  rdfs:label "Coordinates"@en;
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> eurio:longitude ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> eurio:latitude ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>];
                  <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/ns/locn#Geometry>;
                  <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/GeoCoordinates>.
eurio:Country a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A country"@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Country"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:hasEUCountryCode ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              eurio:AdministrativeArea;
              <http://www.w3.org/2004/02/skos/core#broadMatch> <http://schema.org/Country>.
eurio:DetectedAcronym a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:comment "Any acronym that has been detected, automatically or manually, from the description of an entity or from any other form of natural language text."@en;
                      rdfs:isDefinedBy eurio:;
                      rdfs:label "Detected Acronym"@en;
                      rdfs:subClassOf eurio:Acronym;
                      <http://www.w3.org/2002/07/owl#disjointWith> eurio:TitleAcronym.
eurio:ForProfitOrganisation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "A for profit entity"@en;
                            rdfs:isDefinedBy eurio:;
                            rdfs:label "For Profit Organisation"@en;
                            rdfs:subClassOf eurio:Organisation;
                            <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#ForProfitOrganisation>.
eurio:FundingAgency a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "An organisation that materially administrates funding schemes and disburses related grants. In the context of CORDIS, it represents the various European agencies responsible for funding research projects (e.g. ERC, EASME, REA, etc.)."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Funding Agency"@en;
                    rdfs:subClassOf eurio:Organisation;
                    <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#FundingAgency>.
eurio:FundingScheme a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "Set of rules and conditions which forms the basis for public funding of European research. In CORDIS, they represent the different legal frameworks (e.g. FP6, FP7, H2020). They can also be used to represent the different calls inside each framework by using the recursive relation “partOfScheme”."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Funding Scheme"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:isImplementedBy ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#allValuesFrom> xsd:nonNegativeInteger ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:duration ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:url ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:hasFundingSchemeCategory ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:title ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#FundingScheme>.
eurio:Grant a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:comment "A disbursed fund paid to a recipient or beneficiary within the context of a funded research project. In the context of CORDIS, it represents a grant of a specific EU programme (e.g. an H2020 grant)."@en;
            rdfs:isDefinedBy eurio:;
            rdfs:label "Grant"@en;
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:startDate ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:hasBeneficiary ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:isDisbursedBy ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#someValuesFrom> xsd:nonNegativeInteger ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:duration ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:hasFundingAmount ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:endDate ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:hasFundingScheme ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:funds ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>],
                            [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                             <http://www.w3.org/2002/07/owl#onProperty> eurio:hasPayment ; 
                             a <http://www.w3.org/2002/07/owl#Restriction>];
            <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#Grant>.
eurio:GrantPayment a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "A single payment to a recipient or beneficiary of a Grant within a research project."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Grant Payment"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:hasPaymentAmount ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#GrantPayment>.
eurio:HigherOrSecondaryEducation a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "Institution that provides education."@en;
                                 rdfs:isDefinedBy eurio:;
                                 rdfs:label "Higher Or Secondary Education"@en;
                                 rdfs:subClassOf eurio:Organisation;
                                 <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#EducationOrganisation>,
                                                                                  <http://schema.org/EducationalOrganization>.
eurio:JournalPaper a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "An article, typically the realization of a research paper reporting original research findings, published in a journal issue."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Journal Paper"@en;
                   rdfs:subClassOf eurio:ProjectPublication;
                   <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/JournalArticle>.
eurio:MonetaryAmount a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:comment "A monetary value or range. This type can be used to describe an amount of money such as $50 USD, or a range as in describing a bank account being suitable for a balance between £1,000 and £1,000,000 GBP, or the value of a salary, etc."@en;
                     rdfs:isDefinedBy eurio:;
                     rdfs:label "Monetary Amount"@en;
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> eurio:value ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>];
                     <http://www.w3.org/2004/02/skos/core#broadMatch> <http://schema.org/MonetaryAmount>.
eurio:NonPeerReviewedPublication a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:comment "A work that hasn't undergone peer reviewing prior to its publication."@en;
                                 rdfs:isDefinedBy eurio:;
                                 rdfs:label "Non Peer-Reviewed Publication"@en;
                                 rdfs:subClassOf eurio:ProjectPublication.
eurio:Organisation a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:comment "Represents a group of people, with the same purpose, organized together into a community or other social, commercial or political structure that participate in CORDIS projects."@en;
                   rdfs:isDefinedBy eurio:;
                   rdfs:label "Organisation"@en;
                   rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:identifier ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#allValuesFrom> eurio:OrganisationRole ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:hasRole ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:vatNumber ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:url ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:rcn ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:hasSite ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>],
                                   [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                    <http://www.w3.org/2002/07/owl#onProperty> eurio:legalName ; 
                                    a <http://www.w3.org/2002/07/owl#Restriction>];
                   <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#Organisation>,
                                                                    <http://www.w3.org/ns/org#Organization>.
eurio:OrganisationRole a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "Function assumed by or ascribed to an organisation that takes part in a particular project. In CORDIs, it represents roles such as coordinator, partner, consortium member, etc."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Organisation Role"@en;
                       rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> eurio:isRoleOf ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       [<http://www.w3.org/2002/07/owl#allValuesFrom> eurio:Organisation ; 
                                        <http://www.w3.org/2002/07/owl#onProperty> eurio:isRoleOf ; 
                                        a <http://www.w3.org/2002/07/owl#Restriction>],
                                       eurio:Role;
                       <http://www.w3.org/2004/02/skos/core#broadMatch> <https://w3id.org/dingo#OrganisationRole>.
eurio:OrganisationUnit a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A department or unit which is part of some larger Organization and only has full recognition within the context of that Organization. In CORDIS, it represents for instance the different departments of a university that participate in a particular project."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Organisation Unit"@en;
                       <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.w3.org/ns/org#OrganizationalUnit>.
eurio:PostalAddress a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:comment "The postal address of entities that participate in or form part of research projects."@en;
                    rdfs:isDefinedBy eurio:;
                    rdfs:label "Postal Address"@en;
                    rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:postalCode ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:streetAddress ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:addressCountry ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:fullAddress ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>],
                                    [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                                     <http://www.w3.org/2002/07/owl#onProperty> eurio:addressLocality ; 
                                     a <http://www.w3.org/2002/07/owl#Restriction>];
                    <http://www.w3.org/2004/02/skos/core#broadMatch> <http://schema.org/PostalAddress>,
                                                                     <http://www.w3.org/ns/locn#Address>.
eurio:ProceedingsPaper a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually presented at a workshop and published within a workshop proceedings volume."@en;
                       rdfs:isDefinedBy eurio:;
                       rdfs:label "Procedings Paper"@en;
                       rdfs:subClassOf eurio:ProjectPublication;
                       <http://www.w3.org/2004/02/skos/core#broadMatch> <http://purl.org/spar/fabio/WorkshopPaper>.
eurio:Project a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:comment "A planned research work that has one or more objectives (divided or not into tasks) and is conducted by one or more organisations. In CORDIS, it represents a project funded by an EU programme."@en;
              rdfs:isDefinedBy eurio:;
              rdfs:label "Project"@en;
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:title ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:abstract ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:isFundedBy ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:hasTotalCost ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:doi ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:signatureDate ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#minCardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:hasInvolvedParty ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:endDate ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:rcn ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:duration ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:projectStatus ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#maxCardinality> 1  ; 
                               <http://www.w3.org/2002/07/owl#onProperty> eurio:url ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>],
                              [<http://www.w3.org/2002/07/owl#cardinality> 1  ; 
