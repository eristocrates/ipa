                                           rdfs:label "family saccharomycetaceae value region";
                                           rdfs:subClassOf biotop:OrderSaccharomycetalesValueRegion.
biotop:FattyAcidMoleculeOrResidue ru:definition "Carboxylic acid often with a long unbranched aliphatic tail.";
                                  a owl:Class;
