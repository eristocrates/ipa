                                                                                 a <http://www.w3.org/2002/07/owl#Class>].
biotop:OrganismInteraction <http://purl.org/imbi/ru-meta.owl#definition> "action in which single biological organisms interact";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "organism interaction";
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasParticipant ; 
                                            <http://www.w3.org/2002/07/owl#allValuesFrom> biotop:LivingOrganism ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           biotop:Interacting.
biotop:OrganismPart <http://purl.org/imbi/ru-meta.owl#definition> "A well defined and circumscribed subdivision of an organism, not any arbitrary part. Macroscopic organism parts may be delimited mainly by natural boundaries but always exhibit at least small regions of fiat boundaries. An organism part may derive from an organism, i.e. it may continue to exist even when the organism does not exist any longer.";
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "organism part";
                    rdfs:subClassOf biotop:StructuredBiologicalCompoundByGranularityPartition;
                    <http://www.w3.org/2002/07/owl#disjointWith> biotop:Syncytium;
                    <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Tissue ; 
                                                                                                                     <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                     [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:MulticellularOrganism ; 
                                                                                                                     <http://www.w3.org/2002/07/owl#onProperty> biotop:originatesFrom ; 
                                                                                                                     a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                     a <http://www.w3.org/2002/07/owl#Class>].
biotop:OrganismProcess <http://purl.org/imbi/ru-meta.owl#definition> "any biological process that involves a whole organism";
                       a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:label "organism process";
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:BiologicalProcessualEntity
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:LivingOrganism ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> biotop:hasParticipant ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>].
biotop:Organization <http://purl.org/imbi/ru-meta.owl#definition> "collection of human or legal entities";
                    a <http://www.w3.org/2002/07/owl#Class>;
                    rdfs:label "organization";
                    rdfs:subClassOf biotop:LegalEntity.
biotop:ParentRole <http://purl.org/imbi/ru-meta.owl#definition> "the role an organism plays in relation to its children";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "parent role";
                  rdfs:subClassOf biotop:FamilyRole.
biotop:Particular <http://purl.org/imbi/ru-meta.owl#definition> """From an universalist point of view most BioTop classes can be considered the extension of universals. 

However, BioTop does not claim that all of its classes are the extension of universals and is agnostic with regard to the existence of universals and the delineation between universals and non-universals.
""";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  <http://www.w3.org/2002/07/owl#priorVersion> "particular entity".
biotop:ParticularEntity a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:subClassOf biotop:DEPRECATED.
biotop:PathologicalCondition <http://purl.org/imbi/ru-meta.owl#definition> """pathological structure, disposition, or process. This disjoint category helps properly represent diseases becauses it is often left open whether they are meant as pathological structure, disposition, or process.

In case this is to be left open, the relation has_locus should be used to connect them to anatomical entities""";
                             a <http://www.w3.org/2002/07/owl#Class>;
                             rdfs:label "pathological condition";
                             rdfs:subClassOf biotop:Condition;
                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:PathologicalDisposition
                                                                                                                       biotop:PathologicalProcess
                                                                                                                       biotop:PathologicalStructure) ; 
                                                                              a <http://www.w3.org/2002/07/owl#Class>].
biotop:PathologicalDisposition <http://purl.org/imbi/ru-meta.owl#definition> """any kind of disposition considered non-canonical. The criteria of canonicity are not further specified. 
The classification of certain dispositions as dysfunctional or pathological is dependent on a historic and cultural context. Dysfunction or disease therefore hasn't the status of a universal.""";
                               a <http://www.w3.org/2002/07/owl#Class>;
                               rdfs:label "pathological disposition";
                               rdfs:subClassOf biotop:Disposition;
                               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Disposition
                                                                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Canonicity
                                                                                                                                                                                                                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:NoncanonicalValueRegion ; 
                                                                                                                                                                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> biotop:inheresIn ; 
                                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                a <http://www.w3.org/2002/07/owl#Class>];
                               <http://www.w3.org/2002/07/owl#priorVersion> """prior label \"dysfunction\"""".
biotop:PathologicalProcess <http://purl.org/imbi/ru-meta.owl#definition> "a biological process which is non-canonic";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "pathological process";
                           <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:BiologicalProcessualEntity
                                                                                                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Canonicity
                                                                                                                                                                                                                            [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:NoncanonicalValueRegion ; 
                                                                                                                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                            a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                            <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProcessQuality ; 
                                                                                                                            a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                            a <http://www.w3.org/2002/07/owl#Class>].
biotop:PathologicalStaticProcessualEntity a <http://www.w3.org/2002/07/owl#Class>;
                                          rdfs:comment """Condition of an organism that deviates from what is considered normal. Often referred to by the terms \"disorder\", \"disease\", \"syndrome\", \"sign\", or \"symptom\". None of these denote clearly delineated ontological categories. 

See disease role etc.""";
                                          rdfs:label "pathological static processual entity";
                                          rdfs:subClassOf biotop:NoncanonicalStaticProcessualEntity;
                                          <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:StructuredBiologicalEntity
                                                                                                                                                                                                                                    [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:StructuredBiologicalEntity ; 
                                                                                                                                                                                                                                    <http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                                                                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                           a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> biotop:hasParticipant ; 
                                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Canonicity
                                                                                                                                                                                                                                           [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:PathologicalValueRegion ; 
                                                                                                                                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                           a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                           <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProcessQuality ; 
                                                                                                                                           a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                           a <http://www.w3.org/2002/07/owl#Class>];
                                          <http://www.w3.org/2002/07/owl#priorVersion> "pathological state".
