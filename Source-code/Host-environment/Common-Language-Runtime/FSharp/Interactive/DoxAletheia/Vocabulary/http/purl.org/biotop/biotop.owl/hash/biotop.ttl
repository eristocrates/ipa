<http://purl.org/biotop/biotop.owl> <http://purl.org/dc/elements/1.1/creator> "Stefan Schulz, Martin Boeker, Elena Beisswanger, Holger Stenzhorn, Djamila Raufie, Daniel Schober, Udo Hahn";
                                    <http://purl.org/dc/elements/1.1/description> """BioTop Website:
http://purl.org/biotop


See related articles at:

http://www.google.com/search?q=Schulz+BioTop+site:www.ncbi.nlm.nih.gov/pmc/articles+ontology+OR+ontologies""",
                                                                                  "Upper-Level ontology for Biology and Medicine. Compatible with BFO, DOLCE, and the UMLS Semantic Network (mapping files available)";
                                    <http://purl.org/dc/elements/1.1/format> "application/rdf+xml";
                                    <http://purl.org/dc/elements/1.1/identifier> "20120424",
                                                                                 "http://purl.org/biotop/biotop.owl";
                                    <http://purl.org/dc/elements/1.1/publisher> """Institute of Medical Biometry and Medical Informatics, University Medical Center Freiburg, Stefan-Meier-Strasse 26, 79104 Freiburg, Germany

Institute of Medical Informatics, Statistics and Documentation, Medical University of Graz, Auenbruggerplatz 2/V , 8036 Graz (Austria)""";
                                    <http://purl.org/dc/elements/1.1/rights> "http://creativecommons.org/licenses/by/3.0";
                                    <http://purl.org/dc/elements/1.1/subject> "Biology, Medicine",
                                                                              "An experimental top level ontology for biology and medicine.";
                                    <http://purl.org/dc/elements/1.1/title> "BioTop";
                                    a <http://www.w3.org/2002/07/owl#Ontology>;
                                    <http://www.w3.org/2002/07/owl#versionInfo> """Last modification
Apr 24, 2012 by Stefan Schulz""".
biotop:AcquiredAbnormalStructure <http://purl.org/imbi/ru-meta.owl#definition> "biological structure that deviates from what is considered normal and that evolved during lifetime";
                                 a <http://www.w3.org/2002/07/owl#Class>;
                                 rdfs:label "acquired abnormal structure";
                                 rdfs:subClassOf biotop:PathologicalStructure;
                                 <http://www.w3.org/2002/07/owl#disjointWith> biotop:CongenitalAbnormalStructure.
biotop:AcquiredPathologicalCondition <http://purl.org/imbi/ru-meta.owl#definition> "Ill-formed state of a biological entity,acquired after birth [steschu 20071010]";
                                     a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:label "acquired pathological condition";
                                     rdfs:subClassOf biotop:PathologicalValueRegion;
                                     <http://www.w3.org/2002/07/owl#disjointWith> biotop:CongenitalPathologicalCondition.
biotop:AcquiredPathologicalStaticProcessualEntity <http://purl.org/imbi/ru-meta.owl#definition> "pathological state acquired during lifetime";
                                                  a <http://www.w3.org/2002/07/owl#Class>;
                                                  rdfs:label "acquired pathological static processual entity";
                                                  <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:PathologicalStaticProcessualEntity
                                                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Canonicity
                                                                                                                                                                                                                                                   [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:AcquiredPathologicalCondition ; 
                                                                                                                                                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                                   a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProcessQuality ; 
                                                                                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                   a <http://www.w3.org/2002/07/owl#Class>];
                                                  <http://www.w3.org/2002/07/owl#priorVersion> "acquired pathological state".
biotop:Action <http://purl.org/imbi/ru-meta.owl#definition> "An action is a processual entity that that is promoted by an agent, having a clear role distinction between agent and patient";
              a <http://www.w3.org/2002/07/owl#Class>;
              rdfs:label "action";
              rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:TimeInterval ; 
                               <http://www.w3.org/2002/07/owl#onProperty> biotop:hasDuration ; 
                               a <http://www.w3.org/2002/07/owl#Restriction>];
              <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Process
                                                                                                               [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Particular ; 
                                                                                                               <http://www.w3.org/2002/07/owl#onProperty> biotop:hasAgent ; 
                                                                                                               a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                               a <http://www.w3.org/2002/07/owl#Class>].
biotop:ActionOnBiologicalSystem <http://purl.org/imbi/ru-meta.owl#definition> "an action which externally acts upon a biological system";
                                a <http://www.w3.org/2002/07/owl#Class>;
                                rdfs:label "action on biological system";
                                rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:LivingOrganism
                                                                                                                                          [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:LivingOrganism ; 
                                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> biotop:properPhysicalPartOf ; 
                                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                 a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                 <http://www.w3.org/2002/07/owl#onProperty> biotop:hasPatient ; 
                                                 a <http://www.w3.org/2002/07/owl#Restriction>],
                                                biotop:Action.
biotop:AdultOrganism <http://purl.org/imbi/ru-meta.owl#definition> "organism in reproductive phase";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "adult organism";
                     rdfs:subClassOf biotop:OrganismByDevelopmentalStagePartition;
                     <http://www.w3.org/2002/07/owl#disjointWith> biotop:EmbryonicOrganism,
                                                                  biotop:JuvenileOrganism;
                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:LivingOrganism
                                                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:DevelopmentalQuality
                                                                                                                                                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:AdultValueRegion ; 
                                                                                                                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                      a <http://www.w3.org/2002/07/owl#Class>].
biotop:AdultValueRegion a <http://www.w3.org/2002/07/owl#Class>;
                        rdfs:comment """\"adult\" as the value of a developmental stage. E.g. a 4 year old dog has a quality which has its value located in \"adult value region\".""";
                        rdfs:label "adult value region";
                        rdfs:subClassOf biotop:DevelopmentalValueRegion.
biotop:Affecting <http://purl.org/imbi/ru-meta.owl#definition> "Producing a direct effect on";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "affecting";
                 rdfs:subClassOf biotop:Action.
biotop:AgeQuality <http://purl.org/imbi/ru-meta.owl#definition> "the quality of having a livespan";
                  a <http://www.w3.org/2002/07/owl#Class>;
                  rdfs:label "age quality";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                                                                                                            biotop:MaterialObject) ; 
                                                                                                                                   a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:inheresIn ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                   [<http://www.w3.org/2002/07/owl#onProperty> biotop:inheresIn ; 
                                                                                   <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                                                                                                           biotop:MaterialObject) ; 
                                                                                                                                  a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>],
                                  biotop:ObjectQuality.
biotop:Alga a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "alga";
            rdfs:subClassOf biotop:Eukaryote.
biotop:AlphaParticle <http://purl.org/imbi/ru-meta.owl#definition> "Positively charged particles composed of two protons and two neutrons, i.e. equivalent to Helium nuclei ";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "alpha particle";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Electron ; 
                                                                                                                                    <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                                                                                                                    a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>]
                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Neutron ; 
                                                                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>],
                                     biotop:Atom.
biotop:AminoAcidMoleculeOrResidue <http://purl.org/imbi/ru-meta.owl#definition> "Amino Acids molecules or residues (residues as in peptide bonds)";
                                  a <http://www.w3.org/2002/07/owl#Class>;
                                  rdfs:comment "(QCR) ro:hasPart some CarbonHydrogenSubstructure and ((hasComponent myx 2 CarboxyGroup) and (hasComponent min 1 CarboxyGroup) and (hasComponent exactly 1 AminoGroup)) or ((hasComponent max 2 AminoGroup) and (hasComponent min 1 AminoGroup) and (hasComponent exactly 1 CarboxyGroup))",
                                               "In chemistry, an amino acid is any molecule that contains both amine and carboxyl functional groups. However, in biochemistry, this more general term is frequently used to refer to alpha amino acids (amino acids in which the amino and carboxylate functionalities are attached to the same carbon, called ?–carbon). Amino Acids have at least one amino and one carboxy group. Those having two carboxy groups have only one amino group and vice versa.";
                                  rdfs:label "amino acid molecule or residue";
                                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:SubmolecularGroup ; 
                                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                                  biotop:AminoAcidOrPeptideMoleculeOrStructure,
                                                  biotop:Monomer;
                                  <http://www.w3.org/2002/07/owl#disjointWith> biotop:PeptideStructure.
biotop:AminoAcidOrPeptideMoleculeOrStructure <http://purl.org/imbi/ru-meta.owl#definition> "amino acids as monomers and polymers";
                                             a <http://www.w3.org/2002/07/owl#Class>;
                                             rdfs:label "amino acid or peptide molecule or structure";
                                             rdfs:subClassOf biotop:OrganicMolecularEntityPartition.
biotop:AminoAcidSequence <http://purl.org/imbi/ru-meta.owl#definition> "Chain of amino acids, joined by peptide bonds. Folded or unfolded.";
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "amino acid sequence";
                         rdfs:subClassOf biotop:PeptideStructure;
                         <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:AminoAcidMoleculeOrResidue ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                          [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                                                                                          <http://www.w3.org/2002/07/owl#allValuesFrom> biotop:AminoAcidMoleculeOrResidue ; 
                                                                                                                          a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
