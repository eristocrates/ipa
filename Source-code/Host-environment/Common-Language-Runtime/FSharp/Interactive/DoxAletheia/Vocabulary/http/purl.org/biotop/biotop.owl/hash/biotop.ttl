                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>],
                                 biotop:Fungus.
biotop:YeastPopulation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "yeast population";
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Population
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:YeastCell ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#allValuesFrom> biotop:YeastCell ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>].
biotop:abstractPartOf <http://purl.org/imbi/ru-meta.owl#definition> """abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. 

Example: a header is an abstract part of a jpg file.""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:InformationObject;
                      rdfs:label "abstract part of";
                      rdfs:range biotop:InformationObject;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasAbstractPart.
biotop:abstractlyRelatedTo <http://purl.org/imbi/ru-meta.owl#definition> """Relation in which immaterial entities (information entities, roles, qualities) are involved. 

abstractlyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:label "abstractly related to";
                           rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
biotop:agentIn <http://purl.org/imbi/ru-meta.owl#definition> """agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.
This is the reason why agentIn is subsumed by the relation causedBy. 

Example: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. """;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:InformationObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "agent in";
               rdfs:range biotop:Process;
               rdfs:subPropertyOf biotop:causes,
                                  biotop:participatesIn.
biotop:attachedTo <http://purl.org/imbi/ru-meta.owl#definition> """Contiguous with a clear bona fide boundary between the connected parts.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                        biotop:MaterialObject) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:label "attached to";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf biotop:contiguousWith.
biotop:bearerOf <http://purl.org/imbi/ru-meta.owl#definition> """inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.

(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")

Example: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick.""";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                      biotop:MaterialObject) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "bearer of";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                     biotop:InformationObject
                                                                     biotop:ObjectQuality
                                                                     biotop:Role) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:locusOf;
                <http://www.w3.org/2002/07/owl#inverseOf> biotop:inheresIn.
biotop:branchOf <http://purl.org/imbi/ru-meta.owl#definition> """A is a branch of B if it is contiguous with B and if some flow of matter or energy of information flows form B to A.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                      biotop:MaterialObject) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "branch of";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:attachedTo;
                <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasBranch.
biotop:causallyRelatedTo <http://purl.org/imbi/ru-meta.owl#definition> """Expresses a causal chain between material or processual entities.

causallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:label "causally related to";
                         rdfs:subPropertyOf <http://www.w3.org/2002/07/owl#topObjectProperty>.
biotop:causedBy <http://purl.org/imbi/ru-meta.owl#definition> """Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. 
 """;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain biotop:Process;
                rdfs:label "caused by";
                rdfs:subPropertyOf biotop:causallyRelatedTo.
biotop:causes <http://purl.org/imbi/ru-meta.owl#definition> """Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. 
 """;
              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
              rdfs:label "causes";
              rdfs:range biotop:Process;
              rdfs:subPropertyOf biotop:causallyRelatedTo;
              <http://www.w3.org/2002/07/owl#inverseOf> biotop:causedBy.
biotop:componentPartOf <http://purl.org/imbi/ru-meta.owl#definition> """The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. 

The choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.

Components should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.

Examples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule.""";
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain biotop:MaterialObject;
                       rdfs:label "component part of";
                       rdfs:range biotop:MaterialObject;
                       rdfs:subPropertyOf biotop:properPhysicalPartOf;
                       <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasComponentPart.
biotop:contiguousWith <http://purl.org/imbi/ru-meta.owl#definition> """ContiguousWith describes the connection between two material objects that abut and can transmit forces.

 """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "contiguous with";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:physicallyAdjacentTo.
biotop:continuousWith <http://purl.org/imbi/ru-meta.owl#definition> """Contiguous with a clear bona fide boundary between the connected parts.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "continuous with";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:contiguousWith.
biotop:cooccurringWith <http://purl.org/imbi/ru-meta.owl#definition> "The relation coocurring with relates two processes if their temporal extensions overlap.";
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                       rdfs:domain biotop:Process;
                       rdfs:label "cooccurring with";
                       rdfs:range biotop:Process;
                       rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:denotedBy <http://purl.org/imbi/ru-meta.owl#definition> """denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. 

Example: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"""";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "denoted by";
                 rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:denotes <http://purl.org/imbi/ru-meta.owl#definition> """denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. 

Example: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"""";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain biotop:InformationObject;
               rdfs:label "denotes";
               rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:derivedInto <http://purl.org/imbi/ru-meta.owl#definition> """DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. 

There is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. 

These relations are borrowed from the OBO Relation Ontology

Example:
\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46""";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                   rdfs:domain biotop:MaterialObject;
                   rdfs:label "derived into";
                   rdfs:range biotop:MaterialObject;
                   rdfs:subPropertyOf biotop:hasOrigin;
                   <http://www.w3.org/2002/07/owl#inverseOf> biotop:derivesFrom.
biotop:derivesFrom <http://purl.org/imbi/ru-meta.owl#definition> """DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. 

There is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. 

These relations are borrowed from the OBO Relation Ontology

Example:
\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46""";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                     <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                   rdfs:domain biotop:MaterialObject;
                   rdfs:label "derives from";
                   rdfs:range biotop:MaterialObject;
                   rdfs:subPropertyOf biotop:originatesFrom.
biotop:encodedBy <http://purl.org/imbi/ru-meta.owl#definition> """EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.

Example: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) """;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "encodedBy";
                 rdfs:range biotop:InformationObject;
                 rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                 <http://www.w3.org/2002/07/owl#inverseOf> biotop:encodes.
biotop:encodes <http://purl.org/imbi/ru-meta.owl#definition> """EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.

Example: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) """;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:domain biotop:InformationObject;
               rdfs:label "encodes";
               rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:featureOf a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "feature of";
                 rdfs:subPropertyOf biotop:DEPRECATED_RELATION;
                 <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasFeature.
biotop:granularPartOf <http://purl.org/imbi/ru-meta.owl#definition> """hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. 

Generally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.

Example: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "granular part of";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:properPhysicalPartOf;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasGranularPart.
biotop:hasAbstractPart <http://purl.org/imbi/ru-meta.owl#definition> """abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. 

For instance, a header is an abstract part of a jpg file.""";
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain biotop:InformationObject;
                       rdfs:label "has abstract part";
                       rdfs:range biotop:InformationObject;
                       rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:hasAgent <http://purl.org/imbi/ru-meta.owl#definition> """agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.
This is the reason why agentIn is subsumed by the relation causedBy. 

Example: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. """;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain biotop:Process;
                rdfs:label "has agent";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:InformationObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:causedBy,
                                   biotop:hasParticipant;
                <http://www.w3.org/2002/07/owl#inverseOf> biotop:agentIn.
biotop:hasBranch <http://purl.org/imbi/ru-meta.owl#definition> """B hasBranch A if it is contiguous with B and if some flow of matter or energy of information flows form B to A.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "has branch";
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                      biotop:MaterialObject) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:subPropertyOf biotop:attachedTo.
biotop:hasComponentPart <http://purl.org/imbi/ru-meta.owl#definition> """The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. 

The choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.

Components should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.

Examples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule.""";
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                              biotop:MaterialObject) ; 
                                     a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:label "has component part";
                        rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                             biotop:MaterialObject) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>],
                                   biotop:MaterialObject;
                        rdfs:subPropertyOf biotop:hasProperPhysicalPart.
biotop:hasDuration <http://purl.org/imbi/ru-meta.owl#definition> "hasDuration relates a process with the time interval it covers.";
                   a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                   rdfs:domain biotop:Process;
                   rdfs:label "has duration";
                   rdfs:range biotop:TimeInterval;
                   rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:hasFeature a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:label "has feature";
                  rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:hasGranularPart <http://purl.org/imbi/ru-meta.owl#definition> """hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. 

Generally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.

Example: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water""";
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                             biotop:MaterialObject) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:label "has granular part";
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:subPropertyOf biotop:hasProperPhysicalPart.
biotop:hasLocus <http://purl.org/imbi/ru-meta.owl#definition> """hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.

See property chains: a participant of a process at a given time is located where the process is located. 

Example: A heart pumping process is located in a heart. """;
                a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                      biotop:ImmaterialObject
                                                                      biotop:InformationObject
                                                                      biotop:MaterialObject
                                                                      biotop:ObjectQuality
                                                                      biotop:Process
                                                                      biotop:Role) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "has locus";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:spatiallyRelatedTo;
                <http://www.w3.org/2002/07/owl#inverseOf> biotop:locusOf;
                <http://www.w3.org/2002/07/owl#propertyChainAxiom> (biotop:participatesIn
                                                                    biotop:hasLocus).
biotop:hasOrigin a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:label "has origin";
                 rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:hasOriginalPart <http://purl.org/imbi/ru-meta.owl#definition> """hasOriginalPart (inverse: originalPartOf). 

original parts of A are no longer parts of A but were parts of A when they came into existence. 

Example:
Apples harvested from an apple tree, tissue samples in a lab. """;
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                       rdfs:domain biotop:MaterialObject;
                       rdfs:label "has original part";
                       rdfs:range biotop:MaterialObject;
                       rdfs:subPropertyOf biotop:hasOrigin;
                       <http://www.w3.org/2002/07/owl#inverseOf> biotop:originalPartOf.
biotop:hasOriginatingPhysicalPart <http://purl.org/imbi/ru-meta.owl#definition> """originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)

An originating physical part is a proper physical part that has never ceased to be part of the object it is related to. 

Example: my brain is an originating physical part of my body """;
                                  a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                    <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                                  rdfs:domain biotop:MaterialObject;
                                  rdfs:label "has originating physical part";
                                  rdfs:range biotop:MaterialObject;
                                  rdfs:subPropertyOf biotop:hasOrigin,
                                                     biotop:hasProperPhysicalPart;
                                  <http://www.w3.org/2002/07/owl#inverseOf> biotop:originatingPhysicalPartOf.
biotop:hasOutcome <http://purl.org/imbi/ru-meta.owl#definition> """outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either
- a) comes into being during the process
or - b) undergoes some change during the process, so that it instantiates a different class at the end of the process 
and it constitutes (one of) the main result(s) of the process

Example: a Protein molecule is the outcome of a translation process.""";
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain biotop:Process;
                  rdfs:label "has outcome";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:InformationObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf biotop:hasParticipant.
biotop:hasParticipant <http://purl.org/imbi/ru-meta.owl#definition> """HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. 

Process participation is distinguished from process location.

Example: 

An urea molecule which is excreted in a renal filtration process is participant of this process.

A person who undergoes an operation is participant of this process.""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:Process;
                      rdfs:label "has participant";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:InformationObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:processuallyRelatedTo;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:participatesIn.
biotop:hasPatient <http://purl.org/imbi/ru-meta.owl#definition> """patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  

Example: A prey is the patient in a hunting process; a solute is the patient in a solving process. """;
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                  rdfs:domain biotop:Process;
                  rdfs:label "has patient";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:InformationObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf biotop:hasParticipant;
                  <http://www.w3.org/2002/07/owl#inverseOf> biotop:patientIn.
biotop:hasPhysicalPart <http://purl.org/imbi/ru-meta.owl#definition> """hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is reflexive, i.e. every physical object has itself as a physical part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"""";
                       a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                         <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                       rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                             biotop:MaterialObject) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:label "has physical part";
                       rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                       rdfs:subPropertyOf biotop:physicalLocationOf.
biotop:hasPointInTime <http://purl.org/imbi/ru-meta.owl#definition> """hasPointInTome relates a processual entity with some point in the interval it occupies. 
If there is no temporal extension (process boundary) it relates it to the time it occurs. """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:Process;
                      rdfs:label "has point in time";
                      rdfs:range biotop:PointInTime;
                      rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:hasProcessQuality <http://purl.org/imbi/ru-meta.owl#definition> """processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. 

Example: The process of heart beating has the process quality heart rate.""";
                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain biotop:Process;
                         rdfs:label "has process quality";
                         rdfs:range biotop:ProcessQuality;
                         rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                         <http://www.w3.org/2002/07/owl#inverseOf> biotop:processQualityOf.
biotop:hasProcessRole <http://purl.org/imbi/ru-meta.owl#definition> """processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. 

Example: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor.""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:Process;
                      rdfs:label "has process role";
                      rdfs:range biotop:Role;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:hasProcessualPart <http://purl.org/imbi/ru-meta.owl#definition> """hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).

Example: G1 phase is a processual part of the process mitosis.""";
                         a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                           <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                         rdfs:domain biotop:Process;
                         rdfs:label "has processual part";
                         rdfs:range biotop:Process;
                         rdfs:subPropertyOf biotop:temporallyRelatedTo;
                         <http://www.w3.org/2002/07/owl#inverseOf> biotop:processualPartOf.
biotop:hasProperPhysicalPart <http://purl.org/imbi/ru-meta.owl#definition> """hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"

Examples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer.""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                               <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                   biotop:MaterialObject) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:label "has proper physical part";
                             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                  biotop:MaterialObject) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:subPropertyOf biotop:hasPhysicalPart.
biotop:hasRealization <http://purl.org/imbi/ru-meta.owl#definition> """Realization occurs if a disposition or function manifests itself as a process. 

Example: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                            biotop:InformationObject
                                                                            biotop:ObjectQuality
                                                                            biotop:Role) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "has realization";
                      rdfs:range biotop:Process;
                      rdfs:subPropertyOf biotop:causes;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:realizationOf.
biotop:inheresIn <http://purl.org/imbi/ru-meta.owl#definition> """inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.

(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")

Example: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick.""";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                       biotop:InformationObject
                                                                       biotop:ObjectQuality
                                                                       biotop:Role) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "inheres in";
                 rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                      biotop:MaterialObject) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:subPropertyOf biotop:hasLocus.
biotop:isAbout <http://purl.org/imbi/ru-meta.owl#definition> "replaced by denotes";
               a <http://www.w3.org/2002/07/owl#ObjectProperty>;
               rdfs:label "is about";
               rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:locusOf <http://purl.org/imbi/ru-meta.owl#definition> """hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.

See property chains: a participant of a process at a given time is located where the process is located. 

Example: A heart pumping process is located in a heart. """;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#TransitiveProperty>;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "locus of";
               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                    biotop:ImmaterialObject
                                                                    biotop:InformationObject
                                                                    biotop:MaterialObject
                                                                    biotop:ObjectQuality
                                                                    biotop:Process
                                                                    biotop:Role) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:originalPartOf <http://purl.org/imbi/ru-meta.owl#definition> """hasOriginalPart (inverse: originalPartOf). 

original parts of A are no longer parts of A but were parts of A when they came into existence. 

Example:
Apples harvested from an apple tree, tissue samples in a lab. """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:MaterialObject;
                      rdfs:label "original part of";
                      rdfs:range biotop:MaterialObject;
                      rdfs:subPropertyOf biotop:originatesFrom.
biotop:originatesFrom <http://purl.org/imbi/ru-meta.owl#definition> """originatesFrom relates two material objects one of which originates from the other in a very broad sense. 

It includes derivation (in the OBO RO sense), actual actual parts (provided they were always parts), as well as original (historical) parts.

Examples: see Subrelations""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:MaterialObject;
                      rdfs:label "originates from";
                      rdfs:range biotop:MaterialObject;
                      rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:originatingPhysicalPartOf <http://purl.org/imbi/ru-meta.owl#definition> """originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)

An originating physical part is a proper physical part that has never ceased to be part of the object it is related to. 

Example: my brain is an originating physical part of my body """;
                                 a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                   <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                                 rdfs:domain biotop:MaterialObject;
                                 rdfs:label "originating physical part of";
                                 rdfs:range biotop:MaterialObject;
                                 rdfs:subPropertyOf biotop:originatesFrom,
                                                    biotop:properPhysicalPartOf.
biotop:outcomeOf <http://purl.org/imbi/ru-meta.owl#definition> """outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either
- a) comes into being during the process
or - b) undergoes some change during the process, so that it instantiates a different class at the end of the process 
and it constitutes (one of) the main result(s) of the process

Example: a Protein molecule is the outcome of a translation process.""";
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:InformationObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "outcome of";
                 rdfs:range biotop:Process;
                 rdfs:subPropertyOf biotop:participatesIn;
                 <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasOutcome.
biotop:participatesIn <http://purl.org/imbi/ru-meta.owl#definition> """HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. 

Process participation is distinguished from process location.

Example: 

An urea molecule which is excreted in a renal filtration process is participant of this process.

A person who undergoes an operation is participant of this process.""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:InformationObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "participates in";
                      rdfs:range biotop:Process;
                      rdfs:subPropertyOf biotop:processuallyRelatedTo.
biotop:patientIn <http://purl.org/imbi/ru-meta.owl#definition> """patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  

Example: A prey is the patient in a hunting process; a solute is the patient in a solving process. """;
                 a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                 rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                       biotop:InformationObject
                                                                       biotop:MaterialObject) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                 rdfs:label "patient in";
                 rdfs:range biotop:Process;
                 rdfs:subPropertyOf biotop:participatesIn.
biotop:physicalLocationOf <http://purl.org/imbi/ru-meta.owl#definition> """physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. 

Generally, this relation is further specificed in terms of parthood or containment

Examples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. """;
                          a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                biotop:MaterialObject) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:label "physical location of";
                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                               biotop:MaterialObject) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:subPropertyOf biotop:locusOf,
                                             biotop:physicallyConnectedTo.
biotop:physicalPartOf <http://purl.org/imbi/ru-meta.owl#definition> """hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is reflexive, i.e. every physical object has itself as a physical part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                        <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "physical part of";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:physicallyLocatedIn;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasPhysicalPart.
biotop:physicallyAdjacentTo <http://purl.org/imbi/ru-meta.owl#definition> """physicalAdjacentTo relates two physical objects that abut without physical overlap. 

Examples: see subrelations""";
                            a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                  biotop:MaterialObject) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:label "physically adjacent to";
                            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyBoundedBy <http://purl.org/imbi/ru-meta.owl#definition> """physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. 

Example: the surface of my liver physically bounds my liver. """;
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:label "physically bounded by";
                           rdfs:range biotop:PhysicalBoundary;
                           rdfs:subPropertyOf biotop:hasProperPhysicalPart;
                           <http://www.w3.org/2002/07/owl#inverseOf> biotop:physicallyBounds.
biotop:physicallyBounds <http://purl.org/imbi/ru-meta.owl#definition> """physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. 

Example: the surface of my liver physically bounds my liver. """;
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain biotop:PhysicalBoundary;
                        rdfs:label "physically bounds";
                        rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                             biotop:MaterialObject) ; 
                                    a <http://www.w3.org/2002/07/owl#Class>];
                        rdfs:subPropertyOf biotop:properPhysicalPartOf.
biotop:physicallyConnectedTo <http://purl.org/imbi/ru-meta.owl#definition> """physicallyConnectedTo (a symmetric relation) relates two spatially relevant entities (material entities or spaces) which overlap at least one point in space. 

Example: France is connected to Germany, my optic nerve is connected to my eyeball.""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                               <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                   biotop:MaterialObject) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:label "physically connected to";
                             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                  biotop:MaterialObject) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:physicallyContainedIn <http://purl.org/imbi/ru-meta.owl#definition> """Containment is location without parthood. E.g. Food is contained in the stomach. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                   biotop:MaterialObject) ; 
                                          a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:label "physically contained in";
                             rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                  biotop:MaterialObject) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                             rdfs:subPropertyOf biotop:physicallyLocatedIn;
                             <http://www.w3.org/2002/07/owl#inverseOf> biotop:physicallyContains.
biotop:physicallyContains <http://purl.org/imbi/ru-meta.owl#definition> """Containment is location without parthood. E.g. Food is contained in the stomach. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118  """;
                          a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                biotop:MaterialObject) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:label "physically contains";
                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                               biotop:MaterialObject) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:subPropertyOf biotop:physicalLocationOf.
biotop:physicallyDisconnectedFrom <http://purl.org/imbi/ru-meta.owl#definition> """No sharing of parts and no sharing of boundaries. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                                  a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                                    <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                        biotop:MaterialObject) ; 
                                               a <http://www.w3.org/2002/07/owl#Class>];
                                  rdfs:label "physically disconnected from";
                                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                       biotop:MaterialObject) ; 
                                              a <http://www.w3.org/2002/07/owl#Class>];
                                  rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:physicallyInterconnects a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                     biotop:MaterialObject) ; 
                                            a <http://www.w3.org/2002/07/owl#Class>];
                               rdfs:label "physically interconnects";
                               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                    biotop:MaterialObject) ; 
                                           a <http://www.w3.org/2002/07/owl#Class>];
                               rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyLocatedIn <http://purl.org/imbi/ru-meta.owl#definition> """physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. 

Generally, this relation is further specificed in terms of parthood or containment

Examples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. """;
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                             <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:label "physically located in";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                biotop:MaterialObject) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:subPropertyOf biotop:hasLocus,
                                              biotop:physicallyConnectedTo;
                           <http://www.w3.org/2002/07/owl#inverseOf> biotop:physicalLocationOf.
biotop:physicallySurroundedBy <http://purl.org/imbi/ru-meta.owl#definition> """Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)
""";
                              a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                              rdfs:label "physically surrounded by";
                              rdfs:subPropertyOf biotop:physicallyConnectedTo;
                              <http://www.w3.org/2002/07/owl#inverseOf> biotop:physicallySurrounds.
biotop:physicallySurrounds <http://purl.org/imbi/ru-meta.owl#definition> """Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)
""";
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:label "physically surrounds";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                biotop:MaterialObject) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyTraverses <http://purl.org/imbi/ru-meta.owl#definition> "crossing over and crossing through";
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:label "physically traverses";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                biotop:MaterialObject) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:precededBy <http://purl.org/imbi/ru-meta.owl#definition> """precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. 

Example: fecundation preceeds embryonic development.""";
                  a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                  rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Process
                                                                        biotop:Time) ; 
                               a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:label "preceded by";
                  rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Process
                                                                       biotop:Time) ; 
                              a <http://www.w3.org/2002/07/owl#Class>];
                  rdfs:subPropertyOf biotop:temporallyRelatedTo;
                  <http://www.w3.org/2002/07/owl#inverseOf> biotop:precedes.
biotop:precedes <http://purl.org/imbi/ru-meta.owl#definition> """precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. 

Example: fecundation preceeds embryonic development.""";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                  <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Process
                                                                      biotop:Time) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "precedes";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Process
                                                                     biotop:Time) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:processQualityOf <http://purl.org/imbi/ru-meta.owl#definition> """processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. 

Example: The process of heart beating has the process quality heart rate.""";
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                        rdfs:domain biotop:ProcessQuality;
                        rdfs:label "process quality of";
                        rdfs:range biotop:Process;
                        rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:processRoleOf <http://purl.org/imbi/ru-meta.owl#definition> """processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. 

Example: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor.""";
                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain biotop:Role;
                     rdfs:label "process role of";
                     rdfs:range biotop:Process;
                     rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                     <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasProcessRole.
biotop:processualPartOf <http://purl.org/imbi/ru-meta.owl#definition> """hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).

Example: G1 phase is a processual part of the process mitosis.""";
                        a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                          <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                        rdfs:domain biotop:Process;
                        rdfs:label "processual part of";
                        rdfs:range biotop:Process;
                        rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:processuallyRelatedTo <http://purl.org/imbi/ru-meta.owl#definition> """Relations that connect processes with other entities.

processuallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                             a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                             rdfs:label "processually related to".
biotop:properPhysicalPartOf <http://purl.org/imbi/ru-meta.owl#definition> """hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"

Examples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer.""";
                            a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                              <http://www.w3.org/2002/07/owl#TransitiveProperty>;
                            rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                  biotop:MaterialObject) ; 
                                         a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:label "proper physical part of";
                            rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                 biotop:MaterialObject) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                            rdfs:subPropertyOf biotop:physicalPartOf;
                            <http://www.w3.org/2002/07/owl#inverseOf> biotop:hasProperPhysicalPart.
biotop:qualityLocated <http://purl.org/imbi/ru-meta.owl#definition> """qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. 
Value regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.

Example: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   """;
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain biotop:Quality;
                      rdfs:label "quality located";
                      rdfs:range biotop:ValueRegion;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:qualityLocationOf.
biotop:qualityLocationOf <http://purl.org/imbi/ru-meta.owl#definition> """qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. 
Value regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.

Example: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   """;
                         a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                         rdfs:domain biotop:ValueRegion;
                         rdfs:label "quality location of";
                         rdfs:range biotop:Quality;
                         rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:ramificationOf <http://purl.org/dc/elements/1.1/source> """Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
			Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                      a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                      rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                            biotop:MaterialObject) ; 
                                   a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:label "ramification of";
                      rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                           biotop:MaterialObject) ; 
                                  a <http://www.w3.org/2002/07/owl#Class>];
                      rdfs:subPropertyOf biotop:DEPRECATED_RELATION;
                      <http://www.w3.org/2002/07/owl#inverseOf> biotop:ramifies.
biotop:ramifies <http://purl.org/dc/elements/1.1/source> """Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
			Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                      biotop:MaterialObject) ; 
                             a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:label "ramifies";
                rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
                rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:realizationOf <http://purl.org/imbi/ru-meta.owl#definition> """Realization occurs if a disposition or function manifests itself as a process. 

Example: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  """;
                     a <http://www.w3.org/2002/07/owl#ObjectProperty>;
                     rdfs:domain biotop:Process;
                     rdfs:label "realization of";
                     rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                          biotop:InformationObject
                                                                          biotop:ObjectQuality
                                                                          biotop:Role) ; 
                                 a <http://www.w3.org/2002/07/owl#Class>];
                     rdfs:subPropertyOf biotop:causedBy.
biotop:spatiallyRelatedTo <http://purl.org/imbi/ru-meta.owl#definition> """Most general relation that relates entities in terms of physical location.

spatiallyRelatedTo is meant as an organizing parent. It should not be asserted. """;
                          a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                            <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                          rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                                biotop:ImmaterialObject
                                                                                biotop:InformationObject
                                                                                biotop:MaterialObject
                                                                                biotop:ObjectQuality
                                                                                biotop:Process
                                                                                biotop:Role) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>];
                          rdfs:label "spatially related to";
                          rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:Disposition
                                                                               biotop:ImmaterialObject
                                                                               biotop:InformationObject
                                                                               biotop:MaterialObject
                                                                               biotop:ObjectQuality
                                                                               biotop:Process
                                                                               biotop:Role) ; 
                                      a <http://www.w3.org/2002/07/owl#Class>].
biotop:temporallyRelatedTo <http://purl.org/imbi/ru-meta.owl#definition> """The temporal arrangement of processes, events, durations and temporal measurements.

temporallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                           a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                             <http://www.w3.org/2002/07/owl#SymmetricProperty>;
                           rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ObjectQuality
                                                                                 biotop:Process
                                                                                 biotop:Time) ; 
                                        a <http://www.w3.org/2002/07/owl#Class>];
                           rdfs:label "temporally related to";
                           rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ObjectQuality
                                                                                biotop:Process
                                                                                biotop:Time) ; 
                                       a <http://www.w3.org/2002/07/owl#Class>].
biotop:touches <http://purl.org/imbi/ru-meta.owl#definition> """Abutting without mechanical connection.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 """;
               a <http://www.w3.org/2002/07/owl#ObjectProperty>,
                 <http://www.w3.org/2002/07/owl#SymmetricProperty>;
               rdfs:domain [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                     biotop:MaterialObject) ; 
                            a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:label "touches";
               rdfs:range [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                    biotop:MaterialObject) ; 
                           a <http://www.w3.org/2002/07/owl#Class>];
               rdfs:subPropertyOf biotop:physicallyAdjacentTo.
