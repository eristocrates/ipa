                                    owl:members (biotop:GroupInteraction
                                                 biotop:OrganismInteraction
                                                 biotop:SubstanceInteraction).
_:B249469e9ebe3e189a5331168a4f78842 a owl:AllDisjointClasses;
                                    owl:members (biotop:KingdomAnimaliaValueRegion
                                                 biotop:KingdomArchaeaValueRegion
                                                 biotop:KingdomBacteriaValueRegion
                                                 biotop:KingdomChromistaValueRegion
                                                 biotop:KingdomFungiValueRegion
                                                 biotop:KingdomPlantaeValueRegion
                                                 biotop:KingdomProtozoaValueRegion
                                                 biotop:KingdomVirusesValueRegion).
_:B2b18990aec9a9656ea4f7a10efb7f4ce a owl:AllDisjointClasses;
                                    owl:members (biotop:BodySystem
                                                 biotop:Organ
                                                 biotop:OrganPart).
_:B30ea7d9cb386e0f41ec7f6bef319fea9 a owl:AllDisjointClasses;
                                    owl:members (biotop:CellMembrane
                                                 biotop:CellNucleus
                                                 biotop:Cytoplasm
                                                 biotop:Genome).
