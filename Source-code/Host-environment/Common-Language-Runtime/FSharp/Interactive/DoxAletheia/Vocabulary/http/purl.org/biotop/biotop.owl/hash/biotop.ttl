                                                   owl:onProperty biotop:hasComponentPart ; 
                                                   a owl:Restriction],
                                                  biotop:OrganicMolecularEntityPartition.
biotop:FindingRole ru:definition "The role that may inhere in any biological structure, state, or process that is of reportable interest in a diagnostic process.";
                   a owl:Class;
                   rdfs:label "finding role";
                   rdfs:subClassOf biotop:HealthRelatedRole.
biotop:Fish a owl:Class;
            rdfs:label "fish";
            rdfs:subClassOf biotop:Vertebrate.
biotop:FoodRole ru:definition "The role of an entity components of which are used for supplying energy and vital substrates to a biological system";
                a owl:Class;
                rdfs:label "food role";
                rdfs:subClassOf biotop:HealthRelatedRole.
biotop:FruitFly a owl:Class;
                rdfs:comment "one drosophila melanogaster";
                rdfs:label "fruit fly";
                rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                         [owl:someValuesFrom biotop:SpeciesDrosophilaMelanogasterValueRegion ; 
                                                                         owl:onProperty biotop:qualityLocated ; 
                                                                         a owl:Restriction]) ; 
                                                     a owl:Class] ; 
                                 owl:onProperty biotop:bearerOf ; 
                                 a owl:Restriction],
                                biotop:Insect.
biotop:FruitFlyPopulation a owl:Class;
                          rdfs:comment "EXAMPLE OF POPULATION";
                          rdfs:label "fruit fly population";
                          owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                   [owl:someValuesFrom biotop:FruitFly ; 
                                                                   owl:onProperty biotop:hasGranularPart ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty biotop:hasGranularPart ; 
                                                                   owl:allValuesFrom biotop:FruitFly ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
biotop:Function ru:definition """A classical definition of function according to Wright is that the function F of X is Z means that X is there because it Zs, and Z is a consequence of X being there. 

For artefacts, functions are distinguished from dispositions by the purpose they have been built. For example, a hammer has the function to drive in nails, but not to be used as a weapon. However, it has the disposition to be used as a weapon under certain circumstances.

For biological objects, which developed by evolution, the definition of function is still subject to controversy (e.g. Barry Smith's view of function as pertaining to a canonical life plan, cf. 
http://www.slideserve.com/presentation/103450/The-Canonical-Life). 

In BFO \"Disposition\" and \"Function\" are siblings, in BioTop Function is more specific.
 """;
                a owl:Class;
                rdfs:label "function";
                rdfs:subClassOf [owl:onProperty biotop:hasRealization ; 
                                 owl:allValuesFrom biotop:Process ; 
                                 a owl:Restriction],
                                biotop:Disposition.
biotop:Fungus ru:definition "Heterotrophic organisms characterized by a chitinous cell wall.";
              a owl:Class;
              rdfs:comment "On fungus organisms";
              rdfs:label "fungus";
              rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                       [owl:someValuesFrom biotop:KingdomFungiValueRegion ; 
                                                                       owl:onProperty biotop:qualityLocated ; 
                                                                       a owl:Restriction]
                                                                       [owl:onProperty biotop:qualityLocated ; 
                                                                       owl:allValuesFrom biotop:KingdomFungiValueRegion ; 
                                                                       a owl:Restriction]) ; 
                                                   a owl:Class] ; 
                               owl:onProperty biotop:bearerOf ; 
                               a owl:Restriction],
                              biotop:Eukaryote.
biotop:FungusPopulation a owl:Class;
                        rdfs:comment "EXAMPLE OF POPULATION";
                        rdfs:label "fungus population";
                        owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                 [owl:someValuesFrom biotop:Fungus ; 
                                                                 owl:onProperty biotop:hasGranularPart ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty biotop:hasGranularPart ; 
                                                                 owl:allValuesFrom biotop:Fungus ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
biotop:GaseousValueRegion a owl:Class;
                          rdfs:comment """\"gaseous\" as the value of a states of matter.  E.g. a portion of air has a quality which has its value located in \"gaseous value region\"""";
                          rdfs:label "gaseous value region";
                          rdfs:subClassOf biotop:StateOfMatterValueRegion.
biotop:Gene ru:definition "region of nucleic acid macromolecule that carry information";
            a owl:Class;
            rdfs:label "gene";
            rdfs:subClassOf [owl:someValuesFrom biotop:GeneticInformation ; 
                             owl:onProperty biotop:bearerOf ; 
                             a owl:Restriction],
                            biotop:NucleicAcidStructure;
            owl:versionInfo "TODO: Discuss whether all genes are DNA !".
biotop:GeneInformation ru:definition "Information that resides on a gene.";
                       a owl:Class;
                       rdfs:label "gene information";
                       rdfs:subClassOf biotop:DEPRECATED.
biotop:GeneRegion ru:definition "part of a gene";
                  a owl:Class;
                  rdfs:label "gene region";
                  rdfs:subClassOf biotop:DEPRECATED.
biotop:GeneticInformation ru:definition "information that can be interpreted by a genetic code";
                          a owl:Class;
