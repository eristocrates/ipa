                                                                a owl:Class] ; 
                                            owl:onProperty biotop:bearerOf ; 
                                            a owl:Restriction],
                                           biotop:BacterialCell.
biotop:EscherichiaColiPopulation a owl:Class;
                                 rdfs:comment "EXAMPLE OF POPULATION";
                                 rdfs:label "escherichia coli population";
                                 owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                          [owl:someValuesFrom biotop:EscherichiaColiCell ; 
                                                                          owl:onProperty biotop:hasGranularPart ; 
                                                                          a owl:Restriction]
                                                                          [owl:onProperty biotop:hasGranularPart ; 
                                                                          owl:allValuesFrom biotop:EscherichiaColiCell ; 
                                                                          a owl:Restriction]) ; 
                                                      a owl:Class].
biotop:Eukaryote ru:definition "An eukaryote is an organism with a complex cell or cells, in which the genetic material is organized into a membrane-bound nucleus or nuclei. Most Eukaryots are multicellular, haowever, there are some which are always unicellular (protists, some fungi) but there are also unicellular developmental stages (zygotes) of plants and animals.";
                 a owl:Class;
                 rdfs:label "eukaryote";
                 rdfs:subClassOf biotop:OrganismByTaxonPartition.
biotop:EukaryotePopulation a owl:Class;
                           rdfs:comment "EXAMPLE OF POPULATION";
                           rdfs:label "eukaryote population";
                           owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                    [owl:someValuesFrom biotop:Eukaryote ; 
                                                                    owl:onProperty biotop:hasGranularPart ; 
                                                                    a owl:Restriction]
                                                                    [owl:onProperty biotop:hasGranularPart ; 
                                                                    owl:allValuesFrom biotop:Eukaryote ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:Event a owl:Class;
             rdfs:subClassOf biotop:DEPRECATED.
biotop:ExaminationResultRole ru:definition "The role a measurement plays if it has been produced in the context of the quantitative assessment of a biological system";
                             a owl:Class;
                             rdfs:label "examination result role";
                             rdfs:subClassOf biotop:FindingRole;
                             owl:disjointWith biotop:SignOrSymptomRole.
biotop:FamilyDrosophilidaeValueRegion a owl:Class;
                                      rdfs:comment "EXAMPLE OF TAXON REGION";
                                      rdfs:label "family drosophilidae value region";
                                      rdfs:subClassOf biotop:OrderDipteraValueRegion.
biotop:FamilyEnterobacteriaceaeaValueRegion a owl:Class;
                                            rdfs:comment "EXAMPLE OF TAXON REGION";
                                            rdfs:label "family enterobacteriaceaea value region";
                                            rdfs:subClassOf biotop:OrderEnterobacterialesValueRegion.
biotop:FamilyHominidaeValueRegion a owl:Class;
                                  rdfs:comment "EXAMPLE OF TAXON REGION";
                                  rdfs:label "family hominidae value region";
                                  rdfs:subClassOf biotop:OrderPrimatesValueRegion.
biotop:FamilyOfIndividualOrganisms a owl:Class;
                                   rdfs:comment "unclear classe. to be revised";
                                   rdfs:label "family of individual organisms";
                                   rdfs:subClassOf biotop:DEPRECATED.
biotop:FamilyRole a owl:Class;
                  rdfs:label "family role";
                  rdfs:subClassOf [owl:onProperty biotop:inheresIn ; 
