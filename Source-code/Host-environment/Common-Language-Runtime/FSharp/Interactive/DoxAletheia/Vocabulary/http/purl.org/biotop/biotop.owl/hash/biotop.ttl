                                                                          a <http://www.w3.org/2002/07/owl#Class>].
biotop:Process <http://purl.org/imbi/ru-meta.owl#definition> """Process is in BioTop the generic subsumer of anything that \"occurs\". 
Processes can span across time and have temporal parts (i.e. there is no time in which all parts of a process are simultaneously present). 

A special kind of process is the event, which has no temporal extension. It can be regarded as Process Boundary (BFO).


Processes have physical or informational entities as participants.""";
               a <http://www.w3.org/2002/07/owl#Class>;
               rdfs:label "process";
               rdfs:subClassOf [<http://www.w3.org/2002/07/owl#unionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:TimeInterval ; 
                                                                         <http://www.w3.org/2002/07/owl#onProperty> biotop:hasDuration ; 
                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                         [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:PointInTime ; 
                                                                         <http://www.w3.org/2002/07/owl#onProperty> biotop:hasPointInTime ; 
                                                                         a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                a <http://www.w3.org/2002/07/owl#Class>],
                               biotop:Particular;
               <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Particular
                                                                                                                [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:ImmaterialObject
                                                                                                                                                                                                         biotop:InformationObject
                                                                                                                                                                                                         biotop:MaterialObject) ; 
                                                                                                                                                                a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                <http://www.w3.org/2002/07/owl#onProperty> biotop:hasParticipant ; 
                                                                                                                a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                a <http://www.w3.org/2002/07/owl#Class>];
               <http://www.w3.org/2002/07/owl#priorVersion> "processual entity".
biotop:ProcessQuality <http://purl.org/imbi/ru-meta.owl#definition> "A quality that inheres in some process";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "process quality";
                      rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Process ; 
                                       <http://www.w3.org/2002/07/owl#onProperty> biotop:processQualityOf ; 
                                       a <http://www.w3.org/2002/07/owl#Restriction>],
                                      biotop:Quality.
biotop:Producing <http://purl.org/imbi/ru-meta.owl#definition> "action in which a new physical or informational entity comes into being";
                 a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:label "producing";
                 rdfs:subClassOf biotop:Affecting.
biotop:Prokaryote <http://purl.org/imbi/ru-meta.owl#definition> "Cell lacking membrane enclosed organells";
