biotop:Role <http://purl.org/imbi/ru-meta.owl#definition> """A role is a realizable entity the manifestation of which brings about some result or end that is not essential to its bearer in virtue of the kind of thing that it is, but that can be served or participated in by that kind of continuant entity in some kinds of natural, social or institutional
contexts.""";
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "role";
            rdfs:subClassOf [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Particular
                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Particular ; 
                                                                             <http://www.w3.org/2002/07/owl#onProperty> biotop:inheresIn ; 
                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                             a <http://www.w3.org/2002/07/owl#Class>].
biotop:SiblingRole <http://purl.org/imbi/ru-meta.owl#definition> "the role an organism plays in relation to another organism that has the same parents";
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "sibling role";
                   rdfs:subClassOf biotop:FamilyRole.
biotop:SignOrSymptomRole <http://purl.org/imbi/ru-meta.owl#definition> "A role that can inhere in states, processes, or even in certain independent continuants (e.g. in a deformity). This a role is ascribed to an entity in a diagnostic process where the symptom is suspected to indicate a second state or process)";
                         a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:label "sign or symptom role";
                         rdfs:subClassOf biotop:FindingRole.
biotop:SignallingRole <http://purl.org/imbi/ru-meta.owl#definition> "The role of a biological entity that participates in a biological signalling process.";
                      a <http://www.w3.org/2002/07/owl#Class>;
