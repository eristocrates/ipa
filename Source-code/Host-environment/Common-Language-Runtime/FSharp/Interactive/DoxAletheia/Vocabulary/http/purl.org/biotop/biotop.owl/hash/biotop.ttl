                                    owl:members (biotop:EducatorRole
                                                 biotop:HealthProfessionalRole
                                                 biotop:ResearcherRole).
_:B44d367b1194131edeacc48d3730ef8c5 a owl:AllDisjointClasses;
                                    owl:members (biotop:FindingRole
                                                 biotop:FoodRole
                                                 biotop:PoisonRole
                                                 biotop:PreventiveRole
                                                 biotop:SubjectOfCareRole
                                                 biotop:TherapeuticRole).
_:B4c1bb3e569937f88737e96fe14d36233 a owl:AllDisjointClasses;
                                    owl:members (biotop:Electron
                                                 biotop:Neutron
                                                 biotop:Proton).
_:B6020501090f103ed973c22c2b84d24bd a owl:AllDisjointClasses;
                                    owl:members (biotop:Disposition
                                                 biotop:ImmaterialObject
                                                 biotop:InformationObject
                                                 biotop:MaterialObject
                                                 biotop:Process
                                                 biotop:Quality
                                                 biotop:Role
                                                 biotop:Time
                                                 biotop:ValueRegion).
_:B6d8a9f6d4ea085bea297f786a4a64134 a owl:AllDisjointClasses;
                                    owl:members (biotop:AminoAcidOrPeptideMoleculeOrStructure
                                                 biotop:CarbohydrateMoleculeOrResidue
                                                 biotop:FattyAcidMoleculeOrResidue
                                                 biotop:HeterocyclicBaseMoleculeOrResidue
                                                 biotop:LipidMoleculeOrResidue
                                                 biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue).
_:B825beabafa15b1aaa4e49d5d7b6bde47 a owl:AllDisjointClasses;
                                    owl:members (biotop:BiologicalSizeValueRegion
                                                 biotop:CanonicityValueRegion
                                                 biotop:DevelopmentalValueRegion
                                                 biotop:StateOfMatterValueRegion
                                                 biotop:TaxonValueRegion).
_:B8854c708caa7cc1e38169ab4330704f1 a owl:AllDisjointClasses;
                                    owl:members (biotop:ChildRole
                                                 biotop:ParentRole
                                                 biotop:SiblingRole).
_:B88ad6fd5f5d7ecc2be8c7a35980fd495 a owl:AllDisjointClasses;
                                    owl:members (biotop:ArtefactRole
                                                 biotop:BiologicalSystemRole
                                                 biotop:ChemicalRole
                                                 biotop:FamilyRole
                                                 biotop:HealthRelatedRole
                                                 biotop:OccupationalRole
                                                 biotop:SpatialReferenceRole).
_:B8d16859e72cf680781411a55e04ad669 a owl:AllDisjointClasses;
                                    owl:members (biotop:NucleicAcidStructure
                                                 biotop:NucleosideMolecule
                                                 biotop:NucleotideMolecule).
_:B9c2ede5245edfc77f601d3f79476acd0 a owl:AllDisjointClasses;
                                    owl:members (biotop:Eukaryote
                                                 biotop:Prokaryote
                                                 biotop:Virus).
_:Ba0b6a5dd1b5753d503d6c5319dca7226 a owl:AllDisjointClasses;
                                    owl:members (biotop:Atom
                                                 biotop:MonoMolecularEntity
                                                 biotop:PolyMolecularCompositeEntity
                                                 biotop:SubatomicParticle).
_:Bac143033c25b23106a07a7b6a5b1d1ba a owl:AllDisjointClasses;
                                    owl:members (biotop:MoleculeComplex
                                                 biotop:StructuredBiologicalEntity
                                                 biotop:StructuredNonbiologicalCompound).
_:Bbc2e4724069eba73a3fd68fd51429a3d a owl:AllDisjointClasses;
                                    owl:members (biotop:AgeQuality
                                                 biotop:BiologicalSize
                                                 biotop:Canonicity
                                                 biotop:DevelopmentalQuality
                                                 biotop:PhysicalForce
                                                 biotop:PhysicalLength
                                                 biotop:PhysicalMass
                                                 biotop:PhysicalState
                                                 biotop:PhysicalVolume
                                                 biotop:StateOfMatter
                                                 biotop:TaxonQuality).
_:Bbcf2246f06e69572f0d6f725785f203d a owl:AllDisjointClasses;
                                    owl:members (biotop:Alga
                                                 biotop:AnimalIncludingHuman
                                                 biotop:Plant
                                                 biotop:Protist).
_:Bc3dcd83a6dd85445b75236e4e954a32c a owl:AllDisjointClasses;
                                    owl:members (biotop:Amphibian
                                                 biotop:Bird
                                                 biotop:Fish
                                                 biotop:Mammal
                                                 biotop:Reptile).
_:Bd1be089abfbb9c60125de54890f99dbb a owl:AllDisjointClasses;
                                    owl:members (biotop:AdultValueRegion
                                                 biotop:EmbryonicValueRegion
                                                 biotop:JuvenileValueRegion).
_:Bd82cabab2c8048e4d296368b36c8b895 a owl:AllDisjointClasses;
                                    owl:members (biotop:HormoneRole
                                                 biotop:NeuroreactiveRole
                                                 biotop:ReceptorRole).
_:Bd9126573c71de9d249598ececa41011b a owl:AllDisjointClasses;
                                    owl:members (biotop:FindingRole
                                                 biotop:FoodRole
                                                 biotop:PoisonRole
                                                 biotop:PreventiveRole
                                                 biotop:TherapeuticRole).
_:Bdf9c5289c9bed340ca6df29118b70bdd a owl:AllDisjointClasses;
                                    owl:members (biotop:GaseousValueRegion
                                                 biotop:LiquidValueRegion
                                                 biotop:SolidValueRegion).
_:Be4bc4ddb03866665eab5c3069eb02349 a owl:AllDisjointClasses;
                                    owl:members (biotop:AnimalLanguage
                                                 biotop:HumanLanguage
                                                 biotop:MachineLanguage).
_:Bf2b8469357479c7846a5800857f7e40f a owl:AllDisjointClasses;
                                    owl:members (biotop:Eicosanoid
                                                 biotop:NonSteroidLipid
                                                 biotop:Steroid).
_:Bf914682018bcb804c25f2d369d7df01c a owl:AllDisjointClasses;
                                    owl:members (biotop:CatalyticRole
                                                 biotop:IndicatorRole
