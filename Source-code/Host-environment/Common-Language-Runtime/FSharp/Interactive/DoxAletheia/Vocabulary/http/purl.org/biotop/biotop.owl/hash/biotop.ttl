                                <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                a <http://www.w3.org/2002/07/owl#Restriction>],
                               biotop:GreatApe.
biotop:PrimatePopulation a <http://www.w3.org/2002/07/owl#Class>;
                         rdfs:comment "EXAMPLE OF POPULATION";
