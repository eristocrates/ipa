                                  [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:MicroscopicValueRegion ; 
                                                                                                                                 <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                                                                 <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                                                                 a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                   a <http://www.w3.org/2002/07/owl#Class>],
                                  biotop:AnimalIncludingHuman.
biotop:VertebratePopulation a <http://www.w3.org/2002/07/owl#Class>;
                            rdfs:comment "EXAMPLE OF POPULATION";
                            rdfs:label "vertebrate population";
                            <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Population
                                                                                                                             [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Vertebrate ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                             [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                             <http://www.w3.org/2002/07/owl#allValuesFrom> biotop:Vertebrate ; 
                                                                                                                             a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                             a <http://www.w3.org/2002/07/owl#Class>].
biotop:Virus <http://purl.org/imbi/ru-meta.owl#definition> "Sub-microscopic agent that requires a host cell to grow and reproduce. Viruses resemble other organisms in that they possess genes, and can evolve in infected cells by natural selection.  We therefore classify viruses as organisms, although there is an open debate.";
             a <http://www.w3.org/2002/07/owl#Class>;
             rdfs:label "virus";
             rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:MicroscopicValueRegion ; 
                                                                              <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                              a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                              <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                              a <http://www.w3.org/2002/07/owl#Restriction>],
                             [<http://www.w3.org/2002/07/owl#complementOf> biotop:Cell ; 
                              a <http://www.w3.org/2002/07/owl#Class>],
                             [<http://www.w3.org/2002/07/owl#complementOf> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Cell ; 
                                                                            <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                                                            a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                              a <http://www.w3.org/2002/07/owl#Class>],
                             biotop:OrganismByTaxonPartition.
biotop:VirusPopulation a <http://www.w3.org/2002/07/owl#Class>;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "virus population";
                       <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Population
                                                                                                                        [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Virus ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                        [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasGranularPart ; 
                                                                                                                        <http://www.w3.org/2002/07/owl#allValuesFrom> biotop:Virus ; 
                                                                                                                        a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                        a <http://www.w3.org/2002/07/owl#Class>].
biotop:VitaminRole <http://purl.org/imbi/ru-meta.owl#definition> "The role a certain substance can play in an organism. Vitamins are organic compounds that are essential to an organism for metabolic reactions. They are not food. Vitamin does not include essential fatty acids or essential amino acids";
                   a <http://www.w3.org/2002/07/owl#Class>;
                   rdfs:label "vitamin role";
                   rdfs:subClassOf biotop:BiologicalSystemRole.
biotop:WaterMolecule <http://purl.org/imbi/ru-meta.owl#definition> "A water molecule is composed by one oxygen molecule and two hydrogen molecules";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "water molecule";
                     rdfs:subClassOf biotop:InorganicMolecularEntity.
biotop:Wave <http://purl.org/imbi/ru-meta.owl#definition> "(wikipedia) disturbance that propagates through space and time, usually with transference of energy";
            a <http://www.w3.org/2002/07/owl#Class>;
            rdfs:label "wave";
            rdfs:subClassOf biotop:ImmaterialObject.
biotop:WellFormedBiologicalStructure a <http://www.w3.org/2002/07/owl#Class>;
                                     rdfs:label "well formed biological structure";
                                     rdfs:subClassOf biotop:StructuredBiologicalCompoundByCanonicityPartition;
                                     <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:StructuredBiologicalEntity
                                                                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:Canonicity
                                                                                                                                                                                                                                      [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:CanonicalValueRegion ; 
                                                                                                                                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                                                                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                                                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                                                                                                                      a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                                      a <http://www.w3.org/2002/07/owl#Class>].
biotop:YeastCell a <http://www.w3.org/2002/07/owl#Class>;
                 rdfs:comment "Unicellular Fungi.";
                 rdfs:label "yeast cell";
                 rdfs:subClassOf [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                  <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#complementOf> biotop:Cell ; 
                                                                                 a <http://www.w3.org/2002/07/owl#Class>] ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:MicroscopicValueRegion ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:Cytoplasm ; 
                                  <http://www.w3.org/2002/07/owl#onProperty> biotop:hasProperPhysicalPart ; 
                                  a <http://www.w3.org/2002/07/owl#Restriction>],
                                 [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:CellMembrane ; 
                                                                                  <http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                                                  a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                  [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:CellularComponent ; 
