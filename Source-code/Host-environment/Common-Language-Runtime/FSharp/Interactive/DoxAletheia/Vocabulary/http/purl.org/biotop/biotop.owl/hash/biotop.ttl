                  rdfs:label "prokaryote";
                  rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:MicroscopicValueRegion ; 
                                                                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:qualityLocated ; 
                                                                                   a <http://www.w3.org/2002/07/owl#Restriction>] ; 
                                   <http://www.w3.org/2002/07/owl#onProperty> biotop:bearerOf ; 
                                   a <http://www.w3.org/2002/07/owl#Restriction>],
                                  biotop:OrganismByTaxonPartition.
biotop:ProteinComplex <http://purl.org/imbi/ru-meta.owl#definition> "Mostly only proteins but composition with other molecules possible (e.g. Fe -> Hemoglobin) or also lipoproteins";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "protein complex";
                      rdfs:subClassOf biotop:MoleculeComplex;
                      <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> ([<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:EntireProteinMolecule ; 
                                                                                                                       <http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]
                                                                                                                       [<http://www.w3.org/2002/07/owl#onProperty> biotop:hasComponentPart ; 
                                                                                                                       <http://www.w3.org/2002/07/owl#allValuesFrom> [<http://www.w3.org/2002/07/owl#unionOf> (biotop:EntireProteinMolecule
                                                                                                                                                                                                               biotop:MonoMolecularEntity) ; 
                                                                                                                                                                      a <http://www.w3.org/2002/07/owl#Class>] ; 
                                                                                                                       a <http://www.w3.org/2002/07/owl#Restriction>]) ; 
                                                                       a <http://www.w3.org/2002/07/owl#Class>].
biotop:ProteinDomain <http://purl.org/imbi/ru-meta.owl#definition> "Structural domain is the smallest element of protein tertiary structure that is self-stabilizing and often folds independently of the rest of the amino acid chain. It may contain one or more structural motives (ProteinSubstructure). A protein domain typically has its own function, the overall function of the protein results from the composition of the functions of all of its structural domains.";
                     a <http://www.w3.org/2002/07/owl#Class>;
                     rdfs:label "protein domain";
                     rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:EntireProteinMolecule ; 
                                      <http://www.w3.org/2002/07/owl#onProperty> biotop:properPhysicalPartOf ; 
                                      a <http://www.w3.org/2002/07/owl#Restriction>],
                                     biotop:PeptideStructure.
biotop:ProteinSubstructure <http://purl.org/imbi/ru-meta.owl#definition> "A secondary substructure of a protein (protein Motif)";
                           a <http://www.w3.org/2002/07/owl#Class>;
                           rdfs:label "protein substructure";
                           rdfs:subClassOf [<http://www.w3.org/2002/07/owl#someValuesFrom> biotop:EntireProteinMolecule ; 
                                            <http://www.w3.org/2002/07/owl#onProperty> biotop:properPhysicalPartOf ; 
                                            a <http://www.w3.org/2002/07/owl#Restriction>],
                                           biotop:PeptideStructure.
biotop:ProteinSubunit <http://purl.org/imbi/ru-meta.owl#definition> "A protein molecule that assembles with other protein molecules to form a protein complex. May have its own function. However, most proteinsubunits do not gain functionality until associated with the other subunits.";
                      a <http://www.w3.org/2002/07/owl#Class>;
                      rdfs:label "protein subunit";
                      rdfs:subClassOf biotop:EntireProteinMolecule.
