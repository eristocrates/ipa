                                                         biotop:OrganicMolecularEntityPartition.
biotop:HormoneRole ru:definition "The role a biologically active substance plays when it participates in the transmission of messages across a certain distance in an organism.";
                   a owl:Class;
                   rdfs:label "hormone role";
                   rdfs:subClassOf biotop:SignallingRole.
biotop:Human a owl:Class;
             rdfs:label "human";
             rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                      [owl:someValuesFrom biotop:SpeciesHomoSapiensValueRegion ; 
                                                                      owl:onProperty biotop:qualityLocated ; 
                                                                      a owl:Restriction]
                                                                      [owl:onProperty biotop:qualityLocated ; 
                                                                      owl:allValuesFrom biotop:SpeciesHomoSapiensValueRegion ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class] ; 
                              owl:onProperty biotop:bearerOf ; 
                              a owl:Restriction],
                             biotop:Primate.
biotop:HumanAction ru:definition "Action that has some human as agent";
                   a owl:Class;
                   rdfs:label "human action";
                   rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (biotop:Human
                                                                     [owl:someValuesFrom biotop:Human ; 
                                                                     owl:onProperty biotop:hasGranularPart ; 
                                                                     a owl:Restriction]) ; 
                                                        a owl:Class] ; 
                                    owl:onProperty biotop:hasAgent ; 
                                    a owl:Restriction],
                                   biotop:OrganismAction.
biotop:HumanEpithelialCell a owl:Class;
                           rdfs:label "human epithelial cell";
                           owl:equivalentClass [owl:intersectionOf (biotop:EpithelialCell
                                                                    [owl:someValuesFrom [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                                                                [owl:someValuesFrom biotop:SpeciesHomoSapiensValueRegion ; 
                                                                                                                                owl:onProperty biotop:qualityLocated ; 
                                                                                                                                a owl:Restriction]) ; 
                                                                                                            a owl:Class] ; 
                                                                                        owl:onProperty biotop:bearerOf ; 
                                                                                        a owl:Restriction] ; 
                                                                    owl:onProperty biotop:originatesFrom ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:HumanLanguage ru:definition "language used in communication between non-human animals";
                     a owl:Class;
                     rdfs:label "human language";
                     rdfs:subClassOf biotop:LanguagePartition.
biotop:HumanPopulation a owl:Class;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "human population";
                       owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                [owl:someValuesFrom biotop:Human ; 
                                                                owl:onProperty biotop:hasGranularPart ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty biotop:hasGranularPart ; 
                                                                owl:allValuesFrom biotop:Human ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:HumanReasoning ru:definition "Process in which a human creates an intellectual product";
                      a owl:Class;
                      rdfs:label "human reasoning";
                      rdfs:subClassOf biotop:HumanAction;
                      owl:equivalentClass [owl:intersectionOf (biotop:HumanAction
                                                               [owl:someValuesFrom biotop:Human ; 
                                                               owl:onProperty biotop:hasAgent ; 
                                                               a owl:Restriction]
                                                               [owl:someValuesFrom biotop:IntellectualProduct ; 
                                                               owl:onProperty biotop:hasOutcome ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
biotop:Hurting a owl:Class;
               rdfs:comment "negatively affecting a biological system by using physical force";
               rdfs:label "hurting";
               rdfs:subClassOf [owl:someValuesFrom biotop:PhysicalForce ; 
                                owl:onProperty biotop:hasProcessQuality ; 
                                a owl:Restriction],
                               biotop:ActionOnBiologicalSystem.
biotop:ImmaterialNonphysicalEntity ru:definition "Continuant entity that has neither a mass nor a volume and which do not inhere in other entities.";
                                   a owl:Class;
                                   rdfs:label "immaterial nonphysical entity";
                                   rdfs:subClassOf biotop:DEPRECATED.
biotop:ImmaterialObject ru:definition """Physical spaces that have a threedimensional spatial dimension but no mass.
Old name: immaterial anatomical entity""";
                        a owl:Class;
                        rdfs:label "immaterial object";
                        rdfs:subClassOf [owl:complementOf [owl:someValuesFrom biotop:PhysicalMass ; 
                                                           owl:onProperty biotop:bearerOf ; 
                                                           a owl:Restriction] ; 
                                         a owl:Class],
                                        [owl:onProperty biotop:hasPhysicalPart ; 
                                         owl:allValuesFrom biotop:ImmaterialObject ; 
                                         a owl:Restriction],
                                        biotop:Particular;
                        owl:priorVersion "immaterial physical entity".
biotop:ImmaterialPhysicalEntity a owl:Class;
                                rdfs:subClassOf biotop:DEPRECATED.
biotop:ImmaterialProcessualEntity ru:definition "A process with non-material participants, e.g. legal or organizational entities or information objects";
                                  a owl:Class;
                                  rdfs:label "immaterial processual entity";
                                  owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                                           [owl:someValuesFrom biotop:InformationObject ; 
                                                                           owl:onProperty biotop:hasParticipant ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
biotop:ImmaterialThreeDimensionalPhysicalEntity ru:definition "three-dimensional space";
                                                a owl:Class;
                                                rdfs:label "immaterial three dimensional physical entity";
                                                rdfs:subClassOf [owl:someValuesFrom biotop:PhysicalVolume ; 
                                                                 owl:onProperty biotop:bearerOf ; 
                                                                 a owl:Restriction],
                                                                biotop:ImmaterialObject.
biotop:ImmunologicRole ru:definition "A role that is played by any biological entity in virtue of the defense of an organism against infective agents";
                       a owl:Class;
                       rdfs:label "immunologic role";
                       rdfs:subClassOf biotop:BiologicalSystemRole.
biotop:Indicating ru:definition "action that indicates something";
                  a owl:Class;
                  rdfs:label "indicating";
                  rdfs:subClassOf biotop:Affecting.
biotop:IndicatorRole ru:definition "A role a chemical plays for measuring or analyzing other chemical processes";
                     a owl:Class;
                     rdfs:label "indicator role";
                     rdfs:subClassOf biotop:ChemicalRole.
biotop:IndividualBehavior ru:definition "Behavior of an individual organism";
                          a owl:Class;
                          rdfs:label "individual behavior";
                          owl:disjointWith biotop:SocialBehavior;
                          owl:equivalentClass [owl:intersectionOf (biotop:Behavior
                                                                   [owl:someValuesFrom biotop:LivingOrganism ; 
                                                                   owl:onProperty biotop:hasAgent ; 
                                                                   a owl:Restriction]
                                                                   [owl:onProperty biotop:hasAgent ; 
                                                                   owl:allValuesFrom biotop:LivingOrganism ; 
                                                                   a owl:Restriction]) ; 
                                               a owl:Class].
biotop:InformationEntity a owl:Class;
                         rdfs:subClassOf biotop:DEPRECATED.
biotop:InformationObject ru:definition "Piece of information (not necessarily human) , as it exists independently of any potential material carrier.";
                         a owl:Class;
                         rdfs:label "information object";
                         rdfs:subClassOf [owl:intersectionOf ([owl:complementOf [owl:someValuesFrom biotop:PhysicalMass ; 
                                                                                owl:onProperty biotop:bearerOf ; 
                                                                                a owl:Restriction] ; 
                                                              a owl:Class]
                                                              [owl:complementOf [owl:someValuesFrom biotop:PhysicalVolume ; 
                                                                                owl:onProperty biotop:bearerOf ; 
                                                                                a owl:Restriction] ; 
                                                              a owl:Class]
                                                              [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                                               biotop:MaterialObject) ; 
                                                                                  a owl:Class] ; 
                                                              owl:onProperty biotop:inheresIn ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class],
                                         biotop:Particular;
                         owl:priorVersion "information entity".
biotop:InorganicMolecularEntity ru:definition "Substances which do not include carbon and its derivatives as their principal elements. However, carbides, carbonates, cyanides, cyanates and carbon disulfide are included in this class.";
                                a owl:Class;
                                rdfs:label "inorganic molecular entity";
                                rdfs:subClassOf biotop:MolecularEntityByOrganicInorganicPartition;
                                owl:disjointWith biotop:OrganicMolecularEntity.
biotop:Insect ru:definition "one insect";
              a owl:Class;
              rdfs:label "insect";
              rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                       [owl:someValuesFrom biotop:ClassInsectaValueRegion ; 
                                                                       owl:onProperty biotop:qualityLocated ; 
                                                                       a owl:Restriction]) ; 
                                                   a owl:Class] ; 
                               owl:onProperty biotop:bearerOf ; 
                               a owl:Restriction],
                              biotop:Arthropod.
biotop:InsectPopulation a owl:Class;
                        rdfs:comment "EXAMPLE OF POPULATION";
                        rdfs:label "insect population";
                        owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                 [owl:someValuesFrom biotop:Insect ; 
                                                                 owl:onProperty biotop:hasGranularPart ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty biotop:hasGranularPart ; 
                                                                 owl:allValuesFrom biotop:Insect ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
biotop:InstantaneousProcess ru:definition """What happens at one point in time, typically a process boundary. 
Name \"event\" deprecated
""";
                            a owl:Class;
                            rdfs:label "instantaneous process";
                            owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                                     [owl:complementOf [owl:someValuesFrom biotop:TimeInterval ; 
                                                                                       owl:onProperty biotop:hasDuration ; 
                                                                                       a owl:Restriction] ; 
                                                                     a owl:Class]
                                                                     [owl:someValuesFrom biotop:PointInTime ; 
                                                                     owl:onProperty biotop:hasPointInTime ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
biotop:IntellectualProduct ru:definition "An intellectual product is a piece of information that is the outcome of a human reasoning process";
                           a owl:Class;
                           rdfs:label "intellectual product";
                           rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:Process
                                                                                    [owl:someValuesFrom biotop:Human ; 
                                                                                    owl:onProperty biotop:hasAgent ; 
                                                                                    a owl:Restriction]) ; 
                                                                a owl:Class] ; 
                                            owl:onProperty biotop:patientIn ; 
                                            a owl:Restriction],
                                           biotop:InformationObject.
biotop:Interacting ru:definition "two or more interaction partners exerce a mutual effect that may lead to structural transformation.";
                   a owl:Class;
                   rdfs:label "interacting";
                   rdfs:subClassOf biotop:Affecting;
                   owl:equivalentClass [owl:unionOf (biotop:GroupInteraction
                                                     biotop:OrganismInteraction
                                                     biotop:SubstanceInteraction) ; 
                                        a owl:Class].
biotop:IntraCellularProcess ru:definition "Process occuring in a cell.";
                            a owl:Class;
                            rdfs:label "intra cellular process";
                            owl:equivalentClass [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                                     [owl:someValuesFrom biotop:Cell ; 
                                                                     owl:onProperty biotop:hasLocus ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
biotop:Invertebrate a owl:Class;
                    rdfs:label "invertebrate";
                    rdfs:subClassOf biotop:AnimalIncludingHuman;
                    owl:disjointWith biotop:Vertebrate.
biotop:JuvenileOrganism ru:definition "born organism, not yet in reproductive age";
                        a owl:Class;
                        rdfs:label "juvenile organism";
                        rdfs:subClassOf biotop:OrganismByDevelopmentalStagePartition;
                        owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                 [owl:someValuesFrom [owl:intersectionOf (biotop:DevelopmentalQuality
                                                                                                         [owl:someValuesFrom biotop:JuvenileValueRegion ; 
                                                                                                         owl:onProperty biotop:qualityLocated ; 
                                                                                                         a owl:Restriction]) ; 
                                                                                     a owl:Class] ; 
                                                                 owl:onProperty biotop:bearerOf ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
biotop:JuvenileValueRegion a owl:Class;
                           rdfs:label "juvenile value region";
                           rdfs:subClassOf biotop:DevelopmentalValueRegion.
biotop:KingdomAnimaliaValueRegion a owl:Class;
                                  rdfs:comment "EXAMPLE OF TAXON REGION";
                                  rdfs:label "kingdom animalia value region";
                                  rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomArchaeaValueRegion a owl:Class;
                                 rdfs:comment "EXAMPLE OF TAXON REGION";
                                 rdfs:label "kingdom archaea value region";
                                 rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomBacteriaValueRegion a owl:Class;
                                  rdfs:comment "EXAMPLE OF TAXON REGION";
                                  rdfs:label "kingdom bacteria value region";
                                  rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomChromistaValueRegion a owl:Class;
                                   rdfs:comment "EXAMPLE OF TAXON REGION";
                                   rdfs:label "kingdom chromista value region";
                                   rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomFungiValueRegion a owl:Class;
                               rdfs:comment "EXAMPLE OF TAXON REGION";
                               rdfs:label "kingdom fungi value region";
                               rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomPlantaeValueRegion a owl:Class;
                                 rdfs:comment "EXAMPLE OF TAXON REGION";
                                 rdfs:label "kingdom plantae value region";
                                 rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomProtozoaValueRegion a owl:Class;
                                  rdfs:comment "EXAMPLE OF TAXON REGION";
                                  rdfs:label "kingdom protozoa value region";
                                  rdfs:subClassOf biotop:TaxonValueRegion.
biotop:KingdomVirusesValueRegion a owl:Class;
                                 rdfs:comment "EXAMPLE OF TAXON REGION";
                                 rdfs:label "kingdom viruses value region";
                                 rdfs:subClassOf biotop:TaxonValueRegion.
biotop:Language ru:definition "system of signs used for communication between biological and / or machine agents";
                a owl:Class;
                rdfs:label "language";
                rdfs:subClassOf biotop:InformationObject.
biotop:LanguagePartition ru:definition "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.";
                         a owl:Class;
                         owl:equivalentClass [owl:intersectionOf (biotop:Language
                                                                  [owl:unionOf (biotop:AnimalLanguage
                                                                               biotop:HumanLanguage
                                                                               biotop:MachineLanguage) ; 
                                                                  a owl:Class]) ; 
                                              a owl:Class].
biotop:LegalEntity ru:definition "nonmaterial entity that as an existence in a legal system";
                   a owl:Class;
                   rdfs:label "legal entity";
                   rdfs:subClassOf biotop:InformationObject.
biotop:LipidMoleculeOrResidue ru:definition "Fat-soluble (lipophilic), naturally-occurring molecule.";
                              a owl:Class;
                              rdfs:label "lipid molecule or residue";
                              rdfs:subClassOf [owl:someValuesFrom biotop:SubmolecularGroup ; 
                                               owl:onProperty biotop:hasComponentPart ; 
                                               a owl:Restriction],
                                              biotop:OrganicMolecularEntityPartition.
biotop:LiquidValueRegion a owl:Class;
                         rdfs:comment """\"liquid\" as the value of a states of matter. E.g. a portion of water has a quality which has its value located in \"liquid value region\"""";
                         rdfs:label "liquid value region";
                         rdfs:subClassOf biotop:StateOfMatterValueRegion.
biotop:LivingBody ru:definition "Entirety of the biological structure that constitutes a living organism";
                  a owl:Class;
                  rdfs:label "living body";
                  rdfs:subClassOf [owl:someValuesFrom biotop:BiologicalLife ; 
                                   owl:onProperty biotop:participatesIn ; 
                                   a owl:Restriction],
                                  [owl:unionOf (biotop:LivingOrganism
                                                [owl:someValuesFrom biotop:LivingOrganism ; 
                                                owl:onProperty biotop:properPhysicalPartOf ; 
                                                a owl:Restriction]) ; 
                                   a owl:Class],
                                  biotop:Body.
biotop:LivingOrganism ru:definition """Living complex biological system which functions as a stable whole. In contrast to colonial organisms their components generally cannot survive on their own. We conceive organisms in a material sense. Therefore we do not assume any ontological difference between a unicellular organism and the cell it is made of. \"Colonial Organism\" are not considered Organisms. We here include viruses into the category of organisms.

Organism in an inactive form which are not dead are considered living organisms.

Whether a living organism coincides with its body or hasPart its body, is controversial. We use \"hasPhysicalPart\" for relating organism to body. Being reflexive, this would not be incompatible with a view in which a living organism is a body.""";
                      a owl:Class;
                      rdfs:label "living organism";
                      rdfs:subClassOf [owl:someValuesFrom biotop:BiologicalLife ; 
                                       owl:onProperty biotop:participatesIn ; 
                                       a owl:Restriction],
                                      biotop:StructuredBiologicalEntity;
                      owl:priorVersion "organism".
biotop:MachineAction ru:definition "An action performed by a machine. A machine is here seen as a non-biological artifact.";
                     a owl:Class;
                     rdfs:label "machine action";
                     owl:equivalentClass [owl:intersectionOf (biotop:Action
                                                              [owl:someValuesFrom [owl:intersectionOf (biotop:MaterialObject
                                                                                                      [owl:someValuesFrom biotop:ArtefactRole ; 
                                                                                                      owl:onProperty biotop:bearerOf ; 
                                                                                                      a owl:Restriction]) ; 
                                                                                  a owl:Class] ; 
                                                              owl:onProperty biotop:hasAgent ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
biotop:MachineLanguage ru:definition "language used for processing by machines";
                       a owl:Class;
                       rdfs:label "machine language";
                       rdfs:subClassOf biotop:LanguagePartition.
biotop:MacroscopicValueRegion ru:definition "size values of objects that are visible to the naked eye";
                              a owl:Class;
                              rdfs:label "macroscopic value region";
                              rdfs:subClassOf biotop:BiologicalSizeValueRegion;
                              owl:disjointWith biotop:MicroscopicValueRegion.
biotop:Mammal a owl:Class;
              rdfs:comment "one mammal";
              rdfs:label "mammal";
              rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                       [owl:someValuesFrom biotop:ClassMammaliaValueRegion ; 
                                                                       owl:onProperty biotop:qualityLocated ; 
                                                                       a owl:Restriction]) ; 
                                                   a owl:Class] ; 
                               owl:onProperty biotop:bearerOf ; 
                               a owl:Restriction],
                              biotop:Vertebrate.
biotop:MammalPopulation a owl:Class;
                        rdfs:comment "EXAMPLE OF POPULATION";
                        rdfs:label "mammal population";
                        owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                 [owl:someValuesFrom biotop:Mammal ; 
                                                                 owl:onProperty biotop:hasGranularPart ; 
                                                                 a owl:Restriction]
                                                                 [owl:onProperty biotop:hasGranularPart ; 
                                                                 owl:allValuesFrom biotop:Mammal ; 
                                                                 a owl:Restriction]) ; 
                                             a owl:Class].
biotop:ManagingCare ru:definition "action in which a subject cares for the well-being of some biological entity";
                    a owl:Class;
                    rdfs:label "managing care";
                    rdfs:subClassOf [owl:onProperty biotop:hasParticipant ; 
                                     owl:allValuesFrom [owl:unionOf (biotop:Human
                                                                     biotop:LegalEntity
                                                                     [owl:someValuesFrom biotop:Human ; 
                                                                     owl:onProperty biotop:hasGranularPart ; 
                                                                     a owl:Restriction]) ; 
                                                        a owl:Class] ; 
                                     a owl:Restriction],
                                    biotop:Affecting.
biotop:MaterialEntity a owl:Class;
                      rdfs:subClassOf biotop:DEPRECATED.
biotop:MaterialEntityBySizePartition a owl:Class;
                                     rdfs:comment """MaterialEntityBySizePartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                                     rdfs:label "*";
                                     rdfs:subClassOf biotop:MaterialObject;
                                     owl:equivalentClass [owl:unionOf (biotop:Atom
                                                                       biotop:MonoMolecularEntity
                                                                       biotop:PolyMolecularCompositeEntity
                                                                       biotop:SubatomicParticle) ; 
                                                          a owl:Class].
biotop:MaterialObject ru:definition "A material object that has exactly one mass and one volume at a time.  Material objects may have Immaterial nonphysical entities as parts (e.g. Heart and Heart Ventricle). ";
                      a owl:Class;
                      rdfs:label "material object";
                      rdfs:subClassOf [owl:unionOf (biotop:SubatomicParticle
                                                    [owl:someValuesFrom biotop:SubatomicParticle ; 
                                                    owl:onProperty biotop:hasProperPhysicalPart ; 
                                                    a owl:Restriction]) ; 
                                       a owl:Class],
                                      biotop:Particular;
                      owl:equivalentClass [owl:intersectionOf (biotop:Particular
                                                               [owl:someValuesFrom biotop:PhysicalMass ; 
                                                               owl:onProperty biotop:bearerOf ; 
                                                               a owl:Restriction]
                                                               [owl:someValuesFrom biotop:PhysicalVolume ; 
                                                               owl:onProperty biotop:bearerOf ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class];
                      owl:priorVersion "material entity".
biotop:Measure ru:definition "Numeric quantity or cardinality, reference for measurement processes. Example kilogram, hour, ampere.";
               a owl:Class;
               rdfs:label "measure";
               rdfs:subClassOf biotop:InformationObject.
biotop:MeasurementMethod ru:definition "Plan that is realized by a measurement process.";
                         a owl:Class;
                         rdfs:label "measurement method";
                         rdfs:subClassOf biotop:Plan;
                         owl:equivalentClass [owl:intersectionOf (biotop:Plan
                                                                  [owl:onProperty biotop:hasRealization ; 
                                                                  owl:allValuesFrom biotop:MeasuringAction ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:MeasuringAction ru:definition "an action that aims at producing a measurement";
                       a owl:Class;
                       rdfs:label "measuring action";
                       rdfs:subClassOf biotop:Action.
biotop:Membership ru:definition "Process that endures while something or some person is part of a legal entity";
                  a owl:Class;
                  rdfs:label "membership";
                  rdfs:subClassOf [owl:someValuesFrom biotop:LegalEntity ; 
                                   owl:onProperty biotop:hasPatient ; 
                                   a owl:Restriction],
                                  [owl:someValuesFrom [owl:unionOf (biotop:Human
                                                                    biotop:LegalEntity) ; 
                                                       a owl:Class] ; 
                                   owl:onProperty biotop:hasAgent ; 
                                   a owl:Restriction],
                                  biotop:ImmaterialProcessualEntity.
biotop:MentalFunction ru:definition "biological function ascribed to the behavioral manisfestations of the brain";
                      a owl:Class;
                      rdfs:label "mental function";
                      rdfs:subClassOf [owl:intersectionOf (biotop:BiologicalFunction
                                                           [owl:someValuesFrom biotop:CentralNervousSystem ; 
                                                           owl:onProperty biotop:inheresIn ; 
                                                           a owl:Restriction]) ; 
                                       a owl:Class].
biotop:MentalProcess a owl:Class;
                     rdfs:comment "process in an organism as a realization of a mental function";
                     rdfs:label "mental process";
                     rdfs:subClassOf biotop:OrganismProcess.
biotop:Microorganism ru:definition "organism that can be seen only through a microscope";
                     a owl:Class;
                     rdfs:label "microorganism";
                     rdfs:subClassOf biotop:LivingOrganism;
                     owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                              [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                                                  owl:onProperty biotop:qualityLocated ; 
                                                                                  a owl:Restriction] ; 
                                                              owl:onProperty biotop:bearerOf ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
biotop:MicroscopicValueRegion ru:definition "size values of objects that are too small to be seen without a microscope";
                              a owl:Class;
                              rdfs:label "microscopic value region";
                              rdfs:subClassOf biotop:BiologicalSizeValueRegion.
biotop:Mind a owl:Class;
            rdfs:comment """Difficult concept. Better to be expressed by the primitive \"mental function\" """;
            rdfs:label "mind";
            rdfs:subClassOf biotop:DEPRECATED.
biotop:ModifiedCell ru:definition "Cells that grow and replicate continuously outside the living organism.";
                    a owl:Class;
                    rdfs:label "modified cell";
                    rdfs:subClassOf [owl:someValuesFrom biotop:CellInVivo ; 
                                     owl:onProperty biotop:derivesFrom ; 
                                     a owl:Restriction],
                                    [owl:complementOf [owl:someValuesFrom biotop:LivingOrganism ; 
                                                       owl:onProperty biotop:properPhysicalPartOf ; 
                                                       a owl:Restriction] ; 
                                     a owl:Class],
                                    biotop:CellByLocusPartition.
biotop:MolecularEntityByEntiretyPartition ru:definition """MolecularEntityByEntiretyPartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                                          a owl:Class;
                                          rdfs:label "*";
                                          owl:equivalentClass [owl:intersectionOf (biotop:MonoMolecularEntity
                                                                                   [owl:unionOf (biotop:EntireMolecularEntity
                                                                                                biotop:MolecularResidue) ; 
                                                                                   a owl:Class]) ; 
                                                               a owl:Class].
biotop:MolecularEntityByGranularityPartition ru:definition """MolecularEntityByGranularityPartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                                             a owl:Class;
                                             rdfs:label "*";
                                             rdfs:subClassOf biotop:MonoMolecularEntity;
                                             owl:equivalentClass [owl:unionOf (biotop:Monomer
                                                                               biotop:OligoOrPolymer
                                                                               biotop:SubmolecularGroup) ; 
                                                                  a owl:Class].
biotop:MolecularEntityByOrganicInorganicPartition ru:definition """MolecularEntityByOrganicInorganicPartition

Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.""";
                                                  a owl:Class;
                                                  rdfs:label "*";
                                                  rdfs:subClassOf biotop:MonoMolecularEntity;
                                                  owl:equivalentClass [owl:unionOf (biotop:InorganicMolecularEntity
                                                                                    biotop:OrganicMolecularEntity) ; 
                                                                       a owl:Class].
biotop:MolecularFunction ru:definition "Inherent function of a single molecule.";
                         a owl:Class;
                         rdfs:label "molecular function";
                         owl:equivalentClass [owl:intersectionOf (biotop:Function
                                                                  [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                                                  owl:onProperty biotop:inheresIn ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:MolecularResidue ru:definition "not self-standing aggregation of atoms which are part of a bigger molecule";
                        a owl:Class;
                        rdfs:label "molecular residue";
                        rdfs:subClassOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                         owl:onProperty biotop:componentPartOf ; 
                                         a owl:Restriction],
                                        biotop:MolecularEntityByEntiretyPartition.
biotop:MoleculeComplex ru:definition "Particle that consists of entire molecules.";
                       a owl:Class;
                       rdfs:label "molecule complex";
                       rdfs:subClassOf [owl:someValuesFrom biotop:EntireMolecularEntity ; 
                                        owl:onProperty biotop:hasComponentPart ; 
                                        a owl:Restriction],
                                       biotop:PolyMolecularCompositeEntity.
biotop:MonoMolecularEntity ru:definition """A mono-molecular entity is a self connected compound of two atoms or more which exhibit at least one covalent bound. Molecular entities can be isolated molecules or parts of molecules (groups, residue). They may be electrically neutral or not.

In biological systems molecular entities generally occur in very high quantities. In text, references to chemicals are often ambiguous. When we state \"water has a molecular weight of 18\" we refer to single water molecules. However, saying that \"water has a density of 1kg/dm³\" under certain conditions then we make a statement about pluralities of water molecules each of which has water molecules as \"grains\"
Old name: molecular entity

The upper bound of monomolecular entities is shallow. Strictly even a diamond crystal would be a monomolecular entity. One argument against this idea is that a diamond crystal is still a diamond crystal if you take away some portions. 
This is not the case with a classical molecule. """;
                           a owl:Class;
                           rdfs:label "mono molecular entity";
                           rdfs:subClassOf [owl:someValuesFrom biotop:Atom ; 
                                            owl:onProperty biotop:hasProperPhysicalPart ; 
                                            a owl:Restriction],
                                           biotop:MaterialEntityBySizePartition.
biotop:Monomer ru:definition "Monomers can be described as constituted by molecularl groups. They are not repetitive and can constitute the building blocks of Polymers.";
               a owl:Class;
               rdfs:label "monomer";
               rdfs:subClassOf biotop:MolecularEntityByGranularityPartition;
               owl:disjointWith biotop:OligoOrPolymer,
                                biotop:SubmolecularGroup.
biotop:MulticellularOrganism ru:definition "Organisms that are composed by more than one cell.";
                             a owl:Class;
                             rdfs:label "multicellular organism";
                             owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                      [owl:someValuesFrom biotop:DevelopmentalQuality ; 
                                                                      owl:onProperty biotop:bearerOf ; 
                                                                      a owl:Restriction]
                                                                      [owl:someValuesFrom biotop:Cell ; 
                                                                      owl:onProperty biotop:hasProperPhysicalPart ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class].
biotop:NeoplasticProcess a owl:Class;
                         rdfs:label "neoplastic process";
                         owl:equivalentClass [owl:intersectionOf (biotop:GrowingProcess
                                                                  [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                          [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                          owl:onProperty biotop:qualityLocated ; 
                                                                                                          a owl:Restriction]) ; 
                                                                                      a owl:Class] ; 
                                                                  owl:onProperty biotop:hasProcessQuality ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:NeuroreactiveRole ru:definition "A role a molecule plays if it acts as a neurotransmitter";
                         a owl:Class;
                         rdfs:label "neuroreactive role";
                         rdfs:subClassOf biotop:SignallingRole.
biotop:Neutron ru:synonym "Neutral Particle";
               a owl:Class;
               rdfs:label "neutron";
               rdfs:subClassOf biotop:SubatomicEntityByChargePartition.
biotop:NonSteroidLipid ru:definition "Lipids that have aliphatic chains and no steroid rings";
                       a owl:Class;
                       rdfs:label "non steroid lipid";
                       rdfs:subClassOf biotop:LipidMoleculeOrResidue.
biotop:NoncanonicalProcessualEntity ru:definition "a process that is considered abnormal";
                                    a owl:Class;
                                    rdfs:label "noncanonical processual entity";
                                    owl:equivalentClass [owl:intersectionOf (biotop:Process
                                                                             [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                     [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                                     owl:onProperty biotop:qualityLocated ; 
                                                                                                                     a owl:Restriction]) ; 
                                                                                                 a owl:Class] ; 
                                                                             owl:onProperty biotop:hasProcessQuality ; 
                                                                             a owl:Restriction]) ; 
                                                         a owl:Class].
biotop:NoncanonicalStaticProcessualEntity ru:definition """a biological state that is considered \"abnormal\"""";
                                          a owl:Class;
                                          rdfs:label "noncanonical static processual entity";
                                          owl:equivalentClass [owl:intersectionOf (biotop:StaticProcessualEntity
                                                                                   [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                           [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                                           owl:onProperty biotop:qualityLocated ; 
                                                                                                                           a owl:Restriction]) ; 
                                                                                                       a owl:Class] ; 
                                                                                   owl:onProperty biotop:hasProcessQuality ; 
                                                                                   a owl:Restriction]) ; 
                                                               a owl:Class];
                                          owl:priorVersion "noncanonical state".
biotop:NoncanonicalValueRegion a owl:Class;
                               rdfs:comment """abstract region in which the value \"noncanonical\" of canonicity is located""";
                               rdfs:label "noncanonical value region";
                               rdfs:subClassOf biotop:CanonicityValueRegion.
biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue a owl:Class;
                                                          rdfs:label "nucleic acid nucleotide or nucleoside molecule or residue";
                                                          rdfs:subClassOf biotop:OrganicMolecularEntityPartition.
biotop:NucleicAcidRegion a owl:Class;
                         rdfs:label "nucleic acid region";
                         rdfs:subClassOf biotop:DEPRECATED.
biotop:NucleicAcidStructure ru:definition "A nucleic acid is a complex, high-molecular-weight biochemical macromolecule composed of nucleotide chains that convey genetic information.";
                            a owl:Class;
                            rdfs:label "nucleic acid structure";
                            rdfs:subClassOf [owl:someValuesFrom biotop:NucleotideMolecule ; 
                                             owl:onProperty biotop:hasComponentPart ; 
                                             a owl:Restriction],
                                            [owl:onProperty biotop:hasComponentPart ; 
                                             owl:allValuesFrom biotop:NucleotideMolecule ; 
                                             a owl:Restriction],
                                            biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue.
biotop:NucleosideMolecule ru:definition "";
                          a owl:Class;
                          rdfs:label "nucleoside molecule";
                          rdfs:subClassOf [owl:someValuesFrom biotop:SubmolecularGroup ; 
                                           owl:onProperty biotop:hasComponentPart ; 
                                           a owl:Restriction],
                                          biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue.
biotop:NucleotideMolecule ru:definition "Comment: (QCR) hasComponent exactly 1 HeterocyclicBase and hasComponent exactly 1 Phosphate and hasComponent only (Phosphate or Ribose or HeterocyclicBase) and hasComponent exactly 1 Pentose";
                          a owl:Class;
                          rdfs:label "nucleotide molecule";
                          rdfs:subClassOf [owl:someValuesFrom biotop:SubmolecularGroup ; 
                                           owl:onProperty biotop:hasComponentPart ; 
                                           a owl:Restriction],
                                          biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue.
biotop:NucleotideSequenceInformation ru:definition "The information that describes the make-up of a (physical) nucleotide sequence.";
                                     a owl:Class;
                                     rdfs:label "nucleotide sequence information";
                                     rdfs:subClassOf biotop:DEPRECATED.
biotop:NurseRole ru:definition "The role a nurse plays";
                 a owl:Class;
                 rdfs:label "nurse role";
                 rdfs:subClassOf biotop:HealthProfessionalRole;
                 owl:disjointWith biotop:PhysicianRole.
biotop:ObjectQuality ru:definition "A quality that inheres in some material or immaterial physical object.";
                     a owl:Class;
                     rdfs:label "object quality";
                     rdfs:subClassOf [owl:onProperty biotop:qualityLocated ; 
                                      owl:allValuesFrom biotop:ValueRegion ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                       biotop:MaterialObject) ; 
                                                          a owl:Class] ; 
                                      owl:onProperty biotop:inheresIn ; 
                                      a owl:Restriction],
                                     biotop:Quality;
                     owl:disjointWith biotop:ProcessQuality.
biotop:ObservingAction a owl:Class;
                       rdfs:subClassOf biotop:Action.
biotop:OccupationalRole ru:definition "The role that determines the occupation that characterizes the daily life of a human being or animal.";
                        a owl:Class;
                        rdfs:label "occupational role";
                        rdfs:subClassOf biotop:Role.
biotop:OligoOrPolymer ru:definition "An oligo or polymer macromolecular structure is a molecule of moderate to high relative molecular mass, the structure of which essentially comprises the multiple repetition (n >= 2) of units derived from molecules of low relative molecular mass.";
                      a owl:Class;
                      rdfs:label "oligo or polymer";
                      rdfs:subClassOf [owl:onProperty biotop:hasComponentPart ; 
                                       owl:allValuesFrom biotop:Monomer ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom biotop:Monomer ; 
                                       owl:onProperty biotop:hasComponentPart ; 
                                       a owl:Restriction],
                                      biotop:MolecularEntityByGranularityPartition;
                      owl:disjointWith biotop:SubmolecularGroup.
biotop:OneDimensionalBoundary ru:definition "line bounding a two-dimensional biological entity";
                              a owl:Class;
                              rdfs:label "one dimensional boundary";
                              rdfs:subClassOf biotop:OneDimensionalPhysicalEntity;
                              owl:disjointWith biotop:TwoDimensionalBoundary;
                              owl:equivalentClass [owl:someValuesFrom biotop:TwoDimensionalPhysicalEntity ; 
                                                   owl:onProperty biotop:physicallyBounds ; 
                                                   a owl:Restriction].
biotop:OneDimensionalPhysicalEntity ru:definition "line or curve";
                                    a owl:Class;
                                    rdfs:label "one dimensional physical entity";
                                    rdfs:subClassOf biotop:ImmaterialObject.
biotop:OrderDipteraValueRegion a owl:Class;
                               rdfs:comment "EXAMPLE OF TAXON REGION";
                               rdfs:label "order diptera value region";
                               rdfs:subClassOf biotop:ClassInsectaValueRegion.
biotop:OrderEnterobacterialesValueRegion a owl:Class;
                                         rdfs:comment "EXAMPLE OF TAXON REGION";
                                         rdfs:label "order enterobacteriales value region";
                                         rdfs:subClassOf biotop:ClassGammaProteobacteriaValueRegion.
biotop:OrderPrimatesValueRegion a owl:Class;
                                rdfs:comment "EXAMPLE OF TAXON REGION";
                                rdfs:label "order primates value region";
                                rdfs:subClassOf biotop:ClassMammaliaValueRegion.
biotop:OrderSaccharomycetalesValueRegion a owl:Class;
                                         rdfs:comment "EXAMPLE OF TAXON REGION";
                                         rdfs:label "order saccharomycetales value region";
                                         rdfs:subClassOf biotop:ClassSaccharomycetesValueRegion.
biotop:Organ ru:definition "Macroscopic, well delimited, functionally and structurally characterized part of an organism. Exact criteria of what an organ is do not exist.";
             a owl:Class;
             rdfs:label "organ";
             rdfs:subClassOf biotop:OrganismPart.
biotop:OrganPart a owl:Class;
                 rdfs:label "organ part";
                 rdfs:seeAlso "FMAID:82472 Cardinal organ part";
                 rdfs:subClassOf biotop:OrganismPart.
biotop:OrganSystem a owl:Class;
                   rdfs:label "organ system";
                   rdfs:seeAlso "FMAID:7149 Organ system";
                   rdfs:subClassOf biotop:BodySystem.
biotop:OrganSystemPart a owl:Class;
                       rdfs:label "organ system part";
                       rdfs:seeAlso "FMAID:67509  Organ system subdivistion";
                       rdfs:subClassOf biotop:BodySystem.
biotop:OrganicMolecularEntity ru:definition "Substances containing carbon and its derivatives as their prinicipal elements, usually combined with itself and with atoms of one or more other element such as hydrogen, oxygen, nitrogen, sulfur, phosphorus, chlorine or fluorine. They exist in either carbon chain or carbon ring form. Excludes carbides, carbonates and carbon oxides.";
                              a owl:Class;
                              rdfs:label "organic molecular entity";
                              rdfs:subClassOf biotop:MolecularEntityByOrganicInorganicPartition.
biotop:OrganicMolecularEntityPartition a owl:Class;
                                       rdfs:comment "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.";
                                       owl:equivalentClass [owl:intersectionOf (biotop:OrganicMolecularEntity
                                                                                [owl:unionOf (biotop:AminoAcidOrPeptideMoleculeOrStructure
                                                                                             biotop:CarbohydrateMoleculeOrResidue
                                                                                             biotop:FattyAcidMoleculeOrResidue
                                                                                             biotop:HeterocyclicBaseMoleculeOrResidue
                                                                                             biotop:LipidMoleculeOrResidue
                                                                                             biotop:NucleicAcidNucleotideOrNucleosideMoleculeOrResidue) ; 
                                                                                a owl:Class]) ; 
                                                            a owl:Class].
biotop:OrganismAction ru:definition "Action that has some organism as agent";
                      a owl:Class;
                      rdfs:label "organism action";
                      rdfs:subClassOf biotop:BiologicalAction;
                      owl:equivalentClass [owl:someValuesFrom [owl:unionOf (biotop:LivingOrganism
                                                                            [owl:someValuesFrom biotop:LivingOrganism ; 
                                                                            owl:onProperty biotop:hasGranularPart ; 
                                                                            a owl:Restriction]) ; 
                                                               a owl:Class] ; 
                                           owl:onProperty biotop:hasAgent ; 
                                           a owl:Restriction].
biotop:OrganismByDevelopmentalStagePartition ru:definition "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.";
                                             a owl:Class;
                                             rdfs:subClassOf [owl:unionOf (biotop:AdultOrganism
                                                                           biotop:EmbryonicOrganism
                                                                           biotop:JuvenileOrganism) ; 
                                                              a owl:Class];
                                             owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                                      [owl:unionOf (biotop:AdultOrganism
                                                                                                   biotop:EmbryonicOrganism
                                                                                                   biotop:JuvenileOrganism) ; 
                                                                                      a owl:Class]) ; 
                                                                  a owl:Class].
biotop:OrganismByTaxonPartition a owl:Class;
                                rdfs:comment "Ontologically irrelevant partitioning node. Used for improving ontology housekeeping. Its purpose is to express that all subclasses are mutually disjoint.";
                                owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                         [owl:unionOf (biotop:Eukaryote
                                                                                      biotop:Prokaryote
                                                                                      biotop:Virus) ; 
                                                                         a owl:Class]) ; 
                                                     a owl:Class].
biotop:OrganismInteraction ru:definition "action in which single biological organisms interact";
                           a owl:Class;
                           rdfs:label "organism interaction";
                           rdfs:subClassOf [owl:onProperty biotop:hasParticipant ; 
                                            owl:allValuesFrom biotop:LivingOrganism ; 
                                            a owl:Restriction],
                                           biotop:Interacting.
biotop:OrganismPart ru:definition "A well defined and circumscribed subdivision of an organism, not any arbitrary part. Macroscopic organism parts may be delimited mainly by natural boundaries but always exhibit at least small regions of fiat boundaries. An organism part may derive from an organism, i.e. it may continue to exist even when the organism does not exist any longer.";
                    a owl:Class;
                    rdfs:label "organism part";
                    rdfs:subClassOf biotop:StructuredBiologicalCompoundByGranularityPartition;
                    owl:disjointWith biotop:Syncytium;
                    owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom biotop:Tissue ; 
                                                             owl:onProperty biotop:hasProperPhysicalPart ; 
                                                             a owl:Restriction]
                                                             [owl:someValuesFrom biotop:MulticellularOrganism ; 
                                                             owl:onProperty biotop:originatesFrom ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class].
biotop:OrganismProcess ru:definition "any biological process that involves a whole organism";
                       a owl:Class;
                       rdfs:label "organism process";
                       owl:equivalentClass [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                                [owl:someValuesFrom biotop:LivingOrganism ; 
                                                                owl:onProperty biotop:hasParticipant ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:Organization ru:definition "collection of human or legal entities";
                    a owl:Class;
                    rdfs:label "organization";
                    rdfs:subClassOf biotop:LegalEntity.
biotop:ParentRole ru:definition "the role an organism plays in relation to its children";
                  a owl:Class;
                  rdfs:label "parent role";
                  rdfs:subClassOf biotop:FamilyRole.
biotop:Particular ru:definition """From an universalist point of view most BioTop classes can be considered the extension of universals. 

However, BioTop does not claim that all of its classes are the extension of universals and is agnostic with regard to the existence of universals and the delineation between universals and non-universals.
""";
                  a owl:Class;
                  owl:priorVersion "particular entity".
biotop:ParticularEntity a owl:Class;
                        rdfs:subClassOf biotop:DEPRECATED.
biotop:PathologicalCondition ru:definition """pathological structure, disposition, or process. This disjoint category helps properly represent diseases becauses it is often left open whether they are meant as pathological structure, disposition, or process.

In case this is to be left open, the relation has_locus should be used to connect them to anatomical entities""";
                             a owl:Class;
                             rdfs:label "pathological condition";
                             rdfs:subClassOf biotop:Condition;
                             owl:equivalentClass [owl:unionOf (biotop:PathologicalDisposition
                                                               biotop:PathologicalProcess
                                                               biotop:PathologicalStructure) ; 
                                                  a owl:Class].
biotop:PathologicalDisposition ru:definition """any kind of disposition considered non-canonical. The criteria of canonicity are not further specified. 
The classification of certain dispositions as dysfunctional or pathological is dependent on a historic and cultural context. Dysfunction or disease therefore hasn't the status of a universal.""";
                               a owl:Class;
                               rdfs:label "pathological disposition";
                               rdfs:subClassOf biotop:Disposition;
                               owl:equivalentClass [owl:intersectionOf (biotop:Disposition
                                                                        [owl:someValuesFrom [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                                    [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                                                    owl:onProperty biotop:qualityLocated ; 
                                                                                                                                    a owl:Restriction]) ; 
                                                                                                                a owl:Class] ; 
                                                                                            owl:onProperty biotop:bearerOf ; 
                                                                                            a owl:Restriction] ; 
                                                                        owl:onProperty biotop:inheresIn ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class];
                               owl:priorVersion """prior label \"dysfunction\"""".
biotop:PathologicalProcess ru:definition "a biological process which is non-canonic";
                           a owl:Class;
                           rdfs:label "pathological process";
                           owl:equivalentClass [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                                    [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                            [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                            owl:onProperty biotop:qualityLocated ; 
                                                                                                            a owl:Restriction]) ; 
                                                                                        a owl:Class] ; 
                                                                    owl:onProperty biotop:hasProcessQuality ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:PathologicalStaticProcessualEntity a owl:Class;
                                          rdfs:comment """Condition of an organism that deviates from what is considered normal. Often referred to by the terms \"disorder\", \"disease\", \"syndrome\", \"sign\", or \"symptom\". None of these denote clearly delineated ontological categories. 

See disease role etc.""";
                                          rdfs:label "pathological static processual entity";
                                          rdfs:subClassOf biotop:NoncanonicalStaticProcessualEntity;
                                          owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom [owl:unionOf (biotop:StructuredBiologicalEntity
                                                                                                                    [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                                                                    owl:onProperty biotop:hasGranularPart ; 
                                                                                                                    a owl:Restriction]) ; 
                                                                                                       a owl:Class] ; 
                                                                                   owl:onProperty biotop:hasParticipant ; 
                                                                                   a owl:Restriction]
                                                                                   [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                           [owl:someValuesFrom biotop:PathologicalValueRegion ; 
                                                                                                                           owl:onProperty biotop:qualityLocated ; 
                                                                                                                           a owl:Restriction]) ; 
                                                                                                       a owl:Class] ; 
                                                                                   owl:onProperty biotop:hasProcessQuality ; 
                                                                                   a owl:Restriction]) ; 
                                                               a owl:Class];
                                          owl:priorVersion "pathological state".
biotop:PathologicalStructure ru:definition "biological structure that is non-canonic";
                             a owl:Class;
                             rdfs:label "pathological structure";
                             rdfs:subClassOf biotop:StructuredBiologicalCompoundByCanonicityPartition;
                             owl:disjointWith biotop:WellFormedBiologicalStructure;
                             owl:equivalentClass [owl:intersectionOf (biotop:StructuredBiologicalEntity
                                                                      [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                              [owl:someValuesFrom biotop:NoncanonicalValueRegion ; 
                                                                                                              owl:onProperty biotop:qualityLocated ; 
                                                                                                              a owl:Restriction]) ; 
                                                                                          a owl:Class] ; 
                                                                      owl:onProperty biotop:bearerOf ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class];
                             owl:priorVersion """former name: \"ill formed biological structure\"""".
biotop:PathologicalValueRegion ru:definition "state of an organism or an organism part requiring therapeutic or palliative intervention";
                               a owl:Class;
                               rdfs:label "pathological value region";
                               rdfs:subClassOf [owl:intersectionOf (biotop:NoncanonicalValueRegion
                                                                    [owl:unionOf ([owl:intersectionOf (biotop:Canonicity
                                                                                                     [owl:someValuesFrom [owl:unionOf (biotop:LivingOrganism
                                                                                                                                      biotop:OrganismPart) ; 
                                                                                                                         a owl:Class] ; 
                                                                                                     owl:onProperty biotop:processQualityOf ; 
                                                                                                     a owl:Restriction]) ; 
                                                                                 a owl:Class]
                                                                                 [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                         [owl:someValuesFrom [owl:unionOf (biotop:LivingOrganism
                                                                                                                                                          biotop:OrganismPart) ; 
                                                                                                                                             a owl:Class] ; 
                                                                                                                         owl:onProperty biotop:inheresIn ; 
                                                                                                                         a owl:Restriction]) ; 
                                                                                                     a owl:Class] ; 
                                                                                 owl:onProperty biotop:qualityLocationOf ; 
                                                                                 a owl:Restriction]) ; 
                                                                    a owl:Class]) ; 
                                                a owl:Class].
biotop:PeptideFunction ru:definition "Inherent Function of a protein or a part of it.";
                       a owl:Class;
                       rdfs:label "peptide function";
                       owl:equivalentClass [owl:intersectionOf (biotop:MolecularFunction
                                                                [owl:someValuesFrom biotop:PeptideStructure ; 
                                                                owl:onProperty biotop:inheresIn ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:PeptideStructure a owl:Class;
                        rdfs:comment "Comment: We here use the term peptide in the most general sense, viz. a oligo or polymer made out of amino acids.";
                        rdfs:label "peptide structure";
                        rdfs:subClassOf [owl:someValuesFrom biotop:AminoAcidMoleculeOrResidue ; 
                                         owl:onProperty biotop:hasComponentPart ; 
                                         a owl:Restriction],
                                        biotop:AminoAcidOrPeptideMoleculeOrStructure.
biotop:Phosphate ru:definition "Phosphate is a salt of phosphoric acid or a functional group on organic compounds.";
                 a owl:Class;
                 rdfs:label "phosphate";
                 rdfs:subClassOf biotop:InorganicMolecularEntity.
biotop:PhylumArthropodaValueRegion a owl:Class;
                                   rdfs:comment "EXAMPLE OF TAXON REGION";
                                   rdfs:label "phylum arthropoda value region";
                                   rdfs:subClassOf biotop:KingdomAnimaliaValueRegion;
                                   owl:disjointWith biotop:PhylumChordataValueRegion.
biotop:PhylumAscomycotaValueRegion a owl:Class;
                                   rdfs:comment "EXAMPLE OF TAXON REGION";
                                   rdfs:label "phylum ascomycota value region";
                                   rdfs:subClassOf biotop:KingdomFungiValueRegion.
biotop:PhylumChordataValueRegion a owl:Class;
                                 rdfs:comment "EXAMPLE OF TAXON REGION";
                                 rdfs:label "phylum chordata value region";
                                 rdfs:subClassOf biotop:KingdomAnimaliaValueRegion.
biotop:PhylumProteobacteriaValueRegion a owl:Class;
                                       rdfs:comment "EXAMPLE OF TAXON REGION";
                                       rdfs:label "phylum proteobacteria value region";
                                       rdfs:subClassOf biotop:KingdomBacteriaValueRegion.
biotop:PhysicalBoundary ru:definition "A independent physical entity that bounds or demarcates some other physical entity. Commonly viewed as a lower-dimensional part, the the notion of physical boundary here also encompasses ill-delimited spaces that fulfill the same function, e.g. biological joints.";
                        a owl:Class;
                        rdfs:label "physical boundary";
                        rdfs:subClassOf biotop:ImmaterialObject;
                        owl:equivalentClass [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                              biotop:MaterialObject) ; 
                                                                 a owl:Class] ; 
                                             owl:onProperty biotop:physicallyBounds ; 
                                             a owl:Restriction].
biotop:PhysicalForce ru:definition "force as defined by physics (mass + acceleration)";
                     a owl:Class;
                     rdfs:label "physical force";
                     rdfs:subClassOf biotop:ProcessQuality.
biotop:PhysicalLength ru:definition "physical length (e.g. in meters)";
                      a owl:Class;
                      rdfs:label "physical length";
                      rdfs:subClassOf [owl:onProperty biotop:inheresIn ; 
                                       owl:allValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                       biotop:MaterialObject) ; 
                                                          a owl:Class] ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                        biotop:MaterialObject) ; 
                                                           a owl:Class] ; 
                                       owl:onProperty biotop:inheresIn ; 
                                       a owl:Restriction],
                                      biotop:ObjectQuality.
biotop:PhysicalMass ru:definition "Mass (gravity independent) - not weight. Measured in g, kg, ...";
                    a owl:Class;
                    rdfs:label "physical mass";
                    rdfs:subClassOf [owl:onProperty biotop:inheresIn ; 
                                     owl:allValuesFrom biotop:MaterialObject ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom biotop:MaterialObject ; 
                                     owl:onProperty biotop:inheresIn ; 
                                     a owl:Restriction],
                                    biotop:ObjectQuality.
biotop:PhysicalProcessualEntity ru:definition "process that only involves non-biological participants";
                                a owl:Class;
                                rdfs:label "physical processual entity";
                                rdfs:subClassOf [owl:complementOf biotop:BiologicalProcessualEntity ; 
                                                 a owl:Class],
                                                biotop:Process.
biotop:PhysicalState ru:definition "Quality of being solid, liquid, gaseous, ...  [steschu20080127]";
                     a owl:Class;
                     rdfs:comment "former name: StateOfAggregation";
                     rdfs:label "physical state";
                     rdfs:subClassOf [owl:onProperty biotop:inheresIn ; 
                                      owl:allValuesFrom biotop:MaterialObject ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom biotop:MaterialObject ; 
                                      owl:onProperty biotop:inheresIn ; 
                                      a owl:Restriction],
                                     biotop:ObjectQuality.
biotop:PhysicalVolume ru:definition "Volume of three-dimensional objects - third potency of length";
                      a owl:Class;
                      rdfs:label "physical volume";
                      rdfs:subClassOf [owl:onProperty biotop:inheresIn ; 
                                       owl:allValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                       biotop:MaterialObject) ; 
                                                          a owl:Class] ; 
                                       a owl:Restriction],
                                      [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                        biotop:MaterialObject) ; 
                                                           a owl:Class] ; 
                                       owl:onProperty biotop:inheresIn ; 
                                       a owl:Restriction],
                                      biotop:ObjectQuality.
biotop:PhysicianRole ru:definition "The role a physician plays";
                     a owl:Class;
                     rdfs:label "physician role";
                     rdfs:subClassOf biotop:HealthProfessionalRole.
biotop:Plan ru:definition "A plan is an information entity that describes a series of steps to be carried out in order to achiev a goal. Plans can only be realized by processes.";
            a owl:Class;
            rdfs:comment "(OBI 344)";
            rdfs:label "plan";
            rdfs:subClassOf [owl:onProperty biotop:hasRealization ; 
                             owl:allValuesFrom biotop:Process ; 
                             a owl:Restriction],
                            biotop:InformationObject.
biotop:Plant ru:definition "Organism of the kingdom Plantae.";
             a owl:Class;
             rdfs:label "plant";
             rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                      [owl:someValuesFrom biotop:KingdomPlantaeValueRegion ; 
                                                                      owl:onProperty biotop:qualityLocated ; 
                                                                      a owl:Restriction]) ; 
                                                  a owl:Class] ; 
                              owl:onProperty biotop:bearerOf ; 
                              a owl:Restriction],
                             biotop:Eukaryote.
biotop:PlantCell a owl:Class;
                 rdfs:label "plant cell";
                 rdfs:subClassOf biotop:CellByTaxonPartition;
                 owl:equivalentClass [owl:intersectionOf (biotop:Cell
                                                          [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                                                  [owl:someValuesFrom biotop:KingdomPlantaeValueRegion ; 
                                                                                                  owl:onProperty biotop:qualityLocated ; 
                                                                                                  a owl:Restriction]) ; 
                                                                              a owl:Class] ; 
                                                          owl:onProperty biotop:bearerOf ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class].
biotop:PlantPopulation a owl:Class;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "plant population";
                       owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                [owl:someValuesFrom biotop:Plant ; 
                                                                owl:onProperty biotop:hasGranularPart ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty biotop:hasGranularPart ; 
                                                                owl:allValuesFrom biotop:Plant ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:PluralityOfIdenticalPolymolecularEntities ru:definition "collection of identical things of the same sort";
                                                 a owl:Class;
                                                 rdfs:label "plurality of identical polymolecular entities";
                                                 rdfs:subClassOf biotop:CollectiveMaterialEntity.
biotop:PluralityOfOrganisms ru:definition "Collection of two or more organisms of the same sort.  ";
                            a owl:Class;
                            rdfs:label "plurality of organisms";
                            rdfs:subClassOf [owl:someValuesFrom biotop:TaxonQuality ; 
                                             owl:onProperty biotop:bearerOf ; 
                                             a owl:Restriction],
                                            [owl:onProperty biotop:hasGranularPart ; 
                                             owl:allValuesFrom biotop:LivingOrganism ; 
                                             a owl:Restriction],
                                            [owl:someValuesFrom biotop:LivingOrganism ; 
                                             owl:onProperty biotop:hasGranularPart ; 
                                             a owl:Restriction],
                                            biotop:CollectiveMaterialEntity.
biotop:PointInTime ru:definition "typically the boundary of a time interval";
                   a owl:Class;
                   rdfs:label "point in time";
                   rdfs:subClassOf biotop:Time;
                   owl:disjointWith biotop:TimeInterval.
biotop:PoisonRole ru:definition "The role of a substance of mixture of substance of a defined amount thereof to be toxic to (parts of) biological organisms";
                  a owl:Class;
                  rdfs:label "poison role";
                  rdfs:subClassOf biotop:HealthRelatedRole.
biotop:Poisoning a owl:Class;
                 rdfs:comment "negatively affecting the integrity of a biologival system caused by one or more chemical substances";
                 rdfs:label "poisoning";
                 rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (biotop:AmountOfPureSubstance
                                                                   biotop:CompoundOfCollectiveMaterialEntities) ; 
                                                      a owl:Class] ; 
                                  owl:onProperty biotop:hasAgent ; 
                                  a owl:Restriction],
                                 biotop:ActionOnBiologicalSystem.
biotop:PolyMolecularCompositeEntity ru:definition "An object which contains several molecules, has direct parts (components) of different types and which changes its ontological nature if subdivided. It must have clear unity and identity criteria.";
                                    a owl:Class;
                                    rdfs:label "poly molecular composite entity";
                                    rdfs:subClassOf [owl:someValuesFrom biotop:EntireMolecularEntity ; 
                                                     owl:onProperty biotop:hasProperPhysicalPart ; 
                                                     a owl:Restriction],
                                                    biotop:MaterialEntityBySizePartition.
biotop:Population ru:definition """Collection of Organisms of a defined taxon living in a given geographic area. In contrast to the \"official\" definition (\"same species\") this definition is broader and corresponds better to the use of the term in some contexts (e.g. \"mixed population of 2 species\")""";
                  a owl:Class;
                  rdfs:comment "all child classes of population are only meant as examples demonstrating how population classes can be postcoordinated";
                  rdfs:label "population";
                  rdfs:subClassOf biotop:PluralityOfOrganisms.
biotop:PortionOfHeterogenousLiquid ru:definition "Liquid constituted by different kinds of collectives, e.g. aqueous NaCl solution";
                                   a owl:Class;
                                   rdfs:label "portion of heterogenous liquid";
                                   rdfs:subClassOf biotop:CompoundOfCollectiveMaterialEntities;
                                   owl:equivalentClass [owl:intersectionOf (biotop:CompoundOfCollectiveMaterialEntities
                                                                            [owl:someValuesFrom [owl:someValuesFrom biotop:LiquidValueRegion ; 
                                                                                                owl:onProperty biotop:qualityLocated ; 
                                                                                                a owl:Restriction] ; 
                                                                            owl:onProperty biotop:bearerOf ; 
                                                                            a owl:Restriction]) ; 
                                                        a owl:Class].
biotop:PortionOfHeterogenousSolid ru:definition "Solid constituted by different kinds of collectives, e.g. a NaCl crystal, granite";
                                  a owl:Class;
                                  rdfs:label "portion of heterogenous solid";
                                  owl:equivalentClass [owl:intersectionOf (biotop:CompoundOfCollectiveMaterialEntities
                                                                           [owl:someValuesFrom [owl:someValuesFrom biotop:LiquidValueRegion ; 
                                                                                               owl:onProperty biotop:qualityLocated ; 
                                                                                               a owl:Restriction] ; 
                                                                           owl:onProperty biotop:bearerOf ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class].
biotop:PortionOfHomogenousMatter ru:definition "Composition of granular components of the same kind.";
                                 a owl:Class;
                                 rdfs:label "portion of homogenous matter";
                                 rdfs:subClassOf biotop:DEPRECATED.
biotop:PreventionAction ru:definition """Hinders a  process or the realization of a  function. As the second argument represents sth non-existent, it cannot be expressed in FOL. Hence the special status of this class. (Cf. Condovardi et al. \"Preventing Existence, FOIS 2001)""";
                        a owl:Class;
                        rdfs:label "prevention action";
                        rdfs:subClassOf [owl:intersectionOf ([owl:onProperty biotop:hasAgent ; 
                                                             owl:allValuesFrom biotop:MaterialObject ; 
                                                             a owl:Restriction]
                                                             [owl:onProperty biotop:hasPatient ; 
                                                             owl:allValuesFrom biotop:Process ; 
                                                             a owl:Restriction]) ; 
                                         a owl:Class],
                                        biotop:Action.
biotop:PreventiveRole ru:definition "The role an action plays if it is intended to protect an organism against negative external influences.";
                      a owl:Class;
                      rdfs:label "preventive role";
                      rdfs:subClassOf biotop:HealthRelatedRole.
biotop:Primate a owl:Class;
               rdfs:comment "one primate";
               rdfs:label "primate";
               rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                        [owl:someValuesFrom biotop:OrderPrimatesValueRegion ; 
                                                                        owl:onProperty biotop:qualityLocated ; 
                                                                        a owl:Restriction]
                                                                        [owl:onProperty biotop:qualityLocated ; 
                                                                        owl:allValuesFrom biotop:OrderPrimatesValueRegion ; 
                                                                        a owl:Restriction]) ; 
                                                    a owl:Class] ; 
                                owl:onProperty biotop:bearerOf ; 
                                a owl:Restriction],
                               biotop:GreatApe.
biotop:PrimatePopulation a owl:Class;
                         rdfs:comment "EXAMPLE OF POPULATION";
                         rdfs:label "primate population";
                         owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                  [owl:someValuesFrom biotop:Primate ; 
                                                                  owl:onProperty biotop:hasGranularPart ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty biotop:hasGranularPart ; 
                                                                  owl:allValuesFrom biotop:Primate ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:Process ru:definition """Process is in BioTop the generic subsumer of anything that \"occurs\". 
Processes can span across time and have temporal parts (i.e. there is no time in which all parts of a process are simultaneously present). 

A special kind of process is the event, which has no temporal extension. It can be regarded as Process Boundary (BFO).


Processes have physical or informational entities as participants.""";
               a owl:Class;
               rdfs:label "process";
               rdfs:subClassOf [owl:unionOf ([owl:someValuesFrom biotop:TimeInterval ; 
                                             owl:onProperty biotop:hasDuration ; 
                                             a owl:Restriction]
                                             [owl:someValuesFrom biotop:PointInTime ; 
                                             owl:onProperty biotop:hasPointInTime ; 
                                             a owl:Restriction]) ; 
                                a owl:Class],
                               biotop:Particular;
               owl:equivalentClass [owl:intersectionOf (biotop:Particular
                                                        [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                                         biotop:InformationObject
                                                                                         biotop:MaterialObject) ; 
                                                                            a owl:Class] ; 
                                                        owl:onProperty biotop:hasParticipant ; 
                                                        a owl:Restriction]) ; 
                                    a owl:Class];
               owl:priorVersion "processual entity".
biotop:ProcessQuality ru:definition "A quality that inheres in some process";
                      a owl:Class;
                      rdfs:label "process quality";
                      rdfs:subClassOf [owl:someValuesFrom biotop:Process ; 
                                       owl:onProperty biotop:processQualityOf ; 
                                       a owl:Restriction],
                                      biotop:Quality.
biotop:Producing ru:definition "action in which a new physical or informational entity comes into being";
                 a owl:Class;
                 rdfs:label "producing";
                 rdfs:subClassOf biotop:Affecting.
biotop:Prokaryote ru:definition "Cell lacking membrane enclosed organells";
                  a owl:Class;
                  rdfs:label "prokaryote";
                  rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                       owl:onProperty biotop:qualityLocated ; 
                                                       a owl:Restriction] ; 
                                   owl:onProperty biotop:bearerOf ; 
                                   a owl:Restriction],
                                  biotop:OrganismByTaxonPartition.
biotop:ProteinComplex ru:definition "Mostly only proteins but composition with other molecules possible (e.g. Fe -> Hemoglobin) or also lipoproteins";
                      a owl:Class;
                      rdfs:label "protein complex";
                      rdfs:subClassOf biotop:MoleculeComplex;
                      owl:equivalentClass [owl:intersectionOf ([owl:someValuesFrom biotop:EntireProteinMolecule ; 
                                                               owl:onProperty biotop:hasComponentPart ; 
                                                               a owl:Restriction]
                                                               [owl:onProperty biotop:hasComponentPart ; 
                                                               owl:allValuesFrom [owl:unionOf (biotop:EntireProteinMolecule
                                                                                               biotop:MonoMolecularEntity) ; 
                                                                                  a owl:Class] ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
biotop:ProteinDomain ru:definition "Structural domain is the smallest element of protein tertiary structure that is self-stabilizing and often folds independently of the rest of the amino acid chain. It may contain one or more structural motives (ProteinSubstructure). A protein domain typically has its own function, the overall function of the protein results from the composition of the functions of all of its structural domains.";
                     a owl:Class;
                     rdfs:label "protein domain";
                     rdfs:subClassOf [owl:someValuesFrom biotop:EntireProteinMolecule ; 
                                      owl:onProperty biotop:properPhysicalPartOf ; 
                                      a owl:Restriction],
                                     biotop:PeptideStructure.
biotop:ProteinSubstructure ru:definition "A secondary substructure of a protein (protein Motif)";
                           a owl:Class;
                           rdfs:label "protein substructure";
                           rdfs:subClassOf [owl:someValuesFrom biotop:EntireProteinMolecule ; 
                                            owl:onProperty biotop:properPhysicalPartOf ; 
                                            a owl:Restriction],
                                           biotop:PeptideStructure.
biotop:ProteinSubunit ru:definition "A protein molecule that assembles with other protein molecules to form a protein complex. May have its own function. However, most proteinsubunits do not gain functionality until associated with the other subunits.";
                      a owl:Class;
                      rdfs:label "protein subunit";
                      rdfs:subClassOf biotop:EntireProteinMolecule.
biotop:Protist ru:definition "Organisms of the kingdom Protista";
               a owl:Class;
               rdfs:label "protist";
               rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                    owl:onProperty biotop:qualityLocated ; 
                                                    a owl:Restriction] ; 
                                owl:onProperty biotop:bearerOf ; 
                                a owl:Restriction],
                               biotop:Eukaryote.
biotop:ProtistPopulation a owl:Class;
                         rdfs:comment "EXAMPLE OF POPULATION";
                         rdfs:label "protist population";
                         owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                  [owl:someValuesFrom biotop:Protist ; 
                                                                  owl:onProperty biotop:hasGranularPart ; 
                                                                  a owl:Restriction]
                                                                  [owl:onProperty biotop:hasGranularPart ; 
                                                                  owl:allValuesFrom biotop:Protist ; 
                                                                  a owl:Restriction]) ; 
                                              a owl:Class].
biotop:Proton ru:definition "Positively Charged Particle";
              a owl:Class;
              rdfs:label "proton";
              rdfs:subClassOf biotop:SubatomicEntityByChargePartition.
biotop:Quality a owl:Class;
               rdfs:label "Quality";
               rdfs:subClassOf biotop:Particular;
               owl:equivalentClass [owl:intersectionOf (biotop:Particular
                                                        [owl:unionOf (biotop:ObjectQuality
                                                                     biotop:ProcessQuality) ; 
                                                        a owl:Class]) ; 
                                    a owl:Class].
biotop:RNAChain ru:definition "any kind of NucleicAcid that is composed of Ribonucleotides which are not Deoxyribonucleotides";
                a owl:Class;
                rdfs:label "RNA chain";
                rdfs:subClassOf biotop:ChainOfNucleotideMonomers.
biotop:Radiation ru:definition "process in which energy-rich particles or electromagnetic waves participate";
                 a owl:Class;
                 rdfs:label "radiation";
                 owl:equivalentClass [owl:intersectionOf (biotop:PhysicalProcessualEntity
                                                          [owl:someValuesFrom [owl:unionOf (biotop:AlphaParticle
                                                                                           biotop:SubatomicParticle
                                                                                           biotop:Wave) ; 
                                                                              a owl:Class] ; 
                                                          owl:onProperty biotop:hasParticipant ; 
                                                          a owl:Restriction]) ; 
                                      a owl:Class].
biotop:ReagentRole ru:definition "A role a chemical plays as participant in a chemical reation";
                   a owl:Class;
                   rdfs:label "reagent role";
                   rdfs:subClassOf biotop:ChemicalRole.
biotop:ReceptorRole ru:definition "The role a (membrane) protein or protein complex plays in acting as a receptor.";
                    a owl:Class;
                    rdfs:label "receptor role";
                    rdfs:subClassOf biotop:SignallingRole.
biotop:RegulationOrLaw ru:definition "set of rules governing a particular kind of activity (WordNet)";
                       a owl:Class;
                       rdfs:label "regulation or law";
                       rdfs:subClassOf biotop:IntellectualProduct.
biotop:RegulatoryBody ru:definition "organization that has the function of issuing regulations or laws";
                      a owl:Class;
                      rdfs:label "regulatory body";
                      rdfs:subClassOf biotop:Organization.
biotop:Reptile a owl:Class;
               rdfs:label "reptile";
               rdfs:subClassOf biotop:Vertebrate.
biotop:ResearcherRole ru:definition "the role a human plays if he / she is involved in research activities";
                      a owl:Class;
                      rdfs:label "researcher role";
                      rdfs:subClassOf biotop:OccupationalRole.
biotop:RickettsiaCell a owl:Class;
                      rdfs:label "rickettsia cell";
                      rdfs:subClassOf biotop:Prokaryote.
biotop:Role ru:definition """A role is a realizable entity the manifestation of which brings about some result or end that is not essential to its bearer in virtue of the kind of thing that it is, but that can be served or participated in by that kind of continuant entity in some kinds of natural, social or institutional
contexts.""";
            a owl:Class;
            rdfs:label "role";
            rdfs:subClassOf [owl:intersectionOf (biotop:Particular
                                                 [owl:someValuesFrom biotop:Particular ; 
                                                 owl:onProperty biotop:inheresIn ; 
                                                 a owl:Restriction]) ; 
                             a owl:Class].
biotop:SiblingRole ru:definition "the role an organism plays in relation to another organism that has the same parents";
                   a owl:Class;
                   rdfs:label "sibling role";
                   rdfs:subClassOf biotop:FamilyRole.
biotop:SignOrSymptomRole ru:definition "A role that can inhere in states, processes, or even in certain independent continuants (e.g. in a deformity). This a role is ascribed to an entity in a diagnostic process where the symptom is suspected to indicate a second state or process)";
                         a owl:Class;
                         rdfs:label "sign or symptom role";
                         rdfs:subClassOf biotop:FindingRole.
biotop:SignallingRole ru:definition "The role of a biological entity that participates in a biological signalling process.";
                      a owl:Class;
                      rdfs:label "signalling role";
                      rdfs:subClassOf [owl:someValuesFrom biotop:MonoMolecularEntity ; 
                                       owl:onProperty biotop:inheresIn ; 
                                       a owl:Restriction],
                                      biotop:BiologicalSystemRole.
biotop:SocialAction ru:definition "action that targets a population";
                    a owl:Class;
                    rdfs:label "social action";
                    rdfs:subClassOf [owl:onProperty biotop:hasAgent ; 
                                     owl:allValuesFrom [owl:unionOf (biotop:HumanPopulation
                                                                     biotop:Organization) ; 
                                                        a owl:Class] ; 
                                     a owl:Restriction],
                                    biotop:Action.
biotop:SocialBehavior ru:definition "Behaviour of a group of organisms";
                      a owl:Class;
                      rdfs:label "social behavior";
                      owl:equivalentClass [owl:intersectionOf (biotop:Behavior
                                                               [owl:someValuesFrom biotop:Population ; 
                                                               owl:onProperty biotop:hasAgent ; 
                                                               a owl:Restriction]) ; 
                                           a owl:Class].
biotop:SolidValueRegion a owl:Class;
                        rdfs:comment """\"solid\" as the value of a states of matter. E.g. a stone has a quality which has its value located in \"solid value region\"""";
                        rdfs:label "solid value region";
                        rdfs:subClassOf biotop:StateOfMatterValueRegion.
biotop:SpatialReferenceRole ru:definition "The role attributed to a - mainly fiat - part of an object that is the site of some process or the location of some object of interest.";
                            a owl:Class;
                            rdfs:label "spatial reference role";
                            rdfs:subClassOf biotop:Role.
biotop:SpatialRegion ru:definition "An independent continuant entity that is neither a bearer of qualities nor inheres in any other entity (snap:SpatialRegion)";
                     a owl:Class;
                     rdfs:label "spatial region";
                     rdfs:subClassOf biotop:ImmaterialThreeDimensionalPhysicalEntity.
biotop:SpeciesCandidaAlbicansValueRegion a owl:Class;
                                         rdfs:comment "EXAMPLE OF TAXON REGION";
                                         rdfs:label "species candida albicans value region";
                                         rdfs:subClassOf biotop:GenusCandidaValueRegion.
biotop:SpeciesDrosophilaMelanogasterValueRegion a owl:Class;
                                                rdfs:comment "EXAMPLE OF TAXON REGION";
                                                rdfs:label "species drosophila melanogaster value region";
                                                rdfs:subClassOf biotop:GenusDrosophilaValueRegion.
biotop:SpeciesEscherichiaColiValueRegion a owl:Class;
                                         rdfs:comment "EXAMPLE OF TAXON REGION";
                                         rdfs:label "species escherichia coli value region";
                                         rdfs:subClassOf biotop:GenusEscherichiaValueRegion.
biotop:SpeciesHomoSapiensValueRegion a owl:Class;
                                     rdfs:comment "EXAMPLE OF TAXON REGION";
                                     rdfs:label "species homo sapiens value region";
                                     rdfs:subClassOf biotop:GenusHomoValueRegion.
biotop:SpeciesSaccharomycesCerevisiaeValueRegion a owl:Class;
                                                 rdfs:comment "EXAMPLE OF TAXON REGION";
                                                 rdfs:label "species saccharomyces cerevisiae value region";
                                                 rdfs:subClassOf biotop:GenusSaccharomycesValueRegion.
biotop:StateOfMatter ru:definition "States of matter are the distinct forms that different phases of matter take on.";
                     a owl:Class;
                     rdfs:label "state of matter";
                     rdfs:subClassOf [owl:onProperty biotop:qualityLocated ; 
                                      owl:allValuesFrom biotop:StateOfMatterValueRegion ; 
                                      a owl:Restriction],
                                     [owl:someValuesFrom biotop:StateOfMatterValueRegion ; 
                                      owl:onProperty biotop:qualityLocated ; 
                                      a owl:Restriction],
                                     biotop:ObjectQuality.
biotop:StateOfMatterValueRegion ru:definition "Values that a states of matter can have, e.g. liquid, solid.";
                                a owl:Class;
                                rdfs:label "state of matter value region";
                                rdfs:subClassOf [owl:someValuesFrom biotop:StateOfMatter ; 
                                                 owl:onProperty biotop:qualityLocationOf ; 
                                                 a owl:Restriction],
                                                biotop:ValueRegion.
biotop:StaticProcessualEntity a owl:Class;
                              rdfs:comment "Static condition as a special case of process in which temporal parts are neglected.  ";
                              rdfs:label "static processual entity";
                              rdfs:subClassOf [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialObject
                                                                                biotop:InformationObject
                                                                                biotop:MaterialObject
                                                                                biotop:PhysicalBoundary) ; 
                                                                   a owl:Class] ; 
                                               owl:onProperty biotop:hasParticipant ; 
                                               a owl:Restriction],
                                              biotop:Process;
                              owl:priorVersion "State".
biotop:Steroid ru:definition "One of a group of polycyclic, 17-carbon-atom, fused-ring compounds occurring both in natural and synthetic forms. Included here are naturally occurring and synthetic steroids, bufanolides, cardanolides, homosteroids, norsteroids, and secosteroids. (UMLS SN)";
               a owl:Class;
               rdfs:label "steroid";
               rdfs:subClassOf biotop:LipidMoleculeOrResidue.
biotop:StructuredBiologicalCompoundByCanonicityPartition ru:definition """StructuredBiologicalCompoundByCanonicityPartition

ontologically irrelevant partition node""";
                                                         a owl:Class;
                                                         rdfs:label "*";
                                                         owl:equivalentClass [owl:intersectionOf (biotop:StructuredBiologicalEntity
                                                                                                  [owl:unionOf (biotop:PathologicalStructure
                                                                                                               biotop:WellFormedBiologicalStructure) ; 
                                                                                                  a owl:Class]) ; 
                                                                              a owl:Class].
biotop:StructuredBiologicalCompoundByGranularityPartition a owl:Class;
                                                          rdfs:comment """StructuredBiologicalCompoundByGranularityPartition

ontologically irrelevant disjoint partition: structured biological compound by granularity""";
                                                          rdfs:label "*";
                                                          owl:equivalentClass [owl:intersectionOf (biotop:StructuredBiologicalEntity
                                                                                                   [owl:unionOf (biotop:Cell
                                                                                                                biotop:CellularComponent
                                                                                                                biotop:OrganismPart
                                                                                                                biotop:Syncytium) ; 
                                                                                                   a owl:Class]) ; 
                                                                               a owl:Class].
biotop:StructuredBiologicalEntity ru:definition """Corresponds to FMA anatomical structure but extends to any kind of orgnaism: Material anatomical entity which is generated by coordinated expression of the organism's own genes that guide its morphogenesis; has inherent 3D shape; its parts are connected and spatially related to one another in patterns determined by coordinated gene expression. Examples: heart, right ventricle, mitral valve, myocardium, endothelium, lymphocyte, fibroblast, thorax, cardiovascular system, hemoglobin, T cell receptor.
Old name: anatomical structure""";
                                  a owl:Class;
                                  rdfs:label "structured biological entity";
                                  rdfs:subClassOf [owl:someValuesFrom biotop:TaxonQuality ; 
                                                   owl:onProperty biotop:bearerOf ; 
                                                   a owl:Restriction],
                                                  biotop:PolyMolecularCompositeEntity.
biotop:StructuredNonbiologicalCompound ru:definition """All those things that are not identified by belonging to any biological species
Borderline cases are artifacts that use biological substance (a table, a cloth, a house, a meal ...) A criterion to draw the boundary is whether or not the species affiliation has some structural or functional implication.""";
                                       a owl:Class;
                                       rdfs:label "structured nonbiological compound";
                                       rdfs:subClassOf [owl:onProperty biotop:bearerOf ; 
                                                        owl:allValuesFrom [owl:complementOf biotop:TaxonQuality ; 
                                                                           a owl:Class] ; 
                                                        a owl:Restriction],
                                                       biotop:PolyMolecularCompositeEntity.
biotop:SubatomicEntityByChargePartition ru:definition """SubatomicEntityByChargePartition

ontologically irrelevant node: disjoint partition: subatomic entity by charge""";
                                        a owl:Class;
                                        rdfs:label "*";
                                        owl:equivalentClass [owl:intersectionOf (biotop:SubatomicParticle
                                                                                 [owl:unionOf (biotop:Electron
                                                                                              biotop:Neutron
                                                                                              biotop:Proton) ; 
                                                                                 a owl:Class]) ; 
                                                             a owl:Class].
biotop:SubatomicParticle ru:definition "Parts of Atoms.";
                         a owl:Class;
                         rdfs:label "subatomic particle";
                         rdfs:subClassOf biotop:MaterialEntityBySizePartition.
biotop:SubfamilyDrosophilinaeValueRegion a owl:Class;
                                         rdfs:comment "EXAMPLE OF TAXON REGION";
                                         rdfs:label "subfamily drosophilinae value region";
                                         rdfs:subClassOf biotop:FamilyDrosophilidaeValueRegion.
biotop:SubjectOfCareRole ru:definition "the role an animal or human plays as receiver of health care";
                         a owl:Class;
                         rdfs:label "subject of care role";
                         rdfs:subClassOf biotop:HealthRelatedRole.
biotop:SubmolecularGroup a owl:Class;
                         rdfs:comment "A submolecular group or moiety is a group of covalently bound atoms that occurs only as part of a molecule";
                         rdfs:label "submolecular group";
                         rdfs:subClassOf [owl:complementOf biotop:Atom ; 
                                          a owl:Class],
                                         [owl:someValuesFrom [owl:complementOf biotop:OligoOrPolymer ; 
                                                              a owl:Class] ; 
                                          owl:onProperty biotop:componentPartOf ; 
                                          a owl:Restriction],
                                         [owl:complementOf biotop:EntireMolecularEntity ; 
                                          a owl:Class],
                                         biotop:MolecularEntityByGranularityPartition.
biotop:SubphylumSaccharomycotinaValueRegion a owl:Class;
                                            rdfs:comment "EXAMPLE OF TAXON REGION";
                                            rdfs:label "subphylum saccharomycotina value region";
                                            rdfs:subClassOf biotop:PhylumAscomycotaValueRegion.
biotop:SubphylumVertebrataValueRegion a owl:Class;
                                      rdfs:comment "EXAMPLE OF TAXON REGION";
                                      rdfs:label "subphylum vertebrata value region";
                                      rdfs:subClassOf biotop:PhylumChordataValueRegion.
biotop:SubstanceInteraction ru:definition "action in which molecular entities interact";
                            a owl:Class;
                            rdfs:label "substance interaction";
                            rdfs:subClassOf [owl:onProperty biotop:hasParticipant ; 
                                             owl:allValuesFrom [owl:unionOf (biotop:MoleculeComplex
                                                                             biotop:MonoMolecularEntity
                                                                             [owl:someValuesFrom [owl:unionOf (biotop:MoleculeComplex
                                                                                                              biotop:MonoMolecularEntity) ; 
                                                                                                 a owl:Class] ; 
                                                                             owl:onProperty biotop:hasGranularPart ; 
                                                                             a owl:Restriction]) ; 
                                                                a owl:Class] ; 
                                             a owl:Restriction],
                                            biotop:Interacting.
biotop:Syncytium ru:definition "Fusion of cells ";
                 a owl:Class;
                 rdfs:label "syncytium";
                 rdfs:subClassOf [owl:intersectionOf ([owl:someValuesFrom biotop:CellMembrane ; 
                                                      owl:onProperty biotop:hasComponentPart ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom biotop:CellularComponent ; 
                                                      owl:onProperty biotop:hasComponentPart ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom biotop:Cytoplasm ; 
                                                      owl:onProperty biotop:hasProperPhysicalPart ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class],
                                 biotop:StructuredBiologicalCompoundByGranularityPartition.
biotop:TaxonQuality ru:definition "The quality of one or more biological organisms, as well as of parts of organism of partaining to a biological taxon. [steschu20080127]";
                    a owl:Class;
                    rdfs:label "taxon quality";
                    rdfs:subClassOf [owl:onProperty biotop:qualityLocated ; 
                                     owl:allValuesFrom biotop:TaxonValueRegion ; 
                                     a owl:Restriction],
                                    [owl:someValuesFrom biotop:TaxonValueRegion ; 
                                     owl:onProperty biotop:qualityLocated ; 
                                     a owl:Restriction],
                                    biotop:ObjectQuality.
biotop:TaxonValueRegion ru:definition """abstract region in which the values of biological taxa are located (cf. Schulz et.al ISMB 2008). Biological taxa can be ascribed not only to organisms but also to ogranism parts, derivates, as well as populations.

""";
                        a owl:Class;
                        rdfs:label "taxon value region";
                        rdfs:subClassOf [owl:someValuesFrom biotop:TaxonQuality ; 
                                         owl:onProperty biotop:qualityLocationOf ; 
                                         a owl:Restriction],
                                        biotop:ValueRegion.
biotop:TemporalEntity a owl:Class;
                      rdfs:subClassOf biotop:DEPRECATED.
biotop:TherapeuticRole ru:definition """1. The role of a continuant participating in a process with an expected positive impact on a dysfunctional biological system.
2. The role of a process with an expected positive impact on a dysfunctional biological system.""";
                       a owl:Class;
                       rdfs:label "therapeutic role";
                       rdfs:subClassOf biotop:HealthRelatedRole.
biotop:Time ru:definition "Point or interval on the time axis";
            a owl:Class;
            rdfs:label "time";
            rdfs:subClassOf biotop:Particular;
            owl:priorVersion "temporal entity".
biotop:TimeInterval ru:definition "the interval between two time points";
                    a owl:Class;
                    rdfs:label "time interval";
                    rdfs:subClassOf biotop:Time.
biotop:Tissue ru:definition "Aggregate of an arbitrary number of congeneric cells (cells with identical specialized characteristics), embedded into an amount of matter (matrix) that work together to perform a specific function.";
              a owl:Class;
              rdfs:label "tissue";
              rdfs:subClassOf [owl:someValuesFrom biotop:MulticellularOrganism ; 
                               owl:onProperty biotop:originatesFrom ; 
                               a owl:Restriction],
                              [owl:someValuesFrom [owl:someValuesFrom biotop:Cell ; 
                                                   owl:onProperty biotop:hasGranularPart ; 
                                                   a owl:Restriction] ; 
                               owl:onProperty biotop:hasComponentPart ; 
                               a owl:Restriction],
                              [owl:someValuesFrom [owl:someValuesFrom biotop:EntireMolecularEntity ; 
                                                   owl:onProperty biotop:hasGranularPart ; 
                                                   a owl:Restriction] ; 
                               owl:onProperty biotop:hasComponentPart ; 
                               a owl:Restriction],
                              biotop:PortionOfHeterogenousSolid.
biotop:TissueProcess ru:definition "process occurring in a tissue";
                     a owl:Class;
                     rdfs:label "tissue process";
                     owl:equivalentClass [owl:intersectionOf (biotop:BiologicalProcessualEntity
                                                              [owl:someValuesFrom biotop:Tissue ; 
                                                              owl:onProperty biotop:hasParticipant ; 
                                                              a owl:Restriction]) ; 
                                          a owl:Class].
biotop:Treating ru:definition "action with the intention to produce a positive effect on a biological organism or in which a malfunctioning is relieved or disrupted.";
                a owl:Class;
                rdfs:label "treating";
                rdfs:subClassOf biotop:Affecting;
                owl:equivalentClass [owl:unionOf (biotop:TreatingCondition
                                                  biotop:TreatingOrganism) ; 
                                     a owl:Class].
biotop:TreatingCondition ru:definition "action with the intention to relieve or disrupt a malfunctioning of a biological entity";
                         a owl:Class;
                         rdfs:label "treating condition";
                         rdfs:subClassOf [owl:onProperty biotop:hasPatient ; 
                                          owl:allValuesFrom [owl:someValuesFrom biotop:NoncanonicalStaticProcessualEntity ; 
                                                             owl:onProperty biotop:participatesIn ; 
                                                             a owl:Restriction] ; 
                                          a owl:Restriction],
                                         [owl:onProperty biotop:hasAgent ; 
                                          owl:allValuesFrom [owl:someValuesFrom biotop:TherapeuticRole ; 
                                                             owl:onProperty biotop:bearerOf ; 
                                                             a owl:Restriction] ; 
                                          a owl:Restriction],
                                         biotop:Affecting.
biotop:TreatingOrganism ru:definition "action with the intention to produce a positive effect on a biological organism";
                        a owl:Class;
                        rdfs:label "treating organism";
                        rdfs:subClassOf [owl:onProperty biotop:hasPatient ; 
                                         owl:allValuesFrom [owl:unionOf (biotop:LivingOrganism
                                                                         [owl:someValuesFrom biotop:LivingOrganism ; 
                                                                         owl:onProperty biotop:hasGranularPart ; 
                                                                         a owl:Restriction]) ; 
                                                            a owl:Class] ; 
                                         a owl:Restriction],
                                        [owl:onProperty biotop:hasAgent ; 
                                         owl:allValuesFrom [owl:someValuesFrom biotop:OccupationalRole ; 
                                                            owl:onProperty biotop:bearerOf ; 
                                                            a owl:Restriction] ; 
                                         a owl:Restriction],
                                        biotop:Affecting.
biotop:TwoDimensionalBiologicalEntity ru:definition "surface or plane in a biological entity";
                                      a owl:Class;
                                      rdfs:label "two dimensional biological entity";
                                      owl:equivalentClass [owl:intersectionOf (biotop:TwoDimensionalPhysicalEntity
                                                                               [owl:unionOf ([owl:someValuesFrom biotop:BiologicalSpace ; 
                                                                                            owl:onProperty biotop:physicallyBounds ; 
                                                                                            a owl:Restriction]
                                                                                            [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                                            owl:onProperty biotop:physicallyBounds ; 
                                                                                            a owl:Restriction]
                                                                                            [owl:someValuesFrom biotop:StructuredBiologicalEntity ; 
                                                                                            owl:onProperty biotop:properPhysicalPartOf ; 
                                                                                            a owl:Restriction]) ; 
                                                                               a owl:Class]
                                                                               [owl:complementOf [owl:unionOf (biotop:BiologicalSpace
                                                                                                              biotop:StructuredBiologicalEntity) ; 
                                                                                                 a owl:Class] ; 
                                                                               a owl:Class]
                                                                               [owl:onProperty biotop:physicallyBounds ; 
                                                                               owl:allValuesFrom [owl:unionOf (biotop:BiologicalSpace
                                                                                                               biotop:StructuredBiologicalEntity) ; 
                                                                                                  a owl:Class] ; 
                                                                               a owl:Restriction]) ; 
                                                           a owl:Class].
biotop:TwoDimensionalBoundary ru:definition "plane bounding a three-dimensional biological entity";
                              a owl:Class;
                              rdfs:label "two dimensional boundary";
                              rdfs:subClassOf biotop:TwoDimensionalPhysicalEntity;
                              owl:equivalentClass [owl:someValuesFrom [owl:unionOf (biotop:ImmaterialThreeDimensionalPhysicalEntity
                                                                                    biotop:MaterialObject) ; 
                                                                       a owl:Class] ; 
                                                   owl:onProperty biotop:physicallyBounds ; 
                                                   a owl:Restriction].
biotop:TwoDimensionalPhysicalEntity ru:definition "plane";
                                    a owl:Class;
                                    rdfs:label "two dimensional physical entity";
                                    rdfs:subClassOf biotop:ImmaterialObject.
biotop:UnicellularOrganism ru:definition "Organisms that (always or in certain initial stages) consist of a single cell. We conceive organisms in a material sense. Therefore we do not assume any ontological difference between a monocellular organism and the cell it is made of.";
                           a owl:Class;
                           rdfs:label "unicellular organism";
                           owl:equivalentClass [owl:intersectionOf (biotop:LivingOrganism
                                                                    [owl:complementOf biotop:Syncytium ; 
                                                                    a owl:Class]
                                                                    [owl:someValuesFrom biotop:CellMembrane ; 
                                                                    owl:onProperty biotop:hasComponentPart ; 
                                                                    a owl:Restriction]
                                                                    [owl:someValuesFrom biotop:CellularComponent ; 
                                                                    owl:onProperty biotop:hasComponentPart ; 
                                                                    a owl:Restriction]
                                                                    [owl:someValuesFrom biotop:Cytoplasm ; 
                                                                    owl:onProperty biotop:hasProperPhysicalPart ; 
                                                                    a owl:Restriction]) ; 
                                                a owl:Class].
biotop:UsingAction ru:definition "action that relates a user with an object he/she uses";
                   a owl:Class;
                   rdfs:label "using action";
                   rdfs:subClassOf biotop:Action.
biotop:ValueRegion ru:definition "A value region is an abstract region in which (non quantitative) values of qualities are located.";
                   a owl:Class;
                   rdfs:label "value region";
                   rdfs:subClassOf [owl:onProperty biotop:qualityLocationOf ; 
                                    owl:allValuesFrom biotop:Quality ; 
                                    a owl:Restriction],
                                   [owl:someValuesFrom biotop:Quality ; 
                                    owl:onProperty biotop:qualityLocationOf ; 
                                    a owl:Restriction],
                                   biotop:Particular.
biotop:Vertebrate a owl:Class;
                  rdfs:comment "one vertebrate";
                  rdfs:label "vertebrate";
                  rdfs:subClassOf [owl:someValuesFrom [owl:intersectionOf (biotop:TaxonQuality
                                                                           [owl:someValuesFrom biotop:SubphylumVertebrataValueRegion ; 
                                                                           owl:onProperty biotop:qualityLocated ; 
                                                                           a owl:Restriction]
                                                                           [owl:onProperty biotop:qualityLocated ; 
                                                                           owl:allValuesFrom biotop:SubphylumVertebrataValueRegion ; 
                                                                           a owl:Restriction]) ; 
                                                       a owl:Class] ; 
                                   owl:onProperty biotop:bearerOf ; 
                                   a owl:Restriction],
                                  [owl:complementOf [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                                         owl:onProperty biotop:qualityLocated ; 
                                                                         a owl:Restriction] ; 
                                                     owl:onProperty biotop:bearerOf ; 
                                                     a owl:Restriction] ; 
                                   a owl:Class],
                                  biotop:AnimalIncludingHuman.
biotop:VertebratePopulation a owl:Class;
                            rdfs:comment "EXAMPLE OF POPULATION";
                            rdfs:label "vertebrate population";
                            owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                     [owl:someValuesFrom biotop:Vertebrate ; 
                                                                     owl:onProperty biotop:hasGranularPart ; 
                                                                     a owl:Restriction]
                                                                     [owl:onProperty biotop:hasGranularPart ; 
                                                                     owl:allValuesFrom biotop:Vertebrate ; 
                                                                     a owl:Restriction]) ; 
                                                 a owl:Class].
biotop:Virus ru:definition "Sub-microscopic agent that requires a host cell to grow and reproduce. Viruses resemble other organisms in that they possess genes, and can evolve in infected cells by natural selection.  We therefore classify viruses as organisms, although there is an open debate.";
             a owl:Class;
             rdfs:label "virus";
             rdfs:subClassOf [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                  owl:onProperty biotop:qualityLocated ; 
                                                  a owl:Restriction] ; 
                              owl:onProperty biotop:bearerOf ; 
                              a owl:Restriction],
                             [owl:complementOf biotop:Cell ; 
                              a owl:Class],
                             [owl:complementOf [owl:someValuesFrom biotop:Cell ; 
                                                owl:onProperty biotop:hasProperPhysicalPart ; 
                                                a owl:Restriction] ; 
                              a owl:Class],
                             biotop:OrganismByTaxonPartition.
biotop:VirusPopulation a owl:Class;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "virus population";
                       owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                [owl:someValuesFrom biotop:Virus ; 
                                                                owl:onProperty biotop:hasGranularPart ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty biotop:hasGranularPart ; 
                                                                owl:allValuesFrom biotop:Virus ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:VitaminRole ru:definition "The role a certain substance can play in an organism. Vitamins are organic compounds that are essential to an organism for metabolic reactions. They are not food. Vitamin does not include essential fatty acids or essential amino acids";
                   a owl:Class;
                   rdfs:label "vitamin role";
                   rdfs:subClassOf biotop:BiologicalSystemRole.
biotop:WaterMolecule ru:definition "A water molecule is composed by one oxygen molecule and two hydrogen molecules";
                     a owl:Class;
                     rdfs:label "water molecule";
                     rdfs:subClassOf biotop:InorganicMolecularEntity.
biotop:Wave ru:definition "(wikipedia) disturbance that propagates through space and time, usually with transference of energy";
            a owl:Class;
            rdfs:label "wave";
            rdfs:subClassOf biotop:ImmaterialObject.
biotop:WellFormedBiologicalStructure a owl:Class;
                                     rdfs:label "well formed biological structure";
                                     rdfs:subClassOf biotop:StructuredBiologicalCompoundByCanonicityPartition;
                                     owl:equivalentClass [owl:intersectionOf (biotop:StructuredBiologicalEntity
                                                                              [owl:someValuesFrom [owl:intersectionOf (biotop:Canonicity
                                                                                                                      [owl:someValuesFrom biotop:CanonicalValueRegion ; 
                                                                                                                      owl:onProperty biotop:qualityLocated ; 
                                                                                                                      a owl:Restriction]) ; 
                                                                                                  a owl:Class] ; 
                                                                              owl:onProperty biotop:bearerOf ; 
                                                                              a owl:Restriction]) ; 
                                                          a owl:Class].
biotop:YeastCell a owl:Class;
                 rdfs:comment "Unicellular Fungi.";
                 rdfs:label "yeast cell";
                 rdfs:subClassOf [owl:onProperty biotop:hasProperPhysicalPart ; 
                                  owl:allValuesFrom [owl:complementOf biotop:Cell ; 
                                                     a owl:Class] ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom [owl:someValuesFrom biotop:MicroscopicValueRegion ; 
                                                      owl:onProperty biotop:qualityLocated ; 
                                                      a owl:Restriction] ; 
                                  owl:onProperty biotop:bearerOf ; 
                                  a owl:Restriction],
                                 [owl:someValuesFrom biotop:Cytoplasm ; 
                                  owl:onProperty biotop:hasProperPhysicalPart ; 
                                  a owl:Restriction],
                                 [owl:intersectionOf ([owl:someValuesFrom biotop:CellMembrane ; 
                                                      owl:onProperty biotop:hasComponentPart ; 
                                                      a owl:Restriction]
                                                      [owl:someValuesFrom biotop:CellularComponent ; 
                                                      owl:onProperty biotop:hasComponentPart ; 
                                                      a owl:Restriction]) ; 
                                  a owl:Class],
                                 biotop:Fungus.
biotop:YeastPopulation a owl:Class;
                       rdfs:comment "EXAMPLE OF POPULATION";
                       rdfs:label "yeast population";
                       owl:equivalentClass [owl:intersectionOf (biotop:Population
                                                                [owl:someValuesFrom biotop:YeastCell ; 
                                                                owl:onProperty biotop:hasGranularPart ; 
                                                                a owl:Restriction]
                                                                [owl:onProperty biotop:hasGranularPart ; 
                                                                owl:allValuesFrom biotop:YeastCell ; 
                                                                a owl:Restriction]) ; 
                                            a owl:Class].
biotop:abstractPartOf ru:definition """abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. 

Example: a header is an abstract part of a jpg file.""";
                      a owl:ObjectProperty;
                      rdfs:domain biotop:InformationObject;
                      rdfs:label "abstract part of";
                      rdfs:range biotop:InformationObject;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                      owl:inverseOf biotop:hasAbstractPart.
biotop:abstractlyRelatedTo ru:definition """Relation in which immaterial entities (information entities, roles, qualities) are involved. 

abstractlyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                           a owl:ObjectProperty;
                           rdfs:label "abstractly related to";
                           rdfs:subPropertyOf owl:topObjectProperty.
biotop:agentIn ru:definition """agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.
This is the reason why agentIn is subsumed by the relation causedBy. 

Example: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. """;
               a owl:ObjectProperty;
               rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                         biotop:InformationObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
               rdfs:label "agent in";
               rdfs:range biotop:Process;
               rdfs:subPropertyOf biotop:causes,
                                  biotop:participatesIn.
biotop:attachedTo ru:definition """Contiguous with a clear bona fide boundary between the connected parts.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                  a owl:ObjectProperty,
                    owl:SymmetricProperty;
                  rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                            biotop:MaterialObject) ; 
                               a owl:Class];
                  rdfs:label "attached to";
                  rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                  rdfs:subPropertyOf biotop:contiguousWith.
biotop:bearerOf ru:definition """inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.

(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")

Example: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick.""";
                a owl:ObjectProperty;
                rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                          biotop:MaterialObject) ; 
                             a owl:Class];
                rdfs:label "bearer of";
                rdfs:range [owl:unionOf (biotop:Disposition
                                         biotop:InformationObject
                                         biotop:ObjectQuality
                                         biotop:Role) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:locusOf;
                owl:inverseOf biotop:inheresIn.
biotop:branchOf ru:definition """A is a branch of B if it is contiguous with B and if some flow of matter or energy of information flows form B to A.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                a owl:ObjectProperty;
                rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                          biotop:MaterialObject) ; 
                             a owl:Class];
                rdfs:label "branch of";
                rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:attachedTo;
                owl:inverseOf biotop:hasBranch.
biotop:causallyRelatedTo ru:definition """Expresses a causal chain between material or processual entities.

causallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                         a owl:ObjectProperty;
                         rdfs:label "causally related to";
                         rdfs:subPropertyOf owl:topObjectProperty.
biotop:causedBy ru:definition """Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. 
 """;
                a owl:ObjectProperty;
                rdfs:domain biotop:Process;
                rdfs:label "caused by";
                rdfs:subPropertyOf biotop:causallyRelatedTo.
biotop:causes ru:definition """Causation of a process is here understood as the disjunction between agency (a continuant causes a process) and as the realization of a disposition, i.e. a disposition is considered the cause of a process. 
 """;
              a owl:ObjectProperty;
              rdfs:label "causes";
              rdfs:range biotop:Process;
              rdfs:subPropertyOf biotop:causallyRelatedTo;
              owl:inverseOf biotop:causedBy.
biotop:componentPartOf ru:definition """The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. 

The choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.

Components should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.

Examples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule.""";
                       a owl:ObjectProperty;
                       rdfs:domain biotop:MaterialObject;
                       rdfs:label "component part of";
                       rdfs:range biotop:MaterialObject;
                       rdfs:subPropertyOf biotop:properPhysicalPartOf;
                       owl:inverseOf biotop:hasComponentPart.
biotop:contiguousWith ru:definition """ContiguousWith describes the connection between two material objects that abut and can transmit forces.

 """;
                      a owl:ObjectProperty,
                        owl:SymmetricProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "contiguous with";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:physicallyAdjacentTo.
biotop:continuousWith ru:definition """Contiguous with a clear bona fide boundary between the connected parts.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 """;
                      a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "continuous with";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:contiguousWith.
biotop:cooccurringWith ru:definition "The relation coocurring with relates two processes if their temporal extensions overlap.";
                       a owl:ObjectProperty,
                         owl:SymmetricProperty;
                       rdfs:domain biotop:Process;
                       rdfs:label "cooccurring with";
                       rdfs:range biotop:Process;
                       rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:denotedBy ru:definition """denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. 

Example: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"""";
                 a owl:ObjectProperty;
                 rdfs:label "denoted by";
                 rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:denotes ru:definition """denotedBy (inverse: denotes) relates entities with symbols, which are information entities. In contrast to encoding, the denoted entity is completely independent on the denoting one. 

Example: The inflamation of a sinus is denoted by the word \"Sinusitis\", as well as by the ICD code \"J10\"""";
               a owl:ObjectProperty;
               rdfs:domain biotop:InformationObject;
               rdfs:label "denotes";
               rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:derivedInto ru:definition """DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. 

There is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. 

These relations are borrowed from the OBO Relation Ontology

Example:
\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46""";
                   a owl:ObjectProperty,
                     owl:TransitiveProperty;
                   rdfs:domain biotop:MaterialObject;
                   rdfs:label "derived into";
                   rdfs:range biotop:MaterialObject;
                   rdfs:subPropertyOf biotop:hasOrigin;
                   owl:inverseOf biotop:derivesFrom.
biotop:derivesFrom ru:definition """DerivesFrom (inverse: derivedInto) holds between  distinct material objects  when one succeeds the other across a temporal divide in such a way that at least a biologically significant portion of the matter of the earlier object is included into the later. 

There is some instant of time t such that the first object exists only prior to and the second one  only subsequent to t. 

These relations are borrowed from the OBO Relation Ontology

Example:
\"Three simple kinds of instance-level derivation can then be distinguished (Figure 3): first, the succession of one single continuant by another single continuant across a temporal threshold (for example, this blastocyst derives from this zygote); second, the fusion of two or more continuants into one continuant (for example, this zygote derives from this sperm and from this ovum); and third, the fission of an earlier single continuant to create a plurality of later continuants (for example, these promyelocytes derive from this myeoloblast). \" from http://genomebiology.com/2005/6/5/R46""";
                   a owl:ObjectProperty,
                     owl:TransitiveProperty;
                   rdfs:domain biotop:MaterialObject;
                   rdfs:label "derives from";
                   rdfs:range biotop:MaterialObject;
                   rdfs:subPropertyOf biotop:originatesFrom.
biotop:encodedBy ru:definition """EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.

Example: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) """;
                 a owl:ObjectProperty;
                 rdfs:label "encodedBy";
                 rdfs:range biotop:InformationObject;
                 rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                 owl:inverseOf biotop:encodes.
biotop:encodes ru:definition """EncodedBy (inverse: encodes) relates entities with symbols, which are information entities. In contrast to denotation, encoding entails that the makeup of the encoded entity is determined by the code. There is a dependence of the former on the latter. Note that the association of human-made codes with entities (e.g. for coding and classification systems like ICD-10) is nothing more than denotation and is therefore not in the scope of the encodedBy (encodes) relation.

Example: A material gene sequence is related to a sequence of nucleotide symbols (like ACCGATTGA) """;
               a owl:ObjectProperty;
               rdfs:domain biotop:InformationObject;
               rdfs:label "encodes";
               rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:featureOf a owl:ObjectProperty;
                 rdfs:label "feature of";
                 rdfs:subPropertyOf biotop:DEPRECATED_RELATION;
                 owl:inverseOf biotop:hasFeature.
biotop:granularPartOf ru:definition """hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. 

Generally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.

Example: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water""";
                      a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "granular part of";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:properPhysicalPartOf;
                      owl:inverseOf biotop:hasGranularPart.
biotop:hasAbstractPart ru:definition """abstractPartOf (inverse: hasAbstractPart) Relates parts and wholes of abstract entities. Abstract entities are neither processes, material objects, regions or spaces. Typical abstract entities are pieces of information. 

For instance, a header is an abstract part of a jpg file.""";
                       a owl:ObjectProperty;
                       rdfs:domain biotop:InformationObject;
                       rdfs:label "has abstract part";
                       rdfs:range biotop:InformationObject;
                       rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:hasAgent ru:definition """agentIn (inverse: hasAgent) relates a participant with a process, with the condition that this participant is causally active in the relevant process.
This is the reason why agentIn is subsumed by the relation causedBy. 

Example: A physician is the agent in a opeeration process; a solvent is the agent in a solving process. """;
                a owl:ObjectProperty;
                rdfs:domain biotop:Process;
                rdfs:label "has agent";
                rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                         biotop:InformationObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:causedBy,
                                   biotop:hasParticipant;
                owl:inverseOf biotop:agentIn.
biotop:hasBranch ru:definition """B hasBranch A if it is contiguous with B and if some flow of matter or energy of information flows form B to A.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                 rdfs:label "has branch";
                 rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                          biotop:MaterialObject) ; 
                             a owl:Class];
                 rdfs:subPropertyOf biotop:attachedTo.
biotop:hasComponentPart ru:definition """The non-transitive relation hasComponentPart (inverse: componentPartOf) relates components with a compound. Components strictly partition the compound, and the compound is the mereological sum of its components. A loss of some component affects the integrity of the compound, and possibly the type it instantiates, e.g. a complete vs. a defective organism. 

The choice of what is a component of a compound is somewhat arbitrary, because there are several ways to divide a whole into parts. Strictly spoken, this relation should refer to some partition.

Components should be - at least - partly bona fide parts. The use of this relation also requires the commitment to an underlying granularity level. So could we consider the codons (base triples) as the components of a DNA molecule but also the single nucleotides. Note that components of a compound may also be portions of matter.

Examples: my liver is a component of my organism, a carboxy group is a component of some organic acid molecule.""";
                        a owl:ObjectProperty;
                        rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                  biotop:MaterialObject) ; 
                                     a owl:Class];
                        rdfs:label "has component part";
                        rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                 biotop:MaterialObject) ; 
                                    a owl:Class],
                                   biotop:MaterialObject;
                        rdfs:subPropertyOf biotop:hasProperPhysicalPart.
biotop:hasDuration ru:definition "hasDuration relates a process with the time interval it covers.";
                   a owl:ObjectProperty;
                   rdfs:domain biotop:Process;
                   rdfs:label "has duration";
                   rdfs:range biotop:TimeInterval;
                   rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:hasFeature a owl:ObjectProperty;
                  rdfs:label "has feature";
                  rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:hasGranularPart ru:definition """hasGranularPart (inverse: granularPartOf) relate  Pluralities with their constituents. The constituents are of the same sort. 

Generally pluralities have a high number of grains. The loss of a grain has no effect on the sortality of the identity of the plurality.

Example: A cow is a granular part of a herd of cows. A water molecule is a granular part of some amount of water""";
                       a owl:ObjectProperty;
                       rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                 biotop:MaterialObject) ; 
                                    a owl:Class];
                       rdfs:label "has granular part";
                       rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                       rdfs:subPropertyOf biotop:hasProperPhysicalPart.
biotop:hasLocus ru:definition """hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.

See property chains: a participant of a process at a given time is located where the process is located. 

Example: A heart pumping process is located in a heart. """;
                a owl:ObjectProperty,
                  owl:TransitiveProperty;
                rdfs:domain [owl:unionOf (biotop:Disposition
                                          biotop:ImmaterialObject
                                          biotop:InformationObject
                                          biotop:MaterialObject
                                          biotop:ObjectQuality
                                          biotop:Process
                                          biotop:Role) ; 
                             a owl:Class];
                rdfs:label "has locus";
                rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:spatiallyRelatedTo;
                owl:inverseOf biotop:locusOf;
                owl:propertyChainAxiom (biotop:participatesIn
                                        biotop:hasLocus).
biotop:hasOrigin a owl:ObjectProperty;
                 rdfs:label "has origin";
                 rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:hasOriginalPart ru:definition """hasOriginalPart (inverse: originalPartOf). 

original parts of A are no longer parts of A but were parts of A when they came into existence. 

Example:
Apples harvested from an apple tree, tissue samples in a lab. """;
                       a owl:ObjectProperty;
                       rdfs:domain biotop:MaterialObject;
                       rdfs:label "has original part";
                       rdfs:range biotop:MaterialObject;
                       rdfs:subPropertyOf biotop:hasOrigin;
                       owl:inverseOf biotop:originalPartOf.
biotop:hasOriginatingPhysicalPart ru:definition """originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)

An originating physical part is a proper physical part that has never ceased to be part of the object it is related to. 

Example: my brain is an originating physical part of my body """;
                                  a owl:ObjectProperty,
                                    owl:TransitiveProperty;
                                  rdfs:domain biotop:MaterialObject;
                                  rdfs:label "has originating physical part";
                                  rdfs:range biotop:MaterialObject;
                                  rdfs:subPropertyOf biotop:hasOrigin,
                                                     biotop:hasProperPhysicalPart;
                                  owl:inverseOf biotop:originatingPhysicalPartOf.
biotop:hasOutcome ru:definition """outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either
- a) comes into being during the process
or - b) undergoes some change during the process, so that it instantiates a different class at the end of the process 
and it constitutes (one of) the main result(s) of the process

Example: a Protein molecule is the outcome of a translation process.""";
                  a owl:ObjectProperty;
                  rdfs:domain biotop:Process;
                  rdfs:label "has outcome";
                  rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                           biotop:InformationObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                  rdfs:subPropertyOf biotop:hasParticipant.
biotop:hasParticipant ru:definition """HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. 

Process participation is distinguished from process location.

Example: 

An urea molecule which is excreted in a renal filtration process is participant of this process.

A person who undergoes an operation is participant of this process.""";
                      a owl:ObjectProperty;
                      rdfs:domain biotop:Process;
                      rdfs:label "has participant";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:InformationObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:processuallyRelatedTo;
                      owl:inverseOf biotop:participatesIn.
biotop:hasPatient ru:definition """patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  

Example: A prey is the patient in a hunting process; a solute is the patient in a solving process. """;
                  a owl:ObjectProperty;
                  rdfs:domain biotop:Process;
                  rdfs:label "has patient";
                  rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                           biotop:InformationObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                  rdfs:subPropertyOf biotop:hasParticipant;
                  owl:inverseOf biotop:patientIn.
biotop:hasPhysicalPart ru:definition """hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is reflexive, i.e. every physical object has itself as a physical part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"""";
                       a owl:ObjectProperty,
                         owl:TransitiveProperty;
                       rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                 biotop:MaterialObject) ; 
                                    a owl:Class];
                       rdfs:label "has physical part";
                       rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                       rdfs:subPropertyOf biotop:physicalLocationOf.
biotop:hasPointInTime ru:definition """hasPointInTome relates a processual entity with some point in the interval it occupies. 
If there is no temporal extension (process boundary) it relates it to the time it occurs. """;
                      a owl:ObjectProperty;
                      rdfs:domain biotop:Process;
                      rdfs:label "has point in time";
                      rdfs:range biotop:PointInTime;
                      rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:hasProcessQuality ru:definition """processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. 

Example: The process of heart beating has the process quality heart rate.""";
                         a owl:ObjectProperty;
                         rdfs:domain biotop:Process;
                         rdfs:label "has process quality";
                         rdfs:range biotop:ProcessQuality;
                         rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                         owl:inverseOf biotop:processQualityOf.
biotop:hasProcessRole ru:definition """processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. 

Example: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor.""";
                      a owl:ObjectProperty;
                      rdfs:domain biotop:Process;
                      rdfs:label "has process role";
                      rdfs:range biotop:Role;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:hasProcessualPart ru:definition """hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).

Example: G1 phase is a processual part of the process mitosis.""";
                         a owl:ObjectProperty,
                           owl:TransitiveProperty;
                         rdfs:domain biotop:Process;
                         rdfs:label "has processual part";
                         rdfs:range biotop:Process;
                         rdfs:subPropertyOf biotop:temporallyRelatedTo;
                         owl:inverseOf biotop:processualPartOf.
biotop:hasProperPhysicalPart ru:definition """hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"

Examples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer.""";
                             a owl:ObjectProperty,
                               owl:TransitiveProperty;
                             rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                       biotop:MaterialObject) ; 
                                          a owl:Class];
                             rdfs:label "has proper physical part";
                             rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                      biotop:MaterialObject) ; 
                                         a owl:Class];
                             rdfs:subPropertyOf biotop:hasPhysicalPart.
biotop:hasRealization ru:definition """Realization occurs if a disposition or function manifests itself as a process. 

Example: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  """;
                      a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (biotop:Disposition
                                                biotop:InformationObject
                                                biotop:ObjectQuality
                                                biotop:Role) ; 
                                   a owl:Class];
                      rdfs:label "has realization";
                      rdfs:range biotop:Process;
                      rdfs:subPropertyOf biotop:causes;
                      owl:inverseOf biotop:realizationOf.
biotop:inheresIn ru:definition """inheresIn (inverse: bearerOf) relates a quality, role, function, disposition, or information object with the physical entity it depends on.

(Note that for processes there is a separate relation pair \"hasProcessQuality\" and \"processQualityOf\")

Example: a color inheres in a paint, the ability to fly inheres in a bird, or a pdf file inheres in a USB stick.""";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:unionOf (biotop:Disposition
                                           biotop:InformationObject
                                           biotop:ObjectQuality
                                           biotop:Role) ; 
                              a owl:Class];
                 rdfs:label "inheres in";
                 rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                          biotop:MaterialObject) ; 
                             a owl:Class];
                 rdfs:subPropertyOf biotop:hasLocus.
biotop:isAbout ru:definition "replaced by denotes";
               a owl:ObjectProperty;
               rdfs:label "is about";
               rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:locusOf ru:definition """hasLocus (inverse: locusOf) is a very broad relation which relates an entity with the place it occurs, inheres, or is part of.

See property chains: a participant of a process at a given time is located where the process is located. 

Example: A heart pumping process is located in a heart. """;
               a owl:ObjectProperty,
                 owl:TransitiveProperty;
               rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
               rdfs:label "locus of";
               rdfs:range [owl:unionOf (biotop:Disposition
                                        biotop:ImmaterialObject
                                        biotop:InformationObject
                                        biotop:MaterialObject
                                        biotop:ObjectQuality
                                        biotop:Process
                                        biotop:Role) ; 
                           a owl:Class];
               rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:originalPartOf ru:definition """hasOriginalPart (inverse: originalPartOf). 

original parts of A are no longer parts of A but were parts of A when they came into existence. 

Example:
Apples harvested from an apple tree, tissue samples in a lab. """;
                      a owl:ObjectProperty;
                      rdfs:domain biotop:MaterialObject;
                      rdfs:label "original part of";
                      rdfs:range biotop:MaterialObject;
                      rdfs:subPropertyOf biotop:originatesFrom.
biotop:originatesFrom ru:definition """originatesFrom relates two material objects one of which originates from the other in a very broad sense. 

It includes derivation (in the OBO RO sense), actual actual parts (provided they were always parts), as well as original (historical) parts.

Examples: see Subrelations""";
                      a owl:ObjectProperty;
                      rdfs:domain biotop:MaterialObject;
                      rdfs:label "originates from";
                      rdfs:range biotop:MaterialObject;
                      rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:originatingPhysicalPartOf ru:definition """originatingPhysicalPartOf (inverse: hasOriginatingPhysicalPart)

An originating physical part is a proper physical part that has never ceased to be part of the object it is related to. 

Example: my brain is an originating physical part of my body """;
                                 a owl:ObjectProperty,
                                   owl:TransitiveProperty;
                                 rdfs:domain biotop:MaterialObject;
                                 rdfs:label "originating physical part of";
                                 rdfs:range biotop:MaterialObject;
                                 rdfs:subPropertyOf biotop:originatesFrom,
                                                    biotop:properPhysicalPartOf.
biotop:outcomeOf ru:definition """outcomeOf (inverse: hasOutcome) relates a participant to a process. This participant either
- a) comes into being during the process
or - b) undergoes some change during the process, so that it instantiates a different class at the end of the process 
and it constitutes (one of) the main result(s) of the process

Example: a Protein molecule is the outcome of a translation process.""";
                 a owl:ObjectProperty;
                 rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                           biotop:InformationObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                 rdfs:label "outcome of";
                 rdfs:range biotop:Process;
                 rdfs:subPropertyOf biotop:participatesIn;
                 owl:inverseOf biotop:hasOutcome.
biotop:participatesIn ru:definition """HasParticipant (inverse: participatesIn) relates a process with a non processual entity which plays some role in the process. Process participants may exist during the whole process, remain unchanged or undergo changes; they may come into being or get out of being during the process. 

Process participation is distinguished from process location.

Example: 

An urea molecule which is excreted in a renal filtration process is participant of this process.

A person who undergoes an operation is participant of this process.""";
                      a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:InformationObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "participates in";
                      rdfs:range biotop:Process;
                      rdfs:subPropertyOf biotop:processuallyRelatedTo.
biotop:patientIn ru:definition """patientIn (inverse: hasPatient) relates a participant with a process, with the condition that that this participant is not causally active.  

Example: A prey is the patient in a hunting process; a solute is the patient in a solving process. """;
                 a owl:ObjectProperty;
                 rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                           biotop:InformationObject
                                           biotop:MaterialObject) ; 
                              a owl:Class];
                 rdfs:label "patient in";
                 rdfs:range biotop:Process;
                 rdfs:subPropertyOf biotop:participatesIn.
biotop:physicalLocationOf ru:definition """physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. 

Generally, this relation is further specificed in terms of parthood or containment

Examples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. """;
                          a owl:ObjectProperty,
                            owl:TransitiveProperty;
                          rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                    biotop:MaterialObject) ; 
                                       a owl:Class];
                          rdfs:label "physical location of";
                          rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                   biotop:MaterialObject) ; 
                                      a owl:Class];
                          rdfs:subPropertyOf biotop:locusOf,
                                             biotop:physicallyConnectedTo.
biotop:physicalPartOf ru:definition """hasPhysicalPart (inverse: physicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is reflexive, i.e. every physical object has itself as a physical part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"""";
                      a owl:ObjectProperty,
                        owl:TransitiveProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "physical part of";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:physicallyLocatedIn;
                      owl:inverseOf biotop:hasPhysicalPart.
biotop:physicallyAdjacentTo ru:definition """physicalAdjacentTo relates two physical objects that abut without physical overlap. 

Examples: see subrelations""";
                            a owl:ObjectProperty,
                              owl:SymmetricProperty;
                            rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                      biotop:MaterialObject) ; 
                                         a owl:Class];
                            rdfs:label "physically adjacent to";
                            rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                            rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyBoundedBy ru:definition """physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. 

Example: the surface of my liver physically bounds my liver. """;
                           a owl:ObjectProperty;
                           rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                           rdfs:label "physically bounded by";
                           rdfs:range biotop:PhysicalBoundary;
                           rdfs:subPropertyOf biotop:hasProperPhysicalPart;
                           owl:inverseOf biotop:physicallyBounds.
biotop:physicallyBounds ru:definition """physicallyBounds (inverse: physically boundedBy) relates a three-dimensional physical object with its two dimensional boundary. 

Example: the surface of my liver physically bounds my liver. """;
                        a owl:ObjectProperty;
                        rdfs:domain biotop:PhysicalBoundary;
                        rdfs:label "physically bounds";
                        rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                 biotop:MaterialObject) ; 
                                    a owl:Class];
                        rdfs:subPropertyOf biotop:properPhysicalPartOf.
biotop:physicallyConnectedTo ru:definition """physicallyConnectedTo (a symmetric relation) relates two spatially relevant entities (material entities or spaces) which overlap at least one point in space. 

Example: France is connected to Germany, my optic nerve is connected to my eyeball.""";
                             a owl:ObjectProperty,
                               owl:SymmetricProperty;
                             rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                       biotop:MaterialObject) ; 
                                          a owl:Class];
                             rdfs:label "physically connected to";
                             rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                      biotop:MaterialObject) ; 
                                         a owl:Class];
                             rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:physicallyContainedIn ru:definition """Containment is location without parthood. E.g. Food is contained in the stomach. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                             a owl:ObjectProperty;
                             rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                       biotop:MaterialObject) ; 
                                          a owl:Class];
                             rdfs:label "physically contained in";
                             rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                      biotop:MaterialObject) ; 
                                         a owl:Class];
                             rdfs:subPropertyOf biotop:physicallyLocatedIn;
                             owl:inverseOf biotop:physicallyContains.
biotop:physicallyContains ru:definition """Containment is location without parthood. E.g. Food is contained in the stomach. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118  """;
                          a owl:ObjectProperty;
                          rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                    biotop:MaterialObject) ; 
                                       a owl:Class];
                          rdfs:label "physically contains";
                          rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                   biotop:MaterialObject) ; 
                                      a owl:Class];
                          rdfs:subPropertyOf biotop:physicalLocationOf.
biotop:physicallyDisconnectedFrom ru:definition """No sharing of parts and no sharing of boundaries. 

Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                                  a owl:ObjectProperty,
                                    owl:SymmetricProperty;
                                  rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                            biotop:MaterialObject) ; 
                                               a owl:Class];
                                  rdfs:label "physically disconnected from";
                                  rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                           biotop:MaterialObject) ; 
                                              a owl:Class];
                                  rdfs:subPropertyOf biotop:spatiallyRelatedTo.
biotop:physicallyInterconnects a owl:ObjectProperty;
                               rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                         biotop:MaterialObject) ; 
                                            a owl:Class];
                               rdfs:label "physically interconnects";
                               rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                        biotop:MaterialObject) ; 
                                           a owl:Class];
                               rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyLocatedIn ru:definition """physicallylocatedIn (inverse: physical location of) relates two physical objects in terms of space. All point in space occupied by the first object are also occupied by the second object. 

Generally, this relation is further specificed in terms of parthood or containment

Examples: my thumb is physically located in my hand, food is located in my stomach or also in the cavity of my stomach. A 10 Euro bill is located in my wallet. """;
                           a owl:ObjectProperty,
                             owl:TransitiveProperty;
                           rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                           rdfs:label "physically located in";
                           rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                    biotop:MaterialObject) ; 
                                       a owl:Class];
                           rdfs:subPropertyOf biotop:hasLocus,
                                              biotop:physicallyConnectedTo;
                           owl:inverseOf biotop:physicalLocationOf.
biotop:physicallySurroundedBy ru:definition """Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)
""";
                              a owl:ObjectProperty;
                              rdfs:label "physically surrounded by";
                              rdfs:subPropertyOf biotop:physicallyConnectedTo;
                              owl:inverseOf biotop:physicallySurrounds.
biotop:physicallySurrounds ru:definition """Partly or completely covering from outside (establishing boundaries, enclosing, confining, enclosing, circumscribing)
""";
                           a owl:ObjectProperty;
                           rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                           rdfs:label "physically surrounds";
                           rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                    biotop:MaterialObject) ; 
                                       a owl:Class];
                           rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:physicallyTraverses ru:definition "crossing over and crossing through";
                           a owl:ObjectProperty;
                           rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                           rdfs:label "physically traverses";
                           rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                    biotop:MaterialObject) ; 
                                       a owl:Class];
                           rdfs:subPropertyOf biotop:physicallyConnectedTo.
biotop:precededBy ru:definition """precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. 

Example: fecundation preceeds embryonic development.""";
                  a owl:ObjectProperty,
                    owl:TransitiveProperty;
                  rdfs:domain [owl:unionOf (biotop:Process
                                            biotop:Time) ; 
                               a owl:Class];
                  rdfs:label "preceded by";
                  rdfs:range [owl:unionOf (biotop:Process
                                           biotop:Time) ; 
                              a owl:Class];
                  rdfs:subPropertyOf biotop:temporallyRelatedTo;
                  owl:inverseOf biotop:precedes.
biotop:precedes ru:definition """precedes (inverse: precededBy) relates two processes, one of which ends or totally happens before the second one begins. 

Example: fecundation preceeds embryonic development.""";
                a owl:ObjectProperty,
                  owl:TransitiveProperty;
                rdfs:domain [owl:unionOf (biotop:Process
                                          biotop:Time) ; 
                             a owl:Class];
                rdfs:label "precedes";
                rdfs:range [owl:unionOf (biotop:Process
                                         biotop:Time) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:processQualityOf ru:definition """processQualityOf (abstract: hasProcessQuality) links a quality that further characterizes a process to this process. Process qualities are asserted where the process cannot sufficiently be described by the qualities of its participants only. 

Example: The process of heart beating has the process quality heart rate.""";
                        a owl:ObjectProperty;
                        rdfs:domain biotop:ProcessQuality;
                        rdfs:label "process quality of";
                        rdfs:range biotop:Process;
                        rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:processRoleOf ru:definition """processRoleOf (abstract: hasProcessRole) links a role attributed to a process to this process. Process roles are asserted where the process cannot sufficiently be described by the roles of its participants only. 

Example: The process of injuring has the process role \"allowed\" in case of a surgical intervention agreed by both the patient and the doctor.""";
                     a owl:ObjectProperty;
                     rdfs:domain biotop:Role;
                     rdfs:label "process role of";
                     rdfs:range biotop:Process;
                     rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                     owl:inverseOf biotop:hasProcessRole.
biotop:processualPartOf ru:definition """hasProcessualPart (inverse: processualPartOf) relates a process with a subprocess (process part).

Example: G1 phase is a processual part of the process mitosis.""";
                        a owl:ObjectProperty,
                          owl:TransitiveProperty;
                        rdfs:domain biotop:Process;
                        rdfs:label "processual part of";
                        rdfs:range biotop:Process;
                        rdfs:subPropertyOf biotop:temporallyRelatedTo.
biotop:processuallyRelatedTo ru:definition """Relations that connect processes with other entities.

processuallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                             a owl:ObjectProperty;
                             rdfs:label "processually related to".
biotop:properPhysicalPartOf ru:definition """hasProperPhysicalPart (inverse: properPhysicalPartOf) obtains between physical objects. The distinction between parthood and locatedness is complex and does not obey strict criteria. 
This relation is irreflexive, i.e. a physical object cannot have itself as a physical proper part.

Note that for abstract entities like information artefacts there is a separate relation pair \"abstractPartOf\" and \"hasAbstractPart\"

For processes there are the relations \"hasProcessualPart\" and \"processualPartOf\"

Examples: my thumb is a proper physical part of my hand, this keyboard is a proper physical part of my computer.""";
                            a owl:ObjectProperty,
                              owl:TransitiveProperty;
                            rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                      biotop:MaterialObject) ; 
                                         a owl:Class];
                            rdfs:label "proper physical part of";
                            rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                                     biotop:MaterialObject) ; 
                                        a owl:Class];
                            rdfs:subPropertyOf biotop:physicalPartOf;
                            owl:inverseOf biotop:hasProperPhysicalPart.
biotop:qualityLocated ru:definition """qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. 
Value regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.

Example: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   """;
                      a owl:ObjectProperty;
                      rdfs:domain biotop:Quality;
                      rdfs:label "quality located";
                      rdfs:range biotop:ValueRegion;
                      rdfs:subPropertyOf biotop:abstractlyRelatedTo;
                      owl:inverseOf biotop:qualityLocationOf.
biotop:qualityLocationOf ru:definition """qualityLocated (inverse: qualityLocationOf) relates a quality with an abstract value region. The underlying idea, borrowed from the DOLCE ontology, is that the attribute / value distinction - as ubiquitous in information systems - should at least be optionally expressible in ontologies. 
Value regions are abstract regions, in which qualitative just as quantitative \"values\" are located. Like in topographic regions, these entities can overlap or be disjoint.

Example: \"Color\" as quality may be refined as \"Red Color\". It can be fully defined in by \"quality located some RedColorRegion\"   """;
                         a owl:ObjectProperty;
                         rdfs:domain biotop:ValueRegion;
                         rdfs:label "quality location of";
                         rdfs:range biotop:Quality;
                         rdfs:subPropertyOf biotop:abstractlyRelatedTo.
biotop:ramificationOf dc11:source """Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
			Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                      a owl:ObjectProperty;
                      rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                                biotop:MaterialObject) ; 
                                   a owl:Class];
                      rdfs:label "ramification of";
                      rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                               biotop:MaterialObject) ; 
                                  a owl:Class];
                      rdfs:subPropertyOf biotop:DEPRECATED_RELATION;
                      owl:inverseOf biotop:ramifies.
biotop:ramifies dc11:source """Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
			Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118""";
                a owl:ObjectProperty;
                rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                          biotop:MaterialObject) ; 
                             a owl:Class];
                rdfs:label "ramifies";
                rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
                rdfs:subPropertyOf biotop:DEPRECATED_RELATION.
biotop:realizationOf ru:definition """Realization occurs if a disposition or function manifests itself as a process. 

Example: the disposition of a bird to fly (which exists even when it does not fly) is realized by its process of flying.  """;
                     a owl:ObjectProperty;
                     rdfs:domain biotop:Process;
                     rdfs:label "realization of";
                     rdfs:range [owl:unionOf (biotop:Disposition
                                              biotop:InformationObject
                                              biotop:ObjectQuality
                                              biotop:Role) ; 
                                 a owl:Class];
                     rdfs:subPropertyOf biotop:causedBy.
biotop:spatiallyRelatedTo ru:definition """Most general relation that relates entities in terms of physical location.

spatiallyRelatedTo is meant as an organizing parent. It should not be asserted. """;
                          a owl:ObjectProperty,
                            owl:SymmetricProperty;
                          rdfs:domain [owl:unionOf (biotop:Disposition
                                                    biotop:ImmaterialObject
                                                    biotop:InformationObject
                                                    biotop:MaterialObject
                                                    biotop:ObjectQuality
                                                    biotop:Process
                                                    biotop:Role) ; 
                                       a owl:Class];
                          rdfs:label "spatially related to";
                          rdfs:range [owl:unionOf (biotop:Disposition
                                                   biotop:ImmaterialObject
                                                   biotop:InformationObject
                                                   biotop:MaterialObject
                                                   biotop:ObjectQuality
                                                   biotop:Process
                                                   biotop:Role) ; 
                                      a owl:Class].
biotop:temporallyRelatedTo ru:definition """The temporal arrangement of processes, events, durations and temporal measurements.

temporallyRelatedTo is meant as an organizing parent. It should not be asserted.""";
                           a owl:ObjectProperty,
                             owl:SymmetricProperty;
                           rdfs:domain [owl:unionOf (biotop:ObjectQuality
                                                     biotop:Process
                                                     biotop:Time) ; 
                                        a owl:Class];
                           rdfs:label "temporally related to";
                           rdfs:range [owl:unionOf (biotop:ObjectQuality
                                                    biotop:Process
                                                    biotop:Time) ; 
                                       a owl:Class].
biotop:touches ru:definition """Abutting without mechanical connection.
Schulz S, Hahn U. Towards the ontological foundations of symbolic biological theories.
Artif Intell Med. 2007 Mar;39(3):237-50. PMID: 17321118 """;
               a owl:ObjectProperty,
                 owl:SymmetricProperty;
               rdfs:domain [owl:unionOf (biotop:ImmaterialObject
                                         biotop:MaterialObject) ; 
                            a owl:Class];
               rdfs:label "touches";
               rdfs:range [owl:unionOf (biotop:ImmaterialObject
                                        biotop:MaterialObject) ; 
                           a owl:Class];
               rdfs:subPropertyOf biotop:physicallyAdjacentTo.
