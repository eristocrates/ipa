                                     rdfs:label "genus saccharomyces value region";
                                     rdfs:subClassOf biotop:FamilySaccharomycetaceaeValueRegion.
biotop:GeographicSurface ru:definition "delineated surface of a large solid body in space (earth, moon, sun,...)";
