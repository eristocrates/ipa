                                             <http://www.w3.org/2002/07/owl#equivalentClass> [<http://www.w3.org/2002/07/owl#intersectionOf> (biotop:LivingOrganism
                                                                                                                                              [<http://www.w3.org/2002/07/owl#unionOf> (biotop:AdultOrganism
                                                                                                                                                                                       biotop:EmbryonicOrganism
                                                                                                                                                                                       biotop:JuvenileOrganism) ; 
